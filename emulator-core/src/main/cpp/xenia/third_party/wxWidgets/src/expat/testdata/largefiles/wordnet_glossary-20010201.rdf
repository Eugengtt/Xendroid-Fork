<rdf:Description rdf:about="&a;200267142"
	 b:glossaryEntry="express in the metric system"/>
<rdf:Description rdf:about="&a;200267237">
	<b:glossaryEntry>make useful again; transform from a useless or uncultivated state; "The people reclaimed the marshes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200267403">
	<b:glossaryEntry xml:space='preserve'><![CDATA[change completely the nature of something; "In Kafka''s story, a person metamorphoses into a bug"]]></b:glossaryEntry>
