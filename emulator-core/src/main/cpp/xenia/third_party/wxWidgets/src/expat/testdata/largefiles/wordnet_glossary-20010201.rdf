</rdf:Description>
<rdf:Description rdf:about="&a;201294038"
	 b:glossaryEntry="do the twist"/>
<rdf:Description rdf:about="&a;201294113"
	 b:glossaryEntry="dance a waltz"/>
<rdf:Description rdf:about="&a;201294204">
