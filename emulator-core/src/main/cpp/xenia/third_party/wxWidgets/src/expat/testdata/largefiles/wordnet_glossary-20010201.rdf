	<b:glossaryEntry>reduce the diameter of (a wire or metal rod) by pulling it through a die; "draw wire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200300201"
	 b:glossaryEntry="lose thickness; become thin or thinner"/>
<rdf:Description rdf:about="&a;200300319">
	<b:glossaryEntry xml:space='preserve'><![CDATA[become thick or thicker; ''The sauce thickened"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200300448"
	 b:glossaryEntry='make thick or thicker; "Thicken the sauce"'/>
<rdf:Description rdf:about="&a;200300599"
	 b:glossaryEntry="make viscous or dense, as of liquids"/>
<rdf:Description rdf:about="&a;200300708"
	 b:glossaryEntry='grow smaller; "Interest in the project waned"'/>
<rdf:Description rdf:about="&a;200300889"
	 b:glossaryEntry='go down momentarily; "Prices dipped"'/>
<rdf:Description rdf:about="&a;200300986"
	 b:glossaryEntry='pass slowly (of time); "The day wore on"'/>
<rdf:Description rdf:about="&a;200301091">
	<b:glossaryEntry>make more extreme; raise in quantity, degree, or intensity; "heightened interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200301246"
	 b:glossaryEntry='become more extreme; "The tension heightened"'/>
<rdf:Description rdf:about="&a;200301365"
	 b:glossaryEntry='rise dramatically; "Prices shot up overnight"'/>
<rdf:Description rdf:about="&a;200301476"
	 b:glossaryEntry='go down in value; "Stock prices dropped"'/>
<rdf:Description rdf:about="&a;200301614">
	<b:glossaryEntry>fall heavily or suddenly; decline markedly; "The real estate market fell off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200301772">
	<b:glossaryEntry>fall suddenly and sharply; "Prices tumbled after the devaluation of the currency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200301917">
	<b:glossaryEntry>go up or advance; "Sales were climbing after prices were lowered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200302084"
	 b:glossaryEntry='increase in phase; "the moon is waxing"'/>
<rdf:Description rdf:about="&a;200302209"
	 b:glossaryEntry="make (a garment) fuller by pleating or gathering"/>
<rdf:Description rdf:about="&a;200302319"
	 b:glossaryEntry='decrease in phase; "the moon is waning"'/>
<rdf:Description rdf:about="&a;200302438"
	 b:glossaryEntry='become smaller; "Interest in his novels waned"'/>
<rdf:Description rdf:about="&a;200302564">
	<b:glossaryEntry>increase in size, volume or significance: "Her terror was magnified in her mind."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200302737">
	<b:glossaryEntry>stop operating or functioning; "The engine finally went"; "The car died on the road"; "The bus we travelled in broke down on the way to town"; "The coffe maker broke"; "The engine failed on the way to town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200303160">
	<b:glossaryEntry>stop operating; "My computer crashed last night"; "The system goes down at least once a week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200303326">
	<b:glossaryEntry>end resistance, esp. under pressure or force; "The door yielded to repeated blows with a battering ram."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200303520">
	<b:glossaryEntry>melt, break, or become otherwise unusable; "The lightbulbs blew out"; "The fuse blew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200303689">
	<b:glossaryEntry>unroll, unfold, or spread out or be unrolled, unfolded, or spread out from a furled state; "unfurl a banner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200303897"
	 b:glossaryEntry='form a cylinder by rolling; "roll up a banner"'/>
<rdf:Description rdf:about="&a;200304044"
	 b:glossaryEntry='form into a cylinder by rolling; "Roll up the cloth"'/>
<rdf:Description rdf:about="&a;200304267"
	 b:glossaryEntry='lower quickly; "douse a sail"'/>
<rdf:Description rdf:about="&a;200304359"
	 b:glossaryEntry="roll up (a portion of a sail) in order to reduce its area"/>
<rdf:Description rdf:about="&a;200304478"
	 b:glossaryEntry='make or roll into bolts; "bolt fabric"'/>
<rdf:Description rdf:about="&a;200304578">
	<b:glossaryEntry>vary in order to spread risk or to expand; "The company diversified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200304770">
	<b:glossaryEntry>produce variety or variegate; "The plants on this island diversified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200304906"
	 b:glossaryEntry='make something more diverse and varied; "Vary the menu"'/>
<rdf:Description rdf:about="&a;200305062"
	 b:glossaryEntry='make (more) diverse; "diversify a course of study"'/>
<rdf:Description rdf:about="&a;200305205"
	 b:glossaryEntry="variegate with different colors, shades, or patterns"/>
<rdf:Description rdf:about="&a;200305332"
	 b:glossaryEntry='become more special; "We specialize in dried flowers"'/>
<rdf:Description rdf:about="&a;200305536">
	<b:glossaryEntry xml:space='preserve'><![CDATA[suit to a special purpose; "specialize one''s research"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200305658">
	<b:glossaryEntry>become overly specialized; "She overspecialized when she concentrated on verbs in Fijian"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200305843"
	 b:glossaryEntry='move faster; "The car accelerated"'/>
<rdf:Description rdf:about="&a;200306034"
	 b:glossaryEntry='reduce the speed of; "He slowed down the car"'/>
<rdf:Description rdf:about="&a;200306237">
	<b:glossaryEntry>cause to move more slowly or operate at a slower rate; "This drug will retard your heart rate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200306422">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lessen the momentum or velocity of; "deaden a ship''s headway"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200306555"
	 b:glossaryEntry='make vapid or deprive of spirit: "deadened wine"'/>
<rdf:Description rdf:about="&a;200306667">
	<b:glossaryEntry>slow down by moving the tail sideways; "The airplane fishtailed on the runway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200306811"
	 b:glossaryEntry='cause to move faster; "He accelerated the car"'/>
<rdf:Description rdf:about="&a;200306968">
	<b:glossaryEntry>increase the number of rotations per minute; "rev up an engine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200307101">
	<b:glossaryEntry xml:space='preserve'><![CDATA[speed up; "let''s rev up production"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200307210"
	 b:glossaryEntry='lose velocity; move more slowly; "The car decelerated"'/>
<rdf:Description rdf:about="&a;200307430"
	 b:glossaryEntry="slow the growth or development of"/>
<rdf:Description rdf:about="&a;200307579"
	 b:glossaryEntry='become slow or slower; "Production slowed"'/>
<rdf:Description rdf:about="&a;200307731"
	 b:glossaryEntry='cause to proceed more slowly; "The illness slowed him down"'/>
<rdf:Description rdf:about="&a;200307934">
	<b:glossaryEntry>impede with a clog or as if with a clog; "The market is being clogged by these operations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200308094">
	<b:glossaryEntry>make less active or fast; "He slackened his pace as he got tired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200308251"
	 b:glossaryEntry='make smaller; "He decreased his staff"'/>
<rdf:Description rdf:about="&a;200308615">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lessen the authority, dignity, or reputation of; "don''t belittle your colleagues"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200308797"
	 b:glossaryEntry='give life or energy to; "The cold water invigorated him"'/>
<rdf:Description rdf:about="&a;200308947"
	 b:glossaryEntry='turn into gas; "The substance gasified"'/>
<rdf:Description rdf:about="&a;200309086">
	<b:glossaryEntry>become gelatinous; "the liquid jelled after we added the enzyme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200309228"
	 b:glossaryEntry='turn from a liquid to a solid mass; "his blood curdled"'/>
<rdf:Description rdf:about="&a;200309363"
	 b:glossaryEntry='go bad or sour; "The milk curdled"'/>
<rdf:Description rdf:about="&a;200309461"
	 b:glossaryEntry='become hard or harder; "The wax hardened"'/>
<rdf:Description rdf:about="&a;200309646"
	 b:glossaryEntry='make hard or harder; "The cold hardened the butter"'/>
<rdf:Description rdf:about="&a;200309849"
	 b:glossaryEntry="assume crystalline form; become crystallized"/>
<rdf:Description rdf:about="&a;200310006">
	<b:glossaryEntry>become liquid or fluid; of a solid substance, when heated; "the frozen fat liquefied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200310220">
	<b:glossaryEntry>make (a solid substance) liquid, as by heating; "liquefy the silver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200310395">
	<b:glossaryEntry>reduce from a solid to a liquid state, usually by heating; "melt butter"; "melt down gold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200310633">
	<b:glossaryEntry>melt (fat, lard, etc.) in order to separate out impurities; "try the yak butter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200310783"
	 b:glossaryEntry='become solid; "The metal solidified when it cooled"'/>
<rdf:Description rdf:about="&a;200310972"
	 b:glossaryEntry="make solid or more solid; cause to solidify"/>
<rdf:Description rdf:about="&a;200311143">
	<b:glossaryEntry>change from a liquid to a solid when cold; "Water freezes at 32 degrees Fahrenheit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200311317">
	<b:glossaryEntry>cause to form crystals or assume crystalline form; "crystallize minerals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200311485"
	 b:glossaryEntry='pass into a solution; "disslove sugar in coffee"'/>
<rdf:Description rdf:about="&a;200311612">
	<b:glossaryEntry>undergo solvation or convert into a solvate (a chemical process of association between different molecules)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200311784"
	 b:glossaryEntry="cause a solvation in (a substance)"/>
<rdf:Description rdf:about="&a;200311901">
	<b:glossaryEntry>undergo a chemical reaction; react with another substance under certain conditions; "The hydrogen and the oxygen react"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200312101"
	 b:glossaryEntry='improve the cleansing action of; build detergents"'/>
<rdf:Description rdf:about="&a;200312214"
	 b:glossaryEntry='cause to go into a solution; "dissolve sugar in water"'/>
<rdf:Description rdf:about="&a;200312407"
	 b:glossaryEntry='dissolve by breaking down the fat of; "soap cuts grease"'/>
<rdf:Description rdf:about="&a;200312524"
	 b:glossaryEntry='become weaker, as of sound or vision; "The sound faded out"'/>
<rdf:Description rdf:about="&a;200312672">
	<b:glossaryEntry>make valid or confirm the validity of, as of a document; "validate a ticket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200312840">
	<b:glossaryEntry>take away the legal force of or render ineffective; "invalidateas a contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200313029"
	 b:glossaryEntry='become empty or void of its content; "The room emptied"'/>
<rdf:Description rdf:about="&a;200313195"
	 b:glossaryEntry='empty completely; "We cleaned out all the drawers"'/>
<rdf:Description rdf:about="&a;200313342">
	<b:glossaryEntry>flow off or away gradually; "The water drained from the pipe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200313489"
	 b:glossaryEntry='drain of water; "bleed the radiators"'/>
<rdf:Description rdf:about="&a;200313589"
	 b:glossaryEntry='empty completely; "evacuate the bottle"'/>
<rdf:Description rdf:about="&a;200313702">
	<b:glossaryEntry>remove (water) from a boat by dipping and throwing over the side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200313843"
	 b:glossaryEntry="create a vacuum in (a bulb, flask, reaction vessel, etc.)"/>
<rdf:Description rdf:about="&a;200313984">
	<b:glossaryEntry>make void or empty of contents; "Empty the box"; "The alarm emptied the building"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200314352"
	 b:glossaryEntry='remove the occupants of; "Clear the building"'/>
<rdf:Description rdf:about="&a;200314478">
	<b:glossaryEntry>remove (people) from a building; "clear the patrons from the theater after the bomb threat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200314650"
	 b:glossaryEntry='rid of instructions or data; "clear a memory buffer"'/>
<rdf:Description rdf:about="&a;200314765">
	<b:glossaryEntry>use up the whole supply of; "We have exhaustet the food supplies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200314903"
	 b:glossaryEntry='empty (as of tobacco) by knocking out; "knocked out a pipe"'/>
<rdf:Description rdf:about="&a;200315029"
	 b:glossaryEntry='fill with people; "people a room"'/>
<rdf:Description rdf:about="&a;200315126">
	<b:glossaryEntry>empty of liquid; drain the liquid from; "We drained the oil tank"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200315280">
	<b:glossaryEntry>become full; "The pool slowly filled with water"; "The theater filled up slowly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200315504"
	 b:glossaryEntry='fill with tears; "His eyes were watering"'/>
<rdf:Description rdf:about="&a;200315608">
	<b:glossaryEntry>become filled to overflowing; "Our basement flooded during the heavy rains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200315746"
	 b:glossaryEntry="supply a rack with feed for (horses or other animals)"/>
<rdf:Description rdf:about="&a;200315864"
	 b:glossaryEntry='make full; "fill a container," "fill the child with pride"'/>
<rdf:Description rdf:about="&a;200316526"
	 b:glossaryEntry='fill to overflow; "heap the platter with potatoes"'/>
<rdf:Description rdf:about="&a;200316638"
	 b:glossaryEntry='fill beyond capacity; "overfill the baskets"'/>
<rdf:Description rdf:about="&a;200316764"
	 b:glossaryEntry='fill with ink; "ink a pen"'/>
<rdf:Description rdf:about="&a;200316851">
	<b:glossaryEntry>fill something that had previously been emptied; "refill my glass, please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200317030"
	 b:glossaryEntry='fill with priming liquid; "prime a car engine"'/>
<rdf:Description rdf:about="&a;200317147">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fill plentifully; "line one''s pockets"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200317263">
	<b:glossaryEntry>cause to spread or flush or flood through, over, or across; "The sky was suffused with a warm pink color"; also of liquids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200317468">
	<b:glossaryEntry>force a fluid through (a body part or tissue); "perfuse a liver with a salt solution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200317626">
	<b:glossaryEntry>to become overspread as with a fluid, a colour, a gleam of light: "His whole frame suffused with a cold dew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200317807">
	<b:glossaryEntry>cause to flow or flood with or as if with water; "flush the meadows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200317982"
	 b:glossaryEntry='flow freely; "The body washed down the river"'/>
<rdf:Description rdf:about="&a;200318115"
	 b:glossaryEntry='flow freely; "The garbage flushed down the river"'/>
<rdf:Description rdf:about="&a;200318253"
	 b:glossaryEntry='irrigate with water from a sluice; "sluice the earth"'/>
<rdf:Description rdf:about="&a;200318379">
	<b:glossaryEntry>rinse, clean, or empty with a liquid; "flush the wound with antibiotics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200318530">
	<b:glossaryEntry>bring to a whole, with all the necessary parts or elements; "A child would complete the family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200318699">
	<b:glossaryEntry>make complementary to; "I need some pepper to complement the sweet touch in the soup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200318860">
	<b:glossaryEntry>fill, soak, or imbue totally; "saturate the bandage with disinfectant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200319045">
	<b:glossaryEntry>make (a chemical compound, vapour, solution, magnetic material, etc.) saturated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200319198"
	 b:glossaryEntry='be equal or harmonize; "The two pieces match"'/>
<rdf:Description rdf:about="&a;200319306"
	 b:glossaryEntry='make match or correspond or harmonize; "Match my sweater"'/>
<rdf:Description rdf:about="&a;200319458">
	<b:glossaryEntry>make fit for use, as of appliances or cars; "service my truck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200319585">
	<b:glossaryEntry>make equal or homogeneous as by mixing; "homogenize the main ingredients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200319734">
	<b:glossaryEntry>become homogeneous or similar, as by mixing; "The two liquids homogenized in the blender"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200319891">
	<b:glossaryEntry>break up fat globules, as of dairy products; "homogenized milk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200320040"
	 b:glossaryEntry='turn into curds,as of dairy products; "curdled milk"'/>
<rdf:Description rdf:about="&a;200320199">
	<b:glossaryEntry>change from a liquid to a thickened or solid state; "coagulated blood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200320369"
	 b:glossaryEntry='go sour or spoil; "The milk has soured"'/>
<rdf:Description rdf:about="&a;200320487">
	<b:glossaryEntry>cause to undergo fermentation; "We ferment the grapes for a very long time to achieve high alcohol content"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200320703">
	<b:glossaryEntry>convert a juice into wine by fermentation; "vinify grape juice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200320830">
	<b:glossaryEntry xml:space='preserve'><![CDATA[urge to an unnatural speed; "Don''t rush me, please!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200320978"
	 b:glossaryEntry='act or move at high speed; "We have to rush!"'/>
<rdf:Description rdf:about="&a;200321115">
	<b:glossaryEntry>cause to be slowed down or delayed; "Traffic was delayed by the bad weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200321361">
	<b:glossaryEntry>delay or hold up; prevent from proceeding on schedule or as planned; "I was caught in traffic and missed the meeting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200321559">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deliberately delay an event or action; "she doesnt'' want to write the report, so she is stalling"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200321727">
	<b:glossaryEntry>act so as to delay an event or action in order to gain an advantage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200321868"
	 b:glossaryEntry='stop or halt; "Please stay the bloodshed!"'/>
<rdf:Description rdf:about="&a;200321989"
	 b:glossaryEntry='tighten the spring of (a mechanisms); wind up the toy"'/>
<rdf:Description rdf:about="&a;200322115">
	<b:glossaryEntry>run water over the ground to erode (soil), revealing the underlying strata and valuable minerals; in mining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200322284"
	 b:glossaryEntry='wash by removing particles; in mining; "Wash ores"'/>
<rdf:Description rdf:about="&a;200322396"
	 b:glossaryEntry='become quiet or still; fall silent; "hush my babay!"'/>
<rdf:Description rdf:about="&a;200322518">
	<b:glossaryEntry>cause to be quiet or not talk; "This threat ought to shut them up!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200322829">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to put down by force or authority; "suppress a nascent uprising", "stamp down on littering" "conquer one''s desires"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200323209">
	<b:glossaryEntry>limit the range or extent of; "Contact between the young was inhibited by strict social customs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200323378"
	 b:glossaryEntry='get rid of, silence, or suppress; "burke an issue"'/>
<rdf:Description rdf:about="&a;200323501"
	 b:glossaryEntry='suppress or crush completely; "squelch any sign of dissent"'/>
<rdf:Description rdf:about="&a;200323633"
	 b:glossaryEntry='become flat or flatter; "The landscape flattened"'/>
<rdf:Description rdf:about="&a;200323797"
	 b:glossaryEntry='flatten on impact; "The snowballs splatted on the trees"'/>
<rdf:Description rdf:about="&a;200323924">
	<b:glossaryEntry>make flat or flatter; "flatten a road", "flatten your stomach with these exercises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200324134">
	<b:glossaryEntry>split open and flatten for cooking, as of fish over an open fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200324261">
	<b:glossaryEntry>place in a line or arrange so as to be parallel; "align the car with the curb"; "align the sheets of paper on the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200324577">
	<b:glossaryEntry>align anew or better; "The surgeon realigned my jaw after the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200324723">
	<b:glossaryEntry>make level, square, balanced, or concentric; "true up the cylinder of an engine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200324875"
	 b:glossaryEntry="adjust the line of sight of (an optical instrument)"/>
<rdf:Description rdf:about="&a;200324993"
	 b:glossaryEntry="adjust with a plumb line so as to make vertical"/>
<rdf:Description rdf:about="&a;200325103"
	 b:glossaryEntry='move out of position; "dislocate joints"'/>
<rdf:Description rdf:about="&a;200325225">
	<b:glossaryEntry>bring (components or parts) into proper or desirable coordination correlation; "align the wheels of my car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200325408">
	<b:glossaryEntry>turn or place at an angle; "the lines on the sheet of paper are skewed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200325575">
	<b:glossaryEntry>make into a whole or make part of a whole; "She incorporated his suggestions into her proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200325849">
	<b:glossaryEntry>make something an integral part of something else; "we can build in a special clause to make the contract better for you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200326044"
	 b:glossaryEntry="incorporate again or anew"/>
<rdf:Description rdf:about="&a;200326149">
	<b:glossaryEntry>become one; become integrated; "The students at this school integrate immediately, despite their different backgrounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200326361">
	<b:glossaryEntry>make standard or the norm; "The weights and measures were standardized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200326513">
	<b:glossaryEntry>make normal or conform to a standard; "normalize relations with China"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200326672">
	<b:glossaryEntry>set or arrange in a new or different determinate position; "Orient the house towards the South"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200326923"
	 b:glossaryEntry='spoil the appearance of; "The vandals disfigured the statue"'/>
<rdf:Description rdf:about="&a;200327120">
	<b:glossaryEntry>change shape, as via computer animation; "In the video, Michael Jackson morphed into a panther"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200327278">
	<b:glossaryEntry>cause to change shape in a computer animation; "The computer programmer morphed the image"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200327473">
	<b:glossaryEntry>deteriorate through use or stress; "The constant friction wore out the cloth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200327698"
	 b:glossaryEntry='become limp; "The flowers wilted"'/>
<rdf:Description rdf:about="&a;200327801"
	 b:glossaryEntry='lose strength; "My opponent was wilting"'/>
<rdf:Description rdf:about="&a;200327911"
	 b:glossaryEntry='make chemically neutral; "She neutralized the solution"'/>
<rdf:Description rdf:about="&a;200328042">
	<b:glossaryEntry>make ineffective by counterbalancing the effect of; "Her optimism neutralizes his gloom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200328216">
	<b:glossaryEntry>make commercial; "Some Amish people have commercialized their way of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200328370">
	<b:glossaryEntry>kill in large numbers; "the plague wiped out an entire population"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200328583">
	<b:glossaryEntry>wipe out the effect of something; "The new tax effectively cancels out my raise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200328742">
	<b:glossaryEntry xml:space='preserve'><![CDATA[terminate or take out; "Let''s eliminate the course on Akkadian hieroglyphics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200329065"
	 b:glossaryEntry='eliminate; "knock out a target"'/>
<rdf:Description rdf:about="&a;200329171">
	<b:glossaryEntry>get rid of as if by submerging; "She drowned her trouble in alcohol"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200329310"
	 b:glossaryEntry='delete or remove; "Cut out the extra text"'/>
<rdf:Description rdf:about="&a;200329441"
	 b:glossaryEntry='be lively: "The music sparkled"'/>
<rdf:Description rdf:about="&a;200329545">
	<b:glossaryEntry>weed out unwanted or unnecessary things; "We had to lose weight, so we cut the sugar from our diet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200329781"
	 b:glossaryEntry='make perfect or complete; "perfect yur French in Paris!"'/>
<rdf:Description rdf:about="&a;200329953">
	<b:glossaryEntry>bring to a highly developed, finished, or refined state; "polish your social manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200330153">
	<b:glossaryEntry xml:space='preserve'><![CDATA[improve or perfect by pruning or polishing; "refine one''s style of writing"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200330354">
	<b:glossaryEntry>reduce to a fine, unmixed, or pure state; separate from extraneous matter or cleanse from impurities; "refine sugar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200330542">
	<b:glossaryEntry>treat or prepare so as to put in a usable condition; "refine paper stock"; "refine pig iron"; "refine oil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200330720"
	 b:glossaryEntry="cause to separate from solution or suspension"/>
<rdf:Description rdf:about="&a;200330852"
	 b:glossaryEntry="fall abruptly into a different condition"/>
<rdf:Description rdf:about="&a;200330961">
	<b:glossaryEntry>separate from solution as a fine suspension of solid particles, in chemistry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200331131"
	 b:glossaryEntry='remove impurities from; "purify the water"'/>
<rdf:Description rdf:about="&a;200331315"
	 b:glossaryEntry='rid of impurities; "purge your mind"'/>
<rdf:Description rdf:about="&a;200331414">
	<b:glossaryEntry>declare holy or pure or free from sin; "he left the monastery ourified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200331596">
	<b:glossaryEntry>purify from the corrupting influences of the world; "During his stay at the ashram he was spiritualized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200331770">
	<b:glossaryEntry>purify by means of a ritual; also used in post-Communist countries to refer to the political cleansing of former officials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200331958">
	<b:glossaryEntry>alter the shape of (something) by stress; "His body was deformed by leprosy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200332143"
	 b:glossaryEntry='contract; "Her skin drew in the cold air"'/>
<rdf:Description rdf:about="&a;200332246"
	 b:glossaryEntry='distort adversely: "Jealousy had jaundiced his judgment"'/>
<rdf:Description rdf:about="&a;200332368"
	 b:glossaryEntry='shape by blowing; "Blow a glass vase"'/>
<rdf:Description rdf:about="&a;200332467">
	<b:glossaryEntry>shape into a block or blocks; "block the graphs so one can see the results clearly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200332613"
	 b:glossaryEntry='shape by using a block: "Block a hat"; "block a garment"'/>
<rdf:Description rdf:about="&a;200332732">
	<b:glossaryEntry>become misshapen; "The sidewalk deformed during the earthquake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200332859"
	 b:glossaryEntry='form into the shape of a cup; "She cupped her hands"'/>
<rdf:Description rdf:about="&a;200332972"
	 b:glossaryEntry='make imperfect; "nothing marred her beauty"'/>
<rdf:Description rdf:about="&a;200333158">
	<b:glossaryEntry>put an end to; kill; "The Nazis snuffed out the life of many Jewish children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200333375">
	<b:glossaryEntry>destroy or extinguish as if by stamping with the foot; "Stamp fascism into submission"; "stamp out tyranny"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200333569"
	 b:glossaryEntry='extinguish by crushing; "stub out your cigar"'/>
<rdf:Description rdf:about="&a;200333717">
	<b:glossaryEntry xml:space='preserve'><![CDATA[mark for deletion or rule out; "kill these lines in the President''s speech"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200333886"
	 b:glossaryEntry='kill by submerging in water; "He drowned the kittens"'/>
<rdf:Description rdf:about="&a;200334002">
	<b:glossaryEntry>kill a large number of people indiscriminately; "The Hutus massacred the Tutsis in Rwanda"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200334181">
	<b:glossaryEntry>remove from memory or existence; "The Turks erased the Armenians in 1915"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200334352"
	 b:glossaryEntry='make mechanical; "mechanize the procedure:'/>
<rdf:Description rdf:about="&a;200334469"
	 b:glossaryEntry='make automatic; "automatize the production"'/>
<rdf:Description rdf:about="&a;200334617">
	<b:glossaryEntry>make semi-automatic; "Can we semi-autamotize the semantic tagging process?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200334773">
	<b:glossaryEntry>make monotonous; make automatic or routine; "If your work becomes too mechanized, change jobs!"</b:glossaryEntry>
</rdf:Description>
