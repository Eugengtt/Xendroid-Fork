</rdf:Description>
<rdf:Description rdf:about="&a;109256224"
	 b:glossaryEntry="coextensive with the family Ophioglossaceae"/>
<rdf:Description rdf:about="&a;109256389">
	<b:glossaryEntry>a family of succulent ferns of order Ophioglossales; cosmopolitan in distribution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109256633"
	 b:glossaryEntry="the type genus of the fern family Ophioglossaceae"/>
<rdf:Description rdf:about="&a;109256800"
	 b:glossaryEntry="ferns with fertile spikes shaped like a snake''s tongue"/>
<rdf:Description rdf:about="&a;109256974">
	<b:glossaryEntry>epiphytic fern with straplike usually twisted fronds of tropical Asia and Polynesia and America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109257151"
	 b:glossaryEntry="grape fern; moonwort"/>
<rdf:Description rdf:about="&a;109257285">
	<b:glossaryEntry>a fern of the genus Botrychium having a fertile frond bearing small grapelike clusters of spore cases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109257534"
	 b:glossaryEntry="of America and Eurasia and Australia"/>
<rdf:Description rdf:about="&a;109257664"
	 b:glossaryEntry="of North America and Eurasia"/>
<rdf:Description rdf:about="&a;109257815"
	 b:glossaryEntry="European fern with leathery and sparsely hairy fronds"/>
<rdf:Description rdf:about="&a;109257958">
	<b:glossaryEntry>American fern whose clustered sporangia resemble a snake''s rattle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109258111">
	<b:glossaryEntry>1 species: terrestrial fern of southeastern Asia and Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109258299">
	<b:glossaryEntry>Australasian fern with clusters of sporangia on stems of fertile fronds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109258479"
	 b:glossaryEntry="a variety of grainy club"/>
<rdf:Description rdf:about="&a;109258569">
	<b:glossaryEntry>a small pore especially one in the reproductive bodies of certain algae and fungi through which spores pass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109258730"
	 b:glossaryEntry="flask-shaped ascocarp"/>
<rdf:Description rdf:about="&a;109258809"
	 b:glossaryEntry="the dense colorless framework of a chloroplast"/>
<rdf:Description rdf:about="&a;109258908">
	<b:glossaryEntry>any of various small particles in the cytoplasm of the cells of plants and some animals containing pigments or starch or oil or protein</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109259133">
	<b:glossaryEntry>plastid containing pigments other than chlorophyll usually yellow or orange carotenoids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109259278">
	<b:glossaryEntry>plastid containing chlorophyll and other pigments; in plants that carry out photosynthesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109259426"
	 b:glossaryEntry="saprophytic and parasitic fungi that live on plants"/>
<rdf:Description rdf:about="&a;109259593">
	<b:glossaryEntry>family of fungi parasitic mostly on leaves; includes powdery mildews</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109259780"
	 b:glossaryEntry="genus of powdery mildews"/>
<rdf:Description rdf:about="&a;109259914">
	<b:glossaryEntry>any of various fungi of the genus Erysiphe producing powdery conidia on the host surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109260082">
	<b:glossaryEntry>large order of ascomycetous fungi usually having a dark hard perithecia with definite ostioles; in more recent classifications often divided among several orders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109260416">
	<b:glossaryEntry>parasitic fungi having globose and sometimes necked or beaked perithecia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109260607">
	<b:glossaryEntry>genus of fungi with black perithecia used extensively in genetic research; includes some forms with orange spore masses that cause severe damage in bakeries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109260858"
	 b:glossaryEntry="fungi having carbonous perithecia with long necks"/>
<rdf:Description rdf:about="&a;109261036"
	 b:glossaryEntry="genus of fungi forming continuous hyaline spores"/>
<rdf:Description rdf:about="&a;109261206"
	 b:glossaryEntry="fungus causing Dutch elm disease"/>
<rdf:Description rdf:about="&a;109261342"
	 b:glossaryEntry="used in some classifications for the family Hypocreaceae"/>
<rdf:Description rdf:about="&a;109261495">
	<b:glossaryEntry>family of fungi having brightly colored fleshy or membranous ascocarps; sometimes placed in its own order Hypocreales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109261749"
	 b:glossaryEntry="fungi parasitic upon the ovaries of various grasses"/>
<rdf:Description rdf:about="&a;109261912">
	<b:glossaryEntry>a fungus that infects various cereal plants forming compact black masses of branching filaments that replace many grains of the plant; source of medicinally important alkaloids and of lysergic acid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109262219"
	 b:glossaryEntry="a sclerotium or hardened mass of mycelium"/>
<rdf:Description rdf:about="&a;109262316"
	 b:glossaryEntry="any of various mushrooms of the family Hypocreaceae"/>
<rdf:Description rdf:about="&a;109262465"
	 b:glossaryEntry="a variety of mushroom pimple"/>
<rdf:Description rdf:about="&a;109262562"
	 b:glossaryEntry="a variety of mushroom pimple"/>
<rdf:Description rdf:about="&a;109262658"
	 b:glossaryEntry="family of fungi characterized by dark brown to back spores"/>
<rdf:Description rdf:about="&a;109262852">
	<b:glossaryEntry>type genus of Xylariaceae; fungi with perithecia in the upper part of erect black woody stromata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109263075"
	 b:glossaryEntry="fungus causing black root rot in apples"/>
<rdf:Description rdf:about="&a;109263216"
	 b:glossaryEntry="the fruiting bodies of the fungi of the genus Xylaria"/>
<rdf:Description rdf:about="&a;109263395">
	<b:glossaryEntry>fungi having smooth perithecia with dark one-celled ascospores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109263552">
	<b:glossaryEntry>order of fungi having asci in a disk- to goblet-shaped apothecium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109263769"
	 b:glossaryEntry="a fungus family of order Helotiales"/>
<rdf:Description rdf:about="&a;109263921"
	 b:glossaryEntry="type genus of the Helotiaceae"/>
<rdf:Description rdf:about="&a;109264041"
	 b:glossaryEntry="a fungus family of order Helotiales"/>
<rdf:Description rdf:about="&a;109264220">
	<b:glossaryEntry>large genus of ascomycetous fungi including various destructive plant pathogens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109264401">
	<b:glossaryEntry>any fungus of the genus Sclerotinia; some causing brown rot diseases in plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109264574"
	 b:glossaryEntry="a variety of sclerotinia"/>
<rdf:Description rdf:about="&a;109264673">
	<b:glossaryEntry>an order of fungi having a peridium surrounding an unchamered gleba (sometimes placed in subclass Homobasidiomycetes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109264935">
	<b:glossaryEntry>a family of fungi or order Sclerodermatales with a single-layered peridium; includes earthballs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109265159">
	<b:glossaryEntry>genus of poisonous fungi having hard-skinned fruiting bodies: false truffles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109265408">
	<b:glossaryEntry>any of various fungi of the genus Scleroderma having hard-skinned subterranean trufflelike fruiting bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109265694">
	<b:glossaryEntry>an earthball fungus that is a dingy brownish yellow and a dark purplish interior; the peridium is covered with a pattern of small warts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109265939">
	<b:glossaryEntry>an earthball with a smooth upper surface that is at first buried in sand; the top of the fruiting body opens up to form raylike segments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109266179">
	<b:glossaryEntry>an earthball with a peridium that is firm dry and smooth when young but developing cracks when mature; pale orange-yellow when young and reddish brown at maturity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109266445"
	 b:glossaryEntry="a variety of Gastromycete"/>
<rdf:Description rdf:about="&a;109266545"
	 b:glossaryEntry="a variety of Podaxaceae"/>
<rdf:Description rdf:about="&a;109266631"
	 b:glossaryEntry="stalked puffballs"/>
<rdf:Description rdf:about="&a;109266812"
	 b:glossaryEntry="type genus of the Tulostomaceae"/>
<rdf:Description rdf:about="&a;109266985"
	 b:glossaryEntry="puffball-like mushroom of the genus Tulostoma"/>
<rdf:Description rdf:about="&a;109267112">
	<b:glossaryEntry>an order of fungi belonging to the class Gasteromycetes; has a distinct basidiocarp with a fleshy or waxy gleba (sometimes placed in subclass Homobasidiomycetes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109267397">
	<b:glossaryEntry>a family of fungi of order Hymenogastrales having round subterranean sporophores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109267640">
	<b:glossaryEntry>any of various fungi of the family Rhizopogonaceae having subterranean fruiting bodies similar to the truffle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109267864">
	<b:glossaryEntry>a genus of fungi having subterranean sporophores resembling tubers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109268044">
	<b:glossaryEntry>a large whitish Rhizopogon that becomes grayish brown in maturity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109268196"
	 b:glossaryEntry="a genus of fungi belonging to the family Rhizopogonaceae"/>
<rdf:Description rdf:about="&a;109268376">
	<b:glossaryEntry>a fungus with a round yellow to orange fruiting body that is found on the surface of the ground or partially buried; has a distinctive sterile column extending into the spore-bearing tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109268654"
	 b:glossaryEntry="division of fungi having sexually produced zygospores"/>
<rdf:Description rdf:about="&a;109268869"
	 b:glossaryEntry="class of fungi coextensive with subdivision Zygomycota"/>
<rdf:Description rdf:about="&a;109269058"
	 b:glossaryEntry="an order of mostly saprophytic fungi"/>
<rdf:Description rdf:about="&a;109269206">
	<b:glossaryEntry>large family of chiefly saprophytic fungi that includes many common molds destructive to food products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109269442">
	<b:glossaryEntry>type genus of the Mucoraceae; genus of molds having cylindrical or pear-shaped sporangia not limited in location to points where rhizoids develop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109269683"
	 b:glossaryEntry="any mold of the genus Mucor"/>
<rdf:Description rdf:about="&a;109269781">
	<b:glossaryEntry>genus of rot-causing fungi having columnar hemispherical aerial sporangia anchored to the substrate by rhizoids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109270029"
	 b:glossaryEntry="any of various rot-causing fungi of the genus Rhizopus"/>
<rdf:Description rdf:about="&a;109270175"
	 b:glossaryEntry="a mold of the genus Rhizopus"/>
<rdf:Description rdf:about="&a;109270300">
	<b:glossaryEntry>fungus causing soft watery rot in fruits and vegetables and rings of dry rot around roots of sweet potatoes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109270524"
	 b:glossaryEntry="coextensive with the family Entomophthoraceae"/>
<rdf:Description rdf:about="&a;109270695">
	<b:glossaryEntry>mostly parasitic lower fungi that typically develop in the bodies of insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109270900">
	<b:glossaryEntry>type genus of the Entomophthoraceae; fungi parasitic on insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109271064">
	<b:glossaryEntry>any of various slender filaments that function as roots in mosses and ferns and fungi etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109271225">
	<b:glossaryEntry>a naked mass of protoplasm having characteristics of both plants and animals; sometimes classified as protoctists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109271445">
	<b:glossaryEntry>slime molds; organisms having a noncellular and multinucleate creeping vegetative phase and a propagative spore-producing stage: comprises Myxomycetes and Acrasiomycetes and Plasmodiophoromycetes; in some classifications placed in the kingdom_Protoctista</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109271872">
	<b:glossaryEntry>the class of true slime molds; essentially equivalent to the division Myxomycota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109272068"
	 b:glossaryEntry="a slime mold of the class Myxomycetes"/>
<rdf:Description rdf:about="&a;109272246">
	<b:glossaryEntry>cellular slime molds; in some classifications placed in Kingdom Protoctista</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109272462">
	<b:glossaryEntry>differing from true slime molds in being cellular and nucleate throughout the life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109272653">
	<b:glossaryEntry>genus of slime molds that grow on dung and decaying vegetation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109272818"
	 b:glossaryEntry="any slime mold of the genus Dictostylium"/>
<rdf:Description rdf:about="&a;109272936">
	<b:glossaryEntry>a large and probably unnatural group of fungi and funguslike organisms comprising the Mastigomycota (including the Oomycetes) and Zygomycota subdivisions of the division Eumycota; a category not used in all systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109273249">
	<b:glossaryEntry>fungi in which the spores and gametes are motile; in some systems placed in the Phycomycetes group with the Zygomycota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109273560">
	<b:glossaryEntry>nonphotosynthetic fungi that resemble algae and that reproduce by forming oospores; sometimes classified as protoctists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109273829">
	<b:glossaryEntry>a class of mostly aquatic fungi; saprophytic or parasitic on algae or fungi or plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109274059">
	<b:glossaryEntry>simple aquatic fungi mostly saprophytic but some parasitic on higher plants or animals or fresh water fungi; sometimes placed in class Oomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109274340">
	<b:glossaryEntry>an aquatic fungus of genus Synchytriaceae that is parasitic on pond scum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109274496"
	 b:glossaryEntry="a family of aquatic fungi of order Chytridiales"/>
<rdf:Description rdf:about="&a;109274645">
	<b:glossaryEntry>fungi that carry out asexual reproduction by thick-walled resting spores that produce zoospores upon germination; sometimes placed in class Oomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109274918"
	 b:glossaryEntry="a family of saprobic fungi of order Blastocladiales"/>
<rdf:Description rdf:about="&a;109275090"
	 b:glossaryEntry="a genus of fungi of the family Blastodiaceae"/>
<rdf:Description rdf:about="&a;109275233"
	 b:glossaryEntry="a fungus family of order Chytridiales"/>
<rdf:Description rdf:about="&a;109275393"
	 b:glossaryEntry="simple parasitic fungi including pond scum parasites"/>
<rdf:Description rdf:about="&a;109275580"
	 b:glossaryEntry="fungus causing potato wart disease in potato tubers"/>
<rdf:Description rdf:about="&a;109275742"
	 b:glossaryEntry="order of chiefly aquatic fungi"/>
<rdf:Description rdf:about="&a;109275894">
	<b:glossaryEntry>aquatic fungi growing chiefly on plant debris and animal remains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109276093">
	<b:glossaryEntry>a fungus that attacks living fish and tadpoles and spawn causing white fungus disease: a coating of white hyphae on especially peripheral parts (as fins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109276344">
	<b:glossaryEntry>parasitic or saprobic organisms living chiefly in fresh water or moist soil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109276495">
	<b:glossaryEntry>order of chiefly parasitic lower fungi: Albuginaceae and Peronosporaceae and Pythiaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109276742"
	 b:glossaryEntry="parasitic fungi: downy mildews"/>
<rdf:Description rdf:about="&a;109276916"
	 b:glossaryEntry="genus of destructive downy mildews"/>
<rdf:Description rdf:about="&a;109277104">
	<b:glossaryEntry>any of various fungi of the family Peronosporaceae parasitic on e.g. grapes and potatoes and melons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109277350">
	<b:glossaryEntry>fungus causing a serious disease in tobacco plants characterized by bluish-gray mildew on undersides of leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109277565"
	 b:glossaryEntry="fungus causing a downy mildew on onions"/>
<rdf:Description rdf:about="&a;109277707"
	 b:glossaryEntry="fungus causing a downy mildew on growing tobacco"/>
<rdf:Description rdf:about="&a;109277859">
	<b:glossaryEntry>fungi that produce white blister-like sori on certain flowering plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109278048"
	 b:glossaryEntry="type genus of the Albuginaceae; fungi causing white rusts"/>
<rdf:Description rdf:about="&a;109278211">
	<b:glossaryEntry>fungus causing a disease characterized by a white powdery mass of conidia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109278360">
	<b:glossaryEntry>fungi having sporangia usually borne successively and singly at the tips of branching sporangiophores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109278596"
	 b:glossaryEntry="destructive root-parasitic fungi"/>
<rdf:Description rdf:about="&a;109278726"
	 b:glossaryEntry="any fungus of the genus Pythium"/>
<rdf:Description rdf:about="&a;109278848"
	 b:glossaryEntry="fungus causing damping off disease in seedlings"/>
<rdf:Description rdf:about="&a;109278981"
	 b:glossaryEntry="destructive parasitic fungi causing brown rot in plants"/>
<rdf:Description rdf:about="&a;109279173"
	 b:glossaryEntry="causes brown rot gummosis in citrus fruits"/>
<rdf:Description rdf:about="&a;109279306">
	<b:glossaryEntry>fungus causing late blight in solanaceous plants especially tomatoes and potatoes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109279475"
	 b:glossaryEntry="family of fungi often causing hypertrophy in seed plants"/>
<rdf:Description rdf:about="&a;109279662">
	<b:glossaryEntry>type genus of Plasmodiophoracea comprising minute plant parasitic fungi similar to and sometimes included among the slime molds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109279911">
	<b:glossaryEntry>slime-mold-like fungus causing swellings or distortions of the roots of cabbages and related plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109280118"
	 b:glossaryEntry="a type of ascomycetous fungus"/>
<rdf:Description rdf:about="&a;109280206"
	 b:glossaryEntry="a type of ascomycetous fungus"/>
<rdf:Description rdf:about="&a;109280405"
	 b:glossaryEntry="a common name for a variety of Sarcosomataceae"/>
<rdf:Description rdf:about="&a;109280512"
	 b:glossaryEntry="a common name for a variety of Sarcosomataceae"/>
<rdf:Description rdf:about="&a;109280622"
	 b:glossaryEntry="a common name for a variety of Sarcosomataceae"/>
<rdf:Description rdf:about="&a;109280734"
	 b:glossaryEntry="a common name for a variety of Sarcosomataceae"/>
<rdf:Description rdf:about="&a;109280840"
	 b:glossaryEntry="a common name for a variety of Sarcosomataceae"/>
<rdf:Description rdf:about="&a;109280944"
	 b:glossaryEntry="a common name for a variety of Sarcosomataceae"/>
<rdf:Description rdf:about="&a;109281047">
	<b:glossaryEntry>small order of fungi belonging to the subdivision Ascomycota having closed underground ascocarps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109281255">
	<b:glossaryEntry>family of fungi whose ascocarps resemble tubers and vary in size from that of an acorn to that of a large apple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109281481">
	<b:glossaryEntry>type genus of the Tuberaceae: fungi whose fruiting bodies are typically truffles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109281665">
	<b:glossaryEntry>any of various highly prized edible subterranean fungi of the genus Tuber; grow naturally in southwestern Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109281874"
	 b:glossaryEntry="fleshy fungi: coral fungi"/>
<rdf:Description rdf:about="&a;109282018"
	 b:glossaryEntry="a club-shaped coral fungus"/>
<rdf:Description rdf:about="&a;109282102">
	<b:glossaryEntry>any of numerous fungi of the family Clavariaceae often brightly colored that grow in often intricately branched clusters like coral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109282329"
	 b:glossaryEntry="tooth_fungi"/>
<rdf:Description rdf:about="&a;109282472"
	 b:glossaryEntry="a fungus of the family Hydnaceae"/>
<rdf:Description rdf:about="&a;109282582"
	 b:glossaryEntry="type genus of Hydnaceae"/>
<rdf:Description rdf:about="&a;109282692">
	<b:glossaryEntry>comprising the lichens which grow symbiotically with algae; sometimes treated as an independent group more or less coordinate with Algae and Fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109283103">
	<b:glossaryEntry>category used especially in former classifications for organisms now constituting the division Lichenes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109283301">
	<b:glossaryEntry>any thallophytic plant of the division Lichenes; occur as crusty patches or bushy growths on tree trunks or rocks or bare ground etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109283668"
	 b:glossaryEntry="a lichen in which the fungus component is an ascomycete"/>
<rdf:Description rdf:about="&a;109283780"
	 b:glossaryEntry="a lichen in which the fungus component is a basidiomycete"/>
<rdf:Description rdf:about="&a;109283897">
	<b:glossaryEntry>category used in some classification systems for all lichens that produce apothecia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109284079"
	 b:glossaryEntry="a fungus family of the division Lichenes"/>
<rdf:Description rdf:about="&a;109284238"
	 b:glossaryEntry="type genus of Lecanoraceae; crustaceous lichens"/>
<rdf:Description rdf:about="&a;109284403">
	<b:glossaryEntry>any lichen of the genus Lecanora; some used in dyeing; some used for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109284586">
	<b:glossaryEntry>any of several Old World semicrustaceous or shrubby lecanoras that roll up and are blown about over African and Arabian deserts and used as food by people and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109284811"
	 b:glossaryEntry="any of various lecanoras that yield the dye archil"/>
<rdf:Description rdf:about="&a;109284942"
	 b:glossaryEntry="a fungus family of division Lichenes"/>
<rdf:Description rdf:about="&a;109285097"
	 b:glossaryEntry="chiefly fruticose maritime rock-inhabiting lichens"/>
<rdf:Description rdf:about="&a;109285246"
	 b:glossaryEntry="a source of the dye archil and of litmus"/>
<rdf:Description rdf:about="&a;109285381"
	 b:glossaryEntry="a fungus family of division Lichenes"/>
<rdf:Description rdf:about="&a;109285540">
	<b:glossaryEntry>crustose lichens that are a source of the dye archil and of litmus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109285701">
	<b:glossaryEntry>fruticose lichens having prostrate or erect or pendullus thalli: genera Usnea; Evernia; Ramalina; Alectoria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109285940">
	<b:glossaryEntry>widely distributed lichens usually having a grayish or yellow pendulous freely branched thallus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109286139"
	 b:glossaryEntry="greenish gray pendulous lichen growing on trees"/>
<rdf:Description rdf:about="&a;109286293">
	<b:glossaryEntry>lichens having dark brown erect or pendulous much-branched cylindrical thallus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109286483">
	<b:glossaryEntry>any of several lichens of the genus Alectoria having a thallus consisting of filaments resembling hair</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109286686"
	 b:glossaryEntry="a family of lichens"/>
<rdf:Description rdf:about="&a;109286824">
	<b:glossaryEntry>type genus of Cladoniaceae; lichens characterized by a crustose thallus and capitate fruiting bodies borne on simple or branched podetia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109287070">
	<b:glossaryEntry>an erect grayish branching lichen of Arctic and even some north temperate regions constituting the chief food for reindeer and caribou and sometimes being eaten by humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109287374"
	 b:glossaryEntry="a family of lichens"/>
<rdf:Description rdf:about="&a;109287531">
	<b:glossaryEntry>type genus of the Parmeliaceae; a large genus of chiefly alpine foliaceous lichens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109287723">
	<b:glossaryEntry>any of several lichens of the genus Parmelia from which reddish brown or purple dyes are made</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109287908"
	 b:glossaryEntry="foliose lichens chiefly of northern latitudes"/>
<rdf:Description rdf:about="&a;109288063">
	<b:glossaryEntry>lichen with branched flattened partly erect thallus that grows in mountainous and arctic regions; used as a medicine or food for humans and livestock; a source of glycerol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109288350"
	 b:glossaryEntry="the taxonomic kingdom of lower plants"/>
<rdf:Description rdf:about="&a;109288624">
	<b:glossaryEntry>a parasitic plant lacking chlorophyll and leaves and true stems and roots and reproducing by spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109290095">
	<b:glossaryEntry>a small club-shaped structure typically bearing four basidiospores at the ends of minute projections; unique to basidiomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109290295">
	<b:glossaryEntry>special cell constituting the base of the basidium in various fungi especially of the order Tremellales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109290476">
	<b:glossaryEntry>true fungi; eukaryotic heterotrophic walled organisms; distinguished from Myxomycota (funguslike slime molds): comprises subdivisions Mastigomycotina; Zygomycotina; Ascomycotina; Basidiomycotina; Deuteromycotina (imperfect fungi)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109290932">
	<b:glossaryEntry>category used in some classifications: coextensive with division Eumycota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109291098"
	 b:glossaryEntry="any of numerous fungi of the division Eumycota"/>
<rdf:Description rdf:about="&a;109291221">
	<b:glossaryEntry>large and heterogeneous form division of fungi comprising forms for which no sexually reproductive stage is known: orders Sphaeropsidales; Melanconiales; Moniliales; Mycelia_sterilia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109291634"
	 b:glossaryEntry="form class; coextensive with subdivision Deuteromycota"/>
<rdf:Description rdf:about="&a;109291791">
	<b:glossaryEntry>comprises fungi bearing the spores on a basidium: Gasteromycetes (puffballs); Tiliomycetes (comprising the orders Ustilaginales (smuts) and Uredinales (rusts)); Hymenomycetes (mushrums; toadstools; agarics; bracket fungi); in some classification systems considered a division of kingdom Fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109292391">
	<b:glossaryEntry>large class of higher fungi coextensive with subdivision Basidiomycota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109292678">
	<b:glossaryEntry>category used in some classification systems for various basidiomycetous fungi including e.g. mushrooms and puffballs which are usually placed in the classes Gasteromycetes and Hymenomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109292982">
	<b:glossaryEntry>category used in some classification systems for various basidiomycetous fungi including rusts and smuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109293204"
	 b:glossaryEntry="any of various fungi of the subdivision Basidiomycota"/>
<rdf:Description rdf:about="&a;109293451">
	<b:glossaryEntry>any of various fleshy fungi of the subdivision Basidiomycota consisting of a cap at the end of a stem arising from an underground mycelium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109293662">
	<b:glossaryEntry>used in some classifications; usually coextensive with order Agaricales: mushrooms; toadstools; agarics; bracket fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109293881">
	<b:glossaryEntry>typical gilled mushrooms belonging to the subdivision Basidiomycota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109294347">
	<b:glossaryEntry>a saprophytic fungus of the order Agricales having an umbrellalike cap with gills on the underside</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109295885"
	 b:glossaryEntry="large family including many familiar mushrooms"/>
<rdf:Description rdf:about="&a;109296181">
	<b:glossaryEntry>type genus of Agaricaceae; gill fungi having brown spores and including several edible species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109296404">
	<b:glossaryEntry>common name for an edible agaric (contrasting with the inedible toadstool)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109296551">
	<b:glossaryEntry>common name for an inedible or poisonous agaric (contrasting with the edible mushroom)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109296711">
	<b:glossaryEntry>coarse edible mushroom with a hollow stem and abroad white cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109296873">
	<b:glossaryEntry>common edible mushroom found naturally in moist open soil; the cultivated mushroom of commerce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109297087"
	 b:glossaryEntry="a genus of fungus belonging to the family Tricholomataceae"/>
<rdf:Description rdf:about="&a;109297274">
	<b:glossaryEntry>edible east Asian mushroom having a golden or dark brown to blackish cap and an inedible stipe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109297553">
	<b:glossaryEntry>a fungus with a scaly cap and white flesh and a ring on the stalk (with scales below the ring); odor reminiscent of licorice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109297777">
	<b:glossaryEntry>genus of widely distributed white-spored agarics being poisonous with few exceptions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109298082"
	 b:glossaryEntry="widely distributed edible mushroom resembling the fly agaric"/>
<rdf:Description rdf:about="&a;109298257"
	 b:glossaryEntry="agaric often confused with the death cup"/>
<rdf:Description rdf:about="&a;109298393">
	<b:glossaryEntry>poisonous (but rarely fatal) woodland fungus having a scarlet cap with white warts and white gills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109298586">
	<b:glossaryEntry>extremely poisonous usually white fungus with a prominent cup-shaped base; differs from edible Agaricus only in its white gills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109298854"
	 b:glossaryEntry="yellowish edible agaric that usually turns red when touched"/>
<rdf:Description rdf:about="&a;109299026"
	 b:glossaryEntry="fungus similar to Amanita_phalloides"/>
<rdf:Description rdf:about="&a;109299160"
	 b:glossaryEntry="a mushroom of the genus Amanita"/>
<rdf:Description rdf:about="&a;109299288"
	 b:glossaryEntry="a type of slime mushroom"/>
<rdf:Description rdf:about="&a;109299379"
	 b:glossaryEntry="a type of slime mushroom"/>
<rdf:Description rdf:about="&a;109299474">
	<b:glossaryEntry>a well-known genus of fungus; has funnel-shaped fruiting body; includes the chanterelles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109299737">
	<b:glossaryEntry>widely distributed edible mushroom rich yellow in color with a smooth cap and a pleasant apricot aroma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109299954">
	<b:glossaryEntry>a mildly poisonous fungus with a fruiting body shaped like a hollow trumpet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109300140">
	<b:glossaryEntry>an edible agaric with a brown fruiting body that is often compound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109300306"
	 b:glossaryEntry="mushroom with a distinctive pink to vermillion fruiting body"/>
<rdf:Description rdf:about="&a;109300480"
	 b:glossaryEntry="a genus of mushrooms with a depressed disc in the cap"/>
<rdf:Description rdf:about="&a;109300647">
	<b:glossaryEntry>a large poisonous agaric with orange caps and narrow clustered stalks; the gills are luminescent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109300886">
	<b:glossaryEntry>genus of black-spotted agarics in which the cap breaks down at maturity into an inky fluid; sometimes placed in its own family Coprinaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109301153"
	 b:glossaryEntry="used in some classifications for the genus Coprinus"/>
<rdf:Description rdf:about="&a;109301302">
	<b:glossaryEntry>having a cap that melts into an inky fluid after spores have matured</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109301489">
	<b:glossaryEntry>common edible mushroom having an elongated shaggy white cap and black spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109301694">
	<b:glossaryEntry>large genus of white-spored agarics that include a white or milky juice when cut or broken; includes both edible and poisonous species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109301940"
	 b:glossaryEntry="edible mushroom"/>
<rdf:Description rdf:about="&a;109302050"
	 b:glossaryEntry="chiefly small white-spored mushrooms"/>
<rdf:Description rdf:about="&a;109302198"
	 b:glossaryEntry="mushroom that grows in a fairy ring"/>
<rdf:Description rdf:about="&a;109302338">
	<b:glossaryEntry>a ring of fungi marking the periphery of the perennial underground growth of the mycelium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109302499">
	<b:glossaryEntry>white-spored agarics with caps having an eccentric stem; an important mushroom of Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109302717">
	<b:glossaryEntry>edible agaric with a soft grayish cap growing in shelving masses on dead wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109302929"
	 b:glossaryEntry="red luminescent mushroom of Europe"/>
<rdf:Description rdf:about="&a;109303070">
	<b:glossaryEntry>genus of brown-spored gilled agarics of Europe and North America having an annulus and growing on open ground or decaying wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109303458">
	<b:glossaryEntry>a fungus with a smooth orange cap and yellow gills and pale yellow stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109303616">
	<b:glossaryEntry>a beautiful yellow gilled fungus found from Alaska south along the coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109303786">
	<b:glossaryEntry>a large fungus with shitish scales on the cap and remnants of the veil hanging from the cap; the stalk is thick and hard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109303990">
	<b:glossaryEntry>a fungus with a yellow cap covered with fine scales as is the stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109304140">
	<b:glossaryEntry>a fungus that grows in clusters on the ground; cap is brownish orange with a surface that is smooth and slightly sticky; whitish gills and a cylindrical brown stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109304386"
	 b:glossaryEntry="one of the most important fungi cultivated in Japan"/>
<rdf:Description rdf:about="&a;109304545">
	<b:glossaryEntry>a gilled fungus having yellow slimy caps with conspicuous tawny scales on the caps and stalks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109304730">
	<b:glossaryEntry>a gilled fungus with a cap and stalk that are conspicuously scaly with upright scales; gills develop a greenish tinge with age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109304957"
	 b:glossaryEntry="a pale buff fungus with tawny scales"/>
<rdf:Description rdf:about="&a;109305081">
	<b:glossaryEntry>large genus of stout-stemmed white-spored fungi with neither annulus nor volva; brittle caps of red or purple or yellow or green or blue; differs from genus Lactarius in lacking milky juice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109305359"
	 b:glossaryEntry="used in some classification systems for the genus Russula"/>
<rdf:Description rdf:about="&a;109305514"
	 b:glossaryEntry="sometimes included in family Agaricaceae"/>
<rdf:Description rdf:about="&a;109305696">
	<b:glossaryEntry>genus of brown-spored gill fungi closely related to Agaricus; here placed in its own family Strophariaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109305976">
	<b:glossaryEntry>a gilled fungus with a long stalk and a yellow slimy cap from which fragments of the broken veil hang; gills are initially white but become dark brown as spores are released</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109306233">
	<b:glossaryEntry>a gilled fungus with a large slimy purple or olive cap; gills become purple with age; the stalk is long and richly decorated with pieces of the white sheath that extends up to a ring</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109306503">
	<b:glossaryEntry>a large gilled fungus with a broad cap and a long stalk; the cap is dark brown; the white gills turn dark purplish brown with age; edible and choice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109306743"
	 b:glossaryEntry="a basidiomycete with gills"/>
<rdf:Description rdf:about="&a;109306827">
	<b:glossaryEntry>any of the radiating leaflike spore-producing structures on the underside of the cap of a mushroom or similar fungus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109307004"
	 b:glossaryEntry="a family of fungi belonging to the order Agaricales"/>
<rdf:Description rdf:about="&a;109307178">
	<b:glossaryEntry>pink-spored agarics lacking both volva and annulus and including some that are poisonous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109307395">
	<b:glossaryEntry>a deadly poisonous agaric; a large cap that is first white (livid or lead-colored) and then turns yellowish or tan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109307611">
	<b:glossaryEntry>an agaric with a dark brown conical cap; fruits in early spring</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109307755">
	<b:glossaryEntry>a family of fungi having free gills and a cap that is cleanly separable from the stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109307977"
	 b:glossaryEntry="a genus of fungus belonging to the family Lepiotaceae"/>
<rdf:Description rdf:about="&a;109308115">
	<b:glossaryEntry>a poisonous agaric with a fibrillose cap and brown scales on a white ground color; cap can reach a diameter of 30 cm; often forms `fairy rings''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109308329">
	<b:glossaryEntry>white-spored agarics including several edible and poisonous mushrooms: parasol mushrooms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109308667"
	 b:glossaryEntry="any fungus of the genus Lepiota"/>
<rdf:Description rdf:about="&a;109308897">
	<b:glossaryEntry>edible long-stalked mushroom with white flesh and gills and spores; found in open woodlands in autumn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109309098"
	 b:glossaryEntry="an agaric regarded as poisonous"/>
<rdf:Description rdf:about="&a;109309230">
	<b:glossaryEntry>an agaric with grayish white fruiting body and gills that change from pink to dingy red</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109309398">
	<b:glossaryEntry>an agaric with a large cap with brown scales and a thick stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109309542">
	<b:glossaryEntry>an agaric with a pallid cap and a stalk that is enlarged near the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109309714">
	<b:glossaryEntry>an agaric with a relatively small pink to red cap and white gills and stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109309874"
	 b:glossaryEntry="an agaric with a ragged stalk and a soft floccose cap"/>
<rdf:Description rdf:about="&a;109310012">
	<b:glossaryEntry>a white agaric that tends to cluster and has a club-shaped base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109310173"
	 b:glossaryEntry="fungi having leathery or membranous sporaphores"/>
<rdf:Description rdf:about="&a;109310362">
	<b:glossaryEntry>genus of fungi having simple smooth-surfaced sporophores; some are parasitic on wood or economic crops; some species formerly placed in form genus Rhizoctinia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109310651">
	<b:glossaryEntry>fungus causing pink disease in citrus and coffee and rubber trees etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109310830"
	 b:glossaryEntry="fungus causing bottom rot in lettuce"/>
<rdf:Description rdf:about="&a;109310968">
	<b:glossaryEntry>genus of fungi having the hymenium in the form of a crust; some species formerly placed in the form genus Rhizoctinia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109311222">
	<b:glossaryEntry>fungus causing a disease in potatoes characterized by black scurfy spots on the tubers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109311435">
	<b:glossaryEntry>fungus causing a disease in coffee and some other tropical plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109311603"
	 b:glossaryEntry="a family of fungi belonging to the order Agaricales"/>
<rdf:Description rdf:about="&a;109311895">
	<b:glossaryEntry>white-spored agarics with a fleshy stalk and notched gills; of various colors both edible and inedible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109312244">
	<b:glossaryEntry>edible agaric that is pale lilac when young; has a smooth moist cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109312382">
	<b:glossaryEntry>an edible agaric that fruits in great clusters (especially in sandy soil under cottonwood trees)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109312581">
	<b:glossaryEntry>a mildly poisonous agaric with a viscid reddish brown cap and white gills and stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109312752">
	<b:glossaryEntry>an agaric with a cap that is coated with dark fibrils in the center and has yellowish margins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109312931">
	<b:glossaryEntry>an edible agaric with yellow gills and a viscid yellow cap that has a brownish center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109313121"
	 b:glossaryEntry="a poisonous white agaric"/>
<rdf:Description rdf:about="&a;109313230"
	 b:glossaryEntry="a poisonous agaric having a pale cap with fine gray fibrils"/>
<rdf:Description rdf:about="&a;109313374">
	<b:glossaryEntry>an agaric with a cap that is densely covered with reddish fibrils and pale gills an stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109313548">
	<b:glossaryEntry>an orange tan agaric whose gills become brown by maturity; has a strong odor and taste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109313720"
	 b:glossaryEntry="a family of fungi belonging to the order Agaricales"/>
<rdf:Description rdf:about="&a;109313890"
	 b:glossaryEntry="agarics having pink spores and a distinct volva"/>
<rdf:Description rdf:about="&a;109314047"
	 b:glossaryEntry="a parasite on various trees"/>
<rdf:Description rdf:about="&a;109314158"
	 b:glossaryEntry="a family of fungi belonging to the order Agaricales"/>
<rdf:Description rdf:about="&a;109314343">
	<b:glossaryEntry>a large genus of fungi belonging to the family Pluteaceae; the shape of the cap resembles a roof; often abundant early in the summer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109314637"
	 b:glossaryEntry="an agaric with a brilliant scarlet cap and a slender stalk"/>
<rdf:Description rdf:about="&a;109314784">
	<b:glossaryEntry>an edible agaric found in piles of hardwood sawdust; the caps are black and coarsely wrinkled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109314976">
	<b:glossaryEntry>a small edible agaric with a slender stalk; usually found on rotting hardwoods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109315152"
	 b:glossaryEntry="an important genus of mushrooms in the Orient"/>
<rdf:Description rdf:about="&a;109315332">
	<b:glossaryEntry>small tropical and subtropical edible mushroom having a white cap and long stem; an expensive delicacy in China and other Asian countries where it is grown commercially</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109315622"
	 b:glossaryEntry="a mushroom with a dry yellowish to white fibrillose cap"/>
<rdf:Description rdf:about="&a;109315764">
	<b:glossaryEntry>a genus of agarics with white to pale yellow spore deposits and fleshy stalks centrally attached to the cap and closely attached gills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109316105">
	<b:glossaryEntry>an agaric with a flat cap that is grayish or yellowish brown with pallid gills and a stalk that bulges toward the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109316307">
	<b:glossaryEntry>a small poisonous agaric; has a dry white cap with crowded gills and a short stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109316473">
	<b:glossaryEntry>a fungus with a cap that is creamy gray when young and turns brown with age and a whitish stalk that stains yellow when handled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109316684"
	 b:glossaryEntry="a large white agaric; edible but not palatable"/>
<rdf:Description rdf:about="&a;109316830">
	<b:glossaryEntry>an edible agaric with large silky white caps and thick stalks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109317008">
	<b:glossaryEntry>an edible white agaric that fruits in dense clusters; the gills are narrow and crowded and the stalk in fleshy and unpolished</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109317219"
	 b:glossaryEntry="a genus of agarics"/>
<rdf:Description rdf:about="&a;109317351">
	<b:glossaryEntry>an edible agaric that is available in early spring or late fall when few other mushrooms are; has a viscid smooth orange to brown cap and a velvety stalk that turns black in maturity and pallid gills; often occur in clusters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109317679">
	<b:glossaryEntry>any of the threadlike filaments forming the mycelium of a fungus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109317850">
	<b:glossaryEntry>the vegetative part of a fungus consisting of a mass of branching threadlike hyphae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109318044">
	<b:glossaryEntry>compact usually dark-colored mass of hardened mycelium constituting a vegetative food-storage body in various true fungi; detaches when mature and can give rise to new growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109318275">
	<b:glossaryEntry>any of various ascomycetous fungi in which the spores are formed in a sac or ascus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109318433">
	<b:glossaryEntry>a large subdivision of Eumycota including Hemiascomycetes and Plectomycetes and Pyrenomycetes and Discomycetes; sac fungi; in some classification systems considered a division of the kingdom Fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109318924">
	<b:glossaryEntry>large class of higher fungi coextensive with division Ascomycota: sac fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109319153">
	<b:glossaryEntry>any fungus of the class Ascomycetes (or subdivision Ascomycota) in which the spores are formed inside an ascus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109319471"
	 b:glossaryEntry="category not used in many classification systems"/>
<rdf:Description rdf:about="&a;109319623"
	 b:glossaryEntry="any of various mushrooms of the class Ascomycete"/>
<rdf:Description rdf:about="&a;109319775"
	 b:glossaryEntry="a variety of grainy_club_mushrooms"/>
<rdf:Description rdf:about="&a;109319885">
	<b:glossaryEntry>class of fungi in which no ascocarps are formed: yeasts and some plant parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109320089">
	<b:glossaryEntry>fungi having a zygote or a single cell developing directly into an ascus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109320319">
	<b:glossaryEntry>family of fungi comprising the typical yeasts: reproduce by budding and ferment carbohydrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109320543">
	<b:glossaryEntry>single-celled yeasts that reproduce asexually by budding; used to ferment carbohydrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109320769">
	<b:glossaryEntry>any of various single-celled fungi that reproduce asexually by budding or division</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109320959"
	 b:glossaryEntry="used as a leaven in baking and brewing"/>
<rdf:Description rdf:about="&a;109321120"
	 b:glossaryEntry="used in making wine"/>
<rdf:Description rdf:about="&a;109321251"
	 b:glossaryEntry="a family of fungi belonging to order Endomycetales"/>
<rdf:Description rdf:about="&a;109321444">
	<b:glossaryEntry>type and only genus of Schizosaccharomycetaceae; comprises the fission yeasts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109321634">
	<b:glossaryEntry>class of fungi in which the fruiting body is a cleistothecium (it releases spores only on decay or disintegration)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109321868">
	<b:glossaryEntry>order of fungi having a closed ascocarp (cleistothecium) with the asci scattered rather than gathered into a hymenial layer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109322162"
	 b:glossaryEntry="a genus of fungi belonging to the order Eurotiales"/>
<rdf:Description rdf:about="&a;109322303"
	 b:glossaryEntry="family of fungi including some common molds"/>
<rdf:Description rdf:about="&a;109322488">
	<b:glossaryEntry>genus of common molds causing food spoilage and some pathogenic to plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109322670"
	 b:glossaryEntry="a mold causing aspergillosis in birds and man"/>
<rdf:Description rdf:about="&a;109322783">
	<b:glossaryEntry>genus of fungi having spherical brown perithecia and some conidia borne in chains; cause root rot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109322992">
	<b:glossaryEntry>fungus causing brown root rot in plants of the pea and potato and cucumber families</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109323183">
	<b:glossaryEntry>class of fungi in which the fruiting body is a perithecium; includes powdery mildews and ergot and neurospora</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109323450">
	<b:glossaryEntry>a large and taxonomically difficult group of Ascomycetes in which the fleshy fruiting body is disklike or cup-shaped</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109323706"
	 b:glossaryEntry="any fungus that is a member of the subclass Discomycetes"/>
<rdf:Description rdf:about="&a;109324032">
	<b:glossaryEntry>a discomycete that develops in clusters of slippery rubbery gelatinous fruiting bodies that are dingy yellow to tan in color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109324217">
	<b:glossaryEntry>a discomycete that is 3-8 cm high with an orange to yellow fertile portion and white or pinkish stalks often half in and half out of the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109324421">
	<b:glossaryEntry>a discomycete that is a harbinger of spring; the fruiting body is thin and tough and saucer-shaped (about the size of quarter to a half dollar) with a deep bright red upper surface and a whitish exterior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109324705">
	<b:glossaryEntry>an early spring variety of discomycete with yellow to orange yellow lining of the cup</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109324855">
	<b:glossaryEntry>a discomycete with bright orange cup-shaped or saucer-shaped fruiting bodies and pale orange exteriors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109325041">
	<b:glossaryEntry>order of mostly saprophytic fungi having cup-shaped ascocarps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109325252"
	 b:glossaryEntry="large family comprising many typical cup fungi"/>
<rdf:Description rdf:about="&a;109325432"
	 b:glossaryEntry="apothecium of a fungus of the family Pezizaceae"/>
<rdf:Description rdf:about="&a;109325533"
	 b:glossaryEntry="type genus of the Pezizaceae: a variety of cup fungus"/>
<rdf:Description rdf:about="&a;109325711">
	<b:glossaryEntry>a discomycetous fungus of the genus Peziza; the fragile fruiting body is a ghostly white but stains yellow when broken; favors strongly alkaline habitats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109325947"
	 b:glossaryEntry="a scarlet European fungus with cup-shaped ascocarp"/>
<rdf:Description rdf:about="&a;109326102">
	<b:glossaryEntry>genus of fungi in the family Pezizaceae closely related to and often included in genus Peziza</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109326288"
	 b:glossaryEntry="an urn-shaped discomycete with a nearly black interior"/>
<rdf:Description rdf:about="&a;109326418">
	<b:glossaryEntry>the cup-shaped fruiting body of this discomycete has a jellylike interior and a short stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109326569">
	<b:glossaryEntry>the fruiting bodies of this discomycete have a firm texture and long retain their cup shape; the pale brown interior blends with the color of dead leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109326785"
	 b:glossaryEntry="a family of edible fungi including the true morels"/>
<rdf:Description rdf:about="&a;109327051"
	 b:glossaryEntry="genus of edible fungi: morel"/>
<rdf:Description rdf:about="&a;109327210">
	<b:glossaryEntry>any of various edible mushrooms of the genus Morchella having a brownish spongelike cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109327476">
	<b:glossaryEntry>an edible and choice morel with a globular to elongate head with an irregular pattern of pits and ridges</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109327713">
	<b:glossaryEntry>an edible morel with a cup-shaped or saucer-shaped fruiting body can be up to 20 cm wide; the fertile surface inside the cup has wrinkles radiating from the center; can be easily confused with inedible mushrooms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109328018">
	<b:glossaryEntry>a morel whose fertile portion resembles a bell and is attached to the stipe only at the top</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109328229">
	<b:glossaryEntry>resembles a thimble on a finger; the surface of the fertile portion is folded into wrinkles that extend from the top down; fruiting begins in spring before the leaves are out on the trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109328491">
	<b:glossaryEntry>a morel with a fertile portion that has a relatively smooth surface; the stalk is fragile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109328672">
	<b:glossaryEntry>a morel whose pitted fertile body is attached to the stalk with little free skirt around it; the fertile body is gray when young and black in old age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109328974">
	<b:glossaryEntry>a delicious morel with a conic fertile portion having deep and irregular pits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109329157">
	<b:glossaryEntry>a morel with the ridged and pitted fertile portion attached to the stipe for about half its length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109329372"
	 b:glossaryEntry="family of fungi belonging to the order Pesisales"/>
<rdf:Description rdf:about="&a;109329526"
	 b:glossaryEntry="a genus of fungi belonging to the family Sarcoscyphaceae"/>
<rdf:Description rdf:about="&a;109329650">
	<b:glossaryEntry>a fungus composed of several apothecia that look like elongated rabbit ears; the sterile surface is dark brown and warty; the fertile surface is smooth and pinkish orange</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109329883">
	<b:glossaryEntry>a fungus with a long solid stalk embedded in soil and a cauliflower-shaped yellow-brown head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109330041">
	<b:glossaryEntry>family of false morels or lorchels; some are edible and some are poisonous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109330329"
	 b:glossaryEntry="a fungus of the family Helvellaceae"/>
<rdf:Description rdf:about="&a;109330477"
	 b:glossaryEntry="a large fungus of the family Helvellaceae"/>
<rdf:Description rdf:about="&a;109330609"
	 b:glossaryEntry="type genus of the Helvellaceae"/>
<rdf:Description rdf:about="&a;109330794">
	<b:glossaryEntry>any fungus of the genus Helvella having the ascocarps stalked or pleated or often in folds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109331012">
	<b:glossaryEntry>a helvella with a saddle-shaped fertile part and creamy color; the stalk is fluted and pitted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109331203">
	<b:glossaryEntry>a helvella with a cup-shaped fertile body having a brown interior; the stalk is creamy white and heavily ribbed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109331399">
	<b:glossaryEntry>a helvella with an irregularly convoluted cap that is dark brown when young and becomes dull gray with age; the lower surface of the cap is smooth and pale gray; the stalk is thick and deeply fluted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109331678">
	<b:glossaryEntry>a genus of fungi of the family Helvellaceae with a cup-shaped or saucer-shaped fruiting body and ornamented spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109331890"
	 b:glossaryEntry="any fungus of the genus Discina"/>
<rdf:Description rdf:about="&a;109331993">
	<b:glossaryEntry>a discina with a flat or saucer-shaped fertile body that is brown on the upper surface; has a short stalk; not recommended for eating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109332210">
	<b:glossaryEntry>a genus of fungi of the family Helvellaceae with a fertile portion that is tan to brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109332492"
	 b:glossaryEntry="any fungus of the genus Gyromitra"/>
<rdf:Description rdf:about="&a;109332671">
	<b:glossaryEntry>a gyromitra with a brown puffed up fertile part and a thick fluted stalk; found under conifers in California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109332891">
	<b:glossaryEntry>a gyromitra with a brown puffed up fertile part and a rosy pink fluted stalk and smooth round spores; found on hardwood slash east of the Great Plains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109333154">
	<b:glossaryEntry>a poisonous gyromitra; the surface of the fertile body is smooth at first and becomes progressively undulating and wrinkled (but never truly pitted); color varies from dull yellow to brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109333462">
	<b:glossaryEntry>a poisonous fungus; saddle-shaped and dull yellow to brown fertile part is relatively even</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109333663">
	<b:glossaryEntry>a lorchel with deep brownish red fertile part and white stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109333830">
	<b:glossaryEntry>a gyromitra with a large irregular stalk and fertile part that is yellow to brown and wrinkled; has early fruiting time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109334030">
	<b:glossaryEntry>fungi in which the hymenium is enclosed until after spores have matured: puffballs; earth stars; stinkhorn fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109334435"
	 b:glossaryEntry="any fungus of the class Gasteromycetes"/>
<rdf:Description rdf:about="&a;109334639">
	<b:glossaryEntry>order of fungi comprising the stinkhorns and related forms whose mature hymenium is slimy and fetid; sometimes placed in subclass Homobasidiomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109334956">
	<b:glossaryEntry>a family of fungi belonging to the order Phallales and comprising the true stinkhorns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109335194">
	<b:glossaryEntry>genus of fungi having the cap or pileus hanging free around the stem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109335389">
	<b:glossaryEntry>any of various ill-smelling brown-capped fungi of the order Phallales; "the foul smell of the stinkhorn attracts insects that carry the spores away on their feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109335715">
	<b:glossaryEntry>a common fungus formerly used in preparing a salve for rheumatism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109335882">
	<b:glossaryEntry>this stinkhorn has a cap with a granulose surface at the apex and smells like decaying flesh</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109336057">
	<b:glossaryEntry>closely related to genus Phallus distinguished by an indusium hanging like a skirt from below the pileus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109336258"
	 b:glossaryEntry="a genus of fungi belonging to the family Phallaceae"/>
<rdf:Description rdf:about="&a;109336398">
	<b:glossaryEntry>a stinkhorn having a stalk without a cap; the slimy gleba is simply plastered on its surface near the apex where winged insects can find it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109336634"
	 b:glossaryEntry="an order of fungi belonging to the class Gasteromycetes"/>
<rdf:Description rdf:about="&a;109336811"
	 b:glossaryEntry="a family of fungi belonging to the order Tulostomatales"/>
<rdf:Description rdf:about="&a;109337029">
	<b:glossaryEntry>a gasteromycete with a leathery stalk and a fruiting body that is globose and has a pale yellow spore case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109337220">
	<b:glossaryEntry>a gasteromycete with a leathery stalk and a fruiting body this globose and has a red spore case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109337402">
	<b:glossaryEntry>a gasteromycete with a leathery stalk and a fruiting body with a thin gelatinous spore case and elliptical spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109337600"
	 b:glossaryEntry="family of fleshy stinkhornlike fungi"/>
<rdf:Description rdf:about="&a;109337772"
	 b:glossaryEntry="type genus of the Clathraceae"/>
<rdf:Description rdf:about="&a;109337892"
	 b:glossaryEntry="a genus of fungi belonging to the family Clathraceae"/>
<rdf:Description rdf:about="&a;109338060">
	<b:glossaryEntry>a stinkhorn of genus Pseudocolus; the fruiting body first resembles a small puffball that soon splits open to form a stalk with tapering arms that arch and taper to a common point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109338342">
	<b:glossaryEntry>small order of basidiomycetous fungi having fleshy often globose fruiting bodies; includes puffballs and earthstars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109338594">
	<b:glossaryEntry>a fungus family belonging to the order Lycoperdales; includes puffballs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109338824">
	<b:glossaryEntry>genus of fungi whose fruiting body tapers toward a base consisting of spongy mycelium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109339004">
	<b:glossaryEntry>any of various fungi of the family Lycoperdaceae whose round fruiting body discharges a cloud of spores when mature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109339227">
	<b:glossaryEntry>genus of puffballs having outer casings whose upper parts break at maturity into angular pieces to expose the spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109339453">
	<b:glossaryEntry>huge edible puffball up to 2 feet diameter and 25 pounds in weight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109339619">
	<b:glossaryEntry>a family of earthstar fungi belonging to the order Lycoperdales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109339856">
	<b:glossaryEntry>any fungus of the family Geastraceae; in form suggesting a puffball whose outer peridium splits into the shape of a star</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109340105">
	<b:glossaryEntry>type genus of Geastraceae; fungi whose outer peridium when dry splits into starlike segments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109340288">
	<b:glossaryEntry>an earthstar with a bluish spore sac and a purplish brown gleba; at maturity the outer layer splits into rays that bend backward and elevate the spore sac</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109340507"
	 b:glossaryEntry="a genus of fungus belonging to the family Geastraceae"/>
<rdf:Description rdf:about="&a;109340672">
	<b:glossaryEntry>a fungus similar to an earthstar except that it does not open up; the spore mass is brown at maturity with a column of sterile tissue extending up into it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109340912"
	 b:glossaryEntry="a genus of fungi belonging to the family Geastraceae"/>
<rdf:Description rdf:about="&a;109341053">
	<b:glossaryEntry>the largest earthstar; the fruiting body can measure 15 cm across when the rays are expanded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109341208">
	<b:glossaryEntry>a common species of earthstar widely distributed in sandy soil; the gleba is a pale tan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109341363">
	<b:glossaryEntry>small order of basidiomycetous fungi comprising families Nidulariaceae and Sphaerobolaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109341590"
	 b:glossaryEntry="bird''s-nest fungi"/>
<rdf:Description rdf:about="&a;109341747">
	<b:glossaryEntry>any of various fungi of the family Nidulariaceae having a cup-shaped body containing several egg-like structure enclosing the spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109341963"
	 b:glossaryEntry="type genus of the Nidulariaceae"/>
<rdf:Description rdf:about="&a;109342087">
	<b:glossaryEntry>monotypic family of fungi in which the more or less spherical gleba is forcibly ejected at maturity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109342292"
	 b:glossaryEntry="an order of fungi belonging to the class Gasteromycetes"/>
<rdf:Description rdf:about="&a;109342461">
	<b:glossaryEntry>a family of fungi that have a stalk and cap and a wrinkled mass of tissue (the gleba) where spores are produced; are often dismissed as misshapen forms of other fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109342782"
	 b:glossaryEntry="a genus of fungi of the family Secotiaceae"/>
<rdf:Description rdf:about="&a;109342938">
	<b:glossaryEntry>a species of Gastrocybe fungus that has a conic cap and a thin stalk; at first the stalk is upright but as it matures the stalk bends over and then downward; the cap then gelatinizes and a slimy mass containing the spores falls to the ground as the stalk collapses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109343288">
	<b:glossaryEntry>a stout-stemmed genus of fungus belonging to the family Secotiaceae having fruiting bodies that never expand completely</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109343523">
	<b:glossaryEntry>a small fungus with a fragile cap that cracks to expose the white context and a white stalk that is practically enclosed by the cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109343742">
	<b:glossaryEntry>a genus of fungi belonging to the family Secotiaceae; they resemble boletes but the spores are not discharged from the basidium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109344008">
	<b:glossaryEntry>a dingy yellow brown fungus with a rough stalk that superficially resembles a bolete</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109344181">
	<b:glossaryEntry>a fungus with a cap that can vary from red to dark brown; superficially resembles a bolete</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109344361">
	<b:glossaryEntry>includes chiefly saprophytic fungi typically with shelflike bodies; sometimes placed in class Hymenomycetes or included in Agaricales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109344637">
	<b:glossaryEntry>fungi that become corky or woody with age, often forming shelflike growths on trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109345029">
	<b:glossaryEntry>woody pore fungi; any fungus of the family Polyporaceae or family Boletaceae having the spore-bearing surface within tubes or pores; the fruiting bodies are usually woody at maturity and persistent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109345472"
	 b:glossaryEntry="a woody fungus that forms shelflike sporophores"/>
<rdf:Description rdf:about="&a;109345595"
	 b:glossaryEntry="a genus of fungi belonging to the family Polyporaceae"/>
<rdf:Description rdf:about="&a;109345745">
	<b:glossaryEntry>a rare fungus having a large (up to 14 inches wide) yellow fruiting body with multiple individual caps and a broad central stalk and a fragrant odor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109345980">
	<b:glossaryEntry>a fungus with a whitish often circular cap and a white pore surface and small pores and a white central stalk; found under conifers; edible but not popular</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109346236"
	 b:glossaryEntry="a genus of fungi belonging to the family Polyporaceae"/>
<rdf:Description rdf:about="&a;109346386">
	<b:glossaryEntry>a gilled polypore with a large cap (up to 15 inches in diameter) and a broad stalk; edible when young and tender</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109346586"
	 b:glossaryEntry="a genus of fungi belonging to the family Polyporaceae"/>
<rdf:Description rdf:about="&a;109346734">
	<b:glossaryEntry>a woody pore fungus with a dark brown to red brown cap and spore surface and small pores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109346906"
	 b:glossaryEntry="a genus of fungi belonging to the family Polyporaceae"/>
<rdf:Description rdf:about="&a;109347054">
	<b:glossaryEntry>a pore fungus with a whitish cottony soft cap found on conifer logs in forests at high elevation in the western United States and adjacent Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109347288">
	<b:glossaryEntry>a fungus with a whitish kidney-shaped cap and elongated pores; causes white rot in dead hardwoods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109347471">
	<b:glossaryEntry>type genus of the Polyporaceae; includes important pathogens of e.g. birches and conifers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109347710">
	<b:glossaryEntry>large grayish-brown edible fungus forming a mass of overlapping caps that somewhat resembles a hen at the base of trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109347971">
	<b:glossaryEntry>a fungus with a lateral stalk (when there is a stalk) and a scaly cap that becomes nearly black in maturity; widely distributed in the northern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109348227">
	<b:glossaryEntry>a family of fungi closely related to the family Polyporaceae except that the tubes on the undersurface of the cap are separate from each other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109348490"
	 b:glossaryEntry="fungi having each pore separate though crowded"/>
<rdf:Description rdf:about="&a;109348648">
	<b:glossaryEntry>a popular edible fungus with a cap the color of liver or raw meat; abundant in southeastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109348856">
	<b:glossaryEntry>genus of bracket fungi forming corky or woody perennial shelflike sporophores often of large size; includes some that cause destructive heartrot in trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109349113"
	 b:glossaryEntry="fungus used in the preparation of punk for fuses"/>
<rdf:Description rdf:about="&a;109349251">
	<b:glossaryEntry>family of pore-bearing fleshy fungi having the spores easily separating from the cup and often from each other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109349609"
	 b:glossaryEntry="any fungus of the family Boletaceae"/>
<rdf:Description rdf:about="&a;109350058">
	<b:glossaryEntry>type genus of Boletaceae; genus of soft early-decaying pore fungi; some poisonous and some edible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109350472">
	<b:glossaryEntry>a fungus convex cap and a dingy yellow under surface and a dry stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109350626">
	<b:glossaryEntry>a edible and choice fungus; has a convex cap that is slightly viscid when fresh and moist but soon dries and a thick bulbous tan stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109350840"
	 b:glossaryEntry="a fungus with a red cap and a red coarsely reticulate stalk"/>
<rdf:Description rdf:about="&a;109350997">
	<b:glossaryEntry>a poisonous fungus with a dingy yellow cap and orange red undersurface and a cylindrical reticulate stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109351183">
	<b:glossaryEntry>a fungus that is edible when young and fresh; has a dark brown convex cap with a yellow to greenish under surface and reddish stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109351397">
	<b:glossaryEntry>a fungus that has an off-white cap when it is young but later becomes dingy brown and a stalk of the same color; the under surface of the cap (the tubes) a pale greenish yellow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109351655">
	<b:glossaryEntry>a beautiful but poisonous bolete; has a brown cap with a scarlet pore surface and a thick reticulate stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109351847">
	<b:glossaryEntry>an edible fungus with a broadly convex blackish brown cap and a pore surface that is yellow when young and darkens with age; stalk is thick and enlarges toward the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109352102">
	<b:glossaryEntry>a fungus with a rusty red cap and a white pore surface that becomes yellow with age and a pale yellow stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109352290">
	<b:glossaryEntry>a fungus with a velvety stalk and usually a dingy brown cap; injured areas turn blue instantly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109352470">
	<b:glossaryEntry>an edible (but not choice) fungus found on soil under hardwoods; has a dry convex cap with whitish under surface and a reticulate stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109352687">
	<b:glossaryEntry>an edible and choice fungus that has a brown cap with greenish yellow under surface and a stalk that become dull red with age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109352893"
	 b:glossaryEntry="a genus of fungi belonging to the family Boletaceae"/>
<rdf:Description rdf:about="&a;109353085">
	<b:glossaryEntry>an edible fungus with a pinkish purple cap and stalk and a pore surface that is yellow with large angular pores that become gill-like in maturity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109353319">
	<b:glossaryEntry>an edible fungus with a broadly convex brown cap and a whitish pore surface and stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109353494"
	 b:glossaryEntry="a genus of fungi belonging to the family Boletaceae"/>
<rdf:Description rdf:about="&a;109353655">
	<b:glossaryEntry>an edible fungus with a dark reddish brown cap and a wide light tan stalk that expands toward the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109353843"
	 b:glossaryEntry="a genus of fungi belonging to the family Boletaceae"/>
<rdf:Description rdf:about="&a;109354010">
	<b:glossaryEntry>a fungus with a broadly convex brown cap gill-like pores that extend part way down the stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109354192"
	 b:glossaryEntry="a genus of fungi belonging to the family Boletaceae"/>
<rdf:Description rdf:about="&a;109354351">
	<b:glossaryEntry>a short squat edible fungus with a reddish brown cap and white stalk; fruits under pines in the spring</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109354538"
	 b:glossaryEntry="fungi similar to Boletus but with a shaggy scaly cap"/>
<rdf:Description rdf:about="&a;109354710">
	<b:glossaryEntry>edible mild-tasting mushroom found in coniferous woodlands of eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109354905"
	 b:glossaryEntry="a genus of fungi belonging to the family Boletaceae"/>
<rdf:Description rdf:about="&a;109355070">
	<b:glossaryEntry>a fungus with a coarsely shaggy-reticulate stalk and rimose-areolate cap surface and a long stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109355253">
	<b:glossaryEntry>any fungus of the order Tremellales or Auriculariales whose fruiting body is jellylike in consistency when fresh</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109355514">
	<b:glossaryEntry>fungi varying from gelatinous to waxy or even horny in texture; most are saprophytic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109355752">
	<b:glossaryEntry>a family of basidiomycetous fungi of the order Tremellales that have the basidium divided longitudinally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109355975">
	<b:glossaryEntry>fungi with yellowish gelatinous sporophores having convolutions resembling those of the brain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109356235">
	<b:glossaryEntry>popular in China and Japan and Taiwan; gelatinous mushrooms; most are dried</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109356411"
	 b:glossaryEntry="a yellow jelly fungus"/>
<rdf:Description rdf:about="&a;109356534">
	<b:glossaryEntry>a jelly fungus with a fruiting body 5-15 cm broad and gelatinous in consistency; resembles a bunch of leaf lettuce; mostly water and brownish in color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109356767">
	<b:glossaryEntry>a jelly fungus with an erect whitish fruiting body and a highly variable shape (sometimes resembling coral fungi)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109356965">
	<b:glossaryEntry>coextensive with the family Auriculariaceae; sometimes included in the order Tremellales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109357156"
	 b:glossaryEntry="fungi having gelatinous sporophores"/>
<rdf:Description rdf:about="&a;109357316"
	 b:glossaryEntry="type genus of the Auriculariaceae"/>
<rdf:Description rdf:about="&a;109357465">
	<b:glossaryEntry>widely distributed edible fungus shaped like a human ear and growing on decaying wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109357674">
	<b:glossaryEntry>a family of basidiomycetous fungi belonging to the order Tremellales having a bifurcate basidium that lacks septa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109357912">
	<b:glossaryEntry>type genus of the Dacrymycetaceae: fungi with a bifurcate basidium that lacks septa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109358090">
	<b:glossaryEntry>rust fungi: parasitic fungi causing rust in plants; sometimes placed in</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109358313"
	 b:glossaryEntry="any of various fungi causing rust disease in plants"/>
<rdf:Description rdf:about="&a;109358558">
	<b:glossaryEntry>fruiting body of some rust fungi bearing chains of aeciospores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109358692"
	 b:glossaryEntry="spore of a rust fungus formed in an aecium"/>
<rdf:Description rdf:about="&a;109358810"
	 b:glossaryEntry="rust fungi"/>
<rdf:Description rdf:about="&a;109358962">
	<b:glossaryEntry>rusts having sessile one-celled teliospores in a single layer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109359137"
	 b:glossaryEntry="fungus causing flax rust"/>
<rdf:Description rdf:about="&a;109359273">
	<b:glossaryEntry>rust fungi having aecia produced in raised or swollen sori and teliospores borne in waxy columns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109359483">
	<b:glossaryEntry>fungus causing white pine blister rust and having a complex life cycle requiring a plant of genus Ribes as alternate host</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109359704"
	 b:glossaryEntry="large important family of rust fungi"/>
<rdf:Description rdf:about="&a;109359878">
	<b:glossaryEntry>type genus of the Pucciniaceae; a large genus of parasitic fungi including many that are destructive to various economic plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109360115"
	 b:glossaryEntry="rust fungus that attacks wheat"/>
<rdf:Description rdf:about="&a;109360241">
	<b:glossaryEntry>genus of fungi that produce galls on cedars and other conifers of genera Juniperus and Libocedrus and causes rust spots on apples and pears and other plants of family Rosaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109360540"
	 b:glossaryEntry="rust fungus causing rust spots on apples and pears etc"/>
<rdf:Description rdf:about="&a;109360728">
	<b:glossaryEntry>category used in some systems to comprise the two orders Ustilaginales (smuts) and Uredinales (rusts)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109360928">
	<b:glossaryEntry>parasitic fungi causing smuts; sometimes placed in class Tiliomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109361155"
	 b:glossaryEntry="any fungus of the order Usrilaginales"/>
<rdf:Description rdf:about="&a;109361438">
	<b:glossaryEntry>a smut fungus causing a smut disease of grains in which the spore masses are covered or held together by the grain membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109361621"
	 b:glossaryEntry="a fungus family of loose smuts"/>
<rdf:Description rdf:about="&a;109361793">
	<b:glossaryEntry>type genus of the Ustilaginaceae; genus comprising the loose smuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109361969">
	<b:glossaryEntry>a smut fungus of the genus Ustilago causing a smut disease of grains in which the entire head is transformed into a dusty mass of spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109362181"
	 b:glossaryEntry="a smut fungus attacking Indian corn"/>
<rdf:Description rdf:about="&a;109362320">
	<b:glossaryEntry>a common smut attacking Indian corn causing grayish white swellings that rupture to expose a black spore mass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109362522"
	 b:glossaryEntry="genus of smut fungus"/>
<rdf:Description rdf:about="&a;109362662">
	<b:glossaryEntry>smut fungus attacking heads of corn or sorghum and causing a covered smut</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109362835">
	<b:glossaryEntry>a family of smut fungi having a simple promycelium bearing the spores in an apical cluster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109363063"
	 b:glossaryEntry="a genus of fungi belonging to the family Tilletiaceae"/>
<rdf:Description rdf:about="&a;109363245">
	<b:glossaryEntry>fungus that destroys kernels of wheat by replacing them with greasy masses of smelly spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109363424"
	 b:glossaryEntry="similar to Tilletia caries"/>
<rdf:Description rdf:about="&a;109363555"
	 b:glossaryEntry="a genus of smut fungi belonging to the family Tilletiaceae"/>
<rdf:Description rdf:about="&a;109363725">
	<b:glossaryEntry>smut fungus causing blackish blisters on scales and leaves of onions; especially destructive to seedlings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109363907">
	<b:glossaryEntry>a smut fungus causing a smut in cereals and other grasses that chiefly affects leaves and stems and is characterized chains of sori within the plant tissue that later rupture releasing black masses of spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109364214"
	 b:glossaryEntry="fungus affecting leaves and stems of wheat"/>
<rdf:Description rdf:about="&a;109364338"
	 b:glossaryEntry="a family of fungi belonging to the subdivision Basidiomycota"/>
<rdf:Description rdf:about="&a;109364525">
	<b:glossaryEntry>type genus of Septobasidiaceae: smooth shelf fungi usually having a well-developed sometimes thick-walled hypobasidium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109364763">
	<b:glossaryEntry>fungus that frequently encircles twigs and branches of various trees especially citrus trees in southern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109364993">
	<b:glossaryEntry>a family of fungi belonging to the order Agricales; the gills of these fungi have a clean waxy appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109365297">
	<b:glossaryEntry>any fungus of the family Hygrophoraceae having gills that are more or less waxy in appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109365697"
	 b:glossaryEntry="a genus of fungi belonging to the family Hygrophoraceae"/>
<rdf:Description rdf:about="&a;109365864"
	 b:glossaryEntry="a fungus having an acutely conic cap and dry stalks"/>
<rdf:Description rdf:about="&a;109366018"
	 b:glossaryEntry="a genus of fungi belonging to the family Hygrophoraceae"/>
<rdf:Description rdf:about="&a;109366360">
	<b:glossaryEntry>a fungus with a white convex cap and arcuate white gills and a stalk that tapers toward the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109366542">
	<b:glossaryEntry>a fungus with a broadly convex cap that is cream color with a tint of blue over the margin; waxy gills are bluish green to blue-gray; a short stalk tapers abruptly at the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109366804">
	<b:glossaryEntry>a fungus with a drab squamulose cap and gray-brown squamules over the white background of the stalk and waxy gray-white gills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109367020">
	<b:glossaryEntry>a fungus with a slightly viscid cap; cap and gills are reddish brown nd the stalk is gray</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109367197"
	 b:glossaryEntry="a gray fungus frequently found near melting snow banks"/>
<rdf:Description rdf:about="&a;109367338">
	<b:glossaryEntry>a fungus with a viscid purplish red cap and stalk; found under spruce and other conifers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109367516">
	<b:glossaryEntry>an edible fungus with a reddish cap and close pale gills and dry stalk; found under hardwoods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109367694">
	<b:glossaryEntry>an edible fungus with a large white cap and a cry stalk and white gills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109367851">
	<b:glossaryEntry>a fungus having a brownish sticky cap with a white margin and white gills and an odor of raw potatoes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109368043">
	<b:glossaryEntry>a small fungus with orange cap and yellow gills found in sphagnum bogs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109368199"
	 b:glossaryEntry="a genus of fungi belonging to the family Hygrophoraceae"/>
<rdf:Description rdf:about="&a;109368368">
	<b:glossaryEntry>a small gray-brown fungus with an unpleasant odor of mothballs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109368514"
	 b:glossaryEntry="a genus of fungi belonging to the family Hygrophoraceae"/>
<rdf:Description rdf:about="&a;109368691">
	<b:glossaryEntry>a fungus with a small brown convex cap with a depressed disc; waxy wine-colored gills and a brown stalk; fruits in or near melting snow banks in the western mountains of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109368967"
	 b:glossaryEntry="a cobwebby partial veil consisting of silky fibrils"/>
<rdf:Description rdf:about="&a;109369072"
	 b:glossaryEntry="a family of fungi belonging to the order Agaricales"/>
<rdf:Description rdf:about="&a;109369265">
	<b:glossaryEntry>the largest genus in th Agaricales; rusty-spored agarics having prominent cortinae (cobwebby partial veils)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109369602">
	<b:glossaryEntry>a fungus with large tawny caps and pale cinnamon gills and a red band of veil around the stalk; usually found near birch trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109369797">
	<b:glossaryEntry>an edible fungus with a slimy viscid cap that is initially yellow but turns olive and then tawny; flesh is lavender</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109370003">
	<b:glossaryEntry>a fungus with a viscid wrinkled tawny cap; the stalk has a basal bulb that diminishes as the stalk elongates; the gills are dark violet at first but soon turn brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109370255">
	<b:glossaryEntry>a poisonous fungus with a bright yellow brown cap and a long cinnamon colored stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109370424">
	<b:glossaryEntry>a fungus with a reddish purple cap having a smooth slimy surface; close violet gills; all parts stain dark purple when bruised</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109370667">
	<b:glossaryEntry>a fungus with a dry brown cap and rusty red gills and a yellowish stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109370830">
	<b:glossaryEntry>a fungus with a sticky lavender cap and stalk that whitish above and covered with a silky lavender sheath</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109371025"
	 b:glossaryEntry="a fungus that is violet over-all with a squamulose cap"/>
<rdf:Description rdf:about="&a;109371166">
	<b:glossaryEntry>a genus of fungus characterized by the orange color of the spore deposit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109371390">
	<b:glossaryEntry>a fungus with a brownish orange fruiting body and a ring near the top of the stalk; the taste is bitter and the flesh contains psilocybin and psilocin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109371628">
	<b:glossaryEntry>a poisonous fungus with a dry cap and a cortina that does not leave much of a ring on the robust stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109371816">
	<b:glossaryEntry>a giant fungus of the Pacific Northwest; has a very thick stalk and the cortina leaves a ring high up on the stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109372018">
	<b:glossaryEntry>a fungus that produces a superficial growth on various kinds of damp or decaying organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109372226">
	<b:glossaryEntry>a fungus that produces a superficial (usually white) growth on organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109372392">
	<b:glossaryEntry>order of imperfect fungi lacking conidiophores of having conidiophores that are superficial and not enclosed in a pycnidium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109372724">
	<b:glossaryEntry>genus of imperfect fungi having conidia borne singly at the apex of whorled branchlets; cause wilt diseases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109372934"
	 b:glossaryEntry="a fungus of the genus Verticillium"/>
<rdf:Description rdf:about="&a;109373046">
	<b:glossaryEntry>family of imperfect fungi having white or brightly colored hyphae and spores that are produced directly on the mycelium and not aggregated in fruiting bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109373396"
	 b:glossaryEntry="a genus of fungus of the family Moniliaceae; causes ringworm"/>
<rdf:Description rdf:about="&a;109373555"
	 b:glossaryEntry="a genus of fungus of the family Moniliaceae; causes ringworm"/>
<rdf:Description rdf:about="&a;109373712">
	<b:glossaryEntry>genus of parasitic yeastlike imperfect fungi having spherical or oval conidia in branched chains; some species usually placed in other genera especially genus Candida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109373976"
	 b:glossaryEntry="any of the yeastlike imperfect fungi of the genus Monilia"/>
<rdf:Description rdf:about="&a;109374106">
	<b:glossaryEntry>a genus of yeastlike imperfect fungi; sometimes included in genus Monilia of the family Moniliaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109374322"
	 b:glossaryEntry="any of the yeastlike imperfect fungi of the genus Candida"/>
<rdf:Description rdf:about="&a;109374470">
	<b:glossaryEntry>a parasitic fungus that can infect the mouth or the skin or the intestines or the vagina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109374678">
	<b:glossaryEntry>form genus of imperfect fungi lacking pigment in the spores and conidiophores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109374856">
	<b:glossaryEntry>genus of fungi commonly growing as green or blue molds on decaying food; used in making cheese and as a source of penicillin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109375077"
	 b:glossaryEntry="genus of pathogenic yeastlike fungi"/>
<rdf:Description rdf:about="&a;109375209">
	<b:glossaryEntry>any of various yeastlike budding fungi of the genus Blastomyces; cause disease in humans and other animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109375374">
	<b:glossaryEntry>family of imperfect mushrooms having dark-colored hyphae or conidia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109375577">
	<b:glossaryEntry>form genus of imperfect fungi that are leaf parasites with long slender spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109375769">
	<b:glossaryEntry>fungus causing yellow spot (a sugarcane disease in Australia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109375934"
	 b:glossaryEntry="genus of imperfect fungi causing smutlike diseases"/>
<rdf:Description rdf:about="&a;109376106"
	 b:glossaryEntry="fungus causing green smut in rice"/>
<rdf:Description rdf:about="&a;109376246"
	 b:glossaryEntry="large family of mainly saprophytic imperfect fungi"/>
<rdf:Description rdf:about="&a;109376442">
	<b:glossaryEntry>type genus of the Tuberculariaceae; fungi with nodules of red or pink conidia; some cause diebacks of woody plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109376655">
	<b:glossaryEntry>a form genus of mostly plant parasites some of which cause dry rot; in humans a species can cause inflammation of cornea leading to blindness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109376876"
	 b:glossaryEntry="a fungus causing dry rot"/>
<rdf:Description rdf:about="&a;109376954"
	 b:glossaryEntry="order of imperfect fungi having no known spore stage"/>
<rdf:Description rdf:about="&a;109377170">
	<b:glossaryEntry>form genus of imperfect fungi some species of which are now placed in genera Pellicularia and Corticium because their perfect stages have been found</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109377420">
	<b:glossaryEntry>any fungus now or formerly belonging to the form genus Rhizoctinia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109377563"
	 b:glossaryEntry="form genus of imperfect fungi"/>
<rdf:Description rdf:about="&a;109377681">
	<b:glossaryEntry>form genus of sterile imperfect fungi; many form sclerotia; some cause sclerotium disease in plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109377875">
	<b:glossaryEntry>any of a variety of plants grown indoors for decorative purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109378158">
	<b:glossaryEntry>any of a variety of plants usually grown especially in a flower or herb garden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109378313"
	 b:glossaryEntry="an ornamental plant suitable for planting in a flowerbed"/>
<rdf:Description rdf:about="&a;109378438">
	<b:glossaryEntry>green plant having a vascular system: ferns, gymnosperms, angiosperms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109379036">
	<b:glossaryEntry>a plant adapted to arid conditions and characterized by fleshy water-storing tissues that act as water reservoirs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109379313">
	<b:glossaryEntry>organisms without vascular tissue: e.g. algae, lichens, fungi, mosses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109379467">
	<b:glossaryEntry>an organism or species surviving as a remnant of an otherwise extinct flora or fauna in an environment much changed from that in which it originated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109379668">
	<b:glossaryEntry>a variety of a plant developed from a natural species and maintained under cultivation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109379809"
	 b:glossaryEntry="plants that are grown for their produce"/>
<rdf:Description rdf:about="&a;109379929"
	 b:glossaryEntry="any plant that crowds out cultivated plants"/>
<rdf:Description rdf:about="&a;109380527">
	<b:glossaryEntry>usually used in combination: `liverwort''; `milkwort''; `whorlywort''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109380644"
	 b:glossaryEntry="the yield from plants in a single growing season"/>
<rdf:Description rdf:about="&a;109380825">
	<b:glossaryEntry>a quick-growing crop (e.g. lettuce) planted between two regular crops grown in successive seasons or between two rows of crops in the same season</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109381027">
	<b:glossaryEntry>crop planted to prevent soil erosion and provide green manure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109381145">
	<b:glossaryEntry>the yield of fruit; "a tree highly recommended for its fruitage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109381264"
	 b:glossaryEntry="any part of a plant or fungus"/>
<rdf:Description rdf:about="&a;109381783"
	 b:glossaryEntry="a functional and structural unit of a plant or fungus"/>
<rdf:Description rdf:about="&a;109382200"
	 b:glossaryEntry="a natural projection or outgrowth from a plant body or organ"/>
<rdf:Description rdf:about="&a;109382510">
	<b:glossaryEntry>(botany) a natural swelling or enlargement: at the base of the stalk or seta in certain mosses or on the cone scale of certain conifers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109382701">
	<b:glossaryEntry>(botany) an isolated thickening of tissue, especially a stiff protuberance on the lip of an orchid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109382852"
	 b:glossaryEntry="small rounded wartlike protuberance on a plant"/>
<rdf:Description rdf:about="&a;109382962"
	 b:glossaryEntry="tubular extension at the base of the corolla in some flowers"/>
<rdf:Description rdf:about="&a;109383073"
	 b:glossaryEntry="an organ specialized for producing spores"/>
<rdf:Description rdf:about="&a;109383246"
	 b:glossaryEntry="a stiff sharp-pointed plant process"/>
<rdf:Description rdf:about="&a;109383353"
	 b:glossaryEntry="a sharp-pointed tip on a stem or leaf"/>
<rdf:Description rdf:about="&a;109383460"
	 b:glossaryEntry="a thorny stem or twig"/>
<rdf:Description rdf:about="&a;109383533"
	 b:glossaryEntry='filamentous hairlike growth on a plant; "peach fuzz"'/>
<rdf:Description rdf:about="&a;109383708">
	<b:glossaryEntry>a multicellular hair in plants like the stinging nettle that expels an irritating fluid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109383855"
	 b:glossaryEntry="a usually terminal tuft of hairs especially on a seed"/>
<rdf:Description rdf:about="&a;109383959">
	<b:glossaryEntry>a tuft or growth of hairs or bristles on certain plants such as iris or grasses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109384108"
	 b:glossaryEntry="slender bristlelike appendage found on the bracts of grasses"/>
<rdf:Description rdf:about="&a;109384218">
	<b:glossaryEntry>fleshy and usually brightly colored cover of some seeds that develops from the ovule stalk and partially or entirely envelopes the seed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109384404">
	<b:glossaryEntry>a continuous tube formed by a row of elongated cells lacking intervening end walls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109384556">
	<b:glossaryEntry>the male sex organ of spore-producing plants; produces antherozoids; equivalent to the anther in flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109384718">
	<b:glossaryEntry>gametophore bearing antheridia as in certain mosses and liverworts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109384846"
	 b:glossaryEntry="leaf in ferns and mosses that bears the sporangia"/>
<rdf:Description rdf:about="&a;109384964"
	 b:glossaryEntry="organ containing or producing spores"/>
<rdf:Description rdf:about="&a;109385136"
	 b:glossaryEntry="stalk bearing one or more sporangia"/>
<rdf:Description rdf:about="&a;109385232">
	<b:glossaryEntry>saclike structure in which ascospores are formed through sexual reproduction of ascomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109385394"
	 b:glossaryEntry="sexually produced fungal spore formed within an ascus"/>
<rdf:Description rdf:about="&a;109385503"
	 b:glossaryEntry="one of a string of sporelike cells of some fungi and algae"/>
<rdf:Description rdf:about="&a;109385619"
	 b:glossaryEntry="a resting sporelike cell produced by some bacteria"/>
<rdf:Description rdf:about="&a;109385727"
	 b:glossaryEntry="a case or sheath especially a pollen sac or moss capsule"/>
<rdf:Description rdf:about="&a;109385841">
	<b:glossaryEntry>a sterile simple or branched filament or hair borne among sporangia; may be pointed or clubbed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109385992"
	 b:glossaryEntry="a sporangium that arises from a group of epidermal cells"/>
<rdf:Description rdf:about="&a;109386107">
	<b:glossaryEntry>a sporangium formed from a single epidermal cell; characteristic of the Filicales or of almost all modern ferns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109386280"
	 b:glossaryEntry="a sporangium containing four asexual spores"/>
<rdf:Description rdf:about="&a;109386385">
	<b:glossaryEntry>a spore-bearing branch or organ: the part of the thallus of a sporophyte that develops spores; in ferns and mosses and liverworts is practically equivalent to the sporophyte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109386634"
	 b:glossaryEntry="cell or organ in which gametes develop"/>
<rdf:Description rdf:about="&a;109386730">
	<b:glossaryEntry>a modified branch bearing gametangia as in the thalloid liverworts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109386872"
	 b:glossaryEntry="cluster of sporangia usually on underside of a fern frond"/>
<rdf:Description rdf:about="&a;109387000"
	 b:glossaryEntry="a spore-producing structure in certain lichens and fungi"/>
<rdf:Description rdf:about="&a;109387108">
	<b:glossaryEntry>a membrane enclosing and protecting the developing spores especially that covering the sori of a fern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109387283">
	<b:glossaryEntry>membrane initially completely investing the young sporophore of various mushrooms that is ruptured by growth; represented in the mature mushroom by a volva around lower part of stem and scales on upper surface of the cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109387572">
	<b:glossaryEntry>membrane of the young sporophore of various mushrooms extending from the margin of the cap to the stem and is ruptured by growth; represented in mature mushroom by an annulus around the stem and sometimes a cortina on the margin of the cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109387915">
	<b:glossaryEntry>(fungi) remnant of the partial veil that in mature mushrooms surrounds the lower part of the stem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109388085">
	<b:glossaryEntry>a motile male gamete of a plant such as an alga or fern or gymnosperm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109388227"
	 b:glossaryEntry="the tissue of a plant"/>
<rdf:Description rdf:about="&a;109388596"
	 b:glossaryEntry="a soft moist part of a fruit"/>
<rdf:Description rdf:about="&a;109388702">
	<b:glossaryEntry>soft spongelike central cylinder of the stems of most flowering plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109388842">
	<b:glossaryEntry>the primary tissue of higher plants composed of thin-walled cells that remain capable of cell division even when mature; constitutes the greater part of leaves, roots, the pulp of fruits, and the pith of stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109389184"
	 b:glossaryEntry="woody tissue"/>
<rdf:Description rdf:about="&a;109389268">
	<b:glossaryEntry>tissue that conducts water and nutrients through the plant body in higher plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109389592">
	<b:glossaryEntry>the usually cylindrical central vascular portion of the axis of a vascular plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109389743">
	<b:glossaryEntry>formative one-cell-thick layer of tissue between xylem and phloem in most vascular plants that is responsible for secondary growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109389927">
	<b:glossaryEntry>newly formed outer wood lying between the cambium and the heartwood of a tree or woody plant; usually light colored; active in water conduction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109390143">
	<b:glossaryEntry>the older inactive central wood of a tree or woody plant; usually darker and denser than the surrounding sapwood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109390340">
	<b:glossaryEntry>a unit strand of the vascular system in stems and leaves of higher plants consisting essentially of xylem and phloem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109390559">
	<b:glossaryEntry>one of the vascular bundles or ribs that form the branching framework of conducting and supporting tissues in a leaf or other plant organ</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109390775"
	 b:glossaryEntry="the vein in the center of a leaf"/>
<rdf:Description rdf:about="&a;109390860"
	 b:glossaryEntry="a sheet of vascular tissue separating the vascular bundles"/>
<rdf:Description rdf:about="&a;109390993">
	<b:glossaryEntry>the woody part of plants: the supporting and water-conducting tissue, consisting primarily of tracheids and vessels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109391198"
	 b:glossaryEntry="long tubular cell peculiar to xylem"/>
<rdf:Description rdf:about="&a;109391307">
	<b:glossaryEntry>(botany) tissue that conducts synthesized food substances (e.g., from leaves) to parts where needed; consists primarily of sieve tubes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109391520">
	<b:glossaryEntry>tube formed by cells joined end-to-end through which nutrients flow in flowering plants and brown algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109391699"
	 b:glossaryEntry="false phloem"/>
<rdf:Description rdf:about="&a;109391770">
	<b:glossaryEntry>strong woody fibers obtained especially from the phloem of from various plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109391912">
	<b:glossaryEntry>abnormal swelling of plant tissue caused by insects or microorganisms or injury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109392060"
	 b:glossaryEntry="oak gall caused by larvae of a cynipid wasp"/>
<rdf:Description rdf:about="&a;109392159">
	<b:glossaryEntry>a plant having foliage that persists and remains green throughout the year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109392325">
	<b:glossaryEntry>a plant having foliage that is shed annually at the end of the growing season</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109392482">
	<b:glossaryEntry>a plant that when touched or ingested in sufficient quantity can be harmful or fatal to an organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109393003">
	<b:glossaryEntry>weak-stemmed plant that derives support from climbing, twining, or creeping along a surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109394711">
	<b:glossaryEntry>a vine or climbing plant that readily grows up a support or over other plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109394860"
	 b:glossaryEntry="any plant (as ivy or periwinkle) that grows by creeping"/>
<rdf:Description rdf:about="&a;109394969">
	<b:glossaryEntry>slender stemlike structure by which some twining plants attach themselves to an object for support</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109395139"
	 b:glossaryEntry="usually coiled"/>
<rdf:Description rdf:about="&a;109395216"
	 b:glossaryEntry="a plant that climbs by its adventitious roots e.g. ivy"/>
<rdf:Description rdf:about="&a;109395329">
	<b:glossaryEntry>a plant having hard lignified tissues or woody parts especially stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109395853"
	 b:glossaryEntry="a category in some early taxonomies"/>
<rdf:Description rdf:about="&a;109395943"
	 b:glossaryEntry="having the shape or characteristics of a tree"/>
<rdf:Description rdf:about="&a;109396070">
	<b:glossaryEntry>a tall perennial woody plant having a main trunk and branches forming a distinct elevated crown; includes both gymnosperms and angiosperms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109399561"
	 b:glossaryEntry="any of several trees having seedpods as fruits"/>
<rdf:Description rdf:about="&a;109399753">
	<b:glossaryEntry>a tree with limbs cut back to promote a more bushy growth of foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109399875"
	 b:glossaryEntry="young tree"/>
<rdf:Description rdf:about="&a;109399939"
	 b:glossaryEntry="a tree planted or valued chiefly for its shade from sunlight"/>
<rdf:Description rdf:about="&a;109400056"
	 b:glossaryEntry="any tree of the division Gymnospermophyta"/>
<rdf:Description rdf:about="&a;109400235"
	 b:glossaryEntry="any gymnospermous tree or shrub bearing cones"/>
<rdf:Description rdf:about="&a;109401109"
	 b:glossaryEntry="any tree having seeds and ovules contained in the ovary"/>
<rdf:Description rdf:about="&a;109402273"
	 b:glossaryEntry="tree bearing edible nuts"/>
<rdf:Description rdf:about="&a;109402532"
	 b:glossaryEntry="tree bearing aromatic bark or berries"/>
<rdf:Description rdf:about="&a;109402698">
	<b:glossaryEntry>any of several trees having leaves or barks used to allay fever or thought to indicate regions free of fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109402863">
	<b:glossaryEntry>the base part of a tree that remains standing after the tree has been felled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109403023">
	<b:glossaryEntry>a dwarfed ornamental tree or shrub grown in a tray or shallow pot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109403177">
	<b:glossaryEntry>a dwarfed evergreen conifer or shrub shaped to have flat-topped asymmetrical branches and grown in a container</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109403343"
	 b:glossaryEntry="an artificial plant resembling a bonsai"/>
<rdf:Description rdf:about="&a;109403438"
	 b:glossaryEntry="small plants other than saplings growing on a forest floor"/>
<rdf:Description rdf:about="&a;109403583">
	<b:glossaryEntry>low-growing plants planted in deep shade or on a steep slope where turf is difficult to grow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109403820">
	<b:glossaryEntry>a low woody perennial plant usually having several major branches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109409363">
	<b:glossaryEntry>(Old Testament) the bush that burned without being consumed and from which God spoke to Moses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109409515"
	 b:glossaryEntry="dwarf shrub"/>
<rdf:Description rdf:about="&a;109409635"
	 b:glossaryEntry="low-growing woody shrub or perennial with woody base"/>
<rdf:Description rdf:about="&a;109410798"
	 b:glossaryEntry="any of various rough thorny shrubs or vines"/>
<rdf:Description rdf:about="&a;109410913"
	 b:glossaryEntry="shrub noted primarily for its flowers"/>
<rdf:Description rdf:about="&a;109411121"
	 b:glossaryEntry="a woody climbing usually tropical plant"/>
<rdf:Description rdf:about="&a;109411356">
	<b:glossaryEntry>plant living on another plant and obtaining from it organic nutriment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109411685">
	<b:glossaryEntry>a parasitic plant that contains some chlorophyll and therefore is capable of photosynthesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109411835">
	<b:glossaryEntry>a perennial plant that propagates by underground bulbs or tubers or corms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109411963">
	<b:glossaryEntry>plant adapted for life with a limited supply of water; compare hydrophyte and mesophyte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109412190">
	<b:glossaryEntry>land plant growing in surroundings having an average supply of water; compare xerophyte and hydrophyte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109412367">
	<b:glossaryEntry>a plant that grows partly or wholly in water whether rooted in the mud, as a lotus, or floating without anchorage, as the water hyacinth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109413150">
	<b:glossaryEntry>a semi-aquatic plant that grows in soft wet land; most are monocots: sedge, sphagnum, grasses, cattails, etc; possibly heath</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109413772">
	<b:glossaryEntry>plant that derives moisture and nutrients from the air and rain; usually grows on another plant but not parasitic on it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109414078"
	 b:glossaryEntry="a plant that is an epiphyte for part of its life"/>
<rdf:Description rdf:about="&a;109414200">
	<b:glossaryEntry>an epiphytic vine or tree whose aerial roots extend down the trunk of a supporting tree and coalesce around it eventually strangling the tree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109414432">
	<b:glossaryEntry>plant that grows on or among rocks or is suitable for a rock garden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109414592">
	<b:glossaryEntry>plant that grows on rocks or stony soil and derives nourishment from the atmosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109414752"
	 b:glossaryEntry="plants growing among rocks"/>
<rdf:Description rdf:about="&a;109414897">
	<b:glossaryEntry>an organism that feeds on dead organic matter especially a fungus or bacterium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109415055">
	<b:glossaryEntry>an organism that lives in and derives its nourishment from organic matter in stagnant or foul water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109415208">
	<b:glossaryEntry>an organism that lives in an oxygenated medium lacking organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109415333">
	<b:glossaryEntry>plant capable of synthesizing its own food from simple organic substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109415516">
	<b:glossaryEntry>the usually underground organ that lacks buds or leaves or nodes; absorbs water and mineral salts; usually it anchors the plant to the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109416162"
	 b:glossaryEntry="main root of a plant growing straight downward from the stem"/>
<rdf:Description rdf:about="&a;109416276"
	 b:glossaryEntry="root growing in an unusual location e.g. from a stem"/>
<rdf:Description rdf:about="&a;109416392">
	<b:glossaryEntry>crop grown for its enlarged roots: e.g. beets; potatoes; turnips</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109416512">
	<b:glossaryEntry>thimble-shaped mass of cells covering and protecting the growing tip of a root</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109416664"
	 b:glossaryEntry="small root or division of a root"/>
<rdf:Description rdf:about="&a;109416750">
	<b:glossaryEntry>thin hairlike outgrowth of an epidermal cell just behind the tip; absorbs nutrients from the soil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109416922">
	<b:glossaryEntry>a root that grows from and supports the stem above the ground in plants such as mangroves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109417067">
	<b:glossaryEntry>a plant or stem onto which a graft is made; especially a plant grown specifically to provide the root part of grafted plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109417261">
	<b:glossaryEntry>root or part of a root used for plant propagation; especially that part of a grafted plant that supplies the roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109417431">
	<b:glossaryEntry>a part (sometimes a root or leaf or bud) removed from a plant to propagate a new plant through rooting or grafting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109417624">
	<b:glossaryEntry>cuttings of plants set in the ground to grow as hawthorn for hedges or vines: "a quickset of a vine planted in a vineyard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109417801">
	<b:glossaryEntry>a horizontal branch from the base of plant that produces new plants from buds at its tips</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109417961"
	 b:glossaryEntry="the upper branches and leaves of a tree"/>
<rdf:Description rdf:about="&a;109418093"
	 b:glossaryEntry="plant growing from a tuber"/>
<rdf:Description rdf:about="&a;109418180">
	<b:glossaryEntry>a fleshy underground stem or root serving for reproductive and food storage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109418397">
	<b:glossaryEntry>a horizontal plant stem with shoots above and roots below serving as a reproductive structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109418568">
	<b:glossaryEntry>the main stem or central part about which plant organs or plant parts such as branches are arranged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109418773"
	 b:glossaryEntry="axis of a compound leaf or compound inflorescence"/>
<rdf:Description rdf:about="&a;109418875"
	 b:glossaryEntry="woody stem of palms and tree ferns"/>
<rdf:Description rdf:about="&a;109418962">
	<b:glossaryEntry>a slender or elongated structure that supports a plant or fungus or a plant part or plant organ</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109419513"
	 b:glossaryEntry="stem of a bean plant"/>
<rdf:Description rdf:about="&a;109419589"
	 b:glossaryEntry="a flattened stem resembling and functioning as a leaf"/>
<rdf:Description rdf:about="&a;109419736"
	 b:glossaryEntry="enlarged tip of a stem that bears the floral parts"/>
<rdf:Description rdf:about="&a;109419862"
	 b:glossaryEntry="persistent thickened stem of a herbaceous perennial plant"/>
<rdf:Description rdf:about="&a;109419980">
	<b:glossaryEntry>the upper angle between an axis and an offshoot such as a branch or leafstalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109420108">
	<b:glossaryEntry>supporting stalk or stemlike structure especially of a pistil or fern frond or supporting a mushroom cap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109420264">
	<b:glossaryEntry>erect leafless flower stalk growing directly from the ground as in a tulip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109420423">
	<b:glossaryEntry>undifferentiated tissue from which new cells are formed, as at the tip of a stem or root</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109420566">
	<b:glossaryEntry>flat-topped or rounded inflorescence characteristic of the family Umbelliferae in which the individual flower stalks arise from about the same point; youngest flowers are at the center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109420803">
	<b:glossaryEntry>flat-topped or convex inflorescence in which the individual flower stalks grow upward from various points on the main stem to approximately the same height; outer flowers open first</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109421037"
	 b:glossaryEntry="a branch of an umbel or an umbelliform inflorescence"/>
<rdf:Description rdf:about="&a;109421139"
	 b:glossaryEntry="the slender stem that supports the blade of a leaf"/>
<rdf:Description rdf:about="&a;109421273"
	 b:glossaryEntry="an expanded petiole taking on the function of a leaf blade"/>
<rdf:Description rdf:about="&a;109421386">
	<b:glossaryEntry>especially a leaf of grass or the broad portion of a leaf as distinct from the petiole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109421537"
	 b:glossaryEntry="stalk bearing an inflorescence or solitary flower"/>
<rdf:Description rdf:about="&a;109421659">
	<b:glossaryEntry>a small stalk bearing a single flower of an inflorescence; an ultimate division of a common peduncle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109421831">
	<b:glossaryEntry>usually elongate cluster of flowers along the main stem in which the flowers at the base open first</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109422001"
	 b:glossaryEntry="compound raceme or branched cluster of flowers"/>
<rdf:Description rdf:about="&a;109422101">
	<b:glossaryEntry>more or less flat-topped cluster of flowers in which the central or terminal flower opens first</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109422247">
	<b:glossaryEntry>(botany) an indeterminate inflorescence bearing sessile flowers on an unbranched axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109422421"
	 b:glossaryEntry="a small spike (as the inflorescence on grasses and sedges)"/>
<rdf:Description rdf:about="&a;109422534"
	 b:glossaryEntry="fruiting spike of a cereal plant especially corn"/>
<rdf:Description rdf:about="&a;109422689">
	<b:glossaryEntry>a dense clusters of flowers or foliage: "a head of cauliflower"; "a head of lettuce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109422836"
	 b:glossaryEntry="the fleshy axis of a spike often surrounded by a spathe"/>
<rdf:Description rdf:about="&a;109422963">
	<b:glossaryEntry>a modified bud consisting of a thickened globular underground stem serving as a reproductive structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109423188"
	 b:glossaryEntry="plant growing from a bulb"/>
<rdf:Description rdf:about="&a;109423417">
	<b:glossaryEntry>small bulb or bulb-shaped growth arising from the leaf axil or in the place of flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109423566">
	<b:glossaryEntry>solid swollen underground bulb-shaped stem or stem base and serving as a reproductive structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109423712"
	 b:glossaryEntry="plant growing from a corm"/>
<rdf:Description rdf:about="&a;109423815"
	 b:glossaryEntry="the ripened reproductive body of a seed plant"/>
<rdf:Description rdf:about="&a;109424380">
	<b:glossaryEntry>a diminutive fruit, especially one that is part of a multiple fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109424502"
	 b:glossaryEntry="a small hard fruit"/>
<rdf:Description rdf:about="&a;109424914"
	 b:glossaryEntry="any of various seeds or fruits suggestive of beans"/>
<rdf:Description rdf:about="&a;109425087"
	 b:glossaryEntry="usually large hard-shelled seed"/>
<rdf:Description rdf:about="&a;109425258">
	<b:glossaryEntry>the inner and usually edible part of a seed or grain or nut or fruit stone: "black walnut kernels are difficult to get out of the shell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109425473">
	<b:glossaryEntry>the fleshy multiple fruit of the fig consisting of an enlarged hollow receptacle containing numerous fruitlets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109425657">
	<b:glossaryEntry>a pulpy and usually edible small fruit having any of various structures: e.g. strawberry or raspberry or blueberry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109425896">
	<b:glossaryEntry>fruit consisting of many individual small fruits or drupes derived from separate ovaries within a common receptacle: e.g. blackberry; raspberry; pineapple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109426157">
	<b:glossaryEntry>an indehiscent fruit derived from a single ovary having one or many seeds within a fleshy wall or pericarp: e.g. grape; tomato; cranberry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109426361">
	<b:glossaryEntry>one of the small drupes making up an aggregate or multiple fruit like a blackberry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109426496">
	<b:glossaryEntry>fleshy indehiscent fruit with a single seed: e.g. almond; peach; plum; cherry; elderberry; olive; jujube</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109426738"
	 b:glossaryEntry="a small drupe-like part of an aggregate fruit"/>
<rdf:Description rdf:about="&a;109426892">
	<b:glossaryEntry>a fleshy fruit (apple or pear or related fruits) having seed chambers and an outer fleshy part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109427105">
	<b:glossaryEntry>a several-seeded dehiscent fruit as e.g. of a leguminous plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109427335">
	<b:glossaryEntry>pods constricted between seeds and breaking apart when ripe into one-seed segments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109427470"
	 b:glossaryEntry="outer membranous covering of some fruits or seeds"/>
<rdf:Description rdf:about="&a;109427642"
	 b:glossaryEntry="the husk of an ear of corn"/>
<rdf:Description rdf:about="&a;109427723"
	 b:glossaryEntry="dry outer covering of a fruit or seed or nut"/>
<rdf:Description rdf:about="&a;109427836">
	<b:glossaryEntry>the vessel that contains the seeds of a plant (not the seeds themselves)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109427993"
	 b:glossaryEntry="husk of a pea; edible in some garden peas"/>
<rdf:Description rdf:about="&a;109428118">
	<b:glossaryEntry>fruit containing much fleshy tissue besides that of the ripened ovary; as apple or strawberry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109428286"
	 b:glossaryEntry="an order of dicotyledonous plants"/>
<rdf:Description rdf:about="&a;109428450">
	<b:glossaryEntry>trees and shrubs usually thorny bearing drupaceous fruit many having medicinal value</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109428744"
	 b:glossaryEntry="type genus of the Rhamnaceae: buckthorns"/>
<rdf:Description rdf:about="&a;109428892">
	<b:glossaryEntry>a shrub or shrubby tree of the genus Rhamnus; fruits are source of yellow dyes or pigments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109429166"
	 b:glossaryEntry="fruit of various buckthorns yielding dyes or pigments"/>
<rdf:Description rdf:about="&a;109429315">
	<b:glossaryEntry>shrubby tree of United States Pacific coast; yields cascara sagrada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109429537"
	 b:glossaryEntry="dried bark of the cascara buckthorn used as a laxative"/>
<rdf:Description rdf:about="&a;109429712">
	<b:glossaryEntry>deciduous shrub of eastern and central United States having black berrylike fruit; golden-yellow in autumn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109429922">
	<b:glossaryEntry>evergreen shrub of western United States bearing small red or black fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109430120"
	 b:glossaryEntry="small tree common in Europe"/>
<rdf:Description rdf:about="&a;109430244">
	<b:glossaryEntry>small spiny evergreen shrub of western United States and Mexico with minute flowers and bright red berries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109430423">
	<b:glossaryEntry>mostly tropical American shrubs or small trees with small yellowish flowers and yellow or red fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109430635">
	<b:glossaryEntry>any of several small to medium-sized trees of Florida and West Indies with thin scaly bark and heavy dark heartwood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109430825"
	 b:glossaryEntry="spiny chiefly tropical American and Asiatic shrubs: jujubes"/>
<rdf:Description rdf:about="&a;109431013"
	 b:glossaryEntry="spiny tree having dark red edible fruits"/>
<rdf:Description rdf:about="&a;109431211"
	 b:glossaryEntry="shrubby deciduous tree of the Mediterranean region"/>
<rdf:Description rdf:about="&a;109431354"
	 b:glossaryEntry="thorny Eurasian shrubs"/>
<rdf:Description rdf:about="&a;109431486"
	 b:glossaryEntry="thorny Eurasian shrub with dry woody winged fruit"/>
<rdf:Description rdf:about="&a;109431658"
	 b:glossaryEntry="a genus of Australasian shrubs and trees"/>
<rdf:Description rdf:about="&a;109431812">
	<b:glossaryEntry>Australian tree grown especially for ornament and its fine-grained wood and bearing edible nuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109432031"
	 b:glossaryEntry="a family of vines belonging to order Rhamnales"/>
<rdf:Description rdf:about="&a;109432239">
	<b:glossaryEntry>the type genus of the family Vitaceae; woody vines with simple leaves and small flowers; includes a wide variety of grapes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109432522">
	<b:glossaryEntry>any of numerous woody vines of genus Vitis bearing clusters of edible berries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109432755">
	<b:glossaryEntry>native grape of northeastern United States; origin of many cultivated varieties e.g. Concord grapes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109432965">
	<b:glossaryEntry>native grape of southeastern United States; origin of many cultivated varieties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109433159">
	<b:glossaryEntry>common European grape cultivated in many varieties; chief source of Old World wine and table grapes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109433603"
	 b:glossaryEntry="white wine grape"/>
<rdf:Description rdf:about="&a;109433714">
	<b:glossaryEntry>any of several purple or white wine grapes used especially for burgundies and champagnes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109433904">
	<b:glossaryEntry>red wine grape; grown especially in California for making Burgundy-type wines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109434057">
	<b:glossaryEntry>white wine grape; grown especially in California for making Chablis-type wines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109434212">
	<b:glossaryEntry>small blue-black grape of Medoc region of France highly prized in winemaking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109434369">
	<b:glossaryEntry>superior red wine grapes grown especially in the Bordeaux region of France and northern California</b:glossaryEntry>
</rdf:Description>
