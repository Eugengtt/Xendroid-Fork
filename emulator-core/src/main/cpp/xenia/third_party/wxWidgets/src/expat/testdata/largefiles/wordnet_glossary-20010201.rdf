</rdf:Description>
<rdf:Description rdf:about="&a;101149285">
	<b:glossaryEntry>earliest fossil amphibian ever found; of the Devonian; found in Pennsylvania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101149475">
