	<b:glossaryEntry>inflammation of one or both testes; characterized by pain and swelling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110296690">
	<b:glossaryEntry>inflammation of a bone as a consequence of infection or trauma or degeneration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110296823">
	<b:glossaryEntry>an inflammation of bone and bone marrow (usually caused by bacterial infection)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110296962"
	 b:glossaryEntry="inflammation of the ear"/>
<rdf:Description rdf:about="&a;110297092">
	<b:glossaryEntry>inflammation of the external ear (including auricle and ear canal)</b:glossaryEntry>
</rdf:Description>
