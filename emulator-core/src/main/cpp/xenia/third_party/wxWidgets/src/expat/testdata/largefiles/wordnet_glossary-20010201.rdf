	<b:glossaryEntry>East Indian tree with racemes of yellow-white flowers; cultivated as an ornamental</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108070035"
	 b:glossaryEntry="large genus of unarmed trees and shrubs of Old World tropics"/>
<rdf:Description rdf:about="&a;108070210"
	 b:glossaryEntry="any of numerous trees of the genus Albizia"/>
<rdf:Description rdf:about="&a;108070390">
