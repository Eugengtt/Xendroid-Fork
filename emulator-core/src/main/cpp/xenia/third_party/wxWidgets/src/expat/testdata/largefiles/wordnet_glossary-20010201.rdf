</rdf:Description>
<rdf:Description rdf:about="&a;200984973"
	 b:glossaryEntry='throw out onto a flat surface, as of die; "Throw a six"'/>
<rdf:Description rdf:about="&a;200985091">
	<b:glossaryEntry>to cause or order to be taken, directed, or transmitted to another place: "He had sent the dispatches downtown to the proper people and had slept."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200985399"
	 b:glossaryEntry='mail in; cause to be delivered; "Send in your comments"'/>
<rdf:Description rdf:about="&a;200985527">
