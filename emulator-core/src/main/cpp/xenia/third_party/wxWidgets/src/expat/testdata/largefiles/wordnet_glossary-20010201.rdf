	 b:glossaryEntry="wood poppies"/>
<rdf:Description rdf:about="&a;108216515">
	<b:glossaryEntry>perennial here native to woodland of the eastern United States having yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108216717">
	<b:glossaryEntry>erect or climbing herbs of the northern hemisphere and southern Africa: bleeding heart; Dutchman''s_breeches; fumitory; squirrel corn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108217022">
	<b:glossaryEntry>annual herbs whose flowers have only one petal spurred at the base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108217196">
