	 b:glossaryEntry='take by theft; "Someone snitched my wallet!"'/>
<rdf:Description rdf:about="&a;201587402">
	<b:glossaryEntry>take without permission; "he walked off my wife!" "The thief walked off with my gold watch"</b:glossaryEntry>
</rdf:Description>
