	<b:glossaryEntry>native to Australia; introduced elsewhere to control scale insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101672446"
	 b:glossaryEntry="ground beetles"/>
<rdf:Description rdf:about="&a;101672611">
	<b:glossaryEntry>predacious shining black or metallic terrestrial beetle that destroys many injurious insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101672835"
	 b:glossaryEntry="bombardier beetles"/>
<rdf:Description rdf:about="&a;101672965"
	 b:glossaryEntry="beetle that ejects audibly a pungent vapor when disturbed"/>
<rdf:Description rdf:about="&a;101673105">
