</rdf:Description>
<rdf:Description rdf:about="&a;201319035">
	<b:glossaryEntry>force a person or an animal into a position from which he cannot escape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201319179">
