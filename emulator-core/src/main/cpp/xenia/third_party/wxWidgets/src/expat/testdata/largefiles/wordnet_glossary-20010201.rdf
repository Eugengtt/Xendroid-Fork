	 b:glossaryEntry="fly very close to the ground"/>
<rdf:Description rdf:about="&a;201331859"
	 b:glossaryEntry="fly by means of a hang glider"/>
<rdf:Description rdf:about="&a;201331981">
	<b:glossaryEntry>be carried or travel on or in a vehicle; "I ride to work in a bus"; "He rides the subway downtown every day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201332419"
	 b:glossaryEntry="ride in a sleigh"/>
<rdf:Description rdf:about="&a;201332507">
