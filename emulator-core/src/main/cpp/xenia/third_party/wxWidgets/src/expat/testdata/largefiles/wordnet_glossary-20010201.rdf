</rdf:Description>
<rdf:Description rdf:about="&a;400254193"
	 b:glossaryEntry='not recorded; "the opera was broadcast live"'/>
<rdf:Description rdf:about="&a;400254270">
	<b:glossaryEntry xml:space='preserve'><![CDATA[comparatives of `soon'' or `early''; "Come a little sooner, if you can"; "came earlier than I expected"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400254416"
	 b:glossaryEntry="at the point of death"/>
<rdf:Description rdf:about="&a;400254477">
