	 b:glossaryEntry="surpass or beat by a wide margin"/>
<rdf:Description rdf:about="&a;200750517">
	<b:glossaryEntry>win a victory over; "You must overcome all difficulties"; "defeat your enemies"; "He overcame his shyness"; "She conquered here fear of mice"; "He overcame his infirmity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200750961">
	<b:glossaryEntry>get on top of; deal with successfully; "He overcame his shyness"</b:glossaryEntry>
</rdf:Description>
