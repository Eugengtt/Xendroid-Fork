	 b:glossaryEntry="spend more than available of (a budget, for example)"/>
<rdf:Description rdf:about="&a;201551896"
	 b:glossaryEntry="spend less than the whole of (a budget, for example)"/>
<rdf:Description rdf:about="&a;201552034">
	<b:glossaryEntry>as of time or space: "I took three hours to get to work this morning"; "This event occupied a very short time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201552250"
	 b:glossaryEntry='spend or use time: "I may be an hour"'/>
<rdf:Description rdf:about="&a;201552355">
