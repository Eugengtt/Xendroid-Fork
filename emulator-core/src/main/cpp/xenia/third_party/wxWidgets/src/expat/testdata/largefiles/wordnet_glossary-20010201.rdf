	 b:glossaryEntry="creating bread or pastry in an oven"/>
<rdf:Description rdf:about="&a;100583827"
	 b:glossaryEntry="creating thread"/>
<rdf:Description rdf:about="&a;100583897"
	 b:glossaryEntry="creating fabric"/>
<rdf:Description rdf:about="&a;100583984"
	 b:glossaryEntry="creating netting"/>
