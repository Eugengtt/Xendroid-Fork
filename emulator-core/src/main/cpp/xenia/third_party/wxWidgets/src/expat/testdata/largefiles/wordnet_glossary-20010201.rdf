	 b:glossaryEntry="a list of people who died recently"/>
<rdf:Description rdf:about="&a;104874191"
	 b:glossaryEntry="a listing of prices for different goods or services"/>
<rdf:Description rdf:about="&a;104874299">
	<b:glossaryEntry>a list in which the next item to be removed is the item most recently stored (LIFO)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104874469">
	<b:glossaryEntry>(in information processing) an ordered list of tasks to be performed or messages to be transmitted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104874637"
	 b:glossaryEntry='a list of names; "his name was struck off the rolls"'/>
<rdf:Description rdf:about="&a;104874857"
	 b:glossaryEntry="a list of persons killed in a war or other disaster"/>
<rdf:Description rdf:about="&a;104874965">
	<b:glossaryEntry>an ordered list of times at which things are planned to occur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104875135">
	<b:glossaryEntry>(British) a list of applicants who have been deemed suitable and from which the successful person will be chosen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104875304">
	<b:glossaryEntry>a list of those who are ill (e.g. on a warship or in a regiment etc)</b:glossaryEntry>
</rdf:Description>
