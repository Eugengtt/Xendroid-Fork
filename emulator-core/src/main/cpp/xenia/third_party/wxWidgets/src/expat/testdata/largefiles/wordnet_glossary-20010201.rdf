</rdf:Description>
<rdf:Description rdf:about="&a;110819685"
	 b:glossaryEntry="an oil obtained from tuna"/>
<rdf:Description rdf:about="&a;110819765">
	<b:glossaryEntry>a black mucky soil with a frozen subsoil that is characteristic of arctic and subarctic regions</b:glossaryEntry>
</rdf:Description>
