	 b:glossaryEntry="most primitive genus of horned dinosaurs; early Cretaceous"/>
<rdf:Description rdf:about="&a;101225717">
	<b:glossaryEntry>primitive dinosaur actually lacking horns and having only the beginning of a frill; long hind and short front limbs; may have been bipedal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101225950">
	<b:glossaryEntry>widespread group including duck-billed dinosaurs and their early relatives (hadrosaurs; trachodon; iguanodon)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101226291"
	 b:glossaryEntry="bipedal herbivorous dinosaur"/>
