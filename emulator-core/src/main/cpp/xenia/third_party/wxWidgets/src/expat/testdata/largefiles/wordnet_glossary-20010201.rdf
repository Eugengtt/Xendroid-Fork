	<b:glossaryEntry>a polymerase that catalyzes the formation of DNA using RNA as a template; found especially in retroviruses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110752928"
	 b:glossaryEntry="any material used for its color"/>
<rdf:Description rdf:about="&a;110753149">
	<b:glossaryEntry>a usually soluble substance for staining or coloring e.g. fabrics or hair</b:glossaryEntry>
</rdf:Description>
