<rdf:Description rdf:about="&a;106726901"
	 b:glossaryEntry="a shelf of rock with steep slopes above and below"/>
<rdf:Description rdf:about="&a;106727012">
	<b:glossaryEntry>extensive tract of level open land; "they emerged from the woods onto a vast open plain"; "he longed for the fields of his youth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106727321"
	 b:glossaryEntry="a level tract of land"/>
<rdf:Description rdf:about="&a;106727393">
	<b:glossaryEntry>open land usually with peaty soil covered with heather and bracken and moss</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106727530"
	 b:glossaryEntry="a permanent wide expanse of snow"/>
<rdf:Description rdf:about="&a;106727618">
	<b:glossaryEntry>extensive plain without trees (associated with eastern Russia and Siberia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106727745">
	<b:glossaryEntry>a vast treeless plain in the arctic regions between the ice cap and the tree line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106727879">
	<b:glossaryEntry>hilly land; "they loved to roam the hills of West Virginia"; "the Black Hills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106728027"
	 b:glossaryEntry="hilly land on the lower slopes of mountains"/>
<rdf:Description rdf:about="&a;106728126">
	<b:glossaryEntry>the point where a stream issues into a larger body of water; "New York is at the mouth of the Hudson"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106728279">
	<b:glossaryEntry>a low triangular area where a river divides before entering a larger body of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106728413"
	 b:glossaryEntry="low level country"/>
<rdf:Description rdf:about="&a;106728520"
	 b:glossaryEntry="a low area that has been filled in"/>
<rdf:Description rdf:about="&a;106728627"
	 b:glossaryEntry="a low area where waste is buried between layers of earth"/>
<rdf:Description rdf:about="&a;106728747">
	<b:glossaryEntry>an enclosure within which something originates or develops (from the Latin for womb)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106728884"
	 b:glossaryEntry="a depression hollowed out of solid matter"/>
<rdf:Description rdf:about="&a;106729093"
	 b:glossaryEntry="a hole in the ground made by gophers"/>
<rdf:Description rdf:about="&a;106729187"
	 b:glossaryEntry="a hole in the ground made by an animal for shelter"/>
<rdf:Description rdf:about="&a;106729317">
	<b:glossaryEntry>a series of connected underground tunnels occupied by rabbits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106729447"
	 b:glossaryEntry="a hole in the ground as a nest made by wild rabbits"/>
<rdf:Description rdf:about="&a;106729572"
	 b:glossaryEntry="hole made by a burrowing worm"/>
<rdf:Description rdf:about="&a;106729656">
	<b:glossaryEntry>a sizeable hole (usually in the ground); "they dug a pit to bury the body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106729879">
	<b:glossaryEntry>(golf) the cavity left when a piece of turf is cut from the ground by the club head in making a stroke; "it was a good drive but the ball ended up in a divot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106730089">
	<b:glossaryEntry>a pit or hole produced by wear or weathering (especially in a road surface)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106730230">
	<b:glossaryEntry>a depression in the ground communicating with a subterranean passage (especially in limestone) and formed by solution or by collapse of a cavern roof</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106730449"
	 b:glossaryEntry="a large pit in sandy ground from which sand is dug"/>
<rdf:Description rdf:about="&a;106730553">
	<b:glossaryEntry>a pit over which lumber is positioned to be sawed by two men with a long two-handled saw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106730694">
	<b:glossaryEntry>a natural accumulation of bitumens at the surface of the earth; often acts as a trap for animals whose bones are thus preserved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106730875"
	 b:glossaryEntry="a long steep-sided depression in the ocean floor"/>
<rdf:Description rdf:about="&a;106730976">
	<b:glossaryEntry>a long depression in the surface of the land that usually contains a river</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106731236">
	<b:glossaryEntry>a natural depression in the surface of the land with a lake at the bottom of it; "the basin of the Great Salt Lake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106731457">
	<b:glossaryEntry>a steep-walled semicircular basin in a mountain; may contain a lake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106731592">
	<b:glossaryEntry>a shallow basin in a desert region; contains salt and gypsum that was deposited by an evaporated salt lake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106731752">
	<b:glossaryEntry>a bowl-shaped depression formed by the impact of a meteorite or bomb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106731909">
	<b:glossaryEntry>a crater that has collected cosmic material hitting the earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106732026"
	 b:glossaryEntry="a crater on the Earth''s moon"/>
<rdf:Description rdf:about="&a;106732149"
	 b:glossaryEntry="a bright crater on the moon"/>
<rdf:Description rdf:about="&a;106732234"
	 b:glossaryEntry="a conspicuous crater on the moon"/>
<rdf:Description rdf:about="&a;106732323"
	 b:glossaryEntry="a basin that is full of water at high tide"/>
<rdf:Description rdf:about="&a;106732423"
	 b:glossaryEntry="(British) an open river valley (in a hilly area)"/>
<rdf:Description rdf:about="&a;106732522"
	 b:glossaryEntry="(Scottish) a narrow secluded valley (in the mountains)"/>
<rdf:Description rdf:about="&a;106732627">
	<b:glossaryEntry>a small valley between mountains; "he built himself a cabin in a hollow high up in the Appalachians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106732807"
	 b:glossaryEntry="a small wooded hollow"/>
<rdf:Description rdf:about="&a;106732888">
	<b:glossaryEntry>a deep narrow steep-sided valley (especially one formed by running water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106733050">
	<b:glossaryEntry>a valley with steep sides; formed by a rift in the earth''s crust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106733172">
	<b:glossaryEntry>a vast valley in central California known for its rich farmland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106733319">
	<b:glossaryEntry>a large valley between the Allegheny and Blue Ridge mountains in northern Virginia; site of numerous battles during the American Civil War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106733540">
	<b:glossaryEntry>(North America) a ravine formed by a river in an area with little rainfall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106733694"
	 b:glossaryEntry="the enormous gorge of the Colorado River in northern Arizona"/>
<rdf:Description rdf:about="&a;106733832"
	 b:glossaryEntry="a deep ravine (usually with a river running through it)"/>
<rdf:Description rdf:about="&a;106733993">
	<b:glossaryEntry>a gorge in northeastern Tanzania where anthropologists have found some of the earliest human remains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106734172"
	 b:glossaryEntry="a narrow gorge with a stream running through it"/>
<rdf:Description rdf:about="&a;106734279">
	<b:glossaryEntry>deep ditch cut by running water (especially after a prolonged downpour)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106734456"
	 b:glossaryEntry="(southwestern United States) a stream or brook"/>
<rdf:Description rdf:about="&a;106734555"
	 b:glossaryEntry="a gully that is shallower than a ravine"/>
<rdf:Description rdf:about="&a;106734645">
	<b:glossaryEntry>a narrow depression (as in the earth or between ocean waves or in the ocean bed)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106734778">
	<b:glossaryEntry>gully or streambed in North Africa and the Middle East that remains dry except during rainy season</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106734927"
	 b:glossaryEntry="natural or artificial channel through which water flows"/>
<rdf:Description rdf:about="&a;106735040">
	<b:glossaryEntry>a pit filled with loose wet sand into which heavy objects sink</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106735177"
	 b:glossaryEntry="an opening (especially a gap in a dike or fortification)"/>
<rdf:Description rdf:about="&a;106735286"
	 b:glossaryEntry="a deep wide chasm"/>
<rdf:Description rdf:about="&a;106735354"
	 b:glossaryEntry="a bottomless gulf or pit"/>
<rdf:Description rdf:about="&a;106735438"
	 b:glossaryEntry="a deep opening in the earth''s surface"/>
<rdf:Description rdf:about="&a;106735563"
	 b:glossaryEntry="a narrow fissure in rock"/>
<rdf:Description rdf:about="&a;106735638"
	 b:glossaryEntry="a deep fissure"/>
<rdf:Description rdf:about="&a;106735707">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(geology) a fracture in the earth''s crust with displacement of one side with respect to the other; "they built it right on the San Andreas fault"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106735991"
	 b:glossaryEntry="a fault in which one side is above the other"/>
<rdf:Description rdf:about="&a;106736170">
	<b:glossaryEntry>a major geological fault in California; runs from San Diego to San Francisco; the source of serious earthquakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106736364">
	<b:glossaryEntry>an inclined fault in which the hanging wall appears to have slipped down relative to the footwall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106736536">
	<b:glossaryEntry>an inclined fault in which the hanging wall appears to have been thrust upward with respect to the footwall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106736702"
	 b:glossaryEntry="the lower wall of an inclined fault"/>
<rdf:Description rdf:about="&a;106736811"
	 b:glossaryEntry="the upper wall of an inclined fault"/>
<rdf:Description rdf:about="&a;106736924"
	 b:glossaryEntry="an opening into or through something"/>
<rdf:Description rdf:about="&a;106737173">
	<b:glossaryEntry>a hole through which an animal may bolt when pursued into its burrow or den</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106737304"
	 b:glossaryEntry="a hole made by a bullet passing through it"/>
<rdf:Description rdf:about="&a;106737404"
	 b:glossaryEntry="a hole (as in the wall of a building) made by rats"/>
<rdf:Description rdf:about="&a;106737508">
	<b:glossaryEntry>a gap between cloud masses; "the sun shone through a rift in the clouds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106737631">
	<b:glossaryEntry>an opening that resembles a window in appearance or function; "he could see them through a window in the trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106737795">
	<b:glossaryEntry>an underground enclosure with access from the surface of the ground or from the sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106738040"
	 b:glossaryEntry="a small cave (usually with attractive features)"/>
<rdf:Description rdf:about="&a;106738147"
	 b:glossaryEntry="a large cave or a large chamber in a cave"/>
<rdf:Description rdf:about="&a;106738241"
	 b:glossaryEntry='any large dark enclosed space; "his eyes were dark caverns"'/>
<rdf:Description rdf:about="&a;106738353"
	 b:glossaryEntry="small or narrow cave in the side of a cliff or mountain"/>
<rdf:Description rdf:about="&a;106738459">
	<b:glossaryEntry>a cylinder of calcium carbonate projecting upward from the floor of a limestone cave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106738619">
	<b:glossaryEntry>a cylinder of calcium carbonate hanging from the roof of a limestone cave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106738768">
	<b:glossaryEntry>a fissure in the earth''s crust (or in the surface of some other planet) through which molten lava and gases erupt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106738951"
	 b:glossaryEntry="land bordering an ocean"/>
<rdf:Description rdf:about="&a;106739031"
	 b:glossaryEntry="land bordering a lake"/>
<rdf:Description rdf:about="&a;106739108"
	 b:glossaryEntry="an area of sand sloping down to the water of a sea or lake"/>
<rdf:Description rdf:about="&a;106739274"
	 b:glossaryEntry="the beach at a seaside resort"/>
<rdf:Description rdf:about="&a;106739355"
	 b:glossaryEntry='a long ridge or pile; "a huge bank of earth"'/>
<rdf:Description rdf:about="&a;106739486">
	<b:glossaryEntry>a submerged bank of sand near a shore or in a river; can be exposed at low tide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106739638"
	 b:glossaryEntry="a sandbank in a stretch of water that is visible at low tide"/>
<rdf:Description rdf:about="&a;106739750">
	<b:glossaryEntry>a submerged (or partly submerged) ridge in a river or along a shore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106739903"
	 b:glossaryEntry="a bar of sand"/>
<rdf:Description rdf:about="&a;106740000">
	<b:glossaryEntry>a ridge of sand created by the wind; found in deserts or near lakes and oceans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106740141"
	 b:glossaryEntry="a projecting ridge on a mountain or submerged under water"/>
<rdf:Description rdf:about="&a;106740258">
	<b:glossaryEntry>a submerged ridge of rock or coral near the surface of the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106740391">
	<b:glossaryEntry>one of a series of small ridges produced in sand by water currents or by wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106740526"
	 b:glossaryEntry="a coral reef off the southern coast of Florida"/>
<rdf:Description rdf:about="&a;106740662"
	 b:glossaryEntry="a reef consisting of coral consolidated into limestone"/>
<rdf:Description rdf:about="&a;106740827"
	 b:glossaryEntry="a long coral reef near and parallel to the shore"/>
<rdf:Description rdf:about="&a;106740934">
	<b:glossaryEntry>an island consisting of a circular coral reef surrounding a lagoon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106741106">
	<b:glossaryEntry>the main land mass of a country or continent; as distinguished from an island or peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106741251">
	<b:glossaryEntry>a land mass (smaller than a continent) that is surrounded by water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106743549"
	 b:glossaryEntry="a small island"/>
<rdf:Description rdf:about="&a;106743622"
	 b:glossaryEntry="a group of many islands in a large body of water"/>
<rdf:Description rdf:about="&a;106744503"
	 b:glossaryEntry="a large mass of land projecting into a body of water"/>
<rdf:Description rdf:about="&a;106744953"
	 b:glossaryEntry="a peninsular region of eastern Canada"/>
<rdf:Description rdf:about="&a;106745081"
	 b:glossaryEntry="a mountainous peninsula on northwest Mexico"/>
<rdf:Description rdf:about="&a;106745243">
	<b:glossaryEntry>a relatively narrow strip of land (with water on both sides) connecting two larger land areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106745408"
	 b:glossaryEntry="the isthmus that connects Central America and South America"/>
<rdf:Description rdf:about="&a;106745550"
	 b:glossaryEntry="a narrow elongated projecting strip of land"/>
<rdf:Description rdf:about="&a;106745644">
	<b:glossaryEntry>a natural elevation (especially a rocky one that just out into the sea)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106745866">
	<b:glossaryEntry>a promontory extending out into a large body of water; "they sailed south around the point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106746009">
	<b:glossaryEntry>a term used in Scottish names of promontories; "the Mull of Kintyre"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106746128"
	 b:glossaryEntry="land forming the forward margin of something"/>
<rdf:Description rdf:about="&a;106746227"
	 b:glossaryEntry="a strip of land projecting into a body of water"/>
<rdf:Description rdf:about="&a;106746386"
	 b:glossaryEntry="a narrow strip of land that juts out into the sea"/>
<rdf:Description rdf:about="&a;106746514">
	<b:glossaryEntry>any long object resembling a thin line; "a mere ribbon of land"; "the lighted ribbon of traffic"; "from the air the road was a gray thread"; "a thread of smoke climbed upward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106746769">
	<b:glossaryEntry>something long and thin resembling a blade of grass; "a blade of lint on his suit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106746903"
	 b:glossaryEntry='any broad thin expanse or surface: "a sheet of ice"'/>
<rdf:Description rdf:about="&a;106747006">
	<b:glossaryEntry>a large and unbroken expanse or distance; "a stretch of highway"; "a stretch of clear water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106747170">
	<b:glossaryEntry>a stretch of water without current or movement; "suddenly they were in slack water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106747305">
	<b:glossaryEntry>an arc of colored light in the sky caused by refraction of the sun''s rays by rain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106747459"
	 b:glossaryEntry="a large mass of ice"/>
<rdf:Description rdf:about="&a;106747605">
	<b:glossaryEntry>a mass of ice and snow that permanently covers a large area of land (e.g., the polar regions or a mountain peak)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106747770"
	 b:glossaryEntry="a slowly moving mass of ice"/>
<rdf:Description rdf:about="&a;106747944"
	 b:glossaryEntry="a glacier that spreads out from a central mass of ice"/>
<rdf:Description rdf:about="&a;106748081"
	 b:glossaryEntry="a glacier near the Arctic or Antarctic poles"/>
<rdf:Description rdf:about="&a;106748185"
	 b:glossaryEntry="a glacier that moves down from a high valley"/>
<rdf:Description rdf:about="&a;106748290">
	<b:glossaryEntry>a large mass of ice floating at sea; usually broken off of a polar glacier</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106748443">
	<b:glossaryEntry>a small iceberg or ice floe just large enough to be hazardous for shipping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106748571"
	 b:glossaryEntry="a flat mass of ice floating at sea"/>
<rdf:Description rdf:about="&a;106748679"
	 b:glossaryEntry="accumulated earth and stones deposited by a glacier"/>
<rdf:Description rdf:about="&a;106748803"
	 b:glossaryEntry="the envelope of gases surrounding any celestial body"/>
<rdf:Description rdf:about="&a;106749007"
	 b:glossaryEntry="outer space as viewed from the earth"/>
<rdf:Description rdf:about="&a;106749186">
	<b:glossaryEntry>the sky as viewed during daylight; "he shot an arrow into the blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106749345">
	<b:glossaryEntry>a sky filled with rows of cirrocumulus or small altocumulus clouds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106749470">
	<b:glossaryEntry>a visible mass of water or ice particles suspended at a considerable altitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106749817">
	<b:glossaryEntry>a cloud at a high altitude consisting of a series of regularly arranged small clouds resembling ripples</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106750000"
	 b:glossaryEntry="a thin uniform layer of hazy cloud at high altitude"/>
<rdf:Description rdf:about="&a;106750131">
	<b:glossaryEntry>a dark cloud of great vertical extent charged with electricity; associated with thunderstorms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106750319"
	 b:glossaryEntry="a globular cloud"/>
<rdf:Description rdf:about="&a;106750423"
	 b:glossaryEntry="a dark gray cloud bearing rain"/>
<rdf:Description rdf:about="&a;106750553"
	 b:glossaryEntry="a cumulus cloud at an intermediate altitude of 2 or 3 miles"/>
<rdf:Description rdf:about="&a;106750690">
	<b:glossaryEntry>a wispy white cloud (usually of fine ice crystals) at a high altitude (4 to 8 miles)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106750860"
	 b:glossaryEntry="a large dark low cloud"/>
<rdf:Description rdf:about="&a;106750970"
	 b:glossaryEntry="a stratus cloud at an intermediate altitude of 2 or 3 miles"/>
<rdf:Description rdf:about="&a;106751107"
	 b:glossaryEntry="a long narrow flowing cirrus cloud"/>
<rdf:Description rdf:about="&a;106751199"
	 b:glossaryEntry="a layer of clouds seen from a distance"/>
<rdf:Description rdf:about="&a;106751294"
	 b:glossaryEntry="a heavy dark cloud presaging rain or a storm"/>
<rdf:Description rdf:about="&a;106751396">
	<b:glossaryEntry>an artificial cloud created by an aircraft; caused either by condensation due to the reduction in air pressure above the wing surface or by water vapor in the engine exhaust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106751645">
	<b:glossaryEntry>the galaxy containing the solar system; consists of millions of stars that can be seen as a diffuse band of light stretching across the night sky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106751922">
	<b:glossaryEntry>the sun with the celestial bodies that revolve around it in its gravitational field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106752330">
	<b:glossaryEntry>either of two galaxies orbiting the Milky Way; visible near the south celestial pole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106752513">
	<b:glossaryEntry>the larger of the two Magellanic galaxies visible from the southern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106752660">
	<b:glossaryEntry>the smaller of the two Magellanic galaxies visible from the southern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106752808">
	<b:glossaryEntry>an immense cloud of gas (mainly hydrogen) and dust in interstellar space</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106752969"
	 b:glossaryEntry="a cluster of stars within an intricate cloud of gas and dust"/>
<rdf:Description rdf:about="&a;106753125">
	<b:glossaryEntry>a nebula that was once thought to be a star with its planets but is now thought to be a very hot star surrounded by an expanding envelope of ionized gases that emit a fluorescent glow because of intense radiation from the star</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106753414"
	 b:glossaryEntry="the smallest planet and the nearest to the sun"/>
<rdf:Description rdf:about="&a;106753533">
	<b:glossaryEntry>the second nearest planet to the sun; visible as an early `morning star'' or an `evening star''; rotates slowly in the opposite direction from the normal rotation of the planets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106753779">
	<b:glossaryEntry>the 3rd planet from the sun; the planet on which we live; "the Earth moves around the sun"; "he sailed around the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106754119"
	 b:glossaryEntry="the 4th planet from the sun"/>
<rdf:Description rdf:about="&a;106754247">
	<b:glossaryEntry>the largest planet and the 5th from the sun; has many satellites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106754384">
	<b:glossaryEntry>one of the four satellites of Jupiter that were discovered by Galileo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106754601"
	 b:glossaryEntry="the closest of Jupiter''s moons; has active volcanoes"/>
<rdf:Description rdf:about="&a;106754702"
	 b:glossaryEntry="the largest of Jupiter''s satellites"/>
<rdf:Description rdf:about="&a;106754792"
	 b:glossaryEntry="the second largest of Jupiter''s satellites"/>
<rdf:Description rdf:about="&a;106754889">
	<b:glossaryEntry>the 4th largest of Jupiter''s satellites; covered with a smooth shell of frozen water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106755026">
	<b:glossaryEntry>a giant planet which is surrounded by three planar concentric rings of ice particles; 6th planet from the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106755207">
	<b:glossaryEntry>the largest of the satellites of Saturn; has a hazy nitrogen atmosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106755330">
	<b:glossaryEntry>a giant planet with a ring of ice particles; 7th from the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106755463">
	<b:glossaryEntry>a giant planet with a ring of ice particles; the 8th planet from the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106755608">
	<b:glossaryEntry>the second smallest planet and the farthest known from the sun; has the most elliptical orbit of all the planets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106755791">
	<b:glossaryEntry>any of numerous small celestial bodies composed of rock and metal that move around the sun (mainly between the orbits of Mars and Jupiter)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106756084"
	 b:glossaryEntry="an asteroid whose orbit crosses the Earth''s orbit"/>
<rdf:Description rdf:about="&a;106756195"
	 b:glossaryEntry="the largest asteroid and the first discovered"/>
<rdf:Description rdf:about="&a;106756292"
	 b:glossaryEntry="the brightest asteroid but the fourth to be discovered"/>
<rdf:Description rdf:about="&a;106756398">
	<b:glossaryEntry>interstellar space including streams of protons moving from the stars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106756533">
	<b:glossaryEntry>interplanetary space including forms of energy and gas and dust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106756759"
	 b:glossaryEntry="microscopic particles in the interplanetary medium"/>
<rdf:Description rdf:about="&a;106756894">
	<b:glossaryEntry>a rarefied flow of gas and charged particles (plasma) that stream from the sun and form the solar wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106757099">
	<b:glossaryEntry>a natural object resembling a machine in structure and function; "the mechanism of the ear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106757282">
	<b:glossaryEntry>anything serving to maintain separation by obstructing vision or access</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106757461">
	<b:glossaryEntry>a mechanism that creates a barrier between brain tissues and circulating blood; serves to protect the central nervous system; "the brain was protected from the large molecules of the virus by the blood-brain barrier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106757743">
	<b:glossaryEntry>any barrier to communication or vision; "a curtain of secrecy"; "a curtain of trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106757881"
	 b:glossaryEntry="natural objects visible in the sky"/>
<rdf:Description rdf:about="&a;106758155"
	 b:glossaryEntry="any object that radiates energy"/>
<rdf:Description rdf:about="&a;106758259"
	 b:glossaryEntry="an object that radiates radio waves"/>
<rdf:Description rdf:about="&a;106758353">
	<b:glossaryEntry>(astronomy) a relatively small celestial body consisting of a frozen mass that travels around the sun in a highly elliptical orbit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106758573">
	<b:glossaryEntry>(astronomy) the luminous cloud of particles surrounding the frozen nucleus of a comet; forms as the comet approaches the sun and is warmed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106758781">
	<b:glossaryEntry>(astronomy) the center of the head of a comet; consists of small solid particles of ice and frozen gas that vaporizes on approaching the sun to form the coma and tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106759020">
	<b:glossaryEntry>(astronomy) any of the small solid bodies traveling through space around the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106759210"
	 b:glossaryEntry="a group of meteoroids with a similar path around the sun"/>
<rdf:Description rdf:about="&a;106759325"
	 b:glossaryEntry="a meteoroid that has entered the earth''s atmosphere"/>
<rdf:Description rdf:about="&a;106759482"
	 b:glossaryEntry="a very luminous meteor (sometimes exploding)"/>
<rdf:Description rdf:about="&a;106759590"
	 b:glossaryEntry="the luminous center of a nuclear explosion"/>
<rdf:Description rdf:about="&a;106759706">
	<b:glossaryEntry>a ball of fire (such as the sun or a ball-shaped discharge of lightning)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106759833">
	<b:glossaryEntry>stony or metallic object that is the remains of a meteoroid that has reached the earth''s surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106760039">
	<b:glossaryEntry>a meteorite so small that it drifts down to earth without becoming intensely heated in the atmosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106760201"
	 b:glossaryEntry="a stony meteorite consisting of silicate minerals"/>
<rdf:Description rdf:about="&a;106760305"
	 b:glossaryEntry="a meteorite consisting principally of metallic iron"/>
<rdf:Description rdf:about="&a;106760411">
	<b:glossaryEntry>any of the celestial bodies (other than comets or satellites) that revolve around the sun in the solar system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106760682">
	<b:glossaryEntry>any of the planets whose orbit lies outside the earth''s orbit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106760859">
	<b:glossaryEntry>any of the planets whose orbit lies inside the earth''s orbit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106761017">
	<b:glossaryEntry>a planet having a compact rocky surface like the Earth''s; the four innermost planets in the solar system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106761240">
	<b:glossaryEntry>any of the four outermost planets in the solar system; much larger than Earth and gaseous in nature (like Jupiter)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106761498">
	<b:glossaryEntry>one of many small solid celestial bodies thought to have existed at an early stage in the development of the solar system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106761678">
	<b:glossaryEntry>a planet (usually Venus) seen just before sunrise in the eastern sky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106761805"
	 b:glossaryEntry="a planet (usually Venus) seen at sunset in the western sky"/>
<rdf:Description rdf:about="&a;106761922">
	<b:glossaryEntry>any celestial body visible (as a point of light) from the Earth at night</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106762045">
	<b:glossaryEntry>(astronomy) a celestial body of hot gases that radiates energy derived from thermonuclear reactions in the interior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106762627">
	<b:glossaryEntry>a starlike object that may send out radio waves and other forms of energy; large red shifts imply enormous recession velocities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106762836">
	<b:glossaryEntry>guiding star; a star that is used as a reference point in navigation of astronomy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106763001"
	 b:glossaryEntry="any star in the Ptolemaic theory of planetary motion"/>
<rdf:Description rdf:about="&a;106763110"
	 b:glossaryEntry="a star that varies noticeably in brightness"/>
<rdf:Description rdf:about="&a;106763242">
	<b:glossaryEntry>a system of two stars that revolve around each other under their mutual gravitation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106763568"
	 b:glossaryEntry="a system of three or more stars associated by gravity"/>
<rdf:Description rdf:about="&a;106763699">
	<b:glossaryEntry>a very bright star of large diameter and low density (relative to the Sun)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106763874">
	<b:glossaryEntry>an extremely bright star of very large diameter and low density</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106764012"
	 b:glossaryEntry="a faint star of enormous density"/>
<rdf:Description rdf:about="&a;106764121">
	<b:glossaryEntry>a small cool star; approximately 100 times the mass of Jupiter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106764274">
	<b:glossaryEntry>a red dwarf star in which luminosity can change several magnitudes in a few minutes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106764432">
	<b:glossaryEntry>a star that has collapsed under its own gravity; it is composed of neutrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106764584">
	<b:glossaryEntry>a degenerate neutron star; small and extremely dense; rotates very fast and emits regular pulses of polarized radiation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106764756">
	<b:glossaryEntry>a star that ejects some of its material in the form of a cloud and become more luminous in the process</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106764909">
	<b:glossaryEntry>a star that explodes and becomes extremely luminous in the process</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106765049"
	 b:glossaryEntry="any celestial body orbiting around a planet or star"/>
<rdf:Description rdf:about="&a;106765228">
	<b:glossaryEntry>any natural satellite of a planet; "Jupiter has sixteen moons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106765341">
	<b:glossaryEntry>a dark region of considerable extent on the surface of the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106765463">
	<b:glossaryEntry>the natural satellite of the Earth; "the average distance to the moon is 384,400 kilometers"; "men first stepped on the moon in 1969"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106765647">
	<b:glossaryEntry>a typical star that is the source of light and heat for the planets in the solar system; "the sun contains 99.85% of the mass in the solar system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106765862"
	 b:glossaryEntry="any star around which a planetary system evolves"/>
<rdf:Description rdf:about="&a;106765960"
	 b:glossaryEntry="the brightest star in the sky; in Canis Major"/>
<rdf:Description rdf:about="&a;106766108">
	<b:glossaryEntry>the brightest star in Ursa Minor; at the end of the handle of the little dipper; the northern axis of the earth points toward it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106766383"
	 b:glossaryEntry="the brightest star in Canis Minor"/>
<rdf:Description rdf:about="&a;106766489"
	 b:glossaryEntry="the second brightest star in Orion"/>
<rdf:Description rdf:about="&a;106766615"
	 b:glossaryEntry="the brightest star in Orion"/>
<rdf:Description rdf:about="&a;106766709"
	 b:glossaryEntry="the brightest star in Auriga"/>
<rdf:Description rdf:about="&a;106766810"
	 b:glossaryEntry="the largest known star"/>
<rdf:Description rdf:about="&a;106766913">
	<b:glossaryEntry>second brightest star in Perseus; first known eclipsing binary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106767046">
	<b:glossaryEntry>the 4th brightest star and the brightest star in the constellation Bootes; 36 light-years from Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106767220">
	<b:glossaryEntry>a multiple star with 6 components; second brightest in Gemini; close to Pollux</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106767388"
	 b:glossaryEntry="the brightest star in Gemini; close to Castor"/>
<rdf:Description rdf:about="&a;106767505"
	 b:glossaryEntry="the brightest star in Leo"/>
<rdf:Description rdf:about="&a;106767603"
	 b:glossaryEntry="the brightest star in Virgo"/>
<rdf:Description rdf:about="&a;106767701"
	 b:glossaryEntry="the brightest star in Scorpius"/>
<rdf:Description rdf:about="&a;106767804"
	 b:glossaryEntry="the brightest star in Taurus"/>
<rdf:Description rdf:about="&a;106767907"
	 b:glossaryEntry="a remnant of a supernova detected first in 1054 AD"/>
<rdf:Description rdf:about="&a;106768034"
	 b:glossaryEntry="a configuration of stars as seen from the earth"/>
<rdf:Description rdf:about="&a;106768863"
	 b:glossaryEntry="(astronomy) a cluster of stars (or a small constellation)"/>
<rdf:Description rdf:about="&a;106769030">
	<b:glossaryEntry>a small conspicuous constellation the the southern hemisphere in the Milky Way near Centaurus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106769265"
	 b:glossaryEntry="the brightest star in the Southern Cross"/>
<rdf:Description rdf:about="&a;106769383"
	 b:glossaryEntry="the second brightest star in the Southern Cross"/>
<rdf:Description rdf:about="&a;106769507">
	<b:glossaryEntry>a conspicuous constellation in the northern hemisphere; between Great Bear and Orion at edge of Milk Way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106769702">
	<b:glossaryEntry>a conspicuous constellation in the northern hemisphere; between Auriga and Cassiopeia and crossed by the Milky Way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106769889"
	 b:glossaryEntry="a W-shaped constellation near Polaris"/>
<rdf:Description rdf:about="&a;106769983">
	<b:glossaryEntry>a zodiacal constellation in the northern hemisphere between Taurus and Cancer on the ecliptic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106770186"
	 b:glossaryEntry="a constellation in the northern hemisphere near Ursa Major"/>
<rdf:Description rdf:about="&a;106770316">
	<b:glossaryEntry>a constellation in the northern hemisphere between Ursa Major and Bootes; contains a cluster of some 10,000 galaxies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106770493">
	<b:glossaryEntry>a small constellation in the northern hemisphere between Bootes and Hercules</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106770631">
	<b:glossaryEntry>a large constellation in the northern hemisphere between Lyra and Corona Borealis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106770767">
	<b:glossaryEntry>a constellation in the southern hemisphere near the south celestial pole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106770892">
	<b:glossaryEntry>a small constellation in the northern hemisphere near Cygnus and Draco; contains the star Vega</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106771056">
	<b:glossaryEntry>a constellation in the northern hemisphere between Pegasus and Draco in the Milky Way; contains a black hole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106771236">
	<b:glossaryEntry>a region of space resulting from the collapse of a star; extremely high gravitational field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106771384">
	<b:glossaryEntry>a faint constellation twisting around the north celestial pole and lying between Ursa Major and Cepheus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106771540"
	 b:glossaryEntry="the brightest star in the constellation Lyra"/>
<rdf:Description rdf:about="&a;106771654">
	<b:glossaryEntry>a small zodiacal constellation in the northern hemisphere; between Leo and Gemini</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106771807">
	<b:glossaryEntry>a zodiacal constellation in northern hemisphere between Cancer and Virgo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106771967">
	<b:glossaryEntry>a large zodiacal constellation on the equator; between Leo and Libra</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106772125">
	<b:glossaryEntry>a small quadrilateral constellation in the southern hemisphere near Virgo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106772258"
	 b:glossaryEntry="a faint constellation in the southern hemisphere near Virgo"/>
<rdf:Description rdf:about="&a;106772370">
	<b:glossaryEntry>a long faint constellation near the equator stretching between Virgo and Cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106772509">
	<b:glossaryEntry>a small faint zodiacal constellation in the southern hemisphere; between Virgo and Scorpius</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106772671"
	 b:glossaryEntry="a large zodiacal constellation between Libra and Sagittarius"/>
<rdf:Description rdf:about="&a;106772834">
	<b:glossaryEntry>a large zodiacal constellation in the southern hemisphere; between Scorpius and Capricornus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106773002">
	<b:glossaryEntry>a faint zodiacal constellation in the southern hemisphere; between Sagittarius and Aquarius</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106773182">
	<b:glossaryEntry>a zodiacal constellation in the southern hemisphere; between Capricornus and Pisces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106773339">
	<b:glossaryEntry>a large faint zodiacal constellation; between Aquarius and Aries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106773475">
	<b:glossaryEntry>a small zodiacal constellation in the northern hemisphere; between Pisces and Taurus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106773630">
	<b:glossaryEntry>a conspicuous constellation in the southern hemisphere near the Southern Cross</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106773864"
	 b:glossaryEntry="a constellation in the southern hemisphere near Centaurus"/>
<rdf:Description rdf:about="&a;106773973"
	 b:glossaryEntry="brightest star in Centaurus; second nearest star to the sun"/>
<rdf:Description rdf:about="&a;106774133"
	 b:glossaryEntry="the nearest star to the sun; distance: 4.3 light years"/>
<rdf:Description rdf:about="&a;106774279"
	 b:glossaryEntry="the second brightest star in Centaurus"/>
<rdf:Description rdf:about="&a;106774396"
	 b:glossaryEntry="a global cluster in the constellation Centaurus"/>
<rdf:Description rdf:about="&a;106774523">
	<b:glossaryEntry>a constellation in the northern hemisphere near Andromeda and Pisces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106774645">
	<b:glossaryEntry>a constellation in the northern hemisphere between Cassiopeia and Pegasus; contains the Andromeda Galaxy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106774805">
	<b:glossaryEntry>a faint constellation in the northern hemisphere near Cassiopeia and the Pole Star</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106774941">
	<b:glossaryEntry>a constellation on the equator east of Taurus; contains Betelgeuse and Rigel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106775119"
	 b:glossaryEntry="a constellation southeast of Orion; contains Sirius"/>
<rdf:Description rdf:about="&a;106775259"
	 b:glossaryEntry="a constellation east of Orion; contains Procyon"/>
<rdf:Description rdf:about="&a;106775396">
	<b:glossaryEntry>a constellation outside the Zodiac that rotates around the North Star</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106775554">
	<b:glossaryEntry>a group of seven bright stars in the constellation Ursa Major</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106775726">
	<b:glossaryEntry>a constellation outside the Zodiac that rotates around the North Star</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106775904">
	<b:glossaryEntry>a cluster of seven stars in Ursa Minor; at the end of the dipper''s handle is Polaris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106776095">
	<b:glossaryEntry>a cluster of 5 bright stars forming a cross in the constellation Cygnus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106776246"
	 b:glossaryEntry="a star cluster in the constellation Taurus"/>
<rdf:Description rdf:about="&a;106776381"
	 b:glossaryEntry="one of the stars in the star cluster Pleiades"/>
<rdf:Description rdf:about="&a;106776510">
	<b:glossaryEntry>a zodiacal constellation in the northern hemisphere near Orion; between Aries and Gemini</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106776727">
	<b:glossaryEntry>a large faint constellation in the southern hemisphere containing most of the Small Magellanic Cloud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106776880">
	<b:glossaryEntry>the lowest atmospheric layer; from 4 to 11 miles high (depending on latitude)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106777053">
	<b:glossaryEntry>the region of discontinuity between the troposphere and the stratosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106777201">
	<b:glossaryEntry>the atmospheric layer between the stratosphere and the thermosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106777344">
	<b:glossaryEntry>the atmospheric layer between the troposphere and the mesosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106777505">
	<b:glossaryEntry>a layer in the stratosphere (at approximately 20 miles) that contains a concentration of ozone sufficient to block most ultraviolet radiation from the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106777755">
	<b:glossaryEntry>an area of the ozone layer (near the poles) that is seasonally depleted of ozone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106777911">
	<b:glossaryEntry>the atmospheric layer between the mesosphere and the exosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106778051"
	 b:glossaryEntry="the outermost atmospheric layer"/>
<rdf:Description rdf:about="&a;106778157">
	<b:glossaryEntry>the watery layer of the earth''s surface; includes water vapor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106778371">
	<b:glossaryEntry>(informal) any large deep body of water; "he jumped into the drink and had to be rescued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106778512"
	 b:glossaryEntry="the solid part of the earth"/>
<rdf:Description rdf:about="&a;106778722">
	<b:glossaryEntry>a rigid layer of the lithosphere that is believed to drift slowly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106778839">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the outermost level of the land or sea; "earthquakes originate far below the surface"; "three quarters of the Earth''s surface is covered by water"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106779132"
	 b:glossaryEntry="the outer layer of the Earth"/>
<rdf:Description rdf:about="&a;106779284">
	<b:glossaryEntry>a ridge of the earth''s crust that has been forced upward between two faults and so is higher than the surrounding land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106779454"
	 b:glossaryEntry="the lower layer of the crust"/>
<rdf:Description rdf:about="&a;106779561"
	 b:glossaryEntry="the layer of the earth between the crust and the core"/>
<rdf:Description rdf:about="&a;106779724"
	 b:glossaryEntry="the upper part of the mantle"/>
<rdf:Description rdf:about="&a;106779830"
	 b:glossaryEntry="the deeper part of the mantle"/>
<rdf:Description rdf:about="&a;106779937"
	 b:glossaryEntry="the central part of the earth"/>
<rdf:Description rdf:about="&a;106780036">
	<b:glossaryEntry>(geology) a stratum of rock (especially sedimentary rock); "they found a bed of standstone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106780195"
	 b:glossaryEntry="a stratum of ore"/>
<rdf:Description rdf:about="&a;106780265"
	 b:glossaryEntry="the bottom surface of any a cave or lake etc."/>
<rdf:Description rdf:about="&a;106780381">
	<b:glossaryEntry>the ground on which people and animals move about; "the fire spared the forest floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106780518"
	 b:glossaryEntry="a navigable body of water"/>
<rdf:Description rdf:about="&a;106780670">
	<b:glossaryEntry>(closed sea) a navigable body of water under the jurisdiction of a single nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106780809">
	<b:glossaryEntry>(free sea) a navigable body of water to which all nations have equal access</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106780943">
	<b:glossaryEntry>a natural body of running water flowing on or under the earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106781218"
	 b:glossaryEntry="the middle of a stream"/>
<rdf:Description rdf:about="&a;106781315">
	<b:glossaryEntry>a stream in which the effects of the tide extend far upstream</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106781505"
	 b:glossaryEntry="any very large body of (salt) water"/>
<rdf:Description rdf:about="&a;106781694">
	<b:glossaryEntry>a large body of water constituting a principal part of the hydrosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106781925">
	<b:glossaryEntry>a division of an ocean or a large body of salt water partially enclosed by land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106782598">
	<b:glossaryEntry>an informal expression for all of the oceans of the world; "the old salt had sailed the seven seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106782754">
	<b:glossaryEntry>the open seas of the world outside the territorial waters of any nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106782917">
	<b:glossaryEntry>the water over which a nation exercises sovereign jurisdiction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106783080"
	 b:glossaryEntry="an especially deep part of a sea or ocean"/>
<rdf:Description rdf:about="&a;106783207">
	<b:glossaryEntry>the water that is well below the surface but also well above the bottom; "many marine fishes inhabit the mid-waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106783379">
	<b:glossaryEntry>the part of the sea that can be seen from the shore; "there was a ship in the offing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106783536"
	 b:glossaryEntry="land that is worked by plowing and sowing and raising crops"/>
<rdf:Description rdf:about="&a;106783707">
	<b:glossaryEntry>the surface soil that must be moved away to get at coal seams and mineral deposits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106783846">
	<b:glossaryEntry>cultivated land that is not seeded for one or more growing seasons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106783965"
	 b:glossaryEntry="a plain adjacent to a coast"/>
<rdf:Description rdf:about="&a;106784070"
	 b:glossaryEntry="low-lying coastal land drained by tidal streams"/>
<rdf:Description rdf:about="&a;106784192"
	 b:glossaryEntry="a channel in which a tidal current runs"/>
<rdf:Description rdf:about="&a;106784285"
	 b:glossaryEntry="ground that is permanently frozen"/>
<rdf:Description rdf:about="&a;106784375"
	 b:glossaryEntry="lan suitable for grazing livestock"/>
<rdf:Description rdf:about="&a;106784465">
	<b:glossaryEntry>surface layer of ground containing a matt of grass and grass roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106784627">
	<b:glossaryEntry>a piece of turf dug out of a lawn or fairway (by an animals hooves or a golf club)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106784761"
	 b:glossaryEntry="land that is covered with trees and shrubs"/>
<rdf:Description rdf:about="&a;106785033"
	 b:glossaryEntry="a hilly forest region in southwestern Germany"/>
<rdf:Description rdf:about="&a;106785151">
	<b:glossaryEntry xml:space='preserve'><![CDATA[woodlands in full leaf; "the greenwood was Robin Hood''s home"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106785268"
	 b:glossaryEntry="an impenetrable equatorial forest"/>
<rdf:Description rdf:about="&a;106785354"
	 b:glossaryEntry="a tropical forest with heavy annual rainfall"/>
<rdf:Description rdf:about="&a;106785479"
	 b:glossaryEntry="woodlands along the banks of stream or river"/>
<rdf:Description rdf:about="&a;106785585">
	<b:glossaryEntry>an ancient forest in central England; formerly a royal hunting ground; said to be the home of Robin Hood and his merry band</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106785770"
	 b:glossaryEntry="the forest trees growing in a country or region"/>
<rdf:Description rdf:about="&a;106785877">
	<b:glossaryEntry>a forest (or part of a forest) where trees are grown for commercial use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106786022"
	 b:glossaryEntry="an area planted with pine trees or related conifers"/>
<rdf:Description rdf:about="&a;106786127">
	<b:glossaryEntry>an open tract of land in a forest that is strewn with debris from logging (or fire or wind)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106786270"
	 b:glossaryEntry="a place or scene of great or strange beauty or wonder"/>
<rdf:Description rdf:about="&a;106786380"
	 b:glossaryEntry="a soft wet area of low-lying land that sinks underfoot"/>
<rdf:Description rdf:about="&a;106786505">
	<b:glossaryEntry>wet spongy ground of decomposing vegetation; has poorer drainage than a swamp; soil is unfit for cultivation but can be cut and dried and used for fuel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106786753"
	 b:glossaryEntry="a hollow filled with mud"/>
<rdf:Description rdf:about="&a;106786830">
	<b:glossaryEntry>low-lying wet land with grassy vegetation; usually is a transition zone between land and water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106786994">
	<b:glossaryEntry>low land that is seasonally flooded; has more woody plants than a marsh and better drainage than a bog</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106787184">
	<b:glossaryEntry>a large subtropical swamp in southern Florida that is noted for its wildlife</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106787317"
	 b:glossaryEntry="a stagnant swamp (especially as part of a bayou)"/>
<rdf:Description rdf:about="&a;106787418"
	 b:glossaryEntry="a low area where the land is saturated with water"/>
<rdf:Description rdf:about="&a;106787575"
	 b:glossaryEntry="a body of (usually fresh) water surrounded by land"/>
<rdf:Description rdf:about="&a;106788037">
	<b:glossaryEntry>a swampy arm or slow-moving outlet of a lake (term used mainly in Mississippi and Louisiana)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106788181"
	 b:glossaryEntry="Scottish and Irish words for lake"/>
<rdf:Description rdf:about="&a;106788273">
	<b:glossaryEntry>a long narrow inlet of the sea in Scotland (especially when it is nearly landlocked) and in Ireland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106788431"
	 b:glossaryEntry="a group of 5 lakes in central North America"/>
<rdf:Description rdf:about="&a;106788665">
	<b:glossaryEntry>a lake east of the Caspian Sea lying between Kazakhstan and Uzbekistan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106788802"
	 b:glossaryEntry="the 4th largest of the Great Lakes"/>
<rdf:Description rdf:about="&a;106788911"
	 b:glossaryEntry="the 2nd largest of the Great Lakes"/>
<rdf:Description rdf:about="&a;106789021"
	 b:glossaryEntry="the smallest of the Great Lakes"/>
<rdf:Description rdf:about="&a;106789130">
	<b:glossaryEntry>the 3rd largest of the Great Lakes; the largest fresh-water lake entirely within the United States borders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106789315">
	<b:glossaryEntry>the largest freshwater lake in the world; the deepest of the Great Lakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106789466"
	 b:glossaryEntry="a shallow body of salt water in northwestern Utah"/>
<rdf:Description rdf:about="&a;106789596"
	 b:glossaryEntry="a stretch of shallow water"/>
<rdf:Description rdf:about="&a;106789684">
	<b:glossaryEntry>an arm of a sea or ocean partly enclosed by land; larger than a bay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106789983">
	<b:glossaryEntry>a large natural stream of water (larger than a creek); "the river was navigable for 50 miles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106792238"
	 b:glossaryEntry="a shallow area in a stream that can be forded"/>
<rdf:Description rdf:about="&a;106792364"
	 b:glossaryEntry="a river and all of its tributaries"/>
<rdf:Description rdf:about="&a;106792476">
	<b:glossaryEntry>the wide part of a river where it nears the sea; fresh and salt water mix</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106792658"
	 b:glossaryEntry="a narrow estuary (especially in Scotland)"/>
<rdf:Description rdf:about="&a;106792751"
	 b:glossaryEntry="any small natural waterway"/>
<rdf:Description rdf:about="&a;106792829"
	 b:glossaryEntry="a natural flow of ground water"/>
<rdf:Description rdf:about="&a;106793017"
	 b:glossaryEntry="a natural spring of water at a temperature of 70 F or above"/>
<rdf:Description rdf:about="&a;106793150">
	<b:glossaryEntry>a natural stream of water smaller than a river (and often a tributary of a river); "the creek dried up every summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106793326"
	 b:glossaryEntry="a stream or river connected to a larger one"/>
<rdf:Description rdf:about="&a;106793458"
	 b:glossaryEntry="a branch that flows into the main stream"/>
<rdf:Description rdf:about="&a;106793574"
	 b:glossaryEntry="a branch that flows away from the main stream"/>
<rdf:Description rdf:about="&a;106793678"
	 b:glossaryEntry="a small stream"/>
<rdf:Description rdf:about="&a;106793780">
	<b:glossaryEntry>a fountain described in folk tales as able to make people young again; "Ponce de Leon discovered Florida while searching for the Fountain of Youth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106793991"
	 b:glossaryEntry="a spring that discharges hot water and steam"/>
<rdf:Description rdf:about="&a;106794088"
	 b:glossaryEntry="a part of a river where the current is very fast"/>
<rdf:Description rdf:about="&a;106794207"
	 b:glossaryEntry="a steep descent of the water of a river"/>
<rdf:Description rdf:about="&a;106794584"
	 b:glossaryEntry="a steep part of a glacier resembling a frozen waterfall"/>
<rdf:Description rdf:about="&a;106794712">
	<b:glossaryEntry>a body of water cut off from a larger body by a reef of sand or coral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106794852">
	<b:glossaryEntry>a small arm off of a larger body of water (often between rocky headlands)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106795067">
	<b:glossaryEntry>a long narrow inlet of the sea between steep cliffs; common in Norway</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106795196">
	<b:glossaryEntry>an indentation of a shoreline larger than a cove but smaller than an gulf</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106795608"
	 b:glossaryEntry="a bay formed by a bend (a bight) in the shoreline"/>
<rdf:Description rdf:about="&a;106795709">
	<b:glossaryEntry>a large ocean inlet or deep bay; "the main body of the sound ran parallel to the coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106795884">
	<b:glossaryEntry>a relatively narrow body of water linking two larger bodies; "the ship went aground in the channel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106796171">
	<b:glossaryEntry>a small body of standing water (rainwater) or other liquid; "there were puddles of muddy water in the road after the rain"; "the body lay in a pool of blood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106796406"
	 b:glossaryEntry='a puddle of mud; "the children loved a mud puddle"'/>
<rdf:Description rdf:about="&a;106796531"
	 b:glossaryEntry="something that shines"/>
<rdf:Description rdf:about="&a;106796605">
	<b:glossaryEntry>anything that resembles a vagabond in having no fixed place; "pirate ships were vagabonds of the sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106796761">
	<b:glossaryEntry>anything that suggests a wall in structure or effect; "a wall of water"; "a wall of smoke"; "a wall of prejudice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106796961"
	 b:glossaryEntry="a puddle where animals go to wallow"/>
<rdf:Description rdf:about="&a;106797049">
	<b:glossaryEntry>a small body of water (usually in a creek) that is deep enough to use for swimming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106797191">
	<b:glossaryEntry>an arm of the Atlantic Ocean that forms a channel between France and Britain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106797348"
	 b:glossaryEntry="a narrow strait connecting two bodies of water"/>
<rdf:Description rdf:about="&a;106797465">
	<b:glossaryEntry>a narrow channel of the sea joining two larger bodies of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106797778"
	 b:glossaryEntry="a strait connecting the Bering Sea to the Arctic Ocean"/>
<rdf:Description rdf:about="&a;106797892">
	<b:glossaryEntry>a strait connecting the Mediterranean and the Black Sea; separates the European and Asian parts of Turkey; an important shipping route</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106798081">
	<b:glossaryEntry>a strait between Korea and Japan; connects the East China Sea and the Sea of Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106798257"
	 b:glossaryEntry="the strait between Spain and Africa"/>
<rdf:Description rdf:about="&a;106798358">
	<b:glossaryEntry>a strategically important strait linking the Persian Gulf and the Gulf of Oman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106798517">
	<b:glossaryEntry>the strait separating South America from Tierra del Fuego and other islands south of the continent; discovered by Ferdinand Magellan in 1520; an important route around South American before the Panama Canal was built</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106798798"
	 b:glossaryEntry="the strait separating Sicily from the tip of Italy"/>
<rdf:Description rdf:about="&a;106798912">
	<b:glossaryEntry>the strait between the English Channel and the North Sea; shortest distance between England and the European continent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106799128"
	 b:glossaryEntry='a small lake; "the pond was too small for sailing"'/>
<rdf:Description rdf:about="&a;106799344"
	 b:glossaryEntry="a freshwater pond with fish"/>
<rdf:Description rdf:about="&a;106799426"
	 b:glossaryEntry="a pond for watering horses"/>
<rdf:Description rdf:about="&a;106799508"
	 b:glossaryEntry="(British) a small pond of standing water"/>
<rdf:Description rdf:about="&a;106799599">
	<b:glossaryEntry>a pond formed by damming a stream to provide a head of water to turn a mill wheel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106799735"
	 b:glossaryEntry="a natural hole or hollow containing water"/>
<rdf:Description rdf:about="&a;106799833"
	 b:glossaryEntry="a mountain lake (especially one formed by glaciers)"/>
<rdf:Description rdf:about="&a;106799935">
	<b:glossaryEntry>(astronomy) an indistinct surface feature of Mars once thought to be a system of channels; they are now believed to be an optical illusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106800125"
	 b:glossaryEntry="a small channel (as one formed by soil erosion)"/>
<rdf:Description rdf:about="&a;106800223">
	<b:glossaryEntry>sloping land (especially the slope beside a body of water); "they pulled the canoe up on the bank"; "he sat on the bank of the river and watched the currents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106800468">
	<b:glossaryEntry>a slope in the turn of a road or track; the outside is higher than the inside in order to reduce the effects of centrifugal force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106800664"
	 b:glossaryEntry="the shore of a lake"/>
<rdf:Description rdf:about="&a;106800750"
	 b:glossaryEntry="the bank of a river"/>
<rdf:Description rdf:about="&a;106800837"
	 b:glossaryEntry="the shore of a sea or ocean regarded as a resort"/>
<rdf:Description rdf:about="&a;106800950"
	 b:glossaryEntry="a boundary line between land and water"/>
<rdf:Description rdf:about="&a;106801063">
	<b:glossaryEntry>the land along the edge of a body of water (a lake or ocean or river)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106801276">
	<b:glossaryEntry>the part of the seashore between the high-water and and low-water marks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106801422"
	 b:glossaryEntry="the shore of a sea or ocean"/>
<rdf:Description rdf:about="&a;106801632">
	<b:glossaryEntry>the seacoast first sighted on a voyage (or flight over water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106801748">
	<b:glossaryEntry>a poetic term for a shore (as the area periodically covered and uncovered by the tides)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106801888"
	 b:glossaryEntry="land bordering a body of water"/>
<rdf:Description rdf:about="&a;106801974">
	<b:glossaryEntry>underground surface below which the ground is wholly saturated with water: "spring rains had raised the water table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106802182"
	 b:glossaryEntry="a layer of ore between layers of rock"/>
<rdf:Description rdf:about="&a;106802303"
	 b:glossaryEntry="a rock immediately adjacent to a vein or fault"/>
<rdf:Description rdf:about="&a;106802405"
	 b:glossaryEntry="an especially rich vein of precious ore"/>
<rdf:Description rdf:about="&a;106802498"
	 b:glossaryEntry="a small globe or ball"/>
<rdf:Description rdf:about="&a;106802591"
	 b:glossaryEntry="a hollow globule of gas (e.g., air or carbon dioxide)"/>
<rdf:Description rdf:about="&a;106802751"
	 b:glossaryEntry="a bubble of air"/>
<rdf:Description rdf:about="&a;106802823"
	 b:glossaryEntry="a bubble formed by a thin soap film"/>
<rdf:Description rdf:about="&a;106802916"
	 b:glossaryEntry="a mass of small bubbles formed in or on a liquid"/>
<rdf:Description rdf:about="&a;106803113">
	<b:glossaryEntry>the foam or froth that accumulates at the top when you pour an effervescent liquid into a container; "the beer had a large head of foam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106803300"
	 b:glossaryEntry="the froth produced by soaps or detergents"/>
<rdf:Description rdf:about="&a;106803412"
	 b:glossaryEntry="the foam resulting from excessive sweating (as on a horse)"/>
<rdf:Description rdf:about="&a;106803523"
	 b:glossaryEntry="foam or froth on the sea"/>
<rdf:Description rdf:about="&a;106803599"
	 b:glossaryEntry="frothy water as in rapids or waterfalls"/>
<rdf:Description rdf:about="&a;106803696"
	 b:glossaryEntry='a small hard particle; "a grain of sand"'/>
<rdf:Description rdf:about="&a;106803806"
	 b:glossaryEntry="a tiny grain"/>
<rdf:Description rdf:about="&a;106803926">
	<b:glossaryEntry>an interface forming the boundary between the non-miscible liquids oil and water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106804072">
	<b:glossaryEntry>the 2nd largest ocean; separates North and South America on the west from Europe and Africa on the east</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106804741"
	 b:glossaryEntry="the largest ocean in the world"/>
<rdf:Description rdf:about="&a;106805278">
	<b:glossaryEntry>any sea south of the equator (but especially the South Pacific)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106805397">
	<b:glossaryEntry>any islands in the southern or southwestern of central parts of the Pacific Ocean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106805542"
	 b:glossaryEntry="the 3rd largest ocean"/>
<rdf:Description rdf:about="&a;106805812">
	<b:glossaryEntry>ice covered waters surrounding the North Pole; mostly covered with solid ice or with ice floes and icebergs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106806073"
	 b:glossaryEntry="the southern waters surrounding Antarctica"/>
<rdf:Description rdf:about="&a;106806234">
	<b:glossaryEntry>a northwestern arm of the Indian Ocean between India and Arabia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106806412"
	 b:glossaryEntry="part of the Arctic Ocean north of Iceland"/>
<rdf:Description rdf:about="&a;106806532">
	<b:glossaryEntry>an arm of the North Atlantic between the British Isles and Scandinavia; oil was discovered under the North Sea in 1970</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106806744">
	<b:glossaryEntry>the part of the Atlantic that lies off the Norwegian coast north of the North Sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106806923">
	<b:glossaryEntry>an arm of the Mediterranean between Greece and Turkey; a main trade route for the ancient civilizations of Crete and Greece and Rome and Persia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106807189">
	<b:glossaryEntry>an arm of the Mediterranean between Yugoslavia and Albania on the east and Italy on the west</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106807370"
	 b:glossaryEntry="a sea in northern Europe; stronghold of the Russian navy"/>
<rdf:Description rdf:about="&a;106807511">
	<b:glossaryEntry>an arm of the South Pacific southwest of the Bismarck Archipelago</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106807654"
	 b:glossaryEntry="an arm of the South Pacific northeast of Australia"/>
<rdf:Description rdf:about="&a;106807798"
	 b:glossaryEntry="the largest inland sea; between Europe and Africa and Asia"/>
<rdf:Description rdf:about="&a;106808182"
	 b:glossaryEntry="(our sea) the Mediterranean to the ancient Romans"/>
<rdf:Description rdf:about="&a;106808290">
	<b:glossaryEntry>an arm of the Mediterranean between northwest Italy and Corsica</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106808431">
