	 b:glossaryEntry="send an invoice to"/>
<rdf:Description rdf:about="&a;201586213"
	 b:glossaryEntry='enter a certain amount as a charge; "he charged me $15"'/>
<rdf:Description rdf:about="&a;201586358">
	<b:glossaryEntry>accumulate as a debt; "he chalked up $100 in the course of the evening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201586504">
	<b:glossaryEntry>take something away by force or without the consent of the owner; "The burglars robbed him of all his money"</b:glossaryEntry>
