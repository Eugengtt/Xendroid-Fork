	 b:glossaryEntry="a purine base found in DNA and RNA; pairs with cytosine"/>
<rdf:Description rdf:about="&a;110683438"
	 b:glossaryEntry="the excrement of sea birds; used as fertilizer"/>
<rdf:Description rdf:about="&a;110683554"
	 b:glossaryEntry="22-karat gold from which guinea coins were made"/>
<rdf:Description rdf:about="&a;110683659">
	<b:glossaryEntry>a mixture of cement and sand and water that is sprayed on a surface under pneumatic pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110683804">
	<b:glossaryEntry>a volatile oil having the odor or flavor of the plant from which it comes; used in perfume and flavorings</b:glossaryEntry>
</rdf:Description>
