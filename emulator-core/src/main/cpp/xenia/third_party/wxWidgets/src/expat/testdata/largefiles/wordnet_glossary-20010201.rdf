</rdf:Description>
<rdf:Description rdf:about="&a;103426159"
	 b:glossaryEntry="a streamlined train"/>
<rdf:Description rdf:about="&a;103426236">
	<b:glossaryEntry>a thoroughfare (usually including sidewalks) that is lined with buildings; "they walked the streets of the small town"; "he lives on Nassau Street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103426653">
