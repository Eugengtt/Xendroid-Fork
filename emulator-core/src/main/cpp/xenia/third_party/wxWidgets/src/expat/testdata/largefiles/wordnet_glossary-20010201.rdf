</rdf:Description>
<rdf:Description rdf:about="&a;201336569"
	 b:glossaryEntry="make a power dive, as of an airplane"/>
<rdf:Description rdf:about="&a;201336681"
	 b:glossaryEntry="dive with a snorkel"/>
<rdf:Description rdf:about="&a;201336773">
	<b:glossaryEntry>move forward by leaps and bounds; "The horse bounded across the meadow"; "The child leapt across the puddle"; "Can you jump over the fence?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201337339">
	<b:glossaryEntry>move suddenly, energetically, or violently; "He burst out of the house into the cool night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201337493"
	 b:glossaryEntry='leap suddenly; "He bounced to his feet"'/>
<rdf:Description rdf:about="&a;201337614"
	 b:glossaryEntry="perform a capriole, of horses in dressage"/>
<rdf:Description rdf:about="&a;201337721"
	 b:glossaryEntry="leap around playfully, like young primates"/>
<rdf:Description rdf:about="&a;201337836"
