	 b:glossaryEntry="web-toed salamanders"/>
<rdf:Description rdf:about="&a;101159399">
	<b:glossaryEntry>any of several salamanders with webbed toes and very long extensile tongues; excellent climbers that move with ease over smooth rock surfaces</b:glossaryEntry>
</rdf:Description>
