	 b:glossaryEntry="1/60 dram; equals an avoirdupois grain or 64.799 milligrams"/>
<rdf:Description rdf:about="&a;109878486"
	 b:glossaryEntry="a unit of apothecary weight equal to 20 grains"/>
<rdf:Description rdf:about="&a;109878624"
	 b:glossaryEntry="a unit of apothecary weight equal to 24 grains"/>
<rdf:Description rdf:about="&a;109878766">
	<b:glossaryEntry>a unit of apothecary weight equal to an eighth of an ounce or to 60 grains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109878948">
	<b:glossaryEntry>a unit of apothecary weight equal to 480 grains or one twelfth of a pound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109879183"
	 b:glossaryEntry="an apothecary weight equal to 12 ounces or 373.242 grams"/>
<rdf:Description rdf:about="&a;109879355"
	 b:glossaryEntry="one millionth of a gram"/>
<rdf:Description rdf:about="&a;109879459"
	 b:glossaryEntry="1/1000 gram"/>
<rdf:Description rdf:about="&a;109879569"
	 b:glossaryEntry="used for pearls or diamonds: 50 mg or 1/4 carat"/>
<rdf:Description rdf:about="&a;109879721"
	 b:glossaryEntry="1/10 gram"/>
<rdf:Description rdf:about="&a;109879828"
	 b:glossaryEntry="a unit of weight for precious stones = 200 mg"/>
<rdf:Description rdf:about="&a;109879963">
	<b:glossaryEntry>a metric unit of weight equal to one thousandth of a kilogram</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109880150">
	<b:glossaryEntry>the quantity of an element whose weight in grams is numerically equal to the atomic weight of the element</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109880332">
	<b:glossaryEntry>the molecular weight of a substance expressed in grams; the basic unit of amount of substance adopted under the System International d''Unites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109880546"
	 b:glossaryEntry="10 grams"/>
<rdf:Description rdf:about="&a;109880670"
	 b:glossaryEntry="100 grams"/>
<rdf:Description rdf:about="&a;109880778">
	<b:glossaryEntry>one thousand grams; the basic unit of mass adopted under the System International d''Unites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109880979"
	 b:glossaryEntry="one ten thousandth of a centner"/>
<rdf:Description rdf:about="&a;109881110">
	<b:glossaryEntry>in some European countries: a unit of weight equivalent to 50 kilograms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109881273"
	 b:glossaryEntry="a unit of weight equal to 100 kilograms"/>
<rdf:Description rdf:about="&a;109881459"
	 b:glossaryEntry="a unit of weight equal to 100 kilograms"/>
<rdf:Description rdf:about="&a;109881590"
	 b:glossaryEntry="a unit of weight equivalent to 1000 kilograms"/>
<rdf:Description rdf:about="&a;109881728">
	<b:glossaryEntry>a cgs unit of work or energy; the work done by a force of one dyne acting over a distance of one centimeter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109881904">
	<b:glossaryEntry>a unit of energy equal to the work done by an electron accelerated through a potential difference of 1 volt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109882076">
	<b:glossaryEntry>a unit of electrical energy equal to the work done when a current of one ampere passes through a resistance of one ohm for one second</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109882298">
	<b:glossaryEntry>unit of heat defined as the quantity of heat required to raise the temperature of 1 gram of water by 1C at atmospheric pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109882538">
	<b:glossaryEntry>a unit of heat equal to the amount of heat required to raise the temperature of one kilogram of water by one degree at one atmosphere pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109882831">
	<b:glossaryEntry>unit of energy-producing potential in food and released by oxidation; equal to a kilocalorie of heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109883000">
	<b:glossaryEntry>a unit of heat equal to the amount of heat required to raise one pound of water one degree Fahrenheit at one atmosphere pressure; equivalent to 251.997 calories</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109883262"
	 b:glossaryEntry="a unit of heat equal to 100,000 British thermal units"/>
<rdf:Description rdf:about="&a;109883386">
	<b:glossaryEntry>a unit of energy equal to the power of one watt operating for one hour</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109883531">
	<b:glossaryEntry>a unit of energy equal to the work done by a power of 1000 watts operating for one hour</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109883736">
	<b:glossaryEntry>a unit of work equal to a force of one pound moving through a distance of one foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109883894"
	 b:glossaryEntry="2240 foot-pounds"/>
<rdf:Description rdf:about="&a;109883984">
	<b:glossaryEntry>a unit of work equal to a force of one poundal moving through a distance of one foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109884127">
	<b:glossaryEntry>a unit of work equal to the work done by one horsepower in one hour</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109884256">
	<b:glossaryEntry>a unit of work equal to the work done by a one kilogram force operating through a distance of one meter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109884420">
	<b:glossaryEntry>the number 1 and any other number obtained by adding 1 to it repeatedly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109884552"
	 b:glossaryEntry="any of the natural numbers (positive or negative) or zero"/>
<rdf:Description rdf:about="&a;109884858">
	<b:glossaryEntry>a number of the form a+bi where a and b are real numbers and i is the square root of -1</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109885099"
	 b:glossaryEntry="any rational or irrational number"/>
<rdf:Description rdf:about="&a;109885251"
	 b:glossaryEntry="an imaginary number of the form a+bi where a is 0"/>
<rdf:Description rdf:about="&a;109885386">
	<b:glossaryEntry>the part of a complex number that has the square root of -1 as a factor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109885574"
	 b:glossaryEntry="a numerical value regardless of its sign"/>
<rdf:Description rdf:about="&a;109885693"
	 b:glossaryEntry="the absolute value of a complex number"/>
<rdf:Description rdf:about="&a;109885785"
	 b:glossaryEntry="an integer or a fraction"/>
<rdf:Description rdf:about="&a;109885889"
	 b:glossaryEntry="a real number that cannot be expressed as a rational number"/>
<rdf:Description rdf:about="&a;109886084"
	 b:glossaryEntry="an irrational number that is not algebraic"/>
<rdf:Description rdf:about="&a;109886194"
	 b:glossaryEntry="root of an algebraic equation with rational coefficients"/>
<rdf:Description rdf:about="&a;109886313">
	<b:glossaryEntry>the product of two equal terms; "nine is the second power of three"; "gravity is inversely proportional to the square of the distance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109886515"
	 b:glossaryEntry="the product of three equal terms"/>
<rdf:Description rdf:about="&a;109886612"
	 b:glossaryEntry="an algebraic equation of the fourth degree"/>
<rdf:Description rdf:about="&a;109886750">
	<b:glossaryEntry>a number that when multiplied by itself some number of times equals a given number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109886919">
	<b:glossaryEntry>a number that when multiplied by itself equals a given number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109887038">
	<b:glossaryEntry>a number that when multiplied three times equals a given number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109887157"
	 b:glossaryEntry="the quotient of two rational numbers"/>
<rdf:Description rdf:about="&a;109887356"
	 b:glossaryEntry="the quotient of two integers"/>
<rdf:Description rdf:about="&a;109887788"
	 b:glossaryEntry="the dividend of a fraction"/>
<rdf:Description rdf:about="&a;109887870"
	 b:glossaryEntry="a number to be divided by another number"/>
<rdf:Description rdf:about="&a;109887965"
	 b:glossaryEntry="the divisor of a fraction"/>
<rdf:Description rdf:about="&a;109888066"
	 b:glossaryEntry="the number by which a dividend is divided"/>
<rdf:Description rdf:about="&a;109888197">
	<b:glossaryEntry>one of two or more integers that can be exactly divided into another integer; "what are the 4 factors of 6?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109888422"
	 b:glossaryEntry="the number by which a multiplicand is multiplied"/>
<rdf:Description rdf:about="&a;109888565"
	 b:glossaryEntry="the number that is multiplied by the multiplier"/>
<rdf:Description rdf:about="&a;109888671"
	 b:glossaryEntry="a number used as a multiplier in scaling"/>
<rdf:Description rdf:about="&a;109888788">
	<b:glossaryEntry>(in simulation) the ratio of the simulation time to the time of the real process</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109888932">
	<b:glossaryEntry>the average number of binary digits needed to express one radix digit in a non-binary numeration system; on the average a number that can be expressed in N decimal digits takes 3.3N binary digits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109889204">
	<b:glossaryEntry>an integer that is an exact divisor of some quantity; "4 is an aliquot part of 12"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109889373">
	<b:glossaryEntry>an integer that is not an exact divisor of some quantity; "5 is an aliquant part of 12"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109889549"
	 b:glossaryEntry="an integer that divides two other integers"/>
<rdf:Description rdf:about="&a;109889685"
	 b:glossaryEntry="an integer that is a multiple of two or more other integers"/>
<rdf:Description rdf:about="&a;109889806">
	<b:glossaryEntry>an integer that is a common multiple of the denominators of two or more fractions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109889952">
	<b:glossaryEntry>an integer that can be divided without remainder into the difference between two other integers; "2 is a modulus of 5 and 9"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109890130"
	 b:glossaryEntry="a fraction whose numerator is larger than the denominator"/>
<rdf:Description rdf:about="&a;109890251"
	 b:glossaryEntry="a fraction with a numerator smaller than the denominator"/>
<rdf:Description rdf:about="&a;109890387"
	 b:glossaryEntry="a fraction with fractions in the numerator or denominator"/>
<rdf:Description rdf:about="&a;109890527"
	 b:glossaryEntry="a proper fraction whose denominator is a power of 10"/>
<rdf:Description rdf:about="&a;109890670">
	<b:glossaryEntry>a decimal with a sequence of digits that repeats itself indefinitely</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109890844">
	<b:glossaryEntry>a fraction whose numerator is an integer and whose denominator is an integer plus a fraction whose numerator is an integer and whose denominator is an integer plus a fraction and so on</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109891093">
	<b:glossaryEntry>one of two equal parts of a divisible whole; "half a loaf" or "half an hour" or "a century and one half"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109891295"
	 b:glossaryEntry="a half expressed as a percentage"/>
<rdf:Description rdf:about="&a;109891387"
	 b:glossaryEntry="one of two (approximately) equal parts"/>
<rdf:Description rdf:about="&a;109891488">
	<b:glossaryEntry>one of three equal parts of a divisible whole; "it contains approximately a third of the minimum daily requirement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109891676"
	 b:glossaryEntry="two of three equal parts of a divisible whole"/>
<rdf:Description rdf:about="&a;109891778"
	 b:glossaryEntry='one of four equal parts; "a quarter of a pound"'/>
<rdf:Description rdf:about="&a;109891948"
	 b:glossaryEntry='three of four equal parts; "three-fourths of a pound"'/>
<rdf:Description rdf:about="&a;109892061"
	 b:glossaryEntry="a fifth part"/>
<rdf:Description rdf:about="&a;109892167"
	 b:glossaryEntry="a sixth part"/>
<rdf:Description rdf:about="&a;109892243"
	 b:glossaryEntry="a seventh part"/>
<rdf:Description rdf:about="&a;109892325"
	 b:glossaryEntry="an eighth part"/>
<rdf:Description rdf:about="&a;109892405"
	 b:glossaryEntry="a ninth part"/>
<rdf:Description rdf:about="&a;109892481"
	 b:glossaryEntry="a tenth part"/>
<rdf:Description rdf:about="&a;109892584"
	 b:glossaryEntry="on part in a hundred"/>
<rdf:Description rdf:about="&a;109892690"
	 b:glossaryEntry="one part in a thousand"/>
<rdf:Description rdf:about="&a;109892786"
	 b:glossaryEntry="one part in a million"/>
<rdf:Description rdf:about="&a;109892879"
	 b:glossaryEntry="one part in a billion"/>
<rdf:Description rdf:about="&a;109892972"
	 b:glossaryEntry="one part in a trillion"/>
<rdf:Description rdf:about="&a;109893068"
	 b:glossaryEntry="one part in a quadrillion"/>
<rdf:Description rdf:about="&a;109893173"
	 b:glossaryEntry="one part in a quintillion"/>
<rdf:Description rdf:about="&a;109893278">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a quantity of no importance; "it looked like nothing I had ever seen before"; "reduced to nil all the work we had done"; "we racked up a pathetic goose egg"; "it was all for naught"; "I didn''t hear zilch about it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109893668">
	<b:glossaryEntry>nothing (as used by a sheriff after an unsuccessful effort to serve a writ: "nihil habet")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109893816">
	<b:glossaryEntry>(British slang) little or nothing at all; "I asked for a raise and they gave me bugger-all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109893975">
	<b:glossaryEntry>one of the elements that collectively form a system of numbers; "0 and 1 are digits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109894345"
	 b:glossaryEntry="either 0 or 1 in binary notation"/>
<rdf:Description rdf:about="&a;109894436"
	 b:glossaryEntry="a digit from 0 to 7 in octal notation"/>
<rdf:Description rdf:about="&a;109894531"
	 b:glossaryEntry="a digit from 0 to 9 in decimal notation"/>
<rdf:Description rdf:about="&a;109894639">
	<b:glossaryEntry>a mathematical element that when added to another number yields the same number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109894800">
	<b:glossaryEntry>the smallest whole number or a numeral representing this number; "he has the one but will need a two and three to go with it"; "they had lunch at one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109895067">
	<b:glossaryEntry>a singular metaphysical entity from which material properties are said to derive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109895207"
	 b:glossaryEntry="a single object (as distinguished from a pair)"/>
<rdf:Description rdf:about="&a;109895309">
	<b:glossaryEntry>the cardinal number that is the sum of one and one or a numeral representing this number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109895500">
	<b:glossaryEntry>when two dice are thrown and both come up showing one spot the results is called `craps'' or `snake eyes''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109895669"
	 b:glossaryEntry="two items of the same kind"/>
<rdf:Description rdf:about="&a;109895854"
	 b:glossaryEntry="the cardinal number that is the sum of one and one and one"/>
<rdf:Description rdf:about="&a;109896114"
	 b:glossaryEntry="the cardinal number that is the sum of three and one"/>
<rdf:Description rdf:about="&a;109896331"
	 b:glossaryEntry="the cardinal number that is the sum of four and one"/>
<rdf:Description rdf:about="&a;109896532"
	 b:glossaryEntry="the cardinal number that is the sum of five and one"/>
<rdf:Description rdf:about="&a;109896726"
	 b:glossaryEntry="the cardinal number that is the sum of six and one"/>
<rdf:Description rdf:about="&a;109896866"
	 b:glossaryEntry="the cardinal number that is the sum of seven and one"/>
<rdf:Description rdf:about="&a;109897050"
	 b:glossaryEntry="the cardinal number that is the sum of eight and one"/>
<rdf:Description rdf:about="&a;109897200"
	 b:glossaryEntry="an integer equal to or greater than ten"/>
<rdf:Description rdf:about="&a;109898127"
	 b:glossaryEntry="a two-digit integer; from 10 to 99"/>
<rdf:Description rdf:about="&a;109898220">
	<b:glossaryEntry>the cardinal number that is the sum of nine and one; the base of the decimal system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109898380"
	 b:glossaryEntry="the cardinal number that is the sum of ten and one"/>
<rdf:Description rdf:about="&a;109898493"
	 b:glossaryEntry="the cardinal number that is the sum of eleven and one"/>
<rdf:Description rdf:about="&a;109898636">
	<b:glossaryEntry>(usually plural) when two dice are thrown and both come up showing six spots the result is called `boxcars''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109898797"
	 b:glossaryEntry="all the numbers that end in -teen"/>
<rdf:Description rdf:about="&a;109898882"
	 b:glossaryEntry="the cardinal number that is the sum of twelve and one"/>
<rdf:Description rdf:about="&a;109899031"
	 b:glossaryEntry="the cardinal number that is the sum of thirteen and one"/>
<rdf:Description rdf:about="&a;109899152"
	 b:glossaryEntry="the cardinal number that is the sum of fourteen and one"/>
<rdf:Description rdf:about="&a;109899271"
	 b:glossaryEntry="the cardinal number that is the sum of fifteen and one"/>
<rdf:Description rdf:about="&a;109899390"
	 b:glossaryEntry="the cardinal number that is the sum of sixteen and one"/>
<rdf:Description rdf:about="&a;109899512"
	 b:glossaryEntry="the cardinal number that is the sum of seventeen and one"/>
<rdf:Description rdf:about="&a;109899636"
	 b:glossaryEntry="the cardinal number that is the sum of eighteen and one"/>
<rdf:Description rdf:about="&a;109899757"
	 b:glossaryEntry="the cardinal number that is the sum of nineteen and one"/>
<rdf:Description rdf:about="&a;109899875"
	 b:glossaryEntry="the cardinal number that is the sum of twenty and one"/>
<rdf:Description rdf:about="&a;109899996"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-one and one"/>
<rdf:Description rdf:about="&a;109900122"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-two and one"/>
<rdf:Description rdf:about="&a;109900251"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-three and one"/>
<rdf:Description rdf:about="&a;109900392"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-four and one"/>
<rdf:Description rdf:about="&a;109900519"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-five and one"/>
<rdf:Description rdf:about="&a;109900646"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-six and one"/>
<rdf:Description rdf:about="&a;109900775"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-seven and one"/>
<rdf:Description rdf:about="&a;109900907"
	 b:glossaryEntry="the cardinal number that is the sum of twenty-eight and one"/>
<rdf:Description rdf:about="&a;109901036"
	 b:glossaryEntry="the cardinal number that is the product of ten and three"/>
<rdf:Description rdf:about="&a;109901156"
	 b:glossaryEntry="the cardinal number that is the product of ten and four"/>
<rdf:Description rdf:about="&a;109901273"
	 b:glossaryEntry="the cardinal number that is the product of ten and five"/>
<rdf:Description rdf:about="&a;109901389"
	 b:glossaryEntry="the cardinal number that is the product of ten and six"/>
<rdf:Description rdf:about="&a;109901505"
	 b:glossaryEntry="the cardinal number that is the product of ten and seven"/>
<rdf:Description rdf:about="&a;109901626"
	 b:glossaryEntry="the cardinal number that is the product of ten and eight"/>
<rdf:Description rdf:about="&a;109901759"
	 b:glossaryEntry="the cardinal number that is the product of ten and nine"/>
<rdf:Description rdf:about="&a;109901877"
	 b:glossaryEntry="ten 10s"/>
<rdf:Description rdf:about="&a;109901976"
	 b:glossaryEntry="twelve dozen"/>
<rdf:Description rdf:about="&a;109902046"
	 b:glossaryEntry="the cardinal number that is the product of ten and twelve"/>
<rdf:Description rdf:about="&a;109902184">
	<b:glossaryEntry>the cardinal number that is the product of one hundred and five</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109902316"
	 b:glossaryEntry="the cardinal number that is the product of 10 and 100"/>
<rdf:Description rdf:about="&a;109902490"
	 b:glossaryEntry="a cardinal number equal to one dozen gross"/>
<rdf:Description rdf:about="&a;109902597">
	<b:glossaryEntry>the cardinal number that is the product of ten and one thousand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109902736"
	 b:glossaryEntry="the cardinal number that is the fifth power of ten"/>
<rdf:Description rdf:about="&a;109902865"
	 b:glossaryEntry="the number that is represented as a one followed by 6 zeros"/>
<rdf:Description rdf:about="&a;109903018">
	<b:glossaryEntry>(in Indian English) the number that is represented as a one followed by 7 zeros</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109903149">
	<b:glossaryEntry>(in the United States) the number that is represented as a one followed by 9 zeros</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109903339">
	<b:glossaryEntry>(British) a billion; "in England they call one thousand million a milliard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109903469">
	<b:glossaryEntry>(in Britain) the number that is represented as a one followed by 12 zeros</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109903634">
	<b:glossaryEntry>(in the United States and France) the number that is represented as a one followed by 12 zeros; "in England they call a trillion a billion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109903866">
	<b:glossaryEntry>(in Britain and Germany) the number that is represented as a one followed by 18 zeros; "in England they call a quintillion a trillion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109904085">
	<b:glossaryEntry>(in the United States and France) the number that is represented as a one followed by 15 zeros</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109904237">
	<b:glossaryEntry>(in Britain and Germany) the number that is represented as a one followed by 24 zeros; "in England they call a septillion a quadrillion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109904431">
	<b:glossaryEntry>(in the United States and France) the number that is represented as a one followed by 18 zeros</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109904583"
	 b:glossaryEntry="the smallest infinite integer"/>
<rdf:Description rdf:about="&a;109904697"
	 b:glossaryEntry="the ratio of the circumference to the diameter of a circle"/>
<rdf:Description rdf:about="&a;109904832"
	 b:glossaryEntry="the base of the natural system of logarithms"/>
<rdf:Description rdf:about="&a;109904938">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a quantity that is added; "there was an addition to property taxes this year"; "they recorded the cattle''s gain in weight over a period of weeks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109905156">
	<b:glossaryEntry>the quantity of game taken in a particular period (usually by one person); "his bag included two deer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109905308">
	<b:glossaryEntry>(computer science) the amount of information (in bytes) that can be stored on a disk drive; "the capacity of a hard disk drive is usually expressed in megabytes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109905560">
	<b:glossaryEntry>(computer science) the usable capacity of a disk drive; the amount of space that is left after the sector headings and boundary definitions and timing information have been added by formatting the disk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109905826">
	<b:glossaryEntry>(computer science) the total number of bytes on a disk including the space that will be required to format it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109906002"
	 b:glossaryEntry='the quantity that was caught; "the catch was only 10 fish"'/>
<rdf:Description rdf:about="&a;109906119">
	<b:glossaryEntry>a quantity that is added or subtracted in order to increase the accuracy of a scientific measure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109906287"
	 b:glossaryEntry="the quantity that a container will hold"/>
<rdf:Description rdf:about="&a;109907411">
	<b:glossaryEntry>the distance covered by a step; "he stepped off ten paces from the old tree and began to dig"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109907582">
	<b:glossaryEntry>the volume left at the top of a filled container (bottle or jar or tin) before sealing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109907724">
	<b:glossaryEntry>an indefinite quantity that is above the average in size or magnitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109908161">
	<b:glossaryEntry>the greatest amount of something that is possible or allowed; "there are limits on the amount you can bet"; "it is growing rapidly with no limitation in sight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109908421">
	<b:glossaryEntry>a designated limit beyond which something cannot function or must be terminated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109908553">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the approximate amount of something (usually used prepositionally as in `in the region of''); "it was going to take in the region of two or three months to finish the job"; "the price is in the neighborhood of $100"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109908835">
	<b:glossaryEntry>the amount of something (as whiskey or oil) lost in storage or transportation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109908965">
	<b:glossaryEntry>the quantity of a crop that is harvested; "he sent the first picking of berries to the market"; "it was the biggest peach pick in years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109909162">
	<b:glossaryEntry>an indefinite quantity that is below average size or magnitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109909754">
	<b:glossaryEntry>a small quantity of something moist or soft; "a dab of paint"; "a splatter of mud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109909906">
	<b:glossaryEntry>(British) a small quantity; "a spot of tea"; "a bit of paper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109910024">
	<b:glossaryEntry>an indefinite but relatively small number; "they bought a case of beer and drank a few"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109910161">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a very small distance or space; "they escaped by a hair''s-breadth"; "they lost by a hair"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109910332">
	<b:glossaryEntry>a small or moderate or token amount: "England still expects a modicum of eccentricity in its artists"- Ian Jack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109910497">
	<b:glossaryEntry>a small number dispersed haphazardly: "the first scatterings of green"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109910637"
	 b:glossaryEntry='a small amount of money; "he managed it on a shoestring"'/>
<rdf:Description rdf:about="&a;109910764">
	<b:glossaryEntry>a quantity of small objects flying through the air; "a spray of bullets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109910899"
	 b:glossaryEntry='a small distance; "my horse lost the race by a nose"'/>
<rdf:Description rdf:about="&a;109911002">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a short distance; "it''s only a step to the drugstore"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109911106">
	<b:glossaryEntry>a small amount or duration; "he accepted the little they gave him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109911225"
	 b:glossaryEntry="the smallest possible quantity"/>
<rdf:Description rdf:about="&a;109911359"
	 b:glossaryEntry="the amount that has spilled"/>
<rdf:Description rdf:about="&a;109911441"
	 b:glossaryEntry="the amount that has spoiled"/>
<rdf:Description rdf:about="&a;109911523">
	<b:glossaryEntry>the quantity contained in (or the capacity of) a tank or tanks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109911639">
	<b:glossaryEntry>the amount that a container (as a wine bottle or tank) lacks of being full</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109911766">
	<b:glossaryEntry>an indefinite quantity of something having a specified value; "10 dollars worth of gasoline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109911946"
	 b:glossaryEntry="the quantity that can be contained in the arms"/>
<rdf:Description rdf:about="&a;109912045">
	<b:glossaryEntry>the quantity that a bag will hold; "he ate a large bag of popcorn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109912170"
	 b:glossaryEntry="the quantity that a barrel (of any size) will hold"/>
<rdf:Description rdf:about="&a;109912285"
	 b:glossaryEntry="the quantity that a barrow will hold"/>
<rdf:Description rdf:about="&a;109912386"
	 b:glossaryEntry="the quantity that a barn will hold"/>
<rdf:Description rdf:about="&a;109912474"
	 b:glossaryEntry="the quantity that a basin will hold"/>
<rdf:Description rdf:about="&a;109912572"
	 b:glossaryEntry="the quantity contained in a basket"/>
<rdf:Description rdf:about="&a;109912671"
	 b:glossaryEntry="the quantity contained in a bin"/>
<rdf:Description rdf:about="&a;109912761"
	 b:glossaryEntry="the quantity contained in a bottle"/>
<rdf:Description rdf:about="&a;109912878"
	 b:glossaryEntry="the quantity contained in a bowl"/>
<rdf:Description rdf:about="&a;109912971">
	<b:glossaryEntry>the quantity contained in a box; "he gave her a box of chocolates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109913096"
	 b:glossaryEntry="the quantity contained in a bucket"/>
<rdf:Description rdf:about="&a;109913195"
	 b:glossaryEntry="the quantity contained in a can"/>
<rdf:Description rdf:about="&a;109913285"
	 b:glossaryEntry="the quantity that a cap will hold"/>
<rdf:Description rdf:about="&a;109913371"
	 b:glossaryEntry="the quantity that a car will hold"/>
<rdf:Description rdf:about="&a;109913457"
	 b:glossaryEntry="the quantity that a cart holds"/>
<rdf:Description rdf:about="&a;109913542"
	 b:glossaryEntry="the quantity contained in a carton"/>
<rdf:Description rdf:about="&a;109913641"
	 b:glossaryEntry="the quantity contained in a case"/>
<rdf:Description rdf:about="&a;109913734"
	 b:glossaryEntry="the quantity a cask will hold"/>
<rdf:Description rdf:about="&a;109913824"
	 b:glossaryEntry="the quantity contained in a crate"/>
<rdf:Description rdf:about="&a;109913920">
	<b:glossaryEntry>the quantity a cup will hold; "he drank a cup of coffee"; "he borrowed a cup of sugar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109914065">
	<b:glossaryEntry>the quantity that a dish will hold; "they served me a dish of rice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109914193"
	 b:glossaryEntry="the quantity that a dustpan will hold"/>
<rdf:Description rdf:about="&a;109914297"
	 b:glossaryEntry="the quantity a flask will hold"/>
<rdf:Description rdf:about="&a;109914390"
	 b:glossaryEntry="the quantity a glass will hold"/>
<rdf:Description rdf:about="&a;109914483"
	 b:glossaryEntry="the quantity that can be held in the hand"/>
<rdf:Description rdf:about="&a;109914588"
	 b:glossaryEntry="as many or as much as a hat will hold"/>
<rdf:Description rdf:about="&a;109914678">
	<b:glossaryEntry>the quantity of information that a head will hold; "he has a headful of baseball statistics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109914824">
	<b:glossaryEntry>as many as a house will accommodate; "they entertained a houseful of guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109914955"
	 b:glossaryEntry='the quantity contained in a jar; "he drank a jar of beer"'/>
<rdf:Description rdf:about="&a;109915071"
	 b:glossaryEntry="the quantity contained in a jug"/>
<rdf:Description rdf:about="&a;109915161"
	 b:glossaryEntry="the quantity contained in a keg"/>
<rdf:Description rdf:about="&a;109915251"
	 b:glossaryEntry="the quantity a kettle will hold"/>
<rdf:Description rdf:about="&a;109915347"
	 b:glossaryEntry="the quantity that can be held in the lap"/>
<rdf:Description rdf:about="&a;109915440"
	 b:glossaryEntry="the quantity that can be held in the mouth"/>
<rdf:Description rdf:about="&a;109915537"
	 b:glossaryEntry="the quantity that can be held in a mug"/>
<rdf:Description rdf:about="&a;109915634"
	 b:glossaryEntry="the quantity contained in a pail"/>
<rdf:Description rdf:about="&a;109915727">
	<b:glossaryEntry>the quantity of tobacco that can be smoked in a pipe at one time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109915845"
	 b:glossaryEntry="the quantity contained in a pitcher"/>
<rdf:Description rdf:about="&a;109915947"
	 b:glossaryEntry="the quantity contained in a plate"/>
<rdf:Description rdf:about="&a;109916043"
	 b:glossaryEntry="the quantity a pocket will hold"/>
<rdf:Description rdf:about="&a;109916130"
	 b:glossaryEntry="the quantity contained in a pot"/>
<rdf:Description rdf:about="&a;109916220"
	 b:glossaryEntry="the quantity a room will hold"/>
<rdf:Description rdf:about="&a;109916303"
	 b:glossaryEntry="the quantity contained in a sack"/>
<rdf:Description rdf:about="&a;109916396"
	 b:glossaryEntry="the quantity a scoop will hold"/>
<rdf:Description rdf:about="&a;109916489">
	<b:glossaryEntry>the amount that a shelf will hold; "he bought a shelfful of books"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109916610">
	<b:glossaryEntry>the amount that a shoe will hold; "he emptied out a shoeful of water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109916733"
	 b:glossaryEntry="the quantity a shovel can hold"/>
<rdf:Description rdf:about="&a;109916839"
	 b:glossaryEntry="the quantity a skep can hold"/>
<rdf:Description rdf:about="&a;109916921"
	 b:glossaryEntry="a bottle containing half the usual amount"/>
<rdf:Description rdf:about="&a;109917014"
	 b:glossaryEntry='as much as a spoon will hold; "he added two spoons of sugar"'/>
<rdf:Description rdf:about="&a;109917137"
	 b:glossaryEntry="as much as a tablespoon will hold"/>
<rdf:Description rdf:about="&a;109917243"
	 b:glossaryEntry="as much as a dessertspoon will hold"/>
<rdf:Description rdf:about="&a;109917355"
	 b:glossaryEntry="as much as a tank will hold"/>
<rdf:Description rdf:about="&a;109917443"
	 b:glossaryEntry="as much as a teacup will hold"/>
<rdf:Description rdf:about="&a;109917537"
	 b:glossaryEntry="as much as a teaspoon will hold"/>
<rdf:Description rdf:about="&a;109917637"
	 b:glossaryEntry="as much as a thimble will hold"/>
<rdf:Description rdf:about="&a;109917734"
	 b:glossaryEntry='the amount that a tub will hold; "a tub of water"'/>
<rdf:Description rdf:about="&a;109917842">
	<b:glossaryEntry>a small quantity of anything; "a morsel of paper was all he needed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109917962">
	<b:glossaryEntry>a small number or amount; "only a handful of responses were received"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109918098">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a small indefinite number; "he''s coming for a couple of days"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109918212">
	<b:glossaryEntry>a small quantity of liquid; "one drop of each sample was analyzed"; "any child with a drop of negro blood was legally a negro"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109918453"
	 b:glossaryEntry="a tiny drop"/>
<rdf:Description rdf:about="&a;109918518"
	 b:glossaryEntry="a small measure (usually of food)"/>
<rdf:Description rdf:about="&a;109918604">
	<b:glossaryEntry>the quantity of an active agent (substance or radiation) taken in or absorbed at any one time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109918757">
	<b:glossaryEntry>(informal) an amount of alcohol sufficient to intoxicate; "he got a load on and started a brawl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109918904">
	<b:glossaryEntry>a quantity that can be processed or transported at one time; "the system broke down under excessive loads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109919089"
	 b:glossaryEntry="quantity that can be carried by a train"/>
<rdf:Description rdf:about="&a;109919184"
	 b:glossaryEntry="a small amount of residue"/>
<rdf:Description rdf:about="&a;109919260"
	 b:glossaryEntry='a small drink of liquor; "he poured a shot of whiskey"'/>
<rdf:Description rdf:about="&a;109919371">
	<b:glossaryEntry>a just detectable amount; "he speaks French with a trace of an accent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109919531">
	<b:glossaryEntry>a small but noticeable trace of some quality that might become stronger; "a spark of interest"; "a spark of decency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109919699"
	 b:glossaryEntry="a tiny or scarcely detectable amount"/>
<rdf:Description rdf:about="&a;109919862">
	<b:glossaryEntry>a small but appreciable amount; "this dish could use a touch of garlic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109920031"
	 b:glossaryEntry="the amount that many barrels might hold"/>
<rdf:Description rdf:about="&a;109920124">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `of'') a large number or amount or extent: "a batch of letters"; "a deal of trouble"; "a lot of money"; "it must have cost plenty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109920569">
	<b:glossaryEntry>a large indefinite number; "a battalion of ants"; "a multitude of TV antennas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109920737">
	<b:glossaryEntry>an unimaginably large amount; British say "it rained like billyo" where Americans say "it rained like all get out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109920939">
	<b:glossaryEntry>the amount of cargo that can be held by a boat or ship or a freight car; "he imported wine by the boatload"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109921122">
	<b:glossaryEntry>an overwhelming number or amount; "a flood of requests"; "a torrent of abuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109921270"
	 b:glossaryEntry="an infinite quantity"/>
<rdf:Description rdf:about="&a;109921347"
	 b:glossaryEntry="the largest possible quantity"/>
<rdf:Description rdf:about="&a;109921480"
	 b:glossaryEntry='a large distance; "he missed by a mile"'/>
<rdf:Description rdf:about="&a;109921570"
	 b:glossaryEntry="a very large indefinite number (usually hyperbole)"/>
<rdf:Description rdf:about="&a;109921720"
	 b:glossaryEntry='a great amount or extent; "they did much for humanity"'/>
<rdf:Description rdf:about="&a;109921825"
	 b:glossaryEntry='a large indefinite number; "he faced a myriad of details"'/>
<rdf:Description rdf:about="&a;109921935">
	<b:glossaryEntry>a large or extra supply of something: "a reservoir of talent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109922052"
	 b:glossaryEntry="anything apparently limitless in quantity or volume"/>
<rdf:Description rdf:about="&a;109922161">
	<b:glossaryEntry>a large quantity of written matter; "he wrote reams and reams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109922274">
	<b:glossaryEntry>a large sum of money; "he made a small fortune in the commodities market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109922407"
	 b:glossaryEntry="an amount of something available for use"/>
<rdf:Description rdf:about="&a;109922518"
	 b:glossaryEntry='a large number or amount; "made lots of new friends"'/>
<rdf:Description rdf:about="&a;109922737">
	<b:glossaryEntry>space for movement; "room to pass"; "make way for": "hardly enough elbow room to turn around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923044">
	<b:glossaryEntry>sufficient room for easy breathing or movement: "moved to the country to find breathing room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923216">
	<b:glossaryEntry>vertical space available to allow easy passage under something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923355">
	<b:glossaryEntry xml:space='preserve'><![CDATA[space for accommodation in a house; "I wouldn''t give that table houseroom"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923485">
	<b:glossaryEntry>space sought for occupation by a nation whose population is expanding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923626">
	<b:glossaryEntry>space in which a vehicle can be parked; "there is plenty of parking behind the store"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923765"
	 b:glossaryEntry="space for maneuver at sea"/>
<rdf:Description rdf:about="&a;109923845">
	<b:glossaryEntry>the space created by the swing of a scythe or the cut of a mowing machine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109923970">
	<b:glossaryEntry>the amount of 3-dimensional space occupied by an object; "the gas expanded to twice its original volume"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109924164">
	<b:glossaryEntry>a relative amount; "mix one volume of the solution with ten volumes of water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109924294">
	<b:glossaryEntry>the amount that can be contained; "the gas tank has a capacity of 12 gallons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109924436">
	<b:glossaryEntry>the number of inhabitants in a given place (country or city etc.); "people come and go, but the population of this town has remained approximately constant for the past decade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109924669">
	<b:glossaryEntry>a measure of alcoholic strength expressed as an integer twice the percentage of alcohol present (by volume)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109924828">
	<b:glossaryEntry>mutual dealings or connections or communications among persons or groups</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109924967"
	 b:glossaryEntry="the relation between causes and effects"/>
<rdf:Description rdf:about="&a;109925062">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(`relationship'' is often used where `relation'' would serve (as in "the relationship between inflation and unemployment")) preferred usage of `relationship'' is for human relations or states of relatedness; "the relationship between mothers and children"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109925412">
	<b:glossaryEntry>a relation such that one thing is dependent on another; "height is a function of age"; "price is a function of supply and demand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109925596"
	 b:glossaryEntry="a relation between persons"/>
<rdf:Description rdf:about="&a;109925728">
	<b:glossaryEntry>a close personal relationship that forms between people (as between husband and wife or parent and child)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109925941"
	 b:glossaryEntry="the formation of a close personal relationship between women"/>
<rdf:Description rdf:about="&a;109926062">
	<b:glossaryEntry>the formation of a close personal relationship between men; "the rituals known as male bonding do not necessarily involve drinking beer together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109926266">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the attachment that forms between an infant and its mother beginning at birth; "maternal-infant bonding influences the child''s psychological and physical development"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109926502"
	 b:glossaryEntry="a relation between logical propositions"/>
<rdf:Description rdf:about="&a;109926676">
	<b:glossaryEntry>a relation between mathematical expressions (such as equality or inequality)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109926856">
	<b:glossaryEntry>a mathematical relation such that each element of one set is associated with at least one element of another set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109927173">
	<b:glossaryEntry>the function obtained by expressing the dependent variable of one function as the independent variable of another; f and g are inverse functions if f(x)=y and g(y)=x</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109927401">
	<b:glossaryEntry>a function that changes the position or direction of the axes of a coordinate system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109927564">
	<b:glossaryEntry>a transformation that is a combination of single transformations such as translation or rotation or reflection on an axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109927753">
	<b:glossaryEntry>a function such that for every element of one set there is a unique element of another set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109927920">
	<b:glossaryEntry>(mathematics) a symbol that represents a function from functions to functions; "the integral operator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109928113">
	<b:glossaryEntry>an operator that obeys the distributive law: A(f+g) = Af + Ag (where f and g are function)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109928265">
	<b:glossaryEntry>an operator that leaves unchanged the element on which it operates; "the identity under numerical multiplication is 1"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109928477">
	<b:glossaryEntry>function of an angle expressed as a ratio of the sides of right-angled triangle containing the angle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109928774"
	 b:glossaryEntry="ratio of the opposite side to the hypotenuse"/>
<rdf:Description rdf:about="&a;109928869"
	 b:glossaryEntry="ratio of the adjacent side to the hypotenuse"/>
<rdf:Description rdf:about="&a;109928966"
	 b:glossaryEntry="ratio of the opposite to the adjacent side"/>
<rdf:Description rdf:about="&a;109929062"
	 b:glossaryEntry="ratio of the adjacent to the opposite side"/>
<rdf:Description rdf:about="&a;109929160"
	 b:glossaryEntry="ratio of the hypotenuse to the adjacent side"/>
<rdf:Description rdf:about="&a;109929257"
	 b:glossaryEntry="ratio of the hypotenuse to the opposite side"/>
<rdf:Description rdf:about="&a;109929356">
	<b:glossaryEntry>a function that takes the value 1 if a specified function of the arguments exceeds a given threshold and 0 otherwise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109929537">
	<b:glossaryEntry>a function in which an independent variable appears as an exponent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109929684"
	 b:glossaryEntry="an equation involving exponential functions of a variable"/>
<rdf:Description rdf:about="&a;109929808"
	 b:glossaryEntry="a graph of an exponential function"/>
<rdf:Description rdf:about="&a;109929906">
	<b:glossaryEntry>a mathematical expression consisting of the constant e raised to some power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109930050">
	<b:glossaryEntry>a series derived from the expansion of an exponential expression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109930179">
	<b:glossaryEntry>(mathematics) a relation between a pair of integers: if both integers are odd or both are even they have the same parity; if one is odd and the other is even they have different parity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109930416">
	<b:glossaryEntry>the basis on which something is grounded; "there is little foundation for his objections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109930598">
	<b:glossaryEntry>a relation that provides the foundation for something; "they were on a friendly footing" or "he worked on an interim basis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109930810">
	<b:glossaryEntry>a basis agreed to by all parties for reaching a mutual understanding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109930938">
	<b:glossaryEntry>the essential foundation or source; "the problem was attacked at the grass roots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109931077">
	<b:glossaryEntry>a relation between things or events (as in the case of one causing the other or sharing features with it); "there was a connection between eating that pickle and having that nightmare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109931544">
	<b:glossaryEntry>a connection based on kinship or marriage or common interest: "the shifting alliances within a large family"; "their friendship constitutes a powerful bond between them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109931775"
	 b:glossaryEntry="an associative relation"/>
<rdf:Description rdf:about="&a;109931870"
	 b:glossaryEntry="the means of connection between things linked in series"/>
<rdf:Description rdf:about="&a;109931984">
	<b:glossaryEntry>a connection allowing access between persons or places; "how many lines of communication can there be among four people?"; "a secret passageway provided communication between the two rooms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109932233">
	<b:glossaryEntry>the linking together of a consecutive series of symbols or events or ideas etc; "it was cause by an improbable concatenation of circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109932435">
	<b:glossaryEntry>something resembling a bridge in form or function: "his letters provided a bridge across the centuries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109932591">
	<b:glossaryEntry>a connection of inclusion or containment; "he escaped involvement in the accident"; "there was additional involvement of the liver and spleen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109932827">
	<b:glossaryEntry>a relation implicated by virtue of involvement or close connection (especially an incriminating involvement); "he was suspected of implication in several robberies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109933049">
	<b:glossaryEntry>the relation of comprising something; "he admired the inclusion of so many ideas in such a short work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109933223"
	 b:glossaryEntry="the lack of a connection between things"/>
<rdf:Description rdf:about="&a;109933378"
	 b:glossaryEntry="the relation of something to the matter at hand"/>
<rdf:Description rdf:about="&a;109933601"
	 b:glossaryEntry="relevance requiring careful consideration"/>
<rdf:Description rdf:about="&a;109933718"
	 b:glossaryEntry="persuasive relevance"/>
<rdf:Description rdf:about="&a;109933792">
	<b:glossaryEntry>a style in speech or writing that arrests attention and has a penetrating or convincing quality or effect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109933949">
	<b:glossaryEntry>pertinence by virtue of a close relation to the matter at hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109934069">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually preceded by `with'') relation of delimitation; "he inquired with respect to the address"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109934263">
	<b:glossaryEntry>relevance by virtue of being applicable to the matter at hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109934446">
	<b:glossaryEntry>a particular manner of connectedness; "the relatedness of all living things"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109934616">
	<b:glossaryEntry>relevant relation or interconnection: "those issues have no bearing on our situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109934755"
	 b:glossaryEntry="the lack of a relation of something to the matter at hand"/>
<rdf:Description rdf:about="&a;109934938">
	<b:glossaryEntry>irrelevance by virtue of being inapplicable to the matter at hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109935083"
	 b:glossaryEntry="complete irrelevance requiring no further consideration"/>
<rdf:Description rdf:about="&a;109935216"
	 b:glossaryEntry="the lack of any particular manner of connectedness"/>
<rdf:Description rdf:about="&a;109935362">
	<b:glossaryEntry>unrelatedness by virtue of falling outside the matter at hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109935484"
	 b:glossaryEntry="a linguistic relation established by grammar"/>
<rdf:Description rdf:about="&a;109935847"
	 b:glossaryEntry="a relation between linguistic forms or constituents"/>
<rdf:Description rdf:about="&a;109936000">
	<b:glossaryEntry>the determination of grammatical inflection on the basis of word relations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109936212">
	<b:glossaryEntry>agreement in number between words in the same grammatical construction (e.g., between adjectives and the nouns they modify)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109936398"
	 b:glossaryEntry="agreement in person between pronouns and verbs"/>
<rdf:Description rdf:about="&a;109936507">
	<b:glossaryEntry>agreement in grammatical case between words in the same construction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109936636">
	<b:glossaryEntry>agreement in grammatical gender between words in the same construction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109936769"
	 b:glossaryEntry="the grammatical relation created by a transitive verb"/>
<rdf:Description rdf:about="&a;109936916"
	 b:glossaryEntry="the grammatical relation created by an intransitive verb"/>
<rdf:Description rdf:about="&a;109937070">
	<b:glossaryEntry>the grammatical relation between two words that have a common referent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109937216">
	<b:glossaryEntry>the coreferential relation between a reflexive pronoun and its antecedent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109937363">
	<b:glossaryEntry>the grammatical relation between linguistic units (words or phrases or clauses) that are connected by a conjunction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109937626">
	<b:glossaryEntry>the coordination by conjunction of linguistic units of the same status</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109937767">
	<b:glossaryEntry>the subordination that occurs when a conjunction makes one linguistic unit a constituent of another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109937938">
	<b:glossaryEntry>the conjunctive relation of units that expresses the addition of their meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109938086">
	<b:glossaryEntry>the conjunctive relation of units that expresses the disjunction of their meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109938238">
	<b:glossaryEntry>the conjunctive relation of units that expresses the opposition of their meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109938389"
	 b:glossaryEntry="the grammatical relation of a word or phrase to a predicate"/>
<rdf:Description rdf:about="&a;109938510">
	<b:glossaryEntry>the grammatical relation of two constituents having the same grammatical form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109938646">
	<b:glossaryEntry>the grammatical relation of a modifying word or phrase to its head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109938772">
	<b:glossaryEntry>the grammatical relation that exists when a word qualifies the meaning of the phrase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109938975">
	<b:glossaryEntry>modification that makes the meaning more specific (`red hat'' has a more specific meaning than `hat'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109939137">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a grammatical relation between a word and a noun phrase that follows; "`Rudolph the red-nosed reindeer'' is an example of apposition"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109939326">
	<b:glossaryEntry>verb inflections that express how the action or state is conceived by the speaker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109939566">
	<b:glossaryEntry>a mood (grammatically unmarked) that represents the act or state as an objective fact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109939785">
	<b:glossaryEntry>a mood that represent an act or state (not as a fact but) as contingent or possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109939945">
	<b:glossaryEntry>a mood (as in Greek or Sanskrit) that expresses a wish or hope; expressed in English by modal verbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109940115">
	<b:glossaryEntry>a mood that expresses an intention to influence the listener''s behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109940276">
	<b:glossaryEntry>some linguists consider interrogative sentences to constitute a mood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109940425">
	<b:glossaryEntry>a classification of propositions on the basis of whether they claim necessity or possibility or impossibility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109940596"
	 b:glossaryEntry="the relation between an anaphor and its antecedent"/>
<rdf:Description rdf:about="&a;109940711">
	<b:glossaryEntry>(linguistics) the grammatical relation of the subject of a verb to the action that the verb denotes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109940898">
	<b:glossaryEntry>the voice used to indicate that the subject of the verb is performing the action or causing the happening denoted by the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109941109">
	<b:glossaryEntry>the voice used to indicate that the subject of the verb is the recipient (not the source) of the action denoted by the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109941320">
	<b:glossaryEntry>a change in the form of a word (usually by adding a suffix) to indicate a change in its grammatical function</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109941551"
	 b:glossaryEntry="the inflection of verbs"/>
<rdf:Description rdf:about="&a;109941651"
	 b:glossaryEntry="the inflection of nouns and pronouns and adjectives"/>
<rdf:Description rdf:about="&a;109941778"
	 b:glossaryEntry="systematic arrangement of all the inflected forms of a word"/>
<rdf:Description rdf:about="&a;109941892">
	<b:glossaryEntry>the beginning or duration or completion or repetition of the action of a verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109942076">
	<b:glossaryEntry>the aspect of a verb that expresses a completed completed action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109942217">
	<b:glossaryEntry>aspect without regard to the beginning or completion of the action of the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109942376"
	 b:glossaryEntry="the aspect of a verb that expresses its duration"/>
<rdf:Description rdf:about="&a;109942533"
	 b:glossaryEntry="the aspect of a verb that expresses its on-going action"/>
<rdf:Description rdf:about="&a;109942653">
	<b:glossaryEntry>aspect with regard to the beginning of the action of the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109942778"
	 b:glossaryEntry="a tense of verbs used in describing action that is on-going"/>
<rdf:Description rdf:about="&a;109943018">
	<b:glossaryEntry>a tense used to express action that is on-going at the time of utterance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109943184">
	<b:glossaryEntry>a tense of verbs used in describing action that has been completed (sometimes regarded as perfective aspect)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109943448">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a perfective tense used to express action completed in the present; "`I have finished'' is an example of the present perfect"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109943658"
	 b:glossaryEntry="a term formerly used to refer to the simple past tense"/>
<rdf:Description rdf:about="&a;109943779">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a perfective tense used to express action completed in the past; "`Ihad finished'' is an example of the past perfect"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109944007">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a progressive tense used to describe on-going action in the past; "`I had been running'' is an example of the past progressive"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109944221">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a perfective tense used to describe action that will be completed in the future; "`I will have finished'' is an example of the future perfect"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109944446">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a progressive tense used to express action that will be on-going in the future; "`I will be running'' is an example of the future progressive"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109944679"
	 b:glossaryEntry="a relation between meanings"/>
<rdf:Description rdf:about="&a;109944896">
	<b:glossaryEntry>the semantic relation of being subordinate or belonging to a lower rank or class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109945047">
	<b:glossaryEntry>the semantic relation of being superordinate or belonging to a higher rank or class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109945204">
	<b:glossaryEntry>the semantic relation that holds between two words that can (in a given context) express the same meaning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109945394">
	<b:glossaryEntry>the semantic relation that holds between two words that can (in a given context) express opposite meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109945555">
	<b:glossaryEntry>the semantic relation that holds between a whole and its parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109945697">
	<b:glossaryEntry>the semantic relation that holds between a part and the whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109945857"
	 b:glossaryEntry="the semantic relation of being a manner of does something"/>
<rdf:Description rdf:about="&a;109945970">
	<b:glossaryEntry>something determined in relation to something that includes it; "he wanted to feel a part of something bigger than himself"; "I read a portion of the manuscript"; "the smaller component is hard to reach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109946426">
	<b:glossaryEntry>a small part that can be considered separately from the whole; "it was perfect in all details"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109946611">
	<b:glossaryEntry>the most interesting or memorable part; "the highlight of the tour was our visit to the Vatican"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109946775">
	<b:glossaryEntry>an individual or group or structure or other entity regarded as a structural or functional constituent of a whole; "the reduced the number of units and installations"; "the word is a basic linguistic unit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109947031">
	<b:glossaryEntry>anything that belongs to a set or class: "snakes are members of the class Reptilia"; "members of the opposite sex"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109947198"
	 b:glossaryEntry="the stuff of which an object consists"/>
<rdf:Description rdf:about="&a;109947291">
	<b:glossaryEntry>something left after other parts have been taken away; "there was no remainder"; "he threw away the rest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109947509">
	<b:glossaryEntry>a small part or portion that remains after the main part no longer exists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109947647"
	 b:glossaryEntry="a part of a part"/>
<rdf:Description rdf:about="&a;109947717">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a close connection marked by community of interests or similarity in nature or character: "found a natural affinity with the immigrants"; "felt a deep kinship with the other students"; "anthropology''s kinship with the humanities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109948047"
	 b:glossaryEntry="relation of mutual understanding or trust between people"/>
<rdf:Description rdf:about="&a;109948157">
	<b:glossaryEntry>a relation of affinity or harmony between people; whatever affects one correspondingly affects the other; "the two of them were in close sympathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109948376"
	 b:glossaryEntry="sympathy of each person for the other"/>
<rdf:Description rdf:about="&a;109948499">
	<b:glossaryEntry>(biology) state of relationship between organisms or groups of organisms resulting in resemblance in structure or structural parts: "in anatomical structure prehistoric man shows close affinity with modern humans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109948791">
	<b:glossaryEntry>state of relatedness or connection by blood or marriage or adoption</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109949111">
	<b:glossaryEntry>the kinship relation between an individual and the individual''s progenitors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109949316"
	 b:glossaryEntry="kinship by marriage or adoption; not a blood relationship"/>
<rdf:Description rdf:about="&a;109949486"
	 b:glossaryEntry="a family relationship by virtue of remarriage"/>
<rdf:Description rdf:about="&a;109949594"
	 b:glossaryEntry="related by blood"/>
<rdf:Description rdf:about="&a;109949716"
	 b:glossaryEntry="the kinship relation of an offspring to the parents"/>
<rdf:Description rdf:about="&a;109949831"
	 b:glossaryEntry="the kinship relation between an offspring and the father"/>
<rdf:Description rdf:about="&a;109949956"
	 b:glossaryEntry="the kinship relation between an offspring and the mother"/>
<rdf:Description rdf:about="&a;109950081">
	<b:glossaryEntry>the kinship relation between a female offspring and the siblings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109950234">
	<b:glossaryEntry>the kinship relation between a male offspring and the siblings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109950354">
	<b:glossaryEntry>line of descent traced through both the maternal and paternal sides of the family</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109950499"
	 b:glossaryEntry="line of descent traced through one side of the family"/>
<rdf:Description rdf:about="&a;109950653">
	<b:glossaryEntry>line of descent traced through the maternal side of the family</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109950796">
	<b:glossaryEntry>line of descent traced through the paternal side of the family</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109950928"
	 b:glossaryEntry="a relation between magnitudes"/>
<rdf:Description rdf:about="&a;109951076"
	 b:glossaryEntry='relative magnitude; "they entertained on a grand scale"'/>
<rdf:Description rdf:about="&a;109951183">
	<b:glossaryEntry>the quotient obtained when the magnitude of a part is divided by the magnitude of the whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109951476">
	<b:glossaryEntry>the proportion of a substance that is contained in a mixture or alloy etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109951604">
	<b:glossaryEntry>the ratio between the size of something and a representation of it; "the scale of the map"; "the scale of the model"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109951772">
	<b:glossaryEntry>the proportional relation between two divisions of line or two dimension of a plane figure such that short : long :: long : (short + long)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109951985"
	 b:glossaryEntry="the relation of correspondence in degree or size or amount"/>
<rdf:Description rdf:about="&a;109952143"
	 b:glossaryEntry="a proportion multiplied by 100"/>
<rdf:Description rdf:about="&a;109952367"
	 b:glossaryEntry="the percentage of workers who do not report to work"/>
<rdf:Description rdf:about="&a;109952478">
	<b:glossaryEntry>(baseball) the percentage of times a batter gets a hit; number of base hits divided by the number of times at bat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109952653">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(an extension of the baseball term) the proportion of times some effort succeeds; "the salesman''s batting average was 7 out of 12"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109952845">
	<b:glossaryEntry>(baseball) the percentage of times a fielder handles a batted ball properly; number of assists and putouts divided by the number of chances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109953047">
	<b:glossaryEntry>the percentage of all rental units (as in hotels) are occupied or rented at a given time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109953196">
	<b:glossaryEntry>the percentage of all rental units (as in hotels) that are unoccupied or not rented at a given time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109953354">
	<b:glossaryEntry>the percentage of the work force that is unemployed at any given date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109953487">
	<b:glossaryEntry>the relative magnitudes of two quantities (usually expressed as a quotient)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109954118"
	 b:glossaryEntry="the ratio of reflected to incident light"/>
<rdf:Description rdf:about="&a;109954230"
	 b:glossaryEntry="the ratio of the width to the height of a tv picture"/>
<rdf:Description rdf:about="&a;109954341">
	<b:glossaryEntry>ratio (in percent) of the maximum breadth to the maximum length of a skull</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109954508"
	 b:glossaryEntry="the ratio of the output to the input of any system"/>
<rdf:Description rdf:about="&a;109954615">
	<b:glossaryEntry>the ratio (in percent) of the maximum width the the maximum height of the face</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109954752">
	<b:glossaryEntry>the ratio of the focal length to the diameter of a (camera) lens system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109954914">
	<b:glossaryEntry>the ratio of the number of observations in a statistical category to the total number of observations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109955110">
	<b:glossaryEntry>a measure of a person''s intelligence as indicated by an intelligence test; the ratio of a person''s mental age to their chronological age (multiplied by 100)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109955382"
	 b:glossaryEntry="the average IQ of the adults in a given population"/>
<rdf:Description rdf:about="&a;109955497">
	<b:glossaryEntry>the minimal IQ required for someone to function normally and independently in the world (without some form of institutional assistance)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109955702">
	<b:glossaryEntry>the ratio of the annual claims paid by an insurance company to the premiums received</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109955843">
	<b:glossaryEntry>the ratio of the speed of a moving body to the speed of sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109955962"
	 b:glossaryEntry="the ratio of the size of an image to the size of the object"/>
<rdf:Description rdf:about="&a;109956081">
	<b:glossaryEntry>the ratio of the force exerted by a machine to the force applied to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109956218">
	<b:glossaryEntry>the ratio of the number of miles traveled to the number of gallons of gasoline burned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109956376">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the ratio by which one better''s wager is greater than that of another; "he offered odds of two to one"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109956529">
	<b:glossaryEntry>a number assigned to the ratio of two quantities; two quantities are of the same order of magnitude if one is less than 10 times as large as the other; the number of magnitudes that the quantities differ is specified to within a power of 10</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109956846"
	 b:glossaryEntry="the output power of a transducer divided by the input power"/>
<rdf:Description rdf:about="&a;109956992">
	<b:glossaryEntry>(economics) the ratio of the quantity and quality of units produced to the labor per unit of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109957148"
	 b:glossaryEntry="the ratio of two quantities to be divided"/>
<rdf:Description rdf:about="&a;109957262">
	<b:glossaryEntry>the ratio of the velocity of light in a vacuum to that in a medium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109957413">
	<b:glossaryEntry>the ratio of the amount of water in the air at a give temperature to the maximum amount it could hold at that temperature; expressed as a percentage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109957625">
	<b:glossaryEntry>the ratio of the volume of carbon dioxide expired to the volume of oxygen consumed by an organism or cell in a given period of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109957823">
	<b:glossaryEntry>the ratio of the breaking stress of a structure to the estimated maximum stress in ordinary use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109957997"
	 b:glossaryEntry="the ratio of signal intensity to noise intensity"/>
<rdf:Description rdf:about="&a;109958173">
	<b:glossaryEntry>the ratio of the inductance of a circuit in henries to its resistance in ohms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109958310">
	<b:glossaryEntry>the ratio of the number of workers that had to be replaced in a given time period to the average number of workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109958495">
	<b:glossaryEntry>the ratio of the gross weight of an airplane to some factor determining its lift</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109958683"
	 b:glossaryEntry="the ratio of the weight of an airplane to its engine power"/>
<rdf:Description rdf:about="&a;109958801"
	 b:glossaryEntry="the ratio of the weight of an airplane to its wingspan"/>
<rdf:Description rdf:about="&a;109958914"
	 b:glossaryEntry="the ratio of the weight of an airplane to its wing area"/>
<rdf:Description rdf:about="&a;109959028"
	 b:glossaryEntry="the relative frequency of occurrence of something"/>
<rdf:Description rdf:about="&a;109959172"
	 b:glossaryEntry="the relative incidence of a particular disease"/>
<rdf:Description rdf:about="&a;109959274">
	<b:glossaryEntry>a relation of constraint of one entity (thing or person or group) by another; "measures for the control of disease"; "they instituted controls over drinking on campus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109959513">
	<b:glossaryEntry>control by preventing the occurrence of something; "money was allocated to study the cause and prevention of influenza"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109959689">
	<b:glossaryEntry>the spatial relation between something and the course along which it points or moves; "he checked the direction and velocity of the wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109960026">
	<b:glossaryEntry>position or alignment relative to points of the compass or other specific directions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109960294">
	<b:glossaryEntry>position of aircraft or spacecraft relative to a frame of reference (the horizon or direction of motion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109960471">
	<b:glossaryEntry>attitude of an aircraft in flight when allowed to take its own orientation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109960596"
	 b:glossaryEntry="something that is oriented horizontally"/>
<rdf:Description rdf:about="&a;109960692"
	 b:glossaryEntry="something that is oriented vertically"/>
<rdf:Description rdf:about="&a;109960784"
	 b:glossaryEntry="a direction opposite to another"/>
<rdf:Description rdf:about="&a;109960926"
	 b:glossaryEntry="the relation of opposition between things at right angles"/>
<rdf:Description rdf:about="&a;109961086"
	 b:glossaryEntry="the relation of opposition along a diameter"/>
<rdf:Description rdf:about="&a;109961233">
	<b:glossaryEntry>the relation of opposition between crystals or molecules that are reflections of one another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109961411"
	 b:glossaryEntry="the direction from which the wind is coming"/>
<rdf:Description rdf:about="&a;109961545"
	 b:glossaryEntry="the side toward the wind"/>
<rdf:Description rdf:about="&a;109961673"
	 b:glossaryEntry="the direction in which the wind is blowing"/>
<rdf:Description rdf:about="&a;109961805"
	 b:glossaryEntry="the side sheltered from the wind"/>
<rdf:Description rdf:about="&a;109961909">
	<b:glossaryEntry>one of the four major division of the compass; "the wind is coming from that quarter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109962048">
	<b:glossaryEntry>any of 32 horizontal directions indicated on the card of a compass; "he checked the point on his compass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109962743"
	 b:glossaryEntry="one of the four main compass points"/>
<rdf:Description rdf:about="&a;109962919"
	 b:glossaryEntry="the cardinal compass point that is at 0 or 360 degrees"/>
<rdf:Description rdf:about="&a;109963041">
	<b:glossaryEntry>the compass point that is one point east (clockwise) of due north</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109963172"
	 b:glossaryEntry="the direction in which a compass needle points"/>
<rdf:Description rdf:about="&a;109963303"
	 b:glossaryEntry="the compass point that is midway between north and northeast"/>
<rdf:Description rdf:about="&a;109963448"
	 b:glossaryEntry="the compass point that is one point north of northeast"/>
<rdf:Description rdf:about="&a;109963574">
	<b:glossaryEntry>the compass point midway between north and east; at 45 degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109963709"
	 b:glossaryEntry="the compass point that is one point east of northeast"/>
<rdf:Description rdf:about="&a;109963833"
	 b:glossaryEntry="the compass point midway between northeast and east"/>
<rdf:Description rdf:about="&a;109963951"
	 b:glossaryEntry="the compass point that is one point north of due east"/>
<rdf:Description rdf:about="&a;109964070"
	 b:glossaryEntry="the cardinal compass point that is at 90 degrees"/>
<rdf:Description rdf:about="&a;109964184"
	 b:glossaryEntry="the compass point that is one point south of due east"/>
<rdf:Description rdf:about="&a;109964303"
	 b:glossaryEntry="the compass point midway between east and southeast"/>
<rdf:Description rdf:about="&a;109964421"
	 b:glossaryEntry="the compass point that is one point east of southeast"/>
<rdf:Description rdf:about="&a;109964545">
	<b:glossaryEntry>the compass point midway between south and east; at 135 degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109964681"
	 b:glossaryEntry="the compass point that is one point south of southeast"/>
<rdf:Description rdf:about="&a;109964807"
	 b:glossaryEntry="the compass point midway between south and southeast"/>
<rdf:Description rdf:about="&a;109964944"
	 b:glossaryEntry="the compass point that is one point east of due south"/>
<rdf:Description rdf:about="&a;109965063"
	 b:glossaryEntry="the cardinal compass point that is at 180 degrees"/>
<rdf:Description rdf:about="&a;109965180"
	 b:glossaryEntry="the compass point that is one point west of due south"/>
<rdf:Description rdf:about="&a;109965299"
	 b:glossaryEntry="the compass point midway between south and southwest"/>
<rdf:Description rdf:about="&a;109965436"
	 b:glossaryEntry="the compass point that is one point south of southwest"/>
<rdf:Description rdf:about="&a;109965562">
	<b:glossaryEntry>the compass point midway between south and west; at 225 degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109965698"
	 b:glossaryEntry="the compass point that is one point west of southwest"/>
<rdf:Description rdf:about="&a;109965822"
	 b:glossaryEntry="the compass point midway between west and southwest"/>
<rdf:Description rdf:about="&a;109965940"
	 b:glossaryEntry="the compass point that is one point south of due west"/>
<rdf:Description rdf:about="&a;109966059"
	 b:glossaryEntry="the cardinal compass point that is a 270 degrees"/>
<rdf:Description rdf:about="&a;109966173"
	 b:glossaryEntry="the compass point that is one point north of due west"/>
<rdf:Description rdf:about="&a;109966292"
	 b:glossaryEntry="the compass point midway between west and northwest"/>
<rdf:Description rdf:about="&a;109966410"
	 b:glossaryEntry="the compass point that is one point west of northwest"/>
<rdf:Description rdf:about="&a;109966534">
	<b:glossaryEntry>the compass point midway between north and west; at 315 degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109966670"
	 b:glossaryEntry="the compass point that is one point north of northwest"/>
<rdf:Description rdf:about="&a;109966796"
	 b:glossaryEntry="the compass point that is midway between north and northwest"/>
<rdf:Description rdf:about="&a;109966941"
	 b:glossaryEntry="the compass point that is one point west of due north"/>
<rdf:Description rdf:about="&a;109967060">
	<b:glossaryEntry>relation by which any position with respect to any other position is established</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109967239">
	<b:glossaryEntry>(astronomy) the angular distance to a point on a celestial object measured north or south from the celestial equator; expressed in degrees; used with right ascension to specify positions on the celestial sphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109967534">
	<b:glossaryEntry>angular distance above the horizon (especially of a celestial object)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109967681">
	<b:glossaryEntry>angular distance below the horizon (especially of a celestial object)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109967807"
	 b:glossaryEntry="a relation between different business enterprises"/>
<rdf:Description rdf:about="&a;109967975">
	<b:glossaryEntry>a business relation in which two parties compete to gain customers; "business competition can be fiendish at times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109968166">
	<b:glossaryEntry>intense competition in which competitors cut retail prices to gain business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109968317"
	 b:glossaryEntry="relation of a client to a patron"/>
<rdf:Description rdf:about="&a;109968405">
	<b:glossaryEntry>the relation that exists when one person requests and is granted professional help from a qualified source</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109968633">
	<b:glossaryEntry>the professional relation between a health care professional and a patient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109968806">
	<b:glossaryEntry>the responsibility of a physician to act in the best interests of the patient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109968991">
	<b:glossaryEntry>the responsibility of a nurse to act in the best interests of the patient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109969171">
	<b:glossaryEntry>a professional relation that is regulated by law (as between a lawyer and a client)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109969333">
	<b:glossaryEntry>the legal relation that exists when one person justifiably places reliance on another whose aid or protection is sought in some matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109969694">
	<b:glossaryEntry>the responsibility of a bank to act in the best interests of the depositors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109969839">
	<b:glossaryEntry>the responsibility of a confidential adviser to act in the best interest of the advisee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109970010">
	<b:glossaryEntry>the responsibility of a conservator to act in the best interests of the ward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109970158">
	<b:glossaryEntry>the responsibility of corporate directors to act in the best interests of stockholders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109970320">
	<b:glossaryEntry>the responsibility of an executor (or administrator) of an estate to act in the best interests of the heir</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109970495">
	<b:glossaryEntry>the responsibility of a lawyer to act in the best interests of the client</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109970702">
	<b:glossaryEntry>the responsibility of partners to act in one another''s best interests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109970834">
	<b:glossaryEntry>the responsibility of receiver or trustee in bankruptcy to act in the best interests of the creditor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109971007">
	<b:glossaryEntry>the responsibility of a trustee to act in the best interests of the beneficiary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109971161">
	<b:glossaryEntry>a professional relation between instructors and those they instruct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109971310"
	 b:glossaryEntry="the academic relation between teachers and their students"/>
<rdf:Description rdf:about="&a;109971476"
	 b:glossaryEntry="social relations involving authority or power"/>
<rdf:Description rdf:about="&a;109971597">
	<b:glossaryEntry>the way two individuals relate to each other; "their chemistry was wrong from the beginning -- they hated each other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109971796"
	 b:glossaryEntry="a relation of mutual dependence or action or influence"/>
<rdf:Description rdf:about="&a;109972014">
	<b:glossaryEntry>the interrelation of reciprocity whereby one thing supplements or depends on the other; "the complementarity of the sexes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109972198"
	 b:glossaryEntry="a reciprocal relation between two or more things"/>
<rdf:Description rdf:about="&a;109972320">
	<b:glossaryEntry>a reciprocal relation between interdependent individuals or groups</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109972550">
	<b:glossaryEntry>the relation between two different kinds of organisms when one receives benefits from the other without damaging it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109972724">
	<b:glossaryEntry>the relation between two different kinds of organisms in which one receives benefits from the other by causing damage to it (usually not fatal damage)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109972931">
	<b:glossaryEntry>the relation between two different kinds of organisms that are interdependent; each gains benefits from the other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109973100">
	<b:glossaryEntry>(math) one of a pair of numbers whose product is 1: the reciprocal of 2/3 is 3/2; the inverse of 7 is 1/7</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109973272">
	<b:glossaryEntry>a reciprocality of sentiments; "the mutuality of their affection was obvious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109973418"
	 b:glossaryEntry="using or enjoying something jointly with others"/>
<rdf:Description rdf:about="&a;109973537">
	<b:glossaryEntry>(computer science) the use of a central computer by many users simultaneously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109973673">
	<b:glossaryEntry>mutual or reciprocal relation or relatedness: "interrelationships of animal structure and function"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109973871"
	 b:glossaryEntry="a relation involving time"/>
<rdf:Description rdf:about="&a;109974104">
	<b:glossaryEntry>anything that precedes something similar in time; "phrenology was an antecedent of modern neuroscience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109974277"
	 b:glossaryEntry="arrangement of events in time"/>
<rdf:Description rdf:about="&a;109974363">
	<b:glossaryEntry>the relation that exists when things occur at the same time; "the drug produces an increased synchrony of the brain waves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109974692">
	<b:glossaryEntry>the relation that exists when things occur at unrelated times; "the stimulus produced a desynchronizing of the brain waves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109974999">
	<b:glossaryEntry>the first or highest in an ordering or series: "He wanted to be the first"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109975156">
	<b:glossaryEntry>the first of two or the first mentioned of two; "Tom and Dick were both heroes but only the former is remembered today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109975346">
	<b:glossaryEntry>following the first in an ordering or series: "he came in a close second"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109975490">
	<b:glossaryEntry>the second of two or the second mentioned of two; "Tom and Dick were both heroes but only the latter is remembered today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109975682">
	<b:glossaryEntry>following the second position in an ordering or series: "a distant third"; "he answered the first question willingly, the second reluctantly, and the third with resentment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109975906">
	<b:glossaryEntry>following the third position; number four in a countable series</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109976022">
	<b:glossaryEntry>position five in a countable series of things; "he was fifth out of several hundred runners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109976166"
	 b:glossaryEntry="position six in a countable series of things"/>
<rdf:Description rdf:about="&a;109976262"
	 b:glossaryEntry="position seven in a countable series of things"/>
<rdf:Description rdf:about="&a;109976362"
	 b:glossaryEntry="position eight in a countable series of things"/>
<rdf:Description rdf:about="&a;109976461">
	<b:glossaryEntry>position nine in a countable series of things; "going into the ninth they were a run ahead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109976604"
	 b:glossaryEntry="position ten in a countable series of things"/>
<rdf:Description rdf:about="&a;109976700"
	 b:glossaryEntry="position 11 in a countable series of things"/>
<rdf:Description rdf:about="&a;109976798"
	 b:glossaryEntry="position 12 in a countable series of things"/>
<rdf:Description rdf:about="&a;109976895"
	 b:glossaryEntry="position 13 in a countable series of things"/>
<rdf:Description rdf:about="&a;109976995"
	 b:glossaryEntry="position 14 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977095"
	 b:glossaryEntry="position 15 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977194"
	 b:glossaryEntry="position 16 is a countable series of things"/>
<rdf:Description rdf:about="&a;109977293"
	 b:glossaryEntry="position 17 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977394"
	 b:glossaryEntry="position 18 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977494"
	 b:glossaryEntry="position 19 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977594"
	 b:glossaryEntry="position 20 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977693"
	 b:glossaryEntry="position 30 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977792"
	 b:glossaryEntry="position 40 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977890"
	 b:glossaryEntry="position 50 in a countable series of things"/>
<rdf:Description rdf:about="&a;109977988"
	 b:glossaryEntry="position 60 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978086"
	 b:glossaryEntry="position 70 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978186"
	 b:glossaryEntry="position 80 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978285"
	 b:glossaryEntry="position 90 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978384"
	 b:glossaryEntry="position 100 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978484"
	 b:glossaryEntry="position 1,000 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978587"
	 b:glossaryEntry="position 1,000,000 in a countable series of things"/>
<rdf:Description rdf:about="&a;109978693">
	<b:glossaryEntry>(in the U.S.) position 1,000,000,000 in a countable series of things</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109978817">
	<b:glossaryEntry>the last or lowest in an ordering or series; "he was the last to leave"; "he finished an inglorious last"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109978973">
	<b:glossaryEntry>an ordered reference standard: "judging on a scale of 1 to 10"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109979235">
	<b:glossaryEntry>a numerical scale used to compare variables with one another or with some reference number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109979377">
	<b:glossaryEntry>scale on which actual distances from the origin are proportional to the logarithms of the corresponding scale numbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109979558"
	 b:glossaryEntry="a schedule of wages paid for different jobs"/>
<rdf:Description rdf:about="&a;109979692">
	<b:glossaryEntry>a wage scale that fluctuates in response to the cost-of-living index</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109979820">
	<b:glossaryEntry>an international scale of wind force from 0 (calm air) to 12 (hurricane)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109980213">
	<b:glossaryEntry>a logarithmic scale of 1 to 10 used to express the energy released by an earthquake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109980356"
	 b:glossaryEntry="relation based on similarities and differences"/>
<rdf:Description rdf:about="&a;109980477">
	<b:glossaryEntry>the kind of mental comparison that is expressed in similes or metaphors or allegories</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109980631">
	<b:glossaryEntry>accepted or approved instance or example of a quantity or quality against which others are judged or measured or compared</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109980822">
	<b:glossaryEntry>an imaginary line or standard by which things are measured or compared; "the established a baseline for the budget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109980992">
	<b:glossaryEntry>a standard or model or pattern regarded as typical: "the current middle-class norm of two children per family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109981153"
	 b:glossaryEntry="the relation between opposed entities"/>
<rdf:Description rdf:about="&a;109981550"
	 b:glossaryEntry='direct opposite; "quiet: an antipode to focused busyness"'/>
<rdf:Description rdf:about="&a;109981662"
	 b:glossaryEntry='exact opposite; "his theory is the antithesis of mine"'/>
<rdf:Description rdf:about="&a;109981773">
	<b:glossaryEntry xml:space='preserve'><![CDATA[opposition in a work of drama or fiction between characters or forces (especially an opposition that motivates the development of the plot); "this form of conflict is essential to Mann''s writing"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109982023">
	<b:glossaryEntry>the opposition or dissimilarity of things that are compared; "in contrast to", "by contrast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109982188">
	<b:glossaryEntry>a relation between two opposite attributes or tendencies; "he viewed it as a balanced polarity between good and evil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109982380"
	 b:glossaryEntry="an opposition that is capable of being graded"/>
<rdf:Description rdf:about="&a;109982509">
	<b:glossaryEntry>an opposition that can be graded between two extremes or poles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109982634">
	<b:glossaryEntry>having an indicated pole (as the distinction between positive and negative electric charges); "he got the polarity of the battery reversed"; "charges of opposite sign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109982917">
	<b:glossaryEntry>an opposition that has no intermediate grade; either one or the other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109983072">
	<b:glossaryEntry>a relation between two opposite states or principles that together exhaust the possibilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109983226"
	 b:glossaryEntry="the relation that exists when opposites cannot coexist"/>
<rdf:Description rdf:about="&a;109983362"
	 b:glossaryEntry="the negative of the opposition"/>
<rdf:Description rdf:about="&a;109983447"
	 b:glossaryEntry="opposition between two conflicting forces or ideas"/>
<rdf:Description rdf:about="&a;109983575">
	<b:glossaryEntry>a contradiction of ideas that serves as the determining factor in their interaction; "this situation created the inner dialectic of American history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109983780">
	<b:glossaryEntry>the relation between propositions that cannot both be true at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109983956">
	<b:glossaryEntry>exact opposition; "public opinion to the contrary he is not guilty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109984078"
	 b:glossaryEntry="the relation between contraries"/>
<rdf:Description rdf:about="&a;109984167">
	<b:glossaryEntry>some third thing similar to two opposites but distinct from both</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109984290">
	<b:glossaryEntry>a relation of direct opposition; "we thought Sue was older than Bill but just the reverse was true"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109984465">
	<b:glossaryEntry>something inverted in sequence or character or effect; "when the direct approach failed he tried the inverse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109984639">
	<b:glossaryEntry>a relational difference between states; especially between states before and after some event: "he attributed the change to their marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109984867">
	<b:glossaryEntry>a significant change; "the difference in her is amazing"; "his support made a real difference"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109985018">
	<b:glossaryEntry>a graded change in the magnitude of some physical quantity or dimension</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109985180">
	<b:glossaryEntry>a gradient in the gravitational forces acting on different parts of a nonspherical object; "the gravity gradient of the moon causes the ocean tides on Earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109985400">
	<b:glossaryEntry>change in temperature as a function of distance (especially altitude)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109985536">
	<b:glossaryEntry>a logical relation between propositions p and q of the form `if p then q''; if p is true then q cannot be false</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109985749"
	 b:glossaryEntry="a three-dimensional shape"/>
<rdf:Description rdf:about="&a;109985988">
	<b:glossaryEntry>(mathematics) an unbounded two-dimensional shape; "we will refer to the plane of the graph as the X-Y plane"; "any line joining two points on a plane lies wholly on that plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109986314"
	 b:glossaryEntry="the plane of a facet of an object (as of a cube)"/>
<rdf:Description rdf:about="&a;109986420"
	 b:glossaryEntry="the median plane of the body (or some part of the body)"/>
<rdf:Description rdf:about="&a;109986540"
	 b:glossaryEntry="(astronomy) the plane on which a body is orbiting"/>
<rdf:Description rdf:about="&a;109986649">
	<b:glossaryEntry>the plane that is in the foreground of a drawing or painting; coextensive with but different from the objective surface of the work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109986859">
	<b:glossaryEntry>the plane that contains all the lines tangent to a specific point on a surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109986997"
	 b:glossaryEntry="a shape created by natural forces; not man-made"/>
<rdf:Description rdf:about="&a;109987122"
	 b:glossaryEntry="any of the various shape that leaves of plants can assume"/>
<rdf:Description rdf:about="&a;109987267"
	 b:glossaryEntry='a shape that spreads outward; "the skirt had a wide flare"'/>
<rdf:Description rdf:about="&a;109987377">
	<b:glossaryEntry>a combination of points and lines and planes that form a visible palpable shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109987563"
	 b:glossaryEntry="a 2-dimensional shape"/>
<rdf:Description rdf:about="&a;109987848"
	 b:glossaryEntry="a 3-dimensional shape"/>
<rdf:Description rdf:about="&a;109987973"
	 b:glossaryEntry="a figure that is a part of another figure"/>
<rdf:Description rdf:about="&a;109988142">
	<b:glossaryEntry>a length (straight or curved) without breadth or thickness; the trace of a moving point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109988406"
	 b:glossaryEntry="a shape that curves or bulges outward"/>
<rdf:Description rdf:about="&a;109988640"
	 b:glossaryEntry="a slight convexity (as of the surface of a road)"/>
<rdf:Description rdf:about="&a;109988741"
	 b:glossaryEntry="a shape having one or more sharp angles"/>
<rdf:Description rdf:about="&a;109988907"
	 b:glossaryEntry="a shape that curves inward"/>
<rdf:Description rdf:about="&a;109989131"
	 b:glossaryEntry="a shape that is curved and without sharp angles"/>
<rdf:Description rdf:about="&a;109989452">
	<b:glossaryEntry>a plane figure with rounded sides curving inward at the top and intersecting at the bottom; conventionally used on playing cards and valentines; "he drew a heart and called it a valentine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109989692"
	 b:glossaryEntry="a closed plane figure bounded by straight sides"/>
<rdf:Description rdf:about="&a;109990063">
	<b:glossaryEntry>a polygon such that no side extended cuts any other side or vertex; it can be cut by a line in at most two points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109990255">
	<b:glossaryEntry>a polygon such that there is a straight line that cuts it in four or more points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109990433"
	 b:glossaryEntry="a polygon with one or more reentrant angles"/>
<rdf:Description rdf:about="&a;109990561"
	 b:glossaryEntry="a polygon with all sides and all angles equal"/>
<rdf:Description rdf:about="&a;109990686"
	 b:glossaryEntry="a shape resulting from distortion"/>
<rdf:Description rdf:about="&a;109990848"
	 b:glossaryEntry="an ill-defined or arbitrary shape"/>
<rdf:Description rdf:about="&a;109990997"
	 b:glossaryEntry="the trace of a point whose direction of motion changes"/>
<rdf:Description rdf:about="&a;109991496">
	<b:glossaryEntry>the curve theoretically assumed by a perfectly flexible and inextensible cord of uniform density and cross section hanging freely from two fixed points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109991702"
	 b:glossaryEntry="an undulating curve"/>
<rdf:Description rdf:about="&a;109991790"
	 b:glossaryEntry="the exterior curve of an arch"/>
<rdf:Description rdf:about="&a;109991874"
	 b:glossaryEntry="something in a thin curved form (like the neck of a goose)"/>
<rdf:Description rdf:about="&a;109991988"
	 b:glossaryEntry="the interior curve of an arch"/>
<rdf:Description rdf:about="&a;109992072">
	<b:glossaryEntry>a circular segment of a curve: "a bend in the road"; "a crook in the path"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109992230"
	 b:glossaryEntry="a sharp curve or crook; a shape resembling a hook"/>
<rdf:Description rdf:about="&a;109992341"
	 b:glossaryEntry="a curve that is tangent to each of a family of curves"/>
<rdf:Description rdf:about="&a;109992449"
	 b:glossaryEntry="a bend in a coastline that forms an open bay"/>
<rdf:Description rdf:about="&a;109992545">
	<b:glossaryEntry>a line traced by a point traveling in a constant direction; a line of zero curvature; "the shortest distance between two points is a straight line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109992950">
	<b:glossaryEntry>(mathematics) the shortest line between two points on a mathematically defined surface (as a straight line on a plane or a an arc of a great circle on a sphere)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109993181"
	 b:glossaryEntry="a straight line at right angles to another line"/>
<rdf:Description rdf:about="&a;109993288"
	 b:glossaryEntry="a connecting shape"/>
<rdf:Description rdf:about="&a;109993418">
	<b:glossaryEntry>a straight line that is the limiting value of a curve; can be considered as tangent at infinity; "the asymptote of the curve"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109993599"
	 b:glossaryEntry="a straight line that touches but does not intersect a curve"/>
<rdf:Description rdf:about="&a;109993712">
	<b:glossaryEntry>a straight line that intersects a curve at two or more points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109993826"
	 b:glossaryEntry="a line enclosing a plane areas"/>
<rdf:Description rdf:about="&a;109993912">
	<b:glossaryEntry>a straight line from the center to the perimeter of a circle (or from the center to the surface of a sphere)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109994073">
	<b:glossaryEntry>a straight line connecting the center of a circle with two points on its perimeter (or the center of a sphere with two points on its surface)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109994269"
	 b:glossaryEntry="a line that bisects a plane figure"/>
<rdf:Description rdf:about="&a;109994374">
	<b:glossaryEntry>a concavity in a surface (especially an anatomical depression)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109994566"
	 b:glossaryEntry="a small concavity"/>
<rdf:Description rdf:about="&a;109994665">
	<b:glossaryEntry>a shape whose base is a cone and whose sides taper up to a point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109994839">
	<b:glossaryEntry>a conical shape with a wider and a narrower opening at the two ends</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109994974">
	<b:glossaryEntry>(geometry) a curve generated by the intersection of a plane and a circular cone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109995193">
	<b:glossaryEntry>a point or set of points common to two or more geometric configurations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109995341">
	<b:glossaryEntry>a plane figure that deviates from a square or circle due to elongation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109995464">
	<b:glossaryEntry>a plane curve generated by one point moving at a constant distance from a fixed point; "he calculated the circumference of the circle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109995724">
	<b:glossaryEntry>something approximating the shape of a circle; "the chairs were arranged in a circle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109995862">
	<b:glossaryEntry>a circle dividing a sphere or other surface into two usually equal and symmetrical parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109996004"
	 b:glossaryEntry="a plane figure with the shape of half a circle"/>
<rdf:Description rdf:about="&a;109996119"
	 b:glossaryEntry="a continuous portion of a circle"/>
<rdf:Description rdf:about="&a;109996239"
	 b:glossaryEntry="a straight line connecting two points on a curve"/>
<rdf:Description rdf:about="&a;109996339">
	<b:glossaryEntry>a plane figure bounded by two radii and the included arc of a circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109996479"
	 b:glossaryEntry="something with a round shape like a flat circular plate"/>
<rdf:Description rdf:about="&a;109996637">
	<b:glossaryEntry>a toroidal shape; "a ring of ships in the harbor"; "a halo of smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109996825">
	<b:glossaryEntry>anything with a round or oval shape that is closed or nearly closed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109996989"
	 b:glossaryEntry="a round shape formed by a series of concentric circles"/>
<rdf:Description rdf:about="&a;109997171">
	<b:glossaryEntry>a plane curve traced by a point circling about the center but at ever-greater distances from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109997319">
	<b:glossaryEntry>a curve that lies on the surface of a cylinder or cone and cuts the element at a constant angle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109997475">
	<b:glossaryEntry>(geometry) a ratio describing the shape of a conic section; the ratio of the distance between the foci to the length of the major axis; "a circle is an ellipse with zero eccentricity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109997717"
	 b:glossaryEntry="a straight line that generates a cylinder or cone"/>
<rdf:Description rdf:about="&a;109997856"
	 b:glossaryEntry="a straight line joining the apex and a point on the base"/>
<rdf:Description rdf:about="&a;109997976"
	 b:glossaryEntry="a straight line running the length of the cylinder"/>
<rdf:Description rdf:about="&a;109998094">
	<b:glossaryEntry>the constant angle at which a helix cuts the elements of a cylinder or cone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109998227">
	<b:glossaryEntry>a sharp bend in a line produced when a line having a loop is pulled tight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109998367"
	 b:glossaryEntry="the shape of something rotating rapidly"/>
<rdf:Description rdf:about="&a;109998489">
	<b:glossaryEntry>a closed plane curve resulting from the intersection of a circular cone and a plane cutting completely through it; "the sums of the distances from the foci to any point on an ellipse is constant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109998745">
	<b:glossaryEntry>(geometry) a plane rectangle with four equal sides and four right angles; a four-sided regular polygon; "you can compute the area of a square if you know the length of its sides"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109999007"
	 b:glossaryEntry="a square-shaped object"/>
<rdf:Description rdf:about="&a;109999084"
	 b:glossaryEntry="a four-sided polygon"/>
<rdf:Description rdf:about="&a;109999242"
	 b:glossaryEntry="a three-sided polygon"/>
<rdf:Description rdf:about="&a;109999484"
	 b:glossaryEntry="a triangle whose interior angles are all acute"/>
<rdf:Description rdf:about="&a;109999615"
	 b:glossaryEntry="a three-sided regular polygon"/>
<rdf:Description rdf:about="&a;109999752"
	 b:glossaryEntry="a triangle with two equal sides"/>
<rdf:Description rdf:about="&a;109999848"
	 b:glossaryEntry="a triangle that contains no right angle"/>
<rdf:Description rdf:about="&a;109999968"
	 b:glossaryEntry="a triangle that contains an obtuse interior angle"/>
<rdf:Description rdf:about="&a;110000104"
	 b:glossaryEntry="a triangle with one right angle"/>
<rdf:Description rdf:about="&a;110000257"
	 b:glossaryEntry="a triangle with no two sides of equal length"/>
<rdf:Description rdf:about="&a;110000364">
	<b:glossaryEntry>a regular polygon formed by completing two equilateral triangles from a regular hexagon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110000506">
	<b:glossaryEntry>a quadrilateral whose opposite sides are both parallel and equal in length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110000712"
	 b:glossaryEntry="(in US) a quadrilateral with no parallel sides"/>
<rdf:Description rdf:about="&a;110000832"
	 b:glossaryEntry="(in US) a quadrilateral with two parallel sides"/>
<rdf:Description rdf:about="&a;110000935">
	<b:glossaryEntry>a plane figure with 5 or more points; often used as an emblem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110001101">
	<b:glossaryEntry>(mineralogy) a six-rayed star-shaped figure seen in some crystal structures under reflected or transmitted light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110001268">
	<b:glossaryEntry>a star with 5 points; formed by 5 straight lines between the vertices of a pentagon and enclosing another pentagon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110001449"
	 b:glossaryEntry="a five-sided polygon"/>
<rdf:Description rdf:about="&a;110001524"
	 b:glossaryEntry="a six-sided polygon"/>
<rdf:Description rdf:about="&a;110001597"
	 b:glossaryEntry="a seven-sided polygon"/>
<rdf:Description rdf:about="&a;110001673"
	 b:glossaryEntry="an eight-sided polygon"/>
<rdf:Description rdf:about="&a;110001749"
	 b:glossaryEntry="a nine-sided polygon"/>
<rdf:Description rdf:about="&a;110001823"
	 b:glossaryEntry="a polygon with 10 sides and 10 angles"/>
<rdf:Description rdf:about="&a;110001914"
	 b:glossaryEntry="an eleven-sided polygon"/>
<rdf:Description rdf:about="&a;110001993"
	 b:glossaryEntry="a twelve-sided polygon"/>
<rdf:Description rdf:about="&a;110002071">
	<b:glossaryEntry>a parallelogram with four equal sides; an oblique-angled equilateral parallelogram</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110002215">
	<b:glossaryEntry>a parallelogram with adjacent sides of unequal lengths; an oblique-angled parallelogram with only the opposite sides equal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110002392"
	 b:glossaryEntry="a parallelogram with four right angles"/>
<rdf:Description rdf:about="&a;110002522"
	 b:glossaryEntry='a rectangular drawing; "the flowchart contained many boxes"'/>
<rdf:Description rdf:about="&a;110002631">
	<b:glossaryEntry>a figure on the surface of of sphere bounded by arcs of 3 or more great circles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110002792"
	 b:glossaryEntry="a spherical polygon formed by the arcs of 3 great circles"/>
<rdf:Description rdf:about="&a;110002914"
	 b:glossaryEntry="a solid figure bounded by plane polygons or faces"/>
<rdf:Description rdf:about="&a;110003272"
	 b:glossaryEntry="a polyhedron any plane section of which is a convex polygon"/>
<rdf:Description rdf:about="&a;110003395">
	<b:glossaryEntry>a polyhedron some of whose plane sections are concave polygons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110003522">
	<b:glossaryEntry>a polyhedron with two congruent and parallel faces (the bases) and whose lateral faces are parallelograms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110003733"
	 b:glossaryEntry="a prism whose bases are parallelograms"/>
<rdf:Description rdf:about="&a;110003923"
	 b:glossaryEntry="a rectangular parallelepiped"/>
<rdf:Description rdf:about="&a;110004004"
	 b:glossaryEntry="a prism whose bases are quadrangles"/>
<rdf:Description rdf:about="&a;110004104"
	 b:glossaryEntry="a prism whose bases are triangles"/>
<rdf:Description rdf:about="&a;110004200"
	 b:glossaryEntry='having curves; "he hated the sinuosity of mountain roads"'/>
<rdf:Description rdf:about="&a;110004327">
	<b:glossaryEntry>a tortuous and twisted shape or position; "they built a tree house in the tortuosities of its boughs"; "the acrobat performed incredible contortions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110004585"
	 b:glossaryEntry="a shape distorted by twisting or folding"/>
<rdf:Description rdf:about="&a;110004685">
	<b:glossaryEntry xml:space='preserve'><![CDATA[something twisted and tight and swollen; "their muscles stood out in knots"; "the old man''s fists were two great gnarls"; "his stomach was in knots"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110004892"
	 b:glossaryEntry="a curved shape in the vertical plane that spans an opening"/>
<rdf:Description rdf:about="&a;110005001"
	 b:glossaryEntry="the shape of a bell"/>
<rdf:Description rdf:about="&a;110005094">
	<b:glossaryEntry>a plane curve formed by the intersection of a right circular cone and a plane parallel to an element of the curve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110005262">
	<b:glossaryEntry>an open curve formed by a plane that cuts the base of a right circular cone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110005393"
	 b:glossaryEntry="a division into two or more branches"/>
<rdf:Description rdf:about="&a;110005528">
	<b:glossaryEntry>an angular shape characterized by sharp turns in alternating directions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110005664">
	<b:glossaryEntry>the space between two lines or planes that intersect; the inclination of one line to another; measured in degrees or radians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110006398">
	<b:glossaryEntry>the angular separation between two objects as perceived by an observer; "he recorded angular distances between the stars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110006672">
	<b:glossaryEntry>(astronomy) the angular distance eastward along the celestial equator from the vernal equinox to the intersection of the hour circle that passes through the body; expressed in hours and minutes and second; used with declination to specify positions on the celestial sphere; "one hour of right ascension equals fifteen degrees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110007087">
	<b:glossaryEntry>(astronomy) the angular distance of a celestial point measured westward along the celestial equator from the zenith crossing; the right ascension for an observer at a particular location and time of day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110007351">
	<b:glossaryEntry>the angular distance of a point in an orbit past the point of periapsis measured in degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110007501"
	 b:glossaryEntry="an angle formed by two straight lines (in the same plane)"/>
<rdf:Description rdf:about="&a;110007616">
	<b:glossaryEntry>an angle formed at the intersection of the arcs of two great circles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110007746">
	<b:glossaryEntry>an angle formed by three or more planes intersecting at a common point (the vertex)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110007887">
	<b:glossaryEntry>(geometry) the angle formed by the x-axis and a given line (measured counterclockwise from the positive half of the x-axis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110008091">
	<b:glossaryEntry>(astronomy) the angle between the plane of the orbit and the plane of the ecliptic stated in degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110008275">
	<b:glossaryEntry>an interior angle of a polygon that is greater than 180 degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110008437">
	<b:glossaryEntry>an angle pointing outward; an interior angle of a polygon that is less than 180 degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110008602"
	 b:glossaryEntry="the angle inside two adjacent sides of a polygon"/>
<rdf:Description rdf:about="&a;110008746"
	 b:glossaryEntry="the supplement of an interior angle of a polygon"/>
<rdf:Description rdf:about="&a;110008872">
	<b:glossaryEntry>the angle that a line makes with a line perpendicular to the surface at the point of incidence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110009085">
	<b:glossaryEntry>the acute angle between the direction of the undisturbed relative wind and the chord of an airfoil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110009245">
	<b:glossaryEntry>the smallest angle of incidence for which light is totally reflected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110009374">
	<b:glossaryEntry>the angle between a reflected ray and a line perpendicular to the reflecting surface at the point of incidence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110009550">
	<b:glossaryEntry>the angle between a refracted ray and a line perpendicular to the surface between the two media at the point of refraction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110009738">
	<b:glossaryEntry>the angle from its axis that a crystal must be rotated before appearing maximally dark when viewed in polarized light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110009940"
	 b:glossaryEntry="an angle less than 90 degrees"/>
<rdf:Description rdf:about="&a;110010027"
	 b:glossaryEntry="an angle between 90 and 180 degrees"/>
<rdf:Description rdf:about="&a;110010121"
	 b:glossaryEntry="the 90 degree angle between two perpendicular lines"/>
<rdf:Description rdf:about="&a;110010248">
	<b:glossaryEntry>an angle that is not a right angle or a multiple of a right angle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110010427"
	 b:glossaryEntry="an angle greater than 180 degrees (but less than 360)"/>
<rdf:Description rdf:about="&a;110010539"
	 b:glossaryEntry="an angle of 360 degrees"/>
<rdf:Description rdf:about="&a;110010630">
	<b:glossaryEntry>the angle between the face of a cutting tool and the surface of the work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110010762">
	<b:glossaryEntry>(physics) the angle that a magnetic needle makes with the plane of the horizon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110010957">
	<b:glossaryEntry>the angle between the direction a gun is aimed and the position of a moving target (correcting for the flight time of the missile)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110011138">
	<b:glossaryEntry>the angle (at a particular location) between magnetic north and true north</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110011300">
	<b:glossaryEntry>the azimuth of a celestial body is the angle between the vertical plane containing it and the plane of the meridian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110011474"
	 b:glossaryEntry="a concave shape with an open top"/>
<rdf:Description rdf:about="&a;110011574">
	<b:glossaryEntry>a long narrow furrow or channel cut by a natural process (such as erosion) or by a tool (as e.g. a groove in a phonograph record)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110011882">
	<b:glossaryEntry>a groove or furrow (especially one in soft earth caused by wheels)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110011998"
	 b:glossaryEntry="a hollow concave shape made by removing something"/>
<rdf:Description rdf:about="&a;110012108"
	 b:glossaryEntry="something that protrudes"/>
<rdf:Description rdf:about="&a;110012369">
	<b:glossaryEntry>a headlike protuberance on an organ or structure; "the caput humeri is the head of the humerus which fits into a cavity in the scapula"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110012556"
	 b:glossaryEntry="a small lump or protuberance"/>
<rdf:Description rdf:about="&a;110012634">
	<b:glossaryEntry>any small rounded protuberance (as on certain plants or animals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110012749"
	 b:glossaryEntry="any thickened enlargement"/>
<rdf:Description rdf:about="&a;110012832">
	<b:glossaryEntry>sculpture in which the figures are raised above a surrounding flat plane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110013044">
	<b:glossaryEntry>a relief in which the figures project only slightly from the surrounding plane surface; no figures are undercut</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110013257"
	 b:glossaryEntry="a sculptural relief between low relief and high relief"/>
<rdf:Description rdf:about="&a;110013401">
	<b:glossaryEntry>a sculptural relief in which more than half of each figure projects out from the surrounding plane surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110013595"
	 b:glossaryEntry="something curved in shape"/>
<rdf:Description rdf:about="&a;110013694">
	<b:glossaryEntry>any shape resembling the curved shape of the moon in its first or last quarters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110013828">
	<b:glossaryEntry>a concavity in a surface produced by pressing; "he left the impression of his fingers in the soft mud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110014154">
	<b:glossaryEntry>any slight depression in a surface; "there are approximately 336 dimples on a golf ball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110014295">
	<b:glossaryEntry>a surface having parabolic sections parallel to a single coordinate axis and elliptic sections perpendicular to that axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110014473">
	<b:glossaryEntry>a surface whose plane sections are all ellipses or circles; "the Earth is an ellipsoid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110014616"
	 b:glossaryEntry="a subfigure consisting of a side of something"/>
<rdf:Description rdf:about="&a;110014749"
	 b:glossaryEntry="the side of a right triangle opposite the right angle"/>
<rdf:Description rdf:about="&a;110014878">
	<b:glossaryEntry>the perpendicular distance from the base of a geometric figure to opposite vertex (or side if parallel)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110015036">
	<b:glossaryEntry>the bottom side of a geometric figure from which the altitude can be constructed; "the base of the triangle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110015195"
	 b:glossaryEntry="equality of distribution"/>
<rdf:Description rdf:about="&a;110015334"
	 b:glossaryEntry="balance among the parts of something"/>
<rdf:Description rdf:about="&a;110015456"
	 b:glossaryEntry="lack of proportion; imbalance among the parts of something"/>
<rdf:Description rdf:about="&a;110015592">
	<b:glossaryEntry>a shape that is generated by rotating an ellipse around one of its axes; "it looked like a sphere but on closer examination I saw it was really a spheroid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110015828">
	<b:glossaryEntry>a three-dimensional closed surface such that every point on the surface is equidistant from the center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110016002"
	 b:glossaryEntry="half of a sphere"/>
<rdf:Description rdf:about="&a;110016075">
	<b:glossaryEntry>a solid figure bounded by a spherical surface (including the space it encloses)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110016225"
	 b:glossaryEntry='any object with a spherical shape; "a ball of fire"'/>
<rdf:Description rdf:about="&a;110016485"
	 b:glossaryEntry="a small sphere"/>
<rdf:Description rdf:about="&a;110016554">
	<b:glossaryEntry>a surface generated by rotating a parallel line around a fixed line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110016820">
	<b:glossaryEntry>a ring-shaped surface generated by rotating a circle around an axis that does not intersect the circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110016983"
	 b:glossaryEntry="the doughnut-shaped object enclosed by a torus"/>
<rdf:Description rdf:about="&a;110017100">
	<b:glossaryEntry>anything tall and thin approximating the shape of a column or tower; "the test tube held a column of white powder"; "a tower of dust rose above the horizon"; "a thin pillar of smoke betrayed their campsite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110017376"
	 b:glossaryEntry="a bulging cylindrical shape; hollow with flat ends"/>
<rdf:Description rdf:about="&a;110017486"
	 b:glossaryEntry="a hollow cylindrical shape"/>
<rdf:Description rdf:about="&a;110017570"
	 b:glossaryEntry="a small sphere"/>
<rdf:Description rdf:about="&a;110017637"
	 b:glossaryEntry="a small round soft mass (as of chewed food)"/>
<rdf:Description rdf:about="&a;110017732">
	<b:glossaryEntry>a shape that is small and round; "he studied the shapes of low-viscosity drops"; "beads of sweat on his forehead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110017947">
	<b:glossaryEntry>anything shaped like a falling drop (as a pendant gem on an earring)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110018070"
	 b:glossaryEntry="any long raised strip"/>
<rdf:Description rdf:about="&a;110018161"
	 b:glossaryEntry="a ridge on a corrugated surface"/>
<rdf:Description rdf:about="&a;110018250"
	 b:glossaryEntry="the shape of a raised edge of a more or less circular object"/>
<rdf:Description rdf:about="&a;110018378">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a V shape; "the cannibal''s teeth were filed to sharp points"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110018689"
	 b:glossaryEntry="a convex shape that narrows toward a point"/>
<rdf:Description rdf:about="&a;110018783">
	<b:glossaryEntry>a curve or surface whose equation (in Cartesian coordinates) is of the second degree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110018921"
	 b:glossaryEntry="a line determining the limits of an area"/>
<rdf:Description rdf:about="&a;110019175">
	<b:glossaryEntry>the boundary line or the area immediately inside the boundary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110019310"
	 b:glossaryEntry="the outside boundary or surface of something"/>
<rdf:Description rdf:about="&a;110019436"
	 b:glossaryEntry="a region marking a boundary"/>
<rdf:Description rdf:about="&a;110019535"
	 b:glossaryEntry="an international boundary or the area along such a boundary"/>
<rdf:Description rdf:about="&a;110019649">
	<b:glossaryEntry>(mathematics) a number equal to or greater than any other number in a given set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110019804">
	<b:glossaryEntry>(mathematics) a number equal to or less than any other number in a given set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110019938"
	 b:glossaryEntry='the uppermost part of a shape; "at the peak of the pyramid"'/>
<rdf:Description rdf:about="&a;110020065"
	 b:glossaryEntry="a straight line that is not at right angles to a side"/>
<rdf:Description rdf:about="&a;110020180">
	<b:glossaryEntry>a depression in an otherwise level surface; "there was a dip in the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110020303">
	<b:glossaryEntry>any cup-shaped concavity; "bees filled the waxen cups with honey"; "he wore a jock strap with a metal cup"; "the cup of her bra"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110020481"
	 b:glossaryEntry="a depression scratched or carved into a surface"/>
<rdf:Description rdf:about="&a;110020641"
	 b:glossaryEntry="a notch that is made to keep a tally"/>
<rdf:Description rdf:about="&a;110020729"
	 b:glossaryEntry='a shape that sags; "there was a sag in the chair seat"'/>
<rdf:Description rdf:about="&a;110020841">
	<b:glossaryEntry>a slight depression in the smoothness of a surface; "His face has many wrinkles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110021108"
	 b:glossaryEntry="a wrinkle at the outer corner of your eyes"/>
<rdf:Description rdf:about="&a;110021235">
	<b:glossaryEntry>a crease on the palm; its length is said by palmists to indicate how long you will live</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110021404">
	<b:glossaryEntry>a crease on the palm; palmists say it indicates your emotional nature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110021572">
	<b:glossaryEntry>a crease on the palm; palmists say it indicates how successful you will be</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110021740"
	 b:glossaryEntry="a long narrow depression in a surface"/>
<rdf:Description rdf:about="&a;110021865"
	 b:glossaryEntry="an angular shape made by folding"/>
<rdf:Description rdf:about="&a;110022048"
	 b:glossaryEntry="an irregular fold in an otherwise even surface"/>
<rdf:Description rdf:about="&a;110022147"
	 b:glossaryEntry="a concave shape in a surface or edge or coastline etc."/>
<rdf:Description rdf:about="&a;110022307"
	 b:glossaryEntry="a split or indentation in something (as the palate or chin)"/>
<rdf:Description rdf:about="&a;110022418">
	<b:glossaryEntry>any of a number of tiny parallel grooves such as: the scratches left by a glacier on rocks or the streaks or ridges in muscle tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110022614">
	<b:glossaryEntry>a line generated by a point on one figure rolling around a second figure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110022811">
	<b:glossaryEntry>a line generated by a point on a circle rolling along a straight line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110022970"
	 b:glossaryEntry="a cycloid generated by a point inside the rolling circle"/>
<rdf:Description rdf:about="&a;110023087"
	 b:glossaryEntry="a cycloid generated by a point outside the rolling circle"/>
<rdf:Description rdf:about="&a;110023206"
	 b:glossaryEntry="the curve of y=sin x"/>
<rdf:Description rdf:about="&a;110023294">
	<b:glossaryEntry>a circle that rolls around (inside or outside) another circle; generates an epicycloid or hypocycloid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110023450">
	<b:glossaryEntry>a line generated by a point on a circle rolling around another circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110023594">
	<b:glossaryEntry>an epicycloid in which the rolling circle equals the fixed circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110023714">
	<b:glossaryEntry>a line generated by a point on a circle that rolls around inside another circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110023851"
	 b:glossaryEntry='an amorphous or indefinite shape; "a shapeless mass"'/>
<rdf:Description rdf:about="&a;110023963"
	 b:glossaryEntry="an indistinct shapeless form"/>
<rdf:Description rdf:about="&a;110024042">
	<b:glossaryEntry>an empty area or space; "the huge desert voids"; "the emptiness of outer space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110024194">
	<b:glossaryEntry>an empty area (usually bounded in some way between things); "the architect left space in front of the building"; "they stopped at an open space in the jungle"; "the space between his teeth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110024561">
	<b:glossaryEntry>a cavity or space in something; "hunger had caused the hollows in their cheeks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110024693"
	 b:glossaryEntry="a connecting point at which several lines come together"/>
<rdf:Description rdf:about="&a;110024799">
	<b:glossaryEntry>the shape or manner in which things come together and a connection is made</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110024987"
	 b:glossaryEntry="an unoccupied space"/>
<rdf:Description rdf:about="&a;110025075"
	 b:glossaryEntry="space that is surrounded by something"/>
<rdf:Description rdf:about="&a;110025218">
	<b:glossaryEntry>a very small circular shape; "a row of points"; "draw lines between the dots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110025353"
	 b:glossaryEntry="any tiny hole admitting passage of a liquid (fluid or gas)"/>
<rdf:Description rdf:about="&a;110025462">
	<b:glossaryEntry>a figure that branches from a single root; "genealogical tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110025608"
	 b:glossaryEntry="a tree diagram used to illustrate phylogenetic relationships"/>
<rdf:Description rdf:about="&a;110025724">
	<b:glossaryEntry>the middle of the chief navigable channel of a waterway that forms the boundary line between states</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110025877"
	 b:glossaryEntry="any pointed projection"/>
<rdf:Description rdf:about="&a;110025958"
	 b:glossaryEntry="a narrowing that reduces the flow through a channel"/>
<rdf:Description rdf:about="&a;110026081"
	 b:glossaryEntry="a smooth surface (as of a bone or cut gemstone)"/>
<rdf:Description rdf:about="&a;110026180">
	<b:glossaryEntry>a straight line segment whose length is magnitude and whose orientation in space is direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110026344"
	 b:glossaryEntry="(mathematics) a straight line extending from a point"/>
<rdf:Description rdf:about="&a;110026446">
	<b:glossaryEntry>the distinctive form in which a thing is made; "pottery of this cast was found throughout the region"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110026613">
	<b:glossaryEntry>a part of a forked or branching shape; "he broke off one of the branches"; "they took the south fork"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110026817"
	 b:glossaryEntry="(biology) a branching or armlike part of an animal"/>
<rdf:Description rdf:about="&a;110026922"
	 b:glossaryEntry="an enclosed space"/>
<rdf:Description rdf:about="&a;110027013">
	<b:glossaryEntry>a three-dimensional shape with six square or rectangular sides</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110027152">
	<b:glossaryEntry>a polyhedron having a polygonal base and triangular sides with a common vertex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110027284"
	 b:glossaryEntry="an egg-shaped object"/>
<rdf:Description rdf:about="&a;110027356"
	 b:glossaryEntry="any polyhedron having four plane faces"/>
<rdf:Description rdf:about="&a;110027452"
	 b:glossaryEntry="any polyhedron having five plane faces"/>
<rdf:Description rdf:about="&a;110027548"
	 b:glossaryEntry="any polyhedron having six plane faces"/>
<rdf:Description rdf:about="&a;110027660">
	<b:glossaryEntry>a parallelepiped bounded by six similar faces (either rhombuses or parallelograms)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110027819"
	 b:glossaryEntry="any polyhedron having eight plane faces"/>
<rdf:Description rdf:about="&a;110027915"
	 b:glossaryEntry="any polyhedron having ten plane faces"/>
<rdf:Description rdf:about="&a;110028009"
	 b:glossaryEntry="any polyhedron having twelve plane faces"/>
<rdf:Description rdf:about="&a;110028108"
	 b:glossaryEntry="any polyhedron having twenty plane faces"/>
<rdf:Description rdf:about="&a;110028206">
	<b:glossaryEntry>any one of five solids whose faces are congruent regular polygons and whose polyhedral angles are all congruent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110028570">
	<b:glossaryEntry>the space enclosed by three or more planes that intersect in a vertex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110028702"
	 b:glossaryEntry="the angle formed by two edges of a polyhedral angle"/>
<rdf:Description rdf:about="&a;110028810"
	 b:glossaryEntry="a tetrahedron with four equilateral triangular faces"/>
<rdf:Description rdf:about="&a;110028928"
	 b:glossaryEntry="a hexahedron with six equal squares as faces"/>
<rdf:Description rdf:about="&a;110029062"
	 b:glossaryEntry="a cubelike object"/>
<rdf:Description rdf:about="&a;110029134"
	 b:glossaryEntry="a dodecahedron with twelve regular pentagons as faces"/>
<rdf:Description rdf:about="&a;110029254"
	 b:glossaryEntry="an octahedron with eight equilateral triangles as faces"/>
<rdf:Description rdf:about="&a;110029374"
	 b:glossaryEntry="an icosahedron with twenty equilateral triangles as faces"/>
<rdf:Description rdf:about="&a;110029497">
	<b:glossaryEntry>a solid bounded by a cylindrical surface and two parallel planes (the bases)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110029664">
	<b:glossaryEntry>the part that is left when a cone or pyramid is cut by a plane parallel to the base and the apical part is removed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110029868"
	 b:glossaryEntry="a frustum formed from a pyramid"/>
<rdf:Description rdf:about="&a;110029963"
	 b:glossaryEntry="a frustum formed from a cone"/>
<rdf:Description rdf:about="&a;110030052">
	<b:glossaryEntry>a polyhedron whose vertices all lie in one or the other of two parallel planes; the faces that lie in those planes are the bases of the prismatoid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110030273">
	<b:glossaryEntry>a prismatoid whose bases are polygons having the same number of sides and whose other faces are trapezoids or parallelograms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110030452"
	 b:glossaryEntry="any projection that resembles the tail of an animal"/>
<rdf:Description rdf:about="&a;110030565">
	<b:glossaryEntry>any long thin projection that is transient; "tongues of flame licked at the walls"; "rifles exploded quick knives of fire into the dark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110030762">
	<b:glossaryEntry>the angle a rocket makes with the vertical as it curves along its trajectory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110030895"
	 b:glossaryEntry="a polyhedron whose faces are trapeziums"/>
<rdf:Description rdf:about="&a;110030994">
	<b:glossaryEntry>either of two equal and opposite angles formed by the intersection of two straight lines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110031143"
	 b:glossaryEntry="a whorl of leaves growing around a stem"/>
<rdf:Description rdf:about="&a;110031237"
	 b:glossaryEntry="the angle included by a photographic lens"/>
<rdf:Description rdf:about="&a;110031351">
	<b:glossaryEntry>the angle of arrival (or departure) of a radio wave with respect to the axis of an antenna array</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110031504"
	 b:glossaryEntry="any shape that is triangular in cross section"/>
<rdf:Description rdf:about="&a;110031624"
	 b:glossaryEntry="any solid convex shape that juts out from something"/>
<rdf:Description rdf:about="&a;110031804">
	<b:glossaryEntry>a state that is intermediate between extremes; a middle position; "a happy medium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110031939">
	<b:glossaryEntry>a mode of being or form of existence of a person or things: "the human condition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110032130">
	<b:glossaryEntry>a condition or state at a particular time: "a condition (or state) of disrepair"; "the current status of the arms negotiations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110033564"
	 b:glossaryEntry="the state of being conditional"/>
<rdf:Description rdf:about="&a;110033655">
	<b:glossaryEntry>(ecology) the status of an organism within its environment and community (affecting its survival as a species)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110033817">
	<b:glossaryEntry>the state of being silent (as when no one is speaking); "there was a shocked silence": "he gestured for silence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110033983"
	 b:glossaryEntry="the condition of being noisy (as in a communication channel)"/>
<rdf:Description rdf:about="&a;110034106"
	 b:glossaryEntry="the amount and state of snow for skiing"/>
<rdf:Description rdf:about="&a;110034206"
	 b:glossaryEntry="the condition of the weather"/>
<rdf:Description rdf:about="&a;110034299">
	<b:glossaryEntry>a condition or position in which you find yourself: "the unpleasant situation (or position) of having to choose between two evils"; "found herself in a very fortunate situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110034597">
	<b:glossaryEntry>a position particularly well suited to the person who occupies it; "he found his niche in the academic world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110034758">
	<b:glossaryEntry>a particular situation: "If you were in my place what would you do?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110034886">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) an unfortunate situation; "we''re in the soup now"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110034997">
	<b:glossaryEntry>a situation in golf where an opponent''s ball blocks the line between your ball and the hole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110035141">
	<b:glossaryEntry>the general state of things; the combination of circumstances at a given time; "the present international situation is dangerous"; "wondered how such a state of affairs had come about"; "eternal truths will be neither true nor eternal unless they have fresh meaning for every new social situation"- Franklin D.Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110036039">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a state of connectedness between people (especially an emotional connection); "he didn''t want his wife to know of the relationship"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110036283">
	<b:glossaryEntry>a state involving mutual dealings between people or parties or countries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110036540">
	<b:glossaryEntry>a formal contractual relationship established to provide for regular banking or brokerage or business services; "he asked to see the executive who handled his account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110036839">
	<b:glossaryEntry>a brokerage account of someone who sells short (sells securities he does not own)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110036980"
	 b:glossaryEntry="the friendship characteristic of blood brothers"/>
<rdf:Description rdf:about="&a;110037091">
	<b:glossaryEntry>the state of being with someone; "he missed their company"; "he enjoyed the society of his friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110037333">
	<b:glossaryEntry>a trustful relationship; "he took me into his confidence"; "he betrayed their trust"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110037482">
	<b:glossaryEntry>a natural or instinctive fellowship between people of similar interests: "he enjoyed the freemasonry of the Press"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110037654"
	 b:glossaryEntry="a relationship less intimate than friendship"/>
<rdf:Description rdf:about="&a;110037776">
	<b:glossaryEntry>a social or business relationship: "a valuable financial affiliation"; "he was sorry he had to sever his ties with other members of the team"; "many close associations with England"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110038044">
	<b:glossaryEntry>(psychoanalysis) relationship marked by strong dependence on others; especially a libidinal attachment to e.g. a parental figure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110038228"
	 b:glossaryEntry="the state of being assimilated"/>
<rdf:Description rdf:about="&a;110038317"
	 b:glossaryEntry="the state of being friends"/>
<rdf:Description rdf:about="&a;110038478"
	 b:glossaryEntry="a clandestine love affair"/>
<rdf:Description rdf:about="&a;110038558"
	 b:glossaryEntry="a relationship between two lovers"/>
<rdf:Description rdf:about="&a;110038677"
	 b:glossaryEntry="the state of being a member"/>
<rdf:Description rdf:about="&a;110038761"
	 b:glossaryEntry="a relationship involving sexual intimacy"/>
<rdf:Description rdf:about="&a;110038885"
	 b:glossaryEntry="a usually secretive or illicit sexual relationship"/>
<rdf:Description rdf:about="&a;110039041">
	<b:glossaryEntry>ideally perfect state; especially in its social and political and moral aspects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110039227">
	<b:glossaryEntry>state in which the condition of life is extremely bad as from deprivation or oppression or terror</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110039397">
	<b:glossaryEntry>the state of being acceptable and accepted; "torn jeans received no acceptance at the country club"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110039715">
	<b:glossaryEntry>a demanding or stimulating situation; "they reacted irrationally to the challenge of Russian power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110039870"
	 b:glossaryEntry="the condition of being without offspring"/>
<rdf:Description rdf:about="&a;110039970">
	<b:glossaryEntry>a situation or condition that is complex or confused: "her coming was a serious complication"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110040122">
	<b:glossaryEntry>a situation in which a public official''s decisions are influenced by the official''s personal interests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110040291">
	<b:glossaryEntry>an unstable situation of extreme danger or difficulty; "they went bankrupt during the economic crisis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110040518"
	 b:glossaryEntry="an unstable situation in which some forces outweigh others"/>
<rdf:Description rdf:about="&a;110040673">
	<b:glossaryEntry>the situation in which you are happiest and most effective; "in your element"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110040804">
	<b:glossaryEntry>the totality of surrounding conditions; "he longed for the comfortable environment of his livingroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110041089"
	 b:glossaryEntry="a stable situation in which forces cancel one another"/>
<rdf:Description rdf:about="&a;110041308"
	 b:glossaryEntry="the state of being excluded"/>
<rdf:Description rdf:about="&a;110041445">
	<b:glossaryEntry>a situation that is ideal for rapid development (especially of something bad); "it was a hotbed of vice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110041602">
	<b:glossaryEntry>a difficult situation; "he dropped the topic like a hot potato"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110041722">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an awkward situation; "that''s a fine how-d''ye-do"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110041845">
	<b:glossaryEntry>an intricate and confusing interpersonal or political situation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110041978"
	 b:glossaryEntry="the state of being included"/>
<rdf:Description rdf:about="&a;110042115"
	 b:glossaryEntry="a situation resembling a terrifying dream"/>
<rdf:Description rdf:about="&a;110042222"
	 b:glossaryEntry="a bad or difficult situation or state of affairs"/>
<rdf:Description rdf:about="&a;110042358">
	<b:glossaryEntry>a situation treated as an observable object; "the political picture is favorable" or "the religious scene in England has changed in the last century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110042569"
	 b:glossaryEntry="a prisonlike situation; a place of seeming confinement"/>
<rdf:Description rdf:about="&a;110042691">
	<b:glossaryEntry>a temporary condition of torment or suffering: "a purgatory of drug abuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110042821"
	 b:glossaryEntry="the state of being rejected"/>
<rdf:Description rdf:about="&a;110042976">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) the actual state of affairs; "that''s the size of the situation"; "she hates me, that''s about the size of it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110043159"
	 b:glossaryEntry="the existing state of affairs"/>
<rdf:Description rdf:about="&a;110043245">
	<b:glossaryEntry>a situation fraught with difficulties and imponderables; "he was trapped in a medical swamp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110043389">
	<b:glossaryEntry>(chemistry) the state in which a substance contains no multiple bonds and thus is incapable of undergoing additional reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110043572">
	<b:glossaryEntry>(optics) condition of an optical system (as a lens) in which light rays from a single point converge in a single focal point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110043771">
	<b:glossaryEntry>(optics) defect in an optical system in which light rays from a single point fail to converge in a single focal point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110043975"
	 b:glossaryEntry="the condition of being arranged in social strata or classes"/>
<rdf:Description rdf:about="&a;110044119">
	<b:glossaryEntry>a wild primitive state untouched by civilization; "he lived in the wild"; "they tried to preserve nature as they found it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110044353">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the condition of things generally; "that''s the way it is" or "I felt the same way"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110044485">
	<b:glossaryEntry>the state of being an isomer; the complex of chemical and physical phenomena characteristic of isomers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110044643">
	<b:glossaryEntry>a specific identifiable position in a continuum or series or especially in a process; "a remarkable degree of frankness"; "at what stage are the social sciences?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110045044">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the highest level or degree attainable: "his landscapes were deemed the acme of beauty"; "the artist''s gifts are at their acme"; "at the height of her career"; "the peak of perfection"; "summer was at its peak"; "...catapulted Einstein to the pinnacle of fame"; "the summit of his ambition"; "so many highest superlatives achieved by man"; "at the top of his profession"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110045533">
	<b:glossaryEntry>the point or degree to which something extends; "the extent of the damage"; "the full extent of the law"; "a mistake would have to that extent let the whole world know"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110045754"
	 b:glossaryEntry="the final point in a process"/>
<rdf:Description rdf:about="&a;110045850">
	<b:glossaryEntry>a level of material comfort in terms of goods and services available to someone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110046013">
	<b:glossaryEntry>a level of existence or development; "he lived on a worldly plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110046131">
	<b:glossaryEntry>the highest degree of development of an art or technique at a particular time; "the state of the art in space travel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110046311">
	<b:glossaryEntry>the state or degree of being ultimate; the final or most extreme in degree or size or time or distance: "the ultimacy of these social values"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110046558"
	 b:glossaryEntry='the greatest or utmost degree: "the extremity of despair"'/>
<rdf:Description rdf:about="&a;110046671">
	<b:glossaryEntry>the expected or commonplace condition or situation: "not out of the ordinary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110046803">
	<b:glossaryEntry>a condition that accompanies or influences some event or activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110046963">
	<b:glossaryEntry>the state or condition of having no home (especially the state of living in the streets)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110047128">
	<b:glossaryEntry>the state of wandering from place to place; having no permanent home or means of livelihood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110047274">
	<b:glossaryEntry>a special set of circumstances; "in that event, the first possibility is excluded"; "it may rain in which case the picnic will be canceled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110047472">
	<b:glossaryEntry>a circumstance upon which subsequent events depend; "his absence is the hinge of our plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110047614">
	<b:glossaryEntry>a special situation; "this thing has got to end"; "it is a remarkable thing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110047742">
	<b:glossaryEntry>a dangerous state of affairs; a situation that is a potential source of violence; "the Balkans are the tinderbox of Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110047921">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a situation in which people or things are crowded together; "he didn''t like the crowding on the beach"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110048096"
	 b:glossaryEntry='excessive crowding; "traffic congestion"'/>
<rdf:Description rdf:about="&a;110048209">
	<b:glossaryEntry>the condition of being reinstated; "her reinstatement to her former office followed quickly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110048361">
	<b:glossaryEntry>(of a government or government official) holding an office means being in power; "being in office already gives a candidate a great advantage"; "during his first year in power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110048616">
	<b:glossaryEntry>the power (usually of a president or governor) to pardon or commute the sentence of someone convicted in that jurisdiction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110048803">
	<b:glossaryEntry>the relative position or standing of things or especially persons in a society: "he had the status of a minor"; "the novel attained the status of a classic"; "atheists do not enjoy a favorable position in American life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110049536">
	<b:glossaryEntry>a state of essential equality or equivalence: "on a par with the best"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110049681">
	<b:glossaryEntry>position in a social hierarchy; "the British are more aware of social status than Americans are"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110049911">
	<b:glossaryEntry>proper or designated social situation: "he overstepped his place"; "the responsibilities of a man in his station"; "married above her station"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110050133">
	<b:glossaryEntry xml:space='preserve'><![CDATA[proper or appropriate position or location; "a woman''s place is no longer in the kitchen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110050274"
	 b:glossaryEntry='high social status; "a man of quality"'/>
<rdf:Description rdf:about="&a;110050366">
	<b:glossaryEntry>social or financial or professional status or reputation: "of equal standing"; "a member in good standing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110050671"
	 b:glossaryEntry="of superior status"/>
<rdf:Description rdf:about="&a;110050855">
	<b:glossaryEntry>the status of being acknowledged as a star: "stardom meant nothing to her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110050983">
	<b:glossaryEntry>the status of being a champion; "he held the title for two years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110051151">
	<b:glossaryEntry>(baseball) an unofficial title won by a batter who leads the league in hitting average and runs batted in and home runs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110051329">
	<b:glossaryEntry>(horse racing) a title won by a horse that can win the Kentucky Derby and the Belmont Stakes and the Preakness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110051498">
	<b:glossaryEntry>higher rank than that of others especially by reason of longer service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110051706">
	<b:glossaryEntry xml:space='preserve'><![CDATA[status established in order of importance or urgency: "...its precedence as the world''s leading manufacturer of pharmaceuticals"; "national independence takes priority over class struggle"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110051975">
	<b:glossaryEntry>the state of excelling or surpassing or going beyond usual limits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110052131"
	 b:glossaryEntry="of inferior status"/>
<rdf:Description rdf:about="&a;110052242"
	 b:glossaryEntry="the state of being inferior"/>
<rdf:Description rdf:about="&a;110052391"
	 b:glossaryEntry="secondary importance"/>
<rdf:Description rdf:about="&a;110052560">
	<b:glossaryEntry>a secondary or inferior position or status: "tennis has had to take a backseat while his work is so demanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110052725">
	<b:glossaryEntry>in a subordinate position; "theology should be the handmaiden of ethics"; "the state cannot be a servant of the church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110052922"
	 b:glossaryEntry="in a junior position"/>
<rdf:Description rdf:about="&a;110053002"
	 b:glossaryEntry="in a secondary position"/>
<rdf:Description rdf:about="&a;110053085"
	 b:glossaryEntry="in a subservient state"/>
<rdf:Description rdf:about="&a;110053184"
	 b:glossaryEntry="a status defined by law"/>
<rdf:Description rdf:about="&a;110053320"
	 b:glossaryEntry="the legal status or condition of a villein or feudal serf"/>
<rdf:Description rdf:about="&a;110053447"
	 b:glossaryEntry="the status of being born to parents who were not married"/>
<rdf:Description rdf:about="&a;110053588"
	 b:glossaryEntry="the status of a citizen with rights and duties"/>
<rdf:Description rdf:about="&a;110053692">
	<b:glossaryEntry>a position of highest authority; "the corporation has just undergone a change in command"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110053835">
	<b:glossaryEntry>the status of belonging to a particular nation by birth or naturalization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110053966">
	<b:glossaryEntry>status with respect to the relations between people or groups: "on good terms with her in-laws"; "on a friendly footing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110054148">
	<b:glossaryEntry>the state of being retired from one''s business or occupation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110054265">
	<b:glossaryEntry>the state or fact of existing: "a point of view gradually coming into being"; "laws in existence for centuries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110054722">
	<b:glossaryEntry>the state of actually existing objectively: "a hope that progressed from possibility to actuality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110054966">
	<b:glossaryEntry>the state of being actual or real: "the reality of his situation slowly dawned on him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110055199">
	<b:glossaryEntry>an event known to have happened or something known to have existed; "your fears have no basis in fact"; "how much of the story is fact and how much fiction is hard to tell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110055422">
	<b:glossaryEntry>the state of the world as it really is rather than as you might want it to be; "businessmen have to face harsh realities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110055615"
	 b:glossaryEntry="the state of having in fact existed in the past"/>
<rdf:Description rdf:about="&a;110055723">
	<b:glossaryEntry>conformity to reality or actuality; "they debated the truth of the proposition"; "the situation brought home to us the blunt truth of the military threat"; "he was famous for the truth of his portraits"; "he turned to religion in his search for eternal verities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110056100"
	 b:glossaryEntry="the state of being genuine"/>
<rdf:Description rdf:about="&a;110056202">
	<b:glossaryEntry>a state of eternal existence believed in some religions to characterize the afterlife</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110056378"
	 b:glossaryEntry="existing in a former state or previous to something else"/>
<rdf:Description rdf:about="&a;110056493"
	 b:glossaryEntry="existing peacefully together"/>
<rdf:Description rdf:about="&a;110056579"
	 b:glossaryEntry="life without beginning or end"/>
<rdf:Description rdf:about="&a;110056682"
	 b:glossaryEntry="the state of existing in reality; having substance"/>
<rdf:Description rdf:about="&a;110056790">
	<b:glossaryEntry>the state of being present; current existence; "he tested for the presence of radon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110057109"
	 b:glossaryEntry="the state of being within or not going beyond a given domain"/>
<rdf:Description rdf:about="&a;110057249"
	 b:glossaryEntry="the state of existing and being localized in space"/>
<rdf:Description rdf:about="&a;110057352">
	<b:glossaryEntry>the state of being everywhere at once (or seeming to be everywhere at once)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110057514"
	 b:glossaryEntry="the state of being here in this place"/>
<rdf:Description rdf:about="&a;110057624"
	 b:glossaryEntry="the state of being there--not here--in position"/>
<rdf:Description rdf:about="&a;110057745">
	<b:glossaryEntry>real existence; "things are really there...capture the thereness of them"--Charles Hopkinson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110057893">
	<b:glossaryEntry>an instance of something occurring; "a disease of frequent occurrence"; "the occurrence (or presence) of life on other planets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110058077"
	 b:glossaryEntry="the state of not being"/>
<rdf:Description rdf:about="&a;110058190"
	 b:glossaryEntry="the state of not existing"/>
<rdf:Description rdf:about="&a;110058346">
	<b:glossaryEntry>the state of being insubstantial or imaginary; not existing objectively or in fact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110058550"
	 b:glossaryEntry='out of touch with reality; "his head was in the clouds"'/>
<rdf:Description rdf:about="&a;110058657">
	<b:glossaryEntry>the state of being false or untrue; "argument could not determine its truth or falsity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110058846"
	 b:glossaryEntry="state of lacking genuineness"/>
<rdf:Description rdf:about="&a;110058951">
	<b:glossaryEntry>the state of being absent; "he was surprised by the absence of any explanation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110059138"
	 b:glossaryEntry="absence by virtue of not occurring"/>
<rdf:Description rdf:about="&a;110059232"
	 b:glossaryEntry="the state of being elsewhere than in particular place"/>
<rdf:Description rdf:about="&a;110059340">
	<b:glossaryEntry>the course of existence of an individual; the actions and events that occur in living; "he hoped for a new life in Australia"; "he wanted to live his own life without interference from others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110059583">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the condition of living or the state of being alive; "while there''s life there''s hope"; "life depends on many chemical and physical processes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110059899">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a person''s skin regarded as their life; "he tried to save his skin"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110060017"
	 b:glossaryEntry="a state of surviving; remaining alive"/>
<rdf:Description rdf:about="&a;110060139">
	<b:glossaryEntry>a means of surviving; "farming is a hard means of subsistence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110060259">
	<b:glossaryEntry>the absence of life or state of being dead; "he seemed more content in death than he had ever been in life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110060454">
	<b:glossaryEntry>euphemisms for death (based on an analogy between lying in a bed and in a tomb); "she was laid to rest beside her husband"; "they had to put their family pet to sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110060721"
	 b:glossaryEntry='no longer in existence; "the extinction of a species"'/>
<rdf:Description rdf:about="&a;110060845">
	<b:glossaryEntry>a characteristic state or mode of living; "social life"; "city life"; "real life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110060977">
	<b:glossaryEntry>a state of being or existence above and beyond the limits of material experience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110061133"
	 b:glossaryEntry="the condition of being married or unmarried"/>
<rdf:Description rdf:about="&a;110061309">
	<b:glossaryEntry>state of being husband and wife; "a long and happy marriage"; "God bless this union"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110061658"
	 b:glossaryEntry="having more than one spouse at a time"/>
<rdf:Description rdf:about="&a;110061748">
	<b:glossaryEntry>a marriage relationship created by agreement and cohabitation rather than by ceremony</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110061899">
	<b:glossaryEntry>marriage within one''s own tribe or group as required by custom or law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110062052">
	<b:glossaryEntry>marriage to a person belonging to a tribe or group other than your own as required by custom or law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110062221"
	 b:glossaryEntry="a marriage for expediency rather than love"/>
<rdf:Description rdf:about="&a;110062333"
	 b:glossaryEntry="an unsuitable marriage"/>
<rdf:Description rdf:about="&a;110062431"
	 b:glossaryEntry="a marriage with a person of inferior social status"/>
<rdf:Description rdf:about="&a;110062539"
	 b:glossaryEntry="having one husband at a time"/>
<rdf:Description rdf:about="&a;110062622"
	 b:glossaryEntry="having one wife at a time"/>
<rdf:Description rdf:about="&a;110062730"
	 b:glossaryEntry="having more than one husband at a time"/>
<rdf:Description rdf:about="&a;110062824"
	 b:glossaryEntry="having more than one wife at a time"/>
<rdf:Description rdf:about="&a;110062925"
	 b:glossaryEntry="an unmarried status (as because of religious vows)"/>
<rdf:Description rdf:about="&a;110063030"
	 b:glossaryEntry="the condition or quality of being a virgin"/>
<rdf:Description rdf:about="&a;110063146"
	 b:glossaryEntry="the state of being an unmarried man"/>
<rdf:Description rdf:about="&a;110063240">
	<b:glossaryEntry>the state of being a spinster (usually an elderly unmarried woman)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110063365"
	 b:glossaryEntry="the state of being a widow who has not remarried"/>
<rdf:Description rdf:about="&a;110063469">
	<b:glossaryEntry>the state of being employed or having a job; "they are looking for employment"; "he was in the employ of the city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110063667">
	<b:glossaryEntry>the state of being unemployed or not having a job: "unemployment is a serious social evil"; "the rate of unemployment is an indicator of the health of an economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110063906">
	<b:glossaryEntry>established customary state esp. of society; "order ruled in the streets"; "law and order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110064174"
	 b:glossaryEntry="the form of government of a social organization"/>
<rdf:Description rdf:about="&a;110064288"
	 b:glossaryEntry="a state of order in which events conform to the law"/>
<rdf:Description rdf:about="&a;110064397"
	 b:glossaryEntry="an untroubled state; free from disturbances"/>
<rdf:Description rdf:about="&a;110064507">
	<b:glossaryEntry>a harmonious state; congruity of parts with one another and with the whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110064713">
	<b:glossaryEntry>harmonious relations; freedom from disputes; "the roommates lived in peace together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110064849">
	<b:glossaryEntry>a state or atmosphere of harmony or mutual civility and respect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110064983">
	<b:glossaryEntry>courteous respect by one nation for the laws and institutions of another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110065119"
	 b:glossaryEntry="a stable order"/>
<rdf:Description rdf:about="&a;110065207"
	 b:glossaryEntry="the state prevailing during the absence of war"/>
<rdf:Description rdf:about="&a;110065395"
	 b:glossaryEntry="a state of friendship and cordiality"/>
<rdf:Description rdf:about="&a;110065501"
	 b:glossaryEntry="a state that is calm and tranquil"/>
<rdf:Description rdf:about="&a;110065609">
	<b:glossaryEntry>a state of peace agreed to between opponents so they can discuss peace terms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110065762">
	<b:glossaryEntry xml:space='preserve'><![CDATA[harmony of people''s opinions or actions or characters; "the two parties were in accord"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110066040">
	<b:glossaryEntry>agreement as to goals; "the preachers and the bootleggers found they had a community of interests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110066219"
	 b:glossaryEntry="a state of cooperation"/>
<rdf:Description rdf:about="&a;110066318"
	 b:glossaryEntry="agreement of the majority in sentiment or belief"/>
<rdf:Description rdf:about="&a;110066460">
	<b:glossaryEntry>the opinion held by the majority of those present at the meeting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110066591"
	 b:glossaryEntry="everyone being of one mind"/>
<rdf:Description rdf:about="&a;110066673"
	 b:glossaryEntry='corresponding exactly: "marching in unison"'/>
<rdf:Description rdf:about="&a;110066769">
	<b:glossaryEntry>an implicit agreement among people that results in the organization of society; individual surrenders liberty in return for protection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110066965"
	 b:glossaryEntry="a disturbance of the peace or of public order"/>
<rdf:Description rdf:about="&a;110067245">
	<b:glossaryEntry>a state of lawlessness and disorder (usually resulting from a failure of government)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110067415">
	<b:glossaryEntry>complete denial of all established authority and institutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110067531"
	 b:glossaryEntry="a disorder of the immune system"/>
<rdf:Description rdf:about="&a;110067721">
	<b:glossaryEntry>lowering the body''s normal immune response to invasion by foreign substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110067861"
	 b:glossaryEntry="an unstable order"/>
<rdf:Description rdf:about="&a;110067954">
	<b:glossaryEntry>disorder resulting from a failure to behave predictably; "the army retreated in confusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110068190">
	<b:glossaryEntry>a state of disorder and confusion; "his inconsistency resulted in the demoralization of his staff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110068349"
	 b:glossaryEntry="a confusion of voices and other sounds"/>
<rdf:Description rdf:about="&a;110068439">
	<b:glossaryEntry>noisy confusion and turbulence; "he was awakened by the bluster of their preparations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110068579"
	 b:glossaryEntry="a state of extreme confusion and disorder"/>
<rdf:Description rdf:about="&a;110068748">
	<b:glossaryEntry>a word for chaos or fiasco borrowed from modern Hebrew (where it is a loan word from Russian); "it was utter and complete balagan!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110068933">
	<b:glossaryEntry>a state of confusion; ritual accompanied by complicated and purposeless activity that obscures and confuses; "he engaged in the hugger-mugger of international finance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110069174"
	 b:glossaryEntry="a state of disorder involving group violence"/>
<rdf:Description rdf:about="&a;110069279"
	 b:glossaryEntry="rowdy behavior"/>
<rdf:Description rdf:about="&a;110069389">
	<b:glossaryEntry>a disorderly outburst or tumult; "they were amazed by the furious disturbance they had caused"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110069677">
	<b:glossaryEntry>a public disturbance: "the police investigated an incident at the bus station"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110069810">
	<b:glossaryEntry>a violent commotion or disturbance; "the storms that had characterized their relationship had died away"; "it was only a tempest in a teapot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110070013"
	 b:glossaryEntry="a center of trouble or disturbance"/>
<rdf:Description rdf:about="&a;110070121"
	 b:glossaryEntry="a state of commotion and loud confused noise"/>
<rdf:Description rdf:about="&a;110070254"
	 b:glossaryEntry="lack of agreement or harmony"/>
<rdf:Description rdf:about="&a;110070345">
	<b:glossaryEntry>a state of violent disturbance and disorder (as in politics or social conditions generally); "the industrial revolution was a period of great turbulence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110070620">
	<b:glossaryEntry>a state of agitation or turbulent change or development: "the political ferment produced a new leadership"; "social unrest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110070833"
	 b:glossaryEntry="a turbulent state resulting in injuries and destruction etc."/>
<rdf:Description rdf:about="&a;110070966">
	<b:glossaryEntry>violent state of the elements: "the sea hurled itself in thundering rage against the rocks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110071108"
	 b:glossaryEntry="a state of deep-seated ill-will"/>
<rdf:Description rdf:about="&a;110071271">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feelings of hostility that are not manifest; "he could sense her latent hostility to him"; "the diplomats'' first concern was to reduce international tensions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110071502">
	<b:glossaryEntry>a state of opposition between persons or ideas or interests; "his conflict of interest made him ineligible for the post"; "a conflict of loyalties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110071758"
	 b:glossaryEntry="a state of conflict between persons"/>
<rdf:Description rdf:about="&a;110071856">
	<b:glossaryEntry>a legal state created by a declaration of war and ended by official declaration during which the international rules of war apply; "war was declared in November but actual fighting did not begin until the following spring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110072161"
	 b:glossaryEntry="actual fighting between the warring parties"/>
<rdf:Description rdf:about="&a;110072276">
	<b:glossaryEntry>a state of political conflict using means short of armed warfare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110072413"
	 b:glossaryEntry="a conflict of people''s opinions or actions or characters"/>
<rdf:Description rdf:about="&a;110072577"
	 b:glossaryEntry="lack of unity (usually resulting from dissension)"/>
<rdf:Description rdf:about="&a;110072681">
	<b:glossaryEntry>the state of being suspected; "he tried to shield me from suspicion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110072823">
	<b:glossaryEntry>suspicion affecting your reputation; "after that mistake he was under a cloud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110072953"
	 b:glossaryEntry="the degree of visibility of your environment"/>
<rdf:Description rdf:about="&a;110073092">
	<b:glossaryEntry>having abundant light or illumination: "they played as long as it was light" or "as long as the lighting was good"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110073287"
	 b:glossaryEntry="absence of light or illumination"/>
<rdf:Description rdf:about="&a;110073471"
	 b:glossaryEntry='darkness; "it vanished into the night"'/>
<rdf:Description rdf:about="&a;110073561">
	<b:glossaryEntry>total absence of light; "they fumbled around in total darkness"; "in the black of night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110073746">
	<b:glossaryEntry>darkness resulting from the extinction of lights (as in a city invisible to enemy aircraft)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110073912"
	 b:glossaryEntry="partial darkness"/>
<rdf:Description rdf:about="&a;110074095"
	 b:glossaryEntry="gloomy semidarkness caused by cloud cover"/>
<rdf:Description rdf:about="&a;110074204"
	 b:glossaryEntry="a state of diffused or dim illumination"/>
<rdf:Description rdf:about="&a;110074305">
	<b:glossaryEntry>relative darkness caused by light rays being intercepted by an opaque body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110074475"
	 b:glossaryEntry="shade within clear boundaries"/>
<rdf:Description rdf:about="&a;110074593">
	<b:glossaryEntry>a region of complete shadow resulting from total obstruction of light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110074714"
	 b:glossaryEntry="a fringe region of partial shadow around an umbra"/>
<rdf:Description rdf:about="&a;110074818"
	 b:glossaryEntry="the state of being poorly illuminated"/>
<rdf:Description rdf:about="&a;110074921">
	<b:glossaryEntry>a state of partial or total darkness; "he struck a match to dispell the gloom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110075077">
	<b:glossaryEntry>the state of being indistinct or indefinite for lack of adequate illumination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110075224">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the state of a person''s emotions (especially with regard to pleasure or dejection); "his emotional state depended on her opinion"; "he was in good spirits"; "his spirit rose"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110075577">
	<b:glossaryEntry>the state of being embarrassed (usually by some financial inadequacy); "he is currently suffering financial embarrassments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110075760">
	<b:glossaryEntry>a state of being carried away by overwhelming emotion: "listening to sweet music in a perfect rapture"- Charles Dickens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110075968">
	<b:glossaryEntry>state of being gratified; great satisfaction: "dull repetitious work gives no gratification"; "to my immense gratification he arrived on time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110076203">
	<b:glossaryEntry>your personal satisfaction (or dissatisfaction) with the cultural or intellectual conditions under which you live (as distinct from material comfort); "the new art museum is expected to improve the quality of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110076479">
	<b:glossaryEntry>state of well-being characterized by emotions ranging from contentment to intense joy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110076721"
	 b:glossaryEntry="a state of supreme happiness"/>
<rdf:Description rdf:about="&a;110076837"
	 b:glossaryEntry="a state of extreme happiness"/>
<rdf:Description rdf:about="&a;110076997"
	 b:glossaryEntry="a state of elated bliss"/>
<rdf:Description rdf:about="&a;110077084">
	<b:glossaryEntry>(Hinduism and Buddhism) the beatitude that transcends the cycle of reincarnation; characterized by the extinction of desire and individual consciousness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110077290">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) a state of depression or agitation; "he was in such a state you just couldn''t reason with him"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110077447">
	<b:glossaryEntry>state characterized by emotions ranging from mild discontentment to deep grief</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110077637">
	<b:glossaryEntry>the state of being embittered; "the embitterment that resulted from the loss of his job never left him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110077799"
	 b:glossaryEntry='the state of being sad; "she tired of his perpetual sadness"'/>
<rdf:Description rdf:about="&a;110077974"
	 b:glossaryEntry="state of sorrow over the death or departure of a loved one"/>
<rdf:Description rdf:about="&a;110078101">
	<b:glossaryEntry>a state of deeply felt distress or sorrow: "a moment of extraordinary poignancy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110078249">
	<b:glossaryEntry>a state or condition of being innocent of a specific crime or offense; "the trial established his innocence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110078467"
	 b:glossaryEntry="a state of innocence"/>
<rdf:Description rdf:about="&a;110078596">
	<b:glossaryEntry>the state of being free from sin or moral wrong; lacking a knowledge of evil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110078769"
	 b:glossaryEntry="without moral defects"/>
<rdf:Description rdf:about="&a;110078846">
	<b:glossaryEntry>the state of being free of suspicion: "investigation showed that he was in the clear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110078983"
	 b:glossaryEntry="the state of having committed an offense"/>
<rdf:Description rdf:about="&a;110079214"
	 b:glossaryEntry="a state of guilt"/>
<rdf:Description rdf:about="&a;110079321"
	 b:glossaryEntry="the state of being guilty of bloodshed and murder"/>
<rdf:Description rdf:about="&a;110079427"
	 b:glossaryEntry="guilt as an accomplice in a crime or offense"/>
<rdf:Description rdf:about="&a;110079528"
	 b:glossaryEntry="the state of being a criminal"/>
<rdf:Description rdf:about="&a;110079644">
	<b:glossaryEntry>the attribution of guilt (without proof) to individuals because the people they associate with are guilty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110079816"
	 b:glossaryEntry="the state of being liable to impeachment"/>
<rdf:Description rdf:about="&a;110079933">
	<b:glossaryEntry>the condition of being free; the power to act or speak or think without externally imposed restraints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110080250">
	<b:glossaryEntry>the freedom of teachers and students to express their ideas in school without religious or political or institutional restrictions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110080443"
	 b:glossaryEntry="freedom from control or influence of another or others"/>
<rdf:Description rdf:about="&a;110080679">
	<b:glossaryEntry>immunity from arbitrary exercise of authority: political independence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110080831"
	 b:glossaryEntry="government of a country by its own people"/>
<rdf:Description rdf:about="&a;110081021"
	 b:glossaryEntry="government free from external control"/>
<rdf:Description rdf:about="&a;110081116">
	<b:glossaryEntry>freedom of a local government to determine by popular vote the applicability of a controversial law in their jurisdiction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110081296">
	<b:glossaryEntry>self-government in local matters by a city or county that is part of a national government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110081442"
	 b:glossaryEntry="economic independence as a national policy"/>
<rdf:Description rdf:about="&a;110081549">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the removal of constraints; "he gave free rein to his impulses"; "they gave full play to the artist''s talent"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110081721">
	<b:glossaryEntry>the right of merchant ships to travel freely in international waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110081855">
	<b:glossaryEntry>freedom of choice: "liberty of opinion"; "liberty of worship"; "liberty--perfect liberty--to think or feel or do just as one pleases"; "at liberty to choose whatever occupation one wishes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110082169">
	<b:glossaryEntry>freedom to deviate deliberately from normally applicable rules or practices (especially in behavior or speech)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110082361">
	<b:glossaryEntry>license used by a writer or artist to heighten the effect of their work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110082493">
	<b:glossaryEntry>freedom from normal restraints in conduct: "the new freedom in movies and novels"; "allowed his children considerable latitude in how they spent their money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110082705">
	<b:glossaryEntry>excessive freedom; lack of due restraint: "when liberty becomes license dictatorship is near"- Will Durant; "the intolerable license with which the newspapers break...the rules of decorum"- Edmund Burke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110082961">
	<b:glossaryEntry>one''s freedom to exercise one''s rights as guaranteed under the laws of the country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110083123"
	 b:glossaryEntry="freedom to act or judge on one''s own"/>
<rdf:Description rdf:about="&a;110083234"
	 b:glossaryEntry="the freedom or ability to choose"/>
<rdf:Description rdf:about="&a;110083322"
	 b:glossaryEntry="personal freedom from servitude or confinement or oppression"/>
<rdf:Description rdf:about="&a;110083436"
	 b:glossaryEntry="forced submission to control by others"/>
<rdf:Description rdf:about="&a;110083617">
	<b:glossaryEntry>a state of forcible subjugation; "the repression of Christian sects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110083742">
	<b:glossaryEntry xml:space='preserve'><![CDATA[kept down by unjust use of force or authority: "the tyrant''s oppression of the people"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110083885">
	<b:glossaryEntry>the state of being a slave; "So every bondman in his own hand bears the power to cancel his captivity"--Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110084106"
	 b:glossaryEntry="the state of being under the control of another person"/>
<rdf:Description rdf:about="&a;110084274">
	<b:glossaryEntry>state of subjection to an owner or master or forced labor imposed as punishment: "penal servitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110084446"
	 b:glossaryEntry="the condition of a peon"/>
<rdf:Description rdf:about="&a;110084523"
	 b:glossaryEntry="the state of a serf"/>
<rdf:Description rdf:about="&a;110084619">
	<b:glossaryEntry>the state of being confined; "he was held in solitary confinement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110084797"
	 b:glossaryEntry="the state of being constrained"/>
<rdf:Description rdf:about="&a;110084914">
	<b:glossaryEntry>something that restricts freedom as a cage restricts movement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110085044"
	 b:glossaryEntry="a cage from which there is no escape"/>
<rdf:Description rdf:about="&a;110085136">
	<b:glossaryEntry>the state of being imprisoned; "he was held in captivity until he died"; "the imprisonment of captured soldiers"; "his ignominious incarceration in the local jail"; "he practiced the immurement of his enemies in the castle dungeon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110085503">
	<b:glossaryEntry>a state of confinement (usually for a short time; "the prisoner is on hold"; "he is in the custody of police")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110085686"
	 b:glossaryEntry="imprisonment (especially for a long time)"/>
<rdf:Description rdf:about="&a;110085781"
	 b:glossaryEntry="confinement during wartime"/>
<rdf:Description rdf:about="&a;110085864">
	<b:glossaryEntry>the state of serving as an official and authorized delegate or agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110086049">
	<b:glossaryEntry>(sports) the state of a professional athlete who is free to negotiate a contract to play for any team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110086208">
	<b:glossaryEntry>personal representation that has legal status; "an person who has been declared incompetent should have legal representation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110086400"
	 b:glossaryEntry="personal independence"/>
<rdf:Description rdf:about="&a;110086528">
	<b:glossaryEntry>political independence; "seeking complete political separateness for Taiwan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110086663"
	 b:glossaryEntry="lack of independence or self-sufficiency"/>
<rdf:Description rdf:about="&a;110086858"
	 b:glossaryEntry="the state of needing help from something"/>
<rdf:Description rdf:about="&a;110086957"
	 b:glossaryEntry="the state of relying on something"/>
<rdf:Description rdf:about="&a;110087045"
	 b:glossaryEntry="the state of being subordinate to something"/>
<rdf:Description rdf:about="&a;110087148"
	 b:glossaryEntry="the state of being contingent on something"/>
<rdf:Description rdf:about="&a;110087248"
	 b:glossaryEntry="the condition of having or giving polarity"/>
<rdf:Description rdf:about="&a;110087349">
	<b:glossaryEntry>the situation in a contest in which the winner is undecided at the end; "the game ended in a draw"; "their record was 3 wins, 6 losses and a tie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110087598"
	 b:glossaryEntry="a tie in a race"/>
<rdf:Description rdf:about="&a;110087669">
	<b:glossaryEntry>drawing position in chess: any of a player''s possible moves would place his king in check</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110087814"
	 b:glossaryEntry="a state of equilibrium"/>
<rdf:Description rdf:about="&a;110087944">
	<b:glossaryEntry>a balance between and interplay of opposing elements or tendencies (especially in art or literature); "there is a tension created between narrative time and movie time"; "there is a tension between these approaches to understanding history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110088238">
	<b:glossaryEntry>(aeronautics) the state of equilibrium in which centrifugal forces due to a rotating mass (e.g., a propeller) do not produce force in the shaft and so vibration is reduced</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110088471"
	 b:glossaryEntry="a state of being balanced in a stable equilibrium"/>
<rdf:Description rdf:about="&a;110088572"
	 b:glossaryEntry="a state of disequilibrium"/>
<rdf:Description rdf:about="&a;110088697"
	 b:glossaryEntry='a state of change; "they were in a state of steady motion"'/>
<rdf:Description rdf:about="&a;110088916">
	<b:glossaryEntry>a shaky motion; "the shaking of his fingers as he lit his pipe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110089131">
	<b:glossaryEntry>(music) a tremulous effect produced by rapid repetition of a single tone or rapid alternation of two tones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110089291">
	<b:glossaryEntry>the motion of a spinning body (as a top) in which it wobbles so that the axis of rotation sweeps out a cone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110089455">
	<b:glossaryEntry>something that resembles a flowing stream in moving continuously; "a stream of people emptied from the terminal"; "the museum had planned carefully for the flow of visitors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110089688"
	 b:glossaryEntry="a state of no motion or movement"/>
<rdf:Description rdf:about="&a;110089847"
	 b:glossaryEntry="remaining in place"/>
<rdf:Description rdf:about="&a;110089951"
	 b:glossaryEntry="a state of no activity"/>
<rdf:Description rdf:about="&a;110090043"
	 b:glossaryEntry="the state of something that has outlived its relevance"/>
<rdf:Description rdf:about="&a;110090167">
	<b:glossaryEntry>the state of being active; "his sphere of activity"; "he is out of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110090534">
	<b:glossaryEntry>the state of being in action or exerting power; "the agency of providence"; "she has free agency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110090684">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a state in which action is feasible; "the ball was still in play"; "insiders said the company''s stock was in play"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110090849">
	<b:glossaryEntry>the state of being or appearing to be actively engaged in an activity: "they manifested all the busyness of a pack of beavers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110091030">
	<b:glossaryEntry>the action or reaction of something (as a machine or substance) under specified circumstances; "the behavior of small particles can be studied in experiments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110091255"
	 b:glossaryEntry="(of volcanos) pouring out fumes or lava"/>
<rdf:Description rdf:about="&a;110091362">
	<b:glossaryEntry>the state of being in effect or being operative; "that rule is no longer in operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110091540">
	<b:glossaryEntry>the state of being in good working order and ready for operation; "put the ships into comission"; "the motor was out of commission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110091728">
	<b:glossaryEntry>the state of being in operation; "the engine is running smoothly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110091847">
	<b:glossaryEntry>a state of steady vigorous action that is characteristic of an activity; "the party went with a swing"; "it took time to get into the swing of things"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110092049"
	 b:glossaryEntry="the state of being inactive"/>
<rdf:Description rdf:about="&a;110092393"
	 b:glossaryEntry="inactivity and lack of energy"/>
<rdf:Description rdf:about="&a;110092475"
	 b:glossaryEntry="a state of inactivity or disuse"/>
<rdf:Description rdf:about="&a;110092562">
	<b:glossaryEntry>inactivity resulting from a static balance between opposing forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110092681">
	<b:glossaryEntry>a state of inactivity (in business or art etc); "economic growth of less than 1% per year is considered to be economic stagnation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110092910">
	<b:glossaryEntry>the state of the economy declines; a widespread decline in the GDP and employment and trade lasting from six months to a year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110093091">
	<b:glossaryEntry>a state of inaction; "a body will continue in a state of rest until acted upon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110093221">
	<b:glossaryEntry>no longer active; extinguished; "the extinction of the volcano"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110093359"
	 b:glossaryEntry="temporary cessation or suspension"/>
<rdf:Description rdf:about="&a;110093496"
	 b:glossaryEntry="a state of abeyance or suspended business"/>
<rdf:Description rdf:about="&a;110093601"
	 b:glossaryEntry="suspension of an ongoing activity"/>
<rdf:Description rdf:about="&a;110093691"
	 b:glossaryEntry="a state of quiet (but possibly temporary) inaction"/>
<rdf:Description rdf:about="&a;110093894">
	<b:glossaryEntry>cessation from or slowing of activity during the winter; especially slowing of metabolism in some animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110094057">
	<b:glossaryEntry>cessation from or slowing of activity during the summer; especially slowing of metabolism in some animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110094233"
	 b:glossaryEntry="an inability to retain bodily secretions"/>
<rdf:Description rdf:about="&a;110094329"
	 b:glossaryEntry="dilation and enlargement of arterioles"/>
<rdf:Description rdf:about="&a;110094429">
	<b:glossaryEntry>a state of motor and mental inactivity with a partial suspension of sensibility; "he fell into a deep torpor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110094639">
	<b:glossaryEntry>the torpid or resting state in which some animals pass the winter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110094762"
	 b:glossaryEntry="a state of comatose torpor"/>
<rdf:Description rdf:about="&a;110094888"
	 b:glossaryEntry="a dormant or quiescent state"/>
<rdf:Description rdf:about="&a;110094970">
	<b:glossaryEntry>the state of inactivity following an interruption; "the negotiations were in arrest"; "held them in check"; "during the halt he got some lunch"; "he spent the entire stay in his room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110095290">
	<b:glossaryEntry>a situation in which no progress can be made: "reached an impasse on the negotiations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110095466">
	<b:glossaryEntry>any stoppage attributable to unusual activity; "the legislation ran into a logjam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110095601"
	 b:glossaryEntry="a state that continues for a limited time"/>
<rdf:Description rdf:about="&a;110095866">
	<b:glossaryEntry>a specific state of mind that is temporary; "a case of the jitters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110095984"
	 b:glossaryEntry="a temporary psychological state"/>
<rdf:Description rdf:about="&a;110096145"
	 b:glossaryEntry="a state in which one thinks"/>
<rdf:Description rdf:about="&a;110096231">
	<b:glossaryEntry>temporary loss of strength and energy resulting from hard physical or mental work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110096480">
	<b:glossaryEntry>a tiredness of the eyes caused by prolonged close work by a person with an uncorrected vision problem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110096650">
	<b:glossaryEntry>fatigue and sleep disturbance resulting from disruption of the body''s normal circadian rhythm as a result of jet travel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110096823"
	 b:glossaryEntry="extreme fatigue"/>
<rdf:Description rdf:about="&a;110096949"
	 b:glossaryEntry="the state of being depleted"/>
<rdf:Description rdf:about="&a;110097050">
	<b:glossaryEntry>loss of salt from the body without replacement (loss by vomiting or profuse perspiration or urination or diarrhea) thus upsetting the electrolyte balance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110097264">
	<b:glossaryEntry>an equilibrium between the amounts of electrolytes (as calcium and sodium and potassium) that is essential for normal health and functioning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110097470">
	<b:glossaryEntry>(informal) a state of extreme exhaustion; "he was worn to a frazzle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110097592"
	 b:glossaryEntry="exhaustion that affects mental keenness"/>
<rdf:Description rdf:about="&a;110097707"
	 b:glossaryEntry="a groggy state resulting from weariness"/>
<rdf:Description rdf:about="&a;110097803"
	 b:glossaryEntry="a dull and listless state resulting from weariness"/>
<rdf:Description rdf:about="&a;110097920">
	<b:glossaryEntry>a temporary state resulting from excessive consumption of alcohol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110098150"
	 b:glossaryEntry="a dazed and staggering state caused by alcohol"/>
<rdf:Description rdf:about="&a;110098253"
	 b:glossaryEntry="stupefaction from drink"/>
<rdf:Description rdf:about="&a;110098334"
	 b:glossaryEntry="the state of being sober"/>
<rdf:Description rdf:about="&a;110098443">
	<b:glossaryEntry>congenital absence of the heart (as in the development of some monsters)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110098588"
	 b:glossaryEntry="absence of the head (as in the development of some monsters)"/>
<rdf:Description rdf:about="&a;110098747"
	 b:glossaryEntry="abnormally high acidity of the blood and other body tissues"/>
<rdf:Description rdf:about="&a;110098879">
	<b:glossaryEntry>acidosis with an accumulation of ketone bodies; occurs primarily in diabetes mellitus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110099042">
	<b:glossaryEntry>a blood disorder characterized by an increased concentration of hydrogen ions in the blood (which falls below 7 on the pH scale)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110099225">
	<b:glossaryEntry>a blood disorder characterized by a lower concentration of hydrogen ions in the blood (which rises above 7.45 on the pH scale)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110099407">
	<b:glossaryEntry>a condition in which the urine (which is normally slightly acidic) is alkaline</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110099555">
	<b:glossaryEntry>abnormally high alkalinity of the blood and other body tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110099673"
	 b:glossaryEntry="absence of the pupil in an eye"/>
<rdf:Description rdf:about="&a;110099756">
	<b:glossaryEntry>abnormally small extremities (underdeveloped fingers and toes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110099888">
	<b:glossaryEntry>abnormal protrusion of the navel; sometimes the start of umbilical hernia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110100019">
	<b:glossaryEntry>a condition in which milk is not secreted in the mother''s breasts after her child has been delivered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110100189">
	<b:glossaryEntry>absence of the mammary glands (either through surgery or developmental defect)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110100321"
	 b:glossaryEntry="abnormal adhesion and rigidity of the bones of a joint"/>
<rdf:Description rdf:about="&a;110100444">
	<b:glossaryEntry>an abnormality involving a chromosome number that is not an exact multiple of the haploid number (one chromosome set is incomplete)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110100632"
	 b:glossaryEntry="absence of one of both testes"/>
<rdf:Description rdf:about="&a;110100742">
	<b:glossaryEntry>a temporary state in which you are unable (or unwilling) to sleep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110100899"
	 b:glossaryEntry="an inability to stay awake"/>
<rdf:Description rdf:about="&a;110101037"
	 b:glossaryEntry="an inability to sleep; chronic sleeplessness"/>
<rdf:Description rdf:about="&a;110101154">
	<b:glossaryEntry>loss of bodily sensation with or without loss of consciousness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110101395"
	 b:glossaryEntry="failure of the sweat glands"/>
<rdf:Description rdf:about="&a;110101479"
	 b:glossaryEntry="failure of some tissue or organ to develop"/>
<rdf:Description rdf:about="&a;110101575"
	 b:glossaryEntry="a state of heightened physiological activity"/>
<rdf:Description rdf:about="&a;110101745"
	 b:glossaryEntry="an abnormal distension of an artery"/>
<rdf:Description rdf:about="&a;110101856">
	<b:glossaryEntry>absence of coordination of organs or body parts that usually work together harmoniously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110102010">
	<b:glossaryEntry>absence of systole; failure of the ventricles of the heart to contract (usually caused by ventricular fibrillation) with consequent absence of the heart beat leading to oxygen lack and eventually to death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110102311">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a natural and periodic state of rest during which consciousness of the world is suspended; "he didn''t get enough sleep last night"; "calm as a child in dreamless slumber"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110102615"
	 b:glossaryEntry="a disturbance of the normal sleep pattern"/>
<rdf:Description rdf:about="&a;110102789">
	<b:glossaryEntry>a disorder of sleep characterized by a dream of terrifying dimensions far worse than a typical nightmare; they occur during NREM sleep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110103009">
	<b:glossaryEntry>a recurring sleep state during which dreaming occurs; a state of Rapid Eye Movements during sleep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110103209">
	<b:glossaryEntry>a recurring sleep state during which rapid eye movements do not occur and dreaming does not occur; accounts for about 75% of normal sleep time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110103438"
	 b:glossaryEntry="a torpid state resembling sleep"/>
<rdf:Description rdf:about="&a;110103521"
	 b:glossaryEntry="informal term for sleep"/>
<rdf:Description rdf:about="&a;110103598"
	 b:glossaryEntry="a loss of will power"/>
<rdf:Description rdf:about="&a;110103681"
	 b:glossaryEntry="an inability to experience pleasure"/>
<rdf:Description rdf:about="&a;110103772">
	<b:glossaryEntry>a state that resembles sleep but that is induced by suggestion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110103907"
	 b:glossaryEntry="hypnosis induced by yourself"/>
<rdf:Description rdf:about="&a;110104030"
	 b:glossaryEntry="insensibility resulting from cold"/>
<rdf:Description rdf:about="&a;110104142">
	<b:glossaryEntry>a state of total unconsciousness resulting from anesthetic drugs (as for a major surgical operation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110104348">
	<b:glossaryEntry>loss of sensation in a small area of the body (as when a local anesthetic is injected for a tooth extraction)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110104540">
	<b:glossaryEntry>anesthesia of an area supplied by a nerve; produced by an anesthetic agent applied to the nerve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110104818">
	<b:glossaryEntry>loss of sensation in a region of the body produced by application of an anesthetic agent to all the nerves supplying that region (as when an epidural anesthetic is administered to the pelvic region during childbirth)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110105231">
	<b:glossaryEntry>loss of sensation confined to the skin or mucous surfaces (as when benzocaine or lidocaine is applied to the surface)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110105435"
	 b:glossaryEntry="loss of sensation in the extremities"/>
<rdf:Description rdf:about="&a;110105550">
	<b:glossaryEntry>regional anesthesia resulting from injection of an anesthetic into the caudal end of the spinal canal; now largely replaced by epidural anesthesia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110105796">
	<b:glossaryEntry>regional anesthesia resulting from injection of an anesthetic into the epidural space of the spinal cord; sensation is lost in the abdominal and genital and pelvic areas; used in childbirth and gynecological surgery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110106111">
	<b:glossaryEntry>regional anesthesia resulting from the injection of a local anesthetic on each side of the cervix; used during labor and childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110106307">
	<b:glossaryEntry>regional anesthesia resulting from the use of a local anesthetic to deaden the pudendal nerves in the region of the vulva and labia majora; used to ease discomfort during childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110106549">
	<b:glossaryEntry>anesthesia of the lower half of the body; caused by injury to the spinal cord or by injecting an anesthetic beneath the arachnoid membrane that surrounds the spinal cord</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110106830">
	<b:glossaryEntry>the parts of a patient''s body that would touch a saddle if the patient were sitting in one are anesthetized by injecting a local anesthetic into the spinal cord</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110107087">
	<b:glossaryEntry>a state of general anesthesia in which the person retains a slight degree of consciousness; can be induced by injection of scopolamine or morphine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110107294">
	<b:glossaryEntry>a dreamlike state of altered consciousness that may last for hours or days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110107420">
	<b:glossaryEntry>a very sleepy state; "sleepiness causes many driving accidents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110107584"
	 b:glossaryEntry="the state of being imminent and liable to happen soon"/>
<rdf:Description rdf:about="&a;110107749">
	<b:glossaryEntry>the state of being ready or prepared for use or action (especially military action); "putting them in readiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110108004"
	 b:glossaryEntry='poised for action; "their guns were at the ready"'/>
<rdf:Description rdf:about="&a;110108105">
	<b:glossaryEntry>condition of heightened watchfulness or preparation for action: "bombers were put on alert during the crisis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110108277"
	 b:glossaryEntry="presence of diverticula in the walls of the colon"/>
<rdf:Description rdf:about="&a;110108387">
	<b:glossaryEntry>a state in which martial law applies; "the governor declared a state of emergency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110108525"
	 b:glossaryEntry='a tense critical situation; "he is a good man in the clutch"'/>
<rdf:Description rdf:about="&a;110108638"
	 b:glossaryEntry='a pressing or urgent situation: "the health-care exigency"'/>
<rdf:Description rdf:about="&a;110108751">
	<b:glossaryEntry>a crisis situation or point in time when a critical decision must be made; "at that juncture he had no idea what to do"; "he must be made to realize that the company stands at a critical point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110109047"
	 b:glossaryEntry="a state of extreme distress"/>
<rdf:Description rdf:about="&a;110109153">
	<b:glossaryEntry>a critical state; especially the point at which a nuclear reaction is self-sustaining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110109350"
	 b:glossaryEntry="point at which something is ready to blow up"/>
<rdf:Description rdf:about="&a;110109452"
	 b:glossaryEntry="the condition of the body or bodily functions"/>
<rdf:Description rdf:about="&a;110110247">
	<b:glossaryEntry>a physiological state corresponding to a strong need or desire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110110433"
	 b:glossaryEntry="a state of excessive gas in the alimentary canal"/>
<rdf:Description rdf:about="&a;110110557">
	<b:glossaryEntry>a state of readiness to respond; "alerting was indicated by the desynchronization of the EEG"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110110717"
	 b:glossaryEntry="the arousal of strong emotions and emotional behavior"/>
<rdf:Description rdf:about="&a;110110870"
	 b:glossaryEntry="the state of being angry"/>
<rdf:Description rdf:about="&a;110110976">
	<b:glossaryEntry>a state of extreme anger; "she fell into a rage and refused to answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110111097">
	<b:glossaryEntry>the state of being excited; "his face was flushed with excitement and his hands trembled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110111279">
	<b:glossaryEntry>the arousal of sexual desires in preparation for sexual behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110111476"
	 b:glossaryEntry="a state of anticipation of sexuality"/>
<rdf:Description rdf:about="&a;110111578">
	<b:glossaryEntry>sexual arousal resulting from handling a fetish (or a specific part of the body other than the sexual organs)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110111755"
	 b:glossaryEntry="(informal) a state of sexual arousal"/>
<rdf:Description rdf:about="&a;110111869"
	 b:glossaryEntry="an erect penis"/>
<rdf:Description rdf:about="&a;110111948">
	<b:glossaryEntry>applies to nonhuman mammals: a state or period of heightened sexual arousal and activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110112130">
	<b:glossaryEntry>applies to nonhuman mammals: a state or interval of sexual inactivity between two periods of estrus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110112355">
	<b:glossaryEntry>(of animals having several estrous cycles in one breeding season) a state or interval of sexual inactivity or quiescence between periods of activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110112569"
	 b:glossaryEntry="something that is desired"/>
<rdf:Description rdf:about="&a;110112683">
	<b:glossaryEntry>something that is desired intensely; "his rage for fame destroyed him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110112814">
	<b:glossaryEntry>a desire for wealth and material possessions with little interest in ethical or spiritual matters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110112984"
	 b:glossaryEntry="a physiological need for food"/>
<rdf:Description rdf:about="&a;110113151"
	 b:glossaryEntry="having an empty stomach"/>
<rdf:Description rdf:about="&a;110113230"
	 b:glossaryEntry="excessive desire to eat"/>
<rdf:Description rdf:about="&a;110113361">
	<b:glossaryEntry>a state of extreme hunger resulting from lack of essential nutrients over a prolonged period</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110113523"
	 b:glossaryEntry="not having enough food to develop or function formally"/>
<rdf:Description rdf:about="&a;110113657"
	 b:glossaryEntry="a physiological need to drink"/>
<rdf:Description rdf:about="&a;110113757"
	 b:glossaryEntry="depletion of bodily fluids"/>
<rdf:Description rdf:about="&a;110113841">
	<b:glossaryEntry>a physiological need for sexual activity; "testosterone is responsible for the male sex drive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110113991">
	<b:glossaryEntry>a very strong drive resulting from oxygen deficiency in bodily tissues (short of anoxia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110114242">
	<b:glossaryEntry>hypoxia resulting from a decreased concentration of hemoglobin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110114365">
	<b:glossaryEntry>hypoxia resulting from defective oxygenation of the blood in the lungs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110114497">
	<b:glossaryEntry>hypoxia resulting from slow peripheral circulation (such as follows congestive cardiac failure)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110114674">
	<b:glossaryEntry>the presence of an abnormally high level of carbon dioxide in the circulating blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110114848">
	<b:glossaryEntry>a state in which the level of carbon dioxide in the blood is lower than normal; can result from deep or rapid breathing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110115034">
	<b:glossaryEntry>a condition in which insufficient or no oxygen and carbon dioxide are exchanged on a ventilatory basis; caused by choking or drowning or electric shock or poison gas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110115292">
	<b:glossaryEntry>a cumulative deficit of oxygen resulting from intense exercise; the deficit must be made up when the body returns to rest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110115471">
	<b:glossaryEntry>effects (as nosebleed or nausea) of oxygen deficiency in the blood and tissues at high altitudes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110115649">
	<b:glossaryEntry>nausea and shortness of breath experienced by mountain climbers above ten thousand feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110115800">
	<b:glossaryEntry>severe hypoxia; absence of oxygen in inspired gases or in arterial blood or in the tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110115997">
	<b:glossaryEntry>anoxia resulting from a decreased concentration of hemoglobin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110116118">
	<b:glossaryEntry>anoxia resulting from defective oxygenation of the blood in the lungs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110116247">
	<b:glossaryEntry>anoxia resulting from slow peripheral circulation (such as follows congestive cardiac failure)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110116421"
	 b:glossaryEntry="abnormally high body temperature"/>
<rdf:Description rdf:about="&a;110116562"
	 b:glossaryEntry="normal body temperature"/>
<rdf:Description rdf:about="&a;110116644"
	 b:glossaryEntry="subnormal body temperature"/>
<rdf:Description rdf:about="&a;110116746"
	 b:glossaryEntry="an inability (usually of a male) to copulate"/>
<rdf:Description rdf:about="&a;110116858">
	<b:glossaryEntry>the state (usually of a woman) of having no children or being unable to have children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110117000"
	 b:glossaryEntry="the state of being unable to produce offspring"/>
<rdf:Description rdf:about="&a;110117206">
	<b:glossaryEntry>inability to produce hybrids that are both viable and fertile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110117325"
	 b:glossaryEntry="infertility between hybrids"/>
<rdf:Description rdf:about="&a;110117409"
	 b:glossaryEntry="the state of being pregnant"/>
<rdf:Description rdf:about="&a;110117652"
	 b:glossaryEntry='an unwanted pregnancy; "he got several girls in trouble"'/>
<rdf:Description rdf:about="&a;110117762"
	 b:glossaryEntry="a technical term for pregnancy"/>
<rdf:Description rdf:about="&a;110117861"
	 b:glossaryEntry="ectopic pregnancy in the abdominal cavity"/>
<rdf:Description rdf:about="&a;110117968"
	 b:glossaryEntry="ectopic pregnancy in the ovary"/>
<rdf:Description rdf:about="&a;110118062"
	 b:glossaryEntry="ectopic pregnancy in a Fallopian tube"/>
<rdf:Description rdf:about="&a;110118161">
	<b:glossaryEntry>pregnancy resulting from gestation elsewhere than in the uterus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110118412"
	 b:glossaryEntry="pregnancy resulting from normal gestation in the uterus"/>
<rdf:Description rdf:about="&a;110118531">
	<b:glossaryEntry>the stage of pregnancy at which the mother first feels movements of the fetus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110118684">
	<b:glossaryEntry>concluding state of pregnancy; from the onset of labor to the birth of a child; "she was in labor for six hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110118974">
	<b:glossaryEntry>the presentation during labor of the head of the fetus at an abnormal angle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110119138">
	<b:glossaryEntry>an abnormal condition in which a normal opening or tube in the body (as the urethra) is closed or absent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110119296">
	<b:glossaryEntry>temporary stiffness of joints and muscular rigidity occurring after death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110119428">
	<b:glossaryEntry>the state of being vigorous and free from bodily or mental disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110119692"
	 b:glossaryEntry="a state of robust good health"/>
<rdf:Description rdf:about="&a;110119788">
	<b:glossaryEntry>a healthy capacity for vigorous activity; "jogging works off my excess energy"; "he seemed full of vim and vigor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110119971">
	<b:glossaryEntry>a rosy color (especially in the cheeks) taken as a sign of good health</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110120120"
	 b:glossaryEntry="an alert and refreshed state"/>
<rdf:Description rdf:about="&a;110120211">
	<b:glossaryEntry>an attractive combination of good health and happiness; "the radiance of her countenance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110120373"
	 b:glossaryEntry="the state of being fertile; capable of producing offspring"/>
<rdf:Description rdf:about="&a;110120553">
	<b:glossaryEntry>the state of being potent; a male''s capacity to have sexual intercourse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110120678">
	<b:glossaryEntry>a state in which you are unable to function normally and without pain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110121017">
	<b:glossaryEntry>a disturbance of normal functioning; "the doctor prescribed some medicine for the disorder"; "everyone gets stomach upsets from time to time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110121707">
	<b:glossaryEntry>the condition in which the upper teeth do not touch the lower teeth when biting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110121844">
	<b:glossaryEntry>a disorder of pregnancy in which the placenta prematurely separates from the wall of the uterus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110122004">
	<b:glossaryEntry>a condition in which little or no bile is secreted or the flow of bile into the digestive tract is obstructed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110122167">
	<b:glossaryEntry>any disorder (as sudden confusion or disorientation) in an otherwise normal person that is due to reversible (temporary) impairment of brain tissues (as by head injuries or drugs or infection)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110122457">
	<b:glossaryEntry>a condition (mostly in boys) characterized by behavioral and learning disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110122628"
	 b:glossaryEntry="absence of an orgasm in sexual relations"/>
<rdf:Description rdf:about="&a;110122725"
	 b:glossaryEntry="a condition in which the vagina is unusually dry"/>
<rdf:Description rdf:about="&a;110122832">
	<b:glossaryEntry>a condition in which a tooth is so crowded in its socket that it cannot erupt normally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110122991"
	 b:glossaryEntry="a condition in which the opposing teeth do not mesh normally"/>
<rdf:Description rdf:about="&a;110123110"
	 b:glossaryEntry="a prolonged disorder of eating due to loss of appetite"/>
<rdf:Description rdf:about="&a;110123237">
	<b:glossaryEntry>(psychiatry) a psychological disorder characterized by somatic delusions that you are too fat despite being emaciated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110123417"
	 b:glossaryEntry="an ill-defined state of irritability and distress"/>
<rdf:Description rdf:about="&a;110123520">
	<b:glossaryEntry>a condition characterized by excessive restlessness and movement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110123663"
	 b:glossaryEntry="the state of having cells"/>
<rdf:Description rdf:about="&a;110123782"
	 b:glossaryEntry="the state of having abnormally many cells"/>
<rdf:Description rdf:about="&a;110123886"
	 b:glossaryEntry="the state of having abnormally few cells"/>
<rdf:Description rdf:about="&a;110123988">
	<b:glossaryEntry>impairment of normal physiological function affecting part or all of an organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110124358"
	 b:glossaryEntry="chronic ill health"/>
<rdf:Description rdf:about="&a;110124433">
	<b:glossaryEntry>gastric distress caused by a disorder of the liver or gall bladder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110124557">
	<b:glossaryEntry>being abnormally dependent on something that is psychologically or physically habit-forming (especially alcohol or narcotic drugs)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110124787">
	<b:glossaryEntry>a temporary cessation of vital functions with loss of consciousness resembling death; usually resulting from asphyxia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110124988">
	<b:glossaryEntry>suspended animation in organisms during periods of extreme drought from which they revive when moisture returns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110125155">
	<b:glossaryEntry>a state in which an animal''s metabolic activities come to a reversible standstill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110125295"
	 b:glossaryEntry="an addiction to a drug (especially a narcotic drug)"/>
<rdf:Description rdf:about="&a;110125512">
	<b:glossaryEntry>prolonged and excessive intake of alcoholic drinks leading to a breakdown in health and an addiction to alcohol such that abrupt deprivation leads to severe withdrawal symptoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110125779"
	 b:glossaryEntry="an addiction to cocaine"/>
<rdf:Description rdf:about="&a;110125866"
	 b:glossaryEntry="an addiction to heroin"/>
<rdf:Description rdf:about="&a;110125951"
	 b:glossaryEntry="an addiction to caffein"/>
<rdf:Description rdf:about="&a;110126038"
	 b:glossaryEntry="an addiction to nicotine"/>
<rdf:Description rdf:about="&a;110126127"
	 b:glossaryEntry="a fit of shivering"/>
<rdf:Description rdf:about="&a;110126196">
	<b:glossaryEntry>a disorder characterized by deposit of amyloid in organs or tissues; often secondary to chronic rheumatoid arthritis or tuberculosis or multiple myeloma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110126406"
	 b:glossaryEntry="inability to urinate"/>
<rdf:Description rdf:about="&a;110126490">
	<b:glossaryEntry>severe illness requiring prolonged hospitalization or recovery; usually involves high costs for hospitals and doctors and medicines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110126688"
	 b:glossaryEntry="an abrupt failure of function or health"/>
<rdf:Description rdf:about="&a;110126818"
	 b:glossaryEntry="a mental or physical breakdown"/>
<rdf:Description rdf:about="&a;110126933"
	 b:glossaryEntry="a severe or incapacitating emotional disorder"/>
<rdf:Description rdf:about="&a;110127078">
	<b:glossaryEntry>an emotional disorder that leaves you exhausted and unable to work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110127231"
	 b:glossaryEntry="nervous breakdown (not in technical use)"/>
<rdf:Description rdf:about="&a;110127330">
	<b:glossaryEntry>(pathology) bodily collapse or near collapse caused by inadequate oxygen delivery to the cells; caused by loss of circulating blood or cardiac arrest or obstruction or poor distribution of the blood flow; characterized by reduced cardiac output and rapid heartbeat and circulatory insufficiency and pallor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110127777"
	 b:glossaryEntry="shock caused by cardiac arrest"/>
<rdf:Description rdf:about="&a;110127871"
	 b:glossaryEntry="shock caused by severe blood or fluid loss"/>
<rdf:Description rdf:about="&a;110127977"
	 b:glossaryEntry="shock caused by obstruction of blood flow"/>
<rdf:Description rdf:about="&a;110128082"
	 b:glossaryEntry="shock caused by poor distribution of the blood flow"/>
<rdf:Description rdf:about="&a;110128198">
	<b:glossaryEntry>a severe and rapid and sometimes fatal hypersensitivity reaction to a substance (especially a vaccine or penicillin or shellfish or insect venom) to which the organism has become sensitized by previous exposure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110128473">
	<b:glossaryEntry>hypoglycemia produced by excessive insulin in the system causing coma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110128640"
	 b:glossaryEntry="pain resulting from rapid change in pressure"/>
<rdf:Description rdf:about="&a;110128809"
	 b:glossaryEntry="illness caused by poisonous or contaminated food"/>
<rdf:Description rdf:about="&a;110129014"
	 b:glossaryEntry="poisoning from ingesting botulin; affects the CNS"/>
<rdf:Description rdf:about="&a;110129118">
	<b:glossaryEntry>a kind of food poisoning caused by eating foods contaminated with Salmonella typhimurium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110129266">
	<b:glossaryEntry>toxic condition produced by the absorption of excessive lead into the system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110129426">
	<b:glossaryEntry>symptom of chronic lead poisoning and associated with obstinate constipation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110129577">
	<b:glossaryEntry>a trancelike state with loss of voluntary motion and failure to react to stimuli</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110129713">
	<b:glossaryEntry>an impairment of health or a condition of abnormal functioning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110130462"
	 b:glossaryEntry="any disease of the blood vessels or lymph ducts"/>
<rdf:Description rdf:about="&a;110130602">
	<b:glossaryEntry>disease especially in agricultural workers caused by inhalation of Aspergillus spores causing lumps in skin and ears and respiratory organs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110130801">
	<b:glossaryEntry>the presence of acanthocytes in the blood stream (as in abetalipoproteinemia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110130939">
	<b:glossaryEntry>an acute blood disorder (often caused by radiation or drug therapy) characterized by severe reduction in granulocytes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110131151"
	 b:glossaryEntry="an abnormally low level of albumin in the blood serum"/>
<rdf:Description rdf:about="&a;110131264">
	<b:glossaryEntry>a disease characterized by congestion and enlargement of the spleen; accompanied by anemia or cirrhosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110131448">
	<b:glossaryEntry>any of several human or animal diseases characterized by dark urine resulting from rapid breakdown of red blood cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110131622">
	<b:glossaryEntry>severe and often fatal malaria characterized by kidney damage resulting in dark urine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110131770">
	<b:glossaryEntry>a disease thought to be transmitted to humans by a scratch from a cat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110131905">
	<b:glossaryEntry>any disease or disorder that occurs during the course of (or because of) another disease; "bed sores are a common complication in cases of paralysis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110132113">
	<b:glossaryEntry>a disease that is constantly present to a greater or lesser degree in people of a certain class or in people living in a particular location</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110132307"
	 b:glossaryEntry="a degenerative state of the cell nucleus"/>
<rdf:Description rdf:about="&a;110132413">
	<b:glossaryEntry>pathological dissolution of cells caused by degeneration of their membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110132544">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the state of being hyaline or having become hyaline: "the patient''s arterioles showed marked hyalinization"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110132711"
	 b:glossaryEntry="the state of having become filled with vacuoles"/>
<rdf:Description rdf:about="&a;110132832">
	<b:glossaryEntry>contracted from meat or milk products from infected domestic animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110133011">
	<b:glossaryEntry>an infective disease caused by sporozoan parasites that are transmitted through the bite of an infected Anopheles mosquito; marked by paroxysms of chills and fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110133265">
	<b:glossaryEntry>a disease (common in India and around the Mediterranean area) caused by a rickettsia that is transmitted to humans by a reddish brown tick (ixodid) that lives on dogs and other mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110133566">
	<b:glossaryEntry>a disease of the inner ear characterized by episodes of dizziness and tinnitus and progressive hearing loss (usually unilateral)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110133758"
	 b:glossaryEntry="caused by consuming milk from cattle suffering from trembles"/>
<rdf:Description rdf:about="&a;110133878">
	<b:glossaryEntry>any disease that shows symptoms characteristic of another disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110134016">
	<b:glossaryEntry>any painful disorder of the joints or muscles or connective tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110134140"
	 b:glossaryEntry="a disease that attacks the gum and bone and around the teeth"/>
<rdf:Description rdf:about="&a;110134354">
	<b:glossaryEntry>chronic periodontitis; purulent inflammation of the teeth sockets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110134543"
	 b:glossaryEntry="pus pocket formation around a tooth"/>
<rdf:Description rdf:about="&a;110134642"
	 b:glossaryEntry="wasting of the bony socket"/>
<rdf:Description rdf:about="&a;110134734"
	 b:glossaryEntry="inflammation of the gums"/>
<rdf:Description rdf:about="&a;110134815"
	 b:glossaryEntry="recession of the gums"/>
<rdf:Description rdf:about="&a;110134893">
	<b:glossaryEntry>a sudden occurrence of an uncontrollable condition; "an attack of diarrhea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110135147">
	<b:glossaryEntry>a sudden acute episode of intense anxiety and feelings of panic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110135271">
	<b:glossaryEntry>a sudden occurrence (or recurrence) of a disease; "he suffered an epileptic seizure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110135453"
	 b:glossaryEntry='a slight attack of illness; "he has a touch of rheumatism"'/>
<rdf:Description rdf:about="&a;110135570">
	<b:glossaryEntry>a sudden loss of consciousness resulting when the rupture or occlusion of a blood vessel leads to oxygen lack in the brain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110135808"
	 b:glossaryEntry="violent uncontrollable contractions of muscles"/>
<rdf:Description rdf:about="&a;110135947">
	<b:glossaryEntry>a sudden uncontrollable attack; "a paroxysm of giggling"; "a fit of coughing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110136085"
	 b:glossaryEntry="an attack of hysteria"/>
<rdf:Description rdf:about="&a;110136162">
	<b:glossaryEntry>convulsion characterized by alternating contractions and relaxations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110136283"
	 b:glossaryEntry="convulsions accompanied by impaired consciousness"/>
<rdf:Description rdf:about="&a;110136451">
	<b:glossaryEntry>a seizure (or a type of epilepsy characterized by such seizures) during which the patient becomes unconscious and has convulsions over the entire body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110136697">
	<b:glossaryEntry>a seizure (or a type of epilepsy characterized by such seizures) of short duration characterized by momentary unconsciousness and local muscle spasms or twitching</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110136933"
	 b:glossaryEntry="a disorder of the nervous system"/>
<rdf:Description rdf:about="&a;110137363"
	 b:glossaryEntry="motionlessness attributable to a temporary paralysis"/>
<rdf:Description rdf:about="&a;110137481">
	<b:glossaryEntry>paralysis of the vocal cords resulting in an inability to speak</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110137597"
	 b:glossaryEntry="paralysis of the urinary bladder"/>
<rdf:Description rdf:about="&a;110137704">
	<b:glossaryEntry>a disorder of the central nervous system characterized by loss of consciousness and convulsions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110138071"
	 b:glossaryEntry="epilepsy characterized by akinesia"/>
<rdf:Description rdf:about="&a;110138169">
	<b:glossaryEntry>epilepsy in which the attack begins with an isolated disturbance of cerebral function</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110138371">
	<b:glossaryEntry>epilepsy in which the attack involves loss of consciousness and tonic spasms of the musculature followed by generalized jerking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110138586">
	<b:glossaryEntry>focal epilepsy in which the attack usually moves from distal to proximal limb muscles on the same side of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110138766">
	<b:glossaryEntry>epilepsy characterized by clonus of muscle groups and progressive mental deterioration and genetic origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110138955">
	<b:glossaryEntry>epilepsy characterized by paroxysmal attacks of brief clouding of consciousness (a possible other abnormalities)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110139196">
	<b:glossaryEntry>petit mal seizure accompanied by other abnormalities (atonia or automatisms or vasomotor changes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110139355">
	<b:glossaryEntry>petit mal seizure without other complications; followed by 3-per-sec brain-wave spikes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110139517">
	<b:glossaryEntry>transient impairment of cortical function demonstrable only by 3-per-second brain-wave spikes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110139676"
	 b:glossaryEntry="reflex epilepsy induced by music"/>
<rdf:Description rdf:about="&a;110139775"
	 b:glossaryEntry="reflex epilepsy induced by a flickering light"/>
<rdf:Description rdf:about="&a;110139886"
	 b:glossaryEntry="a convulsive epileptic state caused by a head injury"/>
<rdf:Description rdf:about="&a;110140028">
	<b:glossaryEntry>epilepsy in which a seizure is induced by whirling or running</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110140155">
	<b:glossaryEntry>epilepsy characterized clinically by impairment of consciousness and amnesia for the episode; often involves purposeful movements of the arms and legs and sometimes hallucinations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110140426">
	<b:glossaryEntry>a form of epilepsy in which attacks are induced by peripheral stimulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110140597"
	 b:glossaryEntry="focal epilepsy initiated by somatosensory phenomena"/>
<rdf:Description rdf:about="&a;110140711">
	<b:glossaryEntry>a condition in which there are continuing attacks of epilepsy without intervals of consciousness; can lead to brain damage and death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110140908"
	 b:glossaryEntry="epilepsy in which the body is rigid during the seizure"/>
<rdf:Description rdf:about="&a;110141023"
	 b:glossaryEntry="a frenzy of emotion; as for something unattainable"/>
<rdf:Description rdf:about="&a;110141131"
	 b:glossaryEntry="inability to make purposeful movements"/>
<rdf:Description rdf:about="&a;110141223">
	<b:glossaryEntry>inability to coordinate voluntary muscle movements; unsteady movements and staggering gait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110141393">
	<b:glossaryEntry>absence or loss of topognosia; inability to locate correctly a point of touch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110141542"
	 b:glossaryEntry="abnormal shortness of fingers and toes"/>
<rdf:Description rdf:about="&a;110141657">
	<b:glossaryEntry>failure of one or both testes to move into the scrotum as the male fetus develops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110141829"
	 b:glossaryEntry="abnormality in performing voluntary muscle movements"/>
<rdf:Description rdf:about="&a;110141956">
	<b:glossaryEntry>involuntary rolling of the tongue and twitching of the face or trunk or limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110142098">
	<b:glossaryEntry>a chronic progressive nervous disorder involving loss of myelin sheath around certain nerve fibers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110142291">
	<b:glossaryEntry>a degenerative disorder of the central nervous system characterized by tremor and impaired muscular coordination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110142557">
	<b:glossaryEntry>a loss or deficiency of motor control with involuntary spasms caused by permanent brain damage present at birth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110142749">
	<b:glossaryEntry>any of several degenerative nervous disorders characterized by spasmodic movements of the body and limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110142978">
	<b:glossaryEntry>weakness or loss of muscle tone resulting from injury or disease of the nerves innervating the muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110143144">
	<b:glossaryEntry>a form of chorea in which spasms occur mainly when the patient is erect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110143273">
	<b:glossaryEntry>chorea occurring chiefly in children and associated with rheumatic fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110143447">
	<b:glossaryEntry>a nervous disorder characterized by an uncontrollable impulse to dance; popularly attributed to bite of the S European tarantula or wolf spider</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110143646">
	<b:glossaryEntry>a loss of the ability to write or to express thoughts in writing because of a brain lesion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110143821">
	<b:glossaryEntry>a disorder in which a lesion to the central nervous system leaves you unable to formulate a statement or to express yourself in an organized manner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110144026"
	 b:glossaryEntry="loss of the ability to swallow"/>
<rdf:Description rdf:about="&a;110144110">
	<b:glossaryEntry>absence of the natural lens of the eye (usually resulting from the removal of cataracts)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110144252">
	<b:glossaryEntry>inability to use or understand language (spoken or written) because of a brain lesion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110144535">
	<b:glossaryEntry>an impairment in understanding spoken language that is not attributable to hearing loss</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110144720">
	<b:glossaryEntry>aphasia in which the lesion is assumed to be in the association tracts connecting the various language centers in the brain; patient''s have difficulty repeating a sentence just heard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110144989"
	 b:glossaryEntry="loss of all ability to communicate"/>
<rdf:Description rdf:about="&a;110145100">
	<b:glossaryEntry>aphasia in which expression by speech or writing is severely impaired</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110145305">
	<b:glossaryEntry>inability to name objects or to recognize written or spoken names of objects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110145506">
	<b:glossaryEntry>a general term for aphasia that results from lesions outside of Broca''s area or Wernicke''s area of the cerebral cortex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110145692"
	 b:glossaryEntry="inability to perceive written words"/>
<rdf:Description rdf:about="&a;110145814">
	<b:glossaryEntry>aphasia characterized by fluent but meaningless speech and severe impairment of the ability understand spoken or written words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110146081"
	 b:glossaryEntry="impaired ability to read"/>
<rdf:Description rdf:about="&a;110146160"
	 b:glossaryEntry="inability to recognize objects by use of the senses"/>
<rdf:Description rdf:about="&a;110146265"
	 b:glossaryEntry="closure or blockage of a blood vessel"/>
<rdf:Description rdf:about="&a;110146430">
	<b:glossaryEntry>occlusion of a blood vessel by an embolus (a loose clot or air bubble or other particle)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110146628">
	<b:glossaryEntry>obstruction of the circulatory system caused by an air bubble as e.g. accidentally during surgery or hypodermic injection or as a complication from scuba diving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110146862">
	<b:glossaryEntry>blockage of the pulmonary artery by foreign matter or by a blood clot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110146996"
	 b:glossaryEntry="occlusion by an embolus that has broken away from a thrombus"/>
<rdf:Description rdf:about="&a;110147118">
	<b:glossaryEntry>the formation or presence of a thrombus (a clot of coagulated blood attached at the site of its formation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110147354"
	 b:glossaryEntry="a blood clot in a cerebral artery or vein"/>
<rdf:Description rdf:about="&a;110147461">
	<b:glossaryEntry>occlusion of a coronary artery caused either by progressive atherosclerosis or by a blood clot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110147620">
	<b:glossaryEntry>obstruction of blood flow in a coronary artery by a blood clot (thrombus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110147789">
	<b:glossaryEntry>painful thrombosis of the femoral vein in the leg following childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110147951"
	 b:glossaryEntry="a disease of the heart or blood vessels"/>
<rdf:Description rdf:about="&a;110148149">
	<b:glossaryEntry>a disorder caused by compression of a nerve in the carpal tunnel (where the nerve passes through the wrist); characterized by discomfort and weakness in the hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110148379"
	 b:glossaryEntry="a disease of the heart"/>
<rdf:Description rdf:about="&a;110148619">
	<b:glossaryEntry>a common disorder in which blood pressure remains abnormally high</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110148819"
	 b:glossaryEntry="abnormally low blood pressure"/>
<rdf:Description rdf:about="&a;110148906">
	<b:glossaryEntry>persistent and pathological high blood pressure for which no specific cause can be found</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110149091">
	<b:glossaryEntry>severe hypertension that runs a rapid course and damages the inner linings of the blood vessels and the heart and spleen and kidneys and brain; "malignant hypertension is the most lethal form of hypertension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110149368"
	 b:glossaryEntry="hypertension that is secondary to another disease"/>
<rdf:Description rdf:about="&a;110149486"
	 b:glossaryEntry="progressive wasting of muscle tissues"/>
<rdf:Description rdf:about="&a;110149594">
	<b:glossaryEntry>thickening of tissue in the motor tracts of the lateral columns and anterior horns of the spinal cord; results in progressive muscle atrophy that starts in the limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110149864"
	 b:glossaryEntry="a sac-like widening of a blood vessel"/>
<rdf:Description rdf:about="&a;110149992"
	 b:glossaryEntry="an aneurysm of the aorta"/>
<rdf:Description rdf:about="&a;110150078"
	 b:glossaryEntry="abnormal narrowing of the aortic valve"/>
<rdf:Description rdf:about="&a;110150178"
	 b:glossaryEntry="abnormal narrowing of a bodily canal or passageway"/>
<rdf:Description rdf:about="&a;110150313"
	 b:glossaryEntry="an aneurysm of the carotid artery"/>
<rdf:Description rdf:about="&a;110150410">
	<b:glossaryEntry>a heart condition marked by paroxysms of chest pain due to reduced oxygen to the heart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110150567"
	 b:glossaryEntry="an abnormal heartbeat rhythm"/>
<rdf:Description rdf:about="&a;110150652"
	 b:glossaryEntry="sclerosis of the arterioles"/>
<rdf:Description rdf:about="&a;110150744"
	 b:glossaryEntry="sclerosis of the arterial walls"/>
<rdf:Description rdf:about="&a;110150978">
	<b:glossaryEntry>the formation of atheromas on the walls of the arteries as in atherosclerosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110151115"
	 b:glossaryEntry="abnormal fatty deposits in the intima of arteries"/>
<rdf:Description rdf:about="&a;110151219">
	<b:glossaryEntry>a stage of arteriosclerosis involving fatty deposits (atheromas) inside the arterial walls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110151397">
	<b:glossaryEntry>a continuous succession of slow writing involuntary movements of the hands and feet and other body parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110151557">
	<b:glossaryEntry>a progressive disease of the central nervous system marked by increasing lack of coordination and advancing to paralysis and death within a year of the appearance of symptoms; thought to have been transmitted by cannibalistic consumption of diseased brain tissue since the disease virtually disappeared when cannibalism was abandoned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110151941">
	<b:glossaryEntry>a stage of arteriosclerosis involving closure of blood vessels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110152077"
	 b:glossaryEntry="accumulation of serous fluid in peritoneal cavity"/>
<rdf:Description rdf:about="&a;110152180"
	 b:glossaryEntry="absence of an enzyme"/>
<rdf:Description rdf:about="&a;110152253">
	<b:glossaryEntry>transient presence of bacteria (or other microorganisms) in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110152408"
	 b:glossaryEntry="any pathological hardening or thickening of tissue"/>
<rdf:Description rdf:about="&a;110152599">
	<b:glossaryEntry>a disorder (usually of unknown origin) of the heart muscle (myocardium)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110152731">
	<b:glossaryEntry>cardiopathy resulting from the mitral valve not regulating the flow of blood between the left atrium and left ventricle of the heart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110152931">
	<b:glossaryEntry>obstruction or narrowing of the mitral valve (as by scarring from rheumatic fever)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110153099">
	<b:glossaryEntry>failure of the cardiovascular system to supply adequate amounts of blood to body tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110153253">
	<b:glossaryEntry>inability of the heart to pump enough blood to sustain normal bodily functions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110153446">
	<b:glossaryEntry>inability to pump enough blood to avoid congestion in the tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110153582"
	 b:glossaryEntry="a sudden severe instance of abnormal heart function"/>
<rdf:Description rdf:about="&a;110153748">
	<b:glossaryEntry>destruction of heart tissue resulting from obstruction of the blood supply to the heart muscle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110153955"
	 b:glossaryEntry="a disease affecting the kidneys"/>
<rdf:Description rdf:about="&a;110154101">
	<b:glossaryEntry>(pathology) inability of a bodily part or organ to function normally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110154265">
	<b:glossaryEntry>inadequate blood flow to the heart muscles; can cause angina pectoris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110154427"
	 b:glossaryEntry="insufficient excretion of wastes by the kidneys"/>
<rdf:Description rdf:about="&a;110154558">
	<b:glossaryEntry>inability of the kidneys to excrete wastes and to help maintain the electrolyte balance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110154758">
	<b:glossaryEntry>renal failure associated with burns or other trauma, or with acute infection or obstruction of the urinary tract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110154936">
	<b:glossaryEntry>renal failure that can result from a variety of systemic disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110155070"
	 b:glossaryEntry="the presence of gallstones in the gallbladder"/>
<rdf:Description rdf:about="&a;110155176"
	 b:glossaryEntry="the presence of kidney stones (calculi) in the kidney"/>
<rdf:Description rdf:about="&a;110155291"
	 b:glossaryEntry="the formation of stones (calculi) in an internal organ"/>
<rdf:Description rdf:about="&a;110155437"
	 b:glossaryEntry="an inflammation of the kidney"/>
<rdf:Description rdf:about="&a;110155559">
	<b:glossaryEntry>nephritis marked by inflammation of the glomerulus of the kidney; characterized by decreased production of urine and by the presence of blood and protein in the urine and by edema</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110155803"
	 b:glossaryEntry="a disease affecting the liver"/>
<rdf:Description rdf:about="&a;110155928">
	<b:glossaryEntry>a chronic disease interfering with the normal functioning of the liver; the major cause is chronic alcoholism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110156118"
	 b:glossaryEntry="a disorder of the glands of the body"/>
<rdf:Description rdf:about="&a;110156410">
	<b:glossaryEntry>a glandular disorder caused by failure of function of the cortex of the adrenal gland and marked by anemia and prostration with brownish skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110156675">
	<b:glossaryEntry>a glandular disease or enlargement of glandular tissue (especially of the lymph glands)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110156819"
	 b:glossaryEntry="a condition caused by over-production of aldosterone"/>
<rdf:Description rdf:about="&a;110156952">
	<b:glossaryEntry>a condition caused by blocking the airways to the lungs (as with food or swelling of the larynx)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110157102">
	<b:glossaryEntry>a glandular disorder caused by excessive ACTH resulting in greater than normal functioning of the adrenal gland; characterized by obesity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110157321"
	 b:glossaryEntry="a glandular disorder caused by excessive cortisol"/>
<rdf:Description rdf:about="&a;110157458">
	<b:glossaryEntry>any of several metabolic disorders marked by excessive urination and persistent thirst</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110157635">
	<b:glossaryEntry>diabetes of pancreatic origin characterized by insulin deficiency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110157800"
	 b:glossaryEntry="diabetes mellitus with an early onset"/>
<rdf:Description rdf:about="&a;110157994">
	<b:glossaryEntry>diabetes mellitus that develops in adults; can be precipitated by obesity or severe stress or menopause or other factors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110158224"
	 b:glossaryEntry="diabetes resulting from a disorder of the pituitary gland"/>
<rdf:Description rdf:about="&a;110158346">
	<b:glossaryEntry>pathologically excessive production of thyroid hormones; characterized by increased metabolism and exophthalmos</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110158573"
	 b:glossaryEntry="hyperthyroidism with protrusion of the eyeballs"/>
<rdf:Description rdf:about="&a;110158704">
	<b:glossaryEntry>a glandular disorder resulting from insufficient production of thyroid hormones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110158880">
	<b:glossaryEntry>marked by dry skin and swellings around lips and nose as well as mental deterioration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110159020">
	<b:glossaryEntry>severe hypothyroidism resulting in physical and mental stunting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110159139">
	<b:glossaryEntry>an inherited skeletal disorder beginning before birth; cartilage is converted to bone resulting in dwarfism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110159326">
	<b:glossaryEntry>a disease that can be communicated from one person to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110159508"
	 b:glossaryEntry="any disease easily transmitted by contact"/>
<rdf:Description rdf:about="&a;110159752"
	 b:glossaryEntry="an acute febrile highly contagious viral disease"/>
<rdf:Description rdf:about="&a;110159907">
	<b:glossaryEntry>influenza caused by the Asian virus that was first isolated in 1957</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110160032">
	<b:glossaryEntry>an acute and highly contagious viral disease marked by distinct red spots followed by a rash; occurs primarily in children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110160247">
	<b:glossaryEntry>milder than measles but damaging to the fetus during the first trimester</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110160390">
	<b:glossaryEntry>marked by the formation of a false membrane in the throat and other air passages causing difficulty in breathing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110160559">
	<b:glossaryEntry>an acute communicable disease (usually in children) characterized by fever and a red rash</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110160721">
	<b:glossaryEntry>a contagious disease characterized by purulent skin eruptions that may leave pock marks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110160894">
	<b:glossaryEntry>a highly contagious viral disease characterized by fever and weakness and skin eruption with pustules that form scabs that slough off leaving scars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110161125">
	<b:glossaryEntry>an acute communicable infection of the respiratory tract and mouth marked by ulceration of the mucous membrane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110161353">
	<b:glossaryEntry>any of several infections of the skin or mucous membrane caused by Blastomyces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110161509">
	<b:glossaryEntry>a fungal infection characterized by itchy warty nodules on the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110161642">
	<b:glossaryEntry>infections of the skin or nails caused by fungi and appearing as itching circular patches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110161914"
	 b:glossaryEntry="fungal infection of the feet"/>
<rdf:Description rdf:about="&a;110162017"
	 b:glossaryEntry="fungal infection of the face and neck"/>
<rdf:Description rdf:about="&a;110162129"
	 b:glossaryEntry="fungal infection of the scalp characterized by bald patches"/>
<rdf:Description rdf:about="&a;110162248"
	 b:glossaryEntry="fungal infection of nonhairy parts of the skin"/>
<rdf:Description rdf:about="&a;110162355"
	 b:glossaryEntry="fungal infection of the groin (most common in men)"/>
<rdf:Description rdf:about="&a;110162476"
	 b:glossaryEntry="fungal infection of the nails (especially toenails)"/>
<rdf:Description rdf:about="&a;110162587"
	 b:glossaryEntry="a disease transmitted only by a specific kind of contact"/>
<rdf:Description rdf:about="&a;110163158">
	<b:glossaryEntry>a serious (often fatal) disease of the immune system transmitted through blood products especially by sexual contact or contaminated needles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110163405">
	<b:glossaryEntry>a rare immunological disorder characterized by the virtual absence of gamma globulin in the blood and consequent susceptibility to infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110163610">
	<b:glossaryEntry>reduction or lack of an immune response to a specific antigen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110163724">
	<b:glossaryEntry>an abnormally low concentration of gamma globulin in the blood and increased risk of infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110163886">
	<b:glossaryEntry>an acute intestinal infection caused by ingestion of contaminated water or food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110164073">
	<b:glossaryEntry>an infectious disease of the tropics transmitted by mosquitoes and characterized by rash and aching head and joints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110164288"
	 b:glossaryEntry="an infection of the intestines marked by severe diarrhea"/>
<rdf:Description rdf:about="&a;110164455"
	 b:glossaryEntry="inflammation of the liver caused by a virus or a toxin"/>
<rdf:Description rdf:about="&a;110164673"
	 b:glossaryEntry="hepatitis caused by a virus"/>
<rdf:Description rdf:about="&a;110164762">
	<b:glossaryEntry>minor form of viral hepatitis caused by an RNA virus and transmitted by ingesting contaminated food or drink</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110164951">
	<b:glossaryEntry>an acute form of viral hepatitis caused by a DNA virus and transmitted by sexual contact or ingestion of contaminated blood or other bodily fluids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110165173"
	 b:glossaryEntry="a severe form of hepatitis"/>
<rdf:Description rdf:about="&a;110165279">
	<b:glossaryEntry>a viral hepatitis clinically indistinguishable from hepatitis B but caused by an RNA virus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110165461">
	<b:glossaryEntry>viral diseases causing eruptions of the skin or mucous membrane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110165613">
	<b:glossaryEntry>an infection caused by the herpes simples virus; affects the skin and nervous system; produces small temporary (but sometimes painful) blisters on the skin and mucous membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110165886"
	 b:glossaryEntry="caused by herpes simplex virus type 1 (HVS-1)"/>
<rdf:Description rdf:about="&a;110166035">
	<b:glossaryEntry>an infection caused by herpes simplex virus type 2 (HSV-2) that is usually transmitted by sexual contact; marked by recurrent attacks of painful eruptions on the skin and mucous membranes of the genital area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110166340">
	<b:glossaryEntry>eruptions along a nerve path often accompanied by severe neuralgia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110166486">
	<b:glossaryEntry>an acute contagious disease caused by herpes varicella zoster virus; causes a rash of vesicles on the face and body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110166670">
	<b:glossaryEntry>a communicable disease transmitted by sexual intercourse or genital contact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110166982">
	<b:glossaryEntry>a common venereal disease caused by the bacterium Neisseria gonorrhoeae; symptoms are painful urination and pain around the urethra</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110167189">
	<b:glossaryEntry>a venereal disease caused by the bacterium Calymmatobacterium granulomatis; characterized by a pimply rash of the skin in the genital and groin region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110167405">
	<b:glossaryEntry>a common venereal disease caused by the Treponema pallidum spirochete; symptoms change through progressive stages; can be congenital (transmitted through the placenta)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110167731">
	<b:glossaryEntry>the first stage; characterized by a chancre at the site of infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110167862">
	<b:glossaryEntry>the second stage; characterized by eruptions of the skin and mucous membrane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110168003">
	<b:glossaryEntry>the third stage; characterized by involvement of internal organs especially the brain and spinal cord as well as the heart and liver</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110168199"
	 b:glossaryEntry="syphilis of the spinal cord"/>
<rdf:Description rdf:about="&a;110168306"
	 b:glossaryEntry="wasting of the body during a chronic disease"/>
<rdf:Description rdf:about="&a;110168402">
	<b:glossaryEntry>an acute disease characterized by fever and swollen lymph nodes; some believe it can be transmitted by kissing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110168619">
	<b:glossaryEntry>chronic granulomatous communicable disease occurring in tropical and subtropical regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110168816">
	<b:glossaryEntry>leprosy characterized by tumors in the skin and cutaneous nerves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110168946">
	<b:glossaryEntry>a very serious form of leprosy characterized by lesions that spread over much of the body and affecting many systems of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110169140">
	<b:glossaryEntry>inflammation of the meninges (the tissues that surround the brain or spinal cord) caused by a bacterial infection; symptoms include headache and stiff neck and fever and nausea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110169409">
	<b:glossaryEntry>an acute inflammatory disease occurring in the intestines of premature infants; necrosis of intestinal tissue may follow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110169601">
	<b:glossaryEntry>an acute contagious viral disease characterized by fever and by swelling of the parotid glands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110169787"
	 b:glossaryEntry="meningitis caused by bacteria and often fatal"/>
<rdf:Description rdf:about="&a;110169961">
	<b:glossaryEntry>a serious (sometimes fatal) infection transmitted by the bite of an infected rat flea (especially bubonic plague)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110170194"
	 b:glossaryEntry="characterized by delirium and the formation of buboes"/>
<rdf:Description rdf:about="&a;110170326">
	<b:glossaryEntry>the epidemic form of bubonic plague experienced during the Middle Ages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110170469"
	 b:glossaryEntry="characterized by lung involvement"/>
<rdf:Description rdf:about="&a;110170565">
	<b:glossaryEntry>an especially dangerous form in which infecting organisms invade the bloodstream</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110170709">
	<b:glossaryEntry>an acute viral disease marked by inflammation of nerve cells of the brain stem and spinal cord</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110170924">
	<b:glossaryEntry>TB of the spine with destruction of vertebrae resulting in curvature of the spine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110171066">
	<b:glossaryEntry>either of two infectious diseases transmitted to humans by the bite of a rat or mouse; characterized by fever and headache and nausea and skin eruptions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110171314">
	<b:glossaryEntry>caused by ticks or mites or body lice infected with rickettsia microorganisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110171547">
	<b:glossaryEntry>transmitted by body lice and characterized by skin rash and high fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110171685">
	<b:glossaryEntry>any of several severe febrile diseases characterized by skin rashes or spots on the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110171851">
	<b:glossaryEntry>caused by a rickettsia microorganism and transmitted by wood ticks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110172022"
	 b:glossaryEntry="an acute disease resembling influenza"/>
<rdf:Description rdf:about="&a;110172113"
	 b:glossaryEntry="marked by pain in muscles and joints and transmitted by lice"/>
<rdf:Description rdf:about="&a;110172232"
	 b:glossaryEntry="transmitted by larval mites and widespread in Asia"/>
<rdf:Description rdf:about="&a;110172365">
	<b:glossaryEntry>marked by recurring high fever and transmitted by the bite of infected lice or ticks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110172529">
	<b:glossaryEntry>a severe disease chiefly of children and characterized by painful inflammation of the joints and frequently damage to the heart valves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110172725">
	<b:glossaryEntry>infection by the tubercle bacillus manifesting itself in lesions of various parts of the body (especially the lungs and bones)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110172994"
	 b:glossaryEntry="involving the lungs with progressive wasting of the body"/>
<rdf:Description rdf:about="&a;110173177">
	<b:glossaryEntry>a form of tuberculosis characterized by swellings of the lymphatic glands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110173328">
	<b:glossaryEntry>marked by intestinal inflammation and ulceration; caused by Salmonella typhosa ingested with food or water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110173520">
	<b:glossaryEntry>any of a variety of infectious intestinal diseases resembling typhoid fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110173673">
	<b:glossaryEntry>epidemic in the 15th and 16th centuries and characterized by profuse sweating and high mortality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110173849"
	 b:glossaryEntry="a disease of the respiratory mucous membrane"/>
<rdf:Description rdf:about="&a;110173984">
	<b:glossaryEntry>an infectious tropical disease resembling syphillis in its early stages; marked by red skin eruptions and ulcerating lesions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110174184"
	 b:glossaryEntry="caused by a virus transmitted by a mosquito"/>
<rdf:Description rdf:about="&a;110174314"
	 b:glossaryEntry="a disease affecting the respiratory system"/>
<rdf:Description rdf:about="&a;110174608">
	<b:glossaryEntry>a mild viral infection involving the nose and respiratory passages (but not the lungs); "will they never find a cure for the common cold?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110174847">
	<b:glossaryEntry>a common cold affecting the nasal passages and resulting in congestion and sneezing and headache</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110174999">
	<b:glossaryEntry>respiratory disorder characterized by wheezing; often of allergic origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110175196">
	<b:glossaryEntry>a prolonged and severe asthma attack that does not respond to standard treatment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110175341"
	 b:glossaryEntry="inflammation of the membranes lining the bronchial tubes"/>
<rdf:Description rdf:about="&a;110175509"
	 b:glossaryEntry="inflammation of the membranes lining the bronchioles"/>
<rdf:Description rdf:about="&a;110175621">
	<b:glossaryEntry>a form of bronchitis characterized by excess production of sputum leading to a chronic cough and obstruction of air flow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110175824">
	<b:glossaryEntry>a nonreversible lung disease that is a combination of emphysema and chronic bronchitis; usually patients have been heavy cigarette smokers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110176064">
	<b:glossaryEntry>an infection of the lungs and skin characterized by excessive sputum and nodules</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110176262">
	<b:glossaryEntry>a fungal infection characterized by nodular lesions--first in the lungs and spreading to the nervous system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110176430">
	<b:glossaryEntry>an abnormal condition of the lungs marked by decreased respiratory function; associated with smoking or chronic bronchitis or old age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110176659">
	<b:glossaryEntry>inflammation of the lungs with congestion caused by viruses or bacteria or irritants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110176853">
	<b:glossaryEntry>pneumonia occurring in persons with impaired immune systems (as AIDS victims)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110177032">
	<b:glossaryEntry>an atypical pneumonia caused by a rickettsia microorganism and transmitted to humans from infected birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110177194">
	<b:glossaryEntry>chronic disease caused by inhaling metallic or mineral particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110177429"
	 b:glossaryEntry="lung disease caused by inhaling coal dust"/>
<rdf:Description rdf:about="&a;110177582"
	 b:glossaryEntry="lung disease caused by inhaling asbestos particles"/>
<rdf:Description rdf:about="&a;110177689">
	<b:glossaryEntry>fibrosis of the lung caused by iron dust; occurs among welders and other metal workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110177831">
	<b:glossaryEntry>a lung disease caused by inhaling particles of silica or quartz or slate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110177959"
	 b:glossaryEntry="a disease or disorder that is inherited genetically"/>
<rdf:Description rdf:about="&a;110178517">
	<b:glossaryEntry>a rare inherited disorder of fat metabolism; characterized by severe deficiency of beta-lipoproteins and abnormal red blood cells (acanthocytes) and abnormally low cholesterol levels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110178766"
	 b:glossaryEntry="a congenital absence of eyelids (partial or complete)"/>
<rdf:Description rdf:about="&a;110178876">
	<b:glossaryEntry>the congenital absence of pigmentation in the eyes and skin and hair</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110178999"
	 b:glossaryEntry="an abnormally large braincase"/>
<rdf:Description rdf:about="&a;110179088">
	<b:glossaryEntry>a defect in brain development resulting in small or missing brain hemispheres</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110179238"
	 b:glossaryEntry="congenital absence of fingers and/or toes"/>
<rdf:Description rdf:about="&a;110179359"
	 b:glossaryEntry="congenital absence of the uterus"/>
<rdf:Description rdf:about="&a;110179445"
	 b:glossaryEntry="genetic inability to distinguish differences in hue"/>
<rdf:Description rdf:about="&a;110179669">
	<b:glossaryEntry>a congenital abnormality in males in which the urethra is on the upper surface of the penis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110179817"
	 b:glossaryEntry="inability to distinguish green and purplish-red"/>
<rdf:Description rdf:about="&a;110179953"
	 b:glossaryEntry="inability to distinguish blue and yellow"/>
<rdf:Description rdf:about="&a;110180067"
	 b:glossaryEntry="inability to distinguish red and purplish blue"/>
<rdf:Description rdf:about="&a;110180186">
	<b:glossaryEntry>a congenital disease in which the pancreas and lungs and intestines become clogged with mucus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110180419">
	<b:glossaryEntry>a rare chronic disorder of lipid metabolism probably of genetic origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110180553"
	 b:glossaryEntry="hereditary; develops in adulthood and ends in dementia"/>
<rdf:Description rdf:about="&a;110180714">
	<b:glossaryEntry>hereditary condition in which certain anesthetics (e.g., halothane) cause high body temperatures and muscle rigidity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110180899">
	<b:glossaryEntry>an autosomal dominant disease characterized by elongated bones (especially of limbs and digits) and abnormalities of the eyes and circulatory system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110181111">
	<b:glossaryEntry>a hereditary disorder characterized by low levels of beta-lipoproteins and lipids and cholesterol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110181278">
	<b:glossaryEntry>a congenital defect in which the top of the head is depressed (concave instead of convex)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110181443">
	<b:glossaryEntry>a congenital defect in which one or more toes or fingers are abnormally positioned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110181584">
	<b:glossaryEntry>a congenital disorder characterized by an abnormally large tongue; often seen in cases of Down''s syndrome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110181748">
	<b:glossaryEntry>a congenital disorder caused by having an extra 21st chromosome; results in a flat face and short stature and mental retardation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110182012">
	<b:glossaryEntry>an inherited disorder of metabolism in which the urine has a odor characteristic of maple syrup; if untreated it can lead to mental retardation and death in early childhood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110182256">
	<b:glossaryEntry>an inherited disease in which abnormal amounts of glycogen accumulate in skeletal muscle; results in weakness and cramping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110182442">
	<b:glossaryEntry>any of several hereditary diseases of the muscular system characterized by weakness and wasting of skeletal muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110182676">
	<b:glossaryEntry>the most common form of muscular dystrophy; X-linked recessive (affecting only males)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110182868"
	 b:glossaryEntry="a disease caused by a dominant mutant gene on an autosome"/>
<rdf:Description rdf:about="&a;110183052">
	<b:glossaryEntry>a disease caused by the presence of two recessive mutant genes on an autosome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110183275">
	<b:glossaryEntry>an autosomal recessive form of muscular dystrophy characterized by progressive muscular weakness beginning either in the shoulder or pelvic girdle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110183516">
	<b:glossaryEntry>a severe form of muscular dystrophy marked by facial weakness and drooping eyelids and difficult speech and difficulty with the hands that spreads to the arms and shoulders and legs and hips</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110183822">
	<b:glossaryEntry>a disorder of lipid metabolism that is inherited as an autosomal recessive trait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110183969">
	<b:glossaryEntry>a congenital abnormality of the skull; the top of the skull assumes a cone shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110184120">
	<b:glossaryEntry>anemia characterized by pancytopenia resulting from failure of the bone marrow; can be caused by neoplasm or by toxic exposure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110184308">
	<b:glossaryEntry>severe anemia in newborn babies; the result of Rh incompatibility between maternal and fetal blood; typically occurs when the child of an Rh-negative mother inherits Rh-positive blood from the father; can be diagnosed before birth by amniocentesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110184626"
	 b:glossaryEntry="a congenital heart disease producing cyanosis"/>
<rdf:Description rdf:about="&a;110184758">
	<b:glossaryEntry>a rare congenital anemia characterized by pancytopenia and hypoplasia of the bone marrow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110184953"
	 b:glossaryEntry="anemia resulting from destruction of erythrocytes"/>
<rdf:Description rdf:about="&a;110185085">
	<b:glossaryEntry>anemia characterized by an increase in the concentration of corpuscular hemoglobin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110185233">
	<b:glossaryEntry>anemia characterized by a decrease in the concentration of corpuscular hemoglobin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110185397">
	<b:glossaryEntry>anemia resulting from inadequately functioning bone marrow; can develop into aplastic anemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110185554">
	<b:glossaryEntry>a form of anemia due to lack of iron in the diet or to iron loss as a result of chronic bleeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110185737">
	<b:glossaryEntry>iron deficiency anemia in young women; characterized by weakness and menstrual disturbances and a green color to the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110185930">
	<b:glossaryEntry>anemia in which the average size of erythrocytes is larger than normal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110186064">
	<b:glossaryEntry>anemia in which the average size of erythrocytes is smaller than normal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110186218">
	<b:glossaryEntry>a chronic progressive anemia of older adults; thought to result from a lack of intrinsic factor (a substance secreted by the stomach that is responsible for the absorption of vitamin B-12)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110186525">
	<b:glossaryEntry>anemia characterized by many large immature and dysfunctional red blood cells (megaloblasts) in the bone marrow; associated with pernicious anemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110186738">
	<b:glossaryEntry>pernicious anemia in which the various formed elements in the blood are changed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110186882">
	<b:glossaryEntry>any of various anemic conditions that are not successfully treated by any means other than blood transfusions (and that are not associated with another primary disease)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110187132">
	<b:glossaryEntry>refractory anemia characterized by sideroblasts in the bone marrow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110187289">
	<b:glossaryEntry>a deficiency of iron; results from inadequate iron in the diet or from hemorrhage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110187428">
	<b:glossaryEntry>a congenital form of anemia occurring mostly in blacks; characterized by abnormal blood cells having a crescent shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110187695">
	<b:glossaryEntry>a congenital progressive disorder of lipid metabolism having an onset at age 5 and characterized by blindness and dementia and early death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110187931">
	<b:glossaryEntry>a hereditary disorder of lipid metabolism occuring most frequently in individuals of E European Jewish descent; accumulation of lipids in nervous tissue results in death in early childhood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110188240">
	<b:glossaryEntry>a rare autosomal recessive disease in which the platelets do not produce clots in the normal way and hemorrhage results</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110188420">
	<b:glossaryEntry>congenital tendency to uncontrolled bleeding; usually affects males and is transmitted from mother to son</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110188688">
	<b:glossaryEntry>the absence of fibrinogen in the plasma leading to prolonged bleeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110188837">
	<b:glossaryEntry>hemophilia caused by a congenital deficiency of factor VIII; occurs almost exclusively in men</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110188989">
	<b:glossaryEntry>a clotting disorder similar to hemophilia A but caused by a congenital deficiency of factor IX</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110189162"
	 b:glossaryEntry="a form of hemophilia discovered by von Willebrand"/>
<rdf:Description rdf:about="&a;110189295">
	<b:glossaryEntry>a rare congenital disorder of blood coagulation in which no fibrinogen is found in the blood plasma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110189485"
	 b:glossaryEntry="a disease characterized by inflammation"/>
<rdf:Description rdf:about="&a;110189826">
	<b:glossaryEntry>inflammation of the stomach and intestines; caused by Salmonella enteritidis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110189996">
	<b:glossaryEntry>often fatal form occurring in children; not true cholera but having similar symptoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110190143">
	<b:glossaryEntry>an inflammatory disease characterized by a rash with joint swelling and fever; caused by the bite of a deer tick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110190314">
	<b:glossaryEntry>inflammation of the female pelvic organs (especially the Fallopian tubes) caused by infection by any of several microorganisms (chiefly gonococci and chlamydia); symptoms are abdominal pain and fever and foul-smelling vaginal discharge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110190629"
	 b:glossaryEntry="inflammation of the pleura (especially the parietal layer)"/>
<rdf:Description rdf:about="&a;110190742"
	 b:glossaryEntry="inflammation of the fauces and pharynx"/>
<rdf:Description rdf:about="&a;110190883">
	<b:glossaryEntry>any disease of the throat or fauces marked by spasmodic attacks of intense suffocative pain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110191081">
	<b:glossaryEntry>a painful inflammation of the tonsils and surrounding tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110191195">
	<b:glossaryEntry>a disease of infants and young children; harsh coughing and hoarseness and fever and difficult breathing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110191374"
	 b:glossaryEntry="a slight illness"/>
<rdf:Description rdf:about="&a;110191450">
	<b:glossaryEntry>invasion of the body by pathogenic microorganisms causing inflammation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110191936"
	 b:glossaryEntry="infection by a disease-causing ameba"/>
<rdf:Description rdf:about="&a;110192084">
	<b:glossaryEntry>inflammation of the intestines caused by Endamoeba histolytica; usually acquired by ingesting food or water contaminated with feces; characterized by severe diarrhea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110192350"
	 b:glossaryEntry="an inflammatory condition caused by a fungus"/>
<rdf:Description rdf:about="&a;110192575">
	<b:glossaryEntry>a viral infection (usually restricted to a specific geographic area); fever and gastrointestinal symptoms are followed by capillary hemorrhage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110192781">
	<b:glossaryEntry>a viral infection (usually in children) marked by sore throat and fever and papules in the mouth and throat and headache and abdominal pain; usually subsides in a short time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110193010">
	<b:glossaryEntry>the presence of pus-forming bacteria or their toxins in the blood or tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110193175">
	<b:glossaryEntry>an acute and serious infection of the central nervous system caused by bacterial infection of open wounds; spasms of the jaw and laryngeal muscles are a symptom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110193399">
	<b:glossaryEntry>a tropical infection caused by protozoa of the genus Leishmania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110193558"
	 b:glossaryEntry="leishmaniasis of the viscera"/>
<rdf:Description rdf:about="&a;110193671">
	<b:glossaryEntry>leishmaniasis of the skin; characterized by ulcerative skin lesions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110193867">
	<b:glossaryEntry>an infection with a parasite of the genus Schistosoma; common in the tropics and Far East; symptoms depend on the part of the body infected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110194095">
	<b:glossaryEntry>an infection caused by fungi of the genus Monilia or Candida (especially Candida albicans)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110194330"
	 b:glossaryEntry="a chronic fungal infection of the skin and lymph nodes"/>
<rdf:Description rdf:about="&a;110194445">
	<b:glossaryEntry>candidiasis of the oral cavity; seen mostly in infants or debilitated adults</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110194574">
	<b:glossaryEntry>a purulent infection at the end of a finger or toe in the area surrounding the nail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110194719">
	<b:glossaryEntry>bacterial infection limited to a specific organ or region especially one causing symptoms elsewhere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110194899">
	<b:glossaryEntry>a central point or locus of bacterial growth in an organism; "the focus of infection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110195063">
	<b:glossaryEntry>any infection caused by a microorganism that does not normally cause disease in humans; occurs in persons with abnormally functioning immune systems (as AIDS patients or transplant patients receiving immunosuppressive drugs)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110195393">
	<b:glossaryEntry>an opportunistic infection by a fungus of the genus Aspergillus; characterized by inflammation and lesions of the ear and other organs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110195587">
	<b:glossaryEntry>an opportunistic infection causing a serious form of pneumonia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110195710"
	 b:glossaryEntry="an open skin infection"/>
<rdf:Description rdf:about="&a;110195855"
	 b:glossaryEntry="a painful sore with a hard pus-filled core"/>
<rdf:Description rdf:about="&a;110195977"
	 b:glossaryEntry="a boil or abscess on the gums"/>
<rdf:Description rdf:about="&a;110196060"
	 b:glossaryEntry="an inflammatory swelling or sore"/>
<rdf:Description rdf:about="&a;110196162">
	<b:glossaryEntry>inflammation of the hands and feet caused by exposure to cold and moisture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110196332"
	 b:glossaryEntry="ulcerated chilblain on the heel"/>
<rdf:Description rdf:about="&a;110196414">
	<b:glossaryEntry>an infection larger than a boil and with several openings for discharge of pus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110196548">
	<b:glossaryEntry>abnormal formation of cartilage from other tissues; observed in some Orientals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110196692">
	<b:glossaryEntry>a small hard painless nodule at the site of entry of a pathogen (as syphilis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110196861"
	 b:glossaryEntry="a sore that has become inflamed and formed pus"/>
<rdf:Description rdf:about="&a;110196979"
	 b:glossaryEntry="a skin sore caused by chafing"/>
<rdf:Description rdf:about="&a;110197077"
	 b:glossaryEntry="sore on a horseback rider chafed by a saddle"/>
<rdf:Description rdf:about="&a;110197179">
	<b:glossaryEntry>an acute infection of the intestine by Shigella bacteria; characterized by diarrhea and fever and abdominal pains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110197372">
	<b:glossaryEntry>an infection with Staphylococcus bacteria; usually marked by abscess formation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110197557">
	<b:glossaryEntry>an infection of the oral pharynx and tonsils by streptococcus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110197771"
	 b:glossaryEntry="an infection of the sebaceous gland of the eyelid"/>
<rdf:Description rdf:about="&a;110197905"
	 b:glossaryEntry="any inadvertent infection of humans by an animal pathogen"/>
<rdf:Description rdf:about="&a;110198035"
	 b:glossaryEntry="inflammation of a joint or joints"/>
<rdf:Description rdf:about="&a;110198196">
	<b:glossaryEntry>a chronic autoimmune disease with inflammation of the joints and marked deformities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110198435">
	<b:glossaryEntry>any of a large group of diseases characterized by abnormal functioning of the immune system that causes it to produce antibodies against your own tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110198781">
	<b:glossaryEntry>a form of rheumatoid arthritis usually affecting fingers and toes and associated with psoriasis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110198942">
	<b:glossaryEntry>a form of rheumatoid arthritis that affects children; large joints become inflamed and bone growth may be retarded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110199150">
	<b:glossaryEntry>chronic breakdown of cartilage in the joints occurring usually after middle age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110199344"
	 b:glossaryEntry="swelling of the bursa in the knee"/>
<rdf:Description rdf:about="&a;110199440"
	 b:glossaryEntry="inflammation of the urinary bladder and ureters"/>
<rdf:Description rdf:about="&a;110199542">
	<b:glossaryEntry>an encephalitis that was epidemic between 1915 and 1926; symptoms include paralysis of the extrinsic eye muscle and extreme muscular weakness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110199840">
	<b:glossaryEntry>a painful inflammation of the big toe and foot caused by defects in uric acid metabolism resulting in deposits of the acid and its salts in the blood and joints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110200083">
	<b:glossaryEntry>arthritis that affects one or more of the intervertebral joints in the spine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110200222"
	 b:glossaryEntry="a disease or disorder of the blood"/>
<rdf:Description rdf:about="&a;110200693">
	<b:glossaryEntry>invasion of the bloodstream by virulent microorganisms from a focus of infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110200898">
	<b:glossaryEntry>blood poisoning caused by putrefactive bacteria; results from eating putrified matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110201050"
	 b:glossaryEntry="blood poisoning caused by toxic substances in the blood"/>
<rdf:Description rdf:about="&a;110201170">
	<b:glossaryEntry>an abnormal condition of pregnancy characterized by hypertension and edema and protein in the urine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110201382">
	<b:glossaryEntry>characterized by convulsions and possibly coma during or immediately after pregnancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110201522">
	<b:glossaryEntry>characterized by hypertension and fluid retention and albuminuria; can lead to eclampsia if untreated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110201682">
	<b:glossaryEntry>a blood disease characterized by the presence of abnormal hemoglobins in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110201847">
	<b:glossaryEntry>inflammatory histiocytosis associated with disturbance of cholesterol metabolism; occurs chiefly in young children and is characterized by cystic defects of the skull and diabetes insipidus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110202143"
	 b:glossaryEntry="the form of ratbite fever occurring in the United States"/>
<rdf:Description rdf:about="&a;110202261">
	<b:glossaryEntry>a blood disease characterized by an abnormal multiplication of macrophages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110202413">
	<b:glossaryEntry>a blood disorder characterized by the presence of excess lipids in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110202599">
	<b:glossaryEntry>a blood disorder consisting of a decrease in the volume of circulating blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110202733"
	 b:glossaryEntry="a deficiency of red blood cells"/>
<rdf:Description rdf:about="&a;110203061">
	<b:glossaryEntry>an inherited form of anemia caused by faulty synthesis of hemoglobin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110203243">
	<b:glossaryEntry>a fatal form of thalassemia in which there is no hemoglobin; skeletal deformations; heart and spleen and liver enlarged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110203444"
	 b:glossaryEntry="an abnormal lowering of the white blood cell count"/>
<rdf:Description rdf:about="&a;110203582">
	<b:glossaryEntry>leukopenia in which the decrease is primarily in number of neutrophils (the chief phagocytic leukocyte)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110203761"
	 b:glossaryEntry="neutropenia that occurs periodically"/>
<rdf:Description rdf:about="&a;110203862">
	<b:glossaryEntry>a blood disorder characterized by the presence of microcytes (abnormally small red blood cells) in the blood; often associated with anemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110204078">
	<b:glossaryEntry>a disorder characterized by an abnormal reduction in the blood of erythrocytes and leukocytes and blood platelets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110204250">
	<b:glossaryEntry>a disorder characterized by an abnormal increase in the number of red blood cells in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110204403"
	 b:glossaryEntry="any of several blood diseases causing subcutaneous bleeding"/>
<rdf:Description rdf:about="&a;110204545">
	<b:glossaryEntry>purpura of unknown origin associated with a reduction in circulating blood platelets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110204799">
	<b:glossaryEntry>the primary form of thrombocytopenia (rather than a shortage of platelets caused by with other conditions such as tuberculosis or chemical suppression of bone marrow etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110205043">
	<b:glossaryEntry>a blood disease characterized by an abnormally small number of platelets in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110205224">
	<b:glossaryEntry>any disease caused by a lack of an essential nutrient (as a vitamin or mineral)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110205440"
	 b:glossaryEntry="the presence of one or more cysts in a breast"/>
<rdf:Description rdf:about="&a;110205636">
	<b:glossaryEntry>any of several diseases caused by deficiency of one or more vitamins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110205871">
	<b:glossaryEntry>an abnormal condition resulting from taking vitamins excessively; can be serious for vitamins A or D or K</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110206039"
	 b:glossaryEntry="caused by lack of thiamine (vitamin B1)"/>
<rdf:Description rdf:about="&a;110206133"
	 b:glossaryEntry="enlarged thyroid gland resulting from iodine deficiency"/>
<rdf:Description rdf:about="&a;110206259">
	<b:glossaryEntry>a state of poor nutrition; can result from insufficient or excessive or unbalanced diet or from inability to absorb foods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110206457">
	<b:glossaryEntry>extreme malnutrition and emaciation (especially in children); can result from inadequate intake of food or from malabsorption or metabolic disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110206660">
	<b:glossaryEntry>a deficiency caused by inadequate zinc in the diet or by liver disease or cystic fibrosis or other diseases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110206829">
	<b:glossaryEntry>caused by deficiency of niacin (vitamin B3; nicotinic acid) and protein</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110206955">
	<b:glossaryEntry>childhood disease caused by deficiency of vitamin D and sunlight associated with impaired metabolism of calcium and phosphorus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110207146">
	<b:glossaryEntry>a condition caused by deficiency of ascorbic acid (vitamin C)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110207260">
	<b:glossaryEntry>an often persistent bodily disorder or disease; a cause for complaining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110207439"
	 b:glossaryEntry="a cyst containing blood"/>
<rdf:Description rdf:about="&a;110207569"
	 b:glossaryEntry="a cystic tumor (usually benign) of the ovary"/>
<rdf:Description rdf:about="&a;110207672">
	<b:glossaryEntry>a small sebaceous cyst of the eyelid resulting when a Meibomian gland is blocked</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110207825">
	<b:glossaryEntry>a common cyst of the skin; filled with fatty matter (sebum) that is secreted by a sebaceous gland that has been blocked</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110208058"
	 b:glossaryEntry="a closed sac that develops abnormally in some body structure"/>
<rdf:Description rdf:about="&a;110208223"
	 b:glossaryEntry="a minor nonspecific ailment"/>
<rdf:Description rdf:about="&a;110208300">
	<b:glossaryEntry>the state of being dizzy or nauseated because of traveling in a moving vehicle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110208512">
	<b:glossaryEntry>motion sickness experienced while traveling by air (especially during turbulence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110208652"
	 b:glossaryEntry="motion sickness experienced while traveling in an car"/>
<rdf:Description rdf:about="&a;110208764"
	 b:glossaryEntry="motion sickness experienced while traveling on water"/>
<rdf:Description rdf:about="&a;110208899"
	 b:glossaryEntry="collapse caused by exposure to excessive heat"/>
<rdf:Description rdf:about="&a;110209037">
	<b:glossaryEntry>a condition marked by dizziness and nausea and weakness caused by depletion of body fluids and electrolytes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110209225">
	<b:glossaryEntry>sudden prostration due to exposure to the sun or excessive heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110209384">
	<b:glossaryEntry>the presence of endometrium elsewhere than in the lining of the uterus; causes premenstrual pain and dysmenorrhea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110209571"
	 b:glossaryEntry="any deviation from a healthy or normal condition"/>
<rdf:Description rdf:about="&a;110210377"
	 b:glossaryEntry="abnormal union of bodily tissues; most common in the abdomen"/>
<rdf:Description rdf:about="&a;110210528"
	 b:glossaryEntry="an abnormal adhesion of two or more structures"/>
<rdf:Description rdf:about="&a;110210630">
	<b:glossaryEntry>adhesions between the iris and the lens or cornea resulting from trauma or eye surgery of as a complication of glaucoma or cataract; can lead to blindness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110210875"
	 b:glossaryEntry="adhesion between the iris and the cornea"/>
<rdf:Description rdf:about="&a;110210979"
	 b:glossaryEntry="adhesion between the iris and the lens"/>
<rdf:Description rdf:about="&a;110211082">
	<b:glossaryEntry>localized necrosis resulting from obstruction of the blood supply</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110211232"
	 b:glossaryEntry="the presence of macrocytes in the blood"/>
<rdf:Description rdf:about="&a;110211330"
	 b:glossaryEntry="development of excess fibrous connective tissue in an organ"/>
<rdf:Description rdf:about="&a;110211481"
	 b:glossaryEntry="fibrosis of the bone marrow"/>
<rdf:Description rdf:about="&a;110211568"
	 b:glossaryEntry="a state of abnormal softening of tissue"/>
<rdf:Description rdf:about="&a;110211679">
	<b:glossaryEntry>abnormal softening of bones caused by deficiencies of phosphorus or calcium or vitamin D</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110211845">
	<b:glossaryEntry>an inherited disorder characterized by an increase in bone density; in severe forms the bone marrow cavity may be obliterated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110212080">
	<b:glossaryEntry>abnormal loss of bony tissue resulting in fragile porous bones; common in postmenopausal women</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110212233"
	 b:glossaryEntry="abnormal loss of mineral salts (especially from bone)"/>
<rdf:Description rdf:about="&a;110212368"
	 b:glossaryEntry="discharge of pus"/>
<rdf:Description rdf:about="&a;110212451">
	<b:glossaryEntry>accumulation in the blood of nitrogen-bearing waste products (urea) that are usually excreted in the urine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110212643"
	 b:glossaryEntry="excess of urea in the urine"/>
<rdf:Description rdf:about="&a;110212725"
	 b:glossaryEntry="any visible abnormal structural change in a bodily part"/>
<rdf:Description rdf:about="&a;110212869"
	 b:glossaryEntry="a swelling that is the characteristic lesion of tuberculosis"/>
<rdf:Description rdf:about="&a;110212984">
	<b:glossaryEntry>an inflammatory and often suppurating lesion on the skin or an internal mucous surface resulting in necrosis of tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110213257">
	<b:glossaryEntry>a chronic ulcer of the skin caused by prolonged pressure on it (as in bedridden patients)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110213418"
	 b:glossaryEntry="infectious venereal ulcer"/>
<rdf:Description rdf:about="&a;110213499"
	 b:glossaryEntry="an ulcer of mucuous membrane of the alimentary tract"/>
<rdf:Description rdf:about="&a;110213628"
	 b:glossaryEntry="a peptic ulcer of the stomach"/>
<rdf:Description rdf:about="&a;110213717">
	<b:glossaryEntry>an ulceration (especially of the lips or living of the mouth)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110213831"
	 b:glossaryEntry="a cancerous ulcer of soft tissue and bone"/>
<rdf:Description rdf:about="&a;110213934"
	 b:glossaryEntry="a condition of suffering or distress due to ill health"/>
<rdf:Description rdf:about="&a;110214063">
	<b:glossaryEntry>(medical) a curving or bending; often abnormal; "curvature of the spine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110214191">
	<b:glossaryEntry>an affliction in which some part of the body is misshapen or malformed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110214420">
	<b:glossaryEntry>a deformity of the foot characterized by an abnormally high arch and hyperextension of the toes which gives the foot the appearance of a claw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110214628">
	<b:glossaryEntry>a deformity in which the space between the third and fourth toes extends up into the foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110214774"
	 b:glossaryEntry="a congenital cleft in the middle of the upper lip"/>
<rdf:Description rdf:about="&a;110214905"
	 b:glossaryEntry="a congenital fissure of the hard palate"/>
<rdf:Description rdf:about="&a;110215003">
	<b:glossaryEntry>congenital deformity of the foot usually marked by a curled shape or twisted position of the ankle and heel and toes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110215184"
	 b:glossaryEntry="abnormal protrusion of the breastbone caused by rickets"/>
<rdf:Description rdf:about="&a;110215316"
	 b:glossaryEntry="any plant disease resulting in withering without rotting"/>
<rdf:Description rdf:about="&a;110215875">
	<b:glossaryEntry>a disease of alders caused by the woolly alder aphid (a plant louse)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110216002"
	 b:glossaryEntry="a disease of apple trees"/>
<rdf:Description rdf:about="&a;110216100"
	 b:glossaryEntry="a disease of beet plants"/>
<rdf:Description rdf:about="&a;110216182"
	 b:glossaryEntry="a disease of tea plants"/>
<rdf:Description rdf:about="&a;110216266"
	 b:glossaryEntry="a disease of Scotch pines"/>
<rdf:Description rdf:about="&a;110216352">
	<b:glossaryEntry>a disease affecting the canes of various bush fruits (e.g., raspberries or currants)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110216494"
	 b:glossaryEntry="a fungous leaf spot disease of the celery plant"/>
<rdf:Description rdf:about="&a;110216602"
	 b:glossaryEntry="a disease of American chestnut trees"/>
<rdf:Description rdf:about="&a;110216742"
	 b:glossaryEntry="a blight affecting the coffee plant"/>
<rdf:Description rdf:about="&a;110216837"
	 b:glossaryEntry="a disease affecting the trunks of pear and apple trees"/>
<rdf:Description rdf:about="&a;110216951"
	 b:glossaryEntry="a disease blackening the leaves of pear and apple trees"/>
<rdf:Description rdf:about="&a;110217096"
	 b:glossaryEntry="a phase of fire blight in which cankers appear"/>
<rdf:Description rdf:about="&a;110217202"
	 b:glossaryEntry="a blight of bean plants"/>
<rdf:Description rdf:about="&a;110217309"
	 b:glossaryEntry="a blight affecting the leaves of oats and other grasses"/>
<rdf:Description rdf:about="&a;110217422"
	 b:glossaryEntry="a blight of the heads of cereals"/>
<rdf:Description rdf:about="&a;110217530"
	 b:glossaryEntry="a disease of the heads of wheat plants"/>
<rdf:Description rdf:about="&a;110217625">
	<b:glossaryEntry>blight in which symptoms appear late in the growing season especially a disease of solanaceous plants caused by the fungus Phytophthora infestans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110217846">
	<b:glossaryEntry>any blight causing a browning and falling of the leaves of a plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110218006"
	 b:glossaryEntry="a disease of conifers causing the needles to fall"/>
<rdf:Description rdf:about="&a;110218141"
	 b:glossaryEntry="a black plant louse that lives on oaks and dogwoods"/>
<rdf:Description rdf:about="&a;110218249"
	 b:glossaryEntry="a disease of trees bearing drupes"/>
<rdf:Description rdf:about="&a;110218341"
	 b:glossaryEntry="a blight of potatoes"/>
<rdf:Description rdf:about="&a;110218485"
	 b:glossaryEntry="a disease of tea plants"/>
<rdf:Description rdf:about="&a;110218565"
	 b:glossaryEntry="a disease of spinach plants"/>
<rdf:Description rdf:about="&a;110218653"
	 b:glossaryEntry="a disease of raspberries"/>
<rdf:Description rdf:about="&a;110218735"
	 b:glossaryEntry="a fungous blight attacking the stems of plants"/>
<rdf:Description rdf:about="&a;110218839"
	 b:glossaryEntry="a disease of oats"/>
<rdf:Description rdf:about="&a;110218916"
	 b:glossaryEntry="a disease of tropical woody plants(cocoa or tea or citrus)"/>
<rdf:Description rdf:about="&a;110219034"
	 b:glossaryEntry="a disease of tomato plants"/>
<rdf:Description rdf:about="&a;110219137"
	 b:glossaryEntry="a disease of the ends of twigs of woody plants"/>
<rdf:Description rdf:about="&a;110219241"
	 b:glossaryEntry="a disease of English walnut trees"/>
<rdf:Description rdf:about="&a;110219334">
	<b:glossaryEntry>a mild viral disease transmitted by the bite of the sand fly Phlebotomus papatasii</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110219508"
	 b:glossaryEntry="a disease affecting the skin"/>
<rdf:Description rdf:about="&a;110220009">
	<b:glossaryEntry>tuberculosis of the skin; appears first on the face and heals slowly leaving deep scars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110220175">
	<b:glossaryEntry>a chronic inflammatory collagen disease affecting connective tissue (skin or joints)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110220420">
	<b:glossaryEntry>a chronic skin disease occurring primarily in women between the ages of 20 and 40; characterized by an eruption of red lesions over the cheeks and bridge of the nose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110220683">
	<b:glossaryEntry>a breakdown of a cell layer in the epidermis (as in pemphigus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110220823">
	<b:glossaryEntry>an abnormal but benign thickening of the prickle-cell layer of the skin (as in psoriasis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110220988">
	<b:glossaryEntry>a skin disease characterized by dark wart-like patches in the body folds; can be benign or malignant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110221155">
	<b:glossaryEntry>an inflammatory disease involving the sebaceous glands of the skin; characterized by papules or pustules or comedones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110221396">
	<b:glossaryEntry>a skin disease of adults (more often women) in which blood vessels of the face enlarge resulting in a flushed appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110221585">
	<b:glossaryEntry>the most common form of acne; usually affects people from puberty to young adulthood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110221729"
	 b:glossaryEntry="dermatitis caused exposure to sunlight"/>
<rdf:Description rdf:about="&a;110221832"
	 b:glossaryEntry="dermatitis characterized by atopy"/>
<rdf:Description rdf:about="&a;110221929">
	<b:glossaryEntry>an allergic contact dermatitis developed around the lips of children who chew bubble gum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110222085">
	<b:glossaryEntry>a delayed type of allergic reaction of the skin resulting from skin contact with a specific allergen (such as poison ivy)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110222289"
	 b:glossaryEntry="a dermatitis of the scalp that is common in infants"/>
<rdf:Description rdf:about="&a;110222397">
	<b:glossaryEntry>dermatitis of the thighs and buttocks of infants; supposedly caused by ammonia in the urine in the child''s diapers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110222589">
	<b:glossaryEntry>a severe dermatitis of herbivorous domestic animals attributable to photosensitivity from eating Saint John''s wort</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110222760">
	<b:glossaryEntry>a sensitization reaction to repeated invasion of the skin by cercariae of schistosomes (human or animal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110222950"
	 b:glossaryEntry="generic term for inflammatory conditions of the skin"/>
<rdf:Description rdf:about="&a;110223055">
	<b:glossaryEntry>a very contagious infection of the skin; common in children; localized redness develops into small blisters that gradually crust and erode</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110223248"
	 b:glossaryEntry="induced by a tropical climate"/>
<rdf:Description rdf:about="&a;110223334">
	<b:glossaryEntry>a skin condition marked by an overgrowth of layers of horny skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110223526">
	<b:glossaryEntry>an overgrowth of skin layers resulting from extended exposure to the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110223662">
	<b:glossaryEntry>a rare hereditary condition marked by dark crusted patches (sometimes containing pus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110223816">
	<b:glossaryEntry>a skin condition characterized by circumscribed wartlike lesions that can be itchy and covered with a greasy crust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110223997">
	<b:glossaryEntry>a congenital skin condition characterized by spots or bands of unpigmented skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110224133"
	 b:glossaryEntry="any of several forms of ulcerative skin disease"/>
<rdf:Description rdf:about="&a;110224286">
	<b:glossaryEntry>a condition characterized by abnormal deposits of melanin (especially in the skin)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110224435">
	<b:glossaryEntry>a chronic skin disease characterized by dry red patches covered with scales; occurs especially on the scalp and ears and genitalia and the skin over bony prominences</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110224675">
	<b:glossaryEntry>a skin disease characterized by large thin-walled blisters (bullae) arising from normal skin or mucous membrane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110224861"
	 b:glossaryEntry="any of several inflammatory or gangrenous skin conditions"/>
<rdf:Description rdf:about="&a;110225021">
	<b:glossaryEntry>an acute streptococcal infection characterized by deep-red inflammation of the skin and mucous membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110225182">
	<b:glossaryEntry>poisoning by ergot-infected grain products and characterized by inflamed skin or gangrene in the limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110225339">
	<b:glossaryEntry>a condition in which overactivity of the sebaceous glands causes the skin to become oily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110225483">
	<b:glossaryEntry>a chronic skin disease associated with seborrhea and greasy scales on the scalp or eyelids or other parts of the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110225668">
	<b:glossaryEntry>an acquired skin disease characterized by patches of unpigmented skin (often surrounded by a heavily pigmented border)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110225841">
	<b:glossaryEntry>a skin problem marked by the development (on the eyelids and neck and back) of irregular yellow nodules; sometimes attributable to disturbances of cholesterol metabolism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110226065"
	 b:glossaryEntry="an abnormal yellow discoloration of the skin"/>
<rdf:Description rdf:about="&a;110226165">
	<b:glossaryEntry>(pathology) an abnormal proliferation of tissue (as in a tumor)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110226335"
	 b:glossaryEntry="a small vascular growth on the surface of a mucous membrane"/>
<rdf:Description rdf:about="&a;110226475"
	 b:glossaryEntry="the thin process of tissue that attaches a polyp to the body"/>
<rdf:Description rdf:about="&a;110226609"
	 b:glossaryEntry="an abnormal new mass of tissue that serves no purpose"/>
<rdf:Description rdf:about="&a;110227022"
	 b:glossaryEntry="a neoplasm originating in the epidermis"/>
<rdf:Description rdf:about="&a;110227117"
	 b:glossaryEntry="a benign epithelial tumor of glandular origin"/>
<rdf:Description rdf:about="&a;110227216"
	 b:glossaryEntry="a tumor consisting of a mass of blood or lymphatic vessels"/>
<rdf:Description rdf:about="&a;110227400"
	 b:glossaryEntry="a common benign tumor of cartilage cells"/>
<rdf:Description rdf:about="&a;110227496"
	 b:glossaryEntry="a tumor that is not cancerous"/>
<rdf:Description rdf:about="&a;110227647"
	 b:glossaryEntry="a tumor in the brain"/>
<rdf:Description rdf:about="&a;110227743"
	 b:glossaryEntry="a tumor of the brain consisting of neuroglia"/>
<rdf:Description rdf:about="&a;110227859">
	<b:glossaryEntry>a small tumor (benign or malignant) arising from the mucosa of the gastrointestinal tract; usually associated with excessive secretion of serotonin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110228062"
	 b:glossaryEntry="an abdominal tumor"/>
<rdf:Description rdf:about="&a;110228134">
	<b:glossaryEntry>(medical) a malignant state; progressive and resistant to treatment and tending to cause death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110228335">
	<b:glossaryEntry>new connective tissue and tiny blood vessels that form on the surfaces of a wound during the healing process</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110228540">
	<b:glossaryEntry>a tumor composed of granulation tissue resulting from injury or inflammation or infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110228703">
	<b:glossaryEntry>a small rubbery granuloma that is characteristic of an advanced stage of syphilis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110228836"
	 b:glossaryEntry="a tumor consisting of fatty tissue"/>
<rdf:Description rdf:about="&a;110228939">
	<b:glossaryEntry>a tumor that is malignant and tends to spread to other parts of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110229149">
	<b:glossaryEntry>a tumor arising in the meninges which surround the brain and spinal cord; usually slow growing and sometimes malignant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110229324">
	<b:glossaryEntry>any malignant growth or tumor caused by abnormal and uncontrolled cell division; it may spread to other parts of the body through the lymphatic system or the blood stream</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110229619"
	 b:glossaryEntry="a malignant neoplasm of cartilage cells"/>
<rdf:Description rdf:about="&a;110229719">
	<b:glossaryEntry>a malignant neoplasm of nerve tissue and fibrous tissue and connective tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110229875">
	<b:glossaryEntry>malignant bone tumor; most common in children and young adults where it tends to affect the femur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110230052">
	<b:glossaryEntry>a neoplasm of lymph tissue that is usually malignant; one of the four major types of cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110230216">
	<b:glossaryEntry>a malignant disorder in which there is progressive (but painless) enlargement of lymph tissue followed by enlargement of the spleen and liver</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110230421">
	<b:glossaryEntry>any malignant tumor derived from epithelial tissue; one of the four major types of cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110230764"
	 b:glossaryEntry="the most common form of skin cancer"/>
<rdf:Description rdf:about="&a;110230880">
	<b:glossaryEntry>malignant neoplasm of blood-forming tissues; characterized by abnormal proliferation of leukocytes; one of the four major types of cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110231142"
	 b:glossaryEntry="rapidly progressing leukemia"/>
<rdf:Description rdf:about="&a;110231267">
	<b:glossaryEntry>acute leukemia characterized by proliferation of immature lymphoblast-like cells in bone marrow, lymph nodes, spleen, and blood; most common in children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110231523">
	<b:glossaryEntry>acute leukemia characterized by proliferation of granular leukocytes; most common in adolescents and young adults</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110231733"
	 b:glossaryEntry="slowly progressing leukemia"/>
<rdf:Description rdf:about="&a;110231859">
	<b:glossaryEntry>chronic leukemia characterized by lymphoblast-like cells; more common in older men</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110232016">
	<b:glossaryEntry>chronic leukemia characterized by granular leukocytes; more common in older people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110232191">
	<b:glossaryEntry>a usually malignant tumor arising from connective tissue (bone or muscle etc.); one of the four major types of cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110232434">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a sarcoma that starts with purplish spots on the and spreads from the skin to the lymph nodes and internal organs; a common manifestation of AIDS; "until 1980 Karposi''s sarcoma occurred almost exclusively with Jewish or Italian or black men"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110232738"
	 b:glossaryEntry="malignant tumor originating in glandular epithelium"/>
<rdf:Description rdf:about="&a;110232850">
	<b:glossaryEntry>cancer of the breast; one of the most common malignancies in women in the US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110232986">
	<b:glossaryEntry>a cluster of malignant cells that has not yet invaded the deeper epithelial tissue or spread to other parts of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110233190">
	<b:glossaryEntry>a malignant tumor of the colon; early symptom is bloody stools</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110233311"
	 b:glossaryEntry="malignant neoplasm of the testis"/>
<rdf:Description rdf:about="&a;110233409"
	 b:glossaryEntry="cancer of the uterine lining"/>
<rdf:Description rdf:about="&a;110233526"
	 b:glossaryEntry="angioma consisting of a mass of blood vessels"/>
<rdf:Description rdf:about="&a;110233660">
	<b:glossaryEntry>a congenital bright red superficial vascular tumor resembling a strawberry; tends to decrease in size during childhood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110233871"
	 b:glossaryEntry="angioma consisting of a mass of lymphatic vessels"/>
<rdf:Description rdf:about="&a;110233979">
	<b:glossaryEntry>a dilation of superficial capillaries with a central red dot from which blood vessels radiate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110234166">
	<b:glossaryEntry>a tumor of the bone marrow (usually malignant) composed of cells normally found in bone marrow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110234332"
	 b:glossaryEntry="myeloma that develops in several places at the same time"/>
<rdf:Description rdf:about="&a;110234451"
	 b:glossaryEntry="a tumor composed of muscle tissue"/>
<rdf:Description rdf:about="&a;110234536"
	 b:glossaryEntry="a tumor of bone tissue"/>
<rdf:Description rdf:about="&a;110234612"
	 b:glossaryEntry="a benign epithelial tumor forming a rounded mass"/>
<rdf:Description rdf:about="&a;110234763">
	<b:glossaryEntry>a tumor derived from fibrous tissue of the meninges or choroid plexus or certain other structures associated with the brain; characterized by sand-like particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110234992"
	 b:glossaryEntry="one of the commonest forms of cancer"/>
<rdf:Description rdf:about="&a;110235086">
	<b:glossaryEntry>a rare form of carcinoma of the mesothelium lining lungs or abdomen or heart; usually associated with exposure to asbestos dust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110235272"
	 b:glossaryEntry="cancer of the pancreas"/>
<rdf:Description rdf:about="&a;110235358">
	<b:glossaryEntry>malignant tumor of the testis; usually occurring in older men</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110235494"
	 b:glossaryEntry="a malignant neoplasm of the skin"/>
<rdf:Description rdf:about="&a;110235638"
	 b:glossaryEntry="a malignant tumor of the epithelial tissue"/>
<rdf:Description rdf:about="&a;110235738">
	<b:glossaryEntry>any of several malignant neoplasms (usually of the skin) consisting of melanocytes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110235896"
	 b:glossaryEntry="a disease of the eye"/>
<rdf:Description rdf:about="&a;110236028">
	<b:glossaryEntry>increased pressure in the eyeball causes damage to the optic disc and impaired vision (sometimes progressing to blindness)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110236205">
	<b:glossaryEntry>a chronic contagious viral disease marked by inflammation of the conjunctiva and cornea of the eye and the formation of scar tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110236391"
	 b:glossaryEntry="clouding of the natural lens of the eye"/>
<rdf:Description rdf:about="&a;110236485"
	 b:glossaryEntry="inflammation of a gland or lymph node"/>
<rdf:Description rdf:about="&a;110236577">
	<b:glossaryEntry>inflammation of the alveoli in the lungs caused by inhaling dust; with repeated exposure the condition may become chronic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110236791">
	<b:glossaryEntry>inflammation in the socket of a tooth; sometimes occurs after a tooth is extracted and a blood clot fails to form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110236974"
	 b:glossaryEntry="inflammation of a blood vessel or lymph duct"/>
<rdf:Description rdf:about="&a;110237091"
	 b:glossaryEntry="inflammation of the aorta"/>
<rdf:Description rdf:about="&a;110237170"
	 b:glossaryEntry="inflammation of the vermiform appendix"/>
<rdf:Description rdf:about="&a;110237267"
	 b:glossaryEntry="inflammation of an artery"/>
<rdf:Description rdf:about="&a;110237348"
	 b:glossaryEntry="severe conjunctivitis"/>
<rdf:Description rdf:about="&a;110237459">
	<b:glossaryEntry>ophthalmia in newborns; contracted while passing through the birth canal; usually prevented with silver nitrate drops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110237644"
	 b:glossaryEntry="inflammation of the sheath surrounding a tendon"/>
<rdf:Description rdf:about="&a;110237751"
	 b:glossaryEntry="a disease that typically does not affect human beings"/>
<rdf:Description rdf:about="&a;110238711">
	<b:glossaryEntry>disease of cattle that can be transmitted to humans; results from infection with actinomycetes; characterized by hard swellings that exude pus through long sinuses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110238988">
	<b:glossaryEntry>the commonest and least severe form of actinomycosis; affects the face and neck regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110239161"
	 b:glossaryEntry="a serious form of actinomycosis that affects the chest"/>
<rdf:Description rdf:about="&a;110239284"
	 b:glossaryEntry="a serious form of actinomycosis that affects the abdomen"/>
<rdf:Description rdf:about="&a;110239410">
	<b:glossaryEntry>alveolitis caused by an allergic reaction to fungal spores in the dust that is inhaled from moldy hay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110239571">
	<b:glossaryEntry>a disease of cattle that is transmitted by cattle ticks; similar to Texas fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110239709">
	<b:glossaryEntry>a highly infectious animal disease (especially cattle and sheep); it can be transmitted to people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110239876">
	<b:glossaryEntry>severe respiratory disease of birds that takes the form of an acute rapidly fatal pneumonia in young chickens and turkeys</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110240077">
	<b:glossaryEntry>inflammation of the lungs caused by inhaling or choking on vomitus; may occur during unconsciousness (anesthesia or drunkenness or seizure or cardiac arrest)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110240301"
	 b:glossaryEntry="alveolitis caused by inhaling bagasse (sugarcane dust)"/>
<rdf:Description rdf:about="&a;110240425"
	 b:glossaryEntry="inflammation of the head of the penis"/>
<rdf:Description rdf:about="&a;110240518"
	 b:glossaryEntry="inflammation of both the head of the penis and the foreskin"/>
<rdf:Description rdf:about="&a;110240639">
	<b:glossaryEntry>any of various diseases of animals characterized by edema of the head and neck</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110240771">
	<b:glossaryEntry>inflammation of the eyelids characterized by redness and swelling and dried crusts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110240911"
	 b:glossaryEntry="inflammation of a bursa; frequently in the shoulder"/>
<rdf:Description rdf:about="&a;110241035">
	<b:glossaryEntry>an infectious disease often resulting in abortion; transmittable to humans through contaminated milk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110241215"
	 b:glossaryEntry="a disease of pigs resulting in swelling of the snout"/>
<rdf:Description rdf:about="&a;110241323"
	 b:glossaryEntry="chorea in dogs"/>
<rdf:Description rdf:about="&a;110241406">
	<b:glossaryEntry>a fatal disease of fresh-water fish caused by a flagellated protozoan invading the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110241549">
	<b:glossaryEntry>a viral disease of cattle causing a mild skin disease affecting the udder; used to innoculate humans against smallpox</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110241730">
	<b:glossaryEntry>a disease of cattle and sheep attributed to a dietary deficiency; characterized by anemia and softening of the bones and a slow stiff gait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110241921">
	<b:glossaryEntry>an acute infectious disease characterized by pneumonia and blood infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110242081">
	<b:glossaryEntry>an acute diarrheal disease (especially of chickens) caused by the microorganism that causes hemorrhagic septicemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110242254">
	<b:glossaryEntry>an acute viral disease of domestic fowl; characterized by refusal to each and high temperature and discoloration of the comb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110242434"
	 b:glossaryEntry="highly infectious virus disease"/>
<rdf:Description rdf:about="&a;110242523"
	 b:glossaryEntry="any of various infectious diseases of animals"/>
<rdf:Description rdf:about="&a;110242660">
	<b:glossaryEntry>a viral disease of young dogs characterized by high fever and respiratory inflammation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110242809">
	<b:glossaryEntry>an acute bacterial disease of horses characterized by inflammation of the mucous membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110242974">
	<b:glossaryEntry>a disease of cattle and sheep that is attributed to toxins absorbed from the intestines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110243121">
	<b:glossaryEntry>acute contagious disease of cloven-footed animals marked by ulcers in the mouth and around the hoofs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110243315">
	<b:glossaryEntry>contagious degenerative infection of the feet of hoofed animals (especially cattle and sheep)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110243463">
	<b:glossaryEntry>a disease of the liver (especially in sheep and cattle) caused by liver flukes and their by-products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110243647"
	 b:glossaryEntry="a destructive and contagious bacterial disease of horses"/>
<rdf:Description rdf:about="&a;110243758">
	<b:glossaryEntry>a chronic emphysema of the horse that causes difficult expiration and heaving of the flanks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110243916">
	<b:glossaryEntry>a viral disease of green monkeys; when transmitted to humans it causes serious or fatal illness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110244120">
	<b:glossaryEntry>the presence of excessive protein (chiefly albumin but also globulin) in the urine; usually a symptom of kidney disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110244312">
	<b:glossaryEntry>abnormal presence of amino acids in the urine; usually a symptom of metabolic defects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110244457"
	 b:glossaryEntry="excessive ammonia in the urine"/>
<rdf:Description rdf:about="&a;110244544">
	<b:glossaryEntry>a purplish discoloration of the mucuous membrane of the vagina that occurs early in pregnancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110244701">
	<b:glossaryEntry>an abnormal increase of ketone bodies in the blood as in diabetes mellitus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110244854">
	<b:glossaryEntry>excessive amounts of ketone bodies in the urine as in diabetes mellitus or starvation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110245023">
	<b:glossaryEntry>an acute viral disease of the nervous system of warm-blooded animals (usually transmitted by the bite of a rabid animal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110245220"
	 b:glossaryEntry="a disease of cattle; characterized by hematuria"/>
<rdf:Description rdf:about="&a;110245323"
	 b:glossaryEntry="an respiratory infection of the nose and throat in cattle"/>
<rdf:Description rdf:about="&a;110245442">
	<b:glossaryEntry>an acute infectious viral disease of cattle (usually fatal); characterized by fever and diarrhea and inflammation of mucous membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110245648"
	 b:glossaryEntry="diarrhea in livestock"/>
<rdf:Description rdf:about="&a;110245722">
	<b:glossaryEntry>a deadly form of septicemia in cattle and sheep; involves high fever and pneumonia; contracted under conditions of exposure or exhaustion (as often happens when the animals are shipped to market)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110245999">
	<b:glossaryEntry>a swelling of the hock joint of a horse; resulting in lameness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110246168"
	 b:glossaryEntry="spavin caused by distension of the veins"/>
<rdf:Description rdf:about="&a;110246267"
	 b:glossaryEntry="spavin caused by collection of fluids"/>
<rdf:Description rdf:about="&a;110246361"
	 b:glossaryEntry="spavin caused by a bony growth"/>
<rdf:Description rdf:about="&a;110246449">
	<b:glossaryEntry>an infectious disease cause by leptospira and transmitted to humans from domestic animals; characterized by jaundice and fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110246685">
	<b:glossaryEntry>an acute feverish disease in people and in dogs marked by gastroenteritis and mild jaundice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110246837"
	 b:glossaryEntry="a severe form of leptospirosis in human beings"/>
<rdf:Description rdf:about="&a;110246944">
	<b:glossaryEntry>a disease of livestock caused by locoweed poisoning; characterized by weakness and lack of coordination and trembling and partial paralysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110247152">
	<b:glossaryEntry>an persistent and contagious disease of the skin causing inflammation and itching and loss of hair; affects domestic animals (and sometimes people)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110247351">
	<b:glossaryEntry>a contagious skin infection caused by the itch mite (Sarcoptes scaboi); characterized by persistent itching and skin irritation; "he has a bad case of the itch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110247572">
	<b:glossaryEntry>infection that occurs while you are being treated for another infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110247704"
	 b:glossaryEntry="a secondary infection caused by an opportunistic infection"/>
<rdf:Description rdf:about="&a;110247823"
	 b:glossaryEntry="infection of the vagina"/>
<rdf:Description rdf:about="&a;110247907">
	<b:glossaryEntry>recurrent eye inflammation in horses; sometimes resulting in blindness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110248048"
	 b:glossaryEntry="any plaguelike disease of domestic animals"/>
<rdf:Description rdf:about="&a;110248144"
	 b:glossaryEntry="a viral disease (usually fatal) of rabbits"/>
<rdf:Description rdf:about="&a;110248244"
	 b:glossaryEntry="disease of domestic fowl and other birds"/>
<rdf:Description rdf:about="&a;110248348"
	 b:glossaryEntry="a disease of poultry"/>
<rdf:Description rdf:about="&a;110248418"
	 b:glossaryEntry="infectious disease of birds"/>
<rdf:Description rdf:about="&a;110248535"
	 b:glossaryEntry="a serious bacterial disease of young chickens"/>
<rdf:Description rdf:about="&a;110248670">
	<b:glossaryEntry>an open sore on the back of a horse caused by ill-fitting or badly adjusted saddle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110248817">
	<b:glossaryEntry>a fissure in the wall of a horse''s hoof often causing lameness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110248972"
	 b:glossaryEntry="a crack on the forepart of a horse''s hindfoot"/>
<rdf:Description rdf:about="&a;110249073"
	 b:glossaryEntry="a crack on the inside of a horse''s forefoot"/>
<rdf:Description rdf:about="&a;110249176"
	 b:glossaryEntry="a disease of cattle (especially calves)"/>
<rdf:Description rdf:about="&a;110249279">
	<b:glossaryEntry>an infectious disease of cattle transmitted by the cattle tick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110249399">
	<b:glossaryEntry>disease of livestock and especially cattle poisoned by eating certain kinds of snakeroot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110249558">
	<b:glossaryEntry>disease of rodents (especially rabbits and squirrels) and sometimes transmitted to humans by ticks or flies or by handling infected animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110249817"
	 b:glossaryEntry="a disease that affects plants"/>
<rdf:Description rdf:about="&a;110250464">
	<b:glossaryEntry>a reddish-brown discoloration of leaves and stems caused by a rust fungus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110250606">
	<b:glossaryEntry>any of several diseases of pines caused by rust fungi of the genus Cronartium and marked by destructive invasion of bark and sapwood and producing blisters externally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110250875"
	 b:glossaryEntry="any of various diseases in which the central tissues blacken"/>
<rdf:Description rdf:about="&a;110250992">
	<b:glossaryEntry>disease of plum and cherry trees characterized by black excrescences on the branches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110251133">
	<b:glossaryEntry>a fungous disease causing darkening and decay of the leaves of fruits and vegetables</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110251273">
	<b:glossaryEntry>fungous disease of lettuce that first rots lower leaves and spreads upward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110251404">
	<b:glossaryEntry>any of certain fungous diseases of plants characterized by browning and decay of tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110251584">
	<b:glossaryEntry>disease of citrus trees caused by the fungus Phytophthora citrophthora</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110251730">
	<b:glossaryEntry>pathological production of gummy exudates in citrus and various stone-fruit trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110251866">
	<b:glossaryEntry>disease of tomatoes and potatoes and tobacco etc caused by the bacterium Pseudomonas solanacearum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110252048"
	 b:glossaryEntry="a fungus disease of cranberries"/>
<rdf:Description rdf:about="&a;110252137">
	<b:glossaryEntry>a bacterial disease of plants (especially pome and stone fruits and grapes and roses) which forms excrescences on the stem near the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110252350">
	<b:glossaryEntry>a phase of crown gall (especially in apples) during which there is abnormal development of fine fibrous roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110252516">
	<b:glossaryEntry>a fungous disease of alfalfa which forms white excrescences at the base of the stem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110252656">
	<b:glossaryEntry>a plant disease caused by a fungus; diseased condition of seedlings in excessive moisture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110252803">
	<b:glossaryEntry>a disease of plants characterized by the gradula dying of the young shoots starting at the tips and progressing to the larger branches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110252991">
	<b:glossaryEntry>a crumbling and drying of timber or bulbs or potatoes or fruit caused by a fungus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110253126">
	<b:glossaryEntry>any plant disease in which the central part of a plant rots (especially in trees)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110253262">
	<b:glossaryEntry>viral disease in solanaceous plants (tomatoes; potatoes; tobacco) resulting in mottling and often shriveling of the leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110253473"
	 b:glossaryEntry="a disease of the leaves of potato plants"/>
<rdf:Description rdf:about="&a;110253573">
	<b:glossaryEntry>a plant disease causing discoloration of the leaves of tobacco plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110253703">
	<b:glossaryEntry>disease of a wide range of plants (tomatoes; potatoes; peas) resulting from a mixed infection of potato and tomato mosaic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110253884">
	<b:glossaryEntry>disease caused by rhizoctinia or fungi of Pellicularia and Corticium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110254036"
	 b:glossaryEntry="rhizoctinia disease of potatoes"/>
<rdf:Description rdf:about="&a;110254166">
	<b:glossaryEntry>serious bark disease of many tropical crop trees (coffee; citrus; rubber); branches have a covering of pink hyphae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110254339">
	<b:glossaryEntry>fungous disease causing dark warty spongy excrescences in the eyes of potato tubers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110254480"
	 b:glossaryEntry="disease characterized by root decay; caused by various fungi"/>
<rdf:Description rdf:about="&a;110254595">
	<b:glossaryEntry>disease of sweet potatoes in which roots are girdled by rings of dry rot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110254735">
	<b:glossaryEntry>plant disease cause by fungi of the genus Sclerotium; also one in which sclerotia are formed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110254909"
	 b:glossaryEntry="disease of elms caused by a fungus"/>
<rdf:Description rdf:about="&a;110255007"
	 b:glossaryEntry="a plant disease caused by the ergot fungus"/>
<rdf:Description rdf:about="&a;110255101"
	 b:glossaryEntry="plant disease in which the stem or trunk rots at the base"/>
<rdf:Description rdf:about="&a;110255213"
	 b:glossaryEntry="a bacterial wilt of tobacco plants"/>
<rdf:Description rdf:about="&a;110255308"
	 b:glossaryEntry="a fungal disease of onions"/>
<rdf:Description rdf:about="&a;110255389">
	<b:glossaryEntry>any plant disease characterized by drooping and shriveling; usually caused by parasites attacking the roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110255616"
	 b:glossaryEntry="caused by fungi of the genus Fusarium"/>
<rdf:Description rdf:about="&a;110255713"
	 b:glossaryEntry="caused by soil-borne fungi of the genus Verticillium"/>
<rdf:Description rdf:about="&a;110255826">
	<b:glossaryEntry>destructive diseases of plants (especially cereal grasses) caused by fungi that produce black powdery masses of spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110256067"
	 b:glossaryEntry="disease of grains; the entire head is a dusty mass of spores"/>
<rdf:Description rdf:about="&a;110256184">
	<b:glossaryEntry>disease of wheat characterized by replacement of the grains with greasy masses of smelly smut spores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110256351"
	 b:glossaryEntry="smut affecting leaves and stems of cereals and other grasses"/>
<rdf:Description rdf:about="&a;110256467">
	<b:glossaryEntry>disease of rice; grains covered by a green powder consisting of conidia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110256608"
	 b:glossaryEntry="mushy or slimy decay of plants caused by bacteria or fungi"/>
<rdf:Description rdf:about="&a;110256739"
	 b:glossaryEntry="soft watery rot in fruits and vegetables caused by fungi"/>
<rdf:Description rdf:about="&a;110256846">
	<b:glossaryEntry>any of several virus diseases of plants characterized by stunting and yellowing of the leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110257034"
	 b:glossaryEntry="the yellow dwarf disease of potato plants"/>
<rdf:Description rdf:about="&a;110257166"
	 b:glossaryEntry="the yellow dwarf disease of onion plants"/>
<rdf:Description rdf:about="&a;110257271">
	<b:glossaryEntry>any of several fungous or viral diseases characterized by yellow spotting on the leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110257434">
	<b:glossaryEntry>an emotional wound or shock often having long-lasting effects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110257548"
	 b:glossaryEntry="any physical damage to the body"/>
<rdf:Description rdf:about="&a;110257907">
	<b:glossaryEntry>any break in the skin or an organ caused by violence or surgical incision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110258149"
	 b:glossaryEntry="a wound that exposes subcutaneous tissue"/>
<rdf:Description rdf:about="&a;110258245"
	 b:glossaryEntry="marks resembling the wounds on the crucified body of Christ"/>
<rdf:Description rdf:about="&a;110258359"
	 b:glossaryEntry="an abraded area where the skin is torn or worn off"/>
<rdf:Description rdf:about="&a;110258533"
	 b:glossaryEntry="a superficial abrasion"/>
<rdf:Description rdf:about="&a;110258607">
	<b:glossaryEntry>abrasion (usually on the hands) caused by friction from a rope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110258725"
	 b:glossaryEntry='a wound made by cutting; "he put a bandage over the cut"'/>
<rdf:Description rdf:about="&a;110258854"
	 b:glossaryEntry="a torn ragged wound"/>
<rdf:Description rdf:about="&a;110258930"
	 b:glossaryEntry="an injury resulting from getting some body part squeezed"/>
<rdf:Description rdf:about="&a;110259038"
	 b:glossaryEntry="a wound resulting from biting"/>
<rdf:Description rdf:about="&a;110259154"
	 b:glossaryEntry="a bite inflicted by a dog"/>
<rdf:Description rdf:about="&a;110259234"
	 b:glossaryEntry="a bite inflicted by a (venomous) snake"/>
<rdf:Description rdf:about="&a;110259328"
	 b:glossaryEntry="a painful wound caused by the thrust of a stinger into skin"/>
<rdf:Description rdf:about="&a;110259514"
	 b:glossaryEntry="a sting inflicted by a bee"/>
<rdf:Description rdf:about="&a;110259596"
	 b:glossaryEntry="sting inflicted by a flea"/>
<rdf:Description rdf:about="&a;110259678"
	 b:glossaryEntry="a sting inflicted by a mosquito"/>
<rdf:Description rdf:about="&a;110259769">
	<b:glossaryEntry>an injury that doesn''t break the skin but results in some discoloration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110259923"
	 b:glossaryEntry="a bruise caused by a blow to the eye"/>
<rdf:Description rdf:about="&a;110260024"
	 b:glossaryEntry="a lump on the body caused by a blow"/>
<rdf:Description rdf:about="&a;110260110">
	<b:glossaryEntry>an injury cause by exposure to fire or chemicals or radiation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110260330"
	 b:glossaryEntry="a surface burn"/>
<rdf:Description rdf:about="&a;110260405"
	 b:glossaryEntry="a burn cause by hot liquid or steam"/>
<rdf:Description rdf:about="&a;110260492">
	<b:glossaryEntry>a state of reduced excitement or anxiety that is induced by the administrative of a sedative agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110260645">
	<b:glossaryEntry>inflammation of the skin caused by exposure to the rays of the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110260783">
	<b:glossaryEntry>a browning of the skin resulting from exposure to the rays of the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110260928"
	 b:glossaryEntry="redness of the skin surface"/>
<rdf:Description rdf:about="&a;110261019">
	<b:glossaryEntry>blisters on the skin and superficial destruction of the dermis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110261146"
	 b:glossaryEntry="characterized by destruction of both epidermis and dermis"/>
<rdf:Description rdf:about="&a;110261267">
	<b:glossaryEntry>breaking of hard tissue such as bone; "it was a nasty fracture"; "the break seems to have been caused by a fall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110261622"
	 b:glossaryEntry="fracture in which the bone is splintered or crushed"/>
<rdf:Description rdf:about="&a;110261739"
	 b:glossaryEntry="break involving the entire width of the bone"/>
<rdf:Description rdf:about="&a;110261847">
	<b:glossaryEntry>bone fracture associated with lacerated soft tissue or an open wound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110261995">
	<b:glossaryEntry>fracture in which the bone collapses (especially in short bones such as vertebrae)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110262144"
	 b:glossaryEntry="fracture of the skull where the bone is pushed in"/>
<rdf:Description rdf:about="&a;110262258">
	<b:glossaryEntry>fracture in which the two ends of the broken bone are separated from one another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110262403">
	<b:glossaryEntry>fracture resulting from excessive activity rather than a specific injury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110262556">
	<b:glossaryEntry>a partial fracture of a bone (usually in children); the bone is bent but broken on only one side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110262718">
	<b:glossaryEntry>fracture that does not go across the entire width of the bone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110262863">
	<b:glossaryEntry>fracture in which one broken end is wedged into the other broken end</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110262995">
	<b:glossaryEntry>an uncomplicated fracture in which the broken bones to not pierce the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110263149">
	<b:glossaryEntry>a displacement of a part (especially a bone) from its normal position (as in the shoulder or the vertebral column)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110263375"
	 b:glossaryEntry="dislocation of a joint"/>
<rdf:Description rdf:about="&a;110263458">
	<b:glossaryEntry>separation of an epiphysis from the long bone to which it is normally attached without fracture of the bone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110263621">
	<b:glossaryEntry>a forward dislocation of one vertebra over the one beneath it producing pressure on spinal nerves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110263782"
	 b:glossaryEntry="state of being torn or burst open"/>
<rdf:Description rdf:about="&a;110263905">
	<b:glossaryEntry>rupture in smooth muscle tissue through which a bodily structure protrudes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110264099">
	<b:glossaryEntry>a herniation through the muscular wall of a tubular organ (especially the colon)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110264256">
	<b:glossaryEntry>a congenital diverticulum in the ileum resulting from incomplete closure of the yolk sac</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110264412">
	<b:glossaryEntry>a painful rupture of the fibrocartilage of the disc between spinal vertebrae; occurs most often in the lumbar region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110264635"
	 b:glossaryEntry="hernia projecting into the vagina"/>
<rdf:Description rdf:about="&a;110264755">
	<b:glossaryEntry>hernia in which the urinary bladder protrudes through the wall of the vagina; sometimes occurs after childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110264939">
	<b:glossaryEntry>protrusion of the intestine and omentum through a hernia in the abdominal wall near the navel; usually self correcting after birth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110265132">
	<b:glossaryEntry>injury to a muscle (often caused by overuse); results in swelling and pain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110265259">
	<b:glossaryEntry>an injury to the neck (the cervical vertebrae) resulting from rapid acceleration or deceleration (as in an automobile accident)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110265459"
	 b:glossaryEntry="a raised mark on the skin (as produced by a blow)"/>
<rdf:Description rdf:about="&a;110265581">
	<b:glossaryEntry>a sharp strain on muscles or ligaments; "the wrench to his knee occurred as he fell"; "he was sidelined with a hamstring pull"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110265793">
	<b:glossaryEntry>a painful injury to a joint caused by a sudden wrenching of its ligaments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110265919">
	<b:glossaryEntry>destruction of tissue by freezing and characterized by tingling, blistering and possibly gangrene</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110266102">
	<b:glossaryEntry>resembling frostbite but without freezing; resulting from exposure to cold and wet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110266258">
	<b:glossaryEntry>(medical) any sensation or change in bodily function that is experienced by a patient and is associated with a particular disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110267738">
	<b:glossaryEntry>(medical) any objective evidence of the presence of a disorder or disease; "there were no signs of asphixiation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110267920">
	<b:glossaryEntry>an abnormal deficiency or absence of free hydrochloric acid in the gastric juice; often associated with severe anemias and cancer of the stomach</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110268123"
	 b:glossaryEntry="absence of gastric juices (partial or complete)"/>
<rdf:Description rdf:about="&a;110268243"
	 b:glossaryEntry="absence or suppression of normal menstrual flow"/>
<rdf:Description rdf:about="&a;110268406">
	<b:glossaryEntry>a sensation (as of a cold breeze or bright light) that precedes the onset of certain disorders such as a migraine attack or epileptic seizure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110268598">
	<b:glossaryEntry>a tan discoloration of a woman''s face that is associated with pregnancy or with the use of oral contraceptives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110268793">
	<b:glossaryEntry>a condition in which the ends of toes and fingers become wide and thick; a symptom of heart or lung disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110268955">
	<b:glossaryEntry>a bluish discoloration of the skin and mucous membranes; a sign that oxygen in the blood is dangerously diminished (as in carbon monoxide poisoning)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110269195">
	<b:glossaryEntry>cyanosis of the extremities; can occur when a spasm of the blood vessels is caused by exposure to cold or by strong emotion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110269394"
	 b:glossaryEntry="delay of menarche beyond age 18"/>
<rdf:Description rdf:about="&a;110269490">
	<b:glossaryEntry>cessation of menstruation in a woman who had previously menstruated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110269624">
	<b:glossaryEntry>an early symptom that a disease is developing or that an attack is about to occur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110269760"
	 b:glossaryEntry="a pattern of symptoms indicative of some disease"/>
<rdf:Description rdf:about="&a;110270044">
	<b:glossaryEntry>an abnormal condition resulting from compression of spinal nerve roots in the neck region; involves neck pains and muscular weakness and paresthesia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110270286">
	<b:glossaryEntry>headache and tingling or burning feelings and sweating caused by eating food that contains monosodium glutamate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110270471">
	<b:glossaryEntry>disturbances in salt-water balance and symptoms of weakness and muscular cramps and twitching and convulsions and sometimes paralysis; usually caused by a benign tumor of the cortex of the adrenal gland that leads to excess secretion of aldosterone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110270781">
	<b:glossaryEntry>a condition in which body deformation or facial development or mental ability of a fetus is impaired because the mother drank alcohol while pregnant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110270998">
	<b:glossaryEntry>a serious chronic and progressive inflammation of the colon producing frequent bouts of diarrhea with abdominal pain and nausea and fever and weight loss</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110271234">
	<b:glossaryEntry>recurrent abdominal pain and diarrhea (often alternating with periods of constipation); often associated with emotional stress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110271464">
	<b:glossaryEntry>a serious chronic inflammatory disease of the large intestine and rectum characterized by recurrent episodes of abdominal pain and fever and chills and profuse diarrhea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110271697">
	<b:glossaryEntry>a pattern of symptoms including loss of appetite and bloating and weight loss and muscle pain and steatorrhea; associated with celiac disease and sprue and cystic fibrosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110271937">
	<b:glossaryEntry>a sleep disorder characterized by sudden and uncontrollable episodes of deep sleep; "he believes that narcolepsy is attributable to an inability to suppress REM sleep during waking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110272175">
	<b:glossaryEntry>a syndrome that occurs in many women from 2 to 14 days before the onset of menstruation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110272336">
	<b:glossaryEntry>discomfort and vascular symptoms and loss of sensation in a shoulder and arm; caused by a scalene muscle compressing the subclavian artery and part of the brachial plexus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110272570">
	<b:glossaryEntry>sudden and unexpected death of an apparently healthy infant during sleep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110272749">
	<b:glossaryEntry>tingling sensations in the fingers; caused by compression on a nerve supplying the arm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110272906">
	<b:glossaryEntry>a symptom caused by an illness or a drug; "the effects of sleep loss"; "the effect of the anesthetic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110273096">
	<b:glossaryEntry>a delayed effect of a drug or therapy; "the drug had unexpected aftereffects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110273231">
	<b:glossaryEntry>a secondary and usually adverse effect of a drug or therapy; "severe headaches are one of the side effects of the drug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110273408"
	 b:glossaryEntry="localized collection of pus surrounded by inflamed tissue"/>
<rdf:Description rdf:about="&a;110273575"
	 b:glossaryEntry="a common form of abscess of the tissue around a tooth"/>
<rdf:Description rdf:about="&a;110273689"
	 b:glossaryEntry="the tip of an abscess (where the pus accumulates)"/>
<rdf:Description rdf:about="&a;110273808"
	 b:glossaryEntry="the state of being purulent (containing or forming pus)"/>
<rdf:Description rdf:about="&a;110273950"
	 b:glossaryEntry="containing a nonpurulent clear watery content"/>
<rdf:Description rdf:about="&a;110274055"
	 b:glossaryEntry="containing blood or bloody serum usually caused by an injury"/>
<rdf:Description rdf:about="&a;110274175"
	 b:glossaryEntry="protrusion of the eyeball from the socket"/>
<rdf:Description rdf:about="&a;110274294"
	 b:glossaryEntry="a furlike coating of matter as on the tongue"/>
<rdf:Description rdf:about="&a;110274392">
	<b:glossaryEntry>death and decay of tissue caused by loss of blood supply or infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110274516">
	<b:glossaryEntry>the presence of blood in the urine; often a symptom of urinary tract disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110274648">
	<b:glossaryEntry>an abnormal increase of mononuclear leucocytes or monocytes in the bloodstream</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110274793">
	<b:glossaryEntry>a symptom consisting of the involuntary expulsion of air from the nose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110274960"
	 b:glossaryEntry="abnormal protuberance or localized enlargement"/>
<rdf:Description rdf:about="&a;110275188">
	<b:glossaryEntry>swelling of the rumen or intestinal tract of domestic animals caused by excessive gas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110275325">
	<b:glossaryEntry>a lymph node that is inflamed and swollen because of plague or gonorrhea or tuberculosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110275482">
	<b:glossaryEntry>swelling from excessive accumulation of serous fluid in tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110275650">
	<b:glossaryEntry>generalized edema with accumulation of serum in subcutaneous connective tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110275783">
	<b:glossaryEntry>edema of the mucous membrane of the eyeball and eyelid lining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110275899">
	<b:glossaryEntry>a painful swelling of the bursa of the first joint of the big toe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110276017"
	 b:glossaryEntry="a condition marked by uncontrollable tremor"/>
<rdf:Description rdf:about="&a;110276112"
	 b:glossaryEntry="slight swelling"/>
<rdf:Description rdf:about="&a;110276207"
	 b:glossaryEntry="swelling up with blood or other fluids (as with congestion)"/>
<rdf:Description rdf:about="&a;110276358">
	<b:glossaryEntry>a collection of blood under the scalp of a newborn; caused by pressure during birth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110276520"
	 b:glossaryEntry="a localized swelling filled with blood"/>
<rdf:Description rdf:about="&a;110276625"
	 b:glossaryEntry="the swollen tissue around a healing wound or ulcer"/>
<rdf:Description rdf:about="&a;110276733"
	 b:glossaryEntry="abnormally high amounts of bilirubin in the blood"/>
<rdf:Description rdf:about="&a;110276884">
	<b:glossaryEntry>a common disorder that is usually due to immaturity of the liver; usually subsides spontaneously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110277060"
	 b:glossaryEntry="abnormally high blood sugar usually associated with diabetes"/>
<rdf:Description rdf:about="&a;110277180">
	<b:glossaryEntry>abnormally low blood sugar usually resulting from excessive insulin or a poor diet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110277340">
	<b:glossaryEntry>yellowing of the skin and the whites of the eyes caused by an accumulation of bile pigment (bilirubin) in the blood; can be a symptom of gallstones or liver infection or anemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110277636">
	<b:glossaryEntry>yellowish appearance in newborn infants; usually subsides spontaneously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110277838">
	<b:glossaryEntry>an abnormal accumulation of bile pigment in the brain and other nerve tissue; causes yellow staining and tissue damage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110278014">
	<b:glossaryEntry>excessive accumulation of blood or other fluid in a body part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110278168"
	 b:glossaryEntry="excessive blood in an organ or other body part"/>
<rdf:Description rdf:about="&a;110278283"
	 b:glossaryEntry="congestion in the lungs"/>
<rdf:Description rdf:about="&a;110278373"
	 b:glossaryEntry="any eruption of the skin"/>
<rdf:Description rdf:about="&a;110278539"
	 b:glossaryEntry="inflammation around the sweat ducts"/>
<rdf:Description rdf:about="&a;110278645">
	<b:glossaryEntry>an itchy skin eruption characterized by weals with pale interiors and well-defined red margins; usually the result of an allergic response to insect bites or food or drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110278925">
	<b:glossaryEntry>partial or total lack of sensation in a part of the body; a symptom of nerve damage or dysfunction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110279078">
	<b:glossaryEntry>a symptom of some physical hurt or disorder; "the patient developed severe pain and distension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110279666"
	 b:glossaryEntry="a dull persistent (usually moderately intense) pain"/>
<rdf:Description rdf:about="&a;110279867"
	 b:glossaryEntry="an ache localized in a tooth"/>
<rdf:Description rdf:about="&a;110279969">
	<b:glossaryEntry>pain in the teeth that results from a change in air pressure (as in flying of mountain climbing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110280125"
	 b:glossaryEntry="a state of acute pain"/>
<rdf:Description rdf:about="&a;110280246"
	 b:glossaryEntry="pain in a joint or joints"/>
<rdf:Description rdf:about="&a;110280328">
	<b:glossaryEntry>severe spasm of pain: "the throes of dying"; "the throes of childbirth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110280451">
	<b:glossaryEntry>abnormal skin sensations (as tingling or tickling or itching or burning) usually associated with peripheral nerve damage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110280662">
	<b:glossaryEntry>hallucinated sensation that insects or snakes are crawling over the skin; a common side-effect of extensive use of cocaine or amphetamines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110280858"
	 b:glossaryEntry="the suffering of Jesus at the crucifixion"/>
<rdf:Description rdf:about="&a;110280953"
	 b:glossaryEntry="an ache localized in the back"/>
<rdf:Description rdf:about="&a;110281055"
	 b:glossaryEntry="pain that feels hot as if it were on fire"/>
<rdf:Description rdf:about="&a;110281157">
	<b:glossaryEntry>a burning pain in a limb along the course of a peripheral nerve; usually associated with skin changes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110281314"
	 b:glossaryEntry="acute abdominal pain (especially in infants)"/>
<rdf:Description rdf:about="&a;110281447"
	 b:glossaryEntry="pain in the chest"/>
<rdf:Description rdf:about="&a;110281521"
	 b:glossaryEntry="a pain in the hand that is not traumatic"/>
<rdf:Description rdf:about="&a;110281617"
	 b:glossaryEntry="painful menstruation"/>
<rdf:Description rdf:about="&a;110281696">
	<b:glossaryEntry>pain in the head caused by dilation of cerebral arteries or muscle contractions or a reaction to drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110281951">
	<b:glossaryEntry>pain caused by venous swelling at or inside the anal sphincter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110282077"
	 b:glossaryEntry="an ache localized in the stomach or abdominal region"/>
<rdf:Description rdf:about="&a;110282246"
	 b:glossaryEntry="an ache localized in the middle or inner ear"/>
<rdf:Description rdf:about="&a;110282354">
	<b:glossaryEntry>a headache associated with the release of histamine from cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110282500">
	<b:glossaryEntry>a severe recurring vascular headache; occur more frequently in women than men</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110282670">
	<b:glossaryEntry>a headache located at the back of the head; usually caused by body tension resulting from overwork or psychological stress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110282855">
	<b:glossaryEntry>a headache resulting from congestion or infection in the paranasal sinuses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110282990">
	<b:glossaryEntry>backache affecting the lumbar region or lower back; can be caused by muscle strain or arthritis or vascular insufficiency or a ruptured intervertebral disc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110283199"
	 b:glossaryEntry="rheumatic or myalgic pains in the arms or legs"/>
<rdf:Description rdf:about="&a;110283299"
	 b:glossaryEntry="pain in the uterus"/>
<rdf:Description rdf:about="&a;110283373"
	 b:glossaryEntry="pain in a muscle or group of muscles"/>
<rdf:Description rdf:about="&a;110283474">
	<b:glossaryEntry>pain in the chest caused by inflammation of the muscles between the ribs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110283629">
	<b:glossaryEntry>an acute infectious disease occurring in epidemic form and featuring paroxysms of pain (usually in the chest)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110283877"
	 b:glossaryEntry="pain in the breast"/>
<rdf:Description rdf:about="&a;110283951"
	 b:glossaryEntry="pain in the thigh"/>
<rdf:Description rdf:about="&a;110284023"
	 b:glossaryEntry="acute spasmodic pain along the course of one or more nerves"/>
<rdf:Description rdf:about="&a;110284185"
	 b:glossaryEntry="intense paroxysmal neuralgia along the trigeminal nerve"/>
<rdf:Description rdf:about="&a;110284324"
	 b:glossaryEntry="neuralgia along the sciatic nerve"/>
<rdf:Description rdf:about="&a;110284412"
	 b:glossaryEntry="a sharp spasm of pain"/>
<rdf:Description rdf:about="&a;110284520">
	<b:glossaryEntry>a regularly recurrent spasm of pain that is characteristic of childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110284679">
	<b:glossaryEntry>pains felt by a woman after her baby is born; associated with contractions of the uterus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110284824"
	 b:glossaryEntry='a mental pain or distress; "a pang of conscience"'/>
<rdf:Description rdf:about="&a;110284932"
	 b:glossaryEntry="a stinging pain"/>
<rdf:Description rdf:about="&a;110285010">
	<b:glossaryEntry>something as sudden and painful as a sting; "the sting of death"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110285137"
	 b:glossaryEntry="a sharp spasm of pain in the side resulting from running"/>
<rdf:Description rdf:about="&a;110285246"
	 b:glossaryEntry="a pain that is felt when the area is touched"/>
<rdf:Description rdf:about="&a;110285376">
	<b:glossaryEntry>soreness and warmth caused by friction; "he had a nasty chafe on his knee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110285502"
	 b:glossaryEntry="unbearable physical pain"/>
<rdf:Description rdf:about="&a;110285590">
	<b:glossaryEntry>secretion of mucus from the rear of the nasal cavity into the nasopharynx</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110285724"
	 b:glossaryEntry="a small inflamed elevation of skin that is nonsuppurative"/>
<rdf:Description rdf:about="&a;110285834"
	 b:glossaryEntry="a small inflamed elevation of skin containing pus"/>
<rdf:Description rdf:about="&a;110285955">
	<b:glossaryEntry>a small inflamed elevation of the skin; a pustule or papule; common symptom in acne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110286146"
	 b:glossaryEntry="a pustule in an eruptive disease"/>
<rdf:Description rdf:about="&a;110286248">
	<b:glossaryEntry>an abnormal enlargement of the heart; mild cardiomegaly is common in athletes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110286429">
	<b:glossaryEntry>an abnormal sound of the heart; sometimes a sign of abnormal heart function</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110286607"
	 b:glossaryEntry="a murmur heard during systole"/>
<rdf:Description rdf:about="&a;110286698"
	 b:glossaryEntry="a rapid and irregular heart beat"/>
<rdf:Description rdf:about="&a;110286788">
	<b:glossaryEntry>a painful burning sensation in the chest caused by acidic backflow from the stomach irritating the esophagus; symptomatic of an ulcer or other disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110287005"
	 b:glossaryEntry="reflux of stomach contents into the esophagus"/>
<rdf:Description rdf:about="&a;110287140"
	 b:glossaryEntry="a venous reflux occurring in congestive heart failure"/>
<rdf:Description rdf:about="&a;110287260"
	 b:glossaryEntry="a backflow of urine from the ureter into the renal pelvis"/>
<rdf:Description rdf:about="&a;110287383"
	 b:glossaryEntry="a backflow of urine from the bladder into the ureter"/>
<rdf:Description rdf:about="&a;110287503"
	 b:glossaryEntry="an abnormal backward flow of body fluids"/>
<rdf:Description rdf:about="&a;110287668">
	<b:glossaryEntry>a disorder of digestive function characterized by discomfort or heartburn or nausea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110287872">
	<b:glossaryEntry>a response of body tissues to injury or irritation; characterized by pain and swelling and redness and heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110289641"
	 b:glossaryEntry="a condition in which no mucus in produced"/>
<rdf:Description rdf:about="&a;110289735">
	<b:glossaryEntry>sudden brief flush and sensation of heat associated with menopause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110289857"
	 b:glossaryEntry="inflammation of the heart"/>
<rdf:Description rdf:about="&a;110289991"
	 b:glossaryEntry="inflammation of the endocardium and heart valves"/>
<rdf:Description rdf:about="&a;110290116">
	<b:glossaryEntry>a chronic bacterial infection of the endocardium and heart valves; symptoms develop slowly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110290284">
	<b:glossaryEntry>inflammation of the myocardium (the muscular tissue of the heart)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110290433"
	 b:glossaryEntry="inflammation of the pericardium"/>
<rdf:Description rdf:about="&a;110290523">
	<b:glossaryEntry>inflammation of the nose and throat with increased production of mucus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110290647">
	<b:glossaryEntry>an inflammation of body tissue (especially that below the skin) characterized by fever and swelling and redness and pain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110290824"
	 b:glossaryEntry="inflammation of the uterine cervix"/>
<rdf:Description rdf:about="&a;110290915"
	 b:glossaryEntry="inflammation and cracking of the skin of the lips"/>
<rdf:Description rdf:about="&a;110291020">
	<b:glossaryEntry>a disorder of the lips marked by scaling and fissures at the corners of the mouth; caused by a deficiency of riboflavin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110291206">
	<b:glossaryEntry>a sensation of cold that often marks the start of an infection and the development of a fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110291363">
	<b:glossaryEntry>successive stages of chills and fever that is a symptom of malaria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110291518"
	 b:glossaryEntry="inflammation of the bile ducts"/>
