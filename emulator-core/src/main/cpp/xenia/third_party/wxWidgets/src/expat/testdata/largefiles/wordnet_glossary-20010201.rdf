	 b:glossaryEntry="a mountain formed by volcanic material"/>
<rdf:Description rdf:about="&a;106723036"
	 b:glossaryEntry="an underwater mountain rising above the ocean floor"/>
<rdf:Description rdf:about="&a;106723160">
