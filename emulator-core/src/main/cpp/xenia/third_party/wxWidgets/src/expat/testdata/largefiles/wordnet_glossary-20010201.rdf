<rdf:Description rdf:about="&a;110763217"
	 b:glossaryEntry="a solid substance in the form of tiny loose particles"/>
<rdf:Description rdf:about="&a;110763341"
	 b:glossaryEntry="a type of soil occurring under grasses in temperate climates"/>
<rdf:Description rdf:about="&a;110763460"
	 b:glossaryEntry="a substance that causes a precipitate to form"/>
<rdf:Description rdf:about="&a;110763563">
	<b:glossaryEntry>a chemical compound that is added to protect against decay or decomposition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110763715">
	<b:glossaryEntry>a chemical substance formed as a result of a chemical reaction; "a product of lime and nitric acid"</b:glossaryEntry>
</rdf:Description>
