<rdf:Description rdf:about="&a;200998398"
	 b:glossaryEntry='draw slowly or heavily; "haul stones"; "haul nets"'/>
<rdf:Description rdf:about="&a;200998550"
	 b:glossaryEntry="haul with a tackle"/>
<rdf:Description rdf:about="&a;200998639">
