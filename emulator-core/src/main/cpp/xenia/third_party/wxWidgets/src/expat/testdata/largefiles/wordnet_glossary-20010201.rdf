</rdf:Description>
<rdf:Description rdf:about="&a;102129483"
	 b:glossaryEntry="a genus of Polyodontidae"/>
<rdf:Description rdf:about="&a;102129619">
	<b:glossaryEntry>fish of larger rivers of China similar to the Mississippi paddlefish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102129790"
	 b:glossaryEntry="sturgeons"/>
<rdf:Description rdf:about="&a;102129939">
