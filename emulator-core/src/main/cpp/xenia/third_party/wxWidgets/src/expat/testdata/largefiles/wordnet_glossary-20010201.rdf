</rdf:Description>
<rdf:Description rdf:about="&a;101347516"
	 b:glossaryEntry="a family of birds of the order Coraciiformes"/>
<rdf:Description rdf:about="&a;101347692"
	 b:glossaryEntry="type genus of the Momotidae"/>
<rdf:Description rdf:about="&a;101347808">
	<b:glossaryEntry>tropical American bluejay-like bird having greenish and bluish plumage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101347958"
	 b:glossaryEntry="a family of birds of the order Coraciiformes"/>
<rdf:Description rdf:about="&a;101348111"
	 b:glossaryEntry="type genus of the Todidae"/>
<rdf:Description rdf:about="&a;101348240">
	<b:glossaryEntry>tiny insectivorous West Indian bird having red-and-green plumage and a long straight bill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101348399"
	 b:glossaryEntry="swifts; hummingbirds"/>
<rdf:Description rdf:about="&a;101348592">
	<b:glossaryEntry>nonpasserine bird having long wings and weak feet; spends much of its time in flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101348810">
	<b:glossaryEntry>swifts; in former classifications included in the order Coraciiformes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101349047">
	<b:glossaryEntry>small plain-colored bird that resembles a swallow and is noted for its rapid flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101349255"
	 b:glossaryEntry="type genus"/>
<rdf:Description rdf:about="&a;101349367">
	<b:glossaryEntry>common European bird with a shrieking call that nests chiefly about eaves of buildings or on cliffs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101349558"
	 b:glossaryEntry="a genus of Apodidae"/>
