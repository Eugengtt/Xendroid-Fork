	 b:glossaryEntry="duck-billed dinosaurs; upper Cretaceous"/>
<rdf:Description rdf:about="&a;101226634">
	<b:glossaryEntry>any of numerous large bipedal ornithischian dinosaurs having a horny duck-like bill and webbed feet; may have been partly aquatic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101226947"
	 b:glossaryEntry="genus of large duck-billed dinosaurs; late Cretaceous"/>
