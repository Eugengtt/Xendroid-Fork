	 b:glossaryEntry="a lizard of the family Agamidae"/>
<rdf:Description rdf:about="&a;101208714"
	 b:glossaryEntry="type genus of the Agamidae"/>
<rdf:Description rdf:about="&a;101208836"
	 b:glossaryEntry="small terrestrial lizard of warm regions of the Old World"/>
<rdf:Description rdf:about="&a;101208964"
	 b:glossaryEntry="frilled lizards"/>
<rdf:Description rdf:about="&a;101209101">
