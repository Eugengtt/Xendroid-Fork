	 b:glossaryEntry="a country in eastern part of the Balkan Peninsula"/>
<rdf:Description rdf:about="&a;106411888"
	 b:glossaryEntry="capital and largest city of Bulgaria"/>
<rdf:Description rdf:about="&a;106412015">
	<b:glossaryEntry>a geographical division of Asia that includes Indochina plus Indonesia and the Philippines and Singapore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106412275">
	<b:glossaryEntry>a mountainous republic in southeastern Asia on the Bay of Bengal; "much opium is grown in Myanmar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106412530">
	<b:glossaryEntry>the capital and largest city of Myanmar; located in the south on the Rangoon river near its outlet in the Irrawaddy river delta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106412739"
	 b:glossaryEntry="a city in central Myanmar north of Rangoon"/>
<rdf:Description rdf:about="&a;106412855"
	 b:glossaryEntry="a republic in east central Africa"/>
