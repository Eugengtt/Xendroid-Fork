	<b:glossaryEntry>mammals of which the females have a pouch (the marsupium) containing the teats where the young are fed and carried</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101390789"
	 b:glossaryEntry="opossums"/>
<rdf:Description rdf:about="&a;101390933">
