<rdf:Description rdf:about="&a;110742602"
	 b:glossaryEntry="an enzyme that catalyzes oxidation-reduction"/>
<rdf:Description rdf:about="&a;110742725"
	 b:glossaryEntry="any compound containing the group -C=NOH"/>
<rdf:Description rdf:about="&a;110742817">
	<b:glossaryEntry>a mixture of oxygen and acetylene; used to create high temperatures for cutting or welding metals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110742992"
	 b:glossaryEntry="any acid that contains oxygen"/>
<rdf:Description rdf:about="&a;110743215"
	 b:glossaryEntry="any oxygen-containing acid of iodine"/>
<rdf:Description rdf:about="&a;110743311">
	<b:glossaryEntry>an oxidoreductase that catalyzes the incorporation of molecular oxygen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110743437">
	<b:glossaryEntry>a colorless gas (O3) soluble in alkalis and cold water; a strong oxidizing agent; can be produced by electric discharge in oxygen or by the action of ultraviolet radiation on oxygen in the stratosphere (where it acts as a screen for ultraviolet radiation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110743763"
	 b:glossaryEntry="a number of sheets of paper fastened together along one edge"/>
<rdf:Description rdf:about="&a;110743933">
	<b:glossaryEntry>a saturated fatty acid; glycerides of palmitic acid occur widely in plant and animal oils and fats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110744111"
	 b:glossaryEntry="an ester of glycerol and palmitic acid"/>
<rdf:Description rdf:about="&a;110744204">
	<b:glossaryEntry>a vitamin of the vitamin B complex that performs an important role in the oxidation of fats and carbohydrates and certain amino acids; occurs in many foods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110744452">
	<b:glossaryEntry>a proteolytic enzyme obtained from the unripe papaya; used as a meat tenderizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110744584">
	<b:glossaryEntry>a metabolic acid found in yeast and liver cells; used to make dyes and drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110744736">
	<b:glossaryEntry>a material made of cellulose pulp derived mainly from wood or rags or certain grasses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110745576"
	 b:glossaryEntry="absorbent paper used as toweling"/>
<rdf:Description rdf:about="&a;110745669">
	<b:glossaryEntry>a substance made from paper pulp that can be molded when went and painted when dry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110745810">
	<b:glossaryEntry>paper made from the papyrus plant by cutting it in strips and pressing it flat; used by ancient Egyptians and Greeks and Romans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110745991"
	 b:glossaryEntry="a superior paper resembling sheepskin"/>
<rdf:Description rdf:about="&a;110746084">
	<b:glossaryEntry>a thin delicate material resembling paper; made from the rice-paper tree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110746213">
	<b:glossaryEntry>a heavy paper impregnated with tar and used as part of a roof for waterproofing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110746382">
	<b:glossaryEntry>leaf or strip from a leaf of the talipot palm used in India for writing paper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110746535">
	<b:glossaryEntry>a continuous thin ribbon of paper on which stock quotes are written</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110746660"
	 b:glossaryEntry="any material used especially to protect something"/>
<rdf:Description rdf:about="&a;110746846">
	<b:glossaryEntry>a transparent plastic blister used to package items of merchandise</b:glossaryEntry>
</rdf:Description>
