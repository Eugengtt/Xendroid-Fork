</rdf:Description>
<rdf:Description rdf:about="&a;200286340">
	<b:glossaryEntry>make into a citizen; "The French family was naturalized last year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200286510">
	<b:glossaryEntry>strip of the rights and duties of citizenship; "The former Nazi was denaturalized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200286680"
	 b:glossaryEntry="make more natural or lifelike"/>
<rdf:Description rdf:about="&a;200286795"
	 b:glossaryEntry="make less natural or unnatural"/>
<rdf:Description rdf:about="&a;200286913">
	<b:glossaryEntry>adopt to another place; "The stories had become naturalized into an American setting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200287066">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take into one''s family; "They adopted two children from Nicaragua"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200287213">
	<b:glossaryEntry>come into a new country and change residency; "Many people immigrated at the beginning of the 20th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200287431">
	<b:glossaryEntry>introduce or send as immigrants; "Britain immigrated many colonists to America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200287585">
	<b:glossaryEntry>take up residence and become established; "The immigrants settled in the Midwest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200287786">
	<b:glossaryEntry>settle as colonists or establish a colony (in): "The British colonized the East Coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200287938">
	<b:glossaryEntry>put out of its usual place, position, or relationship; "The colonists displaced the natives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200288116"
	 b:glossaryEntry='form a community; "The Swedes settled in Minnesota"'/>
<rdf:Description rdf:about="&a;200288249">
	<b:glossaryEntry>settle land given by the government and occupy it as a homestead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200288380">
	<b:glossaryEntry xml:space='preserve'><![CDATA[become settled or established and stable in one''s residence or life style; "He finally settled down"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200288610"
	 b:glossaryEntry="settle down or stay, as if on a roost"/>
<rdf:Description rdf:about="&a;200288718"
	 b:glossaryEntry='become established; "winter has set in"'/>
<rdf:Description rdf:about="&a;200288803"
	 b:glossaryEntry='settle in a new place; "The immigrants had to resettle"'/>
<rdf:Description rdf:about="&a;200288942"
	 b:glossaryEntry="migrate to a new environment, of plants and animals"/>
<rdf:Description rdf:about="&a;200289068">
	<b:glossaryEntry xml:space='preserve'><![CDATA[leave one''s country of residence for a new one; "Many people had to emigrate during the Nazi period"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200289278"
	 b:glossaryEntry='make steady; "steady your hands"'/>
<rdf:Description rdf:about="&a;200289432"
	 b:glossaryEntry="make even or more even"/>
<rdf:Description rdf:about="&a;200289607"
	 b:glossaryEntry='become even or more even; "even out the surface"'/>
<rdf:Description rdf:about="&a;200289728">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make equal or uniform; "let''s equalize the duties among all employees in this office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200289949"
	 b:glossaryEntry="make homologous"/>
<rdf:Description rdf:about="&a;200290032">
	<b:glossaryEntry>make stiff or stiffer; "Stiffen the cream by adding gelatine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200290256"
	 b:glossaryEntry='stiffen with starch; "starch clothes"'/>
<rdf:Description rdf:about="&a;200290357"
	 b:glossaryEntry='stiffen with or as with buckram; "buckram the skirt"'/>
<rdf:Description rdf:about="&a;200290474"
	 b:glossaryEntry='make rigid; "rigidify the training schedule"'/>
<rdf:Description rdf:about="&a;200290584"
	 b:glossaryEntry='become rigid; "The body rigidified"'/>
<rdf:Description rdf:about="&a;200290685">
	<b:glossaryEntry>become stiff or stiffer; "He stiffened when he saw his boss enter the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200290869"
	 b:glossaryEntry='restrict; "Tighten the rules"; "stiffen the regulations"'/>
<rdf:Description rdf:about="&a;200291025">
	<b:glossaryEntry>repress or suppress (something regarded as undesirable); "The police clamped down on illegal drugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200291205"
	 b:glossaryEntry='become loose or looser; "The noose loosened"'/>
<rdf:Description rdf:about="&a;200291365"
	 b:glossaryEntry='make loose or looser; "loosen the tension on a rope"'/>
<rdf:Description rdf:about="&a;200291639"
	 b:glossaryEntry='become less tight; "the rope relaxed"'/>
<rdf:Description rdf:about="&a;200291747"
	 b:glossaryEntry='make less tight; "relax the tension on the rope"'/>
<rdf:Description rdf:about="&a;200291893"
	 b:glossaryEntry="remove from tension"/>
<rdf:Description rdf:about="&a;200291977"
	 b:glossaryEntry='become tight or tighter; "The rope tightened"'/>
<rdf:Description rdf:about="&a;200292159"
	 b:glossaryEntry='make tight or tighter; "Tighten the wire"'/>
<rdf:Description rdf:about="&a;200292364"
	 b:glossaryEntry='take up the slack of; "frap a rope"'/>
<rdf:Description rdf:about="&a;200292461"
	 b:glossaryEntry='make taut or tauter; "tauten a rope"'/>
<rdf:Description rdf:about="&a;200292576"
	 b:glossaryEntry="become taut or tauter"/>
<rdf:Description rdf:about="&a;200292668">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make transitive; "adding ''out'' to many verbs transitivizes them"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200292828">
	<b:glossaryEntry>intransitivize; "removing the object will intransitivize the verbs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200293010"
	 b:glossaryEntry="make slack as by lessening tension or firmness"/>
<rdf:Description rdf:about="&a;200293173"
	 b:glossaryEntry='slacken; "douse a rope"'/>
<rdf:Description rdf:about="&a;200293275"
	 b:glossaryEntry='become looser or slack; "the rope slackened"'/>
<rdf:Description rdf:about="&a;200293402"
	 b:glossaryEntry='go away or leave; "He absented himself"'/>
<rdf:Description rdf:about="&a;200293522">
	<b:glossaryEntry>disappear gradually; as of emotions, for example; "The pain eventually passed off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200293723"
	 b:glossaryEntry='lose freshness, vigor, or vitality; "Her bloom was fading"'/>
<rdf:Description rdf:about="&a;200293860">
	<b:glossaryEntry>come into sight or view; "He suddenly appeared at the wedding"; "A new star appeared on the horizon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200294354"
	 b:glossaryEntry='be revealed or disclosed; "The truth finally came to light"'/>
<rdf:Description rdf:about="&a;200294499"
	 b:glossaryEntry='appear briefly; "A terrible thought gleamed in her mind"'/>
<rdf:Description rdf:about="&a;200294626">
	<b:glossaryEntry>appear or become visible; make a showing; "She turned up at the funeral"; "I hope the list key is going to surface again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200294877">
	<b:glossaryEntry>come out into view, as from concealment; "Suddenly, the proprietor emerged from his office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200295058"
	 b:glossaryEntry='emerge suddenly; "The sun burst into view"'/>
<rdf:Description rdf:about="&a;200295171">
	<b:glossaryEntry xml:space='preserve'><![CDATA[appear in a show, on T.V., radio, etc.; "The news won''t be on tonight"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200295337">
	<b:glossaryEntry>appear on the surface, come to the surface on the ground; "Big boulders outcropped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200295493"
	 b:glossaryEntry='appear briefly; "The headlines flashed on the screen"'/>
<rdf:Description rdf:about="&a;200295617">
	<b:glossaryEntry>emit a brief burst of light; "A shooting star flashed and was gone."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200295748">
	<b:glossaryEntry>come into being or existence, or appear on the scene: "Then the computer came along and changed our lives"; "Homo sapiens appeared millions of years ago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200296004">
	<b:glossaryEntry>come, usually in answer to an invitation or summons; "How many people turned out that evening?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200296173">
	<b:glossaryEntry>appear again; "The missing man suddenly resurfaced in New York</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200296326"
	 b:glossaryEntry='appear at the surface: "A seam of coal bassets"'/>
<rdf:Description rdf:about="&a;200296448">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be issued or published, as of news in a paper, a book, or a movie; "Did your latest book appear yet?" "The new Woody Allen film hasn''t come out yet"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200296679"
	 b:glossaryEntry='appear suddenly: "Spring popped up everywhere in the valley"'/>
<rdf:Description rdf:about="&a;200296824">
	<b:glossaryEntry>appear again; "The sores reappeared on her body"; "Her husband reappeared after having left her years ago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200297068">
	<b:glossaryEntry>become known or apparent; "Some nice results emerged from the study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200297200"
	 b:glossaryEntry='penetrate; "The sun broke through the clouds"'/>
<rdf:Description rdf:about="&a;200297331">
	<b:glossaryEntry>get lost, esp. without warning or explanation; "He disappeared without a trace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200297682"
	 b:glossaryEntry='cease to exist; "An entire civilization vanished"'/>
<rdf:Description rdf:about="&a;200297825"
	 b:glossaryEntry="disappear without notifying anyone (idiom)"/>
<rdf:Description rdf:about="&a;200297950"
	 b:glossaryEntry='become extinct; "Dinosaurs died out"'/>
<rdf:Description rdf:about="&a;200298069">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make small or insignificant; "Let''s minimize the risk"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200298215"
	 b:glossaryEntry='reduce proportionally; "The model is scaled down"'/>
<rdf:Description rdf:about="&a;200298386"
	 b:glossaryEntry='increase proportionally; "scale up the model"'/>
<rdf:Description rdf:about="&a;200298551"
	 b:glossaryEntry='make as big or large as possible; "Maximize your profits!"'/>
<rdf:Description rdf:about="&a;200298701"
	 b:glossaryEntry='make the most of; "He maximized his role"'/>
<rdf:Description rdf:about="&a;200298808">
	<b:glossaryEntry>cut down on; make a reduction in; "reduce your daily fat intake"; "The employer wants to cut back health benefits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200299246"
	 b:glossaryEntry='reduce in amount; "This cuts into my earnings"'/>
<rdf:Description rdf:about="&a;200299354">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make a reduction, as in one''s workforce; "The company had to retrench"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200299498"
	 b:glossaryEntry='cut drastically; "Prices were slashed"'/>
<rdf:Description rdf:about="&a;200299607"
	 b:glossaryEntry='make sparse; "thin out the young plants"'/>
<rdf:Description rdf:about="&a;200299731">
	<b:glossaryEntry>become sparser; "Towards the end of town, the houses thinned out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200299862"
	 b:glossaryEntry='make thin or thinner; "Thin the solution"'/>
