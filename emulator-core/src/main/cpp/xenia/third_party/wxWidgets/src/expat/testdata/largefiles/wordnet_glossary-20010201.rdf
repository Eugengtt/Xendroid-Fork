</rdf:Description>
<rdf:Description rdf:about="&a;201198077"
	 b:glossaryEntry='create designs; "Dupont designs for the house of Chanel"'/>
<rdf:Description rdf:about="&a;201198215">
	<b:glossaryEntry>bring into existence; "The company was created 25 years ago"; "He created a new movement in painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201198388"
	 b:glossaryEntry='create by pressing: "Press little holes into the soft clay"'/>
<rdf:Description rdf:about="&a;201198518">
	<b:glossaryEntry>to prepare verbally, either for written or spoken delivery; "prepare a report"; "prepare a speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201198699"
	 b:glossaryEntry="prepare in preliminary or sketchy form"/>
<rdf:Description rdf:about="&a;201198823">
	<b:glossaryEntry>put into writing; write in complete form; "write out a contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201198965"
	 b:glossaryEntry='form or shape by cutting or incising; "cut out paper dolls"'/>
<rdf:Description rdf:about="&a;201199121">
	<b:glossaryEntry>form by probing, penetrating, or digging; "cut a hole"; "cut trenches"; "The sweat cut little rivulets into her face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201199325"
	 b:glossaryEntry="represent by means of a graph"/>
<rdf:Description rdf:about="&a;201199417"
	 b:glossaryEntry="plot upon a graph"/>
<rdf:Description rdf:about="&a;201199497"
	 b:glossaryEntry="dance a shimmy"/>
<rdf:Description rdf:about="&a;201199575"
	 b:glossaryEntry='gather and light the materials for: "make a fire"'/>
<rdf:Description rdf:about="&a;201199722">
	<b:glossaryEntry>create a disturbance, esp. by making a great noise; "raise hell"; "raise the roof"; "raise Cain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201199881">
	<b:glossaryEntry>perform or carry out; "make a decision"; "make a move"; "make advances"; "make a phone call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201200071">
	<b:glossaryEntry>make by pounding or trampling; "beat a path through the forest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201200214">
	<b:glossaryEntry xml:space='preserve'><![CDATA[plan, delineate, or arrange in detail; ""map one''s future"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201200343"
	 b:glossaryEntry='create by recording electronically; "cut a disk"; "cut a CD"'/>
<rdf:Description rdf:about="&a;201200482"
	 b:glossaryEntry='record a performance on; "cut a record"'/>
<rdf:Description rdf:about="&a;201200618"
	 b:glossaryEntry='make a recording of: "cut the songs"'/>
<rdf:Description rdf:about="&a;201200733"
	 b:glossaryEntry='write a script for; "The playwright scripted the movie"'/>
<rdf:Description rdf:about="&a;201200852">
	<b:glossaryEntry>call forth; of emotions, feelings, and responses; "arouse pity"; "raise a smile"; "evoke sympathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201201328">
	<b:glossaryEntry>increase the likelihood of; "ask for trouble"; "invite criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201201467">
	<b:glossaryEntry xml:space='preserve'><![CDATA[draw responses, such as objections, criticism, applause, etc.; "The President''s comments drew sharp criticism from the Republicans"; "The comedian drew a lot of laughter"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201201699"
	 b:glossaryEntry='arouse again: "rekindle hopes"; "rekindle her love"'/>
<rdf:Description rdf:about="&a;201201824"
	 b:glossaryEntry="make passionate, of foolish passions"/>
<rdf:Description rdf:about="&a;201201935">
	<b:glossaryEntry>to cause a sharp emotional pain; "The thought of her unhappiness pricked his conscience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201202110">
	<b:glossaryEntry xml:space='preserve'><![CDATA[arouse or excite feelings and passions; "The ostentatious way of living of the rich ignites the hatred of the poor"; "The refugees'' fate stirred up compassion around the world"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201202395">
	<b:glossaryEntry>as of senses or emotions; "These stories shook the community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201202744"
	 b:glossaryEntry='stimulate; "fuel the debate on creationism"'/>
<rdf:Description rdf:about="&a;201202849"
	 b:glossaryEntry="arouse sexually"/>
<rdf:Description rdf:about="&a;201202989">
	<b:glossaryEntry>cause to be agitated, excited, or roused; "The speaker charged up the crowd with his inflammatory remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201203288"
	 b:glossaryEntry="overflow with a certain feeling, such as anger or joy"/>
<rdf:Description rdf:about="&a;201203434"
	 b:glossaryEntry="get excited or stimulated"/>
<rdf:Description rdf:about="&a;201203543"
	 b:glossaryEntry="calm by deception"/>
<rdf:Description rdf:about="&a;201203630">
	<b:glossaryEntry>become quiet or calm, esp. after a state of agitation; "After the fight both men need to cool off." "It took a while after the baby was born for things to settle down again."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201203947">
	<b:glossaryEntry>disturb in mind or make uneasy or cause to be worried or alarmed; "She was rather perturbed by the news that her father was seriously ill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201204236"
	 b:glossaryEntry="derange mentally, throw out of mental balance; make insane"/>
<rdf:Description rdf:about="&a;201204371"
	 b:glossaryEntry='make calm or still; "quiet the dragons of worry and fear"'/>
<rdf:Description rdf:about="&a;201204662">
	<b:glossaryEntry>calm (someone, esp. oneself); make quiet; "She had to compose herself before she could reply to this terrible insult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201204852">
	<b:glossaryEntry>cause to be more favorably inclined; gain the good will of; "She managed to mollify her angry boss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201205112"
	 b:glossaryEntry="disturb the peace of mind of"/>
<rdf:Description rdf:about="&a;201205301">
	<b:glossaryEntry xml:space='preserve'><![CDATA[worry or cause anxiety in a persistent way: "What''s eating you?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201205436"
	 b:glossaryEntry="cause to feel sure; give reassurance to"/>
<rdf:Description rdf:about="&a;201205576"
	 b:glossaryEntry='worry persistently; "nagging concerns and doubts"'/>
<rdf:Description rdf:about="&a;201205686"
	 b:glossaryEntry='be concerned with; "I worry about my grades"'/>
<rdf:Description rdf:about="&a;201205800"
	 b:glossaryEntry='lose interest; "he retired from life when his wife died"'/>
<rdf:Description rdf:about="&a;201205957"
	 b:glossaryEntry="be worried, concerned, anxious, troubled, or uneasy"/>
<rdf:Description rdf:about="&a;201206123"
	 b:glossaryEntry="be agitated or irritated"/>
<rdf:Description rdf:about="&a;201206235"
	 b:glossaryEntry="be in an agitated emotional state"/>
<rdf:Description rdf:about="&a;201206358"
	 b:glossaryEntry="have violent emotions, such as anger or frustration"/>
<rdf:Description rdf:about="&a;201206498">
	<b:glossaryEntry>seethe with deep anger or resentment; "She was sizzling with anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201206630">
	<b:glossaryEntry>have an emotional or cognitive impact upon; "This struck me as odd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201206985"
	 b:glossaryEntry='refer to or be relevant to; "I hope this message hits home!"'/>
<rdf:Description rdf:about="&a;201207150">
	<b:glossaryEntry>affect suddenly with deep feeling; "He was smitten with love for this young girl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201207302">
	<b:glossaryEntry>make gloomy or depressed; "Their faces were clouded with sadness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201207430">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move or affect (a person''s emotions, bodily feelings, etc.) deeply or sharply; "The cold pierced her bones"; "Her words pierced the students"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201207643">
	<b:glossaryEntry>impress positively; "The young chess player impressed her audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201207819">
	<b:glossaryEntry>make a positive impression (on someone) beforehand: "A prepossessing appearance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201207975"
	 b:glossaryEntry='impress greatly; "The speaker wowed the audience"'/>
<rdf:Description rdf:about="&a;201208093"
	 b:glossaryEntry='overwhelm emotionally; "Her swept her away"'/>
<rdf:Description rdf:about="&a;201208224"
	 b:glossaryEntry='move deeply; "This book upset me"; "A troubling thought"'/>
<rdf:Description rdf:about="&a;201208417">
	<b:glossaryEntry>affect emotionally; "A stirring movie"; "I was touched by your kind letter of sympathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201208618">
	<b:glossaryEntry xml:space='preserve'><![CDATA[evoke an emotional response; "Brahms''s ''Requiem'' gets me every time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201208774">
	<b:glossaryEntry>irritate; "Her childish behavior really get to me"; "His lying really gets me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201208947"
	 b:glossaryEntry='arouse sympathy or compassion in; "Her fate moved us all"'/>
<rdf:Description rdf:about="&a;201209074">
	<b:glossaryEntry>undergo an emotional sensation; "She felt resentful"; "He felt regret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201209585">
	<b:glossaryEntry>experience anew: "She could not recapture that feeling of happiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201209720"
	 b:glossaryEntry="be proud"/>
<rdf:Description rdf:about="&a;201209835">
	<b:glossaryEntry>be proud of; "He prides himself on making it into law school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201209982"
	 b:glossaryEntry="have strong suppressed feelings"/>
<rdf:Description rdf:about="&a;201210089"
	 b:glossaryEntry="give expression or emotion to, in a stage or movie role"/>
<rdf:Description rdf:about="&a;201210207"
	 b:glossaryEntry="arouse or elicit a feeling"/>
<rdf:Description rdf:about="&a;201210323">
	<b:glossaryEntry>maintain; as of a theory, thoughts, or feelings; "bear a grudge"; "hold a grudge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201210505">
	<b:glossaryEntry>feel bitter or indignant about; "She resents being paid less than her co-workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201210676">
	<b:glossaryEntry>cause to be bitter or resentful; "These injustices embittered her even more"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201210839"
	 b:glossaryEntry="accept or admit unwillingly"/>
<rdf:Description rdf:about="&a;201210930"
	 b:glossaryEntry="gnaw into; make resentful or angry"/>
<rdf:Description rdf:about="&a;201211054"
	 b:glossaryEntry="bear a grudge; harbor ill feelings"/>
<rdf:Description rdf:about="&a;201211167">
	<b:glossaryEntry>dislike intensely; feel antipathy or aversion towards; "I hate Mexican food"; "She detests politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201211403"
	 b:glossaryEntry="find repugnant"/>
<rdf:Description rdf:about="&a;201211520">
	<b:glossaryEntry xml:space='preserve'><![CDATA[look down on with disdain; "He despises the people he has to work for"; "The professor scorns the students who don''t catch on immediately"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201211759">
	<b:glossaryEntry>have a great affection or liking for; "I love French food"; "She loves her boss and works hard for him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201212004"
	 b:glossaryEntry='be enamored or in love with; "She loves her husband deeply"'/>
<rdf:Description rdf:about="&a;201212143"
	 b:glossaryEntry="have a love affair with"/>
<rdf:Description rdf:about="&a;201212239">
	<b:glossaryEntry>fall in love with; become infatuated with; "She fell for the man from Brazil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201212390">
	<b:glossaryEntry>to remain emotionally or intellectually attached; "He clings to the idea that she might still love him."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201212539"
	 b:glossaryEntry="be fond of; be attached to"/>
<rdf:Description rdf:about="&a;201212690"
	 b:glossaryEntry="hold sacred"/>
<rdf:Description rdf:about="&a;201212775">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have a fancy or particular liking or desire for; "She fancied a necklace that she had seen in the jeweler''s window"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201212998">
	<b:glossaryEntry>have or feel a dislike or distaste for; "I really dislike this salesman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201213205"
	 b:glossaryEntry='be fond of; "I like my nephews"'/>
<rdf:Description rdf:about="&a;201213288"
	 b:glossaryEntry='take a liking to; "cotton to something"'/>
<rdf:Description rdf:about="&a;201213391">
	<b:glossaryEntry>find enjoyable or agreeable; "I like jogging"; "She likes to read Russian novels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201213640">
	<b:glossaryEntry>shower with love; show excessive affection for; "Grandmother dotes on her the twins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201213786"
	 b:glossaryEntry="have affection for; feel tenderness for"/>
<rdf:Description rdf:about="&a;201213888"
	 b:glossaryEntry="feel less enamoured of something or somebody"/>
<rdf:Description rdf:about="&a;201213998"
	 b:glossaryEntry='love intensely; "he just adored his wife"'/>
<rdf:Description rdf:about="&a;201214144"
	 b:glossaryEntry="love unquestioningly and uncritically"/>
<rdf:Description rdf:about="&a;201214306"
	 b:glossaryEntry='be in awe of; "Fear God as your father"'/>
<rdf:Description rdf:about="&a;201214483">
	<b:glossaryEntry>show religious devotion to, as of a deity; "Many Hindus worship Shiva"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201214618">
	<b:glossaryEntry>cause fear in; "The stranger who hangs around the building frightens me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201214954">
	<b:glossaryEntry>inspire awe in; "The famous professor awed the undergraduates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201215095">
	<b:glossaryEntry>subdue, restrain, or overcome by affecting with a feeling of awe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201215256"
	 b:glossaryEntry="intimidate or overawe"/>
<rdf:Description rdf:about="&a;201215350"
	 b:glossaryEntry="drive out by frightening"/>
<rdf:Description rdf:about="&a;201215448">
	<b:glossaryEntry>be afraid or scared of; be frightened of; "I fear the winters in Moscow"; "We should not fear the Communists!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201215644">
	<b:glossaryEntry>be uneasy or apprehensive about; "I fear the results of the final exams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201215760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be sorry; used to introduce an unpleasant statement: "I fear I won''t make it to your wedding party"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201215921">
	<b:glossaryEntry>be afraid or feel anxious or apprehensive about a possible or probable situation or event; "I fear she might get aggressive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201216115"
	 b:glossaryEntry="fill with terror; frighten greatly"/>
<rdf:Description rdf:about="&a;201216252"
	 b:glossaryEntry='make timid or fearful; "Her boss intimidates her"'/>
<rdf:Description rdf:about="&a;201216405">
	<b:glossaryEntry>intimidate somebody (with a threat); "She was holding it over him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201216538">
	<b:glossaryEntry>be bossy towards; "Her big brother always bullied her when she was young"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201216775">
	<b:glossaryEntry>rule or exercise power over (somebody) in a cruel and autocratic manner; "her husband and mother-in-law tyrannize her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201216971"
	 b:glossaryEntry="cause to feel horror"/>
<rdf:Description rdf:about="&a;201217082">
	<b:glossaryEntry>cause panic in; fill with panic; "Th mere thought of an isolation cell panicked the prisoners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201217265">
	<b:glossaryEntry>feel panic; "The students panicked when told that final exams were less than a week away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201217443"
	 b:glossaryEntry="anticipate with dread or anxiety"/>
<rdf:Description rdf:about="&a;201217571"
	 b:glossaryEntry="fill with apprehension or alarm"/>
<rdf:Description rdf:about="&a;201217709">
	<b:glossaryEntry>strike with horror or terror; "The news of the bombing shocked her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201217847">
	<b:glossaryEntry>haunt like a ghost; pursue; "She is haunted by her fear of illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201218002">
	<b:glossaryEntry>engage or engross the interest or attention of beforehand; "His work preoccupies him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201218191">
	<b:glossaryEntry>cause to be preoccupied; "The idea of his failure prepossesses him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201218326"
	 b:glossaryEntry="disturb the composure of"/>
<rdf:Description rdf:about="&a;201218470">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cause to lose one''s nerve; "an unmanning experience"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201218593">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lose one''s nerve; "When he saw the accident, he freaked out"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201218755">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lose control of one''s emotions; "When she heard that she had not passed the exam, she lost it completely"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201218974">
	<b:glossaryEntry>be brought to or as if to the point of death by an intense emotion such as embarrassment, amusement, or shame; "I was dying with embarrassment when my little lie was discovered"; "We almost died laughing during the show"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201219263">
	<b:glossaryEntry>languish as with love or desire; "She dying for a cigarette"; "I was dying to leave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201219416">
	<b:glossaryEntry>force out or release suddenly and often violently something pent up; "break into tears"; "erupt in anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201219600"
	 b:glossaryEntry="suffer a nervous breakdown"/>
<rdf:Description rdf:about="&a;201219733"
	 b:glossaryEntry='cause to lose courage; "dashed by the refusal"'/>
<rdf:Description rdf:about="&a;201219920"
	 b:glossaryEntry='make angry; "The news angered him"'/>
<rdf:Description rdf:about="&a;201220151"
	 b:glossaryEntry='irritate or vex; "It galls me that we lost the suit"'/>
<rdf:Description rdf:about="&a;201220279"
	 b:glossaryEntry="make furious"/>
<rdf:Description rdf:about="&a;201220411"
	 b:glossaryEntry='become angry; "He angers easily"'/>
<rdf:Description rdf:about="&a;201220534"
	 b:glossaryEntry='get very angry; "He will raise the roof when he hears this"'/>
<rdf:Description rdf:about="&a;201220665"
	 b:glossaryEntry='make mad; "His behavior is maddening"'/>
<rdf:Description rdf:about="&a;201220774"
	 b:glossaryEntry="drive up the wall; go on someone''s nerves"/>
<rdf:Description rdf:about="&a;201220887"
	 b:glossaryEntry="cause to go crazy; cause to lose one''s mind"/>
<rdf:Description rdf:about="&a;201221002">
	<b:glossaryEntry>cause annoyance in; disturb, esp. by minor irritations: "Mosquitoes buzzing in my ear really bothers me"; "It irritates me that she never closes the door after she leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201221478"
	 b:glossaryEntry="cause to be annoyed, irritated, or resentful"/>
<rdf:Description rdf:about="&a;201221593">
	<b:glossaryEntry xml:space='preserve'><![CDATA[trouble or vex; "ruffle somebody''s composure"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201221710"
	 b:glossaryEntry="cause annoyance in"/>
<rdf:Description rdf:about="&a;201221816">
	<b:glossaryEntry>cause to feel resentment or indignation; "Her tactless remark offended me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201221988">
	<b:glossaryEntry>annoy continually or chronically; "He is known to harry his staff when he is overworked"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201222254"
	 b:glossaryEntry="cause to lose one''s composure"/>
<rdf:Description rdf:about="&a;201222491"
	 b:glossaryEntry="cause to be flustered or consternated"/>
<rdf:Description rdf:about="&a;201222619">
	<b:glossaryEntry>cause to feel embarrassment; "The constant attention of the young man confused her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201222893"
	 b:glossaryEntry="cause to be confused emotionally"/>
<rdf:Description rdf:about="&a;201223033"
	 b:glossaryEntry="make confused or perplexed or puzzled"/>
<rdf:Description rdf:about="&a;201223160">
	<b:glossaryEntry>make nervous or agitated; "The mere thought of her bothered him and made his heart beat faster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201223346"
	 b:glossaryEntry="draw someone''s attention away from something"/>
<rdf:Description rdf:about="&a;201223486"
	 b:glossaryEntry="be flustered; behave in a confused manner"/>
<rdf:Description rdf:about="&a;201223592"
	 b:glossaryEntry="cause to be embarrassed; cause to feel self-conscious"/>
<rdf:Description rdf:about="&a;201223746"
	 b:glossaryEntry="cause to be ashamed"/>
<rdf:Description rdf:about="&a;201223854">
	<b:glossaryEntry>look with disfavor on; "The republic soon discountenanced its few friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201224008"
	 b:glossaryEntry="cause anguish;, make miserable"/>
<rdf:Description rdf:about="&a;201224189">
	<b:glossaryEntry>hurt the feelings of; "She hurt me when she did not include me among her guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201224409"
	 b:glossaryEntry="worry unnecessarily of excessively"/>
<rdf:Description rdf:about="&a;201224565"
	 b:glossaryEntry='raise scruples; "He lied and did not even scruple about it"'/>
<rdf:Description rdf:about="&a;201224697"
	 b:glossaryEntry="suffer agony or anguish"/>
<rdf:Description rdf:about="&a;201224803"
	 b:glossaryEntry="cause to agonize"/>
<rdf:Description rdf:about="&a;201224912"
	 b:glossaryEntry="endure emotional pain"/>
<rdf:Description rdf:about="&a;201225068">
	<b:glossaryEntry>suffer the loss of a person through death or removal; "She lost her husband in the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201225225"
	 b:glossaryEntry="be mad, angry, or furious"/>
<rdf:Description rdf:about="&a;201225320">
	<b:glossaryEntry>blow one''s stack; fly off the handle, flip one''s wig; lose one''s temper; blow a fuse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201225491"
	 b:glossaryEntry="put into a rage; make violently angry"/>
<rdf:Description rdf:about="&a;201225618"
	 b:glossaryEntry="feel intense anger"/>
<rdf:Description rdf:about="&a;201225706">
	<b:glossaryEntry>feel sudden intense sensation or emotion; "he was thrilled by the speed and the roar of the engine."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201225879"
	 b:glossaryEntry="feel remorse for; feel sorry for; be contrite about"/>
<rdf:Description rdf:about="&a;201226025"
	 b:glossaryEntry="turn away from sin or do penitence"/>
<rdf:Description rdf:about="&a;201226113"
	 b:glossaryEntry="feel sad about the loss or absence of"/>
<rdf:Description rdf:about="&a;201226222"
	 b:glossaryEntry='fell sadness; "She is mourning her dead child"'/>
<rdf:Description rdf:about="&a;201226339">
	<b:glossaryEntry>observe the customs of mourning after the death of a loved one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201226464"
	 b:glossaryEntry="feel grief; eat one''s heart out"/>
<rdf:Description rdf:about="&a;201226612"
	 b:glossaryEntry="break the heart of; cause to feel sorrow"/>
<rdf:Description rdf:about="&a;201226745"
	 b:glossaryEntry="cause great unhappiness for"/>
<rdf:Description rdf:about="&a;201226873"
	 b:glossaryEntry="cause mental pain to"/>
<rdf:Description rdf:about="&a;201226967"
	 b:glossaryEntry='test the limits of; "You are trying my patience!"'/>
<rdf:Description rdf:about="&a;201227121"
	 b:glossaryEntry="rack one''s brains"/>
<rdf:Description rdf:about="&a;201227200">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give pain or trouble to; "I''ve been sorely tried by these students"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201227336"
	 b:glossaryEntry="fail to meet the hopes or expectations of"/>
<rdf:Description rdf:about="&a;201227518">
	<b:glossaryEntry>disappoint, prove undependable to; abandon, forsake; "His sense of smell failed him this time"; "His strength finally failed him"; "His children failed him in the crisis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201227767"
	 b:glossaryEntry="fail to meet (expectations or standards)"/>
<rdf:Description rdf:about="&a;201227912">
	<b:glossaryEntry>hinder or prevent (the efforts, plans, or desires) of; thwart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201228083">
	<b:glossaryEntry>make ineffective or powerless; "The teachers were hamstrung by the overly rigid schedules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201228249"
	 b:glossaryEntry="lower in esteem; hurt the pride of"/>
<rdf:Description rdf:about="&a;201228413"
	 b:glossaryEntry="reduce in worth, character, etc.; disgrace; dishonour"/>
<rdf:Description rdf:about="&a;201228606"
	 b:glossaryEntry='make inconspicuous: "efface onself"'/>
<rdf:Description rdf:about="&a;201228705">
	<b:glossaryEntry>lower in grade or rank; "She reduced her niece to a servant"; force somebody into an unpleasant situation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201228874">
	<b:glossaryEntry>show to be irresponsible; demonstrate someone''s incompetence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201229000"
	 b:glossaryEntry="deprive of human qualities"/>
<rdf:Description rdf:about="&a;201229112"
	 b:glossaryEntry="make more human"/>
<rdf:Description rdf:about="&a;201229222"
	 b:glossaryEntry='cause to be unpretentious; "This exeprience will humble him"'/>
<rdf:Description rdf:about="&a;201229372">
	<b:glossaryEntry xml:space='preserve'><![CDATA[hold within limits and control; "subdue one''s appetites"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201229528"
	 b:glossaryEntry="express grief verbally"/>
<rdf:Description rdf:about="&a;201229639"
	 b:glossaryEntry="give verbal or other expression to one''s feelings"/>
<rdf:Description rdf:about="&a;201229834"
	 b:glossaryEntry="torment emotionally or mentally"/>
<rdf:Description rdf:about="&a;201229968"
	 b:glossaryEntry="annoy constantly"/>
<rdf:Description rdf:about="&a;201230185">
	<b:glossaryEntry>annoy persistently; "The children teased the boy because of his stammer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201230365"
	 b:glossaryEntry="offer and withdraw"/>
<rdf:Description rdf:about="&a;201230482">
	<b:glossaryEntry xml:space='preserve'><![CDATA[influence skilfully to one''s advantage; "She manipulates her boss"; "She is a very controlling mother and doesn''t let her children grow up"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201230743"
	 b:glossaryEntry="gain favor with somebody by deliberate efforts"/>
<rdf:Description rdf:about="&a;201230883">
	<b:glossaryEntry>ingratiate oneself to; often with insincere behavior; "She is playing up to the chairman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201231091"
	 b:glossaryEntry="be excited or anxious about"/>
<rdf:Description rdf:about="&a;201231225">
	<b:glossaryEntry>become excited about; "He warmed to the idea of a trip to Antarctica"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201231359"
	 b:glossaryEntry="be apathetic, gloomy, or dazed"/>
<rdf:Description rdf:about="&a;201231478"
	 b:glossaryEntry="be in a huff; be silent or sullen"/>
<rdf:Description rdf:about="&a;201231606"
	 b:glossaryEntry='feel or suffer from the lack of: "He misses his mother"'/>
<rdf:Description rdf:about="&a;201231785"
	 b:glossaryEntry="have a yen for"/>
<rdf:Description rdf:about="&a;201231918"
	 b:glossaryEntry="recognize with gratitude; be grateful for"/>
<rdf:Description rdf:about="&a;201232027"
	 b:glossaryEntry="prepare (oneself) for something unpleasant or difficult"/>
<rdf:Description rdf:about="&a;201232171"
	 b:glossaryEntry="get ready for something difficult or unpleasant"/>
<rdf:Description rdf:about="&a;201232289"
	 b:glossaryEntry="gain courage"/>
<rdf:Description rdf:about="&a;201232387">
	<b:glossaryEntry xml:space='preserve'><![CDATA[attract; cause to be enamored; "She captured all the men''s hearts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201232663"
	 b:glossaryEntry='appear inviting; "The shop window decorations beckoned"'/>
<rdf:Description rdf:about="&a;201232782">
	<b:glossaryEntry>make attractive or lovable: "This behavior endeared her to me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201232908">
	<b:glossaryEntry xml:space='preserve'><![CDATA[provoke the hostility of; "Don''t antagonize your boss"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201233051"
	 b:glossaryEntry="give rise to a desire"/>
<rdf:Description rdf:about="&a;201233160"
	 b:glossaryEntry="try to seduce"/>
<rdf:Description rdf:about="&a;201233236">
	<b:glossaryEntry>be attractive to; "The idea of a vacation appeals to me"; "The beautiful garden attracted many people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201233464">
	<b:glossaryEntry>attract or elicit; "The school attracts students with artistic talents"; "His playing drew a crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201233712">
	<b:glossaryEntry>attract the attention of; "The noise and the screaming brought the curious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201233868"
	 b:glossaryEntry="cause aversion in; offend the moral sense of"/>
<rdf:Description rdf:about="&a;201234043"
	 b:glossaryEntry="cause to feel intense dislike or distaste"/>
<rdf:Description rdf:about="&a;201234179"
	 b:glossaryEntry="be repellent to; cause aversion in"/>
<rdf:Description rdf:about="&a;201234366"
	 b:glossaryEntry="surprise greatly; knock someone''s socks off"/>
<rdf:Description rdf:about="&a;201234562"
	 b:glossaryEntry="overcome, as with emotions or perceptual stimuli"/>
<rdf:Description rdf:about="&a;201234840">
	<b:glossaryEntry>overwhelm with hilarity, pleasure, or admiration; "The comedian was so funny, he was killing me!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201235007"
	 b:glossaryEntry="silence or overwhelm by shouting"/>
<rdf:Description rdf:about="&a;201235107"
	 b:glossaryEntry="overtake with darkness or night"/>
<rdf:Description rdf:about="&a;201235203">
	<b:glossaryEntry>overwhelm with admiration; "All the guys were knocked out by her charm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201235349">
	<b:glossaryEntry>astound or overwhelm, as with shock: "She was staggered with bills after she tried to rebuild her house following the earthquake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201235543">
	<b:glossaryEntry>hold fast (in a certain state); "He was locked in a laughing fit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201235670">
	<b:glossaryEntry>strike with disgust or revulsion; "The scandalous behavior of this married woman shocked her friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201235891">
	<b:glossaryEntry xml:space='preserve'><![CDATA[abandon hope; give up hope; lose heart; "Don''t despair--help is on the way!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201236040">
	<b:glossaryEntry>be optimistic; be full of hope; have hopes; "I am still hoping that all will turn out well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201236227"
	 b:glossaryEntry="fill with high spirits; fill with optimism"/>
<rdf:Description rdf:about="&a;201236454"
	 b:glossaryEntry='make proud or conceited; "The sudden fame puffed her ego"'/>
<rdf:Description rdf:about="&a;201236581">
	<b:glossaryEntry>fill with sublime emotion; tickle pink(exhilarate is obsolete in this usage); "The children were thrilled at the prospect of going to the movies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201236819">
	<b:glossaryEntry>heighten or intensify; "These paintings exalt the imagination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201237013"
	 b:glossaryEntry="become glad or happy"/>
<rdf:Description rdf:about="&a;201237116"
	 b:glossaryEntry="make unhappy; ''The news of her death saddened me''"/>
<rdf:Description rdf:about="&a;201237297"
	 b:glossaryEntry="come to feel sad"/>
<rdf:Description rdf:about="&a;201237403"
	 b:glossaryEntry="make glad or happy"/>
<rdf:Description rdf:about="&a;201237518"
	 b:glossaryEntry="feel extreme happiness or elation"/>
<rdf:Description rdf:about="&a;201237680"
	 b:glossaryEntry="feel happiness or joy"/>
<rdf:Description rdf:about="&a;201237834"
	 b:glossaryEntry="make more cheerful"/>
<rdf:Description rdf:about="&a;201237971"
	 b:glossaryEntry="be oppressive or disheartening to"/>
<rdf:Description rdf:about="&a;201238101">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lower someone''s spirits; make downhearted; "These news depressed her"; "The bad state of her child''s health demoralizes her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201238399"
	 b:glossaryEntry="give moral or emotional strength to"/>
<rdf:Description rdf:about="&a;201238553"
	 b:glossaryEntry="lessen the intensity of; calm; as of of anxieties and fears"/>
<rdf:Description rdf:about="&a;201238726">
	<b:glossaryEntry>discharge bad feelings or tension through verbalization, in psychoanalysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201238865"
	 b:glossaryEntry="give pleasure to; be pleasing to"/>
<rdf:Description rdf:about="&a;201239069"
	 b:glossaryEntry="excite pleasurably"/>
<rdf:Description rdf:about="&a;201239189"
	 b:glossaryEntry="make happy or satisfied"/>
<rdf:Description rdf:about="&a;201239331"
	 b:glossaryEntry="fail to satisfy"/>
<rdf:Description rdf:about="&a;201239476"
	 b:glossaryEntry='make content; "I am contented"'/>
<rdf:Description rdf:about="&a;201239597"
	 b:glossaryEntry="make dissatisfied"/>
<rdf:Description rdf:about="&a;201239708"
	 b:glossaryEntry="give displeasure to"/>
<rdf:Description rdf:about="&a;201239874"
	 b:glossaryEntry="hold spellbound"/>
<rdf:Description rdf:about="&a;201240044"
	 b:glossaryEntry="free from enchantment"/>
<rdf:Description rdf:about="&a;201240173"
	 b:glossaryEntry="give encouragement to"/>
<rdf:Description rdf:about="&a;201240333">
	<b:glossaryEntry>become heartened or elated; "Her spirits rose when she heard the good news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201240452"
	 b:glossaryEntry="inspire with confidence; give hope or courage to"/>
<rdf:Description rdf:about="&a;201240719"
	 b:glossaryEntry="encourage to be less reserved, as of a shy person"/>
<rdf:Description rdf:about="&a;201240859"
	 b:glossaryEntry="give heart or courage to"/>
<rdf:Description rdf:about="&a;201240960">
	<b:glossaryEntry xml:space='preserve'><![CDATA[depress or discourage; "The news of the city''s surrender chilled the soldiers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201241117">
	<b:glossaryEntry>deprive of courage or hope; take away hope from; cause to feel discouraged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201241339"
	 b:glossaryEntry="take away the enthusiasm of"/>
<rdf:Description rdf:about="&a;201241470"
	 b:glossaryEntry="to compel or deter by or as if by threats"/>
<rdf:Description rdf:about="&a;201241634"
	 b:glossaryEntry="make a fuss; be agitated"/>
<rdf:Description rdf:about="&a;201241746"
	 b:glossaryEntry="make upset or troubled"/>
<rdf:Description rdf:about="&a;201241840"
	 b:glossaryEntry="act nervously; be undecided; be uncertain"/>
<rdf:Description rdf:about="&a;201241953">
	<b:glossaryEntry>derive or receive pleasure from; get enjoyment from; take pleasure in; "She relished her fame and basked in her glory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201242209"
	 b:glossaryEntry='enjoy avidly, as of a book; "She devoured his novels"'/>
<rdf:Description rdf:about="&a;201242326"
	 b:glossaryEntry="exasperate or irritate"/>
<rdf:Description rdf:about="&a;201242449">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to render motionless, as with a fixed stare or by arousing terror or awe: "The eye of the Ancient Mariner fascinated the wedding guest." Burton; "The serpent fascinates its prey,..by the power of his eyes." Todd & Bowman]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201242774"
	 b:glossaryEntry="excite the curiosity of; engage the interest of"/>
<rdf:Description rdf:about="&a;201242949"
	 b:glossaryEntry='to stimulate to action : "..startled him awake."'/>
<rdf:Description rdf:about="&a;201243090"
	 b:glossaryEntry="cause to be bored"/>
<rdf:Description rdf:about="&a;201243184"
	 b:glossaryEntry="share the suffering of"/>
<rdf:Description rdf:about="&a;201243364"
	 b:glossaryEntry="to feel or express sympathy or compassion"/>
<rdf:Description rdf:about="&a;201243513">
	<b:glossaryEntry>express one''s sympathetic grieve, as on the death of someone to his survivors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201243663"
	 b:glossaryEntry="share the feelings of; understand the sentiments of"/>
<rdf:Description rdf:about="&a;201243790">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feel concern or interest; "I really care about my work"; "I don''t care"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201243967">
	<b:glossaryEntry xml:space='preserve'><![CDATA[show no concern or interest; always used in the negative: "I don''t give a hoot"; "She doesn''t give a damn about her job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201244174"
	 b:glossaryEntry="be ecstatic with joy"/>
<rdf:Description rdf:about="&a;201244286">
	<b:glossaryEntry>arouse enmity or indifference in where there had formerly been love, affection, or friendliness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201244504"
	 b:glossaryEntry="detach the affections of"/>
<rdf:Description rdf:about="&a;201244590"
	 b:glossaryEntry='hope for; have a wish; "I wish I could go home now"'/>
<rdf:Description rdf:about="&a;201244729">
	<b:glossaryEntry>feel or express a desire or hope concerning the future or fortune of</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201244897">
	<b:glossaryEntry>prefer or wish to do something; "Do you care to try this dish?" "Would you like to come along to the movies?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201245100">
	<b:glossaryEntry>be the will of or have the will (to); "he could do many things if he pleased"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201245250"
	 b:glossaryEntry="wish ill or allow unwillingly"/>
<rdf:Description rdf:about="&a;201245362">
	<b:glossaryEntry>feel or have a desire for; want strongly; "I want to go home now; "I want my own room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201245795">
	<b:glossaryEntry xml:space='preserve'><![CDATA[want to have; "I''d like a beer now!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201245893"
	 b:glossaryEntry="have as one''s ambition"/>
<rdf:Description rdf:about="&a;201245981">
	<b:glossaryEntry>have an inclination for something or some activity; "I feel like staying in bed all day"; "I feel like a cold beer now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201246175"
	 b:glossaryEntry="express a desire for"/>
<rdf:Description rdf:about="&a;201246259">
	<b:glossaryEntry>like better; value more highly; "Some people prefer camping to staying in hotels"; "We prefer sleeping outside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201246466">
	<b:glossaryEntry>expect with desire; "I trust you will behave better from now on"; "I hope she understands that she cannot exepct a raise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201246666"
	 b:glossaryEntry="be envious of; set one''s heart on"/>
<rdf:Description rdf:about="&a;201246798">
	<b:glossaryEntry xml:space='preserve'><![CDATA[wish, long, or crave for (something, esp. the property of another person); "She covets her sister''s house"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201246968"
	 b:glossaryEntry="feel envious towards; admire enviously"/>
<rdf:Description rdf:about="&a;201247076"
	 b:glossaryEntry="envy without restraint"/>
<rdf:Description rdf:about="&a;201247189"
	 b:glossaryEntry="feel admiration for"/>
<rdf:Description rdf:about="&a;201247311">
	<b:glossaryEntry>have a strong sexual desire for; "he is lusting after his secretary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201247460"
	 b:glossaryEntry="desire strongly or persistently"/>
<rdf:Description rdf:about="&a;201247570"
	 b:glossaryEntry="have a liking, fondness, or taste (for)"/>
<rdf:Description rdf:about="&a;201247684"
	 b:glossaryEntry='get pleasure from; "I love cooking"'/>
<rdf:Description rdf:about="&a;201247815"
	 b:glossaryEntry="be in want of"/>
<rdf:Description rdf:about="&a;201247914"
	 b:glossaryEntry='feel pride of; "She took great pride in her sons"'/>
<rdf:Description rdf:about="&a;201248047"
	 b:glossaryEntry="lose one''s emotional or mental composure"/>
<rdf:Description rdf:about="&a;201248170">
	<b:glossaryEntry>feel strong emotion, esp. anger or passion; "She was burning with anger"; "He was burning to try out his new skies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201248347"
	 b:glossaryEntry='become suddenly excited or angry; "She flares up easily"'/>
<rdf:Description rdf:about="&a;201248467">
	<b:glossaryEntry>feel indifferent towards; "She died to worldly things and eventually entered a monastery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201248617"
	 b:glossaryEntry='be elated; "He was flying high during the summer months"'/>
<rdf:Description rdf:about="&a;201248739">
	<b:glossaryEntry>experience a feeling of well-being or happiness, as from good health or an intense emotion; "She was beaming with joy"; "Her face radiated with happiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201248980">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be exuberant or high-spirited; "Make the people''s hearts glow"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201249112"
	 b:glossaryEntry="cause to feel enthusiasm"/>
<rdf:Description rdf:about="&a;201249227">
	<b:glossaryEntry>cause to be enthusiastic; "Her playing brought down the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201249365">
	<b:glossaryEntry>move so as to change position, as of a body part (nontranslational motion): "He moved his hand slightly to the right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201251262">
	<b:glossaryEntry>take position in the rear, esp. of a military formation or team sporting event, "The defender dropped back behind his teammate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201251456">
	<b:glossaryEntry>fall or drop suddenly, usually to evade some danger; "The soldiers hit the dirt when they heard gunfire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201251646"
	 b:glossaryEntry='"He fell down to his knees'/>
<rdf:Description rdf:about="&a;201251793"
	 b:glossaryEntry='of body parts: "prolapsed rectum"'/>
<rdf:Description rdf:about="&a;201251892">
	<b:glossaryEntry>dash violently or with great speed or impetuosity; "She plunged at it eagerly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201252034"
	 b:glossaryEntry='move gently or carefully; "He eased himself into the chair"'/>
<rdf:Description rdf:about="&a;201252181"
	 b:glossaryEntry="move with a whish"/>
<rdf:Description rdf:about="&a;201252269"
	 b:glossaryEntry="remain in place; hold still; remain fixed or immobile"/>
<rdf:Description rdf:about="&a;201252435">
	<b:glossaryEntry>stop moving or become immobilized; "When he saw the police car he froze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201252601"
	 b:glossaryEntry='be unable to move further; "The car bogged down in the sand"'/>
<rdf:Description rdf:about="&a;201252772"
	 b:glossaryEntry='cause to get stuck as if in a mire; "The mud mired our cart"'/>
<rdf:Description rdf:about="&a;201252913"
	 b:glossaryEntry="of boats"/>
<rdf:Description rdf:about="&a;201253005"
	 b:glossaryEntry="move due to the pull of gravitation"/>
<rdf:Description rdf:about="&a;201253107">
	<b:glossaryEntry>change location; move, travel, or proceed; "How fast does your new car go?" "We travelled from Rome to Naples by bus"; "The policemen went from door to door looking for the suspect";"The soldiers moved towards the city in an attempt to take it before night fell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201255856"
	 b:glossaryEntry='go to or towards; "a liquid seeks its own level"'/>
<rdf:Description rdf:about="&a;201255966">
	<b:glossaryEntry>move with a whining sound; "The bullets were whining past us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201256090"
	 b:glossaryEntry='be dissipated; "Rumors and accusations are flying"'/>
<rdf:Description rdf:about="&a;201256209">
	<b:glossaryEntry>move like a floating object; "The moon rode high in the night sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201256361"
	 b:glossaryEntry='cover a certain distance: "She came a long way"'/>
<rdf:Description rdf:about="&a;201256478">
	<b:glossaryEntry>move like a ghost; "The masked men ghosted across the moonlit yard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201256616"
	 b:glossaryEntry="displace oneself; go from one location to another"/>
<rdf:Description rdf:about="&a;201256745"
	 b:glossaryEntry='fly over; "The plane passed over Damascus"'/>
<rdf:Description rdf:about="&a;201256872">
	<b:glossaryEntry>travel in an airplane; "she is flying to Cincinnati tonight"; "Are we driving or flying?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201257030">
	<b:glossaryEntry>informal: travel by means of an aircraft, bus, etc.; "She hopped a train to Chicago"; "He hopped rides all over the country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201257215"
	 b:glossaryEntry="undergo transportation, as in a vehicle"/>
<rdf:Description rdf:about="&a;201257396"
	 b:glossaryEntry="direct one''s course or way"/>
<rdf:Description rdf:about="&a;201257484"
	 b:glossaryEntry='cause to sheer: "She sheered her car around the obstacle"'/>
<rdf:Description rdf:about="&a;201257604">
	<b:glossaryEntry>travel or traverse (a distance) "This car does 150 miles per hour"; "We did 6 miles on our hike every day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201257779"
	 b:glossaryEntry="travel by boat, car, or plane"/>
<rdf:Description rdf:about="&a;201257892"
	 b:glossaryEntry="navigate in space; of astronauts"/>
<rdf:Description rdf:about="&a;201257991"
	 b:glossaryEntry='move quickly or suddenly; "He flew about the place"'/>
<rdf:Description rdf:about="&a;201258127">
	<b:glossaryEntry>leave the house to go somewhere; "We never went out when our children were small"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201258290"
	 b:glossaryEntry='travel by raft in water; "Raft the Colorado River"'/>
<rdf:Description rdf:about="&a;201258418">
	<b:glossaryEntry>travel or go by means of a certain kind of transportation, or a certain route: "He takes the bus to work"; "She takes Route 1 to Newark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201258616">
	<b:glossaryEntry>move around; move from place to place; "How does she get around without a car?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201258783"
	 b:glossaryEntry="make a trip for pleasure"/>
<rdf:Description rdf:about="&a;201259002"
	 b:glossaryEntry="go on a junket"/>
<rdf:Description rdf:about="&a;201259080">
	<b:glossaryEntry>move travel or proceed toward something; "He went to his cabin."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201259232"
	 b:glossaryEntry="go to certain places"/>
<rdf:Description rdf:about="&a;201259363"
	 b:glossaryEntry="visit famous or interesting sights"/>
<rdf:Description rdf:about="&a;201259471">
	<b:glossaryEntry>come to see in an official or professional capacity; "The governor visited the prison"; "The grant administrator visited the laboratory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201259670"
	 b:glossaryEntry='visit again: "We revisited Rome after 25 years"'/>
<rdf:Description rdf:about="&a;201259782"
	 b:glossaryEntry="be a regular or frequent visitor to a certain place"/>
<rdf:Description rdf:about="&a;201259899"
	 b:glossaryEntry="go on a cruise"/>
<rdf:Description rdf:about="&a;201259985"
	 b:glossaryEntry="travel at a moderate speed; of vessels or airplanes"/>
<rdf:Description rdf:about="&a;201260134"
	 b:glossaryEntry="cruise in slow or routine flights"/>
<rdf:Description rdf:about="&a;201260239"
	 b:glossaryEntry="make a tour of a certain place"/>
<rdf:Description rdf:about="&a;201260375"
	 b:glossaryEntry="travel all over the world for pleasure and sightseeing"/>
<rdf:Description rdf:about="&a;201260505">
	<b:glossaryEntry>give theatrical performances while traveling from town to town</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201260638"
	 b:glossaryEntry="travel as for pleasure and sightseeing; go on travels"/>
<rdf:Description rdf:about="&a;201260845">
	<b:glossaryEntry>travel with a sledge; "the antarctic expedition sledged along the coastline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201260993"
	 b:glossaryEntry="travel by boat"/>
<rdf:Description rdf:about="&a;201261115">
	<b:glossaryEntry>travel by ship on (a body of water); "We sailed the Atlantic"; "This frigate has sailed to France"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201261299"
	 b:glossaryEntry='travel upon or across; "travel the oceans"'/>
<rdf:Description rdf:about="&a;201261495">
	<b:glossaryEntry>ride over, along, or through: "Travel the highways of America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201261627">
	<b:glossaryEntry>travel over (an area of land or sea) in an aircraft; "Lindbergh was the first to fly the Atlantic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201261786"
	 b:glossaryEntry='cause to fly or float: "fly a kite"'/>
<rdf:Description rdf:about="&a;201261882"
	 b:glossaryEntry="be stationary"/>
<rdf:Description rdf:about="&a;201261992">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move in order to make room for someone for something; "The park gave way to a supermarket"; "`Move over,'' he told the crowd"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201262245">
	<b:glossaryEntry>move away from a place into another direction; "Go away before I start to cry"; "The train departs at noon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201262491">
	<b:glossaryEntry>leave; informal or rude: "shove off!"; "The children shoved along"; "Blow now!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201262658">
	<b:glossaryEntry>move toward, travel toward something or somebody or approach something or somebody; "He came singing down the road"; "Come with me to the Casbah"; "come down here!"; "come out of the closet!"; "come into the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201263165">
	<b:glossaryEntry>metaphorically, as in time; "Winter is approaching"; "approaching old age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201263393">
	<b:glossaryEntry xml:space='preserve'><![CDATA[grow late or (of time) elapse; "It is getting on midnight--let''s all go to bed!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201263545">
	<b:glossaryEntry>approach while driving; "The truck entered the driveway and drove up towards the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201263706"
	 b:glossaryEntry='cause to move; "Move those boxes into the corner, please"'/>
<rdf:Description rdf:about="&a;201265292">
	<b:glossaryEntry>move in ran agitated manner; "His fingers worked with tension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201265417"
	 b:glossaryEntry="move text to the previous line; in printing"/>
<rdf:Description rdf:about="&a;201265527">
	<b:glossaryEntry>move into the center; "That vase in the picture is not centered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201265700">
	<b:glossaryEntry>enter again; "You cannot re-enter the country with this visa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201265859"
	 b:glossaryEntry="raise with a pump; of gases or fluids"/>
<rdf:Description rdf:about="&a;201265966"
	 b:glossaryEntry="move up and down, as of weights"/>
<rdf:Description rdf:about="&a;201266059"
	 b:glossaryEntry="draw or pour with a pump"/>
<rdf:Description rdf:about="&a;201266171"
	 b:glossaryEntry="convey, draw off, or empty by or as if by a siphon"/>
<rdf:Description rdf:about="&a;201266307"
	 b:glossaryEntry="draw through a sluice, as of water"/>
<rdf:Description rdf:about="&a;201266405"
	 b:glossaryEntry="transport in or send down a sluice, as of logs"/>
<rdf:Description rdf:about="&a;201266515">
	<b:glossaryEntry>take liquid out of a container or well; "She drew water from the barrel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201266812">
	<b:glossaryEntry>draw something in by or as if by a vacuum; "Mud was sucking at her feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201266956"
	 b:glossaryEntry="draw off from the lees, as of wine"/>
<rdf:Description rdf:about="&a;201267052">
	<b:glossaryEntry>lift and reset in another soil or situation; "Transplant the young rice plants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201267218">
	<b:glossaryEntry>move a light beam over; in electronics, to reproduce an image</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201267341">
	<b:glossaryEntry>change residence, affiliation, or place of employment; "We moved from Idaho to Nebraska"; "The basketball player moved from one team to another"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201267627"
	 b:glossaryEntry="move into a new house or office"/>
<rdf:Description rdf:about="&a;201267741"
	 b:glossaryEntry='occupy a place; "The crowds are moving in"'/>
<rdf:Description rdf:about="&a;201267856"
	 b:glossaryEntry="move out of one''s old house or office"/>
<rdf:Description rdf:about="&a;201267995"
	 b:glossaryEntry="move out and leave nothing behind"/>
<rdf:Description rdf:about="&a;201268095">
	<b:glossaryEntry>move out of an unsafe location into safety; "AFter the earthquake, residents were evacuated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201268253"
	 b:glossaryEntry="move from one place to another"/>
<rdf:Description rdf:about="&a;201268426">
	<b:glossaryEntry>stay put (in a certain place); "We are staying in Detroit; we are not moving to Cincinnati"; "Stay put in the corner here!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201268695">
	<b:glossaryEntry>get going or set in motion; "We simply could not start the engine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201268933">
	<b:glossaryEntry>stop or check by or as if by a pull at the reins; "He reined in his horses in front of the post office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201269108">
	<b:glossaryEntry>start a car engine with wire instead of a key, as when stealing the car</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201269245"
	 b:glossaryEntry="restart and engine, for example"/>
<rdf:Description rdf:about="&a;201269341"
	 b:glossaryEntry="start by cranking; of engines"/>
<rdf:Description rdf:about="&a;201269444"
	 b:glossaryEntry="wind around; move along a circular course"/>
<rdf:Description rdf:about="&a;201269548"
	 b:glossaryEntry="of car engines"/>
<rdf:Description rdf:about="&a;201269636"
	 b:glossaryEntry='cause to stop; "stop a car"; "stop the thief"'/>
<rdf:Description rdf:about="&a;201269947">
	<b:glossaryEntry>cause to stop; "Halt the engines"; "Arrest the progress"; "halt the presses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201270125">
	<b:glossaryEntry>cause to come to a sudden stop; "The noise brought her up in shock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201270266"
	 b:glossaryEntry='stop filming; "cut a movie scene"'/>
<rdf:Description rdf:about="&a;201270378">
	<b:glossaryEntry>make an abrupt change of image or sound; "cut from one scene to another"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201270573">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move quickly to another scene or focus, as in filming; "`cut away now!'' the director shouted"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201270740">
	<b:glossaryEntry>move to another scene, as in filming; "The camera cut to the sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201270877"
	 b:glossaryEntry="signal to stop; of cabs or cab drivers"/>
<rdf:Description rdf:about="&a;201270990">
	<b:glossaryEntry>come to a halt, stop moving; "the car stopped"; "She stopped in front of a store window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201271353">
	<b:glossaryEntry>stop for a moment, as if out of uncertainty or caution; "She checked for an instant and missed a step"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201271554"
	 b:glossaryEntry='stop in a chase esp. when scent is lost; "The dog checked"'/>
<rdf:Description rdf:about="&a;201271693">
	<b:glossaryEntry>abandon the intended prey, turn, and pursue an inferior prey, of falcons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201271846">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stop or slow up one''s horse or oneself by or as if by pulling the reins; "They reined in in front of the post office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201272059"
	 b:glossaryEntry='come to a stop; "The car stalled in the driveway"'/>
<rdf:Description rdf:about="&a;201272178">
	<b:glossaryEntry>cause an engine to stop; "The inexperienced driver kept stalling the car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201272322"
	 b:glossaryEntry="cause an airplane to go into a stall"/>
<rdf:Description rdf:about="&a;201272421"
	 b:glossaryEntry="experience a stall in flight, of airplanes"/>
<rdf:Description rdf:about="&a;201272526">
	<b:glossaryEntry xml:space='preserve'><![CDATA[interrupt a trip; "we stopped at Aunt Mary''s house"; "they stopped for three days in Florence"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201272712">
	<b:glossaryEntry>as of vehicles or their riders; "The Rolls pulled up on pour front lawn"; "The chauffeur hauled up in front of us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201272919">
	<b:glossaryEntry>cause to stop; as of vehicles; "He pulled up the car in front of the hotel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201273069"
	 b:glossaryEntry="cause to stop by applying the brakes"/>
<rdf:Description rdf:about="&a;201273194">
	<b:glossaryEntry>stop travelling by applying a brake; "We had to brake suddenly when a chicken crossed the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201273360">
	<b:glossaryEntry>travel a route regularly; "Ships ply the waters near the coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201273498">
	<b:glossaryEntry>begin or set in motion; "I start at eight in the morning"; "Ready, set, go!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201273706">
	<b:glossaryEntry>get started or set in motion, used figuratively, as of a project,</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201273866"
	 b:glossaryEntry="move abruptly"/>
<rdf:Description rdf:about="&a;201273966"
	 b:glossaryEntry="move or cause to move with a sudden jerky motion"/>
<rdf:Description rdf:about="&a;201274098"
	 b:glossaryEntry='shock physically; "George was shaken up in the Tech game"'/>
<rdf:Description rdf:about="&a;201274249">
	<b:glossaryEntry>to move (the head or body) quickly downwards or away: "Before he could duck, another stone struck him."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201274431">
	<b:glossaryEntry>move up and down repeatedly; "her rucksack bobbed gently on her back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201274587"
	 b:glossaryEntry="move (a baby) up and down in one''s arms or on one''s knees"/>
<rdf:Description rdf:about="&a;201274708"
	 b:glossaryEntry="bob aimlessly, as of a cork in water"/>
<rdf:Description rdf:about="&a;201274832"
	 b:glossaryEntry="roll around, as of a pig in mud"/>
<rdf:Description rdf:about="&a;201274944">
	<b:glossaryEntry>to rotate or cause to rotate: "The child rolled down the hill"; "She rolled the ball her eyes at his words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201275187"
	 b:glossaryEntry="do a somersault"/>
<rdf:Description rdf:about="&a;201275270"
	 b:glossaryEntry='make a rolling motion or turn; "The dog rolled over"'/>
<rdf:Description rdf:about="&a;201275451"
	 b:glossaryEntry="roll over and over, back and forth"/>
<rdf:Description rdf:about="&a;201275557"
	 b:glossaryEntry="move heavily; of vehicles, such as streetcars"/>
<rdf:Description rdf:about="&a;201275667"
	 b:glossaryEntry="sway to and fro"/>
<rdf:Description rdf:about="&a;201275761">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to move in a twisting or contorted motion, (esp. when struggling); "The prisoner writhed in discomfort." "The child tried to wriggle free from his aunt''s embrace."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201276058"
	 b:glossaryEntry="make a sudden twisting motion"/>
<rdf:Description rdf:about="&a;201276159"
	 b:glossaryEntry="move with slow, sinuous movements"/>
<rdf:Description rdf:about="&a;201276270">
	<b:glossaryEntry>move unsteadily; "His knees wobbled"; "The old cart wobbled down the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201276427"
	 b:glossaryEntry="move sideways"/>
<rdf:Description rdf:about="&a;201276512">
	<b:glossaryEntry>move unobtrusively or furtively; "The young man began to sidle near the pretty girl sitting on the log"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201276678"
	 b:glossaryEntry="jump straight up, as of kangaroos"/>
<rdf:Description rdf:about="&a;201276774">
	<b:glossaryEntry>move with sweeping, effortless, gliding motions; "The diva swept into the room"; "Shreds of paper sailed through the air"; "The searchlights swept across the sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201277068">
	<b:glossaryEntry>sweep majestically; "Airplanes were swanning over the mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201277218">
	<b:glossaryEntry>sweep across or over; "Her long skirt brushed the floor"; "A gasp swept cross the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201277396"
	 b:glossaryEntry="slide sideways"/>
<rdf:Description rdf:about="&a;201277579">
	<b:glossaryEntry>slide without control, as of a car that does not grip the road</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201277711">
	<b:glossaryEntry>slide sideways through the air in a downward direction in an airplane along an inclined lateral axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201277886"
	 b:glossaryEntry="apply a brake or skid to"/>
<rdf:Description rdf:about="&a;201277972"
	 b:glossaryEntry="move unsteadily or with a weaving or rolling motion"/>
<rdf:Description rdf:about="&a;201278111"
	 b:glossaryEntry="move suddenly"/>
<rdf:Description rdf:about="&a;201278186">
	<b:glossaryEntry>tremble or shake; "His voice wobbled with restrained emotion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201278320">
	<b:glossaryEntry>come into rough contact with while moving; "The passengers each other in the overcrowded train"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201278539">
	<b:glossaryEntry>come into rough contact while moving; "The passengers in the overcrowded train jostled against each other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201278717">
	<b:glossaryEntry>move with force, "He pushed the table into a corner"; "She pushed her chin out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201279248"
	 b:glossaryEntry="press against forcefully without being able to move"/>
<rdf:Description rdf:about="&a;201279385"
	 b:glossaryEntry="push or move with the nose"/>
<rdf:Description rdf:about="&a;201279473"
	 b:glossaryEntry="push to thrust outward"/>
<rdf:Description rdf:about="&a;201279592"
	 b:glossaryEntry="push out of the way"/>
<rdf:Description rdf:about="&a;201279715">
	<b:glossaryEntry xml:space='preserve'><![CDATA[force one''s way: "He muscled into the union"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201279828"
	 b:glossaryEntry="push upward"/>
<rdf:Description rdf:about="&a;201279964"
	 b:glossaryEntry="lift up or elevate"/>
<rdf:Description rdf:about="&a;201280046">
	<b:glossaryEntry>push upward; "She pushed up her children when the policeman came by"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201280204"
	 b:glossaryEntry="push one''s way with the elbows"/>
<rdf:Description rdf:about="&a;201280297"
	 b:glossaryEntry="push one''s way in with one''s shoulders"/>
<rdf:Description rdf:about="&a;201280404"
	 b:glossaryEntry="be driven or carried along"/>
<rdf:Description rdf:about="&a;201280508"
	 b:glossaryEntry="be carried with the tide"/>
<rdf:Description rdf:about="&a;201280594"
	 b:glossaryEntry="cause to float with the tide"/>
<rdf:Description rdf:about="&a;201280720">
	<b:glossaryEntry>set afloat; "He floated the logs down the river"; "The boy floated his toy boat on the pond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201280919"
	 b:glossaryEntry='set afloat again; "refloat a grounded boat"'/>
<rdf:Description rdf:about="&a;201281027">
	<b:glossaryEntry>travel volitionally and in a certain direction with a certain goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201281178"
	 b:glossaryEntry="move back and forth, like a ship"/>
<rdf:Description rdf:about="&a;201281339"
	 b:glossaryEntry="rock, sway, or nod; usually involuntarily"/>
<rdf:Description rdf:about="&a;201281444"
	 b:glossaryEntry="sway heavily or unsteadily"/>
<rdf:Description rdf:about="&a;201281540"
	 b:glossaryEntry="move in one direction and then into the opposite direction"/>
<rdf:Description rdf:about="&a;201281763">
	<b:glossaryEntry>rock or place in or as if in a cradle; "He cradled the infant in his arms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201281924"
	 b:glossaryEntry="move in an unstable manner"/>
<rdf:Description rdf:about="&a;201282045">
	<b:glossaryEntry>move or walk in a swinging or swaying manner; "He swung back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201282256">
	<b:glossaryEntry>change direction with a swinging motion; turn; "swing back"; "swing forward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201282403">
	<b:glossaryEntry>sway gently back and forth, as of flowers or tress in the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201282541"
	 b:glossaryEntry="lash about; flick sharply, as of animals'' tails"/>
<rdf:Description rdf:about="&a;201282650">
	<b:glossaryEntry>move or swing from side to side regularly; as of a pendulum, for example</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201282825"
	 b:glossaryEntry="vibrate, as of a swing before it comes to a total rest"/>
<rdf:Description rdf:about="&a;201282944"
	 b:glossaryEntry="move back and forth very rapidly, as of a candle"/>
<rdf:Description rdf:about="&a;201283094">
	<b:glossaryEntry>turn abruptly and face the other way; "He turned around to face his opponent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201283277">
	<b:glossaryEntry>expand and contract rhythmically; beat rhythmically; "The city pulsed with with music and excitement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201283459">
	<b:glossaryEntry>drive by or as if by pulsation; "A soft breeze pulsed the air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201283610"
	 b:glossaryEntry="beat rapidly, of the heart"/>
<rdf:Description rdf:about="&a;201283713"
	 b:glossaryEntry='move rhythmically; "Her heart was beating fast"'/>
<rdf:Description rdf:about="&a;201283900"
	 b:glossaryEntry="beat out a rhythm"/>
<rdf:Description rdf:about="&a;201284013">
	<b:glossaryEntry>indicate by beating; as with the fingers or drumsticks; "Beat the rhythm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201284192"
	 b:glossaryEntry='move noisily; "flags flapped in the strong wind"'/>
<rdf:Description rdf:about="&a;201284302"
	 b:glossaryEntry="move unsteadily, with a rocking motion"/>
<rdf:Description rdf:about="&a;201284430"
	 b:glossaryEntry='wander about aimlessly; "The gypsies roamed the woods"'/>
<rdf:Description rdf:about="&a;201284680"
	 b:glossaryEntry="wander aimlessly"/>
<rdf:Description rdf:about="&a;201284769">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take a walk; go for a walk; walk for pleasure; "Let''s walk around the lake--it''s a beautiful day"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201284936"
	 b:glossaryEntry="wander aimlessly in search of pleasure"/>
<rdf:Description rdf:about="&a;201285061">
	<b:glossaryEntry>to move or cause to move in a sinuous, spiral, or circular course: the river winds through the hills.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201285278">
	<b:glossaryEntry>move along a winding path; "The army snaked through the jungle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201285412">
	<b:glossaryEntry xml:space='preserve'><![CDATA[change place or direction; "Shift one''s position"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201285582">
	<b:glossaryEntry>dislodge from a position; "She beat the dealer down to a much better price"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201285748">
	<b:glossaryEntry>play or romp around; "The children frolicked in the garden"; "the gamboling lambs in the meadows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201286031"
	 b:glossaryEntry="move with increasing speed"/>
<rdf:Description rdf:about="&a;201286144"
	 b:glossaryEntry='move ahead steadily; "He forged ahead"'/>
<rdf:Description rdf:about="&a;201286261">
	<b:glossaryEntry>jump vertically, with legs stiff and back arched, as of horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201286408"
	 b:glossaryEntry="heel over"/>
<rdf:Description rdf:about="&a;201286558">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tilt or slant to one side; "cock one''s head"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201286664">
	<b:glossaryEntry>move sideways or in an unsteady way, as of a ship or a vehicle out of control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201286870">
	<b:glossaryEntry>rise or heave upward under the influence of a natural force, as on a wave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201287022"
	 b:glossaryEntry="be agitated; of liquids"/>
<rdf:Description rdf:about="&a;201287147"
	 b:glossaryEntry="agitate the air"/>
<rdf:Description rdf:about="&a;201287257"
	 b:glossaryEntry='blow on; "The wind was winnowing her hair"'/>
<rdf:Description rdf:about="&a;201287363">
	<b:glossaryEntry>move slowly; in the case of people or animals with the body near the ground; "The crocodile was crawling along the riverbed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201287584"
	 b:glossaryEntry="as of a snake"/>
<rdf:Description rdf:about="&a;201287667"
	 b:glossaryEntry='to move hurriedly: "The friend scrambled after them."'/>
<rdf:Description rdf:about="&a;201287786">
	<b:glossaryEntry>to pass or move unobtrusively or smoothly: "They slid through the wicket in the big gate,"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201288009"
	 b:glossaryEntry="move effortlessly; by force of gravity"/>
<rdf:Description rdf:about="&a;201288152"
	 b:glossaryEntry="coast in a vehicle using the freewheel"/>
<rdf:Description rdf:about="&a;201288265"
	 b:glossaryEntry="move along on or as if on wheels or a wheeled vehicle"/>
<rdf:Description rdf:about="&a;201288448"
	 b:glossaryEntry="roll (a ball), as in bowling"/>
<rdf:Description rdf:about="&a;201288538"
	 b:glossaryEntry='cause to move round and round; "The child trolled her hoop"'/>
<rdf:Description rdf:about="&a;201288660"
	 b:glossaryEntry="move smoothly and effortlessly"/>
<rdf:Description rdf:about="&a;201288913"
	 b:glossaryEntry="cause to move or pass silently, smoothly, or imperceptibly"/>
<rdf:Description rdf:about="&a;201289042"
	 b:glossaryEntry="glide easily along a surface"/>
<rdf:Description rdf:about="&a;201289159"
	 b:glossaryEntry="move smoothly, like a snake"/>
<rdf:Description rdf:about="&a;201289257"
	 b:glossaryEntry='move stealthily; "The ship slipped away in the darkness"'/>
<rdf:Description rdf:about="&a;201289419">
	<b:glossaryEntry>move involuntarily up and down or sideways; "His hands were trembling when he signed the document"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201289618">
	<b:glossaryEntry>shake with seismic vibrations, as of planets; "The earth was quaking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201289759"
	 b:glossaryEntry="tremble convulsively"/>
<rdf:Description rdf:about="&a;201289878"
	 b:glossaryEntry='shake with fast, tremulous movements"'/>
<rdf:Description rdf:about="&a;201289996">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move back and forth; "She shook her cousin''s hands"; "Don''t shake the bottle"; "My hands were shaking"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201290347"
	 b:glossaryEntry="shake violently"/>
<rdf:Description rdf:about="&a;201290427"
	 b:glossaryEntry="shake and cause to make a rattling noise"/>
<rdf:Description rdf:about="&a;201290539"
	 b:glossaryEntry="beat about"/>
<rdf:Description rdf:about="&a;201290704">
	<b:glossaryEntry>thrash about flexibly in the manner of a whiplash; "The tall grass whipped in the wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201290861">
	<b:glossaryEntry>shake, quiver, or throb; move mack and forth rapidly, usually in an uncontrolled manner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201291065">
	<b:glossaryEntry>swing from one hold to the next, as of some arboreal apes and monkeys</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201291209"
	 b:glossaryEntry="shake or vibrate rapidly"/>
<rdf:Description rdf:about="&a;201291321">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move with abrupt, seemingly uncontrolled motions; "The patient''s legs were jerkings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201291519"
	 b:glossaryEntry="jerk or toss one''s body about"/>
<rdf:Description rdf:about="&a;201291615">
	<b:glossaryEntry>spring back; spring away from an impact; "The rubber ball bounced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201291867"
	 b:glossaryEntry="move up and down repeatedly"/>
<rdf:Description rdf:about="&a;201291975"
	 b:glossaryEntry="bound off one point after another"/>
<rdf:Description rdf:about="&a;201292090">
	<b:glossaryEntry>rebound after hitting: "The car caromed off several lampposts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201292232"
	 b:glossaryEntry="as of coins"/>
<rdf:Description rdf:about="&a;201292328"
	 b:glossaryEntry="of boats"/>
<rdf:Description rdf:about="&a;201292413"
	 b:glossaryEntry="cause to move with a flick"/>
<rdf:Description rdf:about="&a;201292509">
	<b:glossaryEntry>toss with a sharp movement so as to cause to turn over in the air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201292661">
	<b:glossaryEntry>move or strike with a click; "then the brightness as he clicked on the light."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201292817"
	 b:glossaryEntry='move very slightly; "He shifted in his seat"'/>
<rdf:Description rdf:about="&a;201292957">
	<b:glossaryEntry>to begin moving, "As the thunder started the sleeping children began to stir"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201293113"
	 b:glossaryEntry='move with a stirring motion; "stir the soup"'/>
<rdf:Description rdf:about="&a;201293227"
	 b:glossaryEntry="to proceed quickly and easily"/>
<rdf:Description rdf:about="&a;201293338"
	 b:glossaryEntry="move in a graceful and rhythmical way"/>
<rdf:Description rdf:about="&a;201293528"
	 b:glossaryEntry="perform a glissade, in ballet"/>
<rdf:Description rdf:about="&a;201293623"
	 b:glossaryEntry="perform a chasse step, in ballet"/>
<rdf:Description rdf:about="&a;201293719"
	 b:glossaryEntry="perform a capriole, in ballet"/>
<rdf:Description rdf:about="&a;201293814"
	 b:glossaryEntry="dance the bebop"/>
<rdf:Description rdf:about="&a;201293898">
