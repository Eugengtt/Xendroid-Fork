	<b:glossaryEntry xml:space='preserve'><![CDATA[make one''s debut; "This young soprano debuts next months at the Metropolitan Opera"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201176483">
	<b:glossaryEntry>present for the first time to the public; "The and debuts a new song or two each month"</b:glossaryEntry>
