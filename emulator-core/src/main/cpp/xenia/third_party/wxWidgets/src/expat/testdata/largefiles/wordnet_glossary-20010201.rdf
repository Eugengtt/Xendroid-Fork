	 b:glossaryEntry="writing paper suitable for use in a typewriter"/>
<rdf:Description rdf:about="&a;110820597">
	<b:glossaryEntry>an amino acid found in most proteins; a precursor of several hormones</b:glossaryEntry>
</rdf:Description>
