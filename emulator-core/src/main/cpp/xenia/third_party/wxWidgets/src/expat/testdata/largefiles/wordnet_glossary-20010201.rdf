<rdf:Description rdf:about="&a;101867775"
	 b:glossaryEntry="coypus"/>
<rdf:Description rdf:about="&a;101867898"
	 b:glossaryEntry="a genus of Capromyidae"/>
<rdf:Description rdf:about="&a;101868032">
