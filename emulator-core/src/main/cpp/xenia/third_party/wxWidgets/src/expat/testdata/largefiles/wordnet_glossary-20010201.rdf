</rdf:Description>
<rdf:Description rdf:about="&a;101212194"
	 b:glossaryEntry="stout-bodied lizards"/>
<rdf:Description rdf:about="&a;101212335"
	 b:glossaryEntry="1 species"/>
<rdf:Description rdf:about="&a;101212460"
	 b:glossaryEntry="a stout-bodied pleurodont lizard of Borneo"/>
<rdf:Description rdf:about="&a;101212590"
	 b:glossaryEntry="only known venomous lizards"/>
<rdf:Description rdf:about="&a;101212759">
