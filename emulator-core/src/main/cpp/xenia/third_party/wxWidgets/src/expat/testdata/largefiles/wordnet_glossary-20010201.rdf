<rdf:Description rdf:about="&a;108402780"
	 b:glossaryEntry="of North America"/>
<rdf:Description rdf:about="&a;108402884"
	 b:glossaryEntry="a loosestrife vine"/>
<rdf:Description rdf:about="&a;108403018"
	 b:glossaryEntry="frequently considered a weed; Europe and Asia"/>
<rdf:Description rdf:about="&a;108403171">
	<b:glossaryEntry>North American plant with spikes of yellow flowers, found in wet places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108403326"
	 b:glossaryEntry="common North American yellow-flowered plant"/>
