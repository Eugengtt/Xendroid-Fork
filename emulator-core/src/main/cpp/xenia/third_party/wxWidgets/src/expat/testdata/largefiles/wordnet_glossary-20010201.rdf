<rdf:Description rdf:about="&a;102017576"
	 b:glossaryEntry="hakes"/>
<rdf:Description rdf:about="&a;102017693"
	 b:glossaryEntry="American hakes"/>
<rdf:Description rdf:about="&a;102017777"
	 b:glossaryEntry="ling"/>
<rdf:Description rdf:about="&a;102017885">
