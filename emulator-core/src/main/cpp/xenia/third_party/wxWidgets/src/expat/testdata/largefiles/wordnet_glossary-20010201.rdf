	 b:glossaryEntry="a bit of fiber that has become separated from woven fabric"/>
<rdf:Description rdf:about="&a;110767008">
	<b:glossaryEntry>brass with enough copper to give it a reddish tint; used for plumbing pipe and other brass hardware and in cheap jewelry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110767198">
	<b:glossaryEntry>a reddish oxide of lead (Pb3O4) used as a pigment in paints and in glass and ceramics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110767347"
	 b:glossaryEntry="a substance used to provide cooling (as in a refrigerator)"/>
<rdf:Description rdf:about="&a;110767481">
	<b:glossaryEntry>a solvent that removes a substance (usually from a surface); "paint remover" or "rust remover" but also "hair remover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110767653">
	<b:glossaryEntry>an enzyme that occurs in gastric juice; causes milk to coagulate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110767837"
	 b:glossaryEntry="matter that remains after something has been removed"/>
<rdf:Description rdf:about="&a;110767997"
	 b:glossaryEntry="a crystalline phenol obtained from various resins"/>
<rdf:Description rdf:about="&a;110768103"
	 b:glossaryEntry="retinal protein formed by the action of light on rhodopsin"/>
<rdf:Description rdf:about="&a;110768232">
	<b:glossaryEntry>either of two yellow to red retinal pigments formed from Rhodopsin by the action of light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110768405">
	<b:glossaryEntry>an decorative tile that is bent in cross section; used to cover the ridge of a roof</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110768545"
	 b:glossaryEntry="building material used in constructing roofs"/>
<rdf:Description rdf:about="&a;110768724"
	 b:glossaryEntry="a translucent rose-red variety of quartz used for ornaments"/>
<rdf:Description rdf:about="&a;110768841"
	 b:glossaryEntry="a coarse plaster for the surface of external walls"/>
<rdf:Description rdf:about="&a;110768947">
	<b:glossaryEntry>a milky exudate from certain plants that coagulates on exposure to air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110769087">
	<b:glossaryEntry>latex from trees (especially trees of the genera Hevea and Ficus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110769355"
	 b:glossaryEntry="crude natural rubber; used mainly for shoe soles"/>
<rdf:Description rdf:about="&a;110769462"
	 b:glossaryEntry="any of various synthetic materials that resemble rubber"/>
<rdf:Description rdf:about="&a;110769652">
	<b:glossaryEntry>made from silicone elastomers; retains flexibility resilience and tensile strength over a wide temperature range</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110769826">
	<b:glossaryEntry>a rubber made at low temperatures (5C, 41F) which is tougher than conventional rubber and is often used in car tires</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110770000"
	 b:glossaryEntry="resistant to oils and aging; used in waterproof products"/>
<rdf:Description rdf:about="&a;110770130">
	<b:glossaryEntry>a hard nonresilient rubber formed by vulcanizing natural rubber</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110770273"
	 b:glossaryEntry="a type of South American rubber"/>
<rdf:Description rdf:about="&a;110770362"
	 b:glossaryEntry="made by polymerizing butadiene"/>
<rdf:Description rdf:about="&a;110770462"
	 b:glossaryEntry="made by polymerizing isobutylene"/>
<rdf:Description rdf:about="&a;110770565">
	<b:glossaryEntry>a transparent deep red variety of corundum; used as a gemstone and in lasers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110770710">
	<b:glossaryEntry>a mineral consisting of titanium dioxide in crystalline form; occurs in metamorphic and plutonic rocks and is a major source of titanium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110770918"
	 b:glossaryEntry="drops of fresh water that fall as precipitation from clouds"/>
<rdf:Description rdf:about="&a;110771040">
	<b:glossaryEntry>water containing salts; "the water in the ocean is all saltwater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110771331"
	 b:glossaryEntry="the sediment that is left after the evaporation of seawater"/>
<rdf:Description rdf:about="&a;110771465"
	 b:glossaryEntry="water that is not salty"/>
<rdf:Description rdf:about="&a;110771582"
	 b:glossaryEntry="a double salt used in Seidlitz powder; acts as a cathartic"/>
<rdf:Description rdf:about="&a;110771717">
	<b:glossaryEntry>an effervescing salt containing sodium bicarbonate and Rochelle salt and tartaric acid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110771902">
	<b:glossaryEntry>a salt of salicylic acid (including several commonly used drugs)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110772095">
	<b:glossaryEntry>a white crystalline substance with a bitter aftertaste; used as a fungicide or in making aspirin or dyes or perfumes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110772334">
	<b:glossaryEntry>a fatty oil obtained from the wastes in canning salmon; used in making soap and dressing leather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110772487">
	<b:glossaryEntry>a white powder with a pleasant taste and odor; used to absorb light in sun tan lotions or as a preservative or an antiseptic or a coating for pills in which the medicine is intended for enteric release</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110772760">
	<b:glossaryEntry>a compound formed by replacing hydrogen in an acid by a metal (or a radical that acts like a metal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110774026"
	 b:glossaryEntry="a solid solution of two simple salts"/>
<rdf:Description rdf:about="&a;110774174"
	 b:glossaryEntry="a toxic double salt of copper arsenate and copper acetate"/>
<rdf:Description rdf:about="&a;110774325">
	<b:glossaryEntry>a white crystalline insecticide that has low toxicity for mammals; is used in home gardens; extracted from the roots of derris and cube</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110774515"
	 b:glossaryEntry="a complex black mineral occuring in pegmatites"/>
<rdf:Description rdf:about="&a;110774656">
	<b:glossaryEntry>a rare light blue or green mineral; consists of aluminum-magnesium silicate and occurs as small grains in some metamorphic rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110774841">
	<b:glossaryEntry>a salt of bile acid and a base; functions as an emulsifier of lipids and fatty acids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110774981"
	 b:glossaryEntry="(Na2SO4.10H2O) a colorless salt used as a cathartic"/>
<rdf:Description rdf:about="&a;110775111"
	 b:glossaryEntry="a salt used especially in baking powder"/>
<rdf:Description rdf:about="&a;110775251"
	 b:glossaryEntry="a salt or ester of nitric acid"/>
<rdf:Description rdf:about="&a;110775461">
	<b:glossaryEntry>a colorless salt (NaClO3) used as a weed killer and an antiseptic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110775588">
	<b:glossaryEntry>the hypothetical acid (H2Cr2O7) from which dichromates are derived; known only in solution and in the form of dichromate salts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110775775"
	 b:glossaryEntry="a salt of the hypothetical dichromic acid"/>
<rdf:Description rdf:about="&a;110775886"
	 b:glossaryEntry="a red-orange salt used as a mordant"/>
<rdf:Description rdf:about="&a;110776023"
	 b:glossaryEntry="used as an explosive and fertilizer and rocket propellant"/>
<rdf:Description rdf:about="&a;110776181">
	<b:glossaryEntry>a nitrate used in making photographic emulsions; also used in medicine as a cautery and as a topical anti-infective agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110776418">
	<b:glossaryEntry>silver nitrate fused into sticks and formerly used as a caustic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110776541"
	 b:glossaryEntry="any chemical substance that burns or destroys living tissue"/>
<rdf:Description rdf:about="&a;110776690">
	<b:glossaryEntry>a soft sheepskin leather that is colored and finished to resemble morocco; used in bookbinding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110776835">
	<b:glossaryEntry>a strongly alkaline caustic used in manufacturing soap and paper and aluminum and various sodium compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110777019">
	<b:glossaryEntry>a bromide that darkens when exposed to light; used in making photographic emulsions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110777182">
	<b:glossaryEntry>an iodide that is used in photography, in seeding clouds to make rain, and in medicine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110777328"
	 b:glossaryEntry="salt or ester of nitrous acid"/>
<rdf:Description rdf:about="&a;110777429">
	<b:glossaryEntry>used to preserve and color food especially in meat and fish products; implicated in the formation of suspected carcinogens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110777612">
	<b:glossaryEntry>a mixture of potassium nitrate, charcoal, and sulfur in a 75:15:10 ratio which is used in gunnery, time fuses, and fireworks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110777801"
	 b:glossaryEntry="an explosive made of guncotton and used as a propellant"/>
<rdf:Description rdf:about="&a;110777919">
	<b:glossaryEntry>a white salt present in urine and used to test for metal oxides</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110778045"
	 b:glossaryEntry="any salt of hydrochloric acid (containing the chloride ion)"/>
<rdf:Description rdf:about="&a;110778159">
	<b:glossaryEntry>any compound containing three chlorine atoms in each molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110778278"
	 b:glossaryEntry="a compound containing two chlorine atoms per molecule"/>
<rdf:Description rdf:about="&a;110778401"
	 b:glossaryEntry="any compound containing a chlorine atom"/>
<rdf:Description rdf:about="&a;110778603"
	 b:glossaryEntry="a chloride used as a wood preservative or catalyst"/>
<rdf:Description rdf:about="&a;110778738">
	<b:glossaryEntry>a chloride used chiefly in the manufacture of photographic emulsions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110778868">
	<b:glossaryEntry>a colorless caustic liquid made by treating tin with chlorine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110778992"
	 b:glossaryEntry="a white powder that is used to fluoridate toothpaste"/>
<rdf:Description rdf:about="&a;110779108"
	 b:glossaryEntry="a loose material consisting of grains of rock or coral"/>
<rdf:Description rdf:about="&a;110779327"
	 b:glossaryEntry="a variety of gum"/>
<rdf:Description rdf:about="&a;110779417"
	 b:glossaryEntry="a deep blue cordierite often used as a gemstone"/>
<rdf:Description rdf:about="&a;110779543">
	<b:glossaryEntry>a precious transparent stone of rich blue corundum valued as a gemstone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110779705"
	 b:glossaryEntry="a sweetish crystalline amino acid"/>
<rdf:Description rdf:about="&a;110779794"
	 b:glossaryEntry="a deep orange-red variety of chalcedony"/>
<rdf:Description rdf:about="&a;110779904">
	<b:glossaryEntry>oil obtained from sardines and used chiefly as a lubricant and in soap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110780032">
	<b:glossaryEntry>an onyx characterized by parallel layers of sard and a different colored mineral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110780167"
	 b:glossaryEntry="fine particles of wood made by sawing wood"/>
<rdf:Description rdf:about="&a;110780263"
	 b:glossaryEntry="partly refined paraffin wax"/>
<rdf:Description rdf:about="&a;110780363">
	<b:glossaryEntry>a chemical agent that is added to a chemical mixture to counteract the effects of impurities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110780511">
	<b:glossaryEntry>a mineral consisting of calcium tungstate; an ore of tungsten</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110780647"
	 b:glossaryEntry="iron to be remelted and reworked"/>
<rdf:Description rdf:about="&a;110780736"
	 b:glossaryEntry="a pad of paper for keeping notes"/>
<rdf:Description rdf:about="&a;110780840">
	<b:glossaryEntry>pad for preliminary or hasty writing or notes or sketches etc: "scribbling block" is a British term</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110781016">
	<b:glossaryEntry>a pale yellow to red-brown fatty oil obtained from seal blubber; used in making soap and dressing leather and as a lubricant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110781195">
	<b:glossaryEntry>a peptic hormone produced in the small intestine; activates the pancreas and liver</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110781332"
	 b:glossaryEntry="clay soil formed by sedimentary deposits"/>
<rdf:Description rdf:about="&a;110781435"
	 b:glossaryEntry="rich brown pigment prepared from the ink of cuttlefishes"/>
<rdf:Description rdf:about="&a;110781543">
	<b:glossaryEntry>a sweetish crystalline amino acid involved in the synthesis by the body of cysteine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110781679">
	<b:glossaryEntry>a sterile solution of globulins that contains many antibodies normally present in adult human blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110781846">
	<b:glossaryEntry>a family of proteins found in blood and milk and muscle and in plant seed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110782082">
	<b:glossaryEntry>a protein fraction of human blood plasma containing numerous antibodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110782274">
	<b:glossaryEntry>the commonest protein in muscle; a globulin that combines with actin to form actomyosin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110782433">
	<b:glossaryEntry>a protein complex in muscle fibers; composed of myosin and actin; shortens when stimulated and causes muscle contractions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110782649">
	<b:glossaryEntry>any of the factors in the blood whose actions are essential for blood coagulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110782831">
	<b:glossaryEntry>a globulin present in blood plasma; converts to fibrin when blood clots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110782977">
	<b:glossaryEntry>a white insoluble fibrous protein formed by the action of thrombin on fibrinogen when blood clots; it forms a network that traps red cells and platelets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110783182">
	<b:glossaryEntry>tiny bits of protoplasm found in vertebrate blood; essential for blood clotting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110783347">
	<b:glossaryEntry>a conjugated protein composed of heme and globin that gives red blood cells their characteristic color; function primarily to transport oxygen from the lungs to the body tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110783670"
	 b:glossaryEntry="the form of hemoglobin found in muscle fibers"/>
<rdf:Description rdf:about="&a;110783771"
	 b:glossaryEntry="a complex red organic pigment containing iron"/>
<rdf:Description rdf:about="&a;110783893">
	<b:glossaryEntry>a colorless protein obtained by removing heme from hemoglobin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110784026"
	 b:glossaryEntry="a simple protein found in the seeds of cereals"/>
<rdf:Description rdf:about="&a;110784127">
	<b:glossaryEntry>a simple protein containing mainly basic amino acids; present in cell nuclei in association with nucleic acids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110784291"
	 b:glossaryEntry="a simple protein found in plants"/>
<rdf:Description rdf:about="&a;110784379">
	<b:glossaryEntry>a simple protein found in fish sperm; rich in arginine; simpler in composition than globulin or albumin; counteracts the anticoagulant effect of heparin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110784587">
	<b:glossaryEntry>a simple protein found in horny and cartilaginous tissues and in the lens of the eye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110784816">
	<b:glossaryEntry>a granular brown substance composed of ferric oxide; left from the breakdown of hemoglobin; can be a sign of disturbed iron metabolism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110785027">
	<b:glossaryEntry>any of a large variety of immunoglobulins normally present in the body or produced in response to an antigen which it neutralizes, thus producing an immune response</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110785354">
	<b:glossaryEntry>an antibody that causes precipitation when it unites with its antigen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110785480"
	 b:glossaryEntry="blood type antibodies"/>
<rdf:Description rdf:about="&a;110785562"
	 b:glossaryEntry="rhesus factor antibody"/>
<rdf:Description rdf:about="&a;110785642"
	 b:glossaryEntry="an antibody that can neutralize a specific toxin"/>
<rdf:Description rdf:about="&a;110785764">
	<b:glossaryEntry>an antitoxin that counteracts the effects of venom from the bite of a snake or insect or other animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110785921">
	<b:glossaryEntry>a mixture of toxin and antitoxin used to immunize against a disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110786050"
	 b:glossaryEntry="an antibody that causes agglutination of a specific antigen"/>
<rdf:Description rdf:about="&a;110786166">
	<b:glossaryEntry>any substance that acts as an antigen to cause agglutinin production</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110786293">
	<b:glossaryEntry>any of a class of antibodies produced in the laboratory by identical offspring of a hybridoma; very specific for a particular location in the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110786505">
	<b:glossaryEntry>a class of globulins produced in lymph tissue in vertebrates and that function as antibodies in the immune response</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110786704">
	<b:glossaryEntry>any substance that causes injury or illness or death of a living organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110786920"
	 b:glossaryEntry="a substance producing irritation"/>
<rdf:Description rdf:about="&a;110787088">
	<b:glossaryEntry>colorless pungent crystalline compound derived from capsicum; source of the hotness of hot peppers of the genus Capsicum such as chili and cayenne and jalapeno</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110787322"
	 b:glossaryEntry="derived from ginger; source of the hotness of ginger"/>
<rdf:Description rdf:about="&a;110787448">
	<b:glossaryEntry>derived from pepper (especially black pepper); source of the hotness of black and white pepper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110787626">
	<b:glossaryEntry>a family of compounds derived from horseradish and radishes and onions and mustards; source of the hotness of those plants and preparations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110787921">
	<b:glossaryEntry>any of several antigens that occur naturally in the fetus and sometimes in adults with cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110788090">
	<b:glossaryEntry>an abnormally large amount of this fetoprotein in the fetus can signal an abnormality of the neural tube (as spina bifida or anencephaly)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110788297"
	 b:glossaryEntry="a poison produced by microorganisms"/>
<rdf:Description rdf:about="&a;110788438">
	<b:glossaryEntry>potent toxin produced by the bacterium Clostridium botulinum that causes botulism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110788573"
	 b:glossaryEntry="an substance that has a toxic effect on cells"/>
<rdf:Description rdf:about="&a;110788674"
	 b:glossaryEntry="a poison secreted by certain animals"/>
<rdf:Description rdf:about="&a;110788762">
	<b:glossaryEntry>any substance (as a toxin or enzyme) that stimulates the production of antibodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110788969">
	<b:glossaryEntry>a blood group antigen possessed by Rh-positive people; if an Rh-negative person receives a blood transfusion from an Rh-positive person it can result in hemolysis and anemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110789219"
	 b:glossaryEntry="a drug that destroys the itch mite that causes scabies"/>
<rdf:Description rdf:about="&a;110789329"
	 b:glossaryEntry="foul-smelling gas that forms in sewers"/>
<rdf:Description rdf:about="&a;110789423">
	<b:glossaryEntry>a sedimentary rock formed by the deposition of successive layers of clay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110789565"
	 b:glossaryEntry="shale from which oil can be obtained by heating"/>
<rdf:Description rdf:about="&a;110789668"
	 b:glossaryEntry="oil extracted from oil shale by heating"/>
<rdf:Description rdf:about="&a;110789763">
	<b:glossaryEntry>a fatty yellow to brown oil obtained from the livers of sharks; used for dressing leather and as a source of vitamin A</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110789955">
	<b:glossaryEntry>a liquid mixture containing pesticides in which sheep are dipped to kill parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110790111"
	 b:glossaryEntry="a wool obtained from sheep of the Shetland islands"/>
<rdf:Description rdf:about="&a;110790221"
	 b:glossaryEntry="building material used as siding or roofing"/>
<rdf:Description rdf:about="&a;110790326">
	<b:glossaryEntry>a substance used to produce a shiny protective surface on footwear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110790461">
	<b:glossaryEntry>an alloy that is 98% lead and 2% arsenic; used in making small shot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110790585"
	 b:glossaryEntry="iron ore in the form of ferrous carbonate"/>
<rdf:Description rdf:about="&a;110790693"
	 b:glossaryEntry="a jelly-like substance (hydrated silica)"/>
<rdf:Description rdf:about="&a;110790792"
	 b:glossaryEntry="a salt or ester derived from silicic acid"/>
<rdf:Description rdf:about="&a;110790888">
	<b:glossaryEntry>any of various compounds of silicon with a more electropositive element or radical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110791025">
	<b:glossaryEntry>an extremely hard blue-black crystalline compound (SiC) used as an abrasive and a heat refractory material; crystals of silicon carbide can be used as semiconductors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110791252">
	<b:glossaryEntry>any of a large class of siloxanes that are unusually stable over a wide range of temperatures; used in lubricants and adhesives and coatings and synthetic rubber and electrical insulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110791550"
	 b:glossaryEntry="a polymeric silicone compound"/>
<rdf:Description rdf:about="&a;110791640">
	<b:glossaryEntry>any of a large class of compounds that have alternate silicon and oxygen atoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110791791">
	<b:glossaryEntry>material applied to the outside of a building to make it weatherproof</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110791931"
	 b:glossaryEntry="a pure form of finely ground silica"/>
<rdf:Description rdf:about="&a;110792018">
	<b:glossaryEntry>a white or colorless vitreous insoluble solid; various forms occur widely in the earth''s crust as quartz or cristobalite or tridymite or lechartelierite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110792387"
	 b:glossaryEntry="a porous form of silica that is highly absorbent"/>
<rdf:Description rdf:about="&a;110792492"
	 b:glossaryEntry="a bronze with 2-3% silicon that is resistant to corrosion"/>
<rdf:Description rdf:about="&a;110792610"
	 b:glossaryEntry="fibers from silkworm cocoons provide threads for knitting"/>
<rdf:Description rdf:about="&a;110792718"
	 b:glossaryEntry="mud or clay or small rocks deposited by a river or lake"/>
<rdf:Description rdf:about="&a;110792824"
	 b:glossaryEntry="a fine-grained sandstone of consolidated silt"/>
<rdf:Description rdf:about="&a;110792925">
	<b:glossaryEntry>a herbicide that is effective in controlling woody plants but is toxic to animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110793059"
	 b:glossaryEntry="a herbicide used to control weeds (especially among crops)"/>
<rdf:Description rdf:about="&a;110793172"
	 b:glossaryEntry="a plant fiber used for making rope"/>
<rdf:Description rdf:about="&a;110793290"
	 b:glossaryEntry="wax used on the bottom of skis"/>
<rdf:Description rdf:about="&a;110793374"
	 b:glossaryEntry="the scum formed by oxidation at the surface of molten metals"/>
<rdf:Description rdf:about="&a;110793520"
	 b:glossaryEntry="thin layers of rock used for roofing"/>
<rdf:Description rdf:about="&a;110793618">
	<b:glossaryEntry>a gray mineral consisting of cobalt arsenide and nickel; an important source of cobalt and nickel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110793808"
	 b:glossaryEntry="partially melted snow"/>
<rdf:Description rdf:about="&a;110793881">
	<b:glossaryEntry>a pungent preparation of ammonium carbonate and perfume; sniffed as a stimulant to relieve faintness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110794061">
	<b:glossaryEntry>any of various liquids sold as medicine (as by a travelling medicine show) but medically worthless</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110794215">
	<b:glossaryEntry>a layer of snowflakes (white crystals of frozen water) covering the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110794396"
	 b:glossaryEntry="granular snow formed by alternate thawing and freezing"/>
<rdf:Description rdf:about="&a;110794506">
	<b:glossaryEntry>a soft heavy compact variety of talc having a soapy feel; used to make hearths and tabletops and ornaments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110794690">
	<b:glossaryEntry>a mixture of sodium and calcium hydroxides; absorbs liquids and gases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110794815">
	<b:glossaryEntry>a vitreous mineral consisting of sodium aluminum silicate and sodium chloride in crystalline form; occurs in igneous rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110795011">
	<b:glossaryEntry>a sodium salt of carbonic acid; used in making soap powders and glass and paper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110795197">
	<b:glossaryEntry>a gummy substance that is a sodium salt of carboxymethyl cellulose; used as a thickening or emulsifying agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110795383">
	<b:glossaryEntry>a colorless crystalline salt of sodium (NaF) used in fluoridation of water and to prevent tooth decay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110795546"
	 b:glossaryEntry="a flammable gray crystalline compound (NaH)"/>
<rdf:Description rdf:about="&a;110795650">
	<b:glossaryEntry>an unstable salt (NaOCl) used as a bleaching agent and disinfectant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110795837"
	 b:glossaryEntry="a crystalline salt used like potassium iodide"/>
<rdf:Description rdf:about="&a;110795942">
	<b:glossaryEntry>a sodium salt of pyrophosphoric acid used as a builder in soaps and detergents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110796115"
	 b:glossaryEntry="a bitter salt used in detergents"/>
<rdf:Description rdf:about="&a;110796209">
	<b:glossaryEntry>a sodium salt of triphosphoric acid used as a builder in soaps and detergents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110796356"
	 b:glossaryEntry="phosphate of sodium"/>
<rdf:Description rdf:about="&a;110796462">
	<b:glossaryEntry>water that is not hard (does not contain salts that interfere with the formation of lather with soap)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110796620"
	 b:glossaryEntry="a substance that is a solid at room temperature and pressure"/>
<rdf:Description rdf:about="&a;110796840">
	<b:glossaryEntry>solidified carbon dioxide; dry ice sublimates at -78.5 C and is used mainly as a refrigerant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110796986"
	 b:glossaryEntry="a liquid substance capable of dissolving other substances"/>
<rdf:Description rdf:about="&a;110797336">
	<b:glossaryEntry>the dissolved substance in a solution; the component of a solution that changes its state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110797478">
	<b:glossaryEntry>a compound formed by solvation (the combination of solvent molecules with molecules or ions of the solute)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110797638"
	 b:glossaryEntry="an agent that converts something into a solvate"/>
<rdf:Description rdf:about="&a;110797747">
	<b:glossaryEntry>an agent (physical or chemical) that inactivates or destroys viruses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110797881"
	 b:glossaryEntry="hypothetical universal solvent once sought by alchemists"/>
<rdf:Description rdf:about="&a;110798023">
	<b:glossaryEntry>(informal) any composition having a consistency suggestive of soup</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110798140">
	<b:glossaryEntry>a leaven of dough in which fermentation is active; used by pioneers for making bread</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110798280"
	 b:glossaryEntry="a plastic paste to fill cracks and holes in plaster"/>
<rdf:Description rdf:about="&a;110798406">
	<b:glossaryEntry>any of various nonmetallic minerals (calcite or feldspar) that are light in color and transparent or translucent and cleavable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110798619">
	<b:glossaryEntry>pig iron containing manganese; used as a deoxidizing agent and to raise the manganese content in making steel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110798812"
	 b:glossaryEntry='liquid that is spilled; "clean up the spills"'/>
<rdf:Description rdf:about="&a;110798909"
	 b:glossaryEntry="an animal oil found in the blubber of the sperm whale"/>
<rdf:Description rdf:about="&a;110799018">
	<b:glossaryEntry>aromatic substances of vegetable origin used as a preservative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110799132">
	<b:glossaryEntry>a hard glassy mineral consisting of an oxide of magnesium and aluminum; occurs in various colors that are used as gemstones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110799363"
	 b:glossaryEntry="a spinel used as a gemstone (usually dark red)"/>
<rdf:Description rdf:about="&a;110799535"
	 b:glossaryEntry="a purple variety of the ruby spinel"/>
<rdf:Description rdf:about="&a;110799626"
	 b:glossaryEntry="a pale rose-colored variety of the ruby spinel"/>
<rdf:Description rdf:about="&a;110799737"
	 b:glossaryEntry="a dark-colored spinel containing iron"/>
<rdf:Description rdf:about="&a;110799842"
	 b:glossaryEntry="a yellow or orange variety of ruby spinel"/>
<rdf:Description rdf:about="&a;110799939">
	<b:glossaryEntry>a solution of ammonium carbonate in ammonia water and alcohol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110800099">
	<b:glossaryEntry>a pyroxene mineral consisting of lithium aluminum silicate; a source of lithium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110800289">
	<b:glossaryEntry>a green transparent form of the mineral spodumene used as a gemstone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110800431"
	 b:glossaryEntry="a pesticide in suspension or solution; intended for spraying"/>
<rdf:Description rdf:about="&a;110800543">
	<b:glossaryEntry>a tetrasaccharide found in the tubers of the Chinese artichoke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110800661">
	<b:glossaryEntry>a dye or other coloring material that is used in microscopy to make structures visible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110800835">
	<b:glossaryEntry>a dark gray mineral with a metallic luster that is a source of tin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110800970">
	<b:glossaryEntry>a sapphire that when cut shows a star-like figure in reflected light because of its crystalline structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110801135">
	<b:glossaryEntry>a complex carbohydrate found chiefly in seeds, fruits, tubers, roots and stem pith of plants, notably in corn, potatoes, wheat, and rice; an important foodstuff and used otherwise especially in adhesives and as fillers and stiffeners for paper and textiles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110801561">
	<b:glossaryEntry>a nutritive starch obtained from the root of the arrowroot plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110801681">
	<b:glossaryEntry>starch prepared from the grains of corn; used in cooking as a thickener</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110801821">
	<b:glossaryEntry>powdery starch from certain sago palms; used in Asia as a food thickener and textile stiffener</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110801984"
	 b:glossaryEntry="sago ground into small pearl-like grains"/>
<rdf:Description rdf:about="&a;110802081">
	<b:glossaryEntry>(pathology) a waxy translucent complex protein resembling starch that results from degeneration of tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110802240">
	<b:glossaryEntry>a nonnitrogenous food substance consisting chiefly of starch; any substance resembling starch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110802387"
	 b:glossaryEntry="water at boiling temperature diffused in the atmosphere"/>
<rdf:Description rdf:about="&a;110802512"
	 b:glossaryEntry="steam coming from a boiler at full pressure"/>
<rdf:Description rdf:about="&a;110802612">
	<b:glossaryEntry>water in a vaporous form diffused in the atmosphere but below boiling temperature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110802803">
	<b:glossaryEntry>a visible suspension in the air of particles of some substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110802962"
	 b:glossaryEntry="a substance added to another to make it less hard"/>
<rdf:Description rdf:about="&a;110803102">
	<b:glossaryEntry>a substance that lessens the hardness of water giving it more efficient sudsing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110803242">
	<b:glossaryEntry>water in small drops in the atmosphere; blown from waves or thrown up by a waterfall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110803414"
	 b:glossaryEntry="spray from ocean waves"/>
<rdf:Description rdf:about="&a;110803492"
	 b:glossaryEntry="spray blown up from the surface of the sea"/>
<rdf:Description rdf:about="&a;110803603">
	<b:glossaryEntry>a waxy saturated fatty acid; occurs widely as a glyceride in animal and vegetable fats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110803768"
	 b:glossaryEntry="an ester of glycerol and stearic acid"/>
<rdf:Description rdf:about="&a;110803859">
	<b:glossaryEntry>(trademark) a cobalt-base alloy with chromium and other metals; very hard; used to make cutting tools and for surfaces subject to heavy wear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110804054"
	 b:glossaryEntry="a silver alloy with no more than 7.5% copper"/>
<rdf:Description rdf:about="&a;110804179">
	<b:glossaryEntry>a chemical substance that causes sneezing and coughing and crying; "police used a sternutatory to subdue the mob"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110804365">
	<b:glossaryEntry>any of several fat-soluble organic compounds having as a basis 17 carbon atoms in four rings; many have important physiological effects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110804608">
	<b:glossaryEntry>any of a group of natural steroid alcohols derived from plants or animals; they are waxy insoluble substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110804842">
	<b:glossaryEntry>an animal sterol that is normally synthesized by the liver; the most abundant steroid in animal tissue; a high level in the blood is thought to be related to various pathogenic conditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110805087">
	<b:glossaryEntry>a plant sterol that is converted into vitamin D by ultraviolet radiation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110805235">
	<b:glossaryEntry>any of the liver-generated steroid acids and stored with bile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110805370"
	 b:glossaryEntry="an insoluble crystalline acid present in bile"/>
<rdf:Description rdf:about="&a;110805473"
	 b:glossaryEntry="water accumulated in the bilge of a ship"/>
<rdf:Description rdf:about="&a;110805579">
	<b:glossaryEntry>obtained from a number of plants and used to stimulate the heart in cases of heart failure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110805771"
	 b:glossaryEntry="a powerful cardiac stimulant obtained from foxglove"/>
<rdf:Description rdf:about="&a;110805912"
	 b:glossaryEntry="a soft gray mineral; the chief ore of antimony"/>
<rdf:Description rdf:about="&a;110806032"
	 b:glossaryEntry="(informal) a general term for building materials"/>
<rdf:Description rdf:about="&a;110806143"
	 b:glossaryEntry="material used for stiffening something"/>
<rdf:Description rdf:about="&a;110806237">
	<b:glossaryEntry>an enzyme produced by some hemolytic strains of streptococcus that dissolves fibrinous secretions from infections; used medicinally (often in combination with streptokinase)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110806471">
	<b:glossaryEntry>an enzyme produced by some strains of streptococcus that can liquefy blood clots by converting plasminogen to plasmin; used medicinally in some cases of myocardial infarction and pulmonary embolism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110806728">
	<b:glossaryEntry>any of several hemolysins derived from strains of streptococcus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110806850"
	 b:glossaryEntry="a mineral consisting of strontium carbonate"/>
<rdf:Description rdf:about="&a;110806971">
	<b:glossaryEntry>a plaster now made mostly from Portland cement and sand and lime; applied while soft to cover exterior walls or surfaces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110807144"
	 b:glossaryEntry="the product of vaporization of a solid"/>
<rdf:Description rdf:about="&a;110807256">
	<b:glossaryEntry>obtained from suet and used in making soap, candles and lubricants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110807429">
	<b:glossaryEntry>a complex carbohydrate found in many plants and used as a sweetening agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110807606"
	 b:glossaryEntry="unrefined brown sugar made from palm sap"/>
<rdf:Description rdf:about="&a;110807759"
	 b:glossaryEntry="iron that has been cast or worked in structural shapes"/>
<rdf:Description rdf:about="&a;110807875">
	<b:glossaryEntry>a strong steel that is rolled into shapes that are used in construction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110808009"
	 b:glossaryEntry="a crystalline acid made from aniline and used as a dye"/>
<rdf:Description rdf:about="&a;110808144"
	 b:glossaryEntry="a salt or ester of sulphuric acid"/>
<rdf:Description rdf:about="&a;110808332">
	<b:glossaryEntry>a compound of sulphur and some other element that is more electropositive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110808543"
	 b:glossaryEntry="any of several oxides of sulphur"/>
<rdf:Description rdf:about="&a;110808634">
	<b:glossaryEntry>a toxic gas (SO2) that occurs in the gases from volcanoes; used in many manufacturing processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110808808">
	<b:glossaryEntry>a translucent quartz spangled with bits of mica or other minerals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110808977"
	 b:glossaryEntry="wrought iron of high purity made in Sweden"/>
<rdf:Description rdf:about="&a;110809078">
	<b:glossaryEntry>a silver-white mineral consisting of silver gold telluride; a source of gold in Australia and America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110809293">
	<b:glossaryEntry>a mineral consisting of native potassium chloride; an important ore of potassium that is found in sedimentary beds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110809490">
	<b:glossaryEntry>a mineral consisting of hydrated magnesium silicate and used in a variety of products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110809689">
	<b:glossaryEntry>a soft white compact talc used to mark cloth or to remove grease stains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110809819"
	 b:glossaryEntry="a kind of soft talc; sometimes used as wood filler"/>
<rdf:Description rdf:about="&a;110809929">
	<b:glossaryEntry>an animal oil obtained by pressing tallow; used as a lubricant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110810048">
	<b:glossaryEntry>any of various complex phenolic substances of plant origin; used in tanning and in medicine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110810224">
	<b:glossaryEntry>a mineral consisting of tantalum oxide of iron and manganese that occurs with niobite or in coarse granite; an ore of tantalum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110810425">
	<b:glossaryEntry>an acid found in many fruits; used in soft drinks and confectionery and baking powder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110810588">
	<b:glossaryEntry>the optically inactive form of tartaric acid that is often found in grape juice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110810726">
	<b:glossaryEntry>a gas that makes the eyes fill with tears but does not damage them; used in dispersing crowds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110810887">
	<b:glossaryEntry>any binary compound of tellurium with other more electropositive elements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110811035">
	<b:glossaryEntry>a substance (as the plant enzyme papain) applied to meat to make it tender</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110811166"
	 b:glossaryEntry="an unsaturated hydrocarbon obtained from plants"/>
<rdf:Description rdf:about="&a;110811285"
	 b:glossaryEntry="any compound that contains four chlorine atoms per molecule"/>
<rdf:Description rdf:about="&a;110811422">
	<b:glossaryEntry>a flammable gaseous fluorocarbon used in making plastics (polytetrafluoroethylene resins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110811577"
	 b:glossaryEntry="any halide containing four halogen atoms in it molecules"/>
<rdf:Description rdf:about="&a;110811691">
	<b:glossaryEntry>any of a variety of carbohydrates that yield four monosaccharide molecules on complete hydrolysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110811868"
	 b:glossaryEntry="plant stalks used as roofing material"/>
<rdf:Description rdf:about="&a;110811958">
	<b:glossaryEntry>any material used to thicken; "starch is used in cooking as a thickening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110812100"
	 b:glossaryEntry="depresses the function of the thyroid gland"/>
<rdf:Description rdf:about="&a;110812200">
	<b:glossaryEntry>a salt of thiocyanic acid; formed when alkaline cyanides are fused with sulfur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110812336">
	<b:glossaryEntry>an unstable acid that can be obtained by distilling a thiocyanate salt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110812468">
	<b:glossaryEntry>a radioactive mineral consisting of thorium silicate; it is a source of thorium that is found in coarse granite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110812652">
	<b:glossaryEntry>a mineral consisting of scandium yttrium silicate; a source of scandium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110812801">
	<b:glossaryEntry>a colorless crystalline amino acid that occurs in the hydrolysates of certain proteins; an essential component of human nutrition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110812986">
	<b:glossaryEntry>an enzyme liberated from blood platelets that converts prothrombin into thrombin as blood starts to clot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110813167">
	<b:glossaryEntry>a base found in DNA (but not in RNA) and derived from pyrimidine; pairs with adenine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110813324">
	<b:glossaryEntry>a colorless crystalline solid used in perfume or preserving biological specimens or in embalming or medically as a fungicide or antiseptic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110813545">
	<b:glossaryEntry>a hormone secreted by the anterior pituitary gland that controls the degree of pigmentation in melanocytes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110813734">
	<b:glossaryEntry>a pituitary hormone that stimulates the function of the thyroid gland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110813921"
	 b:glossaryEntry="a phenolic amino acid of which thyroxine is a derivative"/>
<rdf:Description rdf:about="&a;110814033"
	 b:glossaryEntry="a thin flat slab of fired clay used for roofing"/>
<rdf:Description rdf:about="&a;110814219">
