</rdf:Description>
<rdf:Description rdf:about="&a;102089558"
	 b:glossaryEntry="goatfishes or red mullets"/>
<rdf:Description rdf:about="&a;102089732">
	<b:glossaryEntry>bottom-dwelling marine warm-water fishes with two barbels on the chin</b:glossaryEntry>
</rdf:Description>
