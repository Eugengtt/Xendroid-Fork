<rdf:Description rdf:about="&a;200790549"
	 b:glossaryEntry="eat human flesh"/>
<rdf:Description rdf:about="&a;200790647">
	<b:glossaryEntry>use again after processing; "We must recycle the cardboard boxes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200790833"
	 b:glossaryEntry="present or use over, with no or few changes"/>
<rdf:Description rdf:about="&a;200790940">
	<b:glossaryEntry xml:space='preserve'><![CDATA[use to one''s advantage; "He exploit the new taxation system"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200791181">
	<b:glossaryEntry xml:space='preserve'><![CDATA[use to one''s advantage; "She palys on her clients'' emotions"]]></b:glossaryEntry>
