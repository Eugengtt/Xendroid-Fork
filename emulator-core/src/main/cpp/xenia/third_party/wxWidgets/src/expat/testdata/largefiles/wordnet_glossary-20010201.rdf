</rdf:Description>
<rdf:Description rdf:about="&a;109169622"
	 b:glossaryEntry="aromatic plant of western United States"/>
<rdf:Description rdf:about="&a;109169785"
	 b:glossaryEntry="aromatic plant of the eastern United States"/>
<rdf:Description rdf:about="&a;109169918">
	<b:glossaryEntry>carnivorous aquatic or bog plants: genera Utricularia; Pinguicula; Genlisea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109170179">
	<b:glossaryEntry>bladderworts: large genus of aquatic carnivorous plants; cosmopolitan in distribution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109170380">
	<b:glossaryEntry>any of numerous aquatic carnivorous plants of the genus Utricularia some of whose leaves are modified as small urn-shaped bladders that trap minute aquatic animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109170620">
