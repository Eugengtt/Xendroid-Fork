<rdf:Description rdf:about="&a;100393569"
	 b:glossaryEntry="the position of protector"/>
<rdf:Description rdf:about="&a;100393654"
	 b:glossaryEntry="the office of a receiver"/>
<rdf:Description rdf:about="&a;100393737"
	 b:glossaryEntry="the office of a regent"/>
<rdf:Description rdf:about="&a;100393813"
	 b:glossaryEntry="the position of ruler"/>
<rdf:Description rdf:about="&a;100393890"
	 b:glossaryEntry="the position of secretary"/>
<rdf:Description rdf:about="&a;100394299">
	<b:glossaryEntry>the position of the head of the Justice Department and the chief law enforcement officer of the United States; "the post of Attorney General was created in 1789"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100394582">
	<b:glossaryEntry>the position of the head of the Department of Agriculture; "the post of Secretary of Agriculture was established in 1889"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100394817">
	<b:glossaryEntry>the position of the head of the Department of Commerce; "the position of Commerce Secretary was created in 1913"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100395037">
	<b:glossaryEntry>the position of the head of the Department of Defense; "the position of Defense Secretary was created in 1947"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100395253">
	<b:glossaryEntry>the position of the head of the Education Department; "the post of Education Secretary was created in 1979"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100395470">
	<b:glossaryEntry>the position of the head of the Department of Energy; "the post of Energy Secretary was created in 1977"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100395678">
	<b:glossaryEntry>the position of the head of the Department of Health and Human Services; "the post of Secretary of Health and Human Services was created by Congress in 1979"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100395939">
	<b:glossaryEntry>the position of the head of the Department of Housing and Urban Development; "the position of Secretary of Housing and Urban Development was created in 1966"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100396204">
	<b:glossaryEntry>the position of the head of the Department of Labor; "the post of Labor Secretary was created in 1913"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100396408">
	<b:glossaryEntry>the position of the head of the State Department; "the position of Secretary of State was established in 1789"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100396602">
	<b:glossaryEntry>the position of the head of the Department of the Interior; "the position of Interior Secretary was created in 1849"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100396830">
	<b:glossaryEntry>the position of the head of the Treasury Department; "the position of Treasury Secretary was created in 1789"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100397051">
	<b:glossaryEntry>the position of the head of the Department of Transportation; "the post of Transportation Secretary was created in 1966</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100397290">
	<b:glossaryEntry>the position of the head of the Department of Veterans Affairs; "the post of Secretary of Veterans Affairs was created in 1989"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100397512">
	<b:glossaryEntry>head of a former executive department; combined with the Navy Secretary to form the Defense Secretary in 1947</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100397700">
	<b:glossaryEntry>head of a former executive department; combined with the War Secretary to form the Defense Secretary in 1947</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100397893">
	<b:glossaryEntry>head of a former executive department created in 1903 and divided into two departments in 1913</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100398065">
	<b:glossaryEntry>head of a former executive department created in 1953 and divided into two departments in 1979</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100398247"
	 b:glossaryEntry="the office of senator"/>
<rdf:Description rdf:about="&a;100398326"
	 b:glossaryEntry="an office that involves minimal duties"/>
