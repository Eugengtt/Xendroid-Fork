</rdf:Description>
<rdf:Description rdf:about="&a;108131636">
	<b:glossaryEntry>Old World annual widely naturalized in warm regions having white flowers and fleshy foliage covered with icelike hairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108131857"
	 b:glossaryEntry="carpetweeds"/>
<rdf:Description rdf:about="&a;108131976">
	<b:glossaryEntry>annual prostrate mat-forming weed having whorled leaves and small greenish-white flowers; widespread throughout North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108132219"
	 b:glossaryEntry="perennial succulents of South Africa"/>
<rdf:Description rdf:about="&a;108132371">
	<b:glossaryEntry>highly succulent stemless clump-forming plants with gray-green leaves similar in texture to lumps of granite; South Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108132609"
	 b:glossaryEntry="New Zealand spinach"/>
<rdf:Description rdf:about="&a;108132742">
	<b:glossaryEntry>coarse sprawling Australasian plant with red or yellow flowers; cultivated for its edible young shoots and succulent leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108132999"
	 b:glossaryEntry="cosmopolitan family of herbs and shrubs"/>
<rdf:Description rdf:about="&a;108133291">
	<b:glossaryEntry>large widely distributed genus of chiefly coarse annual herbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108133485">
	<b:glossaryEntry>any of various plants of the genus Amaranthus having dense plumes of green or red flowers; often cultivated for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108133747">
	<b:glossaryEntry>seed of amaranth plants used as a native cereal in Central and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108133878"
	 b:glossaryEntry="bushy plant of western United States"/>
<rdf:Description rdf:about="&a;108134013">
	<b:glossaryEntry>young leaves widely used as leaf vegetables; seeds used as cereal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108134197">
	<b:glossaryEntry>tall showy tropical American annual having hairy stems and long spikes of usually red flowers above leaves deeply flushed with purple; seeds often used as cereal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108134587">
	<b:glossaryEntry>leaves sometimes used as potherbs; seeds used as cereal; southern United States to Central America; India and China</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108134785">
	<b:glossaryEntry>erect annual of tropical central Asia and Africa having a pair of divergent spines at most leaf nodes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108134989">
	<b:glossaryEntry>genus of low herbs of tropical America and Australia; includes genus Telanthera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108135188">
	<b:glossaryEntry>prolific South American aquatic weed having grasslike leaves and short spikes of white flowers; clogs waterways with dense floating masses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108135454">
	<b:glossaryEntry>annual or perennial herbs or vines of tropical and subtropical America and Asia and Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108135652"
	 b:glossaryEntry="weedy annual with spikes of silver-white flowers"/>
<rdf:Description rdf:about="&a;108135792">
	<b:glossaryEntry>garden annual with featherlike spikes of red or yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108135976">
	<b:glossaryEntry>genus of erect or procumbent herbs of the Americas having spikes of woolly white flowers: cottonweed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108136190">
	<b:glossaryEntry>any of various plants of the genus Froelichia found in sandy soils and on rocky slopes in warmer regions of America; grown for their spikes of woolly white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108136429">
	<b:glossaryEntry>genus of tropical herbs or subshrubs having flowers in close heads; tropical America and Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108136639">
	<b:glossaryEntry>tropical American herb having rose to red or purple flowers that can be dried without losing color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108136857"
	 b:glossaryEntry="genus of tropical American herbs or subshrubs"/>
<rdf:Description rdf:about="&a;108137010"
	 b:glossaryEntry="any plant of the genus Iresine having colored foliage"/>
<rdf:Description rdf:about="&a;108137156">
