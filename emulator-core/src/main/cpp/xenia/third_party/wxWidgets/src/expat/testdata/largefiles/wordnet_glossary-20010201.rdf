	 b:glossaryEntry='happen, as of an event; "Report the news as it develops"'/>
<rdf:Description rdf:about="&a;200235005"
	 b:glossaryEntry='occur; "A slight unpleasantness arose from this discussion"'/>
<rdf:Description rdf:about="&a;200235191">
	<b:glossaryEntry>come to pass; occur: "What is happening?"; "The meeting took place off without an incidence"; "Nothing occurred that seemed important"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200235831">
	<b:glossaryEntry>come about, happen, or occur; "Several important events transpired last week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200235975"
	 b:glossaryEntry='occur; "what gives?" (slang)'/>
<rdf:Description rdf:about="&a;200236065"
	 b:glossaryEntry='ferment; "What is working in the minds of the people?"'/>
<rdf:Description rdf:about="&a;200236191"
	 b:glossaryEntry="take place as an additional or unexpected development"/>
<rdf:Description rdf:about="&a;200236311">
	<b:glossaryEntry>follow a certain course; "The inauguration went well"; "how did your interview go?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200236508">
	<b:glossaryEntry>proceed for an extended period of time; "The speech dragged on for two hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200236668">
	<b:glossaryEntry>come to pass; arrive, as in due course; "The first success came three days later"; "It came as a shock"; "Dawn comes early in June"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200236898"
	 b:glossaryEntry='come as if by falling; "Night fell"'/>
<rdf:Description rdf:about="&a;200237013"
	 b:glossaryEntry='go as if by falling; "Grief fell from our hearts'/>
<rdf:Description rdf:about="&a;200237141">
	<b:glossaryEntry>occur at a specified time or place; "Christmas falls on a Monday this year"; "The accent falls on the first syllable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200237338">
	<b:glossaryEntry>be a forerunner of or occur earlier than, as in: "This composition anticipates Impressionism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200237489">
	<b:glossaryEntry>be found or available; "These shoes come in three colors; The furniture comes unassembled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200237657">
	<b:glossaryEntry>be gradually disclosed or unfolded; become manifest; "The plot developed slowly"; "It develops thay neither one knows the answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200237851">
	<b:glossaryEntry>come to light; become known; "It transpired that she had worked as spy in East Germany"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200238005"
	 b:glossaryEntry='happen or occur again; "This is a recurring story"'/>
<rdf:Description rdf:about="&a;200238145"
