</rdf:Description>
<rdf:Description rdf:about="&a;302878686">
	<b:glossaryEntry>shaped or worked with a hammer and often showing hammer marks: "a bowl of hammered brass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302878830">
	<b:glossaryEntry>small and light enough to be operated while you hold it in your hands; "a hand-held computer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302879008">
	<b:glossaryEntry>occupied or in the control of; often used in combination: "enemy-held territory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302879139">
	<b:glossaryEntry>drawn toward the source of the force; "this exercise must be done with the arms pulled back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302879284">
	<b:glossaryEntry>(of vehicles) pulled forward (often used in combination: "horse-drawn vehicles")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302879416">
	<b:glossaryEntry>that is caused by; "if...such a change is produced by...insulin comas or electroshocks"; "the emotional states produced by this drug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302879604"
	 b:glossaryEntry='who is rebuking severely; "the scolding father"'/>
<rdf:Description rdf:about="&a;302879706">
	<b:glossaryEntry>exuding a bodily fluid in profuse amounts: "his streaming face"; "her streaming eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302879847"
	 b:glossaryEntry='having something on top: "columns surmounted by statues"'/>
<rdf:Description rdf:about="&a;302879960"
	 b:glossaryEntry='that in a dock; "a docked ship"'/>
<rdf:Description rdf:about="&a;302880044"
	 b:glossaryEntry='reduced to small pieces; "crunched nuts"'/>
<rdf:Description rdf:about="&a;302880139"
	 b:glossaryEntry='expressed by; "the idea embodied in the text"'/>
<rdf:Description rdf:about="&a;302880239">
	<b:glossaryEntry>gradually unfolding or growing (especially as of something latent); "his developing social conscience"; "after the long winter they took joy in the developing warmth of spring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302880472">
	<b:glossaryEntry>making or becoming visible through or as if through the action of a chemical agent: "he watched as the developing photograph became clearer and sharper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302880681"
	 b:glossaryEntry='that are estimated; "the extrapolated values"'/>
<rdf:Description rdf:about="&a;302880785"
	 b:glossaryEntry='that are running rapidly; "surrounded by galloping horses"'/>
<rdf:Description rdf:about="&a;302880899">
	<b:glossaryEntry>turning green; leafing out: "overgrown with greening trees and underbrush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302881028">
	<b:glossaryEntry>stopping and stealing or stealing from a vehicle in transit: "hijacking gangs after truckloads of cigarettes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302881193">
	<b:glossaryEntry>having the pituitary gland removed by surgery: "hypophysectomized tadpoles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302881352">
	<b:glossaryEntry>(of persons) seized and detained unlawfully, often for ransom: "the father restored the kidnapped (or abducted) child to the mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302881580">
	<b:glossaryEntry>dwelling or inhabiting; often used in combination: "living quarters"; "tree-living animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302881724"
	 b:glossaryEntry="being or having been trodden or marched on"/>
<rdf:Description rdf:about="&a;302881825"
	 b:glossaryEntry="having a wound formed over it"/>
<rdf:Description rdf:about="&a;302881913">
	<b:glossaryEntry>requiring that official notification be given: "a notifiable disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882039">
	<b:glossaryEntry>involved in a kind of operation; "the operating conditions of the oxidation pond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882176">
	<b:glossaryEntry>combined with or having undergone a chemical reaction with oxygen: "the oxidized form of iodine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882338">
	<b:glossaryEntry>that have been left; "there were four parked cars across the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882459">
	<b:glossaryEntry>having been subjected to pasteurization in order to halt fermentation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882586"
	 b:glossaryEntry="not having undergone pasteurization"/>
<rdf:Description rdf:about="&a;302882681">
	<b:glossaryEntry>drawn or written with a pencil; "a penciled sketch"; "the penciled message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882841">
	<b:glossaryEntry>causing to disperse into a colloidal state; "acting...as peptizing agents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302882971">
	<b:glossaryEntry>(of sound) set to a certain pitch or key; usually used as a combining form: "high-pitched"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302883115"
	 b:glossaryEntry='(of games) engaged in; "the loosely played game"'/>
<rdf:Description rdf:about="&a;302883216"
	 b:glossaryEntry="that points"/>
<rdf:Description rdf:about="&a;302883282">
	<b:glossaryEntry>(of an idea or opinion) formed beforehand; especially without evidence or through prejudice: "certain preconceived notions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302883464"
	 b:glossaryEntry='resulting in punishment; "the king imposed a punishing tax"'/>
<rdf:Description rdf:about="&a;302883579">
	<b:glossaryEntry>followed with enmity as if to harm: "running and leaping like a herd of pursued antelopes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302883723">
	<b:glossaryEntry>wandering freely: "at night in bed...his slowly ranging thoughts...encountered her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302883860"
	 b:glossaryEntry='created anew: "this re-created literalness"'/>
<rdf:Description rdf:about="&a;302883960"
	 b:glossaryEntry='that are generating anew; "regenerating fibers"'/>
<rdf:Description rdf:about="&a;302884067"
	 b:glossaryEntry='that is recalled; "the remembered sensations"'/>
<rdf:Description rdf:about="&a;302884169"
	 b:glossaryEntry="that is sublimed again"/>
<rdf:Description rdf:about="&a;302884248">
	<b:glossaryEntry>having a ridge or shaped like a ridge or the keel of a ship: "a carinate sepal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302884412"
	 b:glossaryEntry="made sanitary"/>
<rdf:Description rdf:about="&a;302884481">
	<b:glossaryEntry>trying to obtain: "profit-seeking producers"; "people seeking happiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302884607"
	 b:glossaryEntry="uttered in a shrill scream as of pain or terror"/>
<rdf:Description rdf:about="&a;302884709"
	 b:glossaryEntry="formed into a mass by heat and pressure"/>
<rdf:Description rdf:about="&a;302884803"
	 b:glossaryEntry='pouring from or as if from a sluice: "the sluicing rain"'/>
<rdf:Description rdf:about="&a;302884914">
	<b:glossaryEntry>dried by bringing a sprayed substance (e.g. milk or soap) into contact with hot air and recovering it in the form of a powder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302885097">
	<b:glossaryEntry>that has been violently compressed; "the squashed looking nakedness of the fledgling birds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302885243"
	 b:glossaryEntry="arranged in a stack"/>
<rdf:Description rdf:about="&a;302885316"
	 b:glossaryEntry='that is on a string; "keys strung on a red cord"'/>
<rdf:Description rdf:about="&a;302885417">
	<b:glossaryEntry>passing or having passed from the solid to the gaseous state (or vice versa) without becoming liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302885603"
	 b:glossaryEntry="being or sounding of nervous or suppressed laughter"/>
<rdf:Description rdf:about="&a;302885740"
	 b:glossaryEntry='that is passing through; "transpiring gas"'/>
<rdf:Description rdf:about="&a;302885840">
	<b:glossaryEntry>quickly going away and passing out of sight: "all I saw was his vanishing back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302886008"
	 b:glossaryEntry='that is at worship; "a worshiping group"'/>
<rdf:Description rdf:about="&a;302886137"
	 b:glossaryEntry='that is making a soft cry; "the cooing pigeons"'/>
<rdf:Description rdf:about="&a;302886237">
	<b:glossaryEntry>engaged in making a rapid repetitive noise resembling speech; "the chattering sparrows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302886381"
	 b:glossaryEntry='occurring throughout; "her poems are permeated with sorrow"'/>
<rdf:Description rdf:about="&a;302886496"
	 b:glossaryEntry='that is looked for; "the long sought relatives"'/>
<rdf:Description rdf:about="&a;302886596">
	<b:glossaryEntry>that is dropped in a heap; "his hastily dumped clothes"; "the money was there, dumped all over the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302886754">
	<b:glossaryEntry>(television) broadcast with captions that are seen only on receivers having special equipment; can be provided for hard-of-hearing viewers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302886955"
	 b:glossaryEntry='converted into soap; saponified oils"'/>
<rdf:Description rdf:about="&a;302887067"
	 b:glossaryEntry='not converted into soap; "unsaponified fat"'/>
<rdf:Description rdf:about="&a;400001740">
	<b:glossaryEntry>on horseback; "managed to escape ahorse"; "policeman patrolled the streets ahorseback"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400001874">
	<b:glossaryEntry>by a small margin; "they could barely hear the speaker"; "we hardly knew them"; "just missed being hit"; "had scarcely rung the bell when the door flew open"; "would have scarce arrived before she would have found some excuse to leave"- W.B.Yeats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400002191">
	<b:glossaryEntry>almost not; "he hardly ever goes fishing"; "he was hardly more than sixteen years old"; "they scarcely ever used the emergency generator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400002374"
	 b:glossaryEntry="in an annoying manner or to an annoying degree"/>
<rdf:Description rdf:about="&a;400002477">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at bottom or by one''s (or its) very nature; "He is basically dishonest"; "the argument was essentially a technical one"; "for all his bluster he is in essence a shy person"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400002794"
	 b:glossaryEntry="in a blessed manner"/>
<rdf:Description rdf:about="&a;400002869"
	 b:glossaryEntry='(informal) extremely; "boiling mad"'/>
<rdf:Description rdf:about="&a;400002940"
	 b:glossaryEntry='in an enviable manner; "she was enviably fluent in French"'/>
<rdf:Description rdf:about="&a;400003053">
	<b:glossaryEntry>in such a manner as to make something clearly evident; "he pointedly ignored the question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400003199"
	 b:glossaryEntry='in a negative way; "he was negatively inclined"'/>
<rdf:Description rdf:about="&a;400003303"
	 b:glossaryEntry='in a harmful manner; "he was negatively affected"'/>
<rdf:Description rdf:about="&a;400003409">
	<b:glossaryEntry>in a kind manner or out of kindness; "He spoke kindly to the boy"; "she kindly overlooked the mistake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400003582">
	<b:glossaryEntry>in an unkind manner or with unkindness; "The teacher treats the children unkindly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400003737">
	<b:glossaryEntry>and nothing more; "I was merely asking"; "it is simply a matter of time"; "just a scratch"; "he was only a child"; "hopes that last but a moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400003982"
	 b:glossaryEntry='absolutely; altogether; really; "we are simply broke"'/>
<rdf:Description rdf:about="&a;400004070">
	<b:glossaryEntry>in a simple manner; without extravagance or embellishment; "she was dressed plainly"; "they lived very simply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400004261">
	<b:glossaryEntry>in ancient times; long ago; "a concern with what may have happened anciently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400004394"
	 b:glossaryEntry='as can be shown by argument; "she is arguably the best"'/>
<rdf:Description rdf:about="&a;400004504"
	 b:glossaryEntry='in an unabashed manner; "unabashedly, he asked for more"'/>
<rdf:Description rdf:about="&a;400004618"
	 b:glossaryEntry='in a reflex manner; "he answered automatically"'/>
<rdf:Description rdf:about="&a;400004725"
	 b:glossaryEntry='in an alarming manner; "It grew alarmingly fast"'/>
<rdf:Description rdf:about="&a;400004830">
	<b:glossaryEntry>to an exceedingly great extent or degree; "He had vastly overestimated his resources"; "was immensely more important to the project as a scientist than as an administrator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400005085"
	 b:glossaryEntry="in a gross manner"/>
<rdf:Description rdf:about="&a;400005156">
	<b:glossaryEntry>in large part; mainly or chiefly; "These accounts are largely inactive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400005310">
	<b:glossaryEntry>in a significant manner; "our budget will be significantly affected by these new cuts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400005474">
	<b:glossaryEntry>not to a significant degree or amount; "Our budget will only be insignificantly affected by these new cuts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400005661">
	<b:glossaryEntry>to a noticeable degree; "they weather was appreciably colder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400005780">
	<b:glossaryEntry>by ultrasonic means; "the kidney stones were removed ulrasonically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400005908"
	 b:glossaryEntry='in a stylish manner; "He was smartly dressed"'/>
<rdf:Description rdf:about="&a;400006065">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of quantities) imprecise but fairly close to correct; "lasted approximately an hour"; "in just about a minute"; "he''s about 30 years old"; "I''ve had about all I can stand"; "we meet about once a month"; "some forty people came"; "weighs around a hundred pounds"; "roughly $3,000"; "holds 3 gallons, more or less"; "20 or so people were at the party"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400006538">
	<b:glossaryEntry>totally and definitely; without question; "we are absolutely opposed to the idea"; "he forced himself to lie absolutely still"; "iron is absolutely necessary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400006753">
	<b:glossaryEntry>in part; in some degree; not wholly; "I felt partly to blame"; "He was partially paralyzed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400006952">
	<b:glossaryEntry>partially or to the extent of a half; "he was half hidden by the bushes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400007075">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to a complete degree or to the full or entire extent; "he was wholly convinced"; "entirely satisfied with the meal"; "it was completely different from what we expected"; "was completely at fault"; "a totally new situation"; "the directions were all wrong"; "It was not altogether her fault"; "an altogether new approach"; (`whole'' is often used informally for `wholly'' as in "a whole new idea")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400007655">
	<b:glossaryEntry>without any others being included or involved; "was entirely to blame"; "a school devoted entirely to the needs of problem children"; "he works for Mr. Smith exclusively"; "did it solely for money"; "the burden of proof rests on the prosecution alone"; "a privilege granted only to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400008052">
	<b:glossaryEntry xml:space='preserve'><![CDATA[completely and without qualification; used informally as intensifiers; "an absolutely magnificent painting"; "a perfectly idiotic idea"; "you''re perfectly right"; "utterly miserable"; "you can be dead sure of my innocence"; "was dead tired"; "dead right"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400008428">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(slang) completely; used as intensifiers; "clean forgot the appointment"; "I''m plumb (or plum) tuckered out"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400008585"
	 b:glossaryEntry='(informal) exactly; "fell plumb in the middle of the puddle"'/>
<rdf:Description rdf:about="&a;400008686">
	<b:glossaryEntry>in a perfect or faultless way; "She performed perfectly on the balance beam"; "spoke English perfectly"; "solved the problem perfectly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400008895">
	<b:glossaryEntry>completely or perfectly; "he has the lesson pat"; "had the system down pat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400009002">
	<b:glossaryEntry>in an imperfect or faulty way; "The lobe was imperfectly developed"; "Miss Bennet would not play at all amiss if she practiced more"- Jane Austen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400009231">
	<b:glossaryEntry>in an improper or mistaken or unfortunate manner; "if you think him guilty you judge amiss"; "he spoke amiss"; "no one took it amiss when she spoke frankly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400009421"
	 b:glossaryEntry='wholly or completely; "He is flat broke"'/>
<rdf:Description rdf:about="&a;400009494">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to the the greatest degree or extent; completely or entirely; "fully grown"; "he didn''t fully understand"; "knew full well"; (`full'' is used as a combining form as in `full-grown'' or `full-fledged'')]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400009765">
	<b:glossaryEntry>with nevertheless the final result; "He arrived only to find his wife dead"; "We won only to lose again in the next round"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400009920">
	<b:glossaryEntry>in the final outcome; "These news will only make you more upset"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400010017"
	 b:glossaryEntry='as recently as; "I spoke to him only an hour ago"'/>
<rdf:Description rdf:about="&a;400010099">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often used as a combining form) in a good or proper or satisfactory manner or to a high standard; "the children behaved well"; "a task well done"; "the party went well"; "he slept well"; "a well-argued thesis"; "a well-planned party"; (`good'' is a nonstandard dialectal variant for `well'' as in "the baby can walk pretty good")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400010485">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(`ill'' is often used as a combining form) in a poor or improper or unsatisfactory manner; not well; "he was ill prepared"; "it ill befits a man to betray old friends"; "the car runs badly"; "he performed badly on the exam"; "the team played poorly"; "ill-fitting clothes"; "an ill-conceived plan"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400010866">
	<b:glossaryEntry>with difficulty or inconvenience; scarcely or hardly; "we can ill afford to buy a new car just now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400010997">
	<b:glossaryEntry>without unusual distress or resentment; with good humor; "took the joke well"; "took the tragic news well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400011154">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with unusual distress or resentment or regret or emotional display; "they took their defeat badly"; "took her father''s death badly"; "conducted himself very badly at the time of the earthquake"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400011399">
	<b:glossaryEntry>indicating high probability; in all likelihood; "I might well do it"; "a mistake that could easily have ended in disaster"; "you may well need your umbrella"; "he could equally well be trying to deceive us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400011647">
	<b:glossaryEntry>thoroughly or completely; fully; often used as a combining form; "The problem is well understood"; "she was well informed"; "shake well before using"; "in order to avoid food poisoning be sure the meat is well cooked"; "well-done beef", "well-satisfied customers"; "well-educated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400011960">
	<b:glossaryEntry>favorably; with approval; "their neighbors spoke well of them"; "he thought well of the book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400012104">
	<b:glossaryEntry>unfavorably or with disapproval; "tried not to speak ill of the dead"; "thought badly of him for his lack of concern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400012297">
	<b:glossaryEntry>to a suitable or appropriate extent or degree; "the project was well underway"; "the fetus has well developed organs"; "his father was well pleased with his grades"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400012494">
	<b:glossaryEntry>in financial comfort; "They live well"; "she has been able to live comfortably since her husband died"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400012661">
	<b:glossaryEntry>in a manner affording benefit or advantage; "she married well"; "The children were settled advantageously in Seattle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400012882">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a disadvantageous way; to someone''s disadvantage; "the venture turned out badly for the investors"; "angry that the case was settled disadvantageously for them"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400013153">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to a great extent or degree; "I''m afraid the film was well over budget"; "painting the room white made it seem considerably (or substantially) larger"; "the house has fallen considerably in value"; "the price went up substantially"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400013484">
	<b:glossaryEntry>with skill or in a pleasing manner; "she dances well"; "he writes well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400013606">
	<b:glossaryEntry>without skill or in a displeasing manner; "she writes badly"; "I think he paints very badly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400013750">
	<b:glossaryEntry>with prudence or propriety; "You would do well to say nothing more"; "could not well refuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400013875">
	<b:glossaryEntry>with great or especially intimate knowledge; "we knew them well</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400014002">
	<b:glossaryEntry>(used for emphasis or as an intensifier) "a book well worth reading"; "was well aware of the difficulties ahead"; "suspected only too well what might be going on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400014198"
	 b:glossaryEntry="in a satisfactory manner"/>
<rdf:Description rdf:about="&a;400014301">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) in a satisfactory or adequate manner; "she''ll do okay on her own"; "held up all right under pressure"; (`alright'' is a nonstandard variant of `all right'')]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400014528">
	<b:glossaryEntry>in an unsatisfactory manner; "He performed unsatisfactorily as a manager"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400014682"
	 b:glossaryEntry="in the manner of prosperous people"/>
<rdf:Description rdf:about="&a;400014775">
	<b:glossaryEntry>to a severe or serious degree; "fingers so badly frozen they had to be amputated"; "badly injured"; "a severely impaired heart"; "is gravely ill"; "was seriously ill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400015062">
	<b:glossaryEntry>very much; strongly; "I wanted it badly enough to work hard for it"; "the cables had sagged badly"; "they were badly in need of help"; "he wants a bicycle so bad he can taste it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400015280">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with great intensity; "the injury hurt badly"; "the buildings were badly shaken"; (`bad'' is a nonstandard variant for `badly'' as in "it hurts bad" or "we need water bad")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400015508">
	<b:glossaryEntry>in a disobedient or naughty way; "he behaved badly in school"; "he mischievously looked for a chance to embarrass his sister"; "behaved naughtily when they had guests and was sent to his room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400015798">
	<b:glossaryEntry>evilly or wickedly; "treated his parents badly"; "to steal is to act badly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400015925">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `ill'') in a less effective or successful or desirable manner; "he did worse on the second exam"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400016070">
	<b:glossaryEntry>to the highest degree of inferiority or badness; "She suffered worst of all"; "schools were the worst hit by government spending cuts"; "the worst dressed person present"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400016274">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used as an intensive especially to indicate something unexpected; "even an idiot knows that"; "declined even to consider the idea"; "I don''t have even a dollar!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400016468">
	<b:glossaryEntry>to a greater degree or extent; used with comparisons; "looked sick and felt even worse"; "an even (or still) more interesting problem"; "still another problem must be solved"; "a yet sadder tale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400016710">
	<b:glossaryEntry>at the same time as; "even as he lay dying they argued over his estate"; "the building collapsed just as he arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400016872">
	<b:glossaryEntry>in spite of; notwithstanding; "even when he is sick, he works"; "even with his head start she caught up with him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400017018"
	 b:glossaryEntry='to the full extent; "loyal even unto death"'/>
<rdf:Description rdf:about="&a;400017094"
	 b:glossaryEntry="even"/>
<rdf:Description rdf:about="&a;400017131">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to some (great or small) extent; "it was rather cold"; "the party was rather nice"; "the knife is rather dull"; "I rather regret that I cannot attend"; "He''s rather good at playing the cello"; "he is kind of shy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400017406">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intensifier, as in "pretty big"; "pretty bad"; (`jolly'' is used informally in Britain as in "jolly decent of him")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400017563">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to the greatest extent; completely; "you''re quite right"; "she was quite alone"; "was quite mistaken"; "quite the opposite"; "not quite finished"; "did not quite make it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400017767">
	<b:glossaryEntry>to a degree (not used with a negative); "quite tasty"; "quite soon"; "quite ill"; "quite rich"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400017904">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of an unusually noticeable or exceptional or remarkable kind (not used with a negative); "her victory was quite something"; "she''s quite a girl"; "quite a film"; "quite a walk"; "we''ve had quite an afternoon"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400018167">
	<b:glossaryEntry xml:space='preserve'><![CDATA[actually or truly or to an extreme; "was quite a sudden change"; "it''s quite the thing to do"; "quite the rage"; "Quite so!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400018325">
	<b:glossaryEntry>at all times; all the time and on every occasion; "I will always be there to help you"; "always arrives on time"; "there is always some pollution in the air"; "ever hoping to strike it rich"; "ever busy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400018595">
	<b:glossaryEntry>forever; throughout all time; "we will always be friends"; "I shall treasure it always"; "I will always love you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400018743">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at any time or in any event; "you can always resign if you don''t like it"; "you could always take a day off"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400018886">
	<b:glossaryEntry>seemingly without interruption; often and repeatedly; "always looking for faults"; "it is always raining"; "he is forever cracking jokes"; "they are forever arguing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400019096"
	 b:glossaryEntry='without interruption; "the world is constantly changing"'/>
<rdf:Description rdf:about="&a;400019209">
	<b:glossaryEntry>seemingly uninterrupted; "constantly bullied by his big brother"; "was perpetually answering the doorbell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400019404"
	 b:glossaryEntry='without variation or change; "constantly kind and gracious"'/>
<rdf:Description rdf:about="&a;400019520">
	<b:glossaryEntry>not ever; at no time in the past or future; "I have never been to China"; "I shall never forget this day"; "had never seen a circus"; "never on Sunday"; "I will never marry you!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400019758">
	<b:glossaryEntry>not at all; certainly not; not in any circumstances; "never fear"; "bringing up children is never easy"; "that will never do"; "what is morally wrong can never be politically right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400019973"
	 b:glossaryEntry='n is between 2 and infinity; "They split the loot four ways"'/>
<rdf:Description rdf:about="&a;400020075">
	<b:glossaryEntry>now and then or here and there; "he was arrogant and occasionally callous"; "open areas are only occasionally interrupted by clumps of trees"; "they visit New York on occasion"; "now and again she would take her favorite book from the shelf and read to us"; "as we drove along, the beautiful scenery now and then attracted his attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400020565">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at some indefinite or unstated time; "let''s get together sometime"; "everything has to end sometime"; "It was to be printed sometime later"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400020741">
	<b:glossaryEntry>on certain occasions or in certain cases but not always; "sometimes she wished she were back in England"; "sometimes her photography is breathtaking"; "sometimes they come for a month; at other times for six months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400020994">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `as'') to the same degree; "they were equally beautiful"; "birds were singing and the child sang as sweetly"; "sang as sweetly as a nightingale"; (`every bit'' is informal as in "he is every bit as mean as she is")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400021296">
	<b:glossaryEntry>of the distant or comparatively distant past; "We met once long ago"; "they long ago forsook their nomadic life"; "left for work long ago"; "he has long since given up mountain climbing"; "This name has long since been forgotten"; "lang syne" is Scottish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400021612">
	<b:glossaryEntry>to some degree; "we were pretty much lost when we met the forest ranger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400021724">
	<b:glossaryEntry>(degree adverb used before a noun phrase) for all practical purposes but not completely; "much the same thing happened every time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400021901"
	 b:glossaryEntry='to a certain degree; "we will be that much ahead of them"'/>
<rdf:Description rdf:about="&a;400021996"
	 b:glossaryEntry='in a palmate manner; "palmately cleft"'/>
<rdf:Description rdf:about="&a;400022090">
	<b:glossaryEntry>in a paradoxical manner; "paradoxically, ice ages seem to occur when the sun gets hotter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400022239"
	 b:glossaryEntry="in a parasitic manner"/>
<rdf:Description rdf:about="&a;400022320">
	<b:glossaryEntry>in a conventional manner; "he usually behaves rather conventionally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400022467">
	<b:glossaryEntry>in an unconventional manner; "she always behaves rather unconventionally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400022621"
	 b:glossaryEntry="in a pathogenic manner"/>
<rdf:Description rdf:about="&a;400022704"
	 b:glossaryEntry='in a pictorial manner; "depth is established pictorially"'/>
<rdf:Description rdf:about="&a;400022819">
	<b:glossaryEntry>negation of a word or group of words; "he does not speak French"; "she is not going"; "they are not friends"; "not many"; "not much"; "not at all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400022997">
	<b:glossaryEntry xml:space='preserve'><![CDATA[contraction of `not''; combining form; "isn''t"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400023074">
	<b:glossaryEntry>used to express refusal or denial or disagreement etc or especially to emphasize a negative statement; "no, you are wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400023227">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to any degree or extent; "it isn''t any better"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400023305">
	<b:glossaryEntry>not in any degree or manner; not at all; "he is no better today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400023400">
	<b:glossaryEntry>not at all or in no way; "seemed none too pleased with his dinner"; "shirt looked none the worse for having been slept in"; "none too prosperous"; "the passage is none too clear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400023611">
	<b:glossaryEntry>after a negative statement used to indicate that the next statement is similarly negative; "I was not happy and neither were they"; "just as you would not complain, neither should he"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400023830">
	<b:glossaryEntry xml:space='preserve'><![CDATA[after a negative statement used as an intensive meaning something like `likewise'' or `also''; "he isn''t stupid, but he isn''t exactly a genius either"; "I don''t know either"; "if you don''t order dessert I won''t either"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400024081">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used to introduce the first phrase of a correlative construction and usually followed by `but'') "not only was he poor, but..."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400024245">
	<b:glossaryEntry>(intensifier) "you are bloody right"; "Why are you so all-fired aggressive?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400024375">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at or in or to any place; "you can find this food anywhere"; (`anyplace'' is used informally for `anywhere'')]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400024530"
	 b:glossaryEntry='not anywhere; in or at or to no place; "I am going nowhere"'/>
<rdf:Description rdf:about="&a;400024625">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in or at or to some place; "she must be somewhere"; (`someplace'' is used informally for `somewhere'')]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400024775">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to or in any or all places; "You find fast food stores everywhere"; "people everywhere are becoming aware of the problem"; "he carried a gun everywhere he went"; "looked all over for a suitable gift"; (`everyplace'' is used informally for `everywhere'')]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400025089"
	 b:glossaryEntry='everywhere; "searched high and low"'/>
<rdf:Description rdf:about="&a;400025165">
	<b:glossaryEntry>in some unspecified way or manner; or by some unspecified means; "they managed somehow"; "he expected somehow to discover a woman who would love him"; "he tried to make is someway acceptable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400025444">
	<b:glossaryEntry xml:space='preserve'><![CDATA[for some unspecified reason; "It doesn''t seem fair somehow"; "he had me dead to rights but somehow I got away with it"; "for some reason they didn''t seem to match"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400025661">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used to indicate that a statement explains or supports a previous statement; "Anyhow, he is dead now"; "I think they''re asleep; anyhow, they''re quiet"; "I don''t know what happened to it; anyway, it''s gone"; "anyway, there is another factor to consider"; "I don''t know how it started; in any case, there was a brief scuffle"; "in any event, the government faced a serious protest"; "but at any rate he got a knighthood for it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400026173">
	<b:glossaryEntry>in the actual state of affairs and often contrary to expectations; "he might have been killed; as it is he was severely injured"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400026338">
	<b:glossaryEntry>in any way whatsoever; "they came anyhow they could"; "get it done anyway you can"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400026464">
	<b:glossaryEntry xml:space='preserve'><![CDATA[despite anything to the contrary (usually following a concession); "although I''m a little afraid, however I''d like to try it"; "while we disliked each other, nevertheless we agreed"; "he was a stern yet fair master"; "granted that it is dangerous, all the same I still want to go"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400026875">
	<b:glossaryEntry>up to the present time; "I have yet to see the results"; "details are yet to be worked out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400026998">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used in negative statement to describe a situation that has existed up to this point or up to the present time; "So far he hasn''t called"; "the sun isn''t up yet"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400027278">
	<b:glossaryEntry>used after a superlative; "this is the best so far"; "the largest drug bust yet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400027399">
	<b:glossaryEntry>except that; "It was the same story; only this time she came out better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400027504">
	<b:glossaryEntry>in whatever way or manner; "Victory, however it was brought about, was sweet"; "however he did it, it was very clever"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400027658">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to whatever degree or extent; "The results, however general, are important"; "they have begun, however reluctantly, to acknowledge the legitimacy of some of the opposition''s concerns"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400027877">
	<b:glossaryEntry>by contrast; on the other hand; "the first part was easy; the second, however, took hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400028003"
	 b:glossaryEntry='with indifference or without dejection; "he took it lightly"'/>
<rdf:Description rdf:about="&a;400028117">
	<b:glossaryEntry xml:space='preserve'><![CDATA[making an additional point; anyway; "I don''t want to go to a restaurant; besides, we can''t afford it"; "she couldn''t shelter behind him all the time and in any case he wasn''t always with her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400028358"
	 b:glossaryEntry="(music) in a fugal style"/>
<rdf:Description rdf:about="&a;400028436">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in addition; "computer chess games are getting cheaper all the time; furthermore, their quality is improving"; "the cellar was dark; moreover, mice nested there"; "what is more, there''s no sign of a change"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400028708">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to or at a greater distance in time or space (`farther'' is used more frequently than `further'' in this physical sense); "farther north"; "moved farther away"; "farther down the corridor"; "the practice may go back still farther to the Druids"; "went only three miles further"; "further in the future"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400029054">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to or at a greater extent or degree or a more advanced stage (`further'' is used more often than `farther'' in this abstract sense); "further complicated by uncertainty about the future"; "let''s not discuss it further"; "nothing could be further from the truth"; "they are further along in their research than we expected"; "the application of the law was extended farther"; "he is going no farther in his studies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400029512">
	<b:glossaryEntry>in addition or furthermore; "if we further suppose"; "stated further that he would not cooperate with them"; "they are definitely coming; further, they should be here already"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400029723">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to the greatest distance in space or time (`farthest'' is used more often than `furthest'' in this physical sense); "see who could jump the farthest"; "chose the farthese seat from the door"; "he swam the furthest"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400029983">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to the greatest degree or extent or most advanced stage (`furthest'' is used more often than `farthest'' in this abstract sense); "went the furthest of all the children in her education"; "furthest removed from reality"; "she goes farthest in helping us"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400030283"
	 b:glossaryEntry="in a futile and unproductive manner"/>
<rdf:Description rdf:about="&a;400030373">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with reference to action or condition; without change, interruption, or cessation; "it''s still warm outside"; "will you still love me when we''re old and grey?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400030584"
	 b:glossaryEntry='not now; "she is no more"'/>
<rdf:Description rdf:about="&a;400030675">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at the present or from now on; usually used with a negative; "Alice doesn''t live here anymore"; "the children promised not to quarrel any more"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400030867">
	<b:glossaryEntry>prior to a specified or implied time; "she has already graduated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400030986">
	<b:glossaryEntry xml:space='preserve'><![CDATA[subsequent to a specified or implied time; "he hasn''t arrived yet"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400031106">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intensifiers; "she was very gifted"; "he played very well"; "a really enjoyable evening"; (`real'' is sometimes used informally for `really'' as in "I''m real sorry about it"; `rattling'' is informal as in "a rattling good yarn")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400031391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(Southern regional intensive) very; "the baby is mighty cute"; "he''s mighty tired"; "it is powerful humid"; "that boy is powerful big now"; "they have a right nice place"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400031615">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) completely or thoroughly; "when I''m good and ready"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400031714">
	<b:glossaryEntry>intensifier, very colloquial; "what took you so fucking long?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400031812"
	 b:glossaryEntry='very; "he was much annoyed"'/>
<rdf:Description rdf:about="&a;400031872">
	<b:glossaryEntry>from this time forth; from now on; "henceforth she will be known as Mrs. Smith"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400032005">
	<b:glossaryEntry>following this in time or order or place; after this; "hereafter you will no longer receive an allowance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400032148"
	 b:glossaryEntry='in a future life or state; "hope to win salvation hereafter"'/>
<rdf:Description rdf:about="&a;400032246">
	<b:glossaryEntry>only a moment ago; "he has just arrived"; "the sun just now came out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400032359"
	 b:glossaryEntry='without any delay; "he was killed outright"'/>
<rdf:Description rdf:about="&a;400032500"
	 b:glossaryEntry='to a great degree; "rejoiced mightily at the news"'/>
<rdf:Description rdf:about="&a;400032587"
	 b:glossaryEntry='to a moderate degree; "he was mildly interested"'/>
<rdf:Description rdf:about="&a;400032688">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to a small degree; somewhat; "it''s a bit warm"; "felt a little better"; "a trifle smaller"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400032834">
	<b:glossaryEntry>(old-fashioned or informal) in a little while; "see you anon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400032928">
	<b:glossaryEntry>in the near future; "the doctor will soon be here"; "the book will appear shortly"; "she will arrive presently"; "we should have news before long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400033143">
	<b:glossaryEntry>for a short time; "he was at the airport shortly before she was expected to arrive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400033273"
	 b:glossaryEntry='at a short distance; "the hem fell shortly below her knees"'/>
<rdf:Description rdf:about="&a;400033378"
	 b:glossaryEntry='at any moment; "she will be with you momently"'/>
<rdf:Description rdf:about="&a;400033489">
	<b:glossaryEntry>side by side and close together; "the troops marched shoulder-to-shoulder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400033630"
	 b:glossaryEntry='with the least delay; "the soonest I can arrive is 3 P.M."'/>
<rdf:Description rdf:about="&a;400033735"
	 b:glossaryEntry="in a merry sportive manner"/>
<rdf:Description rdf:about="&a;400033818"
	 b:glossaryEntry="in a stormy or violent manner"/>
<rdf:Description rdf:about="&a;400033931">
	<b:glossaryEntry>many times at short intervals; "we often met over a cup of coffee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400034128"
	 b:glossaryEntry="more often or more frequently"/>
<rdf:Description rdf:about="&a;400034193"
	 b:glossaryEntry='at another time; "ever and anon"'/>
<rdf:Description rdf:about="&a;400034258"
	 b:glossaryEntry='not often; "we rarely met"'/>
<rdf:Description rdf:about="&a;400034364">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a manner differing from the usual or expected; "had a curiously husky voice"; "he''s behaving rather peculiarly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400034591">
	<b:glossaryEntry xml:space='preserve'><![CDATA[curious (or funny or interesting or odd or strange) though it may seem; "curiously enough, he didn''t recognize his old friend"; "interestingly enough, America is now dependent on Africa for a large part of its oil"; "funnily enough, the ones I thought so ugly were the ones that sold out first"; "oddly enough, he hasn''t mentioned it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400035044"
	 b:glossaryEntry='in a strange way; "he was strangely silent"'/>
<rdf:Description rdf:about="&a;400035125">
	<b:glossaryEntry>to a moderately sufficient extent or degree; "the shoes are priced reasonably"; "he is fairly clever with computers"; "they lived comfortably within reason"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400035463">
	<b:glossaryEntry>to a degree that exceeds the bounds or reason or moderation; "his prices are unreasonably high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400035686">
	<b:glossaryEntry>to a small degree or extent; "his arguments were somewhat self-contradictory"; "the children argued because one slice of cake was slightly larger than the other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400035913"
	 b:glossaryEntry='in a moving manner; "she sang movingly"'/>
<rdf:Description rdf:about="&a;400036007"
	 b:glossaryEntry="to a great extent"/>
<rdf:Description rdf:about="&a;400036082">
	<b:glossaryEntry>in a widespread way; "oxidation ponds are extensively used for sewage treatment in the Midwest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400036235">
	<b:glossaryEntry>with respect to its inherent nature; "this statement is interesting per se"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400036408">
	<b:glossaryEntry>without question and beyond doubt; "it was decidedly too expensive"; "by all odds they should win"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400036639">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in accordance with truth or fact or reality; "she was now truly American"; "a genuinely open society"; "they don''t really listen to us"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400036883">
	<b:glossaryEntry>(used as an interjection to express surprise or skepticism or irony etc.) "Wants to marry the butler? Indeed!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400037028">
	<b:glossaryEntry>in truth (often tends to intensify); "they said the car would break down and indeed it did"; "it is very cold indeed"; "was indeed grateful"; "indeed, the rain may still come"; "he did so do it!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400037263">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used as intensifiers or sentence modifiers) "in truth, moral decay hastened the decline of the Roman Empire"; "really, you shouldn''t have done it"; "a truly awful book"; (`forsooth'' is archaic and now usually used to express disbelief)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400037564">
	<b:glossaryEntry>as might be expected; "naturally, the lawyer sent us a huge bill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400037706">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not as might be expected; "The early Church not unnaturally adopted the position that failure to see the messianic character of his work was really caused by the people''s own blindness"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400037949">
	<b:glossaryEntry>without doubt or question; "they were clearly lost"; "history has clearly shown the folly of that policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400038108">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unmistakably; "the answer is obviously wrong"; "she was in bed and evidently in great pain"; "he was manifestly too important to leave off the guest list"; "it is all patently nonsense"; "she has apparently been living here for some time"; "I thought he owned the property, but apparently not"; "You are plainly wrong"; (`plain'' is often used informally for `plainly'' as in "he is plain stubborn")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400038718">
	<b:glossaryEntry>from appearances alone; "irrigation often produces bumper crops from apparently desert land"; "the child is seemingly healthy but the doctor is concerned"; "had been ostensibly frank as to his purpose while really concealing it"-Thomas Hardy; "on the face of it the problem seems minor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400039142"
	 b:glossaryEntry='anew; "she tried again"; "they rehearsed the scene again"'/>
<rdf:Description rdf:about="&a;400039271"
	 b:glossaryEntry="together with this"/>
<rdf:Description rdf:about="&a;400039324"
	 b:glossaryEntry='without advance planning; "they met accidentally"'/>
<rdf:Description rdf:about="&a;400039514">
	<b:glossaryEntry>in a way that was not expected; "her brother showed up at the wedding out of the blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400039677">
	<b:glossaryEntry>in distinction from others; "a program specifically for teenagers"; "he is interested specifically in poisonous snakes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400039873">
	<b:glossaryEntry>without distinction of one from others; "he is interested in snakes in general"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400040053"
	 b:glossaryEntry='without specificity; "nonspecifically staining substances"'/>
<rdf:Description rdf:about="&a;400040173"
	 b:glossaryEntry='by good fortune; "fortunately the weather was good"'/>
<rdf:Description rdf:about="&a;400040403"
	 b:glossaryEntry='in an unexpectedly lucky way; "happily he was not injured"'/>
<rdf:Description rdf:about="&a;400040533">
	<b:glossaryEntry>in an unfortunate way; "sadly he died before he could see his grandchild"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400040688">
	<b:glossaryEntry>by bad luck; "unfortunately it rained all day"; "alas, I cannot stay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400040922">
	<b:glossaryEntry>(used to introduce a logical conclusion) from that fact or reason or as a result; "therefore X must be true"; "the eggs were fresh and hence satisfactory"; "we were young and thence optimistic"; "it is late and thus we must go"; "the witness is biased and so cannot be trusted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400041261"
	 b:glossaryEntry="(used as a sentenced connector) therefore or consequently"/>
<rdf:Description rdf:about="&a;400041351"
	 b:glossaryEntry='from this time; "a year hence it will be forgotten"'/>
<rdf:Description rdf:about="&a;400041436"
	 b:glossaryEntry='(archaic) from this place; "get thee hence!"'/>
<rdf:Description rdf:about="&a;400041514">
	<b:glossaryEntry>from that place or from there; "proceeded thence directly to college"; "flew to Helsinki and thence to Moscow"; "roads that lead therefrom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400041700">
	<b:glossaryEntry>from that circumstance or source; "atomic formulas and all compounds thence constructible"- W.V.Quine; "a natural conclusion follows thence";"public interest and a policy deriving therefrom"; "Typhus fever results therefrom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400041981">
	<b:glossaryEntry>from what place or origin or source; "whence did he come?"; "whence comes this splendid feast?"; "sketches the lawless society whence the ballads sprang"-DeLancey Ferguson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400042199">
	<b:glossaryEntry>(in formal usage; especially legal usage) for that or it; "ordering goods and enclosing payment therefor"; "a refund therefor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400042362">
	<b:glossaryEntry>affecting the pursuit of a vocation or occupation; "vocationally trained"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400042494">
	<b:glossaryEntry>involving close contact; confronting each other; "the boy and the policeman suddenly came face-to-face at the corner"; "they spoke facel to face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400042680">
	<b:glossaryEntry>(of two persons) in direct encounter; "preferred to settle the matter one-on-one"; "interviewed her person-to-person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400042855">
	<b:glossaryEntry xml:space='preserve'><![CDATA[within each other''s presence; "she met the president face-to-face"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400042962">
	<b:glossaryEntry>directly facing each other; "the two photographs lay face-to-face on the table"; "lived all their lives in houses face-to-face across the street"; "they sat opposite at the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400043193"
	 b:glossaryEntry='face-to-face; "they sat vis-a-vis at the table"'/>
<rdf:Description rdf:about="&a;400043278">
	<b:glossaryEntry>without the intrusion of a third person; in intimate privacy; "we talked tete-a-tete"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400043403">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perhaps; indicating possibility of being more remarkable (greater or better or sooner) than; "will yield 10% if not more"; "pretty if not actually beautiful"; "let''s meet tonight if not sooner"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400043631">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually used with `or'') if not, then; "watch your step or else you may fall"; "leave or else I''ll get angry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400043773">
	<b:glossaryEntry xml:space='preserve'><![CDATA[additional to or different from this one or place or time or manner; "nobody else is here"; "she ignored everything else"; "I don''t know where else to look"; "when else can we have the party?"; "couldn''t decide how else it could be done"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044043">
	<b:glossaryEntry>in addition; "agreed to provide essentials but nothing beyond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044140">
	<b:glossaryEntry>farther along in space or time or degree; "through the valley and beyond"; "to the eighth grade but not beyond"; "will be influential in the l990s and beyond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044333">
	<b:glossaryEntry>on the farther side from the observer; "a pond with a hayfield beyond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044456">
	<b:glossaryEntry>in other respects or ways; "he is otherwise normal"; "the funds are not otherwise available"; "an otherwise hopeless situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044621">
	<b:glossaryEntry>by way of addition; furthermore; "he serves additionally as the CEO"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044772"
	 b:glossaryEntry='for fear that; "she tiptoed lest her mother should hear her"'/>
<rdf:Description rdf:about="&a;400044865">
	<b:glossaryEntry>that (after verbs explicitly expressing fear etc.); "he worried lest he should be late"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400044985">
	<b:glossaryEntry>to an extreme degree; "extremely cold"; "extremely unpleasant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400045103"
	 b:glossaryEntry='in excess or without limit; "amazed beyond measure"'/>
<rdf:Description rdf:about="&a;400045197">
	<b:glossaryEntry>(used as intensives) extremely; "she was madly in love"; "deadly dull"; "deadly earnest"; "deucedly clever"; "insanely jealous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400045402">
	<b:glossaryEntry>extremely; "she was inordinately smart"; "it will be an extraordinarily painful step to negotiate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400045595">
	<b:glossaryEntry>by a considerable margin; "she was by far the smartest student"; "it was far and away the best meal he had ever eaten"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400045763">
	<b:glossaryEntry>outstandingly superior to; "in intelligence he was head and shoulders above the others in his class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400045916"
	 b:glossaryEntry='to an excessive degree; "too big"'/>
<rdf:Description rdf:about="&a;400046022"
	 b:glossaryEntry='in addition; "he has a Mercedes, too"'/>
<rdf:Description rdf:about="&a;400046129">
	<b:glossaryEntry>within an indefinite time or at an unspecified future time; "he will understand eventually"; "he longed for the flowers that were yet to show themselves"; "sooner or later you will have to face the facts"; "in time they came to accept the harsh reality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400046493">
	<b:glossaryEntry>as the end result of a succession or process; "ultimately he had to give in"; "at long last the winter was over"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400046728">
	<b:glossaryEntry>after a long period of time or an especially long delay; "at length they arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400046870">
	<b:glossaryEntry>at this time or period; now; "he is presently our ambassador to the United Nations"; "currently they live in Connecticut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400047077">
	<b:glossaryEntry>in these times; "it is solely by their language that the upper classes nowadays are distinguished"- Nancy Mitford; "we now rarely see horse-drawn vehicles on city streets"; "today almost every home has television"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400047341">
	<b:glossaryEntry>without delay; with no time intervening; "he answered immediately"; "found an answer straightaway"; "an official accused of dishonesty should be supended forthwith"; "Come here now!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400047675">
	<b:glossaryEntry>used to preface a command or reproof or request; "now hear this!"; "now pay attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400047793">
	<b:glossaryEntry>at the present moment; "goods now on sale"; "the now-aging dictator"; "they are now abroad"; "he is busy at present writing a new novel"; "it could happen any time now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400048006">
	<b:glossaryEntry>in the historical present; at this point in the narration of a series of past events; "President Kennedy now calls in the National Guard"; "Washington now decides to cross the Delaware"; "the ship is now listing to port"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400048258"
	 b:glossaryEntry='in the immediate past; "told me just now"'/>
<rdf:Description rdf:about="&a;400048331"
	 b:glossaryEntry='(prefatory or transitional) "Now the next problem is..."'/>
<rdf:Description rdf:about="&a;400048419"
	 b:glossaryEntry="interjection of rebuke"/>
<rdf:Description rdf:about="&a;400048477"
	 b:glossaryEntry='in an aggressive manner; "she was being sharply questioned"'/>
<rdf:Description rdf:about="&a;400048605"
	 b:glossaryEntry='in a shrill voice; "she sang rather shrilly"'/>
<rdf:Description rdf:about="&a;400048734"
	 b:glossaryEntry='at a steady rate or pace; "his interest eroded steadily"'/>
<rdf:Description rdf:about="&a;400048845"
	 b:glossaryEntry='in a joyous manner; "they shouted happily"'/>
<rdf:Description rdf:about="&a;400049121"
	 b:glossaryEntry='in an unpleasant way; "they were unhappily married"'/>
<rdf:Description rdf:about="&a;400049246">
	<b:glossaryEntry>referring to the degree to which a certain quality is present; "he was no heavier than a child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400049382">
	<b:glossaryEntry>with resolute determination; "we firmly believed it"; "you must stand firm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400049582">
	<b:glossaryEntry>with firmness and conviction; without compromise; "he stood foursquare for religious liberty and toleration"- C.G.Bowers; "dealt straightforwardly with all issues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400049833">
	<b:glossaryEntry>firmly and solidly; "hit the ball squarely"; "the bat met the ball squarely"; "planted his great bulk square before his enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400050005">
	<b:glossaryEntry>in a square shape; "a squarely cut piece of paper"; "folded the sheet of paper square"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400050155">
	<b:glossaryEntry>directly and without evasion; not roundabout; "to face a problem squarely"; "the responsibility lies squarely with them"; "spoke forthright (or forthrightly) and to the point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400050413">
	<b:glossaryEntry>with honesty and fairness; "dealt squarely with his customers"; "always treated me square"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400050567">
	<b:glossaryEntry>without deviation; "the path leads directly to the lake"; "went direct to the office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400050745">
	<b:glossaryEntry>in a straight direct way; "looked him squarely in the eye"; "ran square into me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400050871"
	 b:glossaryEntry='directly or exactly; straight; "went due North"'/>
<rdf:Description rdf:about="&a;400050950">
	<b:glossaryEntry>in diverse ways; "the alternatives that are variously represented by the participants"; "the speakers treated the subject most diversely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400051208">
	<b:glossaryEntry>with indefatigable energy; "she watched the show indefatigably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400051378"
	 b:glossaryEntry='in a biradial manner; "biradially symmetrical"'/>
<rdf:Description rdf:about="&a;400051481"
	 b:glossaryEntry='in a resentful manner; "she complained bitterly"'/>
<rdf:Description rdf:about="&a;400051602">
	<b:glossaryEntry>indicating something hard to accept; "he was bitterly disappointed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400051724"
	 b:glossaryEntry="sentence-initial expression of agreement"/>
<rdf:Description rdf:about="&a;400051836">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reinforces an assertion, as in "It''s expensive all right"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400051957"
	 b:glossaryEntry='in a swift manner; "she moved swiftly"'/>
<rdf:Description rdf:about="&a;400052077">
	<b:glossaryEntry>in an open way; "he openly flaunted his affection for his sister"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400052195"
	 b:glossaryEntry='almost; "he was practically the only guest at the party"'/>
<rdf:Description rdf:about="&a;400052291"
	 b:glossaryEntry='by reasonable assumption; "presumably, he missed the train"'/>
<rdf:Description rdf:about="&a;400052441">
	<b:glossaryEntry>at the time or occasion immediately following; "next the doctor examined his back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400052557">
	<b:glossaryEntry xml:space='preserve'><![CDATA[temporarily; "we''ll stop for the time being"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400052665">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without question; "easily the best book she''s written"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400052754"
	 b:glossaryEntry='without the use of a machine; "this dress is sewn by hand"'/>
<rdf:Description rdf:about="&a;400052866"
	 b:glossaryEntry='with the use of a machine; "the shirt is sewn by machine"'/>
<rdf:Description rdf:about="&a;400052980"
	 b:glossaryEntry='at close quarters; "fought hand to hand"'/>
<rdf:Description rdf:about="&a;400053061">
	<b:glossaryEntry>with barely enough money for immediate needs; "they lived form hand to mouth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400053180">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) used as intensifiers, as in "terribly interesting"; "I''m awful sorry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400053329"
	 b:glossaryEntry='in a terrible manner; "she sings terribly"'/>
<rdf:Description rdf:about="&a;400053540">
	<b:glossaryEntry>in an acceptable (but not outstanding) manner; "she plays tennis tolerably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400053746">
	<b:glossaryEntry>to an unacceptable degree; "The percentage of lead in our drinking water is unacceptably high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400053967">
	<b:glossaryEntry>in an abusive manner; "he behaved abusively toward his children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400054087"
	 b:glossaryEntry='with admiration; "he looked at his wife admiringly"'/>
<rdf:Description rdf:about="&a;400054177"
	 b:glossaryEntry='with adoration; "he looked at his wife adoringly"'/>
<rdf:Description rdf:about="&a;400054282"
	 b:glossaryEntry='in an adroit manner; "he handled the situation adroitly"'/>
<rdf:Description rdf:about="&a;400054429">
	<b:glossaryEntry>in a maladroit manner; "he dealt with the situation maladroitly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400054569">
	<b:glossaryEntry>of a dreadful kind; "there was a dreadfully bloody accident on the road this morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400054768">
	<b:glossaryEntry>to a great extent or degree; "he improved greatly"; "greatly reduced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400054891"
	 b:glossaryEntry="in a drastic manner"/>
<rdf:Description rdf:about="&a;400054968">
	<b:glossaryEntry>in the slightest degree or in any respect; "Are you at all interested? No, not at all"; "was not in the least unfriendly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400055155"
	 b:glossaryEntry='(informal) definitely or certainly; "Visit us by all means"'/>
<rdf:Description rdf:about="&a;400055273">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) definitely not; "the prize is by no means certain"; "and that isn''t all, not by a long sight"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400055480"
	 b:glossaryEntry='in an exhaustive manner; "we searched the files thoroughly"'/>
<rdf:Description rdf:about="&a;400055611">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a complete and thorough manner; "he was soundly defeated"; (`good'' is used informally for `thoroughly'' as in "we beat him good")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400055834">
	<b:glossaryEntry xml:space='preserve'><![CDATA[throughout the entire extent; "got soaked through in the rain"; "I''m frozen through"; "a letter shot through with the writer''s personality"; "knew him through and through"; "boards rotten through and through"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400056100">
	<b:glossaryEntry>deeply or completely; "slept soundly through the storm"; "is sound asleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400056236"
	 b:glossaryEntry='(informal) exactly; "he fell flop on his face"'/>
<rdf:Description rdf:about="&a;400056323">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a forthright manner; candidly or frankly; "he didn''t answer directly"; "told me straight out"; "came out flat for less work and more pay"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400056554"
	 b:glossaryEntry='not in a forthright manner; "he answered very indirectly"'/>
<rdf:Description rdf:about="&a;400056686"
	 b:glossaryEntry="in an individualistic manner"/>
<rdf:Description rdf:about="&a;400056780"
	 b:glossaryEntry='directly; "we must talk man-to-man"'/>
<rdf:Description rdf:about="&a;400056854">
	<b:glossaryEntry>in a relaxed position, of soldiers; "the soldiers were standing at ease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400056972">
	<b:glossaryEntry>by indirect means; "I heard about it only secondhand or thirdhand--maybe even fourthhand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400057118">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to a great degree or extent; "she''s much better now"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400057204">
	<b:glossaryEntry>to a very great degree or extent; "we enjoyed ourselves very much"; "she was very much interested"; "this would help a great deal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400057416">
	<b:glossaryEntry xml:space='preserve'><![CDATA[frequently or in great quantities; "I don''t drink much"; "I don''t travel much"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400057550">
	<b:glossaryEntry xml:space='preserve'><![CDATA[comparative of `well''; in a better or more excellent manner or more advantageously or attractively or to a greater degree etc.; "She had never sung better"; "a deed better left undone"; "better suited to the job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400057797">
	<b:glossaryEntry>advancing in amount or intensity; "she became increasingly depressed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400057975">
	<b:glossaryEntry>in actuality or reality or fact; "she is effectively his wife"; "in effect, they had no choice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400058140">
	<b:glossaryEntry>in reality or fact; "the result was, de facto, a one-party system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400058243">
	<b:glossaryEntry>in every practical sense; "to all intents and purposes the case is closed"; "the rest are for all practical purposes useless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400058484"
	 b:glossaryEntry="in a manner that is reproducible"/>
<rdf:Description rdf:about="&a;400058575">
	<b:glossaryEntry>at an earlier time or formerly; "she had previously lived in Chicago"; "he was previously president of a bank"; "better than anything previously proposed"; "a previously unquestioned attitude"; "antecedently arranged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400058882">
	<b:glossaryEntry>earlier in time; previously; "I had known her before"; "as I said before"; "he called me the day before but your call had come even earlier"; "her parents had died four years earlier"; "I mentioned that problem earlier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400059146">
	<b:glossaryEntry xml:space='preserve'><![CDATA[happening at a time subsequent to a reference time; "he apologized subsequently"; "he''s going to the store but he''ll be back here later"; "it didn''t happen until afterward"; "two hours after that"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400059471"
	 b:glossaryEntry='quickly and without warning; "he stopped suddenly"'/>
<rdf:Description rdf:about="&a;400059620">
	<b:glossaryEntry>happening unexpectedly; "suddenly she felt a sharp pain in her side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400059757">
	<b:glossaryEntry xml:space='preserve'><![CDATA[suddenly; "Presto! begone! ''tis here again"- Swift]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400059842"
	 b:glossaryEntry="(music) at a very fast tempo (faster than allegro)"/>
<rdf:Description rdf:about="&a;400059927">
	<b:glossaryEntry>with intention; in an intentional manner; "he used that word intentionally"; "I did this by choice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400060247">
	<b:glossaryEntry>without intention; in an unintentional manner; "she hit him unintentionally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400060454">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sentence connectors) because of the reason given; "consequently, he didn''t do it"; "continued to have severe headaches and accordingly returned to the doctor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400060686"
	 b:glossaryEntry='in accordance with; "she acted accordingly"'/>
<rdf:Description rdf:about="&a;400060769">
	<b:glossaryEntry>in place of, or as an alternative to; "Felix became a herpetologist instead"; "alternatively we could buy a used car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400060986">
	<b:glossaryEntry xml:space='preserve'><![CDATA[much less; "she can''t boil potatoes, let alone cook a meal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400061100">
	<b:glossaryEntry>for a still stronger, more certain reason; "if you are wrong then, a foritori, so am I"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400061267">
	<b:glossaryEntry>with everything included or counted; "altogether he earns close to a million dollars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400061411">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of a group whose members acted or were acted upon collectively and when `all'' and `together'' can be separated by other words; "they were herded all together"; "they were all herded together"; "the books lay all together in a heap"; "the books all lay together..."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400061720"
	 b:glossaryEntry='with respect to anatomy; "anatomically correct"'/>
<rdf:Description rdf:about="&a;400061826">
	<b:glossaryEntry>without preparation or reflection; without a rational basis; "they bought the car blindly"; "he picked a wife blindly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400061998"
	 b:glossaryEntry='with respect to color; "chromatically pure"'/>
<rdf:Description rdf:about="&a;400062101"
	 b:glossaryEntry='with respect to chronology; "he is chronologically older"'/>
<rdf:Description rdf:about="&a;400062220"
	 b:glossaryEntry='in a clinical manner; "she is clinically qualified"'/>
<rdf:Description rdf:about="&a;400062328"
	 b:glossaryEntry='at the proper time; "she was duly apprised of the raise"'/>
<rdf:Description rdf:about="&a;400062466"
	 b:glossaryEntry='with respect to mathematics; "mathematically impossible"'/>
<rdf:Description rdf:about="&a;400062583">
	<b:glossaryEntry>during the intervening time; "meanwhile I will not think about the problem"; "meantime he was attentive to his other interests"; "in the meantime the police were notified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400062821">
	<b:glossaryEntry>at the same time but in another place; "meanwhile, back at the ranch..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400062931"
	 b:glossaryEntry='two times; "I called her twice"'/>
<rdf:Description rdf:about="&a;400062996">
	<b:glossaryEntry>in a lengthy or prolix manner; "the argument went on lengthily"; "she talked at length about the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400063169">
	<b:glossaryEntry>more recently than any other time; "I saw him last in London"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400063279">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the item at the end; "last, I''ll discuss family values"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400063420">
	<b:glossaryEntry>in addition to all the foregoing; "last not least he plays the saxophone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400063557"
	 b:glossaryEntry="in an enduring or permanent manner"/>
<rdf:Description rdf:about="&a;400063647">
	<b:glossaryEntry>in an absent-minded or preoccupied manner; "he read the letter absently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400063876"
	 b:glossaryEntry='in an accusing manner; "he looked at her accusingly"'/>
<rdf:Description rdf:about="&a;400063985"
	 b:glossaryEntry="in an affected manner"/>
<rdf:Description rdf:about="&a;400064063"
	 b:glossaryEntry='in a poignant or touching manner; "she spoke poignantly"'/>
<rdf:Description rdf:about="&a;400064239">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at or in the front; "I see the lights of a town ahead"; "the road ahead is foggy"; "staring straight ahead"; "we couldn''t see over the heads of the people in front"; "with the cross of Jesus marching on before"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400064503">
	<b:glossaryEntry>ahead of time; in anticipation; "when you pay ahead (or in advance) you receive a discount"; "We like to plan ahead"; "should have made reservatons beforehand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400064722">
	<b:glossaryEntry>in a forward direction; "go ahead"; "the train moved ahead slowly"; "the boat lurched ahead"; "moved onward into the forest"; "they went slowly forward in the mud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400064970">
	<b:glossaryEntry>leading or ahead in a competition; "the horse was three lengths ahead going into the home stretch"; "ahead by two pawns"; "our candidate is in the lead in the polls"; "way out front in the race"; "the advertising campaign put them out front in sales"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400065280">
	<b:glossaryEntry>to a different or a more advanced time (meaning advanced either toward the present or toward the future); "moved the appointment ahead from Tuesday to Monday"; "pushed the deadline ahead from Tuesday to Wednesday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400065527">
	<b:glossaryEntry>to a more advanced or advantageous position; "a young man sure to get ahead"; "pushing talented students ahead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400065672">
	<b:glossaryEntry>all the time or over a period of time; "She had known all along"; "the hope had been there all along"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400065825">
	<b:glossaryEntry>with a forward motion; "we drove along admiring the view"; "the horse trotted along at a steady pace"; "the circus traveled on to the next city"; "move along"; "march on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400066034">
	<b:glossaryEntry>in accompaniment or as a companion; "his little sister came along to the movies"; "I brought my camera along"; "working along with his father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400066210">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in addition (usually followed by `with''); "we sent them food and some clothing went along in the package"; "along with the package came a bill"; "consider the advantages along with the disadvantages"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400066443">
	<b:glossaryEntry>to a more advanced state; "the work is moving along"; "well along in their research"; "hurrying their education along"; "getting along in years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400066621">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in line with a length or direction (often followed by `by'' or `beside''); "pass the word along"; "ran along beside me"; "cottages along by the river"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400066803">
	<b:glossaryEntry>indicates continuity or persistence or concentration; "his spirit lives on"; "shall I read on?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400066929">
	<b:glossaryEntry>in a state required for something to function or be effective; "turn the lights on"; "get a load on" is slang for "drink enough to become intoxicated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400067110"
	 b:glossaryEntry='in a like manner; "they walk alike"'/>
<rdf:Description rdf:about="&a;400067179"
	 b:glossaryEntry='equally; "parents and teachers alike demanded reforms"'/>
<rdf:Description rdf:about="&a;400067278">
	<b:glossaryEntry>using the voice; not silently; "please read the passage aloud"; "he laughed out loud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400067408">
	<b:glossaryEntry>with relatively high volume; "the band played loudly"; "she spoke loudly and angrily"; "he spoke loud enough for those at the back of the room to hear him"; "cried aloud for help"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400067673">
	<b:glossaryEntry>with low volume; "speak softly but carry a big stick"; "she spoke quietly to the child"; "the radio was playing softly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400067873">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to a faint degree or weakly perceived; "between him and the dim light a form was outlined faintly"; "stars shining faintly through the overcast"; "could hear his distant shouts only faintly"; "the rumors weren''t even faintly true"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400068157"
	 b:glossaryEntry='in an analogous manner; "analogously, we have a variable"'/>
<rdf:Description rdf:about="&a;400068272">
	<b:glossaryEntry>in a random manner; "the houses were randomly scattered"; "bullets were fired into the crowd at random"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400068557">
	<b:glossaryEntry>in circumference; "the trunk is ten feet around"; "the pond is two miles around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400068672">
	<b:glossaryEntry>in the area or vicinity; "a few spectators standing about"; "hanging around"; "waited around for the next flight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400068828">
	<b:glossaryEntry>not far away in relative terms; "she works nearby"; "the planets orbiting nearby are Venus and Mars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400068963">
	<b:glossaryEntry>from beginning to end; throughout; "It rains all year round on Skye"; "frigid weather the year around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400069108">
	<b:glossaryEntry>by a circular or circuitous route; "He came all the way around the base"; "the road goes around the pond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400069248">
	<b:glossaryEntry>in a circle or circular motion; "The wheels are spinning around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400069347">
	<b:glossaryEntry xml:space='preserve'><![CDATA[all around or on all sides; "dirty clothes lying around (or about)"; "let''s look about for help"; "There were trees growing all around"; "she looked around her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400069550">
	<b:glossaryEntry>to a particular destination either specified or understood; "she came around to see me"; "I invited them around for supper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400069708">
	<b:glossaryEntry>in or to a reversed position or direction; "about face"; "brought the ship about"; "suddenly she turned around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400069862">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to or among many different places or in no particular direction; "wandering about with no place to go"; "people were rushing about"; "news gets around (or about)"; "traveled around in Asia"; "he needs advice from someone who''s been around"; "she sleeps around"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400070165">
	<b:glossaryEntry>in or to various places; first this place and then that; "he worked here and there but never for long in one town"; "we drove here and there in the darkness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400070365">
	<b:glossaryEntry>with great urgency; "health care reform is needed urgently"; "the soil desperately needed potash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400070549">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of actions or states) slightly short of or not quite accomplished; "the job is (just) about done"; "the baby was almost asleep when the alarm sounded"; "we''re almost finished"; "the car all but ran her down"; "he nearly fainted"; "talked for nigh onto 2 hours"; "the recording is well-nigh perfect"; "virtually all the parties signed the contract"; (`near'' is used informally for `nearly'' as in "I was near exhausted by the run"; `most'' is used informally for `almost'' as in "most everybody ag40007054]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400071169"
	 b:glossaryEntry='in an asexual manner; "plants that reproduce asexually"'/>
<rdf:Description rdf:about="&a;400071280"
	 b:glossaryEntry='toward an asymptote; "it grew asymptotically"'/>
<rdf:Description rdf:about="&a;400071386"
	 b:glossaryEntry='n a sparse or scanty way; "a barely furnished room"'/>
<rdf:Description rdf:about="&a;400071501"
	 b:glossaryEntry='for the most part; "he is mainly interested in butterflies"'/>
<rdf:Description rdf:about="&a;400071699">
	<b:glossaryEntry>in the past; "long ago"; "sixty years ago my grandfather came to the U.S."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400071805">
	<b:glossaryEntry>in or to or toward a past time; "set the clocks back an hour"; "never look back"; "lovers of the past looking fondly backward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400072011">
	<b:glossaryEntry>at or to or toward or the back or rear; "he moved back"; "tripped when he stepped backward"; "she looked rearward out the window of the car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400072248">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at or to or toward the front; "he faced forward"; "step forward"; "she practiced sewing backward as well as frontward on her new sewing machine"; (`forrad'' and `forrard'' are dialectal variations)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400072552">
	<b:glossaryEntry>in repayment or retaliation; "we paid back everything we had borrowed"; "he hit me and I hit him back"; "I was kept in after school for talking back to the teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400072749">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in or to or toward a former location; "she went back to her parents'' house"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400072857">
	<b:glossaryEntry>in or to or toward an original condition; "he went back to sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400072955">
	<b:glossaryEntry>in answer; "he wrote back three days later"; "had little to say in reply to the questions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400073089">
	<b:glossaryEntry>toward the future; forward in time; "I like to look ahead in imagination to what the future may bring"; "I look forward to seeing you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400073303"
	 b:glossaryEntry='by surprise; "taken aback by the caustic remarks"'/>
<rdf:Description rdf:about="&a;400073386">
	<b:glossaryEntry>having the wind against the forward side of the sails; "the ship came up into the wind with all yards aback"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400073528"
	 b:glossaryEntry="at right angles to the length of a ship or airplane"/>
<rdf:Description rdf:about="&a;400073613">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a manner or order or direction the reverse of normal; "it''s easy to get the `i'' and the `e'' backward in words like `seize'' and `siege''"; "the child put her jersey on backward"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400073840">
	<b:glossaryEntry>moving from one place to another and back again; "he traveled back and forth between Los Angeles and New York"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074029">
	<b:glossaryEntry>moving backward and forward along a given course; "he walked up and down the locker room"; "all up and down the Eastern seaboard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074198">
	<b:glossaryEntry>with regard to sound or the ear; "the new musical was visually and aurally appealing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074337">
	<b:glossaryEntry>with respect to an axis; "the jet was directed axially toward the cathode"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074465"
	 b:glossaryEntry='in a brazen manner; "he spoke brazenly"'/>
<rdf:Description rdf:about="&a;400074559">
	<b:glossaryEntry>in an extremely intelligent way; "he solved the problem brilliantly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074685">
	<b:glossaryEntry>with brightness; "the stars shone brilliantly"; "the windows glowed jewel bright"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074862">
	<b:glossaryEntry>in a commercial manner; "the product is commercially available"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400074984">
	<b:glossaryEntry>at a great cost; "he paid dearly for the food"; "this cost him dear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400075112">
	<b:glossaryEntry>with affection; "she loved him dearly"; "he treats her affectionately"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400075277">
	<b:glossaryEntry>in a sincere and heartfelt manner; "I would dearly love to know"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400075415">
	<b:glossaryEntry>with the terms of the relation reversed; "conversely, not all women are mothers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400075552">
	<b:glossaryEntry>for cosmetic purposes to improve appearance; "it is used cosmetically by many women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400075695"
	 b:glossaryEntry="in a decorative manner"/>
<rdf:Description rdf:about="&a;400075774"
	 b:glossaryEntry='in a covert manner; "he did it covertly"'/>
<rdf:Description rdf:about="&a;400075887"
	 b:glossaryEntry='in an overt manner; "he did it overtly"'/>
<rdf:Description rdf:about="&a;400075999">
	<b:glossaryEntry>by using a microscope; "the blood was examined microscopically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400076124">
	<b:glossaryEntry>in a microscopic manner; with extreme precision and attention to detail; "every manuscript was edited microscopically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400076304">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with certainty; "it''s undoubtedly very beautiful"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400076476">
	<b:glossaryEntry>with respect to statistics; "this is statistically impossible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400076598">
	<b:glossaryEntry>with respect to thermodynamics; "this phenomenon is thermodynamically impossible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400076743"
	 b:glossaryEntry='during the night of the present day; "drop by tonight"'/>
<rdf:Description rdf:about="&a;400076861"
	 b:glossaryEntry='in an active manner; "he participated actively in the war"'/>
<rdf:Description rdf:about="&a;400076992"
	 b:glossaryEntry='in a passive manner; "he listened passively"'/>
<rdf:Description rdf:about="&a;400077110"
	 b:glossaryEntry='at a later place; "see below"'/>
<rdf:Description rdf:about="&a;400077191"
	 b:glossaryEntry='at an earlier place; "see above"'/>
<rdf:Description rdf:about="&a;400077283"
	 b:glossaryEntry="in or to a place that is lower"/>
<rdf:Description rdf:about="&a;400077413"
	 b:glossaryEntry="in or to a place that is higher"/>
<rdf:Description rdf:about="&a;400077548">
	<b:glossaryEntry>in addition; over and above what is expected; "He lost his wife in the bargain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400077689"
	 b:glossaryEntry="in a contemptible manner"/>
<rdf:Description rdf:about="&a;400077772">
	<b:glossaryEntry>without respect; in a disdainful manner; "she spoke of him contemptuously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400078025">
	<b:glossaryEntry>by virtue of a contract; "they were contractually responsible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400078147">
	<b:glossaryEntry>in an insane manner; "she behaved insanely"; "he behaves crazily when he is off his medication"; "the witch cackled madly"; "screaming dementedly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400078451">
	<b:glossaryEntry>in a sane or lucid manner; "she is behaving rather sanely these days even though we know she is schizophrenic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400078632"
	 b:glossaryEntry='in a comical manner; "she acted comically"'/>
<rdf:Description rdf:about="&a;400078738"
	 b:glossaryEntry='without missing a day; "he stops by daily"'/>
<rdf:Description rdf:about="&a;400078837"
	 b:glossaryEntry='without missing a week; "she visited her aunt weekly"'/>
<rdf:Description rdf:about="&a;400078983"
	 b:glossaryEntry='without missing a month; "we get paid monthly"'/>
<rdf:Description rdf:about="&a;400079092"
	 b:glossaryEntry='without missing a year; "they travel to China annually"'/>
<rdf:Description rdf:about="&a;400079236"
	 b:glossaryEntry='with curiosity; "the baby looked around curiously"'/>
<rdf:Description rdf:about="&a;400079394"
	 b:glossaryEntry="in a manner or to a degree that dazzles the beholder"/>
<rdf:Description rdf:about="&a;400079503"
	 b:glossaryEntry='in a misleading way; "the exam looked deceptively easy"'/>
<rdf:Description rdf:about="&a;400079663">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at or in an indicated (usually distant) place; "the house yonder"; (`yon'' is archaic and dialectal as in "scattered here and yon"- Calder Willingham)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400079853"
	 b:glossaryEntry="in a depressing manner or to a depressing degree"/>
<rdf:Description rdf:about="&a;400079960"
	 b:glossaryEntry="in a dichotomous manner"/>
<rdf:Description rdf:about="&a;400080043"
	 b:glossaryEntry="in a digitate manner"/>
<rdf:Description rdf:about="&a;400080120"
	 b:glossaryEntry="in a disruptive manner"/>
<rdf:Description rdf:about="&a;400080201"
	 b:glossaryEntry='in a giddy light-headed manner; "he walked around dizzily"'/>
<rdf:Description rdf:about="&a;400080358"
	 b:glossaryEntry="in a dorsal location or direction"/>
<rdf:Description rdf:about="&a;400080446">
	<b:glossaryEntry>in a dorsoventral direction; "the ray has a dorsoventrally flattened body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400080581"
	 b:glossaryEntry="in a ventral location or direction"/>
<rdf:Description rdf:about="&a;400080671">
	<b:glossaryEntry>to double the degree; "she was doubly rewarded"; "his eyes were double bright"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400080819"
	 b:glossaryEntry='one by one; one at a time; "they were arranged singly"'/>
<rdf:Description rdf:about="&a;400080944">
	<b:glossaryEntry>in several ways; in a multiple manner; "they were multiply checked for errors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400081095"
	 b:glossaryEntry='in a twofold manner; "he was doubly wrong"'/>
<rdf:Description rdf:about="&a;400081186"
	 b:glossaryEntry='in an empirical manner; "this can be empirically tested"'/>
<rdf:Description rdf:about="&a;400081371"
	 b:glossaryEntry='in a tolerable manner; "she did it well enough"'/>
<rdf:Description rdf:about="&a;400081536">
	<b:glossaryEntry>to a distinctly greater extent or degree than is common; "he was particularly fussy about spelling"; "a particularly gruesome attack"; "under peculiarly tragic circumstances"; "an especially (or specially) cautious approach to the danger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400081925"
	 b:glossaryEntry='unusually or exceptionally; "an extra fast car"'/>
<rdf:Description rdf:about="&a;400082006"
	 b:glossaryEntry='with elaboration; "it was elaborately spelled out"'/>
<rdf:Description rdf:about="&a;400082168">
	<b:glossaryEntry>in or to another place; "he went elsewhere"; "look elsewhere for the answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400082282"
	 b:glossaryEntry="in an exasperating manner"/>
<rdf:Description rdf:about="&a;400082368">
	<b:glossaryEntry>in an experimental fashion; "this can be experimentally determined"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400082541">
	<b:glossaryEntry>for the express purpose; "she needs the money expressly for her patients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400082679">
	<b:glossaryEntry>in an explicit manner; "he stated expressly that the needed the money by tomorrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400082848"
	 b:glossaryEntry='not seriously; "I meant it facetiously"'/>
<rdf:Description rdf:about="&a;400082992"
	 b:glossaryEntry='with rapid movements; "he works quickly"'/>
<rdf:Description rdf:about="&a;400083181">
	<b:glossaryEntry>quickly or rapidly (often used as a combining form); "how fast can he get here?"; "ran as fast as he could"; "needs medical help fast"; "fast-running rivers"; "fast-breaking news"; "fast-opening (or fast-closing) shutters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400083436"
	 b:glossaryEntry='at top speed; "ran flat out to catch the bus"'/>
<rdf:Description rdf:about="&a;400083518">
	<b:glossaryEntry>firmly or tightly; "held fast to the rope"; "her foot was stuck fast"; "held tight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400083642"
	 b:glossaryEntry="more quickly"/>
<rdf:Description rdf:about="&a;400083735"
	 b:glossaryEntry="more slowly"/>
<rdf:Description rdf:about="&a;400083799"
	 b:glossaryEntry="most quickly"/>
<rdf:Description rdf:about="&a;400083894"
	 b:glossaryEntry="most slowly"/>
<rdf:Description rdf:about="&a;400083959"
	 b:glossaryEntry="in a permissive manner"/>
<rdf:Description rdf:about="&a;400084040"
	 b:glossaryEntry="in a permissible manner"/>
<rdf:Description rdf:about="&a;400084169">
	<b:glossaryEntry>not permissibly; "the radon level in the basement was impermissibly high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400084320"
	 b:glossaryEntry='in an unqualified manner; "he flatly denied the charges"'/>
<rdf:Description rdf:about="&a;400084499"
	 b:glossaryEntry='squarely or solidly; "hit him flush in the face"'/>
<rdf:Description rdf:about="&a;400084581"
	 b:glossaryEntry='in the same plane; "set it flush with the top of the table"'/>
<rdf:Description rdf:about="&a;400084674">
	<b:glossaryEntry xml:space='preserve'><![CDATA[for a limitless time; "no one can live forever"; "brightly beams our Father''s mercy from his lighthouse evermore"- P.P.Bliss]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400084909">
	<b:glossaryEntry>to infinity; without or seemingly without limit; "talked on and on ad infinitum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400085048">
	<b:glossaryEntry>for a long time without essential change; "he is permanently disabled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400085205">
	<b:glossaryEntry>for an indefinitely long time; "bequeathed to the nation in perpetuity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400085318">
	<b:glossaryEntry>for life; "desire happiness in perpetuity"; "an annuity paid in perpetuity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400085435">
	<b:glossaryEntry>for a limited time only; not permanently; "he will work here temporarily"; "he was brought out of retirement temporarily"; "a power failure temporarily darkened the town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400085681">
	<b:glossaryEntry>for an intervening time; temporarily; "elected to serve ad interim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400085787"
	 b:glossaryEntry='without advance preparation; "he spoke ad lib"'/>
<rdf:Description rdf:about="&a;400085909">
	<b:glossaryEntry>temporarily and conditionally; "they have agreed provisionally"; "was appointed provisionally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400086063">
	<b:glossaryEntry xml:space='preserve'><![CDATA[seemingly without interruption; "complained continually that there wasn''t enough money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400086208">
	<b:glossaryEntry>(informal) for a very long or seemingly endless time; "she took forever to write the paper"; "we had to wait forever and a day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400086391">
	<b:glossaryEntry>in a high position or level or rank; "details known by only a few highly placed persons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400086532">
	<b:glossaryEntry>favorably or with much respect; "He spoke highly of her"; "does not think highly of his writing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400086681">
	<b:glossaryEntry>to a high degree or extent; "highly successful play"; "highly informative"; "a highly educated woman"; "an extremely interesting book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400086880"
	 b:glossaryEntry='at a high rate or wage; "highly paid workers"'/>
<rdf:Description rdf:about="&a;400086960"
	 b:glossaryEntry='as if by magnetism; "he was magnetically attracted to her"'/>
<rdf:Description rdf:about="&a;400087077"
	 b:glossaryEntry='in a marginal manner; "marginally interesting"'/>
<rdf:Description rdf:about="&a;400087180"
	 b:glossaryEntry='in a linear fashion; "it grew linearly"'/>
<rdf:Description rdf:about="&a;400087292"
	 b:glossaryEntry='in a geometric fashion; "it grew geometrically"'/>
<rdf:Description rdf:about="&a;400087435">
	<b:glossaryEntry>in a dangerous manner; "he came dangerously close to falling off the ledge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400087631"
	 b:glossaryEntry='in a weary manner; "he walked around tiredly"'/>
<rdf:Description rdf:about="&a;400087758"
	 b:glossaryEntry='to a vital degree; "this is vitally important'/>
<rdf:Description rdf:about="&a;400087857"
	 b:glossaryEntry="in an energetic manner"/>
<rdf:Description rdf:about="&a;400087939">
	<b:glossaryEntry>in a strenuous manner; strongly or vigorously; "he objected strenuously to the stand his party was taking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400088103">
	<b:glossaryEntry>with strained or eager attention; "listened intently"; "stood watching intently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400088238">
	<b:glossaryEntry>(informal) heartily or earnestly; "They fell to work dingdong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400088337">
	<b:glossaryEntry>powerfully or vigorously; "he strove mightily to achieve a better position in life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400088457"
	 b:glossaryEntry="with reluctance"/>
<rdf:Description rdf:about="&a;400088530">
	<b:glossaryEntry>with effort or force or vigor; "the team played hard"; "worked hard all day"; "pressed hard on the lever"; "hit the ball hard"; "slammed the door hard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400088732">
	<b:glossaryEntry>to the full extent possible; all the way; "hard alee"; "the ship went hard astern"; "swung the wheel hard left"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400088876"
	 b:glossaryEntry='slowly and with difficulty; "prejudices die hard"'/>
<rdf:Description rdf:about="&a;400088976">
	<b:glossaryEntry xml:space='preserve'><![CDATA[causing great damage or hardship; "industries hit hard by the depression"; "she was severely affected by the bank''s failure"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400089162"
	 b:glossaryEntry='with firmness; "held hard to the railing"'/>
<rdf:Description rdf:about="&a;400089245">
	<b:glossaryEntry>earnestly or intently; "thought hard about it"; "stared hard at the accused"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400089354">
	<b:glossaryEntry>with pain or distress or bitterness; "he took the rejection very hard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400089457">
	<b:glossaryEntry xml:space='preserve'><![CDATA[very near or close in space or time; "it stands hard by the railroad tracks"; "they were hard on his heels"; "a strike followed hard upon the plant''s opening"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400089648">
	<b:glossaryEntry>into a solid condition; "concrete that sets hard within a few hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400089767"
	 b:glossaryEntry='securely fixed or fastened; "the window was tightly sealed"'/>
<rdf:Description rdf:about="&a;400089880">
	<b:glossaryEntry>for a short time; "she visited him briefly"; "was briefly associated with IBM"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400090012">
	<b:glossaryEntry>for an instant or moment; "we paused momentarily before proceeding"; "a cardinal perched momently on the dogwood branch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400090183"
	 b:glossaryEntry='in a conclusive way; "we settled the problem conclusively"'/>
<rdf:Description rdf:about="&a;400090337"
	 b:glossaryEntry='not conclusively; "the meeting ended inconclusively"'/>
<rdf:Description rdf:about="&a;400090468">
	<b:glossaryEntry>in an unfortunate or deplorable manner; "he was sadly neglected"; "it was woefully inadequate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400090705">
	<b:glossaryEntry>with respect to denomination; "denominationally diverse audiences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400090834"
	 b:glossaryEntry='with respect to the cortex; "cortically induced arousal"'/>
<rdf:Description rdf:about="&a;400090947"
	 b:glossaryEntry='in a focal manner; "the submucosa was focally infiltrated"'/>
<rdf:Description rdf:about="&a;400091059">
	<b:glossaryEntry>with respect to the hypothalamus; "hypothalamically controlled secretions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400091196"
	 b:glossaryEntry="into the skin"/>
<rdf:Description rdf:about="&a;400091269">
	<b:glossaryEntry>in an intramuscular way; "administer the drug intramuscularly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400091393">
	<b:glossaryEntry>in an entertaining and amusing manner; "Hollywood has grown too sophisticated to turn out anything really amusingly bad these days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400091612"
	 b:glossaryEntry='on a floor below; "the tenants live downstairs"'/>
<rdf:Description rdf:about="&a;400091761"
	 b:glossaryEntry='on a floor above; "they lived upstairs"'/>
<rdf:Description rdf:about="&a;400091891">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with respect to the mind; "she''s a bit weak upstairs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400092009"
	 b:glossaryEntry='against the current; "he swam upstream"'/>
<rdf:Description rdf:about="&a;400092085"
	 b:glossaryEntry='in the direction the wind is blowing; "they flew downwind"'/>
<rdf:Description rdf:about="&a;400092214">
	<b:glossaryEntry>in the direction opposite to the direction the wind is blowing; "they flew upwind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400092384"
	 b:glossaryEntry='away from the wind; "they were sailing windward"'/>
<rdf:Description rdf:about="&a;400092516"
	 b:glossaryEntry='toward the wind; "they were sailing leeward"'/>
<rdf:Description rdf:about="&a;400092641">
	<b:glossaryEntry xml:space='preserve'><![CDATA[spatially or metaphorically from a higher to a lower level or position; "don''t fall down"; "rode the lift up and skied down"; "prices plunged downward"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400092933">
	<b:glossaryEntry>away from a more central or a more northerly place; "was sent down to work at the regional office"; "worked down on the farm"; "came down for the wedding"; "flew down to Flordia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400093162">
	<b:glossaryEntry>paid in cash at time of purchase; "put ten dollars down on the necklace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400093267">
	<b:glossaryEntry>in an inactive or inoperative state; "the factory went down during the strike"; "the computer went down again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400093410">
	<b:glossaryEntry>to a lower intensity; "he slowly phased down the light until the stage was completely black"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400093553">
	<b:glossaryEntry>from an earlier time; "the story was passed down from father to son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400093654">
	<b:glossaryEntry>spatially or metaphorically from a lower to a higher position; "look up!"; "the music surged up"; "the fragments flew upwards"; "prices soared upwards"; "upwardly mobile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400093957">
	<b:glossaryEntry>to a later time; "they moved the meeting date up"; "from childhood upward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400094081">
	<b:glossaryEntry>to a more central or a more northerly place; "was transferred up to headquarters"; "up to Canada for a vacation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400094242"
	 b:glossaryEntry='nearer to the speaker; "he walked up and grabbed my lapels"'/>
<rdf:Description rdf:about="&a;400094332"
	 b:glossaryEntry='to a higher intensity; "he turned up the volume"'/>
<rdf:Description rdf:about="&a;400094429"
	 b:glossaryEntry="toward the source or against the current"/>
<rdf:Description rdf:about="&a;400094552"
	 b:glossaryEntry="away from the source or with the current"/>
<rdf:Description rdf:about="&a;400094679">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sports) toward or in the defending team''s end of the playing field; "he caught the ball and ran downfield 15 yards"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400094833"
	 b:glossaryEntry='(intensifier) thoroughgoing; "he is outright dishonest"'/>
<rdf:Description rdf:about="&a;400094926">
	<b:glossaryEntry>without reservation or concealment; "she asked him outright for a divorce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400095037">
	<b:glossaryEntry>without restrictions or stipulations or further payments; "buy outright"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400095146">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at or to or in the direction of one''s home or family; "He stays home on weekends"; "after the game the children brought friends home for supper"; "I''ll be home tomorrow"; "came riding home in style"; "I hope you will come home for Christmas"; "I''ll take her home"; "don''t forget to write home"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400095472">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(in sports) on the home team''s field; "they played at home last night"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400095578">
	<b:glossaryEntry>to the fullest extent; to the heart; "drove the nail home"; "drove his point home"; "his comments hit home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400095718"
	 b:glossaryEntry='on or to the point aimed at; "the arrow struck home"'/>
<rdf:Description rdf:about="&a;400095803"
	 b:glossaryEntry='toward home; "fought his way homeward through the deep snow"'/>
<rdf:Description rdf:about="&a;400095912">
	<b:glossaryEntry xml:space='preserve'><![CDATA[on the contrary; "rather than disappoint the children, he did two quick tricks before he left"; "he didn''t call; rather (or instead), he wrote her a letter"; "used English terms instead of Latin ones"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400096157">
	<b:glossaryEntry>to the degree or extent; "insofar as it can be ascertained, the horse lung is comparable to that of man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400096343">
	<b:glossaryEntry>used to form the comparative of some adjectives and adverbs; "more interesting"; "more beautiful"; "more quickly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400096529">
	<b:glossaryEntry>used to form the comparative of some adjectives and adverbs; "less interesting"; "less expensive"; "less quickly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400096714">
	<b:glossaryEntry>comparative of much; to a greater degree or extent; "he works more now"; "they eat more than they should"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400096870">
	<b:glossaryEntry>comparative of little; "she walks less than she should"; "he works less these days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400097004"
	 b:glossaryEntry='not much; "he talked little about his family"'/>
<rdf:Description rdf:about="&a;400097084">
	<b:glossaryEntry>before the usual time or the time expected; "she graduated early"; "the house was completed ahead of time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400097269">
	<b:glossaryEntry>later than usual or than expected; "the train arrived late"; "we awoke late"; "the children came late to school"; "notice came so tardily that we almost missed the deadline"; "I belatedly wished her a happy birthday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400097594"
	 b:glossaryEntry='in good time; "he awoke betimes that morning"'/>
<rdf:Description rdf:about="&a;400097683"
	 b:glossaryEntry='during an early stage; "early on in her career"'/>
<rdf:Description rdf:about="&a;400097775">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as far as that is concerned; "for that matter I don''t care either"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400097885">
	<b:glossaryEntry>(old-fashioned) at or from or to a great distance; far; "we traveled afar"; "we could see the ship afar off"; "the Magi came from afar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400098053">
	<b:glossaryEntry>at or to or from a great distance in space; "he traveled far"; "strayed far from home"; "sat far away from each other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400098203">
	<b:glossaryEntry>remote in time; "if we could see far into the future"; "all that happened far in the past"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400098325">
	<b:glossaryEntry>to a considerable degree; very much; "a far far better thing that I do"; "felt far worse than yesterday"; "eyes far too close together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400098492">
	<b:glossaryEntry>at or to a certain point or degree; "I can only go so far before I have to give up"; "how far can we get with this kind of argument?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400098657">
	<b:glossaryEntry>to an advanced stage or point; "a young man who will go very far"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400098754">
	<b:glossaryEntry>(informal) to a great degree or by a great distance; very much; "way over budget"; "way off base"; "right smart" is regional (US S and Midland) as in "the other side of the hill is right smart steeper than the side we are on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400099025">
	<b:glossaryEntry>over great areas or distances; everywhere; "he traveled far and wide"; "the news spread far and wide"; "people came from far and near"; "searched for the child far and near"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400099254">
	<b:glossaryEntry>in a delicate manner; "finely shaped features"; "her fine drawn body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400099428"
	 b:glossaryEntry='in an elegant manner; "finely costumed actors"'/>
<rdf:Description rdf:about="&a;400099527">
	<b:glossaryEntry>before anything else; "first we must consider the garter snake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400099672"
	 b:glossaryEntry='in the second place; "second, we must consider the economy"'/>
<rdf:Description rdf:about="&a;400099777"
	 b:glossaryEntry='in the third place; "third we must consider unemployment"'/>
<rdf:Description rdf:about="&a;400099878"
	 b:glossaryEntry="from first to last"/>
<rdf:Description rdf:about="&a;400099935">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at the beginning; "at first he didn''t notice anything strange"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400100073"
	 b:glossaryEntry='immediately; "it was love at first sight"'/>
<rdf:Description rdf:about="&a;400100175">
	<b:glossaryEntry>as a first impression; "at first blush the offer seemed attractive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400100303"
	 b:glossaryEntry='the initial time; "when Felix first saw a garter snake"'/>
<rdf:Description rdf:about="&a;400100414"
	 b:glossaryEntry="continuing in the same way"/>
<rdf:Description rdf:about="&a;400100511">
	<b:glossaryEntry>out into view; "came forth from the crowd"; "put my ideas forth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400100609">
	<b:glossaryEntry>forward in time or order or degree; "from that time forth"; "from the sixth century onward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400100753">
	<b:glossaryEntry>to or in a foreign country; "they had never travelled abroad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400100849"
	 b:glossaryEntry='in reality; "she is very kind at heart"'/>
<rdf:Description rdf:about="&a;400100983"
	 b:glossaryEntry='in a general fashion; "he talked at large about his plans"'/>
<rdf:Description rdf:about="&a;400101095">
	<b:glossaryEntry>not less than; "at least two hours studying the manual"; "a tumor at least as big as an orange"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400101278"
	 b:glossaryEntry='not more than; "spend at most $20 on the lunch"'/>
<rdf:Description rdf:about="&a;400101411">
	<b:glossaryEntry xml:space='preserve'><![CDATA[if nothing else; "at least he survived"; "they felt--at any rate Jim felt--relieved though still wary"; "the influence of economists--or at any rate of economics--is far-reaching"; (`leastwise'' is informal; `leastways'' is colloquial)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400101719">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an unhurried way or at one''s convenience; "read the manual at your leisure"; "he traveled leisurely"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400101891"
	 b:glossaryEntry='immediately; "she called right after dinner"'/>
<rdf:Description rdf:about="&a;400101969">
	<b:glossaryEntry>at a particular time in the past; "just then the bugle sounded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400102070"
	 b:glossaryEntry='in a punctual manner; "he did his homework promptly"'/>
<rdf:Description rdf:about="&a;400102202">
	<b:glossaryEntry>at once (usually modifies an undesirable occurrence); "he promptly forgot the address"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400102338">
	<b:glossaryEntry>with little or no delay; "the rescue squad arrived promptly"; "come here, quick!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400102510">
	<b:glossaryEntry xml:space='preserve'><![CDATA[under the best of conditions; "at best we''ll lose only the money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400102643">
	<b:glossaryEntry xml:space='preserve'><![CDATA[under the worst of conditions; "at worst we''ll go to jail"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400102771">
	<b:glossaryEntry>in an uncontrolled manner; "they searched frantically for their child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400102899"
	 b:glossaryEntry="in a very agitated manner; as if possessed by an evil spirit"/>
<rdf:Description rdf:about="&a;400103051">
	<b:glossaryEntry>in a furtive manner; "the soldiers were furtively crawling through the night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400103197">
	<b:glossaryEntry>of one mind; without dissent; "the Senate unanimously approved the bill"; "we voted unanimusly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400103383"
	 b:glossaryEntry='in a responsible manner; "we must act responsibly"'/>
<rdf:Description rdf:about="&a;400103509"
	 b:glossaryEntry='in an irresponsible manner; "he acted irresponsibly"'/>
<rdf:Description rdf:about="&a;400103672"
	 b:glossaryEntry='in a fair evenhanded manner; "deal fairly with one another"'/>
<rdf:Description rdf:about="&a;400103835"
	 b:glossaryEntry='under normal conditions; "usually she was late"'/>
<rdf:Description rdf:about="&a;400104058"
	 b:glossaryEntry='in the usual manner; "as usual, she arrived late"'/>
<rdf:Description rdf:about="&a;400104160"
	 b:glossaryEntry='to a remarkably degree or extent; "she was unusually tall"'/>
<rdf:Description rdf:about="&a;400104346">
	<b:glossaryEntry>in the recent past; "he was in Paris recently"; "lately the rules have been enforced"; "as late as yesterday she was fine"; "feeling better of late"; "the spelling was first affected, but latterly the meaning also"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400104652">
	<b:glossaryEntry>in an erratic unpredictable manner; "economic changes are proceeding erratically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400104825">
	<b:glossaryEntry>in a dominant fashion; "religion functions dominantly in many societies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400104954"
	 b:glossaryEntry='like a girl; "she was girlishly shy"'/>
<rdf:Description rdf:about="&a;400105046">
	<b:glossaryEntry>in a gradual manner; "the snake moved gradually toward its victim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400105196"
	 b:glossaryEntry='in a grim implacable manner; "he was grimly satisfied"'/>
<rdf:Description rdf:about="&a;400105303">
	<b:glossaryEntry>in this general vicinity; "the people are friendly hereabouts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400105416">
	<b:glossaryEntry>in or at this place; where the speaker or writer is; "I work here"; "turn here"; "radio waves received here on Earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400105584">
	<b:glossaryEntry>to this place (especially toward the speaker); "come here, please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400105710">
	<b:glossaryEntry>in this circumstance or respect or on this point or detail; "what do we have here?"; "here I must disagree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400105850">
	<b:glossaryEntry>in this place or thing or document; "I shall discuss the question herein"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400105958">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at this time; now; "we''ll adjourn here for lunch and discuss the remaining issues this afternoon"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400106088">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in or at that place; "they have lived there for years"; "it''s not there"; "that man <who is> there"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400106274">
	<b:glossaryEntry>to or toward that place; away from the speaker; "go there around noon!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400106407"
	 b:glossaryEntry='in that matter; "I agree with you there"'/>
<rdf:Description rdf:about="&a;400106515"
	 b:glossaryEntry='with respect to history; "this is historically interesting"'/>
<rdf:Description rdf:about="&a;400106633">
	<b:glossaryEntry>throughout history; "historically they have never co-existed peacefully"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400106764">
	<b:glossaryEntry>in a peaceful manner; "the hen settled herself on the nest most peacefully"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400106878">
	<b:glossaryEntry>with respect to science; in a scientific way; "this is scientifically interesting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400107021">
	<b:glossaryEntry>in un unscientific way; not according to the principles of science; "they proceeded unscientifically when they dissected the mummy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400107215"
	 b:glossaryEntry='to what extent or amount or degree; "how tall is she?"'/>
<rdf:Description rdf:about="&a;400107301"
	 b:glossaryEntry="how much"/>
<rdf:Description rdf:about="&a;400107369">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in what way or manner or by what means; "how did you catch the snake?"; "he told us how he did it"; (`however'' is used as an intensive of `how'' as in "however did you get here so soon?")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400107597">
	<b:glossaryEntry xml:space='preserve'><![CDATA[question word; what is the reason; "why are you here?"; (`how come'' is a nonstandard variant as in "how come he got an ice cream cone but I didn''t?")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400107789"
	 b:glossaryEntry='in a humble manner; "he humbly lowered his head"'/>
<rdf:Description rdf:about="&a;400107917">
	<b:glossaryEntry>in a submissive or spiritless manner; "meekly bowed to his wishes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400108036"
	 b:glossaryEntry='within a building; "in winter we play inside"'/>
<rdf:Description rdf:about="&a;400108162"
	 b:glossaryEntry='outside a building; "in summer we play outside"'/>
<rdf:Description rdf:about="&a;400108318"
	 b:glossaryEntry='on the inside; "inside, the car is a mess"'/>
<rdf:Description rdf:about="&a;400108422"
	 b:glossaryEntry='on the outside; "outside, the box is black"'/>
<rdf:Description rdf:about="&a;400108519">
	<b:glossaryEntry>with respect to the military; "on a militarily significant scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400108641">
	<b:glossaryEntry>without using a microscope; "The tubes were examined macroscopically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400108772">
	<b:glossaryEntry>(intensifier before a figurative expression) without exaggeration; "our eyes were literally pinned to TV during the Gulf war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400108947">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in essence or effect but not in fact; "the strike virtually paralyzed the city"; "I''m virtually broke"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400109105">
	<b:glossaryEntry>used to form the superlative; "the king cobra is the most dangerous snake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400109254">
	<b:glossaryEntry>used to form the superlative; "The garter snake is the least dangerous snake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400109406"
	 b:glossaryEntry='especially not; "nobody, least of all Joe, agreed with me"'/>
<rdf:Description rdf:about="&a;400109505"
	 b:glossaryEntry='(intensifier) very; "a most welcome relief"'/>
<rdf:Description rdf:about="&a;400109581"
	 b:glossaryEntry='without speaking; "he sat mutely next to her"'/>
<rdf:Description rdf:about="&a;400109770"
	 b:glossaryEntry='throughout the world; "She is internationally known"'/>
<rdf:Description rdf:about="&a;400109884">
	<b:glossaryEntry>in such a manner as could not be otherwise; "it is necessarily so"; "we must needs by objective"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400110092">
	<b:glossaryEntry>very recently; "they are newly married"; "newly raised objections"; "a newly arranged hairdo"; "grass new washed by the rain"; "a freshly cleaned floor"; "we are fresh out of tomatoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400110345">
	<b:glossaryEntry>again but in a new or different way; "start afresh"; "wanted to write the story anew"; "starting life anew in a fresh place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400110511">
	<b:glossaryEntry>in another and different manner; "very soon you will know differently"; "she thought otherwise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400110676"
	 b:glossaryEntry='involving carbon compounds; "organically bound iodone"'/>
<rdf:Description rdf:about="&a;400110806">
	<b:glossaryEntry>not involving carbon compounds; "inorganically bound molecules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400110947">
	<b:glossaryEntry>as an important constituent; "the drapery served organically to cover the Madonna"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400111087"
	 b:glossaryEntry='in an organic manner; "this food is grown organically"'/>
<rdf:Description rdf:about="&a;400111199">
	<b:glossaryEntry>in an invariable manner; "invariably, he would forget his keys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400111319"
	 b:glossaryEntry="without fail"/>
<rdf:Description rdf:about="&a;400111389">
	<b:glossaryEntry>in a machine-like manner; without feeling; "he smiled mechanically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400111515">
	<b:glossaryEntry>in a mechanical manner; by a mechanism; "this door opens mechanically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400111678">
	<b:glossaryEntry>in an official role; "officially, he is in charge"; "officially responsible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400111829">
	<b:glossaryEntry>not in an official capacity; "unofficially, he serves as the treasurer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400111977"
	 b:glossaryEntry='unpleasantly; "his ignorance was painfully obvious"'/>
<rdf:Description rdf:about="&a;400112118">
	<b:glossaryEntry>in or near or toward a center or according to a central role or function; "The theater is centrally located"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400112300">
	<b:glossaryEntry>in or at or near a periphery or according to a peripheral role or function or relationship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400112467">
	<b:glossaryEntry>with regard to phylogeny; "a phylogenetically primitive part of the brain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400112604"
	 b:glossaryEntry='in accord with physical laws; "it is physically impossible"'/>
<rdf:Description rdf:about="&a;400112720">
	<b:glossaryEntry>of or relating to physiological processes; with respect to physiology; "physiologically ready"; "physiologically addicted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400112904">
	<b:glossaryEntry xml:space='preserve'><![CDATA[more readily or willingly; "clean it well, preferably with warm water"; "I''d rather be in Philadelphia"; "I''d sooner die than give up"]]></b:glossaryEntry>
</rdf:Description>
