	 b:glossaryEntry="deliver to the wrong address"/>
<rdf:Description rdf:about="&a;200986223">
	<b:glossaryEntry>serve somebody with a warrant or summons; "He was processed by the sheriff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200986409">
	<b:glossaryEntry>cause to come into a particular state or condition: "Long hard years of on the job training had brought them to their competence"; "bring water to the boiling point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200986697">
