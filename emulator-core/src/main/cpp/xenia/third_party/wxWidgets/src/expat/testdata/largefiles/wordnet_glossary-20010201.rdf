<rdf:Description rdf:about="&a;101661806"
	 b:glossaryEntry="foot adapted for digging as in moles"/>
<rdf:Description rdf:about="&a;101661903"
	 b:glossaryEntry="a burrowing mammal having limbs adapted for digging"/>
<rdf:Description rdf:about="&a;101662053"
	 b:glossaryEntry="the horny end of the foot in hoofed animals"/>
