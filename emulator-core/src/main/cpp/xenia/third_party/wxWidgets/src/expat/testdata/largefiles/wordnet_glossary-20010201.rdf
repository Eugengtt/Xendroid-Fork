<rdf:Description rdf:about="&a;400277096"
	 b:glossaryEntry='unpredictably; "the weather has been freakishly varible"'/>
<rdf:Description rdf:about="&a;400277242"
	 b:glossaryEntry='in a captious, carping manner; "he was captiously pedantic"'/>
<rdf:Description rdf:about="&a;400277358">
	<b:glossaryEntry>in a gentle or caressing manner; "His voice was caressingly sweet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400277483">
	<b:glossaryEntry>in a caustic vitriolic manner; "he addressed her caustically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400277636">
