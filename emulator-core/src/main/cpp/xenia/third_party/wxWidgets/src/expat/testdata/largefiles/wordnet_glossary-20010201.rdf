	 b:glossaryEntry="the informed analysis and evaluation of literature"/>
<rdf:Description rdf:about="&a;104685770"
	 b:glossaryEntry="study of poetic works"/>
<rdf:Description rdf:about="&a;104685863"
	 b:glossaryEntry="the study of poetic meter and the art of versification"/>
<rdf:Description rdf:about="&a;104685971"
	 b:glossaryEntry="study of the literary works of ancient Greece and Rome"/>
<rdf:Description rdf:about="&a;104686080">
	<b:glossaryEntry>study of the technique and rules for using language effectively (especially in public speaking)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104686230">
	<b:glossaryEntry>the study of the principles and practices of library administration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104686359"
	 b:glossaryEntry="the humanistic study of language and literature"/>
<rdf:Description rdf:about="&a;104686476"
	 b:glossaryEntry="the study of Chinese history and language and culture"/>
<rdf:Description rdf:about="&a;104686584"
	 b:glossaryEntry="the scientific study of language"/>
<rdf:Description rdf:about="&a;104686855"
	 b:glossaryEntry="studies of the formation of basic linguistic units"/>
<rdf:Description rdf:about="&a;104686995"
	 b:glossaryEntry="the grammatical arrangement of words in sentences"/>
<rdf:Description rdf:about="&a;104687137"
	 b:glossaryEntry="studies of the rules for forming admissible sentences"/>
<rdf:Description rdf:about="&a;104687243">
	<b:glossaryEntry>the branch of acoustics concerned with speech processes including its production and perception and acoustic analysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104687416">
	<b:glossaryEntry>the study of the sound system of a given language and the analysis and classification of its phonemes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104687585"
	 b:glossaryEntry="the admissible arrangement of sounds in words"/>
<rdf:Description rdf:about="&a;104687761"
	 b:glossaryEntry="the result of adding an affix to a root word"/>
<rdf:Description rdf:about="&a;104687862"
	 b:glossaryEntry="studies of the rules for forming admissible words"/>
<rdf:Description rdf:about="&a;104688022"
	 b:glossaryEntry="the part of grammar that deals with the inflections of words"/>
<rdf:Description rdf:about="&a;104688164"
	 b:glossaryEntry="the part of grammar that deals with the derivations of words"/>
<rdf:Description rdf:about="&a;104688294">
	<b:glossaryEntry>the part of grammar that deals with combinations of simple words into compound words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104688444">
	<b:glossaryEntry>the study of the phonological realization of the allomorphs of the morphemes of a language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104688596"
	 b:glossaryEntry="the study of language use"/>
<rdf:Description rdf:about="&a;104688678">
	<b:glossaryEntry>the branch of linguistics that studies the lexical component of language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104688825">
	<b:glossaryEntry>the branch of lexicology that studies the origins and history of proper names</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104688959"
	 b:glossaryEntry="the study of the sources and development of words"/>
<rdf:Description rdf:about="&a;104689082">
	<b:glossaryEntry>a statistical technique used in glottochronology; used to estimate how long ago different languages evolved from a common source language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104689282"
	 b:glossaryEntry="the study of language meaning"/>
<rdf:Description rdf:about="&a;104689385">
	<b:glossaryEntry>the function of pointing or specifying from the perspective of a participant in an act of speech or writing; aspects of a communication whose interpretation depends on knowledge of the context in which the communication occurs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104689664"
	 b:glossaryEntry="the study of linguistic change"/>
<rdf:Description rdf:about="&a;104689782"
	 b:glossaryEntry="a law describing sound changes in the history of a language"/>
<rdf:Description rdf:about="&a;104689952">
	<b:glossaryEntry>a sound law relating German consonants and consonants in other Indo-European languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104690096"
	 b:glossaryEntry="a qualification of Grimm''s law"/>
<rdf:Description rdf:about="&a;104690185">
	<b:glossaryEntry>an explanation of a person''s mastery of their native language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104690395">
	<b:glossaryEntry>the study of the geographical distribution of linguistic features</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104690547">
	<b:glossaryEntry>the study of language in relation to its sociocultural context</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104690672">
	<b:glossaryEntry>the rational and systematic study of religion and its influences and of the nature of religious truth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104690911">
	<b:glossaryEntry>the branch of theology that is concerned with the defense of Christian doctrines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104691049">
	<b:glossaryEntry>the branch of theology that is concerned with such final things as death and judgment; heaven and hell; the end of the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104691231">
	<b:glossaryEntry>the branch of theology that deals with principles of exegesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104691351"
	 b:glossaryEntry="the branch of theology that deals with sermons and homilies"/>
<rdf:Description rdf:about="&a;104691467">
	<b:glossaryEntry>a particular system or school of religious beliefs and teachings; "Jewish theology"; "Roman Catholic theology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104691689">
	<b:glossaryEntry>a theology that holds that knowledge of God can be acquired by human reason without the aid of divine revelation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104691864"
	 b:glossaryEntry="the teachings of Christian churches"/>
<rdf:Description rdf:about="&a;104692001">
	<b:glossaryEntry>the theology or the practices of the Jesuits (often considered to be casuistic)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104692147">
	<b:glossaryEntry>a doctrine that is taught; "the teaching of religion"; "he believed all the Christian precepts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104692325"
	 b:glossaryEntry="the doctrine of a religious group"/>
<rdf:Description rdf:about="&a;104692803">
	<b:glossaryEntry>the theological doctrine that by faith and God''s grace a Christian is freed from all laws (including the moral standards of the culture)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104692999">
	<b:glossaryEntry>the comprehensive theological doctrine created by Saint Thomas Aquinas in the 13th century and still taught by the Dominicans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104693178">
	<b:glossaryEntry>doctrine that the useful is the good especially as elaborated by Jeremy Bentham and James Mill the aim being the greatest happiness for of greatest number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104693393">
	<b:glossaryEntry>the theological doctrine taught by Arius that Christ the Son was not consubstantial with God the Father</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104693569">
	<b:glossaryEntry>the theological doctrine taught by Athanasius that Christ the Son is of the same substance as God the Father</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104693755">
	<b:glossaryEntry>the mystical theological doctrine of Jakob Boehme that influenced the Quakers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104693901">
	<b:glossaryEntry>the High-Church Anglican doctrine that after the consecration of the Eucharist the substance of the body and blood of Christ coexists with the substance of the consecrated bread and wine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104694151"
	 b:glossaryEntry="the theological doctrine of Church government by bishops"/>
<rdf:Description rdf:about="&a;104694269">
	<b:glossaryEntry>the doctrine that the state is supreme over the church in ecclesiastical matters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104694437">
	<b:glossaryEntry>the Roman Catholic doctrine of Cornelis Jansen and his disciples; salvation is limited to those who are subject to supernatural determinism and the rest are assigned to perdition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104694671">
	<b:glossaryEntry>belief in the Christian doctrine of the millennium mentioned in the Book of Revelations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104694819"
	 b:glossaryEntry="the theological beliefs of the Society of Friends"/>
<rdf:Description rdf:about="&a;104694924">
	<b:glossaryEntry>the theological doctrine that human reason rather than divine revelation establishes religious truth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104695100">
	<b:glossaryEntry>the theological doctrine that venerates the rose and the Cross as symbols of Christ''s Resurrection and Redemption; claims various occult powers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104695304">
	<b:glossaryEntry>the theological doctrine that salvation results from the interaction of human will and divine grace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104695459">
	<b:glossaryEntry>the Calvinist doctrine that everyone is born in a state of corruption as a result of original sin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104695618">
	<b:glossaryEntry>any system of philosophy emphasizing the intuitive and spiritual above the empirical and material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104695807">
	<b:glossaryEntry>the Roman Catholic doctrine that the whole substance of the bread and the wine changes into the substance of the body and blood of Christ when consecrated in the Eucharist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104696043">
	<b:glossaryEntry>the theological doctrine that all people will eventually be saved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104696167">
	<b:glossaryEntry>the theological doctrine that Jesus Christ had no human father; Christians believe that Jesus''s birth fulfilled Old Testament prophecies and was attended by miracles; the Nativity is celebrated at Christmas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104696462">
	<b:glossaryEntry>a complex mental orientation involving beliefs and feelings and values and dispositions to act in certain ways; "he had the attitude that work was fun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104696956">
	<b:glossaryEntry>the mental attitude that something is believable and should be accepted as true; "he gave credence to the gossip"; "acceptance of Newtonian mechanics was unquestioned for 200 years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104697205">
	<b:glossaryEntry>an attitude of defense; especially in the phrase "on the defensive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104697349">
	<b:glossaryEntry>a no-nonsense attitude in business or politics; "they play hardball in the Senate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104697486">
	<b:glossaryEntry>a attitude characteristic of Southerners (especially in the US)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104697607"
	 b:glossaryEntry="a habitual or characteristic mental attitude"/>
<rdf:Description rdf:about="&a;104697717">
	<b:glossaryEntry>the attitude (of a person or a government) that subordinates should be controlled in a fatherly way for their own good</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104697893"
	 b:glossaryEntry="a rationalized mental attitude"/>
<rdf:Description rdf:about="&a;104697988">
	<b:glossaryEntry>an attitude of mind especially one that favors one alternative over others; "he had an inclination to give up too easily"; "a tendency to be too strict"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104698475">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a general course along which something has a tendency to develop; "I couldn''t follow the direction of his thoughts"; "his ideals determined the direction of his career"; "they proposed a new direction for the firm"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104698745">
	<b:glossaryEntry>a general tendency as of opinion: "not openly liberal but that is the tendency of the book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104698896">
	<b:glossaryEntry>a special disposition (as if from a divine source) to pursue a particular course; "he was disappointed that he had not heard the Call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104699081">
	<b:glossaryEntry>an inclination or desire; used in the plural in the phrase "left to your own devices"; "the children were left to their own devices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104699267">
	<b:glossaryEntry>an inclination to support or be loyal to or to agree with an opinion; "his sympathies were always with the underdog"; "I knew I could count on his understanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104699499"
	 b:glossaryEntry="an inclination to favor some person or group"/>
<rdf:Description rdf:about="&a;104699614">
	<b:glossaryEntry>a natural inclination; "he has a proclivity for exaggeration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104699755">
	<b:glossaryEntry>a relatively permanent inclination to react in a particular way; "the set of his mind was obvious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104699910"
	 b:glossaryEntry="a disposition to interpret statements in their literal sense"/>
<rdf:Description rdf:about="&a;104700027">
	<b:glossaryEntry>an inclination beforehand to interpret statements in a particular way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104700175"
	 b:glossaryEntry="a predisposition in favor of something"/>
<rdf:Description rdf:about="&a;104700285">
	<b:glossaryEntry>an inclination to approve; "that style is in favor this season"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104700409">
	<b:glossaryEntry>an inclination to withhold approval from some person or group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104700597"
	 b:glossaryEntry='an informal term for disfavor; "he is in the doghouse"'/>
<rdf:Description rdf:about="&a;104700706"
	 b:glossaryEntry="severe disapproval"/>
<rdf:Description rdf:about="&a;104700782">
	<b:glossaryEntry>an inclination to favor one group or view or opinion over alternatives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104701050">
	<b:glossaryEntry>an inclination to evaluate reality exclusively in terms of human values</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104701205"
	 b:glossaryEntry="belief in the superiority of one''s own ethnic group"/>
<rdf:Description rdf:about="&a;104701316">
	<b:glossaryEntry>a partiality that prevents objective consideration of an issue or situation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104701508">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a slight but noticeable partiality; "the court''s tilt toward conservative rulings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104701641"
	 b:glossaryEntry="an intentional and controversial bias"/>
<rdf:Description rdf:about="&a;104701740"
	 b:glossaryEntry="a partiality for some particular place"/>
<rdf:Description rdf:about="&a;104701864"
	 b:glossaryEntry="partiality that is not fair or equitable"/>
<rdf:Description rdf:about="&a;104701990"
	 b:glossaryEntry="an inclination to weigh both views or opinions equally"/>
<rdf:Description rdf:about="&a;104702175"
	 b:glossaryEntry="freedom from bias or selfish motives"/>
<rdf:Description rdf:about="&a;104702275">
	<b:glossaryEntry>ability to make judgments free from discrimination or dishonesty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104702449">
	<b:glossaryEntry>prejudice against (fear or dislike of) homosexual people and homosexuality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104702580">
	<b:glossaryEntry>the prejudice that members of one race are intrinsically superior to members of other races</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104702760"
	 b:glossaryEntry="the intense dislike for and prejudice against Jewish people"/>
<rdf:Description rdf:about="&a;104702879">
	<b:glossaryEntry>the prejudice that members of the white race are superior to members of other races</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104703024">
	<b:glossaryEntry>willingness to recognize and respect the beliefs or practices of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104703223">
	<b:glossaryEntry>an inclination to tolerate or overlook opposing or shocking opinions or behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104703384"
	 b:glossaryEntry="an inclination to favor progress and individual freedom"/>
<rdf:Description rdf:about="&a;104703510"
	 b:glossaryEntry="tolerance attributable to a lack of involvement"/>
<rdf:Description rdf:about="&a;104703628">
	<b:glossaryEntry>unwillingness to recognize and respect differences in opinions or beliefs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104703831">
	<b:glossaryEntry>an inclination to criticize opposing opinions or chocking behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104704051">
	<b:glossaryEntry>a limitation of views or interests like that defined by a local parish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104704180"
	 b:glossaryEntry="narrowness of mind or ideas or views"/>
<rdf:Description rdf:about="&a;104704272"
	 b:glossaryEntry="a lack of sophistication"/>
<rdf:Description rdf:about="&a;104704356">
	<b:glossaryEntry>a narrow-minded adherence to a particular sect or party or denomination; "he condemned religious sectarianism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104704545"
	 b:glossaryEntry="the intolerance and prejudice of a bigot"/>
<rdf:Description rdf:about="&a;104704651"
	 b:glossaryEntry="excessive intolerance of opposing views"/>
<rdf:Description rdf:about="&a;104704758">
	<b:glossaryEntry>an attitude of admiration or esteem; "she lost all respect for him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104704933">
	<b:glossaryEntry>the respect with which a person is held; "they had a high estimation of his ability"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104705103">
	<b:glossaryEntry>the general estimation that the public has for a person; "he acquired a reputation as an actor before he started writing"; "he was a person of bad report"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104705323"
	 b:glossaryEntry="a disrespectful mental attitude"/>
<rdf:Description rdf:about="&a;104705429"
	 b:glossaryEntry="a reverent mental attitude"/>
<rdf:Description rdf:about="&a;104705529"
	 b:glossaryEntry="an irreverent mental attitude"/>
<rdf:Description rdf:about="&a;104705652"
	 b:glossaryEntry="an attitude of irreverence or contempt for a divinity"/>
<rdf:Description rdf:about="&a;104705763"
	 b:glossaryEntry="an integrated set of attitudes and beliefs"/>
<rdf:Description rdf:about="&a;104706007">
	<b:glossaryEntry>a shared orientation leading to mutual understanding; "they are on the same wavelength"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104706151">
	<b:glossaryEntry>an orientation that favors experimentation and innovation; "the children of psycholoigsts are often raised in an atmosphere of experimentalism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104706356"
	 b:glossaryEntry="a new orientation; a changed set of attitudes and beliefs"/>
<rdf:Description rdf:about="&a;104706473">
	<b:glossaryEntry>a way of regarding situations or topics etc.; "consider what follows from the positivist view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104706751">
	<b:glossaryEntry>the position of greatest advancement; the leading position in any movement or field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104706916">
	<b:glossaryEntry>the generally accepted perspective of a particular discipline at a given time; "he framed the problem within the psychoanalytic paradigm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104707108">
	<b:glossaryEntry>a mental position from which things are viewed; "we should consider this problem from the viewpoint of the Russians"; "teaching history gave him a special point of view toward current events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104707410">
	<b:glossaryEntry>a particular perspective or aspect of a situation; "although he saw it in a different light, he still did not understand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104707583">
	<b:glossaryEntry>a range of mental vision; "in his sight she could do no wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104707697"
	 b:glossaryEntry="a biased way of looking at or presenting something"/>
<rdf:Description rdf:about="&a;104707807"
	 b:glossaryEntry="a comprehensive view of the world and human life"/>
<rdf:Description rdf:about="&a;104707947">
	<b:glossaryEntry>the view that the universe resembles a clock built by God and ticking along according to Newtonian mechanics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104708120"
	 b:glossaryEntry="a belief or orientation agreeing with conventional standards"/>
<rdf:Description rdf:about="&a;104708272"
	 b:glossaryEntry="orthodoxy in thoughts and belief"/>
<rdf:Description rdf:about="&a;104708428"
	 b:glossaryEntry="conformity with conventional thought and behavior"/>
<rdf:Description rdf:about="&a;104708539">
	<b:glossaryEntry>strict conformity to the letter of the law rather than its spirit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104708659">
	<b:glossaryEntry>any opinions or doctrines at variance with the official or orthodox position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104708869"
	 b:glossaryEntry="a lack of conformity"/>
<rdf:Description rdf:about="&a;104708984">
	<b:glossaryEntry>an orientation that characterizes the thinking of a group or nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104709707">
	<b:glossaryEntry>the principle of complete and unrestricted power in government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104709855"
	 b:glossaryEntry="a political theory favoring the abolition of governments"/>
<rdf:Description rdf:about="&a;104709967">
	<b:glossaryEntry>a political theory favoring unlimited authority by a single individual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104710111">
	<b:glossaryEntry>the political doctrine of Machiavelli: any means (however unscrupulous) can be used by a ruler in order to create and maintain his autocratic government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104710326"
	 b:glossaryEntry="the belief in government by divine guidance"/>
<rdf:Description rdf:about="&a;104710425">
	<b:glossaryEntry>a political theory that the people should own the means of production</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104710553">
	<b:glossaryEntry>a political theory favoring collectivism in a classless society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104710672">
	<b:glossaryEntry>a political orientation advocating the preservation of the best in society and opposing radical changes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104710852">
	<b:glossaryEntry>extreme conservatism in political or social matters; "the forces of reaction carried the election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711005">
	<b:glossaryEntry>advocacy of a system of government according to constitutional principles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711142">
	<b:glossaryEntry>the political orientation of those who favor government by the people of by their elected representatives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711303">
	<b:glossaryEntry>the belief in a gradual transition from capitalism to socialism by democratic means</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711449">
	<b:glossaryEntry>the attitude that society should be governed by an elite group of individuals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711580">
	<b:glossaryEntry>any political theory favoring immoderate uncompromising policies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711700">
	<b:glossaryEntry>a political theory advocating an authoritarian hierarchical government (as opposed to democracy or liberalism)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711864">
	<b:glossaryEntry>the idea of a federal organization of more or less self-governing units</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104711992"
	 b:glossaryEntry="a political orientation that advocates imperial interests"/>
<rdf:Description rdf:about="&a;104712107"
	 b:glossaryEntry="a political orientation that favors progress and reform"/>
<rdf:Description rdf:about="&a;104712237">
	<b:glossaryEntry>the belief that rulers should be chosen for their superior abilities and not because of their wealth or birth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104712404">
	<b:glossaryEntry>a political orientation originating in the 1960s; blends liberal political views with an emphasis on economic growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104712580"
	 b:glossaryEntry="an ideological belief in freedom of thought and speech"/>
<rdf:Description rdf:about="&a;104712695"
	 b:glossaryEntry="a moderate political orientation; an avoidance of extremes"/>
<rdf:Description rdf:about="&a;104712810"
	 b:glossaryEntry="a belief in and advocacy of monarchy as a political system"/>
<rdf:Description rdf:about="&a;104712925">
	<b:glossaryEntry>an ideological position that holds Black culture to be independent and valid on its own terms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104713074">
	<b:glossaryEntry>the political orientation of those who favor progress toward better conditions in government and society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104713238">
	<b:glossaryEntry>the political orientation of those who favor revolutionary change in government and society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104713404">
	<b:glossaryEntry>the ideology of the most radical element of the French Revolution that instituted the Reign of Terror</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104713562"
	 b:glossaryEntry="the political orientation of reactionaries"/>
<rdf:Description rdf:about="&a;104713662">
	<b:glossaryEntry>the political orientation of those who hold that a republic is the best form of government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104713812"
	 b:glossaryEntry="a political theory advocating state ownership of industry"/>
<rdf:Description rdf:about="&a;104713979">
	<b:glossaryEntry>(British) socialism to be established by gradual reforms within the law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104714106">
	<b:glossaryEntry>a form of socialist theory advocating state ownership of industry but managements by guilds of workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104714270"
	 b:glossaryEntry="socialism achieved by voluntary sacrifice"/>
<rdf:Description rdf:about="&a;104714375">
	<b:glossaryEntry>the political orientation of a utopian who believes in impossibly idealistic schemes social perfection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104714534">
	<b:glossaryEntry>any political orientation favoring compromise to avoid conflict</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104714690">
	<b:glossaryEntry>any policy that advocates maintaining peaceful international relations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104714821"
	 b:glossaryEntry="any political orientation favoring aggressive policies"/>
<rdf:Description rdf:about="&a;104714987">
	<b:glossaryEntry>aggressiveness that involves the threat of using military force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104715107"
	 b:glossaryEntry="a policy of advocating war"/>
<rdf:Description rdf:about="&a;104715207"
	 b:glossaryEntry="an attitude toward religion or religious practices"/>
<rdf:Description rdf:about="&a;104715397">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a religious orientation of doubt; a denial of ultimate knowledge of the existence of God; "agnosticism holds that you can neither prove nor disprove God''s existence"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104715620">
	<b:glossaryEntry>a religious orientation advocating gnosis as the way to release a person''s spiritual element; considered heresy by Christian churches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104715810"
	 b:glossaryEntry="the doctrine or belief that there is no God"/>
<rdf:Description rdf:about="&a;104715939"
	 b:glossaryEntry="the doctrine or belief in the existence of a God or gods"/>
<rdf:Description rdf:about="&a;104716102">
	<b:glossaryEntry>the form of theological rationalism that believes in God on the basis of reason without reference to revelation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104716280"
	 b:glossaryEntry="belief in a single God"/>
<rdf:Description rdf:about="&a;104716413"
	 b:glossaryEntry="belief in multiple Gods"/>
<rdf:Description rdf:about="&a;104716523">
	<b:glossaryEntry>any of various religions other than Christianity or Judaism or Islamism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104716679">
	<b:glossaryEntry>a Brazilian religious cult of African origin; combines voodoo elements with singing a chanting and dancing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104716839">
	<b:glossaryEntry>a religious belief of African origin involving witchcraft and sorcery; practiced in parts of the West Indies and tropical Americas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104717027">
	<b:glossaryEntry>belief in Ras Tafari (Haile Selassie of Ethiopia) as the Messiah and that Africa (especially Ethiopia) is the Promised Land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104717211"
	 b:glossaryEntry="the system of Christian beliefs and practices"/>
<rdf:Description rdf:about="&a;104717408">
	<b:glossaryEntry>any Christian religion that believes the second coming of Christ is imminent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104717577">
	<b:glossaryEntry>Adventism that is strongly Protestant and observes Saturday as the Sabbath</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104717719"
	 b:glossaryEntry="the beliefs and practices of a Catholic Church"/>
<rdf:Description rdf:about="&a;104717873"
	 b:glossaryEntry="a religious orientation opposed to Catholicism"/>
<rdf:Description rdf:about="&a;104717982">
	<b:glossaryEntry>the beliefs and practices of the Catholic Church based in Rome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104718119">
	<b:glossaryEntry>the beliefs and practices of any of the Eastern Catholic Churches based in Constantinople</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104718274">
	<b:glossaryEntry>the theological system of any of the churches of Western Christendom that separated from the Roman Catholic Church during the Reformation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104718831">
	<b:glossaryEntry>doctrine characterized by opposition to war and rejection of ritual and a formal creed and an ordained ministry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104718999"
	 b:glossaryEntry="the faith and doctrine and practice of the Anglican Church"/>
<rdf:Description rdf:about="&a;104719133">
	<b:glossaryEntry>a doctrine and practice within the Church of England emphasizing the Catholic tradition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104719303">
	<b:glossaryEntry>principles of the founders of the Oxford movement; expounded in pamphlets called "Tracts for the Times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104719477">
	<b:glossaryEntry>doctrines of Jacobus Arminius (1610) rejecting absolute predestination or strict Calvinism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104719625">
	<b:glossaryEntry>the theological system of John Calvin and his followers emphasizing omnipotence of God and salvation by grace alone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104719796">
	<b:glossaryEntry>religious system based on teachings of Mary Baker Eddy emphasizing spiritual healing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104719944">
	<b:glossaryEntry>teachings of Martin Luther emphasizing the cardinal doctrine of justification by faith alone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104720094">
	<b:glossaryEntry>Christian doctrine that stresses individual freedom of belief and rejects the Trinity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104720238"
	 b:glossaryEntry="Christian doctrine stressing belief in the Trinity"/>
<rdf:Description rdf:about="&a;104720349">
	<b:glossaryEntry>system of beliefs and church government of a Protestant denomination in which each member church is self-governing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104720527">
	<b:glossaryEntry>system of beliefs and practices including belief in Scriptural authority; plain dress; adult baptism; foot washing; restriction of marriage to members of the group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104720748">
	<b:glossaryEntry>stresses the importance of personal conversion and faith as the means of salvation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104720909"
	 b:glossaryEntry="an attempt to reawaken the evangelical faith"/>
<rdf:Description rdf:about="&a;104721010">
	<b:glossaryEntry>the interpretation of every word in the Bible as literal truth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104721133">
	<b:glossaryEntry>the religious beliefs and practices of Methodists characterized by concern with social welfare and public morals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104721301"
	 b:glossaryEntry="evangelical principles taught by John Wesley"/>
<rdf:Description rdf:about="&a;104721415">
	<b:glossaryEntry>belief in: the primacy of the Bible; baptism of believers not infants; complete separation of church and state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104721582"
	 b:glossaryEntry="any of various doctrines closely related to Anabaptism"/>
<rdf:Description rdf:about="&a;104721701">
	<b:glossaryEntry>the doctrines and practices of the Mormon Church based on the Book of Mormon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104721833">
	<b:glossaryEntry>the principles and practices of Pentecostal religious groups; characterized by religious excitement and talking in tongues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104722016">
	<b:glossaryEntry>the doctrines and practices of the Presbyterian Church: based in Calvinism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104722152">
	<b:glossaryEntry>the beliefs and practices characteristic of Puritans (most of whom were Calvinists who wished to purify the Church of England of its Catholic aspects)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104722359">
	<b:glossaryEntry>the monotheistic religion of the Jews; based on the Old Testament and the Talmud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104722493"
	 b:glossaryEntry="the monotheistic religion of Muslims based on the Koran"/>
<rdf:Description rdf:about="&a;104722655">
	<b:glossaryEntry>a complex of beliefs and values and customs including worship of many gods especially the Trimurti composed of Brahma the Creator; Vishnu the preserver; and Shiva the destroyer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104722988">
	<b:glossaryEntry>the religious beliefs of ancient India as prescribed in the sacred Vedas and Brahmanas and Upanishads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104723159"
	 b:glossaryEntry="worship of Krishna the 8th avatar of Vishnu"/>
<rdf:Description rdf:about="&a;104723259">
	<b:glossaryEntry>worship of Shiva one of the 3 chief gods of the Hindu pantheon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104723386"
	 b:glossaryEntry="worship of Shakti as the wife of Shiva"/>
<rdf:Description rdf:about="&a;104723489">
	<b:glossaryEntry>worship of Vishnu one of the 3 chief gods of the Hindu pantheon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104723635">
	<b:glossaryEntry>a Hindu theistic philosophy; union of self and the Supreme Being is sought through a state of complete awareness and tranquillity attained by certain physical exercises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104723873">
	<b:glossaryEntry>founded in the 6th century as a revolt against Hinduism; emphasizes asceticism and immortality and transmigration of the soul; denies existence of a perfect or supreme being</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104724100">
	<b:glossaryEntry>the ethical philosophy of Buddha; emphasizes physical and spiritual discipline as a means of liberation from the physical world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104724390">
	<b:glossaryEntry>one of two great schools of Buddhist doctrine emphasizing a common search for universal salvation especially through faith alone; chiefly in China; Tibet; Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104724605">
	<b:glossaryEntry>one of two great schools of Buddhist doctrine emphasizing personal salvation through one''s own efforts; chiefly in Sri_Lanka (Ceylon); Myanmar (Burma); Thailand; Cambodia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104724830">
	<b:glossaryEntry>Tibetan Buddhist doctrine including non-Buddhist Indian elements and elements of preexisting shamanism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104724986">
	<b:glossaryEntry>doctrine that enlightenment can be attained through direct intuitive insight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104725127">
	<b:glossaryEntry>a Japanese Buddhism emphasizing mystical symbolism of mantras and mudras and the Buddha''s ideal which is inexpressible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104725299">
	<b:glossaryEntry>doctrine of enlightenment as the realization of the oneness of one''s self and the visible world; combines elements of Hinduism and paganism including magical and mystical elements like mantras and mudras and erotic rites; especially influential in Tibet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104725616"
	 b:glossaryEntry="(Taoism) the ultimate principle of the universe"/>
<rdf:Description rdf:about="&a;104725732">
	<b:glossaryEntry>popular Chinese philosophical system based in teachings of Lao-tse but characterized by a pantheism of many gods and the practices of alchemy and divination and magic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104725965">
	<b:glossaryEntry>the indigenous polytheistic religion of Japan lacking organized teachings; primarily nature and ancestor worship including a chief deity from whom the emperor is believed to be descended</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104726216">
	<b:glossaryEntry>ancient Persian religion; popular among Romans during first three centuries a.d.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104726366">
	<b:glossaryEntry>system founded in Persia in the 6th century b.c. by Zoroaster; set forth in the Zend-Avesta; based on concept of struggle between light (good) and dark (evil)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104726614"
	 b:glossaryEntry="Zoroastrian sect in India"/>
<rdf:Description rdf:about="&a;104726706">
	<b:glossaryEntry>an animistic religion of northern Asia having the belief that the mediation between the visible and the spirit worlds is effected by shamans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104726902">
	<b:glossaryEntry>any animistic religion similar to Asian shamanism especially as practiced by certain Native American tribes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104727065">
	<b:glossaryEntry>belief in a kind of sorcery that originated in Africa and is practiced in the West Indies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104727207">
	<b:glossaryEntry>a religious cult practiced chiefly in Caribbean countries (especially Haiti); involves witchcraft and animistic deities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104727430">
	<b:glossaryEntry>the conviction that people should participate in sports as a hobby (for the fun of it) rather than for money</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104727595">
	<b:glossaryEntry>the conviction that the culture and interests of your nation are superior to those of any other nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104727755">
	<b:glossaryEntry>(psychoanalysis) an unconscious process whereby two ideas or images combine into a single symbol; especially in dreams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104727932"
	 b:glossaryEntry="the discipline dealing with the principles of warfare"/>
<rdf:Description rdf:about="&a;104728084">
	<b:glossaryEntry>the branch of military science dealing with detailed maneuvers to achieve objectives set by strategy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104728238">
	<b:glossaryEntry>the branch of military science dealing with military command and the planning and conduct of a war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104728391"
	 b:glossaryEntry="communication by means of transmitted signals"/>
<rdf:Description rdf:about="&a;104728675"
	 b:glossaryEntry="the activity of communicating"/>
<rdf:Description rdf:about="&a;104729014"
	 b:glossaryEntry="mutual communication"/>
<rdf:Description rdf:about="&a;104729099"
	 b:glossaryEntry="the transmission of information"/>
<rdf:Description rdf:about="&a;104729231"
	 b:glossaryEntry="opening to public discussion and debate"/>
<rdf:Description rdf:about="&a;104729401">
	<b:glossaryEntry>the spreading of something (a belief or practice) into new regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104729537">
	<b:glossaryEntry>a communication (usually brief) that is written or spoken or signaled; "he sent a three-word message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104729800"
	 b:glossaryEntry="a message transmitted by means of the sun''s rays"/>
<rdf:Description rdf:about="&a;104729904">
	<b:glossaryEntry>an intervening substance through which signals can travel as a means for communication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104730097"
	 b:glossaryEntry="a means or instrumentality for communicating"/>
<rdf:Description rdf:about="&a;104730302">
	<b:glossaryEntry>a medium that was once supposed to fill all space and to support the propagation of electromagnetic waves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104730468">
	<b:glossaryEntry>a medium for the expression or achievement of something; "his editorials provided a vehicle for his political views"; "a congregation is a vehicle of group identity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104730687">
	<b:glossaryEntry>medium for spoken communication; "he gave air to his objections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104730801">
	<b:glossaryEntry>medium for radio and television broadcasting; "the program was on the air from 9 til midnight"; "the president used the airwaves to take his message to the people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104731024">
	<b:glossaryEntry>medium for written communication; "the notion of an office running without paper is absurd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104731186"
	 b:glossaryEntry="used for writing or printing"/>
<rdf:Description rdf:about="&a;104731408">
	<b:glossaryEntry>a sheet with several pages printed on it; it folds to page size and is bound with other signatures to form a book</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104731596"
	 b:glossaryEntry="a sheet of any written or printed material"/>
<rdf:Description rdf:about="&a;104731752"
	 b:glossaryEntry="a blank leaf in the front of back of a book"/>
<rdf:Description rdf:about="&a;104731849"
	 b:glossaryEntry="especially one side of a leaf"/>
<rdf:Description rdf:about="&a;104732131"
	 b:glossaryEntry="a sheet that can be easily torn out of a publication"/>
<rdf:Description rdf:about="&a;104732240">
	<b:glossaryEntry>something that covers an entire page; "the ad took up a full page"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104732362"
	 b:glossaryEntry="something that covers (the top or bottom) half of a page"/>
<rdf:Description rdf:about="&a;104732474"
	 b:glossaryEntry="right-hand page"/>
<rdf:Description rdf:about="&a;104732559"
	 b:glossaryEntry="left-hand page"/>
<rdf:Description rdf:about="&a;104732643">
	<b:glossaryEntry>a page of a book displaying the title and author and publisher</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104732762">
	<b:glossaryEntry>a first page of some books displaying only the title of the book</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104732899"
	 b:glossaryEntry="two facing pages of a book or other publication"/>
<rdf:Description rdf:about="&a;104733046"
	 b:glossaryEntry="the system of numbering pages"/>
<rdf:Description rdf:about="&a;104733173">
	<b:glossaryEntry>paper cut to an appropriate size for writing letters; usually with matching envelopes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104733360">
	<b:glossaryEntry>a sheet of stationery with name and address of the organization printed at the top</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104733499"
	 b:glossaryEntry="a size of paper used especially in Britain"/>
<rdf:Description rdf:about="&a;104733596">
	<b:glossaryEntry>a sheet of paper with multiple columns; used by an accountant to assemble figures for financial statements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104733758"
	 b:glossaryEntry="a piece of paper recording work planned or done on a project"/>
<rdf:Description rdf:about="&a;104733874"
	 b:glossaryEntry="a path over which electrical signals can pass"/>
<rdf:Description rdf:about="&a;104734014">
	<b:glossaryEntry>(often plural) a means of communication or access; "it must go through official channels"; "lines of communication were set up between the two firms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104734266"
	 b:glossaryEntry="band of radio frequencies for e.g. transmitting a TV signal"/>
<rdf:Description rdf:about="&a;104734393">
	<b:glossaryEntry>a channel for communication between groups; "he provided a liaison with the geurillas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104734578">
	<b:glossaryEntry>official routes of communication; "you have to go through channels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104734700"
	 b:glossaryEntry="transmissions that are disseminated widely to the public"/>
<rdf:Description rdf:about="&a;104734839">
	<b:glossaryEntry>transmission that combine media of communication (text and graphics and sound etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104735017">
	<b:glossaryEntry>a multimedia system in which related items of information are connected and can be presented together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104735270">
	<b:glossaryEntry>machine-readable text that is not sequential but is organized so that related items of information are connected; "Let me introduce the word hypertext to mean a body of written or pictorial material interconnected in such a complex way that it could not conveniently be presented or represented on paper"--Ted Nelson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104735661">
	<b:glossaryEntry>a medium (art or business) that disseminates moving pictures: "theater pieces transferred to celluloid"; "this story would be good cinema"; "film coverange of sporting events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104735926"
	 b:glossaryEntry="the film industry"/>
<rdf:Description rdf:about="&a;104736003"
	 b:glossaryEntry="printed matter in the form of newspapers or magazines"/>
<rdf:Description rdf:about="&a;104736159"
	 b:glossaryEntry="a medium that disseminates printed matter"/>
<rdf:Description rdf:about="&a;104736294"
	 b:glossaryEntry="a medium that disseminates via telecommunications"/>
<rdf:Description rdf:about="&a;104736420">
	<b:glossaryEntry>the system whereby messages are transmitted via the post office</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104736576"
	 b:glossaryEntry="a system of conveying mail by aircraft"/>
<rdf:Description rdf:about="&a;104736678">
	<b:glossaryEntry>mail that includes letters and postcards and packages sealed against inspection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104736897"
	 b:glossaryEntry="communication by exchange of letters"/>
<rdf:Description rdf:about="&a;104736994"
	 b:glossaryEntry="mail that is distributed by a rapid and efficient system"/>
<rdf:Description rdf:about="&a;104737137">
	<b:glossaryEntry>an address written on mail that is to be held at the post office until called for (not in US or Canada)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104737301">
	<b:glossaryEntry>express mail carried by relays of riders on horseback; especially between Missouri and California around 1860</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104737469"
	 b:glossaryEntry="postal service that handles packages"/>
<rdf:Description rdf:about="&a;104737563">
	<b:glossaryEntry>mail consisting of large numbers of identical items (circulars or advertisements) sent to individual addresses at less than 1st-class rates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104737758"
	 b:glossaryEntry="newspapers and magazines collectively"/>
<rdf:Description rdf:about="&a;104737954"
	 b:glossaryEntry="British journalism"/>
<rdf:Description rdf:about="&a;104738031">
	<b:glossaryEntry>journalism that presents a story primarily through the use of pictures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104738199"
	 b:glossaryEntry="photography of newsworthy events"/>
<rdf:Description rdf:about="&a;104738294">
	<b:glossaryEntry>printed material (text and pictures) produced by an intaglio printing process in a rotary press</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104738466">
	<b:glossaryEntry>a daily or weekly publication on folded sheets; contains news and articles and advertisements; "he read his newspaper at breakfast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104738867"
	 b:glossaryEntry="a newspaper that is published every day"/>
<rdf:Description rdf:about="&a;104738958"
	 b:glossaryEntry="a newspaper"/>
<rdf:Description rdf:about="&a;104739023"
	 b:glossaryEntry="newspaper with half-size pages"/>
<rdf:Description rdf:about="&a;104739121"
	 b:glossaryEntry="sensationalist journalism"/>
<rdf:Description rdf:about="&a;104739220">
	<b:glossaryEntry>nonfictional prose forming an independent part of a publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104739463"
	 b:glossaryEntry="an article giving opinions or perspectives"/>
<rdf:Description rdf:about="&a;104739626">
	<b:glossaryEntry>a special or prominent article in a newspaper or magazine; "they ran a feature on retirement planning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104739838"
	 b:glossaryEntry="an article published in a magazine"/>
<rdf:Description rdf:about="&a;104739954"
	 b:glossaryEntry="an article reporting news"/>
<rdf:Description rdf:about="&a;104740201">
	<b:glossaryEntry>an artistic or literary composition; "he wrote an interesting piece on Iran"; "the children acted out a comic piece to amuse the guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104740425">
	<b:glossaryEntry>a separately printed article that originally appeared in a larger publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104740578">
	<b:glossaryEntry>a scholarly article describing the results of observations or stating hypotheses; "he has written many scientific papers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104740751">
	<b:glossaryEntry>a publication (such as a book) that is reprinted without changes or editing and offered again for sale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104740930">
	<b:glossaryEntry>a publication (such as a book) that has been modified or updated and offered again for sale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104741079">
	<b:glossaryEntry>the introductory section of a story; "it was an amusing lead-in to a very serious matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104741248"
	 b:glossaryEntry="the first line of a piece of writing (as a newspaper story)"/>
<rdf:Description rdf:about="&a;104741385"
	 b:glossaryEntry="a news story of major importance"/>
<rdf:Description rdf:about="&a;104741481"
	 b:glossaryEntry="a short newspaper article about a particular person or group"/>
<rdf:Description rdf:about="&a;104741596"
	 b:glossaryEntry="a short news story presenting sidelights on a major story"/>
<rdf:Description rdf:about="&a;104741707"
	 b:glossaryEntry="a newspaper column devoted to personal problems"/>
<rdf:Description rdf:about="&a;104741813">
	<b:glossaryEntry>(often plural) systems used in transmitting messages electronically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104742034"
	 b:glossaryEntry="transmitting speech at a distance"/>
<rdf:Description rdf:about="&a;104742189">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a telephone connection; "she reported several anonymous calls"; "he placed a phone call to London"; "he heard the phone ringing but didn''t want to take the call"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104742539"
	 b:glossaryEntry="a return call"/>
<rdf:Description rdf:about="&a;104742608"
	 b:glossaryEntry="a phone call that the receiving party is asked to pay for"/>
<rdf:Description rdf:about="&a;104742724">
	<b:glossaryEntry>lets you transfer your incoming calls to any telephone that you can dial direct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104742865">
	<b:glossaryEntry>a way of letting you know that someone else is calling when you are using your telephone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104743012"
	 b:glossaryEntry="a hostile phone call (from a crank)"/>
<rdf:Description rdf:about="&a;104743104"
	 b:glossaryEntry="a telephone call made within a local calling area"/>
<rdf:Description rdf:about="&a;104743210"
	 b:glossaryEntry="a telephone call made outside the local calling area"/>
<rdf:Description rdf:about="&a;104743374"
	 b:glossaryEntry="a long-distance telephone call at charges above a local rate"/>
<rdf:Description rdf:about="&a;104743490"
	 b:glossaryEntry="a telephone call in which more than two people participate"/>
<rdf:Description rdf:about="&a;104743628">
	<b:glossaryEntry>a way of adding a third party to your conversation without the assistance of a telephone operator</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104743789">
	<b:glossaryEntry>communicating at a distance by electric transmission over wire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104743908"
	 b:glossaryEntry="a telegram sent abroad"/>
<rdf:Description rdf:about="&a;104744014">
	<b:glossaryEntry>a cheaper form of telegram that is sent abroad for delivery the next day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104744148"
	 b:glossaryEntry="transmission by radio waves"/>
<rdf:Description rdf:about="&a;104744266">
	<b:glossaryEntry>telegraphy that uses transmission by radio rather than by wire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104744429"
	 b:glossaryEntry="a message transmitted by wireless telegraphy"/>
<rdf:Description rdf:about="&a;104744529">
	<b:glossaryEntry>telephony that uses transmission by radio rather than by wire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104744689"
	 b:glossaryEntry="taking part in a radio or tv program"/>
<rdf:Description rdf:about="&a;104744856"
	 b:glossaryEntry="(British) a system for distributing radio or tv programs"/>
<rdf:Description rdf:about="&a;104744970"
	 b:glossaryEntry="communicates two or more signals over a common channel"/>
<rdf:Description rdf:about="&a;104745080"
	 b:glossaryEntry="medium for communication"/>
<rdf:Description rdf:about="&a;104745188"
	 b:glossaryEntry="broadcasting visual images of stationary or moving objects"/>
<rdf:Description rdf:about="&a;104745386">
	<b:glossaryEntry>the visible part of a television transmission; "they could still receive the sound but the picture was gone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104745575">
	<b:glossaryEntry>the audible part of a transmitted signal; "they always raise the audio for commercials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104745741">
	<b:glossaryEntry>television that is transmitted over cable directly to the receiver</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104745878"
	 b:glossaryEntry="communication by computer"/>
<rdf:Description rdf:about="&a;104746028">
	<b:glossaryEntry>electronic transmission of information that has been encoded digitally (as for storage and processing by computers)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104746250">
	<b:glossaryEntry>a means of digital communications that is capable of very high speeds; suitable for transmission of images or voice or video as well as data; "ATM is used for both LAN and WAN"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104746505">
	<b:glossaryEntry>(computer science) a system of world-wide electronic communication in which a computer user can compose a message at one terminal that is generated at the recipient''s terminal when he logs in</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104746775">
	<b:glossaryEntry>(computer science) a symbol that appears on the computer screen to indicate that the computer is ready to receive a command</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104746968"
	 b:glossaryEntry="the transmission of light signals via glass fibers"/>
<rdf:Description rdf:about="&a;104747092"
	 b:glossaryEntry="quality or fidelity of a received broadcast"/>
<rdf:Description rdf:about="&a;104747227"
	 b:glossaryEntry="the detection that a signal is being received"/>
<rdf:Description rdf:about="&a;104747347">
	<b:glossaryEntry>(electronics) the transmission of a signal by imposing it on a carrier wave by changing the carrier''s amplitude or frequency or phase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104747609"
	 b:glossaryEntry="modulation of the amplitude of the (radio) carrier wave"/>
<rdf:Description rdf:about="&a;104747736"
	 b:glossaryEntry="modulation of the frequency of the (radio) carrier wave"/>
<rdf:Description rdf:about="&a;104747863"
	 b:glossaryEntry="modulation of the phase of the carrier wave"/>
<rdf:Description rdf:about="&a;104747974"
	 b:glossaryEntry="modulation that imposes a signal on a train of pulses"/>
<rdf:Description rdf:about="&a;104748108"
	 b:glossaryEntry="modulation of the time between successive pulses"/>
<rdf:Description rdf:about="&a;104748224">
	<b:glossaryEntry>(electronics) the reception of a signal by extracting it from the carrier wave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104748361">
	<b:glossaryEntry>a systematic means of communicating by the use of sounds or conventional symbols; "he taught foreign languages"; "the language introduced is standard throughout the text"; "the speed with which a program can be executed depends on the language in which it is written"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104748872">
	<b:glossaryEntry>language that is spoken or written; "he has a gift for words"; "she put her thoughts into words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104749020"
	 b:glossaryEntry="a language that is to be translated into another language"/>
<rdf:Description rdf:about="&a;104749175">
	<b:glossaryEntry>the language into which a text written in another language is to be translated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104749333">
	<b:glossaryEntry>one of the natural units into which linguistic messages can be analyzed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104749663">
	<b:glossaryEntry>a position in a grammatical linguistic construction in which a variety of alternative units are interchangeable; "he developed a version of slot grammar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104749867"
	 b:glossaryEntry="extended verbal expression in speech or writing"/>
<rdf:Description rdf:about="&a;104749988">
	<b:glossaryEntry>discourse that surrounds a language unit and helps to determine its interpretation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104750162">
	<b:glossaryEntry>a string of words satisfying the grammatical rules of a language; "he always spoke in grammatical sentences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104750452">
	<b:glossaryEntry>a sentence composed of at least one main clause and one subordinate clause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104750589">
	<b:glossaryEntry>a sentence composed of at least two coordinate independent clauses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104750719">
	<b:glossaryEntry>formal expression containing variables; becomes a sentence when variables are replaced by constants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104750884">
	<b:glossaryEntry>a unit of language that native speakers can identify; "words are the blocks from which sentences are made"; "he hardly said ten words all morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104751911">
	<b:glossaryEntry>a word placed at the beginning of a line or paragraph (as in a dictionary entry)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104752065"
	 b:glossaryEntry="a word that is qualified by a modifier"/>
<rdf:Description rdf:about="&a;104752177">
	<b:glossaryEntry>a word that is used metonymically; a word that denotes one thing but refers to a related thing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104752325">
	<b:glossaryEntry>a word or phrase spelled by rearranging the letters of another word or phrase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104752474">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an anagram that means the opposite of the original word or phrase; "`restful'' is the antigram of `fluster''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104752636"
	 b:glossaryEntry="a word acted out in an episode of the game of charades"/>
<rdf:Description rdf:about="&a;104752763">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a word formed from two or more words by omitting or combining some sounds: "won''t" from "will not"; "o''clock" from "of the clock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104752950"
	 b:glossaryEntry="a word or phrase that reads the same backward as forward"/>
<rdf:Description rdf:about="&a;104753063">
	<b:glossaryEntry>the phonological or orthographic sound or appearance of a word; "the inflected forms of a word can be represented by a stem and a list of inflections to be attached"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104753435"
	 b:glossaryEntry="the form of a word that is used to denote more than one"/>
<rdf:Description rdf:about="&a;104753575"
	 b:glossaryEntry="the form of a word that is used to denote a singleton"/>
<rdf:Description rdf:about="&a;104753717">
	<b:glossaryEntry>a word form that has entered the language through the perpetuation of an error</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104753852">
	<b:glossaryEntry>(linguistics) the form of a word after all affixes are removed; "thematic vowels are part of the stem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104754049"
	 b:glossaryEntry="a word form from which other words are derived"/>
<rdf:Description rdf:about="&a;104754148">
	<b:glossaryEntry>the form of a word that heads a lexical entry and is alphabetized in a dictionary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104754339"
	 b:glossaryEntry="the entry in a dictionary of information about a word"/>
<rdf:Description rdf:about="&a;104754528">
	<b:glossaryEntry>a word is cognate with another if both derive from the same word in an ancestral language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104754686">
	<b:glossaryEntry>a word borrowed from another language; e.g. `blitz'' is a German word borrowed into modern English</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104754863">
	<b:glossaryEntry>a word that is composed of parts from different languages (e.g., `monolingual'' has a Greek prefix and a Latin root)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104755043"
	 b:glossaryEntry="a newly invented word or phrase"/>
<rdf:Description rdf:about="&a;104755150">
	<b:glossaryEntry>a word formed by joining two others (e.g., `smog'' is a blend of `smoke'' and `fog'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104755317">
	<b:glossaryEntry xml:space='preserve'><![CDATA[one of the eight sayings of Jesus at the beginning of the Sermon on the Mount; in Latin each saying begins with `beatus'' (blessed); "her favorite Beatitude is `Blessed are the meek for they shall inherit the earth''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104755607">
	<b:glossaryEntry>an expression introduced into one language by translating it from another language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104755761"
	 b:glossaryEntry="a word that is spoken aloud"/>
<rdf:Description rdf:about="&a;104755856">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a unit of spoken language larger than a phoneme; "the word `pocket'' has two syllables"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104756070"
	 b:glossaryEntry="the next to last syllable in a word"/>
<rdf:Description rdf:about="&a;104756184"
	 b:glossaryEntry="the 3rd syllable of a word counting back from the end"/>
<rdf:Description rdf:about="&a;104756312"
	 b:glossaryEntry="a word or utterance of one syllable"/>
<rdf:Description rdf:about="&a;104756426"
	 b:glossaryEntry="a word of more than three syllables"/>
<rdf:Description rdf:about="&a;104756576"
	 b:glossaryEntry="a word that is hard to pronounce"/>
<rdf:Description rdf:about="&a;104756665"
	 b:glossaryEntry="a very long word (a foot and a half long)"/>
<rdf:Description rdf:about="&a;104756783"
	 b:glossaryEntry="a word having two syllables"/>
<rdf:Description rdf:about="&a;104756881"
	 b:glossaryEntry="a word having three syllables"/>
<rdf:Description rdf:about="&a;104756968">
	<b:glossaryEntry>two words that can be interchanged in a context are said to be synonymous relative to that context</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104757138">
	<b:glossaryEntry>two words that express opposing concepts; "to him the opposite of gay was depressed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104757339">
	<b:glossaryEntry>antonyms that are commonly associated (e.g., `wet'' and `dry'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104757461">
	<b:glossaryEntry>antonyms whose opposition is mediated (e.g., the antonymy of `wet'' and `parched'' is mediated by the similarity of `parched'' to `dry'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104757657"
	 b:glossaryEntry="a word that is more generic than a given word"/>
<rdf:Description rdf:about="&a;104757794"
	 b:glossaryEntry="a word that is more specific than a given word"/>
<rdf:Description rdf:about="&a;104757927">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a word that names a part of a given word; "`brim'' and `crown'' are meronyms of `hat''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104758077">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a word that names the whole of which a given word is a part; "`hat'' is a holonym for `brim'' and `crown''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104758248">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a word that denotes a manner of doing something; "`march'' is a troponym of `walk''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104758399"
	 b:glossaryEntry="a word that is derived from another word"/>
<rdf:Description rdf:about="&a;104758496">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a word specifying identity or spacial or temporal location from the perspective of a speaker or hearer in the context in which the communication occurs: "words that introduce particulars of the speaker''s and hearer''s shared cognitive field into the message"- R.Rommetveit]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104758836"
	 b:glossaryEntry="a word with a special meaning used for a special occasion"/>
<rdf:Description rdf:about="&a;104758968">
	<b:glossaryEntry>a word or expression used for some particular thing; "he learned many medical terms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104759121">
	<b:glossaryEntry>a system of words used in a particular discipline; "legal terminology"; "the language of sociology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104759322">
	<b:glossaryEntry>a minimal unit (as a word or stem) in the lexicon of a language; `go'' and `went'' and `gone'' and `going'' are all members of the English lexeme `go''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104759521">
	<b:glossaryEntry>minimal meaningful language unit; it cannot be divided into smaller meaningful units</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104759714">
	<b:glossaryEntry>minimal language unit that has a syntactic (or morphological) function</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104759840">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a variant phonological representation of a morpheme: "the final sounds of `bets'' and `beds'' and `horses'' and `oxen'' are allomorphs of the English plural morpheme"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104760076"
	 b:glossaryEntry="a morpheme that can occur alone"/>
<rdf:Description rdf:about="&a;104760179">
	<b:glossaryEntry>a morpheme that occurs only as part of a larger construction; eg an -s at the end of plural nouns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104760386">
	<b:glossaryEntry>a bound form used only in compounds (e.g., `hemato-'' in `hematology'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104760516">
	<b:glossaryEntry>a word invented (usually unwittingly by subtracting an affix) on the assumption that a familiar word derives from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104760693">
	<b:glossaryEntry>a linguistic element added to a word to produce an inflected or derived form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104760894"
	 b:glossaryEntry="an affix that added in front of the word"/>
<rdf:Description rdf:about="&a;104761005"
	 b:glossaryEntry="the negative prefix a- or un-"/>
<rdf:Description rdf:about="&a;104761096"
	 b:glossaryEntry="an affix that is added at the end of the word"/>
<rdf:Description rdf:about="&a;104761221"
	 b:glossaryEntry="an inflection that is added at the end of a root word"/>
<rdf:Description rdf:about="&a;104761340"
	 b:glossaryEntry="an affix that is inserted inside the word"/>
<rdf:Description rdf:about="&a;104761433"
	 b:glossaryEntry="a category of words having the same grammatical properties"/>
<rdf:Description rdf:about="&a;104761687">
	<b:glossaryEntry>(linguistics) the grammatical constituent about which something is predicated in a sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104761832">
	<b:glossaryEntry>a grammatical constituent that is acted upon; "the object of the verb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104762027"
	 b:glossaryEntry="the object governed by a preposition"/>
<rdf:Description rdf:about="&a;104762156"
	 b:glossaryEntry="the object that receives the direct action of the verb"/>
<rdf:Description rdf:about="&a;104762291">
	<b:glossaryEntry>the object that is the recipient or beneficiary of the action of the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104762426"
	 b:glossaryEntry="an object in a passive construction"/>
<rdf:Description rdf:about="&a;104762523">
	<b:glossaryEntry>nouns or pronouns or adjectives (often marked by inflection) related in some way to other words in a sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104762738">
	<b:glossaryEntry>the category of nouns serving as the grammatical subject of a verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104762912"
	 b:glossaryEntry="any grammatical case other than the nominative"/>
<rdf:Description rdf:about="&a;104763171"
	 b:glossaryEntry="the category of nouns serving as the direct object of a verb"/>
<rdf:Description rdf:about="&a;104763323">
	<b:glossaryEntry>the category of nouns serving as the indirect object of a verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104763452"
	 b:glossaryEntry="the case expressing ownership"/>
<rdf:Description rdf:about="&a;104763570">
	<b:glossaryEntry>the case indicating where the action described by the verb occurred</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104763708">
	<b:glossaryEntry>the case indicating the instrument used in performing the action of the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104763863">
	<b:glossaryEntry>the case (in some inflected languages) used when the referent of the noun is being addressed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104764026">
	<b:glossaryEntry>the case indicating the agent in passive sentences or the instrument or manner or place of the action described by the verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104764220">
	<b:glossaryEntry>a constituent in Latin grammar; a noun and its modifier can function as a sentence modifier</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104764375">
	<b:glossaryEntry>a word or phrase or clause forming part of a larger construction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104764650">
	<b:glossaryEntry>a constituent of a sentence at the first step in an analysis: e.g., subject and predicate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104764807">
	<b:glossaryEntry>a group of words that form a constituent of a sentence and are considered as a single unit; "I concluded from his awkward constructions that he was a foreigner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104765129"
	 b:glossaryEntry="an ungrammatical construction"/>
<rdf:Description rdf:about="&a;104765220">
	<b:glossaryEntry>(grammar) an expression including a subject and predicate but not constituting a complete sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104765389">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a clause introduced by a relative pronoun; "`who visits frequently'' is a relative clause in the sentence `John, who visits frequently, is ill''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104765594">
	<b:glossaryEntry>an expression forming a grammatical constituent of a sentence but not containing a finite verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104765869"
	 b:glossaryEntry="a word or phrase used to complete a grammatical construction"/>
<rdf:Description rdf:about="&a;104765986"
	 b:glossaryEntry="an expression that predicates"/>
<rdf:Description rdf:about="&a;104766072">
	<b:glossaryEntry>a phrase that can function as the subject or object of a verb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104766191"
	 b:glossaryEntry="a phrase that functions as a verb"/>
<rdf:Description rdf:about="&a;104766294">
	<b:glossaryEntry>an infinitive with an adverb between `to'' and the verb (e.g., `to boldly go'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104766434"
	 b:glossaryEntry="a phrase beginning with a preposition"/>
<rdf:Description rdf:about="&a;104766538">
	<b:glossaryEntry>one of the traditional categories of words intended to reflect their functions in a grammatical context</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104766818"
	 b:glossaryEntry="any of the parts of speech of traditional grammar"/>
<rdf:Description rdf:about="&a;104766930"
	 b:glossaryEntry="a word that can serve as the subject or object of a verb"/>
<rdf:Description rdf:about="&a;104767056"
	 b:glossaryEntry="a word that serves as the predicate of a sentence"/>
<rdf:Description rdf:about="&a;104767247">
	<b:glossaryEntry>a noun formed from a verb (such as the `-ing'' form of an English verb when used as a noun)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104767390"
	 b:glossaryEntry="the uninflected form of the verb"/>
<rdf:Description rdf:about="&a;104767497"
	 b:glossaryEntry="the word class that qualifies nouns"/>
<rdf:Description rdf:about="&a;104767588"
	 b:glossaryEntry="the word class that qualifies verbs or clauses"/>
<rdf:Description rdf:about="&a;104767687">
	<b:glossaryEntry>a word that serves a grammatical function but has no identifiable meaning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104767949"
	 b:glossaryEntry="a word to which an independent meaning can be assigned"/>
<rdf:Description rdf:about="&a;104768171"
	 b:glossaryEntry="a noun or a pronoun that is used in place of a noun"/>
<rdf:Description rdf:about="&a;104768298">
	<b:glossaryEntry>a word that can be used to refer to a person or place or thing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104768501"
	 b:glossaryEntry="a noun that does not form plurals"/>
<rdf:Description rdf:about="&a;104768590"
	 b:glossaryEntry="a noun that forms plurals"/>
<rdf:Description rdf:about="&a;104768672"
	 b:glossaryEntry="a noun that denotes a particular thing; usually capitalized"/>
<rdf:Description rdf:about="&a;104768821"
	 b:glossaryEntry="a noun that denotes any or all members of a class"/>
<rdf:Description rdf:about="&a;104768982"
	 b:glossaryEntry="a noun that is derived from a verb"/>
<rdf:Description rdf:about="&a;104769108">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an adjective used as a noun; "`meek'' in `blessed are the meek'' is an adnoun"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104769237"
	 b:glossaryEntry="a content word that denotes an action or a state"/>
<rdf:Description rdf:about="&a;104769354"
	 b:glossaryEntry="a content word that qualifies the meaning of a noun or verb"/>
<rdf:Description rdf:about="&a;104769571">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a modifier that has little meaning except to intensify the meaning it modifies; "`up'' in `finished up'' is an intensifier"; "`honestly'' in `I honestly don''t know'' is an intensifier"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104769821"
	 b:glossaryEntry="a word that expresses an attribute of something"/>
<rdf:Description rdf:about="&a;104769996">
	<b:glossaryEntry>an adjective that ascribes to its noun the value of an attribute of that noun (e.g., `a nervous person'' or `a musical speaking voice'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104770221">
	<b:glossaryEntry>an adjective that classifies its noun (e.g., `a nervous disease'' or `a musical instrument'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104770421"
	 b:glossaryEntry="(informal) meaning relating to or pertaining to"/>
<rdf:Description rdf:about="&a;104770524">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the comparative form of an adjective; "`better'' is the comparative form of `good''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104770664">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the superlative form of an adjective; "`best'' is the superlative form of `good''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104770802"
	 b:glossaryEntry="a word that modifies something other than a noun"/>
<rdf:Description rdf:about="&a;104770921">
	<b:glossaryEntry>a word or phrase apparently modifying an unintended word because of its placement in a sentence: e.g., `when young'' in `when young, circuses appeal to all of us''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104771185">
	<b:glossaryEntry>a participle (usually at the begining of a sentence) apparently modifying a word other than the word intended: e.g., `flying across the country'' in `flying across the country the Rockies came into view''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104771453"
	 b:glossaryEntry="a word or group of words function as an adverb"/>
<rdf:Description rdf:about="&a;104771555">
	<b:glossaryEntry>one of a limited class of noun modifiers that determine the referents of noun phrases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104771731">
	<b:glossaryEntry>(Grammar) a determiner that may indicate the specificity of reference of a noun phrase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104771907">
	<b:glossaryEntry>a determiner (as `the'' in English) that indicates specificity of reference</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104772044">
	<b:glossaryEntry>a determiner (as `a'' or `some'' in English) that indicates non-specificity of reference</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104772195">
	<b:glossaryEntry>a function word that combines with a noun or pronoun or noun phrase to form a prepositional phrase that can have an adverbial or adjectival relation to some other word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104772420">
	<b:glossaryEntry>a function word that is used in place of a noun or noun phrase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104772608">
	<b:glossaryEntry>a word that is formed with a suffix (such as -let or -kin) to indicate smallness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104772745">
	<b:glossaryEntry>a word (such a `some'' or `less'') that is used to indicate a part as distinct from a whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104772890">
	<b:glossaryEntry>(linguistics) the word in a constituent that plays the same grammatical role as the whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104773042"
	 b:glossaryEntry="a word that expresses a quantity (as `fifteen'' or `many'')"/>
<rdf:Description rdf:about="&a;104773156">
	<b:glossaryEntry>a word (such as `some'' or `all` or `no'') that binds the variables in a logical proposition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104773303">
	<b:glossaryEntry>a word (such as a pronoun) used to avoid repetition; the referent of an anaphor is determined by its antecedent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104773468"
	 b:glossaryEntry="a pronoun that refers to an antecedent"/>
<rdf:Description rdf:about="&a;104773570"
	 b:glossaryEntry="a pronoun that points out an intended referent"/>
<rdf:Description rdf:about="&a;104773700">
	<b:glossaryEntry>an uninflected function word that serves to conjoin words or phrases or clauses or sentences</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104773913">
	<b:glossaryEntry>a conjunction (like `and'' or `or'') that connects two identically constructed grammatical constituents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104774085">
	<b:glossaryEntry>a conjunction (like `since'' or `that'' or `who'') that introduces a dependent clause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104774265"
	 b:glossaryEntry="a function word having different uses in different languages"/>
<rdf:Description rdf:about="&a;104774380">
	<b:glossaryEntry>(linguistics) the grammatical category for the forms of nouns and pronouns and verbs that are used depending on the number of entities involved (singular or dual or plural); "in English the subject and the verb must agree in number"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104774665">
	<b:glossaryEntry>a grammatical category of pronouns and verb forms; "stop talking about yourself in the third person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104774872"
	 b:glossaryEntry="a pronoun expressing a distinction of person"/>
<rdf:Description rdf:about="&a;104774997">
	<b:glossaryEntry>a pronoun (as `that'' or `which'' or `who'') that introduces a relative clause referring to some antecedent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104775164">
	<b:glossaryEntry>pronouns and verbs used to refer to the speaker or writer of the language in which they occur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104775316">
	<b:glossaryEntry>pronouns and verbs used to refer to the person addressed by the language in which they occur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104775468">
	<b:glossaryEntry>pronouns and verbs used to refer to something other than the speaker or addressee of the language in which they occur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104775644">
	<b:glossaryEntry>a personal pronoun compounded with -self to show the agent''s action affects itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104775802">
	<b:glossaryEntry>a grammatical category in inflected languages governing the agreement between nouns and pronouns and adjectives; in some languages it is quite arbitrary but in Indo-European languages it is usually based on sex or animateness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104776155">
	<b:glossaryEntry>a gender that refers chiefly (but not exclusively) to females or to objects classified as female</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104776306">
	<b:glossaryEntry>a gender that refers chiefly (but not exclusively) to males or to objects classified as male</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104776454">
	<b:glossaryEntry>a gender that refers chiefly (but not exclusively) to inanimate objects (neither masculine nor feminine)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104776611">
	<b:glossaryEntry>a grammatical category of verbs used to express distinctions of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104776839">
	<b:glossaryEntry>a verb tense that expresses actions or states at the time of speaking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104776996">
	<b:glossaryEntry>the use of the present tense to describe past actions or states</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104777124">
	<b:glossaryEntry>a verb tense in some languages (classical Greek; Sanskrit) expressing action (especially past) without indicating its completion or continuation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104777321"
	 b:glossaryEntry="a verb tense that expresses actions or states in the past"/>
<rdf:Description rdf:about="&a;104777460"
	 b:glossaryEntry="a verb tense that expresses actions or states in the future"/>
<rdf:Description rdf:about="&a;104777587">
	<b:glossaryEntry>a non-finite form of the verb; in English it is used adjectivally and to form compound tenses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104777773">
	<b:glossaryEntry>a participle expressing present action; in English is formed by adding -ing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104777913"
	 b:glossaryEntry="a participle that expresses completed action"/>
<rdf:Description rdf:about="&a;104778040">
	<b:glossaryEntry>a verb (or verb construction) that requires an object to be grammatical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104778214">
	<b:glossaryEntry>a transitive verb that takes both a direct and an indirect object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104778378"
	 b:glossaryEntry="a verb (or verb construction) that does not take an object"/>
<rdf:Description rdf:about="&a;104778525">
	<b:glossaryEntry>a language unit by which a person or thing is known; "his name really is George Washington"; "those are two names for the same thing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104779015">
	<b:glossaryEntry>a name derived from the name of person (real or imaginary) as the name of Alexandria is derived from the name of its founder: Alexander the Great</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104779213">
	<b:glossaryEntry>the name of a person for whom something is supposedly named; Constantine I is the eponym for Constantinople</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104779373">
	<b:glossaryEntry>a name derived with an affix (such as -son in English or O''- in Irish) from the name of your father or a paternal ancestor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104779552">
	<b:glossaryEntry>a name derived from the name of your mother or a maternal ancestor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104779688">
	<b:glossaryEntry>the name used to identify the members of a family (as distinguished from each member''s given name)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104779895"
	 b:glossaryEntry="a woman''s surname before marriage"/>
<rdf:Description rdf:about="&a;104779986"
	 b:glossaryEntry="the name that precedes the surname"/>
<rdf:Description rdf:about="&a;104780137"
	 b:glossaryEntry="the first name given to Christians at birth or christening"/>
<rdf:Description rdf:about="&a;104780273"
	 b:glossaryEntry="the first name of a citizen of ancient Rome"/>
<rdf:Description rdf:about="&a;104780372">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a familiar name (often a shortened version of a person''s given name); "Joe''s mother would not use his nickname and always called him Joseph"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104780613"
	 b:glossaryEntry="a name that has been assumed temporarily"/>
<rdf:Description rdf:about="&a;104780733">
	<b:glossaryEntry>a fictitious name used when the person performs a particular social role</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104780922"
	 b:glossaryEntry="an incorrect or unsuitable name"/>
<rdf:Description rdf:about="&a;104781008"
	 b:glossaryEntry="the pseudonym of an actor"/>
<rdf:Description rdf:about="&a;104781090"
	 b:glossaryEntry="an author''s pseudonym"/>
<rdf:Description rdf:about="&a;104781181">
	<b:glossaryEntry>the name that appears on the by-line to identify the author of a work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104781345">
	<b:glossaryEntry>identifying word or words by which someone or something is called and classified or distinguished from others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104781609">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an identifying appellation signifying status or function: e.g. Mr. or General; "the professor didn''t like his friends to use his formal title"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104781839"
	 b:glossaryEntry="a title of respect for a clergyman"/>
<rdf:Description rdf:about="&a;104781928">
	<b:glossaryEntry>a title of respect for various ecclesiastical officials (as cathedral deans and canons and others)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104782086">
	<b:glossaryEntry>a title used to address any British peer except a duke and extended to a bishop or a judge: "Your Lordship" or "His Lordship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104782266">
	<b:glossaryEntry>a title used to address any peeress except a duchess; "Your Ladyship" or "Her Ladyship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104782408">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an appellation signifying nobility; "`your majesty'' is the appropriate title to use in addressing a king"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104782637"
	 b:glossaryEntry="the title of a baron"/>
<rdf:Description rdf:about="&a;104782713"
	 b:glossaryEntry="the title of a viscount"/>
<rdf:Description rdf:about="&a;104782793">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the name of a work of art or literary composition etc.; "he looked for books with the word `jazz'' in the title"; "he refused to give titles to his paintings"; "I can never remember movie titles"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104783039"
	 b:glossaryEntry="the name by which a geographical place is known"/>
<rdf:Description rdf:about="&a;104783153">
	<b:glossaryEntry>a line of text serving to indicate what the passage below it is about; "the heading seemed to have little to do with the text"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104783466">
	<b:glossaryEntry>a heading of a subsection printed within the body of the text</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104783598"
	 b:glossaryEntry="the heading or caption of a newspaper article"/>
<rdf:Description rdf:about="&a;104783792"
	 b:glossaryEntry="the head of an annotation or gloss"/>
<rdf:Description rdf:about="&a;104783878"
	 b:glossaryEntry="a heading that is printed in red or in a special type"/>
<rdf:Description rdf:about="&a;104783984">
	<b:glossaryEntry>a heading printed at the top of every page (or every other page) of a book</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104784173"
	 b:glossaryEntry="a heading of a subdivision of a text"/>
<rdf:Description rdf:about="&a;104784294">
	<b:glossaryEntry>the title (or a shortened title) of a book used as a running head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104784419">
	<b:glossaryEntry>a headline with the top line flush left and succeeding lines indented to the right</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104784626"
	 b:glossaryEntry="a sensational newspaper headline"/>
<rdf:Description rdf:about="&a;104784713"
	 b:glossaryEntry="a newspaper headline that runs across the full page"/>
<rdf:Description rdf:about="&a;104784828">
	<b:glossaryEntry>a heading that names a statute or legislative bill; gives a brief summary of the matters it deals with; "Title 8 provided federal help for schools"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104785043">
	<b:glossaryEntry>(usually plural) written material introduced into a movie or TV show to give credits or represent dialogue or explain an action; "the titles go by faster than I can read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104785265">
	<b:glossaryEntry>a general or descriptive heading for a section of a written work; "the novel had chapter titles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104785467">
	<b:glossaryEntry>an entry on a list of persons who contributed to a film or written work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104785610"
	 b:glossaryEntry="brief description accompanying an illustration"/>
<rdf:Description rdf:about="&a;104785738"
	 b:glossaryEntry="secondary or explanatory title"/>
<rdf:Description rdf:about="&a;104785833">
	<b:glossaryEntry>translation of foreign dialogue of a movie or TV program; usually displayed at the bottom of the screen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104786020">
	<b:glossaryEntry>translation of the words of a foreign opera (or choral work) projected on a screen above the stage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104786205"
	 b:glossaryEntry="a single line of words in a poem"/>
<rdf:Description rdf:about="&a;104786370"
	 b:glossaryEntry="a line of verse that has six iambic feet"/>
<rdf:Description rdf:about="&a;104786468"
	 b:glossaryEntry="a line giving the name of the writer of a story or article"/>
<rdf:Description rdf:about="&a;104786613">
	<b:glossaryEntry>a line at the beginning of a news article giving the date and place of origin of the news dispatch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104786785"
	 b:glossaryEntry="communication by means of written symbols"/>
<rdf:Description rdf:about="&a;104787112">
	<b:glossaryEntry>a written communication in a second language having the same meaning as the written communication in a first language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104787406"
	 b:glossaryEntry="an incorrect translation"/>
<rdf:Description rdf:about="&a;104787491">
	<b:glossaryEntry>a literal translation used in studying a foreign language (often used illicitly)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104787636">
	<b:glossaryEntry>something written, esp. copied from one medium to another, as a typed version of shorthand notes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104787843"
	 b:glossaryEntry="transcribing from one alphabet to another"/>
<rdf:Description rdf:about="&a;104787946">
	<b:glossaryEntry>a transcription intended to represent each distinct speech sound with a separate symbol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104788121"
	 b:glossaryEntry="a method of writing rapidly"/>
<rdf:Description rdf:about="&a;104788218">
	<b:glossaryEntry>handwriting in which letters are set down in full and cursively connected within words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104788423">
	<b:glossaryEntry>a fine style of handwriting based on the writing used on copperplate engravings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104788560">
	<b:glossaryEntry>a style of handwriting with the letters slanting to the right</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104788674"
	 b:glossaryEntry="a clearly written style of longhand with large round curves"/>
<rdf:Description rdf:about="&a;104788790">
	<b:glossaryEntry>a method of representing the sounds of a language by written or printed symbols</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104789236"
	 b:glossaryEntry="a particular orthography or writing system"/>
<rdf:Description rdf:about="&a;104789385">
	<b:glossaryEntry>an alphabetic script used to write the Arabic dialects (and borrowed to write Urdu)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104789537">
	<b:glossaryEntry>a writing system having an alphabet of 38 letters in which the Armenian language is written</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104789703">
	<b:glossaryEntry>the script in which the ancient Persian language of the Avesta is written</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104789830">
	<b:glossaryEntry>the ideographic and syllabic writing system in which the ancient Babylonian language was written</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104789983"
	 b:glossaryEntry="a syllabic script used in writing Sanskrit and Hindi"/>
<rdf:Description rdf:about="&a;104790137">
	<b:glossaryEntry>a style of orthography characterized by somewhat rounded capital letters; found especially in Greek and Latin manuscripts of the 4th to 8th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104790339">
	<b:glossaryEntry>forming words with letters according to the principles underlying accepted usage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104790511"
	 b:glossaryEntry="a spelling that is incorrect"/>
<rdf:Description rdf:about="&a;104790597">
	<b:glossaryEntry>a system of signals used to represent letters or numbers in transmitting messages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104790774">
	<b:glossaryEntry>a coding system used for transmitting messages requiring brevity or secrecy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104791008">
	<b:glossaryEntry>a number usually of 3 digits assigned to a telephone area as in the US and Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104791145">
	<b:glossaryEntry>code of a series of vertical bars printed on consumer product packages indicating price etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104791316"
	 b:glossaryEntry="system using colors to designate classifications"/>
<rdf:Description rdf:about="&a;104791421"
	 b:glossaryEntry="a piece of writing in code or cipher"/>
<rdf:Description rdf:about="&a;104791545"
	 b:glossaryEntry="a secret method of writing"/>
<rdf:Description rdf:about="&a;104791661">
	<b:glossaryEntry>a telegraph code in which letters and numbers are represented by strings of dots and dashes (short and long signals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104791907">
	<b:glossaryEntry>a code of letters and digits added to a postal address to aid in the sorting of mail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104792090">
	<b:glossaryEntry>(computer science) the symbolic arrangement of data or instructions in a computer program or the set of such instructions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104792458">
	<b:glossaryEntry>(computer science) the code that identifies where a piece of information is stored</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104792613">
	<b:glossaryEntry>(computer science) American Standard Code for Information Interchange; a code for information exchange between computers made by different companies; a string of 7 binary digits represents each character; used in most microcomputers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104792917">
	<b:glossaryEntry>(computer science) 128 characters that make up the ASCII coding scheme; "the ASCII character set is the most universal character coding set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104793123">
	<b:glossaryEntry>code using a string of 8 binary digits to represent characters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104793243">
	<b:glossaryEntry>(computer science) a coding system that incorporates extra parity bits in order to detect errors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104793431">
	<b:glossaryEntry>an error correction code that is recorded in each sector of a magnetic disk and used to catch errors in the data</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104793613">
	<b:glossaryEntry>(computer science) coded instructions that are stored permanently in read-only memory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104793753">
	<b:glossaryEntry>a set of instructions coded so that the computer can use it directly without further translation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104793927">
	<b:glossaryEntry>the machine-language output of a compiler that is ready for execution on a particular computer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104794079">
	<b:glossaryEntry>the portion of a set of operation descriptions that specifies the operation to be performed; the set of operations in a computer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104794281">
	<b:glossaryEntry>program instructions written as an ASCII text file; must be translated by a compiler or interpreter or assembler into the object code for a particular computer before execution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104794515">
	<b:glossaryEntry xml:space='preserve'><![CDATA[letters or symbols written or imprinted on a surface; "he turned the paper over so the writing wouldn''t show"; "the doctor''s writing was illegible"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104794922"
	 b:glossaryEntry="the written form of a word"/>
<rdf:Description rdf:about="&a;104795061">
	<b:glossaryEntry>a word that is written with two letters in an alphabetic writing system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104795185">
	<b:glossaryEntry>a word that is written with three letters in an alphabetic writing system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104795312">
	<b:glossaryEntry>a word that is written with four letters in an alphabetic writing system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104795458">
	<b:glossaryEntry>four Hebrew letters (usually transliterated as YHWH (Yahweh) or JHVH (Jehovah)) signifying the Hebrew name for God (which the Jews regarded as too holy to pronounce)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104795684">
	<b:glossaryEntry>any of several short English words (often having 4 letters) generally regarded as obscene or offensive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104795880"
	 b:glossaryEntry="a writing system using pictographs"/>
<rdf:Description rdf:about="&a;104795976"
	 b:glossaryEntry="a writing system based on alphabetic characters"/>
<rdf:Description rdf:about="&a;104796108">
	<b:glossaryEntry>an ancient writing system: having alternate lines written in opposite directions; literally "as the ox ploughs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104796279">
	<b:glossaryEntry>an ancient wedge-shaped script used in Mesopotamia and Persia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104796414"
	 b:glossaryEntry="a writing system whose characters represent syllables"/>
<rdf:Description rdf:about="&a;104796577">
	<b:glossaryEntry>an undeciphered writing system used in Crete in the 17th century B.C.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104796701"
	 b:glossaryEntry="a syllabic script used in Greece in the 13th century B.C."/>
<rdf:Description rdf:about="&a;104796813"
	 b:glossaryEntry="the use of ideograms in writing"/>
<rdf:Description rdf:about="&a;104796901">
	<b:glossaryEntry>a cursive form of Egyptian hieroglyphics; used especially by the priests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104797046">
	<b:glossaryEntry>a writing system using picture symbols; used in ancient Egypt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104797197">
	<b:glossaryEntry>a system of writing or printing using patterns of raised dots that can be read by touch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104797361">
	<b:glossaryEntry>a point system of writing in which patterns of raised dots represent letters and numerals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104797504">
	<b:glossaryEntry>reading matter; anything expressed in letters of the alphabet (especially when considered from the point of view of style and effect); "the writing in her novels is excellent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104798203">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually plural) the collected work of an author; "the idea occurs with increasing frequency in Hemingway''s writings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104798392">
	<b:glossaryEntry>something that has been written again; "the rewrite was much better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104798536"
	 b:glossaryEntry="imaginative or creative writing"/>
<rdf:Description rdf:about="&a;104798830"
	 b:glossaryEntry="creative writing of recognized artistic value"/>
<rdf:Description rdf:about="&a;104798932">
	<b:glossaryEntry>published writings in a particular style on a particular subject; "the technical literature"; "one aspect of Waterloo has not yet been treated in the literature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104799150">
	<b:glossaryEntry>written material (especially in books or magazines); "he always took some reading matter with him on the plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104799433">
	<b:glossaryEntry>written instructions from a physician or dentist to a druggist concerning the form and dosage of a drug to be issued to a given patient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104799627">
	<b:glossaryEntry>written instructions for an optician on the lenses for a given person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104799755">
	<b:glossaryEntry>verse in which certain letters such as the first in each line form a word or message</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104799894"
	 b:glossaryEntry="creative writing valued for esthetic content"/>
<rdf:Description rdf:about="&a;104800016">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a literary composition in the form of a conversation between two people; "he has read Plato''s Dialogues in the original Greek"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104800206">
	<b:glossaryEntry>an elegant style of prose of the Elizabethan period; characterized by balance and antithesis and alliteration and extended similes with and allusions to nature and mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104800434">
	<b:glossaryEntry>a literary work based on the imagination and not necessarily on fact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104800610"
	 b:glossaryEntry="prose writing that is not fictional"/>
<rdf:Description rdf:about="&a;104800741">
	<b:glossaryEntry>a extended fictional work in prose; usually in the form of a story</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104800949"
	 b:glossaryEntry="a melodramatic paperback novel"/>
<rdf:Description rdf:about="&a;104801053">
	<b:glossaryEntry>fiction with a large amount of fantasy in it; "she made a lot of money writing romantic fantasies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104801234">
	<b:glossaryEntry>literary fantasy involving the imagined impact of science on society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104801364"
	 b:glossaryEntry="a short novel"/>
<rdf:Description rdf:about="&a;104801443">
	<b:glossaryEntry>a novel in which actual persons and events are disguised as fictional characters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104801582">
	<b:glossaryEntry>a novel dealing with idealized events remote from everyday life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104801717">
	<b:glossaryEntry>a romance that deals with desolate and mysterious and grotesque events</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104801848">
	<b:glossaryEntry>a romantic novel containing scenes in which the heroine is sexually violated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104801984">
	<b:glossaryEntry>a French novel in the form of a long chronicle of a family or other social group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104802123">
	<b:glossaryEntry>a piece of fiction that narrates a chain of related events; "he writes stories for the magazines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104802472"
	 b:glossaryEntry="a story of an adventure"/>
<rdf:Description rdf:about="&a;104802607"
	 b:glossaryEntry="a suspenseful adventure story"/>
<rdf:Description rdf:about="&a;104802691">
	<b:glossaryEntry>an narrative telling the adventures of a hero or a family; originally (12th to 14th centuries) a story of the families that settled Iceland and their descendants but now any prose narrative that resembles such an account</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104802962">
	<b:glossaryEntry>a story about a crime (usually murder) presented as a novel or play or movie</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104803137">
	<b:glossaryEntry>a narrative about someone who investigates crimes and obtains evidence leading to their resolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104803297"
	 b:glossaryEntry="a story dealing with love"/>
<rdf:Description rdf:about="&a;104803389"
	 b:glossaryEntry="a story about mythical or supernatural beings or events"/>
<rdf:Description rdf:about="&a;104803505"
	 b:glossaryEntry="a prose narrative shorter than a novel"/>
<rdf:Description rdf:about="&a;104803601"
	 b:glossaryEntry="a short moral story (often with animal characters)"/>
<rdf:Description rdf:about="&a;104803753">
	<b:glossaryEntry>a collection of fables believed to have been written the Greek storyteller Aesop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104803894">
	<b:glossaryEntry>a traditional story accepted as history; serves to explain the world view of a people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104804067">
	<b:glossaryEntry>myth about the ultimate destruction of the gods in a battle with evil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104804232">
	<b:glossaryEntry>(New Testament) any of the stories told by Jesus to convey his religious message; "the parable of the prodigal son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104804401">
	<b:glossaryEntry>the story that is told in a novel or play or movie etc.; "the characters were well drawn but the plot was banal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104804600">
	<b:glossaryEntry>the series of events that form a plot; "his novels always have a lot of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104804732"
	 b:glossaryEntry="the plot of a book or play or film"/>
<rdf:Description rdf:about="&a;104804834">
	<b:glossaryEntry>the decisive moment in a novel or play; "the deathbed scene is the climax of the play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104805006"
	 b:glossaryEntry="a change from a serious subject to a disappointing one"/>
<rdf:Description rdf:about="&a;104805145">
	<b:glossaryEntry>a literary genre that reveals a characters thoughts and feeling by means of a long soliloquy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104805307"
	 b:glossaryEntry="a written evaluation of a work of literature"/>
<rdf:Description rdf:about="&a;104805518">
	<b:glossaryEntry>a method of literary criticism that analyzes details of a text in order to reveal its structure and meaning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104805692">
	<b:glossaryEntry>comparison of a particular text with related materials in order to establish authenticity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104805881"
	 b:glossaryEntry="literary criticism based on close analysis of the text"/>
<rdf:Description rdf:about="&a;104805995">
	<b:glossaryEntry>the study of existing manuscripts of Scriptures to determine the original text</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104806135">
	<b:glossaryEntry>the scientific study of biblical writings to determine their origin and meaning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104806277">
	<b:glossaryEntry>a form of literary criticism in which the structure of a piece of writing is analyzed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104806417"
	 b:glossaryEntry="the literary genre of works intended for the theater"/>
<rdf:Description rdf:about="&a;104806575"
	 b:glossaryEntry="ordinary writing as distinguished from verse"/>
<rdf:Description rdf:about="&a;104806761"
	 b:glossaryEntry="prose that resembles poetry"/>
<rdf:Description rdf:about="&a;104806845">
	<b:glossaryEntry>a rhythmical prose employing the poetic devices of alliteration and assonance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104806985"
	 b:glossaryEntry="literature narrating the lives (and legends) of the saints"/>
<rdf:Description rdf:about="&a;104807099">
	<b:glossaryEntry>a solemn literary work that is the product of laborious cogitation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104807223">
	<b:glossaryEntry>a literary work idealizing the rural life (especially the life of shepherds)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104807372">
	<b:glossaryEntry>a composition written in metrical feet forming rhythmical lines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104807919">
	<b:glossaryEntry>a poem having lines beginning with letters of the alphabet in regular order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104808052">
	<b:glossaryEntry>verse in the meter used in Greek and Latin poetry consisting of strophes of 4 tetrametric lines; reputedly invented by Alcaeus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104808246"
	 b:glossaryEntry="a narrative poem of popular origin"/>
<rdf:Description rdf:about="&a;104808339"
	 b:glossaryEntry="a poem consisting of 3 stanzas and an envoy"/>
<rdf:Description rdf:about="&a;104808436"
	 b:glossaryEntry="unrhymed verse (usually in iambic pentameter)"/>
<rdf:Description rdf:about="&a;104808539">
	<b:glossaryEntry>a witty satiric verse containing two rhymed couplets and mentioning a famous person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104808677">
	<b:glossaryEntry>a stanza consisting of two successive lines of verse; usually rhymed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104808854"
	 b:glossaryEntry="a passionate poem of irregular form"/>
<rdf:Description rdf:about="&a;104808945">
	<b:glossaryEntry>a comic verse of irregular measure; "he had heard some silly doggerel that kept running through his mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104809131"
	 b:glossaryEntry="a short descriptive poem of rural or pastoral life"/>
<rdf:Description rdf:about="&a;104809253"
	 b:glossaryEntry="a mournful poem; a lament for the dead"/>
<rdf:Description rdf:about="&a;104809352"
	 b:glossaryEntry="a long narrative poem telling of a hero''s deeds"/>
<rdf:Description rdf:about="&a;104809577">
	<b:glossaryEntry>an epic in Latin by Virgil; tells the adventures of Aeneas after the Trojan War; provides an illustrious historical background for the Roman Empire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104809777"
	 b:glossaryEntry="unrhymed verse without a consistent metrical pattern"/>
<rdf:Description rdf:about="&a;104809899"
	 b:glossaryEntry="an epigrammatic Japanese verse form of three short lines"/>
<rdf:Description rdf:about="&a;104810007">
	<b:glossaryEntry>a humorous verse form of 5 anapestic lines with a rhyme scheme aabba</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104810130"
	 b:glossaryEntry="a short poem of songlike quality"/>
<rdf:Description rdf:about="&a;104810283">
	<b:glossaryEntry>a French verse form of 10 or 13 lines running on two rhymes; the opening phrase is repeated as the refrain of the second and third stanzas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104810520">
	<b:glossaryEntry>English form of rondeau having three triplets with a refrain after the first and third</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104810660"
	 b:glossaryEntry="a shorter form of rondeau"/>
<rdf:Description rdf:about="&a;104810740">
	<b:glossaryEntry>a verse form consisting of 14 lines with a fixed rhyme scheme</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104810908">
	<b:glossaryEntry>a form of Japanese poetry; the 1st and 3rd lines have five syllables and the 2nd, 4th, and 5th have seven syllables</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104811075"
	 b:glossaryEntry="a verse form with a rhyme scheme: aba bcb cdc, etc."/>
<rdf:Description rdf:about="&a;104811183"
	 b:glossaryEntry="a piece of poetry"/>
<rdf:Description rdf:about="&a;104811314">
	<b:glossaryEntry>a Greek epic poem (attributed to Homer) describing the siege of Troy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104811434">
	<b:glossaryEntry>a Greek epic poem (attributed to Homer) describing the journey of Odysseus after the fall of Troy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104811585"
	 b:glossaryEntry="Old French epic poems"/>
<rdf:Description rdf:about="&a;104811669"
	 b:glossaryEntry="an epic poem adapted for recitation"/>
<rdf:Description rdf:about="&a;104811759">
	<b:glossaryEntry>a sonnet consisting of an octave with the rhyme pattern abbaabba, followed by a sestet with the rhyme pattern cdecde or cdcdcd</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104811966"
	 b:glossaryEntry="a rhythmic group of eight lines of verse"/>
<rdf:Description rdf:about="&a;104812059"
	 b:glossaryEntry="a rhythmic group of six lines of verse"/>
<rdf:Description rdf:about="&a;104812150">
	<b:glossaryEntry>a sonnet consisting three quatrains and a concluding couplet in iambic pentameter with the rhyme pattern abab cdcd efef gg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104812377">
	<b:glossaryEntry>a sonnet consisting of three quatrains and a concluding couplet in iambic pentameter with the rhyme pattern abab bcbd cdcd ee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104812566">
	<b:glossaryEntry>a body of poetry that conveys the traditions of a society by treating some epic theme</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104812702"
	 b:glossaryEntry="a lyric poem with complex stanza forms"/>
<rdf:Description rdf:about="&a;104812844"
	 b:glossaryEntry="an ode with several stanzas"/>
<rdf:Description rdf:about="&a;104812944">
	<b:glossaryEntry>an ode form used by Pindar; has triple groups of triple units</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104813075"
	 b:glossaryEntry="ode sung by the chorus in classical Greek drama"/>
<rdf:Description rdf:about="&a;104813179"
	 b:glossaryEntry="a major division of a long poem"/>
<rdf:Description rdf:about="&a;104813281"
	 b:glossaryEntry="a fixed number of lines of verse forming a unit of a poem"/>
<rdf:Description rdf:about="&a;104813590"
	 b:glossaryEntry="a brief stanza concluding certain forms of poetry"/>
<rdf:Description rdf:about="&a;104813699"
	 b:glossaryEntry="a stanza of four lines"/>
<rdf:Description rdf:about="&a;104813812"
	 b:glossaryEntry="a quatrain in iambic pentameter with abab rhyme scheme"/>
<rdf:Description rdf:about="&a;104813927"
	 b:glossaryEntry="a line of metrical text"/>
<rdf:Description rdf:about="&a;104814178"
	 b:glossaryEntry="a verse line consisting of iambs"/>
<rdf:Description rdf:about="&a;104814263">
	<b:glossaryEntry>a verse line with a dactyl followed by a spondee or trochee; used in laments by Adonis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104814416">
	<b:glossaryEntry>a short verse said or sung by a priest or minister in public worship and followed by a response from the congregation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104814606">
	<b:glossaryEntry>(Roman Catholic Church) a Latin versicle meaning "lift up your hearts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104814735">
	<b:glossaryEntry>a phrase recited or sung by the congregation following a versicle by the priest or minister</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104814881"
	 b:glossaryEntry="a rhymed couplet that forms a complete syntactic unit"/>
<rdf:Description rdf:about="&a;104814995"
	 b:glossaryEntry="a couplet written in an elevated style"/>
<rdf:Description rdf:about="&a;104815094">
	<b:glossaryEntry>a quatrain written in elevated style; the rhyme scheme is abab</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104815217">
	<b:glossaryEntry>a verse form suited to the treatment of heroic or elevated themes; dactylic hexameter or iambic pentameter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104815383">
	<b:glossaryEntry>a stanza with eight lines of iambic pentameter and a concluding Alexandrine with the rhyme pattern abab bcbc c; "the spenserian stanza was introduced by Edmund Spenser in The Faerie Queene"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104815636">
	<b:glossaryEntry>one section of a lyric poem or choral ode in classical Greek drama</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104815775">
	<b:glossaryEntry>the section of a choral ode answering a previous strophe in classical Greek drama; the second of two metrically corresponding sections in a poem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104815996">
	<b:glossaryEntry>a literary composition of poor quality that was written quickly to make money (to boil the pot)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104816147">
	<b:glossaryEntry>writing of poor quality; characterized by affected choice of archaic words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104816275">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the words of something written; "there were more than a thousand words of text"; "they handed out the printed text of the mayor''s speech"; "he wants to reconstruct the original text"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104816802">
	<b:glossaryEntry>the main body of a written work (as distinct from illustrations or footnotes etc.); "pictures made the text easier to understand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104816982">
	<b:glossaryEntry>text that is in a form that a computer can store and display on a computer screen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104817161">
	<b:glossaryEntry>electronic text that is stored and used in the form of a digital image</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104817302">
	<b:glossaryEntry>electronic text that is stored as strings of characters and that can be displayed in a variety of formats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104817493">
	<b:glossaryEntry>typewritten matter especially a typewritten copy of a manuscript</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104817614"
	 b:glossaryEntry="the blank space that surrounds the text on a page"/>
<rdf:Description rdf:about="&a;104817735"
	 b:glossaryEntry='a blank area; "write your name in the space provided"'/>
<rdf:Description rdf:about="&a;104817917">
	<b:glossaryEntry>the space left between the margin and the start of an indented line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104818063"
	 b:glossaryEntry="the order of words in a text"/>
<rdf:Description rdf:about="&a;104818167"
	 b:glossaryEntry="a clean copy of a corrected draft"/>
<rdf:Description rdf:about="&a;104818256"
	 b:glossaryEntry="matter to be printed; exclusive of graphical materials"/>
<rdf:Description rdf:about="&a;104818414"
	 b:glossaryEntry="written matter preceding the main text of a book"/>
<rdf:Description rdf:about="&a;104818531"
	 b:glossaryEntry="written matter following the main text of a book"/>
<rdf:Description rdf:about="&a;104818688"
	 b:glossaryEntry="preliminary version of a written work"/>
<rdf:Description rdf:about="&a;104818790">
	<b:glossaryEntry>text that is typed or printed on paper; "he ran off a hard copy of the report"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104818924"
	 b:glossaryEntry="a part of a published serial"/>
<rdf:Description rdf:about="&a;104819060"
	 b:glossaryEntry="an installment of a printed work"/>
<rdf:Description rdf:about="&a;104819171">
	<b:glossaryEntry>a self-contained part of a larger composition; "he always turns first to the business section"; "the history of this work is discussed in the next section"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104819646"
	 b:glossaryEntry="the section of a newspaper that reports on sports"/>
<rdf:Description rdf:about="&a;104819775">
	<b:glossaryEntry>a separate section of a legal document (as a statute or contract or will)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104819984">
	<b:glossaryEntry>a clause in a contract providing for arbitration of disputes arising under the contract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104820155">
	<b:glossaryEntry>a clause in an insurance policy that relieves the insurer of responsibility to pay the initial loss up to a stated amount</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104820333"
	 b:glossaryEntry="a clause that is appended to a legislative bill"/>
<rdf:Description rdf:about="&a;104820470">
	<b:glossaryEntry>the central message of a communication; "the body of the message was short"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104820634">
	<b:glossaryEntry>a major division of a long written composition; "the book of Isaiah"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104821096">
	<b:glossaryEntry>a subdivision of a written work; usually numbered and titled; "he read a chapter every night before falling asleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104821284">
	<b:glossaryEntry>a brief section of a literary or dramatic work that forms part of a connected series</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104821422">
	<b:glossaryEntry>a section of an entertainment that is assigned to a specific performer or performance; "they changed his spot on the progam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104821597">
	<b:glossaryEntry>a short section or illustration (as between radio or tv programs or in a magazine) that is often used for advertising</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104821765">
	<b:glossaryEntry>a folded section placed between the leaves of another publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104821883"
	 b:glossaryEntry="the first section of a communication"/>
<rdf:Description rdf:about="&a;104822088">
	<b:glossaryEntry>the initial part of the introduction; "the opening established the basic theme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104822239"
	 b:glossaryEntry="word of greeting used to begin a letter"/>
<rdf:Description rdf:about="&a;104822335"
	 b:glossaryEntry="a short introductory essay preceding the text of a book"/>
<rdf:Description rdf:about="&a;104822486">
	<b:glossaryEntry>a preliminary introduction to a statute or constitution (usually explaining its purpose)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104822648">
	<b:glossaryEntry>the last section of a communication; "in conclusion I want to say..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104822935">
	<b:glossaryEntry>a short passage added at the end of a literary work; "the epilogue told what eventually happened to the main characters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104823138">
	<b:glossaryEntry>a short speech (often in verse) addressed directly to the audience by an actor at the end of a play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104823319">
	<b:glossaryEntry>(rhetoric) the concluding section of an oration; "he summarized his main points in his peroration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104823493">
	<b:glossaryEntry>supplementary material that is collected and appended at the back of a book</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104823659"
	 b:glossaryEntry="a part added to a book or play that continues and extends it"/>
<rdf:Description rdf:about="&a;104823787">
	<b:glossaryEntry>textual matter that is added onto a publication; usually at the end</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104823990"
	 b:glossaryEntry="a brief addendum at the end of a newspaper article"/>
<rdf:Description rdf:about="&a;104824115">
	<b:glossaryEntry>one of several distinct subdivisions of a text intended to separate ideas; the beginning is usually marked by a new indented line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104824319"
	 b:glossaryEntry="particularly a section of medium length"/>
<rdf:Description rdf:about="&a;104824539">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a passage selected from a larger work; "he presented exerpts from William James'' philosophical writings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104824773"
	 b:glossaryEntry="an authoritative and often-quoted passage"/>
<rdf:Description rdf:about="&a;104824876">
	<b:glossaryEntry>the passage that is being read; "he lost his place on the page"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104824991"
	 b:glossaryEntry="a passage full of ornate and flowery language"/>
<rdf:Description rdf:about="&a;104825097"
	 b:glossaryEntry="a passage that connects a topic to one that follows"/>
<rdf:Description rdf:about="&a;104825277">
	<b:glossaryEntry>a transition (in literary or theatrical works or films) to an earlier event or scene</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104825417">
	<b:glossaryEntry>a daily written record of (usually personal) experiences and observations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104825552"
	 b:glossaryEntry="writing in capital letters"/>
<rdf:Description rdf:about="&a;104825639"
	 b:glossaryEntry="writing done with a typewriter"/>
<rdf:Description rdf:about="&a;104825808"
	 b:glossaryEntry="typing that leaves alternate lines blank"/>
<rdf:Description rdf:about="&a;104825909"
	 b:glossaryEntry="typing that does not leave lines blank"/>
<rdf:Description rdf:about="&a;104826008"
	 b:glossaryEntry="typing that leaves two lines blank between lines of typing"/>
<rdf:Description rdf:about="&a;104826127">
	<b:glossaryEntry>typewriting in which the fingers are trained to hit particular keys; typist can read and type at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104826311"
	 b:glossaryEntry="text written in the style of printed matter"/>
<rdf:Description rdf:about="&a;104826409">
	<b:glossaryEntry>something written by hand; "she recognized his handwriting"; "his hand was illegible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104826640">
	<b:glossaryEntry>writing that resembles hieroglyphics (usually by being illegible)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104826777"
	 b:glossaryEntry="writing formed in the sky by smoke released from an airplane"/>
<rdf:Description rdf:about="&a;104826894"
	 b:glossaryEntry="beautiful handwriting"/>
<rdf:Description rdf:about="&a;104826986"
	 b:glossaryEntry="poor handwriting"/>
<rdf:Description rdf:about="&a;104827107"
	 b:glossaryEntry="an illegible scrawl"/>
<rdf:Description rdf:about="&a;104827181"
	 b:glossaryEntry="your name written in your own handwriting"/>
<rdf:Description rdf:about="&a;104827368"
	 b:glossaryEntry="a signature made by one person for another"/>
<rdf:Description rdf:about="&a;104827466"
	 b:glossaryEntry="a person''s own signature"/>
<rdf:Description rdf:about="&a;104827561">
	<b:glossaryEntry>a second confirming signature endorsing a document already signed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104827703"
	 b:glossaryEntry="a signature that endorses something"/>
<rdf:Description rdf:about="&a;104827814">
	<b:glossaryEntry>an endorsement on commercial paper naming no payee and so payable to the bearer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104827980"
	 b:glossaryEntry="the signature of a sovereign on an official document"/>
<rdf:Description rdf:about="&a;104828090"
	 b:glossaryEntry="letters inscribed on something"/>
<rdf:Description rdf:about="&a;104828280">
	<b:glossaryEntry>an inscription of a black basalt stone; gave first clue to decipherment of Egyptian hieroglyphics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104828437"
	 b:glossaryEntry="an inscription written above something else"/>
<rdf:Description rdf:about="&a;104828541">
	<b:glossaryEntry>an inscription (as in a book or musical work) dedicating it to someone or something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104828681"
	 b:glossaryEntry="an engraved inscription"/>
<rdf:Description rdf:about="&a;104828759">
	<b:glossaryEntry>an inscription on a tombstone or monument in memory of the person buried there</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104828891"
	 b:glossaryEntry="a summary statement of commemoration for a dead person"/>
<rdf:Description rdf:about="&a;104828999"
	 b:glossaryEntry="the form of a literary work submitted for publication"/>
<rdf:Description rdf:about="&a;104829114"
	 b:glossaryEntry="something written by one''s own hand"/>
<rdf:Description rdf:about="&a;104829223"
	 b:glossaryEntry="handwritten book or document"/>
<rdf:Description rdf:about="&a;104829374"
	 b:glossaryEntry="an unbound manuscript of some ancient classic"/>
<rdf:Description rdf:about="&a;104829471">
	<b:glossaryEntry>a manuscript (usually written on papyrus or parchment) on which more than one text has been written with the earlier writing incompletely erased and still visible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104829690"
	 b:glossaryEntry="a document that can be rolled up (as for storage)"/>
<rdf:Description rdf:about="&a;104829817">
	<b:glossaryEntry>a collection of written scrolls (containing nearly all of the Old Testament) found in a cave near the Dead Sea in the late 1940s; "the Dead Sea Scrolls provide information about Judaism and the Bible around the time of Jesus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104830105"
	 b:glossaryEntry="a formal exposition"/>
<rdf:Description rdf:about="&a;104830233">
	<b:glossaryEntry>a written work (as a novel) that has been recast in a new form: "the play is an adaptation of a short novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104830408">
	<b:glossaryEntry>a treatise advancing a new point of view resulting from research; usually a requirement for an advanced academic degree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104830595">
	<b:glossaryEntry>a brief treatise on a subject of interest; published in the form of a booklet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104830735"
	 b:glossaryEntry="a detailed and documented treatise on a particular subject"/>
<rdf:Description rdf:about="&a;104830849"
	 b:glossaryEntry="an analytic or interpretive literary composition"/>
<rdf:Description rdf:about="&a;104831003">
	<b:glossaryEntry>an essay (especially one written as an assignment); "he got an A on his composition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104831170"
	 b:glossaryEntry="an elaborate analytical or explanatory essay or discussion"/>
<rdf:Description rdf:about="&a;104831287"
	 b:glossaryEntry="an essay on a scientific or scholarly topic"/>
<rdf:Description rdf:about="&a;104831383">
	<b:glossaryEntry>an essay or article that gives a critical evaluation (as of a book or play)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104831593">
	<b:glossaryEntry>a critical review of a book (usually a recently published book)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104831714"
	 b:glossaryEntry='a short critical review; "the play received good notices"'/>
<rdf:Description rdf:about="&a;104831824">
	<b:glossaryEntry>a copy of a written work or composition that has been published (printed on pages bound together); "I am reading a good book on economics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104832357">
	<b:glossaryEntry>an authoritative written work; "this book is the final authority on the life of Milton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104832500">
	<b:glossaryEntry>a book by Sir Thomas More (1516) describing the perfect society on an imaginary island</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104832658"
	 b:glossaryEntry="a book intended for general readership"/>
<rdf:Description rdf:about="&a;104832805"
	 b:glossaryEntry="a book that has had a large and rapid sale"/>
<rdf:Description rdf:about="&a;104832905">
	<b:glossaryEntry>a medieval book (usually illustrated) with allegorical and amusing descriptions of real and fabled animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104833066">
	<b:glossaryEntry>an elementary book summarizing the principles of a Christian religion; written as questions and answers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104833225"
	 b:glossaryEntry="a book of recipes and cooking directions"/>
<rdf:Description rdf:about="&a;104833335">
	<b:glossaryEntry>a book of directions for using or operating some piece of equipment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104833465"
	 b:glossaryEntry="a (usually) large and scholarly book"/>
<rdf:Description rdf:about="&a;104833552">
	<b:glossaryEntry>a publication that is one of a set of several similar publications; "the third volume was missing"; "he asked for the 1989 volume of the Annual Review"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104833775"
	 b:glossaryEntry="a small book usually having a paper cover"/>
<rdf:Description rdf:about="&a;104833947">
	<b:glossaryEntry>a blue-covered booklet used in universities for writing examinations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104834071"
	 b:glossaryEntry="a book of tickets that can be torn out and used"/>
<rdf:Description rdf:about="&a;104834176">
	<b:glossaryEntry>a book prepared for use in schools or colleges; "his economics textbook is in its tenth edition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104834466"
	 b:glossaryEntry="a textbook designed for cramming"/>
<rdf:Description rdf:about="&a;104834552"
	 b:glossaryEntry="a basic or elementary instructional text"/>
<rdf:Description rdf:about="&a;104834651"
	 b:glossaryEntry="an introductory textbook"/>
<rdf:Description rdf:about="&a;104834728"
	 b:glossaryEntry="one of a series of texts for students learning to read"/>
<rdf:Description rdf:about="&a;104834835"
	 b:glossaryEntry="a book with blank pages for recording notes or memoranda"/>
<rdf:Description rdf:about="&a;104834982"
	 b:glossaryEntry="a notebook in which you enter memorabilia"/>
<rdf:Description rdf:about="&a;104835086"
	 b:glossaryEntry="a small notebook for rough notes"/>
<rdf:Description rdf:about="&a;104835171">
	<b:glossaryEntry>a student''s book or booklet containing problems with spaces for solving them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104835302">
	<b:glossaryEntry>a book containing models of good penmanship; used in teaching penmanship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104835429">
	<b:glossaryEntry>a book containing a calendar and space to keep a record of appointments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104835586">
	<b:glossaryEntry>a book or pamphlet containing an enumeration of things; "he found it in the Sears catalog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104835760">
	<b:glossaryEntry>a book containing common expressions in a foreign language along with their translations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104835906"
	 b:glossaryEntry="a book containing prayers"/>
<rdf:Description rdf:about="&a;104836043">
	<b:glossaryEntry>(Roman Catholic Church) a book of prayers to be recited daily certain priests and members of religious orders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104836207">
	<b:glossaryEntry>(Roman Catholic Church) a book containing all the prayers and responses needed to celebrate Mass throughout the year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104836376"
	 b:glossaryEntry="a collection of Psalms for liturgical use"/>
<rdf:Description rdf:about="&a;104836507">
	<b:glossaryEntry>a book to which you can refer for authoritative facts; "he contributed articles to the basic reference work on that topic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104836897">
	<b:glossaryEntry>a copy of a newly published book that is sent for review to a writer or periodical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104837037"
	 b:glossaryEntry="a book containing a collection of songs"/>
<rdf:Description rdf:about="&a;104837149"
	 b:glossaryEntry="a songbook containing a collection of hymns"/>
<rdf:Description rdf:about="&a;104837266">
	<b:glossaryEntry>a cylinder with Tibetan Buddhist prayers written on it; each revolution counts as uttering prayers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104837423">
	<b:glossaryEntry>a collection of historically important documents published together as a book</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104837558">
	<b:glossaryEntry>a reference book containing words (usually with their meanings)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104837766">
	<b:glossaryEntry>a reference book containing an alphabetical list of words with information about them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104838081"
	 b:glossaryEntry="a dictionary giving equivalent words in two languages"/>
<rdf:Description rdf:about="&a;104838201">
	<b:glossaryEntry>an abridged dictionary of a size convenient to hold in the hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104838350"
	 b:glossaryEntry="a dictionary giving the historical origins of each word"/>
<rdf:Description rdf:about="&a;104838475"
	 b:glossaryEntry="a geographical dictionary (as at the back of an atlas)"/>
<rdf:Description rdf:about="&a;104838604">
	<b:glossaryEntry>a dictionary specially written for those learning a foreign language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104838759"
	 b:glossaryEntry="a dictionary that is small enough to carry in your pocket"/>
<rdf:Description rdf:about="&a;104838900">
	<b:glossaryEntry>an electronic dictionary in a word processor that can be used to catch misspelled words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104839066"
	 b:glossaryEntry="a dictionary that is claimed to be complete"/>
<rdf:Description rdf:about="&a;104839177"
	 b:glossaryEntry="a list of proper nouns naming persons or places"/>
<rdf:Description rdf:about="&a;104839282"
	 b:glossaryEntry="a listing of the words used in some enterprise"/>
<rdf:Description rdf:about="&a;104839385">
	<b:glossaryEntry>an alphabetical list of technical terms in some specialized field of knowledge; usually published as an appendix to a text on that field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104839584"
	 b:glossaryEntry="a book of synonyms"/>
<rdf:Description rdf:about="&a;104839693">
	<b:glossaryEntry>a thesaurus organized to help you find the word you want but cannot think of</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104839827">
	<b:glossaryEntry>a concise reference book providing specific information about a subject or location</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104840046"
	 b:glossaryEntry="a small handbook"/>
<rdf:Description rdf:about="&a;104840187">
	<b:glossaryEntry>a manual describing the customs of a particular group (especially the ceremonial practices of a monastic order)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104840375"
	 b:glossaryEntry="a manual of black magic (for invoking spirits and demons)"/>
<rdf:Description rdf:about="&a;104840487">
	<b:glossaryEntry>a manual usually accompanying a technical device and explaining how to install or operate it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104840707">
	<b:glossaryEntry>a manual containing information organized in a summary manner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104840831"
	 b:glossaryEntry="a book regarded as authoritative in its field"/>
<rdf:Description rdf:about="&a;104840928"
	 b:glossaryEntry="something that offers basic information or instruction"/>
<rdf:Description rdf:about="&a;104841082">
	<b:glossaryEntry>a guidebook describing the roads of a country; contains maps and (sometimes) a gazetteer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104841225">
	<b:glossaryEntry>any of a series of travel guidebooks published by the German firm founded by Karl Baedeker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104841370"
	 b:glossaryEntry="a guidebook for travelers"/>
<rdf:Description rdf:about="&a;104841488"
	 b:glossaryEntry="an alphabetical list of names and addresses"/>
<rdf:Description rdf:about="&a;104841623">
	<b:glossaryEntry>a directory containing an alphabetical list of telephone subscribers and their telephone numbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104841846">
	<b:glossaryEntry>a numeral or string of numerals that is used for identification; "she refused to give them her Social Security number"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104842095">
	<b:glossaryEntry>a card on which are printed the person''s name and business affiliation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104842225">
	<b:glossaryEntry>a two-part code assigned to banks and savings associations; the first part shows the location and the second identifies the bank itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104842460">
	<b:glossaryEntry>the number on the license plate that identifies the car that bears it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104842612">
	<b:glossaryEntry>the number of a particular individual''s social security account</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104842744">
	<b:glossaryEntry>the number is used in calling a particular phone; "he has an unlisted number"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104842908">
	<b:glossaryEntry>an annual publication containing tabular information in a particular field or fields arranged according to the calendar of a given year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104843097"
	 b:glossaryEntry="a reference book that is published regularly once every year"/>
<rdf:Description rdf:about="&a;104843275">
	<b:glossaryEntry>an annual publication including weather forecasts and other miscellaneous information arranged according to the calendar of a given year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104843485">
	<b:glossaryEntry>an annual publication containing tables that give the positions of the celestial bodies throughout the year; "today computers calculate the ephemerides"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104843693"
	 b:glossaryEntry="a collection of maps in book form"/>
<rdf:Description rdf:about="&a;104843847">
	<b:glossaryEntry>an atlas showing the distribution of distinctive linguistic features</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104843994">
	<b:glossaryEntry>a reference work (often in several volumes) containing articles on various topics (often arranged in alphabetical order) dealing with the entire range of human knowledge or with some particular specialty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104844317"
	 b:glossaryEntry="an elementary encyclopedia dealing with general knowledge"/>
<rdf:Description rdf:about="&a;104844438"
	 b:glossaryEntry="putting something (as a literary work) into publishable form"/>
<rdf:Description rdf:about="&a;104844636">
	<b:glossaryEntry>putting something (as a literary work) into suitable form for a printer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104844766">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the part that is omitted when an editorial change shortens a written passage; "an editor''s deletions frequently upset young authors"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104844959"
	 b:glossaryEntry="something substituted for an error"/>
<rdf:Description rdf:about="&a;104845068"
	 b:glossaryEntry="correction by erasing"/>
<rdf:Description rdf:about="&a;104845143"
	 b:glossaryEntry="editing that involves writing something again"/>
<rdf:Description rdf:about="&a;104845291"
	 b:glossaryEntry="the act of rewriting something"/>
<rdf:Description rdf:about="&a;104845406"
	 b:glossaryEntry="changing a particular word or phrase"/>
<rdf:Description rdf:about="&a;104845541"
	 b:glossaryEntry="rewording for the purpose of clarification"/>
<rdf:Description rdf:about="&a;104845672"
	 b:glossaryEntry="rewording something in less technical terminology"/>
<rdf:Description rdf:about="&a;104845779"
	 b:glossaryEntry="writing that is venerated for the worship of a deity"/>
<rdf:Description rdf:about="&a;104846339"
	 b:glossaryEntry="a long piece of writing"/>
<rdf:Description rdf:about="&a;104846415"
	 b:glossaryEntry="any writing that is regarded as sacred by a religious group"/>
<rdf:Description rdf:about="&a;104846548">
	<b:glossaryEntry>a collection of books accepted as holy scripture especially the books of the Bible recognized by any Christian church as genuine and inspired</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104846741"
	 b:glossaryEntry="sacred text of Zoroastrianism"/>
<rdf:Description rdf:about="&a;104846837">
	<b:glossaryEntry>(Hinduism) the sacred `song of God'' composed about 200 BC and incorporated into the Mahabharata (a Sanskrit epic); contains a discussion between Krishna and the Indian hero Arjuna on human nature and the purpose of life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104847135">
	<b:glossaryEntry>(Hinduism) a sacred epic Sanskrit poem of India dealing in many episodes with the struggle between two rival families</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104847359">
	<b:glossaryEntry>the sacred writings of the Christian religion; "he went to carry the Word to the heathen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104847802">
	<b:glossaryEntry>the first book of the Old Testament: tells of creation; Adam and Eve; the Fall of Man; Cain and Abel; Noah and the flood; God''s covenant with Abraham; Abraham and Isaac; Jacob and Esau; Joseph and his brothers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104848084">
	<b:glossaryEntry>the second book of the Old Testament: tells of the departure of the Israelites out of slavery in Egypt led by Moses; God gave them the Ten Commandments and the rest of Mosaic law on Mount Sinai during the Exodus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104848367">
	<b:glossaryEntry>the third book of the Old Testament; contains Levitical law and ritual precedents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104848523">
	<b:glossaryEntry>the fourth book of the Old Testament; contains a record of the number of Israelites who followed Moses out of Egypt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104848711">
	<b:glossaryEntry>the fifth book of the Old Testament; contains a second statement of Mosaic Law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104848866">
	<b:glossaryEntry>a book in the Old Testament describing how Joshua led the Israelites into Canaan (the Promised Land) after the death of Moses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104849063">
	<b:glossaryEntry>a book of the Old Testament that tells the history of Israel under the leaders known as judges</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104849229">
	<b:glossaryEntry>a book of the Old Testament that tells the story of Ruth who was not an Israelite but who married and Israelite and who stayed with her mother-in-law Naomi after her husband died</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104849477">
	<b:glossaryEntry>a book in the Old Testament containing the oracles of the prophet Jeremiah</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104849625">
	<b:glossaryEntry>a book in the Old Testament that tells the story of Jonah and the whale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104849767">
	<b:glossaryEntry>a book in the Old Testament containing Job''s pleas to God about his afflictions and God''s reply</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104849931">
	<b:glossaryEntry>a book of the Old Testament that tells how Esther saved her people from massacre</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104850084">
	<b:glossaryEntry>one of the Gospels in the New Testament; includes the Sermon on the Mount</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104850278"
	 b:glossaryEntry="the shortest of the four Gospels in the New Testament"/>
<rdf:Description rdf:about="&a;104850446">
	<b:glossaryEntry>one of the four Gospels in the New Testament; contains details of Jesus''s birth and early life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104850655"
	 b:glossaryEntry="the last of the four Gospels in the New Testament"/>
<rdf:Description rdf:about="&a;104850819"
	 b:glossaryEntry="a large Bible with pages to record marriages and births"/>
<rdf:Description rdf:about="&a;104850933"
	 b:glossaryEntry="the pre-Christian Greek version of the Old Testament"/>
<rdf:Description rdf:about="&a;104851042"
	 b:glossaryEntry="the Latin version of the Bible used by Roman Catholics"/>
<rdf:Description rdf:about="&a;104851150">
	<b:glossaryEntry>an English translation of the Vulgate by Roman Catholic scholars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104851376"
	 b:glossaryEntry="an English translation of the Bible published in 1611"/>
<rdf:Description rdf:about="&a;104851515"
	 b:glossaryEntry="a British revision of the Authorized Version"/>
<rdf:Description rdf:about="&a;104851621"
	 b:glossaryEntry="a modern English version of the Bible and Apocrypha"/>
<rdf:Description rdf:about="&a;104851736"
	 b:glossaryEntry="a revised version of the King James Version"/>
<rdf:Description rdf:about="&a;104851878"
	 b:glossaryEntry="a revision of the American Standard Version"/>
<rdf:Description rdf:about="&a;104851992">
	<b:glossaryEntry>the collection of books comprising the sacred Scripture of the Hebrews and recording their history as the chosen people; the first half of the Christian Bible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104852475">
	<b:glossaryEntry>the first of three divisions of the Hebrew Scriptures comprising the first five books of the Old Testament considered as a unit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104852788"
	 b:glossaryEntry="the second of three divisions of the Hebrew Scriptures"/>
<rdf:Description rdf:about="&a;104852916"
	 b:glossaryEntry="the third of three divisions of the Hebrew Scriptures"/>
<rdf:Description rdf:about="&a;104853057"
	 b:glossaryEntry="either of the two main parts of the Christian Bible"/>
<rdf:Description rdf:about="&a;104853183">
	<b:glossaryEntry>the collection of books of the Gospels, Acts of the Apostles, Pauline and other Epistles, and Revelation; composed soon after Christ''s death; the second half of the Christian Bible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104853575">
	<b:glossaryEntry>four books in the New Testament that tell the story of Christ''s life and teachings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104853839"
	 b:glossaryEntry="the message of the gospel of Christ"/>
<rdf:Description rdf:about="&a;104853932"
	 b:glossaryEntry="a book of the New Testament"/>
<rdf:Description rdf:about="&a;104854052"
	 b:glossaryEntry="revelations of Saint John the Divine in the New Testament"/>
<rdf:Description rdf:about="&a;104854198">
	<b:glossaryEntry>revealed to Joseph Smith in 1830 by an ancient prophet Mormon; supposedly a record of ancient peoples of America translated by Joseph Smith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104854419"
	 b:glossaryEntry="a fixed text used in praying"/>
<rdf:Description rdf:about="&a;104854626">
	<b:glossaryEntry>a prayer said 3 times a day by Roman Catholics in memory of the Annunciation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104854756"
	 b:glossaryEntry="a salutation to the Virgin Mary now used in prayers to Her"/>
<rdf:Description rdf:about="&a;104854882"
	 b:glossaryEntry="the prayer of Simeon; Luke 2:29-32"/>
<rdf:Description rdf:about="&a;104854997">
	<b:glossaryEntry>(Anglican Church) a daily evening service with prayers prescribed in the Book of Common Prayer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104855163"
	 b:glossaryEntry="the opening prayer on the eve of Yom Kippur"/>
<rdf:Description rdf:about="&a;104855262"
	 b:glossaryEntry="a book setting forth the forms of church service"/>
<rdf:Description rdf:about="&a;104855387">
	<b:glossaryEntry>the Anglican service book of the Church of England; has had several revisions since the Reformation and is widely admired for the dignity and beauty of its language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104855657">
	<b:glossaryEntry>a prayer consisting of a series of invocations by the priest with responses from the congregation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104855826">
	<b:glossaryEntry>the prayer that Christ gave his disciples in the Sermon on the Mount (Matthew 6:9-13)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104856008">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(Roman Catholic) the Lord''s Prayer in Latin; translates as "our father"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104856137">
	<b:glossaryEntry>14 books of the Old Testament included in the Vulgate but omitted in Jewish and Protestant versions of the Bible</b:glossaryEntry>
</rdf:Description>
