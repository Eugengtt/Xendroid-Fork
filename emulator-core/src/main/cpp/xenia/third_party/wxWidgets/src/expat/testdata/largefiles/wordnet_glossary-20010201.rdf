</rdf:Description>
<rdf:Description rdf:about="&a;101388755"
	 b:glossaryEntry="a genus of Tachyglossidae"/>
<rdf:Description rdf:about="&a;101388892"
	 b:glossaryEntry="New Guinea echidnas"/>
<rdf:Description rdf:about="&a;101389012"
	 b:glossaryEntry="platypus"/>
