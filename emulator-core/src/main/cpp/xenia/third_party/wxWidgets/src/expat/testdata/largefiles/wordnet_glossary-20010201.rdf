</rdf:Description>
<rdf:Description rdf:about="&a;110300803"
	 b:glossaryEntry="inflammation of the tonsils"/>
<rdf:Description rdf:about="&a;110300888"
	 b:glossaryEntry="inflammation of the trachea"/>
<rdf:Description rdf:about="&a;110300972"
	 b:glossaryEntry="inflammation of the gums"/>
<rdf:Description rdf:about="&a;110301049"
	 b:glossaryEntry="inflammation of the ureter"/>
<rdf:Description rdf:about="&a;110301132"
	 b:glossaryEntry="inflammation of the uvea of the eye"/>
<rdf:Description rdf:about="&a;110301221"
	 b:glossaryEntry="inflammation of the uvula"/>
<rdf:Description rdf:about="&a;110301301">
	<b:glossaryEntry>inflammation of the vagina (usually associated with candidiasis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110301440"
	 b:glossaryEntry="inflammation of a cardiac valve"/>
<rdf:Description rdf:about="&a;110301528"
	 b:glossaryEntry="inflammation of a blood vessel"/>
<rdf:Description rdf:about="&a;110301615">
	<b:glossaryEntry>inflammation of a seminal vesicle (usually in conjunction with prostatitis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110301748"
	 b:glossaryEntry="inflammation of the vulva"/>
<rdf:Description rdf:about="&a;110301828"
	 b:glossaryEntry="symptom of coldness"/>
<rdf:Description rdf:about="&a;110301947">
	<b:glossaryEntry>sudden expulsion of air from the lungs that clears the air passages; a common symptom of upper respiratory infection or bronchitis or pneumonia or tuberculosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110302188">
	<b:glossaryEntry>(usually plural) the state of having involuntary spasms of the diaphragm accompanied by a rapid closure of the glottis; sometimes a symptom of indigestion; "how do you cure the hiccups?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110302438">
	<b:glossaryEntry>symptoms that mimic those of meningitis but without inflammation of the meninges</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110302574"
	 b:glossaryEntry="the state that precedes vomiting"/>
<rdf:Description rdf:about="&a;110302724">
	<b:glossaryEntry>nausea early in the day; a characteristic symptom in the early months of pregnancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110302888"
	 b:glossaryEntry="a mild state of nausea"/>
<rdf:Description rdf:about="&a;110302991"
	 b:glossaryEntry="a painful and involuntary muscular contraction"/>
<rdf:Description rdf:about="&a;110303169">
	<b:glossaryEntry>(colloquial) a muscular cramp (especially in the thigh or calf) following vigorous exercise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110303319">
	<b:glossaryEntry>muscular spasms of thumb and forefinger while writing with a pen or pencil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110303454">
	<b:glossaryEntry>a painful muscle spasm especially in the neck or back (`rick'' and `wrick'' are British)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110303607"
	 b:glossaryEntry="a sudden spasm especially one caused by a nervous condition"/>
<rdf:Description rdf:about="&a;110303785"
	 b:glossaryEntry="a local and habitual twitching especially in the face"/>
<rdf:Description rdf:about="&a;110303888">
	<b:glossaryEntry>muscular twitching involving individual muscle fibers acting without coordination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110304064"
	 b:glossaryEntry="fibrillation of the muscles of the atria of the heart"/>
<rdf:Description rdf:about="&a;110304201"
	 b:glossaryEntry="abnormally slow heartbeat"/>
<rdf:Description rdf:about="&a;110304284">
	<b:glossaryEntry>recurrent sudden attacks of unconsciousness caused by impaired conduction of the impulse that regulates the heartbeat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110304532"
	 b:glossaryEntry="abnormally rapid heartbeat"/>
<rdf:Description rdf:about="&a;110304616">
	<b:glossaryEntry>fibrillation of heart muscles resulting in interference with rhythmic contractions of the ventricles and possibly leading to cardiac arrest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110304844"
	 b:glossaryEntry="an abnormal rate of muscle contractions in the heart"/>
<rdf:Description rdf:about="&a;110305051"
	 b:glossaryEntry="muscular twitching of contiguous groups of muscle fibers"/>
<rdf:Description rdf:about="&a;110305167"
	 b:glossaryEntry="a mark left by the healing of injured tissue"/>
<rdf:Description rdf:about="&a;110305321"
	 b:glossaryEntry="bony tissue formed during the healing of a fractured bone"/>
<rdf:Description rdf:about="&a;110305449"
	 b:glossaryEntry="a scar from a cut made by a sword"/>
<rdf:Description rdf:about="&a;110305538"
	 b:glossaryEntry="abnormal hardening or thickening of tissue"/>
<rdf:Description rdf:about="&a;110305672">
	<b:glossaryEntry>an area of skin that is thick or hard from continual pressure or friction (as the sole of the foot)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110305854">
	<b:glossaryEntry>a hard thickening of the skin (especially of the toes) caused by the pressure of ill-fitting shoes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110306012"
	 b:glossaryEntry="tissue hardened by deposition of lime salts"/>
<rdf:Description rdf:about="&a;110306115">
	<b:glossaryEntry>caused by opaque cell fragments in the vitreous humor and lens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110306292">
	<b:glossaryEntry>a rise in the temperature of the body; frequently a symptom of infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110306471"
	 b:glossaryEntry="extremely high fever"/>
<rdf:Description rdf:about="&a;110306568"
	 b:glossaryEntry="a decrease in size of an organ caused by disease or disuse"/>
<rdf:Description rdf:about="&a;110306741">
	<b:glossaryEntry>abnormal development (of organs or cells) or an abnormal structure resulting from such growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110306980">
	<b:glossaryEntry>a disturbance in which bone that is undergoing lysis is replaced by an abnormal proliferation of fibrous tissue resulting in bone lesions or skin lesions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110307241"
	 b:glossaryEntry="fibrous dysplasia of bone affecting multiple bones"/>
<rdf:Description rdf:about="&a;110307388"
	 b:glossaryEntry="fibrous dysplasia of bone confined to a single bone"/>
<rdf:Description rdf:about="&a;110307514"
	 b:glossaryEntry="abnormal enlargement of a body part or organ"/>
<rdf:Description rdf:about="&a;110307724"
	 b:glossaryEntry="gland enlargement"/>
<rdf:Description rdf:about="&a;110307799">
	<b:glossaryEntry>enlargement of the right ventricle of the heart due to disease of the lungs or of the pulmonary blood vessels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110307968">
	<b:glossaryEntry>hypertrophy of certain body parts (usually legs and scrotum); the end state of the disease filariasis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110308183"
	 b:glossaryEntry="hypertrophy of a limb"/>
<rdf:Description rdf:about="&a;110308276">
	<b:glossaryEntry>swelling of the scrotum resulting from chronic lymphatic obstruction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110308424">
	<b:glossaryEntry>thickening of the skin (usually unilateral on an extremity) caused by congenital enlargement of lymph vessel and lymph vessel obstruction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110308659">
	<b:glossaryEntry>a disease caused by nematodes in the blood or tissues of the body causing blockage of lymphatic vessels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110308819"
	 b:glossaryEntry="an abnormal enlargement of the spleen"/>
<rdf:Description rdf:about="&a;110308915">
	<b:glossaryEntry>excessive size; usually caused by excessive secretion of growth hormone from the pituitary gland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110309091">
	<b:glossaryEntry>enlargement of bones of hands and feet and face; often accompanied by headache and muscle pain and emotional disturbances; caused by overproduction of growth hormone by the anterior pituitary gland (due to a tumor)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110309376"
	 b:glossaryEntry="abnormal increase in number of cells"/>
<rdf:Description rdf:about="&a;110309470">
	<b:glossaryEntry>underdevelopment of an organ because of a decrease in the number of cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110309600">
	<b:glossaryEntry>loss of structural differentiation within a cell or group of cells often with increased capacity for multiplication, as in a malignant tumor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110309796"
	 b:glossaryEntry="transient cessation of respiration"/>
<rdf:Description rdf:about="&a;110309918">
	<b:glossaryEntry>irregular breathing of newborns; periods of rapid breathing followed by apnea; believed to be associated with sudden infant death syndrome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110310132"
	 b:glossaryEntry="apnea that occurs during sleep"/>
<rdf:Description rdf:about="&a;110310256"
	 b:glossaryEntry="difficult or labored respiration"/>
<rdf:Description rdf:about="&a;110310342"
	 b:glossaryEntry="flow of blood from ruptured blood vessels"/>
<rdf:Description rdf:about="&a;110310519"
	 b:glossaryEntry="bleeding from a ruptured blood vessel in the brain"/>
<rdf:Description rdf:about="&a;110310654">
	<b:glossaryEntry>bleeding from the uterus that is not due to menstruation; usually indicative of disease (as cervical cancer)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110310821"
	 b:glossaryEntry="bleeding from the nose"/>
<rdf:Description rdf:about="&a;110310911">
	<b:glossaryEntry>irregular and infrequent or difficult evacuation of the bowels; can be a symptom of intestinal obstruction or diverticulitis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110311109"
	 b:glossaryEntry="frequent and watery bowel movements"/>
<rdf:Description rdf:about="&a;110311274"
	 b:glossaryEntry="obscene term for diarrhea"/>
<rdf:Description rdf:about="&a;110311355"
	 b:glossaryEntry="a reeling sensation; feeling about to fall"/>
<rdf:Description rdf:about="&a;110311493"
	 b:glossaryEntry="a lack of vitality"/>
<rdf:Description rdf:about="&a;110311584">
	<b:glossaryEntry>presence of abnormal high-pitched sound heard with a stethoscope when an airway is blocked (as in asthma or chronic bronchitis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110311768">
	<b:glossaryEntry>any physical or psychological disturbance (as sweating or depression) experienced by a drug addict when deprived of the drug</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110311957">
	<b:glossaryEntry>a blood clot formed within a blood vessel and remaining attached to its place of origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110312118">
	<b:glossaryEntry>an abnormal particle (e.g. an air bubble or part of a clot) circulating in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110312275">
	<b:glossaryEntry>a mental condition in which the qualities of a state are relatively constant even though the state itself may be dynamic; "a manic state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110312817">
	<b:glossaryEntry>a state of individual psychological well-being based upon a sense of confidence and usefulness and purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110312976">
	<b:glossaryEntry>a relatively permanent state of anxiety occurring in a variety of mental disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110313198">
	<b:glossaryEntry>(psychoanalysis) anxiety resulting from real or imagined threats to your sexual functions; originally applied only to men but can in principal apply to women</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110313420"
	 b:glossaryEntry="excessive anxiety"/>
<rdf:Description rdf:about="&a;110313495">
	<b:glossaryEntry>chronic and abnormal anxiety about imaginary symptoms and ailments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110313638">
	<b:glossaryEntry>distress and disorientation especially in adolescence resulting from conflicting pressures and uncertainty about and one''s self and one''s role in society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110313853"
	 b:glossaryEntry='an uneasy state; "he suffered an attack of nerves"'/>
<rdf:Description rdf:about="&a;110314018">
	<b:glossaryEntry>nervousness resulting from mental stress; "his responsibilities were a constant strain"; "the mental strain of staying alert hour after hour was too much for him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110314284">
	<b:glossaryEntry>a state mental or emotional strain or suspense; "he suffered from fatigue and emotional tension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110314473">
	<b:glossaryEntry>stress at which a person breaks down or a situation becomes crucial</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110314601">
	<b:glossaryEntry>an erroneous belief that is held in the face of evidence to the contrary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110314837">
	<b:glossaryEntry>a delusion (common in paranoia) that you are much greater and more powerful and influential than you really are</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110315035">
	<b:glossaryEntry>a delusion (common in paranoia) that others are out to get you and frustrate and embarrass you or inflict suffering on you; a complicated conspiracy is frequently imagined</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110315277"
	 b:glossaryEntry="illusory perception"/>
<rdf:Description rdf:about="&a;110315446"
	 b:glossaryEntry="an auditory hallucination of strange nonverbal sounds"/>
<rdf:Description rdf:about="&a;110315553"
	 b:glossaryEntry="hallucinatory perception of colored lights"/>
<rdf:Description rdf:about="&a;110315652"
	 b:glossaryEntry="any hallucination arising from heavy drinking"/>
<rdf:Description rdf:about="&a;110315759">
	<b:glossaryEntry>an image vivid enough to be a hallucination but recognized as unreal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110315893"
	 b:glossaryEntry='a hallucinatory experience induced by drugs; "an acid trip"'/>
<rdf:Description rdf:about="&a;110316003"
	 b:glossaryEntry="an delusion concerning the body image or parts of the body"/>
<rdf:Description rdf:about="&a;110316124"
	 b:glossaryEntry="the delusion that you have assumed the form of an animal"/>
<rdf:Description rdf:about="&a;110316237">
	<b:glossaryEntry>the psychological state of someone who is functioning at a satisfactory level of emotional and behavioral adjustment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110316467">
	<b:glossaryEntry>the healthy psychological state of someone with good judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110316608"
	 b:glossaryEntry="normal or sound powers of mind"/>
<rdf:Description rdf:about="&a;110316756"
	 b:glossaryEntry="a lucid state of mind; not confused"/>
<rdf:Description rdf:about="&a;110316846">
	<b:glossaryEntry>the state of having good sense and sound judgment; "his rationality may have been impaired"; "he had to rely less on reason than on rousing their emotions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110317085">
	<b:glossaryEntry>the psychological state of someone who has emotional or behavioral problems serious enough to require psychiatric intervention</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110317361">
	<b:glossaryEntry>(psychiatry) a psychological disorder of thought or emotion; a more neutral term than mental illness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110317756">
	<b:glossaryEntry>a cover term for a variety of mental disorders in which severe anxiety is a salient symptom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110317982">
	<b:glossaryEntry>an anxiety disorder characterized by free-floating anxiety and such symptoms as tension or sweating or trembling of light-headedness or irritability etc; a functional disorder (not organic)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110318265">
	<b:glossaryEntry>an anxiety disorder characterized by unpredictable panic attacks; the attacks are usually severe but brief</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110318432"
	 b:glossaryEntry="a general term for all phobias"/>
<rdf:Description rdf:about="&a;110318659"
	 b:glossaryEntry="a morbid fear of small insects and mites and worms"/>
<rdf:Description rdf:about="&a;110318767">
	<b:glossaryEntry>a morbid fear of open spaces (as fear of being caught alone in some public place)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110318906"
	 b:glossaryEntry="a morbid fear of men"/>
<rdf:Description rdf:about="&a;110318984"
	 b:glossaryEntry="a morbid fear of women"/>
<rdf:Description rdf:about="&a;110319063">
	<b:glossaryEntry>any phobia (other than agoraphobia) associated with relatively simple well-defined stimuli</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110319483"
	 b:glossaryEntry="a morbid fear of great heights"/>
<rdf:Description rdf:about="&a;110319570"
	 b:glossaryEntry="a morbid fear of pain"/>
<rdf:Description rdf:about="&a;110319648"
	 b:glossaryEntry="a morbid fear of drowning"/>
<rdf:Description rdf:about="&a;110319730"
	 b:glossaryEntry="a morbid fear of thunder and lightning"/>
<rdf:Description rdf:about="&a;110319826"
	 b:glossaryEntry="a morbid fear of being closed in a confined space"/>
<rdf:Description rdf:about="&a;110319936"
	 b:glossaryEntry="a morbid fear of freezing"/>
<rdf:Description rdf:about="&a;110320018"
	 b:glossaryEntry="a morbid fear of falling asleep"/>
<rdf:Description rdf:about="&a;110320107"
	 b:glossaryEntry="a morbid fear of dirt or contamination"/>
<rdf:Description rdf:about="&a;110320202"
	 b:glossaryEntry="a morbid fear of night or darkness"/>
<rdf:Description rdf:about="&a;110320294"
	 b:glossaryEntry="a morbid fear of developing a phobia"/>
<rdf:Description rdf:about="&a;110320388"
	 b:glossaryEntry="a morbid fear of fire"/>
<rdf:Description rdf:about="&a;110320466"
	 b:glossaryEntry="a morbid fear of being buried alive"/>
<rdf:Description rdf:about="&a;110320559"
	 b:glossaryEntry="a morbid fear of death"/>
<rdf:Description rdf:about="&a;110320641"
	 b:glossaryEntry="a morbid fear of the number 13"/>
<rdf:Description rdf:about="&a;110320735"
	 b:glossaryEntry="a morbid fear of animals"/>
<rdf:Description rdf:about="&a;110320905"
	 b:glossaryEntry="a morbid fear of cats"/>
<rdf:Description rdf:about="&a;110320985"
	 b:glossaryEntry="a morbid fear of dogs"/>
<rdf:Description rdf:about="&a;110321063"
	 b:glossaryEntry="a morbid fear of insects"/>
<rdf:Description rdf:about="&a;110321146"
	 b:glossaryEntry="a morbid fear of snakes"/>
<rdf:Description rdf:about="&a;110321228"
	 b:glossaryEntry="a morbid fear of mice"/>
<rdf:Description rdf:about="&a;110321306">
	<b:glossaryEntry>any phobia (other than agoraphobia) associated with situations in which you are subject to criticism by others (as fear of eating in public or public speaking etc)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110321601"
	 b:glossaryEntry="an abnormal fear of Satan"/>
<rdf:Description rdf:about="&a;110321685"
	 b:glossaryEntry="a child''s sudden fear of attending school"/>
<rdf:Description rdf:about="&a;110321786"
	 b:glossaryEntry="a morbid fear of battle or physical injury"/>
<rdf:Description rdf:about="&a;110321889"
	 b:glossaryEntry="a fear of foreigners or strangers"/>
<rdf:Description rdf:about="&a;110321979">
	<b:glossaryEntry>an anxiety disorder associated with serious traumatic events and characterized by such symptoms as guilt about surviving or reliving the trauma in dreams or numbness and lack of involvement with reality or recurrent thoughts and images</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110322315"
	 b:glossaryEntry="a mental disorder that causes somatic symptoms"/>
<rdf:Description rdf:about="&a;110322430"
	 b:glossaryEntry="a disorder in one''s mental state"/>
<rdf:Description rdf:about="&a;110322519">
	<b:glossaryEntry>a mental disorder characterized by the conversion of mental conflict into somatic forms (into paralysis or anesthesia having no apparent cause)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110322790">
	<b:glossaryEntry>a mental disorder involving loss of sensitivity in the hand and wrist; "since no combination of nerves serve this area a glove anesthesia is clearly psychogenic in origin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110323024">
	<b:glossaryEntry>state of excitement and mental confusion often accompanied by hallucinations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110323155">
	<b:glossaryEntry>any mental disorder in which delusions play a significant role</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110323283"
	 b:glossaryEntry="inflexible and maladaptive patterns of behavior"/>
<rdf:Description rdf:about="&a;110323451">
	<b:glossaryEntry>the condition of being unable to adapt properly to your environment with resulting emotional instability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110323615">
	<b:glossaryEntry>an antisocial personality disorder; capable of violent acts without guilt feelings (`psychopathic personality'' was once widely used but has now been superseded by `sociopathic personality'' to indicate the social aspects of the disorder)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110323948"
	 b:glossaryEntry="a mental disorder caused by stress of active warfare"/>
<rdf:Description rdf:about="&a;110324110">
	<b:glossaryEntry>characterized by symptoms similar to but less severe than schizophrenia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110324251">
	<b:glossaryEntry>any mental disorder not caused by detectable organic abnormalities of the brain and in which a major disturbance of emotions is predominant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110324581">
	<b:glossaryEntry>a state of depression and anhedonia so severe as to require clinical intervention</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110324907">
	<b:glossaryEntry>a state of clinical depression in which the person exhibits irritability and restlessness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110325062">
	<b:glossaryEntry>severe and progressive depression in infants who lose their mother and do not get a suitable substitute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110325232">
	<b:glossaryEntry>a state of depression for which there is no apparent precipitating cause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110325372">
	<b:glossaryEntry>an inappropriate state of depression that is precipitated by events in the person''s life (to be distinguished from normal grief)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110325590">
	<b:glossaryEntry>(psychiatry) a state of depression with all the classic symptoms (anhedonia and lethargy and sleep disturbance and despondency and morbid thoughts and feelings of worthlessness and sometimes attempted suicide) but with no known organic dysfunction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110325944"
	 b:glossaryEntry="a major depressive episode associated with the climacteric"/>
<rdf:Description rdf:about="&a;110326072">
	<b:glossaryEntry>a term used for any state of depression that is not psychotic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110326217">
	<b:glossaryEntry>a state of depression so severe that the person loses contact with reality and suffers a variety of functional impairments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110326424">
	<b:glossaryEntry>a state of clinical depression in which the individual is lethargic and slow to initiate action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110326585">
	<b:glossaryEntry>a major depressive episode that occurs without the manic phase that occurs in the classic form of bipolar disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110326765">
	<b:glossaryEntry>a mood disorder; an affective disorder in which the victim tends to respond excessively and sometimes violently</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110326963"
	 b:glossaryEntry="state of violent mental agitation"/>
<rdf:Description rdf:about="&a;110327104"
	 b:glossaryEntry="a psychological state characterized by delusions of grandeur"/>
<rdf:Description rdf:about="&a;110327241">
	<b:glossaryEntry>extreme depression characterized by tearful sadness and irrational fears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110327371">
	<b:glossaryEntry>a mental disorder characterized by episodes of mania and depression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110327594"
	 b:glossaryEntry="a mild bipolar disorder that persists over a long time"/>
<rdf:Description rdf:about="&a;110327747">
	<b:glossaryEntry>resembling schizophrenia but remaining within the bounds of normality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110327875">
	<b:glossaryEntry>a mental or personality disturbance not attributable to any known neurological or organic dysfunction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110328098">
	<b:glossaryEntry>characterized by violent emotional outbreaks and disturbances of sensory and motor functions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110328322">
	<b:glossaryEntry>a form of hysteria having features of both conversion disorder and anxiety neurosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110328468"
	 b:glossaryEntry="hysteria with cataleptic symptoms"/>
<rdf:Description rdf:about="&a;110328564">
	<b:glossaryEntry>characterized by diffuse anxiety and often somatic manifestations of fear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110328700">
	<b:glossaryEntry>a relatively rare disorder in which the usual integrity of the personality breaks down and two or more independent personalities emerge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110328922"
	 b:glossaryEntry="relatively permanent disorder of the mind"/>
<rdf:Description rdf:about="&a;110329126"
	 b:glossaryEntry="obsolete terms for legal insanity"/>
<rdf:Description rdf:about="&a;110329235"
	 b:glossaryEntry="mental deterioration of organic or functional origin"/>
<rdf:Description rdf:about="&a;110329411">
	<b:glossaryEntry>dementia observed during the last stages of severe chronic alcoholism; involves loss of memory for recent events although long term memory is intact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110329697"
	 b:glossaryEntry="dementia with onset before the age of 65"/>
<rdf:Description rdf:about="&a;110329820">
	<b:glossaryEntry>a progressive form of presenile dementia that is similar to senile dementia except that it usually starts in the 40s or 50s; first symptoms are impaired memory which is followed by impaired thought and speech and finally complete helplessness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110330155">
	<b:glossaryEntry>dementia of the aged; results from degeneration of the brain in the absence of cerebrovascular disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110330338">
	<b:glossaryEntry>the state of being irrational; lacking powers of understanding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110330471"
	 b:glossaryEntry="a state of mental disturbance and disorientation"/>
<rdf:Description rdf:about="&a;110330610"
	 b:glossaryEntry="informal terms for insanity"/>
<rdf:Description rdf:about="&a;110330716">
	<b:glossaryEntry>any severe mental disorder in which contact with reality is lost or highly distorted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110330910"
	 b:glossaryEntry="acute delirium caused by alcohol poisoning"/>
<rdf:Description rdf:about="&a;110331029">
	<b:glossaryEntry>a psychological disorder characterized by delusions of persecution or grandeur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110331162">
	<b:glossaryEntry>any of several psychotic disorders characterized by distortions of reality and disturbances of thought and language and withdrawal from social contact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110331532">
	<b:glossaryEntry>schizophrenia characterized by mild symptoms or by some preexisting tendency to schizophrenia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110331719">
	<b:glossaryEntry>a form of schizophrenia characterized by a tendency to remain in a fixed stuporous state for long periods; the catatonia may give way to short periods of extreme excitement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110332023">
	<b:glossaryEntry>a form of schizophrenia characterized by severe disintegration of personality including erratic speech and childish mannerisms and bizarre behavior; usually becomes evident during puberty; the most common diagnostic category in mental institutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110332419">
	<b:glossaryEntry>a form of schizophrenia characterized by delusions (of persecution or grandeur or jealousy); symptoms may include anger and anxiety and aloofness and doubts about gender identity; unlike other types of schizophrenia the patients are usually presentable and (if delusions are not acted on) may function in an apparently normal manner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110332892">
	<b:glossaryEntry>schizophrenia of abrupt onset and relatively short duration (a few weeks or months)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110333074">
	<b:glossaryEntry>a disorder of the vocal organs that results in the loss of voice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110333208">
	<b:glossaryEntry>a chronic disorder that occurs in tropical and nontropical forms and in both children and adults; nutrients are not absorbed; symptoms include foul-smelling diarrhea and emaciation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110333440">
	<b:glossaryEntry>a disorder in children and adults; inability to tolerate wheat protein (gluten); symptoms include foul-smelling diarrhea and emaciation; often accompanied by lactose intolerance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110333678"
	 b:glossaryEntry="a disorder of the urinary bladder"/>
<rdf:Description rdf:about="&a;110333810">
	<b:glossaryEntry>a bladder disorder resulting from interruption of the reflex arc normally associated with voiding urine; absence of bladder sensation and over-filling of the bladder and inability to urinate voluntarily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110334074">
	<b:glossaryEntry>a bladder disorder resulting from spinal cord lesion or multiple sclerosis or trauma; absence of bladder sensation and incontinence and interrupted voiding of urine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110334300"
	 b:glossaryEntry="a disorder of oral speech"/>
<rdf:Description rdf:about="&a;110334457">
	<b:glossaryEntry>a speech disorder in which the same word is repeated several times in succession</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110334594">
	<b:glossaryEntry>a speech defect that involves pronouncing s like voiceless th and z like voiced th</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110334727">
	<b:glossaryEntry>a speech disorder involving hesitations and involuntary repetitions of certain sounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110334876"
	 b:glossaryEntry="a mental state of extreme emotional disturbance"/>
<rdf:Description rdf:about="&a;110335051">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an unhappy and worried mental state; "there was too much anger and disturbance"; "she didn''t realize the upset she caused me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110335257">
	<b:glossaryEntry xml:space='preserve'><![CDATA[agitation resulting from active worry; "don''t get in a stew"; "he''s in a sweat about exams"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110335433">
	<b:glossaryEntry>an excited state of agitation; "he was in a dither"; "there was a terrible flap about the theft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110335613">
	<b:glossaryEntry>loss of emotional control often resulting in emotional collapse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110335731">
	<b:glossaryEntry>a mental state characterized by a pessimistic sense of inadequacy and a despondent lack of activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110336031">
	<b:glossaryEntry>an informal term for a state of depression; "he had a bad case of the blues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110336169"
	 b:glossaryEntry='a state of nervous depression; "he was in a funk"'/>
<rdf:Description rdf:about="&a;110336281"
	 b:glossaryEntry="a constitutional tendency to be gloomy and depressed"/>
<rdf:Description rdf:about="&a;110336390"
	 b:glossaryEntry="(formal) extreme depression"/>
<rdf:Description rdf:about="&a;110336481"
	 b:glossaryEntry="a state of mild depression"/>
<rdf:Description rdf:about="&a;110336601"
	 b:glossaryEntry='(informal) "in the dumps"; "have the mopes"'/>
<rdf:Description rdf:about="&a;110336704">
	<b:glossaryEntry>an exhilarating psychological state of pride and optimism; an absence of depression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110336913">
	<b:glossaryEntry>a state of altered consciousness induced by alcohol or narcotics; "they took drugs to get a high on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110337064">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a state of sustained elation; "his high spirits told us he must have won"; "I''m on a permanent high these days"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110337259"
	 b:glossaryEntry="concurrent perspiration and chill; associated with fear"/>
<rdf:Description rdf:about="&a;110337390">
	<b:glossaryEntry>sudden mass fear and anxiety over anticipated events; "panic in the stock market"; "a war scare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110337564"
	 b:glossaryEntry="a period of general fear of communists"/>
<rdf:Description rdf:about="&a;110337658">
	<b:glossaryEntry>a display of bad temper; "he had a fit"; "she threw a tantrum"; "he made a scene"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110337807"
	 b:glossaryEntry="absence of a reflex; a sign of possible nerve damage"/>
<rdf:Description rdf:about="&a;110337915"
	 b:glossaryEntry="the psychological state of being irritated or annoyed"/>
<rdf:Description rdf:about="&a;110338138"
	 b:glossaryEntry="the state of being bothered"/>
<rdf:Description rdf:about="&a;110338223"
	 b:glossaryEntry="a state of irritation or annoyance"/>
<rdf:Description rdf:about="&a;110338328"
	 b:glossaryEntry="a minor annoyance"/>
<rdf:Description rdf:about="&a;110338400">
	<b:glossaryEntry>a lack of patience; irritation with anything that causes delay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110338534"
	 b:glossaryEntry='a state of agitated irritation; "he was in a snit"'/>
<rdf:Description rdf:about="&a;110338635">
	<b:glossaryEntry>a psychological state induced by (or as if induced by) a magical incantation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110338822"
	 b:glossaryEntry="being controlled by passion or the supernatural"/>
<rdf:Description rdf:about="&a;110338926">
	<b:glossaryEntry>the state of being intensely interested (as by awe or terror)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110339059">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a situation or condition almost beyond one''s ability to deal with and requiring great effort to bear or overcome: "grappling with financial difficulties"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110339449">
	<b:glossaryEntry>(slang) an unpleasant difficulty; "this problem is a real bitch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110339565">
	<b:glossaryEntry>a situation from which extrication is difficult especially an unpleasant or trying one: "finds himself in a most awkward predicament"; "the woeful plight of homeless people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110339852">
	<b:glossaryEntry>a predicament from which a skillful or graceful escape is impossible; "his lying got him into a tight corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110340020"
	 b:glossaryEntry="a difficult entangling situation"/>
<rdf:Description rdf:about="&a;110340106">
	<b:glossaryEntry>a painful or straitened circumstance: "the pinch of the recession"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110340224">
	<b:glossaryEntry>informal terms for a difficult situation; "he got into a terrible fix"; "he made a muddle of his marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110340435">
	<b:glossaryEntry>a difficulty that can be overcome with effort; "we had a hard time getting here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110340571">
	<b:glossaryEntry>a state of extreme difficulty: "he presided over the economy during the period of the greatest stress and danger"- R.J.Samuelson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110340761">
	<b:glossaryEntry>a state of difficulty that needs to be resolved; "she and her husband are having problems"; "it is always a job to contact him"; "urban problems such as traffic congestion and smog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110341038">
	<b:glossaryEntry>a social and political problem caused by conflict between races occupying the same or adjacent regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110341199">
	<b:glossaryEntry>an economic problem caused by payments for imports being greater than receipts for exports</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110341363"
	 b:glossaryEntry="a current state of general acceptance and use"/>
<rdf:Description rdf:about="&a;110341471"
	 b:glossaryEntry="the state or quality of being recognized or acknowledged"/>
<rdf:Description rdf:about="&a;110341656"
	 b:glossaryEntry='acceptance as satisfactory; "he bought it on aproval"'/>
<rdf:Description rdf:about="&a;110341804"
	 b:glossaryEntry='(British abbreviation) "he accepted it on appro"'/>
<rdf:Description rdf:about="&a;110341904"
	 b:glossaryEntry="acceptance as true or valid"/>
<rdf:Description rdf:about="&a;110341989">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the state of being contented with your situation in life; "he relaxed in sleepy contentedness"; "they could read to their heart''s content"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110342197"
	 b:glossaryEntry="passive acceptance"/>
<rdf:Description rdf:about="&a;110342274"
	 b:glossaryEntry="the state of being eligible"/>
<rdf:Description rdf:about="&a;110342359">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the state of being welcome; "don''t outstay your welcome"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110342469"
	 b:glossaryEntry="the state of having rejected your religious beliefs"/>
<rdf:Description rdf:about="&a;110342602">
	<b:glossaryEntry>the state of being out of favor; "he is in disfavor with the king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110342735"
	 b:glossaryEntry="the state of being excommunicated"/>
<rdf:Description rdf:about="&a;110342852"
	 b:glossaryEntry="the state of lacking unity"/>
<rdf:Description rdf:about="&a;110343061"
	 b:glossaryEntry="the state of being several and distinct"/>
<rdf:Description rdf:about="&a;110343201"
	 b:glossaryEntry="a state of separation between persons or groups"/>
<rdf:Description rdf:about="&a;110343430"
	 b:glossaryEntry="a state of social isolation"/>
<rdf:Description rdf:about="&a;110343521"
	 b:glossaryEntry="the state of being alone in solitary isolation"/>
<rdf:Description rdf:about="&a;110343639"
	 b:glossaryEntry="enforced isolation to prevent spread of disease"/>
<rdf:Description rdf:about="&a;110343743"
	 b:glossaryEntry="the state of being insulated"/>
<rdf:Description rdf:about="&a;110343867"
	 b:glossaryEntry="separation resulting from hostility"/>
<rdf:Description rdf:about="&a;110343974">
	<b:glossaryEntry>personal state of isolation and anxiety resulting from a lack of social control and regulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110344121"
	 b:glossaryEntry="the condition of being concealed or hidden"/>
<rdf:Description rdf:about="&a;110344291">
	<b:glossaryEntry>(archaic) the chest considered as the place where secret thoughts are kept; "his bosom was bursting with the secret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110344459">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the state of being secret; "you must respect the confidentiality of your client''s communications"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110344618"
	 b:glossaryEntry="the state of being separate and unconnected"/>
<rdf:Description rdf:about="&a;110344737"
	 b:glossaryEntry="lack of connection of continuity"/>
<rdf:Description rdf:about="&a;110344847"
	 b:glossaryEntry="state of being disconnected"/>
<rdf:Description rdf:about="&a;110345035"
	 b:glossaryEntry="the capability of being separated"/>
<rdf:Description rdf:about="&a;110345127"
	 b:glossaryEntry="lack of cohesion or clarity or organization"/>
<rdf:Description rdf:about="&a;110345278"
	 b:glossaryEntry="lacking order or coherence"/>
<rdf:Description rdf:about="&a;110345365"
	 b:glossaryEntry='the state of being united; "there is strength in union"'/>
<rdf:Description rdf:about="&a;110345580"
	 b:glossaryEntry="the state of being combined into one body"/>
<rdf:Description rdf:about="&a;110345722"
	 b:glossaryEntry="the state of being allied or confederated"/>
<rdf:Description rdf:about="&a;110345834">
	<b:glossaryEntry>the state of being federalized; "the federalization of postal service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110345982">
	<b:glossaryEntry>the state of being connected; "the connection between church and state is inescapable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110346256">
	<b:glossaryEntry>the state or condition of touching or of being in immediate proximity: "litmus paper turns red on contact with an acid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110346447">
	<b:glossaryEntry>the state of being linked together as in a chain; union in a linked series</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110346581"
	 b:glossaryEntry="contact at a single point or along a line"/>
<rdf:Description rdf:about="&a;110346677"
	 b:glossaryEntry="a state of being connected reciprocally"/>
<rdf:Description rdf:about="&a;110346799"
	 b:glossaryEntry="the state of cohering"/>
<rdf:Description rdf:about="&a;110346968">
	<b:glossaryEntry>logical coherence and accordance with the facts: "a rambling argument that lacked any consistency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110347124"
	 b:glossaryEntry="the state of being joined"/>
<rdf:Description rdf:about="&a;110347254">
	<b:glossaryEntry>the state of being connected together as in memory or imagination; "his association of his father with being beaten was too strong to break"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110347452">
	<b:glossaryEntry>a close and intimate union; "the marriage of music and dance"; "a marriage of ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110347591"
	 b:glossaryEntry="uninterrupted connection or union"/>
<rdf:Description rdf:about="&a;110347699">
	<b:glossaryEntry>a condition superior to an earlier condition: "the new school represents a great improvement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110347922"
	 b:glossaryEntry="a condition inferior to an earlier condition"/>
<rdf:Description rdf:about="&a;110348092">
	<b:glossaryEntry>an improvement that adds to the value of a property or facility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110348212">
	<b:glossaryEntry>a state in which things are improving; the result of developing; "after he saw the latest development he changed his mind and became a supporter"; "in chess your should take care of your development before moving your queen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110348512">
	<b:glossaryEntry>state of inadequate development: "much poverty can be traced to the underdevelopment of industry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110348672">
	<b:glossaryEntry>the state of something that has been unused and neglected; "the house was in a terrible state of neglect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110348858">
	<b:glossaryEntry>something that has been omitted; "she searched the table for omissions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110348984">
	<b:glossaryEntry>a condition of decline following successes; "in the twilight of the empire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110349114">
	<b:glossaryEntry>something or someone that has suffered ruin or dilapidation; "the house was a wreck when they bought it"; "thanks to that quack I am a human wreck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110349313">
	<b:glossaryEntry>the state of being restored to its former good condition; "the inn was a renovation of a Colonial house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110349488"
	 b:glossaryEntry="state of being mature; full development"/>
<rdf:Description rdf:about="&a;110349703">
	<b:glossaryEntry>the state (and responsibilities) of a person who has attained maturity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110349883"
	 b:glossaryEntry="the state of being a man; manly qualities"/>
<rdf:Description rdf:about="&a;110349978"
	 b:glossaryEntry="the state of being a parent"/>
<rdf:Description rdf:about="&a;110350062"
	 b:glossaryEntry="the state of being ripe"/>
<rdf:Description rdf:about="&a;110350158"
	 b:glossaryEntry="the state of being a woman; womanly qualities"/>
<rdf:Description rdf:about="&a;110350259">
	<b:glossaryEntry>early maturity; the state of being young or immature or inexperienced</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110350380"
	 b:glossaryEntry="not having reached maturity"/>
<rdf:Description rdf:about="&a;110350605"
	 b:glossaryEntry="the state of not being ripe"/>
<rdf:Description rdf:about="&a;110350706"
	 b:glossaryEntry="lacking and evidencing lack of experience of life"/>
<rdf:Description rdf:about="&a;110350838"
	 b:glossaryEntry="the state of being premature"/>
<rdf:Description rdf:about="&a;110350940"
	 b:glossaryEntry="in the state between puberty and adulthood"/>
<rdf:Description rdf:about="&a;110351040"
	 b:glossaryEntry="the state of a child between infancy and adolescence"/>
<rdf:Description rdf:about="&a;110351160"
	 b:glossaryEntry="the earliest state of immaturity"/>
<rdf:Description rdf:about="&a;110351257">
	<b:glossaryEntry>the state of taking in or encircling; "an island in the embrace of the sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110351386"
	 b:glossaryEntry="including entirely"/>
<rdf:Description rdf:about="&a;110351464">
	<b:glossaryEntry>the state of being banished or ostracized (excluded from society by general consent)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110351617">
	<b:glossaryEntry>the state of being debarred (excluded from enjoying certain possessions or rights or practices)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110351768">
	<b:glossaryEntry>a relative position or degree of value in a graded group: "lumber of the highest grade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110351976"
	 b:glossaryEntry="standing or position on a scale"/>
<rdf:Description rdf:about="&a;110352060"
	 b:glossaryEntry="position on a scale in relation to others in a sport"/>
<rdf:Description rdf:about="&a;110352166">
	<b:glossaryEntry>relative position in a graded series: "always a step behind"; "subtle gradations in color"; "keep in step with the fashions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110352371"
	 b:glossaryEntry='a step on some scale; "he is a cut above the the rest"'/>
<rdf:Description rdf:about="&a;110352475">
	<b:glossaryEntry>relative status; "his salary was determined by his rank and seniority"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110353370"
	 b:glossaryEntry="not the highest rank in a classification"/>
<rdf:Description rdf:about="&a;110353469">
	<b:glossaryEntry>(England) the advanced level of a subject taken in school (usually two years after O level)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110353614"
	 b:glossaryEntry="(England) the basic level of a subject taken in school"/>
<rdf:Description rdf:about="&a;110353722">
	<b:glossaryEntry>the level of education that college students are assumed to have attained</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110353855"
	 b:glossaryEntry="rank in a military organization"/>
<rdf:Description rdf:about="&a;110354002"
	 b:glossaryEntry="the rank of a flag officer"/>
<rdf:Description rdf:about="&a;110354084">
	<b:glossaryEntry xml:space='preserve'><![CDATA[social status or position conferred by a system based on class: "lose caste by doing work beneath one''s station"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110354248">
	<b:glossaryEntry>high office or rank or station: "he respected the dignity of the emissaries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110354378"
	 b:glossaryEntry="the state of being of noble birth"/>
<rdf:Description rdf:about="&a;110354495"
	 b:glossaryEntry='of imperial status; "he was born to the purple"'/>
<rdf:Description rdf:about="&a;110354595">
	<b:glossaryEntry>a position of great esteem (and supposed superiority); "they put him on a pedestal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110354733"
	 b:glossaryEntry="office or position of an archdeacon"/>
<rdf:Description rdf:about="&a;110354829"
	 b:glossaryEntry="the rank or dignity or position of a baronet or baroness"/>
<rdf:Description rdf:about="&a;110354950"
	 b:glossaryEntry="the dignity or rank or position of a duke"/>
<rdf:Description rdf:about="&a;110355045"
	 b:glossaryEntry="the dignity or rank or position of an earl or countess"/>
<rdf:Description rdf:about="&a;110355153"
	 b:glossaryEntry="the dignity or rank or position of a king"/>
<rdf:Description rdf:about="&a;110355249"
	 b:glossaryEntry="the dignity or rank or position of a prince"/>
<rdf:Description rdf:about="&a;110355348"
	 b:glossaryEntry="the dignity or rank or position of a viscount or viscountess"/>
<rdf:Description rdf:about="&a;110355477">
	<b:glossaryEntry>the status of a leader; "they challenged his leadership of the union"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110355603"
	 b:glossaryEntry="the state of being noble"/>
<rdf:Description rdf:about="&a;110355685"
	 b:glossaryEntry="the state of being prominent: widely known or eminent"/>
<rdf:Description rdf:about="&a;110355849">
	<b:glossaryEntry>a focus of public attention; "he enjoyed being in the limelight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110355994"
	 b:glossaryEntry="the state of being salient"/>
<rdf:Description rdf:about="&a;110356119"
	 b:glossaryEntry="the state of being conspicuous"/>
<rdf:Description rdf:about="&a;110356224"
	 b:glossaryEntry='a prominent status; "a person of importance"'/>
<rdf:Description rdf:about="&a;110356373">
	<b:glossaryEntry>special importance or significance; "the red light gave the central figure increased emphasis"; "the room was decorated in shades of gray with distinctive red accents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110356622">
	<b:glossaryEntry>special emphasis attached to something; "the stress was more on accuracy than on speed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110356770"
	 b:glossaryEntry="the state of being first in importance"/>
<rdf:Description rdf:about="&a;110356862">
	<b:glossaryEntry>high status importance owing to marked superiority; "a scholar of great eminence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110357033">
	<b:glossaryEntry>a high standing achieved through success or influence or wealth etc.; "he wanted to achieve power and prestige"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110357217">
	<b:glossaryEntry>an obscure and unimportant standing; not well known; "he worked in obscurity for many years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110357455"
	 b:glossaryEntry="the state of being anonymous"/>
<rdf:Description rdf:about="&a;110357554"
	 b:glossaryEntry="the state of being humble and unimportant"/>
<rdf:Description rdf:about="&a;110357681"
	 b:glossaryEntry='an insignificant place; "he came out of nowhere"'/>
<rdf:Description rdf:about="&a;110357783"
	 b:glossaryEntry="the state of being disregarded or forgotten"/>
<rdf:Description rdf:about="&a;110357889"
	 b:glossaryEntry="the state of being honored"/>
<rdf:Description rdf:about="&a;110358076"
	 b:glossaryEntry='a state of high honor; "he valued glory above life itself"'/>
<rdf:Description rdf:about="&a;110358202"
	 b:glossaryEntry="the state or quality of being widely honored and acclaimed"/>
<rdf:Description rdf:about="&a;110358350">
	<b:glossaryEntry>the condition of being honored (esteemed or respected or well regarded); "it is held in esteem"; "a man who has earned high regard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110358589"
	 b:glossaryEntry="the state in which esteem has been lost"/>
<rdf:Description rdf:about="&a;110358702">
	<b:glossaryEntry>high level of respect gained by impressive development or achievement: "a man of great stature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110358851"
	 b:glossaryEntry="the state of being held in high esteem and honor"/>
<rdf:Description rdf:about="&a;110359109">
	<b:glossaryEntry>the reputation and popularity a person has; "his stock was so high he could have been elected mayor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110359261"
	 b:glossaryEntry='good repute; "he is a man of character"'/>
<rdf:Description rdf:about="&a;110359356">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a person''s reputation; "he wanted to protect his good name"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110359466"
	 b:glossaryEntry="favorable public reputation"/>
<rdf:Description rdf:about="&a;110359562"
	 b:glossaryEntry="evil fame or public reputation"/>
<rdf:Description rdf:about="&a;110359681"
	 b:glossaryEntry="the state of being known for some unfavorable act or quality"/>
<rdf:Description rdf:about="&a;110359826">
	<b:glossaryEntry>notoriety for some particular characteristic; "his reputation for promiscuity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110359961">
	<b:glossaryEntry>a state of shame or disgrace; "he was resigned to a life of dishonor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110360205">
	<b:glossaryEntry>the state of being held in low esteem; "your actions will bring discredit to your name"; "because of the scandal the school has fallen into disrepute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110360441"
	 b:glossaryEntry="the state of being corrupt"/>
<rdf:Description rdf:about="&a;110360525">
	<b:glossaryEntry>a state of dishonor; "one mistake brought shame to all his family"; "suffered the ignominy of being sent to prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110360768"
	 b:glossaryEntry="state of disgrace or loss of self-respect"/>
<rdf:Description rdf:about="&a;110360885">
	<b:glossaryEntry>a low or downcast state: "each confesson brought her into an attitude of abasement"- H.L.Menchken</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110361100"
	 b:glossaryEntry="the state of being degenerate in mental or moral qualities"/>
<rdf:Description rdf:about="&a;110361230">
	<b:glossaryEntry>(usually plural) a low moral state; "he had sunk to the depths of addiction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110361358">
	<b:glossaryEntry>a state of extreme dishonor: "a date which will live in infamy"- F.D.Roosevelt; "the name was a by-word of scorn and approbrium throughout the city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110361590"
	 b:glossaryEntry="the state of disgrace resulting from public abuse"/>
<rdf:Description rdf:about="&a;110361706"
	 b:glossaryEntry='disgrace or shame; "he brought reproach upon his family"'/>
<rdf:Description rdf:about="&a;110361817">
	<b:glossaryEntry>the state that exists when one person or group has power over another; "her apparent dominance of her husband was really her attempt to make him pay attention to her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110362210">
	<b:glossaryEntry>position or state of being dominant or in control: "that idea was in the ascendant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110362361"
	 b:glossaryEntry='power to dominate or defeat; "mastery of the seas"'/>
<rdf:Description rdf:about="&a;110362508"
	 b:glossaryEntry="the state of being predominant over others"/>
<rdf:Description rdf:about="&a;110362625"
	 b:glossaryEntry="an equilibrium of power between nations"/>
<rdf:Description rdf:about="&a;110362727">
	<b:glossaryEntry>dominance or power through legal authority; "France held undisputed dominion over vast areas of Africa"; "the rule of Caesar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110362986"
	 b:glossaryEntry="the state of being paramount; the highest rank or authority"/>
<rdf:Description rdf:about="&a;110363103"
	 b:glossaryEntry="British dominion over India (1757-1947)"/>
<rdf:Description rdf:about="&a;110363192"
	 b:glossaryEntry="royal authority; the dominion of a monarch"/>
<rdf:Description rdf:about="&a;110363318"
	 b:glossaryEntry="the imperial authority symbolized by a scepter"/>
<rdf:Description rdf:about="&a;110363428">
	<b:glossaryEntry>the position or authority of a suzerain: "under the suzerainty of..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110363554"
	 b:glossaryEntry="dominance through threat of punishment and violence"/>
<rdf:Description rdf:about="&a;110363684">
	<b:glossaryEntry>exclusive control or possession of something; "They have no monopoly on intelligence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110363824">
	<b:glossaryEntry>(economics) a market in which there are many buyers but only one seller; "a monopoly on silver"; "when you have a monopoly you can ask any price you like"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110364051">
	<b:glossaryEntry>(economics) a market in which goods or services are offered by several sellers but there is only one buyer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110364213">
	<b:glossaryEntry>a temporary monopoly on a kind of commercial trade: "a corner on the silver market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110364349"
	 b:glossaryEntry='something causes misery or death; "the bane of my life"'/>
<rdf:Description rdf:about="&a;110364483">
	<b:glossaryEntry>a state of being relaxed and feeling no pain; "he is a man who enjoys his comfort"; "she longed for the comfortableness of her armchair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110364817">
	<b:glossaryEntry>the condition of being comfortable or relieved (especially after being relieved of distress); "he enjoyed his relief from responsibility"; "getting it off his conscience gave him some ease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110365084"
	 b:glossaryEntry="a (temporary) relief from harm or discomfort"/>
<rdf:Description rdf:about="&a;110365193"
	 b:glossaryEntry="comfort in disappointment or misery"/>
<rdf:Description rdf:about="&a;110365294"
	 b:glossaryEntry="a state of warm snug comfort"/>
<rdf:Description rdf:about="&a;110365399">
	<b:glossaryEntry>the state of being suitable or opportune; "chairs arranged for his own convenience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110365540"
	 b:glossaryEntry="the state of being tense and feeling pain"/>
<rdf:Description rdf:about="&a;110365730"
	 b:glossaryEntry="an inconvenient discomfort"/>
<rdf:Description rdf:about="&a;110365835"
	 b:glossaryEntry="physical discomfort (as mild sickness or depression)"/>
<rdf:Description rdf:about="&a;110365963">
	<b:glossaryEntry>disagreeable aftereffects from the use of drugs (especially alcohol)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110366086">
	<b:glossaryEntry>the state of being happy and healthy and prosperous; "the town was finally on the upbeat after our recent troubles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110366331"
	 b:glossaryEntry="an illusory state of well-being"/>
<rdf:Description rdf:about="&a;110366424"
	 b:glossaryEntry="a healthy state of well-being"/>
<rdf:Description rdf:about="&a;110366542"
	 b:glossaryEntry="lack of prosperity or happiness or health"/>
<rdf:Description rdf:about="&a;110366675">
	<b:glossaryEntry>a state of ill-being due to affliction or misfortune; "the misery and wretchedness of those slums is intolerable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110366892"
	 b:glossaryEntry="a state of constant misery"/>
<rdf:Description rdf:about="&a;110366977"
	 b:glossaryEntry="misery resulting from affliction"/>
<rdf:Description rdf:about="&a;110367071"
	 b:glossaryEntry="extreme distress of body or mind"/>
<rdf:Description rdf:about="&a;110367157">
	<b:glossaryEntry>a condition requiring relief; "she satified his need for affection"; "God has no need of men to accomplish His work"; "there is a demand for jobs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110367399">
	<b:glossaryEntry>the state of needing something that is absent or unavailable; "there is a serious lack of insight into the problem"; "water is the critical deficiency in desert regions"; "for want of a nail the shoe was lost"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110367751"
	 b:glossaryEntry="a severe shortage (especially a shortage of food)"/>
<rdf:Description rdf:about="&a;110367873">
	<b:glossaryEntry>a state occasioned by scarcity of money and a shortage of credit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110368006"
	 b:glossaryEntry="the condition of being essential or indispensable"/>
<rdf:Description rdf:about="&a;110368183"
	 b:glossaryEntry="the state of being absolutely required"/>
<rdf:Description rdf:about="&a;110368281">
	<b:glossaryEntry>the state of being urgent; an earnest and insistent necessity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110368450">
	<b:glossaryEntry>a condition of urgency making it necessary to hurry; "in a hurry to lock the door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110368592">
	<b:glossaryEntry>the state of urgently demanding notice or attention; "the press of business matters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110368782"
	 b:glossaryEntry="a state of critical urgency"/>
<rdf:Description rdf:about="&a;110368895"
	 b:glossaryEntry="the condition of being filled to capacity"/>
<rdf:Description rdf:about="&a;110369117">
	<b:glossaryEntry>the state of being satisfactorily full and unable to take on more</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110369260"
	 b:glossaryEntry="the state of being more than full"/>
<rdf:Description rdf:about="&a;110369372"
	 b:glossaryEntry="state of having the interior filled with matter"/>
<rdf:Description rdf:about="&a;110369528">
	<b:glossaryEntry>the state of being overrun in unpleasantly large numbers (as by parasites)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110369786"
	 b:glossaryEntry="infestation with itch mites"/>
<rdf:Description rdf:about="&a;110369895"
	 b:glossaryEntry="infestation of the human intestine with Ascaris roundworms"/>
<rdf:Description rdf:about="&a;110370010"
	 b:glossaryEntry="(veterinary medicine) infestation with coccidia"/>
<rdf:Description rdf:about="&a;110370115"
	 b:glossaryEntry="infestation with echinococci (tapeworms)"/>
<rdf:Description rdf:about="&a;110370216">
	<b:glossaryEntry>infestation with slender threadlike roundworms (filaria) deposited under the skin by the bite of black fleas; when the eyes are involved it can result in blindness; common in Africa and tropical America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110370497">
	<b:glossaryEntry>infestation with lice (Pediculus humanus) resulting in severe itching</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110370654"
	 b:glossaryEntry="infestation with chiggers"/>
<rdf:Description rdf:about="&a;110370740"
	 b:glossaryEntry="infestation by crab lice"/>
<rdf:Description rdf:about="&a;110370816"
	 b:glossaryEntry="the state of containing nothing"/>
<rdf:Description rdf:about="&a;110371011"
	 b:glossaryEntry="the state of being blank; void; emptiness"/>
<rdf:Description rdf:about="&a;110371108"
	 b:glossaryEntry="the state of being hollow: having an empty space within"/>
<rdf:Description rdf:about="&a;110371238"
	 b:glossaryEntry="the state of nonexistence"/>
<rdf:Description rdf:about="&a;110371356">
	<b:glossaryEntry>nowhere to be found in a giant void; "it vanished into thin air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110371470"
	 b:glossaryEntry="being unoccupied"/>
<rdf:Description rdf:about="&a;110371540"
	 b:glossaryEntry="total absence of matter"/>
<rdf:Description rdf:about="&a;110371631"
	 b:glossaryEntry="the absence of matter"/>
<rdf:Description rdf:about="&a;110371715"
	 b:glossaryEntry="the state of being without clothing or covering of any kind"/>
<rdf:Description rdf:about="&a;110371922"
	 b:glossaryEntry='as in the phrase "They swam in the nude"'/>
<rdf:Description rdf:about="&a;110372013"
	 b:glossaryEntry='informal; "in the raw" or "in his birthday suit"'/>
<rdf:Description rdf:about="&a;110372147"
	 b:glossaryEntry='partial or complete nakedness; "a state of undress"'/>
<rdf:Description rdf:about="&a;110372252">
	<b:glossaryEntry>the state of being unclothed and exposed (especially of a part of the body)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110372382">
	<b:glossaryEntry>the condition of having no hair (especially on the top of the head)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110372569">
	<b:glossaryEntry>loss of hair (especially on the head) or wool or feathers; in humans it can result from heredity or hormonal imbalance or certain diseases or drugs and treatments (chemotherapy for cancer)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110372830"
	 b:glossaryEntry="patchy baldness"/>
<rdf:Description rdf:about="&a;110372907"
	 b:glossaryEntry="loss of hair on the crown of the head"/>
<rdf:Description rdf:about="&a;110373014"
	 b:glossaryEntry="the state of being carelessly or partially dressed"/>
<rdf:Description rdf:about="&a;110373152">
	<b:glossaryEntry>not wearing a jacket; "in your shirtsleeves" means you are not wearing anything over your shirt; "in hot weather they dined in their shirtsleeves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110373357"
	 b:glossaryEntry="a state of sanctification by God"/>
<rdf:Description rdf:about="&a;110373458"
	 b:glossaryEntry="the state of being condemned to eternal punishment in Hell"/>
<rdf:Description rdf:about="&a;110373610">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(Old Testament) God''s means of destroying sinners; "his sermons were full of fire and brimstone"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110373771"
	 b:glossaryEntry="the state of being omniscient; having infinite knowledge"/>
<rdf:Description rdf:about="&a;110373903"
	 b:glossaryEntry="the omniscience of a divine being"/>
<rdf:Description rdf:about="&a;110373995"
	 b:glossaryEntry="the state of being omnipotent; having unlimited power"/>
<rdf:Description rdf:about="&a;110374124"
	 b:glossaryEntry="the omnipotence of a divine being"/>
<rdf:Description rdf:about="&a;110374214"
	 b:glossaryEntry="the state of being without a flaw or defect"/>
<rdf:Description rdf:about="&a;110374471"
	 b:glossaryEntry='someone of something wonderful; "this dessert is a dream"'/>
<rdf:Description rdf:about="&a;110374580"
	 b:glossaryEntry='a highly developed state; "they performed with great polish"'/>
<rdf:Description rdf:about="&a;110374706">
	<b:glossaryEntry>state of perfection; the utmost degree; "they polished the furniture to a fare-thee-well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110374856"
	 b:glossaryEntry="the state of being unimpaired"/>
<rdf:Description rdf:about="&a;110374942"
	 b:glossaryEntry="an unreduced or unbroken completeness or totality"/>
<rdf:Description rdf:about="&a;110375193">
	<b:glossaryEntry>the state of being complete and entire; having everything that is needed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110375432">
	<b:glossaryEntry>the state of being total: "appalled by the totality of the destruction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110375600"
	 b:glossaryEntry="completeness over a broad scope"/>
<rdf:Description rdf:about="&a;110375724"
	 b:glossaryEntry="undivided purpose or will or enthusiasm"/>
<rdf:Description rdf:about="&a;110375826">
	<b:glossaryEntry xml:space='preserve'><![CDATA[everything available; usually preceded by `the''; "we saw the whole shebang"; "a hotdog with the works"; "we took on the whole caboodle"; "for $10 you get the full treatment"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110376211"
	 b:glossaryEntry="the state of being only a part; not total; incomplete"/>
<rdf:Description rdf:about="&a;110376322"
	 b:glossaryEntry="the state of being incomplete and imperfect"/>
<rdf:Description rdf:about="&a;110376480"
	 b:glossaryEntry="incompleteness of details"/>
<rdf:Description rdf:about="&a;110376563"
	 b:glossaryEntry="the state or an instance of being imperfect"/>
<rdf:Description rdf:about="&a;110376771">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a flaw or weak point; "he was quick to point out his wife''s failings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110376959">
	<b:glossaryEntry>a failing in the character of a tragic hero that leads to his downfall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110377087">
	<b:glossaryEntry>a lack of competence; "pointed out the insufficiencies in my report"; "juvenile offenses often reflect an inadequacy in the parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110377292">
	<b:glossaryEntry>(of materials (especially metals)) the state of being weakened by long stress: "metal fatigue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110377440">
	<b:glossaryEntry>an imperfection in a bodily system; "visual defects"; "this device permits detection of defects in the lungs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110377620">
	<b:glossaryEntry>an imperfection in a device or machine; "if there are any defects you should send it back to the manufacturer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110377834"
	 b:glossaryEntry="a fault or defect in a system or machine"/>
<rdf:Description rdf:about="&a;110377933"
	 b:glossaryEntry='a fault; "he shot holes in my argument"'/>
<rdf:Description rdf:about="&a;110378023"
	 b:glossaryEntry="a defect that is present at birth"/>
<rdf:Description rdf:about="&a;110378617">
	<b:glossaryEntry>an abnormal condition in which cerebrospinal fluid collects in the ventricles of the brain; in infants it can cause abnormally rapid growth of the head and bulging fontanelles and a small face; in adults the symptoms are primarily neurological</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110378935"
	 b:glossaryEntry="the condition of having no arms"/>
<rdf:Description rdf:about="&a;110379021"
	 b:glossaryEntry="congenital absence of an arm or leg"/>
<rdf:Description rdf:about="&a;110379109"
	 b:glossaryEntry="congenital absence of part of an arm or leg"/>
<rdf:Description rdf:about="&a;110379244">
	<b:glossaryEntry>an abnormality of development in which the upper part of an arm or leg is missing so the hands or feet are attached to the body like stumps; rare condition that results from taking thalidomide during pregnancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110379523">
	<b:glossaryEntry>a congenital anomaly of the central nervous system in which a sac protruding from the brain or the spinal meninges contains cerebrospinal fluid (but no nerve tissue)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110379746">
	<b:glossaryEntry>a congenital defect of the central nervous system in which a sac containing part of the spinal cord and its meninges protrude through a gap in the vertebral column; frequently accompanied by hydrocephalus and mental retardation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110380036">
	<b:glossaryEntry>congenital malformation of the skull which is long and narrow; frequently accompanied by mental retardation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110380203">
	<b:glossaryEntry>a congenital abnormality in the septum between the left and right sides of the heart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110380383">
	<b:glossaryEntry>an abnormal opening between the left and right atria of the heart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110380515">
	<b:glossaryEntry>a common congenital heart defect; an abnormal opening in the septum dividing the ventricles allows blood to pass directly from the left to the right ventricle; large openings may cause congestive heart failure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110380796">
	<b:glossaryEntry>a not uncommon congenital defect in which a vertebra is malformed; unless several vertebrae are affected or there is myelomeningocele there are few symptoms; can be diagnosed by amniocentesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110381064">
	<b:glossaryEntry>any of several congenital disorders marked by degeneration of the cerebellum and spinal cord resulting in spasticity and ataxia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110381281">
	<b:glossaryEntry>a birth defect (in humans) in which there is partial or total webbing connecting two or more fingers or toes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110381461">
	<b:glossaryEntry>a congenital anomaly in which the mucous membrane under the tongue is too short limiting the mobility of the tongue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110381649"
	 b:glossaryEntry="the state of being defective"/>
<rdf:Description rdf:about="&a;110381768"
	 b:glossaryEntry="the state of having bugs"/>
<rdf:Description rdf:about="&a;110381848"
	 b:glossaryEntry="a natural or unrefined state"/>
<rdf:Description rdf:about="&a;110381983">
	<b:glossaryEntry>your overall circumstances or condition in life (including everything that happens to you): "whatever my fortune may be"; "deserved a better fate"; "has a happy lot"; "the luck of the Irish"; "a victim of circumstances"; "success that was her portion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110382416"
	 b:glossaryEntry="a auspicious state resulting from favorable outcomes"/>
<rdf:Description rdf:about="&a;110382611">
	<b:glossaryEntry>a manifestation of God''s foresightful care for His creatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110382728"
	 b:glossaryEntry="the condition of prospering; having good fortune"/>
<rdf:Description rdf:about="&a;110382904">
	<b:glossaryEntry>a desirable state; "enjoy the blessings of peace"; "a spanking breeze is a boon to sailors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110383075">
	<b:glossaryEntry>something for which to be thankful; "it was a mercy we got out alive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110383196">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the condition of financial success; "the strength of the company''s stock in recent weeks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110383358">
	<b:glossaryEntry>the condition of being financially weak; "the weakness of the dollar against the yen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110383516">
	<b:glossaryEntry>a state of prosperity or fame; "he is enjoying great success"; "he does not consider wealth synonymous with success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110383776">
	<b:glossaryEntry>the highest level of an occupation (especially in entertainment)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110383895">
	<b:glossaryEntry>a profitable success; "the inventor worked for years before hitting pay dirt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110384027"
	 b:glossaryEntry="an unfortunate state resulting from unfavorable outcomes"/>
<rdf:Description rdf:about="&a;110384234">
	<b:glossaryEntry>a state of misfortune or affliction: "debt-ridden farmers struggling with adversity"; "a life of hardship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110384515">
	<b:glossaryEntry>a state of extreme (usually irremediable) ruin and misfortune; "lack of funds has resulted in a catastrophe for our school system"; "his policies were a disaster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110384746">
	<b:glossaryEntry>an extreme condition or state (especially of adversity or disease)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110384886">
	<b:glossaryEntry>the final extremity (however unpleasant it may be); "he was determined to fight to the bitter end"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110385041">
	<b:glossaryEntry>a state of adversity (danger or affliction or need); "in trouble with the police"; "he wanted to cure the ills of all mankind"; "she was the classic maiden in distress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110385316">
	<b:glossaryEntry>hard or painful trouble or struggle: "a country in the throes of economic collapse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110385451"
	 b:glossaryEntry="a state of great suffering and distress due to adversity"/>
<rdf:Description rdf:about="&a;110385582">
	<b:glossaryEntry>any affliction that causes great suffering; "that is his cross to bear"; "he bears his afflictions like a crown of thorns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110385774"
	 b:glossaryEntry="lack of success"/>
<rdf:Description rdf:about="&a;110385915"
	 b:glossaryEntry="the ability to meet maturing obligations as they come due"/>
<rdf:Description rdf:about="&a;110386045"
	 b:glossaryEntry="lacking financial resources"/>
<rdf:Description rdf:about="&a;110386165"
	 b:glossaryEntry="inability to discharge all ones debts as they come due"/>
<rdf:Description rdf:about="&a;110386276">
	<b:glossaryEntry>a state of complete lack of some abstract property; "spiritual bankruptcy"; "moral bankruptcy"; "intellectual bankruptcy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110386454"
	 b:glossaryEntry="the inability of a bank to meet its credit obligations"/>
<rdf:Description rdf:about="&a;110386567"
	 b:glossaryEntry="the failure of crops to produce a marketable surplus"/>
<rdf:Description rdf:about="&a;110386678">
	<b:glossaryEntry>the state of property that is in the hands of a receiver; "the business is in receivership"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110386828"
	 b:glossaryEntry="the state or fact of being an owner"/>
<rdf:Description rdf:about="&a;110386919">
	<b:glossaryEntry>(chemistry) the three traditional states of matter are solids (fixed shape and volume) and liquids (fixed volume and shaped by the container) and gases (filling the container); "the solid state of water is called ice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110387350">
	<b:glossaryEntry>(physical chemistry) a distinct state of matter in a system; matter that is identical in chemical composition and physical state and separated from other material by the phase boundary: "the reaction occurs in the liquid phase of the system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110387643">
	<b:glossaryEntry>the state in which a substance exhibits a characteristic readiness to flow with little or no tendency to disperse and relatively high incompressibility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110387872">
	<b:glossaryEntry>the state in which a substance has no tendency to flow under moderate stress; resists forces (such as compression) that tend to deform it; and retains an definite size and shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110388113">
	<b:glossaryEntry>the state of matter distinguished from the solid and liquid states by: relatively low density and viscosity; relatively great expansion and contraction with changes in pressure and temperature; the ability to diffuse readily; and the spontaneous tendency to become distributed uniformly throughout any container</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110388474">
	<b:glossaryEntry>(physical chemistry) the gaseous state of hot ionized material consisting of ions and electrons and present in the stars and fusion reactors: sometimes regarded as a fourth state of matter distinct from normal gasses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110388744">
	<b:glossaryEntry>capability of existing or happening or being true; "there is a possibility that his sense of smell has been impaired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110389060"
	 b:glossaryEntry="the state of being conceivable"/>
<rdf:Description rdf:about="&a;110389169"
	 b:glossaryEntry="the state of being achievable"/>
<rdf:Description rdf:about="&a;110389291"
	 b:glossaryEntry="the inherent capacity for coming into being"/>
<rdf:Description rdf:about="&a;110389469"
	 b:glossaryEntry="the state of being not yet evident or active"/>
<rdf:Description rdf:about="&a;110389567">
	<b:glossaryEntry>the possibility of future success; "his prospects as a writer are excellent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110389698"
	 b:glossaryEntry="incapability of existing or occurring"/>
<rdf:Description rdf:about="&a;110389866"
	 b:glossaryEntry="the state of being impossible to conceive"/>
<rdf:Description rdf:about="&a;110389990"
	 b:glossaryEntry="the state of being unattainable"/>
<rdf:Description rdf:about="&a;110390084"
	 b:glossaryEntry="full of hope"/>
<rdf:Description rdf:about="&a;110390190">
	<b:glossaryEntry>a state of confident hopefulness that events will be favorable; "public confidence in the economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110390345">
	<b:glossaryEntry>a possibility due to a favorable combination of circumstances; "the holiday gave us the opportunity to visit Washington"; "now is your chance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110390752">
	<b:glossaryEntry>a period of opportunity; "he deserves his day in court"; "every dog has his day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110390882"
	 b:glossaryEntry="an opportunity to start over without prejudice"/>
<rdf:Description rdf:about="&a;110391014">
	<b:glossaryEntry>an opportunity to state your case and be heard; "they condemned him without a hearing"; "he saw that he had lost his audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110391205"
	 b:glossaryEntry="a place where opportunities abound"/>
<rdf:Description rdf:about="&a;110391300">
	<b:glossaryEntry>an opportunity to do something; "there was never an occasion for her to demonstrate her skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110391467">
	<b:glossaryEntry>opportunity especially for employment or promotion; "there is an opening in the sales department"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110391618"
	 b:glossaryEntry='opportunity for; "room for improvement"'/>
<rdf:Description rdf:about="&a;110391708"
	 b:glossaryEntry='the chance to speak; "let him have his say"'/>
<rdf:Description rdf:about="&a;110391801">
	<b:glossaryEntry>(informal) a chance to do something; "he wanted a shot at the champion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110391931">
	<b:glossaryEntry>(informal) a situation offering opportunities; "he worked both sides of the street"; "cooperation is a two-way street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110392102">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) a single chance or instance; "he couldn''t afford $50 a throw"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110392226"
	 b:glossaryEntry="wishing with confidence of fulfillment"/>
<rdf:Description rdf:about="&a;110392337">
	<b:glossaryEntry>a state in which everything seems wrong and will turn out badly; "they were rescued from despair at the last minute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110392521"
	 b:glossaryEntry="a state of melancholy depression"/>
<rdf:Description rdf:about="&a;110392609"
	 b:glossaryEntry="an extreme state of adversity; the lowest point of anything"/>
<rdf:Description rdf:about="&a;110392737"
	 b:glossaryEntry="being undiluted or unmixed with extraneous material"/>
<rdf:Description rdf:about="&a;110392924">
	<b:glossaryEntry>the state of being unmixed with other material; "the plainess of vanilla ice cream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110393063"
	 b:glossaryEntry="the condition of being impure"/>
<rdf:Description rdf:about="&a;110393286"
	 b:glossaryEntry="being mixed with extraneous material"/>
<rdf:Description rdf:about="&a;110393394">
	<b:glossaryEntry>the state of impairing the quality or reducing the value of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110393527"
	 b:glossaryEntry="the state of being contaminated"/>
<rdf:Description rdf:about="&a;110393644"
	 b:glossaryEntry="state of being contaminated with dust"/>
<rdf:Description rdf:about="&a;110393746"
	 b:glossaryEntry="the state of containing dirty impurities"/>
<rdf:Description rdf:about="&a;110393842"
	 b:glossaryEntry="the state of being putrid"/>
<rdf:Description rdf:about="&a;110393923"
	 b:glossaryEntry="the condition of finances"/>
<rdf:Description rdf:about="&a;110394305">
	<b:glossaryEntry>a state in which there is a short supply of cash to lend to businesses and consumers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110394468">
	<b:glossaryEntry>a long-term economic state characterized by unemployment and low prices and low levels of trade and investment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110394679">
	<b:glossaryEntry>the economic crisis beginning with the stock market crash in 1929 and continuing through the 1930s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110394840">
	<b:glossaryEntry>the economic condition when everyone who wishes to work at the going wage-rate for their type of labor is employed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110395016">
	<b:glossaryEntry>an economic state of growth with rising profits and full employment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110395158"
	 b:glossaryEntry="a state of economic prosperity"/>
<rdf:Description rdf:about="&a;110395239"
	 b:glossaryEntry="a financial condition of being indebted"/>
<rdf:Description rdf:about="&a;110395421"
	 b:glossaryEntry='the state of owing money; "he is badly in debt"'/>
<rdf:Description rdf:about="&a;110395519"
	 b:glossaryEntry="the state of having financial obligations"/>
<rdf:Description rdf:about="&a;110395617">
	<b:glossaryEntry>a liability account showing how much is owed for goods and services purchased on credit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110395766">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an amount due (as at a restaurant or bar); "add it to my score and I''ll settle later"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110395903"
	 b:glossaryEntry="obligations of all kinds taken as a whole"/>
<rdf:Description rdf:about="&a;110396003">
	<b:glossaryEntry>the state of being rich and affluent; having a plentiful supply of material goods and money: "great wealth is not a sign of great intelligence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110396321">
	<b:glossaryEntry>the state (usually personal) with regard to wealth; "each person was helped according to his circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110396488"
	 b:glossaryEntry="abundant wealth"/>
<rdf:Description rdf:about="&a;110396588">
	<b:glossaryEntry>a freedom from financial difficulty that promotes a comfortable state: "a life of luxury and ease"; "he had all the material comforts of this world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110396797"
	 b:glossaryEntry="wealth as evidenced by sumptuous living"/>
<rdf:Description rdf:about="&a;110396932"
	 b:glossaryEntry="wealth regarded as an evil influence"/>
<rdf:Description rdf:about="&a;110397021">
	<b:glossaryEntry>inherited wealth; "he was born with a silver spoon in his mouth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110397144">
	<b:glossaryEntry>the state of having little or no money and few or no material possessions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110397389"
	 b:glossaryEntry="a state of extreme poverty"/>
<rdf:Description rdf:about="&a;110397492"
	 b:glossaryEntry="a state without friends or money or prospects"/>
<rdf:Description rdf:about="&a;110397595">
	<b:glossaryEntry>a state of extreme poverty or destitution; "their indigence appalled him"; "a general state of need exists among the homeless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110397805"
	 b:glossaryEntry="a state of lacking money"/>
<rdf:Description rdf:about="&a;110397923">
	<b:glossaryEntry>a financial condition that results in the elimination of marginally financed participants in an industry; "they glutted the market in order to cause a shakeout of their competitors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110398159">
	<b:glossaryEntry>any financial condition or variable that serves to set wage rates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110398282"
	 b:glossaryEntry="the state of sanitation (clean or dirty)"/>
<rdf:Description rdf:about="&a;110398459"
	 b:glossaryEntry="the state of being conducive to health"/>
<rdf:Description rdf:about="&a;110398628"
	 b:glossaryEntry='a condition promoting sanitary practices; "personal hygiene"'/>
<rdf:Description rdf:about="&a;110398742">
	<b:glossaryEntry>(of non-living objects) the state of being free of pathogenic organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110398906"
	 b:glossaryEntry="the state of being clean and conducive to health"/>
<rdf:Description rdf:about="&a;110399011"
	 b:glossaryEntry="a state that is not conducive to health"/>
<rdf:Description rdf:about="&a;110399165"
	 b:glossaryEntry="a state characterized by foul or disgusting dirt and refuse"/>
<rdf:Description rdf:about="&a;110399312"
	 b:glossaryEntry="a foul or degraded condition"/>
<rdf:Description rdf:about="&a;110399395">
	<b:glossaryEntry>the state of aggregation of soil and its condition for supporting plant growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110399525"
	 b:glossaryEntry="the state of being clean; without dirt or other impurities"/>
<rdf:Description rdf:about="&a;110399711"
	 b:glossaryEntry="the habit of keeping free of superficial imperfections"/>
<rdf:Description rdf:about="&a;110399841"
	 b:glossaryEntry="the state of being spotlessly clean"/>
<rdf:Description rdf:about="&a;110399952">
	<b:glossaryEntry>a condition of regular or proper arrangement: "he put his desk in order"; "put the chessmen in order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110400191">
	<b:glossaryEntry>careful attention to order and appearance (as in the military)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110400315"
	 b:glossaryEntry="the habit of being tidy"/>
<rdf:Description rdf:about="&a;110400429"
	 b:glossaryEntry="the state of being neat and smart and trim"/>
<rdf:Description rdf:about="&a;110400557"
	 b:glossaryEntry='a state of arrangement or appearance: "in good trim"'/>
<rdf:Description rdf:about="&a;110400671"
	 b:glossaryEntry="a condition of great disorder"/>
<rdf:Description rdf:about="&a;110400755"
	 b:glossaryEntry="the state of being unsanitary"/>
<rdf:Description rdf:about="&a;110400980"
	 b:glossaryEntry="the state of being covered with unclean things"/>
<rdf:Description rdf:about="&a;110401117"
	 b:glossaryEntry="the state of being polluted"/>
<rdf:Description rdf:about="&a;110401226"
	 b:glossaryEntry="the state of being grimy"/>
<rdf:Description rdf:about="&a;110401319"
	 b:glossaryEntry="sordid dirtiness"/>
<rdf:Description rdf:about="&a;110401416"
	 b:glossaryEntry="discoloration due to dirtiness"/>
<rdf:Description rdf:about="&a;110401502"
	 b:glossaryEntry="the state of being dirty with soot"/>
<rdf:Description rdf:about="&a;110401605"
	 b:glossaryEntry="the habit of neglecting cleanliness"/>
<rdf:Description rdf:about="&a;110401718">
	<b:glossaryEntry>a condition in which things are not in their expected places: "the files are in complete disorder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110402014"
	 b:glossaryEntry="the condition of being untidy"/>
<rdf:Description rdf:about="&a;110402136"
	 b:glossaryEntry="untidiness in personal appearance"/>
<rdf:Description rdf:about="&a;110402273"
	 b:glossaryEntry="unkemptness of hair"/>
<rdf:Description rdf:about="&a;110402349">
	<b:glossaryEntry>a state of confusion and disorderliness; "the house was a mess"; "she smoothed the mussiness of the bed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110402535"
	 b:glossaryEntry="a condition in which an orderly system has been disrupted"/>
<rdf:Description rdf:about="&a;110402671"
	 b:glossaryEntry="a confused multitude of things"/>
<rdf:Description rdf:about="&a;110402824"
	 b:glossaryEntry="a jumble of things to be given away"/>
<rdf:Description rdf:about="&a;110402913"
	 b:glossaryEntry="conformity with the norm"/>
<rdf:Description rdf:about="&a;110403112">
	<b:glossaryEntry>the state of being average; indicates normality but with connotations of mediocrity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110403253"
	 b:glossaryEntry="the state of being commonly observed"/>
<rdf:Description rdf:about="&a;110403361"
	 b:glossaryEntry="the state of being that is typical"/>
<rdf:Description rdf:about="&a;110403506"
	 b:glossaryEntry="an abnormal condition"/>
<rdf:Description rdf:about="&a;110404228">
	<b:glossaryEntry>collapse of an expanded lung (especially in infants); also failure of pulmonary alveoli to expand at birth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110404392"
	 b:glossaryEntry="any state that is not typical"/>
<rdf:Description rdf:about="&a;110404512"
	 b:glossaryEntry="abnormally low oxygen content in arterial blood"/>
<rdf:Description rdf:about="&a;110404614">
	<b:glossaryEntry>an abnormal state in which development has stopped prematurely</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110404788">
	<b:glossaryEntry>an uncontrollable use of obscene language; often accompanied by mental disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110404925"
	 b:glossaryEntry="an aberrant state or condition"/>
<rdf:Description rdf:about="&a;110405083"
	 b:glossaryEntry="a developmental abnormality in which there is only one eye"/>
<rdf:Description rdf:about="&a;110405196">
	<b:glossaryEntry>any change in the normal structure or number of chromosomes; often results in physical or mental abnormalities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110405415">
	<b:glossaryEntry>a twist or aberration; especially a perverse or abnormal way of judging or acting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110405560"
	 b:glossaryEntry="an abnormal curvature of the vertebral column"/>
<rdf:Description rdf:about="&a;110405722"
	 b:glossaryEntry="an abnormal backward curve to the vertebral column"/>
<rdf:Description rdf:about="&a;110405850">
	<b:glossaryEntry>an abnormal inward (forward) curvature of the vertebral column</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110405981"
	 b:glossaryEntry="an abnormal lateral curve to the vertebral column"/>
<rdf:Description rdf:about="&a;110406086">
	<b:glossaryEntry>the state of being less than normal (especially with respect to intelligence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110406222"
	 b:glossaryEntry="deviation from the normal or common order or form or rule"/>
<rdf:Description rdf:about="&a;110406349">
	<b:glossaryEntry>excessive development of the breasts in males; usually the result of hormonal imbalance or treatment with certain drugs (including some antihypertensives)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110406562"
	 b:glossaryEntry="strabismus in which eyes turn inward toward the nose"/>
<rdf:Description rdf:about="&a;110406708"
	 b:glossaryEntry="a genetic abnormality resulting in short stature"/>
<rdf:Description rdf:about="&a;110406838">
	<b:glossaryEntry>a form of dwarfism accompanied by fragile bones and bad teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110406961">
	<b:glossaryEntry>a genetic abnormality of metabolism causing abdominal pains and mental confusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110407097">
	<b:glossaryEntry>an abnormal condition in which an older child or adult retains infantile characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110407261">
	<b:glossaryEntry>a form of infantilism characterized by physical underdevelopment but normal intelligence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110407418">
	<b:glossaryEntry>an abnormally large head; differs from hydrocephalus because there is no increased intracranial pressure and the overgrowth is symmetrical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110407645"
	 b:glossaryEntry="abnormally small arms"/>
<rdf:Description rdf:about="&a;110407725"
	 b:glossaryEntry="an abnormally small head and underdeveloped brain"/>
<rdf:Description rdf:about="&a;110407863">
	<b:glossaryEntry>the physiological state produced by a poison or a toxic substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110408110">
	<b:glossaryEntry>poisoning resulting from the ingestion of an alkali compound (as lye or ammonia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110408253">
	<b:glossaryEntry>poisoning resulting from excessive intake of caffeine containing products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110408407">
	<b:glossaryEntry>a toxic condition that results from inhaling and absorbing carbon monoxide gas; "carbon monoxide combines with hemoglobin and displaces oxygen in the blood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110408654">
	<b:glossaryEntry>poisoning due to ingesting or inhaling cyanide; common in smoke from fires and in industrial chemicals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110408820">
	<b:glossaryEntry>a toxic condition caused by inhaling or ingesting the insecticide Malathion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110408961"
	 b:glossaryEntry="a toxic condition caused by ingesting or inhaling mercury"/>
<rdf:Description rdf:about="&a;110409100">
	<b:glossaryEntry>a form of mercury poisoning among people who ate fish from mercury-contaminated waters of Minamata Bay off Japan in the 1950s; characterized by severe neurological degeneration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110409339">
	<b:glossaryEntry>poisoning caused by the excessive ingestion of salicylates (usually aspirin)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110409482">
	<b:glossaryEntry>the set of facts or circumstances that surround a situation or event; "the historical context"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110409645">
	<b:glossaryEntry>the environment as it relates to living organisms; "it changed the ecology of the island"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110409788">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the state of the environment in which a situation exists; "you can''t do that in a university setting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110410000">
	<b:glossaryEntry>the setting for a narrative or fictional or dramatic account; "the crowded canvas of history;" "the movie demanded a dramatic canvas of sound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110410205">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an environment offering affection and security; "home is where the heart is"; "he grew up in a good Christian home"; "there''s no place like home"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110410402"
	 b:glossaryEntry="the environmental condition"/>
<rdf:Description rdf:about="&a;110410497">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a particular environment or walk of life; "his social sphere is limited"; "it was a closed area of employment"; "he''s out of my orbit"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110410850"
	 b:glossaryEntry="the sphere of work by women"/>
<rdf:Description rdf:about="&a;110410931">
	<b:glossaryEntry>a sphere of activity involving effort; "the Japanese were active last week on the diplomatic front"; "they advertise on many different fronts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110411125">
	<b:glossaryEntry>a domain in which something is dominant; "the untroubled kingdom of reason"; "a land of make-believe"; "the rise of the realm of cotton in the south"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110411343">
	<b:glossaryEntry>an area of control or responsibility; "the job fell right in my lap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110411461"
	 b:glossaryEntry="a sphere of intense political activity"/>
<rdf:Description rdf:about="&a;110411580">
	<b:glossaryEntry>a domain that seems to be specially reserved for someone; "medicine is no longer a male preserve"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110411732">
	<b:glossaryEntry>the proper sphere or extent of your activities; "it was his province to take care of himself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110411897">
	<b:glossaryEntry>a setting in which something can be displayed to best effect; "it was a showcase for democracy in Africa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110412071">
	<b:glossaryEntry>the streets of a city viewed as a depressed environment in which there is poverty and crime and prostitution and dereliction; "she tried to keep her children off the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110412297"
	 b:glossaryEntry="the state of the environment"/>
<rdf:Description rdf:about="&a;110412503"
	 b:glossaryEntry="the state of being contaminated with harmful substances"/>
<rdf:Description rdf:about="&a;110412686"
	 b:glossaryEntry="pollution of the air"/>
<rdf:Description rdf:about="&a;110412820">
	<b:glossaryEntry>rain containing acids that form in the atmosphere when industrial gas emissions combine with water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110412995">
	<b:glossaryEntry>unhealthy vapors rising from the ground or other sources; "the miasma of the marshes" or "a miasma of cigar smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110413162"
	 b:glossaryEntry="air pollution by a mixture of smoke and fog"/>
<rdf:Description rdf:about="&a;110413269"
	 b:glossaryEntry="annoying and potentially harmful environmental noise"/>
<rdf:Description rdf:about="&a;110413401"
	 b:glossaryEntry="pollution of the water"/>
<rdf:Description rdf:about="&a;110413485">
	<b:glossaryEntry>condition in which the earth''s surface is worn away by the action of water and wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110413622"
	 b:glossaryEntry="the state of being clear of trees"/>
<rdf:Description rdf:about="&a;110413715"
	 b:glossaryEntry="the condition of having reduced numbers of inhabitants"/>
<rdf:Description rdf:about="&a;110413828">
	<b:glossaryEntry>the weather in some location averaged over some long period of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110413957">
	<b:glossaryEntry>the prevailing environmental conditions as they influence the prediction of weather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110414112">
	<b:glossaryEntry>the weather or climate at some place; "the atmosphere was thick with fog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110414334">
	<b:glossaryEntry>a large body of air with uniform characteristics horizontally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110414486">
	<b:glossaryEntry>an air mass of higher than normal pressure; "the east coast benefits from a Bermuda high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110414642">
	<b:glossaryEntry>an air mass of lower pressure; often brings precipitation; "a low moved in over night bringing sleet and snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110414830">
	<b:glossaryEntry>(meteorology) winds spiraling outward from a high-pressure center; circling clockwise in the northern hemisphere and counter-clockwise in the southern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110415056">
	<b:glossaryEntry>(meteorology) rapid inward circulation of air masses about a low-pressure center; circling counterclockwise in the northern hemisphere and clockwise in the southern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110415292">
	<b:glossaryEntry>an atmosphere in which visibility is reduced because of a cloud of some substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110415472"
	 b:glossaryEntry="(British informal) an airless smoky smelly atmosphere"/>
<rdf:Description rdf:about="&a;110415575"
	 b:glossaryEntry="weather suitable for outdoor activities"/>
<rdf:Description rdf:about="&a;110415727"
	 b:glossaryEntry="an absence of strong winds or rain"/>
<rdf:Description rdf:about="&a;110415852"
	 b:glossaryEntry="good weather with comfortable temperatures"/>
<rdf:Description rdf:about="&a;110415960"
	 b:glossaryEntry="calmness without winds"/>
<rdf:Description rdf:about="&a;110416053"
	 b:glossaryEntry='a period of calm weather; "there was a lull in the storm"'/>
<rdf:Description rdf:about="&a;110416169"
	 b:glossaryEntry="weather unsuitable for outdoor activities"/>
<rdf:Description rdf:about="&a;110416387"
	 b:glossaryEntry="unpleasantly cold and damp weather"/>
<rdf:Description rdf:about="&a;110416479">
	<b:glossaryEntry>the state of being stormy; "he dreaded the storminess of the North Atlantic in winter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110416694"
	 b:glossaryEntry="a turbulent and stormy state of the sea"/>
<rdf:Description rdf:about="&a;110416794"
	 b:glossaryEntry="a mildly windy state of the air"/>
<rdf:Description rdf:about="&a;110416894"
	 b:glossaryEntry="a state of wild storminess"/>
<rdf:Description rdf:about="&a;110416982"
	 b:glossaryEntry="used of the sea"/>
<rdf:Description rdf:about="&a;110417080"
	 b:glossaryEntry="the state of the sky when it is covered by clouds"/>
<rdf:Description rdf:about="&a;110417211"
	 b:glossaryEntry="instability in the atmosphere"/>
<rdf:Description rdf:about="&a;110417315">
	<b:glossaryEntry>strong turbulence in an otherwise cloudless region that subjects aircraft to violent updrafts or downdrafts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110417489">
	<b:glossaryEntry>the prevailing psychological state; "the climate of opinion"; "the national mood had changed radically since the last election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110417677">
	<b:glossaryEntry>a particular environment or surrounding influence; "there was an atmosphere of excitement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110417936"
	 b:glossaryEntry="the special atmosphere of a place"/>
<rdf:Description rdf:about="&a;110418027">
	<b:glossaryEntry>an atmosphere of depression and melancholy; "gloom pervaded the office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110418192"
	 b:glossaryEntry="a bleak and desolate atmosphere"/>
<rdf:Description rdf:about="&a;110418292">
	<b:glossaryEntry>an unwholesome atmosphere; "the novel spun a miasma of death and decay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110418416">
	<b:glossaryEntry>the general atmosphere of a place or situation; "the feel of the city excited him"; "a clergyman improved the tone of the meeting"; "it had the smell of treason"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110418678">
	<b:glossaryEntry>a distinctive emotional atmosphere; sensed intuitively; "the place gives me bad vibes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110418829">
	<b:glossaryEntry>the state of not being susceptible: "unsusceptibility to rust"; "immunity to disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110419060">
	<b:glossaryEntry>a form of acquired immunity in which the body produces its own antibodies against disease-causing antigens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110419228">
	<b:glossaryEntry>an impermanent form of acquired immunity in which antibodies against a disease are acquired naturally (as through the placenta to an unborn child) or artificially (as by injection of antiserum)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110419484">
	<b:glossaryEntry>production of antibodies against the tissues of your own body; produces autoimmune disease or hypersensitivity reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110419682">
	<b:glossaryEntry>immunity to a particular disease that is not innate but has been acquired during life; immunity can be acquired by the development of antibodies after an attack of an infectious disease or by a pregnant mother passing antibodies through the placenta to a fetus or by vaccination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110420060"
	 b:glossaryEntry="the condition in which an organism can resist disease"/>
<rdf:Description rdf:about="&a;110420170"
	 b:glossaryEntry="immunity from an obligation or duty"/>
<rdf:Description rdf:about="&a;110420343"
	 b:glossaryEntry="a period during which offenders are exempt from punishment"/>
<rdf:Description rdf:about="&a;110420455"
	 b:glossaryEntry="legal exemption from liability for damages"/>
<rdf:Description rdf:about="&a;110420553"
	 b:glossaryEntry="exemption from punishment or loss"/>
<rdf:Description rdf:about="&a;110420641">
	<b:glossaryEntry>an exemption based on circumstances existing prior to the adoption of some policy; used to enfranchise illiterate whites in US south after the Civil War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110420858"
	 b:glossaryEntry="the state of being susceptible; easily affected"/>
<rdf:Description rdf:about="&a;110421128"
	 b:glossaryEntry="the state of being legally obliged and responsible"/>
<rdf:Description rdf:about="&a;110421270"
	 b:glossaryEntry="liability to taxation"/>
<rdf:Description rdf:about="&a;110421348">
	<b:glossaryEntry>(British) the state of being liable to assessment or taxation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110421480">
	<b:glossaryEntry>the susceptibility of something to a particular treatment; "the capability of a metal to be fused"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110421664">
	<b:glossaryEntry>(chemistry) the capacity of a substance to take part in a chemical reaction; "catalytic activity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110421816"
	 b:glossaryEntry="susceptibility to a pathogen"/>
<rdf:Description rdf:about="&a;110422009"
	 b:glossaryEntry="the state of being sensitive (as to an antigen)"/>
<rdf:Description rdf:about="&a;110422116">
	<b:glossaryEntry>an allergic reaction that becomes apparent in a sensitized person only minutes after contact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110422324">
	<b:glossaryEntry>a delayed allergic reaction to the injection of an antiserum caused by an antibody reaction to an antigen in the donor serum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110422525">
	<b:glossaryEntry>an allergic reaction that becomes apparent only hours after contact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110422682">
	<b:glossaryEntry>hypersensitivity reaction to a particular allergen; symptoms can vary greatly in intensity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110422900"
	 b:glossaryEntry="hypersensitivity to cold"/>
<rdf:Description rdf:about="&a;110422997">
	<b:glossaryEntry>an inappropriate and excessive reaction to an allergen (as pollen or dust or animal hair or certain foods); severity ranges from mild allergy to severe systemic reactions leading to anaphylactic shock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110423341">
	<b:glossaryEntry>hypersensitivity reaction to the ingestion or injection of a substance (a protein or drug) resulting from prior contact with a substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110423553"
	 b:glossaryEntry="pathological sensitivity"/>
<rdf:Description rdf:about="&a;110423676"
	 b:glossaryEntry="rhinitis caused by an allergic reaction"/>
<rdf:Description rdf:about="&a;110423815">
	<b:glossaryEntry>a symptom of allergic states; increased eosinophils in the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110423938">
	<b:glossaryEntry>a seasonal rhinitis resulting from an allergic reaction to pollen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110424072">
	<b:glossaryEntry>constitutional predisposition to a particular disease or abnormality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110424196"
	 b:glossaryEntry="ready susceptibility to chemical change"/>
<rdf:Description rdf:about="&a;110424292"
	 b:glossaryEntry="susceptibility or responsiveness to suggestion"/>
<rdf:Description rdf:about="&a;110424399">
	<b:glossaryEntry>the condition of containing or being covered by a liquid (especially water); "he confirmed the wetness of the paint"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110424695">
	<b:glossaryEntry>wetness caused by water; "drops of wet gleamed on the window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110424817"
	 b:glossaryEntry="wetness in the atmosphere"/>
<rdf:Description rdf:about="&a;110424927"
	 b:glossaryEntry="a state of warm humidity"/>
<rdf:Description rdf:about="&a;110425007"
	 b:glossaryEntry="a slight wetness"/>
<rdf:Description rdf:about="&a;110425115"
	 b:glossaryEntry="unpleasant wetness"/>
<rdf:Description rdf:about="&a;110425201"
	 b:glossaryEntry="a heavy wetness"/>
<rdf:Description rdf:about="&a;110425272">
	<b:glossaryEntry>the condition of not containing or being covered by a liquid (especially water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110425511"
	 b:glossaryEntry="dryness resulting from the removal of water"/>
<rdf:Description rdf:about="&a;110425626"
	 b:glossaryEntry="a temporary shortage of rainfall"/>
<rdf:Description rdf:about="&a;110425712"
	 b:glossaryEntry="a permanent absence of rainfall"/>
<rdf:Description rdf:about="&a;110425808"
	 b:glossaryEntry="a withered dryness"/>
<rdf:Description rdf:about="&a;110425881"
	 b:glossaryEntry='the state of being safe; "the safety of the children"'/>
<rdf:Description rdf:about="&a;110426059"
	 b:glossaryEntry="safety as a consequence of entailing no risk"/>
<rdf:Description rdf:about="&a;110426162"
	 b:glossaryEntry="having the strength to withstand attack"/>
<rdf:Description rdf:about="&a;110426280">
	<b:glossaryEntry>the state of being free from danger or injury; "we support the armed services in the name of national security"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110426518">
	<b:glossaryEntry>the general security of public places; "he was arrested for disturbing the peace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110426669"
	 b:glossaryEntry="the state of being secure"/>
<rdf:Description rdf:about="&a;110426769"
	 b:glossaryEntry="protection against future loss"/>
<rdf:Description rdf:about="&a;110426867">
	<b:glossaryEntry>the condition of being protected; "they were huddled together for protection"; "he enjoyed a sense of peace and protection in his new home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110427091"
	 b:glossaryEntry="a system for international peace"/>
<rdf:Description rdf:about="&a;110427189">
	<b:glossaryEntry>the Roman peace; the long period of peace enforced on states in the Roman Empire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110427326">
	<b:glossaryEntry>the condition of being susceptible to harm or injury; "you are in no danger"; "there was widespread danger of disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110427605">
	<b:glossaryEntry>a cause of pain or injury or loss; "he feared the dangers of traveling by air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110427790">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a standard for judging when freedom of speech can be abridged; "no one has a right to shout `fire'' in a crowded theather when there is no fire because such an action would pose a clear and present danger to public safety"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110428082"
	 b:glossaryEntry="the state of being dangerous"/>
<rdf:Description rdf:about="&a;110428185"
	 b:glossaryEntry="the state of being subject to danger or injury"/>
<rdf:Description rdf:about="&a;110428324"
	 b:glossaryEntry='a source of danger; "drinking alcohol is a health hazard"'/>
<rdf:Description rdf:about="&a;110428460"
	 b:glossaryEntry="a potentially explosive state"/>
<rdf:Description rdf:about="&a;110428546">
	<b:glossaryEntry>something that is a source of danger; "earthquakes are a constant threat in Japan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110428708">
	<b:glossaryEntry>the threat to Western civilization said to arise from the power of Asiatic peoples</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110428849"
	 b:glossaryEntry="a state of danger involving risk"/>
<rdf:Description rdf:about="&a;110428963"
	 b:glossaryEntry="financial risk"/>
<rdf:Description rdf:about="&a;110429039">
	<b:glossaryEntry>the state of being vulnerable or exposed; "exposure to ridicule" or "vulnerability to litigation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110429207"
	 b:glossaryEntry="the state of being insecure"/>
<rdf:Description rdf:about="&a;110429311">
	<b:glossaryEntry>the physical condition of being stretched or strained; "it places great tension on the leg muscles"; "he could feel the tenseness of her body"; "the violinist adjusted the tension of the strings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110429611">
	<b:glossaryEntry>the elastic tension of living muscles, arteries, etc. that facilitate response to stimuli; "the doctor tested my tonicity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110429875">
	<b:glossaryEntry>extreme tonus; muscular rigidity; a common symptom in catatonic schizophrenia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110430027">
	<b:glossaryEntry>normal tonicity of the muscles; "exercise improves muscle tone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110430165">
	<b:glossaryEntry>abnormally long muscular contractions; slow relaxation of a muscle after a contraction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110430324">
	<b:glossaryEntry>myotonia of the extremities only; causes spastic deformity of the hand or foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110430461"
	 b:glossaryEntry="lack of normal muscular tension or tonus"/>
<rdf:Description rdf:about="&a;110430604">
	<b:glossaryEntry>the state of (good) health--especially in the phrases "in condition" or "in shape" or "out of condition" or "out of shape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110430808"
	 b:glossaryEntry="good physical condition; being in shape or in condition"/>
<rdf:Description rdf:about="&a;110431002"
	 b:glossaryEntry='a state of fitness and good health; "in fine fettle"'/>
<rdf:Description rdf:about="&a;110431107">
	<b:glossaryEntry>a formal way of referring to the condition of something; "the building was in good repair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110431250"
	 b:glossaryEntry="a state or condition free from damage or decay"/>
<rdf:Description rdf:about="&a;110431406"
	 b:glossaryEntry="fitness to traverse the seas"/>
<rdf:Description rdf:about="&a;110431540">
	<b:glossaryEntry>fitness to fly: "the plane received a certificate of airworthiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110431703">
	<b:glossaryEntry>poor physical condition; being out of shape or out of condition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110431905">
	<b:glossaryEntry>the state of being weak in health or body (especially from old age)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110432110"
	 b:glossaryEntry="an abnormal loss of strength"/>
<rdf:Description rdf:about="&a;110432203">
	<b:glossaryEntry>any general wasting of body and mind resulting from any debilitating chronic disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110432352">
	<b:glossaryEntry>the condition of being unable to perform as a consequence of physical or mental unfitness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110432734"
	 b:glossaryEntry="a disability that interferes with or prevents walking"/>
<rdf:Description rdf:about="&a;110432891"
	 b:glossaryEntry="inability to walk"/>
<rdf:Description rdf:about="&a;110433069"
	 b:glossaryEntry="abasia due to trembling of the legs"/>
<rdf:Description rdf:about="&a;110433167"
	 b:glossaryEntry="abasia due to ataxia of the legs"/>
<rdf:Description rdf:about="&a;110433276"
	 b:glossaryEntry="abasia related to abnormal movements of the legs"/>
<rdf:Description rdf:about="&a;110433385"
	 b:glossaryEntry="abasia related to paralysis of the leg muscles"/>
<rdf:Description rdf:about="&a;110433494"
	 b:glossaryEntry="abasia related to spasticity of the legs"/>
<rdf:Description rdf:about="&a;110433608"
	 b:glossaryEntry="abasia due to spastic contractions of the leg muscles"/>
<rdf:Description rdf:about="&a;110433722"
	 b:glossaryEntry="disability of walking due to crippling of the legs or feet"/>
<rdf:Description rdf:about="&a;110433890"
	 b:glossaryEntry="inability to stand due to muscular incoordination"/>
<rdf:Description rdf:about="&a;110433993">
	<b:glossaryEntry>a condition of disability resulting from the loss of one or more limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110434120">
	<b:glossaryEntry>any abnormality following or resulting from a disease or injury or treatment; "paralysis is one of the sequelae of poliomyelitis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110434303"
	 b:glossaryEntry="impairment of the sense of hearing"/>
<rdf:Description rdf:about="&a;110434472"
	 b:glossaryEntry="partial or complete loss of hearing"/>
<rdf:Description rdf:about="&a;110434598">
	<b:glossaryEntry>hearing loss due to problems with the bones of the middle ear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110434773"
	 b:glossaryEntry="hearing loss due to failure of the auditory nerve"/>
<rdf:Description rdf:about="&a;110434912"
	 b:glossaryEntry="an inability to distinguish differences in pitch"/>
<rdf:Description rdf:about="&a;110435020"
	 b:glossaryEntry="congenital deafness that results in inability to speak"/>
<rdf:Description rdf:about="&a;110435148"
	 b:glossaryEntry="absence of the sense of pain without loss of consciousness"/>
<rdf:Description rdf:about="&a;110435262">
	<b:glossaryEntry>impairment of the sense of smell (as by damage to olfactory nasal tissue or the olfactory nerve or by obstruction of the nasal passages)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110435475"
	 b:glossaryEntry="impairment of the sense of sight"/>
<rdf:Description rdf:about="&a;110435819">
	<b:glossaryEntry>(ophthalmology) eyesight abnormality resulting from the eye''s faulty refractive ability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110435996">
	<b:glossaryEntry>(ophthalmology) faulty refraction of light rays in the eye as in astigmatism or myopia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110436192">
	<b:glossaryEntry>(ophthalmology) impaired eyesight resulting usually from irregular conformation of the cornea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110436354"
	 b:glossaryEntry="lack of sight"/>
<rdf:Description rdf:about="&a;110436520">
	<b:glossaryEntry>sightlessness (especially because of a structural defect in or the absence of an eye)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110436658">
	<b:glossaryEntry>partial or total loss of sight without pathology of the eye; caused by disease of optic nerve or retina or brain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110436826"
	 b:glossaryEntry="dimness of vision without apparent organic pathology"/>
<rdf:Description rdf:about="&a;110436934">
	<b:glossaryEntry>visual defect in which the shape and size of an ocular image differ in the two eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110437075"
	 b:glossaryEntry="distorted vision in which straight lines appear curved"/>
<rdf:Description rdf:about="&a;110437186">
	<b:glossaryEntry>abnormal condition in which vision for distant objects is better than for near objects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110437394">
	<b:glossaryEntry>reduced ability to focus caused by loss of elasticity of crystalline lens with age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110437533"
	 b:glossaryEntry="the condition of the optical properties of the eye"/>
<rdf:Description rdf:about="&a;110437679"
	 b:glossaryEntry="difference in the refractive power of the two eyes"/>
<rdf:Description rdf:about="&a;110437789"
	 b:glossaryEntry="equality of refractive power in the two eyes"/>
<rdf:Description rdf:about="&a;110437891">
	<b:glossaryEntry>temporary blindness caused by exposure to sunlight reflected from snow or ice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110438028">
	<b:glossaryEntry>a defect of vision in which objects appear to be distorted; usually due to a defect in the retina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110438186">
	<b:glossaryEntry>inability to see clearly in dim light; due to a deficiency of vitamin A or to a retinal disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110438392"
	 b:glossaryEntry="inability to see clearly in bright light"/>
<rdf:Description rdf:about="&a;110438506"
	 b:glossaryEntry="blindness due to loss of the eyes"/>
<rdf:Description rdf:about="&a;110438597"
	 b:glossaryEntry="inability to see shapes and contours"/>
<rdf:Description rdf:about="&a;110438697"
	 b:glossaryEntry="abnormal alignment of one or both eyes"/>
<rdf:Description rdf:about="&a;110438837"
	 b:glossaryEntry="strabismus in which one or both eyes are directed outward"/>
<rdf:Description rdf:about="&a;110438971">
	<b:glossaryEntry>an unnatural condition in which the head leans to one side because the neck muscles on that side are contracted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110439150">
	<b:glossaryEntry>(medical) any disturbance in the function of an organ or body part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110439292"
	 b:glossaryEntry="loss of the ability to move a body part"/>
<rdf:Description rdf:about="&a;110439521"
	 b:glossaryEntry="a slight or partial paralysis"/>
<rdf:Description rdf:about="&a;110439604"
	 b:glossaryEntry="prolapse of the uterus"/>
<rdf:Description rdf:about="&a;110439684">
	<b:glossaryEntry>drooping of the upper eyelid caused by muscle paralysis and weakness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110439805">
	<b:glossaryEntry>the slipping or falling out of place of an organ (as the uterus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110439972"
	 b:glossaryEntry="paralysis of the lower half of the body"/>
<rdf:Description rdf:about="&a;110440068"
	 b:glossaryEntry="paralysis of one side of the body"/>
<rdf:Description rdf:about="&a;110440158"
	 b:glossaryEntry="paralysis of both arms and both legs"/>
<rdf:Description rdf:about="&a;110440253"
	 b:glossaryEntry="inward slant of the thigh"/>
<rdf:Description rdf:about="&a;110440381"
	 b:glossaryEntry="outward curvature of the legs"/>
<rdf:Description rdf:about="&a;110440488"
	 b:glossaryEntry="a condition of damage or decay"/>
<rdf:Description rdf:about="&a;110440630"
	 b:glossaryEntry="in need of repairs"/>
<rdf:Description rdf:about="&a;110440704">
	<b:glossaryEntry>an inferior state resulting from the process of decaying; "the corpse was in an advanced state of decay"; "the house had fallen into a serious state of decay and disrepair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110440982"
	 b:glossaryEntry="decay usually accompanied by an offensive odor"/>
<rdf:Description rdf:about="&a;110441111"
	 b:glossaryEntry="in a state of progressive putrefaction"/>
<rdf:Description rdf:about="&a;110441246"
	 b:glossaryEntry="in a decomposed state"/>
<rdf:Description rdf:about="&a;110441344"
	 b:glossaryEntry="a symptom of reduced quality or strength"/>
<rdf:Description rdf:about="&a;110441529">
	<b:glossaryEntry>a state of deterioration in metals caused by oxidation or chemical action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110441658"
	 b:glossaryEntry="the state of being decayed or destroyed"/>
<rdf:Description rdf:about="&a;110441793"
	 b:glossaryEntry="a state of deterioration due to old age or long use"/>
<rdf:Description rdf:about="&a;110441917">
	<b:glossaryEntry>impairment resulting from long use; "the tires showed uneven wear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110442034"
	 b:glossaryEntry="a state or condition being blighted"/>
<rdf:Description rdf:about="&a;110442122">
	<b:glossaryEntry>a final state; "he came to a bad end"; "the so-called glorious experiment came to an inglorious end"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110442294">
	<b:glossaryEntry>absence of moral or spiritual values; "the powers of darkness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110442442">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a condition of spiritual awareness; divine illumination; "follow God''s light"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110442586">
	<b:glossaryEntry>any unwholesome or desperate condition; "what maladies afflict our nation?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110442714">
	<b:glossaryEntry>the state of being purchasable; offered or exhibited for selling; "vitamin C is on sale at most pharmacies"; "the new line of cars will soon be on sale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110442917">
	<b:glossaryEntry>difficulty in beginning the flow of urine; associated with prostate enlargement in men and with narrowing of the urethral opening in women; may be caused by emotional stress in either men or women</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110443177">
	<b:glossaryEntry>a difficult or awkward situation; "his back was to the wall"; "competition was pushing them to the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110443332">
	<b:glossaryEntry>a chronic disease of unknown cause marked by the formation of nodules in the lungs and liver and lymph glands and salivary glands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110443519">
	<b:glossaryEntry>a skin disease marked by hardening of the tissue usually beginning in the face</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110443654">
	<b:glossaryEntry>an autoimmune disease that affects the blood vessels and connective tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110443786">
	<b:glossaryEntry>any disease or abnormality that is determined by the sex hormones; "hemophilia is determined by a gene defect on an X chromosome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110444035">
	<b:glossaryEntry>a chromosomal anomaly in males who have more than one X chromosome (XXY or XXXY instead of XY); marked by small testes and long legs and enlarged breasts and decreased sperm production and mental retardation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110444311">
	<b:glossaryEntry>a chromosomal disorder in females who have only one X chromosome; marked by dwarfism and heart abnormalities and underdeveloped sex organs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110444513"
	 b:glossaryEntry="any infection of any of the organs of the urinary tract"/>
<rdf:Description rdf:about="&a;110444692">
	<b:glossaryEntry>inflammation of the kidney and its pelvis caused by bacterial infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110444860">
	<b:glossaryEntry>pyelonephritis resulting from the spread of a bladder infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110444990">
	<b:glossaryEntry>excess carotene in the blood stream; can cause the skin to turn a pale yellow-red color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110445147">
	<b:glossaryEntry>pyelonephritis that develops slowly and can lead to renal failure if untreated; often associated with a kidney stone or with narrowing of the urinary passageways</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110445377"
	 b:glossaryEntry="inflammation of the urethra; results in painful urination"/>
<rdf:Description rdf:about="&a;110445491"
	 b:glossaryEntry="the form of ratbite fever occurring in the Far East"/>
<rdf:Description rdf:about="&a;110445613">
	<b:glossaryEntry>an abnormal state in which the normal flow of a liquid (such as blood) is slowed or stopped</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110445757">
	<b:glossaryEntry>the presence of greater than normal amounts of fat in the feces which are frothy and foul smelling and floating; a symptom of disorders of fat metabolism and malabsorption syndrome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110445995">
	<b:glossaryEntry>a whistling sound when breathing (usually heard on inspiration); indicates obstruction of the trachea or larynx</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110446160">
	<b:glossaryEntry>a ringing or booming sensation in one or both ears; a symptom of an ear infection or Meniere''s disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110446317"
	 b:glossaryEntry="the most severe stage of a disease"/>
<rdf:Description rdf:about="&a;110446404">
	<b:glossaryEntry>the condition of being serrated; "the serrations of a city skyline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110446527">
	<b:glossaryEntry>(biology) the normal rigid state of fullness of a cell or blood vessel or capillary resulting from pressure of the contents against the wall or membrane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110446732">
	<b:glossaryEntry>painful inflammation of the muscles around the shins; frequent among runners</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110446867">
	<b:glossaryEntry>the tangible substance that goes into the makeup of a physical object; "coal is a hard black material"; "wheat is the stuff they use to make bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110447797">
	<b:glossaryEntry>a hypothetical substance that the alchemists believed to be capable of changing other metals into gold</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110447965">
	<b:glossaryEntry>a semiliquid mass of partially digested food that passes from the stomach through the pyloric sphincter into the duodenum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110448138">
	<b:glossaryEntry>worthless material that should be removed; "there were impurities in the water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110448280"
	 b:glossaryEntry="any substance that can cause an allergy"/>
<rdf:Description rdf:about="&a;110448392">
	<b:glossaryEntry>any of various compounds that are added to gasoline to reduce engine knocking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110448543"
	 b:glossaryEntry="pollen of the ragweed plant is a common allergen"/>
<rdf:Description rdf:about="&a;110448670"
	 b:glossaryEntry="(nontechnical usage) a tiny piece of anything"/>
<rdf:Description rdf:about="&a;110448821">
	<b:glossaryEntry>a small loosely aggregated mass of flocculent material suspended in or precipitated from a liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110448980">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an abbreviation for `hazardous material'' used on warning signs; "NO HAZMATS IN TUNNEL"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110449119">
	<b:glossaryEntry>(chemistry) a substance consisting of two or more substances mixed together (not in fixed proportions and not with chemical bonding)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110449557">
	<b:glossaryEntry>a mixture of two or more metals or of metallic and nonmetallic elements usually fused together or dissolving into each other when molten</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110450286">
	<b:glossaryEntry>a mixture with properties between those of a solution and fine suspension</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110450503"
	 b:glossaryEntry="a mixture of ingredients"/>
<rdf:Description rdf:about="&a;110450657">
	<b:glossaryEntry>a mixture whose components can be separated by mechanical means</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110450785"
	 b:glossaryEntry="a mixture of substances having a minimum melting point"/>
<rdf:Description rdf:about="&a;110450894">
	<b:glossaryEntry>a homogeneous solid that can exist over a range of component chemicals; a constituent of alloys that is formed when atoms of an element are incorporated into the crystals of a metal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110451252">
	<b:glossaryEntry>a homogeneous mixture of two or more substances; frequently (but not necessarily) a liquid solution; "he used a solution of peroxide and water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110451792"
	 b:glossaryEntry="a solution in water"/>
<rdf:Description rdf:about="&a;110451874">
	<b:glossaryEntry>a solution obtained by steeping or soaking a substance (usually in water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110452048"
	 b:glossaryEntry="a liquid solution that results from elution"/>
<rdf:Description rdf:about="&a;110452144">
	<b:glossaryEntry>a mixture of two partially miscible liquids A and B produces two conjugate solutions: one of A in B and another of B in A</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110452342"
	 b:glossaryEntry="a solution having the same osmotic pressure as blood"/>
<rdf:Description rdf:about="&a;110452497"
	 b:glossaryEntry="an isotonic solution of sodium chloride and distilled water"/>
<rdf:Description rdf:about="&a;110452627"
	 b:glossaryEntry="a solution that conducts electricity"/>
<rdf:Description rdf:about="&a;110452739"
	 b:glossaryEntry="an electrolyte of high molecular weight"/>
<rdf:Description rdf:about="&a;110452840"
	 b:glossaryEntry="a colloid is a more solid form than a sol"/>
<rdf:Description rdf:about="&a;110452931">
	<b:glossaryEntry>a colloid that has a continuous liquid phase in which a solid is suspended in a liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110453111">
	<b:glossaryEntry>a mixture in which fine particles are suspended in a fluid where they are supported by buoyancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110453335">
	<b:glossaryEntry>a suspension of insoluble particles (as plaster of paris or lime or clay etc.) usually in water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110453483"
	 b:glossaryEntry="a suspension after precipitation"/>
<rdf:Description rdf:about="&a;110453574">
	<b:glossaryEntry>a precipitated solid substance in suspension or after settling or filtering</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110453725"
	 b:glossaryEntry="the precipitate produced by sewage treatment"/>
<rdf:Description rdf:about="&a;110453822"
	 b:glossaryEntry="a thin polyester film"/>
<rdf:Description rdf:about="&a;110453903"
	 b:glossaryEntry="a fine cloth made from pineapple fibers"/>
<rdf:Description rdf:about="&a;110453999">
	<b:glossaryEntry>a synthetic material resembling clay but remaining soft; used as a substitute for clay or wax in modeling (especially in schools)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110454185">
	<b:glossaryEntry>generic name for certain synthetic or semisynthetic materials that can be molded or extruded into objects or films or filaments or used for making e.g. coatings and adhesives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110454719">
	<b:glossaryEntry>a substance added to plastics or other materials to make them more pliable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110454851">
	<b:glossaryEntry>a material that softens when heated and rehardens when cooled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110455030"
	 b:glossaryEntry="any of various thermoplastic resins used to make things"/>
<rdf:Description rdf:about="&a;110455156">
	<b:glossaryEntry>a glassy thermoplastic; can be cast and molded or used in coatings and adhesives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110455341"
	 b:glossaryEntry="a transparent plastic used as a substitute for glass"/>
<rdf:Description rdf:about="&a;110455499"
	 b:glossaryEntry="(trademark) a transparent thermoplastic acrylic resin"/>
<rdf:Description rdf:about="&a;110455615">
	<b:glossaryEntry>(trademark) a light transparent weather resistant thermoplastic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110455747">
	<b:glossaryEntry>a lightweight thermoplastic; used especially in packaging and insulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110455890"
	 b:glossaryEntry="a univalent chemical radical derived from ethylene"/>
<rdf:Description rdf:about="&a;110456022">
	<b:glossaryEntry>a thermoplastic derived by polymerization from compounds containing the vinyl group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110456251"
	 b:glossaryEntry="a vinyl polymer used especially in paints or adhesives"/>
<rdf:Description rdf:about="&a;110456375">
	<b:glossaryEntry>a polymer of vinyl chloride used instead of rubber in electric cables</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110456515"
	 b:glossaryEntry="a colorless oily liquid; the monomer for polystyrene"/>
<rdf:Description rdf:about="&a;110456683">
	<b:glossaryEntry>a polymer of styrene; a rigid transparent thermoplastic; "expanded polystyrene looks like a rigid white foam and is used as packing or insulation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110456905"
	 b:glossaryEntry="(trademark) a light resilient foam of polystyrene"/>
<rdf:Description rdf:about="&a;110457028"
	 b:glossaryEntry="a material that hardens when heated and cannot be remolded"/>
<rdf:Description rdf:about="&a;110457181">
	<b:glossaryEntry>(trademark) a thermosetting plastic used as electric insulators and for making plastic ware and telephone receivers etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110457356">
	<b:glossaryEntry>(trademark) a material used to coat cooking utensils and in industrial applications where sticking is to be avoided</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110457550"
	 b:glossaryEntry="(trademark) any of various vinyl resins"/>
<rdf:Description rdf:about="&a;110457644"
	 b:glossaryEntry="material suitable for manufacture or use or finishing"/>
<rdf:Description rdf:about="&a;110457765">
	<b:glossaryEntry>a material that has been or is capable of being taken up by another substance by either absorption or adsorption</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110457967">
	<b:glossaryEntry>a material that sorbs another substance; i.e. that has the capacity or tendency to take it up by either absorption or adsorption</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110458204">
	<b:glossaryEntry>a material having capacity or tendency to absorb another substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110458401"
	 b:glossaryEntry="a material that has been or is capable of being absorbed"/>
<rdf:Description rdf:about="&a;110458513">
	<b:glossaryEntry>a porous mass of interlacing fibers the forms the internal skeleton of various marine animals and usable to absorb water or any porous rubber or cellulose product similarly used</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110458743">
	<b:glossaryEntry>(physics) material in a nuclear reactor that absorbs radiation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110458860"
	 b:glossaryEntry="cotton made absorbent by removal of the natural wax"/>
<rdf:Description rdf:about="&a;110459006">
	<b:glossaryEntry>a material having capacity or tendency to adsorb another substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110459149"
	 b:glossaryEntry="a material that has been or is capable of being adsorbed"/>
<rdf:Description rdf:about="&a;110459261"
	 b:glossaryEntry="a chemical agent used to kill mites"/>
<rdf:Description rdf:about="&a;110459364">
	<b:glossaryEntry>an alcohol-soluble resin from Australian trees; used in varnishes and in manufacturing paper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110459595">
	<b:glossaryEntry>a colorless pungent liquid widely used in manufacturing plastics and pharmaceuticals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110459887"
	 b:glossaryEntry="a salt or ester of acetic acid"/>
<rdf:Description rdf:about="&a;110459989">
	<b:glossaryEntry>a poisonous white solid (Pb[CH3CO]2) used in dyeing cotton and in making enamels and varnishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110460176"
	 b:glossaryEntry="a poisonous white solid (Pb3[AsO4]2) used as an insecticide"/>
<rdf:Description rdf:about="&a;110460295">
	<b:glossaryEntry>a clear oily poisonous liquid added to gasoline to prevent knocking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110460442">
	<b:glossaryEntry>a highly inflammable liquid ketone widely used as an organic solvent and as material for making plastics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110460630">
	<b:glossaryEntry>a colorless flammable gas used chiefly in welding and in organic synthesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110460788">
	<b:glossaryEntry>a herbicide used in the Vietnam War to defoliate forest areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110460927">
	<b:glossaryEntry>building block of proteins; containing an amino group and a carboxylic acid group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110461519"
	 b:glossaryEntry="a crystalline amino acid that occurs in many proteins"/>
<rdf:Description rdf:about="&a;110461626">
	<b:glossaryEntry>a crystalline amino acid found in many plants (e.g., asparagus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110461746">
	<b:glossaryEntry>a crystalline amino acid occurring naturally in sugar beets and sugar cane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110461880"
	 b:glossaryEntry="an amino acid found in the jack bean"/>
<rdf:Description rdf:about="&a;110461973">
	<b:glossaryEntry>a fluorocarbon with chlorine; formerly used as a refrigerant and as a propellant in aerosol cans; "CFCs cause depletion of atmospheric ozone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110462185">
	<b:glossaryEntry>an amino acid that is an intermediate in the conversion of ornithine to arginine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110462322">
	<b:glossaryEntry>an amino acid containing sulfur that is found in most proteins; oxidizes on exposure to air to form cystine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110462484">
	<b:glossaryEntry>a crystalline amino acid found in proteins (especially keratin); discovered in bladder stones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110462631"
	 b:glossaryEntry="a substance that exhibits diamagnetism"/>
<rdf:Description rdf:about="&a;110462725"
	 b:glossaryEntry="an chemical compound containing two amino groups"/>
<rdf:Description rdf:about="&a;110462827">
	<b:glossaryEntry>an amino acid that is found in the central nervous system; acts as an inhibitory neurotransmitter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110463019">
	<b:glossaryEntry>an amino acid occurring in proteins; important in the nitrogen metabolism of plants; used in monosodium glutamate to enhance the flavor of meats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110463241">
	<b:glossaryEntry>a crystalline amino acid occurring in proteins; important in protein metabolism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110463376"
	 b:glossaryEntry="the principal amino acid in sugar cane"/>
<rdf:Description rdf:about="&a;110463468"
	 b:glossaryEntry="a crystalline amino acid obtained from gelatin or collagen"/>
<rdf:Description rdf:about="&a;110463587"
	 b:glossaryEntry="an amino acid with iodine added"/>
<rdf:Description rdf:about="&a;110463715"
	 b:glossaryEntry="an amino acid important in the formation of urea"/>
<rdf:Description rdf:about="&a;110463819">
	<b:glossaryEntry>any of various water-soluble compounds having a sour taste and capable of turning litmus red and reacting with a base to form a salt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110465442"
	 b:glossaryEntry="a salt or ester of arsenic acid"/>
<rdf:Description rdf:about="&a;110465528"
	 b:glossaryEntry="an acid formed from arsenic pentoxide"/>
<rdf:Description rdf:about="&a;110465624"
	 b:glossaryEntry="a white solid fatty acid found in waxes (such as beeswax)"/>
<rdf:Description rdf:about="&a;110465779"
	 b:glossaryEntry="any salt of chloric acid"/>
<rdf:Description rdf:about="&a;110465858">
	<b:glossaryEntry>(HClO3) a strong unstable acid with an acrid odor found in chlorate salts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110465990"
	 b:glossaryEntry="(HClO2) a strongly oxidizing acid; known only in solution"/>
<rdf:Description rdf:about="&a;110466107">
	<b:glossaryEntry>an acid containing only one replaceable hydrogen atom per molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110466234">
	<b:glossaryEntry>an acid containing two replaceable hydrogen atoms per molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110466355"
	 b:glossaryEntry="a salt derived by replacing two hydrogen atoms per molecule"/>
<rdf:Description rdf:about="&a;110466473">
	<b:glossaryEntry>an acid containing three replaceable hydrogen atoms per molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110466597">
	<b:glossaryEntry>an acid containing four replaceable hydrogen atoms per molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110466722">
	<b:glossaryEntry>(CNOH) an unstable acid occurring mainly in the form of explosive salts and esters that is isomeric with cyanic acid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110466898"
	 b:glossaryEntry="a crystalline acid used to make azo dyes"/>
<rdf:Description rdf:about="&a;110466995">
	<b:glossaryEntry>a colorless explosive liquid that is volatile and poisonous and foul-smelling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110467186">
	<b:glossaryEntry>(HI) a colorless or yellow aqueous solution of hydrogen iodide; "hydriodic acid is a strong acid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110467344">
	<b:glossaryEntry>a weak poisonous acid (HCN) used in fumigating and in synthesis of organic compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110467525"
	 b:glossaryEntry="a product of hydrolysis"/>
<rdf:Description rdf:about="&a;110467606">
	<b:glossaryEntry>any acid that has hydroxyl groups in addition to the hydroxyl group in the acid itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110467823"
	 b:glossaryEntry="a crystalline derivative of benzoic acid"/>
<rdf:Description rdf:about="&a;110467929"
	 b:glossaryEntry="any salt or ester of hypochlorous acid"/>
<rdf:Description rdf:about="&a;110468062"
	 b:glossaryEntry="an explosive white crystalline weak acid (H2N2O2)"/>
<rdf:Description rdf:about="&a;110468174"
	 b:glossaryEntry="a crystalline tetrabasic acid (H4P2O6)"/>
<rdf:Description rdf:about="&a;110468278"
	 b:glossaryEntry="a clear or yellow-colored monobasic acid (H3PO2)"/>
<rdf:Description rdf:about="&a;110468436"
	 b:glossaryEntry="a crystalline acid found in the exudations of some conifers"/>
<rdf:Description rdf:about="&a;110468556">
	<b:glossaryEntry>a crystalline acid often used in medical research; obtained from ergotic alkaloids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110468698">
	<b:glossaryEntry>a dibasic acid (H2MnO4) found only in solution and in manganate salts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110468827">
	<b:glossaryEntry>a glassy solid acid ([HPO3]n) often used as a dehydrating agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110468956"
	 b:glossaryEntry="a series of oxyacids of phosphorus"/>
<rdf:Description rdf:about="&a;110469092"
	 b:glossaryEntry="a solid acid formed by reactions of orthophosphoric acid"/>
<rdf:Description rdf:about="&a;110469214">
	<b:glossaryEntry>a compound derived from ammonium with hydrogen atoms replaced by organic groups; used as surface-active agents, disinfectants, and in drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110469428">
	<b:glossaryEntry>an unsaturated acid (C4H6O2) used to make resins and plastics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110469577"
	 b:glossaryEntry="a solid acid (C6H10O8) found in milk or sugar"/>
<rdf:Description rdf:about="&a;110469679"
	 b:glossaryEntry="a strong acid (H2SeO4) analogous to sulfuric acid"/>
<rdf:Description rdf:about="&a;110469787"
	 b:glossaryEntry="a dicarboxylic acid found in cork"/>
<rdf:Description rdf:about="&a;110469898"
	 b:glossaryEntry="a dicarboxylic acid (C4H6O4) active in metabolic processes"/>
<rdf:Description rdf:about="&a;110470016"
	 b:glossaryEntry="a salt of sulphonic acid"/>
<rdf:Description rdf:about="&a;110470096"
	 b:glossaryEntry="n acid derived from sulphuric acid"/>
<rdf:Description rdf:about="&a;110470207">
	<b:glossaryEntry>a white weak acid that is a hydrated form of titanium dioxide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110470327">
	<b:glossaryEntry>a white powder used as a pigment for its high covering power and durability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110470526">
	<b:glossaryEntry>any substance that adulterates (lessens the purity or effectiveness of a substance); "it is necessary to remove the adulterants before use"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110470722">
	<b:glossaryEntry>the univalent unsaturated organic radical C3H5; derived from propylene</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110470874"
	 b:glossaryEntry="a methyl with the hydrogen atom replaced by an amino radical"/>
<rdf:Description rdf:about="&a;110470993"
	 b:glossaryEntry="a compound characterized by an active anion"/>
<rdf:Description rdf:about="&a;110471099">
	<b:glossaryEntry>a class of synthetic detergents in which the molecules do not ionize in aqueous solutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110471284">
	<b:glossaryEntry>any of various water-soluble compounds capable of turning litmus blue and reacting with an acid to form a salt and water; "bases include oxides and hydroxides of metals and ammonia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110471669">
	<b:glossaryEntry>a heterocyclic compound having a metal ion attached by coordinate bonds to at least two nonmetal ions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110471843">
	<b:glossaryEntry>(physics and chemistry) the smallest component of an element having the chemical properties of the element</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110472184">
	<b:glossaryEntry>one of two or more atoms with the same atomic number but with different numbers of neutrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110472365">
	<b:glossaryEntry>a radioactive isotope of an element; produced either naturally or artificially</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110472538">
	<b:glossaryEntry>a radioactive isotope that is used in a compound in order to trace the mechanism of a chemical reaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110472693"
	 b:glossaryEntry="an atom having a valence of one"/>
<rdf:Description rdf:about="&a;110472776">
	<b:glossaryEntry>a simple compound whose molecules can join together to form polymers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110472898">
	<b:glossaryEntry>(physics and chemistry) the simplest structural unit of an element or compound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110473160">
	<b:glossaryEntry>two or more atoms bound together as a single unit and forming part of a molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110473627"
	 b:glossaryEntry="the univalent radical derived from toluene"/>
<rdf:Description rdf:about="&a;110473754"
	 b:glossaryEntry="the univalent radical derived from benzoic acid"/>
<rdf:Description rdf:about="&a;110473879">
	<b:glossaryEntry>any of the more than 100 known substances (of which 93 occur naturally) that cannot be separated into simpler substances and that singly or in combination constitute all matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110474867">
	<b:glossaryEntry>a structurally different form of an element: "graphite and diamond are allotropes of carbon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110475015">
	<b:glossaryEntry>any element having an atomic number greater than 92" (the atomic number of uranium); all are radioactive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110475185">
	<b:glossaryEntry>any of the chemically inert gaseous elements of the helium group (group 8A or 0 of the periodic table)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110475491"
	 b:glossaryEntry="the series of inert gases"/>
<rdf:Description rdf:about="&a;110475575">
	<b:glossaryEntry>any element of the lanthanide series (atomic numbers 57" through 71")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110475765">
	<b:glossaryEntry>a separate group of related lanthanides, including terbium, europium, gadolinium, and sometimes dysprosium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110475931">
	<b:glossaryEntry>a series of 15 radioactive elements with increasing atomic numbers from actinium to lawrencium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110476087">
	<b:glossaryEntry>the rare-earth elements with atomic numbers 57 through 71; having properties similar to lanthanum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110476248">
	<b:glossaryEntry>any of several chemical elements that are usually shiny solids that conduct heat or electricity and can be formed into sheets etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110477817"
	 b:glossaryEntry="any metal that is resistant to corrosion or oxidation"/>
<rdf:Description rdf:about="&a;110477982"
	 b:glossaryEntry="a chemical element lacking typical metallic properties"/>
<rdf:Description rdf:about="&a;110478091">
	<b:glossaryEntry>a radioactive element of the actinide series; found in uranium ores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110478256">
	<b:glossaryEntry>a silvery ductile metallic element found primarily in bauxite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110478501">
	<b:glossaryEntry>a white crystalline double sulfate of aluminum: the potassium double sulfate of aluminum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110478671">
	<b:glossaryEntry>a white crystalline double sulfate of aluminum: the ammonium double sulfate of aluminum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110478840">
	<b:glossaryEntry>a radioactive transuranic metallic element; discovered by bombarding uranium with helium atoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110479014">
	<b:glossaryEntry>a metallic element having four allotropic forms; used in a wide variety of alloys; found in stibnite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110479212">
	<b:glossaryEntry>a colorless and odorless inert gas; one of the six inert gases; comprises approximately 1% of the earth''s atmosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110479441">
	<b:glossaryEntry>a very poisonous metallic element that has three allotropic forms; arsenic and arsenic compounds are used as herbicides and insecticides and various alloys; found in arsenopyrite and orpiment and realgar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110479817">
	<b:glossaryEntry>a highly unstable radioactive element (the heaviest of the halogen series); a decay product of uranium and thorium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110480010">
	<b:glossaryEntry>a soft silvery metallic element of the alkali earth group; found in barite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110480198"
	 b:glossaryEntry="any of several compounds of barium"/>
<rdf:Description rdf:about="&a;110480339">
	<b:glossaryEntry>white poisonous crystals; made by dissolving barium oxide in water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110480468"
	 b:glossaryEntry="an oxide of barium; a whitish toxic powder"/>
<rdf:Description rdf:about="&a;110480606"
	 b:glossaryEntry="a white toxic powder obtained by heating barium oxide in air"/>
<rdf:Description rdf:about="&a;110480745">
	<b:glossaryEntry>a radioactive transuranic element; discovered by bombarding americium with helium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110480906"
	 b:glossaryEntry="a light strong brittle gray toxic bivalent metallic element"/>
<rdf:Description rdf:about="&a;110481113">
	<b:glossaryEntry>a heavy brittle diamagnetic trivalent metallic element (resembles arsenic and antimony chemically); usually recovered as a by-product from ores of other metals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110481350">
	<b:glossaryEntry>a trivalent metalloid element; occurs both in a hard black crystal and in the form of a yellow or brown powder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110481572">
	<b:glossaryEntry>a nonmetallic largely pentavalent heavy volatile corrosive dark brown liquid element belonging to the halogens; found in sea water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110481799">
	<b:glossaryEntry>a soft bluish-white ductile malleable toxic bivalent metallic element; occurs in association with zinc ores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110482003">
	<b:glossaryEntry>a white metallic element that burns with a brilliant light; the fifth most abundant element in the earth''s crust; an important component of most plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110482320">
	<b:glossaryEntry>a radioactive transuranic element; discovered by bombarding curium with alpha particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110482489">
	<b:glossaryEntry>an abundant nonmetallic tetravalent element occurring in three allotropic forms: amorphous carbon and graphite and diamond; occurs in all organic compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110482884"
	 b:glossaryEntry="an atom of carbon"/>
<rdf:Description rdf:about="&a;110482959"
	 b:glossaryEntry="a radioactive isotope of carbon"/>
<rdf:Description rdf:about="&a;110483060">
	<b:glossaryEntry>a ductile gray metallic element of the lanthanide series; used in lighter flints; the most abundant of the rare-earth group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110483317">
	<b:glossaryEntry>a soft silver-white ductile metallic element (liquid at normal temperatures); the most electropositive and alkaline metal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110483561"
	 b:glossaryEntry="a radioactive isotope of cesium used in radiation therapy"/>
<rdf:Description rdf:about="&a;110483675">
	<b:glossaryEntry>a common nonmetallic element belonging to the halogens; best known as a heavy yellow irritating toxic gas; used to purify water and as a bleaching agent and disinfectant; occurs naturally only as a salt (as in sea water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110484029"
	 b:glossaryEntry="a radioactive isotope of chlorine"/>
<rdf:Description rdf:about="&a;110484122">
	<b:glossaryEntry>a hard brittle blue-white multivalent metallic element; resistant to corrosion and tarnishing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110484331">
	<b:glossaryEntry>a hard ferromagnetic silver-white bivalent or trivalent metallic element; a trace element in plant and animal nutrition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110484583">
	<b:glossaryEntry>a radioactive isotope of cobalt with mass number 60; a source of exceptionally intense gamma rays; used in radiation therapy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110484763">
	<b:glossaryEntry>a ductile malleable reddish-brown corrosion-resistant diamagnetic metallic element; occurs in various minerals but is the only metal that occurs abundantly in large masses; used as an electrical and thermal conductor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110485225">
	<b:glossaryEntry>a radioactive transuranic metallic element; produced by bombarding plutonium with helium nuclei</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110485397">
	<b:glossaryEntry>a trivalent metallic element of the rare earth group; forms compounds that are highly magnetic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110485572">
	<b:glossaryEntry>a radioactive transuranic element produced by bombarding plutonium with neutrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110485738">
	<b:glossaryEntry>a trivalent metallic element of the rare earth group; occurs with yttrium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110485926">
	<b:glossaryEntry>a bivalent and trivalent metallic element of the rare earth group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110486089">
	<b:glossaryEntry>a radioactive transuranic metallic element produced by bombarding plutonium with neutrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110486257">
	<b:glossaryEntry>a nonmetallic univalent element; usually a yellow irritating toxic flammable gas; a powerful oxidizing agent; recovered from fluorite or cryolite or fluorapatite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110486570">
	<b:glossaryEntry>a radioactive element of the alkali-metal group discovered as a disintegration product of actinium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110486747">
	<b:glossaryEntry>a ductile silvery-white ductile ferromagnetic trivalent metallic element of the rare earth group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110486962">
	<b:glossaryEntry>a rare silvery (usually trivalent) metallic element; brittle at low temperatures but liquid above room temperature; occurs in trace amounts in bauxite and zinc ores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110487223">
	<b:glossaryEntry>a brittle gray crystalline element that is a semiconducting metalloid (resembling silicon) used in transistors; occurs in germanite and argyrodite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110487505">
	<b:glossaryEntry>a soft yellow malleable ductile (trivalent and univalent) metallic element; occurs mainly as nuggets in rocks and alluvial deposits; does not react with most chemicals but is attacked by chlorine and aqua regia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110487939">
	<b:glossaryEntry>a gray tetravalent metallic element that resembles zirconium chemically and is found in zirconium minerals; used in filaments for its ready emission of electrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110488178">
	<b:glossaryEntry>a very light colorless element that is one of the six inert gasses; the most difficult gas to liquefy; occurs in economically extractable amounts in certain natural gases (as those found in Texas and Kansas)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110488479">
	<b:glossaryEntry>a trivalent metallic element of the rare earth group; occurs together with yttrium; forms highly magnetic compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110488691">
	<b:glossaryEntry>a nonmetallic univalent element that is normally a colorless and odorless highly flammable diatomic gas; the simplest and lightest and most abundant element in the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110488977"
	 b:glossaryEntry="an atom of hydrogen"/>
<rdf:Description rdf:about="&a;110489093">
	<b:glossaryEntry>an isotope of hydrogen which has one neutron (as opposed to zero neutrons in hydrogen)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110489270">
	<b:glossaryEntry>a rare soft silvery metallic element; occurs in small quantities in sphalerite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110489444">
	<b:glossaryEntry>a nonmetallic element belonging to the halogens; used especially in medicine and photography and in dyes; occurs naturally only in combination in small quantities (as in sea water or rocks)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110489736">
	<b:glossaryEntry>a heavy brittle metallic element of the platinum group; used in alloys; occurs in natural alloys with platinum or osmium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110489934">
	<b:glossaryEntry>a heavy ductile magnetic metallic element; is silver-white in pure form but readily rusts; used in construction and tools and armament; plays a role in the transport of oxygen by the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110490433">
	<b:glossaryEntry>a colorless element that is one of the six inert gasses; occurs in trace amounts in air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110490616">
	<b:glossaryEntry>a white soft metallic element that tarnishes readily; occurs in rare earth minerals and is usually classified as a rare earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110490821">
	<b:glossaryEntry>a radioactive transuranic element synthesized from californium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110490965">
	<b:glossaryEntry>a soft heavy toxic malleable metallic element; bluish white when freshly cut but tarnishes readily to dull gray; "the children were playing with lead soldiers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110491291">
	<b:glossaryEntry>a soft silver-white univalent element of the alkali metal group; the lightest metal known; occurs in several minerals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110491561">
	<b:glossaryEntry>a trivalent metallic element of the rare earth group; usually occurs in association with yttrium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110491747">
	<b:glossaryEntry>a light silver-white ductile bivalent metallic element; in pure form it burns with brilliant white flame; occurs naturally only in combination (as in magnesite and dolomite and carnallite and spinel and olivine)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110492152">
	<b:glossaryEntry>a hard brittle gray polyvalent metallic element that resembles iron but is not magnetic; used in making steel; occurs in many minerals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110492461">
	<b:glossaryEntry>a radioactive transuranic element synthesized by bombarding einsteinium with alpha particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110492641">
	<b:glossaryEntry>a heavy silvery toxic univalent and bivalent metallic element; the only metal that is liquid at ordinary temperatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110492888">
	<b:glossaryEntry>a polyvalent metallic element that resembles chromium and tungsten in its properties; used to strengthen and harden steel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110493109">
	<b:glossaryEntry>a yellow trivalent metallic element of the rare earth group; occurs in monazite and bastnasite in association with cerium and lanthanum and praseodymium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110493379">
	<b:glossaryEntry>a colorless odorless gaseous element that give a red glow in a vacuum tube; one of the six inert gasses; occurs in the air in small amounts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110493630">
	<b:glossaryEntry>a radioactive transuranic metallic element; found in trace amounts in uranium ores; a by-product of the production of plutonium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110493837">
	<b:glossaryEntry>a hard malleable ductile silvery metallic element that is resistant to corrosion; used in alloys; occurs in pentlandite and smaltite and garnierite and millerite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110494151">
	<b:glossaryEntry>a soft gray ductile metallic element used in alloys; occurs in niobite; formerly called columbium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110494363"
	 b:glossaryEntry="a former name for niobium"/>
<rdf:Description rdf:about="&a;110494444">
	<b:glossaryEntry>a common nonmetallic element that is normally a colorless odorless tasteless inert diatomic gas; constitutes 78 percent of the atmosphere by volume; a constituent of all living tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110494778"
	 b:glossaryEntry="an obsolete name for nitrogen"/>
<rdf:Description rdf:about="&a;110494859">
	<b:glossaryEntry>a radioactive transuranic element synthesized by bombarding curium with carbon ions; 7 isotopes are known</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110495044">
	<b:glossaryEntry>a hard brittle blue-gray or blue-black metallic element that is one of the platinum metals; the heaviest metal known</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110495237">
	<b:glossaryEntry>a nonmetallic bivalent element that is normally a colorless odorless tasteless nonflammable diatomic gas; constitutes 28 percent of the atmosphere by volume; the most abundant element in the earth''s crust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110495609">
	<b:glossaryEntry>a bluish transparent magnetic liquid obtained by compressing gaseous oxygen; used as an oxidizer in rocket propellants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110495793">
	<b:glossaryEntry>a sliver-white metallic element of the platinum group that resembles platinum; occurs in some copper and nickel ores; does not tarnish at ordinary temperatures and is used (alloyed with gold) in jewelry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110496075">
	<b:glossaryEntry>a multivalent nonmetallic element of the nitrogen family that occurs commonly in inorganic phosphate rocks and as organic phosphates in all living cells; is highly reactive and occurs in several allotropic forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110496385">
	<b:glossaryEntry>a heavy precious metallic element; gray-white and resistant to corroding; occurs in some nickel and copper ores and is also found native in some deposits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110496617">
	<b:glossaryEntry>an electrically neutral ionized gas in an electric discharge; distinctly different from solids and liquids and normal gases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110496811">
	<b:glossaryEntry>a radioactive transuranic element that is similar to uranium; found in minute quantities in uranium ores but is usually synthesized in nuclear reactors; 13 isotopes are known with the most important being plutonium 239</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110497127">
	<b:glossaryEntry>a highly fissionable isotope of plutonium that is used in atomic weapons and as a reactor fuel; produced by irradiating uranium 238 with slow electrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110497338">
	<b:glossaryEntry>a radioactive metallic_element that is similar to tellurium and bismuth; occurs in uranium ores but can be produced by bombarding bismuth with neutrons in a nuclear reactor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110497589">
	<b:glossaryEntry>a light soft silver-white metallic element of the alkali metal group; oxidizes rapidly in air and reacts violently with water; is abundant in nature in combined forms occurring in sea water and in carnallite and kainite and sylvite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110497994">
	<b:glossaryEntry>a soft yellowish-white trivalent metallic element of the rare earth group; can be recovered from bastnasite or monazite by an ion-exchange process</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110498261">
	<b:glossaryEntry>a soft silvery metallic element of the rare earth group having no stable isotope; was discovered in radioactive form as a fission product of uranium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110498490">
	<b:glossaryEntry>a short-lived radioactive metallic element formed from uranium and disintegrating into actinium and then into lead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110498703">
	<b:glossaryEntry>an intensely radioactive metallic element that occurs in minute amounts in uranium ores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110498886">
	<b:glossaryEntry>a radioactive gaseous element formed by the disintegration of radium; the heaviest of the inert gasses; occurs naturally (especially in areas over granite) and is considered a hazard to health</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110499172">
	<b:glossaryEntry>a rare heavy polyvalent metallic element that resembles manganese chemically and is used in some alloys; is obtained as a by-product in refining molybdenum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110499405">
	<b:glossaryEntry>a white hard metallic element that is one of the platinum group and is found in platinum ores; used in alloys with platinum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110499606">
	<b:glossaryEntry>a soft silvery metallic element of the alkali metal group; burns in air and reacts violently in water; occurs in carnallite and lepidolite and pollucite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110499894">
	<b:glossaryEntry>a rare polyvalent metallic element of the platinum group; it is found associated with platinum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110500068"
	 b:glossaryEntry="a radioactive transuranic element which has been synthesized"/>
<rdf:Description rdf:about="&a;110500268">
	<b:glossaryEntry>a gray lustrous metallic element of the rare earth group; is used in special alloys; occurs in monazite and bastnasite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110500503">
	<b:glossaryEntry>a white trivalent metallic element; sometimes classified in the rare earth group; occurs in the Scandinavian mineral thortveitite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110500730">
	<b:glossaryEntry>a toxic nonmetallic element related to sulfur and tellurium; occurs in several allotropic forms; a stable gray metallike allotrope conducts electricity better in the light than in the dark and is used in photocells; occurs in sulfide ores (as pyrite)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110501078">
	<b:glossaryEntry>a tetravalent nonmetallic element; next to oxygen it is the most abundant element in the earth''s crust; occurs in clay and feldspar and granite and quartz and sand; used as a semiconductor in transistors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110501473">
	<b:glossaryEntry>a soft white precious univalent metallic element having the highest electrical and thermal conductivity of any metal; occurs in argentite and in free form; used in coins and jewelry and tableware and photography</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110501854">
	<b:glossaryEntry>a silvery soft waxy metallic element of the alkali metal group; occurs abundantly in natural compounds (especially in salt water); burns with a yellow flame and reacts violently in water; occurs in sea water and in the mineral halite (rock salt)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110502214">
	<b:glossaryEntry>a soft silver-white or yellowish metallic element of the alkali metal group; turns yellow in air; occurs in celestite and strontianite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110502485">
	<b:glossaryEntry>a radioactive isotope of strontium (with the mass number 90) that is present in the fallout from nuclear explosions; can be assimilated like calcium into bones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110502703">
	<b:glossaryEntry>an abundant tasteless odorless multivalent nonmetallic element; best known in yellow crystals; occurs in many sulphide and sulphate minerals and even in native form (especially in volcanic regions)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110503042">
	<b:glossaryEntry>a hard gray lustrous metallic element that is highly corrosion-resistant; occurs in niobite and fergusonite and tantalite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110503299">
	<b:glossaryEntry>a crystalline metallic element not found in nature; occurs as one of the fission products of uranium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110503480">
	<b:glossaryEntry>a brittle silver-white metalloid element that is related to selenium and sulfur; it is used in alloys and as a semiconductor; occurs mainly as tellurides in ores of copper and nickel and silver and gold</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110503800">
	<b:glossaryEntry>a metallic element of the rare earth group; used in lasers; occurs in apatite and monazite and xenotime and ytterbite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110504052">
	<b:glossaryEntry>a soft gray malleable metallic element that resembles tin but discolors on exposure to air; it is highly toxic and is used in rodent and insect poisons; occurs in zinc blende and some iron ores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110504343">
	<b:glossaryEntry>a soft silvery-white tetravalent radioactive metallic element; isotope 232 is used as a power source in nuclear reactors; occurs in thorite and in monazite sands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110504620">
	<b:glossaryEntry>a soft silvery metallic element of the rare earth group; isotope 170 emits X-rays and is used in small portable X-ray machines; it occurs in monazite and apatite and xenotime</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110504929">
	<b:glossaryEntry>a silvery malleable metallic element that resists corrosion; used in many alloys and to coat other metals to prevent corrosion; obtained chiefly from cassiterite where it occurs as tin oxide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110505231">
	<b:glossaryEntry>a light strong gray lustrous corrosion-resistant metallic element used in strong light-weight alloys (as for airplane parts); the main sources are rutile and ilmenite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110505514">
	<b:glossaryEntry>a heavy gray-white metallic element; the pure form is used mainly in electrical applications; it is found in several ores including wolframite and scheelite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110505796"
	 b:glossaryEntry="a transuranic element"/>
<rdf:Description rdf:about="&a;110505915"
	 b:glossaryEntry="a transuranic element that has not been found in nature"/>
<rdf:Description rdf:about="&a;110506095"
	 b:glossaryEntry="a transuranic element that has not been found in nature"/>
<rdf:Description rdf:about="&a;110506249">
	<b:glossaryEntry>a heavy toxic silvery-white radioactive metallic element; occurs in many isotopes; used for nuclear fuels and nuclear weapons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110506506">
	<b:glossaryEntry>a uranium isotope with mass number 235; capable of sustaining chain reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110506641">
	<b:glossaryEntry>the commonest isotope of uranium; it is not fissionable but when irradiated with neutrons it produces fissionable plutonium 239</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110506826">
	<b:glossaryEntry>a soft silvery white toxic metallic element used in steel alloys; it occurs in several complex minerals including carnotite and vanadinite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110507080">
	<b:glossaryEntry>a colorless odorless inert gaseous element occurring in the earth''s atmosphere in trace amounts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110507288">
	<b:glossaryEntry>a soft silvery metallic element; a rare earth of the lanthanide series; it occurs in gadolinite and monazite and xenotime</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110507546">
	<b:glossaryEntry>a silvery metallic element that is common in rare-earth minerals; used in magnesium and aluminum alloys</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110507783">
	<b:glossaryEntry>a bluish-white lustrous metallic element; brittle at ordinary temperatures but malleable when heated; used in a wide variety of alloys and in galvanizing iron; it occurs as zinc sulphide in zinc blende</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110508059">
	<b:glossaryEntry>a lustrous gray strong metallic element resembling titanium; it is used in nuclear reactors as a neutron absorber; it occurs in baddeleyite but is obtained chiefly from zircon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110508351">
	<b:glossaryEntry>solid homogeneous inorganic substances occurring in nature having a definite chemical composition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110510537">
	<b:glossaryEntry>a waxy mineral that is a mixture of hydrocarbons and occurs in association with petroleum; some varieties are used in making ceresin and candles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110510786">
	<b:glossaryEntry>a compact fine-textured usually white gypsum used for carving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110510903"
	 b:glossaryEntry="a hard compact kind of calcite"/>
<rdf:Description rdf:about="&a;110511039">
	<b:glossaryEntry>a white or gray mineral consisting of lithium aluminum phosphate; a source of lithium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110511201">
	<b:glossaryEntry>a mineral or mineral variety belonging to the amphibole group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110511446">
	<b:glossaryEntry>a group of minerals with similar crystal structures containing a silicate chain and combinations of chiefly sodium and calcium and magnesium and iron and aluminum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110511803">
	<b:glossaryEntry>a metamorphic rock composed chiefly of amphibole and plagioclase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110511944">
	<b:glossaryEntry>a common complex mineral consisting of calcium fluoride phosphate or calcium chloride phosphate; a source of phosphorus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110512192">
	<b:glossaryEntry>a protein that combines with a coenzyme to form an active enzyme</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110512312"
	 b:glossaryEntry="a valuable silver ore consisting of silver sulfide (Ag2S)"/>
<rdf:Description rdf:about="&a;110512444">
	<b:glossaryEntry>a sedimentary rock differing from shale in being bound by silica and from slate in having no slate cleavages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110512608">
	<b:glossaryEntry>a rare steel-gray mineral consisting of silver and germanium and sulfur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110512755"
	 b:glossaryEntry="a silver-white or gray ore of arsenic"/>
<rdf:Description rdf:about="&a;110512882">
	<b:glossaryEntry>a dark bituminous substance found in natural beds and as residue from petroleum distillation; consists mainly of hydrocarbons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110513077">
	<b:glossaryEntry>dark-green to black glassy mineral of the pyroxene group containing large amounts of aluminum and iron and magnesium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110513246"
	 b:glossaryEntry="a mineral consisting of zirconium oxide"/>
<rdf:Description rdf:about="&a;110513361">
	<b:glossaryEntry>a yellow-to-brown mineral that is a source of rare earth elements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110513573">
	<b:glossaryEntry>a clay-like mineral; the chief ore of aluminum; composed of aluminum oxides and aluminum hydroxides; used as an abrasive and catalyst</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110513798">
	<b:glossaryEntry>the chief source of beryllium; colored transparent varieties are valued as gems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110514002">
	<b:glossaryEntry>dark brown to black mica found in igneous and metamorphic rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110514136">
	<b:glossaryEntry>an ore of boron consisting of hydrated sodium borate; used as a flux or cleansing agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110514294">
	<b:glossaryEntry>a mineral consisting of sulfides of copper and iron that is found in copper deposits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110514465">
	<b:glossaryEntry>a white or reddish mineral consisting of hydrous chlorides of potassium and magnesium; used as a fertilizer and as a source of potassium and magnesium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110514729">
	<b:glossaryEntry>a yellow radioactive mineral; an ore of uranium and radium and vanadium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110514893"
	 b:glossaryEntry="a hard heavy dark mineral that is the chief source of tin"/>
<rdf:Description rdf:about="&a;110515027"
	 b:glossaryEntry="a mineral consisting of strontium sulphate"/>
<rdf:Description rdf:about="&a;110515144">
	<b:glossaryEntry>a mineral consisting of lead carbonate that is an important source of lead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110515310"
	 b:glossaryEntry="a heavy gray mineral that is an ore of copper"/>
<rdf:Description rdf:about="&a;110515447"
	 b:glossaryEntry="a yellow copper ore (CuFeS2) made up of copper-iron sulfide"/>
<rdf:Description rdf:about="&a;110515601">
	<b:glossaryEntry>a fine usually white clay formed by the weathering of aluminous minerals (as feldspar); used in ceramics and as an absorbent and as a filler (e.g., in paper)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110515878"
	 b:glossaryEntry="a brownish-black mineral; the major source of chromium"/>
<rdf:Description rdf:about="&a;110516006">
	<b:glossaryEntry>a rare hard yellow green mineral consisting of beryllium aluminate in crystal form; used as a gemstone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110516221">
	<b:glossaryEntry>a heavy reddish mineral consisting of mercuric sulfide; the chief source of mercury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110516378">
	<b:glossaryEntry>greenish-blue pigment consisting essentially of cobalt oxide and alumina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110516529"
	 b:glossaryEntry="a rare silvery-white mineral; important ore of cobalt"/>
<rdf:Description rdf:about="&a;110516657">
	<b:glossaryEntry>as white crystalline solid consisting mainly of sodium chloride</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110516892">
	<b:glossaryEntry>a blue mineral of magnesium and iron and aluminum and silicon and oxygen; often used as a gemstone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110517065"
	 b:glossaryEntry="very hard mineral used as an abrasive"/>
<rdf:Description rdf:about="&a;110517241">
	<b:glossaryEntry>a white mineral consisting of silica; found in volcanic rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110517380">
	<b:glossaryEntry>a white mineral consisting of fluorides of aluminum and sodium; a source of fluorine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110517555">
	<b:glossaryEntry>a mineral consisting of cuprous oxide that is a source of copper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110517692"
	 b:glossaryEntry="a variety of muscovite"/>
<rdf:Description rdf:about="&a;110517770">
	<b:glossaryEntry>a light colored mineral consisting of calcium magnesium carbonate; a source of magnesium; used as a ceramic and as fertilizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110517969"
	 b:glossaryEntry="a colored mineral used as a pigment"/>
<rdf:Description rdf:about="&a;110518134">
	<b:glossaryEntry>a hard gary-black mineral consisting of corundum and either hematite or magnetite; used as an abrasive (especially as a coating on paper)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110518399">
	<b:glossaryEntry>a surface-active agent that promotes the formation of an emulsion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110518539">
	<b:glossaryEntry>(chemistry) a colloid in which both phases are liquids; "an oil-in-water emulsion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110518676">
	<b:glossaryEntry>a dark mineral consisting of oxides of yttrium and erbium and tantalum and other minerals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110518880">
	<b:glossaryEntry>a form of apatite in which fluorine predominates over chlorine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110519020">
	<b:glossaryEntry>a soft mineral (calcium fluoride) that is fluorescent in ultraviolet light; chief source of fluorine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110519233">
	<b:glossaryEntry>a mineral that is a source of rare earths; consists of silicates of iron and beryllium and cerium and yttrium and erbium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110519574"
	 b:glossaryEntry="soft blue-gray mineral; lead sulfide; a major source of lead"/>
<rdf:Description rdf:about="&a;110519706">
	<b:glossaryEntry>any of a group of hard glassy minerals (silicates of various metals) used as gemstones and as an abrasive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110519954">
	<b:glossaryEntry>a green mineral consisting of hydrated nickel magnesium silicate; a source of nickel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110520114"
	 b:glossaryEntry="a deep red garnet consisting of iron aluminum silicate"/>
<rdf:Description rdf:about="&a;110520236">
	<b:glossaryEntry>a rare reddish-gray mineral consisting of a copper iron germanium sulfide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110520384">
	<b:glossaryEntry>a green mineral consisting of hydrated silicate of potassium or iron or magnesium or aluminum; found in greensand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110520554">
	<b:glossaryEntry>a red or yellow or brown mineral; an oxide of iron that is a common constituent of rust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110520725">
	<b:glossaryEntry>ore of cadmium; a rare yellowish mineral consisting of cadmium sulphide in crystalline form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110520893">
	<b:glossaryEntry>a common white or colorless mineral (hydrated calcium sulphate) used to make cements and plasters (especially plaster of Paris)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110521147">
	<b:glossaryEntry>a mineral consisting of manganese tetroxide; a source of manganese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110521309">
	<b:glossaryEntry>a white or colorless mineral (BaSO4); the main source of barium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110521485"
	 b:glossaryEntry="a white mineral; a common ore of zinc"/>
<rdf:Description rdf:about="&a;110521630">
	<b:glossaryEntry>a weakly magnetic black mineral found in metamorphic and plutonic rocks; an iron titanium oxide in crystalline form; a source of titanium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110521841">
	<b:glossaryEntry>a hard green mineral consisting of sodium aluminum silicate in monoclinic crystalline form; a source of jade; found principally in Burma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110522031">
	<b:glossaryEntry>a white mineral consisting of magnesium sulphate and potassium chloride; a source of potassium salts; used as a fertilizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110522226">
	<b:glossaryEntry>a mineral consisting of aluminum silicate; main source of kaolin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110522346">
	<b:glossaryEntry>a light soft mineral consisting of hydrated sodium borate in crystalline form; an important source of boron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110522526">
	<b:glossaryEntry>a mineral consisting of potassium magnesium double sulphate; used as a fertilizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110522684">
	<b:glossaryEntry>a mineral form of vitreous or glassy silica; formed by the melting of quartz sand (as by lightning or a meteorite)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110522879">
	<b:glossaryEntry>a yellow phospholipid found in egg yolk and in many plant and animal cells; used commercially as an emulsifier</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110523062"
	 b:glossaryEntry="a mineral of the mica group; an important source of lithium"/>
<rdf:Description rdf:about="&a;110523216"
	 b:glossaryEntry="a mica that is a biotite containing iron"/>
<rdf:Description rdf:about="&a;110523315">
	<b:glossaryEntry>a black magnetic mineral consisting of magnesium carbonate; a source of magnesium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110523471">
	<b:glossaryEntry>a green mineral used as an ore of copper and for making ornamental objects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110523620"
	 b:glossaryEntry="a thick black tar intermediate between petroleum and asphalt"/>
<rdf:Description rdf:about="&a;110523747"
	 b:glossaryEntry="an oxide of manganese found naturally as hausmannite"/>
<rdf:Description rdf:about="&a;110523884">
	<b:glossaryEntry>a black mineral consisting of basic manganese oxide; a source of manganese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110524033">
	<b:glossaryEntry>a loose and crumbling earthy deposit consisting mainly of calcite or dolomite; used as a fertilizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110524183"
	 b:glossaryEntry="a white clayey mineral"/>
<rdf:Description rdf:about="&a;110524293">
	<b:glossaryEntry>any of various minerals consisting of hydrous silicates of aluminum or potassium etc. that crystallize in forms that allow perfect cleavage into very thin leaves; used as dielectrics because of their resistance to electricity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110524707">
	<b:glossaryEntry>a yellow mineral consisting of nickel sulfide; a minor source of nickel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110524853">
	<b:glossaryEntry>a mineral resembling graphite that is valued as the chief source of molybdenum and its compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110525026">
	<b:glossaryEntry>a reddish-brown mineral containing rare earth metals; an important source of thorium and cerium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110525347"
	 b:glossaryEntry="a colorless or pale brown mica with potassium"/>
<rdf:Description rdf:about="&a;110525466">
	<b:glossaryEntry>an amphibole mineral consisting of calcium magnesium silicate in monoclinic crystalline form; a source of jade that is less valuable than from jadeite; once believed to cure kidney disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110525730"
	 b:glossaryEntry="a black mineral that is an ore of niobium and tantalum"/>
<rdf:Description rdf:about="&a;110525888"
	 b:glossaryEntry="the mineral form of calcium nitrate"/>
<rdf:Description rdf:about="&a;110525982">
	<b:glossaryEntry>a mineral consisting of magnesium iron silicate; a source of magnesium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110526143"
	 b:glossaryEntry="a salt of perchloric acid"/>
<rdf:Description rdf:about="&a;110526226"
	 b:glossaryEntry="a powerful oxidizing agent; forms perchlorates"/>
<rdf:Description rdf:about="&a;110526334">
	<b:glossaryEntry>an amino acid that is found in many proteins (especially collagen)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110526454"
	 b:glossaryEntry="plant materials and animal waste used as fuel"/>
<rdf:Description rdf:about="&a;110526553">
	<b:glossaryEntry>occurs in natural gas; used in the manufacture of rubber and fuels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110526690">
	<b:glossaryEntry>a carbonaceous material obtained by heating wood or other organic matter in the absence of air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110526869">
	<b:glossaryEntry>gaseous mixture produced by distillation of bituminous coal and used for heating and lighting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110527035"
	 b:glossaryEntry="(Brit) coal gas manufactured for domestic and industrial use"/>
<rdf:Description rdf:about="&a;110527150"
	 b:glossaryEntry="produced by distillation of coal"/>
<rdf:Description rdf:about="&a;110527233"
	 b:glossaryEntry="a heavy mineral oil used as fuel in diesel engines"/>
<rdf:Description rdf:about="&a;110527372">
	<b:glossaryEntry>(British) diesel oil used in cars and lorries with diesel engines (from d(iesel) e(ngine) r(oad) v(ehicle))</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110527530">
	<b:glossaryEntry>fuel consisting of the remains of organisms preserved in rocks in the earth''s crust with high carbon and hydrogen content</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110527763"
	 b:glossaryEntry="a petroleum product used for fuel"/>
<rdf:Description rdf:about="&a;110527901">
	<b:glossaryEntry>a gasoline substitute consisting of 90% gasoline and 10% grain alcohol from corn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110528091">
	<b:glossaryEntry>a volatile flammable mixture of hydrocarbons (hexane and heptane and octane etc.) derived from petroleum; used mainly as a fuel in internal-combustion engines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110528385"
	 b:glossaryEntry="something that can serve as a source of light"/>
<rdf:Description rdf:about="&a;110528487">
	<b:glossaryEntry>a flammable hydrocarbon oil used as fuel in lamps and heaters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110528650">
	<b:glossaryEntry>a light volatile flammable poisonous liquid alcohol; used as an antifreeze and solvent and fuel and as a denaturant for ethyl alcohol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110528921">
	<b:glossaryEntry>a translucent mineral consisting of hydrated silica of variable color; some varieties are used as gemstones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110529151"
	 b:glossaryEntry="a metal-bearing mineral valuable enough to be mined"/>
<rdf:Description rdf:about="&a;110529342">
	<b:glossaryEntry>a yellow mineral occuring in conjunction with realgar; an ore of arsenic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110529488"
	 b:glossaryEntry="a colorless or pale brown mica with sodium"/>
<rdf:Description rdf:about="&a;110529587">
	<b:glossaryEntry>partially carbonized vegetable matter saturated with water; used as a fuel when dried</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110529723">
	<b:glossaryEntry>a mineral (iron-nickel sulphide) that is the chief ore of nickel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110529864">
	<b:glossaryEntry>any monosaccharide sugar containing five atoms of carbon per molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110529987"
	 b:glossaryEntry="an oxide containing five atoms of oxygen in the molecule"/>
<rdf:Description rdf:about="&a;110530099">
	<b:glossaryEntry>any of various water-soluble compounds that form by hydrolysis in the digestion of proteins to amino acids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110530259">
	<b:glossaryEntry>a white solid mineral that occurs naturally as periclase; a source of magnesium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110530442">
	<b:glossaryEntry>a brown form of mica consisting of hydrous silicate of potassium and magnesium and aluminum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110530590"
	 b:glossaryEntry="a rare mineral that is an important source of cesium"/>
<rdf:Description rdf:about="&a;110530735">
	<b:glossaryEntry>colorless gas found in natural gas and petroleum; used as a fuel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110530871"
	 b:glossaryEntry="fuel that propels a rocket"/>
<rdf:Description rdf:about="&a;110531000">
	<b:glossaryEntry>a crystalline compound used as an antithyroid drug in the treatment of goiter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110531140">
	<b:glossaryEntry>a mineral consisting of hydrated basic oxide of manganese and barium; a source of manganese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110531308">
	<b:glossaryEntry>a toxic colorless flammable liquid organic base with a disagreeable odor; usually derived from coal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110531480">
	<b:glossaryEntry>a common mineral (iron disulfide) that has a pale yellow color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110531642">
	<b:glossaryEntry>any of various metallic-looking sulfides (of which pyrite is the commonest)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110531771">
	<b:glossaryEntry>a mineral consisting of manganese dioxide; an important source of manganese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110531922">
	<b:glossaryEntry>any of a group of crystalline silicate mineral common in igneous and metamorphic rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110532082">
	<b:glossaryEntry>a hard glossy mineral consisting of silicon dioxide in crystal form; present in most rocks (especially sandstone and granite); yellow sand is quartz with iron oxide impurities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110532492">
	<b:glossaryEntry>hard metamorphic rock consisting essentially of interlocking quartz crystals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110532624">
	<b:glossaryEntry>a clear quartz used in making electronic and optical equipment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110532784">
	<b:glossaryEntry>an imitation diamond made from rock crystal or glass or paste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110532902"
	 b:glossaryEntry="a smoky yellow or brown quartz"/>
<rdf:Description rdf:about="&a;110533003"
	 b:glossaryEntry="paper made partly or wholly from rags"/>
<rdf:Description rdf:about="&a;110533096">
	<b:glossaryEntry>a chemical substance that is present at the start of a chemical reaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110533223">
	<b:glossaryEntry>a rare soft orange mineral consisting of arsenic sulphide; an important ore of arsenic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110533382"
	 b:glossaryEntry="clay whose redness results from iron oxide"/>
<rdf:Description rdf:about="&a;110533497">
	<b:glossaryEntry>combustible_material (usually salts of lithium or strontium) that burns bright red; used in flares and fireworks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110533664">
	<b:glossaryEntry>a type of soil consisting of unconsolidated material from freshly deposited alluvium or sand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110533810"
	 b:glossaryEntry="a rich black loam of India"/>
<rdf:Description rdf:about="&a;110533901">
	<b:glossaryEntry>the soil that is remaining after the soluble elements have been dissolved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110534050"
	 b:glossaryEntry="the layer of soil on the surface"/>
<rdf:Description rdf:about="&a;110534151"
	 b:glossaryEntry="the layer of soil between the topsoil and bedrock"/>
<rdf:Description rdf:about="&a;110534266"
	 b:glossaryEntry="a plastic containing resins"/>
<rdf:Description rdf:about="&a;110534348">
	<b:glossaryEntry>a mineral consisting of manganese carbonate; a source of manganese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110534493"
	 b:glossaryEntry="a pentose sugar important as a component of ribonucleic acid"/>
<rdf:Description rdf:about="&a;110534625">
	<b:glossaryEntry>a toxic protein extracted from castor beans; used as a chemical reagent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110534748"
	 b:glossaryEntry="broken rock used for repairing or making roads"/>
<rdf:Description rdf:about="&a;110534851">
	<b:glossaryEntry>material consisting of the aggregate of minerals like those making up the Earth''s crust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110535394"
	 b:glossaryEntry="a sedimentary rock composed of sand"/>
<rdf:Description rdf:about="&a;110535509"
	 b:glossaryEntry="a sedimentary rock formed from clay deposits"/>
<rdf:Description rdf:about="&a;110535617"
	 b:glossaryEntry="a sedimentary rock formed of coarse-grained material"/>
<rdf:Description rdf:about="&a;110535748">
	<b:glossaryEntry>a rudaceous rock consisting of sharp fragments embedded in clay or sand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110535873"
	 b:glossaryEntry="rock formed from consolidated clay sediments"/>
<rdf:Description rdf:about="&a;110536106"
	 b:glossaryEntry="rock altered by pressure and heat"/>
<rdf:Description rdf:about="&a;110536256"
	 b:glossaryEntry="rock fragments and pebbles"/>
<rdf:Description rdf:about="&a;110536386">
	<b:glossaryEntry>a fine-grained metamorphic rock formed by the action of heat on clay rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110536527"
	 b:glossaryEntry="gravel as found in natural deposits"/>
<rdf:Description rdf:about="&a;110536647">
	<b:glossaryEntry>nitrate-bearing rock or gravel of the sodium nitrate deposits of Chile and Peru</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110536780">
	<b:glossaryEntry>coarse beach gravel of small water-worn stones and pebbles (or a stretch of shore covered with such gravel)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110536941"
	 b:glossaryEntry="a crystalline rock that can be cut and polished for jewelry"/>
<rdf:Description rdf:about="&a;110537142"
	 b:glossaryEntry="a highly polished convex-cut but unfaceted gem"/>
<rdf:Description rdf:about="&a;110537243">
	<b:glossaryEntry>a fine-grained metamorphic rock that can be split into thin layers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110537361">
	<b:glossaryEntry>(geology) sediment in which flat pebbles are uniformly tilted in the same direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110537500">
	<b:glossaryEntry>a light glass formed on the surface of some lavas; used as an abrasive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110537638"
	 b:glossaryEntry="a hard coarse-grained siliceous sandstone"/>
<rdf:Description rdf:about="&a;110537753"
	 b:glossaryEntry="a product made from animal material"/>
<rdf:Description rdf:about="&a;110537993">
	<b:glossaryEntry>waxy substance secreted by the sperm whale and found floating at sea or washed ashore; used in perfume</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110538151">
	<b:glossaryEntry>resinlike substance secreted by certain lac insects; used in e.g. varnishes and sealing wax</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110538420"
	 b:glossaryEntry="lac refined by treating with solvent; garnet-colored"/>
<rdf:Description rdf:about="&a;110538529"
	 b:glossaryEntry="an inferior lac produced by lac insects in Madagascar"/>
<rdf:Description rdf:about="&a;110538636">
	<b:glossaryEntry>lac purified by heating and filtering; usually in thin orange or yellow flakes but sometimes bleached white</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110538816"
	 b:glossaryEntry="a yellow pigment sometimes suspended in lacquer"/>
<rdf:Description rdf:about="&a;110538939"
	 b:glossaryEntry="lac in its natural state as scraped off twigs and dried"/>
<rdf:Description rdf:about="&a;110539107">
	<b:glossaryEntry>granular material obtained from stick lac by crushing and washing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110539246">
	<b:glossaryEntry>resembling lac; secreted by a scale living on twigs of certain Mexican shrubs; used locally as medicine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110539406"
	 b:glossaryEntry="a substance that unites or bonds"/>
<rdf:Description rdf:about="&a;110539622">
	<b:glossaryEntry>a sticky adhesive that is smeared on small branches to capture small birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110539758"
	 b:glossaryEntry="a strong liquid cement"/>
<rdf:Description rdf:about="&a;110539920">
	<b:glossaryEntry>a protein gelatin obtained by boiling e.g. skins and hoofs of cattle and horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110540075"
	 b:glossaryEntry="made from casein; used for e.g. plywood and cabinetwork"/>
<rdf:Description rdf:about="&a;110540188"
	 b:glossaryEntry="(trademark) a commercial brand of epoxy glue"/>
<rdf:Description rdf:about="&a;110540289">
	<b:glossaryEntry>gelatinous substance obtained by boiling skins fins and bones of fish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110540432">
	<b:glossaryEntry>a dough-like mixture of whiting and boiled linseed oil; used especially to patch woodwork or secure panes of glass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110540616">
	<b:glossaryEntry>a cement resembling putty; made by mixing ferric oxide and boiled linseed oil; is acid resistant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110540769">
	<b:glossaryEntry>a cement resembling putty; made by mixing white and red lead in boiled linseed oil; used as luting on pipe fittings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110540945">
	<b:glossaryEntry>a solution made of gum and ether and used to attach false hair to skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110541072">
	<b:glossaryEntry>something used to bind separate particles together or facilitate adhesion to a surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110541211"
	 b:glossaryEntry="something that hardens to act as adhesive material"/>
<rdf:Description rdf:about="&a;110541404"
	 b:glossaryEntry="a pasty cement used as an adhesive or filler"/>
<rdf:Description rdf:about="&a;110541519">
	<b:glossaryEntry>an adhesive made from water and flour or starch; used on paper and paperboard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110541682"
	 b:glossaryEntry="a small adhesive disk of paste; used to seal letters"/>
<rdf:Description rdf:about="&a;110541786"
	 b:glossaryEntry="any mixture of a soft and malleable consistency"/>
<rdf:Description rdf:about="&a;110541885">
	<b:glossaryEntry>an adhesive made by dissolving unvulcanized rubber in a solvent like benzene or naphtha</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110542032">
	<b:glossaryEntry>any substance used to seal joints or fill cracks in a porous surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110542217"
	 b:glossaryEntry="used to form a hard coating on a porous surface"/>
<rdf:Description rdf:about="&a;110542327"
	 b:glossaryEntry="used for filling cracks or holes in a surface"/>
<rdf:Description rdf:about="&a;110542497">
	<b:glossaryEntry>a substance for packing a joint or coating a porous surface to make it impervious to gas or liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110542655">
	<b:glossaryEntry>any glutinous material used to fill pores in surfaces or to stiffen fabrics; "size gives body to a fabric"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110542821">
	<b:glossaryEntry>a colorless crystalline organic base; the parent compound of various biologically important substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110542976"
	 b:glossaryEntry="any of several bases that are derivatives of purine"/>
<rdf:Description rdf:about="&a;110543116">
	<b:glossaryEntry>purine base found in DNA and RNA; pairs with thymine in DNA and with uracil in RNA</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110543290">
	<b:glossaryEntry>(biochemistry) a nucleoside that is present in all living cells in a combined form; a constituent of DNA and RNA and ATP and AMP</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110543474">
	<b:glossaryEntry>a nucleotide found in muscle cells and important in metabolism; reversibly convertible to ADP and ATP</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110543667">
	<b:glossaryEntry>an ester of adenosine that is converted to ATP for energy storage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110543806">
	<b:glossaryEntry>a a nucleotide derived from adenosine that occurs in muscle tissue; the major source of energy for cellular reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110543998">
	<b:glossaryEntry>an impure form of quartz consisting of banded chalcedony; used as a gemstone and for making mortars and pestles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110544179"
	 b:glossaryEntry="an agate with brown, black, or green moss-like markings"/>
<rdf:Description rdf:about="&a;110544291">
	<b:glossaryEntry>a growth-regulating chemical sprayed on fruit trees; entire crop can be harvested at one time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110544448">
	<b:glossaryEntry>any of a series of volatile hydroxyl compounds that are made from hydrocarbons by distillation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110544776">
	<b:glossaryEntry>the intoxicating agent in fermented and distilled liquors; used pure or denatured as a solvent or in medicines and colognes and cleaning solutions and rocket fuel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110545157"
	 b:glossaryEntry="rectified ethyl alcohol"/>
<rdf:Description rdf:about="&a;110545242"
	 b:glossaryEntry="ethyl alcohol containing no more than 1% water"/>
<rdf:Description rdf:about="&a;110545351"
	 b:glossaryEntry="used as antifreeze or a solvent"/>
<rdf:Description rdf:about="&a;110545460"
	 b:glossaryEntry="any substance that serves as a denaturing agent"/>
<rdf:Description rdf:about="&a;110545564">
	<b:glossaryEntry>ethyl alcohol that is unfit for drinking but is still useful for other purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110545725"
	 b:glossaryEntry="an insoluble solid alcohol used to make detergents"/>
<rdf:Description rdf:about="&a;110545850">
	<b:glossaryEntry>a non-aromatic saturated hydrocarbon with the general formula CnH(2n+2)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110546072">
	<b:glossaryEntry>a poisonous gas or liquid (CH3Br) used to fumigate rodents, worms, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110546204">
	<b:glossaryEntry>ethyl alcohol denatured with methyl alcohol to prevent its use as an alcoholic beverage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110546356"
	 b:glossaryEntry="the bivalent radical CH2 derived from methane"/>
<rdf:Description rdf:about="&a;110546483">
	<b:glossaryEntry>any of a series of univalent groups of the general formula CnH2n+1 derived from aliphatic hydrocarbons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110546687"
	 b:glossaryEntry="the univalent radical CH3- derived from methane"/>
<rdf:Description rdf:about="&a;110546855">
	<b:glossaryEntry>the univalent hydrocarbon radical C2H5 derived from ethane by the removal of one hydrogen atom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110547031"
	 b:glossaryEntry="the bivalent radical UO2 which forms salts with acids"/>
<rdf:Description rdf:about="&a;110547207">
	<b:glossaryEntry>a yellow salt obtained by the reaction of uranium salts with nitric acid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110547359">
	<b:glossaryEntry>a salt obtained by the reaction of uranium salts with oxalic acid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110547504">
	<b:glossaryEntry>any of a class of highly reactive chemical compounds; used in making resins and dyes and organic acids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110547751">
	<b:glossaryEntry>a monosaccharide sugar that contains the aldehyde group or is hemiacetal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110547876">
	<b:glossaryEntry>any organic compound formed by adding alcohol molecules to aldehyde molecules</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548006">
	<b:glossaryEntry>a colorless volatile water-soluble liquid aldehyde used chiefly in manufacture of acetic acid and perfumes and drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548181">
	<b:glossaryEntry>a colorless solid amide of acetic acid used as a solvent and in the synthesis of organic compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548348">
	<b:glossaryEntry>an oily colorless liquid obtained by the condensation of two molecules of acetaldehyde</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548498">
	<b:glossaryEntry>a mixture of soluble salts found in arid soils and some bodies of water; detrimental to agriculture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548650">
	<b:glossaryEntry>any of the monovalent metals of group I of the periodic table (lithium or sodium or potassium or rubidium or cesium or francium)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548837">
	<b:glossaryEntry>any of the bivalent metals (calcium or strontium or barium or magnesium)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110548994"
	 b:glossaryEntry="natural nitrogen-containing bases found in plants"/>
<rdf:Description rdf:about="&a;110549278"
	 b:glossaryEntry="any unsaturated aliphatic hydrocarbon"/>
<rdf:Description rdf:about="&a;110549405"
	 b:glossaryEntry="sulfonate of alkyl benzene"/>
<rdf:Description rdf:about="&a;110549499">
	<b:glossaryEntry>white odorless powdered or crystalline alkaloid from plants of the genus Ephedra (especially Ephedra sinica) or made synthetically; used to treat allergies and asthma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110549721">
	<b:glossaryEntry>poisonous crystalline alkaloid occurring with ephedrine and isomorphic with it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110549861">
	<b:glossaryEntry>an alkaloid poison that occurs in tobacco; used in medicine and as an insecticide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110550034">
	<b:glossaryEntry>an alkaloid poison extracted chiefly from nux vomica; formerly used as a stimulant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110550210">
	<b:glossaryEntry>a bitter alkaloid poison resembling strychnine and extracted from nux vomica</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110550377"
	 b:glossaryEntry="a strong coarse tobacco that has been shredded"/>
<rdf:Description rdf:about="&a;110550474">
	<b:glossaryEntry>a dark, aromatic, small-leaved tobacco of eastern Europe and used in cigarettes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110550615"
	 b:glossaryEntry="a green variety of chrysoberyl used as a gemstone"/>
<rdf:Description rdf:about="&a;110550722">
	<b:glossaryEntry>cast iron containing alloying elements (usually nickel or chromium or copper or molybdenum) to increase the strength or facilitate heat treatment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110550978">
	<b:glossaryEntry>steel who characteristics are determined by the addition of other elements in addition to carbon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110551294">
	<b:glossaryEntry>an alloy used to make high-energy permanent magnets; contains aluminum and iron and nickel plus cobalt or copper or titanium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110551471">
	<b:glossaryEntry>an alloy of metal with another metal (usually silver) used by dentists to fill cavities in teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110551638">
	<b:glossaryEntry>an alloy with a low melting point and used as solder and in safety plugs and sprinkler fuses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110551790"
	 b:glossaryEntry="an alloy of copper and zinc"/>
<rdf:Description rdf:about="&a;110552050">
	<b:glossaryEntry>an alloy of copper and tin and sometimes other elements; also any copper-base alloy containing other elements in place of tin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110552391">
	<b:glossaryEntry>a type of bronze used for parts subject to wear or corrosion (especially corrosion by sea water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110552542">
	<b:glossaryEntry>a corrosion-resistant bronze containing phosphorus; used in bearings and gears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110552682"
	 b:glossaryEntry="a 60/40 alloy of copper and nickel"/>
<rdf:Description rdf:about="&a;110552774"
	 b:glossaryEntry="an alloy of gold and silver"/>
<rdf:Description rdf:about="&a;110552856">
	<b:glossaryEntry>any of various alloys of tin with small amounts of other metals (especially lead)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110552990">
	<b:glossaryEntry>an alloy of copper and zinc that is used in cheap jewelry to imitate gold</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110553119">
	<b:glossaryEntry>solder that contains copper; melts at a relatively high temperature; used for brazing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110553262"
	 b:glossaryEntry="a solder that contains silver"/>
<rdf:Description rdf:about="&a;110553351"
	 b:glossaryEntry="solder that melts at a relatively low temperature"/>
<rdf:Description rdf:about="&a;110553458">
	<b:glossaryEntry>an alloy (usually of lead and tin) used when melted to join two metal surfaces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110553643">
	<b:glossaryEntry>the particles and flakes (and sometimes small nuggets) of gold obtained in placer mining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110553787">
	<b:glossaryEntry>a pale alloy of gold usually with platinum or nickel or palladium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110553909">
	<b:glossaryEntry>an alloy of nickel and copper and other metals (such as iron and/or manganese and/or aluminum)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110554076">
	<b:glossaryEntry>an alloy of tin and lead and antimony used to make printing type</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110554197"
	 b:glossaryEntry="an alloy, often of lead or tin base, used for bearings"/>
<rdf:Description rdf:about="&a;110554309">
	<b:glossaryEntry>a fine-grained fertile soil deposited by water flowing over flood plains or in river beds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110554477">
	<b:glossaryEntry>an unsaturated primary alcohol present in wood spirit; use to make resins and plasticizers and pharmaceuticals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110554685">
	<b:glossaryEntry>a resin derived from allyl alcohol that hardens when cured; used as an adhesive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110554822">
	<b:glossaryEntry>a brass that has more zinc and is stronger than alpha brass; used in making castings and hot-worked products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110555058"
	 b:glossaryEntry="a brass-zinc alloy; used mainly for cold working"/>
<rdf:Description rdf:about="&a;110555164"
	 b:glossaryEntry="a copper-tin alloy that can be worked"/>
<rdf:Description rdf:about="&a;110555260">
	<b:glossaryEntry>a magnetic allotrope of iron; stable below 906 degrees centigrade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110555401">
	<b:glossaryEntry>an allotrope of iron that is the same as alpha iron except that it is nonmagnetic; stable between 768 and 906 degrees centigrade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110555585">
	<b:glossaryEntry>a nonmagnetic allotrope of iron that is the basis of austenite; stable between 906 and 1403 degrees centigrade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110555771">
	<b:glossaryEntry>an allotrope of iron that is stable between 1403 degrees centigrade and the melting point (= 1532 degrees)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110555934"
	 b:glossaryEntry="a transparent purple variety of quartz; used as a gemstone"/>
<rdf:Description rdf:about="&a;110556065">
	<b:glossaryEntry>a copper-aluminum alloy with high tensile strength and resistance to corrosion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110556224">
	<b:glossaryEntry>any agency bringing about activation; (biology) a molecule that increases the activity of an enzyme or a protein that increases the production of a gene product in DNA transcription</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110556533">
	<b:glossaryEntry>(mineral extraction) a surface-active chemical used in flotation process to increase the attraction to a specific mineral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110556717">
	<b:glossaryEntry>(chemistry) a substance that initiates or accelerates a chemical reaction without itself being affected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110556961"
	 b:glossaryEntry="a biochemical catalyst such as an enzyme"/>
<rdf:Description rdf:about="&a;110557059">
	<b:glossaryEntry>(chemistry) a substance other than a catalyst that facilitates the start of a catalytic reaction; (physics) an impurity that augments luminescence in a mineral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110557275"
	 b:glossaryEntry="any organic compound containing the group -CONH2"/>
<rdf:Description rdf:about="&a;110557411"
	 b:glossaryEntry="a substance that retards or stops an activity"/>
<rdf:Description rdf:about="&a;110557584"
	 b:glossaryEntry="any solution that is injected (as into the skin)"/>
<rdf:Description rdf:about="&a;110557700"
	 b:glossaryEntry="substance that inhibits oxidation"/>
<rdf:Description rdf:about="&a;110557791">
	<b:glossaryEntry>(chemistry) a substance that retards a chemical reaction or diminishes the activity of a catalyst</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110557965">
	<b:glossaryEntry>a green mineral of the amphibole group; calcium magnesium iron silicate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110558112"
	 b:glossaryEntry="a dark gray volcanic rock"/>
<rdf:Description rdf:about="&a;110558192">
	<b:glossaryEntry>a dark brown mineral of the amphibole group; magnesium iron silicate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110558339">
	<b:glossaryEntry>a fibrous amphibole; used for making fireproof articles; inhaling fibers can cause asbestosis or lung cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110558557">
	<b:glossaryEntry>a gray or green fibrous mineral; an important source of commercial asbestos</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110558689">
	<b:glossaryEntry>a white or pale green mineral (calcium magnesium silicate) of the amphibole group used as a form of asbestos</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110558872">
	<b:glossaryEntry>a green to black mineral of the amphibole group; consists of silicates of calcium and sodium and magnesium and iron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110559063">
	<b:glossaryEntry>fine-grained homogeneous rock (such as basalt) containing minerals undetectable by the naked eye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110559214">
	<b:glossaryEntry>light-colored and fine-grained granitic rock consisting chiefly of quartz and feldspars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110559354">
	<b:glossaryEntry>a toxic mixture of gases (including carbon dioxide and carbon monoxide and nitrogen) after an explosion of firedamp in a mine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110559535">
	<b:glossaryEntry>a mixture of gases (mostly methane) that form in coal mines and become explosive when mixed with air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110559690">
	<b:glossaryEntry>an inactive substance that is a vehicle for a radioactive tracer of the same substance and that assists in its recovery after some chemical reaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110559892"
	 b:glossaryEntry="any substance used to slow down neutrons in nuclear reactors"/>
<rdf:Description rdf:about="&a;110560045">
	<b:glossaryEntry>water containing a substantial proportion of deuterium atoms, used in nuclear reactors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110560207"
	 b:glossaryEntry="any compound of carbon and another element or a radical"/>
<rdf:Description rdf:about="&a;110560829">
	<b:glossaryEntry>any of a large group of nitrogenous organic compounds that are essential constituents of living cells; consist of long strings of amino acids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110561313">
	<b:glossaryEntry>granular protein in outermost layer of endosperm of many seeds or cereal grains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110561447">
	<b:glossaryEntry>a colorless water-soluble glutinous protein obtained from animal tissues such as bone and skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110561606">
	<b:glossaryEntry>a nitrogenous substance found in mucous secretions; a lubricant that protects body surfaces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110561768"
	 b:glossaryEntry="a protein that yields only amino acids when hydrolyzed"/>
<rdf:Description rdf:about="&a;110562045">
	<b:glossaryEntry>one of the proteins into which actomyosin can be split; can exist in either a globular or a fibrous form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110562220">
	<b:glossaryEntry>a simple water-soluble protein found in many animal tissues and liquids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110562409"
	 b:glossaryEntry="albumin occurring in milk"/>
<rdf:Description rdf:about="&a;110562492">
	<b:glossaryEntry>albumin occurring in blood serum; serves to maintain the somatic pressure of the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110562657">
	<b:glossaryEntry>globulins occurring blood serum and containing most of the antibodies of the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110562819">
	<b:glossaryEntry>a protein complex combining amino acids with other substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110563018">
	<b:glossaryEntry>a fibrous scleroprotein that occurs in the outer layer of the skin and in horny tissues such as hair feathers nails and hooves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110563265">
	<b:glossaryEntry>a tough semitransparent horny substance; the principal component of the exoskeletons of arthropods and the cell walls of certain fungi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110563452"
	 b:glossaryEntry="containing chemically bound phosphoric acid"/>
<rdf:Description rdf:about="&a;110563574"
	 b:glossaryEntry="a milk protein used in making e.g. plastics and adhesives"/>
<rdf:Description rdf:about="&a;110563684">
	<b:glossaryEntry>any of several complex proteins that are produced by cells and act as catalysts in specific biochemical reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110564264">
	<b:glossaryEntry>any of a group of proteins found in saliva and pancreatic juice and parts of plants; help convert starch to sugar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110564449"
	 b:glossaryEntry="an enzyme that induces coagulation"/>
<rdf:Description rdf:about="&a;110564575">
	<b:glossaryEntry>one of a series of enzymes in the blood serum that are part of the immune response</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110564733">
	<b:glossaryEntry>a protein in blood plasma that is the inactive precursor of thrombin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110564896">
	<b:glossaryEntry>an enzyme that acts on fibrinogen in blood causing it to clot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110565012">
	<b:glossaryEntry>enzyme found in most plant and animal cells that functions as an oxidative catalyst; decomposes hydrogen peroxide into hydrogen and water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110565204"
	 b:glossaryEntry="an amylase secreted in saliva"/>
<rdf:Description rdf:about="&a;110565306"
	 b:glossaryEntry="a substance that curdles milk in making cheese and junket"/>
<rdf:Description rdf:about="&a;110565435"
	 b:glossaryEntry="a substance capable of bringing about fermentation"/>
<rdf:Description rdf:about="&a;110565539"
	 b:glossaryEntry="the substance acted upon by an enzyme or ferment"/>
<rdf:Description rdf:about="&a;110565643">
	<b:glossaryEntry>a compound derived from ammonia by replacing hydrogen atoms by univalent hydrocarbon radicals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110565874"
	 b:glossaryEntry="insecticide"/>
<rdf:Description rdf:about="&a;110565963"
	 b:glossaryEntry="an organic acid characterized by one or more carboxyl groups"/>
<rdf:Description rdf:about="&a;110566319">
	<b:glossaryEntry>a white dicarboxylic acid formed from oxidation of sugar or starch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110566446"
	 b:glossaryEntry="a dicarboxylic acid used to make resins"/>
<rdf:Description rdf:about="&a;110566563"
	 b:glossaryEntry="a white crystalline carboxylic acid used as a preservative"/>
<rdf:Description rdf:about="&a;110566679"
	 b:glossaryEntry="a clear liquid carboxylic acid used in perfumes and drugs"/>
<rdf:Description rdf:about="&a;110566812">
	<b:glossaryEntry>any of a class of aliphatic monocarboxylic acids that form part of a lipid molecule and can be derived from fat by hydrolysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110567030">
	<b:glossaryEntry>a fatty acid whose carbon chain cannot absorb any more hydrogen; found chiefly in animal fats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110567352">
	<b:glossaryEntry>a fatty acid whose carbon chain can absorb additional hydrogen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110567573">
	<b:glossaryEntry>an unsaturated fatty acid whose carbon chain has one double or triple valence bond per molecule; found chiefly in olive oil and chicken and almonds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110567793">
	<b:glossaryEntry>an unsaturated fatty acid whose carbon chain has more than one double or triple valence bond per molecule; found chiefly in fish and corn and soybean oil and safflower oil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110568073"
	 b:glossaryEntry="a colorless crystalline synthetic fatty acid"/>
<rdf:Description rdf:about="&a;110568198"
	 b:glossaryEntry="an oily fatty acid found in castor oil and used in soap"/>
<rdf:Description rdf:about="&a;110568334">
	<b:glossaryEntry>amino acid that can be synthesized by the organism and are not required in the diet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110568486">
	<b:glossaryEntry>an amino acid that is required by animals but that they cannot synthesize; must be supplied in the diet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110568836"
	 b:glossaryEntry="a peptide containing 10 to more than 100 amino acids"/>
<rdf:Description rdf:about="&a;110568946"
	 b:glossaryEntry="two or more amino acids held together by peptide bonds"/>
<rdf:Description rdf:about="&a;110569090"
	 b:glossaryEntry="a derivative of benzoic acid"/>
<rdf:Description rdf:about="&a;110569182">
	<b:glossaryEntry>a plastic (synthetic resin) made from amino compounds; used as an adhesive and as a coating for paper and textiles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110569383"
	 b:glossaryEntry="a pungent gas compounded of nitrogen and hydrogen"/>
<rdf:Description rdf:about="&a;110569486"
	 b:glossaryEntry="a complex inorganic compound that contains ammonia molecules"/>
<rdf:Description rdf:about="&a;110569599"
	 b:glossaryEntry="a water solution of ammonia"/>
<rdf:Description rdf:about="&a;110569717"
	 b:glossaryEntry="the aromatic gum of the ammoniac plant"/>
<rdf:Description rdf:about="&a;110569825">
	<b:glossaryEntry>the ion NH4 derived from ammonia; behaves in many respects like an alkali metal ion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110569978">
	<b:glossaryEntry>a salt of carbamic acid that is used as a nitrogen fertilizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110570104">
	<b:glossaryEntry>a carbonate of ammonium; used in the manufacture of smelling salts and baking powder and ammonium compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110570276"
	 b:glossaryEntry="a white salt used in dry cells"/>
<rdf:Description rdf:about="&a;110570385">
	<b:glossaryEntry>a mixture of 2 or more isomeric alcohols; used as a solvent and in organic synthesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110570528"
	 b:glossaryEntry="a hormone-like plant product"/>
<rdf:Description rdf:about="&a;110570686"
	 b:glossaryEntry="a plant hormone that promotes root formation and bud growth"/>
<rdf:Description rdf:about="&a;110570833">
	<b:glossaryEntry>a plant hormone isolated from a fungus; used in promoting plant growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110570979"
	 b:glossaryEntry="a crystalline acid associated with gibberellin"/>
<rdf:Description rdf:about="&a;110571088"
	 b:glossaryEntry="a brand name"/>
<rdf:Description rdf:about="&a;110571154">
	<b:glossaryEntry>any hormone affecting the development and growth of sex organs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110571392">
	<b:glossaryEntry>secreted by the adrenal cortex; involved in regulating water and electrolyte balance in the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110571549">
	<b:glossaryEntry>a steroid hormone produced in the ovary; prepares and maintains the uterus for pregnancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110571714">
	<b:glossaryEntry>a progestational compound used to treat endometrial carcinoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110571832">
	<b:glossaryEntry>a progestin compound (trade name Provera) used to treat menstrual disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110571983">
	<b:glossaryEntry>a progestin compound used in oral contraceptives and to treat endometriosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110572155">
	<b:glossaryEntry>any of a group of steroid hormones that exhibit progesterone-like activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110572339">
	<b:glossaryEntry>male sex hormone that is produced in the testes and responsible for typical male sexual characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110572590">
	<b:glossaryEntry>a steroid having androgenic activity; obtained from the cortex of the adrenal gland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110572733"
	 b:glossaryEntry="a hormone that stimulates the adrenal gland"/>
<rdf:Description rdf:about="&a;110572836"
	 b:glossaryEntry="an androgenic hormone that is less active than testosterone"/>
<rdf:Description rdf:about="&a;110572954">
	<b:glossaryEntry>an androgenic compound contained in druges that are used to treat testosterone deficiency and female breast cancer and to stimulate growth and weight gain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110573173">
	<b:glossaryEntry>an androgen (trade names Durabolin or Kabolin) that is used to treat testosterone deficiency or breast cancer or osteoporosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110573377"
	 b:glossaryEntry="a potent androgenic hormone"/>
<rdf:Description rdf:about="&a;110573463">
	<b:glossaryEntry>a gonadotropic hormone that is secreted by the pituitary and stimulates growth of Graafian follicles in female mammals, and activates sperm-forming cells in male mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110573713">
	<b:glossaryEntry>a gonadotropic hormone that is secreted by the pituitary and stimulates ovulation in female mammals, and stimulates androgen release in male mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110573972">
	<b:glossaryEntry>secreted by the ovary and responsible for typical female sexual characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110574172">
	<b:glossaryEntry>a potent estrogen used in medicine and in feed for livestock and poultry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110574366"
	 b:glossaryEntry="a weak estrogenic hormone secreted by the mammalian ovary"/>
<rdf:Description rdf:about="&a;110574488">
	<b:glossaryEntry>a form of estrogen used in combination with a progestin in oral contraceptives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110574641">
	<b:glossaryEntry>a steroid hormone produced by the adrenal cortex or synthesized</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110574867">
	<b:glossaryEntry>one of the steroids of the adrenal cortex that influences the metabolism of sodium and potassium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110575045">
	<b:glossaryEntry>a steroid hormone that is produced by the adrenal cortex of animals and has anti-inflammatory activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110575280">
	<b:glossaryEntry>a corticosteroid hormone that is secreted by the cortex of the adrenal gland; regulates salt (sodium and potassium) and water balance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110575471">
	<b:glossaryEntry>an adrenal-cortex hormone that is active in carbohydrate and protein metabolism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110575622">
	<b:glossaryEntry>a corticosteroid hormone produced by the adrenal cortex; is converted to hydrocortisone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110575765">
	<b:glossaryEntry>a dehydrogenated analogue of cortisol; used as an anti-inflammatory drug in the treatment of arthritis and as an immunosuppressant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110575970">
	<b:glossaryEntry>a corticosteroid drug (trade names Decadron or Oradexon) used to treat allergies or inflammation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110576166">
	<b:glossaryEntry>a synthetic corticosteroid (trade name Aldactone) used to treat hypertension</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110576333">
	<b:glossaryEntry>oily poisonous liquid amine obtained from nitrobenzene and used to make dyes and plastics and medicines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110576533"
	 b:glossaryEntry="any of many dyes made from aniline"/>
<rdf:Description rdf:about="&a;110576625"
	 b:glossaryEntry="any oil obtained from animal substances"/>
<rdf:Description rdf:about="&a;110577189">
	<b:glossaryEntry>an oil that hardens in air due to oxidation and is often used as a paint or varnish base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110577352"
	 b:glossaryEntry="material derived from animals"/>
<rdf:Description rdf:about="&a;110577587"
	 b:glossaryEntry="pigment occurring in animals"/>
<rdf:Description rdf:about="&a;110577730">
	<b:glossaryEntry>a poisonous colorless flammable gas used in organic synthesis and to dope transistors and as a poison gas in warfare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110577899">
	<b:glossaryEntry>an orange-yellow pigment in the bile that forms as a product of hemoglobin; excess amounts in the blood produce the yellow appearance observed in jaundice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110578109">
	<b:glossaryEntry>pigment occurring in luminescent organisms (as fireflies); emits heatless light when undergoing oxidation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110578270">
	<b:glossaryEntry>insoluble pigments that account for the color of e.g. skin and scales and feathers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110578444">
	<b:glossaryEntry>a calcareous material harder and denser than bone that comprises the bulk of a tooth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110578609">
	<b:glossaryEntry>a hard smooth ivory colored dentine that makes up most of the tusks of elephants and walruses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110578761"
	 b:glossaryEntry="any light downy material"/>
<rdf:Description rdf:about="&a;110578837"
	 b:glossaryEntry="the porous calcified substance from which bones are made"/>
<rdf:Description rdf:about="&a;110578980">
	<b:glossaryEntry>the material (mostly keratin) that covers the horns of ungulates and forms hooves and claws and nails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110579187">
	<b:glossaryEntry>a horny material from the upper jaws of certain whales; used as the ribs of fans or as stays in corsets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110579355"
	 b:glossaryEntry="the mottled horny substance of the shell of some turtles"/>
<rdf:Description rdf:about="&a;110579471">
	<b:glossaryEntry>the material that forms the hard outer covering of many animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110579623"
	 b:glossaryEntry="the iridescent internal layer of a mollusk shell"/>
<rdf:Description rdf:about="&a;110579741">
	<b:glossaryEntry>the tissue forming the outer covering of a fur-bearing animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110579950"
	 b:glossaryEntry="the tissue forming the hard outer layer of e.g. a fruit"/>
<rdf:Description rdf:about="&a;110580063"
	 b:glossaryEntry="skin of a sheep or goat prepared for writing on"/>
<rdf:Description rdf:about="&a;110580207">
	<b:glossaryEntry>fine parchment prepared from the skin of a young animal e.g. a calf or lamb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110580335"
	 b:glossaryEntry="the dressed skin of an animal (especially a large animal)"/>
<rdf:Description rdf:about="&a;110580486"
	 b:glossaryEntry="the hide of a goat"/>
<rdf:Description rdf:about="&a;110580559">
	<b:glossaryEntry>untanned hide especially of cattle; cut in strips it is used for whips and ropes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110580693">
	<b:glossaryEntry>an animal skin made smooth and flexible by removing the hair and tanning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110581251"
	 b:glossaryEntry="leather made from alligator''s hide"/>
<rdf:Description rdf:about="&a;110581341">
	<b:glossaryEntry>a soft yellowish suede leather originally from deerskin but now usually from sheepskin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110581482">
	<b:glossaryEntry>a soft thick undyed leather from the skins of e.g. buffalo or oxen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110581599">
	<b:glossaryEntry>a very soft leather made from the skins of calves and having a suede finish on the flesh side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110581751">
	<b:glossaryEntry>a smooth leather tanned with willow, birch, or oak, and scented on the flesh side with birch oil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110581908">
	<b:glossaryEntry>a bitter alkaloid found in coffee and tea that is responsible for their stimulating effects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110582102"
	 b:glossaryEntry="fine leather from the skin of a calf"/>
<rdf:Description rdf:about="&a;110582218"
	 b:glossaryEntry="a leather that has been treated with alum and/or salt"/>
<rdf:Description rdf:about="&a;110582346">
	<b:glossaryEntry>a starch made by leaching and drying the root of the cassava plant; the source of tapioca; a staple food in the tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110582574">
	<b:glossaryEntry>a soft suede leather formerly from the sheep of the chamois antelope but now from sheepskin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110582807"
	 b:glossaryEntry="piece of chamois used for cleaning and polishing"/>
<rdf:Description rdf:about="&a;110582914"
	 b:glossaryEntry="a fine leather originally made in Cordoba Spain"/>
<rdf:Description rdf:about="&a;110583016"
	 b:glossaryEntry="leather from the skin of a cow"/>
<rdf:Description rdf:about="&a;110583110"
	 b:glossaryEntry="leather that has had its grain pattern accentuated"/>
<rdf:Description rdf:about="&a;110583230"
	 b:glossaryEntry="leather from the hide of a deer"/>
<rdf:Description rdf:about="&a;110583316"
	 b:glossaryEntry="soft leather from deerskin or lambskin"/>
<rdf:Description rdf:about="&a;110583408"
	 b:glossaryEntry="leather from the hide of a horse"/>
<rdf:Description rdf:about="&a;110583496">
	<b:glossaryEntry>soft smooth leather from the hide of a young goat; "kid gloves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110583619"
	 b:glossaryEntry="soft suede glove leather from goatskin"/>
<rdf:Description rdf:about="&a;110583709">
	<b:glossaryEntry>a soft pebble-grained leather made from goatskin; used for shoes and book bindings etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110583850"
	 b:glossaryEntry="leather with a hard glossy surface"/>
<rdf:Description rdf:about="&a;110583945"
	 b:glossaryEntry="leather from the skin of swine"/>
<rdf:Description rdf:about="&a;110584029">
	<b:glossaryEntry>tanned skin of a sheep with the fleece left on; used for clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110584177">
	<b:glossaryEntry>in Greek mythology, a fleece of gold owned by the king of Colchis and guarded in a sacred grove by a dragon; recovered by Jason and the Argonauts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110584382"
	 b:glossaryEntry="leather used to make shoes"/>
<rdf:Description rdf:about="&a;110584467"
	 b:glossaryEntry="leather with a napped surface"/>
