	 b:glossaryEntry="threadfins"/>
<rdf:Description rdf:about="&a;102100613">
	<b:glossaryEntry>mullet-like tropical marine fishes having pectoral fins with long threadlike rays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102100787"
	 b:glossaryEntry="a genus of Polynemidae"/>
<rdf:Description rdf:about="&a;102100927"
	 b:glossaryEntry="found along western Atlantic coast"/>
<rdf:Description rdf:about="&a;102101058"
	 b:glossaryEntry="jawfishes"/>
<rdf:Description rdf:about="&a;102101194">
	<b:glossaryEntry>small large-mouthed tropical marine fishes common along sandy bottoms; males brood egg balls in their mouths; popular aquarium fishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102101400"
	 b:glossaryEntry="stargazers"/>
<rdf:Description rdf:about="&a;102101531">
	<b:glossaryEntry>heavy-bodied marine bottom-lurkers with eyes on flattened top of the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102101679"
	 b:glossaryEntry="sand stargazers"/>
<rdf:Description rdf:about="&a;102101800">
	<b:glossaryEntry>small pallid fishes of shoal tropical waters of North and South America having eyes on stalks atop head; they burrow in sand to await prey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102102018"
	 b:glossaryEntry="blennies; butterfishes; gunnels"/>
<rdf:Description rdf:about="&a;102102282">
	<b:glossaryEntry>elongated mostly scaleless marine fishes with large pectoral fins and reduced pelvic fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102102607"
	 b:glossaryEntry="a family of fish including: combtooth blennies"/>
<rdf:Description rdf:about="&a;102102806">
	<b:glossaryEntry>small usually scaleless fishes with comb-like teeth living about rocky shores; territorial and hole-dwelling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102103041"
	 b:glossaryEntry="type genus of the Blenniidae"/>
<rdf:Description rdf:about="&a;102103179"
	 b:glossaryEntry="European scaleless blenny"/>
<rdf:Description rdf:about="&a;102103294"
	 b:glossaryEntry="a genus of Blenniidae"/>
<rdf:Description rdf:about="&a;102103427"
	 b:glossaryEntry="inhabits both coasts of tropical Atlantic"/>
<rdf:Description rdf:about="&a;102103567"
	 b:glossaryEntry="viviparous blennies of temperate and tropical seas"/>
<rdf:Description rdf:about="&a;102103747">
	<b:glossaryEntry>mostly small blennioid fishes of coral reefs and seagrass beds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102103895">
	<b:glossaryEntry>a genus of fish of the family Clinidae including pikeblennies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102104089">
	<b:glossaryEntry>tropical American fishes; males are aggressively defensive of their territory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102104260"
	 b:glossaryEntry="found from Florida to Cuba"/>
<rdf:Description rdf:about="&a;102104395"
	 b:glossaryEntry="a family of fish of suborder Blennioidea"/>
<rdf:Description rdf:about="&a;102104585">
	<b:glossaryEntry>small eellike fishes common in shallow waters of the North Atlantic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102104761"
	 b:glossaryEntry="type genus of the Pholidae: gunnels"/>
<rdf:Description rdf:about="&a;102104902">
	<b:glossaryEntry>slippery scaleless food fish of North Atlantic coastal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102105091"
	 b:glossaryEntry="pricklebacks"/>
<rdf:Description rdf:about="&a;102105239">
	<b:glossaryEntry>small elongate fishes of shallow northern seas; a long dorsal fin consists entirely of spines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102105426"
	 b:glossaryEntry="a genus of Stichaeidae"/>
<rdf:Description rdf:about="&a;102105577"
	 b:glossaryEntry="found in Arctic and North Atlantic"/>
<rdf:Description rdf:about="&a;102105715"
	 b:glossaryEntry="eellike fishes found in subarctic coastal waters"/>
<rdf:Description rdf:about="&a;102105838"
	 b:glossaryEntry="a genus of Stichaeidae"/>
<rdf:Description rdf:about="&a;102105984">
	<b:glossaryEntry>eellike Atlantic bottom fish with large almost vertical mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102106159"
	 b:glossaryEntry="wolffishes"/>
<rdf:Description rdf:about="&a;102106292"
	 b:glossaryEntry="type genus of the Anarhichadidae"/>
<rdf:Description rdf:about="&a;102106438">
	<b:glossaryEntry>large ferocious northern deep-sea food fishes with strong teeth and no pelvic fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102106616"
	 b:glossaryEntry="eelpouts"/>
<rdf:Description rdf:about="&a;102106794">
	<b:glossaryEntry>marine eellike mostly bottom-dwelling fishes of northern seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102106989"
	 b:glossaryEntry="type genus of the Zoarcidae"/>
<rdf:Description rdf:about="&a;102107124"
	 b:glossaryEntry="an eelpout of northern Europe that is viviparous"/>
<rdf:Description rdf:about="&a;102107276"
	 b:glossaryEntry="a genus of Zoarcidae"/>
<rdf:Description rdf:about="&a;102107406"
	 b:glossaryEntry="brightly colored scaleless Arctic eelpout"/>
<rdf:Description rdf:about="&a;102107543"
	 b:glossaryEntry="a genus of Zoarcidae"/>
<rdf:Description rdf:about="&a;102107681"
	 b:glossaryEntry="common along northeastern coast of North America"/>
<rdf:Description rdf:about="&a;102107831"
	 b:glossaryEntry="sand lances"/>
<rdf:Description rdf:about="&a;102107959"
	 b:glossaryEntry="type genus of the Ammodytidae"/>
<rdf:Description rdf:about="&a;102108100">
	<b:glossaryEntry>very small silvery eellike schooling fishes that burrow into sandy beaches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102108284"
	 b:glossaryEntry="dragonets"/>
<rdf:Description rdf:about="&a;102108414">
	<b:glossaryEntry>small often brightly colored scaleless marine bottom-dwellers; found in tropical and warm-temperate waters of Europe and America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102108616"
	 b:glossaryEntry="gobies"/>
<rdf:Description rdf:about="&a;102108752">
	<b:glossaryEntry>small spiny-finned fish of coastal or brackish waters having a large head and elongated tapering body having the ventral fins modified as a sucker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102108996"
	 b:glossaryEntry="a genus of Gobiidae"/>
<rdf:Description rdf:about="&a;102109137">
	<b:glossaryEntry>found in tropical coastal regions of Africa and Asia; able to move on land on strong pectoral fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102109325"
	 b:glossaryEntry="sleepers"/>
<rdf:Description rdf:about="&a;102109448">
	<b:glossaryEntry>tropical fish that resembles a goby and rests quietly on the bottom in shallow water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102109620"
	 b:glossaryEntry="percoid flatheads"/>
<rdf:Description rdf:about="&a;102109754">
	<b:glossaryEntry>pallid bottom-dwelling flat-headed fish with large eyes and a duck-like snout</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102109905"
	 b:glossaryEntry="archerfishes"/>
<rdf:Description rdf:about="&a;102110030"
	 b:glossaryEntry="type genus of the Toxotidae"/>
<rdf:Description rdf:about="&a;102110165">
	<b:glossaryEntry>any of several small Indo-Australian freshwater fishes that catch insects by squirting water at them and knocking them into the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102110395"
	 b:glossaryEntry="wormfishes"/>
<rdf:Description rdf:about="&a;102110526">
	<b:glossaryEntry>poorly known family of small tropical shallow-water fishes related to gobies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102110676"
	 b:glossaryEntry="surgeonfishes"/>
<rdf:Description rdf:about="&a;102110827">
	<b:glossaryEntry>brightly colored coral-reef fish with knifelike spines at the tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102110988"
	 b:glossaryEntry="type genus of the Acanthuridae: doctorfishes"/>
<rdf:Description rdf:about="&a;102111146"
	 b:glossaryEntry="surgeon fish of the West Indies"/>
<rdf:Description rdf:about="&a;102111276"
	 b:glossaryEntry="snake mackerels"/>
<rdf:Description rdf:about="&a;102111463">
	<b:glossaryEntry>snake mackerels; elongated oily-fleshed marine fishes resembling mackerels; found worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102111682"
	 b:glossaryEntry="type genus of the Gempylidae"/>
<rdf:Description rdf:about="&a;102111801"
	 b:glossaryEntry="predatory tropical fishes with jutting jaws and strong teeth"/>
<rdf:Description rdf:about="&a;102111960"
	 b:glossaryEntry="a genus of Gempylidae"/>
<rdf:Description rdf:about="&a;102112099">
	<b:glossaryEntry>large snake mackerel with rings like spectacles around its eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102112264"
	 b:glossaryEntry="very large deep-water snake mackerel"/>
<rdf:Description rdf:about="&a;102112375"
	 b:glossaryEntry="cutlassfishes"/>
<rdf:Description rdf:about="&a;102112507">
	<b:glossaryEntry>long-bodied marine fishes having a long whiplike scaleless body and sharp teeth; closely related to snake_mackerel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102112722">
	<b:glossaryEntry>mackerels; tunas; albacores; bonitos; swordfishes; sailfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102112997">
	<b:glossaryEntry>important marine food and game fishes found in all tropical and temperate seas; some are at least partially endothermic and can thrive in colder waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102113420"
	 b:glossaryEntry="marine food fishes: mackerels; chub mackerels; tuna"/>
<rdf:Description rdf:about="&a;102113719"
	 b:glossaryEntry="any of various fishes of the family Scombridae"/>
<rdf:Description rdf:about="&a;102113929"
	 b:glossaryEntry="type genus of the Scombridae"/>
<rdf:Description rdf:about="&a;102114103">
	<b:glossaryEntry>important food fish of the North Atlantic and Mediterranean; its body is greenish-blue with dark bars and small if any scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102114356">
	<b:glossaryEntry>medium-sized mackerel of temperate Atlantic and Gulf of Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102114536"
	 b:glossaryEntry="small mackerel found nearly worldwide"/>
<rdf:Description rdf:about="&a;102114681"
	 b:glossaryEntry="wahoos"/>
<rdf:Description rdf:about="&a;102114807">
	<b:glossaryEntry>large fast-moving predacious food and game fish; found worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102114967"
	 b:glossaryEntry="Spanish mackerels"/>
<rdf:Description rdf:about="&a;102115161">
	<b:glossaryEntry>any of several large marine food fishes of the genus Scomberomorus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102115400">
	<b:glossaryEntry>large mackerel with long pointed snout; important food and game fish of the eastern Atlantic coast south to Brazil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102115634">
	<b:glossaryEntry>large commercially important mackerel of American Atlantic coastal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102115796">
	<b:glossaryEntry>large edible mackerel of temperate United States coastal Atlantic waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102116002"
	 b:glossaryEntry="a Spanish mackerel of western North America"/>
<rdf:Description rdf:about="&a;102116121"
	 b:glossaryEntry="tunas: warm-blooded fishes"/>
<rdf:Description rdf:about="&a;102116293">
	<b:glossaryEntry>any very large marine food and game fish of the genus Thunnus; related to mackerel; chiefly of warm waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102116568">
	<b:glossaryEntry>large pelagic tuna the source of most canned tuna; reaches 93 pounds and has long pectoral fins; found worldwide in tropical and temperate waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102116823">
	<b:glossaryEntry>largest tuna; to 1500 pounds; of mostly temperate seas: feed in polar regions but breed in tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102117064"
	 b:glossaryEntry="may reach 400 pounds; worldwide in tropics"/>
<rdf:Description rdf:about="&a;102117218"
	 b:glossaryEntry="bonitos"/>
<rdf:Description rdf:about="&a;102117386">
	<b:glossaryEntry>any of various scombroid fishes intermediate in size and characteristics between mackerels and tunas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102117631">
	<b:glossaryEntry>medium-sized tuna-like food fish of warm Atlantic and Pacific waters; less valued than tuna</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102117828">
	<b:glossaryEntry>common bonito of Pacific coast of the Americas; its dark oily flesh cans well</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102118019"
	 b:glossaryEntry="probably a northern strain of Chile bonito"/>
<rdf:Description rdf:about="&a;102118159"
	 b:glossaryEntry="a genus of Scombridae"/>
<rdf:Description rdf:about="&a;102118292">
	<b:glossaryEntry>oceanic schooling tuna of considerable value in Pacific but less in Atlantic; reaches 75 pounds; very similar to if not the same as oceanic bonito</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102118548">
	<b:glossaryEntry>oceanic bonitos; in some classifications placed in its own family Katsuwonidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102118740">
	<b:glossaryEntry>in some classifications considered a separate family comprising the oceanic bonitos</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102118922">
	<b:glossaryEntry>fish whose flesh is dried and flaked for Japanese cookery; may be same species as skipjack tuna</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102119127"
	 b:glossaryEntry="comprising the common swordfishes"/>
<rdf:Description rdf:about="&a;102119273"
	 b:glossaryEntry="type genus of the Xiphiidae"/>
<rdf:Description rdf:about="&a;102119408">
	<b:glossaryEntry>large toothless marine food fish with a long swordlike upper jaw; not completely cold-blooded i.e. they are able to warm their brains and eyes: worldwide in warm waters but feed on cold ocean floor coming to surface at night</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102119744"
	 b:glossaryEntry="sailfishes; spearfishes; marlins"/>
<rdf:Description rdf:about="&a;102119973">
	<b:glossaryEntry>large pelagic game fish having an elongated upper jaw and long sail-like dorsal fin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102120148"
	 b:glossaryEntry="type genus of the Istiophoridae"/>
<rdf:Description rdf:about="&a;102120295"
	 b:glossaryEntry="a kind of sailfish"/>
<rdf:Description rdf:about="&a;102120419">
	<b:glossaryEntry>giant warm-water game fish having a prolonged and rounded toothless upper jaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102120606"
	 b:glossaryEntry="marlins"/>
<rdf:Description rdf:about="&a;102120721">
	<b:glossaryEntry>large long-jawed oceanic sport fishes; related to sailfishes and spearfishes; not completely cold-blooded i.e. able to warm their brains and eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102121040">
	<b:glossaryEntry>largest marlin; may reach 2000 pounds; found worldwide in warm seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102121185"
	 b:glossaryEntry="Pacific marlin"/>
<rdf:Description rdf:about="&a;102121275"
	 b:glossaryEntry="Pacific marlin"/>
<rdf:Description rdf:about="&a;102121366">
	<b:glossaryEntry>Pacific food and game fish marked with dark blue vertical stripes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102121513"
	 b:glossaryEntry="small marlin (to 180 pounds) of western Atlantic"/>
<rdf:Description rdf:about="&a;102121637"
	 b:glossaryEntry="a genus of Istiophoridae"/>
<rdf:Description rdf:about="&a;102121777">
	<b:glossaryEntry>any of several large vigorous pelagic fishes resembling sailfishes but with first dorsal fin much reduced; worldwide but rare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102121977"
	 b:glossaryEntry="louvars"/>
<rdf:Description rdf:about="&a;102122097"
	 b:glossaryEntry="type genus of the Luvaridae"/>
<rdf:Description rdf:about="&a;102122232">
	<b:glossaryEntry>large silvery fish found worldwide in warm seas but nowhere common; resembles a whale and feeds on plankton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102122432"
	 b:glossaryEntry="butterfishes: harvest fishes; dollar fishes"/>
<rdf:Description rdf:about="&a;102122727">
	<b:glossaryEntry>small marine fish with a short smooth-scaled compressed body and feeble spines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102123039"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102123174"
	 b:glossaryEntry="small food fish of Atlantic coast"/>
<rdf:Description rdf:about="&a;102123307"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102123429"
	 b:glossaryEntry="smaller than Florida pompano; common in West Indies"/>
<rdf:Description rdf:about="&a;102123596"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102123729">
	<b:glossaryEntry>butterfish up to a foot long of Atlantic waters from Chesapeake Bay to Argentina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102123908"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102124037"
	 b:glossaryEntry="small (6 inches) tropical butterfishes found worldwide"/>
<rdf:Description rdf:about="&a;102124166"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102124297">
	<b:glossaryEntry>larger driftfishes of eastern Atlantic from NY area to northern Gulf of Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102124450"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102124591">
	<b:glossaryEntry>sluggish square-tailed fish armored with tough bony scales; of deep warm waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102124746"
	 b:glossaryEntry="a genus of Stromateidae"/>
<rdf:Description rdf:about="&a;102124887"
	 b:glossaryEntry="blackish fish of New England waters"/>
<rdf:Description rdf:about="&a;102125043"
	 b:glossaryEntry="clingfishes"/>
<rdf:Description rdf:about="&a;102125192"
	 b:glossaryEntry="type genus of the Gobiesocidae"/>
<rdf:Description rdf:about="&a;102125313">
	<b:glossaryEntry>very small (to 3 inches) flattened marine fish with a sucking disc on the abdomen for clinging to rocks etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102125514"
	 b:glossaryEntry="clingfish with typical skillet shape"/>
<rdf:Description rdf:about="&a;102125629"
	 b:glossaryEntry="tripletails"/>
<rdf:Description rdf:about="&a;102125753"
	 b:glossaryEntry="type genus of the Lobotidae"/>
<rdf:Description rdf:about="&a;102125888">
	<b:glossaryEntry>large food fish of warm waters worldwide having long anal and dorsal fins that with caudal fin suggest a three-lobed tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102126121"
	 b:glossaryEntry="tripletail found from Cape Cod to northern South America"/>
<rdf:Description rdf:about="&a;102126266"
	 b:glossaryEntry="tripletail found in the Pacific"/>
<rdf:Description rdf:about="&a;102126382"
	 b:glossaryEntry="mojarras"/>
<rdf:Description rdf:about="&a;102126570">
	<b:glossaryEntry>small silvery schooling fishes with protrusible mouths found in warm coastal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102126762"
	 b:glossaryEntry="type genus of the Gerreidae"/>
<rdf:Description rdf:about="&a;102126895"
	 b:glossaryEntry="popular panfish from Bermuda and Gulf of Mexico to Brazil"/>
<rdf:Description rdf:about="&a;102127053"
	 b:glossaryEntry="a genus of Gerreidae"/>
<rdf:Description rdf:about="&a;102127191">
	<b:glossaryEntry>silvery mojarra found along sandy shores of the western Atlantic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102127353">
	<b:glossaryEntry>small family of small food fishes of shallow Indo-Pacific waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102127536"
	 b:glossaryEntry="type genus of the Sillaginidae"/>
<rdf:Description rdf:about="&a;102127674"
	 b:glossaryEntry="a small fish of the genus Sillago; excellent food fish"/>
<rdf:Description rdf:about="&a;102127801">
	<b:glossaryEntry>shiny substance that resemble enamel and is secreted by the corium of certain fishes (especially ganoid_fishes) and composes the outer layer of their scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102128020">
	<b:glossaryEntry>a group of mostly extinct primitive bony fishes characterized by armor-like bony scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102128293">
	<b:glossaryEntry>primitive fishes having thick bony scales with a shiny covering</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102128532"
	 b:glossaryEntry="only the bowfins"/>
<rdf:Description rdf:about="&a;102128657"
	 b:glossaryEntry="type genus of the Amiidae"/>
<rdf:Description rdf:about="&a;102128784">
	<b:glossaryEntry>primitive long-bodies carnivorous freshwater fish with a very long dorsal fin; found in sluggish waters of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102129009"
	 b:glossaryEntry="paddlefishes"/>
