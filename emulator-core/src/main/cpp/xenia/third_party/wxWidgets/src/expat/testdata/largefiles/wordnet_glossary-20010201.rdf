	<b:glossaryEntry>a colorless liquid hydrocarbon; highly inflammable; carcinogenic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110594214">
	<b:glossaryEntry>a closed chain of 6 carbon atoms with hydrogen atoms attached</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110594387"
	 b:glossaryEntry="any salt or ester of benzoic acid"/>
<rdf:Description rdf:about="&a;110594493">
	<b:glossaryEntry>a white crystalline salt used as a food preservative and antiseptic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110594641"
	 b:glossaryEntry="a white crystalline solid occurring in many resins"/>
<rdf:Description rdf:about="&a;110594750">
	<b:glossaryEntry>a white crystalline peroxide used in bleaching (flour or oils or fats) and as a catalyst for free radical reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110594946"
	 b:glossaryEntry="a copper-base alloy containing beryllium"/>
<rdf:Description rdf:about="&a;110595049">
	<b:glossaryEntry>a salt of carbonic acid in which one hydrogen atom has been replaced; an acid carbonate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110595215">
	<b:glossaryEntry>a white soluble compound used in effervescent drinks and in baking powders and as an antacid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110595420">
	<b:glossaryEntry>material made by bonding together sheets of two different metals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110595538"
	 b:glossaryEntry="a cardboard used by bookbinders to make covers for books"/>
