	 b:glossaryEntry="the second compartment of the stomach of a ruminant"/>
<rdf:Description rdf:about="&a;101896973"
	 b:glossaryEntry="the third compartment of the stomach of a ruminant"/>
<rdf:Description rdf:about="&a;101897124">
