	 b:glossaryEntry="bittercress, bitter_cress"/>
<rdf:Description rdf:about="&a;108189420">
	<b:glossaryEntry>usually included in genus Cardamine; in some classifications considered a separate genus</b:glossaryEntry>
</rdf:Description>
