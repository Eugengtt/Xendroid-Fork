<rdf:Description rdf:about="&a;200987038"
	 b:glossaryEntry="capture again, as of an escaped prisoner"/>
<rdf:Description rdf:about="&a;200987154">
	<b:glossaryEntry>to grasp hastily or eagerly; "Before I could stop him the dog snatched the ham bone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200987365"
	 b:glossaryEntry="seize or catch with a swooping motion"/>
