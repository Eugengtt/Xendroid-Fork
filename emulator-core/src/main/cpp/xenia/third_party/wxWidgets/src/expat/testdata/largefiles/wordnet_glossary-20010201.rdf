</rdf:Description>
<rdf:Description rdf:about="&a;102013810"
	 b:glossaryEntry="type genus of the Ariidae: sea catfishes"/>
<rdf:Description rdf:about="&a;102013954"
	 b:glossaryEntry="catfish of the Caribbean area"/>
<rdf:Description rdf:about="&a;102014062">
	<b:glossaryEntry>cods, haddocks, grenadiers; in some classifications considered equivalent to the order Anacanthini</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102014293">
	<b:glossaryEntry>at least partially equivalent to the order Gadiformes in some classifications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102014467"
	 b:glossaryEntry="a soft-finned fish of the family Gadidae"/>
