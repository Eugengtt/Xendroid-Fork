</rdf:Description>
<rdf:Description rdf:about="&a;101119553"
	 b:glossaryEntry="tanagers"/>
<rdf:Description rdf:about="&a;101119695">
	<b:glossaryEntry>any of numerous New World woodland birds having brightly colored males</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101119910"
	 b:glossaryEntry="a genus of Thraupidae"/>
<rdf:Description rdf:about="&a;101120096"
	 b:glossaryEntry="the male is bright red with black wings and tail"/>
<rdf:Description rdf:about="&a;101120265">
	<b:glossaryEntry>of western North America; male is black and yellow and orange-red</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101120433">
	<b:glossaryEntry>of middle and southern United States; male is deep rose-red the female mostly yellow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101120630"
	 b:glossaryEntry="common tanager of southwestern United States and Mexico"/>
<rdf:Description rdf:about="&a;101120791"
	 b:glossaryEntry="shrikes"/>
<rdf:Description rdf:about="&a;101120947">
	<b:glossaryEntry>any of numerous Old World birds having a strong hooked bill that feed on smaller animals</b:glossaryEntry>
</rdf:Description>
