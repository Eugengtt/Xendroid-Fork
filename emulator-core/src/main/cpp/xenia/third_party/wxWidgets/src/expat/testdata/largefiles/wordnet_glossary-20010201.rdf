	 b:glossaryEntry='cause to move forward with force; "Steam propels this ship"'/>
<rdf:Description rdf:about="&a;201038864"
	 b:glossaryEntry='push or propel; "Drive the cows into the stable"'/>
<rdf:Description rdf:about="&a;201038983"
	 b:glossaryEntry='throw with force or recklessness; "fling the frisbee"'/>
<rdf:Description rdf:about="&a;201039125">
