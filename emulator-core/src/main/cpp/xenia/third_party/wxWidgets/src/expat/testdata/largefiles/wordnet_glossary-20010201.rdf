	 b:glossaryEntry="type genus of the Salviniaceae: water ferns"/>
<rdf:Description rdf:about="&a;109255496"
	 b:glossaryEntry="free-floating aquatic ferns"/>
<rdf:Description rdf:about="&a;109255648"
	 b:glossaryEntry="used in some classifications for the genus Azolla"/>
<rdf:Description rdf:about="&a;109255793">
