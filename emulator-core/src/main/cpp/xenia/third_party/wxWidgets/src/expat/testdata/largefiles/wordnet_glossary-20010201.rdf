</rdf:Description>
<rdf:Description rdf:about="&a;200761183">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fight a duel, as over one''s honor or a woman; "In the 19th century, men often dueled over small matters"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200761357">
