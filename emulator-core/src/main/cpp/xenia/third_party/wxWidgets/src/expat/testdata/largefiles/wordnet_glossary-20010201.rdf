	<b:glossaryEntry xml:space='preserve'><![CDATA[lay eggs; of female animals; "This hen doesn''t lay"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201063497"
	 b:glossaryEntry="lay eggs; of certain insects"/>
<rdf:Description rdf:about="&a;201063587">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sit on one''s heels; "In some cultures, the women give birth while squatting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201063788">
	<b:glossaryEntry xml:space='preserve'><![CDATA[rest one''s weight on one''s knees; "In church you have to kneel during parts of the service"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201063950"
	 b:glossaryEntry="not move; be in a resting position"/>
<rdf:Description rdf:about="&a;201064160">
	<b:glossaryEntry>be standing; be upright; "We had to stand for the entire performance!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201064454"
	 b:glossaryEntry="stand with arms or forelegs raised, as if menacing"/>
<rdf:Description rdf:about="&a;201064574">
	<b:glossaryEntry>stand away from an object or person; "He stood back to look at her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201064709">
	<b:glossaryEntry>put into an upright position; "Can you stand the bookshelf up?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201064888">
	<b:glossaryEntry>be lying, be prostrate; be in a horizontal position; "The sick man lay in bed all day"l "the books are lying on the shelf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201065170"
	 b:glossaryEntry="assume a resting position, as on a flat surface"/>
<rdf:Description rdf:about="&a;201065358">
	<b:glossaryEntry>lie in a comfortable resting position; "He was reposing on the couch"</b:glossaryEntry>
</rdf:Description>
