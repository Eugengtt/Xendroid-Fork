	 b:glossaryEntry="the charter given to English barons by King John in 1215"/>
<rdf:Description rdf:about="&a;104863303"
	 b:glossaryEntry="a charter authorizing the operation of a bank"/>
<rdf:Description rdf:about="&a;104863407">
	<b:glossaryEntry>a card certifying the identity of the bearer; "he had to show his card to get in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104863627"
	 b:glossaryEntry="a card certifying membership in an organization"/>
<rdf:Description rdf:about="&a;104863754"
	 b:glossaryEntry="a card certifying membership in a labor union"/>
<rdf:Description rdf:about="&a;104863856"
	 b:glossaryEntry="a card certifying the bearer''s right to use the library"/>
<rdf:Description rdf:about="&a;104863988">
	<b:glossaryEntry>a card certifying the bearer''s right to purchase rationed goods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104864109">
	<b:glossaryEntry>a copy of the official document giving details of a person''s birth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104864239">
	<b:glossaryEntry>a document certifying the successful completion of a course of study</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104864373">
	<b:glossaryEntry>an official document issued by a government and conferring on the recipient the rank of an officer in the armed forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104864570"
	 b:glossaryEntry="a certificate saying that a ship''s company was healthy"/>
<rdf:Description rdf:about="&a;104864685">
	<b:glossaryEntry>a certificate saying that the holder is qualified to teach in the public schools</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104864856">
	<b:glossaryEntry>a document that states some contractual relationship or grants some right</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104865636">
	<b:glossaryEntry>a financial instrument whose value is based on another security</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104865816">
	<b:glossaryEntry>an agreement to buy or sell a specific amount of a commodity or financial instrument at a particular price on a stipulated future date; the contract can be sold before the settlement date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104866084">
	<b:glossaryEntry>a futures contract based on a stock index; a bet on the future price of the indexed group of stocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104866249"
	 b:glossaryEntry="an unconditional order or promise to pay an amount of money"/>
<rdf:Description rdf:about="&a;104866394">
	<b:glossaryEntry>a database containing an ordered array of items (names or topics)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104867079">
	<b:glossaryEntry>a distinct part that can be specified separately in a group of things that could be enumerated on a list; "he noticed an item in the New York Times"; "she had several items on her shopping list"; "the main point on the agenda was taken up first"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104867510"
	 b:glossaryEntry="one of the items to be considered"/>
<rdf:Description rdf:about="&a;104867620"
	 b:glossaryEntry="an item that is incidental"/>
<rdf:Description rdf:about="&a;104867703"
	 b:glossaryEntry="an item listed in an inventory"/>
<rdf:Description rdf:about="&a;104867813">
	<b:glossaryEntry>an item in an appropriation bill; "Some governors can veto line items in their state budgets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104867981"
	 b:glossaryEntry="an item in a newspaper"/>
<rdf:Description rdf:about="&a;104868096">
	<b:glossaryEntry>an item on a list or in a sequence; "in the second place"; "moved from third to fifth position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104868272">
	<b:glossaryEntry>the placing of a modifier after the word that it modifies in a sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104868402"
	 b:glossaryEntry="a brief (usually one sentence and usually trivial) news item"/>
<rdf:Description rdf:about="&a;104868516">
	<b:glossaryEntry>something resembling a fact; unverified (often invented) information that is given credibility because it appeared in print</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104868693"
	 b:glossaryEntry="a document written on papyrus"/>
<rdf:Description rdf:about="&a;104868776"
	 b:glossaryEntry="a list of matters to be taken up (as at a meeting)"/>
