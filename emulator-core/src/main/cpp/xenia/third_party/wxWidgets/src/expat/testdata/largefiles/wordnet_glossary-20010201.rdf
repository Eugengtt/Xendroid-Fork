	<b:glossaryEntry>a polymer (or a molecule of a polymer) consisting of three identical monomers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110818400"
	 b:glossaryEntry="an oxide containing three atoms of oxygen in the molecule"/>
