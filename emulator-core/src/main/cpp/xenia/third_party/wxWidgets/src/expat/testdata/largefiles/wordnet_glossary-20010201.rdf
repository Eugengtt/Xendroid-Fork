</rdf:Description>
<rdf:Description rdf:about="&a;110756072"
	 b:glossaryEntry="a dye or tint for the hair"/>
<rdf:Description rdf:about="&a;110756205"
	 b:glossaryEntry="a reddish coloring material found in some algae"/>
<rdf:Description rdf:about="&a;110756311"
	 b:glossaryEntry="a reddish brown dye used especially on hair"/>
<rdf:Description rdf:about="&a;110756406"
	 b:glossaryEntry="a liquid preparation used on wet hair to it a tint"/>
