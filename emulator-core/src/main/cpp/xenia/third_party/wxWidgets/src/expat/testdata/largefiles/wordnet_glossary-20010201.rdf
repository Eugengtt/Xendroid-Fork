	 b:glossaryEntry="a plant of the genus Valerianella"/>
<rdf:Description rdf:about="&a;109247252"
	 b:glossaryEntry="widely cultivated as a salad crop and pot herb; often a weed"/>
<rdf:Description rdf:about="&a;109247440"
	 b:glossaryEntry="genus of southern European herbs and subshrubs"/>
<rdf:Description rdf:about="&a;109247602">
	<b:glossaryEntry>European herb with small fragrant crimson or white spurred flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109247787">
	<b:glossaryEntry>tannin extract derived from any of several mangrove barks of Pacific areas</b:glossaryEntry>
</rdf:Description>
