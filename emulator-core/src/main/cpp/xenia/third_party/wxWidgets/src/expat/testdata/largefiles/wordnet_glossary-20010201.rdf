</rdf:Description>
<rdf:Description rdf:about="&a;400257643"
	 b:glossaryEntry='in an amicable manner; "they separated amicably"'/>
<rdf:Description rdf:about="&a;400257746"
	 b:glossaryEntry='without giving a name; "she wrote these letters anonymously"'/>
<rdf:Description rdf:about="&a;400257864"
	 b:glossaryEntry='below cost; "sold the car at a loss"'/>
<rdf:Description rdf:about="&a;400257938">
	<b:glossaryEntry xml:space='preserve'><![CDATA[comparing quantity or quality; "by the time she was 4 she was more than half her father''s height"]]></b:glossaryEntry>
</rdf:Description>
