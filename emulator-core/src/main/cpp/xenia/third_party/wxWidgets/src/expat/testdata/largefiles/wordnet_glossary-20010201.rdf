</rdf:Description>
<rdf:Description rdf:about="&a;108225277">
	<b:glossaryEntry>annual to perennial herbs or shrubs of eastern United States and Central and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108225479">
