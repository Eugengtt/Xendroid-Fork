<rdf:Description rdf:about="&a;101236311"
	 b:glossaryEntry="lightly built medium-size theropods"/>
<rdf:Description rdf:about="&a;101236507">
	<b:glossaryEntry>lightly built medium-sized dinosaur having extremely long limbs and necks with small heads and big brains and large eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101236741">
	<b:glossaryEntry>small toothless saurischian dinosaurs; upper Cretaceous of Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101236910">
	<b:glossaryEntry>small light-boned toothless dinosaur resembling an ostrich in size and proportions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101237071"
	 b:glossaryEntry="a reptile genus of Ornithomimida"/>
<rdf:Description rdf:about="&a;101237206"
	 b:glossaryEntry="lightly built medium-sized theropod with long limbs and neck"/>
<rdf:Description rdf:about="&a;101237344">
	<b:glossaryEntry>advanced theropods including oviraptorids and dromaeosaurs and possibly even modern birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101237628"
	 b:glossaryEntry="advanced carnivorous theropod"/>
<rdf:Description rdf:about="&a;101237841"
	 b:glossaryEntry="advanced carnivorous theropod"/>
<rdf:Description rdf:about="&a;101237947"
	 b:glossaryEntry="advanced carnivorous theropod"/>
<rdf:Description rdf:about="&a;101238079">
	<b:glossaryEntry>small active carnivore that probably fed on protoceratops; possibly related more closely to birds than to other dinosaurs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101238278"
	 b:glossaryEntry="swift-running bipedal dinosaurs"/>
<rdf:Description rdf:about="&a;101238472"
	 b:glossaryEntry="a kind of maniraptor"/>
<rdf:Description rdf:about="&a;101238569"
	 b:glossaryEntry="advanced bipedal carnivorous dinosaur"/>
<rdf:Description rdf:about="&a;101238708">
	<b:glossaryEntry>swift agile wolf-sized bipedal dinosaur having a large curved claw on each hind foot; of the Cretaceous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101238888"
	 b:glossaryEntry="advanced bipedal carnivorous dinosaur"/>
<rdf:Description rdf:about="&a;101239026">
	<b:glossaryEntry>large (20-ft) and swift carnivorous dinosaur having an upright 15-in slashing claw on each hind foot; early Cretaceous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101239235">
	<b:glossaryEntry>authorities disagree over whether to classify the genus as bird or dinosaur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101239411">
	<b:glossaryEntry>75-million-year-old turkey-sized long-legged fossil found in the Gobi Desert of Mongolia having birdlike fused wrist bones and keeled breastbone and a long tail resembling a dinosaur''s; short 3-inch-long forelimbs end in a single claw instead of wings; classification as bird or dinosaur is in dispute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101239798">
	<b:glossaryEntry>extinct reptiles of the Permian to Jurassic considered ancestral to mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101240026">
	<b:glossaryEntry>extinct reptile having a single pair of lateral temporal openings in the skull</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101240268">
	<b:glossaryEntry>extinct mammal-like reptiles found inhabiting all continents from the mid Permian to late Triassic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101240537"
	 b:glossaryEntry="probably warm-blooded; considered direct ancestor of mammals"/>
<rdf:Description rdf:about="&a;101240740"
	 b:glossaryEntry="a reptile genus of Therapsida"/>
<rdf:Description rdf:about="&a;101240889">
	<b:glossaryEntry>shrew-sized protomammal from the Alberta Canada region; of about 55 million years ago (much more recent than other mammal-like reptiles)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101241114">
	<b:glossaryEntry>a division of Triassic Therapsida comprising small carnivorous tetrapod reptiles often with mammal-like teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101241359"
	 b:glossaryEntry="small carnivorous reptiles"/>
<rdf:Description rdf:about="&a;101241459"
	 b:glossaryEntry="a genus of reptiles of the division Cynodontia"/>
<rdf:Description rdf:about="&a;101241602"
	 b:glossaryEntry="a division of Therapsida"/>
<rdf:Description rdf:about="&a;101241766"
	 b:glossaryEntry="a kind of therapsid"/>
<rdf:Description rdf:about="&a;101241861"
	 b:glossaryEntry="early reptile found in Argentina"/>
<rdf:Description rdf:about="&a;101241996"
	 b:glossaryEntry="extinct reptiles of the Upper Triassic"/>
<rdf:Description rdf:about="&a;101242152">
	<b:glossaryEntry>intermediate in form between the therapsids and most primitive true mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101242303"
	 b:glossaryEntry="edaphosaurus; dimetrodon"/>
<rdf:Description rdf:about="&a;101242483">
	<b:glossaryEntry>large primitive reptile having a tall spinal sail; of the Permian or late Paleozoic in Europe and North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101242670"
	 b:glossaryEntry="a family of reptiles of the order Pelycosauria"/>
<rdf:Description rdf:about="&a;101242839"
	 b:glossaryEntry="type genus of the Edaphosauridae"/>
<rdf:Description rdf:about="&a;101242974">
	<b:glossaryEntry>heavy-bodied reptile with a dorsal sail or crest; of the late Paleozoic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101243123"
	 b:glossaryEntry="a reptile genus of Pelycosauria"/>
<rdf:Description rdf:about="&a;101243255">
	<b:glossaryEntry>carnivorous dinosaur of the Permian in North America having a crest or dorsal sail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101243413"
	 b:glossaryEntry="extinct flying reptiles: pterosaurs"/>
<rdf:Description rdf:about="&a;101243583">
	<b:glossaryEntry>extinct flying reptile of the Jurassic and Cretaceous having a birdlike beak and membranous wings supported by the very long fourth digit of each forelimb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101243847"
	 b:glossaryEntry="a reptile family in the order Pterosauria"/>
<rdf:Description rdf:about="&a;101244013"
	 b:glossaryEntry="a reptile genus of Pterodactylidae"/>
<rdf:Description rdf:about="&a;101244167"
	 b:glossaryEntry="extinct flying reptile"/>
<rdf:Description rdf:about="&a;101244266">
	<b:glossaryEntry>extinct terrestrial reptiles having teeth set in sockets; of the late Permian to Triassic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101244471">
	<b:glossaryEntry>presumably in the common ancestral line to dinosaurs and crocodiles and birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101244643"
	 b:glossaryEntry="extinct marine reptiles: ichthyosaurs"/>
<rdf:Description rdf:about="&a;101244819">
	<b:glossaryEntry>any of several marine reptiles of the Mesozoic having a body like a porpoise with dorsal and tail fins and paddle-shaped limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101245058">
	<b:glossaryEntry>later ichthyosaurs of the Jurassic and Cretaceous; widely distributed in both hemispheres</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101245291"
	 b:glossaryEntry="type genus of the Ichthyosauridae"/>
<rdf:Description rdf:about="&a;101245428"
	 b:glossaryEntry="ichthyosaurs of the Jurassic"/>
<rdf:Description rdf:about="&a;101245535"
	 b:glossaryEntry="a reptile genus of Ichthyosauridae"/>
<rdf:Description rdf:about="&a;101245674"
	 b:glossaryEntry="an ichthyosaur of the genus Stenopterygius"/>
<rdf:Description rdf:about="&a;101245828"
	 b:glossaryEntry="extinct marine reptiles: plesiosaurs; nothosaurs"/>
<rdf:Description rdf:about="&a;101246015"
	 b:glossaryEntry="any of the plesiosaurs"/>
<rdf:Description rdf:about="&a;101246158"
	 b:glossaryEntry="a reptile genus of suborder Plesiosauria"/>
<rdf:Description rdf:about="&a;101246301">
	<b:glossaryEntry>extinct marine reptile with a small head on a long neck a short tail and four paddle-shaped limbs; of the Jurassic and Cretaceous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101246521"
	 b:glossaryEntry="a suborder of Sauropterygia"/>
<rdf:Description rdf:about="&a;101246667"
	 b:glossaryEntry="a genus of Nothosauria"/>
<rdf:Description rdf:about="&a;101246791">
	<b:glossaryEntry>extinct marine reptile with longer more slender limbs than plesiosaurs and less completely modified for swimming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101246978"
	 b:glossaryEntry="snakes"/>
<rdf:Description rdf:about="&a;101247280"
	 b:glossaryEntry="limbless scaly elongate reptile; some are venomous"/>
<rdf:Description rdf:about="&a;101247530"
	 b:glossaryEntry="nonvenomous snakes; about two-thirds of all living species"/>
<rdf:Description rdf:about="&a;101248216">
	<b:glossaryEntry>mostly harmless temperate-to-tropical terrestrial or arboreal or aquatic snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101248836">
	<b:glossaryEntry>any of various harmless North American snakes that were formerly believed to take tail in mouth and roll along like a hoop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101249015"
	 b:glossaryEntry="thunder snake"/>
<rdf:Description rdf:about="&a;101249142"
	 b:glossaryEntry="small reddish wormlike snake of eastern United States"/>
<rdf:Description rdf:about="&a;101249308">
	<b:glossaryEntry>a genus of reptiles of the family Colubridae including ringneck snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101249490">
	<b:glossaryEntry>any of numerous small nonvenomous North American snakes with a yellow or orange ring around the neck</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101249703">
	<b:glossaryEntry>a genus of small colubrid snakes containing the North American hognose snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101249892">
	<b:glossaryEntry>harmless North American snake with upturned nose; may spread its head and neck or play dead when disturbed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101250103"
	 b:glossaryEntry="leaf-nosed snakes"/>
<rdf:Description rdf:about="&a;101250242">
	<b:glossaryEntry>any of various pale blotched snakes with a blunt snout of southwestern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101250408"
	 b:glossaryEntry="North American green snakes"/>
<rdf:Description rdf:about="&a;101250547"
	 b:glossaryEntry="either of two N. American chiefly insectivorous green snakes"/>
<rdf:Description rdf:about="&a;101250734"
	 b:glossaryEntry="of western and central United States"/>
<rdf:Description rdf:about="&a;101250856"
	 b:glossaryEntry="of southern and eastern United States"/>
<rdf:Description rdf:about="&a;101250978"
	 b:glossaryEntry="African green snakes"/>
<rdf:Description rdf:about="&a;101251112"
	 b:glossaryEntry="any of numerous African green snakes"/>
<rdf:Description rdf:about="&a;101251225"
	 b:glossaryEntry="racers"/>
<rdf:Description rdf:about="&a;101251358"
	 b:glossaryEntry="slender fast-moving North American snakes"/>
<rdf:Description rdf:about="&a;101251506">
	<b:glossaryEntry>blackish racer of the eastern United States that grows to six feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101251683"
	 b:glossaryEntry="bluish-green blacksnake found from Ohio to Texas"/>
<rdf:Description rdf:about="&a;101251823"
	 b:glossaryEntry="slender fast-moving Eurasian snake"/>
<rdf:Description rdf:about="&a;101251964"
	 b:glossaryEntry="whipsnakes"/>
<rdf:Description rdf:about="&a;101252090">
	<b:glossaryEntry>any of several fast-moving North American snakes with long whiplike tails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101252305">
	<b:glossaryEntry>a whipsnake of southern United States and Mexico; tail resembles a braided whip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101252482"
	 b:glossaryEntry="a whipsnake of scrublands and rocky hillsides"/>
<rdf:Description rdf:about="&a;101252634">
	<b:glossaryEntry>both terrestrial and arboreal snake of United States southwest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101252785">
	<b:glossaryEntry>any of various nonvenomous rodent-eating snakes of North America and Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101252986"
	 b:glossaryEntry="North American rat snakes"/>
<rdf:Description rdf:about="&a;101253155">
	<b:glossaryEntry>large harmless snake of southeastern United States; often on farms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101253330"
	 b:glossaryEntry="large harmless shiny black North American snake"/>
<rdf:Description rdf:about="&a;101253530"
	 b:glossaryEntry="large North American snake"/>
<rdf:Description rdf:about="&a;101253635"
	 b:glossaryEntry="Asian rat snakes"/>
<rdf:Description rdf:about="&a;101253755"
	 b:glossaryEntry="enter buildings in pursuit of prey"/>
<rdf:Description rdf:about="&a;101253887"
	 b:glossaryEntry="glossy snake"/>
<rdf:Description rdf:about="&a;101254007">
	<b:glossaryEntry>nocturnal burrowing snake of western United States with shiny tan scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101254175"
	 b:glossaryEntry="bull snakes"/>
<rdf:Description rdf:about="&a;101254298">
	<b:glossaryEntry>any of several large harmless rodent-eating North American burrowing snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101254497">
	<b:glossaryEntry>bull snake of western North America that invades rodent burrows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101254644">
	<b:glossaryEntry>any of several bull snakes of eastern and southeastern United States found chiefly in pine woods; now threatened</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101254813"
	 b:glossaryEntry="king snakes and milk snakes"/>
<rdf:Description rdf:about="&a;101254958">
	<b:glossaryEntry>any of numerous nonvenomous North American constrictors; feed on other snakes and small mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101255177">
	<b:glossaryEntry>widespread in United States except northern regions; black or brown with yellow bands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101255348">
	<b:glossaryEntry>nonvenomous tan and brown king snake with an arrow-shaped occipital spot; southeastern ones have red stripes like coral snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101255602"
	 b:glossaryEntry="garter snakes"/>
<rdf:Description rdf:about="&a;101255729">
	<b:glossaryEntry>any of numerous nonvenomous longitudinally-striped viviparous North and Central American snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101255970"
	 b:glossaryEntry="widespread in North America"/>
<rdf:Description rdf:about="&a;101256085">
	<b:glossaryEntry>slender yellow-striped North American garter snake; prefers wet places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101256236">
	<b:glossaryEntry>yellow- or reddish-striped snake of temperate woodlands and grasslands to tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101256406"
	 b:glossaryEntry="lined snakes"/>
<rdf:Description rdf:about="&a;101256540">
	<b:glossaryEntry>secretive snake of city dumps and parks as well as prairies and open woods; feeds on earthworms; of central United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101256764"
	 b:glossaryEntry="ground snakes"/>
<rdf:Description rdf:about="&a;101256883">
	<b:glossaryEntry>small shy brightly-ringed terrestrial snake of arid or semiarid areas of western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101257077"
	 b:glossaryEntry="ground snakes"/>
<rdf:Description rdf:about="&a;101257204"
	 b:glossaryEntry="ground snakes"/>
<rdf:Description rdf:about="&a;101257304">
	<b:glossaryEntry>in some classifications placed in genus Haldea; small reddish-gray snake of eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101257529">
	<b:glossaryEntry>any of various mostly harmless snakes that live in or near water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101257705"
	 b:glossaryEntry="water snakes; a cosmopolitan genus"/>
<rdf:Description rdf:about="&a;101257864"
	 b:glossaryEntry="North American water snakes"/>
<rdf:Description rdf:about="&a;101257980">
	<b:glossaryEntry>in some classifications placed in the genus Nerodia; western United States snake that seldom ventures far from water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101258236">
	<b:glossaryEntry>any of numerous North American water snakes inhabiting fresh waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101258383">
	<b:glossaryEntry>harmless European snake with a bright yellow collar; common in England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101258573"
	 b:glossaryEntry="a small harmless grass snake"/>
<rdf:Description rdf:about="&a;101258683"
	 b:glossaryEntry="a genus of Colubridae"/>
<rdf:Description rdf:about="&a;101258814"
	 b:glossaryEntry="harmless woodland snake of southeastern United States"/>
<rdf:Description rdf:about="&a;101258978"
	 b:glossaryEntry="sand snakes"/>
<rdf:Description rdf:about="&a;101259109"
	 b:glossaryEntry="small North American burrowing snake"/>
<rdf:Description rdf:about="&a;101259239">
	<b:glossaryEntry>a sand snake of southwestern United States; lives in fine to coarse sand or loamy soil in which it `swims''; banding resembles that of coral snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101259473"
	 b:glossaryEntry="black-headed snakes"/>
<rdf:Description rdf:about="&a;101259602">
	<b:glossaryEntry>small secretive ground-dwelling snake; found from central United States to Argentina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101259770"
	 b:glossaryEntry="vine snakes"/>
<rdf:Description rdf:about="&a;101259891">
	<b:glossaryEntry>slender arboreal snake found from southern Arizona to Bolivia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101260028"
	 b:glossaryEntry="lyre snakes"/>
<rdf:Description rdf:about="&a;101260157">
	<b:glossaryEntry>mildly venomous snake with a lyre-shaped mark on the head; found in rocky areas from southwestern United States to Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101260381"
	 b:glossaryEntry="of desert regions of southwestern North America"/>
<rdf:Description rdf:about="&a;101260515"
	 b:glossaryEntry="night snakes"/>
<rdf:Description rdf:about="&a;101260641"
	 b:glossaryEntry="nocturnal prowler of western United States and Mexico"/>
<rdf:Description rdf:about="&a;101260793"
	 b:glossaryEntry="blind snakes"/>
<rdf:Description rdf:about="&a;101260903"
	 b:glossaryEntry="blind snakes"/>
<rdf:Description rdf:about="&a;101261061">
	<b:glossaryEntry>wormlike burrowing snake of warm regions having vestigial eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101261231"
	 b:glossaryEntry="blind snakes of Asia and Africa and Americas"/>
<rdf:Description rdf:about="&a;101261395">
	<b:glossaryEntry>burrows among roots of shrubs and beneath rocks in desert and rocky hillside areas and beach sand of western United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101261626"
	 b:glossaryEntry="a genus of Colubridae"/>
<rdf:Description rdf:about="&a;101261742">
	<b:glossaryEntry>large dark-blue nonvenomous snake that invades burrows; found in southern North America and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101261952"
	 b:glossaryEntry="a variety of indigo snake"/>
<rdf:Description rdf:about="&a;101262072">
	<b:glossaryEntry>any of various large nonvenomous snakes that kill their prey by crushing it in its coils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101262236"
	 b:glossaryEntry="boas and pythons"/>
<rdf:Description rdf:about="&a;101262435">
	<b:glossaryEntry>any of several chiefly tropical constrictors with vestigial hind limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101262664"
	 b:glossaryEntry="very large boa of tropical America and West Indies"/>
<rdf:Description rdf:about="&a;101262802"
	 b:glossaryEntry="boas of western North America"/>
<rdf:Description rdf:about="&a;101262939">
	<b:glossaryEntry>boa of grasslands and woodlands of western North America; looks and feels like rubber with tail and head of similar shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101263172"
	 b:glossaryEntry="boas of western North America"/>
<rdf:Description rdf:about="&a;101263313"
	 b:glossaryEntry="boa of rocky desert of southwestern United States"/>
<rdf:Description rdf:about="&a;101263459"
	 b:glossaryEntry="anacondas"/>
<rdf:Description rdf:about="&a;101263578"
	 b:glossaryEntry="large arboreal boa of tropical South America"/>
<rdf:Description rdf:about="&a;101263715">
	<b:glossaryEntry>Old World boas: pythons; in some classifications considered a separate family from Boidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101263941">
	<b:glossaryEntry>in some classifications a family separate from Boidae comprising Old World boas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101264097"
	 b:glossaryEntry="large Old World boas"/>
<rdf:Description rdf:about="&a;101264279"
	 b:glossaryEntry="Old World boas"/>
<rdf:Description rdf:about="&a;101264428"
	 b:glossaryEntry="Australian python with a variegated pattern on its back"/>
<rdf:Description rdf:about="&a;101264592">
	<b:glossaryEntry>of southeast Asia and East Indies; the largest snake in the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101264762"
	 b:glossaryEntry="very large python of southeast Asia"/>
<rdf:Description rdf:about="&a;101264893"
	 b:glossaryEntry="very large python of tropical and southern Africa"/>
<rdf:Description rdf:about="&a;101265047"
	 b:glossaryEntry="with an amethyst color"/>
<rdf:Description rdf:about="&a;101265134">
	<b:glossaryEntry>cobras; kraits; mambas; coral snakes; Australian taipan and tiger snakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101265602">
	<b:glossaryEntry>any of numerous venomous front-fanged snakes of warmer parts of both hemispheres</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101265967">
	<b:glossaryEntry>any of several venomous New World snakes brilliantly banded in red and black and either yellow or white; widely distributed in South and Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101266255"
	 b:glossaryEntry="coral snakes"/>
<rdf:Description rdf:about="&a;101266377"
	 b:glossaryEntry="ranges from Central America to southeastern United States"/>
<rdf:Description rdf:about="&a;101266538"
	 b:glossaryEntry="coral snakes"/>
<rdf:Description rdf:about="&a;101266666"
	 b:glossaryEntry="ranges from Central America to southwestern United States"/>
<rdf:Description rdf:about="&a;101266834">
	<b:glossaryEntry>any of various venomous elapid snakes of Asia and Africa and Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101267040"
	 b:glossaryEntry="Asian coral snakes"/>
<rdf:Description rdf:about="&a;101267202"
	 b:glossaryEntry="of India"/>
<rdf:Description rdf:about="&a;101267293"
	 b:glossaryEntry="African coral snakes"/>
<rdf:Description rdf:about="&a;101267427">
	<b:glossaryEntry>small widely distributed arboreal snake of southern Africa banded in black and orange</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101267619"
	 b:glossaryEntry="Australian coral snakes"/>
<rdf:Description rdf:about="&a;101267760">
	<b:glossaryEntry>small venomous but harmless snake marked with black-and-white on red</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101267941"
	 b:glossaryEntry="copperheads"/>
<rdf:Description rdf:about="&a;101268064"
	 b:glossaryEntry="venomous but sluggish reddish-brown snake of Australia"/>
<rdf:Description rdf:about="&a;101268214"
	 b:glossaryEntry="cobras"/>
<rdf:Description rdf:about="&a;101268360">
	<b:glossaryEntry>venomous Asiatic and African elapid snakes that can expand the skin of the neck into a hood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101268575"
	 b:glossaryEntry="of tropical Africa and Asia"/>
<rdf:Description rdf:about="&a;101268692">
	<b:glossaryEntry>cobra used by the Pharaohs as a symbol of their power over life and death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101268863"
	 b:glossaryEntry="king cobra"/>
<rdf:Description rdf:about="&a;101268989">
	<b:glossaryEntry>aggressive cobra widely distributed in Africa; rarely bites but spits venom that may cause blindness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101269209">
	<b:glossaryEntry>large cobra of southeastern Asia and the East Indies; the largest venomous snake; sometimes placed in genus Naja</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101269444"
	 b:glossaryEntry="ringhals"/>
<rdf:Description rdf:about="&a;101269547">
	<b:glossaryEntry>highly venomous snake of southern Africa able to spit venom up to seven feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101269731"
	 b:glossaryEntry="mambas"/>
<rdf:Description rdf:about="&a;101269885">
	<b:glossaryEntry>arboreal snake of central and southern Africa whose bite is often fatal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101270045">
	<b:glossaryEntry>southern African mamba dreaded because of its quickness and readiness to bite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101270224"
	 b:glossaryEntry="green phase of the black mamba"/>
<rdf:Description rdf:about="&a;101270312"
	 b:glossaryEntry="Australian elapid snakes"/>
<rdf:Description rdf:about="&a;101270452"
	 b:glossaryEntry="venomous Australian snake resembling an adder"/>
<rdf:Description rdf:about="&a;101270600"
	 b:glossaryEntry="tiger snakes"/>
<rdf:Description rdf:about="&a;101270722">
	<b:glossaryEntry>highly venomous brown-and-yellow snake of Australia and Tasmania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101270883"
	 b:glossaryEntry="venomous Australian blacksnakes"/>
<rdf:Description rdf:about="&a;101271028">
	<b:glossaryEntry>large semiaquatic snake of Australia; black above with red belly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101271205"
	 b:glossaryEntry="kraits"/>
<rdf:Description rdf:about="&a;101271321">
	<b:glossaryEntry>brightly colored venomous but nonaggressive snake of southeastern Asia and Malay peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101271500"
	 b:glossaryEntry="sluggish krait banded with black and yellow"/>
<rdf:Description rdf:about="&a;101271638"
	 b:glossaryEntry="taipans"/>
<rdf:Description rdf:about="&a;101271757"
	 b:glossaryEntry="large highly venomous snake of northeastern Australia"/>
<rdf:Description rdf:about="&a;101271906"
	 b:glossaryEntry="sea snakes"/>
<rdf:Description rdf:about="&a;101272033">
	<b:glossaryEntry>any of numerous venomous aquatic viviparous snakes having a fin-like tail; of warm littoral seas; feed on fish which they immobilize with quick-acting venom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101272264"
	 b:glossaryEntry="Old World vipers"/>
<rdf:Description rdf:about="&a;101272450">
	<b:glossaryEntry>venomous Old World snakes characterized by hollow venom-conducting fangs in the upper jaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101272718"
	 b:glossaryEntry="type genus of the Viperidae"/>
<rdf:Description rdf:about="&a;101272870"
	 b:glossaryEntry="small terrestrial viper common in northern Eurasia"/>
<rdf:Description rdf:about="&a;101273021"
	 b:glossaryEntry="of southern Europe; similar to but smaller than the adder"/>
<rdf:Description rdf:about="&a;101273174"
	 b:glossaryEntry="a genus of Viperidae"/>
<rdf:Description rdf:about="&a;101273317"
	 b:glossaryEntry="large African viper that inflates its body when alarmed"/>
<rdf:Description rdf:about="&a;101273465">
	<b:glossaryEntry>large heavy-bodied brilliantly marked and extremely venomous west African viper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101273639"
	 b:glossaryEntry="horned vipers"/>
<rdf:Description rdf:about="&a;101273773">
	<b:glossaryEntry>highly venomous viper of North Africa and southwest Asia having a horny spine above each eye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101274000"
	 b:glossaryEntry="New World vipers: pit vipers"/>
<rdf:Description rdf:about="&a;101274238">
	<b:glossaryEntry>New World vipers with hollow fangs and a heat-sensitive pit on each side of the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101274469"
	 b:glossaryEntry="copperheads"/>
<rdf:Description rdf:about="&a;101274649">
	<b:glossaryEntry>common coppery brown pit viper of upland eastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101274812">
	<b:glossaryEntry>venomous semiaquatic snake of swamps in southern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101275016">
	<b:glossaryEntry>pit viper with horny segments at the end of the tail that rattle when shaken</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101275377">
	<b:glossaryEntry>large rattlesnakes; seldom bite unless startled or pursuing prey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101275684"
	 b:glossaryEntry="large deadly rattlesnake with diamond-shaped markings"/>
<rdf:Description rdf:about="&a;101275843"
	 b:glossaryEntry="widely distributed in rugged ground of eastern United States"/>
<rdf:Description rdf:about="&a;101276055"
	 b:glossaryEntry="southern variety"/>
<rdf:Description rdf:about="&a;101276192"
	 b:glossaryEntry="widely distributed between the Mississippi and the Rockies"/>
<rdf:Description rdf:about="&a;101276394">
	<b:glossaryEntry>small pale-colored desert rattlesnake of southwestern United States; body moves in an S-shaped curve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101276611">
	<b:glossaryEntry>largest and most dangerous North American snake; of southwestern United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101276836">
	<b:glossaryEntry>mountain rock dweller of Mexico and most southern parts of United States southwest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101277019">
	<b:glossaryEntry>having irregularly cross-banded back; of arid foothills and canyons of southern Arizona and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101277218">
	<b:glossaryEntry>extremely dangerous; most common in areas of scattered scrubby growth; from Mojave Desert to w. Texas and into Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101277441">
	<b:glossaryEntry>markings vary but usually harmonize with background; of sw Arizona and Baja California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101277635"
	 b:glossaryEntry="pygmy rattlesnakes"/>
<rdf:Description rdf:about="&a;101277765">
	<b:glossaryEntry>pygmy rattlesnake found in moist areas from the Great Lakes to Mexico; feeds on mice and small amphibians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101277989"
	 b:glossaryEntry="small pygmy rattlesnake"/>
<rdf:Description rdf:about="&a;101278107"
	 b:glossaryEntry="fer-de-lance"/>
<rdf:Description rdf:about="&a;101278229">
	<b:glossaryEntry>large extremely venomous pit viper of Central and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101278388"
	 b:glossaryEntry="horny projecting jaws of a bird"/>
<rdf:Description rdf:about="&a;101278508"
	 b:glossaryEntry="beaklike mouth of e.g. turtles"/>
<rdf:Description rdf:about="&a;101278589">
	<b:glossaryEntry>the dead body of an animal esp. one slaughtered and dressed for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101278721"
	 b:glossaryEntry="the dead and rotting body of an animal"/>
<rdf:Description rdf:about="&a;101278813"
	 b:glossaryEntry="any of the arthropods"/>
<rdf:Description rdf:about="&a;101282138"
	 b:glossaryEntry="a genus of arthropods"/>
<rdf:Description rdf:about="&a;101286812">
	<b:glossaryEntry>jointed-foot invertebrates: arachnids; crustaceans; insects; millipedes; centipedes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101287238">
	<b:glossaryEntry>invertebrate having jointed limbs and a segmented body with an exoskeleton made of chitin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101287785"
	 b:glossaryEntry="spiders; scorpions; horseshoe crabs"/>
<rdf:Description rdf:about="&a;101287979">
	<b:glossaryEntry>either of the first pair of fang-like appendages near the mouth of an arachnid; often modified for grasping and piercing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101288155">
	<b:glossaryEntry>any part of the mouth of an insect or other arthropod especially one adapted to a specific way of feeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101288316">
	<b:glossaryEntry>a large class of arthropods including spiders and ticks and scorpions and daddy longlegs; have four pairs of walking legs and no wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101288676">
	<b:glossaryEntry>air-breathing arthropods characterized by simple eyes and four pairs of legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101288946"
	 b:glossaryEntry="harvestmen"/>
<rdf:Description rdf:about="&a;101289100"
	 b:glossaryEntry="a family of Phalangida"/>
<rdf:Description rdf:about="&a;101289241"
	 b:glossaryEntry="type genus of the family Phalangiidae"/>
<rdf:Description rdf:about="&a;101289392">
	<b:glossaryEntry>spider-like arachnid with a small rounded body and very long thin legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101289575"
	 b:glossaryEntry="true scorpions"/>
<rdf:Description rdf:about="&a;101289705">
	<b:glossaryEntry>arachnid of warm dry regions having a long segmented tail ending in a venomous sting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101289863"
	 b:glossaryEntry="false scorpions"/>
<rdf:Description rdf:about="&a;101290105"
	 b:glossaryEntry="small nonvenomous arachnid resembling a tailless scorpion"/>
<rdf:Description rdf:about="&a;101290277"
	 b:glossaryEntry="a genus of Chelonethida"/>
<rdf:Description rdf:about="&a;101290410"
	 b:glossaryEntry="minute arachnid sometimes found in old papers"/>
<rdf:Description rdf:about="&a;101290556"
	 b:glossaryEntry="whip scorpions"/>
<rdf:Description rdf:about="&a;101290727">
	<b:glossaryEntry>nonvenomous arachnid that resembles a scorpion and that has a long thin stingless tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101290925"
	 b:glossaryEntry="giant whip scorpions"/>
<rdf:Description rdf:about="&a;101291067">
	<b:glossaryEntry>large whipscorpion of Mexico and southern United States that emits a vinegary odor when alarmed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101291266"
	 b:glossaryEntry="spiders"/>
<rdf:Description rdf:about="&a;101291504">
	<b:glossaryEntry>predatory arachnid that usually has silk-spinning organs at the back end of the body; they spin silk to make cocoons for eggs or traps for prey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101291863"
	 b:glossaryEntry="orb-weaving spiders; cosmopolitan"/>
<rdf:Description rdf:about="&a;101292030">
	<b:glossaryEntry>the type genus of Argiopidae; small genus of orb-weaving spiders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101292202"
	 b:glossaryEntry="a widely distributed North American garden spider"/>
<rdf:Description rdf:about="&a;101292364">
	<b:glossaryEntry>a genus of orb-weaving spiders including common garden spiders and barn spiders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101292594">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an orange and tan spider with darkly banded legs that spins an orb web daily; "the barn spider was made famous in E. B. White''s book `Charlotte''s Web''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101292842"
	 b:glossaryEntry="a common European garden spider"/>
<rdf:Description rdf:about="&a;101292971"
	 b:glossaryEntry="a family of comb-footed spiders"/>
<rdf:Description rdf:about="&a;101293138"
	 b:glossaryEntry="spider having a comb-like row of bristles on each hind foot"/>
<rdf:Description rdf:about="&a;101293293"
	 b:glossaryEntry="venomous spiders"/>
<rdf:Description rdf:about="&a;101293425">
	<b:glossaryEntry>venomous New World spider; the female is black with an hourglass-shaped red mark on the underside of the abdomen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101293636"
	 b:glossaryEntry="large tropical spiders; tarantulas"/>
<rdf:Description rdf:about="&a;101293791">
	<b:glossaryEntry>large hairy tropical spider that can inflict painful but not highly venomous bites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101293948"
	 b:glossaryEntry="wolf spiders"/>
<rdf:Description rdf:about="&a;101294092"
	 b:glossaryEntry="ground spider that hunts its prey instead of using a web"/>
<rdf:Description rdf:about="&a;101294260"
	 b:glossaryEntry="type genus of the family Lycosidae"/>
<rdf:Description rdf:about="&a;101294400">
	<b:glossaryEntry>large southern European spider once thought to be the cause of tarantism (uncontrollable bodily movement)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101294622"
	 b:glossaryEntry="large burrowing spiders"/>
<rdf:Description rdf:about="&a;101294760">
	<b:glossaryEntry>American spider that constructs a silk-lined nest with a hinged lid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101294909"
	 b:glossaryEntry="mites and ticks"/>
<rdf:Description rdf:about="&a;101295222"
	 b:glossaryEntry="mite or tick"/>
<rdf:Description rdf:about="&a;101295343">
	<b:glossaryEntry>any of two families of small parasitic arachnids with barbed proboscis; feed on blood of warm-blooded animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101295558"
	 b:glossaryEntry="hard ticks"/>
<rdf:Description rdf:about="&a;101295717">
	<b:glossaryEntry>ticks having a hard shield on the back and mouth parts that project from the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101296044"
	 b:glossaryEntry="type genus of the family Ixodidae"/>
<rdf:Description rdf:about="&a;101296316">
	<b:glossaryEntry>a northeastern tick now recognized as same species as Ixodes scapularis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101296479">
	<b:glossaryEntry>a tick that usually does not bite humans; transmits Lyme disease spirochete to dusky-footed woodrats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101296660">
	<b:glossaryEntry>feeds on dusky-footed woodrat and bites humans; principal vector for Lyme disease in western United States especially northern California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101296907">
	<b:glossaryEntry>parasitic on mice of genus Peromyscus (especially P. leucopus) and bites humans; principal vector for Lyme disease in eastern United States (especially New England); northern form was for a time known as Ixodes dammini (deer tick)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101297240">
	<b:glossaryEntry>parasitic on sheep and cattle as well as humans; can transmit looping ill in sheep (acute viral disease of the nervous system); a vector for Lyme disease spirochete</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101297496"
	 b:glossaryEntry="bites humans; a vector for Lyme disease spirochete"/>
<rdf:Description rdf:about="&a;101297630">
	<b:glossaryEntry>usually does not bite humans; transmits Lyme disease spirochete to cottontail rabbits and woodrats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101297809">
	<b:glossaryEntry>usually does not bite humans; transmits Lyme disease spirochete to cottontail rabbits and wood rats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101297992"
	 b:glossaryEntry="vectors of important diseases of man and animals"/>
<rdf:Description rdf:about="&a;101298156">
	<b:glossaryEntry>common tick that can transmit Rocky Mountain spotted fever and tularemia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101298348"
	 b:glossaryEntry="soft ticks"/>
<rdf:Description rdf:about="&a;101298471">
	<b:glossaryEntry>tick lacking a dorsal shield and having mouth parts on the under side of the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101298637">
	<b:glossaryEntry>any of numerous very small to minute arachnids often infesting animals or plants or stored foods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101298911"
	 b:glossaryEntry="mites"/>
<rdf:Description rdf:about="&a;101299027">
	<b:glossaryEntry>very small free-living arachnid that is parasitic on animals or plants; related to ticks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101299187"
	 b:glossaryEntry="mites"/>
<rdf:Description rdf:about="&a;101299311"
	 b:glossaryEntry="mite that in all stages feeds on other arthropods"/>
<rdf:Description rdf:about="&a;101299436"
	 b:glossaryEntry="mites"/>
<rdf:Description rdf:about="&a;101299581">
	<b:glossaryEntry>mite that as nymph and adult feeds on early stages of small arthropods but whose larvae are parasitic on terrestrial vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101299805"
	 b:glossaryEntry="type genus of the family Trombiculidae"/>
<rdf:Description rdf:about="&a;101299957">
	<b:glossaryEntry>larval mite that sucks the blood of vertebrates including human beings causing intense irritation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101300160"
	 b:glossaryEntry="small whitish mites"/>
<rdf:Description rdf:about="&a;101300296"
	 b:glossaryEntry="type genus of the family Sarcoptidae: itch mites"/>
<rdf:Description rdf:about="&a;101300456"
	 b:glossaryEntry="a mite of the genus Acarus"/>
<rdf:Description rdf:about="&a;101300554">
	<b:glossaryEntry>whitish mites that attack the skin of humans and other animals; "itch mites cause scabies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101300731"
	 b:glossaryEntry="plant-feeding mites"/>
<rdf:Description rdf:about="&a;101300890"
	 b:glossaryEntry="web-spinning mite that attacks garden plants and fruit trees"/>
<rdf:Description rdf:about="&a;101301059"
	 b:glossaryEntry="a genus of Tetranychidae"/>
<rdf:Description rdf:about="&a;101301197"
	 b:glossaryEntry="small web-spinning mite; a serious orchard pest"/>
<rdf:Description rdf:about="&a;101301356">
	<b:glossaryEntry>used in some classifications to encompass the millipedes (Diplopoda) and centipedes (Chilopoda); formerly a large taxon including also the Pauropoda and Symphyla; the term Myriapoda now usually used synonymously with Diplopoda and limited to the millipedes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101301698">
	<b:glossaryEntry>general term for any terrestrial arthropod having an elongated body composed of many similar segments: e.g. centipedes and millipedes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101301886">
	<b:glossaryEntry>an obscure class of minute arthropods with branched antennae and 8 to 10 pairs of legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101302065">
	<b:glossaryEntry>small class of minute arthropods; unimportant except for the garden centipede</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101302252"
	 b:glossaryEntry="garden centipedes"/>
<rdf:Description rdf:about="&a;101302387">
	<b:glossaryEntry>minute arthropod often infesting the underground parts of truck-garden and greenhouse crops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101302617">
	<b:glossaryEntry>in some classifications considered a separate phylum: microscopic arachnid-like invertebrates living in water or damp moss having 4 pairs of legs and instead of a mouth a pair of stylets or needle-like piercing organs connected with the pharynx</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101302975"
	 b:glossaryEntry="an arthropod of the division Tardigrada"/>
<rdf:Description rdf:about="&a;101303109">
	<b:glossaryEntry>arthropods having the trunk composed of numerous somites each bearing one pair of legs: centipedes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101303357">
	<b:glossaryEntry>chiefly nocturnal predacious arthropod having a flattened body of 15 to 173 segments each with a pair of legs the foremost being modified into poison fangs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101303605"
	 b:glossaryEntry="a family of Chilopoda"/>
<rdf:Description rdf:about="&a;101303745"
	 b:glossaryEntry="a genus of Scutigeridae"/>
<rdf:Description rdf:about="&a;101303880"
	 b:glossaryEntry="long-legged centipede common in damp places as e.g. cellars"/>
<rdf:Description rdf:about="&a;101304044">
	<b:glossaryEntry>small elongate centipedes living in soil and under stones and having more than 30 pairs of legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101304261"
	 b:glossaryEntry="small extremely elongate earth-living centipedes"/>
<rdf:Description rdf:about="&a;101304426">
	<b:glossaryEntry>type genus of the Geophilidae: cosmopolitan genus of centipedes sometimes called earwigs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101304607">
	<b:glossaryEntry>arthropods having the body composed of numerous double somites each with two pairs of legs: millipedes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101304851">
	<b:glossaryEntry>any of numerous herbivorous nonpoisonous arthropods having a cylindrical body of 20 to 100 or more segments most with two pairs of legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101305084"
	 b:glossaryEntry="sea spiders"/>
<rdf:Description rdf:about="&a;101305211">
	<b:glossaryEntry>any of various small spider-like marine arthropods having small thin bodies and long slender legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101305397">
	<b:glossaryEntry>used in some classifications; includes the orders Xiphosura and Eurypterida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101305607"
	 b:glossaryEntry="horseshoe crabs and extinct forms"/>
<rdf:Description rdf:about="&a;101305752"
	 b:glossaryEntry="horseshoe crabs"/>
<rdf:Description rdf:about="&a;101305899"
	 b:glossaryEntry="type genus of the family Limulidae"/>
<rdf:Description rdf:about="&a;101306041">
	<b:glossaryEntry>large marine arthropod of the American Atlantic coast having a domed horseshoe-shaped carapace and stiff pointed tail; a living fossil related to the wood louse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101306338"
	 b:glossaryEntry="a genus of Limulidae"/>
<rdf:Description rdf:about="&a;101306472"
	 b:glossaryEntry="horseshoe crab of the coast of eastern Asia"/>
<rdf:Description rdf:about="&a;101306601"
	 b:glossaryEntry="extinct aquatic arthropods of the Paleozoic"/>
<rdf:Description rdf:about="&a;101306760">
	<b:glossaryEntry>large extinct scorpion-like arthropod considered related to horseshoe crabs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101306911"
	 b:glossaryEntry="tongue worms"/>
<rdf:Description rdf:about="&a;101307045">
	<b:glossaryEntry>wormlike arthropod having two pairs of hooks at the sides of the mouth; parasitic in nasal sinuses of mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101307245">
	<b:glossaryEntry>pheasants; turkeys; grouse; partridges; quails; chickens; brush turkeys; curassows; hoatzins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101307567"
	 b:glossaryEntry="heavy-bodied largely ground-feeding domestic or game birds"/>
<rdf:Description rdf:about="&a;101307921">
	<b:glossaryEntry>a domesticated gallinaceous bird though to be descended from the red jungle fowl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101308280"
	 b:glossaryEntry="an American breed of domestic fowl"/>
<rdf:Description rdf:about="&a;101308374">
	<b:glossaryEntry>English breed of compact domestic fowl; raised primarily to crossbreed to produce roasters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101308518">
	<b:glossaryEntry>small plump hybrid developed by crossbreeding Plymouth Rock and Cornish fowl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101308672"
	 b:glossaryEntry="any of several breeds reared for cock-fighting"/>
<rdf:Description rdf:about="&a;101308774">
	<b:glossaryEntry>Asian breed of large fowl with dense plumage and feathered legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101308905"
	 b:glossaryEntry="common domestic birds and related forms"/>
<rdf:Description rdf:about="&a;101309069">
	<b:glossaryEntry>small Asiatic wild bird; believed to be ancestral to domestic fowl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101309276"
	 b:glossaryEntry="male jungle fowl"/>
<rdf:Description rdf:about="&a;101309350"
	 b:glossaryEntry="female jungle fowl"/>
<rdf:Description rdf:about="&a;101309425"
	 b:glossaryEntry="SE Asian jungle fowl considered ancestral to domestic fowl"/>
<rdf:Description rdf:about="&a;101309561">
	<b:glossaryEntry>bred for flesh or eggs; believed to have been developed from the red jungle fowl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101309874"
	 b:glossaryEntry="any of various small breeds"/>
<rdf:Description rdf:about="&a;101309954"
	 b:glossaryEntry="young bird esp. of domestic fowl"/>
<rdf:Description rdf:about="&a;101310064"
	 b:glossaryEntry="adult male chicken"/>
<rdf:Description rdf:about="&a;101310180">
	<b:glossaryEntry>the fleshy red crest on the head of the domestic fowl and other gallinaceous birds</b:glossaryEntry>
</rdf:Description>
