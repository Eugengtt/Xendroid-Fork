</rdf:Description>
<rdf:Description rdf:about="&a;103427285"
	 b:glossaryEntry="a light supported on a lamppost; for illuminating a street"/>
<rdf:Description rdf:about="&a;103427434">
	<b:glossaryEntry>a device designed to provide additional strength; "the cardboard backing was just a strengthener,"; "he used gummed reinforcements to hold the page in his notebook"</b:glossaryEntry>
</rdf:Description>
