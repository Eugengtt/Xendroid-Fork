</rdf:Description>
<rdf:Description rdf:about="&a;110815007"
	 b:glossaryEntry="an isomeric acid derived from toluene"/>
<rdf:Description rdf:about="&a;110815102">
	<b:glossaryEntry>an alloy of copper and zinc (and sometimes arsenic) used to imitate gold in cheap jewelry and for gilding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110815278"
	 b:glossaryEntry="a substance used in a printer to develop a xerographic image"/>
<rdf:Description rdf:about="&a;110815390">
	<b:glossaryEntry>a solution containing chemicals that can change the color of a photographic print</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110815523">
	<b:glossaryEntry>alloy steel that is suitable for making tools; is hard a tough and can retain a cutting edge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110815690">
	<b:glossaryEntry>a mineral (fluosilicate of aluminum) that occurs in crystals of various colors and is used as a gemstone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110815864"
	 b:glossaryEntry="a yellow quartz"/>
<rdf:Description rdf:about="&a;110815960">
	<b:glossaryEntry>a mineral that is a complex borosilicate and hydroxide of aluminum containing iron and magnesium and calcium and lithium and sodium; it is usually black but occurs in transparent colored forms that are used as gemstones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110816254">
	<b:glossaryEntry>an element that occurs at very small quantities in the body but is nonetheless important for many biological processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110816432"
	 b:glossaryEntry="a semitransparent paper that is used for tracing drawings"/>
<rdf:Description rdf:about="&a;110816549"
	 b:glossaryEntry="a gum used in pharmacy, adhesives, and textile printing"/>
<rdf:Description rdf:about="&a;110816661"
	 b:glossaryEntry="a class of enzymes that cause transamination"/>
<rdf:Description rdf:about="&a;110816782">
	<b:glossaryEntry>a paper that is coated with a preparation for transferring a design to another surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110816947">
	<b:glossaryEntry>a gemstone having the property of transmitting light without serious diffusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110817447">
	<b:glossaryEntry>a material having the property of admitting light diffusely; a partly transparent material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110817665">
	<b:glossaryEntry>a synthetic corticosteroid used as an anti-inflammatory agent</b:glossaryEntry>
</rdf:Description>
