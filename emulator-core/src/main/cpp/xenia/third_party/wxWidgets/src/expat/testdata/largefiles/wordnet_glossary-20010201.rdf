<rdf:Description rdf:about="&a;201316016"
	 b:glossaryEntry="run easily"/>
<rdf:Description rdf:about="&a;201316088"
	 b:glossaryEntry="take a step"/>
<rdf:Description rdf:about="&a;201316223"
	 b:glossaryEntry="step backwards, in boxing"/>
<rdf:Description rdf:about="&a;201316315"
	 b:glossaryEntry="march in a military fashion"/>
<rdf:Description rdf:about="&a;201316436">
	<b:glossaryEntry>walk with slow or fast paces; "He paced up and down the hall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201316559">
	<b:glossaryEntry>tread or stomp heavily or roughly; "The soldiers trampled across the fields"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201316726">
