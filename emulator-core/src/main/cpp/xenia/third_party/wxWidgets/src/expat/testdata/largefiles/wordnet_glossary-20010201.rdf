	 b:glossaryEntry="large beetle whose larvae bore holes in pine trees"/>
<rdf:Description rdf:about="&a;101674796"
	 b:glossaryEntry="leaf beetles"/>
<rdf:Description rdf:about="&a;101674948">
	<b:glossaryEntry>brightly colored beetle that feeds on plant leaves; larvae infest roots and stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101675156">
	<b:glossaryEntry>any small leaf beetle having enlarged hind legs and capable of jumping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101675284"
	 b:glossaryEntry="Colorado potato beetles"/>
<rdf:Description rdf:about="&a;101675425">
	<b:glossaryEntry>black-and-yellow beetle that feeds in adult and larval stages on potato leaves; originally of eastern Rocky Mountains; now worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101675720"
	 b:glossaryEntry="carpet beetles"/>
<rdf:Description rdf:about="&a;101675851">
	<b:glossaryEntry>small beetle whose larvae are household pests feeding on woolen fabrics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101676050"
	 b:glossaryEntry="a small black and red and white carpet beetle"/>
<rdf:Description rdf:about="&a;101676189"
	 b:glossaryEntry="a solid black carpet beetle"/>
<rdf:Description rdf:about="&a;101676282"
	 b:glossaryEntry="beetles that prey on other insects"/>
<rdf:Description rdf:about="&a;101676427">
	<b:glossaryEntry>predacious on other insects; usually brightly colored or metallic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101676598"
	 b:glossaryEntry="European beetle; infests beehives"/>
<rdf:Description rdf:about="&a;101676688"
	 b:glossaryEntry="scarabaeid beetles and stag beetles"/>
<rdf:Description rdf:about="&a;101676887"
	 b:glossaryEntry="beetle having antennae with hard platelike terminal segments"/>
<rdf:Description rdf:about="&a;101677067"
	 b:glossaryEntry="scarab or dung beetles"/>
<rdf:Description rdf:about="&a;101677303">
	<b:glossaryEntry>any of numerous species of stout-bodied beetles having heads with horny spikes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101677616">
	<b:glossaryEntry>any of numerous beetles that roll balls of dung on which they feed and in which they lay eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101677821"
	 b:glossaryEntry="type genus of the Scarabaeidae"/>
<rdf:Description rdf:about="&a;101677952"
	 b:glossaryEntry="scarabaeid beetle considered divine by ancient Egyptians"/>
<rdf:Description rdf:about="&a;101678112"
	 b:glossaryEntry="any of various dung beetles"/>
<rdf:Description rdf:about="&a;101678195"
	 b:glossaryEntry="Old World dung beetle that flies with a droning sound"/>
<rdf:Description rdf:about="&a;101678304">
	<b:glossaryEntry>any of various large usually brown North American leaf-eating beetles common in late spring; the larvae feed on roots of grasses etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101678547"
	 b:glossaryEntry="large greenish June beetle of southern United States"/>
<rdf:Description rdf:about="&a;101678674"
	 b:glossaryEntry="a genus of Scarabaeidae"/>
<rdf:Description rdf:about="&a;101678807">
	<b:glossaryEntry>small metallic green and brown beetle native to eastern Asia; serious plant pest in North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101679005">
	<b:glossaryEntry>genus of beetles whose grubs feed mainly on roots of plants; includes several pests of cultivated grasses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101679218">
	<b:glossaryEntry>introduced into United States from the Orient; larvae feed on roots of sugarcane and other grasses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101679435">
	<b:glossaryEntry>any of various large chiefly tropical beetles having horns on the head; pest on coconuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101679587"
	 b:glossaryEntry="considered a separate family in some classification systems"/>
<rdf:Description rdf:about="&a;101679789">
	<b:glossaryEntry>any of various beetles of the family (or subfamily) Melolonthidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101679955"
	 b:glossaryEntry="a genus of Melolonthidae"/>
<rdf:Description rdf:about="&a;101680093">
	<b:glossaryEntry>any of various large European beetles destructive to vegetation as both larvae and adult</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101680304"
	 b:glossaryEntry="a genus of Melolonthidae"/>
<rdf:Description rdf:about="&a;101680448">
	<b:glossaryEntry>common North American beetle: larvae feed on roots and adults on leaves and flowers of e.g. rose bushes or apple trees or grape vines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101680697"
	 b:glossaryEntry="considered a separate family in some classification systems"/>
<rdf:Description rdf:about="&a;101680874"
	 b:glossaryEntry="a genus of Cetoniidae"/>
<rdf:Description rdf:about="&a;101681003">
	<b:glossaryEntry>a common metallic green European beetle: larvae feed on plant roots and adults on leaves and flowers of e.g. roses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101681225"
	 b:glossaryEntry="stag beetles"/>
<rdf:Description rdf:about="&a;101681350"
	 b:glossaryEntry="the male has branched mandibles resembling antlers"/>
<rdf:Description rdf:about="&a;101681477"
	 b:glossaryEntry="click beetles and certain fireflies"/>
<rdf:Description rdf:about="&a;101681665"
	 b:glossaryEntry="any of various widely distributed beetles"/>
<rdf:Description rdf:about="&a;101681843">
	<b:glossaryEntry>able to right itself when on its back by flipping into the air with a clicking sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101682015"
	 b:glossaryEntry="tropical click beetles"/>
<rdf:Description rdf:about="&a;101682151"
	 b:glossaryEntry="tropical American click beetle having bright luminous spots"/>
<rdf:Description rdf:about="&a;101682320">
	<b:glossaryEntry>wormlike larva of various elaterid_beetles; feeds on roots of many crop plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101682472"
	 b:glossaryEntry="water beetles"/>
<rdf:Description rdf:about="&a;101682600">
	<b:glossaryEntry>any of numerous aquatic beetles usually having a smooth oval body and flattened hind legs for swimming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101682780"
	 b:glossaryEntry="whirligig beetles"/>
<rdf:Description rdf:about="&a;101682910"
	 b:glossaryEntry="aquatic beetle that circles rapidly on the water surface"/>
<rdf:Description rdf:about="&a;101683048"
	 b:glossaryEntry="deathwatch beetles"/>
<rdf:Description rdf:about="&a;101683179">
	<b:glossaryEntry>bores through wood making a ticking sound popularly thought to presage death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101683376">
	<b:glossaryEntry>any of several families of mostly small beetles that feed on plants and plant products; esp. snout weevils and seed weevils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101683642"
	 b:glossaryEntry="true weevils: snout beetles"/>
<rdf:Description rdf:about="&a;101683809">
	<b:glossaryEntry>small weevil having a prolonged snout; destructive to e.g. grains and nuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101683961"
	 b:glossaryEntry="weevils destructive of cultivated plants"/>
<rdf:Description rdf:about="&a;101684115">
	<b:glossaryEntry>grayish weevil that lays its eggs in cotton bolls destroying the cotton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101684284"
	 b:glossaryEntry="blister beetles"/>
<rdf:Description rdf:about="&a;101684410"
	 b:glossaryEntry="beetle that produces a secretion that blisters the skin"/>
<rdf:Description rdf:about="&a;101684590">
	<b:glossaryEntry>any of various beetles that exude an oily substance from the leg joints that deters enemies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101684738"
	 b:glossaryEntry="green beetle of southern Europe"/>
<rdf:Description rdf:about="&a;101684827">
	<b:glossaryEntry>large family of bark-boring or wood-boring short-beaked beetles; very destructive to forest and fruit trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101685112">
	<b:glossaryEntry>type genus of the Scolytidae comprising numerous small bark beetles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101685289"
	 b:glossaryEntry="a vector of the fungus causing Dutch elm disease"/>
<rdf:Description rdf:about="&a;101685444">
	<b:glossaryEntry>genus of small bark beetles destructive especially to mature conifers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101685612">
	<b:glossaryEntry>small beetle that bores tunnels in the bark and wood of trees; related to weevils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101685788"
	 b:glossaryEntry="rove beetles"/>
<rdf:Description rdf:about="&a;101685921">
	<b:glossaryEntry>active beetle typically having predatory or scavenging habits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101686059">
	<b:glossaryEntry>a family of arthropods including darkling beetles and mealworms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101686281">
	<b:glossaryEntry>sluggish hard-bodied black terrestrial weevil whose larvae feed on e.g. decaying plant material or grain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101686523"
	 b:glossaryEntry="the larva of beetles of the family Tenebrionidae"/>
<rdf:Description rdf:about="&a;101686645"
	 b:glossaryEntry="flour beetles"/>
<rdf:Description rdf:about="&a;101686770"
	 b:glossaryEntry="infests flour and stored grains"/>
<rdf:Description rdf:about="&a;101686894"
	 b:glossaryEntry="seed beetles"/>
<rdf:Description rdf:about="&a;101687076"
	 b:glossaryEntry="infests the seeds of legumes"/>
<rdf:Description rdf:about="&a;101687231"
	 b:glossaryEntry="type genus of the Bruchidae"/>
<rdf:Description rdf:about="&a;101687366"
	 b:glossaryEntry="larvae live in and feed on seeds of the pea plant"/>
<rdf:Description rdf:about="&a;101687509"
	 b:glossaryEntry="a genus of Bruchidae"/>
<rdf:Description rdf:about="&a;101687653"
	 b:glossaryEntry="larvae live in and feed on growing or stored beans"/>
<rdf:Description rdf:about="&a;101687807"
	 b:glossaryEntry="a genus of Bruchidae"/>
<rdf:Description rdf:about="&a;101687941"
	 b:glossaryEntry="brown weevil that infests stored grain esp. rice"/>
<rdf:Description rdf:about="&a;101688101"
	 b:glossaryEntry="web spinners"/>
<rdf:Description rdf:about="&a;101688255">
	<b:glossaryEntry>any of a small order of slender typically tropical insects that nest in colonies in silken tunnels that they spin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101688445"
	 b:glossaryEntry="sucking lice"/>
<rdf:Description rdf:about="&a;101688605">
	<b:glossaryEntry>wingless usually flattened blood-sucking insect parasitic on warm-blooded animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101688845"
	 b:glossaryEntry="true lice: human lice and related forms"/>
<rdf:Description rdf:about="&a;101689001"
	 b:glossaryEntry="type genus of Pediculidae: true lice infecting humans"/>
<rdf:Description rdf:about="&a;101689204"
	 b:glossaryEntry="head or body louse"/>
<rdf:Description rdf:about="&a;101689320"
	 b:glossaryEntry="infests the head and body of humans"/>
<rdf:Description rdf:about="&a;101689451"
	 b:glossaryEntry="a parasitic louse that infests the body of human beings"/>
<rdf:Description rdf:about="&a;101689603"
	 b:glossaryEntry="crab lice"/>
<rdf:Description rdf:about="&a;101689729"
	 b:glossaryEntry="true lice: crab lice"/>
<rdf:Description rdf:about="&a;101689889"
	 b:glossaryEntry="infests the pubic region of the human body"/>
<rdf:Description rdf:about="&a;101690046"
	 b:glossaryEntry="biting lice"/>
<rdf:Description rdf:about="&a;101690190">
	<b:glossaryEntry>wingless insect with mouth parts adapted for biting; mostly parasitic on birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101690385"
	 b:glossaryEntry="chicken lice"/>
<rdf:Description rdf:about="&a;101690505"
	 b:glossaryEntry="parasitic on poultry"/>
<rdf:Description rdf:about="&a;101690656"
	 b:glossaryEntry="fleas"/>
<rdf:Description rdf:about="&a;101690836">
	<b:glossaryEntry>any wingless blood-sucking parasitic insect noted for ability to leap</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101691083"
	 b:glossaryEntry="many common fleas attacking humans and domestic animals"/>
<rdf:Description rdf:about="&a;101691270"
	 b:glossaryEntry="type genus of the Pulicidae"/>
<rdf:Description rdf:about="&a;101691401"
	 b:glossaryEntry="the most common flea attacking humans"/>
<rdf:Description rdf:about="&a;101691518"
	 b:glossaryEntry="an arthropod genus formerly called genus Ctenocephalus"/>
<rdf:Description rdf:about="&a;101691715"
	 b:glossaryEntry="attacks dogs and cats"/>
<rdf:Description rdf:about="&a;101691834"
	 b:glossaryEntry="breeds chiefly on cats and dogs and rats"/>
<rdf:Description rdf:about="&a;101691972"
	 b:glossaryEntry="a genus of Siphonaptera"/>
<rdf:Description rdf:about="&a;101692099">
	<b:glossaryEntry>small tropical flea; the fertile female burrows under the skin of the host including humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101692304"
	 b:glossaryEntry="a genus of Siphonaptera"/>
<rdf:Description rdf:about="&a;101692445"
	 b:glossaryEntry="parasitic on esp. the heads of chickens"/>
<rdf:Description rdf:about="&a;101692604"
	 b:glossaryEntry="true flies; mosquitoes; gnats; crane flies"/>
<rdf:Description rdf:about="&a;101693115">
	<b:glossaryEntry>insects having usually a single pair of functional wings (anterior pair) with the posterior pair reduced to small knobbed structures and mouth parts adapted for sucking or lapping or piercing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101693630"
	 b:glossaryEntry="gall midges"/>
<rdf:Description rdf:about="&a;101693779"
	 b:glossaryEntry="fragile mosquito-like flies that produce galls on plants"/>
<rdf:Description rdf:about="&a;101693951"
	 b:glossaryEntry="a genus of Cecidomyidae"/>
<rdf:Description rdf:about="&a;101694086"
	 b:glossaryEntry="small fly whose larvae damage wheat and other grains"/>
<rdf:Description rdf:about="&a;101694238">
	<b:glossaryEntry>two-winged flies esp. the families: Muscidae; Gasterophilidae; Calliphoridae; Tachinidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101694425"
	 b:glossaryEntry="two-winged flies esp. the housefly"/>
<rdf:Description rdf:about="&a;101694570"
	 b:glossaryEntry="two-winged insects characterized by active flight"/>
<rdf:Description rdf:about="&a;101694851">
	<b:glossaryEntry>scale-like structure between the base of the wing and the halter of a two-winged fly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101695017"
	 b:glossaryEntry="type genus of the Muscidae: houseflies"/>
<rdf:Description rdf:about="&a;101695159">
	<b:glossaryEntry>common fly that frequents human habitations and spreads many diseases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101695320"
	 b:glossaryEntry="flies closely related to the Muscidae: tsetse flies"/>
<rdf:Description rdf:about="&a;101695488"
	 b:glossaryEntry="type genus of the Glossinidae: tsetse flies"/>
<rdf:Description rdf:about="&a;101695630"
	 b:glossaryEntry="blood-sucking African fly; transmits sleeping sickness etc."/>
<rdf:Description rdf:about="&a;101695807"
	 b:glossaryEntry="blowflies"/>
<rdf:Description rdf:about="&a;101695975"
	 b:glossaryEntry="type genus of the Calliphoridae: blowflies"/>
<rdf:Description rdf:about="&a;101696131">
	<b:glossaryEntry>large usually hairy metallic blue or green fly; lays eggs in carrion or dung or wounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101696337">
	<b:glossaryEntry>blowfly with iridescent blue body; makes a loud buzzing noise in flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101696485"
	 b:glossaryEntry="greenbottle flies"/>
<rdf:Description rdf:about="&a;101696610"
	 b:glossaryEntry="blowfly with brilliant coppery green body"/>
<rdf:Description rdf:about="&a;101696746"
	 b:glossaryEntry="flesh flies"/>
<rdf:Description rdf:about="&a;101696871">
	<b:glossaryEntry>fly whose larvae feed on carrion or the flesh of living animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101697031"
	 b:glossaryEntry="parasites on other insects"/>
<rdf:Description rdf:about="&a;101697172">
	<b:glossaryEntry>bristly fly whose larvae live parasitically in caterpillars and other insects; important in control of noxious insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101697367"
	 b:glossaryEntry="any of various large flies that annoy livestock"/>
<rdf:Description rdf:about="&a;101697521">
	<b:glossaryEntry>stout-bodied hairy dipterous fly whose larvae are parasites on humans and other mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101697715"
	 b:glossaryEntry="horse botflies"/>
<rdf:Description rdf:about="&a;101697854"
	 b:glossaryEntry="type genus of the Gasterophilidae: horse botflies"/>
<rdf:Description rdf:about="&a;101698023"
	 b:glossaryEntry="parasitic chiefly on horses"/>
<rdf:Description rdf:about="&a;101698157"
	 b:glossaryEntry="New World botflies"/>
<rdf:Description rdf:about="&a;101698313"
	 b:glossaryEntry="type genus of the Cuterebridae"/>
<rdf:Description rdf:about="&a;101698436"
	 b:glossaryEntry="larvae live under the skin of domestic mammals and humans"/>
<rdf:Description rdf:about="&a;101698607">
	<b:glossaryEntry>large tropical American fly; parasitic on humans and other mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101698772"
	 b:glossaryEntry="warble flies"/>
<rdf:Description rdf:about="&a;101698957"
	 b:glossaryEntry="type genus of the Oestridae: sheep botflies"/>
<rdf:Description rdf:about="&a;101699108"
	 b:glossaryEntry="larvae are parasitic on sheep"/>
<rdf:Description rdf:about="&a;101699245">
	<b:glossaryEntry>in some classifications considered the type genus of the family Hypodermatidae: warble flies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101699449">
	<b:glossaryEntry>hairy bee-like fly whose larvae produce lumpy abscesses (warbles) under the skin of cattle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101699615">
	<b:glossaryEntry>a lumpy abscess under the hide of domestic mammals caused by larvae of a botfly or warble fly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101699761"
	 b:glossaryEntry="horseflies"/>
<rdf:Description rdf:about="&a;101699884">
	<b:glossaryEntry>large swift fly the female of which sucks blood of various animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101700051"
	 b:glossaryEntry="bee flies"/>
<rdf:Description rdf:about="&a;101700177">
	<b:glossaryEntry>hairy nectar-eating fly that resembles a bee; larvae are parasitic on larvae of bees and related insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101700354"
	 b:glossaryEntry="robber flies"/>
<rdf:Description rdf:about="&a;101700477">
	<b:glossaryEntry>swift predatory fly having a strong body like a bee with the proboscis hardened for sucking juices of other insects captured on the wing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101700702"
	 b:glossaryEntry="any of numerous small insects whose larvae feed on fruits"/>
<rdf:Description rdf:about="&a;101700900"
	 b:glossaryEntry="fruit flies; some leafminers"/>
<rdf:Description rdf:about="&a;101701118"
	 b:glossaryEntry="a genus of Trypetidae"/>
<rdf:Description rdf:about="&a;101701253"
	 b:glossaryEntry="larvae bore into and feed on apples"/>
<rdf:Description rdf:about="&a;101701405"
	 b:glossaryEntry="Mediterranean fruit flies"/>
<rdf:Description rdf:about="&a;101701542">
	<b:glossaryEntry>small black-and-white fly that damages citrus and other fruits by implanting eggs that hatch inside the fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101701770"
	 b:glossaryEntry="fruit flies"/>
<rdf:Description rdf:about="&a;101701902"
	 b:glossaryEntry="a genus of Drosophilidae"/>
<rdf:Description rdf:about="&a;101702046"
	 b:glossaryEntry="small fly used in studying basic mechanisms of inheritance"/>
<rdf:Description rdf:about="&a;101702206">
	<b:glossaryEntry>flies whose larvae feed on pickles and imperfectly sealed preserves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101702350"
	 b:glossaryEntry="leaf miners"/>
<rdf:Description rdf:about="&a;101702458">
	<b:glossaryEntry>any of various small moths or dipterous flies whose larvae burrow into and feed on leaf tissue esp. of the family Gracilariidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101702654"
	 b:glossaryEntry="winged or wingless dipterans: louse flies"/>
<rdf:Description rdf:about="&a;101702854"
	 b:glossaryEntry="blood-sucking dipterous fly parasitic on birds and mammals"/>
<rdf:Description rdf:about="&a;101703037"
	 b:glossaryEntry="type genus of the Hippoboscidae"/>
<rdf:Description rdf:about="&a;101703182"
	 b:glossaryEntry="winged fly parasitic on horses"/>
<rdf:Description rdf:about="&a;101703319"
	 b:glossaryEntry="an arthropod genus of wingless flies including the sheep ked"/>
<rdf:Description rdf:about="&a;101703493">
	<b:glossaryEntry>wingless fly that is an external parasite on sheep and cattle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101703674"
	 b:glossaryEntry="European genus of bloodsucking flies"/>
<rdf:Description rdf:about="&a;101703824">
	<b:glossaryEntry>small black European fly introduced into North America; sucks blood from cattle especially at the base of the horn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101704034"
	 b:glossaryEntry="mosquitoes; fungus gnats; crane flies; gnats; sand flies"/>
<rdf:Description rdf:about="&a;101704321"
	 b:glossaryEntry="mosquitoes"/>
<rdf:Description rdf:about="&a;101704520">
	<b:glossaryEntry>two-winged insect whose female has a long proboscis to pierce the skin and suck the blood of humans and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101704831"
	 b:glossaryEntry="larva of a mosquito"/>
<rdf:Description rdf:about="&a;101704934"
	 b:glossaryEntry="British usage"/>
<rdf:Description rdf:about="&a;101704998"
	 b:glossaryEntry="yellow-fever mosquitos"/>
<rdf:Description rdf:about="&a;101705143"
	 b:glossaryEntry="mosquito that transmits yellow fever and dengue"/>
<rdf:Description rdf:about="&a;101705293">
	<b:glossaryEntry>striped native of Japan thriving in United States southeast and midwest and spreading to the Caribbean; potential carrier of serious diseases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101705539">
	<b:glossaryEntry>malaria mosquitoes; distinguished by the adult''s head-downward stance and absence of breathing tubes in the larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101705784"
	 b:glossaryEntry="any mosquito of the genus Anopheles"/>
<rdf:Description rdf:about="&a;101705895"
	 b:glossaryEntry="transmits the malaria parasite"/>
<rdf:Description rdf:about="&a;101706027">
	<b:glossaryEntry>type genus of the Culicidae: widespread genus of mosquitoes distinguished by holding the body parallel to the resting surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101706275"
	 b:glossaryEntry="common house mosquito"/>
<rdf:Description rdf:about="&a;101706393"
	 b:glossaryEntry="widespread tropical mosquito that transmits filarial worms"/>
<rdf:Description rdf:about="&a;101706556">
	<b:glossaryEntry>any of various small biting flies: midges; biting midges; black flies; sand flies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101706778"
	 b:glossaryEntry="biting midges; sand flies"/>
<rdf:Description rdf:about="&a;101706947">
	<b:glossaryEntry>minute two-winged insect that sucks the blood of mammals and birds and other insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101707147"
	 b:glossaryEntry="type genus of the Ceratopogonidae"/>
<rdf:Description rdf:about="&a;101707277"
	 b:glossaryEntry="midges"/>
<rdf:Description rdf:about="&a;101707421">
	<b:glossaryEntry>minute two-winged mosquito-like fly lacking biting mouthparts; appear in dancing swarms esp. near water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101707595"
	 b:glossaryEntry="type genus of the Chironomidae"/>
<rdf:Description rdf:about="&a;101707720"
	 b:glossaryEntry="fungus gnats"/>
<rdf:Description rdf:about="&a;101707855">
	<b:glossaryEntry>mosquito-like insect whose larvae feed on fungi or decaying vegetation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101708002">
	<b:glossaryEntry>very small two-winged flies with hairy wings that develop in moss and damp vegetable matter: sand flies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101708241"
	 b:glossaryEntry="a fly of the family Psychodidae"/>
<rdf:Description rdf:about="&a;101708347"
	 b:glossaryEntry="small blood-sucking sand flies that resemble moths"/>
<rdf:Description rdf:about="&a;101708513"
	 b:glossaryEntry="blood-sucking females can transmit sandfly fever"/>
<rdf:Description rdf:about="&a;101708669"
	 b:glossaryEntry="fungus gnats"/>
<rdf:Description rdf:about="&a;101708794"
	 b:glossaryEntry="type genus of the Sciaridae: fungus gnat"/>
<rdf:Description rdf:about="&a;101708931">
	<b:glossaryEntry>minute blackish gregarious flies destructive to mushrooms and seedlings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101709116">
	<b:glossaryEntry>larva of fungus gnat; march in large companies in regular order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101709234"
	 b:glossaryEntry="crane flies"/>
<rdf:Description rdf:about="&a;101709358">
	<b:glossaryEntry>long-legged slender flies that resemble large mosquitoes but do not bite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101709522"
	 b:glossaryEntry="blackflies and sand flies"/>
<rdf:Description rdf:about="&a;101709662"
	 b:glossaryEntry="type genus of the Simuliidae: blackflies"/>
<rdf:Description rdf:about="&a;101709812">
	<b:glossaryEntry>small blackish stout-bodied biting fly having aquatic larvae; sucks the blood of birds as well as humans and other mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101710035">
	<b:glossaryEntry>an order of insects including: bees; wasps; ants; ichneumons; sawflies; gall wasps; etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101710391">
	<b:glossaryEntry>insects having two pairs of membranous wings and an ovipositor specialized for stinging or piercing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101710728"
	 b:glossaryEntry="bees"/>
<rdf:Description rdf:about="&a;101710960">
	<b:glossaryEntry>any of numerous hairy-bodied insects including social and solitary species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101711283">
	<b:glossaryEntry>stingless male bee in a colony of social bees (esp. honeybees) whose sole function is to mate with the queen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101711443"
	 b:glossaryEntry="fertile egg-laying female bee"/>
<rdf:Description rdf:about="&a;101711547">
	<b:glossaryEntry>sterile member of a colony of social insects that forages for food and cares for the larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101711727">
	<b:glossaryEntry>a wingless sterile ant or termite having a large head and powerful jaws adapted for defending the colony</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101711885">
	<b:glossaryEntry>sterile bee specialized to collect food and maintain the hive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101712022"
	 b:glossaryEntry="honeybees; carpenter bees; bumblebees"/>
<rdf:Description rdf:about="&a;101712223"
	 b:glossaryEntry="type genus of the Apidae: honeybees"/>
<rdf:Description rdf:about="&a;101712360"
	 b:glossaryEntry="social bee often domesticated for the honey it produces"/>
<rdf:Description rdf:about="&a;101712578">
	<b:glossaryEntry>a strain of bees that originated in Brazil in the 1950s as a cross between an aggressive African bee and a honeybee; retains most of the traits of the African bee; now spread as far north as Texas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101712928">
	<b:glossaryEntry>dark-colored ill-tempered honeybee supposedly of German origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101713059">
	<b:glossaryEntry>grayish quiet-dispositioned highly productive European honeybee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101713182">
	<b:glossaryEntry>yellowish honeybee resembling the Carniolan bee in its habits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101713301"
	 b:glossaryEntry="carpenter bees"/>
<rdf:Description rdf:about="&a;101713425">
	<b:glossaryEntry>large solitary bee that lays eggs in tunnels bored into wood or plant stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101713579"
	 b:glossaryEntry="bumblebees"/>
<rdf:Description rdf:about="&a;101713695"
	 b:glossaryEntry="robust hairy social bee of temperate regions"/>
<rdf:Description rdf:about="&a;101713826">
	<b:glossaryEntry>a large bee that resembles the bumblebee but lacks pollen-collecting apparatus and a worker caste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101714035"
	 b:glossaryEntry="a bee that is parasitic in the nests of bumblebees"/>
<rdf:Description rdf:about="&a;101714167">
	<b:glossaryEntry>a large family of solitary short-tongued bees most of which burrow in the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101714362"
	 b:glossaryEntry="a solitary burrowing short-tongued bee"/>
<rdf:Description rdf:about="&a;101714498"
	 b:glossaryEntry="a bee that is a a member of the genus Andrena"/>
<rdf:Description rdf:about="&a;101714640"
	 b:glossaryEntry="a genus of bee; some are important pollinators of legumes"/>
<rdf:Description rdf:about="&a;101714801">
	<b:glossaryEntry>a family of small solitary bees; many are valuable pollinators for agriculture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101714994">
	<b:glossaryEntry>a common solitary bee important for pollinating alfalfa in the western United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101715172"
	 b:glossaryEntry="leaf-cutting and mason bees"/>
<rdf:Description rdf:about="&a;101715356"
	 b:glossaryEntry="type genus of the Megachilidae: leaf-cutting bees"/>
<rdf:Description rdf:about="&a;101715517">
	<b:glossaryEntry>bee that cuts rounded pieces from leaves and flowers to line its nest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101715700">
	<b:glossaryEntry>any of numerous solitary bees that build nests of hardened mud and sand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101715846"
	 b:glossaryEntry="potter bees"/>
<rdf:Description rdf:about="&a;101715969">
	<b:glossaryEntry>solitary bee that builds nests of mud or pebbles cemented together and attached to a plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101716135">
	<b:glossaryEntry>social or solitary hymenopterans typically having a slender body with the abdomen attached by a narrow stalk and having a formidable sting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101716378">
	<b:glossaryEntry>an arthropod family of the order Hymenoptera including: yellow jackets; hornets; mason wasps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101716657"
	 b:glossaryEntry="mostly social nest-building wasps"/>
<rdf:Description rdf:about="&a;101716866">
	<b:glossaryEntry>type genus of the Vespidae: various hornets and yellow jackets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101717013">
	<b:glossaryEntry>any of several social wasps that construct nests of a substance like paper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101717162"
	 b:glossaryEntry="large stinging paper wasp"/>
<rdf:Description rdf:about="&a;101717294"
	 b:glossaryEntry="European hornet introduced into the United States"/>
<rdf:Description rdf:about="&a;101717417"
	 b:glossaryEntry="sometimes considered a subgenus of Vespa: social wasps"/>
<rdf:Description rdf:about="&a;101717598"
	 b:glossaryEntry="a variety of vespid wasp"/>
<rdf:Description rdf:about="&a;101717718"
	 b:glossaryEntry="North American hornet"/>
<rdf:Description rdf:about="&a;101717843">
	<b:glossaryEntry>small yellow-marked social wasp commonly nesting in the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101718022"
	 b:glossaryEntry="a genus of Vespidae"/>
<rdf:Description rdf:about="&a;101718151"
	 b:glossaryEntry="a variety of paper wasp"/>
<rdf:Description rdf:about="&a;101718258"
	 b:glossaryEntry="mason wasps"/>
<rdf:Description rdf:about="&a;101718396">
	<b:glossaryEntry>any of various solitary wasps that construct nests of hardened mud for their young</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101718554">
	<b:glossaryEntry>any of various solitary wasps that construct vase-shaped cells of mud for their eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101718715"
	 b:glossaryEntry="families Sphecidae and Stizidae"/>
<rdf:Description rdf:about="&a;101718904"
	 b:glossaryEntry="any of various solitary wasps"/>
<rdf:Description rdf:about="&a;101719077"
	 b:glossaryEntry="mud daubers; some digger wasps"/>
<rdf:Description rdf:about="&a;101719239"
	 b:glossaryEntry="mud daubers"/>
<rdf:Description rdf:about="&a;101719364">
	<b:glossaryEntry>solitary wasp that constructs nests of hardened mud or clay for the young</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101719513">
	<b:glossaryEntry>solitary wasp that digs nests in the soil and stocks them with paralyzed insects for the larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101719684"
	 b:glossaryEntry="cicada killers"/>
<rdf:Description rdf:about="&a;101719809"
	 b:glossaryEntry="large solitary wasps: cicada killer"/>
<rdf:Description rdf:about="&a;101719954"
	 b:glossaryEntry="large black or rust-colored wasp that preys on cicadas"/>
<rdf:Description rdf:about="&a;101720108">
	<b:glossaryEntry>wasp that constructs mud cells on a solid base in which females place eggs laid in paralyzed insect larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101720290"
	 b:glossaryEntry="a family of Hymenoptera"/>
<rdf:Description rdf:about="&a;101720483">
	<b:glossaryEntry>small solitary wasp that produces galls on oaks and other plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101720667"
	 b:glossaryEntry="type genus of the Cynipidae: gall wasps"/>
<rdf:Description rdf:about="&a;101720793"
	 b:glossaryEntry="cynipid gall wasps, esp. causing oak-apple galls"/>
<rdf:Description rdf:about="&a;101720938"
	 b:glossaryEntry="cynipid gall wasps, chiefly affecting oaks"/>
<rdf:Description rdf:about="&a;101721071"
	 b:glossaryEntry="an arthropod family including: chalcidflies"/>
<rdf:Description rdf:about="&a;101721300">
	<b:glossaryEntry>any of various tiny insects whose larvae are parasites on eggs and larvae of other insects; many are beneficial in destroying injurious insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101721576">
	<b:glossaryEntry>larva of chalcid flies injurious to the straw of wheat and other grains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101721734"
	 b:glossaryEntry="type genus of the Chalcididae"/>
<rdf:Description rdf:about="&a;101721871"
	 b:glossaryEntry="a variety of chalcid fly"/>
<rdf:Description rdf:about="&a;101721972"
	 b:glossaryEntry="ichneumon flies"/>
<rdf:Description rdf:about="&a;101722108">
	<b:glossaryEntry>hymenopterous insect that resembles a wasp and whose larvae are parasitic on caterpillars and other insect larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101722300"
	 b:glossaryEntry="sawflies"/>
<rdf:Description rdf:about="&a;101722450">
	<b:glossaryEntry>insect whose female has a saw-like ovipositor for inserting eggs into the leaf or stem tissue of a host plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101722649"
	 b:glossaryEntry="birch leaf miner"/>
<rdf:Description rdf:about="&a;101722752">
	<b:glossaryEntry>small black sawfly native to Europe but established in eastern United States; larvae mine the leaves of birches causing serious defoliation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101722971"
	 b:glossaryEntry="ants"/>
<rdf:Description rdf:about="&a;101723223">
	<b:glossaryEntry>social insect living in organized colonies; characteristically the males and fertile queen have wings during breeding season; wingless sterile females are the workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101723638"
	 b:glossaryEntry="a genus of Formicidae"/>
<rdf:Description rdf:about="&a;101723792"
	 b:glossaryEntry="small red ant of warm regions; a common household pest"/>
<rdf:Description rdf:about="&a;101723962">
	<b:glossaryEntry>tiny glossy black ant; nests outdoors but invades houses for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101724130"
	 b:glossaryEntry="army ants"/>
<rdf:Description rdf:about="&a;101724255"
	 b:glossaryEntry="tropical nomadic ant that preys mainly on other insects"/>
<rdf:Description rdf:about="&a;101724413"
	 b:glossaryEntry="carpenter ants"/>
<rdf:Description rdf:about="&a;101724541">
	<b:glossaryEntry>ant that nests in decaying wood in which it bores tunnels for depositing eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101724697"
	 b:glossaryEntry="fire ants"/>
<rdf:Description rdf:about="&a;101724820">
	<b:glossaryEntry>omnivorous ant of tropical and subtropical America that can inflict a painful sting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101724977"
	 b:glossaryEntry="type genus of the Formicidae"/>
<rdf:Description rdf:about="&a;101725151">
	<b:glossaryEntry>reddish-brown European ant typically living in anthills in woodlands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101725308">
	<b:glossaryEntry>any of various ants captured as larvae and enslaved by another species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101725452"
	 b:glossaryEntry="an ant frequently enslaved"/>
<rdf:Description rdf:about="&a;101725557">
	<b:glossaryEntry>an ant that attacks colonies of other ant species and carries off the young to be reared as slaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101725768">
	<b:glossaryEntry>slave-making ant widely distributed over the northern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101725932"
	 b:glossaryEntry="bulldog ants"/>
<rdf:Description rdf:about="&a;101726054">
	<b:glossaryEntry>any of the large fierce Australian ants of the genus Myrmecia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101726192"
	 b:glossaryEntry="Amazon ants"/>
<rdf:Description rdf:about="&a;101726315"
	 b:glossaryEntry="small reddish slave-making ant species"/>
<rdf:Description rdf:about="&a;101726451">
	<b:glossaryEntry>order of social insects that live in colonies, including: termites; often placed in subclass Exopterygota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101726742"
	 b:glossaryEntry="termites"/>
<rdf:Description rdf:about="&a;101726884"
	 b:glossaryEntry="type genus of the Termitidae"/>
<rdf:Description rdf:about="&a;101726999">
	<b:glossaryEntry>whitish soft-bodied ant-like social insect that feeds on wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101727253">
	<b:glossaryEntry>includes species highly destructive to structures and living trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101727460"
	 b:glossaryEntry="destructive United States termite"/>
<rdf:Description rdf:about="&a;101727582"
	 b:glossaryEntry="destructive European termite"/>
<rdf:Description rdf:about="&a;101727700">
	<b:glossaryEntry>large widely distributed family of termites of temperate to tropical regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101727882"
	 b:glossaryEntry="primitive termites"/>
<rdf:Description rdf:about="&a;101728025">
	<b:glossaryEntry>primitive genus of termites; mostly extinct; sometimes considered the most primitive Isoptera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101728272">
	<b:glossaryEntry>Australian termite; sole living species of Mastotermes; called a living fossil; apparent missing link between cockroaches and termites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101728496"
	 b:glossaryEntry="extinct termite found in amber in S Mexico"/>
<rdf:Description rdf:about="&a;101728630"
	 b:glossaryEntry="extinct termite found in amber in the Dominican Republic"/>
<rdf:Description rdf:about="&a;101728780"
	 b:glossaryEntry="primitive termites of warm regions"/>
<rdf:Description rdf:about="&a;101728956">
	<b:glossaryEntry>type genus of Kalotermitidae; termites destructive of wood and living trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101729126">
	<b:glossaryEntry>genus of dry wood termites; cosmopolitan; sometimes considered a subgenus of Kalotermes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101729331"
	 b:glossaryEntry="extremely destructive dry-wood termite of warm regions"/>
<rdf:Description rdf:about="&a;101729492"
	 b:glossaryEntry="grasshoppers and locusts; crickets"/>
<rdf:Description rdf:about="&a;101729716">
	<b:glossaryEntry>any of various insects having leathery forewings and membranous hind wings and chewing mouthparts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101729962">
	<b:glossaryEntry>terrestrial plant-eating insect with hind legs adapted for leaping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101730122"
	 b:glossaryEntry="short-horned grasshoppers; true locusts"/>
<rdf:Description rdf:about="&a;101730345"
	 b:glossaryEntry="grasshopper with short antennae"/>
<rdf:Description rdf:about="&a;101730494"
	 b:glossaryEntry="migratory grasshoppers of warm regions having short antennae"/>
<rdf:Description rdf:about="&a;101730643"
	 b:glossaryEntry="a genus of Acrididae"/>
<rdf:Description rdf:about="&a;101730771">
	<b:glossaryEntry>Old World locust that travels in vast swarms stripping large areas of vegetation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101730954"
	 b:glossaryEntry="New World migratory locusts and common American grasshoppers"/>
<rdf:Description rdf:about="&a;101731128">
	<b:glossaryEntry>serious pest of grain-growing and range areas of central and western United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101731297"
	 b:glossaryEntry="long-horned grasshoppers; katydids"/>
<rdf:Description rdf:about="&a;101731490">
	<b:glossaryEntry>grasshoppers with long threadlike antennae and well-developed stridulating organs on the forewings of the male</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101731739"
	 b:glossaryEntry="katydids"/>
<rdf:Description rdf:about="&a;101731865">
