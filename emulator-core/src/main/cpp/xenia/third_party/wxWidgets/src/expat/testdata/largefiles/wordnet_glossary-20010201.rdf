	<b:glossaryEntry>inflammation of the laminated tissue that attaches the hoof to the foot of a horse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110295861">
	<b:glossaryEntry>inflammation of the mucous membrane of the larynx; characterized by hoarseness or loss of voice and coughing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110296026"
	 b:glossaryEntry="inflammation of a breast (or udder)"/>
<rdf:Description rdf:about="&a;110296116"
	 b:glossaryEntry="inflammation of the mastoid"/>
<rdf:Description rdf:about="&a;110296201">
	<b:glossaryEntry>inflammation of the lining of the uterus (of the endometrium)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110296332"
	 b:glossaryEntry="inflammation of the spinal cord"/>
<rdf:Description rdf:about="&a;110296418">
	<b:glossaryEntry>inflammation of a nerve accompanied by pain and sometimes loss of function</b:glossaryEntry>
</rdf:Description>
