</rdf:Description>
<rdf:Description rdf:about="&a;400377650">
	<b:glossaryEntry>in an irrelevant manner; "suddenly and irrelevantly, she asked him for money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400377822"
	 b:glossaryEntry='in an irretrievable manner; "it is irretrievably lost"'/>
<rdf:Description rdf:about="&a;400377936">
	<b:glossaryEntry>in an irreverent manner; "in the seventeenth century England had known fifty years of doctrinal quarrels and civil war; clergymen had been turned from their cures, and churches irreverently used"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400378190">
	<b:glossaryEntry>without respect; "the student irreverently mimicked the teacher in his presence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400378347">
	<b:glossaryEntry>in an irreversible manner; "this old tradition is irreversibly disappearing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400378482">
	<b:glossaryEntry>in a manner that jars and irritates; "the piano was jarringly out of tune"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400378612"
	 b:glossaryEntry='with jealousy; "he guarded his privacy jealously"'/>
<rdf:Description rdf:about="&a;400378717">
	<b:glossaryEntry>in an immature manner; "his teenage son still behaves very immaturely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400378891"
	 b:glossaryEntry='in a mature manner; "she acts very maturely for her age"'/>
