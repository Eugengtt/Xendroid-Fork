</rdf:Description>
<rdf:Description rdf:about="&a;108887114"
	 b:glossaryEntry="fishtail palms"/>
<rdf:Description rdf:about="&a;108887236">
	<b:glossaryEntry>attractive East Indian palm having distinctive bipinnate foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108887379">
	<b:glossaryEntry>fishtail palm of India to Malay Peninsula; sap yields a brown sugar (jaggery) and trunk pith yields sago</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108887612"
	 b:glossaryEntry="wax palms"/>
<rdf:Description rdf:about="&a;108887733">
	<b:glossaryEntry>palm of the Andes yielding a resinous wax which is mixed with tallow to make candles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108887932"
	 b:glossaryEntry="coconut palms"/>
<rdf:Description rdf:about="&a;108888049">
	<b:glossaryEntry>tall palm tree bearing coconuts as fruits; widely planted throughout the tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108888300"
	 b:glossaryEntry="stiff coarse fiber from the outer husk of a coconut"/>
<rdf:Description rdf:about="&a;108888402"
	 b:glossaryEntry="slow-growing tropical fan palms"/>
<rdf:Description rdf:about="&a;108888566">
	<b:glossaryEntry>Brazilian fan palm having an edible root; source of a useful leaf fiber and a brittle yellowish wax</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108888830">
	<b:glossaryEntry>hard yellowish to brownish wax from leaves of the carnauba palm used especially in floor waxes and polishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108889026"
	 b:glossaryEntry="South American palm yielding a wax similar to carnauba wax"/>
<rdf:Description rdf:about="&a;108889235"
	 b:glossaryEntry="a monocotyledonous genus of tropical American palm trees"/>
<rdf:Description rdf:about="&a;108889388"
	 b:glossaryEntry="any of several tropical American palms bearing corozo nuts"/>
<rdf:Description rdf:about="&a;108889532"
	 b:glossaryEntry="large fan palms of tropical Asia to Australia"/>
<rdf:Description rdf:about="&a;108889704">
	<b:glossaryEntry>large-leaved palm of Malay to Philippines and northern Australia; leaves used for thatching or plaiting into containers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108889933">
	<b:glossaryEntry>tall palm of southern India and Sri Lanka with gigantic leaves used as umbrellas and fans or cut into strips for writing paper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108890209"
	 b:glossaryEntry="oil palms"/>
<rdf:Description rdf:about="&a;108890324">
	<b:glossaryEntry>pinnate-leaved palms of the genus Elaeis having dense clusters of crowded flowers and bright red fruit and yielding high quality palm oils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108890591"
	 b:glossaryEntry="oil palm of Africa"/>
<rdf:Description rdf:about="&a;108890692"
	 b:glossaryEntry="palm of Central and South America"/>
<rdf:Description rdf:about="&a;108890807"
	 b:glossaryEntry="see o any oil palm"/>
<rdf:Description rdf:about="&a;108890932">
	<b:glossaryEntry>a monocotyledonous genus of graceful palm trees in tropical America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108891107">
	<b:glossaryEntry>Brazilian palm of genus Euterpe whose leaf buds are eaten like cabbage when young</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108891285"
	 b:glossaryEntry="fan palms of Asia and Australia and Malaysia"/>
<rdf:Description rdf:about="&a;108891441"
	 b:glossaryEntry="Australian palm with leaf buds that are edible when young"/>
<rdf:Description rdf:about="&a;108891613">
	<b:glossaryEntry>a genus of Malayan pinnate-leaved palm trees that flower and fruit once and then die</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108891792">
	<b:glossaryEntry>Malaysian palm whose pithy trunk yields sago--a starch used as a food thickener and fabric stiffener; Malaya to Fiji</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108891987"
	 b:glossaryEntry="monotypic genus of palms of Australasia"/>
<rdf:Description rdf:about="&a;108892148">
	<b:glossaryEntry>any creeping semiaquatic feather palm of the genus Nipa found in mangrove swamps and tidal estuaries; its sap is used for a liquor; leaves are used for thatch; fruit has edible seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108892441">
	<b:glossaryEntry>palms of southern Mexico to northern South America: babassu palm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108892634">
	<b:glossaryEntry>tall feather palm of northern Brazil with hard-shelled nuts yielding valuable oil and a kind of vegetable ivory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108892929"
	 b:glossaryEntry="hard-shelled nut of the babassu palm"/>
<rdf:Description rdf:about="&a;108893061">
	<b:glossaryEntry>fatty oil from kernels of babassu nuts similar to coconut oil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108893212">
	<b:glossaryEntry>tropical American feather palm whose large nuts yield valuable oil and a kind of vegetable ivory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108893431">
	<b:glossaryEntry>nut of the cohune palm having hard white shells like those of ivory nuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108893598">
	<b:glossaryEntry>semisolid fat from nuts of the cohune palm; used in cooking and soap making</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108893779"
	 b:glossaryEntry="latanier palm"/>
<rdf:Description rdf:about="&a;108893897">
	<b:glossaryEntry>a large monocotyledonous genus of pinnate-leaved palms found in Asia and Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108894065">
	<b:glossaryEntry>tall tropical feather palm tree native to Syria bearing sweet edible fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108894236"
	 b:glossaryEntry="small genus of South American feather palms"/>
<rdf:Description rdf:about="&a;108894395"
	 b:glossaryEntry="a stemless palm tree of Brazil and Peru bearing ivory nuts"/>
<rdf:Description rdf:about="&a;108894604">
	<b:glossaryEntry>nutlike seed of a South American palm; the hard white shell takes a high polish and is used for e.g. buttons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108894817">
	<b:glossaryEntry>feather palm of tropical Africa and Madagascar and Central and South America widely grown for commercial purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108895060">
	<b:glossaryEntry>a large feather palm of Africa and Madagascar having very long pinnatisect fronds yielding a strong commercially important fiber from its leafstalks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108895376">
	<b:glossaryEntry>fiber of a raffia palm used as light cordage and in making hats and baskets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108895523">
	<b:glossaryEntry>a tall Brazilian feather palm with a terminal crown of very large leathery pinnatisect leaves rising from long strong stems used for structural purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108895770"
	 b:glossaryEntry="a palm of the genus Raffia"/>
<rdf:Description rdf:about="&a;108895872"
	 b:glossaryEntry="genus of small clump-forming fan palms of China and Japan"/>
<rdf:Description rdf:about="&a;108896035">
	<b:glossaryEntry>any of several small palms of the genus Rhapis; cultivated as houseplants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108896219">
	<b:glossaryEntry>small graceful palm with reedlike stems and leaf bases clothed with loose coarse fibers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108896416">
	<b:glossaryEntry>Chinese lady palm with more slender stems and finer sheath fibers than Rhapis excelsa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108896596"
	 b:glossaryEntry="a monocotyledonous genus of West Indian feather palms"/>
<rdf:Description rdf:about="&a;108896780"
	 b:glossaryEntry="tall feather palm of southern Florida and Cuba"/>
<rdf:Description rdf:about="&a;108896920"
	 b:glossaryEntry="West Indian palm with leaf buds that are edible when young"/>
<rdf:Description rdf:about="&a;108897077"
	 b:glossaryEntry="American dwarf fan palms"/>
<rdf:Description rdf:about="&a;108897205">
	<b:glossaryEntry>low-growing fan-leaved palm of coastal southern United States having edible leaf buds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108897404"
	 b:glossaryEntry="one species: saw palmetto"/>
<rdf:Description rdf:about="&a;108897537">
	<b:glossaryEntry>small hardy clump-forming spiny palm of southern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108897711"
	 b:glossaryEntry="small to medium-sized fan palms"/>
<rdf:Description rdf:about="&a;108897869">
	<b:glossaryEntry>small palm of southern Florida and West Indies closely resembling the silvertop palmetto</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108898098"
	 b:glossaryEntry="small stocky fan palm of southern Florida and Cuba"/>
<rdf:Description rdf:about="&a;108898318"
	 b:glossaryEntry="coextensive with the family Plantaginaceae"/>
<rdf:Description rdf:about="&a;108898480">
	<b:glossaryEntry>cosmopolitan family of small herbs and a few shrubs; most are troublesome weeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108898700">
	<b:glossaryEntry>type genus of the family Plantaginaceae; large cosmopolitan genus of mostly small herbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108898897">
	<b:glossaryEntry>any of numerous plants of the genus Plantago; mostly small roadside or dooryard weeds with elliptic leaves and small spikes of very small flowers; seeds of some used medicinally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108899256">
	<b:glossaryEntry>an Old World plantain with long narrow ribbed leaves widely established in temperate regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108899506">
	<b:glossaryEntry>common European perennial naturalized worldwide; a troublesome weed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108899732">
	<b:glossaryEntry>widely distributed Old World perennial naturalized in North America having finely hairy leaves and inconspicuous white fragrant flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108899945">
	<b:glossaryEntry>plantain of Mediterranean regions whose seeds swell and become gelatinous when moist and are used as a mild laxative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108900166">
	<b:glossaryEntry>North American plantain having reddish leafstalks and broad leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108900338">
	<b:glossaryEntry>North American annual or biennial with long soft hairs on the leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108900488"
	 b:glossaryEntry="coextensive with the family Polygonaceae,"/>
<rdf:Description rdf:about="&a;108900645">
	<b:glossaryEntry>a family of plants of order Polygonales chiefly of the north temperate zone; includes the buckwheats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108900959">
	<b:glossaryEntry>diverse genus of herbs or woody subshrubs of north temperate regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108901177">
	<b:glossaryEntry>twining perennial vine having racemes of fragrant greenish flowers; western China to Russia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108901406">
	<b:glossaryEntry>buckwheat; in some classifications included in the genus Polygonum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108901565">
	<b:glossaryEntry>or member of genus Fagopyrum; annual Asian plant with clusters of small pinkish white flowers and small edible triangular seeds which are used whole or ground into flour</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108901873">
	<b:glossaryEntry>annual with broadly ovate leaves and slender drooping spikes of crimson flowers; southeastern Asia and Australia; naturalized in North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108902186"
	 b:glossaryEntry="North American herbs of the buckwheat family"/>
<rdf:Description rdf:about="&a;108902330">
	<b:glossaryEntry>any plant of the genus Eriogonum with small clustered flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108902502">
	<b:glossaryEntry>late-blooming perennial plant of shale barrens of Virginia having flowers in flat-topped clusters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108902680">
	<b:glossaryEntry>low-growing shrub with spreading branches and flowers in loose heads; desert regions of western United States (California to Utah)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108902918"
	 b:glossaryEntry="rhubarb"/>
<rdf:Description rdf:about="&a;108903048">
	<b:glossaryEntry>plants having long green or reddish acidic leafstalks growing in basal clumps; stems (and only the stems) are edible when cooked; leaves are poisonous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108903341"
	 b:glossaryEntry="Asian herb (Himalaya)"/>
<rdf:Description rdf:about="&a;108903516">
	<b:glossaryEntry>long-cultivated hybrid of Rheum palmatum; stems often cooked in pies or as sauce or preserves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108903739"
	 b:glossaryEntry="long used for laxative properties"/>
<rdf:Description rdf:about="&a;108903851">
	<b:glossaryEntry>docks: coarse herbs and shrubs mainly native to north temperate regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108904026">
	<b:glossaryEntry>any of certain coarse weedy plants with long taproots, sometimes used as table greens or in folk medicine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108904295">
	<b:glossaryEntry>European sorrel with large slightly acidic sagittate leaves grown throughout north temperate zone for salad and spring greens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108904527">
	<b:glossaryEntry>small plant having pleasantly acid-tasting arrow-shaped leaves; common in dry places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108904706">
	<b:glossaryEntry>European dock with broad obtuse leaves and bitter rootstock common as a weed in North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108904912">
	<b:glossaryEntry>low perennial with small silvery-green ovate to hastate leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108905086"
	 b:glossaryEntry="an order of monocotyledonous herbs"/>
<rdf:Description rdf:about="&a;108905382">
	<b:glossaryEntry>plants of tropical to temperate regions; usually in wet places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108905586"
	 b:glossaryEntry="chiefly American marsh plants, having usually yellow flowers"/>
<rdf:Description rdf:about="&a;108905750">
	<b:glossaryEntry>any of several rushlike plants, especially of the pine barrens of southern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108905939"
	 b:glossaryEntry="of Australia"/>
<rdf:Description rdf:about="&a;108906032">
	<b:glossaryEntry>large widely distributed family of chiefly perennial herbs or climbers: spiderworts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108906294">
	<b:glossaryEntry>type genus of the Commelinaceae; large genus of herbs of branching or creeping habit: day flower; widow''s tears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108906505"
	 b:glossaryEntry="any plant of the genus Commelina"/>
<rdf:Description rdf:about="&a;108906612"
	 b:glossaryEntry="any plant of the family Commelinaceae"/>
<rdf:Description rdf:about="&a;108906755"
	 b:glossaryEntry="a variety of spiderwort"/>
<rdf:Description rdf:about="&a;108906864"
	 b:glossaryEntry="spiderworts"/>
<rdf:Description rdf:about="&a;108906974">
	<b:glossaryEntry>a family of tropical American plants of order Xyridales including several (as the pineapple) of economic importance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108907265">
	<b:glossaryEntry>a genus of tropical American plants have sword-shaped leaves and a fleshy compound fruits composed of the fruits of several flowers (such as pineapples)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108907523">
	<b:glossaryEntry>a tropical American plant bearing a large fleshy edible fruit with a terminal tuft of stiff leaves; widely cultivated in the tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108907784">
	<b:glossaryEntry>the type genus of the family Bromeliaceae which incudes tropical American plants with deeply cleft calyx</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108907962">
	<b:glossaryEntry>large genus of epiphytic or terrestrial sparse-rooting tropical plants usually forming dense clumps or pendant masses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108908193">
	<b:glossaryEntry>dense festoons of greenish-gray hairlike flexuous strands anchored to tree trunks and branches by sparse wiry roots; southeastern United States and West Indies to South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108908513"
	 b:glossaryEntry="a monocotyledonous family of bog plants of order Xyridales"/>
<rdf:Description rdf:about="&a;108908686">
	<b:glossaryEntry>small genus of delicate mossy bog plants having white or violet flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108908844">
	<b:glossaryEntry>South American herbs somewhat resembling members of the Juncaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108909007"
	 b:glossaryEntry="chiefly tropical aquatic or bog herbs: pipeworts"/>
<rdf:Description rdf:about="&a;108909194">
	<b:glossaryEntry>type genus of the Eriocaulaceae: rushlike aquatic or marginal perennials usually found in shallow waters of acid lakes and pools and bogs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108909445">
	<b:glossaryEntry>aquatic perennial of North America and Ireland and Hebrides having translucent green leaves in a basal spiral and dense buttonlike racemes of minute white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108909704"
	 b:glossaryEntry="aquatic or bog plants"/>
<rdf:Description rdf:about="&a;108909908"
	 b:glossaryEntry="pickerelweed"/>
<rdf:Description rdf:about="&a;108910034">
	<b:glossaryEntry>American plant having spikes of blue flowers and growing in shallow water of streams and ponds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108910252"
	 b:glossaryEntry="water hyacinth; water orchid"/>
<rdf:Description rdf:about="&a;108910394">
	<b:glossaryEntry>a tropical floating aquatic plant having spikes of large blue flowers; troublesome in clogging waterways especially in southern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108910675"
	 b:glossaryEntry="mud plaintains"/>
<rdf:Description rdf:about="&a;108910807">
	<b:glossaryEntry>grassy-leaved North American aquatic plant with yellow star-shaped blossoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108911000"
	 b:glossaryEntry="an order of aquatic monocotyledonous herbaceous plants"/>
<rdf:Description rdf:about="&a;108911310">
	<b:glossaryEntry>monotypic family of aquatic plants having narrow leaves and small flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108911546"
	 b:glossaryEntry="sole genus of the family Naiadaceae"/>
<rdf:Description rdf:about="&a;108911707">
	<b:glossaryEntry>submerged aquatic plant having narrow leaves and small flowers; of fresh or brackish water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108911882"
	 b:glossaryEntry="perennial or annual aquatic or marsh plants"/>
<rdf:Description rdf:about="&a;108912087"
	 b:glossaryEntry="small genus of aquatic or semiaquatic plants"/>
<rdf:Description rdf:about="&a;108912237">
	<b:glossaryEntry>marsh plant having clusters of small white or pinkish flowers and broad pointed or rounded leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108912477">
	<b:glossaryEntry>genus of aquatic herbs of temperate and tropical regions having sagittate or hastate leaves and white scapose flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108912707"
	 b:glossaryEntry="a weed"/>
<rdf:Description rdf:about="&a;108912776"
	 b:glossaryEntry="a variety of water plantain"/>
<rdf:Description rdf:about="&a;108912878"
	 b:glossaryEntry="a variety of water plantain"/>
<rdf:Description rdf:about="&a;108912980">
	<b:glossaryEntry>simple nearly stemless freshwater aquatic plants; widely distributed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108913352"
	 b:glossaryEntry="frogbit"/>
<rdf:Description rdf:about="&a;108913475">
	<b:glossaryEntry>European floating plant with roundish heart-shaped leaves and white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108913663"
	 b:glossaryEntry="1 species"/>
<rdf:Description rdf:about="&a;108913771">
	<b:glossaryEntry>submersed plant with whorled lanceolate leaves and solitary axillary flowers; Old World plant naturalized in southern United States and clogging Florida''s waterways</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108914033"
	 b:glossaryEntry="American frogbit"/>
<rdf:Description rdf:about="&a;108914161">
	<b:glossaryEntry>American plant with roundish heart-shaped or kidney-shaped leaves; usually rooted in muddy bottoms of ponds and ditches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108914382"
	 b:glossaryEntry="submerged freshwater perennials"/>
<rdf:Description rdf:about="&a;108914542"
	 b:glossaryEntry="a weedy aquatic plant of genus Elodea"/>
<rdf:Description rdf:about="&a;108914690"
	 b:glossaryEntry="North American; widely naturalized in Europe"/>
<rdf:Description rdf:about="&a;108914818">
	<b:glossaryEntry>aquatic plant with deep green foliage useful as an aquarium oxygenator; sometimes placed in genus Egeria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108915018"
	 b:glossaryEntry="small genus of dioecious tropical aquatic plants"/>
<rdf:Description rdf:about="&a;108915153"
	 b:glossaryEntry="eelgrass; eel grass"/>
