<rdf:Description rdf:about="&a;201105694"
	 b:glossaryEntry='cover like a mantle: "The ivy mantles the building"'/>
<rdf:Description rdf:about="&a;201105809"
	 b:glossaryEntry='of liquids; "Blood oozed through the bandage"'/>
<rdf:Description rdf:about="&a;201105950"
