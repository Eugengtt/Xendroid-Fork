	 b:glossaryEntry="an ancient Assyrian city"/>
<rdf:Description rdf:about="&a;106518544"
	 b:glossaryEntry="an ancient Assyrian city"/>
<rdf:Description rdf:about="&a;106518641">
	<b:glossaryEntry>an ancient maritime country (a collection of city states) at eastern end of the Mediterranean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106518839">
