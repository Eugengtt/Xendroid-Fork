	 b:glossaryEntry="countries occupying Scandinavia"/>
<rdf:Description rdf:about="&a;106402554"
	 b:glossaryEntry="a country on the Balkan Peninsula"/>
<rdf:Description rdf:about="&a;106402852"
	 b:glossaryEntry="countries occupying the African continent"/>
<rdf:Description rdf:about="&a;106403819">
	<b:glossaryEntry>a country in southwestern Africa (formerly called South West Africa); the greater part of Namibia form part of the high plateau of South Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106404073"
	 b:glossaryEntry="countries occupying the Asian continent"/>
<rdf:Description rdf:about="&a;106404908"
	 b:glossaryEntry="an ancient country in west central Asia Minor"/>
<rdf:Description rdf:about="&a;106405026">
	<b:glossaryEntry>a peninsula in southwestern Asia that forms the Asian part of Turkey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106405352"
	 b:glossaryEntry="countries occupying the South American continent"/>
<rdf:Description rdf:about="&a;106405728"
	 b:glossaryEntry="a country on the North American continent"/>
<rdf:Description rdf:about="&a;106405953">
	<b:glossaryEntry>countries occupying Central America; except for Belize and Costa Rica these countries are characterized by low per capita income and unstable governments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106406348">
	<b:glossaryEntry>a mountainous country in central Asia; bordered by Iran to the west and Russia to the north and Pakistan to the east and south; "Soviet troops invaded Afghanistan in 1979"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106406653">
	<b:glossaryEntry>the capital and largest city of Afghanistan; located in eastern Afghanistan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106406824">
	<b:glossaryEntry>an uncertain region on the east shore of the Adriatic where an ancient Indo-European people once lived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106406980">
	<b:glossaryEntry>a republic in southeastern Europe on the Adriatic coast of the Balkan Peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106407151"
	 b:glossaryEntry="the capital and largest city of Albania"/>
<rdf:Description rdf:about="&a;106407281">
	<b:glossaryEntry>a republic in northwestern Africa; colonized by France in the 19th century but gained autonomy in the early 1960s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106407572">
	<b:glossaryEntry>an ancient port on the Mediterranean; the capital and largest city of Algeria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106407741">
	<b:glossaryEntry>a port in northwestern Algeria and the country''s 2nd largest city</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106407876"
	 b:glossaryEntry="a republic in southwestern Africa on the Atlantic coast"/>
<rdf:Description rdf:about="&a;106408060">
	<b:glossaryEntry>the capital and largest city of Angola; achieved independence from Portugal in 1976 and has since been the scene of civil war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106408275"
	 b:glossaryEntry="a British colony in the West Indies"/>
<rdf:Description rdf:about="&a;106408384">
	<b:glossaryEntry>a British colony in the Caribbean northwest of Jamaica; an international banking center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106408570"
	 b:glossaryEntry="the capital of the Cayman Islands"/>
<rdf:Description rdf:about="&a;106408680"
	 b:glossaryEntry="a country in the northern Leeward Islands"/>
<rdf:Description rdf:about="&a;106408901"
	 b:glossaryEntry="the largest of the islands comprising Antigua and Barbuda"/>
