	 b:glossaryEntry='appearance with regard to color: "her healthy coloration"'/>
<rdf:Description rdf:about="&a;103889169">
	<b:glossaryEntry>coloring of the hair: "her hair-coloring was unusual: a very pale gold"</b:glossaryEntry>
</rdf:Description>
