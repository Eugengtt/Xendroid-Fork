</rdf:Description>
<rdf:Description rdf:about="&a;200266225"
	 b:glossaryEntry="transform into gold"/>
<rdf:Description rdf:about="&a;200266308"
	 b:glossaryEntry="alter in nature; of chemical elements in alchemy"/>
<rdf:Description rdf:about="&a;200266431">
	<b:glossaryEntry>change or alter in form, appearance, or nature; "This experience transformed her completely"; "She transformed the clay into a beautiful sculpture"</b:glossaryEntry>
