	 b:glossaryEntry="an arm of the Pacific between China and Japan"/>
<rdf:Description rdf:about="&a;106809202"
	 b:glossaryEntry="an arm of the Pacific east of Asia"/>
<rdf:Description rdf:about="&a;106809316"
	 b:glossaryEntry="part of the Pacific off the east coast of Asia"/>
