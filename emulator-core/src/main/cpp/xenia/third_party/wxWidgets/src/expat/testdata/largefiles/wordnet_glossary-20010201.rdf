	 b:glossaryEntry="pungent Old World weedy plant"/>
<rdf:Description rdf:about="&a;108737384"
	 b:glossaryEntry="Eastern Asian plant; larger than Allium_schoenoprasum"/>
<rdf:Description rdf:about="&a;108737568"
	 b:glossaryEntry="Old World leek with a spherical bulb"/>
