	 b:glossaryEntry="type genus of the Mullidae: goatfishes"/>
<rdf:Description rdf:about="&a;102090054"
	 b:glossaryEntry="brightly colored tropical fishes with chin barbels"/>
<rdf:Description rdf:about="&a;102090259"
	 b:glossaryEntry="body bright scarlet with 2 yellow to reddish strips on side"/>
<rdf:Description rdf:about="&a;102090413"
	 b:glossaryEntry="a genus of Mullidae"/>
<rdf:Description rdf:about="&a;102090554"
	 b:glossaryEntry="schooling goatfish; grayish with yellow stripe"/>
<rdf:Description rdf:about="&a;102090709">
	<b:glossaryEntry>fishes distinguished by abdominal pelvic fins: families Mugilidae; Atherinidae; Sphyraenidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102090956"
	 b:glossaryEntry="gray mullets"/>
