<rdf:Description rdf:about="&a;201603572">
	<b:glossaryEntry>cause to be admitted; of persons to an institution; "After the second episode, she had to be committed"; "he was committed to prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201603822">
	<b:glossaryEntry>admit into a hospital; "Mother had to be hospitalized because her blood pressure was too high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201603985">
	<b:glossaryEntry xml:space='preserve'><![CDATA[To confer a trust upon; "The messenger was entrusted with the general''s secret"; "I commit my soul to God"]]></b:glossaryEntry>
</rdf:Description>
