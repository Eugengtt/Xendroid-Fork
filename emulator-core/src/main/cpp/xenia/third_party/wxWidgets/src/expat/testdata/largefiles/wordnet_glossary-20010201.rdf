<rdf:Description rdf:about="&a;400255606"
	 b:glossaryEntry="in proportion"/>
<rdf:Description rdf:about="&a;400255692"
	 b:glossaryEntry='without paying rent; "I can live here rent-free"'/>
<rdf:Description rdf:about="&a;400255778">
