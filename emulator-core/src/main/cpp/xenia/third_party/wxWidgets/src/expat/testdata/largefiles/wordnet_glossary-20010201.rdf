<rdf:Description rdf:about="&a;400286377"
	 b:glossaryEntry='in a shameful manner; "the garden was criminally neglected"'/>
<rdf:Description rdf:about="&a;400286528"
	 b:glossaryEntry='in a coy manner; "she pouted and looked at him coyly"'/>
<rdf:Description rdf:about="&a;400286633">
	<b:glossaryEntry>with the legs crossed; "he sat on the floor cross-legged and meditated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400286745">
	<b:glossaryEntry>with condescension; "he treats his secretary condescendingly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400286902">
	<b:glossaryEntry>in a consecutive manner; "we numbered the papers consecutively"</b:glossaryEntry>
</rdf:Description>
