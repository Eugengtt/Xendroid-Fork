	 b:glossaryEntry="a water ouzel of Europe"/>
<rdf:Description rdf:about="&a;101124519"
	 b:glossaryEntry="a water ouzel of western North America"/>
<rdf:Description rdf:about="&a;101124663"
	 b:glossaryEntry="small insectivorous American songbirds"/>
<rdf:Description rdf:about="&a;101124816"
	 b:glossaryEntry="type genus of the Vireonidae"/>
<rdf:Description rdf:about="&a;101124940">
	<b:glossaryEntry>any of various small insectivorous American birds chiefly olive-gray in color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101125142">
	<b:glossaryEntry>of northern North America having red irises and a olive-gray body with white underparts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101125309">
	<b:glossaryEntry>of eastern North America having a bluish-gray head and mostly green body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101125461">
	<b:glossaryEntry>common vireo of northeastern North America with bluish slaty-gray head</b:glossaryEntry>
</rdf:Description>
