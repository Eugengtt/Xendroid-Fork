	 b:glossaryEntry="terrestrial (hygrophytic) or epiphytic ferns: filmy ferns"/>
<rdf:Description rdf:about="&a;109248124"
	 b:glossaryEntry="type genus of the Hymenophyllaceae: filmy ferns"/>
