</rdf:Description>
<rdf:Description rdf:about="&a;108070596">
	<b:glossaryEntry>large spreading Old World tree having large leaves and globose clusters of greenish-yellow flowers and long seed pods that clatter in the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108070840">
