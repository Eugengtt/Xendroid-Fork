</rdf:Description>
<rdf:Description rdf:about="&a;110749415"
	 b:glossaryEntry="a pale green variety of chrysolite; used as a gemstone"/>
<rdf:Description rdf:about="&a;110749541"
	 b:glossaryEntry="an inorganic compound containing the divalent ion -O-O-"/>
<rdf:Description rdf:about="&a;110749669"
	 b:glossaryEntry="a chemical used to kill pests (as rodents or insects)"/>
<rdf:Description rdf:about="&a;110749886"
	 b:glossaryEntry="any compound obtained from petroleum or natural gas"/>
<rdf:Description rdf:about="&a;110749997"
	 b:glossaryEntry="a dark oil consisting mainly of hydrocarbons"/>
<rdf:Description rdf:about="&a;110750189">
