	 b:glossaryEntry="the pitch range of the highest female voice"/>
<rdf:Description rdf:about="&a;103896558"
	 b:glossaryEntry="the pitch range of the highest male voice"/>
<rdf:Description rdf:about="&a;103896651"
	 b:glossaryEntry='pitch of the voice; "he spoke in a low key"'/>
<rdf:Description rdf:about="&a;103896744"
	 b:glossaryEntry="a pitch that is perceived as below other pitches"/>
<rdf:Description rdf:about="&a;103896936"
	 b:glossaryEntry="a low pitch that is loud and voluminous"/>
<rdf:Description rdf:about="&a;103897030"
	 b:glossaryEntry="the pitch range of the lowest female voice"/>
<rdf:Description rdf:about="&a;103897123"
	 b:glossaryEntry="the lowest part of the musical range"/>
<rdf:Description rdf:about="&a;103897210">
	<b:glossaryEntry>(linguistics) a pitch or change in pitch of the voice that serves to distinguish words in tonal languages; "the Beijing dialect uses four tones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103897405">
	<b:glossaryEntry>the distinctive property of a complex sound (a voice or noise or musical sound); "the timbre of her soprano was rich and lovely"; "the muffled tones of the broken bell summoned them to meet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103897800">
	<b:glossaryEntry>the timbre of a musical sound; "the recording fails to capture the true color of the original music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103897961"
	 b:glossaryEntry="harsh or rough to the ear"/>
<rdf:Description rdf:about="&a;103898072"
	 b:glossaryEntry="a throaty harshness"/>
<rdf:Description rdf:about="&a;103898172"
	 b:glossaryEntry="the property of a sound that has a rich and pleasing timbre"/>
