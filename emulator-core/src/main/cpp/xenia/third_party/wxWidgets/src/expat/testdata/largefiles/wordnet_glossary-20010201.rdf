	 b:glossaryEntry='become popular; "This fashion caught on in paris"'/>
<rdf:Description rdf:about="&a;200379987">
	<b:glossaryEntry>grow emotionally or mature; "The child developed beautifully in her new kindergarten"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200380188">
	<b:glossaryEntry>grow too large or too mature for; "I have outgrown these clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200380326"
	 b:glossaryEntry='make turbid; "muddy the water"'/>
<rdf:Description rdf:about="&a;200380419"
	 b:glossaryEntry="subject to a mathematical transformation"/>
<rdf:Description rdf:about="&a;200380526">
	<b:glossaryEntry>heat by a natural force; "The sun broils the valley in the summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200380670"
	 b:glossaryEntry='heat again; "Please reheat the food from last night"'/>
<rdf:Description rdf:about="&a;200380794"
	 b:glossaryEntry='cook in a simmering liquid; "poached apricots"'/>
<rdf:Description rdf:about="&a;200380903">
	<b:glossaryEntry>raise in rank or condition: "The new law lifted many people from poverty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200381090">
	<b:glossaryEntry xml:space='preserve'><![CDATA[raise in rank, character, or status; "exalted the humble shoemaker to the rank of King''s adviser"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200381258">
	<b:glossaryEntry>change quickly from one emotional state to another: "fly into a rage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200381389">
	<b:glossaryEntry>make harsh or harsher; "Winter harshened the look of the city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200381524">
	<b:glossaryEntry>gradually acquire new traits or characteristics: "Children must develop a sense of right and wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200381705"
	 b:glossaryEntry='develop into: "He will make a splendid father!"'/>
<rdf:Description rdf:about="&a;200381814"
	 b:glossaryEntry="flow forth, as of water"/>
<rdf:Description rdf:about="&a;200381912">
	<b:glossaryEntry>proceed or issue forth, as from a source; "Water emanates from this hole in the ground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200382082"
	 b:glossaryEntry="lose daylight visibility in heavy fog, snow, or rain"/>
<rdf:Description rdf:about="&a;200382201"
	 b:glossaryEntry="make dingy"/>
<rdf:Description rdf:about="&a;200382282"
	 b:glossaryEntry='make a dent or impression in; "dinge a soft hat"'/>
<rdf:Description rdf:about="&a;200382402"
	 b:glossaryEntry='grow louder, of sound; "The music crescendoes here"'/>
<rdf:Description rdf:about="&a;200382538"
	 b:glossaryEntry='grow quieter, of sound; "The music decrescendoes here"'/>
<rdf:Description rdf:about="&a;200382679">
	<b:glossaryEntry>change into a sibilant; "In the syllable /si/, the /s/ sibilates in Japanese"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200382824"
	 b:glossaryEntry="become smooth"/>
<rdf:Description rdf:about="&a;200382903"
	 b:glossaryEntry='make into a demon; "Power had demonized him"'/>
<rdf:Description rdf:about="&a;200383013"
	 b:glossaryEntry='turn into a devil or make devilish; "Man devilized by war"'/>
<rdf:Description rdf:about="&a;200383149"
	 b:glossaryEntry="make ethereal"/>
<rdf:Description rdf:about="&a;200383231"
	 b:glossaryEntry="render immaterial or incorporeal"/>
<rdf:Description rdf:about="&a;200383371"
	 b:glossaryEntry='give life-like qualities to; "animated cartoons"'/>
<rdf:Description rdf:about="&a;200383502"
	 b:glossaryEntry='"Her old vigor returned"'/>
<rdf:Description rdf:about="&a;200383616">
	<b:glossaryEntry>as of teeth, for example; "The tooth erupted and had to be extracted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200383808">
	<b:glossaryEntry>become hostile towards; "The dog suddenly turned on the mailman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200383957">
	<b:glossaryEntry>change from one level to another; "She dropped into army jargon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200384091"
	 b:glossaryEntry='"The tourists murdered the French language"'/>
<rdf:Description rdf:about="&a;200384218"
	 b:glossaryEntry='"shift the date"'/>
<rdf:Description rdf:about="&a;200384297">
	<b:glossaryEntry>change from one state to another; "run amok"; "run rogue", "run riot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200384451">
	<b:glossaryEntry>make clear, bright, light, or translucent; "The water had to be cleared through filtering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200384612">
	<b:glossaryEntry>change pace; "The dancers broke into a cha-cha"; "The horse broke into a gallop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200384768">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make unnecessary an expenditure or effort; "This will save money"; "I''ll save you the trouble"; "This will save you a lot of time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200384987">
	<b:glossaryEntry xml:space='preserve'><![CDATA[direct one''s interest or attention towards; go into; "The pedophile turned to boys for satisfaction"; "People turn to mysticism at the turn of a millenium"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200385197">
	<b:glossaryEntry>"This project developed into a nightmare"; "The nice girl he had married grew into a shrew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200385378"
	 b:glossaryEntry='invigorate or heighten; "lift my spirits", "lift his ego"'/>
<rdf:Description rdf:about="&a;200385513">
	<b:glossaryEntry>lay aside, abandon, or leave for another; "switch to a different brand of beer"; "She switched psychiatrists"; "The car changed lanes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200385870">
	<b:glossaryEntry>become deeper in tone; "His voice began to change when he was 12 years old"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200386000">
	<b:glossaryEntry>change suddenly from one tone quality or register to another; "Her voice broke to a whisper when she started to talk about her children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200386199"
	 b:glossaryEntry="switch channels, on television"/>
<rdf:Description rdf:about="&a;200386306"
	 b:glossaryEntry="make effective, as of a drug"/>
<rdf:Description rdf:about="&a;200386400"
	 b:glossaryEntry="make more dynamic"/>
<rdf:Description rdf:about="&a;200386499"
	 b:glossaryEntry="become concrete, as of an idea in the mind"/>
<rdf:Description rdf:about="&a;200386609"
	 b:glossaryEntry="make more subtle or refined"/>
<rdf:Description rdf:about="&a;200386724"
	 b:glossaryEntry="make volatile; cause to pass off in a vapor"/>
<rdf:Description rdf:about="&a;200386843"
	 b:glossaryEntry="make uniform"/>
<rdf:Description rdf:about="&a;200386939"
	 b:glossaryEntry="make symmetric"/>
<rdf:Description rdf:about="&a;200387029"
	 b:glossaryEntry="undergo decay or decomposition"/>
<rdf:Description rdf:about="&a;200387176"
	 b:glossaryEntry="make famous for ever"/>
<rdf:Description rdf:about="&a;200387297">
	<b:glossaryEntry>transpose and remain equal in value; of variables or operators, in mathematics; "These operators commute with each other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200387503"
	 b:glossaryEntry="become fused"/>
<rdf:Description rdf:about="&a;200387583">
	<b:glossaryEntry>make (alcohol) unfit for drinking without impairing usefulness for other purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200387730">
	<b:glossaryEntry>modify (as a native protein) esp. by heat, acid, alkali, or ultraviolet radiation so that all of the original properties are removed or diminished</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200387942">
	<b:glossaryEntry>add nonfissionable material to (fissionable material) so as to make unsuitable for use in an atomic bomb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200388112">
	<b:glossaryEntry>throw into disorder; "This event disrupted the orderly process"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200388246">
	<b:glossaryEntry>make less offensive or more acceptable by removing objectionable features; "sanitize a document before releasing it to the press"; "sanitize history"; "sanitize the language in a book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200388496">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make into a verb; "`mouse''" has been verbified" by computer users"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200388627">
	<b:glossaryEntry>incorporate (attitudes or ideas) into one''s personality unconsciously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200388763">
	<b:glossaryEntry>increase in size, magnitude, number, or intensity; "The music swelled to a crescendo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200388919">
	<b:glossaryEntry>transfer from one place or period to another; "The ancient Greek story was transplanted into Modern America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200389126">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move from one setting or context to another; "shift the emphasis"; "shift one''s attention"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200389297"
	 b:glossaryEntry='change in quality; "His tone shifted"'/>
<rdf:Description rdf:about="&a;200389405">
	<b:glossaryEntry>remove with or as if with a brush; "brush away the crumbs" ; "brush aside the objections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200389557">
	<b:glossaryEntry>cause to undergo a process in which atoms are removed: "The solar wind protons must sputter away the surface atoms of the dust"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200389749"
	 b:glossaryEntry='as of electronic signals; "mixing sounds"'/>
<rdf:Description rdf:about="&a;200389851">
	<b:glossaryEntry>convert the genetic information in (a strand of DNA) into a strand of RNA, esp. messenger RNA; in biochemistry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200390029">
	<b:glossaryEntry>bring or lead someone to a certain action or condition; "She was drawn to despair"; "The President refused to be drawn into delivering an ultimatum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200390255">
	<b:glossaryEntry>change from one form into another; "make water into wine"; "make lead into gold"; "make clay into bricks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200390422">
	<b:glossaryEntry>add impurities to (a semiconductor) in order to produce or modify its properties; in electronics: "The resistors have been doped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200390613">
	<b:glossaryEntry>change drastically "his mood swings"; "the market is swinging up and down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200390768"
	 b:glossaryEntry='be seized in a specified way; "take sick", "be taken drunk"'/>
<rdf:Description rdf:about="&a;200390889">
	<b:glossaryEntry>bring (a surface, a design, etc.) into relief and cause to project; "raised edges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200391042">
	<b:glossaryEntry>remove by the application of water or other liquid and soap or some other cleaning agent: "he washed the dirt from his coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200391251">
	<b:glossaryEntry>become quiet or less intensive; "the fighting lulled for a moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200391391"
	 b:glossaryEntry='render helpless or defenseless; "They prostrated the enemy"'/>
<rdf:Description rdf:about="&a;200391525"
	 b:glossaryEntry='develop further; "We are advancing technology every day"'/>
<rdf:Description rdf:about="&a;200391654">
	<b:glossaryEntry>come into being; "light broke over the horizon"; "Voices broke in the air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200391791">
	<b:glossaryEntry>become resolved, fixed, established, or quiet; "The roar settled to a thunder"; "The wind settled in the West"; "it is settling to rain"; "A cough settled in her chest"; "Her mood settled into lethargy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200392081"
	 b:glossaryEntry='produce a magnetic field in; "excite the neurons"'/>
<rdf:Description rdf:about="&a;200392202"
	 b:glossaryEntry='raise to a higher energy level; "excite the atoms"'/>
<rdf:Description rdf:about="&a;200392335">
	<b:glossaryEntry>become injured, broken, or distorted by pressure; "The plastic bottle crushed against the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200392502">
	<b:glossaryEntry>bring to a specified condition by or as if by shaking; "He was shaken from his dreams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200392659">
	<b:glossaryEntry>make unfashionable, outdated, or obsolete; "Modern ways of cooking have outmoded the hearth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200392824">
	<b:glossaryEntry>make more interesting or flavorful, either in the literal or in a metaphorical sense; "Spice the soup"; "Spice up the evening by inviting a belly dancer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200393066">
	<b:glossaryEntry>prove insufficient; "The water supply for the town failed after a long drought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200393210">
	<b:glossaryEntry>pass abruptly from one state or topic to another; "leap into fame"; "jump to a conclusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200393378"
	 b:glossaryEntry="shift to a counterclockwise direction, of the wind"/>
<rdf:Description rdf:about="&a;200393490">
	<b:glossaryEntry>make short or shorter; "shorten the skirt"; "shorten the rope by a few inches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200393651">
	<b:glossaryEntry>shorten as if by severing the edges or ends of; "cut my hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200393809"
	 b:glossaryEntry='be cast down; "his eyes fell"'/>
<rdf:Description rdf:about="&a;200393900">
	<b:glossaryEntry>assume a disappointed or sad expression; "Her face fell when she heard that she would be laid off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200394060"
	 b:glossaryEntry='become used up; be exhausted; "Our supplies finally ran out"'/>
<rdf:Description rdf:about="&a;200394186">
	<b:glossaryEntry>exhaust the supply of; "We ran out of time just as the discussion was getting interesting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200394359">
	<b:glossaryEntry>bring into a given condition by mental preoccupation; "She thought herself into a state of panic over the final exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200394539"
	 b:glossaryEntry='favor the development of; "Practice makes the winner"'/>
<rdf:Description rdf:about="&a;200394654"
	 b:glossaryEntry='cause to be enjoyable or pleasurable; "make my day"'/>
<rdf:Description rdf:about="&a;200394775">
	<b:glossaryEntry>reduce or cut back the amount or availability of, creating a decline in value or prices; "deflate the currency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200394977">
	<b:glossaryEntry>increase the amount or availability of, creating a rise in value; "inflate the currency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200395156">
	<b:glossaryEntry>produce deflation in; "The new measures deflated the economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200395300">
	<b:glossaryEntry>cause prices to rise by increasing the available currency or credit; "The war inflated the economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200395482">
	<b:glossaryEntry>divide (a disk) into marked sectors so that it may store data; "Please format this disk before entering data!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200395669">
	<b:glossaryEntry>put into digital form; "She bought device to digitize the data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200395807"
	 b:glossaryEntry="undergo hydrolysis; decompose by reacting with water"/>
<rdf:Description rdf:about="&a;200395938">
	<b:glossaryEntry>cause to undergo hydrolysis ;make a compound react with water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200396086"
	 b:glossaryEntry='become folded; "The bed folds in a jiffy"'/>
<rdf:Description rdf:about="&a;200396217">
	<b:glossaryEntry xml:space='preserve'><![CDATA[become wrinkled or crumpled or creased; "This fabric won''t wrinkle"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200396387">
	<b:glossaryEntry>convert into gelatinous form or jelly; "hot water will gelatinize starch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200396554">
	<b:glossaryEntry>become gelatinous or change into a jelly; "the starch gelatinized when it was heated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200396725"
	 b:glossaryEntry="coat with gelatin"/>
<rdf:Description rdf:about="&a;200396818">
	<b:glossaryEntry>change texture so as to become matted and felt-like; "The fabric felted up after several washes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200397001"
	 b:glossaryEntry="cause genetic recombination"/>
<rdf:Description rdf:about="&a;200397095"
	 b:glossaryEntry="undergo genetic recombination"/>
<rdf:Description rdf:about="&a;200397191">
	<b:glossaryEntry>get the meaning of something; "Do you comprehend the meaning of this letter?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200397486">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to try to avoid detection esp. by police; "After we knock off that liquor store we''ll have to lay low for a while."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200397666">
	<b:glossaryEntry>know and comprehend the nature or meaning of; "She did not understand her husband"; "I understand what she means"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200398033">
	<b:glossaryEntry>grasp the meaning; "Can you follow her argument?" "When he lectures, I cannot follow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200398198">
	<b:glossaryEntry xml:space='preserve'><![CDATA[grasp with the mind; "did you catch that allusion?"; "We caught something of his theory in the lecture"; " don''t catch your meaning"; "did you get it?" "She didn''t get the joke"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200398480">
	<b:glossaryEntry xml:space='preserve'><![CDATA[understand (informal); "He didn''t figure her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200398597"
	 b:glossaryEntry="understand, usually after some initial difficulty"/>
<rdf:Description rdf:about="&a;200398787"
	 b:glossaryEntry='comprehend; "He could not touch the meaning of the poem"'/>
<rdf:Description rdf:about="&a;200398906"
	 b:glossaryEntry="know or grasp by intuition or feeling"/>
<rdf:Description rdf:about="&a;200399015">
	<b:glossaryEntry>arrange and integrate in the mind; "I cannot digest all this information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200399152">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perceive mentally, as of an idea; "Now I see!"; "I just can''t see your point"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200399347">
	<b:glossaryEntry>become conscious of; "She finally perceived the futility of her protest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200399493">
	<b:glossaryEntry>become clear suddenly; "It dawned on him that she had betrayed him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200399709"
	 b:glossaryEntry="be received or understood"/>
<rdf:Description rdf:about="&a;200399840">
	<b:glossaryEntry>create an emotional response: "The music struck a chord with the listeners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200399995">
	<b:glossaryEntry>be fully aware of; realize fully; "Do you appreciate the full meaning of this letter?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200400180">
	<b:glossaryEntry>show due and full appreciation; "The diners did the food and wine justice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200400338">
	<b:glossaryEntry xml:space='preserve'><![CDATA[consider reasonable or due; "I''m expecting a full explanation as to why these files were destroyed"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200400501"
	 b:glossaryEntry='discern; "His greed knew no limits"'/>
<rdf:Description rdf:about="&a;200400668"
	 b:glossaryEntry="acknowledge a new land owner as one''s landlord, of tenants"/>
<rdf:Description rdf:about="&a;200400790"
	 b:glossaryEntry="concede the loss or worthlessness of something or somebody"/>
<rdf:Description rdf:about="&a;200400923">
	<b:glossaryEntry>believe to be the case; "I understand you have no previous experience?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200401079">
	<b:glossaryEntry>gain knowledge of (an area not known or experienced) by extrapolating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200401225">
	<b:glossaryEntry>make sense of a language; "She understands French"; "Can you read Greek?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200401413">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be understanding of; "You don''t need to explain--I understand!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200401559">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be familiar or acquainted with a person or an object; "She doesn''t know this composer"; "Do you know my sister?" "We know this movie"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200401762">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be cognizant or aware of a fact or a specific piece of information; possess knowledge or information about; "I know that the President lied to the people"; "I want to know who is winning the game!"; "I know it''s time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200402103"
	 b:glossaryEntry="be ignorant of or in the dark about"/>
<rdf:Description rdf:about="&a;200402210">
	<b:glossaryEntry>be aware of the truth of something; have a belief or faith in something; regard as true beyond any doubt; "I know that I left the key on the table"; "Galileo knew that the earth moves around the sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200402497">
	<b:glossaryEntry>know how to do or perform something; "She knows how to knit"; "Does your husband know how to cook?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200402658">
	<b:glossaryEntry>have fixed in the mind; "I know Latin"; "This student knows her irregular verbs"; "Do you know the poem well anough to recite it?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200402832"
	 b:glossaryEntry="be well-informed"/>
<rdf:Description rdf:about="&a;200402992">
	<b:glossaryEntry>have firsthand knowledge of states, situations, emotions, or sensations; "I know the feeling!" "have you ever known hunger?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200403216">
	<b:glossaryEntry>experience again, often in the imagination; "He relived the horrors of war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200403367">
	<b:glossaryEntry>have a firm understanding or knowledge of; be on top of; "Do you control these data?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200403563">
	<b:glossaryEntry>be or become completely proficient or skilled in; "She mastered Japanese in less than two years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200403772">
	<b:glossaryEntry>acquire or gain knowledge or skills; "She learned dancing from her sister"; "I learned Sanskrit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200404017">
	<b:glossaryEntry>learn something again, as after having forgotten or neglected it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200404146"
	 b:glossaryEntry="discard something previously learnt, like an old habit"/>
<rdf:Description rdf:about="&a;200404273"
	 b:glossaryEntry="try to forget; put out of one''s memory or knowledge"/>
<rdf:Description rdf:about="&a;200404397"
	 b:glossaryEntry="learn belatedly; find out about something after it happened"/>
<rdf:Description rdf:about="&a;200404522">
	<b:glossaryEntry>get to know or become aware of; "I learned that she has two grown-up children"; "I see that you have been promoted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200404890"
	 b:glossaryEntry='get wise to; "They wised up to it"'/>
<rdf:Description rdf:about="&a;200404997"
	 b:glossaryEntry="cause someone to become aware of something"/>
<rdf:Description rdf:about="&a;200405112">
	<b:glossaryEntry>detect a blunder or misstep: "The reporter tripped up the senator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200405251">
	<b:glossaryEntry>be a student of a certain subject; "She is reading for the bar exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200405440"
	 b:glossaryEntry="attend academic courses without getting credit"/>
<rdf:Description rdf:about="&a;200405557">
	<b:glossaryEntry>engage or engross wholly; "Her interest in butterflies absorbs her completely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200405771">
	<b:glossaryEntry>occupy or engage the interest of; "His story completely involved me during the entire afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200405932">
	<b:glossaryEntry>engage fully; "The effort to pass the exam consumed all his energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200406072">
	<b:glossaryEntry>engross (oneself) fully; "He immersed himself into his studies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200406271">
	<b:glossaryEntry>cause to be immersed; "The professor plunged his students into the study of the Italian text"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200406438"
	 b:glossaryEntry="be immersed in, as of work"/>
<rdf:Description rdf:about="&a;200406510">
	<b:glossaryEntry>believe or accept without questioning or challenge; "Am I supposed to swallow that story?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200406673"
	 b:glossaryEntry="take up the cause or ideology of (beliefs, tasks, etc.)"/>
<rdf:Description rdf:about="&a;200406840"
	 b:glossaryEntry="adopt, as of ideas"/>
<rdf:Description rdf:about="&a;200406975"
	 b:glossaryEntry="take up, as of knowledge or beliefs"/>
<rdf:Description rdf:about="&a;200407124">
	<b:glossaryEntry>receive into the mind and retain; "Imbibe ethical principles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200407249">
	<b:glossaryEntry>be or work as an apprentice; "She apprenticed with the great master"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200407401"
	 b:glossaryEntry="undergo training or instruction"/>
<rdf:Description rdf:about="&a;200407541">
	<b:glossaryEntry>prepare for a future task or career; "I am training young minds"; "develop leaders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200407789"
	 b:glossaryEntry="train in the military, e.g., in the use of weapons"/>
<rdf:Description rdf:about="&a;200407902"
	 b:glossaryEntry="undergo military training or do military exercises"/>
<rdf:Description rdf:about="&a;200408015"
	 b:glossaryEntry="train (a pet) to live cleanly in a house"/>
<rdf:Description rdf:about="&a;200408123"
	 b:glossaryEntry="train (a small child) to use the toilet"/>
<rdf:Description rdf:about="&a;200408232"
	 b:glossaryEntry="commit to memory; learn by heart"/>
<rdf:Description rdf:about="&a;200408362"
	 b:glossaryEntry="be an understudy or alternate for a role"/>
<rdf:Description rdf:about="&a;200408482">
	<b:glossaryEntry>teach doctrines to; teach uncritically; "The Moonies indoctrinate their disciples"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200408670"
	 b:glossaryEntry="fill with revolutionary ideas"/>
<rdf:Description rdf:about="&a;200408797"
	 b:glossaryEntry="submit to brainwashing; indoctrinate forcibly"/>
<rdf:Description rdf:about="&a;200408909">
	<b:glossaryEntry>study intensively, as before an exam; "I had to bone up on my Latin verbs before the final exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200409147"
	 b:glossaryEntry="learn by repetition"/>
<rdf:Description rdf:about="&a;200409270"
	 b:glossaryEntry="teach by repetition"/>
<rdf:Description rdf:about="&a;200409388"
	 b:glossaryEntry="teach by drills and repetition"/>
<rdf:Description rdf:about="&a;200409517"
	 b:glossaryEntry="teach and impress by frequent repetitions or admonitions"/>
<rdf:Description rdf:about="&a;200409685">
	<b:glossaryEntry>instill (into a person) by constant repetition; "he dinned the lessons into his students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200409835">
	<b:glossaryEntry xml:space='preserve'><![CDATA[force to believe; "I''m trying to drive home these basic ideas"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200409976"
	 b:glossaryEntry='remain committed to; "I hold to these ideas"'/>
<rdf:Description rdf:about="&a;200410090"
	 b:glossaryEntry='learn by reading book; "He is studying geology in his room"'/>
<rdf:Description rdf:about="&a;200410292"
	 b:glossaryEntry="study anew, as for a test"/>
<rdf:Description rdf:about="&a;200410381">
	<b:glossaryEntry>be a student; follow a course of study; be enrolled at an institute of learning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200410531">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have as one''s principal field of study; "She im majoring in linguistics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200410666">
	<b:glossaryEntry xml:space='preserve'><![CDATA[recall knowledge from memory; have a recollection: "I can''t remember saying any such thing"; "I can''t think what her last name was"; "can you remember her phone number?" "Do you remember that he once loved you?"; "call up memories"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200411122"
	 b:glossaryEntry='perceive as familiar; "I know this voice!"'/>
<rdf:Description rdf:about="&a;200411252">
	<b:glossaryEntry>be able to distinguish. recognize as being different; "The child knows right from wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200411402">
	<b:glossaryEntry>know the nature or character of; "we all knew her as a big show-off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200411540">
	<b:glossaryEntry>be capable of conscious thought; "Man is the only creature that thinks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200411656"
	 b:glossaryEntry="pass out of one''s memory"/>
<rdf:Description rdf:about="&a;200411760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be unable to remember; "I''m drawing a blank"; "You are blocking the name of your first wife!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200411976">
	<b:glossaryEntry>be remembered; "His name comes to mind when you mention the strike"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200412112"
	 b:glossaryEntry="keep in mind"/>
<rdf:Description rdf:about="&a;200412253">
	<b:glossaryEntry>keep in mind for attention or consideration; "Remember the Alamo"; "Remember to call your mother every day!"; "Think of the starving children in India!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200412544">
	<b:glossaryEntry xml:space='preserve'><![CDATA[keep in one''s mind; "I cannot retain so much information"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200412665"
	 b:glossaryEntry="dismiss from the mind; stop remembering"/>
<rdf:Description rdf:about="&a;200412827"
	 b:glossaryEntry="perceive to be the same"/>
<rdf:Description rdf:about="&a;200412961"
	 b:glossaryEntry='put in the mind of someone; "Remind me to call Mother"'/>
<rdf:Description rdf:about="&a;200413157">
	<b:glossaryEntry>cause someone to remember the past; "This photo takes me back to the good old days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200413315"
	 b:glossaryEntry='remind or urge constantly; "she nagged to take a vacation"'/>
<rdf:Description rdf:about="&a;200413442">
	<b:glossaryEntry>recall the past; "The grandparents sat there, reminiscing all afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200413589">
	<b:glossaryEntry>recapture the past; indulge in memories; "he remembered how he used to pick flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200413778">
	<b:glossaryEntry>call to remembrance; keep alive the memory of someone or something, as in a ceremony; "We remembered the 50th anniversary of the liberation of Auschwitz"; "Remember the dead of the First World War"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200414046">
	<b:glossaryEntry>exercise, or have the power of, memory; "After the shelling, many people lost the ability to remember"; "some remember better than others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200414250">
	<b:glossaryEntry>be a memorial to a person or an event; "This sculpture commemorates the victims of the concentration camps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200414489"
	 b:glossaryEntry="record or memorialize lastingly with a monument"/>
<rdf:Description rdf:about="&a;200414631"
	 b:glossaryEntry="mark by some ceremony or observation"/>
<rdf:Description rdf:about="&a;200414743"
	 b:glossaryEntry="put out of one''s consciousness; in psychiatry"/>
<rdf:Description rdf:about="&a;200414899"
	 b:glossaryEntry='leave behind; "I forgot my umbrella in the restaurant"'/>
<rdf:Description rdf:about="&a;200415041">
	<b:glossaryEntry>cast aside capriciously or unfeelingly; "jilt a lover or a bride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200415168">
	<b:glossaryEntry>stop maintaining or insisting on; of ideas, claims, etc.; "He abandoned the thought of asking for her hand in marriage"; "Both sides have to give in these negociations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200415444">
	<b:glossaryEntry>leave behind; "She left a mess when she moved out"; "His good luck finally left him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200415625">
	<b:glossaryEntry>leave someone who needs or counts on you; leave in the lurch; "The mother deserted her children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200415894">
	<b:glossaryEntry>leave suddenly, often as an expression of disapproval; "She walked out on her husband and children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200416059">
	<b:glossaryEntry xml:space='preserve'><![CDATA[forget to do something; "Don''t forget to call the chairman of the board to the meeting!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200416229">
	<b:glossaryEntry>leave undone or leave out; "How could I miss that typo?"; "The workers on the conveyor belt miss one out of ten"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200416513"
	 b:glossaryEntry="leave or strike out, as of vowels"/>
<rdf:Description rdf:about="&a;200416622">
	<b:glossaryEntry>prevent from being included or considered or accepted; "The bad results were excluded from the report"; "Leave off the top piece"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200416911"
	 b:glossaryEntry='fail to attend to; "he neglects his children"'/>
<rdf:Description rdf:about="&a;200417029">
	<b:glossaryEntry>be inattentive to, or neglect, as of duties: "He slacks his attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200417162">
	<b:glossaryEntry>bypass; "He skippped a row in the text and so the sentence was incomprehensible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200417335">
	<b:glossaryEntry>get down to; pay attention to; take seriously; "Attend to your duties, please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200417522"
	 b:glossaryEntry="give little attention or respect to"/>
<rdf:Description rdf:about="&a;200417676"
	 b:glossaryEntry='remember incorrectly; "I misremembered the date"'/>
<rdf:Description rdf:about="&a;200417819"
	 b:glossaryEntry="to make a mistake or be incorrect"/>
<rdf:Description rdf:about="&a;200418002"
	 b:glossaryEntry="make an error"/>
<rdf:Description rdf:about="&a;200418110">
	<b:glossaryEntry xml:space='preserve'><![CDATA[identify incorrectly; "Don''t mistake her for her twin sister"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200418258"
	 b:glossaryEntry="consider to be equal or the same"/>
<rdf:Description rdf:about="&a;200418418">
	<b:glossaryEntry>identify as belonging to a certain type; "Such people can practically be typed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200418578">
	<b:glossaryEntry>recognize as being; establish the identity of someone or something; "She identified the man on the "wanted" poster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200418793">
	<b:glossaryEntry>assign a date to; determine the (probable) date of; "Scientists often cannot date precisely archeological or prehistorical findings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200419023"
	 b:glossaryEntry="assign the wrong date to"/>
<rdf:Description rdf:about="&a;200419112">
	<b:glossaryEntry>mistake one thing for another; "you are confusing me with the other candidate"; "I mistook her for the secretary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200419381">
	<b:glossaryEntry xml:space='preserve'><![CDATA[interpret in the wrong way; "Don''t misinterpret my comments as criticism"; "She misconstrued my remarks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200419626"
	 b:glossaryEntry='to hear and understand; "I read you loud and clear!"'/>
<rdf:Description rdf:about="&a;200419748">
	<b:glossaryEntry>cause to be perplexed or confounded; "This problem stumped her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200419883"
	 b:glossaryEntry='mix up or confuse; "He muddled the issues"'/>
<rdf:Description rdf:about="&a;200420006">
	<b:glossaryEntry>make unclear, indistinct, or blurred; "Her remarks confused the debate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200420239">
	<b:glossaryEntry>make unclear or incomprehensible; "The new tax return forms only confuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200420413">
	<b:glossaryEntry>cause to become muddy; "These data would have muddied the prediction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200420545">
	<b:glossaryEntry>make free from confusion or ambiguity; make clear: "Could you clarify these remarks?"; "Clear up the question of who is at fault"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200420871"
	 b:glossaryEntry="read what is implied but not expressed on the surface"/>
<rdf:Description rdf:about="&a;200421020"
	 b:glossaryEntry="try to solve"/>
<rdf:Description rdf:about="&a;200421101">
	<b:glossaryEntry>be confusing or perplexing to; cause to be unable to think clearly: "These questions confuse even the experts"; "This question completely threw me"; "This question befuddled even the teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200421500">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be a mystery or bewildering to: "This beats me!" "Got me--I don''t know the answer!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200421887">
	<b:glossaryEntry>astound or overwhelm; "These poor people are staggered by the drain on their savings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200422037"
	 b:glossaryEntry="set a riddle"/>
<rdf:Description rdf:about="&a;200422121"
	 b:glossaryEntry="make sense of; assign a meaning to"/>
<rdf:Description rdf:about="&a;200422467"
	 b:glossaryEntry='make literal; "literalize metaphors"'/>
<rdf:Description rdf:about="&a;200422589"
	 b:glossaryEntry="give a spiritual meaning to; read in a spiritual sense"/>
<rdf:Description rdf:about="&a;200422731"
	 b:glossaryEntry="assign a new or different meaning to"/>
<rdf:Description rdf:about="&a;200422836"
	 b:glossaryEntry="interpret as an allegory"/>
<rdf:Description rdf:about="&a;200422928">
	<b:glossaryEntry xml:space='preserve'><![CDATA[interpret something in a certain way; convey a particular meaning or impression; "I read this address as a satire"; "How should I take this message?"; You can''t take credit for this!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200423198"
	 b:glossaryEntry='interpret wrongly; "I misread Hamlet all my life!"'/>
<rdf:Description rdf:about="&a;200423328"
	 b:glossaryEntry="form ideals"/>
<rdf:Description rdf:about="&a;200423416">
	<b:glossaryEntry>interpret something that is written or printed; "read the advertisement"; "Have you read Salman Rushdie?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200423761"
	 b:glossaryEntry="read letters out of order to discover a hidden meaning"/>
<rdf:Description rdf:about="&a;200423896"
	 b:glossaryEntry='read anew; read again; "He re-read her letters to him"'/>
<rdf:Description rdf:about="&a;200424014"
	 b:glossaryEntry="read selectively; read only certain passages from a text"/>
<rdf:Description rdf:about="&a;200424136"
	 b:glossaryEntry="select from a list, as of prospective jurors"/>
<rdf:Description rdf:about="&a;200424263"
	 b:glossaryEntry="read with difficulty"/>
<rdf:Description rdf:about="&a;200424350"
	 b:glossaryEntry='read with difficulty; "Can you decipher this letter?"'/>
<rdf:Description rdf:about="&a;200424469">
	<b:glossaryEntry>comprehend; "I cannot make out what this politician is saying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200424597"
	 b:glossaryEntry="convert into intelligible form"/>
<rdf:Description rdf:about="&a;200424702">
	<b:glossaryEntry>look at, interpreted, and say out loud something that is written or printed; "The proclamation will be read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200424940"
	 b:glossaryEntry="read out loud for the purpose of recording"/>
<rdf:Description rdf:about="&a;200425047">
	<b:glossaryEntry xml:space='preserve'><![CDATA[interpret the significance of, as of palms, tea leaves, intestines, the sky, etc.; also of human behavior; "She read the sky and predicted rain"; "I can''t read his strange behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200425290">
	<b:glossaryEntry>obtain data from magnetic tapes; "This dictionary can be read by the computer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200425463"
	 b:glossaryEntry='read or interpret wrongly; "He misread the data"'/>
<rdf:Description rdf:about="&a;200425576"
	 b:glossaryEntry="glance over or read superficially"/>
<rdf:Description rdf:about="&a;200425671">
	<b:glossaryEntry>play or perform music by reading it off the sheet; perform unprepared</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200425816"
	 b:glossaryEntry="read superficially"/>
<rdf:Description rdf:about="&a;200425908"
	 b:glossaryEntry="interpret by lipreading; of deaf people"/>
<rdf:Description rdf:about="&a;200426020"
	 b:glossaryEntry="edit and correct (written or printed material)"/>
<rdf:Description rdf:about="&a;200426161"
	 b:glossaryEntry="read for errors"/>
<rdf:Description rdf:about="&a;200426277">
	<b:glossaryEntry xml:space='preserve'><![CDATA[use or exercise the mind or one''s power of reason in order to make inferences, decisions, or arrive at a solution or judgments; "I''ve been thinking all day and getting nowhere"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200426827"
	 b:glossaryEntry='have or formulate in the mind; "think good thoughts"'/>
<rdf:Description rdf:about="&a;200426942">
	<b:glossaryEntry>consider carefully and rationally; "Every detail has been thought out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200427080"
	 b:glossaryEntry="reason philosophically"/>
<rdf:Description rdf:about="&a;200427187"
	 b:glossaryEntry="try to solve a problem by thinking intensely about it"/>
<rdf:Description rdf:about="&a;200427308">
	<b:glossaryEntry>think about at length and in depth; "I mulled over the events of the afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200427666"
	 b:glossaryEntry="reflect on one''s own thoughts and feelings"/>
<rdf:Description rdf:about="&a;200427776">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expect, believe, or suppose; "I imagine she earned a lot of money with her new novel"; "I thought to find her in a bad state"; "he didn''t think to find her in the kitchen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200428091">
	<b:glossaryEntry>take to be the case or to be true; accept without verification or proof; "I assume his train was late"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200428321"
	 b:glossaryEntry="think logically"/>
<rdf:Description rdf:about="&a;200428444">
	<b:glossaryEntry>to believe especially on uncertain or tentative grounds: "Scientists supposed that large dinosaurs lived in swamps."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200428736"
	 b:glossaryEntry="of past events"/>
<rdf:Description rdf:about="&a;200428867"
	 b:glossaryEntry="construct the history of words"/>
<rdf:Description rdf:about="&a;200428966">
	<b:glossaryEntry>decide by reasoning; draw or come to a conclusion; "We reasoned that it was cheaper to rent than to buy a house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200429256">
	<b:glossaryEntry>find the solution to (a problem or question):"did you solve the problem?"; understand the meaning of; "did you get it?"; "Did you get my meaning?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200429631">
	<b:glossaryEntry>understand the meaning of; "The question concerning the meaning of life cannot be answered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200429804"
	 b:glossaryEntry="explain a riddle"/>
<rdf:Description rdf:about="&a;200429884"
	 b:glossaryEntry="get a grip on; get mastery of"/>
<rdf:Description rdf:about="&a;200429976"
	 b:glossaryEntry="arrive at or come upon, as of solutions to problems"/>
<rdf:Description rdf:about="&a;200430091"
	 b:glossaryEntry="guess correctly; solve by guessing"/>
<rdf:Description rdf:about="&a;200430222">
	<b:glossaryEntry>give the correct answer or solution to; "answer a question" "answer the riddle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200430365"
	 b:glossaryEntry="reason or establish by induction"/>
<rdf:Description rdf:about="&a;200430461"
	 b:glossaryEntry="reason by deduction; establish by deduction"/>
<rdf:Description rdf:about="&a;200430666">
	<b:glossaryEntry>use as a basis for; found on; "base a claim on some observation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200430821">
	<b:glossaryEntry xml:space='preserve'><![CDATA[found or ground; "build a defense on nothing but the accused person''s reputation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200430966"
	 b:glossaryEntry="make a mathematical calculation or computation"/>
<rdf:Description rdf:about="&a;200431511"
	 b:glossaryEntry="calculate the root of a number"/>
<rdf:Description rdf:about="&a;200431606">
	<b:glossaryEntry>perform mathematical and logical operations on (data) according to programmed instructions in order to obtain the required information; "The results of the elections were still being processed when he gave his acceptance speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200431899">
	<b:glossaryEntry>divide or assess proportionally; "The rent was prorated for the rest of the month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200432046"
	 b:glossaryEntry="calculate incorrectly"/>
<rdf:Description rdf:about="&a;200432137"
	 b:glossaryEntry='calculate anew; "The costs had to be recalculated"'/>
<rdf:Description rdf:about="&a;200432256">
	<b:glossaryEntry>reach by calculation; "What do you get when you add up these numbers?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200432405"
	 b:glossaryEntry="compute the average of"/>
<rdf:Description rdf:about="&a;200432506"
	 b:glossaryEntry="raise to the second power"/>
<rdf:Description rdf:about="&a;200432595"
	 b:glossaryEntry="raise to the third power"/>
<rdf:Description rdf:about="&a;200432681"
	 b:glossaryEntry="resolve into factors"/>
<rdf:Description rdf:about="&a;200432790">
	<b:glossaryEntry>make an addition by combining numbers; "Add 27 and 49, please!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200432991"
	 b:glossaryEntry="make a subtraction"/>
<rdf:Description rdf:about="&a;200433121">
	<b:glossaryEntry>deduct a loss or an unused credit form taxable income for a prior period</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200433261"
	 b:glossaryEntry='combine by multiplication; "multiply 10 by 15"'/>
<rdf:Description rdf:about="&a;200433445">
	<b:glossaryEntry>multiply (a number) by itself a specified number of times: 8 is 2 raised to the power 3</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200433595"
	 b:glossaryEntry='perform a division; "Can you divide 49 by seven?"'/>
<rdf:Description rdf:about="&a;200433781"
	 b:glossaryEntry='divide by two. divide into halves; "Halve the cake"'/>
<rdf:Description rdf:about="&a;200433903"
	 b:glossaryEntry="divide by four; divide into quarters"/>
<rdf:Description rdf:about="&a;200434012"
	 b:glossaryEntry="estimate the value of; in mathematics"/>
<rdf:Description rdf:about="&a;200434132"
	 b:glossaryEntry="calculate a derivative; take the derivative; in mathematics"/>
<rdf:Description rdf:about="&a;200434288">
	<b:glossaryEntry>calculate the integral of; calculate by integration; in mathematics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200434448">
	<b:glossaryEntry>subject to psychoanalytic treatment; "I was analyzed in Vienna by a famous psychiatrist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200434651">
	<b:glossaryEntry>make a mathematical, chemical, or grammatical analysis of; break down into components or essential features; "analyze a specimen"; "analyze a sentence"; "analyze a chemical compound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200434980">
	<b:glossaryEntry>analyze syntactically by assigning a constituent structure to (a sentence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200435117"
	 b:glossaryEntry="cause to undergo synthesis"/>
<rdf:Description rdf:about="&a;200435242">
	<b:glossaryEntry>consider in detail and subject to an analysis in order to discover essential features or meaning; "analyze a sonnet by Shakespeare"; "analyze the evidence in a criminal trial"; "analyze your real motives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200435755"
	 b:glossaryEntry="collect and study plants"/>
<rdf:Description rdf:about="&a;200435856">
	<b:glossaryEntry>determine or distinguish the nature of a problem or an illness through a diagnostic analysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200436039"
	 b:glossaryEntry="subject to an analysis; usually used in a medical context"/>
<rdf:Description rdf:about="&a;200436180"
	 b:glossaryEntry="examine for diagnostic purposes, as of organs"/>
<rdf:Description rdf:about="&a;200436308"
	 b:glossaryEntry="make some preliminary investigations or test the waters"/>
<rdf:Description rdf:about="&a;200436444"
	 b:glossaryEntry="examine minutely"/>
<rdf:Description rdf:about="&a;200436525"
	 b:glossaryEntry="consider in a comprehensive way"/>
<rdf:Description rdf:about="&a;200436631"
	 b:glossaryEntry="plot a map of (land)"/>
<rdf:Description rdf:about="&a;200436751">
	<b:glossaryEntry>survey by triangulation; "The land surveyer worked by triangulating the plot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200436897">
	<b:glossaryEntry>determine the measurements of something or somebody, take measurements of; "Measure the length of the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200437137"
	 b:glossaryEntry='measure by using trigonometry; "triangulate the angle"'/>
<rdf:Description rdf:about="&a;200437260"
	 b:glossaryEntry="measure by pacing, as of a room"/>
<rdf:Description rdf:about="&a;200437353"
	 b:glossaryEntry="measure the diameter of something with calipers"/>
<rdf:Description rdf:about="&a;200437476"
	 b:glossaryEntry="make a survey of; for statistical purposes"/>
<rdf:Description rdf:about="&a;200437600"
	 b:glossaryEntry="prospect for valuable minerals"/>
<rdf:Description rdf:about="&a;200437696"
	 b:glossaryEntry="inquire into"/>
<rdf:Description rdf:about="&a;200437847"
	 b:glossaryEntry='explore anew; "We need to re-explore Colonialism"'/>
<rdf:Description rdf:about="&a;200437964"
	 b:glossaryEntry="search anxiously"/>
<rdf:Description rdf:about="&a;200438083">
	<b:glossaryEntry>travel to or penetrate into; of unknown territory, for scientific purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200438258"
	 b:glossaryEntry="explore natural caves"/>
<rdf:Description rdf:about="&a;200438351"
	 b:glossaryEntry="recognize or perceive the difference"/>
<rdf:Description rdf:about="&a;200438496"
	 b:glossaryEntry="mark fine distinctions and subtleties, as among words"/>
<rdf:Description rdf:about="&a;200438616"
	 b:glossaryEntry='mark as different; "We distinguish several kinds of maple"'/>
<rdf:Description rdf:about="&a;200439092">
	<b:glossaryEntry>distinguish (an element or atom) by using a radioactive isotope or an isotope of unusual mass for tracing through chemical reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200439287">
	<b:glossaryEntry>distinguish (as a compound or molecule) by introducing a labeled atom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200439419"
	 b:glossaryEntry="tell the sex (of young chickens)"/>
<rdf:Description rdf:about="&a;200439512">
	<b:glossaryEntry>make or mark as individual; "The sounds were individualized by sharpness and tone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200439665">
	<b:glossaryEntry>be a distinctive feature, attribute, or trait; sometimes in a very positive sense</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200439864"
	 b:glossaryEntry="as in in botany or biology, for example"/>
<rdf:Description rdf:about="&a;200440044"
	 b:glossaryEntry="make a catalog of"/>
<rdf:Description rdf:about="&a;200440138">
	<b:glossaryEntry xml:space='preserve'><![CDATA[examine and note the similarities or differences of; "John compared his haircut to his friend''s"; "We compared notes after we had both seen the movie"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200440431"
	 b:glossaryEntry="make an analogy"/>
<rdf:Description rdf:about="&a;200440513"
	 b:glossaryEntry="reason by syllogisms"/>
<rdf:Description rdf:about="&a;200440600">
	<b:glossaryEntry>consider or describe as similar, equal, or analogous; "We can compare the Han dynasty to the Romans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200440790">
	<b:glossaryEntry xml:space='preserve'><![CDATA[consider again; give new consideration to: "Won''t you reconsider your decision?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200440946">
	<b:glossaryEntry xml:space='preserve'><![CDATA[change one''s position or opinion: "He came around to our point of view"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200441099">
	<b:glossaryEntry>arrange or order by classes or categories; "How would you classify these pottery shards--are they prehistoric?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200441510">
	<b:glossaryEntry>think of, regard, or classify under a subsuming principle or with a general group or in relation to another; "This plant can be referred to a known species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200441729">
	<b:glossaryEntry>classify anew, change the previous classification; "The zoologists had to reclassify the mollusks after they found new species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200441924"
	 b:glossaryEntry="sort according to size"/>
<rdf:Description rdf:about="&a;200442008"
	 b:glossaryEntry="divide into two opposing groups or kinds"/>
<rdf:Description rdf:about="&a;200442125">
	<b:glossaryEntry>treat or classify according to a mental stereotype; "I was stereotyped as a lazy Southern European"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200442337">
	<b:glossaryEntry>arrange into a group or groups; "Can you group these shapes together?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200442550"
	 b:glossaryEntry="reorganize into new groups"/>
<rdf:Description rdf:about="&a;200442641"
	 b:glossaryEntry="classify or group"/>
<rdf:Description rdf:about="&a;200442723"
	 b:glossaryEntry="lump, group, or chunk together"/>
<rdf:Description rdf:about="&a;200442843"
	 b:glossaryEntry="place into a category"/>
<rdf:Description rdf:about="&a;200442958"
	 b:glossaryEntry="determine the grade of or assign a grade to"/>
<rdf:Description rdf:about="&a;200443064">
	<b:glossaryEntry>assign a grade or rank to, according to one''s evaluation; as of scholastic work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200443221">
	<b:glossaryEntry>assign a rank or rating to; "how would you rank these students?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200443539"
	 b:glossaryEntry="put someone or something on a short list"/>
<rdf:Description rdf:about="&a;200443654">
	<b:glossaryEntry>distribute (players or teams) so that outstanding teams or players will not meet in the early rounds; as of a tennis or golf player</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200443847"
	 b:glossaryEntry="assign a new order to"/>
<rdf:Description rdf:about="&a;200443959"
	 b:glossaryEntry="change the order of soldiers during a march"/>
<rdf:Description rdf:about="&a;200444072">
	<b:glossaryEntry>cause to appear in a lower class, as in sports: "The Yankees outclassed Cincinnati"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200444229"
	 b:glossaryEntry="rank as less important"/>
<rdf:Description rdf:about="&a;200444338">
	<b:glossaryEntry>take a place in a competition; often followed by an ordinal; "Jerry came in third in the Marathon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200444528"
	 b:glossaryEntry='have a certain priority; "My family comes first"'/>
<rdf:Description rdf:about="&a;200444646">
	<b:glossaryEntry>take or have a position relative to others; "This painting ranks among the best in the Western World"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200444853"
	 b:glossaryEntry="assign a priority to"/>
<rdf:Description rdf:about="&a;200444941"
	 b:glossaryEntry="arrange in a sequence"/>
<rdf:Description rdf:about="&a;200445028"
	 b:glossaryEntry="rate lower; lower in value or esteem"/>
<rdf:Description rdf:about="&a;200445149"
	 b:glossaryEntry="rate higher; raise in value or esteem"/>
<rdf:Description rdf:about="&a;200445269"
	 b:glossaryEntry="estimate the value of something"/>
<rdf:Description rdf:about="&a;200445388"
	 b:glossaryEntry="put in contrast"/>
<rdf:Description rdf:about="&a;200445469"
	 b:glossaryEntry="distinguish or separate"/>
<rdf:Description rdf:about="&a;200445560"
	 b:glossaryEntry="distinguish by contrasting qualities"/>
<rdf:Description rdf:about="&a;200445671"
	 b:glossaryEntry="compare critically; of texts"/>
<rdf:Description rdf:about="&a;200445764">
	<b:glossaryEntry>examine so as to determine accuracy, quality, or condition; "check the brakes"; "Check out the engine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200446050">
	<b:glossaryEntry>put a check mark on or next to; "Please check each name on the list"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200446276"
	 b:glossaryEntry="mark or stamp as paid"/>
<rdf:Description rdf:about="&a;200446362">
	<b:glossaryEntry>be careful or certain to do something; make certain of something; "He verified that the valves were closed"; "See that the curtains are closed"; "control the quality of the product"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200446887">
	<b:glossaryEntry>verify by using a duplicate register for comparison; "control an account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200447025">
	<b:glossaryEntry>verify by consulting a source or authority; "check the spelling of this word"; "check your facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200447203"
	 b:glossaryEntry="check once more to be absolutely sure"/>
<rdf:Description rdf:about="&a;200447318"
	 b:glossaryEntry="check out conflicting sources; crosscheck facts, for example"/>
<rdf:Description rdf:about="&a;200447455"
	 b:glossaryEntry="make sure of"/>
<rdf:Description rdf:about="&a;200447530">
	<b:glossaryEntry>ask someone for identification to determine whether he or she is old enough to consume liquor; "I was carded when I tried to buy a beer!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200447729"
	 b:glossaryEntry="pick out random samples for examination; make spot checks"/>
<rdf:Description rdf:about="&a;200447862"
	 b:glossaryEntry="establish the authenticity of something"/>
<rdf:Description rdf:about="&a;200448015">
	<b:glossaryEntry>confirm the truth of; "Please verify that the doors are closed"; "verify a claim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200448230">
	<b:glossaryEntry>establish the validity of something; "This behavior shows his true nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200448531"
	 b:glossaryEntry="show one''s ability or courage"/>
<rdf:Description rdf:about="&a;200448631">
	<b:glossaryEntry>show to be baseless, or refute and make obsolete, as of a new theory or claim</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200448781"
	 b:glossaryEntry='institute, enact, or establish; "make laws"'/>
<rdf:Description rdf:about="&a;200448935"
	 b:glossaryEntry="prove someone to be of unsound mind"/>
<rdf:Description rdf:about="&a;200449036"
	 b:glossaryEntry="prove formally; demonstrate by a mathematical, formal proof"/>
<rdf:Description rdf:about="&a;200449158"
	 b:glossaryEntry="obtain probate of, as of a will"/>
<rdf:Description rdf:about="&a;200449252">
	<b:glossaryEntry>strengthen or make more firm as by corroboration; "his story confirmed my doubts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200449544"
	 b:glossaryEntry='support with evidence; "Can you document your claims?"'/>
<rdf:Description rdf:about="&a;200449672"
	 b:glossaryEntry="prove negative; show to be false"/>
<rdf:Description rdf:about="&a;200449851"
	 b:glossaryEntry="show to be invalid"/>
<rdf:Description rdf:about="&a;200449973"
	 b:glossaryEntry="prove valid; show or confirm the validity of something"/>
<rdf:Description rdf:about="&a;200450119"
	 b:glossaryEntry="prove to be false or wrong"/>
<rdf:Description rdf:about="&a;200450309"
	 b:glossaryEntry="prove to be false or incorrect"/>
<rdf:Description rdf:about="&a;200450432"
	 b:glossaryEntry='prove false; "Falsify a claim"'/>
<rdf:Description rdf:about="&a;200450535">
	<b:glossaryEntry>put up with something or somebody unpleasant; "I cannot bear his constant criticism"; "The new secretary had to endure a lot of unprofessional remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200450980">
	<b:glossaryEntry>tolerate or accommodate oneself to; "I shall have to accept these unpleasant working conditions"; "I swallowed the insult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200451176">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tolerate or bear; "I won''t stand for this kind of behavior!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200451320"
	 b:glossaryEntry='endure cheerfully; "She bore up under the enormous strain'/>
<rdf:Description rdf:about="&a;200451442">
	<b:glossaryEntry xml:space='preserve'><![CDATA[suffer without protest; suffer or endure passively; "I won''t take this insult lying down"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200451604"
	 b:glossaryEntry="undergo failure or defeat"/>
<rdf:Description rdf:about="&a;200451706">
	<b:glossaryEntry xml:space='preserve'><![CDATA[listen to a joke at one''s one expense; Can''t you take a joke?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200451837"
	 b:glossaryEntry='accept or undergo, often unwillingly; "We took a pay cut"'/>
<rdf:Description rdf:about="&a;200452001">
	<b:glossaryEntry xml:space='preserve'><![CDATA[undergo a test; "She doesn''t test well"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200452102"
	 b:glossaryEntry="endure to the end"/>
<rdf:Description rdf:about="&a;200452184"
	 b:glossaryEntry="form an opinion of or pass judgment on"/>
<rdf:Description rdf:about="&a;200452641">
	<b:glossaryEntry>have or maintain a position or stand on an issue: "Where do you stand on the War?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200452804"
	 b:glossaryEntry="judge incorrectly"/>
<rdf:Description rdf:about="&a;200452949"
	 b:glossaryEntry='make too low an estimate of; "he underestimated the cost"'/>
<rdf:Description rdf:about="&a;200453115"
	 b:glossaryEntry="overestimate the market value of, as of property"/>
<rdf:Description rdf:about="&a;200453243">
	<b:glossaryEntry>make too high an estimate of; "He overestimated his own powers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200453431"
	 b:glossaryEntry="determine the result of, as of a competition"/>
<rdf:Description rdf:about="&a;200453556">
	<b:glossaryEntry>form an opinion about; judge tentatively; form an estimate of, esp. quantities or time; "I estimate this chicken to weigh at three pounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200453976"
	 b:glossaryEntry="gauge something incorrectly or improperly"/>
<rdf:Description rdf:about="&a;200454083"
	 b:glossaryEntry='estimate: "We put the time of arrival at 8 P.M."'/>
<rdf:Description rdf:about="&a;200454206">
	<b:glossaryEntry>estimate the duration or outcome of something; "He gave the patient three months to live"; "I gave him a very good chance at success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200454401"
	 b:glossaryEntry="make a low estimate"/>
<rdf:Description rdf:about="&a;200454501"
	 b:glossaryEntry="judge to be right or commendable; think well of"/>
<rdf:Description rdf:about="&a;200454666"
	 b:glossaryEntry="look disapprovingly upon"/>
<rdf:Description rdf:about="&a;200454769"
	 b:glossaryEntry="consider bad or wrong"/>
<rdf:Description rdf:about="&a;200454928"
	 b:glossaryEntry="approve automatically"/>
<rdf:Description rdf:about="&a;200455018">
	<b:glossaryEntry>pick out, select, or choose from a number of alternatives; "Take any one of these cards"; "Choose a good husband for your daughter"; "She selected a pair of shoes from among the dozen the salesgirl had shown her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200455715">
	<b:glossaryEntry>select or take in from a given group or region; "The participants in the experiment were drawn from a representative population"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200455913"
	 b:glossaryEntry='choose by means of a dial; "dial a telephone number"'/>
<rdf:Description rdf:about="&a;200456027">
	<b:glossaryEntry>give support (to) or make a choice (of) one out of a group or number; "I plumped for the losing candidates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200456210">
	<b:glossaryEntry>select carefully from a group: "She finally picked her successor"; "He picked his way carefully"; "We had to pick through a lot of data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200456424"
	 b:glossaryEntry='choose; "I elected to have my funds deposited automatically"'/>
<rdf:Description rdf:about="&a;200456563"
	 b:glossaryEntry="take out of a literary work in order to cite or copy"/>
<rdf:Description rdf:about="&a;200456709"
	 b:glossaryEntry="select from a group, as of animals"/>
<rdf:Description rdf:about="&a;200456809"
	 b:glossaryEntry="pick the best"/>
<rdf:Description rdf:about="&a;200456908"
	 b:glossaryEntry='separate or remove; he picked over the selection"'/>
<rdf:Description rdf:about="&a;200457036"
	 b:glossaryEntry="select something or someone for a specific purpose"/>
<rdf:Description rdf:about="&a;200457216"
	 b:glossaryEntry="set apart to sacred uses with solemn rites, of a church"/>
<rdf:Description rdf:about="&a;200457338">
	<b:glossaryEntry>assign to a specific task: "The ambulances were detailed to the fire station"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200457479">
	<b:glossaryEntry xml:space='preserve'><![CDATA[plan for an activity or event; "I''ve scheduled a concert next week"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200457708"
	 b:glossaryEntry="assign a time for an activity or event"/>
<rdf:Description rdf:about="&a;200457832">
	<b:glossaryEntry>engage for a performance; "Her agent had booked her for several concerts in Tokyo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200458000"
	 b:glossaryEntry="enter into a calendar"/>
<rdf:Description rdf:about="&a;200458095"
	 b:glossaryEntry='assign a time slot; "slot a television programs"'/>
<rdf:Description rdf:about="&a;200458205">
	<b:glossaryEntry>select from a group; "She was singled out for her outstanding performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200458368">
	<b:glossaryEntry>select as an alternative; choose instead; prefer as an alternative; "I always choose the fish over the meat courses in this restaurant"; "She opted for the job on the East coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200458637"
	 b:glossaryEntry="choose not to do something"/>
<rdf:Description rdf:about="&a;200458746">
	<b:glossaryEntry>see fit or proper to act in a certain way; decide to act in a certain way; "She chose not to attend classes and now she failed the exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200458954"
	 b:glossaryEntry="influence (somebody''s) opinion in advance"/>
<rdf:Description rdf:about="&a;200459119"
	 b:glossaryEntry="cause to be biased"/>
<rdf:Description rdf:about="&a;200459240"
	 b:glossaryEntry="present with a bias"/>
<rdf:Description rdf:about="&a;200459347">
	<b:glossaryEntry>make susceptible; "This illness predisposes you to gain weight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200459496">
	<b:glossaryEntry>make liable: "This action may subject you to certain penalties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200459632"
	 b:glossaryEntry="make receptive or willing"/>
<rdf:Description rdf:about="&a;200459758"
	 b:glossaryEntry="make unwilling"/>
<rdf:Description rdf:about="&a;200459860"
	 b:glossaryEntry="judge beforehand, esp. without sufficient evidence"/>
<rdf:Description rdf:about="&a;200459984"
	 b:glossaryEntry="place a value on; judge the worth of something"/>
<rdf:Description rdf:about="&a;200460224"
	 b:glossaryEntry="revise or renew one''s assessment"/>
<rdf:Description rdf:about="&a;200460335">
	<b:glossaryEntry>subject to political, religious, or moral censorship; "This magazine is censored by the government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200460498">
	<b:glossaryEntry>consider or ponder something carefully: She bethought her of their predicament.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200460650">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accept as true; take to be true; "I believed his report"; "We didn''t believe his stories from the War"; "She believes in spirits"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200460986">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accept as true: "I can''t buy this story"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200461087">
	<b:glossaryEntry xml:space='preserve'><![CDATA[assert or affirm; "Rousseau''s philosophy holds that people are inherently good"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200461228"
	 b:glossaryEntry="have trust in; trust in the truth or veracity of"/>
<rdf:Description rdf:about="&a;200461366">
	<b:glossaryEntry>credit with veracity: "You cannot believe this man"; "Should we believe a publication like the "national Inquirer?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200461554">
	<b:glossaryEntry>follow a credo; have a religious faith; be a believer; "When you hear his sermons, you will be able to believe, too"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200461761"
	 b:glossaryEntry="hold a false or unorthodox believe"/>
<rdf:Description rdf:about="&a;200461863"
	 b:glossaryEntry="reject as false; refuse to accept"/>
<rdf:Description rdf:about="&a;200462038">
	<b:glossaryEntry>consider as part of something; "I include you in the list of culprits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200462245">
	<b:glossaryEntry>include as if by counting; "I can count my colleagues in the opposition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200462388">
	<b:glossaryEntry>consider (an instance of something) as part of a general rule or principle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200462547">
	<b:glossaryEntry>dismiss from consideration; John was ruled out as a possible suspect because he had a strong alibi."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200462716">
	<b:glossaryEntry xml:space='preserve'><![CDATA[refuse to accept or acknowledge; "I reject the idea of starting a war"; "The journal rejected the student''s paper"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200463036">
	<b:glossaryEntry>refuse to acknowledge or recognize; "The woman repudiated the divorce settlement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200463192">
	<b:glossaryEntry>challenge or except to a judge as being incompetent or interested, in canon and civil law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200463353">
	<b:glossaryEntry>consider or hold as true; "I cannot accept the dogma of this church"; "accept an argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200463695"
	 b:glossaryEntry='accept as true or valid; "He received Christ"'/>
<rdf:Description rdf:about="&a;200463813"
	 b:glossaryEntry="accept as valid, as of documents"/>
<rdf:Description rdf:about="&a;200463930"
	 b:glossaryEntry="reject as invalid, as of documents"/>
<rdf:Description rdf:about="&a;200464049"
	 b:glossaryEntry="consider unlikely or have doubts about"/>
<rdf:Description rdf:about="&a;200464166"
	 b:glossaryEntry='lack confidence in; "I doubt these reports"'/>
<rdf:Description rdf:about="&a;200464280">
	<b:glossaryEntry>cause to be distrusted or disbelieved; "The paper discredited the politician with its nasty commentary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200464450">
	<b:glossaryEntry>regard as untrustworthy; regard with suspicion; have no faith or confidence in</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200464659"
	 b:glossaryEntry='rely on for support; "We can lean on this man"'/>
<rdf:Description rdf:about="&a;200464775">
	<b:glossaryEntry>have confidence or faith in; "We can trust in God"; "Rely on your friends"; "bank on your good education"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200465055"
	 b:glossaryEntry="believe guilty"/>
<rdf:Description rdf:about="&a;200465134"
	 b:glossaryEntry="change one''s mind"/>
<rdf:Description rdf:about="&a;200465260"
	 b:glossaryEntry="modify one'' opinion, make it less strong"/>
<rdf:Description rdf:about="&a;200465367"
	 b:glossaryEntry="change one''s mind and assume the opposite viewpoint"/>
<rdf:Description rdf:about="&a;200465486">
	<b:glossaryEntry>imagine to be true or to be the case; "I suspect that there is more to the story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200465640"
	 b:glossaryEntry="infer from incomplete evidence"/>
<rdf:Description rdf:about="&a;200465761">
	<b:glossaryEntry>judge or regard; look upon; judge; "I think he is very smart"; "I believe her to be very smart"; "I think that he is her boyfriend"; "The racist conceives such people to be inferior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200466190"
	 b:glossaryEntry='dispose the mind in a certain way; "Do you really think so?"'/>
<rdf:Description rdf:about="&a;200466313">
	<b:glossaryEntry>look on as or consider: "she looked on this affair as a joke"; "He thinks of himself as a brilliant musician"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200466561">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have a feeling or perception about oneself in reaction to someone''s behavior or attitude; "She felt small and insignificant"; "You make me feel naked"; "I made the students feel different about themselves"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200466852">
	<b:glossaryEntry>consider or deem to be; regard; "She views this quite differently from me"; "I consider her to be shallow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200467385">
	<b:glossaryEntry>consider or regard as being; "I would not call her beautiful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200467516">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feel about or towards; consider, evaluate, or regard; "How did you like the President''s speech last night?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200467685"
	 b:glossaryEntry="consider or treat as relative"/>
<rdf:Description rdf:about="&a;200467782">
	<b:glossaryEntry>consider (oneself) as similar to somebody else; "He identified with the refugees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200467945"
	 b:glossaryEntry='consider as the favorite; "The local team was favored"'/>
<rdf:Description rdf:about="&a;200468095">
	<b:glossaryEntry>consider a concept without thinking of a specific example; consider abstractly or theoretically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200468256"
	 b:glossaryEntry="consider an abstract concept to be real"/>
<rdf:Description rdf:about="&a;200468376"
	 b:glossaryEntry="construe as a real existent, of a conceptual entity"/>
<rdf:Description rdf:about="&a;200468496"
	 b:glossaryEntry="consider as ideal"/>
<rdf:Description rdf:about="&a;200468634"
	 b:glossaryEntry="interpret in a romantic way"/>
<rdf:Description rdf:about="&a;200468752"
	 b:glossaryEntry="consider as a god or god-like"/>
<rdf:Description rdf:about="&a;200468870"
	 b:glossaryEntry="deify or glorify"/>
<rdf:Description rdf:about="&a;200468967">
	<b:glossaryEntry>keep in mind or convey as a conviction or view; "take for granted"; "view as important"; "hold these truths to be self-evident"; "I hold him personally responsible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200469237"
	 b:glossaryEntry="regard highly; think much of"/>
<rdf:Description rdf:about="&a;200469461"
	 b:glossaryEntry='esteem very highly; "She thinks the world of her adviser"'/>
<rdf:Description rdf:about="&a;200469594"
	 b:glossaryEntry="have little or no respect for; hold in contempt"/>
<rdf:Description rdf:about="&a;200469801"
	 b:glossaryEntry="esteem lightly"/>
<rdf:Description rdf:about="&a;200469891"
	 b:glossaryEntry="analyze (chemical substances)"/>
<rdf:Description rdf:about="&a;200470001"
	 b:glossaryEntry="subject to a bio-assay"/>
<rdf:Description rdf:about="&a;200470089">
	<b:glossaryEntry>fix or determine the value of; assign a value to, as of jewelry or art work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200470281"
	 b:glossaryEntry="assign too high a value to"/>
<rdf:Description rdf:about="&a;200470425"
	 b:glossaryEntry="assign too low a value to"/>
<rdf:Description rdf:about="&a;200470570">
	<b:glossaryEntry>allow (currencies) to fluctuate; "The government floated the ruble for a few months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200470717"
	 b:glossaryEntry="look at again; examine again"/>
<rdf:Description rdf:about="&a;200470821">
	<b:glossaryEntry>look back upon (a period of time, sequence of events, etc.); remember; "she reviewed her achievements with pride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200471023"
	 b:glossaryEntry="hold a review (of troops)"/>
<rdf:Description rdf:about="&a;200471139"
	 b:glossaryEntry="refresh one''s memory"/>
<rdf:Description rdf:about="&a;200471270"
	 b:glossaryEntry="of accounts and tax returns; with the intent to verify"/>
<rdf:Description rdf:about="&a;200471410"
	 b:glossaryEntry="examine methodically; test for suitability"/>
<rdf:Description rdf:about="&a;200471542">
	<b:glossaryEntry>reach, make, or come to a decision about something; "We finally decided after lengthy deliberations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200471949"
	 b:glossaryEntry='calculate as being; "I make the height about 100 feet"'/>
<rdf:Description rdf:about="&a;200472101">
	<b:glossaryEntry xml:space='preserve'><![CDATA[consider as being; "It wasn''t the problem some people made it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200472243"
	 b:glossaryEntry='determine by choice; "This action was willed and intended"'/>
<rdf:Description rdf:about="&a;200472363">
	<b:glossaryEntry>intend or have as a purpose; "She designed to go far in the world of business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200472505"
	 b:glossaryEntry='decide irrevocably; "sealing dooms"'/>
<rdf:Description rdf:about="&a;200472610">
	<b:glossaryEntry>bring to an end; settle conclusively; "The case was decided"; "The judge decided the case in favor of the plaintiff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200472835"
	 b:glossaryEntry='cause to decide; "This new development finally decided me!"'/>
<rdf:Description rdf:about="&a;200472976"
	 b:glossaryEntry='reach a decision; "he resolved never to drink again"'/>
<rdf:Description rdf:about="&a;200473111"
	 b:glossaryEntry='fix conclusively or authoritatively; "set the rules"'/>
<rdf:Description rdf:about="&a;200473404">
	<b:glossaryEntry>determine the arrangement of (data) for storage and display (in computer science)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200473549">
	<b:glossaryEntry>set or ask for a certain price; "How much do you charge for lunch?" "This fellow charges $100 for a massage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200473721">
	<b:glossaryEntry>fix in scope; fix the boundaries of; the tree determines the border of the property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200473889"
	 b:glossaryEntry="assign an initial value to a compute program"/>
<rdf:Description rdf:about="&a;200474001">
	<b:glossaryEntry>shape or influence; give direction to; "experience often determines ability"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200474291">
	<b:glossaryEntry>influence or determine; "The vote in New Hampshire often decides the outcome of the Presidential election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200474461">
	<b:glossaryEntry>shape anew or differently; "The new foreign minister reshaped the foreign policy of his country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200474622"
	 b:glossaryEntry="set the speed, duration, or execution of"/>
<rdf:Description rdf:about="&a;200474732">
	<b:glossaryEntry>adjust through indexation; "The government indexes wages and prices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200474863"
	 b:glossaryEntry='regulate or set the pace of; "Pace your efforts"'/>
<rdf:Description rdf:about="&a;200474981"
	 b:glossaryEntry="determine beforehand"/>
<rdf:Description rdf:about="&a;200475123"
	 b:glossaryEntry="foreordain or determine beforehand"/>
<rdf:Description rdf:about="&a;200475284"
	 b:glossaryEntry="foredoom to failure"/>
<rdf:Description rdf:about="&a;200475365"
	 b:glossaryEntry="in theology"/>
<rdf:Description rdf:about="&a;200475488">
	<b:glossaryEntry>consider carefully and deeply; reflect upon; turn over in one''s mind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200475715"
	 b:glossaryEntry='deliberate or decide; "See whether you can come tomorrow"'/>
<rdf:Description rdf:about="&a;200475833">
	<b:glossaryEntry>consider as a possibility; "I contemplated leaving school and taking a full-time job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200476013"
	 b:glossaryEntry='consider beforehand; "premeditated murder"'/>
<rdf:Description rdf:about="&a;200476124">
	<b:glossaryEntry>consult (archaic); "The student should take counsel with himself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200476269"
	 b:glossaryEntry="think moodily or anxiously about something"/>
<rdf:Description rdf:about="&a;200476424">
	<b:glossaryEntry>think intently and at length, as for spiritual purposes; "He is meditating in his study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200476600">
	<b:glossaryEntry>make plans for something; "He is planning a trip with his family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200476915"
	 b:glossaryEntry="plan in detail"/>
<rdf:Description rdf:about="&a;200476992">
	<b:glossaryEntry>have the will and intention to carry out some action; "He plans to be in graduate school next year"; "The rebels had planned turmoil and confusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200477282"
	 b:glossaryEntry="have an ambitious plan or a lofty goal"/>
<rdf:Description rdf:about="&a;200477428"
	 b:glossaryEntry='aim too high; "The plan overshoots its aim"'/>
<rdf:Description rdf:about="&a;200477538">
	<b:glossaryEntry>intend with some possibility of fulfilment; "I hope to have finished this work by tomorrow evening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200477716"
	 b:glossaryEntry="present for consideration"/>
<rdf:Description rdf:about="&a;200477868"
	 b:glossaryEntry='put forward for consideration; "He offered his opinion"'/>
<rdf:Description rdf:about="&a;200477986"
	 b:glossaryEntry="as of legislation into a legislative body"/>
<rdf:Description rdf:about="&a;200478094"
	 b:glossaryEntry='draw up the plans or basic details for; "frame a policy"'/>
<rdf:Description rdf:about="&a;200478244">
	<b:glossaryEntry>enter into a conspiracy; "They conspired to overthrow the government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200478405"
	 b:glossaryEntry="make a plot in response to another plot"/>
<rdf:Description rdf:about="&a;200478521">
	<b:glossaryEntry>act in unison or agreement; "These two factors conspired to cause the stock market to fall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200478704"
	 b:glossaryEntry="form intrigues (for) in an underhand manner"/>
<rdf:Description rdf:about="&a;200478840">
	<b:glossaryEntry>plan secretly, usually something illegal; "They plotted the overthrow fo the government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200479052"
	 b:glossaryEntry="devise a system or form a scheme for"/>
<rdf:Description rdf:about="&a;200479160">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have in mind as a purpose; "I mean no harm"; "I only meant to help you"; "She didn''t think to harm me"; "We thought to return early that night"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200479444">
	<b:glossaryEntry>destine or designate for a certain purpose; "These flowers were meant for you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200479584"
	 b:glossaryEntry='propose or intend; "I aim to arrive at noon"'/>
<rdf:Description rdf:about="&a;200479719"
	 b:glossaryEntry='have in mind; "I will take the exam tomorrow"'/>
<rdf:Description rdf:about="&a;200479841"
	 b:glossaryEntry='wish or demand the presence of; "I want you here at noon!"'/>
<rdf:Description rdf:about="&a;200479979"
	 b:glossaryEntry='design or destine; "She was intended to become the director"'/>
<rdf:Description rdf:about="&a;200480207">
	<b:glossaryEntry>design something for a specific role or purpose or effect; "This room is not designed for work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200480374"
	 b:glossaryEntry="choose someone for a job or function"/>
<rdf:Description rdf:about="&a;200480481">
	<b:glossaryEntry>plan and direct (a complex undertaking); "he masterminded the robber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200480663">
	<b:glossaryEntry xml:space='preserve'><![CDATA[explore or survey for the purpose of making a map; "We haven''t even begun to map the many galaxies that we know exist"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200480842"
	 b:glossaryEntry='make a chart of; "chart the territory"'/>
<rdf:Description rdf:about="&a;200480943"
	 b:glossaryEntry='make a plat of; "Plat the town"'/>
<rdf:Description rdf:about="&a;200481043"
	 b:glossaryEntry="provide a detailed plan or design"/>
<rdf:Description rdf:about="&a;200481177">
	<b:glossaryEntry>plan where and when songs should be inserted into a theatrical production, or plan a theatrical production in general</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200481361">
	<b:glossaryEntry>lay out a full-scale working drawing of the lines of a vessel''s hull</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200481491">
	<b:glossaryEntry>design as an engineer; "He engineered the water supply project"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200481620">
	<b:glossaryEntry>take into consideration, have in view; "He entertained the notion of moving to South America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200481847">
	<b:glossaryEntry>consider not very seriously; "He is trifiling with her"; "She plays with the thought of moving to Tasmania"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200482033"
	 b:glossaryEntry="judge to be probable"/>
<rdf:Description rdf:about="&a;200482197"
	 b:glossaryEntry="judge incorrectly"/>
<rdf:Description rdf:about="&a;200482292">
	<b:glossaryEntry>take account of; "You have to reckon with our opponents"; "Count on the monsoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200482444">
	<b:glossaryEntry>rely or depend on; "you can count on me to help you any time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200482686">
	<b:glossaryEntry>specifically design a product, event, or activity for a certain public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200482838">
	<b:glossaryEntry>make a logical or causal connection; "I cannot connect these two pieces of evidence in my mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200483151">
	<b:glossaryEntry>regard as unconnected; "you must dissociate these two events!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200483299"
	 b:glossaryEntry='"Sex activity is closely identified with the hypothalamus"'/>
<rdf:Description rdf:about="&a;200483431">
	<b:glossaryEntry xml:space='preserve'><![CDATA[associate freely; as in psychotherapy; "Let''s associate freely to bring up old memories"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200483599">
	<b:glossaryEntry>argue with one another; "We debated the question of abortion"; "John debated Mary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200483753"
	 b:glossaryEntry='bring to a close; "The committee concluded the meeting"'/>
<rdf:Description rdf:about="&a;200483900">
	<b:glossaryEntry xml:space='preserve'><![CDATA[come to believe on the basis of emotion, intuitions, or indefinite grounds: "I feel that he doesn''t like me"; "I find him to be obnoxious"; "I found the movie rather entertaining"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200484149">
	<b:glossaryEntry>define clearly; "I cannot narrow down the rules for this game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200484359"
	 b:glossaryEntry="make something concrete"/>
<rdf:Description rdf:about="&a;200484458"
	 b:glossaryEntry="decide with authority"/>
<rdf:Description rdf:about="&a;200484604">
	<b:glossaryEntry>rule against; "The Republicans were overruled when the House voted on the bill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200484801">
	<b:glossaryEntry>require as a necessary antecedent or precondition; in logic; "This step presupposes two prior ones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200484968">
	<b:glossaryEntry>take for granted or as a given; suppose beforehand; "I presuppose that you have done your work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200485167">
	<b:glossaryEntry>take as a given; assume as a postulate or axiom; "He posited three basic laws of nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200485364"
	 b:glossaryEntry='assert to be true; "The letter asserts a free society"'/>
<rdf:Description rdf:about="&a;200485491"
	 b:glossaryEntry="take something as preexisting"/>
<rdf:Description rdf:about="&a;200485595"
	 b:glossaryEntry="show a response or a reaction to something"/>
<rdf:Description rdf:about="&a;200485888">
	<b:glossaryEntry>react to a stimulus or command; "The steering of my new car answers to the slightest touch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200486051">
	<b:glossaryEntry>be sexually responsive to, used of a female domesticated mammal; "The cow accepted the bull"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200486207"
	 b:glossaryEntry="react to a decoy, of wildfowl"/>
<rdf:Description rdf:about="&a;200486299">
	<b:glossaryEntry>respond favorably or as hoped; "The cancer reponded to the aggressive therapy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200486450">
	<b:glossaryEntry>react to in a certain way; "The President was greeted with catcalls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200486605">
	<b:glossaryEntry>show a violent emotional reaction; "The boss exploded when he heard of the resignation of the secretary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200486774">
	<b:glossaryEntry>react favorably to; consider right and proper; "People did not accept atonal music at that time"; "We accept the idea of universal health care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200487007">
	<b:glossaryEntry>respond to a signal; "answer the door," "answer the telephone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200487133">
	<b:glossaryEntry>regard something as probable or likely; "The meteorologists are expecting rain for tomorrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200487408">
	<b:glossaryEntry>look forward to the probably occurrence of: "We were expecting a visit from our relatives"; "She is looking to a promotion"; "he is waiting to be drafted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200487770"
	 b:glossaryEntry='expect or hope for; "I look to hear from you soon"'/>
<rdf:Description rdf:about="&a;200487890">
	<b:glossaryEntry xml:space='preserve'><![CDATA[turn one''s interests or expectations towards; "look to the future"; "this method looks to significant wavings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200488081"
	 b:glossaryEntry="realize beforehand"/>
<rdf:Description rdf:about="&a;200488188"
	 b:glossaryEntry="discover intuitively"/>
<rdf:Description rdf:about="&a;200488280"
	 b:glossaryEntry='discern or comprehend; "He could tell that she was unhappy"'/>
<rdf:Description rdf:about="&a;200488417">
	<b:glossaryEntry>be confident about something; "I believe that he will come back from the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200488567"
	 b:glossaryEntry="learn or discover with certainty"/>
<rdf:Description rdf:about="&a;200488684">
	<b:glossaryEntry>make a discovery; "She found that he had lied to her"; "The story is false, so far as I can discover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200488912">
	<b:glossaryEntry>bring to light; "He raked up the misdeeds of his predecessor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200489046">
	<b:glossaryEntry>ascertain or learn the price of; "Have you priced personal computers lately?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200489186">
	<b:glossaryEntry>discover through persistent investigation; "She ferreted out the truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200489333"
	 b:glossaryEntry="focus one''s attention on something"/>
<rdf:Description rdf:about="&a;200489575">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cause one''s (or someone else''s) thoughts or attention to return from a reverie or digression; "She was recalled by a loud laugh"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200489783">
	<b:glossaryEntry xml:space='preserve'><![CDATA[focus one''s attention on a certain state; "Think big"; "think thin"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200489913">
	<b:glossaryEntry xml:space='preserve'><![CDATA[choose in one''s mind; "Think of any integer between 1 and 25"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200490040">
	<b:glossaryEntry>determine the existence of; "We detected traces of the poison in her food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200490178">
	<b:glossaryEntry xml:space='preserve'><![CDATA[come to one''s mind; suggest itself; "It occurred to me that we shold hire another secretary"; "A great idea then came to her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200490373">
	<b:glossaryEntry>allow or plan for a certain possibility; concede the truth or validity of something; "I allow for this possibility"; "The seamstress planned for 5% shrinkage after the first wash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200490661">
	<b:glossaryEntry>calculate enough money for; provide for in the budget; "I have not budgeted for these expensive meals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200490839"
	 b:glossaryEntry="make a budget"/>
<rdf:Description rdf:about="&a;200490924">
	<b:glossaryEntry>give or assign a share of money or time to a particular person or cause; "I will earmark this money for your research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200491159"
	 b:glossaryEntry="be concerned with or about something or somebody"/>
<rdf:Description rdf:about="&a;200491303">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be on one''s guard; be cautious or wary about; be alert to; "Beware of telephone salesmen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200491471"
	 b:glossaryEntry="cause to be amazed"/>
<rdf:Description rdf:about="&a;200491581">
	<b:glossaryEntry>take unawares or by surprise; cause to be surprised; "The news really surprised me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200491793">
	<b:glossaryEntry>discover or come upon accidentally, suddenly, or unexpectedly; catch somebody doing something or in a certain state: "She caught her son eating candy"; "She was caught shoplifting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200492054"
	 b:glossaryEntry='become aware of; "he caught her staring out the window"'/>
<rdf:Description rdf:about="&a;200492198"
	 b:glossaryEntry='overcome with amazement; "This boggles the mind!"'/>
<rdf:Description rdf:about="&a;200492345">
	<b:glossaryEntry>attribute to a source or cause; "We attributed this quotation to Shakespeare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200492687"
	 b:glossaryEntry="ascribe to an origin in sensation"/>
<rdf:Description rdf:about="&a;200492800">
	<b:glossaryEntry>give someone credit for something; "We credited her for saving our jobs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200492944"
	 b:glossaryEntry="attribute to another source"/>
<rdf:Description rdf:about="&a;200493048"
	 b:glossaryEntry="ascribe human features to something"/>
<rdf:Description rdf:about="&a;200493157">
	<b:glossaryEntry>attribute human qualities to something; "The Greeks personated their gods ridiculous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200493321"
	 b:glossaryEntry='give credit for; "I credit you with saving his life"'/>
<rdf:Description rdf:about="&a;200493456">
	<b:glossaryEntry>attribute responsibility to; "We blamed the accident on her"; "The tragedy was charged to her inexperience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200493635"
	 b:glossaryEntry="enter into someone''s consciousness"/>
<rdf:Description rdf:about="&a;200493735"
	 b:glossaryEntry="make a deep and indelible impression on someone"/>
<rdf:Description rdf:about="&a;200493867"
	 b:glossaryEntry="be fully aware or cognizant of"/>
<rdf:Description rdf:about="&a;200494037"
	 b:glossaryEntry='derive by reason; "elicit a solution"'/>
<rdf:Description rdf:about="&a;200494146"
	 b:glossaryEntry="come to understand"/>
<rdf:Description rdf:about="&a;200494265">
	<b:glossaryEntry>follow, discover, or ascertain the course of development of something; "We must follow closely the economic development is Cuba"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200494502">
	<b:glossaryEntry>have a wish or desire to know something; "He wondered who had built this beautiful church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200494684"
	 b:glossaryEntry="regard as objective; in psychology"/>
<rdf:Description rdf:about="&a;200494805"
	 b:glossaryEntry="incorporate within oneself; in psychology"/>
<rdf:Description rdf:about="&a;200494966">
	<b:glossaryEntry xml:space='preserve'><![CDATA["I''m thinking of good food when I talk about France"; "Yes, I meant you when I complained about people who gossip!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200495195"
	 b:glossaryEntry="set, mark, or draw the boundaries of something"/>
<rdf:Description rdf:about="&a;200495339"
	 b:glossaryEntry="separate clearly; as if by boundaries"/>
<rdf:Description rdf:about="&a;200495451"
	 b:glossaryEntry="measure the depth of something"/>
<rdf:Description rdf:about="&a;200495544">
	<b:glossaryEntry>make, formulate, or derive in the mind; "I draw a line here"; "draw a conclusion"; "draw parallels"; "make an estimate"; "What do you make of his remarks?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200495786">
	<b:glossaryEntry>consider funds as capital assets rather than as an expenditures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200495917"
	 b:glossaryEntry="compute the present value of a business or an income"/>
<rdf:Description rdf:about="&a;200496055">
	<b:glossaryEntry>estimate the capital value of (a company) at an unreasonably or unlawfully high level</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200496212">
	<b:glossaryEntry>trap; esp. in an error or in a reprehensible act; "He was caught out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200496359"
	 b:glossaryEntry="bring into focus or alignment; of ideas or emotions"/>
<rdf:Description rdf:about="&a;200496485">
	<b:glossaryEntry>as in the expressions "give thought to"; "give priority to", etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200496653"
	 b:glossaryEntry='accept as inevitable; "He resigned himself to his fate"'/>
<rdf:Description rdf:about="&a;200496801"
	 b:glossaryEntry='observe correctly; "keep time, keep count, keep track of"'/>
<rdf:Description rdf:about="&a;200496923"
	 b:glossaryEntry="show disapproval by discouraging"/>
<rdf:Description rdf:about="&a;200497027"
	 b:glossaryEntry='find the solution to; "solve an equation"'/>
<rdf:Description rdf:about="&a;200497159"
	 b:glossaryEntry="resolve into factors, as of a polynomial"/>
<rdf:Description rdf:about="&a;200497278"
	 b:glossaryEntry="go over once again"/>
<rdf:Description rdf:about="&a;200497380">
	<b:glossaryEntry>suggest fear or doubt: "Her heart misgave her that she had acted inexcusably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200497522"
	 b:glossaryEntry="align oneself with a group or a way of thinking"/>
<rdf:Description rdf:about="&a;200497658"
	 b:glossaryEntry="agree on (a position, for example)"/>
<rdf:Description rdf:about="&a;200497762">
	<b:glossaryEntry>have a firm conviction as to the goodness of something; "John believes in oat bran"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200497921">
	<b:glossaryEntry>consider, as of an example; "Take the case of China"; "Consider the following case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200498174">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have on one''s mind, think about actively; "I''m thinking about my friends abroad"; "She always thinks about her children first"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200498413">
	<b:glossaryEntry xml:space='preserve'><![CDATA[consider apart from a particular case or instance; "Let''s abstract away from this particular example"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200498580">
	<b:glossaryEntry xml:space='preserve'><![CDATA[implant in the mind; "Plant a thought in the students'' minds"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200498714">
	<b:glossaryEntry>provide with a dateline; mark with a date; "She wrote the letter on Monday but she dated it Saturday so as not to reveal that she procrastinated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200498957">
	<b:glossaryEntry>mark with a date, and often with a place, to, as of a newspaper article or a letter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200499117">
	<b:glossaryEntry>stamp with a date, as of a postmark; "The package is dated November 24"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200499281">
	<b:glossaryEntry xml:space='preserve'><![CDATA[arrange thoughts, ideas, temporal events, etc.; "arrange my schedule;" "set up one''s life"; "I put these memories with those of bygone times"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200499510">
	<b:glossaryEntry>arrange or represent events so that they co-occur; "synchronize bibliocal events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200499675"
	 b:glossaryEntry='make aware; "They were awakened to the sad facts"'/>
<rdf:Description rdf:about="&a;200499778">
	<b:glossaryEntry xml:space='preserve'><![CDATA[break down into components or essential features; "analyze today''s financial market"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200499909">
	<b:glossaryEntry>hold the attention of; "The soprano held the audience"; "This story held our interest"; "She can hold an audience spellbound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200500104">
	<b:glossaryEntry>form anew in the imagination; recollect and re-form in the mind; "His mind re-creates the entire world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200500292">
	<b:glossaryEntry>be fascinated or spell-bound by; pay close attention to; "The mother drink in every word of her son on the stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200500479">
	<b:glossaryEntry xml:space='preserve'><![CDATA[maintain in the forefront of one''s awareness; "He kept note of the location of the soldiers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200500620"
	 b:glossaryEntry='keep from expressing; "I swallowed my anger and kept quiet"'/>
<rdf:Description rdf:about="&a;200500744"
	 b:glossaryEntry='capture the attention of; "This story will grab you"'/>
<rdf:Description rdf:about="&a;200500874">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bear (a cost or penalty), in recompense for some action; "You''ll pay for this!"; "She had to pay the penalty for speaking out rashly"; "You''ll pay for this opinion later"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200501113"
	 b:glossaryEntry='find the solution or key to; "break the code"'/>
<rdf:Description rdf:about="&a;200501239"
	 b:glossaryEntry='find a flaw in: "break an alibi"'/>
<rdf:Description rdf:about="&a;200501360">
	<b:glossaryEntry>challenge the sincerity or truthfulness of; "call the speaker on a question of fact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200501506">
	<b:glossaryEntry>utter in a loud voice or announce; "He called my name"; "The auctioneer called the bids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200501656">
	<b:glossaryEntry>include, as on a list; "How many people are carried on the payroll?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200501787">
	<b:glossaryEntry>become aware of who one is and what one wants to do in life; "My son went to Berkeley to find himself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200501969">
	<b:glossaryEntry>ponder; reflect on, or reason about; "Think the matter through"; "Think how hard life in Russia must be these days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200502173">
	<b:glossaryEntry>decide by pondering, reasoning, or reflecting; "Can you think what to do next?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200502333">
	<b:glossaryEntry>transmit thoughts or feelings; "He communicated his anxieties to the psychiatrist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200503131"
	 b:glossaryEntry="speak or write in aphorisms"/>
<rdf:Description rdf:about="&a;200503224"
	 b:glossaryEntry="speak in riddles"/>
<rdf:Description rdf:about="&a;200503304">
	<b:glossaryEntry>minimize the importance of, brush aside; "Jane shrugged off the news that her stock had fallen 3 points."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200503459">
	<b:glossaryEntry>let know; pass information on (to someone); "Please communicate this message to all employees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200503786"
	 b:glossaryEntry='pass along; "Please relay the news to the villagers"'/>
<rdf:Description rdf:about="&a;200503909"
	 b:glossaryEntry='communicate vividly; "He projected his feelings"'/>
<rdf:Description rdf:about="&a;200504030">
	<b:glossaryEntry>be in communication with, establish communication with; "Our advertisements reach millions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200504256">
	<b:glossaryEntry>establish radio communications with: "They managed to raise Hanoi last night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200504404">
	<b:glossaryEntry>change from a simple vowel to a diphthong; "This vowel diphthongized in Germanic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200504573">
	<b:glossaryEntry>undergo breaking; "The simple vowels broke in many Germanic languages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200504706">
	<b:glossaryEntry xml:space='preserve'><![CDATA[attempt to communicate; "I try to reach out to my daughter but she doesn''t want to have nything to do with me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200504909">
	<b:glossaryEntry>cause to speak, "Can you draw her out--she is always so quiet."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200505038">
	<b:glossaryEntry xml:space='preserve'><![CDATA[communicate successfully; "I couldn''t get across the message"; "He put over the idea very well"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200505212"
	 b:glossaryEntry="pronounce with a nasal twang"/>
<rdf:Description rdf:about="&a;200505303"
	 b:glossaryEntry="speak or recite rapidly or in a rolling voice"/>
<rdf:Description rdf:about="&a;200505419"
	 b:glossaryEntry='be social; "The old man hates to socialize"'/>
<rdf:Description rdf:about="&a;200505537">
	<b:glossaryEntry>make a request for something; "Order me some flowers"; "order a work stoppage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200505758"
	 b:glossaryEntry='to arrange for; "place a phone call", "place a bet"'/>
<rdf:Description rdf:about="&a;200505872"
	 b:glossaryEntry="issue an order"/>
<rdf:Description rdf:about="&a;200506012"
	 b:glossaryEntry="decree or determine beforehand"/>
<rdf:Description rdf:about="&a;200506118"
	 b:glossaryEntry='decree or ordain; "God wills our existence"'/>
<rdf:Description rdf:about="&a;200506231">
	<b:glossaryEntry>decree or designate beforehand; "She was destined to become a great pianist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200506398">
	<b:glossaryEntry>tell somebody to do something; "I said to him to go home"; "She ordered him to do the shopping"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200506658"
	 b:glossaryEntry="issue commands or orders for"/>
<rdf:Description rdf:about="&a;200506779">
	<b:glossaryEntry>impose or thrust urgently, importunately, or inexorably; "She forced her diet fads on him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200506975"
	 b:glossaryEntry='begin to speak or say; "Now listen, friends," he began'/>
<rdf:Description rdf:about="&a;200507092">
	<b:glossaryEntry xml:space='preserve'><![CDATA[thrust oneself in as if by force; "The colors don''t intrude on the viewer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200507249">
	<b:glossaryEntry>impose or inflict forcefully; "The military government clamped a curfew onto the capital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200507401">
	<b:glossaryEntry>saddle with something disagreeable or disadvantageous; "They stuck me with the dinner bill"; "I was stung with a huge tax bill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200507599">
	<b:glossaryEntry>impose something unpleasant: "The principal visited his rage on the students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200507843">
	<b:glossaryEntry>inflict as a punishment; "She gave the boy a good spanking"; "The judge gave me 10 years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200508030"
	 b:glossaryEntry='allow to have or take; "I give you two minutes to respond"'/>
<rdf:Description rdf:about="&a;200508150"
	 b:glossaryEntry='to force onto another; "He foisted his work on me"'/>
<rdf:Description rdf:about="&a;200508263">
	<b:glossaryEntry>command with authority; "He directed the children to do their homework"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200508398">
	<b:glossaryEntry>give directions to; point somebody into a certain direction; "I directed them towards the town hall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200508596">
	<b:glossaryEntry>indicate the right path or direction; "The sign pointed the way to London"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200508780">
	<b:glossaryEntry>give instructions or directions for some task; "She instructed the students to work on their pronounciation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200508990">
	<b:glossaryEntry>instruct or command with authority; "The teacher charged the children to memorize the poem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200509145">
	<b:glossaryEntry>instruct (a jury) about the law, its application, and the weighing of evidence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200509295">
	<b:glossaryEntry>impose a task upon, assign a responsibility to; "He charged her with cleaning up all the files over the weekend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200509569"
	 b:glossaryEntry="burden with too much work or responsibility"/>
<rdf:Description rdf:about="&a;200509688">
	<b:glossaryEntry>exert a force or cause a strain upon; "This tax bears down on the lower middle class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200509840"
	 b:glossaryEntry="charge someone with too many tasks"/>
<rdf:Description rdf:about="&a;200509970"
	 b:glossaryEntry="assign authority to"/>
<rdf:Description rdf:about="&a;200510062"
	 b:glossaryEntry="make someone do something"/>
<rdf:Description rdf:about="&a;200510225"
	 b:glossaryEntry="hire more workers than are necessary"/>
<rdf:Description rdf:about="&a;200510337"
	 b:glossaryEntry='be in command of; "The general commanded a huge army"'/>
<rdf:Description rdf:about="&a;200510499"
	 b:glossaryEntry='command as a general; "We are generaled by an incompetent!"'/>
<rdf:Description rdf:about="&a;200510623"
	 b:glossaryEntry="direct or command as an officer"/>
<rdf:Description rdf:about="&a;200510727">
	<b:glossaryEntry>make a request or demand for something to somebody; "She asked him for a loan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200510998">
	<b:glossaryEntry>express the need or desire for; ask for; "She requested an extra bed in her room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200511577">
	<b:glossaryEntry>ask (a person) to do something: "She asked him to be here at noon"; "I requested that she type the entire manuscript"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200511847">
	<b:glossaryEntry>order or request for a specific duty or role; "He was already called 4 times for jury duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200512000">
	<b:glossaryEntry>order or request or give a command for; "The unions called a general strike for Sunday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200512157"
	 b:glossaryEntry="request an encore, from a performer"/>
<rdf:Description rdf:about="&a;200512256"
	 b:glossaryEntry="make a formal request for official services"/>
<rdf:Description rdf:about="&a;200512368"
	 b:glossaryEntry="call out somebody''s name over a P.A. system"/>
<rdf:Description rdf:about="&a;200512473">
	<b:glossaryEntry>write a petition for something to somebody; request formally and in writing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200512630">
	<b:glossaryEntry xml:space='preserve'><![CDATA[request urgently and forcefully; "The victim''s family is demanding compensation"; "The boss demanded that he be fired immediately"; "She demanded to see the manager"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200512983">
	<b:glossaryEntry>exert oneself continuously, vigorously, or obtrusively to gain an end; "The liberal party pushed for reforms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200513170"
	 b:glossaryEntry="command solemnly"/>
<rdf:Description rdf:about="&a;200513250">
	<b:glossaryEntry>request earnestly (something from somebody); "appeal to somebody for help"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200513425">
	<b:glossaryEntry xml:space='preserve'><![CDATA[consider obligatory; request and expect; "We require our secretary to be on time"; "Aren''t we asking too much of these children?" "I expect my students to arrive in time for their lessons"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200513719">
	<b:glossaryEntry>take as an undesirable consequence of some event or state of affairs; "the accident claimed three lives"; "The hard work took its toll on her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200513974">
	<b:glossaryEntry>assert or affirm strongly; state to be true or existing; "He claimed that he killed the burglar"; "The guru claimed many followers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200514283">
	<b:glossaryEntry>maintain or assert; "He contended that Communism ahd no future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200514423">
	<b:glossaryEntry>try to establish: "She made out that she know nothing about the crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200514559">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have the often specious appearance of being, intending, or claiming; "The letter purports to express people''s opinion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200514743"
	 b:glossaryEntry='make a disclaimer about; "He disclaimed any responsibility"'/>
<rdf:Description rdf:about="&a;200514894">
	<b:glossaryEntry>cast off or disown: "She renounced her husband"; "The parents repudiated their son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200515153"
	 b:glossaryEntry="abandon one''s beliefs or allegiances"/>
<rdf:Description rdf:about="&a;200515285"
	 b:glossaryEntry='deny or renounce; "They abnegated their gods"'/>
<rdf:Description rdf:about="&a;200515404"
	 b:glossaryEntry="renounce a legal claim or title to"/>
<rdf:Description rdf:about="&a;200515522">
	<b:glossaryEntry>lay claim to; as of an idea; "She took credit for the whole idea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200515709"
	 b:glossaryEntry="plead or ask for earnestly"/>
<rdf:Description rdf:about="&a;200515798"
	 b:glossaryEntry="ask humbly (for something)"/>
<rdf:Description rdf:about="&a;200515892"
	 b:glossaryEntry='call upon in supplication; entreat; "I beg you to stop!"'/>
<rdf:Description rdf:about="&a;200516106"
	 b:glossaryEntry='appeal or request earnestly; "I pleaded with him to stop"'/>
<rdf:Description rdf:about="&a;200516262">
	<b:glossaryEntry>ask for or request earnestly; "The prophet bid all people to become good persons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200516449"
	 b:glossaryEntry="address God; say a prayer"/>
<rdf:Description rdf:about="&a;200516552">
	<b:glossaryEntry>communicate intimately with; be in a state of heightened, intimate receptivity; "He seemed to commune with nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200516749"
	 b:glossaryEntry="receive Communion, in the Catholic church"/>
<rdf:Description rdf:about="&a;200516869"
	 b:glossaryEntry='enter a plea, as in courts of law; "She pleaded not guilty"'/>
<rdf:Description rdf:about="&a;200516991">
	<b:glossaryEntry xml:space='preserve'><![CDATA[confess one''s faith in, or allegiance to; "The terrorists professed allegiance to the Muslim faith"; "he professes to be a Communist"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200517197">
	<b:glossaryEntry>act between parties with a view to reconciling differences; "He interceded in the family dispute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200517401"
	 b:glossaryEntry='settle a dispute; "He mediated a settlement"'/>
<rdf:Description rdf:about="&a;200517522"
	 b:glossaryEntry='settle, as of a debt; "clear a debt"'/>
<rdf:Description rdf:about="&a;200517621">
	<b:glossaryEntry xml:space='preserve'><![CDATA[settle by agreement; "concert one''s differences"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200517734">
	<b:glossaryEntry>discuss the terms of an arrangement; "They negotiated the terms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200517980"
	 b:glossaryEntry="negociate with much give and take"/>
<rdf:Description rdf:about="&a;200518082"
	 b:glossaryEntry="discuss, as between enemies"/>
<rdf:Description rdf:about="&a;200518191"
	 b:glossaryEntry="hold a powwow, talk, conference or meeting"/>
<rdf:Description rdf:about="&a;200518297">
	<b:glossaryEntry>have a lengthy discussion, usually between people of different backgrounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200518436">
	<b:glossaryEntry>settle conclusively; come to terms; "We finally settled the argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200518678">
	<b:glossaryEntry>complete a business deal, negociation, or an agreement; "We closed on the house on Friday"; "They closed the deal on the building"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200518879">
	<b:glossaryEntry>end a legal dispute by arriving at a settlement; "The two parties finally settled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200519033">
	<b:glossaryEntry>consent or assent to a condition, or agree to do something: "She agreed to all my conditions"; "He agreed to leave her alone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200519247"
	 b:glossaryEntry='come to terms; "After some discussion we finally made up"'/>
<rdf:Description rdf:about="&a;200519450"
	 b:glossaryEntry="make peace with"/>
<rdf:Description rdf:about="&a;200519543">
	<b:glossaryEntry>ask (for something); "He applied for a leave of absence"; "She applied for college"; "apply for a job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200519742">
	<b:glossaryEntry>force or impel in an indicated direction; "I urged him to finish his studies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200519945">
	<b:glossaryEntry>press, drive, or impel to action; "He pushed her to finish her doctorate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200520166"
	 b:glossaryEntry="push into action by pestering or annoying gently"/>
<rdf:Description rdf:about="&a;200520277">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cause somebody to adopt a certain position, belief, or course of action; twist somebody''s arm; "You can''t persuade me to buy this ugly vase!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200520770">
	<b:glossaryEntry>cause to adopt an opinion or course of action; "His urgent letter finally brought me around to give money to the school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200520982">
	<b:glossaryEntry>induce or persuade; "The confession of one of the accused brought the others to admit to the crime as well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200521178"
	 b:glossaryEntry="persuade through constant efforts"/>
<rdf:Description rdf:about="&a;200521283">
	<b:glossaryEntry>persuade somebody to accept something; "The French try to sell us their image as great lovers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200521455"
	 b:glossaryEntry="talk to someone with the aim of persuading him"/>
<rdf:Description rdf:about="&a;200521566">
	<b:glossaryEntry>speak with fire and passion; "He blazed away at his opponents in the Senate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200521710"
	 b:glossaryEntry="give the keynote address to (an audience)"/>
<rdf:Description rdf:about="&a;200521816"
	 b:glossaryEntry="persuade someone not to do something"/>
<rdf:Description rdf:about="&a;200521939"
	 b:glossaryEntry="persuade somebody to do something"/>
<rdf:Description rdf:about="&a;200522057">
	<b:glossaryEntry>draw in as if with a rope; lure; "The agent had roped in several customers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200522215">
	<b:glossaryEntry>influence or urge by gentle urging, caressing, or flattering; "He palavered her into going along"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200522473"
	 b:glossaryEntry="use flattering talk on somebody"/>
<rdf:Description rdf:about="&a;200522571"
	 b:glossaryEntry="persuade someone through flattery"/>
<rdf:Description rdf:about="&a;200522671">
	<b:glossaryEntry>make (someone) agree, understand, or realize the truth or validity of something; "He had finally convinced several customers of the advantages of his product"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200522959"
	 b:glossaryEntry="convert to another faith or religion"/>
<rdf:Description rdf:about="&a;200523082">
	<b:glossaryEntry>persuade completely, often through coercion; "The propaganda brainwashed many people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200523234">
	<b:glossaryEntry>turn away from by persuasion; "Negative campaigning will only dissuade people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200523422">
	<b:glossaryEntry>cause to do; cause to act in a specified manner: "The ads induced me to buy a VCR"; "My children finally got me to buy a computer"; "My wife made me buy a new sofa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200523848">
	<b:glossaryEntry>spur on; "His financial success encouraged him to look for a wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200523981">
	<b:glossaryEntry>actively cause something to happen; "I let it be known that I was not interested"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200524123">
	<b:glossaryEntry>cause to undertake a certain action; "Her greed led her to forge the checks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200524279">
	<b:glossaryEntry>guide or direct, as by behavior of persuasion: "You gave me to think that you agreed with me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200524434">
	<b:glossaryEntry>serve as the inciting cause of; "She prompted me to call my relatives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200524590"
	 b:glossaryEntry="present reasons and arguments"/>
<rdf:Description rdf:about="&a;200524745">
	<b:glossaryEntry>argue again: "This politician will be forced into re-arguing an old national campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200524897">
	<b:glossaryEntry>give evidence of; "The evidence argues for your claim"; "The results indicate the need for more work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200525080"
	 b:glossaryEntry='bring forward; "We presented the arguments to him"'/>
<rdf:Description rdf:about="&a;200525249"
	 b:glossaryEntry="reason with (somebody) for the purpose of dissuasion"/>
<rdf:Description rdf:about="&a;200525378"
	 b:glossaryEntry="have an argument about something"/>
<rdf:Description rdf:about="&a;200525624"
	 b:glossaryEntry="dispute or argue stubbornly, esp. minor points"/>
<rdf:Description rdf:about="&a;200525735"
	 b:glossaryEntry='fight verbally; "They were sparring all night"'/>
<rdf:Description rdf:about="&a;200525851">
	<b:glossaryEntry xml:space='preserve'><![CDATA[argue over petty things; "Let''s not quibble over pennies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200526031">
	<b:glossaryEntry>to quarrel noisily, angrily or disruptively: "The bar keeper threw them out, but they continued to wrangle on down the street."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200526239"
	 b:glossaryEntry='make loud demands; "he clamored for justice and tolerance"'/>
<rdf:Description rdf:about="&a;200526379"
	 b:glossaryEntry="engage in a brief and petty quarrel"/>
<rdf:Description rdf:about="&a;200526476">
	<b:glossaryEntry>engage in a controversy; "The two historians polemicized for years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200526635">
	<b:glossaryEntry>have a disagreement over something; "We quarreled over the question as to who discovered America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200526908">
	<b:glossaryEntry>have a breach in relations; "We fell out over a trivial question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200527047">
	<b:glossaryEntry>be against; express opposition to; "We oppose the ban on abortion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200527203"
	 b:glossaryEntry='be resistant to; "The board opposed his motion."'/>
<rdf:Description rdf:about="&a;200527377">
	<b:glossaryEntry>assure somebody of the truth of something; "I assured him that traveling to Combodia was safe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200527561">
	<b:glossaryEntry xml:space='preserve'><![CDATA[induce into action by using one''s charm; "She charmed him into giving her all his money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200527758"
	 b:glossaryEntry="chatter inarticulately; of monkeys"/>
<rdf:Description rdf:about="&a;200527864">
	<b:glossaryEntry>cast a spell over someone or something; put a hex on someone or something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200528087"
	 b:glossaryEntry="bewitch by or as if by a voodoo"/>
<rdf:Description rdf:about="&a;200528182">
	<b:glossaryEntry>attract strongly, as if with a magnet; "She magnetized the audience with her tricks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200528375">
	<b:glossaryEntry>use persuasion successfully; "He prevailed upon her to visit his parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200528513">
	<b:glossaryEntry>beg persistently and urgently; "I importune you to help them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200528650">
	<b:glossaryEntry>make a break in; "We interrupt the program for the following messages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200529048"
	 b:glossaryEntry='interrupt the flow of current in; "break a circuit"'/>
<rdf:Description rdf:about="&a;200529170">
	<b:glossaryEntry>turn away from and put aside, perhaps temporarily; "She turned away from her painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200529322">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cease an action temporarily; "We pause for station identification"; "let''s break for lunch"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200529549"
	 b:glossaryEntry="take a short breath"/>
<rdf:Description rdf:about="&a;200529679">
	<b:glossaryEntry>give a rest to; "He rested his bad leg"; "Rest the dogs for a moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200529828"
	 b:glossaryEntry='allow to regain its breath; "blow a horse"'/>
<rdf:Description rdf:about="&a;200529932">
	<b:glossaryEntry>take a five-minute break; "The musicians took five during the rehearsal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200530071">
	<b:glossaryEntry>take a ten minute break; "The players took ten during the long rehearsal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200530210">
	<b:glossaryEntry>break into a conversation; "her husband always chimes in, even wehn he is not involved in the conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200530451"
	 b:glossaryEntry='spring suddenly; "He burst upon our conversation"'/>
<rdf:Description rdf:about="&a;200530582">
	<b:glossaryEntry>turn aside esp. from the main subject of attention or course of argument in writing or speaking; "She always digresses when telling a story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200530824">
	<b:glossaryEntry xml:space='preserve'><![CDATA[continue to speak: "I know it''s hard," he continued, "but there is no choice."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200531049"
	 b:glossaryEntry='continue; "He went ahead with the project"'/>
<rdf:Description rdf:about="&a;200531178">
	<b:glossaryEntry>proceed without interruption; in music or talk; "He segued into another discourse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200531339">
	<b:glossaryEntry xml:space='preserve'><![CDATA[offer one''s body for sex in return for money; "he was solicited by a prostitute"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200531494">
	<b:glossaryEntry>make a solicitation or entreaty for something; request urgently</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200531688"
	 b:glossaryEntry="seek alms, as for religious purposes"/>
<rdf:Description rdf:about="&a;200531787">
	<b:glossaryEntry>provoke someone to do something through promises or persuasion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200532052">
	<b:glossaryEntry>lure by imitating the characteristic call of an animal: "Call ducks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200532182">
	<b:glossaryEntry>persuade to to come away from something attractive or interesting; "He dragged me away from the television set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200532355"
	 b:glossaryEntry="lure with a stool, as of wild fowl"/>
<rdf:Description rdf:about="&a;200532452"
	 b:glossaryEntry="entice or induce esp. when unwise or mistaken"/>
<rdf:Description rdf:about="&a;200532570"
	 b:glossaryEntry="entice through the use of music"/>
<rdf:Description rdf:about="&a;200532674"
	 b:glossaryEntry='try presumptuously; "St. Anthony was tempted in the desert"'/>
<rdf:Description rdf:about="&a;200532796">
	<b:glossaryEntry>inquire about; "I asked about their special today"; "He had to ask directions several times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200533091">
	<b:glossaryEntry xml:space='preserve'><![CDATA[direct or put; seek an answer to: "ask a question"; "pose a problem to one''s students"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200533263">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be nosey; "Don''t pry into my personal matters!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200533379"
	 b:glossaryEntry="pose a question"/>
<rdf:Description rdf:about="&a;200533592"
	 b:glossaryEntry="question formally about policy or government business"/>
<rdf:Description rdf:about="&a;200533715">
	<b:glossaryEntry>secretly collect sensitive or classified information; engage in espionage; "spy for the Russians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200533881"
	 b:glossaryEntry="watch, observe, or inquire secretly"/>
<rdf:Description rdf:about="&a;200534018">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conduct an inquiry of; "The district attorney''s office investigated reports of possible irregularities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200534224">
	<b:glossaryEntry xml:space='preserve'><![CDATA[examine someone''s knowledge of something; "The teacher tests us every week"; "We got quizzed on French irregular verbs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200534420"
	 b:glossaryEntry="question closely"/>
<rdf:Description rdf:about="&a;200534563">
	<b:glossaryEntry>question closely. or question a witness that has already been questioned by the opposing side; "The witness was cross-examined by the defense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200534801"
	 b:glossaryEntry="examine through questioning and answering"/>
<rdf:Description rdf:about="&a;200534921"
	 b:glossaryEntry="give religious instructions to"/>
<rdf:Description rdf:about="&a;200535030">
	<b:glossaryEntry xml:space='preserve'><![CDATA[strengthen and support with rewards; "Let''s reinforce good behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200535174">
	<b:glossaryEntry>teach without challenging the students; "This professir spoonfeeds his students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200535337">
	<b:glossaryEntry>question persistently; "She pumped the witnesses for information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200535464">
	<b:glossaryEntry>pose a series of questions to; "The suspect was questioned by the police"; "We questioned the survivor about the details of the explosion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200535682"
	 b:glossaryEntry="question or examine thoroughly and closely"/>
<rdf:Description rdf:about="&a;200535831">
	<b:glossaryEntry xml:space='preserve'><![CDATA[investigate scientifically: "Let''s investigate the syntax of Chinese"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200536087">
	<b:glossaryEntry>get or try to get into communication by telephone; "I tried to call you all night"; "Take two aspirin and call me in the morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200536377">
	<b:glossaryEntry>communicate (with) by telephone; "call in to a radio station"; "call in sick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200536527">
	<b:glossaryEntry>operate a dial to select a telephone number; "You must take the receive off the hook before you dial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200536690">
	<b:glossaryEntry>hold the phone line open; "Please hang on while I get yoour folder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200536866"
	 b:glossaryEntry="communicate long-distance, as via the telephone or e-mail"/>
<rdf:Description rdf:about="&a;200537104">
	<b:glossaryEntry>communicate by telex; "We telexed the information to our sister company"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200537255"
	 b:glossaryEntry="call in an official matter, such as to attend court"/>
<rdf:Description rdf:about="&a;200537468">
	<b:glossaryEntry>summon to return; "The ambassador was recalled to his country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200537594">
	<b:glossaryEntry>summon to a particular activity or employment; "Experts were called in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200537741"
	 b:glossaryEntry="summon (a vouchee) into court to warrant or defend a title"/>
<rdf:Description rdf:about="&a;200537862">
	<b:glossaryEntry>summon into court to defend a lawsuit against another and to be made liable to pay any judgment secured for the plaintiff; "the defendant couches in his own insurance liability company to defend a negligence case aginst him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200538152"
	 b:glossaryEntry='call with a buzzer; "he buzzed the servant"'/>
<rdf:Description rdf:about="&a;200538265">
	<b:glossaryEntry xml:space='preserve'><![CDATA[order, request, or command to come; "He has been called to active military duty"; "She was called into the director''s office"; "Call the police!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200538725"
	 b:glossaryEntry="call to stop the hunt or to retire, as of hunting dogs"/>
<rdf:Description rdf:about="&a;200538841">
	<b:glossaryEntry>call together; "The students were convened in the auditorium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200538985"
	 b:glossaryEntry="call to duty, military service, jury duty, etc."/>
<rdf:Description rdf:about="&a;200539096">
	<b:glossaryEntry>serve or summon with a subpoena; "The witness and her records were subpoenaed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200539240"
	 b:glossaryEntry="ask someone in a friendly way to do something"/>
<rdf:Description rdf:about="&a;200539391"
	 b:glossaryEntry="entice to do"/>
<rdf:Description rdf:about="&a;200539509"
	 b:glossaryEntry="provide the needed stimulus for"/>
<rdf:Description rdf:about="&a;200539705"
	 b:glossaryEntry='stimulate to remember: "jog my memory"'/>
<rdf:Description rdf:about="&a;200539812">
	<b:glossaryEntry>make an appeal of request to; "She called on her Representative to help her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200540003"
	 b:glossaryEntry="book all available places or tickets"/>
<rdf:Description rdf:about="&a;200540104">
	<b:glossaryEntry>make a schedule; plan the time and place for events; "I scheduled an exam for this afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200540315"
	 b:glossaryEntry="arrange a program of or for"/>
<rdf:Description rdf:about="&a;200540419">
	<b:glossaryEntry xml:space='preserve'><![CDATA[assign a new time and place for an event; "We had to reschedule the doctor''s appointment"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200540576">
	<b:glossaryEntry xml:space='preserve'><![CDATA[obtain or arrange in advance: "We managed to reserve a table at Maxim''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200540739"
	 b:glossaryEntry='command against; "I forbid you to call me late at night"'/>
<rdf:Description rdf:about="&a;200541028">
	<b:glossaryEntry>prohibit esp. by legal means or social pressure; "Smoking is banned in this building"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200541183">
	<b:glossaryEntry>prevent from entering; keep out; "He was barred from membership in the club"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200541362"
	 b:glossaryEntry="issue an injunction"/>
<rdf:Description rdf:about="&a;200541445"
	 b:glossaryEntry='reject with contempt; "She spurned his advances"'/>
<rdf:Description rdf:about="&a;200541647">
	<b:glossaryEntry>speak in a blustering or scornful manner; "A puffing kind of man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200541774"
	 b:glossaryEntry="show unwillingness towards"/>
<rdf:Description rdf:about="&a;200541962">
	<b:glossaryEntry>give an affirmative reply to; respond favorably to: "I cannot accept your invitation"; "I go for this resolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200542284">
	<b:glossaryEntry>accept despite complete satisfaction; "We settled for a lower price"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200542416">
	<b:glossaryEntry>consent in writing to pay money to a trade union for political use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200542569"
	 b:glossaryEntry="refuse to pay a levy to a union for political use"/>
<rdf:Description rdf:about="&a;200542706"
	 b:glossaryEntry="reject outright and bluntly"/>
<rdf:Description rdf:about="&a;200542832">
	<b:glossaryEntry>reject; "He retracted his earlier statements about his beliefs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200542989"
	 b:glossaryEntry='take back what one has said; "He swallowed his words"'/>
<rdf:Description rdf:about="&a;200543138"
	 b:glossaryEntry='state something incorrectly: "You misstated my position"'/>
<rdf:Description rdf:about="&a;200543260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make a retreat; "We''ll have to crawfish out from meeting with him"; "He backed out of his earlier promise"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200543473">
	<b:glossaryEntry>annul by recalling or rescinding; "He revoked the ban on smoking"; "lift an embargo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200543716">
	<b:glossaryEntry>fail to fulfill a promise or obligation; "She backed out of her promise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200543917"
	 b:glossaryEntry="of cheques or tickets"/>
<rdf:Description rdf:about="&a;200544015"
	 b:glossaryEntry='place into brackets; "Please bracket this remark"'/>
<rdf:Description rdf:about="&a;200544143">
	<b:glossaryEntry>remove from a list; "Cross the name of the dead person off the list"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200544324">
	<b:glossaryEntry>bar from attention or consideration; "She dismissed his advances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200544641"
	 b:glossaryEntry='disregard; "She passed off the insult"'/>
<rdf:Description rdf:about="&a;200544745">
	<b:glossaryEntry>cease to consider; put out of judicial consideration: "This case is dismissed!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200544883"
	 b:glossaryEntry='treat with contemptuous disregard; "flout the rules"'/>
<rdf:Description rdf:about="&a;200545006">
	<b:glossaryEntry>refuse to acknowledge; "He turns a blind eye to the injustices in his office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200545165">
	<b:glossaryEntry>deal with a problem by laughing or pretending to be amused by it; "She laughs away all these problems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200545347">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give permission; "She permitted her son to visit her estranged husband"; "I won''t let the police search her basement"; "I cannot allow you to see your exam"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200545801">
	<b:glossaryEntry xml:space='preserve'><![CDATA[allow the presence of; "We don''t allow dogs here"; "Children are not permitted beyond this point"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200545978">
	<b:glossaryEntry>grant authorization or clearance for; "Clear the manuscript fpr publication"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200546336"
	 b:glossaryEntry="approve or sanction officially"/>
<rdf:Description rdf:about="&a;200546433"
	 b:glossaryEntry="authorize by certificate"/>
<rdf:Description rdf:about="&a;200546534"
	 b:glossaryEntry='to agree or express agreement: "Yes, the Maestro assented."'/>
<rdf:Description rdf:about="&a;200546749"
	 b:glossaryEntry="consent reluctantly"/>
<rdf:Description rdf:about="&a;200546908"
	 b:glossaryEntry='withhold assent; "Several Republicans dissented"'/>
<rdf:Description rdf:about="&a;200547039"
	 b:glossaryEntry='be at loggerheads; "I beg to differ!"'/>
<rdf:Description rdf:about="&a;200547234"
	 b:glossaryEntry='disagree violently; "We clashed over the new farm policies"'/>
<rdf:Description rdf:about="&a;200547364">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be in accord; be in agreement; "We agreed on the terms of the settlement"; "I can''t agree with you!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200547704"
	 b:glossaryEntry='be in agreement; "We never saw eye to eye on this question"'/>
<rdf:Description rdf:about="&a;200547843"
	 b:glossaryEntry='be willing to concede; "I grant you this much..."'/>
<rdf:Description rdf:about="&a;200548039"
	 b:glossaryEntry='adopt as a belief; "I subscribe to your view on abortion"'/>
<rdf:Description rdf:about="&a;200548199"
	 b:glossaryEntry='give sanction to; "I approve of his educational policies"'/>
<rdf:Description rdf:about="&a;200548424"
	 b:glossaryEntry='approve officially; "The list of speakers must be visaed"'/>
<rdf:Description rdf:about="&a;200548543">
	<b:glossaryEntry>refuse to approve; "I disapprove of her child rearing methods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200548744">
	<b:glossaryEntry>express or raise an objection or protest; express dissent; "She never objected to the amount of work her boss charged her with"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200549067"
	 b:glossaryEntry="take exception to"/>
<rdf:Description rdf:about="&a;200549164"
	 b:glossaryEntry="raise a formal objection in a court of law"/>
<rdf:Description rdf:about="&a;200549308">
	<b:glossaryEntry>ask for identification; "The illegal immigrant was challenged by the border guard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200549475">
	<b:glossaryEntry>challenge in turn; ""The authentication was counterchallenged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200549619"
	 b:glossaryEntry="raise trivial objections"/>
<rdf:Description rdf:about="&a;200549731">
	<b:glossaryEntry>conduct an interview in television, newspaper, and radio reporting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200549875">
	<b:glossaryEntry xml:space='preserve'><![CDATA[try to learn someone''s opinions and intentions; "I have to sound out the new professor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200550052">
	<b:glossaryEntry>discuss formally with (somebody) for the purpose of an evaluation; "We interviewed the job candidates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200550221">
	<b:glossaryEntry>go for an interview in the hope of being hired; "The job candidate interviewed everywhere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200550404">
	<b:glossaryEntry>avoid or try to avoid, as of duties, questions and issues; "He dodged the issue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200550636"
	 b:glossaryEntry='fail to experience; "Fortunately, I missed the hurricane"'/>
<rdf:Description rdf:about="&a;200550772">
	<b:glossaryEntry xml:space='preserve'><![CDATA[escape potentially unpleasant consequences; get away with a forbidden action; "She gets away with murder!" "I couldn''t get out from under these responsibilities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200551045">
	<b:glossaryEntry>avoid something unpleasant or laborious; "You cannot bypass these rules!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200551242">
	<b:glossaryEntry>stay clear from; keep away from; keep out of the way of someone or something; "Her former friends now avoid her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200551551"
	 b:glossaryEntry='avoid dealing with; "She shirks her duties"'/>
<rdf:Description rdf:about="&a;200551672">
	<b:glossaryEntry>avoid having to deal with some unpleasant task; "I shy away from this task"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200551826"
	 b:glossaryEntry="avoid and stay away from deliberately; stay clear of"/>
<rdf:Description rdf:about="&a;200551957">
	<b:glossaryEntry>come to grips with face (something unpleasant) head on; "You must confront your problems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200552181"
	 b:glossaryEntry="discuss the pros and cons of an issue"/>
<rdf:Description rdf:about="&a;200552303">
	<b:glossaryEntry>think about carefully; weigh; "They considered the possibility of a strike"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200552571">
	<b:glossaryEntry>engage in deep thought, consideration, or debate; "I wrestled with this decision for years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200552727">
	<b:glossaryEntry>discuss lightly; "We bandied around these difficult questions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200552866"
	 b:glossaryEntry='preside over; "John moderated the discussion"'/>
<rdf:Description rdf:about="&a;200553000">
	<b:glossaryEntry>speak with others about (something); talk (something) over in detail; have a discussion; "We discussed our household budget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200553397"
	 b:glossaryEntry="talk or hold forth formally"/>
<rdf:Description rdf:about="&a;200553491">
	<b:glossaryEntry xml:space='preserve'><![CDATA[overthrow by argument, evidence, or proof; "The speaker refuted his opponent''s arguments"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200553715">
	<b:glossaryEntry>give a defence or refutation of (a charge) or in (an argument); "The defendant answered to all the charges of the prosecution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200553905">
	<b:glossaryEntry>speak in response; "He countered with some very persuasive arguments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200554047">
	<b:glossaryEntry>answer adequately or successfully; "The lawyer fileded all questions from the press"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200554194">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reply or respond to; "She didn''t want to answer"; "answer the question"; "We answered that we would accept the invitation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200554494"
	 b:glossaryEntry="answer back"/>
<rdf:Description rdf:about="&a;200554625">
	<b:glossaryEntry>declare untrue; contradict; "He denied the allegations"; "She denied that she had taken money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200554843"
	 b:glossaryEntry='refuse to accept or believe; "He denied his fatal illness"'/>
<rdf:Description rdf:about="&a;200554989"
	 b:glossaryEntry='refuse to recognize or acknowledge; "Peter denied Jesus"'/>
<rdf:Description rdf:about="&a;200555115">
	<b:glossaryEntry>declare or acknowledge to be true; "He admitted his errors"; "She acknowledged that she might have forgotten"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200555417"
	 b:glossaryEntry="declare to be obsolete"/>
<rdf:Description rdf:about="&a;200555517"
	 b:glossaryEntry="declare a child to be illegitimate"/>
<rdf:Description rdf:about="&a;200555619"
	 b:glossaryEntry='admit as valid; "The court sustained the motion"'/>
<rdf:Description rdf:about="&a;200555732">
	<b:glossaryEntry>make a clean breast of; "She confessed that she had taken the money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200555893">
	<b:glossaryEntry>confess to God in the presence of a priest, as in the Catholic faith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200556026"
	 b:glossaryEntry='be insistent and refuse to budge; "I must insist!"'/>
<rdf:Description rdf:about="&a;200556186"
	 b:glossaryEntry="refuse to abandon one''s opinion or belief"/>
<rdf:Description rdf:about="&a;200556340">
	<b:glossaryEntry>confess to a punishable or reprehensible deed, usually under pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200556500"
	 b:glossaryEntry="claim to be proficient"/>
<rdf:Description rdf:about="&a;200556587"
	 b:glossaryEntry="admit openly and bluntly; make no bones about"/>
<rdf:Description rdf:about="&a;200556722">
	<b:glossaryEntry>refuse to acknowledge; disclaim knowledge of; responsibility for, or association with; "Her husband disavowed her after 30 years of marriage and six children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200556981">
	<b:glossaryEntry>affirm to be true,genuine, or correct, asin an official capacity; "I attest this signature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200557170">
	<b:glossaryEntry>establish or verify the usage of; "This word is not attested until 1993"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200557342"
	 b:glossaryEntry='state firmly; "He declared that he was innocent"'/>
<rdf:Description rdf:about="&a;200557499">
	<b:glossaryEntry>provide evidence for; stand as proof of; "His high fever attested to his illness"; "The buildings in Rome manifest a high level of architectural sophistication"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200557831">
	<b:glossaryEntry>authenticate as a notary; "We had to have the signature notarized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200557963"
	 b:glossaryEntry="declare legally insane"/>
<rdf:Description rdf:about="&a;200558050">
	<b:glossaryEntry>declare to be; "She was declared incompetent"; " judge held that the defendant was innocent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200558412">
	<b:glossaryEntry>declare in the capacity of an umpire or referee; "call a runner out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200558560">
	<b:glossaryEntry>in the Catholic church; declare to be a saint; "On Sunday, the martyr will be beatified by the Vatican"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200558747"
	 b:glossaryEntry="deny the truth of"/>
<rdf:Description rdf:about="&a;200558872"
	 b:glossaryEntry="rebuke formally"/>
<rdf:Description rdf:about="&a;200558976">
	<b:glossaryEntry>criticize harshly or violently; "The press savaged the new President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200559117"
	 b:glossaryEntry='take to task; "He admonished the child for his bad behavior"'/>
<rdf:Description rdf:about="&a;200559253">
	<b:glossaryEntry>censure severely; "She chastized him for his insensitive remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200559457"
	 b:glossaryEntry="criticize harshly, on the e-mail"/>
<rdf:Description rdf:about="&a;200559552">
	<b:glossaryEntry xml:space='preserve'><![CDATA[censure severely or angrily; "The mother scolded the child for entering the stranger''s car"; "The deputy ragged the Prime Minister"; "The customer dressed down the waiter for bringing cold soup"; "check" is archaic]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200560060"
	 b:glossaryEntry='reprimand; "She told the misbehaving student off"'/>
<rdf:Description rdf:about="&a;200560188"
	 b:glossaryEntry="speak spontaneously and without restraint"/>
<rdf:Description rdf:about="&a;200560318">
	<b:glossaryEntry>utter a reproach to; "The president reproached the general for his irresponsible behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200560484"
	 b:glossaryEntry="express strong disapproval of"/>
<rdf:Description rdf:about="&a;200560580">
	<b:glossaryEntry xml:space='preserve'><![CDATA[express strong disapproval of; "We deplore the government''s treatment of political prisoners"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200560756">
	<b:glossaryEntry>express criticism of; point out real or perceived flaws; "The paper criticized the new movie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200561219">
	<b:glossaryEntry>attack verbally with harsh criticism; "She was belabored by her fellow students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200561375">
	<b:glossaryEntry>criticize or reprimand harshly; "The critics came down hard on the new play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200561518"
	 b:glossaryEntry='praise or celebrate in song; "All tongues shall troll you"'/>
<rdf:Description rdf:about="&a;200561647"
	 b:glossaryEntry="speak, plead, or argue in favour of"/>
<rdf:Description rdf:about="&a;200561791">
	<b:glossaryEntry>deliver a sermon; "The minister is not preaching this Sunday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200561961"
	 b:glossaryEntry="preach the gospel (to)"/>
<rdf:Description rdf:about="&a;200562059">
	<b:glossaryEntry>speak as if delivering a sermon; "This man always sermonizes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200562221">
	<b:glossaryEntry>talk in a dogmatic and pompous manner; "The new professor always pontificates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200562369"
	 b:glossaryEntry="talk pompously"/>
<rdf:Description rdf:about="&a;200562446">
	<b:glossaryEntry>impart skills or knowledge to; "I taught them French"; "He instructed me in building a boat"; "learn" is not standard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200562981">
	<b:glossaryEntry>be a tutor to someone; give individual instruction; "She tutored me in Spanish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200563124">
	<b:glossaryEntry>cause to disbelieve; teach someone the contrary of what he or she had learned earlier</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200563274">
	<b:glossaryEntry>cause to unlearn; "teach somebody to unlearn old habits or methods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200563424"
	 b:glossaryEntry="instruct someone in the fundamentals of a subject"/>
<rdf:Description rdf:about="&a;200563537">
	<b:glossaryEntry>deliver a lecture or talk; "She will talk at Rutgers next week"; "Did you ever lecture at Harvard?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200563742">
	<b:glossaryEntry>make aware of; "Have the students been apprised of the tuition hike?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200563942">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give essential information to someone; "The reporters were briefed about the President''s plan to invade"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200564109">
	<b:glossaryEntry>put someone through a debriefing and make him report; "The released hostages were debriefed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200564266"
	 b:glossaryEntry='give information; "I informed him of his rights"'/>
<rdf:Description rdf:about="&a;200564954">
	<b:glossaryEntry>act as an informer; "She had informed on her own parents for years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200565093">
	<b:glossaryEntry>supply with information on a specific topic; "He filled me in on the latest developments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200565247"
	 b:glossaryEntry="bring up to date; supply with recent information"/>
<rdf:Description rdf:about="&a;200565367"
	 b:glossaryEntry="teach and supervise, as in sports or acting"/>
<rdf:Description rdf:about="&a;200565489"
	 b:glossaryEntry="give false or misleading information to"/>
<rdf:Description rdf:about="&a;200565685">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tell an untruth; pretend with intent to deceive; "Don''t lie to your parents"; "She lied when she told me she was only 29"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200565947">
	<b:glossaryEntry>tell romantic or exaggerated lies; "This author romanced his trip to an exotic country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200566099">
	<b:glossaryEntry>knowingly tell an untruth in a legal court and render oneself guilty of perjury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200566261">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tell a relatively insignificant lie; "Fibbing is not acceptable, even if you don''t call it lying"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200566419">
	<b:glossaryEntry>be deliberately ambiguous or unclear in order to mislead or withhold information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200566613">
	<b:glossaryEntry>make false by mutilation or addition; as of a message or story</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200566766">
	<b:glossaryEntry>express indirectly; be a symbol of; "What does the Statue of Liberty symbolize?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200566991">
	<b:glossaryEntry>represent falsely; "This statement misrepresents my intentions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200567230">
	<b:glossaryEntry>distort; "My personal feelings color my judgment in this case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200567365"
	 b:glossaryEntry='gloss or excuse; "color a lie"'/>
<rdf:Description rdf:about="&a;200567466">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pretend to be someone you are not; with fraudulent intentions; "She posed as the Czar''s daughter"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200567677">
	<b:glossaryEntry>pretend to be someone or something that you are not; "he is masquerading as the expert on th Internet"; "This silly novel is masquerading as a serious historical treaty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200567914">
	<b:glossaryEntry>frighten someone by pretending to be stronger than one really is</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200568049">
	<b:glossaryEntry>make believe; "He feigned that he was ill"; "He shammed a headache"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200568305"
	 b:glossaryEntry='pretend to be; imitate; "She makes like an actress"'/>
<rdf:Description rdf:about="&a;200568418"
	 b:glossaryEntry="to pretend to be dead"/>
<rdf:Description rdf:about="&a;200568508"
	 b:glossaryEntry="of a boxer: pretend to be knocked out"/>
<rdf:Description rdf:about="&a;200568614">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conceal one''s true motives from esp. by elaborately feigning good intentions so as to gain an end; "He bamboozled his professors into thinking that he knew the subject well"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200568905"
	 b:glossaryEntry="talk through one''s hat"/>
<rdf:Description rdf:about="&a;200569024">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to enlarge beyond bounds or the truth: " tended to romanticize and exaggerate this ``gracious Old_South'''' imagery."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200569337">
	<b:glossaryEntry xml:space='preserve'><![CDATA[play down or obscure; "His advisers soft-pedaled the president''s blunder"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200569498">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make trivial or insignificant; "Don''t trivialize the seriousness of the issue!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200569645">
	<b:glossaryEntry>place special or excessive emphasis on; "I cannot overemphasize the importance of this book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200569841">
	<b:glossaryEntry>emphasize anew; "The director re-emphasized the need for greater productivity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200570012">
	<b:glossaryEntry>pay special attention to: "The lectures bore down on the political background"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200570157"
	 b:glossaryEntry="represent as less significant or important"/>
<rdf:Description rdf:about="&a;200570314"
	 b:glossaryEntry='speak out against; "He denounced the Nazis"'/>
<rdf:Description rdf:about="&a;200570483">
	<b:glossaryEntry xml:space='preserve'><![CDATA[criticize severely; "He fulminated against the Republicans'' plan to cut Medicare"; "She railed against the bad social policies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200570684">
	<b:glossaryEntry>give away information about somebody; "He told on his classmate who had cheated on the exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200570999"
	 b:glossaryEntry="announce the termination of, as of treaties"/>
<rdf:Description rdf:about="&a;200571108"
	 b:glossaryEntry="put or pin the blame on"/>
<rdf:Description rdf:about="&a;200571252">
	<b:glossaryEntry xml:space='preserve'><![CDATA[harass with constant criticism; "Don''t always pick on your little brother"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200571433">
	<b:glossaryEntry>bring an accusation against; level a charge against; "He charged the man with spousal abuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200571723">
	<b:glossaryEntry>blame for, make a claim of wrongdoing or misbehavior against: "he charged me director with indifference"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200571962"
	 b:glossaryEntry="accuse of a wrong or an inadequacy"/>
<rdf:Description rdf:about="&a;200572069">
	<b:glossaryEntry>make an accusatory claim; "The defense attorney charged that the jurors were biased"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200572217"
	 b:glossaryEntry="charge with a crime or misdemeanor"/>
<rdf:Description rdf:about="&a;200572324">
	<b:glossaryEntry>return an accusation against someone or engage in mutual accusations; charge in return</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200572479">
	<b:glossaryEntry>charge with an offense or misdemeanor; "The public officials were impeached"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200572620">
	<b:glossaryEntry>bother persistently with trivial complaints; "She nags her husband all day long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200572787">
	<b:glossaryEntry>persistently ask for overdue payment; "The grocer dunned his customers every day by telephone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200572942">
	<b:glossaryEntry>use foul or abusive language towards; "The actress abused the policeman who gave her a parking ticket"; "The angry mother shouted at the teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200573247"
	 b:glossaryEntry="abuse with coarse language"/>
<rdf:Description rdf:about="&a;200573336"
	 b:glossaryEntry='attack as if with claws; "The politician clawed his rival"'/>
<rdf:Description rdf:about="&a;200573480">
	<b:glossaryEntry xml:space='preserve'><![CDATA[express a negative opinion of; "She disparaged her student''s efforts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200573753"
	 b:glossaryEntry="be overly critical; criticize minor details"/>
<rdf:Description rdf:about="&a;200573861">
	<b:glossaryEntry>express a totally negative opinion of; "The critics panned the performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200574026">
	<b:glossaryEntry>charge falsely or with malicious intent; attack the good name and reputation of someone; "The journalists have defamed me!" The article in the paper sullied my reputation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200574386"
	 b:glossaryEntry="bring (information) out of concealment"/>
<rdf:Description rdf:about="&a;200574499">
	<b:glossaryEntry>damage the reputation of; "This newspaper story discredits the politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200574669">
	<b:glossaryEntry>make slanderous statements against; "The paper was accused of libeling him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200574815">
	<b:glossaryEntry>spread negative information about; "The Nazi propaganda vilified the Jews"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200574990">
	<b:glossaryEntry>speak unfavorably about; "She badmouthes her husband everywhere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200575170">
	<b:glossaryEntry>treat, mention, or speak to rudely; "He insulted her with his rude remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200575328">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be offended or bothered by; take offense with, be bothered by: "I don''t mind your behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200575515">
	<b:glossaryEntry>show anger or indignation; "She bristled at his insolent remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200575715">
	<b:glossaryEntry>treat with contempt; "The new constitution mocks all democratic principles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200575931">
	<b:glossaryEntry>imitate with mockery and derision; "The children mocked their handicapped classmate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200576155">
	<b:glossaryEntry>represent in or produce a caricature of; "The drawing caricatured the President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200576333"
	 b:glossaryEntry="represent another person with comic intentions"/>
<rdf:Description rdf:about="&a;200576448"
	 b:glossaryEntry='make a parody of; "The students spoofed the teachers"'/>
<rdf:Description rdf:about="&a;200576593"
	 b:glossaryEntry='laugh or scoff at; "The crowd jeered at the speaker"'/>
<rdf:Description rdf:about="&a;200576741">
	<b:glossaryEntry xml:space='preserve'><![CDATA[harass with persistent criticism or carping; "The children teased the new teacher"; "Don''t ride me so hard over my failure"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200577024"
	 b:glossaryEntry='tell false information to for fun; "Are you pulling my leg?"'/>
<rdf:Description rdf:about="&a;200577163">
	<b:glossaryEntry>provoke or stir up; "incite a riot"; "set off great unrest among the people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200577387"
	 b:glossaryEntry='activate or stir up; "raise a mutiny"'/>
<rdf:Description rdf:about="&a;200577495">
	<b:glossaryEntry>goad or provoke,as by constant criticism; "He needled her with his sarcastic remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200577669">
	<b:glossaryEntry>subject to laughter or ridicule: "The satirists ridiculed the plans for a new opera house"; "The students poked fun at the inexperienced teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200578042">
	<b:glossaryEntry xml:space='preserve'><![CDATA[ridicule with satire; "The writer satirized the politician''s proposal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200578196">
	<b:glossaryEntry xml:space='preserve'><![CDATA[treat or speak of with contempt; "He derided his student''s attempt to solve the biggest problem in mathematics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200578397">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expose while ridiculing; esp. of pretentious or false claims and ideas; "The physicist debunked the psychic''s claims"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200578606"
	 b:glossaryEntry="cause to appear foolish"/>
<rdf:Description rdf:about="&a;200578703">
	<b:glossaryEntry>tell a joke; speak humorously; "He often jokes even when he appears serious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200578920">
	<b:glossaryEntry>make jokes or quips; "The students were gagging during dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200579058">
	<b:glossaryEntry xml:space='preserve'><![CDATA[indulge in horseplay; "Enough horsing around--let''s get back to work!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200579251">
	<b:glossaryEntry>play jokes or romp; play boisterously; "The children were skylarking in the forest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200579423">
	<b:glossaryEntry>cause someone to believe an untruth; "The insurance company deceived me when they told me they were covering my house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200579701"
	 b:glossaryEntry="free from deception or illusion"/>
<rdf:Description rdf:about="&a;200579817">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fool or hoax; "The immigrant was duped because he trusted everyone"; "You can''t fool me!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200580082">
	<b:glossaryEntry>be silly or tease one another; "After we relaxed, we just kidded around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200580256">
	<b:glossaryEntry>appraise critically; "She reviews books for the New York Times"; "Please critique this performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200580448"
	 b:glossaryEntry="evaluate professionally a colleague''s work"/>
<rdf:Description rdf:about="&a;200580569">
	<b:glossaryEntry xml:space='preserve'><![CDATA[belittle; "The teacher should not deprecate his student''s efforts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200580733">
	<b:glossaryEntry>reduce or lessen the size or importance of; "The bad review of his work deflated his self-confidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200580910"
	 b:glossaryEntry="express strong disapproval of; deplore"/>
<rdf:Description rdf:about="&a;200581023">
	<b:glossaryEntry>declare or judge unfit; "The building was condemned by the inspector"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200581211"
	 b:glossaryEntry="express praise for"/>
<rdf:Description rdf:about="&a;200581587"
	 b:glossaryEntry='express commendation of; "I salute your courage!"'/>
<rdf:Description rdf:about="&a;200581725"
	 b:glossaryEntry="praise excessively"/>
<rdf:Description rdf:about="&a;200581817"
	 b:glossaryEntry='express pleasure verbally; "She crowed with joy"'/>
<rdf:Description rdf:about="&a;200581935"
	 b:glossaryEntry='utter shrill sounds; "The cocks crowed all morning"'/>
<rdf:Description rdf:about="&a;200582048">
	<b:glossaryEntry>to express great joy: "As if the sea, and sky, and earth, rejoiced with new-born liberty." Shelley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200582266"
	 b:glossaryEntry="rejoice proudly"/>
<rdf:Description rdf:about="&a;200582344"
	 b:glossaryEntry="be a cheerleader, in American sports events"/>
<rdf:Description rdf:about="&a;200582462">
	<b:glossaryEntry>show approval or good wishes by shouting; "everybody cheered the birthday boy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200582621">
	<b:glossaryEntry>urge on or encourage esp. by shouts; "The crowd cheered the demonstrating strikers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200582840"
	 b:glossaryEntry="become cheerful"/>
<rdf:Description rdf:about="&a;200582994"
	 b:glossaryEntry="make cheerful"/>
<rdf:Description rdf:about="&a;200583132"
	 b:glossaryEntry="put into a good mood"/>
<rdf:Description rdf:about="&a;200583232"
	 b:glossaryEntry='make (somebody) laugh; "The clown amused the children"'/>
<rdf:Description rdf:about="&a;200583375">
	<b:glossaryEntry>make someone convulse with laughter; "The comedian convulsed the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200583538"
	 b:glossaryEntry="make more cheerful"/>
<rdf:Description rdf:about="&a;200583639"
	 b:glossaryEntry='express approval of; "I applaud your efforts"'/>
<rdf:Description rdf:about="&a;200583793"
	 b:glossaryEntry='applaud with shouts of "bravo" or "brava"'/>
<rdf:Description rdf:about="&a;200583913">
	<b:glossaryEntry xml:space='preserve'><![CDATA[praise, glorify, or honor: "extol the virtues of one''s children"; "glorify one''s spouse''s cooking"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200584172">
	<b:glossaryEntry>exalt to the skies; lift to the skies or to heaven with praise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200584305"
	 b:glossaryEntry="rhapsodize about"/>
<rdf:Description rdf:about="&a;200584395"
	 b:glossaryEntry='praise by singing a hymn: "They hymned their love of God"'/>
<rdf:Description rdf:about="&a;200584514"
	 b:glossaryEntry="put a law into effect by formal declaration"/>
<rdf:Description rdf:about="&a;200584625"
	 b:glossaryEntry="praise vociferously"/>
<rdf:Description rdf:about="&a;200584733">
	<b:glossaryEntry>clap one''s hands or shout after performances to indicate approval</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200584957"
	 b:glossaryEntry="show displeasure, as after a performance or speech"/>
<rdf:Description rdf:about="&a;200585109"
	 b:glossaryEntry="drive from the stage by noisy disapproval"/>
<rdf:Description rdf:about="&a;200585233"
	 b:glossaryEntry="make a sound like frying fat"/>
<rdf:Description rdf:about="&a;200585325">
	<b:glossaryEntry>attack verbally, in speech or writing; "The editors of the left-leaning paper attacked the new House Speaker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200585700"
	 b:glossaryEntry='attack forcefully; "whang away at the school reform plan"'/>
<rdf:Description rdf:about="&a;200585828">
	<b:glossaryEntry>attack with a barrage; "The speaker was barraged by an angry audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200585963"
	 b:glossaryEntry='scorch with words; "blistering criticism; whipping comments"'/>
<rdf:Description rdf:about="&a;200586096">
	<b:glossaryEntry>express strong disapproval of; "We condemn the racism in South Africa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200586279">
	<b:glossaryEntry xml:space='preserve'><![CDATA[belittle; "Don''t belittle his influence"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200586445"
	 b:glossaryEntry="belittle through talk"/>
<rdf:Description rdf:about="&a;200586541"
	 b:glossaryEntry="declare to be evil or anathema"/>
<rdf:Description rdf:about="&a;200586673"
	 b:glossaryEntry="utter obscenities"/>
<rdf:Description rdf:about="&a;200586792"
	 b:glossaryEntry="as to a horse"/>
<rdf:Description rdf:about="&a;200586866">
	<b:glossaryEntry>wish harm upon; put a curse on; "The bad witch cursed the child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200587063"
	 b:glossaryEntry="heap obscenities upon"/>
<rdf:Description rdf:about="&a;200587155"
	 b:glossaryEntry='give a benediction to; "The dying man blessed his son"'/>
<rdf:Description rdf:about="&a;200587298"
	 b:glossaryEntry="render holy by means of religious rites"/>
<rdf:Description rdf:about="&a;200587477"
	 b:glossaryEntry="consecrate anew, as after a desecration"/>
<rdf:Description rdf:about="&a;200587586"
	 b:glossaryEntry="remove the consecration from a person or an object"/>
<rdf:Description rdf:about="&a;200587744">
	<b:glossaryEntry>make the sign of the cross over someone in order to call on God for protection; consecrate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200587904">
	<b:glossaryEntry>call into question; challenge the accuracy, probity, or propriety of; "We must question your judgment in this matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200588138">
	<b:glossaryEntry xml:space='preserve'><![CDATA[furnish a justifying analysis or explanation; "I can''t account for the missing money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200588305"
	 b:glossaryEntry="challenge the honesty or credibility of; as of witnesses"/>
<rdf:Description rdf:about="&a;200588427"
	 b:glossaryEntry="attack as false or wrong"/>
<rdf:Description rdf:about="&a;200588515"
	 b:glossaryEntry='challenge: "I dare you!"'/>
<rdf:Description rdf:about="&a;200588634"
	 b:glossaryEntry='face with defiance or impudence; "brazen it out"'/>
<rdf:Description rdf:about="&a;200588755">
	<b:glossaryEntry>issue a challenge to; "Fischer challenged Spassky to a match"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200589053"
	 b:glossaryEntry='take exception to; "She challenged his claims"'/>
<rdf:Description rdf:about="&a;200589249">
	<b:glossaryEntry>challenge (somebody) to make good on a statement; charge with or censure for an offense; "He deserves to be called on that"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200589434">
	<b:glossaryEntry>make the subject of dispute, contention, or litigation; "They contested the outcome of the race"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200589641">
	<b:glossaryEntry>file a formal charge against; "The suspect was charged with murdering his wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200589833">
	<b:glossaryEntry>notify of danger or of a risk; "The director warned him that he might be fired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200590070"
	 b:glossaryEntry='admonish or counsel; "I warned him not to go too far"'/>
<rdf:Description rdf:about="&a;200590217">
	<b:glossaryEntry xml:space='preserve'><![CDATA[warn in advance or beforehand; give an early warning; "I forewarned him of the trouble that would arise if he showed up at his ex-wife''s house"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200590442"
	 b:glossaryEntry="warn strongly; put on guard"/>
<rdf:Description rdf:about="&a;200590553">
	<b:glossaryEntry>to utter intentions of injury or punishment against:"He threatened me when I tried to call the police"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200590771">
	<b:glossaryEntry>threaten to do something: "I offered to leave the committee if they did not accpet my proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200590929">
	<b:glossaryEntry>to be a menacing indication of something:"The clouds threaten rain"; "Danger threatens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200591090"
	 b:glossaryEntry='indicate by signs; "These signs bode bad news"'/>
<rdf:Description rdf:about="&a;200591365"
	 b:glossaryEntry='arouse to a sense of danger; "The empty house alarmed him"'/>
<rdf:Description rdf:about="&a;200591502"
	 b:glossaryEntry="give advise to"/>
<rdf:Description rdf:about="&a;200591742"
	 b:glossaryEntry="give an important tip or advise to"/>
<rdf:Description rdf:about="&a;200591857">
	<b:glossaryEntry>give information or notice to; "I advised him that the rent was due"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200592068">
	<b:glossaryEntry>require the presentation of for redemption before maturation; "Call a bond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200592223">
	<b:glossaryEntry>make known or acquainted; "We familiarized ourselves with the new surroundings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200592414">
	<b:glossaryEntry>acquaint anew; "We reacquainted ourselves with this technique"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200592544">
	<b:glossaryEntry>familiarize oneself thoroughly with; "He really got into semantics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200592685"
	 b:glossaryEntry="push for something"/>
<rdf:Description rdf:about="&a;200592804"
	 b:glossaryEntry="make a proposal, declare a plan for something"/>
<rdf:Description rdf:about="&a;200593041">
	<b:glossaryEntry>bring forward for consideration or acceptance; "advance an argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200593186">
	<b:glossaryEntry>suggest sex to; "She was propositioned by a stranger at the party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200593320"
	 b:glossaryEntry="give bad advise to"/>
<rdf:Description rdf:about="&a;200593428"
	 b:glossaryEntry="give feedback to somebody"/>
<rdf:Description rdf:about="&a;200593538"
	 b:glossaryEntry="put forward, as of an idea"/>
<rdf:Description rdf:about="&a;200593630"
	 b:glossaryEntry='advise professionally; "The professor consults for industry"'/>
<rdf:Description rdf:about="&a;200593763"
	 b:glossaryEntry="have a conference in order to talk something over"/>
<rdf:Description rdf:about="&a;200593927"
	 b:glossaryEntry="confer secretly"/>
<rdf:Description rdf:about="&a;200594016">
	<b:glossaryEntry>seek information from; "You should consult the dictionary"; "refer to your notes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200594188">
	<b:glossaryEntry>attempt to find out; "The student researched the history of that word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200594342"
	 b:glossaryEntry="when planning or deciding something"/>
<rdf:Description rdf:about="&a;200594442">
	<b:glossaryEntry>get or ask advice from; "Consult your local broker"; "They had to consult before arriving at a decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200594641">
	<b:glossaryEntry>assist (somebody acting or reciting) by suggesting the next words of something forgotten or imperfectly learned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200594839"
	 b:glossaryEntry='put before; "I submit to you that the accused is guilty"'/>
<rdf:Description rdf:about="&a;200594989">
	<b:glossaryEntry xml:space='preserve'><![CDATA[submit or yield to another''s wish or opinion; "The government bowed to the military pressure"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200595179">
	<b:glossaryEntry>refer for judgment or consideration; "She submitted a proposal to the agency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200595382">
	<b:glossaryEntry xml:space='preserve'><![CDATA[submit for consideration, judgment, or use; "give one''s opinion"; ''give an excuse"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200595534">
	<b:glossaryEntry>submit (a report, etc.) to someone in authority; "submit a bill to a legislative body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200595718">
	<b:glossaryEntry>return a bill after consideration and revision to a legislative body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200595862"
	 b:glossaryEntry="propose formally; in a debate or parliamentary meeting"/>
<rdf:Description rdf:about="&a;200596010"
	 b:glossaryEntry="propose as a candidate for some honor"/>
<rdf:Description rdf:about="&a;200596144">
	<b:glossaryEntry>ask (someone) to marry you; "he popped the question on Sunday night"; "she proposed marriage to the man she had known for only two months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200596401"
	 b:glossaryEntry='tell voluntarily; "He volunteered the information"'/>
<rdf:Description rdf:about="&a;200596526"
	 b:glossaryEntry="praise somewhat dishonestly"/>
<rdf:Description rdf:about="&a;200596745"
	 b:glossaryEntry="flatter in an obsequious manner"/>
<rdf:Description rdf:about="&a;200596849"
	 b:glossaryEntry='treat gingerly or carefully; "You have to stroke the boss"'/>
<rdf:Description rdf:about="&a;200596971">
	<b:glossaryEntry>praise formally and eloquently; "The dead woman was eulogized at the funeral"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200597133"
	 b:glossaryEntry="court favor by cringing or flattering"/>
<rdf:Description rdf:about="&a;200597296"
	 b:glossaryEntry="flatter with the intention of getting something"/>
<rdf:Description rdf:about="&a;200597423"
	 b:glossaryEntry="pay a compliment to"/>
<rdf:Description rdf:about="&a;200597534"
	 b:glossaryEntry="express respect or esteem for"/>
<rdf:Description rdf:about="&a;200597631"
	 b:glossaryEntry="express congratulations"/>
<rdf:Description rdf:about="&a;200597745">
	<b:glossaryEntry>praise enthusiastically; "She raved about that new restaurant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200597884"
	 b:glossaryEntry="express approval of"/>
<rdf:Description rdf:about="&a;200597976">
	<b:glossaryEntry>mention as by way of greeting or to indicate friendship; "Remember me to your wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200598135">
	<b:glossaryEntry>mention favourably, as in prayer; "remember me in your prayers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200598264"
	 b:glossaryEntry="express a good opinion of"/>
<rdf:Description rdf:about="&a;200598374"
	 b:glossaryEntry='give to in charge; "I commend my children to you"'/>
<rdf:Description rdf:about="&a;200598488"
	 b:glossaryEntry="show off"/>
<rdf:Description rdf:about="&a;200598699"
	 b:glossaryEntry="dwell on with satisfaction"/>
<rdf:Description rdf:about="&a;200598839"
	 b:glossaryEntry="pride or congratulate (oneself) for an achievement"/>
<rdf:Description rdf:about="&a;200598975"
	 b:glossaryEntry="make a promise or commitment"/>
<rdf:Description rdf:about="&a;200599173"
	 b:glossaryEntry='promise to undertake or give; "I promise you my best effort"'/>
<rdf:Description rdf:about="&a;200599324"
	 b:glossaryEntry="promise or agree condescendingly, as a special favor"/>
<rdf:Description rdf:about="&a;200599443"
	 b:glossaryEntry="promise solemnly and formally"/>
<rdf:Description rdf:about="&a;200599607">
	<b:glossaryEntry>promise to abstain from; "I have sworn off cigarettes altogether"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200599739"
	 b:glossaryEntry="bind or secure by a pledge"/>
<rdf:Description rdf:about="&a;200599829"
	 b:glossaryEntry="bind by a contract; esp. for a training period"/>
<rdf:Description rdf:about="&a;200599940">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bind by an obligation; cause to be indebted; "He''s held by a contract'' "I''ll hold you by your promise"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200600208"
	 b:glossaryEntry="bind by or as if by indentures, as of an apprentice"/>
<rdf:Description rdf:about="&a;200600326">
	<b:glossaryEntry>restrain from independence by an obligation; "He was tied down by his work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200600483">
	<b:glossaryEntry>provide a service or favor for someone; "We had to oblige him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200600641"
	 b:glossaryEntry="ignore someone''s wishes"/>
<rdf:Description rdf:about="&a;200600749"
	 b:glossaryEntry="confer honor on"/>
<rdf:Description rdf:about="&a;200600861"
	 b:glossaryEntry='give as a guarantee; "I pledge my honor"'/>
<rdf:Description rdf:about="&a;200601001"
	 b:glossaryEntry="give to, in marriage"/>
<rdf:Description rdf:about="&a;200601123"
	 b:glossaryEntry='make a vow; promise; "He vowed never to drink alcohol again"'/>
<rdf:Description rdf:about="&a;200601306"
	 b:glossaryEntry="dedicate to a deity by a vow"/>
<rdf:Description rdf:about="&a;200601416">
	<b:glossaryEntry>inscribe or address by way of compliment; "She dedicated her book to her parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200601582">
	<b:glossaryEntry>address, as a work of literature, in a style less formal than a dedication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200601722">
	<b:glossaryEntry xml:space='preserve'><![CDATA[furnish or contribute; "She committed herself to the work of God"; "give one''s talents to a good cause"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200602022"
	 b:glossaryEntry='offer in good faith; "He gave her his word"'/>
<rdf:Description rdf:about="&a;200602145">
	<b:glossaryEntry>dedicate anew; "They were asked to rededicate themselves to their country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200602303"
	 b:glossaryEntry="as in religious orders; take a vow"/>
<rdf:Description rdf:about="&a;200602402"
	 b:glossaryEntry="enter into a contractual arrangement"/>
<rdf:Description rdf:about="&a;200602606">
	<b:glossaryEntry>be engaged by a written agreement; "He signed to play the casino on Dec. 18"; "The soprano signed to sing the new opera"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200602914"
	 b:glossaryEntry="promise or guarantee"/>
<rdf:Description rdf:about="&a;200603039"
	 b:glossaryEntry="guarantee financial support of"/>
<rdf:Description rdf:about="&a;200603145"
	 b:glossaryEntry="promise solemnly; take an oath"/>
<rdf:Description rdf:about="&a;200603280">
	<b:glossaryEntry>give surety or assume responsibility; "I vouch for the quality of my products"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200603511">
	<b:glossaryEntry>make certain of; "This nest egg will ensure a nice retirement for us"; "Preparation will guarantee success!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200603740">
	<b:glossaryEntry>assure the success of; "A good review by this critic will make your play!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200603918">
	<b:glossaryEntry xml:space='preserve'><![CDATA[protect by insurance; "The insurance won''t cover this"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200604153">
	<b:glossaryEntry>insure again by assuming all or a part of the liability of an insurance company already covering a risk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200604346">
	<b:glossaryEntry>insure again by transferring to another insurance company all or a part of a liability assumed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200604530"
	 b:glossaryEntry="stand behind"/>
<rdf:Description rdf:about="&a;200604655"
	 b:glossaryEntry="express gratitude or show appreciation to"/>
<rdf:Description rdf:about="&a;200604807"
	 b:glossaryEntry="express obligation for"/>
<rdf:Description rdf:about="&a;200604928"
	 b:glossaryEntry="acknowledge the receipt of"/>
<rdf:Description rdf:about="&a;200605041"
	 b:glossaryEntry="acknowledge faults"/>
<rdf:Description rdf:about="&a;200605154">
	<b:glossaryEntry xml:space='preserve'><![CDATA[excuse or make allowances for; be lenient with; "excuse someone''s behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200605303"
	 b:glossaryEntry="serve as an excuse for"/>
<rdf:Description rdf:about="&a;200605417"
	 b:glossaryEntry="exonerate by means of an alibi"/>
<rdf:Description rdf:about="&a;200605518">
	<b:glossaryEntry>grant exemption or release to; "Please excuse me from this class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200605701">
	<b:glossaryEntry>exempt by means of an official pass or letter, as from customs or other checks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200605842"
	 b:glossaryEntry="ask for permission to be released from an engagement"/>
<rdf:Description rdf:about="&a;200605968"
	 b:glossaryEntry='offer as an excuse or plea; "She was pleading insanity"'/>
<rdf:Description rdf:about="&a;200606102">
	<b:glossaryEntry>refuse to testify by invoking the Fifth Amendment, which states that nobody may be forced to testify as a witness against himself or herself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200606341"
	 b:glossaryEntry="make excuses for"/>
<rdf:Description rdf:about="&a;200606523"
	 b:glossaryEntry="argue in defense of"/>
<rdf:Description rdf:about="&a;200606705">
	<b:glossaryEntry>defend against attack or criticism;"He stood up to the committee and defended the contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200606863">
	<b:glossaryEntry xml:space='preserve'><![CDATA[provide an excuse or alibi for someone so as to cover up guilt; "I won''t lie and cover for you"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200607025"
	 b:glossaryEntry='conceal the truth; "The White House covered up the burglary"'/>
<rdf:Description rdf:about="&a;200607177"
	 b:glossaryEntry="stand up for; stick up for; of causes, principles, or ideals"/>
<rdf:Description rdf:about="&a;200607301"
	 b:glossaryEntry="show to be right"/>
<rdf:Description rdf:about="&a;200607420">
	<b:glossaryEntry>support against an opponent; "The appellate court upheld the verdict"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200607583"
	 b:glossaryEntry="show to be reasonable"/>
<rdf:Description rdf:about="&a;200607679"
	 b:glossaryEntry="send greetings to"/>
<rdf:Description rdf:about="&a;200607777"
	 b:glossaryEntry="express greetings upon meeting someone"/>
<rdf:Description rdf:about="&a;200608070"
	 b:glossaryEntry='speak to; "He addressed the crowd outside the window"'/>
<rdf:Description rdf:about="&a;200608227">
	<b:glossaryEntry>address a question to and expect an answer from; "Ask your teacher about trigonometry"; "The children asked me about their dead grandmother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200608482">
	<b:glossaryEntry>take someone''s hands and shake them as a gesture of greeting or congratulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200608651"
	 b:glossaryEntry="lower and raise the head, so as to indicate assent"/>
<rdf:Description rdf:about="&a;200608770"
	 b:glossaryEntry='express or signify by nodding; "He nodded his approval"'/>
<rdf:Description rdf:about="&a;200608886"
	 b:glossaryEntry="make the sign of the cross; in the Catholic religion"/>
<rdf:Description rdf:about="&a;200609009">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bend one''s knee or body, or lower one''s head; "He bowed before the King"; "She bowed her head in shame"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200609218"
	 b:glossaryEntry="perform a ceremonious bow"/>
<rdf:Description rdf:about="&a;200609323">
	<b:glossaryEntry>acknowledge applause by inclining the head, as of an artist after a performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200609486">
	<b:glossaryEntry>acknowledge praise or accept credit; "They finally took a bow for what they did"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200609634">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make a curtsy; usually done only by girls and women; as a sign of respect; "She curtsied when she shook the Queen''s hand"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200609843"
	 b:glossaryEntry="great in a friendly way"/>
<rdf:Description rdf:about="&a;200609956"
	 b:glossaryEntry="greet with a salaam"/>
<rdf:Description rdf:about="&a;200610047"
	 b:glossaryEntry="assume a position; in the military"/>
<rdf:Description rdf:about="&a;200610173">
	<b:glossaryEntry>honor with a military ceremony, as when honoring dead soldiers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200610299"
	 b:glossaryEntry="greet enthusiastically"/>
<rdf:Description rdf:about="&a;200610383"
	 b:glossaryEntry="call for, as of cabs"/>
<rdf:Description rdf:about="&a;200610465"
	 b:glossaryEntry="bid welcome to; greet upon arrival"/>
<rdf:Description rdf:about="&a;200610592">
	<b:glossaryEntry>end one''s encounter with somebody by causing or permitting the person to leave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200610747"
	 b:glossaryEntry="say good-bye or bid farewell"/>
<rdf:Description rdf:about="&a;200610889"
	 b:glossaryEntry="make known"/>
<rdf:Description rdf:about="&a;200611049">
	<b:glossaryEntry>formally present a debutante, a representative of a country, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200611179"
	 b:glossaryEntry="furnish with a preface"/>
<rdf:Description rdf:about="&a;200611324"
	 b:glossaryEntry="make a preamble"/>
<rdf:Description rdf:about="&a;200611405"
	 b:glossaryEntry="write or speak a prologue"/>
<rdf:Description rdf:about="&a;200611497"
	 b:glossaryEntry="let off the hook"/>
<rdf:Description rdf:about="&a;200611631"
	 b:glossaryEntry="announce for a score; of cards in a card game"/>
<rdf:Description rdf:about="&a;200611738"
	 b:glossaryEntry='invoke upon; "wish you a nice evening"; "bid farewell"'/>
<rdf:Description rdf:about="&a;200611886"
	 b:glossaryEntry="order politely; express a wish for"/>
<rdf:Description rdf:about="&a;200612000"
	 b:glossaryEntry='make or express a wish; "I wish that Christmas were over"'/>
<rdf:Description rdf:about="&a;200612137"
	 b:glossaryEntry="stop blaming or grant forgiveness"/>
<rdf:Description rdf:about="&a;200612323">
	<b:glossaryEntry>pronounce not guilty of criminal charges; "The suspect was cleared of the murder charges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200612609">
	<b:glossaryEntry>exonerate by means of a perfunctory investigation or through biased presentation of data</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200612772"
	 b:glossaryEntry="cause to be acquitted; get off the hook; in a legal case"/>
<rdf:Description rdf:about="&a;200612875"
	 b:glossaryEntry="clear of a charge"/>
<rdf:Description rdf:about="&a;200612955">
	<b:glossaryEntry>grant a pardon to; "Ford pardoned Nixon"; "The Thanksgiving turkey was pardoned by the President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200613160"
	 b:glossaryEntry="absolve or pardon; archaic"/>
<rdf:Description rdf:about="&a;200613250"
	 b:glossaryEntry="grant a pardon to (a group of people)"/>
<rdf:Description rdf:about="&a;200613352"
	 b:glossaryEntry='accept an excuse for; "Please excuse my dirty hands"'/>
<rdf:Description rdf:about="&a;200613501">
	<b:glossaryEntry>lessen or to try to lessen the seriousness or extent of; "The circumstances extenuate the crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200613686"
	 b:glossaryEntry="find or declare guilty"/>
<rdf:Description rdf:about="&a;200613835"
	 b:glossaryEntry="convict anew"/>
<rdf:Description rdf:about="&a;200613914">
	<b:glossaryEntry>pronounce a sentence on, in a court of law; "He was condemned to ten years in prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200614144"
	 b:glossaryEntry="doom beforehand"/>
<rdf:Description rdf:about="&a;200614225">
	<b:glossaryEntry>express complaints, discontent, displeasure, or unhappiness; "My mother complains all day"; "She has a lot to kick about"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200614681"
	 b:glossaryEntry="say mean things"/>
<rdf:Description rdf:about="&a;200614770"
	 b:glossaryEntry="challenge aggressively"/>
<rdf:Description rdf:about="&a;200614873"
	 b:glossaryEntry="complain whiningly"/>
<rdf:Description rdf:about="&a;200614988">
	<b:glossaryEntry>try to prevent; show opposition to: "We should discourage this practice among our youth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200615168"
	 b:glossaryEntry="help develop, help grow"/>
<rdf:Description rdf:about="&a;200615325"
	 b:glossaryEntry='be a customer or client of; "We patronize this store"'/>
<rdf:Description rdf:about="&a;200615476"
	 b:glossaryEntry="treat condescendingly"/>
<rdf:Description rdf:about="&a;200615603"
	 b:glossaryEntry="make concessions to"/>
<rdf:Description rdf:about="&a;200615688"
	 b:glossaryEntry="complain quietly"/>
<rdf:Description rdf:about="&a;200615819">
	<b:glossaryEntry xml:space='preserve'><![CDATA[show one''s unhappiness or critical attitude; "He scolded about anyhting that he thought was wrong"; "We grumbled about the increased work load"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200616052"
	 b:glossaryEntry="cry softly, as of pigeons"/>
<rdf:Description rdf:about="&a;200616138">
	<b:glossaryEntry>speak softly or lovingly; "The mother who held her baby was cooing softly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200616273"
	 b:glossaryEntry="utter words of protest"/>
<rdf:Description rdf:about="&a;200616376"
	 b:glossaryEntry="argue in protest or opposition"/>
<rdf:Description rdf:about="&a;200616475"
	 b:glossaryEntry="object strongly; make a stink"/>
<rdf:Description rdf:about="&a;200616572"
	 b:glossaryEntry="express discontent"/>
<rdf:Description rdf:about="&a;200616654"
	 b:glossaryEntry='complain; "What was he hollering about?"'/>
<rdf:Description rdf:about="&a;200616819"
	 b:glossaryEntry="complain bitterly"/>
<rdf:Description rdf:about="&a;200616908"
	 b:glossaryEntry="regret strongly"/>
<rdf:Description rdf:about="&a;200617024"
	 b:glossaryEntry='be sorry; "I regret to say..."'/>
<rdf:Description rdf:about="&a;200617155">
	<b:glossaryEntry xml:space='preserve'><![CDATA[decline formally or politely; "I regret I can''t come to the party"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200617311">
	<b:glossaryEntry>utter aloud; often with surprise, horror, or joy; "I won!" he exlaimed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200617516">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter in a loud voice; talk in a loud voice (usually denoting characteristic manner of speaking); "My grandmother is hard of hearing--you''ll have to shout"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200617840">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter or declare in a very loud voice; "You don''t have to yell--I can hear you just fine"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200618000">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter a sudden loud cry; "she cried with pain when the doctor inserted the needle"; "I yelled to her from the window but she couldn''t hear me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200618442"
	 b:glossaryEntry="cry hollo"/>
<rdf:Description rdf:about="&a;200618514"
	 b:glossaryEntry="encourage somebody by crying hollo"/>
<rdf:Description rdf:about="&a;200618611"
	 b:glossaryEntry='shout "hurrah!"'/>
<rdf:Description rdf:about="&a;200618691"
	 b:glossaryEntry='shout "halloo"'/>
<rdf:Description rdf:about="&a;200618777">
	<b:glossaryEntry>shout, as if with joy or enthusiasm; "The children whooped when they were led to the picnic table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200618946"
	 b:glossaryEntry="utter a shrill cry"/>
<rdf:Description rdf:about="&a;200619098"
	 b:glossaryEntry="utter shrieks, as of cats"/>
<rdf:Description rdf:about="&a;200619197">
	<b:glossaryEntry>to insert between other elements: "She interjected clever remarks."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200619398">
	<b:glossaryEntry>utter or proclaim insistently and noisily; "The delegates clamored their disappointment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200619568"
	 b:glossaryEntry='utter in a very loud voice; "They vociferated their demands"'/>
<rdf:Description rdf:about="&a;200619708"
	 b:glossaryEntry='shout out; "He hollered out to surrender our weapons"'/>
<rdf:Description rdf:about="&a;200619854">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter words loudly and forcefully; "`Get out of here,'' he roared."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200620008"
	 b:glossaryEntry="speak softly; in a low voice"/>
<rdf:Description rdf:about="&a;200620135"
	 b:glossaryEntry="speak louder; raise one''s voice"/>
<rdf:Description rdf:about="&a;200620232">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter in an angry, sharp, or abrupt tone; `"No!," she snapped''; "The guard snarled at us"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200620407">
	<b:glossaryEntry>make a snarling noise or move with a snarling noise; "Bullets snarled past us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200620548"
	 b:glossaryEntry="utter with enthusiasm"/>
<rdf:Description rdf:about="&a;200620652"
	 b:glossaryEntry="say (something) with great enthusiasm"/>
<rdf:Description rdf:about="&a;200620765"
	 b:glossaryEntry="out forward, of a guess"/>
<rdf:Description rdf:about="&a;200620914"
	 b:glossaryEntry="express in spite of possible refutation"/>
<rdf:Description rdf:about="&a;200621026">
	<b:glossaryEntry xml:space='preserve'><![CDATA[express a supposition; "Let us say that he did not tell the truth"; "Let''s say you had a lot of money--what would you do?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200621227"
	 b:glossaryEntry="evaluate or criticize with hindsight"/>
<rdf:Description rdf:about="&a;200621340"
	 b:glossaryEntry="attempt to anticipate or predict"/>
<rdf:Description rdf:about="&a;200621460">
	<b:glossaryEntry>make a prediction about; tell in advance; "Call the outcome of an election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200621784"
	 b:glossaryEntry="predict from an omen"/>
<rdf:Description rdf:about="&a;200621875">
	<b:glossaryEntry>maintain with or as if with a bet; "I bet she will be there!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200622024"
	 b:glossaryEntry="estimate based on a calculation"/>
<rdf:Description rdf:about="&a;200622132">
	<b:glossaryEntry>after a calculation, investigation, experiment, or study; "find the product of two numbers"; "The physicist who found the elusive particle won the Nobel Prize"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200622450">
	<b:glossaryEntry>find out or learn with certainty; "I want to see whether she speaks French"; "See whether it works"; "Watch how he will react"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200622696"
	 b:glossaryEntry="determine the presence or properties of (a substance)"/>
<rdf:Description rdf:about="&a;200622811"
	 b:glossaryEntry="determine the refracting power of (a lens)"/>
<rdf:Description rdf:about="&a;200622918"
	 b:glossaryEntry='imagine to be true; "I suspect he is a fugitive"'/>
<rdf:Description rdf:about="&a;200623049"
	 b:glossaryEntry='suspect to be false; "I distrust that man"'/>
<rdf:Description rdf:about="&a;200623193">
	<b:glossaryEntry>be a signal for or a symptom of; "These symptoms indicate a serious illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200623416">
	<b:glossaryEntry>designate as if by a mark; "This sign marks the border"; "He indicated where the border ended"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200623653">
	<b:glossaryEntry>indicate the dimensions on; "These techniques permit us to dimension the human heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200623813"
	 b:glossaryEntry="mark with a signpost, as of a path"/>
<rdf:Description rdf:about="&a;200623913"
	 b:glossaryEntry="make conspicuous"/>
<rdf:Description rdf:about="&a;200624036"
	 b:glossaryEntry="distinguish as singular"/>
<rdf:Description rdf:about="&a;200624152"
	 b:glossaryEntry="mark with a buoy"/>
<rdf:Description rdf:about="&a;200624230">
	<b:glossaryEntry xml:space='preserve'><![CDATA[indicate a certain reading; of gauges and instruments; "The thermometer showed thirteen degrees below zero"; "The gauge read `empty''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200624506"
	 b:glossaryEntry='indicate; "The clock says noon"'/>
<rdf:Description rdf:about="&a;200624616">
	<b:glossaryEntry>give evidence of, as of records; "The diary shows his distress that evening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200624790">
	<b:glossaryEntry>show an omission in (an account) for which credit ought to have been given</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200624932"
	 b:glossaryEntry="indicate a certain time by striking, of clocks"/>
<rdf:Description rdf:about="&a;200625042">
	<b:glossaryEntry>indicate a place, direction, person, or thing; either spatially or figuratively; "I showed the customer the glove section"; "He showed her that there was a lot of space"; "he indicated his opponents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200625408">
	<b:glossaryEntry>indicate the fingering for the playing of musical scores for keyboard instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200625553"
	 b:glossaryEntry="point out carefully and clearly"/>
<rdf:Description rdf:about="&a;200625671"
	 b:glossaryEntry="foretell by divine inspiration"/>
<rdf:Description rdf:about="&a;200625778"
	 b:glossaryEntry="hold in suspicion; believe to be guilty"/>
<rdf:Description rdf:about="&a;200625900">
	<b:glossaryEntry>place in doubt or express doubtful speculation; "I wonder whether this was the right thing to do"; "she wondered whether it would snow tonight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200626145"
	 b:glossaryEntry="have doubts about"/>
<rdf:Description rdf:about="&a;200626227">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be amazed at; "We marvelled at the child''s linguistic abilities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200626364"
	 b:glossaryEntry="express astonishment or surprise about something"/>
<rdf:Description rdf:about="&a;200626484">
	<b:glossaryEntry>elaborate, as of theories and hypotheses; "Could you develop the ideas in your thesis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200626677">
	<b:glossaryEntry>formulate or develop again, of an improved theory or hypothesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200626821"
	 b:glossaryEntry="predict in advance"/>
<rdf:Description rdf:about="&a;200626925">
	<b:glossaryEntry>predict or reveal through, or as if through, divine inspiration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200627088"
	 b:glossaryEntry="give spiritual insight to; in religion"/>
<rdf:Description rdf:about="&a;200627205"
	 b:glossaryEntry="indulge in speculations"/>
<rdf:Description rdf:about="&a;200627339"
	 b:glossaryEntry="drop a hint; intimate by a hint"/>
<rdf:Description rdf:about="&a;200627512"
	 b:glossaryEntry="give to understand"/>
<rdf:Description rdf:about="&a;200627620"
	 b:glossaryEntry='provide someone with a clue; "Can you clue me in?"'/>
<rdf:Description rdf:about="&a;200627736">
	<b:glossaryEntry>to state or express briefly: "indicated his wishes in a letter."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200627936">
	<b:glossaryEntry>suggest the necessity of an intervention; in medicine: "Tetracycline is indicated in such cases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200628126"
	 b:glossaryEntry="make a treatment inadvisable"/>
<rdf:Description rdf:about="&a;200628262"
	 b:glossaryEntry="make known; pass on, of information"/>
<rdf:Description rdf:about="&a;200628548">
	<b:glossaryEntry>communicate or express nonverbally; "What does this painting say?" "Did his face say anything about how he felt?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200628748">
	<b:glossaryEntry>communicate by a sign or signs; "She signed that she was prepared to come along"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200628890">
	<b:glossaryEntry xml:space='preserve'><![CDATA[convey by one''s expression; "She looked her devotion to me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200629019">
	<b:glossaryEntry>make known or cause to appear with great speed; "The latest intelligence is flashed to all command posts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200629195"
	 b:glossaryEntry='manifest or evince; "She breathes the Christian spirit"'/>
<rdf:Description rdf:about="&a;200629331"
	 b:glossaryEntry="express or state indirectly"/>
<rdf:Description rdf:about="&a;200629447">
	<b:glossaryEntry>give sudden release to an expression; "We burst out laughing"; "I hate you," she burst out.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200629631">
	<b:glossaryEntry>burst out with a violent or profane utterance: "ripped out a vicious oath"; "ripped out with an oath."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200629806"
	 b:glossaryEntry="call to mind or evoke"/>
<rdf:Description rdf:about="&a;200629962"
	 b:glossaryEntry="suggest as a logically necessary consequence; in logic"/>
<rdf:Description rdf:about="&a;200630133">
	<b:glossaryEntry>imply as a possibility; "The evidence suggests a need for more clarification"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200630305"
	 b:glossaryEntry='imply or suggest: "Your remarks make me out to be stupid"'/>
<rdf:Description rdf:about="&a;200630452"
	 b:glossaryEntry="involve as a necessary condition of consequence; in logic"/>
<rdf:Description rdf:about="&a;200630586">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have as a meaning; " `multi-'' denotes `many'' "]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200630864">
	<b:glossaryEntry xml:space='preserve'><![CDATA[denote or connote; "`maison'' means `house'' in French"; "An example sentence would show what this word means"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200631047">
	<b:glossaryEntry>be a sign or indication of; "Her smile denoted that she agreed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200631192">
	<b:glossaryEntry>convey or express a meaning; "These words means nothing to me!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200631336">
	<b:glossaryEntry xml:space='preserve'><![CDATA[indicate or signify; "I''m afraid this spells trouble!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200631462"
	 b:glossaryEntry="change the meaning of"/>
<rdf:Description rdf:about="&a;200631606"
	 b:glossaryEntry="refer to something with a euphemism"/>
<rdf:Description rdf:about="&a;200631708">
	<b:glossaryEntry>speak unintelligibly, in religious ecstasy; "The parishioners spoke in tongues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200631861"
	 b:glossaryEntry='give voice to; "He voiced his concern"'/>
<rdf:Description rdf:about="&a;200631970"
	 b:glossaryEntry="express less strongly"/>
<rdf:Description rdf:about="&a;200632077">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make known to the public information that was previously known only to a few people or that was meant to be kept a secret; "The aution house would not disclose the price at which the van Gogh had sold"; "The actress won''t reveal how old she is"; "bring out the truth"; "he broke the news to her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200632769">
	<b:glossaryEntry>cause to be revealed and jeopardized; "The story blew their cover"; "The double agent was blown by the other side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200632945">
	<b:glossaryEntry>be made known; be disclosed or revealed; "The truth will out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200633068">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reveal somebody else''s homosexuality; "This actor was outed last week"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200633207">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to state openly and publicly one''s homosexuality; "This actor outed last year"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200633377">
	<b:glossaryEntry>reveal the true nature of; "The journal article unmasked the corrupt politician"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200633555">
	<b:glossaryEntry>produce or disclose suddenly or unexpectedly; "He sprang these news on me just as I was leaving"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200633716">
	<b:glossaryEntry>be released or become known; of news; "News of her death broke in the morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200633898"
	 b:glossaryEntry='be leaked; "The news leaked out despite his secrecy"'/>
<rdf:Description rdf:about="&a;200634023">
	<b:glossaryEntry>reveal unintentionally; "Her smile betrayed her true feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200634158"
	 b:glossaryEntry="reveal in private; tell confidentially"/>
<rdf:Description rdf:about="&a;200634305"
	 b:glossaryEntry="relieve oneself of troubling information"/>
<rdf:Description rdf:about="&a;200634420"
	 b:glossaryEntry="give inside information to; as to the police"/>
<rdf:Description rdf:about="&a;200634566"
	 b:glossaryEntry="inform or spy (for the police)"/>
<rdf:Description rdf:about="&a;200634658"
	 b:glossaryEntry='tell anonymously; "The news were leaked to the paper"'/>
<rdf:Description rdf:about="&a;200634807">
	<b:glossaryEntry>divulge information or secrets; spill the beans; "Be careful--his secretary talks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200635049">
	<b:glossaryEntry>recite the letters of or give the spelling of; "How do you spell this word?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200635224"
	 b:glossaryEntry="spell incorrectly"/>
<rdf:Description rdf:about="&a;200635307"
	 b:glossaryEntry="give an interpretation or explanation to"/>
<rdf:Description rdf:about="&a;200635530">
	<b:glossaryEntry>interpret (a text or an artwork) by the method of deconstructing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200635663"
	 b:glossaryEntry="interpret from a different viewpoint"/>
<rdf:Description rdf:about="&a;200635781"
	 b:glossaryEntry="serve as a commentator, as in sportscasting"/>
<rdf:Description rdf:about="&a;200635892"
	 b:glossaryEntry="interpret falsely"/>
<rdf:Description rdf:about="&a;200635987"
	 b:glossaryEntry="give an explanation for"/>
<rdf:Description rdf:about="&a;200636201"
	 b:glossaryEntry='give reasons for; "Can you account for all these absences?"'/>
<rdf:Description rdf:about="&a;200636337"
	 b:glossaryEntry="explain with reference to nature"/>
<rdf:Description rdf:about="&a;200636437"
	 b:glossaryEntry="shed light on"/>
<rdf:Description rdf:about="&a;200636600"
	 b:glossaryEntry="make obscure or unclear"/>
<rdf:Description rdf:about="&a;200636716">
	<b:glossaryEntry>articulate; either verbally or with a cry, shout, or noise; "She expressed her anger"; "He uttered a curse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200637219">
	<b:glossaryEntry>utter indistinctly; "She swallowed the last words of her speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200637348">
	<b:glossaryEntry>cause to be heard or known; express or utter; "raise a shout"; "raise a protest"; "raise a sad cry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200637528"
	 b:glossaryEntry='utter or tell; "not breathe a word"'/>
<rdf:Description rdf:about="&a;200637628"
	 b:glossaryEntry='utter casually; "drop a hint"'/>
<rdf:Description rdf:about="&a;200637720">
	<b:glossaryEntry>express without restraint; "The woman poured out her frustrations as the judge listened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200637874"
	 b:glossaryEntry="make a cat-like sound"/>
<rdf:Description rdf:about="&a;200637974">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deliver verbally; "He got off the best line I''ve heard in a long time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200638109"
	 b:glossaryEntry='express in speech; "She talks a lot of nonsense"'/>
<rdf:Description rdf:about="&a;200638965"
	 b:glossaryEntry='discuss or mention; "They spoke of many things"'/>
<rdf:Description rdf:about="&a;200639127"
	 b:glossaryEntry="utter while crying"/>
<rdf:Description rdf:about="&a;200639232"
	 b:glossaryEntry='give expression to; "She showed her disappointment"'/>
<rdf:Description rdf:about="&a;200639588">
	<b:glossaryEntry>manifest or show; "This student gives promise of real creativity"; "The office gave evidence of tampering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200639756">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make apparent by one''s mood or behaviour; "She exude great confidence"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200639889">
	<b:glossaryEntry>give expression or utterance to; "She vented her anger"; "The graduates gave vent to cheers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200640075"
	 b:glossaryEntry="talk in a monotonous voice"/>
<rdf:Description rdf:about="&a;200640175"
	 b:glossaryEntry="conclude by reasoning; in logic"/>
<rdf:Description rdf:about="&a;200640286">
	<b:glossaryEntry>conclude from evidence; "I gather you have not done your homework"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200640416"
	 b:glossaryEntry='repeat aloud from memory; "she recited a poem"'/>
<rdf:Description rdf:about="&a;200640598">
	<b:glossaryEntry xml:space='preserve'><![CDATA[recite or repeat a fixed text; "Say grace"; "She said her `Hail Mary''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200640729">
	<b:glossaryEntry>recite volubly or extravagantly; "He could recite the names of all the chemical elements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200640934"
	 b:glossaryEntry="give or make a list of; name individually; give the names of"/>
<rdf:Description rdf:about="&a;200641064">
	<b:glossaryEntry>specify individually; "She enumerated the many obstacles she had encountered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200641244">
	<b:glossaryEntry>enumerate; "We must number the names of the great mathematicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200641405"
	 b:glossaryEntry="decide upon, as of variables in math"/>
<rdf:Description rdf:about="&a;200641602"
	 b:glossaryEntry='mention and identify by name; "name your accomplices!"'/>
<rdf:Description rdf:about="&a;200641718"
	 b:glossaryEntry='set anew; "They re-set the date"'/>
<rdf:Description rdf:about="&a;200641813"
	 b:glossaryEntry="count backwards; before detonating a bomb, for example"/>
<rdf:Description rdf:about="&a;200641935"
	 b:glossaryEntry='name or recite the numbers; "The toddler could count to 100"'/>
<rdf:Description rdf:about="&a;200642112">
	<b:glossaryEntry>determine the number or amount of; "Can you count the books on your shelf?"; "Count your change"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200642362"
	 b:glossaryEntry="count wrongly"/>
<rdf:Description rdf:about="&a;200642449"
	 b:glossaryEntry='conduct a census; "They censused the deer in the forest"'/>
<rdf:Description rdf:about="&a;200642577"
	 b:glossaryEntry='give numbers to; "You should number the pages of the thesis"'/>
<rdf:Description rdf:about="&a;200642727"
	 b:glossaryEntry="number the pages of a book or manuscript"/>
<rdf:Description rdf:about="&a;200642843">
	<b:glossaryEntry>determine the sum of; "Add all the people in this town to those of the neighboring town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200643108"
	 b:glossaryEntry="keep score, as in games"/>
<rdf:Description rdf:about="&a;200643223"
	 b:glossaryEntry="of appeal courts"/>
<rdf:Description rdf:about="&a;200643331"
	 b:glossaryEntry="be dared to do something and attempt it"/>
<rdf:Description rdf:about="&a;200643462"
	 b:glossaryEntry="be dared to do something and not attempt it"/>
<rdf:Description rdf:about="&a;200643556">
	<b:glossaryEntry xml:space='preserve'><![CDATA[show consideration for; take into account; "You must consider her age"; "The judge considered the offender''s youth and was lenient"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200643777"
	 b:glossaryEntry="utter with tense vocal chords"/>
<rdf:Description rdf:about="&a;200643889">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pronounce (vowels) by bringing the tongue closer to the roof of the mouth; "raise your `o''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200644043"
	 b:glossaryEntry="articulate in a very careful and rhythmic way"/>
<rdf:Description rdf:about="&a;200644158"
	 b:glossaryEntry="pronounce a consonant with the tongue against the palate"/>
<rdf:Description rdf:about="&a;200644295"
	 b:glossaryEntry="pronounce with a lowered velum"/>
<rdf:Description rdf:about="&a;200644402"
	 b:glossaryEntry="pronounce a word incorrectly"/>
<rdf:Description rdf:about="&a;200644500"
	 b:glossaryEntry="pronounce with aspiration; of stop sounds"/>
<rdf:Description rdf:about="&a;200644607"
	 b:glossaryEntry="utter with vibrating vocal chords"/>
<rdf:Description rdf:about="&a;200644776"
	 b:glossaryEntry='let something be known; "Tell them that you will be late"'/>
<rdf:Description rdf:about="&a;200645075">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reveal information; let the cat out of the bag; "If you don''t oblige me, I''ll talk!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200645239"
	 b:glossaryEntry='give an account of; "The witness related the events"'/>
<rdf:Description rdf:about="&a;200645379">
	<b:glossaryEntry>narrate or give a detailed account of; "Tell what happened"; "The father told a story to his child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200645654"
	 b:glossaryEntry="tell or spin a yarn"/>
<rdf:Description rdf:about="&a;200645735"
	 b:glossaryEntry="recite a rhapsody"/>
<rdf:Description rdf:about="&a;200645820"
	 b:glossaryEntry="provide commentary for a film, for example"/>
<rdf:Description rdf:about="&a;200645935"
	 b:glossaryEntry='reveal; "a telling sign"'/>
<rdf:Description rdf:about="&a;200646076"
	 b:glossaryEntry='make public; "She aired her opinions on welfare"'/>
<rdf:Description rdf:about="&a;200646304"
	 b:glossaryEntry="make public by bulletin"/>
<rdf:Description rdf:about="&a;200646401">
	<b:glossaryEntry>mean or intend to express or convey; "You never understand what I mean!" "what do his words intend?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200646688">
	<b:glossaryEntry>direct (a remark) toward an intended goal; "She wanted to aim a pun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200646817">
	<b:glossaryEntry>elaborate or expatiate upon; give details; "She elaborated on her plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200647114"
	 b:glossaryEntry="provide details for"/>
<rdf:Description rdf:about="&a;200647197"
	 b:glossaryEntry="add details to"/>
<rdf:Description rdf:about="&a;200647376">
	<b:glossaryEntry>describe the qualities or peculiarities of; "You can characterize his behavior as that of an egotist"; "This poem can be characterized as a lament for a dead lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200647680">
	<b:glossaryEntry>state unambiguously or remove ambiguities from; "Can you disambiguate this statement?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200647845">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give a definition for the meaning of a word; "Define `sadness''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200647998"
	 b:glossaryEntry="give a new or different definition of (a word)"/>
<rdf:Description rdf:about="&a;200648110">
	<b:glossaryEntry>to say again or imitate: "followers echoing the cries of their leaders."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200648360"
	 b:glossaryEntry="repeat monotonously, like a cuckoo repeats his call"/>
<rdf:Description rdf:about="&a;200648475"
	 b:glossaryEntry="repeat back like an echo"/>
<rdf:Description rdf:about="&a;200648571">
	<b:glossaryEntry xml:space='preserve'><![CDATA[repeat mindlessly; "The students parroted the teacher''s words"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200648713">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to say or state again: "Mrs. Molvar, who kept reiterating her request..", "``Just barely'''' , he said, and repeated his paraphrase:"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200649087">
	<b:glossaryEntry>repeat an action or statement; "The next speaker dittoed her argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200649220">
	<b:glossaryEntry>repeat after memorization; "For the exam, you must be able to regurgitate the information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200649391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[come back to; "Don''t dwell on the past"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200649500">
	<b:glossaryEntry>go back to something earlier; "This harks back to a previous remark of his"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200649691"
	 b:glossaryEntry="return in thought or speech to something"/>
<rdf:Description rdf:about="&a;200649804"
	 b:glossaryEntry="render into another language"/>
<rdf:Description rdf:about="&a;200650017"
	 b:glossaryEntry="translate again"/>
<rdf:Description rdf:about="&a;200650101"
	 b:glossaryEntry="translate incorrectly"/>
<rdf:Description rdf:about="&a;200650192"
	 b:glossaryEntry="provide with a soundtrack of a foreign language; of films"/>
<rdf:Description rdf:about="&a;200650328">
	<b:glossaryEntry>make (motion picture sound) exactly simultaneous with the action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200650479"
	 b:glossaryEntry="provide an interlinear translation of a word or phrase"/>
<rdf:Description rdf:about="&a;200650596"
	 b:glossaryEntry="translate into Latin"/>
<rdf:Description rdf:about="&a;200650693"
	 b:glossaryEntry="provide interlinear explanations for words or phrases"/>
<rdf:Description rdf:about="&a;200650819"
	 b:glossaryEntry="make a commentary on"/>
<rdf:Description rdf:about="&a;200650915"
	 b:glossaryEntry="express the same message in different words"/>
<rdf:Description rdf:about="&a;200651072">
	<b:glossaryEntry>make or coin into a word; "The concept expressed by German "Gemuetlichkeit" is not lexicalized in English"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200651246">
	<b:glossaryEntry>exchange thoughts; talk with; "We often talk business"; also used metaphorically: "Actions talk louder than words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200651751">
	<b:glossaryEntry>speak in a condescending manner, as if to a child; "He talks down to her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200651891"
	 b:glossaryEntry="speak at great length (about something)"/>
<rdf:Description rdf:about="&a;200652001"
	 b:glossaryEntry="speak dogmatically"/>
<rdf:Description rdf:about="&a;200652086"
	 b:glossaryEntry="speak impudently to"/>
<rdf:Description rdf:about="&a;200652168">
	<b:glossaryEntry xml:space='preserve'><![CDATA[use language: "the baby talks already"; "the prisoner won''t speak"; "they speak a strange dialect"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200652398"
	 b:glossaryEntry="talk or narrate at length"/>
<rdf:Description rdf:about="&a;200652487">
	<b:glossaryEntry>speak with spotty or superficial knowledge: "She smatters Russian"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200652618"
	 b:glossaryEntry="use slang or vulgar language"/>
<rdf:Description rdf:about="&a;200652709">
	<b:glossaryEntry>talk frankly with; lay it on the line; "I have to level with you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200652837"
	 b:glossaryEntry="discuss frankly, often in a business context"/>
<rdf:Description rdf:about="&a;200652950"
	 b:glossaryEntry="talk to oneself"/>
<rdf:Description rdf:about="&a;200653048"
	 b:glossaryEntry="carry on a conversation"/>
<rdf:Description rdf:about="&a;200653247"
	 b:glossaryEntry="bring up a topic for discussion"/>
<rdf:Description rdf:about="&a;200653371">
	<b:glossaryEntry>to give an account or representation of in words: "Discreet Italian police described it in a manner typically continental."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200653609">
	<b:glossaryEntry>make known to the authorities; "One student reported the other to the principal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200653772">
	<b:glossaryEntry>complain about; make a charge against; "I reported her to the superviser"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200653917">
	<b:glossaryEntry xml:space='preserve'><![CDATA[announce one''s presence; "I report to work every day at 9 o''clock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200654101"
	 b:glossaryEntry='announce officially; "The President declared war"'/>
<rdf:Description rdf:about="&a;200654262"
	 b:glossaryEntry="declare that a legal case will not be prosecuted"/>
<rdf:Description rdf:about="&a;200654408"
	 b:glossaryEntry="announce one''s arrival, e.g. at hotels or airports"/>
<rdf:Description rdf:about="&a;200654568"
	 b:glossaryEntry="register one''s arrival at work"/>
<rdf:Description rdf:about="&a;200654730"
	 b:glossaryEntry="announce one''s departure from a hotel"/>
<rdf:Description rdf:about="&a;200654860"
	 b:glossaryEntry="register one''s departure from work"/>
<rdf:Description rdf:about="&a;200655029">
	<b:glossaryEntry>announce as the result of an investigation, or announce something to the proper authorities; "Dozens of incidents of wife beatings are reported daily in this city"; "The team reported significant advances in their research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200655324">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be responsible for reporting the details of, as in journalism; "Snow reported on China in the 1950''s"; "The cub reporter covered New York City"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200655573">
	<b:glossaryEntry>maintain a check on; esp. by patrolling; "The second officer covered the top floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200655737"
	 b:glossaryEntry="publish a magazine or newspaper, for example"/>
<rdf:Description rdf:about="&a;200655894"
	 b:glossaryEntry="as of information"/>
<rdf:Description rdf:about="&a;200656191"
	 b:glossaryEntry="broadcast or disseminate via satellite"/>
<rdf:Description rdf:about="&a;200656296"
	 b:glossaryEntry="broadcast a sports event"/>
<rdf:Description rdf:about="&a;200656388"
	 b:glossaryEntry='introduce into an environment; "sow suspicion or beliefs"'/>
<rdf:Description rdf:about="&a;200656514"
	 b:glossaryEntry='broadcast via television; "The Royal wedding was televized"'/>
<rdf:Description rdf:about="&a;200656679"
	 b:glossaryEntry="broadcast in color"/>
<rdf:Description rdf:about="&a;200656764"
	 b:glossaryEntry="of information"/>
<rdf:Description rdf:about="&a;200656866"
	 b:glossaryEntry="pass around, as of rumors"/>
<rdf:Description rdf:about="&a;200656960">
	<b:glossaryEntry>cater to popular taste to make popular and present to the general public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200657112"
	 b:glossaryEntry="spread by propaganda"/>
<rdf:Description rdf:about="&a;200657202"
	 b:glossaryEntry="subject to propaganda"/>
<rdf:Description rdf:about="&a;200657293">
	<b:glossaryEntry>ascribe a quality to or give a name that reflects a quality; "He called me a bastard"; "She called her children lazy and ungrateful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200657531">
	<b:glossaryEntry>assign in incorrect name to; "These misnamed philanthropists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200657667">
	<b:glossaryEntry>advertize in strongly positive terms; "This product was touted as a revolutionary invention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200657821"
	 b:glossaryEntry='pronounce judgment on; "They labeled him unfit to work here"'/>
<rdf:Description rdf:about="&a;200658116">
	<b:glossaryEntry>decide on and make a declaration about; "find someone guilty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200658254"
	 b:glossaryEntry='pronounce fit; "She was qualified to run the marathon"'/>
<rdf:Description rdf:about="&a;200658399">
	<b:glossaryEntry>declare unfit; "She was disqualified for the Olympics because she was a professional athlete"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200658622">
	<b:glossaryEntry>disqualify oneself (as a judge, for example) in a particular case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200658752">
	<b:glossaryEntry>broadcast over the airwaves, as in radio or television; "We cannot air this X-rated song"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200659045"
	 b:glossaryEntry='be broadcast; "This show will air Saturdays at 2 P.M."'/>
<rdf:Description rdf:about="&a;200659168"
	 b:glossaryEntry="broadcast again, as of a film"/>
<rdf:Description rdf:about="&a;200659274"
	 b:glossaryEntry="cease broadcasting; get off the air; as of radio stations"/>
<rdf:Description rdf:about="&a;200659397"
	 b:glossaryEntry="foreshadow or presage"/>
<rdf:Description rdf:about="&a;200659537">
	<b:glossaryEntry>make known; make an announcement; "She denoted his feelings clearly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200659902">
	<b:glossaryEntry>proclaim or announce in public; "before we had newspapers, a town cryer would cry the news"; "He cried his merchandise in the market square"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200660116">
	<b:glossaryEntry>utter a characteristic note or cry; "bluejays called to one another"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200660246"
	 b:glossaryEntry="proclaim or announce with or as if with a fanfare"/>
<rdf:Description rdf:about="&a;200660378"
	 b:glossaryEntry="announce loudly"/>
<rdf:Description rdf:about="&a;200660471">
	<b:glossaryEntry>give the names of; "He announced the winners of the spelling bee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200660610"
	 b:glossaryEntry="call out loudly, as of names or numbers"/>
<rdf:Description rdf:about="&a;200660741">
	<b:glossaryEntry>call in turn from right to left or from back to front numbers that determine some position or function</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200660910">
	<b:glossaryEntry xml:space='preserve'><![CDATA[call attention to; "Please don''t advertise the fact that he has AIDS"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200661130"
	 b:glossaryEntry="publicize widely or highly, as if with a headline"/>
<rdf:Description rdf:about="&a;200661253"
	 b:glossaryEntry="advertize noisily or blatantly"/>
<rdf:Description rdf:about="&a;200661357">
	<b:glossaryEntry>make a plug for; praise the qualities or in order to sell or promote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200661487"
	 b:glossaryEntry="make publicity for; try to sell"/>
<rdf:Description rdf:about="&a;200661682">
	<b:glossaryEntry>advertise esp. by posters or placards; "He was billed as the greatest tenor since Caruso"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200661842">
	<b:glossaryEntry>state or announce; "I am not a Communist," he exclaimed; "The King will proclaim an amnesty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200662067">
	<b:glossaryEntry>proclaim on, or as if on, a trumpet; "Liberals like to trumpet their opposition to the death penalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200662233"
	 b:glossaryEntry="proclaim on, or as if on, a clarion"/>
<rdf:Description rdf:about="&a;200662333">
	<b:glossaryEntry>declare formally; declare someone to be something; of titles: "He was proclaimed King"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200662493"
	 b:glossaryEntry="express or state clearly"/>
<rdf:Description rdf:about="&a;200662608">
	<b:glossaryEntry xml:space='preserve'><![CDATA[speak, pronounce, or utter in a certain way; "She pronounces French words in a funny way"; "I cannot say `zip wire''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200663192">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter aloud; "She said ''Hello'' to everyone in the office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200663310">
	<b:glossaryEntry>utter with distinct articulation of each syllable, as of verse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200663439"
	 b:glossaryEntry="in particular, draw out the vowels"/>
<rdf:Description rdf:about="&a;200663545"
	 b:glossaryEntry="pronounce with rounded lips"/>
<rdf:Description rdf:about="&a;200663647">
	<b:glossaryEntry>put into words or an expression; "He formulated his concerns to the board of trustees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200663919"
	 b:glossaryEntry="state as a dogma"/>
<rdf:Description rdf:about="&a;200664010"
	 b:glossaryEntry="express as a formula"/>
<rdf:Description rdf:about="&a;200664112">
	<b:glossaryEntry xml:space='preserve'><![CDATA[formulate in a particular style or language; "I wouldn''t put it that way"; "She cast her request in very polite language"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200664326"
	 b:glossaryEntry="speak haltingly"/>
<rdf:Description rdf:about="&a;200664433"
	 b:glossaryEntry="utter in a grating voice"/>
<rdf:Description rdf:about="&a;200664527"
	 b:glossaryEntry='utter impulsively; "He blurted out the secret"'/>
<rdf:Description rdf:about="&a;200664682"
	 b:glossaryEntry="speak with a lisp"/>
<rdf:Description rdf:about="&a;200664761"
	 b:glossaryEntry="of one''s speech, varying the pitch"/>
<rdf:Description rdf:about="&a;200664871">
	<b:glossaryEntry>change the form of a word in accordance as required by the grammatical rules of the language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200665082">
	<b:glossaryEntry>to form the comparative or superlative form on an adjective or adverb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200665216"
	 b:glossaryEntry="of nouns, pronouns, and adjectives"/>
<rdf:Description rdf:about="&a;200665315"
	 b:glossaryEntry="of verbs"/>
<rdf:Description rdf:about="&a;200665390"
	 b:glossaryEntry="put stress on; utter with an accent"/>
<rdf:Description rdf:about="&a;200665498"
	 b:glossaryEntry="pronounce as a vowel"/>
<rdf:Description rdf:about="&a;200665595">
	<b:glossaryEntry>express audibly; utter sounds (not necessarily words); "She let out a big heavy sigh"; "He uttered strange sounds that nobody could understand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200666828"
	 b:glossaryEntry='utter a characteristic sound; "The cat was crying"'/>
<rdf:Description rdf:about="&a;200666939">
	<b:glossaryEntry xml:space='preserve'><![CDATA[speak in a nasal voice; " `Come here,'' he nasaled"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200667053"
	 b:glossaryEntry='utter; "She bit out a curse"'/>
<rdf:Description rdf:about="&a;200667147"
	 b:glossaryEntry="utter with a sigh"/>
<rdf:Description rdf:about="&a;200667234">
	<b:glossaryEntry>emit a cry intended to attract other animals; used esp. of animals at rutting time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200667379"
	 b:glossaryEntry='make audible; "He lifted a war whoop"'/>
<rdf:Description rdf:about="&a;200667478"
	 b:glossaryEntry="utter while panting, as if out of breath"/>
<rdf:Description rdf:about="&a;200667580"
	 b:glossaryEntry='utter rapidly; "volley a string of curses"'/>
<rdf:Description rdf:about="&a;200667686">
	<b:glossaryEntry>express or utter spontaneously: "break into a yodel"; "break into a song"; "break into tears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200667855"
	 b:glossaryEntry='utter a sound, as with obvious effort; "She uttered a sigh"'/>
<rdf:Description rdf:about="&a;200667977">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter in unison; " `yes,'' the children chorused"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200668089"
	 b:glossaryEntry="utter with a spitting sound, as if in a rage"/>
<rdf:Description rdf:about="&a;200668209"
	 b:glossaryEntry='give a description of; "He drew an elaborate plan of attack"'/>
<rdf:Description rdf:about="&a;200668411"
	 b:glossaryEntry="serve as a means of expressing something"/>
<rdf:Description rdf:about="&a;200668632">
	<b:glossaryEntry xml:space='preserve'><![CDATA[represent something in a dramatic manner; "These events dramatize the lack of social responsibility among today''s youth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200668845"
	 b:glossaryEntry="present in an overly dramatic manner"/>
<rdf:Description rdf:about="&a;200668960">
	<b:glossaryEntry>portray in words; "The book portrays the actor as a selfish person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200669100"
	 b:glossaryEntry="describe in vivid detail"/>
<rdf:Description rdf:about="&a;200669199">
	<b:glossaryEntry>give a speech to; "The chairman addressed the board of trustees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200669398"
	 b:glossaryEntry="rise in order to make a speech or motion"/>
<rdf:Description rdf:about="&a;200669510">
	<b:glossaryEntry>deliver (a speech, oration, or idea); "The commencement speaker presented a forceful speech that impressed the students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200669723">
	<b:glossaryEntry>utter (an exclamation, noise, etc.); "The students delivered a cry of joy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200669863"
	 b:glossaryEntry="make a speech or speeches"/>
<rdf:Description rdf:about="&a;200669955"
	 b:glossaryEntry="deliver a harangue to; address forcefully"/>
<rdf:Description rdf:about="&a;200670063">
	<b:glossaryEntry>make advances to someone, usually with a proposal or suggestion; "I was approached by the President to serve as his adviser in foreign matters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200670272"
	 b:glossaryEntry="speak to someone"/>
<rdf:Description rdf:about="&a;200670411"
	 b:glossaryEntry="put an address on (an envelope, for example)"/>
<rdf:Description rdf:about="&a;200670547"
	 b:glossaryEntry="put a new address on (an envelope), as for forwarding"/>
<rdf:Description rdf:about="&a;200670668">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make understand; "Can you enlighten me--I don''t understand this proposal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200670824"
	 b:glossaryEntry="free somebody (from an erroneous belief)"/>
<rdf:Description rdf:about="&a;200670930">
	<b:glossaryEntry xml:space='preserve'><![CDATA[publicize with, or as it with, a poster; "I''ll post the news on the bulletin board"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200671093"
	 b:glossaryEntry="publicize or announce by placards"/>
<rdf:Description rdf:about="&a;200671198"
	 b:glossaryEntry="give religious instructions to"/>
<rdf:Description rdf:about="&a;200671307">
	<b:glossaryEntry>show, express or direct through movement; "He gestured his desire to leave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200671658"
	 b:glossaryEntry="communicate nonverbally by telepathy"/>
<rdf:Description rdf:about="&a;200671763">
	<b:glossaryEntry>communicate or express by writing; "Please write to me every week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200672148"
	 b:glossaryEntry="use an apostrophe"/>
<rdf:Description rdf:about="&a;200672235">
	<b:glossaryEntry>convert ordinary language into code; "We should encode the message for security reasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200672478"
	 b:glossaryEntry="convert code into ordinary language"/>
<rdf:Description rdf:about="&a;200672595">
	<b:glossaryEntry>rewrite in a different script;"The Sanskrit text had to be transliterated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200672789">
	<b:glossaryEntry>make a phonetic transcription of; "The anthropologist transcribed the sentences of the native informant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200672961">
	<b:glossaryEntry>write out from speech, notes, etc.; "Transcribe the oral history of this tribe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200673108"
	 b:glossaryEntry="write in the latin alphabet"/>
<rdf:Description rdf:about="&a;200673234"
	 b:glossaryEntry="transcribe in Braille"/>
<rdf:Description rdf:about="&a;200673320">
	<b:glossaryEntry>write differently; alter the writing of; "The student rewrote his thesis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200673530"
	 b:glossaryEntry='make revisions in; "revise a thesis"'/>
<rdf:Description rdf:about="&a;200673648"
	 b:glossaryEntry='make amendments to; "amend the document"'/>
<rdf:Description rdf:about="&a;200673751">
	<b:glossaryEntry xml:space='preserve'><![CDATA[mark with one''s signature; write one''s name (on); "She signed the letter and sent it off"; "Please sign here"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200674004"
	 b:glossaryEntry="sign at the bottom of (a document, for example)"/>
<rdf:Description rdf:about="&a;200674118">
	<b:glossaryEntry xml:space='preserve'><![CDATA[append one''s signature to; "They inked the contract"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200674231">
	<b:glossaryEntry xml:space='preserve'><![CDATA[mark with one''s signature; "The author autographed his book"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200674369"
	 b:glossaryEntry="mark with one''s initials"/>
<rdf:Description rdf:about="&a;200674476">
	<b:glossaryEntry xml:space='preserve'><![CDATA[add one''s signature to after another''s to attest authenticity; "You must contersign on this line of the contract"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200674666"
	 b:glossaryEntry="sign in the presence of witnesses"/>
<rdf:Description rdf:about="&a;200674764"
	 b:glossaryEntry="of documents or cheques"/>
<rdf:Description rdf:about="&a;200674870"
	 b:glossaryEntry="provide (a passport) with a visa"/>
<rdf:Description rdf:about="&a;200674964"
	 b:glossaryEntry="make a dot or dots"/>
<rdf:Description rdf:about="&a;200675051"
	 b:glossaryEntry="register electronically"/>
<rdf:Description rdf:about="&a;200675295">
	<b:glossaryEntry>record data on a computer; "boot-up instructions are written on the hard disk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200675462">
	<b:glossaryEntry>write new data on top of existing data and thus erase the previously existing data; "overwrite that file"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200675634"
	 b:glossaryEntry="record with a tape recorder"/>
<rdf:Description rdf:about="&a;200675738"
	 b:glossaryEntry="record before presentation, as of a broadcast"/>
<rdf:Description rdf:about="&a;200675858">
	<b:glossaryEntry>make a record of additions to a collection, such as a library</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200675986"
	 b:glossaryEntry="for example, of records, in sports"/>
<rdf:Description rdf:about="&a;200676082"
	 b:glossaryEntry="wipe out magnetically recorded information"/>
<rdf:Description rdf:about="&a;200676214"
	 b:glossaryEntry="record digitally, as of compact disks"/>
<rdf:Description rdf:about="&a;200676319">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to perform and record a sale on a cash register; "Sally rang up Eve''s purchase of tomatoes."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200676476"
	 b:glossaryEntry="make a record of; set down in permanent form"/>
<rdf:Description rdf:about="&a;200677013"
	 b:glossaryEntry="write, engrave, or print as a lasting record"/>
<rdf:Description rdf:about="&a;200677124"
	 b:glossaryEntry="record in chronological order; make a historical record"/>
<rdf:Description rdf:about="&a;200677246">
	<b:glossaryEntry xml:space='preserve'><![CDATA[state; "set forth one''s reasons"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200677373">
	<b:glossaryEntry>set forth beforehand, often as an explanation: "He premised these remarks so that his readers might understand..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200677552"
	 b:glossaryEntry="place in a file"/>
<rdf:Description rdf:about="&a;200677641">
	<b:glossaryEntry>register in a public office or in a court of law; "file for divorce"; "file a complaint"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200677802">
	<b:glossaryEntry xml:space='preserve'><![CDATA[record in detail; "The parents documented every step of their child''s development"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200677950"
	 b:glossaryEntry="enter into a log, as on ships and planes"/>
<rdf:Description rdf:about="&a;200678069"
	 b:glossaryEntry="record a distance travelled; on planes and cars"/>
<rdf:Description rdf:about="&a;200678191">
	<b:glossaryEntry>make a film or photograph of something; "take a scene"; "shoot a movie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200678373"
	 b:glossaryEntry="record on videotape"/>
<rdf:Description rdf:about="&a;200678482">
	<b:glossaryEntry>record on photographic film"I photographed the scene of the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200678686"
	 b:glossaryEntry='photograph again; "Please retake that scene"'/>
<rdf:Description rdf:about="&a;200678802">
	<b:glossaryEntry>shoot again: "We had to reshoot that scene 24 times", as of film</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200678948">
	<b:glossaryEntry>take an x-ray of something or somebody; "The doctor x-rayed my chest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200679088"
	 b:glossaryEntry="make underscoring marks"/>
<rdf:Description rdf:about="&a;200679207"
	 b:glossaryEntry="notch a surface to record something"/>
<rdf:Description rdf:about="&a;200679313"
	 b:glossaryEntry="write by means of a typewriter"/>
<rdf:Description rdf:about="&a;200679497">
	<b:glossaryEntry>write by hand; "You should handwrite the note to your guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200679625">
	<b:glossaryEntry>hit the backspace key on a computer or typewriter keyboard; "To erase, you must backspace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200679782"
	 b:glossaryEntry="type with a full space between lines"/>
<rdf:Description rdf:about="&a;200679888"
	 b:glossaryEntry="type with two empty spaces between lines"/>
<rdf:Description rdf:about="&a;200679998"
	 b:glossaryEntry="type without looking at the keyboard"/>
<rdf:Description rdf:about="&a;200680102">
	<b:glossaryEntry>make explicit; specify in detail; "You shuld spell out your demands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200680253"
	 b:glossaryEntry="write briefly or hurriedly; write a short note of"/>
<rdf:Description rdf:about="&a;200680382"
	 b:glossaryEntry="write down quickly without much attention to detail"/>
<rdf:Description rdf:about="&a;200680510">
	<b:glossaryEntry>describe roughly or briefly; "sketch the outline of the book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200680675"
	 b:glossaryEntry='indicate roughly; "We sketched out our plan"'/>
<rdf:Description rdf:about="&a;200680786">
	<b:glossaryEntry>exchange messages; "My Russian pen pal and I have been corresponding for several years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200680967"
	 b:glossaryEntry='communicate (with) in writing; "Write her soon, please!"'/>
<rdf:Description rdf:about="&a;200681108"
	 b:glossaryEntry="send cables, wires, or telegrams"/>
<rdf:Description rdf:about="&a;200681254"
	 b:glossaryEntry='transmit messages via radio waves; "he radioed for help"'/>
<rdf:Description rdf:about="&a;200681381">
	<b:glossaryEntry>send something via a facsimile machine; "Can you fax me the report right away?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200681575"
	 b:glossaryEntry='give a summary (of); "he summed up his results"'/>
<rdf:Description rdf:about="&a;200681787"
	 b:glossaryEntry="give an abstract (of)"/>
<rdf:Description rdf:about="&a;200681882"
	 b:glossaryEntry="make a precis (of)"/>
<rdf:Description rdf:about="&a;200681972">
	<b:glossaryEntry>in law: make a summary or abstract of a legal document and inscribe it in a list</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200682116">
	<b:glossaryEntry>in law: place on the docket for legal action; "Only 5 of the 120 cases docketed were tried"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200682271">
	<b:glossaryEntry xml:space='preserve'><![CDATA[summarize briefly; "Let''s recapitulate the main ideas"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200682429"
	 b:glossaryEntry='go back over; "retrograde arguments"'/>
<rdf:Description rdf:about="&a;200682542">
	<b:glossaryEntry>express an idea, etc. in words; "He said that he wanted to marry her"; "tell me what is bothering you"; "state your opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200683028">
	<b:glossaryEntry xml:space='preserve'><![CDATA[state as one''s opinion or judgement; declare; "I say let''s forget this whole business"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200683175"
	 b:glossaryEntry='express with difficulty; "I managed to get out a few words"'/>
<rdf:Description rdf:about="&a;200683308"
	 b:glossaryEntry='state clearly: "He stated his name"'/>
<rdf:Description rdf:about="&a;200683704">
	<b:glossaryEntry>make a declaration (of dutiable goods) to a customs official; "Do you have anything to declare?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200683865">
	<b:glossaryEntry>to declare or affirm as true: "Before God I swear I am innocent."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200684148">
	<b:glossaryEntry>affirm or avow formally or solemnly; "The suspect protested his innocence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200684295"
	 b:glossaryEntry="say yes to"/>
<rdf:Description rdf:about="&a;200684457"
	 b:glossaryEntry='affirm once again; "He reaffirmed his faith in the church"'/>
<rdf:Description rdf:about="&a;200684589">
	<b:glossaryEntry xml:space='preserve'><![CDATA[strengthen or make more firm; "The witnesses confirmed the victim''s account"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200684839"
	 b:glossaryEntry="give evidence for"/>
<rdf:Description rdf:about="&a;200684962"
	 b:glossaryEntry="give circumstantial evidence for"/>
<rdf:Description rdf:about="&a;200685075"
	 b:glossaryEntry='confirm again: "You must reconfirm your flight reservations"'/>
<rdf:Description rdf:about="&a;200685210"
	 b:glossaryEntry="make a deposition; declare under oath"/>
<rdf:Description rdf:about="&a;200685329"
	 b:glossaryEntry="present and urge reasons in opposition"/>
<rdf:Description rdf:about="&a;200685448">
	<b:glossaryEntry>to stress, single out as important: "Dr. Jones emphasizes exercise in addition to a change in diet."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200685764">
	<b:glossaryEntry>emphasize, esp. by identification; "This novel points up the racial problems in England"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200685934">
	<b:glossaryEntry>make clear by special emphasis; "drive home a point or an argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200686083">
	<b:glossaryEntry>give extra weight to (a communication); "Her gesture emphasized her words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200686265"
	 b:glossaryEntry="give testimony in a court of law"/>
<rdf:Description rdf:about="&a;200686421"
	 b:glossaryEntry='give personal assurance; guarantee; "Will he vouch for me?"'/>
<rdf:Description rdf:about="&a;200686544">
	<b:glossaryEntry>provide evidence for; "The blood test showed that he was the father"; "Her behavior testified to her incompetence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200686832"
	 b:glossaryEntry="advance evidence for"/>
<rdf:Description rdf:about="&a;200686932">
	<b:glossaryEntry>report or maintain; "He alleged that he was the victim of a crime"; "He said it was too late to intervene in the war"; "The registrar says that I owe the school money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200687210">
	<b:glossaryEntry>make an allegation in an action or other legal proceeding, esp. answer the previous pleading of the other party by denying facts therein stated or by alleging new facts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200687441"
	 b:glossaryEntry="state categorically"/>
<rdf:Description rdf:about="&a;200687592"
	 b:glossaryEntry="affirm or declare"/>
<rdf:Description rdf:about="&a;200687695">
	<b:glossaryEntry>administer on oath to; "The speaker of the House swore in the new President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200687837"
	 b:glossaryEntry='state or assert; "He maintained his innocence"'/>
<rdf:Description rdf:about="&a;200687967">
	<b:glossaryEntry>claim as due or just; "The bank demanded payment of the loan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200688152"
	 b:glossaryEntry='ask to be informed of: "I demand an explanation"'/>
<rdf:Description rdf:about="&a;200688264">
	<b:glossaryEntry xml:space='preserve'><![CDATA[demand as one''s due: "This speaker commands a high fee"; "The author commands a fair hearing from his readers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200688439">
	<b:glossaryEntry>ask for legally or make a legal claim to, as of debts, for example; "They claimed on the maximum allowable amount"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200688678"
	 b:glossaryEntry="set up a claim in opposition to a previous claim, as in law"/>
<rdf:Description rdf:about="&a;200688807"
	 b:glossaryEntry="release from (claims and debts)"/>
<rdf:Description rdf:about="&a;200688901">
	<b:glossaryEntry>specify as a condition; "The will stipulates that she can live in the house for the rest of her life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200689127"
	 b:glossaryEntry="give a guarantee of"/>
<rdf:Description rdf:about="&a;200689221">
	<b:glossaryEntry>state positively and with certainty and confidence; "I tell you that man is a crook!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200689385">
	<b:glossaryEntry>give or restore confidence in; cause to feel sure or certain: "I reassured him that we were safe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200689564">
	<b:glossaryEntry>make mention of; "She observed that his presentation took up too much time"; "They noted that it was a fine day to go sailing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200689807"
	 b:glossaryEntry="put down in writing; of texts, musical compositions, etc."/>
<rdf:Description rdf:about="&a;200690027"
	 b:glossaryEntry='write down hastily; "She dashed off a letter to her lawyer"'/>
<rdf:Description rdf:about="&a;200690164">
	<b:glossaryEntry>write all the required information onto a form; "fill out this questionnaire, please!"; "make out a form"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200690367">
	<b:glossaryEntry>make a written note of; "she noted everything the teacher said that morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200690525"
	 b:glossaryEntry="clarify by giving an example of"/>
<rdf:Description rdf:about="&a;200690655"
	 b:glossaryEntry="reach a conclusion after a discussion or deliberation"/>
<rdf:Description rdf:about="&a;200690810">
	<b:glossaryEntry>make arrangements for; "Can you arrange a meeting with the President?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200690998">
	<b:glossaryEntry xml:space='preserve'><![CDATA[arrange firmly; "firm up one''s plans"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200691100"
	 b:glossaryEntry="be specific about"/>
<rdf:Description rdf:about="&a;200691263">
	<b:glossaryEntry>draw too general a conclusion; "It is dangerous to overgeneralize"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200691426"
	 b:glossaryEntry="draw from specific cases for more general cases"/>
<rdf:Description rdf:about="&a;200691620">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make universal; "This author''s stories unversalize"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200691749"
	 b:glossaryEntry="speak in generalities"/>
<rdf:Description rdf:about="&a;200691869"
	 b:glossaryEntry="cite, as for an outstanding achievement"/>
<rdf:Description rdf:about="&a;200692018"
	 b:glossaryEntry='repeat a passage from; "He quoted the Bible to her'/>
<rdf:Description rdf:about="&a;200692188"
	 b:glossaryEntry='quote incorrectly; "He had misquoted the politician"'/>
<rdf:Description rdf:about="&a;200692314"
	 b:glossaryEntry='name the price of; "quote prices for cars"'/>
<rdf:Description rdf:about="&a;200692437"
	 b:glossaryEntry="quote a price lower than that quoted by (another seller)"/>
<rdf:Description rdf:about="&a;200692561">
	<b:glossaryEntry>make reference to: "His name was mentioned in connection with the invention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200692936"
	 b:glossaryEntry="refer to or discuss briefly"/>
<rdf:Description rdf:about="&a;200693037">
	<b:glossaryEntry>cite as an authority: "He invoked the law that would save him"; "I appealed to the law of 1900"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200693222">
	<b:glossaryEntry>refer to people that one assumes one''s interlocutors admire in order to try to impress them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200693379">
	<b:glossaryEntry>put forward for consideration or discussion; "raise the question of promotions"; "bring up an unpleasant topic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200693588">
	<b:glossaryEntry>bring forward for consideration: "The case was called up in court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200693735">
	<b:glossaryEntry>insert casually; "She slipped in a reference to her own work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200693918">
	<b:glossaryEntry>mention something unpleasant from the past; "Drag up old stories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200694068">
	<b:glossaryEntry>refer from one entry to another, as in catalogues, books, and lists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200694228">
	<b:glossaryEntry>give the name or identifying characteristics of; refer to by name or some other identifying characteristic property; "Many senators were named in connection with the scandal"; "The almanac identifies the auspicious months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200694601">
	<b:glossaryEntry>refer (a word or name) to a person or thing; "He applied this racial slur to me!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200694753">
	<b:glossaryEntry>make a more or less disguised reference to; "He alluded to the problem but did not mention it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200694946">
	<b:glossaryEntry>move into a desired direction of discourse; "What are you driving at?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200695091">
	<b:glossaryEntry xml:space='preserve'><![CDATA[state or say further; " `It doesn''t matter,'' " he supplied"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200695281">
	<b:glossaryEntry xml:space='preserve'><![CDATA[add casually to a conversation; "I don''t agree with this," she tossed in]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200695426"
	 b:glossaryEntry="issue or demand by decree"/>
<rdf:Description rdf:about="&a;200695551">
	<b:glossaryEntry xml:space='preserve'><![CDATA[speak one''s opinion without fear or hesitation; "John spoke up at the meeting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200695746"
	 b:glossaryEntry="insert personal opinions into an objective statement"/>
<rdf:Description rdf:about="&a;200695868"
	 b:glossaryEntry='administer baptism to; "The parents had the child baptized"'/>
<rdf:Description rdf:about="&a;200696029">
	<b:glossaryEntry xml:space='preserve'><![CDATA[designate by an identifying term; "They styled their nation `The Confederate States''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200696177"
	 b:glossaryEntry="give a nickname to"/>
<rdf:Description rdf:about="&a;200696267">
	<b:glossaryEntry>assign a specified name to; "They named their son David"; "The new school was named after the famous Civil Rights leader"; "Call me Boris"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200696634">
	<b:glossaryEntry>assign a new name to; "Many streets in the former East Germany were renamed in 1990"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200696790">
	<b:glossaryEntry>greet by a prescribed form; "He always addresses me with "Sir"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200696918">
	<b:glossaryEntry>be called; go by a certain name; "She goes by her maiden name again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200697050"
	 b:glossaryEntry="give a title to"/>
<rdf:Description rdf:about="&a;200697156"
	 b:glossaryEntry="name formally or designate with a term"/>
<rdf:Description rdf:about="&a;200697256"
	 b:glossaryEntry="provide with a name or nickname"/>
<rdf:Description rdf:about="&a;200697348"
	 b:glossaryEntry="assign a label to; designate with a label"/>
<rdf:Description rdf:about="&a;200697540"
	 b:glossaryEntry="assign a designation to"/>
<rdf:Description rdf:about="&a;200697695"
	 b:glossaryEntry="exclude from a church or a religious communities"/>
<rdf:Description rdf:about="&a;200697848"
	 b:glossaryEntry="administer communion; in church"/>
<rdf:Description rdf:about="&a;200697966"
	 b:glossaryEntry="enter into a covenant"/>
<rdf:Description rdf:about="&a;200698089"
	 b:glossaryEntry='mark or expose as infamous; "She was branded a loose woman"'/>
<rdf:Description rdf:about="&a;200698219">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cause to be directed or transmitted to another place; "send me your latest results"; "I''ll mail you the paper when it''s written"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200698485">
	<b:glossaryEntry>communicate by letter; "He wrote that he would be coming soon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200698610">
	<b:glossaryEntry>send or transport by airmail; "Letters to Europe from the U.S. are best airmailed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200698773">
	<b:glossaryEntry xml:space='preserve'><![CDATA[send by registered mail; "I''d like to register this letter"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200698898">
	<b:glossaryEntry>communicate electronically on the computer; "she e-mailed me the good news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200699089">
	<b:glossaryEntry>communicate with and within a group; "You have to network if you want to get a good job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200699242">
	<b:glossaryEntry>send by express mail or courier such as Federal Express; "Express-mail the documents immediately"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200699425"
	 b:glossaryEntry="explain or interpret something"/>
<rdf:Description rdf:about="&a;200699564">
	<b:glossaryEntry>comment on music to be played; "He has a job diskjockeying on the weekend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200699711">
	<b:glossaryEntry>deal with verbally or in some form of artistic expression; "This book deals with incest"; "The course covered all of Western Civilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200700038">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to consider or examine in speech or writing; "The article covered all the different aspects of this question"; "The class discussed Dante''s ''Inferno''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200700338"
	 b:glossaryEntry="talk at great length about something of one''s interest"/>
<rdf:Description rdf:about="&a;200700457">
	<b:glossaryEntry>discuss work-related matters; "As soon as they met, the linguists started to talk shop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200700611"
	 b:glossaryEntry="discuss extravagantly and at great length"/>
<rdf:Description rdf:about="&a;200700715"
	 b:glossaryEntry="obstruct or hinder any discussion of"/>
<rdf:Description rdf:about="&a;200700826">
	<b:glossaryEntry>discourage or frighten with threats or a domineering manner; intimidate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200700989"
	 b:glossaryEntry="settle by concession"/>
<rdf:Description rdf:about="&a;200701103">
	<b:glossaryEntry>achieve harmony of opinion, feeling, or purpose; "No two of my colleagues would agree on whom to elect chairman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200701304">
	<b:glossaryEntry>make a compromise; arrive at a compromise; "nobody will get everything he wants; we all must compromise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200701494"
	 b:glossaryEntry='make mutual concessions; "In life you have to give and take"'/>
<rdf:Description rdf:about="&a;200701625"
	 b:glossaryEntry="put in a dangerous, disadvantageous, or difficult position"/>
<rdf:Description rdf:about="&a;200701844">
	<b:glossaryEntry>expose or make liable to danger, suspicion, or disrepute; "The nuclear secrets of the state were compromised by the spy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200702056">
	<b:glossaryEntry>make vulnerable or liable to; "People in Chernobyl were subjected to radiation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200702218"
	 b:glossaryEntry="speak (about unimportant matters) rapidly and incessantly"/>
<rdf:Description rdf:about="&a;200702476">
	<b:glossaryEntry>make noise as if chattering away: "The magpies were chattering in the trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200702617"
	 b:glossaryEntry="talk incessantly and tiresomely"/>
<rdf:Description rdf:about="&a;200702751">
	<b:glossaryEntry>to talk foolishly; "The two women babbled and crooned at the baby"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200702922">
	<b:glossaryEntry>talk amorously; "The guys always try to chat up the new secretaries"; "My husband never flirts with other women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200703216"
	 b:glossaryEntry="engage in amorous play"/>
<rdf:Description rdf:about="&a;200703302"
	 b:glossaryEntry="act seductively with (someone)"/>
<rdf:Description rdf:about="&a;200703394"
	 b:glossaryEntry="chew the fat; shoot the breeze"/>
<rdf:Description rdf:about="&a;200703599"
	 b:glossaryEntry="chat in a friendly manner"/>
<rdf:Description rdf:about="&a;200703699">
	<b:glossaryEntry xml:space='preserve'><![CDATA[converse silently and non-verbally; converse in sign language; "I don''t know how to sign, so I could not communicate with my deaf cousin"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200704017">
	<b:glossaryEntry>signal by or as if by a flag or light waved according to a code</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200704144"
	 b:glossaryEntry="convey by semaphore, of information"/>
<rdf:Description rdf:about="&a;200704246"
	 b:glossaryEntry="send signals by or as if by semaphore"/>
<rdf:Description rdf:about="&a;200704350"
	 b:glossaryEntry="signal with a heliograph"/>
<rdf:Description rdf:about="&a;200704451"
	 b:glossaryEntry="communicate or signal with a flag"/>
<rdf:Description rdf:about="&a;200704572">
	<b:glossaryEntry>articulate silently; form words with the lips only; "She mouthed a swear word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200704732">
	<b:glossaryEntry>move the lips in synchronization (with recorded speech or song)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200704873">
	<b:glossaryEntry>refuse to talk or stop talking; fall silent; "The children shut up when their father approached"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200705110"
	 b:glossaryEntry="talk freely and without inhibition"/>
<rdf:Description rdf:about="&a;200705227">
	<b:glossaryEntry>signal with the hands or nod; "She waved to her friends"; "He waved his hand hospitably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200705402"
	 b:glossaryEntry="summon with a wave, nod, or some other gesture"/>
<rdf:Description rdf:about="&a;200705520"
	 b:glossaryEntry='ask to come; "summon a lawyer"'/>
<rdf:Description rdf:about="&a;200705705">
	<b:glossaryEntry>wag one''s tongue; speak about others and reveal secrets or intimacies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200705864">
	<b:glossaryEntry>tell or spread rumors; "It was rumored that the next president would be a woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200706032"
	 b:glossaryEntry="talk volubly"/>
<rdf:Description rdf:about="&a;200706113"
	 b:glossaryEntry="talk in a tearful manner"/>
<rdf:Description rdf:about="&a;200706217">
	<b:glossaryEntry>to utter a loud clamourous shout: "the toughs and blades of the city hoot and bang their drums, drink arak, play dice, and dance."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200706453"
	 b:glossaryEntry="communicate by hooting and panting, as of primates"/>
<rdf:Description rdf:about="&a;200706570"
	 b:glossaryEntry="communicate by hooting and grunting, as of primates"/>
<rdf:Description rdf:about="&a;200706689">
	<b:glossaryEntry>issue a grunting, low, animal-like noise; "He grunted his reluctant approval"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200706845"
	 b:glossaryEntry='utter or express by whistling; "She whistled a melody"'/>
<rdf:Description rdf:about="&a;200706980"
	 b:glossaryEntry='give a signal by whistling; "She whistled for her maid"'/>
<rdf:Description rdf:about="&a;200707100"
	 b:glossaryEntry="whistle or howl approvingly at a female, of males"/>
<rdf:Description rdf:about="&a;200707219">
	<b:glossaryEntry>make a whining, ringing, or whistling sound; "the kettle was singing"; "the bullet sang past his ear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200707393">
	<b:glossaryEntry>speak softly or indistinctly; "She murmured softly to the baby in her arms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200707584"
	 b:glossaryEntry="issue soft noises"/>
<rdf:Description rdf:about="&a;200707668"
	 b:glossaryEntry="talk indistinctly; usually in a low voice"/>
<rdf:Description rdf:about="&a;200707829"
	 b:glossaryEntry="utter indistinctly"/>
<rdf:Description rdf:about="&a;200707909">
	<b:glossaryEntry>speak disparagingly of; e.g., make a racial slur; "your comments are slurring your co-workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200708073"
	 b:glossaryEntry="indicate contempt"/>
<rdf:Description rdf:about="&a;200708161"
	 b:glossaryEntry="utter with anger or contempt"/>
<rdf:Description rdf:about="&a;200708262">
	<b:glossaryEntry>indicate pain, discomfort, or displeasure; "The students groaned when the professor got out the exam booklets"; "The ancient door soughed when opened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200708498">
	<b:glossaryEntry>to utter or emit low dull rumbling sounds: "he grumbled a rude response." "Stones grumbled down the cliff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200708694">
	<b:glossaryEntry>make a loud noise, as of wind, water, or vehicles; "The wind was howling in the trees"; "The water roared down the chute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200708920"
	 b:glossaryEntry="make a raucous noise"/>
<rdf:Description rdf:about="&a;200709009">
	<b:glossaryEntry>to make or produce a loud noise; "The river thundered below"; "The engine roared as the driver pushed the car to full throttle."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200709202"
	 b:glossaryEntry='make a murmuring sound; "the water was purling"'/>
<rdf:Description rdf:about="&a;200709311">
	<b:glossaryEntry>emit long loud cries; "wail in self-pity", "howl with sorrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200709491"
	 b:glossaryEntry="make high-pitched, whiney noises"/>
<rdf:Description rdf:about="&a;200709609">
	<b:glossaryEntry>cry loudly, as of animals; "The coyotes were howling in the desert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200709770">
	<b:glossaryEntry>speak in an unfriendly tone; "She barked into the dictaphone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200709901"
	 b:glossaryEntry='make barking sounds; "The dogs barked at the stranger"'/>
<rdf:Description rdf:about="&a;200710053"
	 b:glossaryEntry="bark with prolonged noises, of dogs"/>
<rdf:Description rdf:about="&a;200710157"
	 b:glossaryEntry="utter in deep prolonged tones"/>
<rdf:Description rdf:about="&a;200710255"
	 b:glossaryEntry='bark in a high-pitched tone; "the puppies yelped"'/>
<rdf:Description rdf:about="&a;200710378"
	 b:glossaryEntry='cry plaintively; "The lambs were bleating"'/>
<rdf:Description rdf:about="&a;200710504"
	 b:glossaryEntry="talk whiningly"/>
<rdf:Description rdf:about="&a;200710581"
	 b:glossaryEntry="shout loudly and without restraint"/>
<rdf:Description rdf:about="&a;200710694"
	 b:glossaryEntry='make a loud noise, as of animal; "The bull bellowed"'/>
<rdf:Description rdf:about="&a;200710825"
	 b:glossaryEntry="utter a harsh abrupt scream"/>
<rdf:Description rdf:about="&a;200710974">
	<b:glossaryEntry>make a shrill creaking, squeaking, or noise, as of a door, mouse, or bird</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200711110"
	 b:glossaryEntry="sing a note with the correct pitch"/>
<rdf:Description rdf:about="&a;200711207"
	 b:glossaryEntry="sing loudly and without inhibition"/>
<rdf:Description rdf:about="&a;200711304"
	 b:glossaryEntry="sing softly"/>
<rdf:Description rdf:about="&a;200711386">
	<b:glossaryEntry>sing or play against other voices or parts; "He cannot carry a tune"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200711517">
	<b:glossaryEntry>recite with musical intonation; recite as a chant; "The rabbi chanted a prayer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200711718"
	 b:glossaryEntry="speak, chant, or declaim in a singsong"/>
<rdf:Description rdf:about="&a;200711830"
	 b:glossaryEntry="speak carefully, with rising and falling pitch"/>
<rdf:Description rdf:about="&a;200711951"
	 b:glossaryEntry="begin to play or sing"/>
<rdf:Description rdf:about="&a;200712037">
	<b:glossaryEntry>sing by changing register; sing by yodeling; "The Austrians were yodeling in the mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200712211"
	 b:glossaryEntry="sing with trills"/>
<rdf:Description rdf:about="&a;200712324">
	<b:glossaryEntry>give off unsteady sounds, alternating in amplitude or frequency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200712459"
	 b:glossaryEntry="sing treble"/>
<rdf:Description rdf:about="&a;200712534"
	 b:glossaryEntry="recite in elocution"/>
<rdf:Description rdf:about="&a;200712689"
	 b:glossaryEntry="deliver an oration in grandiloquent style"/>
<rdf:Description rdf:about="&a;200712796"
	 b:glossaryEntry='read metrically; "scan verses"'/>
<rdf:Description rdf:about="&a;200712888"
	 b:glossaryEntry="talk in a noisy, excited, or declamatory manner"/>
<rdf:Description rdf:about="&a;200713053"
	 b:glossaryEntry="make high-pitched sounds; of birds"/>
<rdf:Description rdf:about="&a;200713194"
	 b:glossaryEntry="make a vibrant sound, as of some birds"/>
<rdf:Description rdf:about="&a;200713303"
	 b:glossaryEntry="make a vibrant noise, of grasshoppers or cicadas"/>
<rdf:Description rdf:about="&a;200713414"
	 b:glossaryEntry='cry like a cat; "the cat meowed"'/>
<rdf:Description rdf:about="&a;200713508"
	 b:glossaryEntry="indicate pleasure by purring; characteristic of cats"/>
<rdf:Description rdf:about="&a;200713652"
	 b:glossaryEntry='utter quacking noises; "The ducks quacked"'/>
<rdf:Description rdf:about="&a;200713757"
	 b:glossaryEntry='cry like a goose; "The geese were honking"'/>
<rdf:Description rdf:about="&a;200713877"
	 b:glossaryEntry="use the horn of a car"/>
<rdf:Description rdf:about="&a;200713969"
	 b:glossaryEntry="make high-pitched sounds, as of birds"/>
<rdf:Description rdf:about="&a;200714081"
	 b:glossaryEntry="make a sharp hissing sound, as if to show disapproval"/>
<rdf:Description rdf:about="&a;200714229"
	 b:glossaryEntry="insert a sibilant sound before or after (another sound)"/>
<rdf:Description rdf:about="&a;200714353"
	 b:glossaryEntry="convert into a sibilant sound"/>
<rdf:Description rdf:about="&a;200714450"
	 b:glossaryEntry="express or utter with a hiss"/>
<rdf:Description rdf:about="&a;200714573"
	 b:glossaryEntry="utter a sibilant"/>
<rdf:Description rdf:about="&a;200714691"
	 b:glossaryEntry="braying characteristic of donkeys"/>
<rdf:Description rdf:about="&a;200714796"
	 b:glossaryEntry="utter a high-pitched cry, characteristic of pigs"/>
<rdf:Description rdf:about="&a;200714915"
	 b:glossaryEntry="make a clucking sounds, characteristic of hens"/>
<rdf:Description rdf:about="&a;200715048"
	 b:glossaryEntry="make a low noise, characteristic of bovines"/>
<rdf:Description rdf:about="&a;200715158"
	 b:glossaryEntry='produce a click; "Xhosa speakers click"'/>
<rdf:Description rdf:about="&a;200715260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pronounce with a trill, of the phoneme \r\; "Some spekaers trill their r''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200715399"
	 b:glossaryEntry="pronounce with an initial sibilant"/>
<rdf:Description rdf:about="&a;200715499"
	 b:glossaryEntry="pronounce with a flap, of alveolar sounds"/>
<rdf:Description rdf:about="&a;200715602">
	<b:glossaryEntry>cause to burst as a result of air pressure; of stop consonants like /p/, /t/, and /k/</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200715752"
	 b:glossaryEntry='sing with closed lips; "She hummed a melody"'/>
<rdf:Description rdf:about="&a;200715865">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pronounce with a roll, of the phoneme /r/ "She rolls her r''s".]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200715989"
	 b:glossaryEntry='make a cackling sound; "The fire cackled cozily"'/>
<rdf:Description rdf:about="&a;200716101"
	 b:glossaryEntry='make a low continuous sound; "The refrigerator is humming"'/>
<rdf:Description rdf:about="&a;200716220"
	 b:glossaryEntry="squawk shrilly and loudly, characteristic of hens"/>
<rdf:Description rdf:about="&a;200716351">
	<b:glossaryEntry>talk or utter in a cackling manner; "Hello!," the women cackled when they saw the movie star step out of the limousine.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200716550"
	 b:glossaryEntry='cackle like a goose "Cackling geese"'/>
<rdf:Description rdf:about="&a;200716650"
	 b:glossaryEntry="respond to the reins, as of horses"/>
<rdf:Description rdf:about="&a;200716748">
	<b:glossaryEntry>interfere with or prevent the reception of signals; "Jam the Voice of America"; "block the signals emitted by this station"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200716948">
	<b:glossaryEntry>make less severe or harsh; "He moderated his tone when the students burst out in tears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200717118">
	<b:glossaryEntry>make crunching noises; "his shoes wre crunching on the gravel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200717283"
	 b:glossaryEntry="make a gurgling sound, characteristic of turkeys"/>
<rdf:Description rdf:about="&a;200717396"
	 b:glossaryEntry="make or write comment to make a comment on"/>
<rdf:Description rdf:about="&a;200717603"
	 b:glossaryEntry="make a comment, usually ironic"/>
<rdf:Description rdf:about="&a;200717701"
	 b:glossaryEntry="make unwanted and intrusive comments"/>
<rdf:Description rdf:about="&a;200717811"
	 b:glossaryEntry="acknowledge the presence of or acquaintance with"/>
<rdf:Description rdf:about="&a;200717937"
	 b:glossaryEntry='refuse to acknowledge; "She cut him dead at the meeting"'/>
<rdf:Description rdf:about="&a;200718098"
	 b:glossaryEntry="characteristic of horses"/>
<rdf:Description rdf:about="&a;200718213"
	 b:glossaryEntry="utter with gargling or burbling sounds"/>
<rdf:Description rdf:about="&a;200718315"
	 b:glossaryEntry="utter a cry, characteristic of crows, rooks, or ravens"/>
<rdf:Description rdf:about="&a;200718430"
	 b:glossaryEntry="utter a high-pitched cry, as of seagulls"/>
<rdf:Description rdf:about="&a;200718531">
	<b:glossaryEntry>convey or communicate; of a smile, a look, a physical gesture; "Throw a glance"; "She gave me a dirty look"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200718708">
	<b:glossaryEntry xml:space='preserve'><![CDATA[convey, as of a compliment, regards, attention, etc.; bestow; "Don''t pay him any mind"; "give the orders"; "Give him my best regards"; "pay attention"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200718960"
	 b:glossaryEntry='bestow; "give hommage"'/>
<rdf:Description rdf:about="&a;200719071"
	 b:glossaryEntry="utter catcalls at"/>
<rdf:Description rdf:about="&a;200719161">
	<b:glossaryEntry>serve as a means for expressing something: "The painting of Mary carries motherly love"; "His voice carried a lot af anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200719410">
	<b:glossaryEntry>pass on a communication: "The news was carried to every village in the province"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200719571">
	<b:glossaryEntry>indicate through a symbol, formula, etc.; "Can you express this distance in kilometers?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200719776"
	 b:glossaryEntry='utter "haw"'/>
<rdf:Description rdf:about="&a;200719849"
	 b:glossaryEntry='utter "hem" or "ahem"'/>
<rdf:Description rdf:about="&a;200719931">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter ''hems'' and ''haws''; indicated hesitation; "He hemmed and hawed when asked to address the crowd"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200720100"
	 b:glossaryEntry="pledge without delivery or title of possession"/>
<rdf:Description rdf:about="&a;200720215"
	 b:glossaryEntry="attack strongly"/>
<rdf:Description rdf:about="&a;200720303"
	 b:glossaryEntry="as of a verdict, by a jury"/>
<rdf:Description rdf:about="&a;200720420">
	<b:glossaryEntry>establish as the highest level or best performance: "set a record"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200720562">
	<b:glossaryEntry>transfer; "The spy sent the classified information off to Russia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200720710">
	<b:glossaryEntry>send a message or attempt to reach someone by radio, phone, etc.; make a signal to in order to transmit a message; "Hawaii is calling!"; "A transmitter in Hawaii was heard calling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200721002"
	 b:glossaryEntry="bring out an an official document,such as a warrant"/>
<rdf:Description rdf:about="&a;200721124">
	<b:glossaryEntry>determine (what is to happen in certain contingencies), esp. by including a proviso condition; "The will provides that each child should receive half of the money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200721361">
	<b:glossaryEntry>communicate the intended meaning or impression; "He came across very clearly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200721528">
	<b:glossaryEntry>request the participation or presence of; "The organizers invite submissions of papers for the conference"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200721709">
	<b:glossaryEntry xml:space='preserve'><![CDATA[communicate; "I''d like to share this idea with you"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200721823"
	 b:glossaryEntry="express contempt about"/>
<rdf:Description rdf:about="&a;200721912">
	<b:glossaryEntry>discuss vehemently in order to reach a solution or an agreement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200722064"
	 b:glossaryEntry="utter a hoarse sound, like a raven"/>
<rdf:Description rdf:about="&a;200722169"
	 b:glossaryEntry="place under a spell"/>
<rdf:Description rdf:about="&a;200722269"
	 b:glossaryEntry="release from a spell"/>
<rdf:Description rdf:about="&a;200722372">
	<b:glossaryEntry>make out and issue; "write out a check"; "cut a ticket"; "Please make the check out to me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200722572"
	 b:glossaryEntry="write out a check on a bank account"/>
<rdf:Description rdf:about="&a;200722670">
	<b:glossaryEntry>bring before the public for the first time, as of an actor, song, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200722828">
	<b:glossaryEntry>praise extravagantly; "The critics puffed up this Brodaway production"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200722994"
	 b:glossaryEntry="state by way of explanation"/>
<rdf:Description rdf:about="&a;200723086">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter meaningless sounds, like a baby, or utter in an incoherent way; "The old man is only babbling--don''t pay attention"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200723279">
	<b:glossaryEntry>maintain by writing regular records; "keep a diary"; "maintain a record"; "keep notes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200723438">
	<b:glossaryEntry xml:space='preserve'><![CDATA[communicate with a place or person; establish communication with, as if by telephone: "Bill called this number and he got Mary"; "The operator couldn''t get Kobe because of the earthquake"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200723694">
	<b:glossaryEntry>consider and reconsider carefully; "Think twice before you have a child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200723835">
	<b:glossaryEntry>present somebody with something, usually to accuse or criticize; ""We confronted him with the evidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200724019">
	<b:glossaryEntry>utter monotonously and repetitively and rhythmically; "The students chanted the same slogan over and over again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200724203">
	<b:glossaryEntry xml:space='preserve'><![CDATA[utter or make a noise, as when swallowing too quickly; "`Help,''" he gulped.]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200724340">
	<b:glossaryEntry>express a threat either by an utterance or a gesture; "he menaced the bank manager with a stick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200724508">
	<b:glossaryEntry>express with a beaming face or smile: "he beamed his approval"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200724640"
	 b:glossaryEntry='express with a smile: "She smiled her thanks"'/>
<rdf:Description rdf:about="&a;200724756">
	<b:glossaryEntry>utter with force; utter vehemently; "hurl insults"; "throw accusations at someone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200724908"
	 b:glossaryEntry='to make melodious sounds; "The nightingale was singing"'/>
<rdf:Description rdf:about="&a;200725051"
	 b:glossaryEntry='read aloud to check for omissions or absentees; "Call roll"'/>
<rdf:Description rdf:about="&a;200725173">
	<b:glossaryEntry>bring to public notice by writing, with praise or condemnation; "The New York Times wrote him up last week"; "Did your boss write you up?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200725401">
	<b:glossaryEntry>deny formally (an allegation of fact by the opposing party) in a legal suit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200725531">
	<b:glossaryEntry>make a request of or for: "ask money for the church"; "ask a favor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200725677">
	<b:glossaryEntry>require or ask for as a price or condition; "He is asking $200 for the table"; "The kidnapers are asking a million dollars in return for the release of their hostage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200725904">
	<b:glossaryEntry>indicate a decision in regard to (sports): "call balls and strikes behind the plate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200726068"
	 b:glossaryEntry="summon to court"/>
<rdf:Description rdf:about="&a;200726173"
	 b:glossaryEntry="lay legal claim to"/>
<rdf:Description rdf:about="&a;200726273">
	<b:glossaryEntry>join for the purpose of communication; "Operator, could you connect me to the Raffles in Singapore?"</b:glossaryEntry>
</rdf:Description>
