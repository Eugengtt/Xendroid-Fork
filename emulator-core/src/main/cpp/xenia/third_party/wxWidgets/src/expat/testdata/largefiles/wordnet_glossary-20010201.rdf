</rdf:Description>
<rdf:Description rdf:about="&a;102130146"
	 b:glossaryEntry="type genus of the Acipenseridae: sturgeons"/>
<rdf:Description rdf:about="&a;102130319">
	<b:glossaryEntry>food and game fish of marine and fresh waters of northwestern coast of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102130550">
	<b:glossaryEntry>valuable source of caviar and isinglass; found in Black and Caspian seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102130756"
	 b:glossaryEntry="comprises the genus Lepisosteus"/>
<rdf:Description rdf:about="&a;102130908"
	 b:glossaryEntry="type genus of the Lepisosteidae: freshwater gars"/>
