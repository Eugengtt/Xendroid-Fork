	 b:glossaryEntry="largest carnivorous land animals ever known"/>
<rdf:Description rdf:about="&a;101234135"
	 b:glossaryEntry="large carnivorous bipedal dinosaur having huge claws"/>
<rdf:Description rdf:about="&a;101234262"
	 b:glossaryEntry="includes a single species"/>
