	 b:glossaryEntry="a harsh mixture of sounds"/>
<rdf:Description rdf:about="&a;103895511"
	 b:glossaryEntry="a lack of harmony"/>
<rdf:Description rdf:about="&a;103895604"
	 b:glossaryEntry="loud confusing disagreeable sounds"/>
<rdf:Description rdf:about="&a;103895694"
	 b:glossaryEntry="the property of being noisy and lively and unrestrained"/>
<rdf:Description rdf:about="&a;103895810">
	<b:glossaryEntry>the property of sound that varies with variation in the frequency of vibration</b:glossaryEntry>
</rdf:Description>
