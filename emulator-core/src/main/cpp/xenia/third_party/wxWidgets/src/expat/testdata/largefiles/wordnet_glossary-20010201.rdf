</rdf:Description>
<rdf:Description rdf:about="&a;101896238">
	<b:glossaryEntry>any of various cud-chewing hoofed mammals having a stomach divided into four (occasionally three) compartments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101896624">
