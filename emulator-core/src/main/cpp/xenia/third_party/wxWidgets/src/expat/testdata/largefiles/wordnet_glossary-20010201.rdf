	 b:glossaryEntry="early archosaurian carnivore"/>
<rdf:Description rdf:about="&a;101216926"
	 b:glossaryEntry="early archosaurian carnivore"/>
<rdf:Description rdf:about="&a;101217057"
	 b:glossaryEntry="crocodiles; alligators; caimans; gavials"/>
