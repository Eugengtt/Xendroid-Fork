<rdf:Description rdf:about="&a;200994067">
	<b:glossaryEntry>move to a rearward position; pull towards the back; "Pull back your arms!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200994232"
	 b:glossaryEntry='draw a limb towards the body; "adduct the thight muscle"'/>
<rdf:Description rdf:about="&a;200994370"
	 b:glossaryEntry="pull away from the body, of muscles"/>
<rdf:Description rdf:about="&a;200994488">
	<b:glossaryEntry>pull in opposite directions; "During the Inquisition, the torturers would stretch their victims on a rack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200994693">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be flexible under stress of physical force; "This material doesn''t give"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200994853">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move while supporting, either in a vehicle or in one''s hands or on one''s body; "You must carry your camping gear"; "carry the suitcases to the car"; "This train is carrying nuclear waste"; "These pipes carry waste water into the river"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200995437">
	<b:glossaryEntry xml:space='preserve'><![CDATA[carry, as on one''s back; "Pack your tents to the top of the mountain"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200995576">
	<b:glossaryEntry>carry someone against his will upside down such that each limb is held by one person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200995727"
	 b:glossaryEntry="transport something in a cart"/>
<rdf:Description rdf:about="&a;200995825">
	<b:glossaryEntry>take away by means of a vehicle; "They carted off the old furniture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200996002">
	<b:glossaryEntry>transport by aeroplane; "We fly flowers from the Carribean to North America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200996181">
	<b:glossaryEntry>fly people or goods to or from places not accessible by other means: "Food is airlifted into Bosnia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200996361"
	 b:glossaryEntry="transport, as in a truck"/>
<rdf:Description rdf:about="&a;200996507">
	<b:glossaryEntry>pull lightly but sharply with a plucking motion, as of guitar strings; "he plucked the strings of his mandolin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200996730"
	 b:glossaryEntry='pluck, as a string of an instrument; "He twanged his bow"'/>
<rdf:Description rdf:about="&a;200996850">
	<b:glossaryEntry>pull hard; "The prisoner tugged at the chains"; "This movie tugs at the heart strings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200997005"
	 b:glossaryEntry='pull or strain hard at; "Each oar was tugged by several men"'/>
<rdf:Description rdf:about="&a;200997134">
	<b:glossaryEntry>move by pulling hard: "The horse finally tugged the cart out of the mud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200997275">
	<b:glossaryEntry>pull, as against a resistance; "The sleigh was drawn by four reindeer"; "These worries were dragging at him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200997523">
	<b:glossaryEntry>pull along heavily, like a heavy load against a resistance; "Can you shlep this bag of potatoes upstairs?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200997740"
	 b:glossaryEntry="drag loosely along a surface; allow to sweep the ground"/>
<rdf:Description rdf:about="&a;200997858">
	<b:glossaryEntry xml:space='preserve'><![CDATA[carry with difficulty; "You''ll have to lug this suitcase"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200997989"
	 b:glossaryEntry='drag behind; "Horses used to tow barges along the canal"'/>
<rdf:Description rdf:about="&a;200998158"
	 b:glossaryEntry="drag heavily or wearily, as of the body"/>
<rdf:Description rdf:about="&a;200998260">
	<b:glossaryEntry>tow (a vessel) with a tug; "The tugboat tugged the freighter into the harbor"</b:glossaryEntry>
