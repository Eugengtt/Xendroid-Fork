<rdf:Description rdf:about="&a;400282969"
	 b:glossaryEntry="without compatibility"/>
<rdf:Description rdf:about="&a;400283067">
	<b:glossaryEntry>in a self-satisfied manner; "he complacently lived out his life as a village school teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400283218">
	<b:glossaryEntry>without complaining; "an equally gallant little wife and mother uncomplainingly keeping up the production of tasty and nourishing meals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400283434">
	<b:glossaryEntry>with complaints; "she did her work, but she did so complainingly"</b:glossaryEntry>
