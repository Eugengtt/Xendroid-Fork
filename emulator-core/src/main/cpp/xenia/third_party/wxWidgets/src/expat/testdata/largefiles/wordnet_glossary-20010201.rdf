	 b:glossaryEntry='break partially but keep its integrity; "The glass cracked"'/>
<rdf:Description rdf:about="&a;200233548">
	<b:glossaryEntry>crack due to dehydration, as of skin or lips; "My lips chap in this dry weather"</b:glossaryEntry>
</rdf:Description>
