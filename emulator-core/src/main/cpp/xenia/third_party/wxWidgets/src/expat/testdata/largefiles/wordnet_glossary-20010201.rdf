	<b:glossaryEntry>yellow transparent exudate of the balsam fir; used as a transparent cement in optical devices (especially in microscopy) and as a mounting medium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110688476"
	 b:glossaryEntry="obtained from conifers (especially pines)"/>
<rdf:Description rdf:about="&a;110688628"
	 b:glossaryEntry="a turpentine exuded by the terebinth"/>
<rdf:Description rdf:about="&a;110688727"
	 b:glossaryEntry="an oleoresin used in varnishes and ointments"/>
<rdf:Description rdf:about="&a;110688858"
	 b:glossaryEntry="a mixture of resin and gum"/>
<rdf:Description rdf:about="&a;110689066"
	 b:glossaryEntry="gum resin used especially in treating skin irritation"/>
<rdf:Description rdf:about="&a;110689226">
	<b:glossaryEntry>a colorless oily compound extracted from coal tar and used in manufacturing synthetic resins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110689398"
	 b:glossaryEntry="aromatic gum resin; similar to myrrh"/>
<rdf:Description rdf:about="&a;110689489"
	 b:glossaryEntry="a gum resin used as a yellow pigment and a purgative"/>
<rdf:Description rdf:about="&a;110689595"
	 b:glossaryEntry="aromatic resin used in perfume and incense"/>
<rdf:Description rdf:about="&a;110689735">
	<b:glossaryEntry>any of various substances (soluble in water) that exude from certain plants; they are gelatinous when moist but harden on drying</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110690417">
	<b:glossaryEntry>(bacteriology) a nutrient substance (solid or liquid) that is used to cultivate micro-organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110690600">
