	<b:glossaryEntry>young Atlantic cod or haddock esp. one split and boned for cooking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102016524"
	 b:glossaryEntry="haddock"/>
<rdf:Description rdf:about="&a;102016651">
