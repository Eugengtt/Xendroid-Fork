</rdf:Description>
<rdf:Description rdf:about="&a;200792585">
	<b:glossaryEntry xml:space='preserve'><![CDATA[use to the utmost; exert vigorously or to full capacity; "He really extended himself when he climbed Kilimanjaro"; "Don''t strain your mind too much"]]></b:glossaryEntry>
