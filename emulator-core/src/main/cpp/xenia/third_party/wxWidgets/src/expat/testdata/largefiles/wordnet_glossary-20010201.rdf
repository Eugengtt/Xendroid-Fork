</rdf:Description>
<rdf:Description rdf:about="&a;101162583">
	<b:glossaryEntry>wide-ranging light-brown frog of moist North American woodlands esp. spruce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101162749">
