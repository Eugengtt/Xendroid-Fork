</rdf:Description>
<rdf:Description rdf:about="&a;101933789"
	 b:glossaryEntry="llamas"/>
<rdf:Description rdf:about="&a;101933935">
	<b:glossaryEntry>used in the Andes as a beast of burden and source of wool; considered a domesticated variety of the guanaco</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101934137"
	 b:glossaryEntry="wild llama"/>
<rdf:Description rdf:about="&a;101934236">
	<b:glossaryEntry>domesticated llama with long silky fleece; believed to be a domesticated variety of the guanaco</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101934416"
	 b:glossaryEntry="a genus of Camelidae"/>
<rdf:Description rdf:about="&a;101934544">
	<b:glossaryEntry>small wild cud-chewing Andean animal similar to the guanaco but smaller; valued for its fleecy undercoat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101934738"
	 b:glossaryEntry="giraffes"/>
<rdf:Description rdf:about="&a;101934861"
	 b:glossaryEntry="type genus of the Giraffidae"/>
<rdf:Description rdf:about="&a;101934997">
	<b:glossaryEntry>tallest living quadruped; having a spotted coat and small horns and very long neck and legs; of savannahs of tropical Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101935250"
	 b:glossaryEntry="okapis"/>
<rdf:Description rdf:about="&a;101935362">
