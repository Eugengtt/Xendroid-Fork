	<b:glossaryEntry>mining valuable minerals from a placer by washing or dredging</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100592401"
	 b:glossaryEntry="the mining of ore or coal from an open mine"/>
<rdf:Description rdf:about="&a;100592521">
	<b:glossaryEntry>the extraction of building stone or slate from an open surface quarry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100592646">
	<b:glossaryEntry>the act of drilling a hole in the earth in the hope of producing petroleum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100592801">
	<b:glossaryEntry>the organized action of making of goods and services for sale; "American industry is making increased use of computers to control production"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100593063"
	 b:glossaryEntry="the development of industry on an extensive scale"/>
<rdf:Description rdf:about="&a;100593220">
	<b:glossaryEntry>the act that results in something coming to be; "the devising of plans"; "the fashioning of pots and pans"; "the making of measurements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100593451"
	 b:glossaryEntry="the making of maps and charts"/>
<rdf:Description rdf:about="&a;100593550"
	 b:glossaryEntry="the act of making something (a product) from raw materials"/>
<rdf:Description rdf:about="&a;100593716"
	 b:glossaryEntry="the fabrication of something in a particular shape"/>
<rdf:Description rdf:about="&a;100593886"
	 b:glossaryEntry="shaping metal by heating and hammering"/>
<rdf:Description rdf:about="&a;100593978">
	<b:glossaryEntry>the activity of making things out of metal in a skillful manner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100594112">
	<b:glossaryEntry>the cutting of spiral grooves on the inside of the barrel of a firearm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100594247">
	<b:glossaryEntry>the manufacture of sections of a building at the factory so they can be easily and rapidly assembled at the building site</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100594429">
	<b:glossaryEntry>the act of creating something by compounding or mixing raw materials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100594567"
	 b:glossaryEntry="bonding thin sheets together"/>
<rdf:Description rdf:about="&a;100594670"
	 b:glossaryEntry="the act of applying veneer"/>
<rdf:Description rdf:about="&a;100594752"
	 b:glossaryEntry="the act of creating something by thinking"/>
<rdf:Description rdf:about="&a;100594989">
	<b:glossaryEntry>the act of working out the form of something (as by making a sketch or outline or plan); "he contributed to the design of a new instrument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100595211">
	<b:glossaryEntry>the act or process of drawing up plans or layouts for some project or enterprise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100595364">
	<b:glossaryEntry>determining and drawing up plans for the future physical arrangement and condition of a community</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100595573">
	<b:glossaryEntry>dividing an area into zones or sections reserved for different purposes such as residence and business and manufacturing etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100595769">
	<b:glossaryEntry>creating a sequence of instructions to enable the computer to do something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100595942">
	<b:glossaryEntry>creating a program that enables the computer to reason logically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100596070"
	 b:glossaryEntry="creating something by the use of speech and language"/>
<rdf:Description rdf:about="&a;100596202">
	<b:glossaryEntry>the act of creating written works; "writing was a form of therapy for him"; "it was a matter of disputed authorship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100596517"
	 b:glossaryEntry="writing a first version to be filled out and polished later"/>
<rdf:Description rdf:about="&a;100596631"
	 b:glossaryEntry="writing in a fictional form"/>
<rdf:Description rdf:about="&a;100596754"
	 b:glossaryEntry="converting something into the form of a novel"/>
<rdf:Description rdf:about="&a;100596873"
	 b:glossaryEntry="the act of putting something in writing"/>
<rdf:Description rdf:about="&a;100596968"
	 b:glossaryEntry="the act of writing dictionaries"/>
<rdf:Description rdf:about="&a;100597058"
	 b:glossaryEntry="making real or giving the appearance of reality"/>
<rdf:Description rdf:about="&a;100597227"
	 b:glossaryEntry="representing as an object"/>
<rdf:Description rdf:about="&a;100597368"
	 b:glossaryEntry="embodying in an outward form"/>
<rdf:Description rdf:about="&a;100597512"
	 b:glossaryEntry="regarding something abstract as a material thing"/>
<rdf:Description rdf:about="&a;100597654"
	 b:glossaryEntry="giving concrete form to an abstract concept"/>
<rdf:Description rdf:about="&a;100597790"
	 b:glossaryEntry='the human embodiment of something; "the soul of honor"'/>
<rdf:Description rdf:about="&a;100597895">
	<b:glossaryEntry>the act of attributing human characteristics to abstract ideas etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100598038">
	<b:glossaryEntry>the creation of beautiful or significant things; "he was a patron of art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100598347"
	 b:glossaryEntry="the art of making and decorating pottery"/>
<rdf:Description rdf:about="&a;100598442">
	<b:glossaryEntry>the art of transfering designs from specially prepared paper to a wood or glass or metal surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100598605">
	<b:glossaryEntry>the creation of artistic drawings; "he learned drawing from his father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100598775"
	 b:glossaryEntry="carving or engraving esp. on stones"/>
<rdf:Description rdf:about="&a;100598869">
	<b:glossaryEntry>making a picture with paints; "he studied painting and sculpture for many years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100599058">
	<b:glossaryEntry>a durable method of painting on a wall by using watercolors on wet plaster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100599185">
	<b:glossaryEntry>painting that applies the pigment thickly so that brush or palette knife marks are visible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100599329">
	<b:glossaryEntry>artistic design and manufacture of prints as woodcuts or silkscreens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100599509"
	 b:glossaryEntry="making figures or designs in three dimensions"/>
<rdf:Description rdf:about="&a;100599638">
	<b:glossaryEntry>a preliminary sculpture in wax or clay from which a finished work can be copied</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100599811"
	 b:glossaryEntry="making decorative shapes by trimming shrubs or trees"/>
<rdf:Description rdf:about="&a;100599917"
	 b:glossaryEntry="molding artificial teeth using low-fusing metals or alloys"/>
<rdf:Description rdf:about="&a;100600032"
	 b:glossaryEntry="the act of drawing a plan or diagram or outline"/>
<rdf:Description rdf:about="&a;100600133"
	 b:glossaryEntry="the act of painting with oil paints"/>
<rdf:Description rdf:about="&a;100600227">
	<b:glossaryEntry>making engraved or etched plates and printing designs from them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100600392"
	 b:glossaryEntry="the act of engraving on a steel plate"/>
<rdf:Description rdf:about="&a;100600491">
	<b:glossaryEntry>a method of etching that imitates the broad washes of a water color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100600613"
	 b:glossaryEntry="the act of making a print by the silk-screen method"/>
<rdf:Description rdf:about="&a;100600721"
	 b:glossaryEntry="the act of making a lithographic print"/>
<rdf:Description rdf:about="&a;100600817"
	 b:glossaryEntry="musical creation"/>
<rdf:Description rdf:about="&a;100600921"
	 b:glossaryEntry="the act of arranging a piece of music"/>
<rdf:Description rdf:about="&a;100601046"
	 b:glossaryEntry="the act of arranging a piece of music for an orchestra"/>
<rdf:Description rdf:about="&a;100601160"
	 b:glossaryEntry="the act of inventing"/>
<rdf:Description rdf:about="&a;100601272"
	 b:glossaryEntry="the act of inventing a word or phrase"/>
<rdf:Description rdf:about="&a;100601385"
	 b:glossaryEntry="the act of devising something"/>
<rdf:Description rdf:about="&a;100601482"
	 b:glossaryEntry="the act of formulation something"/>
<rdf:Description rdf:about="&a;100601680">
	<b:glossaryEntry>a formulation adopted in tackling a problem; "his approach to every problem is to draw up a list of pros and cons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100601893">
	<b:glossaryEntry>formulation of the plans and important details; "the framing of judicial decrees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100602028">
	<b:glossaryEntry>a line of approach; "they explored every avenue they could think of"; "it promises to open new avenues to understanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100602201"
	 b:glossaryEntry="the act of creating by removing something"/>
<rdf:Description rdf:about="&a;100602398">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of digging; "there''s an interesting excavation going on near Princeton"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100602550"
	 b:glossaryEntry="cutting away parts to create a desired shape"/>
<rdf:Description rdf:about="&a;100602658"
	 b:glossaryEntry="the act of drilling"/>
<rdf:Description rdf:about="&a;100602741"
	 b:glossaryEntry="the act of gouging"/>
<rdf:Description rdf:about="&a;100602811"
	 b:glossaryEntry="the act of puncturing or perforating"/>
<rdf:Description rdf:about="&a;100602969">
	<b:glossaryEntry>(surgery) the act of puncturing a body cavity or organ with a hollow needle in order to draw out fluid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100603216"
	 b:glossaryEntry="centesis of the belly to remove fluid for diagnosis"/>
<rdf:Description rdf:about="&a;100603345">
	<b:glossaryEntry>extraction of amniotic fluid from a pregnant woman (after the 15th week of pregnancy) to aid in the diagnosis of fetal abnormalities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100603537"
	 b:glossaryEntry="removal of fluid from a joint by centesis"/>
<rdf:Description rdf:about="&a;100603639"
	 b:glossaryEntry="removal of fluid from the abdomen by centesis"/>
<rdf:Description rdf:about="&a;100603744">
	<b:glossaryEntry>removal of fluid from the subarachnoid space of the lumbar region of the spinal cord for diagnostic or therapeutic purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100603960">
	<b:glossaryEntry>the act of punching a role of holes (as for ease of separation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100604081"
	 b:glossaryEntry="the act of puncturing with a small point"/>
<rdf:Description rdf:about="&a;100604176">
	<b:glossaryEntry>the activity of selecting the scenes to be shown and putting them together to create a film</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100604336">
	<b:glossaryEntry>the activity of looking thoroughly in order to find something or someone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100604652">
	<b:glossaryEntry>searching for underground water or minerals by using a dowsing rod</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100604772"
	 b:glossaryEntry="a careful systematic search"/>
<rdf:Description rdf:about="&a;100604875"
	 b:glossaryEntry="the act of searching for food and provisions"/>
<rdf:Description rdf:about="&a;100604983"
	 b:glossaryEntry="the act of searching someone for concealed weapons"/>
<rdf:Description rdf:about="&a;100605096"
	 b:glossaryEntry="the act of searching visually"/>
<rdf:Description rdf:about="&a;100605193">
	<b:glossaryEntry>an organized search (by police) for a person (charged with a crime)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100605314"
	 b:glossaryEntry='the act of searching for something; "a quest for diamonds"'/>
<rdf:Description rdf:about="&a;100605434">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a thorough search for something (often causing disorder or confusion); "he gave the attic a good rummage but couldn''t find his skis"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100605643"
	 b:glossaryEntry="an exploratory action or expedition"/>
<rdf:Description rdf:about="&a;100605730"
	 b:glossaryEntry='the act of using; "the steps were worn from years of use"'/>
<rdf:Description rdf:about="&a;100606005"
	 b:glossaryEntry='utilization or exercise; "the play of the imagination"'/>
<rdf:Description rdf:about="&a;100606110"
	 b:glossaryEntry="improper or excessive use"/>
<rdf:Description rdf:about="&a;100606214"
	 b:glossaryEntry="excessive use of drugs"/>
<rdf:Description rdf:about="&a;100606337"
	 b:glossaryEntry="excessive use of alcohol and alcoholic drinks"/>
<rdf:Description rdf:about="&a;100606479">
	<b:glossaryEntry>the act of making some area of land or water more profitable or productive or useful: "the development of Alaskan resources"; "the exploitation of copper deposits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100606823"
	 b:glossaryEntry="making an area of land more useful"/>
<rdf:Description rdf:about="&a;100606920"
	 b:glossaryEntry="making an area of water more useful"/>
<rdf:Description rdf:about="&a;100607051">
	<b:glossaryEntry>the act of processing used or abandoned materials for use in creating new products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100607207"
	 b:glossaryEntry="collecting bottles for reuse"/>
<rdf:Description rdf:about="&a;100607299">
	<b:glossaryEntry>the act of bringing something to bear; using it for a particular purpose; "he advocated the application of statistics to the problem"; "a novel application of electronics to medical diagnosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100607608"
	 b:glossaryEntry="wrong use or application"/>
<rdf:Description rdf:about="&a;100607693"
	 b:glossaryEntry="the practical application of science to commerce or industry"/>
<rdf:Description rdf:about="&a;100607950"
	 b:glossaryEntry="the activity of designing and constructing aircraft"/>
<rdf:Description rdf:about="&a;100608072"
	 b:glossaryEntry="the activity of designing and constructing automobiles"/>
<rdf:Description rdf:about="&a;100608219">
	<b:glossaryEntry>the activity of applying chemistry to the solution of practical problems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100608358">
	<b:glossaryEntry>the activity of designing and constructing and maintaining communication systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100608528">
	<b:glossaryEntry>the design and construction of communications technology that transmits information in digital form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100608707">
	<b:glossaryEntry>the activity of designing and constructing and programming computers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100608841">
	<b:glossaryEntry>the activity of designing and constructing and operating railroads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100608987">
	<b:glossaryEntry>high-speed rail technology; train is suspended on a magnetic cushion above a magnetized track and so travels free of friction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100609178"
	 b:glossaryEntry="exploitation to the point of diminishing returns"/>
<rdf:Description rdf:about="&a;100609335"
	 b:glossaryEntry="the act of capitalizing on an opportunity"/>
<rdf:Description rdf:about="&a;100609454"
	 b:glossaryEntry="the act of commercializing something"/>
<rdf:Description rdf:about="&a;100609574">
	<b:glossaryEntry>an estimation of the value of a business on the basis of its earnings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100609704">
	<b:glossaryEntry>the act of providing electricity; "the electrification of rural Tennessee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100609840"
	 b:glossaryEntry='a military engagement; "he saw action in Korea"'/>
<rdf:Description rdf:about="&a;100610138">
	<b:glossaryEntry>a war whose objective is less than the unconditional defeat of the enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100610268">
	<b:glossaryEntry>the use of psychological tactics to destroy the opponents'' morale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100610417">
	<b:glossaryEntry>a hostile meeting of opposing military forces in the course of a war; "Grant won a decisive victory in the battle of Chickamauga"; "he lost his romantic ideas about war when he got into a real engagement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100610851">
	<b:glossaryEntry>a war measure that isolates some area of importance to the enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100611021">
	<b:glossaryEntry>military action or resources protecting a country against potential enemies; "they died in the defense of Stalingrad"; "they were developed for the defense program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100611413">
	<b:glossaryEntry>military action involving the use of electromagnetic energy to determine or exploit or reduce or prevent hostile use of the electromagnetic spectrum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100611703">
	<b:glossaryEntry>a military or naval action (as a maneuver or campaign); "it was a joint operation of the navy and air force"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100612083">
	<b:glossaryEntry>a local military action without declaration of war; against violators of international peace and order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100612245">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the military action of resisting the enemy''s advance; "the enemy offered little resistance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100612393">
	<b:glossaryEntry>the ostentatious display of military power (with the implied threat that it might be used)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100612561">
	<b:glossaryEntry>any catastrophically destructive battle; "they called the first World War an Armageddon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100612706">
	<b:glossaryEntry>a fierce battle fought in close combat between troops in predetermined positions at a chosen time and place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100614512"
	 b:glossaryEntry="a pitched battle between naval fleets"/>
<rdf:Description rdf:about="&a;100614914">
	<b:glossaryEntry>an open clash between two opposing groups (or individuals); "the harder the conflict the more glorious the triumph"--Thomas Paine; "police tried to control the battle between the pro- and anti-abortion mobs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100615322"
	 b:glossaryEntry="a minor short-term fight"/>
<rdf:Description rdf:about="&a;100615447">
	<b:glossaryEntry>an awkward clash; "he tried to smooth over his contretemps with the policeman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100615583">
	<b:glossaryEntry>conflict between social or economic classes (especially between the capitalist and proletariat classes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100615775"
	 b:glossaryEntry="a military training exercise"/>
<rdf:Description rdf:about="&a;100615920">
	<b:glossaryEntry>defensive measures designed to destroy attacking enemy aircraft or missiles or to nullify their effectiveness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100616123">
	<b:glossaryEntry>air defense by the use aircraft or missiles or artillery or electronic countermeasures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100616274">
	<b:glossaryEntry>air defense by the use of deception or dispersion or protective construction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100616416">
	<b:glossaryEntry>activities organized by civilians for their own protection in time of war or disaster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100616579">
	<b:glossaryEntry>a defensive effort; "the army made a final stand at the Rhone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100616711"
	 b:glossaryEntry="a successful stand"/>
<rdf:Description rdf:about="&a;100616808">
	<b:glossaryEntry>a defense organized while in contact with the enemy or when time is limited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100616959">
	<b:glossaryEntry>a defensive organized before contact is made with the enemy and while time for organization is available; usually includes a fortified zone (with pillboxes) and communication systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100617245"
	 b:glossaryEntry="the act of fortifying or strengthening defenses"/>
<rdf:Description rdf:about="&a;100617368">
	<b:glossaryEntry>procedures involved in taking defensive measures against attacks using chemical agents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100617536">
	<b:glossaryEntry>laying explosive mines in concealed places to destroy enemy personnel and equipment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100617685">
	<b:glossaryEntry>organized opposition to authority; a conflict in which one faction tries to wrest control from another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100617941"
	 b:glossaryEntry="a war between factions in the same country"/>
<rdf:Description rdf:about="&a;100618075"
	 b:glossaryEntry="the overthrow of a government by those who are governed"/>
<rdf:Description rdf:about="&a;100618313">
	<b:glossaryEntry>a revolution whose aim is to reverse the changes introduced by a previous revolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100618461">
	<b:glossaryEntry>an organized rebellion aimed at overthrowing a constituted government through the use of subversion and armed conflict</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100618654"
	 b:glossaryEntry="actions taken by a government to defeat insurgency"/>
<rdf:Description rdf:about="&a;100618768">
	<b:glossaryEntry>open rebellion against constituted authority (especially by seamen or soldiers against their officers)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100618923">
	<b:glossaryEntry>(English history) a widespread rebellion in 1381 against poll taxes and other inequities that oppressed the poorer people of England; suppressed by Richard II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100619159"
	 b:glossaryEntry="an engagement fought between two military forces"/>
<rdf:Description rdf:about="&a;100619330"
	 b:glossaryEntry='acts of overt warfare; "the outbreak of hostilities"'/>
<rdf:Description rdf:about="&a;100619453"
	 b:glossaryEntry="violent action that is hostile and usually unprovoked"/>
<rdf:Description rdf:about="&a;100619629">
	<b:glossaryEntry>any action resulting in injury or destruction; "the meat grinder of politics destroyed his reputation" or "allied forces crumbled before the Wehrmacht meat grinder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100619852">
	<b:glossaryEntry>an act of aggression (as one against a person who resists); "he may accomplish by craft in the long run what he cannot do by force and violence in the short one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100620094">
	<b:glossaryEntry>the act of stealing valuable things from a place; "the plundering of Rome"; "his plundering of the great authors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100620394"
	 b:glossaryEntry="the practice of plundering in gangs"/>
<rdf:Description rdf:about="&a;100620496"
	 b:glossaryEntry="the act of despoiling a country in warfare"/>
<rdf:Description rdf:about="&a;100620598"
	 b:glossaryEntry="the stealing of cattle"/>
<rdf:Description rdf:about="&a;100620675"
	 b:glossaryEntry="plundering during riots or in wartime"/>
<rdf:Description rdf:about="&a;100620776"
	 b:glossaryEntry="the act of stripping and taking by force"/>
<rdf:Description rdf:about="&a;100620923"
	 b:glossaryEntry="plundering with excessive damage and destruction"/>
<rdf:Description rdf:about="&a;100621040"
	 b:glossaryEntry="an act of plundering"/>
<rdf:Description rdf:about="&a;100621140">
	<b:glossaryEntry>warfare using chemical agents to kill or injure or incapacitate the enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100621298">
	<b:glossaryEntry>the use of bacteria or viruses of toxins to destroy men and animals or food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100621461"
	 b:glossaryEntry="defense against biological warfare"/>
<rdf:Description rdf:about="&a;100621581">
	<b:glossaryEntry>several related operations aimed at achieving a particular goal (usually within geographical and temporal constraints)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100621864">
	<b:glossaryEntry>a military campaign designed to achieve a specific objective in a foreign country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100622063">
	<b:glossaryEntry>any of the more or less continuous military expeditions in the 11-13th centuries when Christian powers of Europe tried to recapture the Holy Land from the Muslims</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100622405">
	<b:glossaryEntry>a Crusade from 1096 to 1099; captured Jerusalem and created a theocracy there</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100622542">
	<b:glossaryEntry>a Crusade from 1145 to 1147 that failed because of internal disagreements among the crusaders and led to the loss of Jerusalem in 1187</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100622737">
	<b:glossaryEntry>a Crusade from 1189 to 1192 led by Richard I of England and the king of France that failed because an army torn by dissensions and fighting on foreign soil could not succeed against forces united by religious zeal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100623010">
	<b:glossaryEntry>a Crusade from 1202 to 1204 that was diverted into a battle for Constantinople and failed to recapture Jerusalem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100623183">
	<b:glossaryEntry>a Crusade under papal control from 1218 to 1221 that achieved military victories but failed when dissension arose over accepting the terms they had been offered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100623403">
	<b:glossaryEntry>a Crusade from 1228 to 1229 led by the Holy Roman Emperor Frederick II who was therefore excommunicated by the Pope; by negotiation Frederick was able to crown himself king of Jerusalem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100623648">
	<b:glossaryEntry>a Crusade initiated in 1248 after the loss of Jerusalem in 1244 and and defeated in 1249</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100623798">
	<b:glossaryEntry>an operation conducted primarily by naval forces in order to gain or extend or maintain control of the sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100623965">
	<b:glossaryEntry>an operation that is assigned by a higher headquarters; "the planes were on a bombing mission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100624204"
	 b:glossaryEntry="a mission to capture or defend something"/>
<rdf:Description rdf:about="&a;100624305"
	 b:glossaryEntry="a mission to discover something"/>
<rdf:Description rdf:about="&a;100624397">
	<b:glossaryEntry>an operation developed for US troops in Vietnam; troops would move through a designated area destroying troops as they found them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100624599">
	<b:glossaryEntry>a military action in which besieged troops burst forth from their position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100624734">
	<b:glossaryEntry>a military operation (often involving new supplies of men and materiel) to strengthen a military force or aid in the performance of its mission; "they called for artillery support"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100625018">
	<b:glossaryEntry>close-in firing by one unit against an enemy engaged by another unit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100625146">
	<b:glossaryEntry>a mission requiring one force to support another specific force and authorizing it to answer directly the supported force''s request for assistance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100625353">
	<b:glossaryEntry>an amphibious operation conducted for the purpose of deceiving the enemy and leading him into a course of action unfavorable to him</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100625555"
	 b:glossaryEntry="an amphibious diversionary attack"/>
<rdf:Description rdf:about="&a;100625655"
	 b:glossaryEntry='the beginning of an offensive; "the attack began at dawn"'/>
<rdf:Description rdf:about="&a;100626011">
	<b:glossaryEntry>the waging of armed conflict against an enemy; "thousands of people were killed in the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100626813"
	 b:glossaryEntry="an attack by armed planes on a surface target"/>
<rdf:Description rdf:about="&a;100626926"
	 b:glossaryEntry="an attack by ground troops"/>
<rdf:Description rdf:about="&a;100627012"
	 b:glossaryEntry="close fighting during the culmination of a military attack"/>
<rdf:Description rdf:about="&a;100627161"
	 b:glossaryEntry="a direct and violent assault on a stronghold"/>
<rdf:Description rdf:about="&a;100627257">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a impetuous rush toward someone or something; "the wrestler''s charge carried him past his adversary"; "the battle began with a cavalry charge"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100627452">
	<b:glossaryEntry>a mass attack of troops without concern for casualties; originated by Japanese who accompanied it with yells of `banzai''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100627649">
	<b:glossaryEntry>an attack calculated to draw enemy defense away from the point of the principal attack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100627831"
	 b:glossaryEntry="an attack that penetrates into enemy territory"/>
<rdf:Description rdf:about="&a;100628019">
	<b:glossaryEntry>a rapid and violent military attack with intensive aerial bombardment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100628140"
	 b:glossaryEntry="a penetration of an enemy''s defense in depth and strength"/>
<rdf:Description rdf:about="&a;100628256">
	<b:glossaryEntry>(football) defensive players try to break through the offensive line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100628413">
	<b:glossaryEntry>(football) a play in which a defensive player is allowed to cross the line of scrimmage and then blocked off as the runner goes through the place the lineman vacated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100628646">
	<b:glossaryEntry>the act of invading; the act of an army that invades for conquest or plunder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100628795">
	<b:glossaryEntry>a process in which a military force moves as individuals (or small groups) through enemy positions without detection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100628970"
	 b:glossaryEntry="a sudden short attack"/>
<rdf:Description rdf:about="&a;100629095"
	 b:glossaryEntry="an invasion or hostile attack"/>
<rdf:Description rdf:about="&a;100629177"
	 b:glossaryEntry="a very rapid raid"/>
<rdf:Description rdf:about="&a;100629246">
	<b:glossaryEntry>an attack that is intended to seize or inflict damage on or destroy an objective; "the strike was scheduled to begin at dawn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100629424">
	<b:glossaryEntry>an attack by a defending force against an attacking enemy force in order to regain lost ground or cut off enemy advance units etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100629628"
	 b:glossaryEntry="an attack by dropping bombs"/>
<rdf:Description rdf:about="&a;100629741">
	<b:glossaryEntry>that part of the flight that begins with the approach to the target; includes target acquisition and ends with the release of the bombs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100629970">
	<b:glossaryEntry>a bombing run in which the bomber release the bomb while flying straight toward the target</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100630119">
	<b:glossaryEntry>a bombing run in which the bomber approaches the target at a low altitude and pulls up just before releasing the bomb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100630328">
	<b:glossaryEntry>a special case of loft bombing in which the bomb is released past the vertical so it is tossed back to the target</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100630513"
	 b:glossaryEntry="the action of attacking the enemy"/>
<rdf:Description rdf:about="&a;100630658">
	<b:glossaryEntry>a large scale offensive (more than a counterattack) undertaken by a defending force to seize the initiative from an attacking force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100630852"
	 b:glossaryEntry="the act of forcing the enemy to withdraw"/>
<rdf:Description rdf:about="&a;100630959"
	 b:glossaryEntry="a military operation by both land and sea forces"/>
<rdf:Description rdf:about="&a;100631128">
	<b:glossaryEntry>an amphibious operation attacking a land base that is carried out by troops that are landed by naval ships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100631461"
	 b:glossaryEntry="the act of collecting information"/>
<rdf:Description rdf:about="&a;100631580"
	 b:glossaryEntry="the operation of gathering information about an enemy"/>
<rdf:Description rdf:about="&a;100631903">
	<b:glossaryEntry>intelligence of all types and forms of immediate interest; usually disseminated without delays for evaluation or interpretation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100632097">
	<b:glossaryEntry>intelligence that is required for the planning and conduct of tactical operations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100632286">
	<b:glossaryEntry>tactical intelligence on the natural and man-made characteristics of an area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100632429">
	<b:glossaryEntry>intelligence that is required for forming policy and military plans at national and international levels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100632602">
	<b:glossaryEntry>intelligence information gathered from communications intelligence or electronics intelligence or telemetry intelligence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100632852">
	<b:glossaryEntry>intelligence derived from non-communications electromagnetic radiations from foreign sources (other than radioactive sources)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100633056">
	<b:glossaryEntry>technical and intelligence information derived from foreign communications by other than the intended recipients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100633251">
	<b:glossaryEntry>intelligence derived from the interception and processing and analysis of foreign telemetry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100633420">
	<b:glossaryEntry>an intelligence operation so planned and executed as to insure concealment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100633562">
	<b:glossaryEntry>an intelligence operation so planned as to permit plausible denial by the sponsor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100633706"
	 b:glossaryEntry="the collection of intelligence openly without concealment"/>
<rdf:Description rdf:about="&a;100633825">
	<b:glossaryEntry>the act of reconnoitring (especially to gain information about an enemy or potential enemy)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100634085"
	 b:glossaryEntry="reconnaissance (by shortening)"/>
<rdf:Description rdf:about="&a;100634183"
	 b:glossaryEntry="exploring in order to gain information"/>
<rdf:Description rdf:about="&a;100634314">
	<b:glossaryEntry>reconnaissance either by visual observation from the air or through the use of airborne sensors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100634474">
	<b:glossaryEntry>a method of reconnaissance in which fire is placed on a suspected enemy position in order to cause the enemy to disclose his presence by moving or returning fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100634704">
	<b:glossaryEntry>an offensive operation designed to discover or test the enemy''s strength (or to obtain other information)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100634879">
	<b:glossaryEntry>the detection and identification and evaluation and location of foreign electromagnetic radiations (other than radioactive)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100635074">
	<b:glossaryEntry>intelligence activities concerned with identifying and counteracting the threat to security posed by hostile intelligence organizations or by individuals engaged in espionage or sabotage or subversion or terrorism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100635443">
	<b:glossaryEntry>the aspect of counterintelligence designed to detect and prevent subversive activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100635593">
	<b:glossaryEntry>counterintelligence designed to detect and counteract sabotage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100635718">
	<b:glossaryEntry>the act of firing weapons or artillery at an enemy; "hold your fire until you can see the whites of their eyes"; "they retreated in the face of withering enemy fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100636447">
	<b:glossaryEntry>fire that makes it difficult for the enemy to fire on your own individuals or formations; "artillery provided covering fire for the withdrawal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100636658"
	 b:glossaryEntry="firing at enemy aircraft"/>
<rdf:Description rdf:about="&a;100636753">
	<b:glossaryEntry>the heavy fire of artillery to saturate an area rather than hit a specific target; "they laid down a barrage in front of the advancing troops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100636999">
	<b:glossaryEntry>(naval) the simultaneous firing of all the armament on one side of a warship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100637131">
	<b:glossaryEntry>rapid simultaneous discharge of firearms; "our fusillade from the left flank caught them by surprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100637313">
	<b:glossaryEntry>fire delivered on a specific target in response to a request from the supported unit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100637453">
	<b:glossaryEntry>fire delivered by supporting units to protect or assist a unit in combat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100637641">
	<b:glossaryEntry>fire on enemy troops or weapons or positions that are near the supported unit and are the most immediate and serious threat to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100637838">
	<b:glossaryEntry>fire on objectives not in the immediate vicinity your forces but with the objective of destroying enemy reserves and weapons nad interfering with the enemy command and supply and communications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100638098">
	<b:glossaryEntry>fire delivered in support of part of a force (as opposed to general supporting fire delivered in support of the force as a whole)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100638296">
	<b:glossaryEntry>fire from two or more weapons directed at a single target or area (as fire by batteries of two or more warships)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100638486"
	 b:glossaryEntry="fire intended to neutralize or destroy enemy weapons"/>
<rdf:Description rdf:about="&a;100638650">
	<b:glossaryEntry>fire delivered to neutralize or destroy indirect fire weapon systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100638784"
	 b:glossaryEntry="bombardment intended to destroy or neutralize enemy weapons"/>
<rdf:Description rdf:about="&a;100638908"
	 b:glossaryEntry="mortar fire intended to destroy or neutralize enemy weapons"/>
<rdf:Description rdf:about="&a;100639032">
	<b:glossaryEntry>intensive prearranged fire delivered when the immanence of enemy attack is discovered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100639187"
	 b:glossaryEntry="fire from two or more points so that the lines of fire cross"/>
<rdf:Description rdf:about="&a;100639303">
	<b:glossaryEntry>fire delivered for the sole purpose of destroying material objects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100639432">
	<b:glossaryEntry>fire delivered on a target that is visible to the person aiming it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100639556"
	 b:glossaryEntry="fire dispersed so as to engage effectively an area target"/>
<rdf:Description rdf:about="&a;100639676">
	<b:glossaryEntry>fire approximately parallel to the ground; the center of the cone of fire does rise above 1 meter from the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100639848">
	<b:glossaryEntry>fire designed to disturb the rest of enemy troops and to curtail movement and to lower enemy morale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100640008">
	<b:glossaryEntry>fire delivered on a target that is not itself used as the point of aim for the weapons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100640154">
	<b:glossaryEntry>fire directed to an area to prevent the enemy from using that area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100640284">
	<b:glossaryEntry>fire that is delivered in order to render the target ineffective or unusable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100640426">
	<b:glossaryEntry>fire for which the point of impact (the burst) can be seen by an observer; fire can be adjusted on the basis of the observations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100640614"
	 b:glossaryEntry="fire delivered on a target in preparation for an assault"/>
<rdf:Description rdf:about="&a;100640733"
	 b:glossaryEntry="gunfire aimed a target that is being tracked by radar"/>
<rdf:Description rdf:about="&a;100640843">
	<b:glossaryEntry>a chemical analysis used to determine the age of organic materials based on their content of the radioisotope carbon 14</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100641062">
	<b:glossaryEntry>fire delivered to obtain accurate data for subsequent effective engagement of targets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100641211"
	 b:glossaryEntry="prearranged fire delivered at a predetermined time"/>
<rdf:Description rdf:about="&a;100641322">
	<b:glossaryEntry>moving over territory to search for something; "scouring the entire area revealed nothing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100641467">
	<b:glossaryEntry>fire distributed in depth by successive changes in the elevation of the gun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100641603">
	<b:glossaryEntry>fire on or about a weapon system to degrade its performance below what is needed to fulfill its mission objectives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100641780">
	<b:glossaryEntry>fire for which the point of impact (the bursts) cannot be observed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100641908"
	 b:glossaryEntry="fire delivered by artillery"/>
<rdf:Description rdf:about="&a;100642082"
	 b:glossaryEntry="intense and continuous artillery fire"/>
<rdf:Description rdf:about="&a;100642186">
	<b:glossaryEntry>fire from a cannon fired at an elevation greater than that for the maximum range</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100642328"
	 b:glossaryEntry="artillery fire delivered by a mortar"/>
<rdf:Description rdf:about="&a;100642422">
	<b:glossaryEntry>artillery or mortar fire delivered in a constant direction at several quadrant elevations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100642567">
	<b:glossaryEntry>electronic warfare undertaken to prevent or reduce an enemy''s effective use of the electromagnetic spectrum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100642789">
	<b:glossaryEntry>electronic warfare undertaken to insure effective friendly use of the electromagnetic spectrum in spite of the enemy''s use of electronic warfare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100643021">
	<b:glossaryEntry>electronic warfare undertaken under direct control of an operational commander to locate sources of radiated electromagnetic energy for the purpose of immediate threat recognition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100643288">
	<b:glossaryEntry>the deliberate insertion of electromagnetic energy into transmission paths with the objective of confusing or deceiving operators</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100643489"
	 b:glossaryEntry="the use of harmful bacteria as a weapon"/>
<rdf:Description rdf:about="&a;100643613"
	 b:glossaryEntry="a holy war by Muslims against unbelievers"/>
<rdf:Description rdf:about="&a;100643714"
	 b:glossaryEntry="a war in which the major nations of the world are involved"/>
<rdf:Description rdf:about="&a;100643864">
	<b:glossaryEntry>the act or process of measuring; "he made a careful measurement"; "his mental measurings proved remarkably accurate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100644524"
	 b:glossaryEntry="measuring the strength of acid in a solution"/>
<rdf:Description rdf:about="&a;100644625">
	<b:glossaryEntry>measuring the intensity of radiation (especially of the sun''s rays)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100644750"
	 b:glossaryEntry="measuring sensitivity to pain or pressure"/>
<rdf:Description rdf:about="&a;100644847">
	<b:glossaryEntry>measuring the strength of an alkali or amount of alkali in a mixture or solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100644985"
	 b:glossaryEntry="recording anemometrical measurements"/>
<rdf:Description rdf:about="&a;100645079"
	 b:glossaryEntry="measuring wind speed and direction"/>
<rdf:Description rdf:about="&a;100645170"
	 b:glossaryEntry="the precise measurement of angles"/>
<rdf:Description rdf:about="&a;100645260">
	<b:glossaryEntry>measurement and study of the human body and its parts and capacities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100645388">
	<b:glossaryEntry>measurement of the pH level and the oxygen and carbon dioxide concentrations in arterial blood; important in diagnosis of many respiratory diseases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100645602"
	 b:glossaryEntry="measuring sensitivity of hearing"/>
<rdf:Description rdf:about="&a;100645691"
	 b:glossaryEntry="measuring the depths of the oceans"/>
<rdf:Description rdf:about="&a;100645793">
	<b:glossaryEntry>the act of checking or adjusting (by comparison with a standard) the accuracy of a measuring instrument; "the thermometer needed calibration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100646064">
	<b:glossaryEntry>calibrating something (a musical instrument or electronic circuit) to a standard frequency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100646207"
	 b:glossaryEntry="the act of adjusting something to match a standard"/>
<rdf:Description rdf:about="&a;100646398"
	 b:glossaryEntry="adjustments made to an engine to improve its performance"/>
<rdf:Description rdf:about="&a;100646508">
	<b:glossaryEntry>an adjustment that causes something to occur or recur in unison</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100646683">
	<b:glossaryEntry>the act of adjusting or aligning the parts of a device in relation to each other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100646855">
	<b:glossaryEntry>the alignment of the wheels of a motor vehicle closer together at the bottom than at the top</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100647000">
	<b:glossaryEntry>the alignment of the front wheels of a motor vehicle closer together at the front than at the back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100647151"
	 b:glossaryEntry="measurement of quantities of heat"/>
<rdf:Description rdf:about="&a;100647242">
	<b:glossaryEntry>measuring the optical density of a substance by shining light on it and measuring its transmission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100647399"
	 b:glossaryEntry="the measurement of specific gravity"/>
<rdf:Description rdf:about="&a;100647504">
	<b:glossaryEntry>a generic term used to cover any application of measurement techniques to the quantification of mental functions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100647699"
	 b:glossaryEntry="the act of making and recording a measurement"/>
<rdf:Description rdf:about="&a;100647820">
	<b:glossaryEntry>the act of discovering or expressing the quantity of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100647961"
	 b:glossaryEntry="the act of arranging in grades"/>
<rdf:Description rdf:about="&a;100648078">
	<b:glossaryEntry>a gradation involving small or imperceptible differences between grades</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100648214">
	<b:glossaryEntry>the act of drawing apart: "an angle is formed by the divergence of straight lines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100648353">
	<b:glossaryEntry>the act of measuring with meters or similar instruments; "he has a job meter reading for the gas company"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100648528">
	<b:glossaryEntry>the act of measuring depth of water (usually with a sounding line)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100648649">
	<b:glossaryEntry>locating a source of sound (as an enemy gun) by measurements of the time the sound arrives at microphones in known positions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100648833">
	<b:glossaryEntry>act of measuring or arranging or adjusting according to a scale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100648968"
	 b:glossaryEntry="the act of scaling in weight or quantity or dimension"/>
<rdf:Description rdf:about="&a;100649075"
	 b:glossaryEntry="estimation of the amount of lumber in a log"/>
<rdf:Description rdf:about="&a;100649172">
	<b:glossaryEntry>diagnosis of neuromuscular disorders with the use of an electromyograph</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100649306">
	<b:glossaryEntry>a diagnostic procedure to detect breast tumors by the use of X rays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100649431">
	<b:glossaryEntry>a diagnostic procedure to detect breast tumors by the use of infrared sensors that detect warm and cold areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100649604">
	<b:glossaryEntry>any standardized procedure for measuring sensitivity or memory or intelligence or aptitude etc; "the test was standardized on a large sample of students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100649895">
	<b:glossaryEntry>a psychometric test of intelligence; "they used to think that intelligence is what an intelligence test tests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100650115"
	 b:glossaryEntry="revision of the Binet-Simon scale"/>
<rdf:Description rdf:about="&a;100650214"
	 b:glossaryEntry="the first intelligence test"/>
<rdf:Description rdf:about="&a;100650305"
	 b:glossaryEntry="one of a battery of related tests"/>
<rdf:Description rdf:about="&a;100650412">
	<b:glossaryEntry>the activity or result of distributing or disposing persons or things properly or methodically; "in this new organization the container is much smaller"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100650778">
	<b:glossaryEntry>an arrangement of events that attempts to achieve a maximum effect; "the skillful orchestration of his political campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100650960">
	<b:glossaryEntry>an deliberately haphazard arrangement of observations so as to simulate chance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100651114"
	 b:glossaryEntry="systematic organization"/>
<rdf:Description rdf:about="&a;100651289"
	 b:glossaryEntry="the act of codifying; arranging is a systematic order"/>
<rdf:Description rdf:about="&a;100651401">
	<b:glossaryEntry>the act of making formal (as by stating formal rules governing classes of expressions)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100651563">
	<b:glossaryEntry>putting in order; "there were mistakes in the ordering of items on the list"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100651792"
	 b:glossaryEntry="an arrangement according to rank"/>
<rdf:Description rdf:about="&a;100651881"
	 b:glossaryEntry="the act of arranging in a graduated series"/>
<rdf:Description rdf:about="&a;100651987">
	<b:glossaryEntry>the action of following in order: "he played the trumps in sequence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100652141">
	<b:glossaryEntry>successive change from one thing or state to another and back again</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100652266"
	 b:glossaryEntry="the act of laying out (as by making plans for something)"/>
<rdf:Description rdf:about="&a;100652375"
	 b:glossaryEntry="the act of putting in alphabetical order"/>
<rdf:Description rdf:about="&a;100652495"
	 b:glossaryEntry="the act of making a list of items"/>
<rdf:Description rdf:about="&a;100652628">
	<b:glossaryEntry>making an itemized list of merchandise or supplies on hand; "the inventory took two days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100652802"
	 b:glossaryEntry="calling out an official list of names"/>
<rdf:Description rdf:about="&a;100652949"
	 b:glossaryEntry="a call of names of those receiving mail"/>
<rdf:Description rdf:about="&a;100653044"
	 b:glossaryEntry="a call of the names of personnel at a military assembly"/>
<rdf:Description rdf:about="&a;100653157"
	 b:glossaryEntry="a call of students'' names in a classroom"/>
<rdf:Description rdf:about="&a;100653260"
	 b:glossaryEntry="the activity of putting things together in groups"/>
<rdf:Description rdf:about="&a;100653454"
	 b:glossaryEntry="the grouping of musical phrases in a melodic line"/>
<rdf:Description rdf:about="&a;100653558"
	 b:glossaryEntry="the grouping of things by classes or categories"/>
<rdf:Description rdf:about="&a;100653772">
	<b:glossaryEntry>the act of classifying and providing an index in order to make items easier to retrieve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100653914"
	 b:glossaryEntry="classifying something again (usually in a new category)"/>
<rdf:Description rdf:about="&a;100654032">
	<b:glossaryEntry>the act or process or arranging persons into classes or social strata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100654162">
	<b:glossaryEntry>practice of classifying plants and animals according to their presumed natural relationships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100654309"
	 b:glossaryEntry="the act of gathering something together"/>
<rdf:Description rdf:about="&a;100654611"
	 b:glossaryEntry="assembling in proper numerical or logical sequence"/>
<rdf:Description rdf:about="&a;100654717">
	<b:glossaryEntry>the act of compiling (as into a single book or file or list); "the job of compiling the inventory took several hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100654904"
	 b:glossaryEntry="the act of gathering something"/>
<rdf:Description rdf:about="&a;100655017"
	 b:glossaryEntry="the gathering of a ripened crop"/>
<rdf:Description rdf:about="&a;100655148"
	 b:glossaryEntry="the harvesting of hay"/>
<rdf:Description rdf:about="&a;100655222">
	<b:glossaryEntry>the collecting of bottles: "bottle collection is a hobby of hers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100655351"
	 b:glossaryEntry="the act or practice of collecting coins"/>
<rdf:Description rdf:about="&a;100655452"
	 b:glossaryEntry="the collection and study of mollusc shells"/>
<rdf:Description rdf:about="&a;100655570"
	 b:glossaryEntry="the collection and removal of garbage"/>
<rdf:Description rdf:about="&a;100655723"
	 b:glossaryEntry="the collection and study of money (and coins in particular)"/>
<rdf:Description rdf:about="&a;100655874">
	<b:glossaryEntry>the act or process of picking up or collecting from various places: "garbage pickup is on Mondays and Thursdays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100656057"
	 b:glossaryEntry="the collection and study of postage stamps"/>
<rdf:Description rdf:about="&a;100656211"
	 b:glossaryEntry="the collection and study of airmail stamps"/>
<rdf:Description rdf:about="&a;100656313"
	 b:glossaryEntry="the collection of taxes"/>
<rdf:Description rdf:about="&a;100656397"
	 b:glossaryEntry="grouping by class or kind or size"/>
<rdf:Description rdf:about="&a;100656520"
	 b:glossaryEntry="the act of organizing as a territory"/>
<rdf:Description rdf:about="&a;100656642">
	<b:glossaryEntry>sorting and allocating aid on the basis of need for or likely benefit from medical treatment or food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100656795">
	<b:glossaryEntry>the act of bearing the weight of or strengthening; "he leaned against the wall for support"; "they forded the stream supporting their packs over their heads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100657055"
	 b:glossaryEntry="the act of propping up with shores"/>
<rdf:Description rdf:about="&a;100657170">
	<b:glossaryEntry>the act of suspending something (hanging it from above so it moves freely); "there was a small ceremony for the hanging of the portrait"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100657384"
	 b:glossaryEntry="the act of continuing or resuming an activity"/>
<rdf:Description rdf:about="&a;100657628">
	<b:glossaryEntry>the act of prolonging something; "there was an indefinite prolongation of the peace talks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100657820"
	 b:glossaryEntry="the act of repeating"/>
<rdf:Description rdf:about="&a;100657981"
	 b:glossaryEntry="doing or saying again"/>
<rdf:Description rdf:about="&a;100658072"
	 b:glossaryEntry="repetition of an act needlessly"/>
<rdf:Description rdf:about="&a;100658160"
	 b:glossaryEntry="an act of duplicating"/>
<rdf:Description rdf:about="&a;100658241"
	 b:glossaryEntry="an act of copying"/>
<rdf:Description rdf:about="&a;100658366">
	<b:glossaryEntry>the act of duplicating something; "this kind of duplication is wasteful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100658528"
	 b:glossaryEntry="the act of reproducing"/>
<rdf:Description rdf:about="&a;100658659">
	<b:glossaryEntry>(television) showing again some action (especially sports action) that has been recorded on video tape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100658830"
	 b:glossaryEntry="the reproduction of sound"/>
<rdf:Description rdf:about="&a;100658956"
	 b:glossaryEntry="the reproduction of sound with little or no distortion"/>
<rdf:Description rdf:about="&a;100659096">
	<b:glossaryEntry>the capacity of a system to reproduce loud sounds without distortion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100659238">
	<b:glossaryEntry>the act of reproducing recorded sound; "he was allowed to hear the playback of his testimony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100659386"
	 b:glossaryEntry="the act of imitating"/>
<rdf:Description rdf:about="&a;100659498"
	 b:glossaryEntry="effort to equal or surpass another"/>
<rdf:Description rdf:about="&a;100659588">
	<b:glossaryEntry>the resemblance of an animal species to another species or to natural objects; provides concealment and protection from predators</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100659771"
	 b:glossaryEntry="the act of persevering"/>
<rdf:Description rdf:about="&a;100659882"
	 b:glossaryEntry="the act of abiding (enduring without yielding)"/>
<rdf:Description rdf:about="&a;100659983">
	<b:glossaryEntry>the continuance of something begun with a view to its completion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100660117"
	 b:glossaryEntry="the act of discontinuing"/>
<rdf:Description rdf:about="&a;100660310">
	<b:glossaryEntry>the discontinuation of a franchise; especially the discontinuation of the right to vote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100660460">
	<b:glossaryEntry>the act by a donor that terminates the right of a person to inherit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100660588"
	 b:glossaryEntry="a mode of conducting legal and parliamentary proceedings"/>
<rdf:Description rdf:about="&a;100660718">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a particular course of action intended to achieve a results; "the procedure of obtaining a driver''s license"; "it was a process of trial and error"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100661165"
	 b:glossaryEntry="(genetics) the process of locating genes on a chromosome"/>
<rdf:Description rdf:about="&a;100661296">
	<b:glossaryEntry>a procedure for operating something or for dealing with a given situation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100661453"
	 b:glossaryEntry="a prescribed procedure to be followed routinely"/>
<rdf:Description rdf:about="&a;100661612"
	 b:glossaryEntry="the act or process of making or becoming stiff"/>
<rdf:Description rdf:about="&a;100661715"
	 b:glossaryEntry="needlessly time-consuming procedure"/>
<rdf:Description rdf:about="&a;100661830">
	<b:glossaryEntry>indirect procedure or action; "he tried to find out by indirection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100661955">
	<b:glossaryEntry>a long and complicated and confusing procedure; "all that academic rigmarole was a waste of time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100662121"
	 b:glossaryEntry="an unvarying or habitual method of procedure"/>
<rdf:Description rdf:about="&a;100662272"
	 b:glossaryEntry="an exhausting routine that leaves no time for relaxation"/>
<rdf:Description rdf:about="&a;100662383">
	<b:glossaryEntry>a settled and monotonous routine that is hard to escape; "they fell into a conversational rut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100662536">
	<b:glossaryEntry>any activity that is performed in an especially solemn elaborate or formal way; "the ceremony of smelling the cork and tasting the wine"; "he makes a ceremony of addressing his golf ball"; "he disposed of it without ceremony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100662816">
	<b:glossaryEntry>the proper or conventional behavior on some solemn occasion; "an inaugural ceremony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100663027">
	<b:glossaryEntry>the ceremonial breaking of the ground to formally begin a construction project</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100663210">
	<b:glossaryEntry>(ancient Rome) a ceremonial purification of the Roman population every five years following the census</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100663366"
	 b:glossaryEntry="any customary observance or practice"/>
<rdf:Description rdf:about="&a;100663517"
	 b:glossaryEntry="a ceremony having religious meaning"/>
<rdf:Description rdf:about="&a;100663816">
	<b:glossaryEntry>a military custom performed in observance of some event or anniversary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100663950"
	 b:glossaryEntry="a religious meal shared as a sign of love and fellowship"/>
<rdf:Description rdf:about="&a;100664071"
	 b:glossaryEntry="the activity of worshipping"/>
<rdf:Description rdf:about="&a;100664494"
	 b:glossaryEntry="the elevation of a person to the status of a god"/>
<rdf:Description rdf:about="&a;100664626"
	 b:glossaryEntry="worship of ancestors"/>
<rdf:Description rdf:about="&a;100664709">
	<b:glossaryEntry>an established ceremony prescribed by a religion; "the rite of baptism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100664956">
	<b:glossaryEntry>a devotional watch (especially on the eve of a religious festival)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100665118">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a vigil held over a corpse the night before burial; "there''s no weeping at an Irish wake"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100665268"
	 b:glossaryEntry="a vigil before certain feasts (as e.g. Easter)"/>
<rdf:Description rdf:about="&a;100665369"
	 b:glossaryEntry="rites performed in connection with a death or burial"/>
<rdf:Description rdf:about="&a;100665478">
	<b:glossaryEntry>secret rite in the cults of ancient Greek or Roman deities involving singing and dancing and drinking and sexual activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100665650">
	<b:glossaryEntry>an offensive term for the practices and rituals of the Roman Catholic Church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100665779"
	 b:glossaryEntry="the prescribed procedure for conducting religious ceremonies"/>
<rdf:Description rdf:about="&a;100665928">
	<b:glossaryEntry>exaggerated emphasis on the importance of rites or ritualistic forms in worship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100666063">
	<b:glossaryEntry>a Jewish and Muslim religious rite performed on a male 8 days after birth;</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100666215"
	 b:glossaryEntry="the Jewish rite of circumcision"/>
<rdf:Description rdf:about="&a;100666314"
	 b:glossaryEntry="the practice of living without clothes for reasons of health"/>
<rdf:Description rdf:about="&a;100666456">
	<b:glossaryEntry>the practice of adopting the clothes or the manner or the sexual role of the opposite sex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100666638">
	<b:glossaryEntry>the act of public worship following prescribed rules; "the Sunday service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100666912">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a service conducted in a church; "don''t be late for church"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100667041"
	 b:glossaryEntry="a service at which people sing hymns and pray together"/>
<rdf:Description rdf:about="&a;100667173"
	 b:glossaryEntry='a service conducted in a chapel; "he was late for chapel"'/>
<rdf:Description rdf:about="&a;100667300"
	 b:glossaryEntry="a rite or body of rites prescribed for public worship"/>
<rdf:Description rdf:about="&a;100667425"
	 b:glossaryEntry="the Christian worship services"/>
<rdf:Description rdf:about="&a;100667538">
	<b:glossaryEntry>a religious rite or service prescribed by ecclesiastical authorities; "the offices of the mass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100667722">
	<b:glossaryEntry>canonical prayers recited daily by priests (e.g. the breviary of the Roman Catholic Church)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100667873">
	<b:glossaryEntry>a Roman Catholic office honoring the Virgin Mary; similar to but shorter than the Divine Office</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100668028"
	 b:glossaryEntry="a late afternoon or evening worship service"/>
<rdf:Description rdf:about="&a;100668143"
	 b:glossaryEntry="Roman Catholic Church: vespers of the office for the dead"/>
<rdf:Description rdf:about="&a;100668254"
	 b:glossaryEntry="a devotional service (especially on New Year''s Eve)"/>
<rdf:Description rdf:about="&a;100668363">
	<b:glossaryEntry>a formal religious act conferring a specific grace on those who receive it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100668619">
	<b:glossaryEntry>the traditional Passover supper of Jesus with his disciples on the eve of his crucifixion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100668782">
	<b:glossaryEntry>(Judaism) the ceremonial dinner on the first night (or both nights) of Passover</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100668949">
	<b:glossaryEntry>a Christian sacrament commemorating the Last Supper by consecrating bread and wine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100669219">
	<b:glossaryEntry>the part of the Eucharist when bread and wine are offered to God</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100669358"
	 b:glossaryEntry="the act of participating in the celebration of the Eucharist"/>
<rdf:Description rdf:about="&a;100669528">
	<b:glossaryEntry>participation in Holy Communion by members of more than one church (eg Catholic and Orthodox)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100669682"
	 b:glossaryEntry="the ceremony or sacrament of marriage"/>
<rdf:Description rdf:about="&a;100669775">
	<b:glossaryEntry>the act of marrying; the nuptial ceremony; "their marriage was conducted in the chapel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100670019"
	 b:glossaryEntry="archaic terms for a wedding or wedding feast"/>
<rdf:Description rdf:about="&a;100670127"
	 b:glossaryEntry="the act of becoming betrothed or engaged"/>
<rdf:Description rdf:about="&a;100670234">
	<b:glossaryEntry>a marriage performed by a government official rather than by a clergyman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100670367"
	 b:glossaryEntry="a marriage for love''s sake; not an arranged marriage"/>
<rdf:Description rdf:about="&a;100670476">
	<b:glossaryEntry>a Christian sacrament signifying spiritual cleansing and rebirth; "most churches baptize infants but some insist on adult baptism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100670732"
	 b:glossaryEntry="the act of baptizing someone by pouring water on their head"/>
<rdf:Description rdf:about="&a;100670856"
	 b:glossaryEntry="the act of sprinkling water in baptism (rare)"/>
<rdf:Description rdf:about="&a;100670970">
	<b:glossaryEntry>a form of baptism in which part or all of a person''s body is submerged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100671096"
	 b:glossaryEntry="giving a Christian name at baptism"/>
<rdf:Description rdf:about="&a;100671188">
	<b:glossaryEntry>a sacrament admitting a baptized person to full participation in the church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100671322">
	<b:glossaryEntry>a ceremony held in the synagogue (usually at Pentecost) to admit as adult members of the Jewish community young men and women who have successfully completed a course of study in Judaism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100671567">
	<b:glossaryEntry>a Catholic sacrament; repentance and confession and satisfaction and absolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100671737">
	<b:glossaryEntry>(Roman Catholic Church) the act of a penitent disclosing his sinfulness before a priest in the sacrament of penance in the hope of absolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100671953"
	 b:glossaryEntry="the act of being shriven"/>
<rdf:Description rdf:about="&a;100672030">
	<b:glossaryEntry>a Catholic sacrament; a priest anoints a dying person with oil and prays for salvation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100672215"
	 b:glossaryEntry="the sacrament of ordination"/>
<rdf:Description rdf:about="&a;100672319"
	 b:glossaryEntry="a religious ceremony in which something is made holy"/>
<rdf:Description rdf:about="&a;100672486">
	<b:glossaryEntry>(Roman Catholic Church) the act of declaring that a deceased person lived a holy life and is worthy of public veneration; a first step toward canonization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100672700">
	<b:glossaryEntry>(Roman Catholic Church and Eastern Orthodox Church) the act of admitting a deceased person into the canon of saints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100672889">
	<b:glossaryEntry>the act of consecrating; "the Cardinal attended the consecration of the church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100673027">
	<b:glossaryEntry>a solemn dedication to a service or a goal; "his consecration to study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100673157"
	 b:glossaryEntry="the act of offering the bread and wine of the Eucharist"/>
<rdf:Description rdf:about="&a;100673306">
	<b:glossaryEntry>the act of contributing to the funds of a church or charity; "oblations for aid to the poor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100673464"
	 b:glossaryEntry="anointing as part of a religious ceremony or healing ritual"/>
<rdf:Description rdf:about="&a;100673607">
	<b:glossaryEntry>the act of pouring a liquid offering (especially wine) as a religious ceremony</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100673740">
	<b:glossaryEntry>the act of communicating with a deity (especially as a petition or in adoration or contrition or thanksgiving)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100673972"
	 b:glossaryEntry="a liturgical prayer"/>
<rdf:Description rdf:about="&a;100674047">
	<b:glossaryEntry>the celebration of the Eucharist (in the Roman Catholic Church and some Protestant Churches)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100674244"
	 b:glossaryEntry="a solemn and elaborate Mass with music"/>
<rdf:Description rdf:about="&a;100674357"
	 b:glossaryEntry="a Mass recited without music"/>
<rdf:Description rdf:about="&a;100674440"
	 b:glossaryEntry="a Mass celebrated for the dead"/>
<rdf:Description rdf:about="&a;100674543">
	<b:glossaryEntry>(usually plural) religious observance or prayers (usually spoken silently); "he returned to his devotions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100674722">
	<b:glossaryEntry>(Roman Catholic Church) a devotion consisting of 14 prayers before the 14 stations of the cross</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100674885"
	 b:glossaryEntry="the act of praying for divine protection"/>
<rdf:Description rdf:about="&a;100674994"
	 b:glossaryEntry="worshiping blindly and to excess"/>
<rdf:Description rdf:about="&a;100675116"
	 b:glossaryEntry="worship given to God alone"/>
<rdf:Description rdf:about="&a;100675207"
	 b:glossaryEntry="the worship of idols; the worship of images that are not God"/>
<rdf:Description rdf:about="&a;100675355"
	 b:glossaryEntry="idolization of William Shakespeare"/>
<rdf:Description rdf:about="&a;100675446"
	 b:glossaryEntry="the worship of sacred images"/>
<rdf:Description rdf:about="&a;100675531"
	 b:glossaryEntry="religious zeal; willingness to serve God"/>
<rdf:Description rdf:about="&a;100675794"
	 b:glossaryEntry="worship of yourself"/>
<rdf:Description rdf:about="&a;100675896"
	 b:glossaryEntry="worship of the Bible"/>
<rdf:Description rdf:about="&a;100675990"
	 b:glossaryEntry="worship of words"/>
<rdf:Description rdf:about="&a;100676094"
	 b:glossaryEntry="worship of symbols"/>
<rdf:Description rdf:about="&a;100676201"
	 b:glossaryEntry="worship of human beings"/>
<rdf:Description rdf:about="&a;100676301"
	 b:glossaryEntry="worship of women"/>
<rdf:Description rdf:about="&a;100676404"
	 b:glossaryEntry="worship of a lord because of his rank or title"/>
<rdf:Description rdf:about="&a;100676507"
	 b:glossaryEntry="worship of miracles"/>
<rdf:Description rdf:about="&a;100676604"
	 b:glossaryEntry="worship of places"/>
<rdf:Description rdf:about="&a;100676693"
	 b:glossaryEntry="worship of trees"/>
<rdf:Description rdf:about="&a;100676782"
	 b:glossaryEntry="worship of planets or stars"/>
<rdf:Description rdf:about="&a;100676895"
	 b:glossaryEntry="worship of the cosmos"/>
<rdf:Description rdf:about="&a;100676973"
	 b:glossaryEntry="worship of devils"/>
<rdf:Description rdf:about="&a;100677077"
	 b:glossaryEntry="worship of fire"/>
<rdf:Description rdf:about="&a;100677163"
	 b:glossaryEntry="worship of saints"/>
<rdf:Description rdf:about="&a;100677270"
	 b:glossaryEntry="worship of the sun"/>
<rdf:Description rdf:about="&a;100677359"
	 b:glossaryEntry="worship of animals"/>
<rdf:Description rdf:about="&a;100677485"
	 b:glossaryEntry="worship of fish"/>
<rdf:Description rdf:about="&a;100677574">
	<b:glossaryEntry>the worship of a single god but without claiming that it is the only god</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100677702"
	 b:glossaryEntry="worship of snakes"/>
<rdf:Description rdf:about="&a;100677794"
	 b:glossaryEntry="worship of the moon"/>
<rdf:Description rdf:about="&a;100677886"
	 b:glossaryEntry="the activity of causing to have energy and be active"/>
<rdf:Description rdf:about="&a;100678057">
	<b:glossaryEntry>the activity of thrilling or markedly exciting some person or group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100678186"
	 b:glossaryEntry="the coming again into activity and prominence"/>
<rdf:Description rdf:about="&a;100678421"
	 b:glossaryEntry="the revival of learning and culture"/>
<rdf:Description rdf:about="&a;100678537"
	 b:glossaryEntry="the activity of spiritual or physical renewal"/>
<rdf:Description rdf:about="&a;100678641">
	<b:glossaryEntry>revival from inactivity and disuse; "it produced a resurrection of hope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100678772"
	 b:glossaryEntry="a revival of consciousness"/>
<rdf:Description rdf:about="&a;100678858"
	 b:glossaryEntry="the activity of giving vitality and vigour to something"/>
<rdf:Description rdf:about="&a;100679011"
	 b:glossaryEntry="the activity of presenting something"/>
<rdf:Description rdf:about="&a;100679124">
	<b:glossaryEntry>presentation to view in an open or public manner; "the exposure of his anger was shocking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100679287">
	<b:glossaryEntry>the exposure of falseness or pretensions; "the debunking of religion has been too successful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100679450"
	 b:glossaryEntry="the activity of keeping something secret"/>
<rdf:Description rdf:about="&a;100679708">
	<b:glossaryEntry>the act of concealing the identity of something by modifying its appearance; "he is a master of disguise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100679881">
	<b:glossaryEntry>activity that tries to conceal something; "no mask could conceal his ignorance"; "they moved in under a mask of friendship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100680055">
	<b:glossaryEntry>the act of concealing the existence of something by obstructing the view of it; "the cover concealed their guns from enemy aircraft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100680272">
	<b:glossaryEntry>an attempt to prevent something embarrassing from becoming public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100680392"
	 b:glossaryEntry="concealing something under the ground"/>
<rdf:Description rdf:about="&a;100680510"
	 b:glossaryEntry="the act of burying again"/>
<rdf:Description rdf:about="&a;100680601"
	 b:glossaryEntry="avoiding detection by moving carefully"/>
<rdf:Description rdf:about="&a;100680704"
	 b:glossaryEntry="concealing the source of illegally gotten money"/>
<rdf:Description rdf:about="&a;100680814"
	 b:glossaryEntry="the act of putting something in a certain place or location"/>
<rdf:Description rdf:about="&a;100681146"
	 b:glossaryEntry="positioning close together (or side by side)"/>
<rdf:Description rdf:about="&a;100681250"
	 b:glossaryEntry="the act of interposing one thing between or among others"/>
<rdf:Description rdf:about="&a;100681366"
	 b:glossaryEntry="the act of orienting"/>
<rdf:Description rdf:about="&a;100681444">
	<b:glossaryEntry>the act of fixing firmly in place; "she resented his planting himself in the doorway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100681584"
	 b:glossaryEntry="the act of implanting"/>
<rdf:Description rdf:about="&a;100681664"
	 b:glossaryEntry="the act of placing in a new position"/>
<rdf:Description rdf:about="&a;100681760">
	<b:glossaryEntry>the act of putting something in position; "he gave a final set to his hat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100681884">
	<b:glossaryEntry>the placement of the fingers for playing different notes (or sequences of notes) on a musical instrument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100682063">
	<b:glossaryEntry>continuing or remaining in a place; "they had a nice stay in Paris"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100682217"
	 b:glossaryEntry="the act of dwelling in a place"/>
<rdf:Description rdf:about="&a;100682362"
	 b:glossaryEntry="the act of lodging"/>
<rdf:Description rdf:about="&a;100682434"
	 b:glossaryEntry="an act of being a tenant or occupant"/>
<rdf:Description rdf:about="&a;100682554"
	 b:glossaryEntry="the act of inhabiting"/>
<rdf:Description rdf:about="&a;100682697"
	 b:glossaryEntry="living together (as spouses)"/>
<rdf:Description rdf:about="&a;100682820"
	 b:glossaryEntry="cohabitation without being legally married"/>
<rdf:Description rdf:about="&a;100682920"
	 b:glossaryEntry="the act of encamping and living in tents in a camp"/>
<rdf:Description rdf:about="&a;100683061"
	 b:glossaryEntry="temporary residence"/>
<rdf:Description rdf:about="&a;100683152"
	 b:glossaryEntry='brief residence as a guest; "a wekend visit with friends"'/>
<rdf:Description rdf:about="&a;100683261">
	<b:glossaryEntry xml:space='preserve'><![CDATA[brief visit in an official or professional capacity: "the pastor''s visits to his parishioners"; "a visit to a dentist"; "the salesman''s call on a customer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100683485">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often plural) a series of professional calls (usually in a set order); "the doctor goes on his rounds first thing every morning"; "the postman''s rounds"; "we enjoyed our round of the local bars"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100683732">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a brief social visit: "senior professors'' wives no longer make afternoon calls on newcomers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100683875">
	<b:glossaryEntry>the activity of making visits; "visiting with the neighbors filled her afternoons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100684012">
	<b:glossaryEntry>a brief stay in the course of a journey; "they made a stopover to visit their friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100684206"
	 b:glossaryEntry="a break in a journey for the night"/>
<rdf:Description rdf:about="&a;100684297">
	<b:glossaryEntry>a stop made by a touring musical or theatrical group to give a performance; "a one-night stand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100684444"
	 b:glossaryEntry="the activity of supplying or providing something"/>
<rdf:Description rdf:about="&a;100684743"
	 b:glossaryEntry="supplying dry land with water by means of ditches etc"/>
<rdf:Description rdf:about="&a;100684853"
	 b:glossaryEntry="the act of supplying food and nourishment"/>
<rdf:Description rdf:about="&a;100685030"
	 b:glossaryEntry="nourishing at the breast"/>
<rdf:Description rdf:about="&a;100685108"
	 b:glossaryEntry="excessive feeding"/>
<rdf:Description rdf:about="&a;100685183"
	 b:glossaryEntry="feeding someone (as a baby) from a spoon"/>
<rdf:Description rdf:about="&a;100685282"
	 b:glossaryEntry="the activity of supplying or taking on fuel"/>
<rdf:Description rdf:about="&a;100685391"
	 b:glossaryEntry="the provision of medical care"/>
<rdf:Description rdf:about="&a;100685503">
	<b:glossaryEntry>the provision of something by issuing it (usually in quantity); "a new issue of stamps"; "the last issue of penicillin was over a month ago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100685734">
	<b:glossaryEntry>(corporation law) the authorization and delivery of shares of stock for sale to the public or the shares thus offered at a particular time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100685930">
	<b:glossaryEntry>handling an operation that involves providing labor and materials be supplied as needed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100686073"
	 b:glossaryEntry="the act of supplying something"/>
<rdf:Description rdf:about="&a;100686160">
	<b:glossaryEntry>the activity of supplying a stock of something; "he supervised the stocking of the stream with trout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100686316"
	 b:glossaryEntry="the act or process of providing aid or help of any sort"/>
<rdf:Description rdf:about="&a;100686428">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of demanding; "the kidnapper''s exorbitant demands for money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100686585">
	<b:glossaryEntry>act of demanding or levying by by force or authority: "exaction of tribute"; "exaction of various dues and fees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100686770">
	<b:glossaryEntry>unjust exaction (as by the misuse of authority): "the extortion by dishonest officials of fees for performing their sworn duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100686953">
	<b:glossaryEntry>demand for something as rightful or due: "they struck in support of their claim for a shorter work day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100687126"
	 b:glossaryEntry="demand for payment in accordance with an insurance policy"/>
<rdf:Description rdf:about="&a;100687245"
	 b:glossaryEntry='a gradual depletion; "a drain on resources"'/>
<rdf:Description rdf:about="&a;100687376"
	 b:glossaryEntry="depletion or loss of intellectual and technical personnel"/>
<rdf:Description rdf:about="&a;100687491"
	 b:glossaryEntry="being inactive"/>
<rdf:Description rdf:about="&a;100687670"
	 b:glossaryEntry="temporary inactivity"/>
<rdf:Description rdf:about="&a;100687814">
	<b:glossaryEntry>a pause from doing something (as work); "we took a 10-minute break"; "he took time out to recuperate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100687997">
	<b:glossaryEntry>the act of pausing uncertainly; "there was a hesitation in his speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100688153"
	 b:glossaryEntry="the act of suspending activity temporarily"/>
<rdf:Description rdf:about="&a;100688254">
	<b:glossaryEntry>an interruption or temporary suspension of progress or movement: "a halt in the arms race"; "a nuclear freeze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100688424">
	<b:glossaryEntry>the act of waiting (remaining inactive in one place while expecting something); "the wait was an ordeal for him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100688597">
	<b:glossaryEntry>freedom from activity (work or strain or responsibility); "took his repose by the swimming pool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100688827"
	 b:glossaryEntry="(British) a long stay in bed in the morning"/>
<rdf:Description rdf:about="&a;100688923"
	 b:glossaryEntry="quiet and inactive restfulness"/>
<rdf:Description rdf:about="&a;100689063"
	 b:glossaryEntry="inactivity that is passive and monotonous"/>
<rdf:Description rdf:about="&a;100689161">
	<b:glossaryEntry>freedom to choose a pastime or enjoyable activity; "he lacked the leisure for golf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100689316"
	 b:glossaryEntry="having no employment"/>
<rdf:Description rdf:about="&a;100689428"
	 b:glossaryEntry="carefree idleness"/>
<rdf:Description rdf:about="&a;100689508"
	 b:glossaryEntry="to that is free for leisure activities"/>
<rdf:Description rdf:about="&a;100689615"
	 b:glossaryEntry="the act of taking a vacation"/>
<rdf:Description rdf:about="&a;100689737"
	 b:glossaryEntry="a holiday where you do the same things you do at work"/>
<rdf:Description rdf:about="&a;100689853"
	 b:glossaryEntry="the practice of taking holidays in a caravan"/>
<rdf:Description rdf:about="&a;100689955"
	 b:glossaryEntry="the act of delaying"/>
<rdf:Description rdf:about="&a;100690191">
	<b:glossaryEntry>detention of a ship or freight car or other cargo beyond its scheduled time of departure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100690335"
	 b:glossaryEntry="act of putting off to a future time"/>
<rdf:Description rdf:about="&a;100690488"
	 b:glossaryEntry="the act of postponing to another time or place"/>
<rdf:Description rdf:about="&a;100690592">
	<b:glossaryEntry>discontinuing the meetings (of a legislative body) without dissolving it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100690722"
	 b:glossaryEntry="the act of procrastinating"/>
<rdf:Description rdf:about="&a;100690838"
	 b:glossaryEntry="the act of slowing down or falling behind"/>
<rdf:Description rdf:about="&a;100690954"
	 b:glossaryEntry="the deliberate act of wasting time instead of working"/>
<rdf:Description rdf:about="&a;100691100">
	<b:glossaryEntry>a tactic for delaying or obstructing legislation by making long speeches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100691229"
	 b:glossaryEntry="an action or remark that interrupts"/>
<rdf:Description rdf:about="&a;100691355"
	 b:glossaryEntry="the act of lingering"/>
<rdf:Description rdf:about="&a;100691454"
	 b:glossaryEntry="an instance of breaking off suddenly"/>
<rdf:Description rdf:about="&a;100691561"
	 b:glossaryEntry="shouting to interrupt a speech with which you disagree"/>
<rdf:Description rdf:about="&a;100691683"
	 b:glossaryEntry="act or practice of refraining from indulging an appetite"/>
<rdf:Description rdf:about="&a;100691886"
	 b:glossaryEntry="abstaining from sexual relations"/>
<rdf:Description rdf:about="&a;100692004"
	 b:glossaryEntry="the act of denying yourself; controlling your impulses"/>
<rdf:Description rdf:about="&a;100692149"
	 b:glossaryEntry="abstaining from excess"/>
<rdf:Description rdf:about="&a;100692239"
	 b:glossaryEntry="abstaining from alcohol"/>
<rdf:Description rdf:about="&a;100692334"
	 b:glossaryEntry="abstaining from food"/>
<rdf:Description rdf:about="&a;100692451"
	 b:glossaryEntry="a fast by a prisoner as a means of protest"/>
<rdf:Description rdf:about="&a;100692553">
	<b:glossaryEntry>the act of restricting your food intake (or your intake of particular foods)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100692690"
	 b:glossaryEntry="control of the flow of traffic in a building or a city"/>
<rdf:Description rdf:about="&a;100692824">
	<b:glossaryEntry>(British) the control of traffic by a policeman stationed at an intersection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100692957"
	 b:glossaryEntry="the conscious exclusion of unacceptable thoughts or desires"/>
<rdf:Description rdf:about="&a;100693087"
	 b:glossaryEntry="the act of tolerating something"/>
<rdf:Description rdf:about="&a;100693192">
	<b:glossaryEntry>lightening a penalty or excusing from a chore by judges or parents or teachers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100693354">
	<b:glossaryEntry>leniency and compassion shown toward offenders by a person or agency charged with administering justice; "he threw himself on the mercy of the court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100693635">
	<b:glossaryEntry>an activity that affords enjoyment; "he puts duty before pleasure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100693756"
	 b:glossaryEntry="act of receiving pleasure from something"/>
<rdf:Description rdf:about="&a;100693866">
	<b:glossaryEntry>the act of laughing; the manifestation of joy or mirth of scorn; "he enjoyed the laughter of the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100694042">
	<b:glossaryEntry>act of fulfilling a desire or need or appetite; "the satisfaction of their demand for better services"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100694234"
	 b:glossaryEntry="the act or an instance of gratifying or satisfying"/>
<rdf:Description rdf:about="&a;100694380">
	<b:glossaryEntry>the act of satisfying your own desires and giving yourself pleasure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100694512"
	 b:glossaryEntry="the act of indulging or gratifying a desire"/>
<rdf:Description rdf:about="&a;100694694">
	<b:glossaryEntry>excessive indulgence; "the child was spoiled by overindulgence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100694827"
	 b:glossaryEntry="any act of immoderate indulgence"/>
<rdf:Description rdf:about="&a;100694910"
	 b:glossaryEntry="the act of hindering or obstructing or impeding"/>
<rdf:Description rdf:about="&a;100695150">
	<b:glossaryEntry>(biochemistry) interference in or inhibition of the physiological action of a chemical substance by another having a similar structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100695341"
	 b:glossaryEntry='the act of obstructing; "obstruction of justice"'/>
<rdf:Description rdf:about="&a;100695483"
	 b:glossaryEntry="the act of blocking"/>
<rdf:Description rdf:about="&a;100695597">
	<b:glossaryEntry>the interdiction of a nation''s lines of communication at sea by the use of naval power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100695744">
	<b:glossaryEntry>the action of an armed force that surrounds a fortified place and isolates it while continuing to attack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100696163">
	<b:glossaryEntry>the act of freeing a city or town that has been besieged; "he asked for troops for the relief of Atlanta"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100696321"
	 b:glossaryEntry="a tactic used to mislead or delay"/>
<rdf:Description rdf:about="&a;100696435">
	<b:glossaryEntry>stalling or delaying especially by refusing to answer questions or cooperate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100696570">
	<b:glossaryEntry>the act of stopping something; "the third baseman made some remarkable stops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100696727"
	 b:glossaryEntry="the act or process of complicating"/>
<rdf:Description rdf:about="&a;100696835"
	 b:glossaryEntry="the act or process of deterring"/>
<rdf:Description rdf:about="&a;100696959"
	 b:glossaryEntry='the act of discouraging; "the dscouragement of petty theft"'/>
<rdf:Description rdf:about="&a;100697079">
	<b:glossaryEntry>(military) a tunnel dug to defeat similar activities by the enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100697202"
	 b:glossaryEntry="the act of preventing"/>
<rdf:Description rdf:about="&a;100697412"
	 b:glossaryEntry="legal prevention"/>
<rdf:Description rdf:about="&a;100697514">
	<b:glossaryEntry>forceful prevention: "suppression of liberal newspapers"; "quelling of the revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100697691"
	 b:glossaryEntry="the prevention of disease"/>
<rdf:Description rdf:about="&a;100697774">
	<b:glossaryEntry>the act of preventing something from occurring; "averting danger was his responsibility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100697917"
	 b:glossaryEntry="the minimization of tax liability by lawful methods"/>
<rdf:Description rdf:about="&a;100698028">
	<b:glossaryEntry>the act of preventing something by anticipating and disposing of it effectively</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100698191">
	<b:glossaryEntry>the act of preventing someone from participating by finding them unqualified</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100698364">
	<b:glossaryEntry>the disqualification of a judge or jury by reason of prejudice or conflict of interest; a judge can be recused by objections of either party or they can disqualify themselves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100698605">
	<b:glossaryEntry>the act of preventing the opposition from scoring (in sports): "the goalie made a brilliant save"; "the relief pitcher got credit for a save"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100698797"
	 b:glossaryEntry="action taken by a group of people"/>
<rdf:Description rdf:about="&a;100699519">
	<b:glossaryEntry>the absorbing of one cultural group into harmony with another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100699688"
	 b:glossaryEntry="assimilation into American culture"/>
<rdf:Description rdf:about="&a;100699784"
	 b:glossaryEntry="assimilation into European culture"/>
<rdf:Description rdf:about="&a;100699880"
	 b:glossaryEntry="activity considered appropriate on social occasions"/>
<rdf:Description rdf:about="&a;100700029"
	 b:glossaryEntry="the act of forming an alliance or confederation"/>
<rdf:Description rdf:about="&a;100700147">
	<b:glossaryEntry>the act of consorting with or joining with others; "you cannot be convicted of criminal guilt by association"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100700350">
	<b:glossaryEntry>associating with others in a brotherly or friendly way; especially with an enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100700508">
	<b:glossaryEntry>the act of becoming formally connected or joined: "welcomed the affiliation of the research center with the university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100700703"
	 b:glossaryEntry="affiliation anew"/>
<rdf:Description rdf:about="&a;100700779">
	<b:glossaryEntry>the action of people mingling and coming into contact; "all the random mingling and idle talk made him hate literary parties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100700959"
	 b:glossaryEntry="the action of changing from colonial to independent status"/>
<rdf:Description rdf:about="&a;100701095">
	<b:glossaryEntry>the act of disbanding; "the orchestra faced the prospect of disbandment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100701225">
	<b:glossaryEntry>the act terminating an established state of affairs; especially ending a connection with the Church of England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100701398"
	 b:glossaryEntry="the act of distributing or spreading or apportioning"/>
<rdf:Description rdf:about="&a;100701617"
	 b:glossaryEntry="distributing again"/>
<rdf:Description rdf:about="&a;100701696"
	 b:glossaryEntry="the act of dispensing (giving out in portions)"/>
<rdf:Description rdf:about="&a;100701814">
	<b:glossaryEntry>the act of distributing by allotting or apportioning; "the apportionment of seats in the House of Representatives is based on the relative populaton of each state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100702192">
	<b:glossaryEntry>a new apportionment (especially a reallotment of US congressional seats on the basis of census results)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100702421">
	<b:glossaryEntry>a redistribution of something; "there was a reshuffle of cabinet officers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100702551">
	<b:glossaryEntry>the act of apportioning or distributing something; "the captain was entrusted with the deal of provisions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100702726"
	 b:glossaryEntry="a reapportioning of something"/>
<rdf:Description rdf:about="&a;100702810"
	 b:glossaryEntry="the act of rationing"/>
<rdf:Description rdf:about="&a;100702886">
	<b:glossaryEntry>the result of parcelling out or sharing; "death gets more than its share of attention from theologicans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100703061">
	<b:glossaryEntry>(card game) the act of distributing playing cards; "the deal was passed around the table clockwise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100703248"
	 b:glossaryEntry="an incorrect deal"/>
<rdf:Description rdf:about="&a;100703319"
	 b:glossaryEntry="a distribution in shares"/>
<rdf:Description rdf:about="&a;100703445"
	 b:glossaryEntry="acting generously"/>
<rdf:Description rdf:about="&a;100703535"
	 b:glossaryEntry="the act of giving"/>
<rdf:Description rdf:about="&a;100703702"
	 b:glossaryEntry="the act of conferring an honor or presenting a gift"/>
<rdf:Description rdf:about="&a;100703846">
	<b:glossaryEntry>the act of endowing with a permanent source of income; "his generous endowment of the laboratory came just in the nick of time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100704029">
	<b:glossaryEntry>governmental provision of economic assistance to persons in need</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100704218">
	<b:glossaryEntry>government provision for unemployed or injured or aged; financed by contributions from employers and employees as well as by government revenue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100704532">
	<b:glossaryEntry>social insurance program in Britain; based on contributions from employers and employees; provides payments to unemployed and sick and retired people as well as medical services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100704774">
	<b:glossaryEntry>(Great Britain) benefits paid to bring incomes up to minimum levels established by law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100704970">
	<b:glossaryEntry>social welfare program in the U.S.; includes old-age and survivors insurance and some unemployment insurance and old-age assistance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100705199">
	<b:glossaryEntry>aid for the aged or indigent or handicapped; "he has been on relief for many years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100705335"
	 b:glossaryEntry="(Great Britain) money received from the state"/>
<rdf:Description rdf:about="&a;100705446"
	 b:glossaryEntry="payment by a US agency to unemployed people"/>
<rdf:Description rdf:about="&a;100705561"
	 b:glossaryEntry="insurance paid to the elderly"/>
<rdf:Description rdf:about="&a;100705654"
	 b:glossaryEntry="insurance paid to surviving spouses"/>
<rdf:Description rdf:about="&a;100705755"
	 b:glossaryEntry="social insurance for the disabled"/>
<rdf:Description rdf:about="&a;100705855"
	 b:glossaryEntry="social insurance for the ill and injured"/>
<rdf:Description rdf:about="&a;100705989">
	<b:glossaryEntry>health care for the aged; a federally administered system of health insurance available to persons aged 65 and over</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100706159">
	<b:glossaryEntry>health care for the needy; a federally and state-funded program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100706277"
	 b:glossaryEntry="voluntary promotion of human welfare"/>
<rdf:Description rdf:about="&a;100706393"
	 b:glossaryEntry="an activity or gift that benefits the public at large"/>
<rdf:Description rdf:about="&a;100706536">
	<b:glossaryEntry>act of giving in common with others for a common purpose especially to a charity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100706704"
	 b:glossaryEntry="a pledged contribution"/>
<rdf:Description rdf:about="&a;100706785"
	 b:glossaryEntry="voluntary contributions to aid the poor"/>
<rdf:Description rdf:about="&a;100706889"
	 b:glossaryEntry="giving money or food or clothing to a needy person"/>
<rdf:Description rdf:about="&a;100706993"
	 b:glossaryEntry="transactions having the objective of supplying commodities"/>
<rdf:Description rdf:about="&a;100707408">
	<b:glossaryEntry>the commercial exchange (buying and selling on domestic or international markets) of goods and services; "Venice was an important center of trade with the East"; "they are accused of conspiring to constrain trade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100707691"
	 b:glossaryEntry="international trade free of government interference"/>
<rdf:Description rdf:about="&a;100707799">
	<b:glossaryEntry>reciprocal transfer of equivalent sums of money especially the currencies of different countries: "he earns his living from the interchange of currency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100708074"
	 b:glossaryEntry="act of exchanging one type of money or security for another"/>
<rdf:Description rdf:about="&a;100708190">
	<b:glossaryEntry>disposing of money or property with the expectation that the same thing (or an equivalent) will be returned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100708351">
	<b:glossaryEntry>a kind of hedged investment meant to capture slight differences in price; when there is a difference in the price of something on two different markets the arbitrageur simultaneously buys at the lower price and sells at the higher price</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100708661">
	<b:glossaryEntry>arbitrage involving risk; as in the simultaneous purchase of stock in a target company and sale of stock in its potential acquirer; if the takeover fails the arbitrageur may lose a great deal of money</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100708943"
	 b:glossaryEntry="a corporation''s first offer to sell stock to the public"/>
<rdf:Description rdf:about="&a;100709093">
	<b:glossaryEntry>the activity of providing goods and services involving financial and commercial and industrial aspects; "computers are now widely used in business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100709721"
	 b:glossaryEntry="activity undertaken as part of a commercial enterprise"/>
<rdf:Description rdf:about="&a;100709934">
	<b:glossaryEntry>a business especially one run on a large scale: "a large-scale farming operation"; "a multinational operation"; they paid taxes on every stage of the operation"; "they had to consolidate their operations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100710194">
	<b:glossaryEntry>the volume of business activity: "business is good today"; "show me where the business was today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100710382">
	<b:glossaryEntry>the business given to a commercial establishment by its customers: "even before noon there was a considerable patronage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100710584">
	<b:glossaryEntry>(informal) any enterprise in which losses and gains cancel out</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100710697"
	 b:glossaryEntry="habitual patronage"/>
<rdf:Description rdf:about="&a;100710768"
	 b:glossaryEntry="very large and profitable volume of commercial activity"/>
<rdf:Description rdf:about="&a;100710890">
	<b:glossaryEntry>a particular kind of commercial enterprise; "they are outstanding in their field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100711063">
	<b:glossaryEntry>the world of commercial activity where goods and services are bought and sold; "without competition there would be no market"; "they were driven from the marketplace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100711405"
	 b:glossaryEntry="a market in which more people want to sell than want to buy"/>
<rdf:Description rdf:about="&a;100711525"
	 b:glossaryEntry="a market in which more people want to buy than want to sell"/>
<rdf:Description rdf:about="&a;100711646">
	<b:glossaryEntry>the market in which workers compete for jobs and employers compete for workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100711783"
	 b:glossaryEntry="a commercial enterprise owned by the people who work for it"/>
<rdf:Description rdf:about="&a;100711940"
	 b:glossaryEntry="the commercial activity of providing funds and capital"/>
<rdf:Description rdf:about="&a;100712138"
	 b:glossaryEntry="the act of financing"/>
<rdf:Description rdf:about="&a;100712224">
	<b:glossaryEntry>large and complex financial transactions (often used with the implication that those individuals or institutions who engage in them are unethical)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100712429">
	<b:glossaryEntry>the act of investing; laying out money or capital in an enterprise with the expectation of profit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100712631">
	<b:glossaryEntry>investing with borrowed money as a way to amplify potential gains (at the risk of greater losses)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100712796"
	 b:glossaryEntry="financing a commercial enterprise by bond or stock shares"/>
<rdf:Description rdf:about="&a;100712922"
	 b:glossaryEntry="transacting business with a bank"/>
<rdf:Description rdf:about="&a;100713008"
	 b:glossaryEntry="engaging in the business of banking"/>
<rdf:Description rdf:about="&a;100713097"
	 b:glossaryEntry="a commercial enterprise run for the benefit of its owners"/>
<rdf:Description rdf:about="&a;100713220"
	 b:glossaryEntry="the business of selling merchandise at a discount"/>
<rdf:Description rdf:about="&a;100713333"
	 b:glossaryEntry="the business of selling real estate"/>
<rdf:Description rdf:about="&a;100713435">
	<b:glossaryEntry>the business of drawing public attention to goods and services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100713637"
	 b:glossaryEntry="forceful and insistent advertising"/>
<rdf:Description rdf:about="&a;100713727"
	 b:glossaryEntry="suggestive or persuasive advertising"/>
<rdf:Description rdf:about="&a;100713819"
	 b:glossaryEntry="circulating printed notices as a means of advertising"/>
<rdf:Description rdf:about="&a;100713952"
	 b:glossaryEntry="the business of publishing"/>
<rdf:Description rdf:about="&a;100714121">
	<b:glossaryEntry>(computer science) the use of microcomputers with graphics capacity to produce printed materials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100714282"
	 b:glossaryEntry="publishing again"/>
<rdf:Description rdf:about="&a;100714373">
	<b:glossaryEntry>a writing for publication especially one of a collection of writings as an article or story</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100714523"
	 b:glossaryEntry="publication in serial form"/>
<rdf:Description rdf:about="&a;100714625"
	 b:glossaryEntry="the craft of composing type and printing from it"/>
<rdf:Description rdf:about="&a;100714730"
	 b:glossaryEntry="the business of printing"/>
<rdf:Description rdf:about="&a;100714845"
	 b:glossaryEntry="intaglio printing"/>
<rdf:Description rdf:about="&a;100714934"
	 b:glossaryEntry="using photography to produce a plate for printing"/>
<rdf:Description rdf:about="&a;100715056"
	 b:glossaryEntry="the act of issuing printed materials"/>
<rdf:Description rdf:about="&a;100715158"
	 b:glossaryEntry="the business of packaging"/>
<rdf:Description rdf:about="&a;100715239"
	 b:glossaryEntry="providing food and services"/>
<rdf:Description rdf:about="&a;100715321"
	 b:glossaryEntry="a large-scale farming enterprise"/>
<rdf:Description rdf:about="&a;100715426"
	 b:glossaryEntry="growing vegetables for the market"/>
<rdf:Description rdf:about="&a;100715519">
	<b:glossaryEntry>the commercial activity involved in constructing buildings; "their main business is home construction"; "workers in the building trades"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100715838"
	 b:glossaryEntry="construction of inferior buildings for a quick profit"/>
<rdf:Description rdf:about="&a;100715952"
	 b:glossaryEntry="the act of laying slates for a roof"/>
<rdf:Description rdf:about="&a;100716041">
	<b:glossaryEntry>the commercial enterprise of transporting goods and materials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100716331">
	<b:glossaryEntry>ship traffic; "the channel will be open to navigation as soon as the ice melts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100716467">
	<b:glossaryEntry>transportation by airplanes (especially when other means of access are blocked)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100716600"
	 b:glossaryEntry="the activity of transporting goods by truck"/>
<rdf:Description rdf:about="&a;100716726"
	 b:glossaryEntry="the work of carting"/>
<rdf:Description rdf:about="&a;100716809">
	<b:glossaryEntry>transporting goods commercially at rates cheaper than express rates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100716943"
	 b:glossaryEntry="rapid transport of goods"/>
<rdf:Description rdf:about="&a;100717034">
	<b:glossaryEntry>transportation of (household or office) belongings to a new address</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100717167"
	 b:glossaryEntry="transport by boat or aircraft"/>
<rdf:Description rdf:about="&a;100717259"
	 b:glossaryEntry="trade from upper-class customers"/>
<rdf:Description rdf:about="&a;100717352">
	<b:glossaryEntry>the act of transacting within or between groups (as carrying on commercial activities); "no transactions are possible without him"; "he has always been honest is his dealings with me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100717794">
	<b:glossaryEntry>transactions of professional or public interest; "news of current affairs"; "great affairs of state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100717966">
	<b:glossaryEntry xml:space='preserve'><![CDATA[affairs between nations; "you can''t really keep up with world affairs by watching television"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100718143">
	<b:glossaryEntry>financial transactions at a brokerage; having to do with the execution of trades and keeping customer records</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100718330"
	 b:glossaryEntry="transferring ownership"/>
<rdf:Description rdf:about="&a;100718494">
	<b:glossaryEntry>act of transferring property title from one person to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100718679"
	 b:glossaryEntry="act of transferring a title or right or claim to another"/>
<rdf:Description rdf:about="&a;100718791">
	<b:glossaryEntry>the voluntary transfer of something (title or possession) from one party to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100718991">
	<b:glossaryEntry>the delivery of personal property in trust by the bailor to the bailee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100719116">
	<b:glossaryEntry>the transfer of goods and services to an ally to aid in a common cause; "lend-lease during World War II was extremely generous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100719313"
	 b:glossaryEntry="transfer of property from ecclesiastical to civil possession"/>
<rdf:Description rdf:about="&a;100719451">
	<b:glossaryEntry>the act of giving something in return for something received; "deductible losses on sales or exchanges of property are allowable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100719653">
	<b:glossaryEntry>an equal exchange; "we had no money so we hd to live by barter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100719824"
	 b:glossaryEntry="the swapping of horses (accompanied by much bargaining)"/>
<rdf:Description rdf:about="&a;100719953">
	<b:glossaryEntry>act of exchanging favors for mutual gain; especially trading of influence or votes among legislators to gain passage of certain projects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100720146">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a particular instance of buying or selling; "it was a package deal"; "I had no further trade with him"; "he''s a master of the business deal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100720397"
	 b:glossaryEntry="a deal to provide military arms"/>
<rdf:Description rdf:about="&a;100720484"
	 b:glossaryEntry="a business deal on a trivial scale"/>
<rdf:Description rdf:about="&a;100720575">
	<b:glossaryEntry>a transaction in the stock market at a price below the price of the preceding transaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100720737">
	<b:glossaryEntry>a transaction in the stock market at a price above the price of the preceding transaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100720897"
	 b:glossaryEntry="obtaining funds from a lender"/>
<rdf:Description rdf:about="&a;100721000">
	<b:glossaryEntry>borrowing and leaving an article as security for repayment of the loan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100721131"
	 b:glossaryEntry="the act of renting (an apartment or house or car)"/>
<rdf:Description rdf:about="&a;100721243">
	<b:glossaryEntry>the commercial activity of buying and bringing in goods from a foreign country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100721409">
	<b:glossaryEntry>the commercial activity of selling and shipping good to a foreign country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100721552">
	<b:glossaryEntry>secretly importing prohibited goods or goods on which duty is due</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100721691">
	<b:glossaryEntry>the smuggling of guns and ammunition into a country secretly and illegally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100721822">
	<b:glossaryEntry>the commercial activity of transporting and selling goods from a producer to a consumer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100721968"
	 b:glossaryEntry="the exchange of goods for an agreed sum of money"/>
<rdf:Description rdf:about="&a;100722332"
	 b:glossaryEntry="buying and selling; especially illicit trade"/>
<rdf:Description rdf:about="&a;100722484"
	 b:glossaryEntry="traffic in illegal drugs"/>
<rdf:Description rdf:about="&a;100722567"
	 b:glossaryEntry="traffic in ecclesiastical offices or preferments"/>
<rdf:Description rdf:about="&a;100722668">
	<b:glossaryEntry>traffic in slaves; especially in Black Africans transported to America in the 16th to 19th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100722842">
	<b:glossaryEntry>the selling of goods to consumers; usually in small quantities and not for resale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100722994">
	<b:glossaryEntry>the selling of goods to merchants; usually in large quantities for resale to consumers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100723154">
	<b:glossaryEntry>a particular instance of selling; "he has just made his first sale"; "they had to complete the sale before the banks closed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100723329">
	<b:glossaryEntry>the activity of persuading someone to buy; "it was a hard sell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100723443">
	<b:glossaryEntry>selling goods abroad at a price below that charged in the domestic market</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100723570">
	<b:glossaryEntry>the activities involved in selling commodities directly to consumers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100723694">
	<b:glossaryEntry>the use of the telephone as an interactive medium for promotion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100723849">
	<b:glossaryEntry>automatic transmission and measurement of data from remote sources by wire or radio or other means</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100724003"
	 b:glossaryEntry="the measurement of temperature"/>
<rdf:Description rdf:about="&a;100724091"
	 b:glossaryEntry="receiving orders via telephone"/>
<rdf:Description rdf:about="&a;100724183"
	 b:glossaryEntry="selling goods for a living"/>
<rdf:Description rdf:about="&a;100724296">
	<b:glossaryEntry>a commercial undertaking that risks a loss but promises a profit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100724414"
	 b:glossaryEntry="the measurement of viscosity"/>
<rdf:Description rdf:about="&a;100724499"
	 b:glossaryEntry="the selling of something purchased"/>
<rdf:Description rdf:about="&a;100724586">
	<b:glossaryEntry>the general activity of selling; "they tried to boost sales"; "laws limit the sale of handguns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100724768">
	<b:glossaryEntry>an occasion (usually brief) for buying at specially reduced prices; "they held a sale to reduce their inventory"; "I got some great bargains at their annual sale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100725119"
	 b:glossaryEntry='a sale of miscellany; often for charity; "the church bazaar"'/>
<rdf:Description rdf:about="&a;100725239"
	 b:glossaryEntry="a sale to reduce inventory"/>
<rdf:Description rdf:about="&a;100725353"
	 b:glossaryEntry="a sale intended to dispose of all remaing stock"/>
<rdf:Description rdf:about="&a;100725455"
	 b:glossaryEntry="a sale of merchandise damaged by fire"/>
<rdf:Description rdf:about="&a;100725548"
	 b:glossaryEntry="a sale of donated articles"/>
<rdf:Description rdf:about="&a;100725647"
	 b:glossaryEntry="a sale of household linens"/>
<rdf:Description rdf:about="&a;100725730"
	 b:glossaryEntry="the act of paying money"/>
<rdf:Description rdf:about="&a;100726020"
	 b:glossaryEntry="the act of paying too much"/>
<rdf:Description rdf:about="&a;100726104"
	 b:glossaryEntry="payment in advance"/>
<rdf:Description rdf:about="&a;100726179"
	 b:glossaryEntry="the act of paying less than required"/>
<rdf:Description rdf:about="&a;100726274"
	 b:glossaryEntry="giving in acknowledgment of obligation"/>
<rdf:Description rdf:about="&a;100726368"
	 b:glossaryEntry="the act of spending or disbursing money"/>
<rdf:Description rdf:about="&a;100726534"
	 b:glossaryEntry="the act of spending money for goods or services"/>
<rdf:Description rdf:about="&a;100726651">
	<b:glossaryEntry>spending money raised by borrowing; used by governments to stimulate their economy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100726835">
	<b:glossaryEntry>the act of paying for goods or services or to recompense for losses; "adequate remuneration for his work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100726999"
	 b:glossaryEntry="payment for the release of someone"/>
<rdf:Description rdf:about="&a;100727086"
	 b:glossaryEntry="the act of returning money received previously"/>
<rdf:Description rdf:about="&a;100727197">
	<b:glossaryEntry>payment of an obligation in a series of installments or transfers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100727336">
	<b:glossaryEntry>the reduction of the value of an asset by prorating its cost over a period of years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100727493"
	 b:glossaryEntry="payment by one nation for protection by another"/>
<rdf:Description rdf:about="&a;100727594">
	<b:glossaryEntry>the movement of a group of people from one country or locality to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100727777"
	 b:glossaryEntry="a large migration of people to a newly discovered gold field"/>
<rdf:Description rdf:about="&a;100727893">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a headlong rush of people on a common impulse; "when he shouted `fire'' there was a stampede to the exits"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100728053"
	 b:glossaryEntry="control exerted (actively or passively) by group action"/>
<rdf:Description rdf:about="&a;100728547">
	<b:glossaryEntry>social control achieved as a manifestation of self-will or consent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100728675">
	<b:glossaryEntry>a mechanism of social control for enforcing a society''s standards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100728795"
	 b:glossaryEntry="control over the growth of population; a government program"/>
<rdf:Description rdf:about="&a;100728919">
	<b:glossaryEntry>the act of governing; exercising authority; "regulations for the government of state prisons"; "he had considerable experience of government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100729178"
	 b:glossaryEntry="government that is inefficient or dishonest"/>
<rdf:Description rdf:about="&a;100729291"
	 b:glossaryEntry="the act of legislating"/>
<rdf:Description rdf:about="&a;100729415"
	 b:glossaryEntry="the craft and science of making wine"/>
<rdf:Description rdf:about="&a;100729508"
	 b:glossaryEntry="the passing of a law by a legislative body"/>
<rdf:Description rdf:about="&a;100729616"
	 b:glossaryEntry="the act of enforcing"/>
<rdf:Description rdf:about="&a;100729766"
	 b:glossaryEntry="the act of compelling by force of authority"/>
<rdf:Description rdf:about="&a;100729882">
	<b:glossaryEntry>the act of accomplishing some aim or executing some order; "the agency was created for the implementation of the policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100730090"
	 b:glossaryEntry="the act of imposing something (as a tax or an embargo)"/>
<rdf:Description rdf:about="&a;100730268">
	<b:glossaryEntry>the imposition of duties or quotas on imports in order to protect domestic industry against foreign competition; "he made trade protection a plank in the party platform"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100730513"
	 b:glossaryEntry="insuring obedience to the laws"/>
<rdf:Description rdf:about="&a;100730623">
	<b:glossaryEntry>the actions of a vigilance committee in trying to enforce the laws</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100730747"
	 b:glossaryEntry="social control by dominating"/>
<rdf:Description rdf:about="&a;100730886"
	 b:glossaryEntry="domination of a political organization by a party boss"/>
<rdf:Description rdf:about="&a;100730994"
	 b:glossaryEntry="the act of mastering or subordinating someone"/>
<rdf:Description rdf:about="&a;100731109">
	<b:glossaryEntry>domination (of a market or commodity) to the exclusion of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100731251">
	<b:glossaryEntry>the adoption of the behavior patterns of the surrounding culture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100731443"
	 b:glossaryEntry="socialization through training and education"/>
<rdf:Description rdf:about="&a;100731545">
	<b:glossaryEntry>raising someone to be an accepted member of the community; "they debated whether nature or nurture was more important"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100731811">
	<b:glossaryEntry>the social force that binds you to your obligations and the courses of action demanded by that force: "we must instill a sense of duty in our children"; "every right implies a responsibility; every opportunity, an obligation; every possession, a duty"- John D.Rockefeller Jr</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100732418">
	<b:glossaryEntry>an obligation arising out of considerations of right and wrong; "he did it out of a feeling of moral obligation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100732593">
	<b:glossaryEntry>the obligation of those of high rank to be honorable and generous (often used ironically)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100732744"
	 b:glossaryEntry="the duty of proving a disputed charge"/>
<rdf:Description rdf:about="&a;100732843"
	 b:glossaryEntry="the responsibilities of a citizen"/>
<rdf:Description rdf:about="&a;100732956"
	 b:glossaryEntry="duty of a child to its parents"/>
<rdf:Description rdf:about="&a;100733062"
	 b:glossaryEntry="some duty that is essential and urgent"/>
<rdf:Description rdf:about="&a;100733157"
	 b:glossaryEntry="a duty that is incumbent upon you"/>
<rdf:Description rdf:about="&a;100733247"
	 b:glossaryEntry="acts which the law requires be done or forborne"/>
<rdf:Description rdf:about="&a;100733369">
	<b:glossaryEntry>the legal duty of a fiduciary to act in the best interests of the beneficiary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100733507">
	<b:glossaryEntry>the care that a reasonable man would exercise under the circumstances; the standard for determining legal duty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100733706">
	<b:glossaryEntry>greater care than is normally bestowed by prudent persons; "the pilot exercised great care in landing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100733865"
	 b:glossaryEntry="such care as a careless or inattentive person would exercise"/>
<rdf:Description rdf:about="&a;100733983"
	 b:glossaryEntry="all that is normally required in some area of responsibility"/>
<rdf:Description rdf:about="&a;100734102">
	<b:glossaryEntry>the supposed responsibility of the white race to take of their non-white subjects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100734248">
	<b:glossaryEntry xml:space='preserve'><![CDATA[behavior intended to please your parents; "their children were never very strong on obedience"; "he went to law school out of respect for his father''s wishes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100734472">
	<b:glossaryEntry>the control of a country by military forces of a foreign power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100734610">
	<b:glossaryEntry>the act of managing something; "he was given overall management of the program"; "is the direction of the economy a function of government?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100735028">
	<b:glossaryEntry>the direction of an orchestra or choir; "he does not use a baton for conducting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100735165">
	<b:glossaryEntry>the management of money and credit and banking and investments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100735299"
	 b:glossaryEntry="the management of a houshold"/>
<rdf:Description rdf:about="&a;100735384"
	 b:glossaryEntry="management that is careless or inefficient"/>
<rdf:Description rdf:about="&a;100735486">
	<b:glossaryEntry>the management of someone or something; "the handling of prisoners" or "the treatment of water sewage"; "the right to equal treatment in the criminal justice system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100735754">
	<b:glossaryEntry>method or manner of conduct in relation to others: "honest dealing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100735875"
	 b:glossaryEntry="brief and unsympathetic treatment"/>
<rdf:Description rdf:about="&a;100735967">
	<b:glossaryEntry>management by overseeing the performance or operation of a person or group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100736161">
	<b:glossaryEntry>(British) keeping watch over examination candidates to prevent cheating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100736291">
	<b:glossaryEntry>administration of the line functions of an organization; administration of activities contributing directly to the organization''s output</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100736489"
	 b:glossaryEntry="a method of tending to (especially business) matters"/>
<rdf:Description rdf:about="&a;100736721">
	<b:glossaryEntry>the administration of law; the act of determining rights and assigning rewards or punishments; "justice deferred is justice denied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100736919"
	 b:glossaryEntry="the way of administering a business"/>
<rdf:Description rdf:about="&a;100737011">
	<b:glossaryEntry>the act of organizing a business or business-related activity; "he was brought in to supervise the organization of a new department"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100737271">
	<b:glossaryEntry>the act of administering or being in charge of something; "he has responsibility for the running of two companies at the same time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100737456">
	<b:glossaryEntry>shrewd or crafty management of public affairs; "we was innocent of stratagems and polity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100737598"
	 b:glossaryEntry="the act of imposing a new organization"/>
<rdf:Description rdf:about="&a;100737725">
	<b:glossaryEntry>organizing yourself (especially organizing your own labor union)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100737873"
	 b:glossaryEntry="organizing into or administering as a syndicate"/>
<rdf:Description rdf:about="&a;100737978"
	 b:glossaryEntry="the act of authorizing"/>
<rdf:Description rdf:about="&a;100738216">
	<b:glossaryEntry>the act of final authorization; "it had the sanction of the church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100738404"
	 b:glossaryEntry="the act of giving a formal (usually written) authorization"/>
<rdf:Description rdf:about="&a;100738610"
	 b:glossaryEntry="sanction by the church"/>
<rdf:Description rdf:about="&a;100738696">
	<b:glossaryEntry>by the sanction or authority of; "halt in the name of the law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100738809"
	 b:glossaryEntry="authoritative approval"/>
<rdf:Description rdf:about="&a;100738890"
	 b:glossaryEntry="the act of certifying"/>
<rdf:Description rdf:about="&a;100739025"
	 b:glossaryEntry="the act of withdrawing certification"/>
<rdf:Description rdf:about="&a;100739144">
	<b:glossaryEntry>the act of certifying that an educational institution maintains suitable standards; "a commission is responsible for the accreditation of medical schools"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100739358"
	 b:glossaryEntry="the act of granting authority to undertake certain functions"/>
<rdf:Description rdf:about="&a;100739509">
	<b:glossaryEntry>(politics) the commission that is given to a government and its policies through an electoral victory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100739664"
	 b:glossaryEntry="authorizing subordinates to make certain decisions"/>
<rdf:Description rdf:about="&a;100739841">
	<b:glossaryEntry>the delegation of authority (especially from a central to a regional government)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100739992"
	 b:glossaryEntry="formal authorization to get a loan (usually from a bank)"/>
<rdf:Description rdf:about="&a;100740108"
	 b:glossaryEntry="routine authorization of an action without questions"/>
<rdf:Description rdf:about="&a;100740219">
	<b:glossaryEntry>permission to proceed; "the plane was given clearance to land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100740337"
	 b:glossaryEntry='formal permission to depart; "he gave me his conge"'/>
<rdf:Description rdf:about="&a;100740440">
	<b:glossaryEntry>the act of allowing; "He objected to the allowance of smoking in the diningroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100740594"
	 b:glossaryEntry="an exemption from some rule or obligation"/>
<rdf:Description rdf:about="&a;100740694"
	 b:glossaryEntry="management through specified channels of communication"/>
<rdf:Description rdf:about="&a;100740856"
	 b:glossaryEntry="the production of a canal or a conversion to canals"/>
<rdf:Description rdf:about="&a;100740981"
	 b:glossaryEntry="the activity of preparing"/>
<rdf:Description rdf:about="&a;100741201"
	 b:glossaryEntry="the distribution of forces in preparation for battle or work"/>
<rdf:Description rdf:about="&a;100741336">
	<b:glossaryEntry>the withdrawal and redistribution of forces in an attempt to use them more effectively</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100741497"
	 b:glossaryEntry="final preparation and adjustments"/>
<rdf:Description rdf:about="&a;100741586"
	 b:glossaryEntry="the act of making something ready"/>
<rdf:Description rdf:about="&a;100741673">
	<b:glossaryEntry>an act of formulating a program for a definite course of action; "the planning was more fun than the trip itself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100741877"
	 b:glossaryEntry="setting an order and time for planned events"/>
<rdf:Description rdf:about="&a;100741992">
	<b:glossaryEntry>act or process of unloading and loading and servicing a vessel or aircraft for a return trip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100742153"
	 b:glossaryEntry="exercising in preparation for strenuous activity"/>
<rdf:Description rdf:about="&a;100742277"
	 b:glossaryEntry="the act of guiding or showing the way"/>
<rdf:Description rdf:about="&a;100742390">
	<b:glossaryEntry>a sudden and decisive change of government illegally or by force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100742557"
	 b:glossaryEntry="the act of restraining"/>
<rdf:Description rdf:about="&a;100742779">
	<b:glossaryEntry>a figurative restraint; "a collar on program trading in the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100742905">
	<b:glossaryEntry>a depressing restraint; "rain put a damper on our picnic plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100743021">
	<b:glossaryEntry>the act of restraining power or action or limiting excess; "his common sense is a bridle to his quick temper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100743198">
	<b:glossaryEntry>the act of limiting movement or making incapable of movement: "immobilizing the injured knee was necessary"; "the storm caused complete immobilization of the rescue team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100743461"
	 b:glossaryEntry="restraint of a person''s liberty"/>
<rdf:Description rdf:about="&a;100743598">
	<b:glossaryEntry>the act of confining someone in a prison (or as if in a prison)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100743769"
	 b:glossaryEntry="confinement to your own home"/>
<rdf:Description rdf:about="&a;100743856"
	 b:glossaryEntry="confinement without legal authority"/>
<rdf:Description rdf:about="&a;100743956"
	 b:glossaryEntry='holding by the police; "the suspect is in custody"'/>
<rdf:Description rdf:about="&a;100744060">
	<b:glossaryEntry>the act of containing; "the army was charged with the containment of the rebel forces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100744204"
	 b:glossaryEntry="the act of suppressing"/>
<rdf:Description rdf:about="&a;100744316"
	 b:glossaryEntry="severely repressive actions"/>
<rdf:Description rdf:about="&a;100744399"
	 b:glossaryEntry="the imposition of order or discipline"/>
<rdf:Description rdf:about="&a;100744496"
	 b:glossaryEntry="imposition again"/>
<rdf:Description rdf:about="&a;100744571"
	 b:glossaryEntry="the act of restricting by restraint"/>
<rdf:Description rdf:about="&a;100744736">
	<b:glossaryEntry>restriction imposed by the government on documents or weapons that are available only to certain authorized people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100744929">
	<b:glossaryEntry>reduction by the government of restrictions on a classified document or weapon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100745088">
	<b:glossaryEntry>a restriction that is insisted upon as a condition for an agreement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100745229"
	 b:glossaryEntry="the act of circumscribing"/>
<rdf:Description rdf:about="&a;100745316"
	 b:glossaryEntry="the act of constraining"/>
<rdf:Description rdf:about="&a;100745414"
	 b:glossaryEntry="restrictions placed on the immature"/>
<rdf:Description rdf:about="&a;100745513"
	 b:glossaryEntry="the action or process of constricting or squeezing"/>
<rdf:Description rdf:about="&a;100745676"
	 b:glossaryEntry="decrease in the diameter of blood vessels"/>
<rdf:Description rdf:about="&a;100745780"
	 b:glossaryEntry="act of depriving"/>
<rdf:Description rdf:about="&a;100745902"
	 b:glossaryEntry="the act of making poor"/>
<rdf:Description rdf:about="&a;100746001">
	<b:glossaryEntry>the act of starving; "they were charged with the starvation of children in their care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100746155"
	 b:glossaryEntry="the act of appeasing"/>
<rdf:Description rdf:about="&a;100746279"
	 b:glossaryEntry="the act of pacifying"/>
<rdf:Description rdf:about="&a;100746374"
	 b:glossaryEntry="the act of placating"/>
<rdf:Description rdf:about="&a;100746480"
	 b:glossaryEntry="the act of bringing something under international control"/>
<rdf:Description rdf:about="&a;100746627">
	<b:glossaryEntry>changing something from private to state ownership or control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100746822">
	<b:glossaryEntry>changing something from state to private ownership or control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100746985">
	<b:glossaryEntry>the act of causing tribal people to abandon their customs and adopt urban ways of living</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100747153">
	<b:glossaryEntry>the organization of a nation or economy on the basis of collectivism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100747303"
	 b:glossaryEntry="the organization of a nation of the basis of communism"/>
<rdf:Description rdf:about="&a;100747433">
	<b:glossaryEntry>unfair treatment of a person or group on the basis of prejudice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100747710">
	<b:glossaryEntry>(politics) granting favors or giving contracts or making appointments to office in return for political support</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100747895">
	<b:glossaryEntry>the system of patronage in Communist countries; controlled by committees in the Communist Party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100748049"
	 b:glossaryEntry="discrimination in favor of the able-bodied"/>
<rdf:Description rdf:about="&a;100748185"
	 b:glossaryEntry="discrimination against middle-aged and elderly people"/>
<rdf:Description rdf:about="&a;100748299"
	 b:glossaryEntry="discrimination against people who are overweight"/>
<rdf:Description rdf:about="&a;100748410">
	<b:glossaryEntry>discrimination in favor of heterosexual and against homosexual people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100748538">
	<b:glossaryEntry>favoritism shown to relatives or close friends by those in power (as by giving them jobs)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100748682">
	<b:glossaryEntry>discriminatory or abusive behavior towards members of another race</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100748813">
	<b:glossaryEntry>discriminatory or abusive behavior towards members of the opposite sex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100748954">
	<b:glossaryEntry>activity indicative of belief in the superiority of men over women</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100749110">
	<b:glossaryEntry>act of assembling and putting into readiness for war or other emergency: "mobilization of the troops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100749390"
	 b:glossaryEntry="the act of equiping with weapons in preparation for war"/>
<rdf:Description rdf:about="&a;100749593"
	 b:glossaryEntry="the act of renovating and fitting out a ship"/>
<rdf:Description rdf:about="&a;100749712"
	 b:glossaryEntry="outfitting a ship again (by repairing or replacing parts)"/>
<rdf:Description rdf:about="&a;100749821">
	<b:glossaryEntry>the act of arming again; "he opposed the rearmament of Japan after World War II"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100749958">
	<b:glossaryEntry>act of reducing or depriving of arms: "the disarmament of the aggressor nations must be complete"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100750161"
	 b:glossaryEntry="compulsory military service"/>
<rdf:Description rdf:about="&a;100750302"
	 b:glossaryEntry="the act of drafting into military service"/>
<rdf:Description rdf:about="&a;100750410">
	<b:glossaryEntry>act of changing from a war basis to a peace basis including disbanding or discharging troops: "demobilization of factories"; "immediate demobilization of the reserves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100750691"
	 b:glossaryEntry="the act of militarizing again"/>
<rdf:Description rdf:about="&a;100750783"
	 b:glossaryEntry="the imposition of a standard"/>
<rdf:Description rdf:about="&a;100750993">
	<b:glossaryEntry>the act of stabilizing; "he worked for price stabilization for farm products"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100751146">
	<b:glossaryEntry>the act of stylizing; causing to conform to a particular style</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100751324"
	 b:glossaryEntry="the act of punishing"/>
<rdf:Description rdf:about="&a;100751642">
	<b:glossaryEntry>threat of a penalty: "the policy so far is all stick and no carrot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100751761"
	 b:glossaryEntry="punishment inflicted on yourself"/>
<rdf:Description rdf:about="&a;100751875">
	<b:glossaryEntry>the act of punishing; "the offenders deserved the harsh discipline they received"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100752044">
	<b:glossaryEntry>the act of slapping on the buttocks; "he gave the brat a good spanking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100752170">
	<b:glossaryEntry>the infliction of physical injury on someone convicted of committing a crime</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100752384">
	<b:glossaryEntry>the act of inflicting corporal punishment with repeated blows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100752563"
	 b:glossaryEntry="beating with a whip or strap or rope as a form of punishment"/>
<rdf:Description rdf:about="&a;100752732">
	<b:glossaryEntry>the act of whipping with a horsewhip; "that villain needs a good horsewhipping"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100752871"
	 b:glossaryEntry="the use of electric shock as a form of punishment"/>
<rdf:Description rdf:about="&a;100752981"
	 b:glossaryEntry="putting a condemned person to death"/>
<rdf:Description rdf:about="&a;100753211"
	 b:glossaryEntry="punishment inflicted by kicking the victim in the behind"/>
<rdf:Description rdf:about="&a;100753330"
	 b:glossaryEntry="execution by fire"/>
<rdf:Description rdf:about="&a;100753442">
	<b:glossaryEntry>the burning to death of heretics (as during the Spanish Inquisition)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100753567">
	<b:glossaryEntry>a form of capital punishment; victim is suspended by the neck from a gallows or gibbet until dead; "in those days the hanging of criminals was a public entertainment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100753787"
	 b:glossaryEntry="execution by electricity"/>
<rdf:Description rdf:about="&a;100753881"
	 b:glossaryEntry="execution by cutting off the victim''s head"/>
<rdf:Description rdf:about="&a;100753994">
	<b:glossaryEntry>a method of execution widespread in the ancient world; victim''s hands and feet are bound or nailed to a cross</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100754161"
	 b:glossaryEntry="verbal punishment"/>
<rdf:Description rdf:about="&a;100754251">
	<b:glossaryEntry>punishment prohibited by the 8th amendment to the U.S. constitution; includes torture or degradation or punishment too severe for the crime committed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100754475">
	<b:glossaryEntry>punishment of a group by cutting off commercial dealings with them; "the economic strangulation of the Jews by the Nazi Party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100754670">
	<b:glossaryEntry>voluntary self-punishment in order to atone for some wrongdoing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100754825"
	 b:glossaryEntry="putting someone in prison or in jail as lawful punishment"/>
<rdf:Description rdf:about="&a;100754951"
	 b:glossaryEntry="the act of imposing a fine"/>
<rdf:Description rdf:about="&a;100755037">
	<b:glossaryEntry>the official act of consigning a person to a prison (or mental hospital)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100755192"
	 b:glossaryEntry="the reduction is severity of a punishment imposed by law"/>
<rdf:Description rdf:about="&a;100755322">
	<b:glossaryEntry xml:space='preserve'><![CDATA[punishment for one''s actions; "you have to face the music"; "take your medicine"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100755465">
	<b:glossaryEntry>the act of exchanging one thing for another; "the devil promised Adam immortality in exchange for his disobedience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100755653"
	 b:glossaryEntry="an exchange of several tennis strokes"/>
<rdf:Description rdf:about="&a;100755761"
	 b:glossaryEntry="the act of submitting; usually surrendering power to another"/>
<rdf:Description rdf:about="&a;100755927"
	 b:glossaryEntry="dutiful or submissive behavior"/>
<rdf:Description rdf:about="&a;100756049"
	 b:glossaryEntry="the act of obeying (especially in a humble manner)"/>
<rdf:Description rdf:about="&a;100756155"
	 b:glossaryEntry="submission without protest"/>
<rdf:Description rdf:about="&a;100756240"
	 b:glossaryEntry="bitter conflict; heated often violent dissension"/>
<rdf:Description rdf:about="&a;100756377"
	 b:glossaryEntry="any hard struggle between equally matched groups"/>
<rdf:Description rdf:about="&a;100756482">
	<b:glossaryEntry>actions counter to the main group activity; "political crosscurrents disrupted the conference"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100756637">
	<b:glossaryEntry>a protest action by labor or minority groups to obtain their demands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100756855">
	<b:glossaryEntry>the act of competing as for profit or a prize: "the teams were in fierce contention for first place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100757072"
	 b:glossaryEntry="a contest in which intelligence rather than violence is used"/>
<rdf:Description rdf:about="&a;100757193"
	 b:glossaryEntry="a struggle between rivals"/>
<rdf:Description rdf:about="&a;100757326"
	 b:glossaryEntry="a series of competing bids"/>
<rdf:Description rdf:about="&a;100757414"
	 b:glossaryEntry="competition (real or figurative) for popular support"/>
<rdf:Description rdf:about="&a;100757531"
	 b:glossaryEntry="group action in opposition to those in power"/>
<rdf:Description rdf:about="&a;100757776">
	<b:glossaryEntry>group refusal to resort to violence even in defense against violence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100757904">
	<b:glossaryEntry>the act of opposing groups confronting each other; "the government was not ready for a confrontation with the unions"; "the invaders encountered stiff opposition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100758157">
	<b:glossaryEntry>resistance by potential customers to aggressive selling practices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100758285"
	 b:glossaryEntry="a discordant act"/>
<rdf:Description rdf:about="&a;100758369"
	 b:glossaryEntry="a defiant act"/>
<rdf:Description rdf:about="&a;100758437"
	 b:glossaryEntry="a public act of violence by an unruly mob"/>
<rdf:Description rdf:about="&a;100758565">
	<b:glossaryEntry>a riot caused by hatred for one another of members of different races in the same community</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100758712"
	 b:glossaryEntry="coming into conflict with"/>
<rdf:Description rdf:about="&a;100758807">
	<b:glossaryEntry>the act of fighting; any contest or struggle; "a fight broke out at the hockey game"; "there was fighting in the streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100759289"
	 b:glossaryEntry="the act or art of using a sword as in fencing"/>
<rdf:Description rdf:about="&a;100759418">
	<b:glossaryEntry>conflict between members of the same organization (usually concealed from outsiders)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100759560"
	 b:glossaryEntry="a brief but vigorous fight"/>
<rdf:Description rdf:about="&a;100759639">
	<b:glossaryEntry>the violent interaction of individuals or groups entering into combat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100759769"
	 b:glossaryEntry="disorderly fighting"/>
<rdf:Description rdf:about="&a;100759879">
	<b:glossaryEntry>(informal British usage) aggravation or aggression; "I skipped it because it was too much aggro"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100760027">
	<b:glossaryEntry>a prearranged fight with deadly weapons by two people (accompanied by seconds) in order to settle a quarrel over a point of honor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100760227">
	<b:glossaryEntry>a powerful stroke with the fist or a weapon; "a blow on the head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100760722"
	 b:glossaryEntry="a return blow; a retaliatory blow"/>
<rdf:Description rdf:about="&a;100760813"
	 b:glossaryEntry='a sweeping blow or stroke; "he took a wild swing at my head"'/>
<rdf:Description rdf:about="&a;100760925"
	 b:glossaryEntry="a fight with bare fists"/>
<rdf:Description rdf:about="&a;100761046"
	 b:glossaryEntry="a thrusting blow with a knife"/>
<rdf:Description rdf:about="&a;100761150"
	 b:glossaryEntry="a sharp stinging blow"/>
<rdf:Description rdf:about="&a;100761225"
	 b:glossaryEntry="a heavy blow with the hand"/>
<rdf:Description rdf:about="&a;100761303">
	<b:glossaryEntry>a swinging blow directed upward (especially at an opponent''s chin)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100761424">
	<b:glossaryEntry>the act of pounding (delivering repeated heavy blows); "the sudden hammer of fists caught him off guard"; "the pounding of feet on the hallway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100761651">
	<b:glossaryEntry>a blow hard enough to cause injury; "he is still recovering from a shot to his leg"; "I caught him with a solid shot to the chin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100761831"
	 b:glossaryEntry="a severe blow"/>
<rdf:Description rdf:about="&a;100761897"
	 b:glossaryEntry="the act of subjecting to strong attack"/>
<rdf:Description rdf:about="&a;100762001"
	 b:glossaryEntry="the act of overcoming or outdoing"/>
<rdf:Description rdf:about="&a;100762099"
	 b:glossaryEntry="a noisy fight"/>
<rdf:Description rdf:about="&a;100762195"
	 b:glossaryEntry="a noisy fight in a crowd"/>
<rdf:Description rdf:about="&a;100762286"
	 b:glossaryEntry="fighting with knives"/>
<rdf:Description rdf:about="&a;100762395"
	 b:glossaryEntry="a fight between rival gangs of adolescents"/>
<rdf:Description rdf:about="&a;100762503"
	 b:glossaryEntry="deliberate interference"/>
<rdf:Description rdf:about="&a;100762587">
	<b:glossaryEntry>the act of protesting; a public (often organized) manifestation of dissent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100762791">
	<b:glossaryEntry>refusal to accept some authority or code or convention; "each generation must have its own rebellion"; "his body was in rebellion against fatigue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100762993"
	 b:glossaryEntry='(British) a fistfight; "the quarrel ended in a punch-up"'/>
<rdf:Description rdf:about="&a;100763104">
	<b:glossaryEntry>a public display of group feelings; "there were violent demonstrations against the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100763287">
	<b:glossaryEntry>a form of civil disobedience in which demonstrators occupy seats and refuse to move</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100763423">
	<b:glossaryEntry>occasion when workers continue to work as a protest against e.g. proposed dismissal or closure of the factory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100763586">
	<b:glossaryEntry>occasion when can express opposition by marching (usually on some government institution) without a license</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100763753"
	 b:glossaryEntry="an insubordinate act"/>
<rdf:Description rdf:about="&a;100763888">
	<b:glossaryEntry>obstinate rebelliousness and insubordination; resistance to authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100764013"
	 b:glossaryEntry="the failure to obey"/>
<rdf:Description rdf:about="&a;100764161">
	<b:glossaryEntry>a group''s refusal to obey orders in protest against discrimination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100764310">
	<b:glossaryEntry>a willful disobedience to or disrespect for the authority of a court or legislative body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100764489">
	<b:glossaryEntry>deliberate obstruction of the operation of the federal legislative branch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100764629"
	 b:glossaryEntry="disrespect for the rules of a court of law"/>
<rdf:Description rdf:about="&a;100764753">
	<b:glossaryEntry>willful refusal to appear before a court or comply with a court order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100764878">
	<b:glossaryEntry>the administration of justice according to established rules and principles; based on the principle that a person cannot be deprived of life or liberty or property without appropriate legal procedures and safeguards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100765298">
	<b:glossaryEntry>a judicial proceeding brought by one party against another; one party prosecutes another for a wrong done or for protection of a right or for prevention of a wrong</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100765635">
	<b:glossaryEntry>an act by a government body or supranational organization; "recent federal action undermined the segregationist position"; "the United Nations must have the power to propose and organize action without being hobbled by irrelevant issues"; "the Union action of emancipating Southern slaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100765977">
	<b:glossaryEntry>(law) a comprehensive term for any proceeding in a court of law whereby an individual seeks a legal remedy; "the family brought suit against the landlord"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100766215">
	<b:glossaryEntry>a legal action brought against parties who are charged with limiting free competition in the market place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100766381">
	<b:glossaryEntry>a claim filed in opposition to another claim in a legal action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100766502">
	<b:glossaryEntry>a legal action to determine custody (usually of children following a divorce)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100766638">
	<b:glossaryEntry>a representative legal action whose outcome is likely to become a precedent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100766781"
	 b:glossaryEntry="a pending lawsuit"/>
<rdf:Description rdf:about="&a;100766856">
	<b:glossaryEntry>the institution of a sequence of steps by which legal judgments are invoked</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100767259">
	<b:glossaryEntry>a legal proceeding in which the appellant resorts to a higher court for the purpose of obtaining a review of a lower court decision and a reversal of the lower court''s judgment or the granting of a new trial</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100767519">
	<b:glossaryEntry>a judgment by a higher court that the judgment of a lower court was incorrect and should be set aside</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100767693">
	<b:glossaryEntry>a judgment by a higher court that the judgment of a lower court was correct and should stand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100767861">
	<b:glossaryEntry>a legal process intended to insure equality among the creditors of a corporation declared in bankruptcy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100768021">
	<b:glossaryEntry>a court action that places property under the control of a receiver during litigation so that it can be preserved for the benefit of all</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100768216"
	 b:glossaryEntry="a judicial proceeding"/>
<rdf:Description rdf:about="&a;100768312">
	<b:glossaryEntry>litigation to settle custody of the children of a divorced couple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100768438">
	<b:glossaryEntry>an accusation of crime made by a grand jury on its own initiative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100768576"
	 b:glossaryEntry="the proceeding whereby a foreigner is granted citizenship"/>
<rdf:Description rdf:about="&a;100768711">
	<b:glossaryEntry>the determination by a court of competent jurisdiction on matters submitted to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100769113">
	<b:glossaryEntry>a judgment entered after a written confession by the debtor without the expense of ordinary legal proceedings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100769358">
	<b:glossaryEntry>a judgment entered in favor of the plaintiff when the defendant defaults (fails to appear in court)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100769585">
	<b:glossaryEntry>a judgment entered in favor of the defendant when the plaintiff has not continued his action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100769750">
	<b:glossaryEntry>a judgment disposing of the case before the court; after the judgment (or an appeal from it) is rendered all that remains is to enforce the judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100770012">
	<b:glossaryEntry>a final judgment of guilty in a criminal case and the punishment that is imposed; "the conviction came as no surprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100770295">
	<b:glossaryEntry>a judgment rendered against an individual (or corporation) for the payment of money damages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100770536">
	<b:glossaryEntry>a judgment pronounced on the status of some particular subject or property or thing (as opposed to one pronounced on persons)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100770760"
	 b:glossaryEntry="a judgment disposing of the matter without a trial"/>
<rdf:Description rdf:about="&a;100770915">
	<b:glossaryEntry>judgment rendered through analysis and adjudication of the factual issues presented</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100771093">
	<b:glossaryEntry>a judgment rendered by the court prior to a verdict because no material issue of fact exists and one party or the other is entitled to a judgment as a matter of law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100771397">
	<b:glossaryEntry>the act of deciding as an arbiter; giving authoritative judgment; "they submitted their disagreement to arbitration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100771599">
	<b:glossaryEntry>the reason for a court''s judgment (as opposed to the decision itself)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100771749">
	<b:glossaryEntry>a ruling by the Supreme Court on affirmative action; the Court ruled in 1978 that medical schools are entitled to consider race as a factor in their admission policy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100771975">
	<b:glossaryEntry>the act of pronouncing judgment based on the evidence presented</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100772115"
	 b:glossaryEntry="the act of umpiring"/>
<rdf:Description rdf:about="&a;100772241"
	 b:glossaryEntry="the decision of a court on issues of fact or law"/>
<rdf:Description rdf:about="&a;100772379">
	<b:glossaryEntry>the findings of a jury on issues of fact submitted to it for decision; can be used in formulating a judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100772667">
	<b:glossaryEntry>a finding as to the applicability of a rule of law to particular facts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100772818">
	<b:glossaryEntry>a verdict resulting from improper compromises between jurors on material issues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100772980">
	<b:glossaryEntry>a verdict entered by the court in a jury trial without consideration by the jury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100773123"
	 b:glossaryEntry="a manifestly unjust verdict; not true to the evidence"/>
<rdf:Description rdf:about="&a;100773236">
	<b:glossaryEntry>an ordinary verdict declaring which party prevails without any special findings of fact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100773403">
	<b:glossaryEntry>a finding (in criminal law) that the defendant is guilty of some charges but innocent of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100773560"
	 b:glossaryEntry="an improper and unacceptable kind of compromise verdict"/>
<rdf:Description rdf:about="&a;100773678">
	<b:glossaryEntry>a verdict rendered on certain specific factual issues posed by the court without finding for one party or the other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100773873"
	 b:glossaryEntry="a judgment of not guilty"/>
<rdf:Description rdf:about="&a;100773971"
	 b:glossaryEntry="conviction for murder"/>
<rdf:Description rdf:about="&a;100774056"
	 b:glossaryEntry="conviction for rape"/>
<rdf:Description rdf:about="&a;100774137"
	 b:glossaryEntry="conviction for robbery"/>
<rdf:Description rdf:about="&a;100774224">
	<b:glossaryEntry>the expulsion of someone (such as a tenant) from land by process of law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100774435"
	 b:glossaryEntry="a wrongful dispossession"/>
<rdf:Description rdf:about="&a;100774512">
	<b:glossaryEntry>the physical ouster of a tenant from the leased premises; the tenant is relieved of any further duty to pay rent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100774686">
	<b:glossaryEntry>action by a landlord that compels a tenant to leave the premises (as by rendering the premises unfit for occupancy); no physical expulsion or legal process is involved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100774932">
	<b:glossaryEntry>an eviction in reprisal for the tenant''s good-faith complaints against the landlord; illegal in many states</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100775106"
	 b:glossaryEntry="the act of legalizing"/>
<rdf:Description rdf:about="&a;100775201">
	<b:glossaryEntry>(law) legal proceedings consisting of the judicial examination of issues by a competent tribunal; "most of these complaints are settled before they go to trial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100775506">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(law) the determination of a person''s innocence or guilt by due process of law; "he had a fair trial and the jury found him guilty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100775725">
	<b:glossaryEntry>a trial held for show; the guilt of the accused person has been decided in advance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100775864"
	 b:glossaryEntry="a trial by court martial"/>
<rdf:Description rdf:about="&a;100775948">
	<b:glossaryEntry>(law) a judicial reexamination of the proceedings of a court (especially by an appellate court)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100776132">
	<b:glossaryEntry>a proceeding brought to obtain an explanation or an alteration or a reversal of a decree by the court that rended it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100776309">
	<b:glossaryEntry>review by a court of law of actions of a government official or entity or of some other legally appointed person or body or the review by an appellate court of the decision of a trial court</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100776560"
	 b:glossaryEntry="an answer indicating why a suit should be dismissed"/>
<rdf:Description rdf:about="&a;100776681">
	<b:glossaryEntry>the prosecution of a defendant for an offense for which he has already been tried; prohibited in the fifth amendment to the U.S. Constitution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100776884">
	<b:glossaryEntry>the institution and conduct of legal proceedings against a defendant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100777065">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a defendant''s answer or plea denying the truth of the charges against him; "he gave evidence for the defense"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100777295"
	 b:glossaryEntry="a trial that is invalid or inconclusive"/>
<rdf:Description rdf:about="&a;100777389">
	<b:glossaryEntry>a new trial in which issues already litigated and to which the court has already rendered a verdict or decision are reexamined by the same court; occurs when the initial trial is found to have been improper or unfair due to procedural errors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100777684"
	 b:glossaryEntry="an investigation (usually by a court of law)"/>
<rdf:Description rdf:about="&a;100777818">
	<b:glossaryEntry>a hearing that takes place outside the judicial process before hearing examiners who have been granted judicial authority specifically for the purpose of conducting such hearings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100778065">
	<b:glossaryEntry>a hearing to determine by what authority someone has an office or franchise or liberty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100778210">
	<b:glossaryEntry>the social act of separating or parting company; "the separation of church and state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100778442"
	 b:glossaryEntry="the legal dissolution of a marriage"/>
<rdf:Description rdf:about="&a;100778545"
	 b:glossaryEntry="the cessation of cohabitation of man and wife"/>
<rdf:Description rdf:about="&a;100778653"
	 b:glossaryEntry="isolation to prevent the spread of infectious disease"/>
<rdf:Description rdf:about="&a;100778763"
	 b:glossaryEntry="the act of secluding yourself from others"/>
<rdf:Description rdf:about="&a;100778860"
	 b:glossaryEntry="the act of isolating something"/>
<rdf:Description rdf:about="&a;100778978"
	 b:glossaryEntry="the act of segregating or sequestering"/>
<rdf:Description rdf:about="&a;100779108">
	<b:glossaryEntry>the action of incorporating a racial or religious group into a community</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100779286">
	<b:glossaryEntry>joint operation or action: "their cooperation with us was essential for the success of our mission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100779641"
	 b:glossaryEntry="cooperative work done by a team"/>
<rdf:Description rdf:about="&a;100779727"
	 b:glossaryEntry="acting according to certain accepted standards"/>
<rdf:Description rdf:about="&a;100779977"
	 b:glossaryEntry="compliance with formal rules"/>
<rdf:Description rdf:about="&a;100780079">
	<b:glossaryEntry>acting in conformity; "in line with" or "he got out of line" or "toe the line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100780208"
	 b:glossaryEntry="conformity with law or custom or practice etc."/>
<rdf:Description rdf:about="&a;100780358"
	 b:glossaryEntry="strict observance of formalities"/>
<rdf:Description rdf:about="&a;100780446"
	 b:glossaryEntry="a lack of conformity with law or custom or practice etc."/>
<rdf:Description rdf:about="&a;100780580"
	 b:glossaryEntry="failure to conform"/>
<rdf:Description rdf:about="&a;100780694">
	<b:glossaryEntry>conformity or harmony; "his behavior was not in keeping with the occasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100780822">
	<b:glossaryEntry>act of working jointly: "they worked either in collaboration or independently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100780971"
	 b:glossaryEntry="act of cooperating traitorously with an enemy"/>
<rdf:Description rdf:about="&a;100781090"
	 b:glossaryEntry="a middle way between two extremes"/>
<rdf:Description rdf:about="&a;100781192"
	 b:glossaryEntry="acting together as of agents or circumstances or events"/>
<rdf:Description rdf:about="&a;100781305"
	 b:glossaryEntry="the reestablishing of cordial relations"/>
<rdf:Description rdf:about="&a;100781421">
	<b:glossaryEntry>acting with less concern for yourself than for the success of the joint activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100781577">
	<b:glossaryEntry>the act of binding yourself (intellectually or emotionally) to a course of action; "his long commitment to public service"; "they felt no loyalty to a losing team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100781887">
	<b:glossaryEntry>commitment to some purpose; "the devotion of his time and wealth to science"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100782054">
	<b:glossaryEntry>loyalty or allegiance to a cause or a person; "keep the faith"; "they broke faith with their investors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100782209">
	<b:glossaryEntry>excessive or irrational devotion to some activity; "made a fetish of cleanliness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100782352"
	 b:glossaryEntry="devotion to a political party"/>
<rdf:Description rdf:about="&a;100782440">
	<b:glossaryEntry>the activity of contributing to the fulfillment of a need or furtherance of an effort or purpose: "he gave me an assist with the housework"; "could not walk without assistance"; "rescue party went to their aid"; "offered his help in unloading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100782988">
	<b:glossaryEntry>act of assisting or making easier the progress or improvement of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100783121"
	 b:glossaryEntry='physical assistance; "give me a hand with the chores"'/>
<rdf:Description rdf:about="&a;100783240">
	<b:glossaryEntry>act of turning to for assistance: "have recourse to the courts"; "an appeal to his uncle was his last resort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100783422">
	<b:glossaryEntry>with the help of or owing to; "thanks to hard work it was a great success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100783549">
	<b:glossaryEntry>any of various services designed to aid the poor and aged and to increase the welfare of children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100783704">
	<b:glossaryEntry>close sociological study of a maladjusted person or family for diagnosis and treatment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100783845"
	 b:glossaryEntry="assistance given in the form of money"/>
<rdf:Description rdf:about="&a;100783978">
	<b:glossaryEntry>assistance in time of difficulty; "the contributions provided some relief for the victims"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100784191"
	 b:glossaryEntry="the act of giving temporary assistance"/>
<rdf:Description rdf:about="&a;100784280"
	 b:glossaryEntry='an act of help or assistance; "he did them a service"'/>
<rdf:Description rdf:about="&a;100784441">
	<b:glossaryEntry>an act intended to help that turns out badly; "he did them a disservice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100784613"
	 b:glossaryEntry="a service involving care for other people''s children"/>
<rdf:Description rdf:about="&a;100784752"
	 b:glossaryEntry="childcare during the day while parents work"/>
<rdf:Description rdf:about="&a;100784860"
	 b:glossaryEntry="the service of ushering people to their seats"/>
<rdf:Description rdf:about="&a;100784959">
	<b:glossaryEntry>the act of providing something (lodging or seat or food) to meet a need</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100785108"
	 b:glossaryEntry="the act of giving hope or support to someone"/>
<rdf:Description rdf:about="&a;100785238">
	<b:glossaryEntry>the act of giving an upward push; "he gave her a boost over the fence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100785360">
	<b:glossaryEntry>anything that serves to increase morale; "the sight of flowers every morning was my morale builder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100785538">
	<b:glossaryEntry>the act of consoling; giving relief in affliction; "his presence was a consolation to her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100785705"
	 b:glossaryEntry="elimination of superfluous details"/>
<rdf:Description rdf:about="&a;100785836"
	 b:glossaryEntry="excessive simplification (to the point of misrepresentation)"/>
<rdf:Description rdf:about="&a;100785961">
	<b:glossaryEntry>(math) the simplification of an expression or equation by eliminating radicals without changing the value of the expression or the roots of the equation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100786193">
	<b:glossaryEntry>aiding the cause or policy or interests of; "the president no longer had the support of his own party"; "they developed a scheme of mutual support"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100786502"
	 b:glossaryEntry="faithful support for a religion or cause or political party"/>
<rdf:Description rdf:about="&a;100786666">
	<b:glossaryEntry>excessive adherence to ecclesiastical forms and activities; "their ecclesiasticism overwhelmed their religion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100786838">
	<b:glossaryEntry>adherence to tradition (especially in cultural or religious matters)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100786967">
	<b:glossaryEntry>the act of providing approval and support; "his vigorous backing of the conservatives got him in trouble with progressives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100787171">
	<b:glossaryEntry>active support especially the act of pleading or arguing for something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100787314"
	 b:glossaryEntry="the act of earnestly supporting or encouraging"/>
<rdf:Description rdf:about="&a;100787413">
	<b:glossaryEntry>kindly endorsement and guidance; "the tournament was held under the auspices of the city council"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100787586"
	 b:glossaryEntry="the act of sponsoring (either officially or financially)"/>
<rdf:Description rdf:about="&a;100787700"
	 b:glossaryEntry="the act of endorsing"/>
<rdf:Description rdf:about="&a;100787796">
	<b:glossaryEntry>the formal act of giving approval: "he gave the project his blessing"; "his decision merited the approval of any sensible person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100788093"
	 b:glossaryEntry="the act of reassuring; restoring someone''s confidence"/>
<rdf:Description rdf:about="&a;100788240">
	<b:glossaryEntry>the activity of providing for or maintaining by supplying with money or necessities; "his support kept the family together"; "they gave him emotional support during difficult times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100788511"
	 b:glossaryEntry="the act of sustaining"/>
<rdf:Description rdf:about="&a;100788641"
	 b:glossaryEntry="assistance between and within military commands"/>
<rdf:Description rdf:about="&a;100788845">
	<b:glossaryEntry>the pooling of specific resources by subscribing nations for the support of some joint operation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100789015"
	 b:glossaryEntry="arrangements made between nations to assist each other"/>
<rdf:Description rdf:about="&a;100789159">
	<b:glossaryEntry>provision of logistic (or administrative) support by one or more of the military services to one or more departments or agencies of the US government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100789402">
	<b:glossaryEntry>action by one military service to provide logistic (or administrative) support to another military service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100789600">
	<b:glossaryEntry>the act of representing; standing in for someone or some group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100789741">
	<b:glossaryEntry>representation of all parties in proportion to their popular vote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100789880"
	 b:glossaryEntry="the act of giving someone a job"/>
<rdf:Description rdf:about="&a;100790051">
	<b:glossaryEntry>a way of hiring longshoremen by the day; applicants gather around a union boss who selects those to be hired</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100790214"
	 b:glossaryEntry="the recall of an employee after a layoff"/>
<rdf:Description rdf:about="&a;100790310">
	<b:glossaryEntry>the act of reserving (a place or passage) or engaging the services of (a person or group): "wondered who had made the booking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100790504">
	<b:glossaryEntry>a favorable judgment; "a small token in admiration of your works"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100790677"
	 b:glossaryEntry="the act of admiring strongly"/>
<rdf:Description rdf:about="&a;100790819">
	<b:glossaryEntry>the act of glorifying (as in worship); "the glorification of God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100790944">
	<b:glossaryEntry>a portrayal of something as ideal; "the idealization of rural life was very misleading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100791139"
	 b:glossaryEntry="the act of indulging in sentiment"/>
<rdf:Description rdf:about="&a;100791294"
	 b:glossaryEntry="an act performed to strengthen approved behavior"/>
<rdf:Description rdf:about="&a;100791429">
	<b:glossaryEntry>promise of reward as in "carrot and stick"; "used the carrot of subsidized housing for the workers to get their vote"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100791599"
	 b:glossaryEntry="the act of disapproving or condemning"/>
<rdf:Description rdf:about="&a;100791766"
	 b:glossaryEntry="the act of speaking contemptuously of"/>
<rdf:Description rdf:about="&a;100791911"
	 b:glossaryEntry="the act of belittling"/>
<rdf:Description rdf:about="&a;100791989"
	 b:glossaryEntry="the act of depreciating"/>
<rdf:Description rdf:about="&a;100792102"
	 b:glossaryEntry="the act of defaming"/>
<rdf:Description rdf:about="&a;100792210"
	 b:glossaryEntry="manner of acting or conducting oneself"/>
<rdf:Description rdf:about="&a;100792361">
	<b:glossaryEntry>(psychology) the aggregate of the responses or reactions or movements made by an organism in any situation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100792552">
	<b:glossaryEntry>the behavior of a male animal that defines and defends its territory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100792681"
	 b:glossaryEntry="deliberately unfriendly behavior"/>
<rdf:Description rdf:about="&a;100792860"
	 b:glossaryEntry="unfriendly behavior that aggravates or irritates someone"/>
<rdf:Description rdf:about="&a;100793037">
	<b:glossaryEntry>violent and bitter exasperation; "his foolishness was followed by an exacerbation of their quarrel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100793195">
	<b:glossaryEntry>aggressive remarks and behavior like that of a spiteful malicious woman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100793321">
	<b:glossaryEntry>the act of intimidating a weaker person to make them do something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100793474"
	 b:glossaryEntry="to inspire with fear"/>
<rdf:Description rdf:about="&a;100793584"
	 b:glossaryEntry="aggravation by deriding or mocking or criticizing"/>
<rdf:Description rdf:about="&a;100793707"
	 b:glossaryEntry="making trouble just for the fun of it"/>
<rdf:Description rdf:about="&a;100793818"
	 b:glossaryEntry="the act of asserting yourself in an aggressive manner"/>
<rdf:Description rdf:about="&a;100793932">
	<b:glossaryEntry>the act of condemning (as land forfeited for public use) or judging to be unfit for use (as a food product)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100794098"
	 b:glossaryEntry="the act of stigmatizing"/>
<rdf:Description rdf:about="&a;100794210"
	 b:glossaryEntry="a lack of politeness; a failure to show regard for others"/>
<rdf:Description rdf:about="&a;100794438"
	 b:glossaryEntry="an impolite act or expression"/>
<rdf:Description rdf:about="&a;100794524"
	 b:glossaryEntry="an offensive disrespectful impudent act"/>
<rdf:Description rdf:about="&a;100794619">
	<b:glossaryEntry>a deliberately offensive act or something producing the effect of an affront; "turning his back on me was a deliberate insult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100794844"
	 b:glossaryEntry="an affront to one''s dignity or self-esteem"/>
<rdf:Description rdf:about="&a;100794942"
	 b:glossaryEntry="the act of scandalizing"/>
<rdf:Description rdf:about="&a;100795053">
	<b:glossaryEntry>a deliberate discourteous act (usually as an expression of anger or disapproval)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100795231">
	<b:glossaryEntry>a refusal to recognize someone you know; "the snub was clearly intentional"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100795379"
	 b:glossaryEntry="an aloof refusal to speak to someone you know"/>
<rdf:Description rdf:about="&a;100795487"
	 b:glossaryEntry="an act intending or showing kindness and good will"/>
<rdf:Description rdf:about="&a;100795609"
	 b:glossaryEntry="a show of affection motivated by selfishness"/>
<rdf:Description rdf:about="&a;100795713"
	 b:glossaryEntry="an act of gracious kindness"/>
<rdf:Description rdf:about="&a;100795819"
	 b:glossaryEntry='a favor for someone; "he did me a good turn"'/>
<rdf:Description rdf:about="&a;100795926"
	 b:glossaryEntry="the act of excusing a mistake or offense"/>
<rdf:Description rdf:about="&a;100796069">
	<b:glossaryEntry>a pardon by treating the offender as if the offense had not occurred</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100796195">
	<b:glossaryEntry>alleviation of distress; showing great kindness toward the distressed; "distributing food and clothing to the flood victims was an act of mercy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100796391"
	 b:glossaryEntry="the act of freeing from guilt or blame"/>
<rdf:Description rdf:about="&a;100796487"
	 b:glossaryEntry="the act of showing affection"/>
<rdf:Description rdf:about="&a;100796572"
	 b:glossaryEntry="the act of showing regard for others"/>
<rdf:Description rdf:about="&a;100796730"
	 b:glossaryEntry="a courteous or respectful or considerate act"/>
<rdf:Description rdf:about="&a;100796865">
	<b:glossaryEntry>something done as an indication of intention; "a political gesture" or "a gesture of defiance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100797031"
	 b:glossaryEntry="a gracious (but usually meaningless) gesture"/>
<rdf:Description rdf:about="&a;100797132">
	<b:glossaryEntry>a courteous act indicating affection; "she tried to win his heart with her many attentions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100797279"
	 b:glossaryEntry="polite attentiveness to women"/>
<rdf:Description rdf:about="&a;100797364">
	<b:glossaryEntry>an courteous expression (by word or deed) of esteem or regard; "his deference to her wishes was very flattering"; "be sure to give my respects to the dean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100797621"
	 b:glossaryEntry='respectful deference; "pay court to the emperor"'/>
<rdf:Description rdf:about="&a;100797730">
	<b:glossaryEntry>the act of expressing respect for someone who has died; "he paid his last respects by standing quietly at the graveside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100797910"
	 b:glossaryEntry="formal expression of respect"/>
<rdf:Description rdf:about="&a;100797991"
	 b:glossaryEntry="a considerate and thoughtful act"/>
<rdf:Description rdf:about="&a;100798100">
	<b:glossaryEntry>the social act of assembling; "they demanded the right of assembly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100798373">
	<b:glossaryEntry xml:space='preserve'><![CDATA[act of assembling or organizing and making ready for use or action: "mobiliation of the country''s economic resources"; "marshaling public support"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100798642"
	 b:glossaryEntry="mobilization of the economy"/>
<rdf:Description rdf:about="&a;100798761">
	<b:glossaryEntry>the act of mobilizing for a common purpose; "the bell was a signal for the rallying of the whole neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100798926"
	 b:glossaryEntry="the act of convoking"/>
<rdf:Description rdf:about="&a;100799023">
	<b:glossaryEntry>the social act of assembling for some common purpose; "his meeting with the salesmen was the high point of his day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100799282">
	<b:glossaryEntry>a trip made by a repairman to visit the location of something in need of service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100799421"
	 b:glossaryEntry="a secret rendezvous (especially between lovers)"/>
<rdf:Description rdf:about="&a;100799534"
	 b:glossaryEntry="a meeting planned at a certain time and place"/>
<rdf:Description rdf:about="&a;100799654"
	 b:glossaryEntry="the act of congregating"/>
<rdf:Description rdf:about="&a;100799751"
	 b:glossaryEntry="the act of convening"/>
<rdf:Description rdf:about="&a;100799840"
	 b:glossaryEntry="bringing together military forces"/>
<rdf:Description rdf:about="&a;100799933">
	<b:glossaryEntry>a meeting devoted to a particular activity; "a filming session"; "a gossip session"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100800070">
	<b:glossaryEntry>the act of meeting for social purposes; "there was too much socialization with the enlisted men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100800256">
	<b:glossaryEntry>the act of going to see some person or place or thing for a short time; "he dropped by for a short visit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100800467"
	 b:glossaryEntry="the act of being present (at a meeting or event etc.)"/>
<rdf:Description rdf:about="&a;100800661">
	<b:glossaryEntry>formal attendance (in court or at a hearing) of a party in an action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100800818"
	 b:glossaryEntry="the act of being present"/>
<rdf:Description rdf:about="&a;100800915">
	<b:glossaryEntry>attendance for a particular event or purpose: "the turnout for the rally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100801042"
	 b:glossaryEntry="the failure to attend"/>
<rdf:Description rdf:about="&a;100801195"
	 b:glossaryEntry="failure to appear (especially as at court)"/>
<rdf:Description rdf:about="&a;100801297"
	 b:glossaryEntry="failure to be present"/>
<rdf:Description rdf:about="&a;100801444"
	 b:glossaryEntry="habitual absence from work"/>
<rdf:Description rdf:about="&a;100801528"
	 b:glossaryEntry="failure to attend (especially school)"/>
<rdf:Description rdf:about="&a;100801627">
	<b:glossaryEntry>a reciprocal group action; "in return we gave them as good as we got"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100801850">
	<b:glossaryEntry>a nonverbal reaction; "his answer to any problem was to get drunk"; "their answer was to sue me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100801999"
	 b:glossaryEntry="an act of requiting; returning in kind"/>
<rdf:Description rdf:about="&a;100802092"
	 b:glossaryEntry="action taken in return for an injury or offense"/>
<rdf:Description rdf:about="&a;100802243">
	<b:glossaryEntry>the act of taking revenge (harming someone in retaliation for something harmful that they have done) especially in the next life; "Vengeance is mine; I will repay, saith the Lord"--Romans 12:19; "For vengeance I would do nothing. This nation is too great to look for mere revenge"--James Garfield; "he swore vengeance on the man who betrayed him"; "the swiftness of divine retribution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100802699"
	 b:glossaryEntry="a retaliatory action against an enemy in wartime"/>
<rdf:Description rdf:about="&a;100802802"
	 b:glossaryEntry="the act of reciprocating"/>
<rdf:Description rdf:about="&a;100802886"
	 b:glossaryEntry="a bitter quarrel between two parties"/>
<rdf:Description rdf:about="&a;100802991">
	<b:glossaryEntry>an active struggle between competing entities; "a price war"; "a war of wits"; "diplomatic warfare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100803150">
	<b:glossaryEntry>a feud in which members of the opposing parties murder each other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100803283"
	 b:glossaryEntry="an equivalent given in return"/>
<rdf:Description rdf:about="&a;100803370"
	 b:glossaryEntry="the act of initiating hostilities"/>
<rdf:Description rdf:about="&a;100803479"
	 b:glossaryEntry="the action of making something democratic"/>
<rdf:Description rdf:about="&a;100803600"
	 b:glossaryEntry="the act of combining into an integral whole"/>
<rdf:Description rdf:about="&a;100803807"
	 b:glossaryEntry="consolidation of power under central control"/>
<rdf:Description rdf:about="&a;100803947">
	<b:glossaryEntry>the spread of power away from the center to local branches or governments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100804120"
	 b:glossaryEntry="consolidating by incorporation"/>
<rdf:Description rdf:about="&a;100804210"
	 b:glossaryEntry="the combination of two or more commercial companies"/>
<rdf:Description rdf:about="&a;100804339">
	<b:glossaryEntry>absorption into a single firm of several firms involved in all aspects of a product''s manufacture from raw materials to distribution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100804561">
	<b:glossaryEntry>absorption into a single firm of several firms involved in the same level of production and sharing resources at that level</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100804778">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sharing the activities of a group; "the teacher tried to increase his students'' engagement in class activities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100805084"
	 b:glossaryEntry="withdrawing from the activities of a group"/>
<rdf:Description rdf:about="&a;100805314">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a country''s withdrawal from internal politics; "he opposed a policy of American isolation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100805460">
	<b:glossaryEntry>an engagement by contract involving financial obligation; "his business commitments took him to London"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100805638">
	<b:glossaryEntry>the act of incurring (making yourself subject to something undesirable)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100805766"
	 b:glossaryEntry="the act of intervening (as to mediate a dispute)"/>
<rdf:Description rdf:about="&a;100805906"
	 b:glossaryEntry="the act of mediating"/>
<rdf:Description rdf:about="&a;100805999"
	 b:glossaryEntry="participation by all members of a group"/>
<rdf:Description rdf:about="&a;100806104"
	 b:glossaryEntry="nonparticipation in a dispute or war"/>
<rdf:Description rdf:about="&a;100806197">
	<b:glossaryEntry>a formal termination (of a relationship or a judicial proceeding etc)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100806355"
	 b:glossaryEntry="an annulment of a marriage"/>
<rdf:Description rdf:about="&a;100806451">
	<b:glossaryEntry>the act of vindicating; "subsequent events have proved to be a vindication of his position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100806644">
	<b:glossaryEntry>the act of justifying: "the justification of barbarous means by holy ends"- H.J.Muller</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100806790">
	<b:glossaryEntry>(British) a form of protest by workers in which they deliberately slow down in order to cause problem from their employers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100806966">
	<b:glossaryEntry>peaceful resistance to a government by fasting or refusing to cooperate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100807116">
	<b:glossaryEntry>refusal to submit to established authority; originally the refusal of Roman Catholics to attend services of the Church of England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100807301">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a group''s refusal to work in protest against low pay or bad work conditions; "the strike lasted more than a month before it was settled"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100807560">
	<b:glossaryEntry>a strike in which workers refuse to leave the workplace until a settlement is reached</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100807718"
	 b:glossaryEntry="a strike in which the worker walk out"/>
<rdf:Description rdf:about="&a;100807809">
	<b:glossaryEntry>a strike in support of other workers who are on strike; a strike not resulting from direct grievances against the workers'' employer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100808023"
	 b:glossaryEntry="the act of releasing by untangling or unsnarling something"/>
<rdf:Description rdf:about="&a;100808183"
	 b:glossaryEntry="murder of a public figure by surprise attack"/>
<rdf:Description rdf:about="&a;100808287">
	<b:glossaryEntry>a deliberate act of destruction or disruption in which equipment is damaged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100808417"
	 b:glossaryEntry="the act of exterminating"/>
<rdf:Description rdf:about="&a;100808515"
	 b:glossaryEntry="systematic killing of a racial or cultural group"/>
<rdf:Description rdf:about="&a;100808655"
	 b:glossaryEntry="the wanton killing of many people"/>
<rdf:Description rdf:about="&a;100808775"
	 b:glossaryEntry="an act of great destruction and loss of life"/>
<rdf:Description rdf:about="&a;100808875">
	<b:glossaryEntry>the throwing of an object in order to determine an outcome randomly; "he risked his fortune on a throw of the dice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100809078"
	 b:glossaryEntry="the act of throwing dice"/>
<rdf:Description rdf:about="&a;100809197">
	<b:glossaryEntry>(in craps) a first roll of 7 or 11 that immediately wins the stake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100809317"
	 b:glossaryEntry="the act of flipping a coin"/>
<rdf:Description rdf:about="&a;100809401"
	 b:glossaryEntry="an attack without warning"/>
<rdf:Description rdf:about="&a;100809521">
	<b:glossaryEntry>the act of concealing yourself and lying in wait to attack by surprise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100809697"
	 b:glossaryEntry="the act of killing from ambush"/>
<rdf:Description rdf:about="&a;100809804"
	 b:glossaryEntry="liberation from any onerous controlling influence"/>
<rdf:Description rdf:about="&a;100809976"
	 b:glossaryEntry="the act of freeing from suspicion"/>
<rdf:Description rdf:about="&a;100810100">
	<b:glossaryEntry>the formal act of freeing from slavery; "he believed in the manumission of the slaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100810244"
	 b:glossaryEntry="an observation made with a radio telescope"/>
<rdf:Description rdf:about="&a;100810350"
	 b:glossaryEntry="a stupid mistake"/>
<rdf:Description rdf:about="&a;100810466">
	<b:glossaryEntry>the act of admitting someone to enter; "the surgery was performed on his second admission to the clinic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100810675">
	<b:glossaryEntry>the act of admitting someone again; "the surgery was performed on his readmission to the clinic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100810829"
	 b:glossaryEntry="the act of entering upon or attaining to a position or right"/>
<rdf:Description rdf:about="&a;100810945"
	 b:glossaryEntry="admission to a group (especially a college or university)"/>
<rdf:Description rdf:about="&a;100811071"
	 b:glossaryEntry="the act of marrying again"/>
<rdf:Description rdf:about="&a;100811153"
	 b:glossaryEntry="the act of renewing"/>
<rdf:Description rdf:about="&a;100811226"
	 b:glossaryEntry="the formal act of liberating someone"/>
<rdf:Description rdf:about="&a;100811339"
	 b:glossaryEntry="the act of demolishing"/>
<rdf:Description rdf:about="&a;100811418">
	<b:glossaryEntry>willful wanton and malicious destruction of the property of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100811593"
	 b:glossaryEntry="the act of ceding back"/>
<rdf:Description rdf:about="&a;100811685"
	 b:glossaryEntry="the act of amending"/>
<rdf:Description rdf:about="&a;100811760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of stopping (usually stopping motion); "the heart was in arrest"; "war caused a check in the company''s growth"; "the momentary stay enabled him to escape the blow"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100811999">
	<b:glossaryEntry>a correction by emending; a correction resulting from critical editing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100812126"
	 b:glossaryEntry="the act of murdering your own brother or sister"/>
<rdf:Description rdf:about="&a;100812230">
	<b:glossaryEntry>a murder carried out by an underworld syndicate; "it has all the earmarks of a Mafia hit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100812369"
	 b:glossaryEntry="murdering an infant"/>
<rdf:Description rdf:about="&a;100812446"
	 b:glossaryEntry="murder by shooting someone down in cold blood"/>
<rdf:Description rdf:about="&a;100812548"
	 b:glossaryEntry="killing a tyrant"/>
<rdf:Description rdf:about="&a;100812622"
	 b:glossaryEntry="murder and robbery by thugs"/>
<rdf:Description rdf:about="&a;100812703">
	<b:glossaryEntry>an act that changes the form or character or substance of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100812851">
	<b:glossaryEntry>electronic jamming over a wide range of frequencies simultaneously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100812979"
	 b:glossaryEntry="electronic jamming of a specific channel or frequency"/>
<rdf:Description rdf:about="&a;100813111">
	<b:glossaryEntry>the deliberate use of electromagnetic energy in a manner intended to convey misleading information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100813330">
	<b:glossaryEntry>actions to eliminate revealing telltale indicators that could be used by the enemy (or to convey misleading indicators)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100813565">
	<b:glossaryEntry>actions to represent friendly notional or actual capabilities to mislead hostile forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100813764">
	<b:glossaryEntry>the introduction of electromagnetic energy into enemy systems that imitates enemy emissions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100813965">
	<b:glossaryEntry>(law) reduction in the value of an estate caused by act or neglect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100814102"
	 b:glossaryEntry="the act of colonizing"/>
<rdf:Description rdf:about="&a;100814228">
	<b:glossaryEntry>the transportation of people (as a family or colony) to a new settlement (as after an upheaval of some kind)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100814426">
	<b:glossaryEntry>(pharmacology) the extraction by boiling of water-soluble drug substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100814555"
	 b:glossaryEntry="the act of dismounting (a horse or bike etc.)"/>
<rdf:Description rdf:about="&a;100814655"
	 b:glossaryEntry="the act of radiating"/>
<rdf:Description rdf:about="&a;100814731"
	 b:glossaryEntry="the act of emitting"/>
<rdf:Description rdf:about="&a;100814853"
	 b:glossaryEntry="the act of venting"/>
<rdf:Description rdf:about="&a;100814937">
	<b:glossaryEntry>deliberate radiation or reflection of electromagnetic energy for the purpose of disrupting enemy use of electronic devices or systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100815187"
	 b:glossaryEntry="the act of making something legally void"/>
<rdf:Description rdf:about="&a;100815282"
	 b:glossaryEntry="singing in harmony"/>
<rdf:Description rdf:about="&a;100815376"
	 b:glossaryEntry="the act of singing with closed lips"/>
<rdf:Description rdf:about="&a;100815465"
	 b:glossaryEntry="the act of winnowing"/>
<rdf:Description rdf:about="&a;100815560">
	<b:glossaryEntry>sorting one thing from others: "the separation of wheat from chaff"; "the separation of mail by postal zones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100815762"
	 b:glossaryEntry="the act of singing in a monotonous tone"/>
<rdf:Description rdf:about="&a;100815869"
	 b:glossaryEntry="singing with three or more voice parts"/>
<rdf:Description rdf:about="&a;100815966"
	 b:glossaryEntry="the act of singing psalms or hymns"/>
<rdf:Description rdf:about="&a;100816065">
	<b:glossaryEntry>singing by changing back and forth between the chest voice and a falsetto</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100816193">
	<b:glossaryEntry>the playing of a card to start a trick in bridge; "the lead was in the dummy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100816340"
	 b:glossaryEntry='the activity of leading; "his leadership inspired the team"'/>
<rdf:Description rdf:about="&a;100816520">
	<b:glossaryEntry>a position of leadership: "the President is at the helm of the Ship of State"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100816648">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a position of leadership (especially in the phrase `take the lead''); "he takes the lead in any group"; "we were just waiting for someone to take the lead"; "they didn''t follow our lead"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100816884"
	 b:glossaryEntry="the initiating or popularizing of a trend or fashion"/>
<rdf:Description rdf:about="&a;100816996"
	 b:glossaryEntry="the act of preceding"/>
<rdf:Description rdf:about="&a;100817086"
	 b:glossaryEntry="any activity that is performed alone without assistance"/>
<rdf:Description rdf:about="&a;100817192"
	 b:glossaryEntry="the act of flooding; filling to overflowing"/>
<rdf:Description rdf:about="&a;100817287">
	<b:glossaryEntry>the act of populating (causing to live in a place); "he deplored the population of colonies with convicted criminals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100817474"
	 b:glossaryEntry="the act of pouncing"/>
<rdf:Description rdf:about="&a;100817546"
	 b:glossaryEntry="the act of liberating on probation"/>
<rdf:Description rdf:about="&a;100817636"
	 b:glossaryEntry="the act of removing an official by petition"/>
<rdf:Description rdf:about="&a;100817732">
	<b:glossaryEntry>the act (by someone having the authority) of annulling something previously done; "the revocation of a law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100817896"
	 b:glossaryEntry="the act of reprieving; postponing or remitting punishment"/>
<rdf:Description rdf:about="&a;100818018"
	 b:glossaryEntry="the mistake of not following suit when able to do so"/>
<rdf:Description rdf:about="&a;100818151">
	<b:glossaryEntry>(cards) the act of playing a trump when unable to follow suit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100818293">
	<b:glossaryEntry>the act of waking; "it was a rude awakening"; "it was the waking up he hated most"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100818472">
	<b:glossaryEntry>a confusion of activity and gossip; "the buzz of excitement was so great that a formal denial was issued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100818628">
	<b:glossaryEntry>violent and excited activity; "she asked for money and then the fun began"; (colloquial) "they began to fight like fun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100818797">
	<b:glossaryEntry>(colloquial) violent and excited activity; "they began to fight like sin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100818927">
	<b:glossaryEntry>something that excites; "he looked forward to the excitements of the day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100819088"
	 b:glossaryEntry='something that thrills; "the thrills of space travel"'/>
<rdf:Description rdf:about="&a;100819194"
	 b:glossaryEntry="an act of inciting"/>
<rdf:Description rdf:about="&a;100819282"
	 b:glossaryEntry="arousal to violent emotion"/>
<rdf:Description rdf:about="&a;100819379"
	 b:glossaryEntry="arousing to a particular emotion or action"/>
<rdf:Description rdf:about="&a;100819490"
	 b:glossaryEntry="the act of stimulating"/>
<rdf:Description rdf:about="&a;100819570"
	 b:glossaryEntry="the removal of covering"/>
<rdf:Description rdf:about="&a;100819730"
	 b:glossaryEntry="the removal of trees"/>
<rdf:Description rdf:about="&a;100819827">
	<b:glossaryEntry>the act of removing floating material from the surface of a liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100819948"
	 b:glossaryEntry="the act of spoiling"/>
<rdf:Description rdf:about="&a;100820041"
	 b:glossaryEntry="the act of turning aside suddenly"/>
<rdf:Description rdf:about="&a;100820148"
	 b:glossaryEntry="an act that avoids a loss of face (of dignity or prestige)"/>
<rdf:Description rdf:about="&a;100820277">
	<b:glossaryEntry>the act of getting recruits; enlisting people for the army (or for a job or a cause etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100820436"
	 b:glossaryEntry='the act of smoothing; "he gave is hair a quick smooth"'/>
<rdf:Description rdf:about="&a;100820543">
	<b:glossaryEntry>the act of referring; "reference to an encyclopedia produced the answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100820686">
	<b:glossaryEntry>the act of giving special importance or significance to something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100820821">
	<b:glossaryEntry>activity that releases or expresses creative energy or emotion; "she had no other outlet for her feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100820990">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a person''s dying act; the last thing a person can do; "he breathed his last"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100821117">
	<b:glossaryEntry>a fast shot made with a short powerful swing of the hockey stick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100821255">
	<b:glossaryEntry>an attempt to put the soccer ball into the net by using the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100821393"
	 b:glossaryEntry="the act of removing the husks from ears of corn"/>
<rdf:Description rdf:about="&a;100821498">
	<b:glossaryEntry>naval battle where Antony and Cleopatra were defeated by Octavian''s fleet under Agrippa in 31 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100821666">
	<b:glossaryEntry>islands west of Sicily (now known as the Egadi Islands) where the Romans won a naval victory over the Carthaginians that ended the First Punic War in 241 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100821937">
	<b:glossaryEntry>a river in ancient Thrace (now Turkey); in the mouth of this river the Spartan fleet under Lysander destroyed the Athenian fleet in the final battle of the Peloponnesian War (404 BC)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100822230">
	<b:glossaryEntry>a battle in which English longbowmen under Henry V decisively defeated a much larger French army in 1415</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100822409">
	<b:glossaryEntry>the mission in San Antonio where Mexican forces under Santa Anna besieged and massacred American rebels who were fighting to make Texas independent of Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100822637">
	<b:glossaryEntry>Federal troops under Sherman cut off the railroads supplying Atlanta and burned the city; 1864</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100822843">
	<b:glossaryEntry>a decisive battle during the Napoleonic campaigns (1805); the French under Napoleon defeated the Russian and Austrian armies of Czar Alexander I and Emperor Francis II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100823128">
	<b:glossaryEntry>a battle in which the Scots under Robert the Bruce defeated the English and assured the independence of Scotland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100823317">
	<b:glossaryEntry>the peninsula and island in the Philippines where Japanese forces besieged American forces in World War II; US surrendered in 1942 and recaptured the area in 1945</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100823583">
	<b:glossaryEntry>the bombardment of British cities by German aircraft during World War II and the aerial combat that accompanied it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100823799">
	<b:glossaryEntry>battle during World War II; in December 1945 von Rundstedt launched a powerful counteroffensive in the Ardennes Forest that caught the Allies by surprise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100824115">
	<b:glossaryEntry>a World War I battle in NW France where the Allies defeated the Germans in 1918</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100824345">
	<b:glossaryEntry>World War II naval battle; Allied land-based bombers destroyed a Japanese convoy in the Bismarck Sea in March 1943</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100824585">
	<b:glossaryEntry>the British Duke of Marlborough and the Austrian Prince Eugene of Savoy defeated the French in 1704 during the War of the Spanish Succession</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100824818">
	<b:glossaryEntry>Napoleon defeated the Russians in 1812, but irreparably weakened his army</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100824984">
	<b:glossaryEntry>the battle that ended the Wars of the Roses (1485); Richard III was killed and Henry Tudor was crowned as Henry VII</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100825198">
	<b:glossaryEntry>in 1214 the French under King Philip Augustus defeated a coalition formed against him in one of the greatest battles of the middle ages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100825407">
	<b:glossaryEntry>a battle in the War of the Grand Alliance in Ireland in 1690; William III of England defeated the deposed James II and so ended Stuart Catholicism in England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100825672">
	<b:glossaryEntry>battle in 937 when Athelstan defeated the Scots; recounted in the Ballad of the Battle of Brunanburh in the Anglo-Saxon Chronicles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100825901">
	<b:glossaryEntry>in 1847 US forces under Zachary Taylor defeated Mexican forces under Santa Anna in the Mexican War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100826095">
	<b:glossaryEntry>two battles during the American Civil War (1861 and 1862); Confederate forces defeated in Federal army in both battles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100826306">
	<b:glossaryEntry>the first important battle of the American War of Independence (1775); the British defeated the colonial forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100826537"
	 b:glossaryEntry="Hannibal defeated the Romans in 216 BC"/>
<rdf:Description rdf:about="&a;100826666">
	<b:glossaryEntry>battle of World War I (1917); Italians were defeated by Austro-German forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100826858"
	 b:glossaryEntry="a battle in 321 BC in which the Samnites defeated the Romans"/>
<rdf:Description rdf:about="&a;100826997">
	<b:glossaryEntry>a battle in which Philip of Macedon defeated the Athenians and Thebans (338 BC) and also Sulla defeated Mithridates (86 BC)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100827195">
	<b:glossaryEntry>the battle in which Attila the Hun was defeated by the Romans and Visigoths in 451</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100827371">
	<b:glossaryEntry>a major battle in the American Civil War (1863); the Confederates under Robert E. Lee defeated the Union forces under Joseph Hooker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100827603">
	<b:glossaryEntry>a victory by American over Mexican forces in the Mexican War (1847)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100827766">
	<b:glossaryEntry>in the American Civil War (1863) the Union armies of Hooker, Thomas, and Sherman under the command of Ulysses S. Grant won a decisive victory over the Confederate Army under Braxton Bragg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100828073">
	<b:glossaryEntry>a Confederate victory in the American Civil War (1863); Confederate forces under Braxton Bragg defeated Union forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100828309">
	<b:glossaryEntry>a Japanese defeat in World War II (May 1942); the first naval battle fought entirely by planes based on aircraft carriers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100828550">
	<b:glossaryEntry>battle in the American Revolutionary War; Americans under Daniel Morgan defeated the British</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100828754">
	<b:glossaryEntry>the first decisive battle of the Hundred Years'' War; in 1346 the English under Edward III defeated the French under King Philip of Valois</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100828999">
	<b:glossaryEntry>battle in 401 BC when the Persian King Artaxerxes II defeated his younger brother who tried to usurp the throne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100829201">
	<b:glossaryEntry>the battle that ended the second Macedonian War (197 BC); the Romans defeated King Philip of Macedon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100829406">
	<b:glossaryEntry>the unsuccessful campaign in World War I (1915) by the English and French to open a passage for aid to Russia; defeated by the Turks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100829657">
	<b:glossaryEntry>the French military base fell after a 56-day siege by Vietnam troops; ended the involvement of France in Indochina in 1954</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100829858">
	<b:glossaryEntry>in 1649 the place was captured by Oliver Cromwell, who massacred the Catholic inhabitants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100830040">
	<b:glossaryEntry>in World War II (1940) 330,000 Allied troops had to be evacuated from the beaches at Dunkirk in a desperate retreat under enemy fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100830294">
	<b:glossaryEntry>in World War II (1942); a decisive Allied victory over German troops under Rommel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100830483">
	<b:glossaryEntry>World War II (February 1944); American infantry landed and captured a Japanese stronghold</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100830665">
	<b:glossaryEntry>a battle in 1513; the English defeated the invading Scots and James IV of Scotland was killed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100830873">
	<b:glossaryEntry>a battle in 1745 in which the French army under Marshal Saxe defeated the Anglo-Allied army under the duke of Cumberland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100831107">
	<b:glossaryEntry>an important battle in the American Civil War (1862); the Union''s Army of the Potomac under A. E. Burnside was defeated by the Confederate Army of Northern Virginia under Robert E. Lee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100831417">
	<b:glossaryEntry>a battle of the American Civil War (1863); the defeat of Robert E. Lee''s invading Confederate army was a major victory for the Union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100831667">
	<b:glossaryEntry>the battle in which Alexander won his first major victory against the Persians (334 BC)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100831855">
	<b:glossaryEntry>a battle in World War II in the Pacific (1942-1943); the island was occupied by the Japanese and later recaptured by American forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100832107">
	<b:glossaryEntry>a battle of the American Civil War (1862); the battle between the Monitor and the Merrimac</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100832295">
	<b:glossaryEntry>the battle in which William the Conqueror (duke of Normandy) defeated the Saxons under King Harold (1066)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100832514">
	<b:glossaryEntry>a battle during the Napoleonic Wars (1800); the French defeated the Austrians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100832711">
	<b:glossaryEntry>a battle in the Korean War (1950); US forces landed at Inchon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100832863">
	<b:glossaryEntry>a battle between the successors of Alexander the Great (301 BC); Lysimachus and Seleucus defeated Antigonus and Demetrius</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100833073">
	<b:glossaryEntry>a battle (333 BC) in which Alexander the Great defeated the Persians under Darius III</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100833247">
	<b:glossaryEntry>a battle (1590) in which the Huguenots under Henry IV of France defeated the Catholics under the duke of Mayenne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100833465">
	<b:glossaryEntry>a bloody and prolonged operation in which American marines landed and defeated Japanese defenders (February and March 1945)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100833705">
	<b:glossaryEntry>the battle in 1806 in which Napoleon decisively defeated the Prussians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100833881">
	<b:glossaryEntry>an indecisive naval battle in World War I (1916); fought between the British and German fleets off the NW coast of Denmark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100834095">
	<b:glossaryEntry>battle of the American Civil War (1864); Union forces under Sherman were repulsed by Confederate troops under Johnston</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100834315">
	<b:glossaryEntry>World War II (January 1944); American forces landed and captured a Japanese air base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100834511">
	<b:glossaryEntry>a battle in 217 BC in which Hannibal ambushed a Roman army led by Flaminius</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100834714">
	<b:glossaryEntry>(1568) Catholic forces supporting Mary Queen of Scots were routed by Protestants under her half-brother Lord James Stuart, Earl of Murray</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100834946">
	<b:glossaryEntry>Turkish sea power was destroyed in 1571 by a league of Christian nations organized by the Pope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100835133">
	<b:glossaryEntry>Thebes defeated Sparta in 371 BC; the battle ended Sparta''s military supremacy in Greece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100835314"
	 b:glossaryEntry="the first battle of the American Revolution (April 19, 1775)"/>
<rdf:Description rdf:about="&a;100835502">
	<b:glossaryEntry>a battle in World War II; the return of US troops to the Philippines began with landings on Leyte Island in October 1944; first use of Kamikaze aircraft by the Japanese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100835792">
	<b:glossaryEntry>a battle in Montana near the Little Bighorn River between General Custer''s cavalry and several groups of Native Americans (1876); Custer was pursuing Sioux led by Sitting Bull; Custer underestimated the size of the Sioux forces (which were supported by Cheyenne warriors) and was killed along with all his command</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100836265"
	 b:glossaryEntry="the British were besieged during the Indian Mutiny (1857)"/>
<rdf:Description rdf:about="&a;100836395">
	<b:glossaryEntry>the principal battle of the Balkan Wars (1912); Bulgarian forces defeated the Turks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100836598">
	<b:glossaryEntry>a battle in the Thirty Years'' War (1632); Swedes under King Gustavus Adolphus defeated the Imperialists under Wallenstein; Adolphus was killed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100836850">
	<b:glossaryEntry>a battle in 1859 in which the Franco-Sardinian forces under Napoleon III defeated the Austrians under Francis Joseph</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100837059">
	<b:glossaryEntry>a battle in which the Danes defeated the East Saxons in 991; celebrated in an old English poem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100837244">
	<b:glossaryEntry>a naval battle in the Spanish-American War (1898); the American fleet under Admiral Dewey defeated the Spanish fleet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100837455">
	<b:glossaryEntry>the site of three famous battles among Greek city-states: in 418 BC and 362 BC and 207 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100837630">
	<b:glossaryEntry>a battle in 490 BC in which the Athenians and their allies defeated the Persians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100837805">
	<b:glossaryEntry>a battle in 1800 in which the French under Napoleon Bonaparte won a great victory over the Austrians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100837997">
	<b:glossaryEntry>a battle in 1644 in which the Parliamentarians under the earl of Manchester defeated the Royalists under Prince Rupert</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100838237">
	<b:glossaryEntry>a battle during the second of the Punic Wars (207 BC); Hannibal''s brother Hasdrubal was defeated by the Romans which ended Hannibal''s hopes for success in Italy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100838496">
	<b:glossaryEntry>an American operation in World War I (1918); American troops under Pershing drove back the German armies which were saved only by the Armistice on November 11</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100838846">
	<b:glossaryEntry>naval battle of World War II (June 1942); land and carrier-based American planes decisively defeated a Japanese fleet on its way to invade the Midway Islands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100839113">
	<b:glossaryEntry>a battle in the Seven Years'' War (1759) in which the Anglo-Allied forces defeated the French</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100839315">
	<b:glossaryEntry>a battle during the American Revolution (1778) that ended with the withdrawal of the British forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100839552">
	<b:glossaryEntry>a battle in 1645 that settled the outcome of the first English Civil War as the Parliamentarians won a major victory over the Royalists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100839797">
	<b:glossaryEntry>a naval battle in the War of Greek Independence (1827); the Turkish and Egyptian fleet was defeated by the allied fleet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100840011">
	<b:glossaryEntry>a campaign in the closing days of World War II in the Pacific (April-June 1945); in savage close-quarter fighting US marines and regular army troops took the island from the Japanese; considered the greatest victory of the Pacific campaign for the Americans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100840379">
	<b:glossaryEntry>a battle (1898) in which an Anglo-Egyptian army under Lord Kitchener defeated the Sudanese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100840564">
	<b:glossaryEntry>the US and its allies defeated Iraq in a ground war that lasted 100 hours (1991)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100840751">
	<b:glossaryEntry>a long siege by the English was relieved by Joan of Arc in 1429</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100840906">
	<b:glossaryEntry>battle in which the ruler of Afghanistan defeated the Mahrattas in 1761</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100841070">
	<b:glossaryEntry>the Spanish Navy was destroyed by France and England while attempting to recover Sicily and Sardinia from Italy (1719)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100841290">
	<b:glossaryEntry>the final campaign of the American Civil War (1864-65); Union forces under Grant besieged and finally defeated Confederate forces under Lee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100841564"
	 b:glossaryEntry="Caesar defeated Pompey in 48 BC"/>
<rdf:Description rdf:about="&a;100841692">
	<b:glossaryEntry>Octavian and Mark Antony defeated Brutus and Cassius in 42 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100841848">
	<b:glossaryEntry>a naval battle in World War II (1944); a decisive naval victory for the US fleet over the Japanese who were trying to block supplies from reaching American troops on Leyte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100842149">
	<b:glossaryEntry>the victory in 1757 by the British under Clive over Siraj-ud-daula that establish British supremacy over India</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100842352"
	 b:glossaryEntry="a defeat of the Persian army by the Greeks in 479 BC"/>
<rdf:Description rdf:about="&a;100842497">
	<b:glossaryEntry>the town was taken from the Turks by the Russians in 1877 after a siege of 143 days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100842661">
	<b:glossaryEntry>the battle in 1356 in which the English under the Black Prince defeated the French</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100842838">
	<b:glossaryEntry>a battle in the Chino-Japanese war (1894); Japanese captured the port and fortifications from the Chinese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100843020">
	<b:glossaryEntry>a major victory by the Romans over the Macedonians in 168 BC; resulted in the downfall of the ancient Macedonian kingdom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100843229">
	<b:glossaryEntry>a battle between the French and an alliance of Spaniards and Swiss and Venetians in 1512</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100843410">
	<b:glossaryEntry>a battle in the Thirty Years'' War (1643); the French defeated the Spanish invaders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100843602">
	<b:glossaryEntry>a battle in the Seven Years'' War (1757); Prussian forces under Frederick the Great defeated the armies of France and Austria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100843840">
	<b:glossaryEntry>a battle in the Meuse-Argonne operation in World War I (1918); the battle in which American troops launched their first offensive in France</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100844110">
	<b:glossaryEntry>US forces captured the island from the Japanese in July 1944; it was an important air base until the end of World War II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100844321">
	<b:glossaryEntry>a battle in World War II; the port was captured by US troops in September 1943</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100844491">
	<b:glossaryEntry>a naval battle in the Spanish-American War (1898); the US fleet bottled up the Spanish ships in the harbor of Santiago de Cuba and destroyed them when they tried to escape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100844774">
	<b:glossaryEntry>a battle during the American Revolutionary War (1777); the British under Burgoyne were defeated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100844983">
	<b:glossaryEntry>the Swiss Confederation escaped Hapsburg domination by their victory in 1386</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100845154">
	<b:glossaryEntry>the second great battle of the American Civil War (1862); the battle ended with the withdrawal of Confederate troops but is was not a Union victory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100845442">
	<b:glossaryEntry>a battle in World War I (May 1918); the Germans tried to attack before the American numbers were too great to defeat; the tactical success of the Germans proved to be a strategic failure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100845803">
	<b:glossaryEntry>an indecisive battle in 1859 between the French and Sardinians under Emperor Napoleon III and the Austrians under Emperor Francis Joseph I</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100846038"
	 b:glossaryEntry="battle in World War I (1916)"/>
<rdf:Description rdf:about="&a;100846192"
	 b:glossaryEntry="battle of World War II (1944)"/>
<rdf:Description rdf:about="&a;100846347">
	<b:glossaryEntry>Francis Drake commanded British ships that successfully defeated the large armada sent from Spain by Philip II to invade England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100846556">
	<b:glossaryEntry>a battle between the armies of Grant and Lee during the Wilderness Campaign</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100846764">
	<b:glossaryEntry>the Athenian siege of Syracuse (415-413 BC) was eventually won by Syracuse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100846932">
	<b:glossaryEntry>the Roman siege of Syracuse (214-212 BC) was eventually won by the Romans who sacked the city (killing Archimedes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100847140">
	<b:glossaryEntry>a battle in World War I (1914); decisive German victory over the Russians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100847331">
	<b:glossaryEntry>battles in World War II in the Pacific (November 1943); US Marines took the islands from the Japanese after bitter fighting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100847568"
	 b:glossaryEntry="a battle in France in 687 among the descendants of Clovis"/>
<rdf:Description rdf:about="&a;100847716">
	<b:glossaryEntry>a battle in 9 AD in which the Germans under Arminius annihilated three Roman legions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100847911">
	<b:glossaryEntry>a famous battle in 480 BC; a Greek army under Leonidas was annihilated by the Persians who were trying to conquer Greece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100848132">
	<b:glossaryEntry>a naval battle in 1805 off the SW coast of Spain; the French and Spanish fleets were defeated by the English under Nelson (who was mortally wounded)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100848396">
	<b:glossaryEntry>a naval battle in the Russo-Japanese War (1905); the Japanese fleet defeated the Russian fleet in the Korean Strait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100848604">
	<b:glossaryEntry>the French defeated the Austrian and Prussian troops in 1792 (with a famous cannonade from the French artillery)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100848805">
	<b:glossaryEntry>a battle in World War I (1916); in some of the bloodiest fighting in World War I the German offensive was stopped</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100849029">
	<b:glossaryEntry>a decisive battle in the American Civil War (1863); after being besieged for nearly seven weeks the Confederates surrendered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100849268">
	<b:glossaryEntry>a battle in the Napoleonic campaigns (1809); Napoleon defeated the Austrians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100849454">
	<b:glossaryEntry>in December 1941 the island was captured by the Japanese after a gallant last-ditch stand by a few hundred US marines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100849694">
	<b:glossaryEntry>the battle on 18 June 1815 in which Napoleon met his final defeat; Prussian and British forces under Blucher and the Duke of Wellington routed the French forces under Napoleon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100849983">
	<b:glossaryEntry>American Civil War; a series of indecisive battles in Grant''s campaign (1864) against Lee in which both armies suffered terrible losses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100850241">
	<b:glossaryEntry>a battle in the Korean War (November 1950); when UN troops advanced north to the Yalu River 200,000 Chinese troops crossed the river and drove them back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100850488">
	<b:glossaryEntry>American Revolution (1781): the British under Cornwallis surrendered after a siege of three weeks by American and French troops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100850708">
	<b:glossaryEntry>battle in World War I (1914); heavy but indecisive fighting as the Allies and the Germans both tried to break through the lines of the others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100850981">
	<b:glossaryEntry>battle in World War I (1915); Germans wanted to try chlorine (a toxic yellow gas) as a weapon and succeeded in taking considerable territory from the Allied salient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100851278">
	<b:glossaryEntry>battle in World War I (1917); an Allied offensive which eventually failed because tanks bogged down in the waterlogged soil of Flanders; Germans introduced mustard gas which interfered with the Allied artillery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100851620">
	<b:glossaryEntry>the battle in 202 BC in which Scipio decisively defeated Hannibal at the end of the second Punic War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100851826">
	<b:glossaryEntry>US history: civil war between the North and the South; 1861-1865</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100852246">
	<b:glossaryEntry>the revolution of the American colonies against Great Britain; 1775-1783</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100852529">
	<b:glossaryEntry>Arab-Israeli tension erupted into a brief war in June 1967; Israel emerged as a major power in the Middle East</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100852735">
	<b:glossaryEntry>Egypt and Syria attacked Israel in October 1973 (on Yom Kippur); Israel counterattacked and drove the Syrians back and crossed the Suez Canal into Egypt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100852986">
	<b:glossaryEntry>wars between Turkey and Greece-Serbia-Bulgaria and later between Turkey and Montenegro; 1912-1914</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100853179">
	<b:glossaryEntry>either of two wars: the first when the Boers fought England in order to regain the independence they had given up to obtain British help against the Zulus (1880-1881); the second when the Orange Free State and Transvaal declared war on Britain (1899-1902)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100853508">
	<b:glossaryEntry>the republican revolution against the Manchu dynasty in China; 1911-1912</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100853664">
	<b:glossaryEntry>a war in Crimea between Russia and a group of nations including England France Turkey Sardinia; 1853-1856</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100853846">
	<b:glossaryEntry>English history: war between the Parliamentarians and the Royalists under Charles I; 1644-1648</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100854080">
	<b:glossaryEntry>the revolution against James II of England; there was little armed resistance to William and Mary in England altho battles were fought in Scotland and Ireland (1688-1689)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100854360">
	<b:glossaryEntry>a war between France and Prussia that ended the French Second Empire and led to the founding of the German empire; 1870-1871</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100854569">
	<b:glossaryEntry>a war between France and Britain (both aided by indian tribes); 1755-1760</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100854748"
	 b:glossaryEntry="the revolution in France against the Bourbons; 1789-1799"/>
<rdf:Description rdf:about="&a;100854887">
	<b:glossaryEntry>the series of wars fought intermittently between France and England; 1337-1453</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100855068">
	<b:glossaryEntry>a dispute over control of the waterway between Iraq and Iran broke out into open fighting in 1980 and continued until 1988, when they accepted a UN cease-fire resolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100855316">
	<b:glossaryEntry>a war between North and South Korea; South Korea was aided by the US and other UN members; 1950-1953</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100855530"
	 b:glossaryEntry="1910-1911"/>
<rdf:Description rdf:about="&a;100855623">
	<b:glossaryEntry>after disputes over Texas lands that were settled by Mexicans the US declared war on Mexico in 1846 and by treaty in 1848 took Texas and California and Arizona and New Mexico and Nevada and Utah and part of Colorado and paid Mexico $15,000,000</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100855981">
	<b:glossaryEntry>a series of wars fought between France (led by Napoleon Bonaparte) and alliances involving England and Prussia and Russia and Austria at different times; 1799-1815</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100856377">
	<b:glossaryEntry>the invasion and settlement of England by the Normans following the Battle of Hastings (1066)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100856551">
	<b:glossaryEntry>a war in which Athens and its allies were defeated by the league centered on Sparta; 431-404 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100856729">
	<b:glossaryEntry>a war in which the US and its allies freed Kuwait from Iraqi invaders; 1990-1991</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100856891">
	<b:glossaryEntry>three wars between Carthage and Rome resulting in the destruction of Carthage: 264-241 BC, 218-201 BC, 149-146 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100857156"
	 b:glossaryEntry="the re-establishment of the British monarchy in 1660"/>
<rdf:Description rdf:about="&a;100857285"
	 b:glossaryEntry="the revolution against the Czarist government; March 1917"/>
<rdf:Description rdf:about="&a;100857448">
	<b:glossaryEntry>the coup d''etat in November 1917 that establish a Soviet government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100857620">
	<b:glossaryEntry>victory in the war with Russia (1904-1905) gave Japan power over Korea and Manchuria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100857807">
	<b:glossaryEntry>a war of England and Prussia against France and Austria (1756-1763); Britain and Prussia got the better of it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100858055"
	 b:glossaryEntry="a war between the US and Spain in 1898"/>
<rdf:Description rdf:about="&a;100858212">
	<b:glossaryEntry>a series of conflicts (1618-1648) starting between German Protestants and Catholics and spreading until France and Denmark and Sweden were opposing the Holy Roman Empire and Spain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100858512">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(Greek mythology) a great war fought between Greece and Troy; the Greeks sailed to Troy to recover Helen of Troy, the beautiful wife of the Greek King Menelaus who had been abducted by Paris; after ten years the Greeks (via the Trojan Horse) achieved final victory and burned Troy to the ground; "the story of the Trojan War is told in Homer''s Iliad"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100858919">
	<b:glossaryEntry>a prolonged war (1954-1975) between the communist armies of North Vietnam who were supported by the Chinese and the non-communist armies of South Vietnam supported by the US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100859169">
	<b:glossaryEntry>Prussian and Austria fought over Silesia and most of the rest of Europe took sides; 1740-1748</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100859377">
	<b:glossaryEntry>an aggressive war waged by Louis XIV against Spain and the Empire and England and Holland and other states (1689-1697)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100859637">
	<b:glossaryEntry>a general war in Europe (1701-1714) that broke out when Louis XIV of France installed his grandson Philip on the throne of Spain; England and Holland hoped to limit Louis'' power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100859928">
	<b:glossaryEntry>struggle for the English throne (1455-1485) between the house of York (white rose) and the house of Lancaster (red rose) ending with the accession of the Tudor monarch Henry VII</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100860226">
	<b:glossaryEntry>a war between the Allies (Russia France British-Empire Italy US Japan Rumania Serbia Belgium Greece Portugal Montenegro) and the Central Powers (Germany Austro-Hungary Turkey Bulgaria) from 1914 to 1918</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100860774">
	<b:glossaryEntry>a war between the Allies (Australia Belgium Bolivia Brazil Canada China Colombia Costa-Rico Cuba Czechoslovakia Dominican-Republic El-Salvador Ethiopia Greece Guatemala Haiti Honduras India Iran Iraq Luxembourg Mexico Netherlands New-Zealand Nicaragua Norway Panama Philippines Poland South-Africa United-Kingdom US USSR Yugoslavia) and the Axis (Albania Bulgaria Finland Germany Hungary Italy Japan Rumania Slovakia Thailand) from 1939 to 1945</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100861689"
	 b:glossaryEntry="taxonomic kingdom comprising all living or extinct animals"/>
<rdf:Description rdf:about="&a;100862484">
	<b:glossaryEntry>any of various small animals or insects that are pests; e.g. cockroaches or rats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100862617">
	<b:glossaryEntry>any usually predatory wild animal considered undesirable; e.g. coyote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100862750">
	<b:glossaryEntry>any animal that feeds on refuse and other decaying organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100862871"
	 b:glossaryEntry="an animal trained for and used for heavy labor"/>
<rdf:Description rdf:about="&a;100863011">
	<b:glossaryEntry>an animal such as a donkey or ox or elephant used for transporting loads or doing other heavy work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100863198"
	 b:glossaryEntry="an animal used for pulling heavy loads"/>
<rdf:Description rdf:about="&a;100863295">
	<b:glossaryEntry>an animal such as a mule or burro or horse used to carry loads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100863425"
	 b:glossaryEntry="any of various domesticated animals"/>
<rdf:Description rdf:about="&a;100863576"
	 b:glossaryEntry="an animal being fattened or suitable for fattening"/>
<rdf:Description rdf:about="&a;100863679"
	 b:glossaryEntry="an animal usable in or suitable for a breeding establishment"/>
<rdf:Description rdf:about="&a;100863793"
	 b:glossaryEntry="any recently hatched animal (especially birds)"/>
<rdf:Description rdf:about="&a;100863895"
	 b:glossaryEntry='a single domestic animal: "200 head of cattle"'/>
<rdf:Description rdf:about="&a;100863992"
	 b:glossaryEntry="a domesticated animal kept for companionship or amusement"/>
<rdf:Description rdf:about="&a;100864099">
	<b:glossaryEntry>a person or other animal having powers of endurance or perseverence: "the horse that won the race is a good stayer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100864267">
	<b:glossaryEntry>a usually horned animal that as either shed its horns or had them removed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100864394">
	<b:glossaryEntry>any of numerous animals inhabiting the sea including e.g. fishes and molluscs and many mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100864561">
	<b:glossaryEntry>an organism or cell having only one complete set of chromosomes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100864678">
	<b:glossaryEntry>an organism or cell having two sets of chromosomes or twice the haploid number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100864810">
	<b:glossaryEntry>an organism or cell having more than twice the haploid number of chromosomes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100864942">
	<b:glossaryEntry>(genetics)an organism having a diploid set of chromosomes from each parent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100865075">
	<b:glossaryEntry>an animal that produces gametes (ova) that can be fertilized by male gametes (spermatozoa)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100865272"
	 b:glossaryEntry="female of certain aquatic animals e.g. octopus or lobster"/>
<rdf:Description rdf:about="&a;100865379">
	<b:glossaryEntry>an animal that produces gametes (spermatozoa) that can fertilize female gametes (ova)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100865569"
	 b:glossaryEntry="any mature animal"/>
<rdf:Description rdf:about="&a;100865638"
	 b:glossaryEntry="any immature animal"/>
<rdf:Description rdf:about="&a;100865811"
	 b:glossaryEntry="any immature mammal"/>
<rdf:Description rdf:about="&a;100866124"
	 b:glossaryEntry='a very young mammal: "baby rabbits"'/>
<rdf:Description rdf:about="&a;100866210"
	 b:glossaryEntry="young of any of various canines such as a dog or wolf"/>
<rdf:Description rdf:about="&a;100866339"
	 b:glossaryEntry="a young wolf"/>
<rdf:Description rdf:about="&a;100866417"
	 b:glossaryEntry="young dog"/>
<rdf:Description rdf:about="&a;100866478">
	<b:glossaryEntry>the young of certain carnivorous mammals such as the bear or wolf or lion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100866673"
	 b:glossaryEntry="a young lion"/>
<rdf:Description rdf:about="&a;100866740"
	 b:glossaryEntry="a young bear"/>
<rdf:Description rdf:about="&a;100866807"
	 b:glossaryEntry="a young tiger"/>
<rdf:Description rdf:about="&a;100866876"
	 b:glossaryEntry='young of any of various fur-bearing animals: "a fox kit"'/>
<rdf:Description rdf:about="&a;100866982"
	 b:glossaryEntry="a young mammal that has not been weaned"/>
<rdf:Description rdf:about="&a;100867076">
	<b:glossaryEntry>male parent of an animal especially a domestic animal such as a horse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100867196"
	 b:glossaryEntry="female parent of an animal especially domestic livestock"/>
<rdf:Description rdf:about="&a;100867302">
	<b:glossaryEntry>a pedigreed animal of unmixed lineage; used especially of horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100867448"
	 b:glossaryEntry="any creature of exceptional size"/>
<rdf:Description rdf:about="&a;100867532">
	<b:glossaryEntry>external opening of urinary or genital system of a lower vertebrate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100867650"
	 b:glossaryEntry="microscopic organism such as an amoeba or paramecium"/>
<rdf:Description rdf:about="&a;100867773"
	 b:glossaryEntry="an animal that is no longer alive"/>
<rdf:Description rdf:about="&a;100867864">
	<b:glossaryEntry>an animal that survives in spite of adversity; "only the fittest animals were survivors of the cold winters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100868028"
	 b:glossaryEntry="an animal that has undergone mutation"/>
<rdf:Description rdf:about="&a;100868118">
	<b:glossaryEntry>any animal that feeds on flesh: "Tyrannosaurus Rex was a large carnivore"; "insectivorous plants are considered carnivores"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100868297">
	<b:glossaryEntry>any animal that feeds chiefly on grass and other plants: "horses are herbivores"; "the sauropod dinosaurs were apparently herbivores"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100868486"
	 b:glossaryEntry="any organism that feeds mainly on insects"/>
<rdf:Description rdf:about="&a;100868585">
	<b:glossaryEntry>an animal having teeth consolidated with the summit of the alveolar ridge without sockets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100868729">
	<b:glossaryEntry>an animal having teeth consolidate with the inner surface of the alveolar ridge without sockets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100868881">
	<b:glossaryEntry>an artificial taxonomic category established on the basis of morphological resemblance for organisms of obscure true relationships esp. fossil forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100869086"
	 b:glossaryEntry="one of the bony outgrowths on the heads of certain ungulates"/>
<rdf:Description rdf:about="&a;100869291"
	 b:glossaryEntry="deciduous horn of a member of the deer family"/>
<rdf:Description rdf:about="&a;100869408"
	 b:glossaryEntry="a bunch of feathers or hair"/>
<rdf:Description rdf:about="&a;100869486">
	<b:glossaryEntry>any outgrowth from the head of an organism that resembles a horn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100869601">
	<b:glossaryEntry>a showy growth of e.g. feathers or skin on the head of a bird or other animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100869784"
	 b:glossaryEntry="showy crest or knot of hair or feathers"/>
<rdf:Description rdf:about="&a;100869877"
	 b:glossaryEntry="any organism (animal or plant) of microscopic size"/>
<rdf:Description rdf:about="&a;100870150">
	<b:glossaryEntry>an organism esp. a bacterium that requires air or free oxygen for life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100870273">
	<b:glossaryEntry>an organism esp. a bacterium that does not require air or free oxygen to live</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100870405">
	<b:glossaryEntry>an offspring of genetically dissimilar parents or stock; especially offspring produced by breeding plants or animals of different varieties or breeds or species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100870649"
	 b:glossaryEntry="esp an animal produced by a cross between two pure breeds"/>
<rdf:Description rdf:about="&a;100870762">
	<b:glossaryEntry>an organism that can assume more than one adult form as in the castes of ants or termites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100870907">
	<b:glossaryEntry>an animal or plant that bears a relationship to another (as related by common descent or by membership in the same genus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100871107">
	<b:glossaryEntry>ultramicroscopic infectious agent that replicates itself only within cells of living hosts; many are pathogenic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100871360">
	<b:glossaryEntry>the outer covering of protein surrounding the nucleic acid of a virus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100871501">
	<b:glossaryEntry>a complete viral particle; nucleic acid and capsid (and a lipid envelope in some viruses)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100871662">
	<b:glossaryEntry>any of a group of viruses including those that in humans cause upper respiratory infections or infectious pinkeye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100871832"
	 b:glossaryEntry="a virus that causes viral hemorrhagic fever"/>
<rdf:Description rdf:about="&a;100871933">
	<b:glossaryEntry>any of a group of viruses that can cause pox diseases in vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100872092">
	<b:glossaryEntry>a poxvirus closely related to smallpox virus; causes benign gelatinous tumors in humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100872238"
	 b:glossaryEntry="the virus that causes smallpox in humans"/>
<rdf:Description rdf:about="&a;100872339">
	<b:glossaryEntry>the widely studied plant virus that causes tobacco mosaic; it was the first virus discovered (1892)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100872511">
	<b:glossaryEntry>a plant virus with its RNA arranged in a circular chromosome without a protein coat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100872658"
	 b:glossaryEntry="virus parasitic in bacteria; multiplies within its host"/>
<rdf:Description rdf:about="&a;100872781">
	<b:glossaryEntry>a plant pathogen that is a virus consisting of a single strand of RNA</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100872980"
	 b:glossaryEntry="an animal pathogen that is a virus"/>
<rdf:Description rdf:about="&a;100873307">
	<b:glossaryEntry>a group of animal DNA viruses including viruses of ducks and woodchucks and squirrels and others as well as the virus causing hepatitis B in humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100873513">
	<b:glossaryEntry>any of a group of viruses that contain two single-strand linear RNA molecules per virion and reverse transcriptase (RNA to DNA)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100873733"
	 b:glossaryEntry="retrovirus causing T-cell leukemia"/>
<rdf:Description rdf:about="&a;100873852">
	<b:glossaryEntry>the virus that causes acquired immune deficiency syndrome (AIDS)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100873997">
	<b:glossaryEntry>any of a group of RNA viruses including those that cause influenza and mumps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100874165"
	 b:glossaryEntry="a group of viruses including those causing influenza"/>
<rdf:Description rdf:about="&a;100874278"
	 b:glossaryEntry="a group of viruses including those causing mumps and measles"/>
<rdf:Description rdf:about="&a;100874398"
	 b:glossaryEntry="a group of single-strand RNA viruses with a protein coat"/>
<rdf:Description rdf:about="&a;100874531"
	 b:glossaryEntry="the virus causing poliomyelitis"/>
<rdf:Description rdf:about="&a;100874619"
	 b:glossaryEntry="the virus causing hepatitis A"/>
<rdf:Description rdf:about="&a;100874712">
	<b:glossaryEntry>any of a group of picornaviruses that infect the gastrointestinal tract and can spread to other areas (especially the nervous system)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100874975">
	<b:glossaryEntry>enterovirus causing a disease resembling poliomyelitis but without paralysis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100875130">
	<b:glossaryEntry>any of a group of viruses associated with various diseases including viral meningitis and mild respiratory disorders and diarrhea in newborn infants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100875334">
	<b:glossaryEntry>any of the animal viruses that cause painful blisters on the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100875539"
	 b:glossaryEntry="a herpes virus that affects the skin and nervous system"/>
<rdf:Description rdf:about="&a;100875714"
	 b:glossaryEntry="a herpes virus that causes oral herpes"/>
<rdf:Description rdf:about="&a;100875821"
	 b:glossaryEntry="a herpes virus that can cause genital herpes"/>
<rdf:Description rdf:about="&a;100875934"
	 b:glossaryEntry="a herpes virus that causes shingles"/>
<rdf:Description rdf:about="&a;100876069"
	 b:glossaryEntry="a herpes virus that causes chickenpox and shingles"/>
<rdf:Description rdf:about="&a;100876221">
	<b:glossaryEntry>the herpes virus that causes infectious mononucleosis; associated with specific cancers in Africa and China</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100876393">
	<b:glossaryEntry>any of a group of herpes viruses that can cause birth defects; can affect humans with impaired immunological systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100876571">
	<b:glossaryEntry>any of a group of animal viruses associated with or causing papillomas or polyomas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100876747">
	<b:glossaryEntry>any of a group of papovaviruses associated with genital or oral carcinomas or a group associated with benign genital tumors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100876938"
	 b:glossaryEntry="a virus the can initiate various kinds of tumors in mice"/>
<rdf:Description rdf:about="&a;100877064">
	<b:glossaryEntry>any of a group of single-strand RNA viruses including those causing hepatitis non-A non-B and yellow fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100877226"
	 b:glossaryEntry="any of a group of RNA viruses including those causing rabies"/>
<rdf:Description rdf:about="&a;100877344">
	<b:glossaryEntry>any of a group of RNA viruses including the rotavirus causing infant enteritis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100877495"
	 b:glossaryEntry="the reovirus causing infant enteritis"/>
<rdf:Description rdf:about="&a;100877588">
	<b:glossaryEntry>any of a group of viruses containing DNA in an icosahedral protein shell and causing disease in dogs and cattle; not known to be associated with any human disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100877815">
	<b:glossaryEntry>a virus that remains dormant in the body for a long time before symptoms appear; "kuru is caused by a slow virus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100877985">
	<b:glossaryEntry>the virus that produces stunting and yellowing of the leaves of onion plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100878132">
	<b:glossaryEntry>the virus that produces stunting and yellowing of the leaves of potato plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100878281">
	<b:glossaryEntry>prokaryotic bacteria and blue-green algae and various primitive pathogens; because of lack of consensus on how to divide the organisms into phyla informal names are used for the major divisions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100878620">
	<b:glossaryEntry>organisms that typically reproduce by asexual budding or fission and whose nutritional mode is absorption or photosynthesis or chemosynthesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100878880"
	 b:glossaryEntry="the order of animals"/>
<rdf:Description rdf:about="&a;100883478"
	 b:glossaryEntry="the order of protoctista"/>
<rdf:Description rdf:about="&a;100883710"
	 b:glossaryEntry="in some classifications considered a kingdom"/>
<rdf:Description rdf:about="&a;100883862">
	<b:glossaryEntry>considered ancient life forms that evolved separately from bacteria and blue-green algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100884120">
	<b:glossaryEntry>archaebacteria found in anaerobic environments such as animal intestinal tracts or sediments or sewage and capable of producing methane; a source of natural gas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100884337">
	<b:glossaryEntry>archaebacteria requiring a salt-rich environment for growth and survival</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100884483">
	<b:glossaryEntry>halophiles in saline environments such as the Dead Sea or salt flats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100884639">
	<b:glossaryEntry>archaebacteria that thrive in strongly acidic environments at high temperatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100884781">
	<b:glossaryEntry>single-celled or noncellular spherical or spiral or rod-shaped organisms lacking chlorophyll that reproduce by fission; important as pathogens and for biochemical properties; taxonomy is difficult; often considered plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100885177"
	 b:glossaryEntry="an organism that thrives in a relatively acid environment"/>
<rdf:Description rdf:about="&a;100885303">
	<b:glossaryEntry>any of the rod-shaped or branched bacteria in the root nodules of nitrogen-fixing plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100885447">
	<b:glossaryEntry>aerobic rod-shaped spore-producing bacterium; often occurring in chainlike formations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100885620"
	 b:glossaryEntry="any spherical or nearly spherical bacteria"/>
<rdf:Description rdf:about="&a;100885741">
	<b:glossaryEntry>any flagellated aerobic bacteria having a spirally twisted rodlike form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100885879"
	 b:glossaryEntry="an order of bacteria"/>
<rdf:Description rdf:about="&a;100885979"
	 b:glossaryEntry="a family of bacteria"/>
<rdf:Description rdf:about="&a;100886476"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100887223"
	 b:glossaryEntry="a species of bacteria"/>
<rdf:Description rdf:about="&a;100887398"
	 b:glossaryEntry="a species of aerobic bacteria"/>
<rdf:Description rdf:about="&a;100887513"
	 b:glossaryEntry="aerobic bacteria widely distributed in nature"/>
<rdf:Description rdf:about="&a;100887672">
	<b:glossaryEntry>a species of Gram-negative aerobic bacteria that produce gas and acid from sugars and are sometimes involved in the souring of milk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100887889"
	 b:glossaryEntry="a small family of rod-shaped bacteria"/>
<rdf:Description rdf:about="&a;100888064">
	<b:glossaryEntry>the type genus of Rhizobiaceae; usually occur in the root nodules of legumes; can fix atmospheric oxygen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100888261">
	<b:glossaryEntry>small motile bacterial rods that can reduce nitrates and cause galls on plant stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100888464"
	 b:glossaryEntry="the bacteria that produce crown gall disease in plants"/>
<rdf:Description rdf:about="&a;100888609">
	<b:glossaryEntry>one-celled monerans having simple cells with rigid walls and (in motile types) flagella</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100889066">
	<b:glossaryEntry>a large group of bacteria having rigid cell walls; motile types have flagella</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100889754">
	<b:glossaryEntry>one of two usually recognized orders of true bacteria; gram-positive spherical or rod-shaped forms; some are motile; in some classifications considered an order of Schizomycetes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100890108">
	<b:glossaryEntry>typically rod-shaped usually gram-positive bacteria that produce endospores</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100890319">
	<b:glossaryEntry>type genus of the Bacillaceae; includes many saprophytes important in decay of organic matter and a number of parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100890537">
	<b:glossaryEntry>anaerobic or micro-aerophilic rod-shaped or spindle-shaped saprophytes; nearly cosmopolitan in soil, animal intestines, and dung</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100890786">
	<b:glossaryEntry>spindle-shaped bacterial cell esp. one swollen at the center by an endospore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100890952">
	<b:glossaryEntry>anaerobic bacterium producing botulin the toxin that causes botulism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100891131">
	<b:glossaryEntry>prokaryotic organisms sometimes considered a class or phylum or subkingdom; coextensive with the Cyanophyceae: cyanobacteria (blue-green algae)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100891391"
	 b:glossaryEntry="former term for the Cyanophyta"/>
<rdf:Description rdf:about="&a;100891559"
	 b:glossaryEntry="a former classification"/>
<rdf:Description rdf:about="&a;100891683">
	<b:glossaryEntry>photosynthetic bacteria found in fresh and salt water, having chlorophyll a and phycobilins; once thought to be algae: blue-green algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100891996">
	<b:glossaryEntry>predominantly photosynthetic prokaryotic organisms containing a blue pigment in addition to chlorophyll; occur singly or in colonies in diverse habitats; important as phytoplankton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100892310"
	 b:glossaryEntry="former terms for Cyanophyceae"/>
<rdf:Description rdf:about="&a;100892476"
	 b:glossaryEntry="blue-green algae"/>
<rdf:Description rdf:about="&a;100892609">
	<b:glossaryEntry>type genus of the family Nostocaceae: freshwater blue-green algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100892771"
	 b:glossaryEntry="found in moist places as rounded jellylike colonies"/>
<rdf:Description rdf:about="&a;100892894"
	 b:glossaryEntry="blue green algae"/>
<rdf:Description rdf:about="&a;100893037"
	 b:glossaryEntry="a genus of blue-green algae"/>
<rdf:Description rdf:about="&a;100893168">
	<b:glossaryEntry>large colonial bacterium common in tropical open-ocean waters; important in carbon and nitrogen fixation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100893351">
	<b:glossaryEntry>green and purple bacteria; energy for growth is derived from sunlight; carbon is derived from carbon dioxide or organic carbon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100893586">
	<b:glossaryEntry>free-living Gram-negative pink to purplish-brown bacteria containing bacteriochlorophyll</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100893736">
	<b:glossaryEntry>one of two usually recognized orders of true bacteria; gram-negative spiral or spherical or rod-shaped bacteria usually motile by polar flagella; some contain photosynthetic pigments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100894118">
	<b:glossaryEntry>rod-shaped gram-negative bacteria; include important plant and animal pathogens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100894343"
	 b:glossaryEntry="type genus of the family Pseudomonodaceae"/>
<rdf:Description rdf:about="&a;100894519"
	 b:glossaryEntry="causes brown rot in tomatoes and potatoes and tobacco etc"/>
<rdf:Description rdf:about="&a;100894667">
	<b:glossaryEntry>bacteria usually producing greenish fluorescent water-soluble pigment; some pathogenic for plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100894871">
	<b:glossaryEntry>a genus of bacteria similar to Pseudomonas but producing a yellow pigment that is not soluble in water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100895089">
	<b:glossaryEntry>bacteria producing yellow non-water-soluble pigments; some pathogenic for plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100895246"
	 b:glossaryEntry="small motile sulphur bacteria"/>
<rdf:Description rdf:about="&a;100895379">
	<b:glossaryEntry>usually rod-shaped bacteria that oxidize ammonia or nitrites: nitrobacteria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100895602"
	 b:glossaryEntry="rod-shaped soil bacteria"/>
<rdf:Description rdf:about="&a;100895742"
	 b:glossaryEntry="soil bacteria that convert nitrites to nitrates"/>
<rdf:Description rdf:about="&a;100895886"
	 b:glossaryEntry="ellipsoidal soil bacteria"/>
<rdf:Description rdf:about="&a;100896029"
	 b:glossaryEntry="soil bacteria that oxidize ammonia to nitrites"/>
<rdf:Description rdf:about="&a;100896175">
	<b:glossaryEntry>free-living coccoid to rod-shaped bacteria that derive energy from oxidizing sulfur or sulfur compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100896405"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100896527">
	<b:glossaryEntry>small rod-shaped bacteria living in sewage or soil and oxidizing sulfur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100896694"
	 b:glossaryEntry="any bacterium of the genus Thiobacillus"/>
<rdf:Description rdf:about="&a;100896811"
	 b:glossaryEntry="rigid spirally curved elongate bacteria"/>
<rdf:Description rdf:about="&a;100896988"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100897107">
	<b:glossaryEntry>spirally twisted elongate rodlike bacteria usually living in stagnant water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100897275"
	 b:glossaryEntry="a bacterium causing rat-bite fever"/>
<rdf:Description rdf:about="&a;100897397"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100897551"
	 b:glossaryEntry="curved rodlike motile bacterium"/>
<rdf:Description rdf:about="&a;100897700"
	 b:glossaryEntry="comma-shaped bacteria that cause Asiatic cholera"/>
<rdf:Description rdf:about="&a;100897843"
	 b:glossaryEntry="bacteria that cause abortion in sheep"/>
<rdf:Description rdf:about="&a;100897958">
	<b:glossaryEntry>family of bacteria living usually in the alimentary canal or on mucous surfaces of warm-blooded animals; sometimes associated with acute infective processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100898237">
	<b:glossaryEntry>type genus of Bacteroidaceae; genus of gram-negative rodlike anaerobic bacteria producing no endospores and no pigment and living in the gut of man and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100898512"
	 b:glossaryEntry="a rodlike bacterium of the genus Bacteroides"/>
<rdf:Description rdf:about="&a;100898631"
	 b:glossaryEntry="the pus-producing bacterium that causes gonorrhea"/>
<rdf:Description rdf:about="&a;100898761"
	 b:glossaryEntry="enterobacteria"/>
<rdf:Description rdf:about="&a;100899001">
	<b:glossaryEntry>rod-shaped gram-negative bacteria; most occur normally or pathogenically in intestines of humans and other animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100899297"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100899418"
	 b:glossaryEntry="a genus of enteric bacteria"/>
<rdf:Description rdf:about="&a;100899540">
	<b:glossaryEntry>normally present in intestinal tract of humans and other animals; sometimes pathogenic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100899689"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100899809">
	<b:glossaryEntry>rod-shaped gram-negative enterobacteria; cause typhoid fever and food poisoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100900018"
	 b:glossaryEntry="a form of salmonella that causes gastroenteritis in humans"/>
<rdf:Description rdf:about="&a;100900166"
	 b:glossaryEntry="a form of salmonella that causes food poisoning in humans"/>
<rdf:Description rdf:about="&a;100900292"
	 b:glossaryEntry="a form of salmonella that causes typhoid fever"/>
<rdf:Description rdf:about="&a;100900441"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100900559">
	<b:glossaryEntry>rod-shaped gram-negative enterobacteria; some are pathogenic for warm-blooded animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100900736"
	 b:glossaryEntry="a bacillus that causes dysentery"/>
<rdf:Description rdf:about="&a;100900852"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100900969"
	 b:glossaryEntry="rod-shaped motile bacteria that attack plants"/>
<rdf:Description rdf:about="&a;100901087"
	 b:glossaryEntry="a group of true bacteria"/>
<rdf:Description rdf:about="&a;100901184"
	 b:glossaryEntry="pleomorphic gram-negative microorganisms"/>
<rdf:Description rdf:about="&a;100901363">
	<b:glossaryEntry>microorganism resembling bacteria inhabiting arthropod tissues but capable of causing disease in vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100901613"
	 b:glossaryEntry="can cause typhus and Rocky Mountain spotted fever in humans"/>
<rdf:Description rdf:about="&a;100901754">
	<b:glossaryEntry>rod-shaped microorganisms resembling both bacteria and viruses; live in biting arthropods and cause disease in vertebrate hosts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100901958">
	<b:glossaryEntry>a cell-free filtrate held to be a virus responsible for a specific neoplasm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100902109"
	 b:glossaryEntry="a tumor virus transmitted by leafhoppers"/>
<rdf:Description rdf:about="&a;100902219"
	 b:glossaryEntry="gram-negative parasites in warm-blooded vertebrates"/>
<rdf:Description rdf:about="&a;100902391">
	<b:glossaryEntry>type genus of the family Chlamydiaceae: disease-causing parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100902556">
	<b:glossaryEntry>coccoid rickettsia infesting birds and mammals; cause infections of eyes and lungs and genitourinary tract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100902737"
	 b:glossaryEntry="coextensive with the family Mycoplasmatacaea"/>
<rdf:Description rdf:about="&a;100902905">
	<b:glossaryEntry>pleomorphic gram-negative nonmotile microorganism similar to both viruses and bacteria; parasitic in mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100903140"
	 b:glossaryEntry="type and sole genus of the family Mycoplasmatacaea"/>
<rdf:Description rdf:about="&a;100903291">
	<b:glossaryEntry>the smallest self-reproducing prokaryote; lacks a cell wall and can survive without oxygen; can cause pneumonia and urinary tract infection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100903524">
	<b:glossaryEntry>antibiotic-resistant mycoplasma causing a kind of pneumonia in humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100903668"
	 b:glossaryEntry="filamentous or rod-shaped bacteria"/>
<rdf:Description rdf:about="&a;100903883">
	<b:glossaryEntry>any bacteria (some of which are pathogenic for humans and animals) belonging to the order Actinomycetales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100904066"
	 b:glossaryEntry="filamentous anaerobic bacteria"/>
<rdf:Description rdf:about="&a;100904223"
	 b:glossaryEntry="type genus of the family Actinomycetacaea"/>
<rdf:Description rdf:about="&a;100904366">
	<b:glossaryEntry>soil-inhabiting saprophytes and disease-producing plant and animal parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100904519"
	 b:glossaryEntry="higher bacteria typically aerobic soil saprophytes"/>
<rdf:Description rdf:about="&a;100904698"
	 b:glossaryEntry="type genus of the family Streptomycetacaea"/>
<rdf:Description rdf:about="&a;100904843">
	<b:glossaryEntry>aerobic bacteria some of which produce the antibiotic streptomycin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100905005">
	<b:glossaryEntry>cause of a potato disease characterized by brownish corky tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100905159"
	 b:glossaryEntry="a family of bacteria"/>
<rdf:Description rdf:about="&a;100905306"
	 b:glossaryEntry="nonmotile gram-positive aerobic bacteria"/>
<rdf:Description rdf:about="&a;100905450"
	 b:glossaryEntry="rod-shaped bacteria some saprophytic or causing diseases"/>
<rdf:Description rdf:about="&a;100905636"
	 b:glossaryEntry="cause of tuberculosis"/>
<rdf:Description rdf:about="&a;100905750"
	 b:glossaryEntry="any rod-shaped bacterium"/>
<rdf:Description rdf:about="&a;100905842"
	 b:glossaryEntry="any of various rod-shaped gram-negative bacteria"/>
<rdf:Description rdf:about="&a;100905952"
	 b:glossaryEntry="cause of leprosy"/>
<rdf:Description rdf:about="&a;100906054"
	 b:glossaryEntry="an order of higher bacteria"/>
<rdf:Description rdf:about="&a;100906285"
	 b:glossaryEntry="bacteria living mostly in soils and on dung"/>
<rdf:Description rdf:about="&a;100906494">
	<b:glossaryEntry>type genus of the family Polyangiaceae: myxobacteria with rounded fruiting bodies enclosed in a membrane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100906693">
	<b:glossaryEntry>bacteria that form colonies in self-produced slime; inhabit moist soils or decaying plant matter or animal waste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100906948">
	<b:glossaryEntry>spherical or elliptical usually aerobic eubacteria that produce yellow or orange or red pigment; includes toxin-producing forms as well as harmless commensals and saprophytes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100907264"
	 b:glossaryEntry="type genus of the family_Micrococcaceae"/>
<rdf:Description rdf:about="&a;100907400"
	 b:glossaryEntry="includes many pathogenic species"/>
<rdf:Description rdf:about="&a;100907537">
	<b:glossaryEntry>spherical gram-positive parasitic bacteria that tend to form irregular colonies; some cause boils or septicemia or infections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100907766">
	<b:glossaryEntry>lactic acid bacteria and important pathogens; bacteria that ferment carbohydrates chiefly into lactic acid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100908084"
	 b:glossaryEntry="type genus of the family Lactobacillaceae"/>
<rdf:Description rdf:about="&a;100908229">
	<b:glossaryEntry>gram-positive rod-shaped bacteria that produce lactic acid esp. in milk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100908379"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100908500"
	 b:glossaryEntry="gram-positive bacteria usually occurring in pairs"/>
<rdf:Description rdf:about="&a;100908644"
	 b:glossaryEntry="bacteria causing pneumonia"/>
<rdf:Description rdf:about="&a;100908754"
	 b:glossaryEntry="a genus of bacteria"/>
<rdf:Description rdf:about="&a;100908896">
	<b:glossaryEntry>spherical gram-positive bacteria occurring in pairs or chains; cause e.g. scarlet fever and tonsillitis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100909101"
	 b:glossaryEntry="a species of bacteria"/>
<rdf:Description rdf:about="&a;100909215"
	 b:glossaryEntry="higher bacteria; slender spiral rodlike forms"/>
<rdf:Description rdf:about="&a;100909420">
	<b:glossaryEntry>large coarsely spiral bacteria; free-living in fresh or salt water or commensal in bodies of oysters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100909645">
	<b:glossaryEntry>type genus of the family Spirochaetaceae; flexible undulating chiefly aquatic bacteria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100909828">
	<b:glossaryEntry>parasitic or free-living bacteria; many pathogenic to humans and other animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100910068"
	 b:glossaryEntry="small spirochetes some parasitic or pathogenic"/>
<rdf:Description rdf:about="&a;100910277">
	<b:glossaryEntry>type genus of Treponemataceae: anaerobic spirochetes with an undulating rigid body; parasitic in warm-blooded animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100910494"
	 b:glossaryEntry="cause of e.g. syphilis and yaws"/>
<rdf:Description rdf:about="&a;100910600">
	<b:glossaryEntry>small flexible parasitic spirochetes having three to five wavy spirals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100910788"
	 b:glossaryEntry="cause of e.g. European and African relapsing fever"/>
<rdf:Description rdf:about="&a;100910912">
	<b:glossaryEntry>cause of Lyme disease; transmitted primarily by ticks of genus Ixodes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100911093">
	<b:glossaryEntry>very slender aerobic spirochetes; free-living or parasitic in mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100911263">
	<b:glossaryEntry>important pathogens causing Weil''s disease or canicola fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100911399">
	<b:glossaryEntry>the aggregate of small plant and animal organisms that float or drift in great numbers in fresh or salt water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100911639">
	<b:glossaryEntry>photosynthetic or plant constituent of plankton; mainly unicellular algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100911809"
	 b:glossaryEntry="unicellular algae"/>
<rdf:Description rdf:about="&a;100911889">
	<b:glossaryEntry>animal constituent of plankton; mainly small crustaceans and fish larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100912038">
	<b:glossaryEntry>the aggregate of actively swimming animals in a body of water ranging from microscopic organisms to whales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100912216">
	<b:glossaryEntry>a minute life form (especially a disease-causing bacterium); the term is not in technical use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100912376">
	<b:glossaryEntry>an animal or plant that lives in or on another and from which it obtains nourishment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100912587">
	<b:glossaryEntry>any of various parasites that live in the internal organs of animals (especially intestinal worms)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100912812"
	 b:glossaryEntry="any external parasitic organism (as fleas)"/>
<rdf:Description rdf:about="&a;100912971">
	<b:glossaryEntry>an animal or plant that nourishes and supports a parasite; the host does not benefit and is often harmed by the association</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100913199">
	<b:glossaryEntry>a host that is used by a parasite in the course of its life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100913328">
	<b:glossaryEntry>the host in which the sexual reproduction of a parasite takes place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100913457">
	<b:glossaryEntry>any disease-producing agent esp. a virus or bacterium or other microorganism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100913588">
	<b:glossaryEntry>either of two different animal or plant species living in close association but not interdependent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100913742">
	<b:glossaryEntry>an organism such as an insect that habitually shares the nest of a species of ant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100913882">
	<b:glossaryEntry>in most modern classifications, replacement for the Protista; includes: Protozoa; Euglenophyta; Chlorophyta; Cryptophyta; Heterokontophyta; Rhodophyta; unicellular protists and their descendant multicellular organisms: regarded as distinct from plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100914453"
	 b:glossaryEntry="any of the unicellular protists"/>
<rdf:Description rdf:about="&a;100914596">
	<b:glossaryEntry>eukaryotic one-celled living organisms distinct from multicellular plants and animals: protozoa, slime molds, and eukaryotic algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100914839">
	<b:glossaryEntry>free-living or colonial organisms with diverse nutritional and reproductive modes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100915005">
	<b:glossaryEntry>any of a group of parasitic microorganisms that live in arthropods (as ticks and mites) and can cause disease if transmitted to human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100915202"
	 b:glossaryEntry="any of the families of Protoctista"/>
<rdf:Description rdf:about="&a;100915715"
	 b:glossaryEntry="any genus of Protoctista"/>
<rdf:Description rdf:about="&a;100916577">
	<b:glossaryEntry>in some classifications considered a superphylum or a subkingdom; comprises flagellates; ciliates; sporozoans; amoebas; foraminifers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100916896">
	<b:glossaryEntry>any of diverse minute acellular or unicellular organisms usually nonphotosynthetic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100917246">
	<b:glossaryEntry>characterized by the formation of pseudopods for locomotion and taking food: Actinopoda; Rhizopoda</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100917494"
	 b:glossaryEntry="protozoa that move and capture food by forming pseudopods"/>
<rdf:Description rdf:about="&a;100917658"
	 b:glossaryEntry="heliozoans; radiolarians"/>
<rdf:Description rdf:about="&a;100917837"
	 b:glossaryEntry="protozoa having stiff rodlike radiating pseudopods"/>
<rdf:Description rdf:about="&a;100917998"
	 b:glossaryEntry="mostly freshwater protozoa"/>
<rdf:Description rdf:about="&a;100918134">
	<b:glossaryEntry>protozoa with spherical bodies and stiff radiating pseudopods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100918270"
	 b:glossaryEntry="marine protozoa"/>
<rdf:Description rdf:about="&a;100918399">
	<b:glossaryEntry>protozoa with amoeba-like bodies and radiating filamentous pseudopods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100918545"
	 b:glossaryEntry="creeping protozoans: amoebas and foraminifers"/>
<rdf:Description rdf:about="&a;100918762"
	 b:glossaryEntry="protozoa characterized by a pseudopod"/>
<rdf:Description rdf:about="&a;100918940"
	 b:glossaryEntry="the animal order including amoebas"/>
<rdf:Description rdf:about="&a;100919150">
	<b:glossaryEntry>protozoan inhabiting moist soils or bottom vegetation in fresh or salt water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100919304">
	<b:glossaryEntry>a large family of endoparasitic amebas that invade the digestive tract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100919493"
	 b:glossaryEntry="the type genus of the family Endamoebidae"/>
<rdf:Description rdf:about="&a;100919646"
	 b:glossaryEntry="any ameba of the genus Endamoeba"/>
<rdf:Description rdf:about="&a;100919751">
	<b:glossaryEntry>naked freshwater or marine or parasitic protozoa that form temporary pseudopods for feeding and locomotion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100919955">
	<b:glossaryEntry>the parasitic ameba that causes amebic dysentery in human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100920106"
	 b:glossaryEntry="foraminifers"/>
<rdf:Description rdf:about="&a;100920293">
	<b:glossaryEntry>marine microorganism having a calcareous shell with openings where pseudopods protrude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100920500"
	 b:glossaryEntry="a family of protoctists"/>
<rdf:Description rdf:about="&a;100920627"
	 b:glossaryEntry="type genus of the family Globigerinidae"/>
<rdf:Description rdf:about="&a;100920749"
	 b:glossaryEntry="marine protozoan having a rounded shell with spiny processes"/>
<rdf:Description rdf:about="&a;100920867"
	 b:glossaryEntry="a family of fossil protoctists"/>
<rdf:Description rdf:about="&a;100921016"
	 b:glossaryEntry="large fossil protozoan of the Tertiary period"/>
<rdf:Description rdf:about="&a;100921136"
	 b:glossaryEntry="testacean rhizopods"/>
<rdf:Description rdf:about="&a;100921303">
	<b:glossaryEntry>any of various rhizopods of the order Testacea characterized by having a shell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100921456"
	 b:glossaryEntry="soil an freshwater protozoa; cosmopolitan"/>
<rdf:Description rdf:about="&a;100921612"
	 b:glossaryEntry="type genus of the Arcellidae"/>
<rdf:Description rdf:about="&a;100921738">
	<b:glossaryEntry>an amoeba-like protozoan with a chitinous shell resembling an umbrella</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100921881"
	 b:glossaryEntry="genus of protozoans related to Amoeba"/>
<rdf:Description rdf:about="&a;100922018"
	 b:glossaryEntry="a protozoan with an ovoid shell of cemented sand grains"/>
<rdf:Description rdf:about="&a;100922148">
	<b:glossaryEntry>class of protozoa having cilia or hairlike appendages on part or all of the surface during some part of the life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100922501">
	<b:glossaryEntry>a protozoan with a microscopic appendage extending from the surface of the cell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100922778">
	<b:glossaryEntry>in some recent classifications, coextensive with the Ciliata: minute organisms found in decomposing infusions of organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100923020"
	 b:glossaryEntry="any member of the subclass Infusoria"/>
<rdf:Description rdf:about="&a;100923132">
	<b:glossaryEntry>freshwater ciliate with an oval body and long deep oral groove</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100923295"
	 b:glossaryEntry="any member of the genus Paramecium"/>
<rdf:Description rdf:about="&a;100923417"
	 b:glossaryEntry="protozoa having four membranous ciliary organelles"/>
<rdf:Description rdf:about="&a;100923569"
	 b:glossaryEntry="relative of the paramecium; often used in genetics research"/>
<rdf:Description rdf:about="&a;100923705">
	<b:glossaryEntry>trumpet-shaped protozoa with a ciliated spiral feeding funnel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100923864"
	 b:glossaryEntry="any member of the genus Stentor"/>
<rdf:Description rdf:about="&a;100923968"
	 b:glossaryEntry="ciliates"/>
<rdf:Description rdf:about="&a;100924077">
	<b:glossaryEntry>protozoa having a transparent goblet-shaped body with a retractile stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100924225">
	<b:glossaryEntry>primitive chlorophyll-containing mainly aquatic eukaryotic organisms lacking true stems and roots and leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100924590"
	 b:glossaryEntry="plant growing in the sea, especially marine algae"/>
<rdf:Description rdf:about="&a;100924765"
	 b:glossaryEntry="dried seaweed esp. that cast ashore"/>
<rdf:Description rdf:about="&a;100924852"
	 b:glossaryEntry="any of various seaweeds that grow underwater in shallow beds"/>
<rdf:Description rdf:about="&a;100924967">
	<b:glossaryEntry>growth of marine vegetation esp. of the large forms such as rockweeds and kelp</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100925109">
	<b:glossaryEntry>any of a group of green pigments found in photosynthetic organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100925282">
	<b:glossaryEntry>a blue-black plant pigment having a blue-green alcohol solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100925405">
	<b:glossaryEntry>a dark-green plant pigment having a brilliant green alcohol solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100925533">
	<b:glossaryEntry>a substance in photosensitive bacteria that is related to but different from chlorophyll of higher plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100925704">
	<b:glossaryEntry>water-soluble proteinaceous pigments found in red algae and cyanobacteria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100925834">
	<b:glossaryEntry>any of a class of highly unsaturated yellow to red pigments occurring in plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100926018"
	 b:glossaryEntry="yellow or orange-red fat-soluble pigments in plants"/>
<rdf:Description rdf:about="&a;100926124">
	<b:glossaryEntry>yellow carotenoid pigments in plants and animal fats and egg yolks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100926270"
	 b:glossaryEntry="red pigment in red algae"/>
<rdf:Description rdf:about="&a;100926354"
	 b:glossaryEntry="blue pigment in algae"/>
<rdf:Description rdf:about="&a;100926433">
	<b:glossaryEntry>algae having chlorophyll a and usually c, and flagella of unequal lengths; terminology supersedes Chrysophyta in some classifications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100926676">
	<b:glossaryEntry>mostly freshwater eukaryotic algae having the chlorophyll masked by brown or yellow pigment; yellow-green and golden-brown algae and diatoms: Xanthophyceae, Chrysophyceae, Bacillariophyceae; some some classification systems superseded or subsumed by Heterokontophyta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100927156">
	<b:glossaryEntry>algae having the pigments chlorophyll and carotene and xanthophyll</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100927300">
	<b:glossaryEntry>any alga of the division Chrysophyta with its chlorophyll masked by yellow pigment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100927484"
	 b:glossaryEntry="all the yellow-green algae having flagella of unequal length"/>
<rdf:Description rdf:about="&a;100927681"
	 b:glossaryEntry="yellow-green algae"/>
<rdf:Description rdf:about="&a;100927800"
	 b:glossaryEntry="marine and freshwater eukaryotic algae: diatoms"/>
<rdf:Description rdf:about="&a;100928015">
	<b:glossaryEntry>microscopic unicellular marine or freshwater colonial alga having cell walls impregnated with silica</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100928187">
	<b:glossaryEntry>yellow-green_algae with simple or branching filaments; comprising the single family Tribonemaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100928408"
	 b:glossaryEntry="simple filamentous freshwater yellow-green algae"/>
<rdf:Description rdf:about="&a;100928577"
	 b:glossaryEntry="type genus of Tribonemaceae"/>
<rdf:Description rdf:about="&a;100928733">
	<b:glossaryEntry>any of various algae of the genus Tribonema; algae with branching filaments that form scum in still or stagnant fresh water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100928930">
	<b:glossaryEntry>algae resembling confervae especially in having branching filaments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100929060"
	 b:glossaryEntry="brown algae; mostly marine and littoral eukaryotic algae"/>
<rdf:Description rdf:about="&a;100929272">
	<b:glossaryEntry>coextensive with class Phaeophyceae; in some classifications subsumed in the division Heterokontophyta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100929491">
	<b:glossaryEntry>algae having the chlorophyll masked by brown and yellow pigments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100929722">
	<b:glossaryEntry>in some classifications coextensive with family Laminariaceae: marine brown algae of cold or polar seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100929943">
	<b:glossaryEntry>large family of marine brown algae including many economically important large kelps chiefly of northern waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100930175">
	<b:glossaryEntry>type genus of the family Laminariaceae: perennial brown kelps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100930348"
	 b:glossaryEntry="large brown seaweeds having fluted leathery fronds"/>
<rdf:Description rdf:about="&a;100930486"
	 b:glossaryEntry="any of various kelps esp. of the genus Laminaria"/>
<rdf:Description rdf:about="&a;100930598"
	 b:glossaryEntry="any of various coarse seaweeds"/>
<rdf:Description rdf:about="&a;100930690"
	 b:glossaryEntry="coextensive with the family Fucaceae"/>
<rdf:Description rdf:about="&a;100930853">
	<b:glossaryEntry>in more recent classifications superseded by the order Fucales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100931014"
	 b:glossaryEntry="small family of brown algae: gulfweeds; rockweeds"/>
<rdf:Description rdf:about="&a;100931250"
	 b:glossaryEntry="any of various algae of the family Fucaceae"/>
<rdf:Description rdf:about="&a;100931380">
	<b:glossaryEntry>a fossilized cast or impression of algae of the order Fucales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100931513"
	 b:glossaryEntry="coarse brown seaweed growing on rocks exposed at low tide"/>
<rdf:Description rdf:about="&a;100931698"
	 b:glossaryEntry="type genus of the family Fucaceae: cartilaginous brown algae"/>
<rdf:Description rdf:about="&a;100931892"
	 b:glossaryEntry="any member of the genus Fucus"/>
<rdf:Description rdf:about="&a;100931992"
	 b:glossaryEntry="brown algae seaweed with serrated edges"/>
<rdf:Description rdf:about="&a;100932135"
	 b:glossaryEntry="common black rockweed used in preparing kelp and as manure"/>
<rdf:Description rdf:about="&a;100932331">
	<b:glossaryEntry>brown algae distinguished by compressed or inflated branchlets along the axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100932505"
	 b:glossaryEntry="similar to and found with black rockweed"/>
<rdf:Description rdf:about="&a;100932626"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100932748">
	<b:glossaryEntry>brown algae with rounded bladders forming dense floating masses in tropical Atlantic waters as in the Sargasso Sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100932982"
	 b:glossaryEntry="free-swimming flagellate algae"/>
<rdf:Description rdf:about="&a;100933152"
	 b:glossaryEntry="coextensive with the division Euglenophyta"/>
<rdf:Description rdf:about="&a;100933316"
	 b:glossaryEntry="considered green algae"/>
<rdf:Description rdf:about="&a;100933455">
	<b:glossaryEntry>type genus of the family Euglenaceae: green algae with a single flagellum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100933626">
	<b:glossaryEntry>minute single-celled green freshwater organism having a single flagella; often classed as algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100933794"
	 b:glossaryEntry="marine and freshwater green or colorless flagellate organism"/>
<rdf:Description rdf:about="&a;100933955">
	<b:glossaryEntry>large division of chiefly freshwater eukaryotic algae that possess chlorophyll a and b, store food as starch, and cellulose cell walls; classes Chlorophyceae, Ulvophyceae, and Charophyceae; obviously ancestral to land plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100934355">
	<b:glossaryEntry>algae distinguished chiefly by having flagella and a clear green color, their chlorophyll being masked little if at all by other pigments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100934688">
	<b:glossaryEntry>algae that are clear green in color; often growing on wet ricks or damp wood or the surface of stagnant water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100934978">
	<b:glossaryEntry>alternative name for the class Chlorophyceae in some classifications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100935143"
	 b:glossaryEntry="an order of protoctista"/>
<rdf:Description rdf:about="&a;100935274"
	 b:glossaryEntry="thin flat or tubular green algae"/>
<rdf:Description rdf:about="&a;100935438">
	<b:glossaryEntry>type genus of the family Ulvaceae; green seaweed having a thallus two cells thick: sea lettuce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100935634"
	 b:glossaryEntry="seaweed with edible translucent crinkly green fronds"/>
<rdf:Description rdf:about="&a;100935771"
	 b:glossaryEntry="chiefly freshwater green algae; solitary or colonial"/>
<rdf:Description rdf:about="&a;100935956">
	<b:glossaryEntry>unicellular or colonial biflagellate free-swimming flagellates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100936135">
	<b:glossaryEntry>type genus of the Volvocaceae; minute pale green flagellates occurring in tiny spherical colonies; minute flagella rotate the colony about an axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100936368"
	 b:glossaryEntry="green algae some of which are colored red by hematochrome"/>
<rdf:Description rdf:about="&a;100936556">
	<b:glossaryEntry>type genus of the Chlamydomonadaceae; solitary doubly-flagellated plant-like algae common in fresh water and damp soil; multiply freely; often a pest around filtration plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100936831"
	 b:glossaryEntry="pond scums; desmids"/>
<rdf:Description rdf:about="&a;100937000">
	<b:glossaryEntry>pond scums: common freshwater algae forming green slimy masses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100937221"
	 b:glossaryEntry="type genus of the family Zygnemataceae"/>
<rdf:Description rdf:about="&a;100937348"
	 b:glossaryEntry="free-floating freshwater green algae"/>
<rdf:Description rdf:about="&a;100937459"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100937581">
	<b:glossaryEntry>freshwater algae consisting of minute filaments containing spiral chlorophyll bands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100937739"
	 b:glossaryEntry="unicellular green algae that reproduce by spores"/>
<rdf:Description rdf:about="&a;100937928">
	<b:glossaryEntry>type genus of Chlorococcales; unicellular green algae occurring singly or in a layer on soil or damp rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100938132">
	<b:glossaryEntry>nonmotile unicellular green algae potentially important as source of high-grade protein and B-complex vitamins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100938342"
	 b:glossaryEntry="any alga of the genus Chlorella"/>
<rdf:Description rdf:about="&a;100938448"
	 b:glossaryEntry="simple or branched filamentous freshwater green algae"/>
<rdf:Description rdf:about="&a;100938619"
	 b:glossaryEntry="filamentous green algae"/>
<rdf:Description rdf:about="&a;100938763">
	<b:glossaryEntry>type genus of Oedogoniaceae; freshwater green algae having long unbranched filaments; usually free-floating when mature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100938977"
	 b:glossaryEntry="in some classifications: contains only the order Charales"/>
<rdf:Description rdf:about="&a;100939171">
	<b:glossaryEntry>small order of macroscopic fresh and brackish water algae with a distinct axis: stoneworts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100939371">
	<b:glossaryEntry>green algae superficially resembling horsetail ferns: stoneworts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100939586">
	<b:glossaryEntry>any of various submerged aquatic algae of the genus Chara having nodes with whorled filamentlike branches; usually encrusted with calcium carbonate deposits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100939817">
	<b:glossaryEntry>green algae common in freshwater lakes of limestone districts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100939963"
	 b:glossaryEntry="fragile branching stoneworts"/>
<rdf:Description rdf:about="&a;100940080"
	 b:glossaryEntry="unicellular algae"/>
<rdf:Description rdf:about="&a;100940216"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100940349"
	 b:glossaryEntry="freshwater green algae"/>
<rdf:Description rdf:about="&a;100940442"
	 b:glossaryEntry="lower plants; mostly marine and littoral eukaryotic algae"/>
<rdf:Description rdf:about="&a;100940635"
	 b:glossaryEntry="coextensive with the Rhodophyta: red algae"/>
<rdf:Description rdf:about="&a;100940834">
	<b:glossaryEntry>marine algae in which the chlorophyll is masked by a red or purplish pigment; source of agar and carrageenan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100941108">
	<b:glossaryEntry>any of various red algae having graceful rose to purple fronds (e.g. dulse or carrageen)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100941251"
	 b:glossaryEntry="a family of protoctista"/>
<rdf:Description rdf:about="&a;100941395"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100941527">
	<b:glossaryEntry>dark purple edible seaweed of the Atlantic coasts of Europe and North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100941735"
	 b:glossaryEntry="a family of protoctista"/>
<rdf:Description rdf:about="&a;100941881"
	 b:glossaryEntry="type genus of the family Rhodymeniaceae"/>
<rdf:Description rdf:about="&a;100942034"
	 b:glossaryEntry="coarse edible red seaweed"/>
<rdf:Description rdf:about="&a;100942151"
	 b:glossaryEntry="a family of protoctista"/>
<rdf:Description rdf:about="&a;100942289"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100942421"
	 b:glossaryEntry="edible red seaweeds"/>
<rdf:Description rdf:about="&a;100942523">
	<b:glossaryEntry>an organism with cells characteristic of all life forms except primitive microorganisms such as bacteria; i.e. an organism with `good'' or membrane-bound nuclei in its cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100942781">
	<b:glossaryEntry>a unicellular organism having cells lacking membrane-bound nuclei; bacteria are the prime example but also included are blue-green algae and actinomycetes and mycoplasma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100943038">
	<b:glossaryEntry>one of the distinct individuals forming a colonial animal such as a bryozoan or hydrozoan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100943179"
	 b:glossaryEntry="protozoa having flagella"/>
<rdf:Description rdf:about="&a;100943410">
	<b:glossaryEntry>usually nonphotosynthetic free-living protozoan with whiplike appendages; some pathogens of humans and other animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100943783">
	<b:glossaryEntry>in some classifications considered a phylum of the kingdom Protista; in others included in the plant phylum Pyrrophyta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100944103">
	<b:glossaryEntry>chiefly marine protozoa having two flagella; a chief constituent of plankton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100944295"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100944417"
	 b:glossaryEntry="large bioluminescent marine protozoan"/>
<rdf:Description rdf:about="&a;100944550"
	 b:glossaryEntry="marine and freshwater dinoflagellates"/>
<rdf:Description rdf:about="&a;100944725"
	 b:glossaryEntry="type genus of the family Peridiniidae"/>
<rdf:Description rdf:about="&a;100944857"
	 b:glossaryEntry="flagellate with a thick test composed of plates"/>
<rdf:Description rdf:about="&a;100944980">
	<b:glossaryEntry>in some classifications considered a phylum of the kingdom Protista; holozoic or saprozoic flagellates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100945241">
	<b:glossaryEntry>flagellate protozoan lacking photosynthesis and other plant-like characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100945415"
	 b:glossaryEntry="cellulose-producing flagellates"/>
<rdf:Description rdf:about="&a;100945568"
	 b:glossaryEntry="flagellate symbiotic in the intestines of e.g. termites"/>
<rdf:Description rdf:about="&a;100945703"
	 b:glossaryEntry="small usually parasitic flagellates"/>
<rdf:Description rdf:about="&a;100945953"
	 b:glossaryEntry="flagellates with several flagella"/>
<rdf:Description rdf:about="&a;100946065"
	 b:glossaryEntry="a genus of flagellate protoctista"/>
<rdf:Description rdf:about="&a;100946195">
	<b:glossaryEntry>a flagellate that is the cause of the frequently fatal fish disease costiasis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100946362"
	 b:glossaryEntry="flagellates parasitic in intestines of vertebrates"/>
<rdf:Description rdf:about="&a;100946510"
	 b:glossaryEntry="a suspected cause of diarrhea in humans"/>
<rdf:Description rdf:about="&a;100946622">
	<b:glossaryEntry>flagellates parasitic in intestines of vertebrates including humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100946786"
	 b:glossaryEntry="flagellates free-living or parasitic in intestines of birds"/>
<rdf:Description rdf:about="&a;100946936">
	<b:glossaryEntry>flagellates parasitic in alimentary or genitourinary tracts of vertebrates and invertebrates including humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100947147"
	 b:glossaryEntry="cause of trichomoniasis in women and cattle and birds"/>
<rdf:Description rdf:about="&a;100947277">
	<b:glossaryEntry>plantlike flagellates containing chlorophyll; often considered unicellular algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100947482">
	<b:glossaryEntry>unicellular organisms having many characteristics of typical algae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100947634"
	 b:glossaryEntry="a phylum in the kingdom Protoctista"/>
<rdf:Description rdf:about="&a;100947786"
	 b:glossaryEntry="motile usually brownish-green protozoa-like algae"/>
<rdf:Description rdf:about="&a;100947955">
	<b:glossaryEntry>common in fresh and salt water appearing along the shore as algal blooms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100948118">
	<b:glossaryEntry>strictly parasitic protozoans that are usually immobile; includes plasmodia and coccidia and piroplasms and malaria parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100948429"
	 b:glossaryEntry="parasitic spore-forming protozoan"/>
<rdf:Description rdf:about="&a;100948807">
	<b:glossaryEntry>one of the minute active bodies into which sporozoans divide in one stage of their life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100948957"
	 b:glossaryEntry="a sporozoan in the active feeding stage of its life cycle"/>
<rdf:Description rdf:about="&a;100949072">
	<b:glossaryEntry>a cell that arises from the asexual division of a parent sporozoan during its life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100949216">
	<b:glossaryEntry>parasitic sporozoans that form spores containing one or more infective sporozoites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100949457"
	 b:glossaryEntry="an order in the subclass Telosporidia"/>
<rdf:Description rdf:about="&a;100949623"
	 b:glossaryEntry="a family of protoctista in the order Coccidia"/>
<rdf:Description rdf:about="&a;100949783">
	<b:glossaryEntry>type genus of the family Eimeriidae; includes serious pathogens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100949925">
	<b:glossaryEntry>parasitic on the digestive epithelium of vertebrates and higher invertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100950087"
	 b:glossaryEntry="an order in the subclass Telosporidia"/>
<rdf:Description rdf:about="&a;100950240">
	<b:glossaryEntry>vermiform protozoans parasitic in insects and other invertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100950380"
	 b:glossaryEntry="an order in the subclass Telosporidia"/>
<rdf:Description rdf:about="&a;100950594">
	<b:glossaryEntry>minute protozoans parasitic at some stage of the life cycle in blood cells of vertebrates including many pathogens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100950788"
	 b:glossaryEntry="malaria parasites"/>
<rdf:Description rdf:about="&a;100950905"
	 b:glossaryEntry="type genus of the family Plasmodiidae"/>
<rdf:Description rdf:about="&a;100951043">
	<b:glossaryEntry>parasitic protozoan of the genus Plasmodium that causes malaria in humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100951230"
	 b:glossaryEntry="bird parasites"/>
<rdf:Description rdf:about="&a;100951405">
	<b:glossaryEntry>related to malaria parasite and having a phase in the viscera of various birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100951561"
	 b:glossaryEntry="type genus of the family Haemoproteidae"/>
<rdf:Description rdf:about="&a;100951699"
	 b:glossaryEntry="a genus of protoctista"/>
<rdf:Description rdf:about="&a;100951847"
	 b:glossaryEntry="parasitic in birds"/>
<rdf:Description rdf:about="&a;100951960"
	 b:glossaryEntry="piroplasms and cattle pathogens"/>
<rdf:Description rdf:about="&a;100952125"
	 b:glossaryEntry="type genus of the family Babesiidae"/>
<rdf:Description rdf:about="&a;100952258">
	<b:glossaryEntry>minute parasite of red blood cells of mammals transmitted by a tick and causing diseases of domestic animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100952441"
	 b:glossaryEntry="a subclass of Sporozoa"/>
<rdf:Description rdf:about="&a;100952607"
	 b:glossaryEntry="imperfectly known parasites of the muscles of vertebrates"/>
<rdf:Description rdf:about="&a;100952784"
	 b:glossaryEntry="chief genus of the order Sarcosporidia"/>
<rdf:Description rdf:about="&a;100952938"
	 b:glossaryEntry="parasite of the muscles of vertebrates"/>
<rdf:Description rdf:about="&a;100953090"
	 b:glossaryEntry="an order in the subclass Acnidosporidia"/>
<rdf:Description rdf:about="&a;100953249">
	<b:glossaryEntry>parasite in invertebrates and lower vertebrates of no known economic importance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100953408"
	 b:glossaryEntry="single-host parasites of lower vertebrates and invertebrates"/>
<rdf:Description rdf:about="&a;100953629"
	 b:glossaryEntry="parasites of worms"/>
<rdf:Description rdf:about="&a;100953767"
	 b:glossaryEntry="parasites of worms"/>
<rdf:Description rdf:about="&a;100953865"
	 b:glossaryEntry="an order in the subclass Cnidosporidia"/>
<rdf:Description rdf:about="&a;100954023">
	<b:glossaryEntry>parasite of arthropods and fishes that invade and destroy host cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100954171"
	 b:glossaryEntry="an order in the subclass Cnidosporidia"/>
<rdf:Description rdf:about="&a;100954327">
	<b:glossaryEntry>mostly parasitic in fishes and including various serious pathogens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100954472">
	<b:glossaryEntry>temporary outgrowth used by some microorganisms as an organ of feeding or locomotion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100954627">
	<b:glossaryEntry>multinucleate sheet of cytoplasm characteristic of some stages of such organisms as slime molds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100954779">
	<b:glossaryEntry>an extensive group of teleost fishes having fins supported by flexible cartilaginous rays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100955204"
	 b:glossaryEntry="any fish of the superorder Malacopterygii"/>
<rdf:Description rdf:about="&a;100955796">
	<b:glossaryEntry>in some classifications considered a superorder comprising the Cypriniformes and the Siluriformes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100955973"
	 b:glossaryEntry="any of various families of fish"/>
<rdf:Description rdf:about="&a;100959105"
	 b:glossaryEntry="any of various genus of fish"/>
<rdf:Description rdf:about="&a;100964339">
	<b:glossaryEntry>an order of animals including almost entirely freshwater fishes: characins; loaches; carp; suckers; sometimes classified as a suborder of Ostariophysi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100964742"
	 b:glossaryEntry="a soft-finned fish of the order Cypriniformes"/>
<rdf:Description rdf:about="&a;100964995"
	 b:glossaryEntry="loaches"/>
<rdf:Description rdf:about="&a;100965115">
	<b:glossaryEntry>slender freshwater fishes of Eurasia and Africa resembling catfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100965254"
	 b:glossaryEntry="a family of fish including: carp; tench; roach; rudd; dace"/>
<rdf:Description rdf:about="&a;100965655">
	<b:glossaryEntry>soft-finned mainly freshwater fishes typically having toothless jaws and cycloid scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100966030"
	 b:glossaryEntry="any of various freshwater fish of the family_Cyprinidae"/>
<rdf:Description rdf:about="&a;100966173"
	 b:glossaryEntry="type genus of the family Cyprinidae: carp"/>
<rdf:Description rdf:about="&a;100966324">
	<b:glossaryEntry>large Old World freshwater bottom-feeding fish introduced into Europe from Asia; inhabits ponds and sluggish streams and often raised for food; introduced into United States where it has become a pest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100966676"
	 b:glossaryEntry="scaleless domestic carp"/>
<rdf:Description rdf:about="&a;100966758"
	 b:glossaryEntry="domestic carp with some large large shining scales"/>
<rdf:Description rdf:about="&a;100966866"
	 b:glossaryEntry="European fishes"/>
<rdf:Description rdf:about="&a;100966989">
	<b:glossaryEntry>European freshwater fish having a flattened body and silvery scales; of little value as food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100967177"
	 b:glossaryEntry="tench"/>
<rdf:Description rdf:about="&a;100967286">
	<b:glossaryEntry>freshwater dace-like game fish of Europe and western Asia noted for ability to survive outside water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100967471"
	 b:glossaryEntry="a genus of fish including: dace, chub"/>
<rdf:Description rdf:about="&a;100967639">
	<b:glossaryEntry>small European freshwater fish with a slender bluish-green body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100967794">
	<b:glossaryEntry>European freshwater game fish with a thick spindle-shaped body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100967947">
	<b:glossaryEntry>any of numerous small silvery North American cyprinid fishes especially of the genus Notropis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100968147"
	 b:glossaryEntry="shiners"/>
<rdf:Description rdf:about="&a;100968264">
	<b:glossaryEntry>small blunt-nosed fish of Great Lakes and Mississippi valley with a greenish luster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100968432"
	 b:glossaryEntry="the common North American shiner"/>
<rdf:Description rdf:about="&a;100968577"
	 b:glossaryEntry="golden shiners"/>
<rdf:Description rdf:about="&a;100968688">
	<b:glossaryEntry>shiner of eastern North America having golden glints; sometimes also called `bream''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100968857"
	 b:glossaryEntry="roaches"/>
<rdf:Description rdf:about="&a;100968972"
	 b:glossaryEntry="European freshwater food fish having a greenish back"/>
<rdf:Description rdf:about="&a;100969113"
	 b:glossaryEntry="rudds"/>
<rdf:Description rdf:about="&a;100969232"
	 b:glossaryEntry="European freshwater fish resembling the roach"/>
<rdf:Description rdf:about="&a;100969377"
	 b:glossaryEntry="minnows"/>
<rdf:Description rdf:about="&a;100969494">
	<b:glossaryEntry>very small European freshwater fish common in gravelly streams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100969648"
	 b:glossaryEntry="true gudgeons"/>
<rdf:Description rdf:about="&a;100969765">
	<b:glossaryEntry>small slender European freshwater fish often used as bait by anglers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100969920"
	 b:glossaryEntry="goldfish"/>
<rdf:Description rdf:about="&a;100970059">
	<b:glossaryEntry>small golden or orange-red freshwater fishes of Eurasia used as pond or aquarium fishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100970258"
	 b:glossaryEntry="a silvery variety of Carassius auratus"/>
<rdf:Description rdf:about="&a;100970353"
	 b:glossaryEntry="European carp closely resembling wild goldfish"/>
<rdf:Description rdf:about="&a;100970520"
	 b:glossaryEntry="small family comprising the electric eels"/>
<rdf:Description rdf:about="&a;100970686"
	 b:glossaryEntry="type genus of the family_Electrophoridae; electric eels"/>
<rdf:Description rdf:about="&a;100970861">
	<b:glossaryEntry>eel-shaped freshwater fish of South America having electric organs in its body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100971042"
	 b:glossaryEntry="suckers; closely related to the family Cyprinidae"/>
<rdf:Description rdf:about="&a;100971305"
	 b:glossaryEntry="a cypriniform fish of the family Catostomidae"/>
<rdf:Description rdf:about="&a;100971444">
	<b:glossaryEntry>mostly North American freshwater fishes with a thick-lipped mouth for feeding by suction; related to carps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100971695"
	 b:glossaryEntry="type genus of the family Catostomidae"/>
<rdf:Description rdf:about="&a;100971827"
	 b:glossaryEntry="buffalo fishes"/>
<rdf:Description rdf:about="&a;100971951"
	 b:glossaryEntry="any of several large suckers of the Mississippi valley"/>
<rdf:Description rdf:about="&a;100972115"
	 b:glossaryEntry="fish of the lower Mississippi"/>
<rdf:Description rdf:about="&a;100972240"
	 b:glossaryEntry="a genus of fish in the family Catostomidae"/>
<rdf:Description rdf:about="&a;100972379"
	 b:glossaryEntry="widely distributed in warm clear shallow streams"/>
<rdf:Description rdf:about="&a;100972521"
	 b:glossaryEntry="a genus of fish in the family Catostomidae"/>
<rdf:Description rdf:about="&a;100972675"
	 b:glossaryEntry="North American sucker with reddish fins"/>
<rdf:Description rdf:about="&a;100972806">
	<b:glossaryEntry>large family of small soft-finned fishes; killifishes; flagfishes; swordtails; guppies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100973112"
	 b:glossaryEntry="any member of the family Cyprinodontidae"/>
<rdf:Description rdf:about="&a;100973283">
	<b:glossaryEntry>small mostly marine warm-water carp-like schooling fishes; used as bait or aquarium fishes or in mosquito control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100973524"
	 b:glossaryEntry="killifish"/>
<rdf:Description rdf:about="&a;100973662">
	<b:glossaryEntry>silver-and-black killifish of saltwater marshes along the United States Atlantic coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100973847">
	<b:glossaryEntry>black-barred fish of bays and coastal marshes of United States Atlantic and Gulf coasts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100974046"
	 b:glossaryEntry="killifish"/>
<rdf:Description rdf:about="&a;100974153">
	<b:glossaryEntry>found in small streams of tropical America; often kept in aquariums; usually hermaphroditic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100974317"
	 b:glossaryEntry="flagfishes"/>
<rdf:Description rdf:about="&a;100974441">
	<b:glossaryEntry>flagfish with a dark-blue back and whitish sides with red stripes; found in swamps and streams of Florida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100974662"
	 b:glossaryEntry="swordtails"/>
<rdf:Description rdf:about="&a;100974788">
	<b:glossaryEntry>freshwater fish of Central America having a long swordlike tail; popular aquarium fish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100974993"
	 b:glossaryEntry="guppies"/>
<rdf:Description rdf:about="&a;100975091">
	<b:glossaryEntry>small freshwater fish of South America and West Indies; often kept in aquariums</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100975260"
	 b:glossaryEntry="topminnows"/>
<rdf:Description rdf:about="&a;100975444">
	<b:glossaryEntry>small usually brightly-colored viviparous surface-feeding fishes of fresh or brackish warm waters; often used in mosquito control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100975745"
	 b:glossaryEntry="mosquitofish"/>
<rdf:Description rdf:about="&a;100975867">
	<b:glossaryEntry>silvery topminnow with rows of black spots of tropical North America and West Indies; important in mosquito control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100976079"
	 b:glossaryEntry="platys"/>
<rdf:Description rdf:about="&a;100976205"
	 b:glossaryEntry="small stocky Mexican fish; popular aquarium fish"/>
<rdf:Description rdf:about="&a;100976350"
	 b:glossaryEntry="mollies"/>
<rdf:Description rdf:about="&a;100976473"
	 b:glossaryEntry="popular aquarium fish"/>
<rdf:Description rdf:about="&a;100976574">
	<b:glossaryEntry>an order of spiny-finned fish in the superorder Acanthopterygii</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100976774"
	 b:glossaryEntry="squirrelfishes and soldierfishes"/>
<rdf:Description rdf:about="&a;100976946"
	 b:glossaryEntry="type genus of the family Holocentridae; squirrelfishes"/>
<rdf:Description rdf:about="&a;100977154">
	<b:glossaryEntry>very small brightly colored (esp. red) nocturnal fishes of shallow waters of tropical reefs; they make sounds like a squirrel''s bark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100977436"
	 b:glossaryEntry="on reefs from Bermuda and Florida to northern South America"/>
<rdf:Description rdf:about="&a;100977601">
	<b:glossaryEntry>a squirrelfish found from South Carolina to Bermuda and Gulf of Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100977781"
	 b:glossaryEntry="bright red fish of West Indies and Bermuda"/>
<rdf:Description rdf:about="&a;100977912"
	 b:glossaryEntry="the larger squirrelfishes"/>
<rdf:Description rdf:about="&a;100977995"
	 b:glossaryEntry="a family of fish including: flashlight fishes"/>
<rdf:Description rdf:about="&a;100978197"
	 b:glossaryEntry="type genus of the family Anomalopidae"/>
<rdf:Description rdf:about="&a;100978334">
	<b:glossaryEntry>fish having a luminous organ beneath eye; of warm waters of the western Pacific and Puerto Rico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100978522"
	 b:glossaryEntry="a genus of fish in the family Anomalopidae"/>
<rdf:Description rdf:about="&a;100978671"
	 b:glossaryEntry="a genus of fish in the family Anomalopidae"/>
<rdf:Description rdf:about="&a;100978816"
	 b:glossaryEntry="fish of deep dark waters having a light organ below each eye"/>
<rdf:Description rdf:about="&a;100978967"
	 b:glossaryEntry="dories"/>
<rdf:Description rdf:about="&a;100979104"
	 b:glossaryEntry="a family of fish in the order Zeomorphi"/>
<rdf:Description rdf:about="&a;100979269">
	<b:glossaryEntry>marine fishes widely distributed in mid-waters and deep slope waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100979425"
	 b:glossaryEntry="type genus of the family Zeidae"/>
<rdf:Description rdf:about="&a;100979558"
	 b:glossaryEntry="European dory"/>
<rdf:Description rdf:about="&a;100979659"
	 b:glossaryEntry="boarfishes"/>
<rdf:Description rdf:about="&a;100979801"
	 b:glossaryEntry="a genus of fish in the family Caproidae"/>
<rdf:Description rdf:about="&a;100979946"
	 b:glossaryEntry="fish with a projecting snout"/>
<rdf:Description rdf:about="&a;100980062"
	 b:glossaryEntry="a genus of fish in the family Caproidae"/>
<rdf:Description rdf:about="&a;100980213"
	 b:glossaryEntry="long-snouted fishes with large eyes"/>
<rdf:Description rdf:about="&a;100980322">
	<b:glossaryEntry>bellows fishes; shrimpfishes; cornetfishes; pipefishes; small order of chiefly tropical marine fishes of varied and bizarre form all having a small mouth at the end of a drawn-out tubular snout</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100980730"
	 b:glossaryEntry="cornetfishes"/>
<rdf:Description rdf:about="&a;100980863"
	 b:glossaryEntry="type genus of the family Fistulariidae"/>
<rdf:Description rdf:about="&a;100981015">
	<b:glossaryEntry>slender tropical fish with a long tubular snout and bony plates instead of scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100981172"
	 b:glossaryEntry="sticklebacks"/>
<rdf:Description rdf:about="&a;100981326">
	<b:glossaryEntry>small (2-4 inches) pugnacious mostly scaleless spiny-backed fishes of northern fresh and littoral waters having elaborate courtship; subjects of much research</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100981611"
	 b:glossaryEntry="type genus of the family Gasterosteidae"/>
<rdf:Description rdf:about="&a;100981787"
	 b:glossaryEntry="of rivers and coastal regions"/>
<rdf:Description rdf:about="&a;100981931"
	 b:glossaryEntry="confined to rivers"/>
<rdf:Description rdf:about="&a;100982062"
	 b:glossaryEntry="pipefishes"/>
<rdf:Description rdf:about="&a;100982248">
	<b:glossaryEntry>fish with long tubular snout and slim body covered with bony plates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100982456"
	 b:glossaryEntry="type genus of the family_Syngnathidae"/>
<rdf:Description rdf:about="&a;100982607"
	 b:glossaryEntry="small (4 inches) fish found off Florida gulf coast"/>
<rdf:Description rdf:about="&a;100982762"
	 b:glossaryEntry="a genus of fish in the family Syngnathidae"/>
<rdf:Description rdf:about="&a;100982920"
	 b:glossaryEntry="8 inches; from eastern Florida to western Caribbean"/>
<rdf:Description rdf:about="&a;100983079"
	 b:glossaryEntry="seahorses"/>
<rdf:Description rdf:about="&a;100983204">
	<b:glossaryEntry>small fish with horselike heads bent sharply downward and curled tails; swim in upright position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100983386"
	 b:glossaryEntry="bellows fishes"/>
<rdf:Description rdf:about="&a;100983529">
	<b:glossaryEntry>small bottom-dwelling fish of warm seas having a compressed body and a long snout with a toothless mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100983723"
	 b:glossaryEntry="shrimpfishes"/>
<rdf:Description rdf:about="&a;100983854">
	<b:glossaryEntry>slender tropical shallow-water East Indian fish covered with transparent plates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100984009"
	 b:glossaryEntry="trumpetfishes"/>
<rdf:Description rdf:about="&a;100984141"
	 b:glossaryEntry="type genus of the Aulostomidae"/>
<rdf:Description rdf:about="&a;100984285"
	 b:glossaryEntry="tropical Atlantic fish with a long snout; swims snout down"/>
<rdf:Description rdf:about="&a;100984443"
	 b:glossaryEntry="mouth of a protozoan"/>
<rdf:Description rdf:about="&a;100984538">
	<b:glossaryEntry>hairlike projection from the surface of a cell; provides locomotion in free unicellular organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100984688">
	<b:glossaryEntry>long lash-like appendage used for locomotion (e.g., in sperm cells and some protozoa)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100984867"
	 b:glossaryEntry="organ of excretion in flatworms"/>
<rdf:Description rdf:about="&a;100984974"
	 b:glossaryEntry="outer layer or covering of an organ or part or organism"/>
<rdf:Description rdf:about="&a;100985104"
	 b:glossaryEntry="thin protective membrane in some protozoa"/>
<rdf:Description rdf:about="&a;100985200">
	<b:glossaryEntry>an animal organism in the early stages of growth and differentiation that in higher forms merge into fetal stages but in lower forms terminate in commencement of larval life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100985510"
	 b:glossaryEntry="the cavity inside a blastula"/>
<rdf:Description rdf:about="&a;100985654"
	 b:glossaryEntry="a layer of cells on the inside of the blastula"/>
<rdf:Description rdf:about="&a;100985802"
	 b:glossaryEntry="any cell resulting from cleavage of a fertilized egg"/>
<rdf:Description rdf:about="&a;100985911">
	<b:glossaryEntry>an unborn or unhatched vertebrate in the later stages of development showing the main recognizable features of the mature animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100986174"
	 b:glossaryEntry="(medicine) a grossly malformed and usually nonviable fetus"/>
<rdf:Description rdf:about="&a;100986324">
	<b:glossaryEntry>a human fetus whose weight is less than 0.5 kilogram when removed or expelled from the mother''s body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100986478">
	<b:glossaryEntry>animal reproductive body consisting of an ovum or embryo together with nutritive and protective envelopes; esp. the thin-shelled reproductive body laid by e.g. female birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100986828">
	<b:glossaryEntry>egg-laying tubular structure at the end of the abdomen in many female insects and some fishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100986978">
	<b:glossaryEntry>one of two spiral bands of tissue connecting the egg yolk to the enclosing membrane at either end of the shell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100987161">
	<b:glossaryEntry>egg or young of an insect parasitic on mammals especially a sucking louse; often attached to a hair or item of clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100987330"
	 b:glossaryEntry="the mass of eggs deposited by fish or amphibians or molluscs"/>
<rdf:Description rdf:about="&a;100987460"
	 b:glossaryEntry="the eggs or egg-laden ovary of a fish"/>
<rdf:Description rdf:about="&a;100987547">
	<b:glossaryEntry>the egg mass or spawn of certain crustaceans such as the lobster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100987661">
	<b:glossaryEntry>early stage of an embryo produced by cleavage of an ovum; a hollow sphere whose wall is composed of a single layer of cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100987896"
	 b:glossaryEntry="double-walled stage of the embryo succeeding the blastula"/>
<rdf:Description rdf:about="&a;100988027">
	<b:glossaryEntry>central cavity of the gastrula; becomes the intestinal or digestive cavity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100988197"
	 b:glossaryEntry="the opening into the archenteron"/>
<rdf:Description rdf:about="&a;100988305"
	 b:glossaryEntry="thin structure composed of a single thickness of cells"/>
<rdf:Description rdf:about="&a;100988447"
	 b:glossaryEntry="tissue in an embryo"/>
<rdf:Description rdf:about="&a;100988547">
	<b:glossaryEntry>(embryology) any of the 3 layers of cells differentiated in embryos following gastrulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100988748">
	<b:glossaryEntry>the outer germ layer that develops into skin and nervous tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100988878">
	<b:glossaryEntry>the middle germ layer that develops into muscle and bone and cartilage and blood and connective tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100989083"
	 b:glossaryEntry="the area of mesoderm that forms the notochord"/>
<rdf:Description rdf:about="&a;100989206">
	<b:glossaryEntry>mesodermal tissue that forms connective tissue and blood and smooth muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100989338">
	<b:glossaryEntry>the inner germ layer that develops into the lining of the digestive and respiratory systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100989531"
	 b:glossaryEntry="eggs of a silkworm"/>
<rdf:Description rdf:about="&a;100989609">
	<b:glossaryEntry>nutritive material of an ovum esp. the yellow mass of a bird or reptile egg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100989754">
	<b:glossaryEntry>membranous structure enclosing the yolk of eggs in birds reptiles marsupials and some fishes; circulates nutrients to the developing embryo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100989949">
	<b:glossaryEntry>membranous structure that functions as the circulatory system in mammal embryos until the heart becomes functional</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100990118">
	<b:glossaryEntry>hollow or grooved tooth a venomous snake; used to inject its poison</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100990236">
	<b:glossaryEntry>canine tooth of a carnivorous animal; used to seize and tear its prey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100990356">
	<b:glossaryEntry>a long pointed tooth specialized for fighting or digging; especially in an elephant or walrus or hog</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100990507"
	 b:glossaryEntry="comprises true vertebrates and animals having a notochord"/>
<rdf:Description rdf:about="&a;100990770">
	<b:glossaryEntry>any animal of the phylum Chordata having a notochord or spinal column</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100990967">
	<b:glossaryEntry>a flexible rodlike structure that forms the supporting axis of the body in the lowest chordates and lowest vertebrates and in embryos of higher vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100991196">
	<b:glossaryEntry>a notochord of a larval tunicate typically confined to the caudal region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100991323"
	 b:glossaryEntry="any family in the phylum Chordata"/>
<rdf:Description rdf:about="&a;100991491"
	 b:glossaryEntry="any genus in the phylum Chordata"/>
<rdf:Description rdf:about="&a;100991675"
	 b:glossaryEntry="lancelets"/>
<rdf:Description rdf:about="&a;100991831">
	<b:glossaryEntry>fishlike animals having a notochord rather than a true spinal column</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100991999"
	 b:glossaryEntry="lancelets"/>
<rdf:Description rdf:about="&a;100992170"
	 b:glossaryEntry="type genus of the Amphioxidae"/>
<rdf:Description rdf:about="&a;100992299">
	<b:glossaryEntry>small translucent lancet-shaped burrowing marine animal; primitive forerunner of the vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100992481"
	 b:glossaryEntry="tunicates"/>
<rdf:Description rdf:about="&a;100992733">
	<b:glossaryEntry>primitive marine animal having a saclike unsegmented body and a urochord (a notochord) conspicuous in the larva</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100993033"
	 b:glossaryEntry="sometimes classified as an order: sea_squirts"/>
<rdf:Description rdf:about="&a;100993213">
	<b:glossaryEntry>minute sedentary marine invertebrate having a saclike body with siphons through which water enters and leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100993414">
	<b:glossaryEntry>ascidian that can contract its body and eject streams of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100993533">
	<b:glossaryEntry>small class of free-swimming tunicates; sometimes classified as an order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100993736"
	 b:glossaryEntry="a small family of tunicates in the class Thaliacea"/>
<rdf:Description rdf:about="&a;100993897"
	 b:glossaryEntry="type (perhaps sole) genus of the Salpidae"/>
<rdf:Description rdf:about="&a;100994034">
	<b:glossaryEntry>minute floating marine tunicate having a transparent body with an opening at each end</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100994197"
	 b:glossaryEntry="oceanic tunicates"/>
<rdf:Description rdf:about="&a;100994329"
	 b:glossaryEntry="type genus of the Doliolidae"/>
<rdf:Description rdf:about="&a;100994456">
	<b:glossaryEntry>free-swimming oceanic tunicate with a barrel-shaped transparent body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100994598">
	<b:glossaryEntry>small free-swimming tunicates; sometimes classified as an order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100994790"
	 b:glossaryEntry="any member of the class Larvacea"/>
<rdf:Description rdf:about="&a;100994897"
	 b:glossaryEntry="a genus of chordates in the class Larvacea"/>
<rdf:Description rdf:about="&a;100995044">
	<b:glossaryEntry>free-swimming tadpole-shaped pelagic tunicate resembling larvae of other tunicates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100995206">
	<b:glossaryEntry>free-swimming larva of ascidians; they have a tail like a tadpole that contains the notochord</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100995381"
	 b:glossaryEntry="fishes; amphibians; reptiles; birds; mammals"/>
<rdf:Description rdf:about="&a;100995974">
	<b:glossaryEntry>animals having a bony or cartilaginous skeleton with a segmented spinal column and a large brain enclosed in a skull or cranium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100996501">
	<b:glossaryEntry>higher vertebrates (reptiles; birds; mammals) possessing an amnion during development</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100996678"
	 b:glossaryEntry="any member of the Amniota"/>
<rdf:Description rdf:about="&a;100996776">
	<b:glossaryEntry>thin membranous sac enclosing the developing embryo in higher vertebrates (Amniota)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100996921">
	<b:glossaryEntry>outer membrane enclosing the embryo in higher vertebrates (reptiles; birds; mammals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100997078">
	<b:glossaryEntry>one of the tiny villi that stick out of the fetal chorion and combine with the mother''s uterine tissue to form the placenta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100997283">
	<b:glossaryEntry>vascular fetal membrane that develops from the hindgut in embryonic higher vertebrates (mammals; birds; reptiles)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100997452">
	<b:glossaryEntry>very vascular fetal membrane composed of the fused chorion and adjacent wall of the allantois</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100997634"
	 b:glossaryEntry="animal living wholly or chiefly in or on water"/>
<rdf:Description rdf:about="&a;100997818">
	<b:glossaryEntry>superclass of eel-shaped chordates lacking jaws and pelvic fins: lampreys; hagfishes; some extinct forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100998111">
	<b:glossaryEntry>eel-shaped vertebrate without jaws or paired appendages including the cyclostomes and some extinct forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100998469">
	<b:glossaryEntry>extinct group of armored jawless vertebrates; taxonomy is not clear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100998692">
	<b:glossaryEntry>extinct fishlike jawless vertebrate having a heavily armored body; of the Paleozoic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100998852">
	<b:glossaryEntry>extinct group of armored jawless fishes or fishlike vertebrate; taxonomy is not clear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100999058">
	<b:glossaryEntry>extinct jawless fish with the anterior part of the body covered with bony plates; of the Silurian and Devonian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100999247">
	<b:glossaryEntry>extinct group of armored fishlike vertebrates; taxonomy is not clear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100999473"
	 b:glossaryEntry="extinct jawless fish of the Devonian with armored head"/>
<rdf:Description rdf:about="&a;100999619"
	 b:glossaryEntry="extinct order of jawless vertebrates"/>
<rdf:Description rdf:about="&a;100999765">
	<b:glossaryEntry>extinct small freshwater jawless fish usually having a heterocercal tail and an armored head; of the Silurian and Devonian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100999960">
	<b:glossaryEntry>extinct order of primitive vertebrates; the precise taxonomy is not clear; in some classifications considered a separate phylum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101000243">
	<b:glossaryEntry>small (2 in) extinct eellike fish with a finned tail and a notochord and having cone-shaped teeth containing cellular bone; late Cambrian to late Triassic; possible predecessor of the cyclostomes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101000512">
	<b:glossaryEntry>tiny fossil cone-shaped tooth of the most primitive vertebrate: the conodont</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101000643"
	 b:glossaryEntry="primitive jawless aquatic vertebrate: lampreys; hagfishes"/>
<rdf:Description rdf:about="&a;101000894"
	 b:glossaryEntry="primitive aquatic vertebrate"/>
<rdf:Description rdf:about="&a;101000998"
	 b:glossaryEntry="lampreys as distinguished from hagfishes"/>
<rdf:Description rdf:about="&a;101001187"
	 b:glossaryEntry="lampreys"/>
<rdf:Description rdf:about="&a;101001339">
	<b:glossaryEntry>primitive eellike freshwater or anadromous cyclostome having round sucking mouth with a rasping tongue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101001559"
	 b:glossaryEntry="typical lampreys"/>
<rdf:Description rdf:about="&a;101001689">
	<b:glossaryEntry>large anadromous lamprey sometimes used as food; destructive of native fish fauna in the Great Lakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101001887"
	 b:glossaryEntry="hagfishes as distinguished from lampreys"/>
<rdf:Description rdf:about="&a;101002114"
	 b:glossaryEntry="slime-producing marine animals: hagfishes"/>
<rdf:Description rdf:about="&a;101002325">
	<b:glossaryEntry>eellike cyclostome having a tongue with horny teeth in a round mouth surrounded by eight tentacles; feeds on dead or trapped fishes by boring into their bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101002630"
	 b:glossaryEntry="type genus of the Myxinidae (typical hagfishes)"/>
<rdf:Description rdf:about="&a;101002783"
	 b:glossaryEntry="typical hagfish"/>
<rdf:Description rdf:about="&a;101002880"
	 b:glossaryEntry="a genus of fossil fish of the family Myxinidae"/>
<rdf:Description rdf:about="&a;101003027"
	 b:glossaryEntry="a fossil hagfish of the genus Eptatretus"/>
<rdf:Description rdf:about="&a;101003143"
	 b:glossaryEntry="fossil hagfishes"/>
<rdf:Description rdf:about="&a;101003273">
	<b:glossaryEntry>fossil hagfish of the Pennsylvanian period (c. 300 million years ago) that resembled modern hagfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101003457"
	 b:glossaryEntry="comprising all vertebrates with upper and lower jaws"/>
<rdf:Description rdf:about="&a;101003634"
	 b:glossaryEntry="a vertebrate animal possessing true jaws"/>
<rdf:Description rdf:about="&a;101003751"
	 b:glossaryEntry="extinct group of bony-plated fishes with primitive jaws"/>
<rdf:Description rdf:about="&a;101003920">
	<b:glossaryEntry>fishlike vertebrate with bony plates on head and upper body; dominant in seas and rivers during the Devonian; considered the earliest vertebrate with jaws</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101004149"
	 b:glossaryEntry="cartilaginous fishes"/>
<rdf:Description rdf:about="&a;101004329">
	<b:glossaryEntry>fishes in which the skeleton may be calcified but not ossified</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101004528"
	 b:glossaryEntry="chimaeras and extinct forms"/>
<rdf:Description rdf:about="&a;101004693">
	<b:glossaryEntry>fish with high compressed head and a body tapering off into a long tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101004860"
	 b:glossaryEntry="a family of Holocephali"/>
<rdf:Description rdf:about="&a;101005000"
	 b:glossaryEntry="type genus of the Chimaeridae"/>
<rdf:Description rdf:about="&a;101005128">
	<b:glossaryEntry>smooth-skinned deep-sea fish with a tapering body and long threadlike tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101005294"
	 b:glossaryEntry="large European chimaera"/>
<rdf:Description rdf:about="&a;101005395"
	 b:glossaryEntry="sharks; rays; dogfishes; skates"/>
<rdf:Description rdf:about="&a;101005867">
	<b:glossaryEntry>any of numerous fishes of the class Chondrichthyes characterized by a cartilaginous skeleton and placoid scales: sharks; rays; skates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101006126">
	<b:glossaryEntry>any of numerous elongate mostly marine carnivorous fishes with heterocercal caudal fins and tough skin covered with small toothlike scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101006532"
	 b:glossaryEntry="primitive sharks"/>
<rdf:Description rdf:about="&a;101006665"
	 b:glossaryEntry="a genus of Hexanchidae"/>
<rdf:Description rdf:about="&a;101006799"
	 b:glossaryEntry="large primitive shark widely distributed in warm seas"/>
<rdf:Description rdf:about="&a;101006966"
	 b:glossaryEntry="oceanic sharks"/>
<rdf:Description rdf:about="&a;101007148"
	 b:glossaryEntry="in some classifications another name for the family Lamnidae"/>
<rdf:Description rdf:about="&a;101007300"
	 b:glossaryEntry="fierce pelagic and oceanic sharks"/>
<rdf:Description rdf:about="&a;101007485"
	 b:glossaryEntry="a genus of Lamnidae"/>
<rdf:Description rdf:about="&a;101007608">
	<b:glossaryEntry>voracious pointed-nose shark of northern Atlantic and Pacific</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101007758"
	 b:glossaryEntry="mako sharks"/>
<rdf:Description rdf:about="&a;101007875"
	 b:glossaryEntry="powerful mackerel shark of the Atlantic and Pacific"/>
<rdf:Description rdf:about="&a;101008063">
	<b:glossaryEntry>very swift active bluish shark found worldwide in warm waters; important game fish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101008225"
	 b:glossaryEntry="similar to shortfin mako but darker blue"/>
<rdf:Description rdf:about="&a;101008340">
	<b:glossaryEntry>common blue-gray shark of southwest Pacific; sport and food fish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101008495"
	 b:glossaryEntry="man-eating sharks"/>
<rdf:Description rdf:about="&a;101008628">
	<b:glossaryEntry>large aggressive shark widespread in warm seas; known to attack humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101008851">
	<b:glossaryEntry>comprising only the basking sharks; in some classifications considered the type genus of a separate family Cetorhinidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101009084">
	<b:glossaryEntry>in some older classifications considered the family of the basking sharks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101009257">
	<b:glossaryEntry>large harmless plankton-eating northern shark; often swims slowly or floats at the sea surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101009451"
	 b:glossaryEntry="thresher sharks"/>
<rdf:Description rdf:about="&a;101009579">
	<b:glossaryEntry>type genus of the family Alopiidae; in some classifications considered a genus of the family Lamnidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101009788">
	<b:glossaryEntry>large pelagic shark of warm seas with a whiplike tail used to round up small fish on which to feed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101010019"
	 b:glossaryEntry="nurse sharks and carpet sharks"/>
<rdf:Description rdf:about="&a;101010189"
	 b:glossaryEntry="carpet sharks"/>
<rdf:Description rdf:about="&a;101010318">
	<b:glossaryEntry>shark of the western Pacific with flattened body and mottled skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101010484"
	 b:glossaryEntry="nurse sharks"/>
<rdf:Description rdf:about="&a;101010616">
	<b:glossaryEntry>small bottom-dwelling shark of warm shallow waters on both coasts of North and South America and from southeast Asia to Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101010847">
	<b:glossaryEntry>sand sharks; in some classifications coextensive with family Carcharhinidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101011082"
	 b:glossaryEntry="type and sole genus of Carchariidae: sand sharks"/>
<rdf:Description rdf:about="&a;101011276">
	<b:glossaryEntry>shallow-water shark with sharp jagged teeth found on both sides of Atlantic; sometimes dangerous to swimmers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101011513"
	 b:glossaryEntry="small-toothed sharks comprising only one species"/>
<rdf:Description rdf:about="&a;101011684"
	 b:glossaryEntry="whale sharks"/>
<rdf:Description rdf:about="&a;101011808">
	<b:glossaryEntry>large spotted shark of warm surface waters worldwide; resembles a whale and feeds chiefly on plankton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101012004"
	 b:glossaryEntry="small bottom-dwelling sharks"/>
<rdf:Description rdf:about="&a;101012155">
	<b:glossaryEntry>small bottom-dwelling sharks with catlike eyes; found along continental slopes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101012308">
	<b:glossaryEntry>largest family of living sharks; found worldwide esp. in tropical waters; dorsal fin lacks spines: requiem sharks including tiger sharks and soupfin sharks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101012681">
	<b:glossaryEntry>any of numerous sharks from small relatively harmless bottom-dwellers to large dangerous oceanic and coastal species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101013038"
	 b:glossaryEntry="type genus of the Carcharhinidae"/>
<rdf:Description rdf:about="&a;101013264">
	<b:glossaryEntry>a most common shark in temperate and tropical coastal waters worldwide; heavy-bodied and dangerous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101013472">
	<b:glossaryEntry>most common gray shark along coasts of middle Atlantic states; sluggish and occasionally caught by fishermen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101013683">
	<b:glossaryEntry>widely distributed shallow-water shark with fins seemingly dipped in ink</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101013875">
	<b:glossaryEntry>large deep-water shark with white-tipped dorsal fin; worldwide distribution; most dangerous shark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101014123">
	<b:glossaryEntry>relatively slender blue-gray shark; nearly worldwide in tropical and temperate waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101014309"
	 b:glossaryEntry="lemon sharks"/>
<rdf:Description rdf:about="&a;101014433">
	<b:glossaryEntry>common shallow-water schooling shark of the Atlantic from North Carolina to Brazil and off west Africa; dangerous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101014648"
	 b:glossaryEntry="blue sharks"/>
<rdf:Description rdf:about="&a;101014769">
	<b:glossaryEntry>slender cosmopolitan, pelagic shark; blue body shades to white belly; dangerous esp. during maritime disasters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101014992"
	 b:glossaryEntry="tiger sharks"/>
<rdf:Description rdf:about="&a;101015118">
	<b:glossaryEntry>large dangerous warm-water shark with striped or spotted body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101015277"
	 b:glossaryEntry="a genus of Carcharhinidae"/>
<rdf:Description rdf:about="&a;101015418">
	<b:glossaryEntry>Pacific shark valued for its fins (used by Chinese in soup) and liver (rich in vitamin A)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101015620"
	 b:glossaryEntry="any of several small sharks"/>
<rdf:Description rdf:about="&a;101015737"
	 b:glossaryEntry="small smooth-skinned sharks lacking spines on dorsal fins"/>
<rdf:Description rdf:about="&a;101015945"
	 b:glossaryEntry="smooth dogfishes"/>
<rdf:Description rdf:about="&a;101016090"
	 b:glossaryEntry="small bottom-dwelling shark found along both Atlantic coasts"/>
<rdf:Description rdf:about="&a;101016302"
	 b:glossaryEntry="smooth dogfish of European coastal waters"/>
<rdf:Description rdf:about="&a;101016441"
	 b:glossaryEntry="found along the Atlantic coast of the Americas"/>
<rdf:Description rdf:about="&a;101016593"
	 b:glossaryEntry="found from the northern Gulf of Mexico to Brazil"/>
<rdf:Description rdf:about="&a;101016745"
	 b:glossaryEntry="a genus of Triakidae"/>
<rdf:Description rdf:about="&a;101016879">
	<b:glossaryEntry>smooth dogfish of Pacific and Indian oceans and Red Sea having white-tipped dorsal and caudal fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101017099"
	 b:glossaryEntry="dogfishes having a spine in each dorsal fin"/>
<rdf:Description rdf:about="&a;101017274"
	 b:glossaryEntry="small bottom-dwelling dogfishes"/>
<rdf:Description rdf:about="&a;101017420"
	 b:glossaryEntry="spiny dogfishes"/>
<rdf:Description rdf:about="&a;101017562">
	<b:glossaryEntry>destructive dogfish of American and European Atlantic coastal waters; widely used in anatomy classes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101017770"
	 b:glossaryEntry="dogfish of Pacific coast of North America"/>
<rdf:Description rdf:about="&a;101017917"
	 b:glossaryEntry="hammerhead sharks; bonnethead sharks"/>
<rdf:Description rdf:about="&a;101018068"
	 b:glossaryEntry="type genus of the Sphyrnidae"/>
<rdf:Description rdf:about="&a;101018204">
	<b:glossaryEntry>medium-sized live-bearing shark with eyes at either end of a flattened hammer-shaped head; worldwide in warm waters; can be dangerous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101018486"
	 b:glossaryEntry="fished for the hides and vitamin-rich liver"/>
<rdf:Description rdf:about="&a;101018611"
	 b:glossaryEntry="fished for the hide and vitamin-rich liver"/>
<rdf:Description rdf:about="&a;101018735">
	<b:glossaryEntry>small harmless hammerhead having a spade-shaped head; abundant in bays and estuaries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101018921"
	 b:glossaryEntry="bottom-dwelling ray-like sharks"/>
<rdf:Description rdf:about="&a;101019069"
	 b:glossaryEntry="type genus of the Squatinidae: angel sharks"/>
<rdf:Description rdf:about="&a;101019222">
	<b:glossaryEntry>sharks with broad flat bodies and winglike pectoral fins but that swim the way sharks do</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101019430">
	<b:glossaryEntry>cartilaginous fishes having horizontally flattened bodies and enlarged winglike pectoral fins with gills on the underside; most swim by moving the pectoral fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101019766"
	 b:glossaryEntry="rays with torpedo-shaped bodies"/>
<rdf:Description rdf:about="&a;101019921"
	 b:glossaryEntry="electric rays"/>
<rdf:Description rdf:about="&a;101020053">
	<b:glossaryEntry>any sluggish bottom-dwelling ray of the order Torpediniformes having a rounded body and electric organs on each side of the head capable of emitting strong electric discharges</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101020339">
	<b:glossaryEntry>fish with dorsoventrally flattened bodies; includes: rays; skates; guitarfishes; sawfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101020666"
	 b:glossaryEntry="large primitive rays with elongated snouts"/>
<rdf:Description rdf:about="&a;101020840">
	<b:glossaryEntry>primitive ray with sharp teeth on each edge of a long flattened snout</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101021000"
	 b:glossaryEntry="type genus of the Pristidae"/>
<rdf:Description rdf:about="&a;101021135">
	<b:glossaryEntry>commonly found in tropical bays and estuaries; not aggressive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101021301"
	 b:glossaryEntry="primitive rays with guitar-shaped bodies"/>
<rdf:Description rdf:about="&a;101021460">
	<b:glossaryEntry>primitive tropical bottom-dwelling ray with a guitar-shaped body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101021600"
	 b:glossaryEntry="sting rays"/>
<rdf:Description rdf:about="&a;101021763">
	<b:glossaryEntry>large venomous ray with large barbed spines near the base of a thin whiplike tail capable of inflicting severe wounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101021990"
	 b:glossaryEntry="type genus of the Dasyatidae"/>
<rdf:Description rdf:about="&a;101022128">
	<b:glossaryEntry>one of the largest stingrays; found from Cape Cod to Cape Hatteras</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101022299"
	 b:glossaryEntry="butterfly rays"/>
<rdf:Description rdf:about="&a;101022421"
	 b:glossaryEntry="short-tailed broad-finned stingray"/>
<rdf:Description rdf:about="&a;101022534"
	 b:glossaryEntry="eagle rays"/>
<rdf:Description rdf:about="&a;101022701">
	<b:glossaryEntry>powerful free-swimming tropical ray noted for `soaring'' by flapping winglike fins; usually harmless but has venomous tissue near base of the tail as in stingrays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101022973"
	 b:glossaryEntry="a genus of Myliobatidae"/>
<rdf:Description rdf:about="&a;101023108">
	<b:glossaryEntry>ray with back covered with white or yellow spots; widely distributed in warm seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101023307"
	 b:glossaryEntry="a genus of Myliobatidae"/>
<rdf:Description rdf:about="&a;101023444"
	 b:glossaryEntry="large ray found along eastern coast of North America"/>
<rdf:Description rdf:about="&a;101023610"
	 b:glossaryEntry="large rays lacking venomous spines: mantas"/>
<rdf:Description rdf:about="&a;101023803">
	<b:glossaryEntry>extremely large pelagic tropical ray that feeds on plankton and small fishes; usually harmless but its size make it dangerous if harpooned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101024072"
	 b:glossaryEntry="a genus of Mobulidae"/>
<rdf:Description rdf:about="&a;101024188">
	<b:glossaryEntry>largest manta (to 22 feet across wings); found worldwide but common in Gulf of Mexico and along southern coasts of United States; primarily oceanic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101024433"
	 b:glossaryEntry="type genus of the Mobulidae"/>
<rdf:Description rdf:about="&a;101024566"
	 b:glossaryEntry="small manta (to 4 feet) that travels in schools"/>
<rdf:Description rdf:about="&a;101024707"
	 b:glossaryEntry="bottom-dwelling tropical rays: skates"/>
<rdf:Description rdf:about="&a;101024872">
	<b:glossaryEntry>large edible rays having a long snout and thick tail with pectoral fins continuous with the head; swim by undulating the edges of the pectoral fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101025162"
	 b:glossaryEntry="type genus of the family Rajidae"/>
<rdf:Description rdf:about="&a;101025353"
	 b:glossaryEntry="common European skate used as food"/>
<rdf:Description rdf:about="&a;101025476">
	<b:glossaryEntry>most plentiful skate in North American inshore waters in summer; to 2l inches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101025647"
	 b:glossaryEntry="cold-water bottom fish with spines on the back; to 40 inches"/>
<rdf:Description rdf:about="&a;101025800">
	<b:glossaryEntry>one of the largest skates (to 5 feet); an active skate easy to hook</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101025961"
	 b:glossaryEntry="birds"/>
<rdf:Description rdf:about="&a;101026695">
	<b:glossaryEntry>warm-blooded egg-laying vertebrates characterized by feathers and forelimbs modified as wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101027518">
	<b:glossaryEntry>(informal) small bird; adults talking to children sometimes call small birds dickeybirds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101027675"
	 b:glossaryEntry="young bird that has just fledged or become capable of flying"/>
<rdf:Description rdf:about="&a;101027804"
	 b:glossaryEntry="young bird not yet fledged"/>
<rdf:Description rdf:about="&a;101027897">
	<b:glossaryEntry>a family of warm-blooded egg-laying vertebrates characterized by feathers and forelimbs modified as wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101030635"
	 b:glossaryEntry="a genus of birds"/>
<rdf:Description rdf:about="&a;101037873"
	 b:glossaryEntry="adult male bird"/>
<rdf:Description rdf:about="&a;101037957"
	 b:glossaryEntry="a cock bred and trained for fighting"/>
<rdf:Description rdf:about="&a;101038064"
	 b:glossaryEntry="adult female bird"/>
<rdf:Description rdf:about="&a;101038131">
	<b:glossaryEntry>any bird associated with night: owl; nightingale; nighthawk; etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101038270"
	 b:glossaryEntry="any bird that cries at night"/>
<rdf:Description rdf:about="&a;101038356"
	 b:glossaryEntry="any bird that migrates seasonally"/>
<rdf:Description rdf:about="&a;101038451">
	<b:glossaryEntry>extinct primitive birds of the Triassic period; 70 million years before archaeopteryx</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101038636">
	<b:glossaryEntry>most primitive avian type known; extinct bird of the Triassic having birdlike jaw and hollow limbs and breastbone with dinosaur-like tail and hind limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101038863">
	<b:glossaryEntry>primitive reptile-like fossil birds of the Jurassic or early Cretaceous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101039116"
	 b:glossaryEntry="a genus of fossil birds"/>
<rdf:Description rdf:about="&a;101039264">
	<b:glossaryEntry>extinct primitive toothed bird of the Upper Jurassic having a long feathered tail and hollow bones; usually considered the most primitive of all birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101039538"
	 b:glossaryEntry="a genus of fossil birds"/>
<rdf:Description rdf:about="&a;101039660">
	<b:glossaryEntry>sparrow-sized fossil bird of the Upper Jurassic to Lower Cretaceous having a keeled breastbone and vestigial tail; found in China; considered possibly the second most primitive of all birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101039923"
	 b:glossaryEntry="a genus of fossil bird of the subclass Archaeornithes"/>
<rdf:Description rdf:about="&a;101040081">
	<b:glossaryEntry>sparrow-sized fossil bird of the Lower Cretaceous having a vestigial tail; found in Spain; considered possibly the third most primitive of all birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101040309"
	 b:glossaryEntry="a genus of fossil bird"/>
<rdf:Description rdf:about="&a;101040433">
	<b:glossaryEntry>extinct primitive toothed bird with a long feathered tail and three free clawed digits on each wing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101040609">
	<b:glossaryEntry>flightless birds having flat breastbones lacking a keel for attachment of flight muscles: ostriches; cassowaries; emus; moas; rheas; kiwis; elephant birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101041010">
	<b:glossaryEntry>birds having keeled breastbones for attachment of flight muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101041196">
	<b:glossaryEntry>used in former classifications to include all ratite bird orders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101041373">
	<b:glossaryEntry>a ratite bird order: ostriches and related extinct birds; known from the Pleistocene onward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101041590"
	 b:glossaryEntry="tall terrestrial birds: ostriches"/>
<rdf:Description rdf:about="&a;101041744"
	 b:glossaryEntry="type genus of the Struthionidae: African ostriches"/>
<rdf:Description rdf:about="&a;101041904">
	<b:glossaryEntry>fast-running African flightless bird with two-toed feet; largest living bird</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101042072"
	 b:glossaryEntry="a ratite bird order: cassowaries and emus"/>
<rdf:Description rdf:about="&a;101042254"
	 b:glossaryEntry="a family of large ostrich-like birds including cassowaries"/>
<rdf:Description rdf:about="&a;101042427"
	 b:glossaryEntry="type and sole genus of the Casuaridae: cassowaries"/>
<rdf:Description rdf:about="&a;101042589">
	<b:glossaryEntry>large black flightless bird of Australia and New Guinea having a horny head crest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101042745"
	 b:glossaryEntry="a genus of birds in the order Casuariiformes"/>
<rdf:Description rdf:about="&a;101042899">
	<b:glossaryEntry>large Australian flightless bird similar to the ostrich but smaller</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101043084">
	<b:glossaryEntry>a ratite bird order: flightless ground birds having vestigial wings and long bills and small eyes: kiwis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101043310"
	 b:glossaryEntry="coextensive with the order Apterygiformes"/>
<rdf:Description rdf:about="&a;101043468"
	 b:glossaryEntry="type genus of the Apterygidae: kiwis"/>
<rdf:Description rdf:about="&a;101043602">
	<b:glossaryEntry>nocturnal flightless bird of New Zealand having a long neck and stout legs; only surviving representative of the order Apterygiformes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101043815">
	<b:glossaryEntry>a ratite bird order: birds intermediate in characteristics between ostriches and emus: recent and extinct rheas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101044040"
	 b:glossaryEntry="a family of birds coextensive with the order Rheiformes"/>
<rdf:Description rdf:about="&a;101044223">
	<b:glossaryEntry>type genus of the Rheidae; large tall flightless South American birds similar to but smaller than ostriches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101044425">
	<b:glossaryEntry>larger of two tall fast-running flightless birds similar to ostriches but three-toed; found from Brazil to Patagonia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101044628"
	 b:glossaryEntry="a genus of birds of the family Rheidae"/>
<rdf:Description rdf:about="&a;101044782">
	<b:glossaryEntry>smaller of two tall fast-running flightless birds similar to ostriches but three-toed; found from Peru to Straits of Magellan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101045007"
	 b:glossaryEntry="huge extinct flightless birds: elephant birds"/>
<rdf:Description rdf:about="&a;101045174"
	 b:glossaryEntry="coextensive with the order Aepyorniformes"/>
<rdf:Description rdf:about="&a;101045332"
	 b:glossaryEntry="type genus of the Aepyornidae: elephant birds"/>
<rdf:Description rdf:about="&a;101045477"
	 b:glossaryEntry="huge (to 9 ft.) extinct flightless bird of Madagascar"/>
<rdf:Description rdf:about="&a;101045621">
	<b:glossaryEntry>a ratite bird order: recently extinct flightless birds of New Zealand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101045816"
	 b:glossaryEntry="moas"/>
<rdf:Description rdf:about="&a;101045979"
	 b:glossaryEntry="type genus of the Dinornithidae: large moas"/>
<rdf:Description rdf:about="&a;101046132"
	 b:glossaryEntry="extinct flightless bird of New Zealand"/>
<rdf:Description rdf:about="&a;101046275"
	 b:glossaryEntry="the largest moa; about 12 feet high"/>
<rdf:Description rdf:about="&a;101046406"
	 b:glossaryEntry="small moas"/>
<rdf:Description rdf:about="&a;101046520">
	<b:glossaryEntry>the smallest moa; slender moa about the size of a large turkey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101046683">
	<b:glossaryEntry>largest order of birds comprising about half the known species: rooks; finches; sparrows; tits; warblers; robins; wrens; swallows; etc.; in four suborders: Eurylaimi; Tyranni; Menurae: Oscines or Passeres</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101047121">
	<b:glossaryEntry>perching birds mostly small and living near the ground with feet having 4 toes arranged to allow for gripping the perch; most are songbirds; hatchlings are helpless</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101047505"
	 b:glossaryEntry="chiefly arboreal birds especially of the order Coraciiformes"/>
<rdf:Description rdf:about="&a;101047629"
	 b:glossaryEntry="two names for the suborder of typical songbirds"/>
<rdf:Description rdf:about="&a;101048464"
	 b:glossaryEntry="passerine bird having specialized vocal apparatus"/>
<rdf:Description rdf:about="&a;101049247"
	 b:glossaryEntry="any bird having a musical call"/>
<rdf:Description rdf:about="&a;101049343"
	 b:glossaryEntry="honey_eaters"/>
<rdf:Description rdf:about="&a;101049474">
	<b:glossaryEntry>Australasian bird with tongue and bill adapted for extracting nectar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101049633"
	 b:glossaryEntry="hedge sparrow"/>
<rdf:Description rdf:about="&a;101049763"
	 b:glossaryEntry="type genus of the Prunellidae"/>
<rdf:Description rdf:about="&a;101049902">
	<b:glossaryEntry>small sparrow-like songbird of mountainous regions of Eurasia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101050055"
	 b:glossaryEntry="small brownish European songbird"/>
<rdf:Description rdf:about="&a;101050188"
	 b:glossaryEntry="larks"/>
<rdf:Description rdf:about="&a;101050325">
	<b:glossaryEntry>any of numerous predominantly Old World birds noted for their singing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101050482"
	 b:glossaryEntry="type genus of the Alaudidae: skylarks"/>
<rdf:Description rdf:about="&a;101050625">
	<b:glossaryEntry>brown-speckled European lark noted for singing while hovering at a great height</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101050795"
	 b:glossaryEntry="pipits and wagtails"/>
<rdf:Description rdf:about="&a;101050952"
	 b:glossaryEntry="type genus of the Motacillidae: wagtails"/>
<rdf:Description rdf:about="&a;101051104">
	<b:glossaryEntry>Old World bird having a very long tail that jerks up and down as it walks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101051250"
	 b:glossaryEntry="pipits"/>
<rdf:Description rdf:about="&a;101051362"
	 b:glossaryEntry="small songbirds resembling larks"/>
<rdf:Description rdf:about="&a;101051500">
	<b:glossaryEntry>a common pipit that is brown above and white below; widely distributed in northern and central Europe and in Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101051691">
	<b:glossaryEntry>finches: goldfinches; bullfinches; chaffinches; siskins; canaries; cardinals; grosbeaks; crossbills; linnets; buntings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101052327">
	<b:glossaryEntry>any of numerous small songbirds with short stout bills adapted for crushing seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101052911"
	 b:glossaryEntry="type genus of the Fringillidae: chaffinch, brambling"/>
<rdf:Description rdf:about="&a;101053094"
	 b:glossaryEntry="small European finch with a cheerful song"/>
<rdf:Description rdf:about="&a;101053230"
	 b:glossaryEntry="Eurasian finch"/>
<rdf:Description rdf:about="&a;101053346"
	 b:glossaryEntry="used in some classifications for a subgroup of finches"/>
<rdf:Description rdf:about="&a;101053501">
	<b:glossaryEntry>in some classifications considered the type genus of a subfamily Carduelinae of the Fringillidae: goldfinches; siskins; redpolls; linnets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101053826">
	<b:glossaryEntry>small European finch having a crimson face and yellow-and-black wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101053992">
	<b:glossaryEntry>small Old World finch whose male has a red breast and forehead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101054148"
	 b:glossaryEntry="small sharp-billed yellow-and-black Eurasian finch"/>
<rdf:Description rdf:about="&a;101054270">
	<b:glossaryEntry>South American species of scarlet finch with black head and wings and tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101054442"
	 b:glossaryEntry="small siskin-like finch with a red crown"/>
<rdf:Description rdf:about="&a;101054575"
	 b:glossaryEntry="small siskin-like finch with a red crown"/>
<rdf:Description rdf:about="&a;101054711">
	<b:glossaryEntry>in some classifications considered a subgenus of Carduelis: siskins and New World goldfinches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101054929"
	 b:glossaryEntry="American finch whose male has yellow body plumage in summer"/>
<rdf:Description rdf:about="&a;101055115"
	 b:glossaryEntry="small finch of North American coniferous forests"/>
<rdf:Description rdf:about="&a;101055268"
	 b:glossaryEntry="house finches and purple finches"/>
<rdf:Description rdf:about="&a;101055433">
	<b:glossaryEntry>small finch originally of the western United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101055604">
	<b:glossaryEntry>North American finch having a raspberry-red head and breast and rump</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101055773"
	 b:glossaryEntry="Old World finches: e.g. canaries and serins"/>
<rdf:Description rdf:about="&a;101055943"
	 b:glossaryEntry="any of several small Old World finches"/>
<rdf:Description rdf:about="&a;101056085">
	<b:glossaryEntry>native to the Canary Islands and Azores; popular usually yellow cage bird noted for its song</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101056255"
	 b:glossaryEntry="any of various brown and yellow finches of pats of Europe"/>
<rdf:Description rdf:about="&a;101056383"
	 b:glossaryEntry="crossbill"/>
<rdf:Description rdf:about="&a;101056496"
	 b:glossaryEntry="finch with a bill whose tips cross when closed"/>
<rdf:Description rdf:about="&a;101056637"
	 b:glossaryEntry="bullfinches"/>
<rdf:Description rdf:about="&a;101056758">
	<b:glossaryEntry>common European finch mostly black and white with red throat and breast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101056924"
	 b:glossaryEntry="American finches"/>
<rdf:Description rdf:about="&a;101057036"
	 b:glossaryEntry="small North American finch seen chiefly in winter"/>
<rdf:Description rdf:about="&a;101057185">
	<b:glossaryEntry>common North American junco having gray plumage and eyes with dark brown irises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101057365"
	 b:glossaryEntry="sparrow-like North American finches"/>
<rdf:Description rdf:about="&a;101057608"
	 b:glossaryEntry="a genus of Fringillidae"/>
<rdf:Description rdf:about="&a;101057743"
