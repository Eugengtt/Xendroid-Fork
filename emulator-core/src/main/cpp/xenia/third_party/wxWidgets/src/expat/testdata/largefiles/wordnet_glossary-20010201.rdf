	 b:glossaryEntry="a strong acid made by chlorinating acetic acid"/>
<rdf:Description rdf:about="&a;110817921"
	 b:glossaryEntry="a glyceryl ester of margaric acid"/>
<rdf:Description rdf:about="&a;110818033"
	 b:glossaryEntry="a mineral form of silica"/>
