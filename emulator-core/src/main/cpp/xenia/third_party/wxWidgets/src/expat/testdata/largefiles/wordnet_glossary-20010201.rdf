<rdf:Description rdf:about="&a;400375494"
	 b:glossaryEntry="in a questioning format"/>
<rdf:Description rdf:about="&a;400375579">
	<b:glossaryEntry>in an narrow-minded manner; "his illiberally biased way of thinking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400375738">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a tolerant manner; "he reacts rather tolerantly toward his son''s juvenile behavior"]]></b:glossaryEntry>
