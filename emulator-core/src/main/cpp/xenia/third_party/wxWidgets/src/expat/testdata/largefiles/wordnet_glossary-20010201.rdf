	 b:glossaryEntry="aquatic herbs"/>
<rdf:Description rdf:about="&a;108401496"
	 b:glossaryEntry="a plant of the genus Hottonia"/>
<rdf:Description rdf:about="&a;108401638">
	<b:glossaryEntry>a featherfoil of the eastern United States with submerged spongy inflated flower stalks and white flowers</b:glossaryEntry>
</rdf:Description>
