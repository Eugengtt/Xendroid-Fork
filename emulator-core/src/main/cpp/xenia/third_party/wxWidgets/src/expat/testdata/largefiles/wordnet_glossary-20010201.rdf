	 b:glossaryEntry="dance a jig"/>
<rdf:Description rdf:about="&a;201295404"
	 b:glossaryEntry="do the jitterbug"/>
<rdf:Description rdf:about="&a;201295487"
	 b:glossaryEntry="move to and fro"/>
<rdf:Description rdf:about="&a;201295618">
	<b:glossaryEntry>move from side to side, as of fingers and tails; "The happy dog wagged his tail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201295784"
	 b:glossaryEntry="perform a folk-dance"/>
<rdf:Description rdf:about="&a;201295872"
	 b:glossaryEntry="dance in formation"/>
<rdf:Description rdf:about="&a;201295960"
	 b:glossaryEntry="give the calls (to the dancers) for a square dance"/>
<rdf:Description rdf:about="&a;201296083"
	 b:glossaryEntry="perform a quickstep"/>
<rdf:Description rdf:about="&a;201296169"
	 b:glossaryEntry='push forcefully; "He thrust his chin forward"'/>
<rdf:Description rdf:about="&a;201296446">
	<b:glossaryEntry>move with sudden speed; "His forefinger darted in all directions as he spoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201296593"
	 b:glossaryEntry="move along rapidly and lightly; skim or dart"/>
<rdf:Description rdf:about="&a;201296740">
	<b:glossaryEntry>miss a step and fall or nearly fall: "She stumbled over the tree root."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201296927"
	 b:glossaryEntry="stumble and nearly fall; of horses"/>
<rdf:Description rdf:about="&a;201297026"
	 b:glossaryEntry="cause to stumble"/>
<rdf:Description rdf:about="&a;201297122"
	 b:glossaryEntry="walk clumsily and with a bounce"/>
<rdf:Description rdf:about="&a;201297225"
	 b:glossaryEntry="walk with a tapping sound"/>
<rdf:Description rdf:about="&a;201297319"
	 b:glossaryEntry="walk unsteadily"/>
<rdf:Description rdf:about="&a;201297425"
	 b:glossaryEntry="move hesitatingly, as if about to give way"/>
<rdf:Description rdf:about="&a;201297547"
	 b:glossaryEntry="run at a moderately swift pace"/>
<rdf:Description rdf:about="&a;201297652"
	 b:glossaryEntry='cause to trot; "She trotted the horse home"'/>
<rdf:Description rdf:about="&a;201297757"
	 b:glossaryEntry="move in a wavy pattern, as of curtains"/>
<rdf:Description rdf:about="&a;201297901"
	 b:glossaryEntry="move about in a confused manner"/>
<rdf:Description rdf:about="&a;201298021">
	<b:glossaryEntry>flap when the wind is blowing equally on both sides; of sails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201298153">
	<b:glossaryEntry>to move about or proceed hurriedly: "so terrified by the extraordinary ebbing of the sea that they scurried to higher ground."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201298374">
	<b:glossaryEntry>be in motion due to some air current; "The leaves were blowing in the wind"; "the boat drifted on the lake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201298615">
	<b:glossaryEntry>move or seem to move quickly, lightly, or irregularly; "The spotlights played on the politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201298774">
	<b:glossaryEntry>cause to move or operate freely within a bounded space, as of machinery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201298915"
	 b:glossaryEntry="rise in waves"/>
<rdf:Description rdf:about="&a;201299016"
	 b:glossaryEntry="low back or recede; of tide water"/>
<rdf:Description rdf:about="&a;201299128"
	 b:glossaryEntry='move back and away from; "The enemy fell back"'/>
<rdf:Description rdf:about="&a;201299337"
	 b:glossaryEntry="be afloat; stay on a liquid surface; not sink"/>
<rdf:Description rdf:about="&a;201299504"
	 b:glossaryEntry="float on the surface of water"/>
<rdf:Description rdf:about="&a;201299603"
	 b:glossaryEntry="use one''s feet to advance; advance by steps"/>
<rdf:Description rdf:about="&a;201300444">
	<b:glossaryEntry xml:space='preserve'><![CDATA[informal or colloquial synonyms of ''walk'' "]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201300583">
	<b:glossaryEntry>walk so that the toes assume an indicated position or direction; "She toes inwards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201300728"
	 b:glossaryEntry="ride in a chariot"/>
<rdf:Description rdf:about="&a;201300810"
	 b:glossaryEntry='make walk; "He walks the horse up the mountain"'/>
<rdf:Description rdf:about="&a;201300981">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take a person or an animal for a walk; "She walks the dog every morning"; "I''ll walk you to your car"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201301198"
	 b:glossaryEntry="do the pimproll"/>
<rdf:Description rdf:about="&a;201301287"
	 b:glossaryEntry='change orientation or direction; "Turn towards me"'/>
<rdf:Description rdf:about="&a;201301973"
	 b:glossaryEntry="turn so as to face; turn the face in a certain direction"/>
<rdf:Description rdf:about="&a;201302099"
	 b:glossaryEntry="cause to turn"/>
<rdf:Description rdf:about="&a;201302196"
	 b:glossaryEntry='make a turn; "turn off at the parking area"'/>
<rdf:Description rdf:about="&a;201302329"
	 b:glossaryEntry="move so as not face somebody or something"/>
<rdf:Description rdf:about="&a;201302461"
