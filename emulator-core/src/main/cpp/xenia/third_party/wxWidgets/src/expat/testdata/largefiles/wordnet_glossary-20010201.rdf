</rdf:Description>
<rdf:Description rdf:about="&a;106999516"
	 b:glossaryEntry="a woman who is a Jew"/>
<rdf:Description rdf:about="&a;106999661"
	 b:glossaryEntry="ethnic slur; offensive term for a Jew"/>
<rdf:Description rdf:about="&a;106999749"
	 b:glossaryEntry="a believer or follower of Islam"/>
<rdf:Description rdf:about="&a;107000080">
	<b:glossaryEntry>a member of the branch of Islam that regards Ali as the legitimate successor to Mohammed and rejects the first three caliphs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;107000319">
