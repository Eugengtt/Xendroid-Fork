<rdf:Description rdf:about="&a;101345328"
	 b:glossaryEntry="Australasian kingfishers"/>
<rdf:Description rdf:about="&a;101345458"
	 b:glossaryEntry="Australian kingfisher having a loud cackling cry"/>
<rdf:Description rdf:about="&a;101345616"
	 b:glossaryEntry="bee-eaters"/>
