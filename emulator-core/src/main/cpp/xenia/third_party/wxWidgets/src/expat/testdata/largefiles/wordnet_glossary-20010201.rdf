<rdf:Description rdf:about="&a;109159217"
	 b:glossaryEntry="small genus of Asiatic herbs"/>
<rdf:Description rdf:about="&a;109159353"
	 b:glossaryEntry="plant grown for its ornamental red or purple foliage"/>
