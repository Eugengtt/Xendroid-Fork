	 b:glossaryEntry="1 species of aquatic or semi-aquatic fern"/>
<rdf:Description rdf:about="&a;109255037"
	 b:glossaryEntry="small latex-containing aquatic fern of southern Brazil"/>
<rdf:Description rdf:about="&a;109255194"
	 b:glossaryEntry="water ferns"/>
