<rdf:Description rdf:about="&a;108771881">
	<b:glossaryEntry>dried root of any of various plants of the genus Smilax used as a flavoring agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108772064">
	<b:glossaryEntry>a very prickly woody vine of the eastern United States growing in tangled masses having tough round stems with shiny leathery leaves and small greenish flowers followed by clusters of inedible shiny black berries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108772426">
