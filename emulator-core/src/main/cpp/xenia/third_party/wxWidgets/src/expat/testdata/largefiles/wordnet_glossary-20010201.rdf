<rdf:Description rdf:about="&a;101352943"
	 b:glossaryEntry="American nocturnal goatsucker with gray-and-white plumage"/>
<rdf:Description rdf:about="&a;101353102"
	 b:glossaryEntry="a genus of Caprimulgidae"/>
<rdf:Description rdf:about="&a;101353240"
	 b:glossaryEntry="mainly nocturnal North American goatsucker"/>
<rdf:Description rdf:about="&a;101353383"
	 b:glossaryEntry="a genus of Caprimulgidae"/>
