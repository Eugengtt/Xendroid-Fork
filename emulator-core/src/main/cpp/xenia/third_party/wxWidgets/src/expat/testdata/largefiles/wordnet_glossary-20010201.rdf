	<b:glossaryEntry>silvery and bluish drumfish of shallow California coastal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102088826">
	<b:glossaryEntry>any of several sciaenid fishes of North American coastal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102088981"
	 b:glossaryEntry="sea trout"/>
<rdf:Description rdf:about="&a;102089121">
