</rdf:Description>
<rdf:Description rdf:about="&a;200822778"
	 b:glossaryEntry='cover; be dispersed over; "Dead bodies strewed the ground"'/>
<rdf:Description rdf:about="&a;200822907"
	 b:glossaryEntry="cover with grass"/>
<rdf:Description rdf:about="&a;200822999">
	<b:glossaryEntry>affect suddenly, usually adversely; "We were hit by really bad weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200823166">
	<b:glossaryEntry>as of a piano key or notes; "strike middle C"; also used metaphorically: "strike a sour note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200823328">
	<b:glossaryEntry>examine by touch; "Feel this soft cloth!"; "The customer fingered the sweater"</b:glossaryEntry>
</rdf:Description>
