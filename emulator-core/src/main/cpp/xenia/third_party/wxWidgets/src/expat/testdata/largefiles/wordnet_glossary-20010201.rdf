	<b:glossaryEntry>perennial of wet and marshy places in the northern hemisphere: water parsnips</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109242386">
	<b:glossaryEntry>stout white-flowered perennial found wild in shallow fresh water; northern United States and Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109242575">
	<b:glossaryEntry>large stout white-flowered perennial found wild in shallow fresh water; Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109242758">
	<b:glossaryEntry>an Asiatic herb cultivated in Europe for its sweet edible tuberous root</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109242917"
	 b:glossaryEntry="Alexanders"/>
<rdf:Description rdf:about="&a;109243037">
	<b:glossaryEntry>European herb somewhat resembling celery widely naturalized in Britain coastal regions and often cultivated as a potherb</b:glossaryEntry>
</rdf:Description>
