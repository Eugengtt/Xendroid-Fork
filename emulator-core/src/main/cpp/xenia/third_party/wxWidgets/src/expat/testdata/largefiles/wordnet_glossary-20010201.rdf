</rdf:Description>
<rdf:Description rdf:about="&a;109246179"
	 b:glossaryEntry="genus of mostly herbs having a characteristic fetid odor"/>
<rdf:Description rdf:about="&a;109246412"
	 b:glossaryEntry="genus of widely distributed perennial herbs and some shrubs"/>
