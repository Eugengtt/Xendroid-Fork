<rdf:Description rdf:about="&a;201057402"
	 b:glossaryEntry="wash in a cradle; of gold"/>
<rdf:Description rdf:about="&a;201057491"
	 b:glossaryEntry="wash with stones to achieve a worn appearance; of blue jeans"/>
<rdf:Description rdf:about="&a;201057618"
	 b:glossaryEntry="wash or launder by hand instead of with a machine"/>
<rdf:Description rdf:about="&a;201057751"
	 b:glossaryEntry="wash by machine"/>
<rdf:Description rdf:about="&a;201057854">
	<b:glossaryEntry>wash with acid so as to achieve a bleached look; of blue jeans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201057983">
	<b:glossaryEntry>make dirty or spotty; also used metaphorically: "The silver was tarnished by the long exposure to the air"; "Her reputation was sullied after the affair with a married man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201058282">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tarnish or stain: "a scandal that darkened the family''s good name"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201058412">
	<b:glossaryEntry xml:space='preserve'><![CDATA[place under suspicion or cast doubt upon; "sully someone''s reputation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201058596"
