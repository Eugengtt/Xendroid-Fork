	 b:glossaryEntry="milky-juiced herb: lettuce; prickly lettuce"/>
<rdf:Description rdf:about="&a;108293804"
	 b:glossaryEntry="any of various plants of the genus Lactuca"/>
<rdf:Description rdf:about="&a;108294009">
