	<b:glossaryEntry>an independent group of closely related Chadic languages spoken in the area between the Biu-Mandara and East Chadic languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105241042">
	<b:glossaryEntry>a family of Afroasiatic tonal languages (mostly two tones) spoken in the regions west and south of Lake Chad in north central Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105241324">
	<b:glossaryEntry>a large family of related languages spoken both in Asia and Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105241645"
	 b:glossaryEntry="a major branch of the Afro-Asiatic language family"/>
<rdf:Description rdf:about="&a;105241839">
	<b:glossaryEntry>the ancient Canaanitic language of the Hebrews that has been revived as the official language of Israel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105242013"
	 b:glossaryEntry="Hebrew used in Israel today; revived from ancient Hebrew"/>
<rdf:Description rdf:about="&a;105242129"
	 b:glossaryEntry="an ancient branch of the Semitic languages"/>
<rdf:Description rdf:about="&a;105242244">
	<b:glossaryEntry>an extinct language of the Assyrians regarded as a dialect of Akkadian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105242369">
	<b:glossaryEntry>the dominant and official language of Ethiopia; a semitic language much influenced by the Cushitic language with which Amhara people have been in close contact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105242603">
	<b:glossaryEntry>the Semitic language of the Arabs; spoken in a variety of dialects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105242740">
	<b:glossaryEntry>an ancient group of related Semitic dialects some of which are still spoken in Syria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105242896">
	<b:glossaryEntry>the form of Aramaic that was spoken in Palestine in the time of the New Testament</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105243040"
	 b:glossaryEntry="a group of Semitic languages"/>
<rdf:Description rdf:about="&a;105243219">
	<b:glossaryEntry>the extinct language of the Semitic people who occupied Canaan before the Israelite conquest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105243367">
	<b:glossaryEntry>the extinct language of an ancient Semitic people who dominated trade in the ancient world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105243532"
	 b:glossaryEntry="the Phoenician dialect of ancient Carthage"/>
<rdf:Description rdf:about="&a;105243626"
	 b:glossaryEntry="an extinct Semitic language of northern Syria"/>
<rdf:Description rdf:about="&a;105243726"
	 b:glossaryEntry="a group of North African languages related to Semitic"/>
<rdf:Description rdf:about="&a;105243852">
	<b:glossaryEntry>the ancient and now extinct language of Pharaonic Egypt; written records date back to 3000 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105244018">
	<b:glossaryEntry>the liturgical language of the Coptic Church of Egypt and Ethiopia; written in the Greek alphabet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105244168">
	<b:glossaryEntry>a cluster of related dialects that were once the major language of North Africa west of Egypt; now spoken mostly in Morocco</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105244362"
	 b:glossaryEntry="the dialect of Berber spoken by the Tuareg people"/>
<rdf:Description rdf:about="&a;105244464">
	<b:glossaryEntry>a group of languages spoken in Ethiopia and Somalia and NW Kenya and adjacent regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105244622"
	 b:glossaryEntry="the Cushitic language spoken by the Somali people"/>
<rdf:Description rdf:about="&a;105244724">
	<b:glossaryEntry>a group of related languages spoken in a valley of southern Ethiopia; closely related to Cushitic languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105244884">
	<b:glossaryEntry>the family of languages that includes most of the languages spoken in sub-Saharan Africa; the majority of them are tonal languages but there are important exceptions (e.g., Swahili or Fula)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105245202">
	<b:glossaryEntry>a group of languages spoken in the relatively small Kordofan area of the south Sudan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105245344"
	 b:glossaryEntry="a family of African language spoken in west Africa"/>
<rdf:Description rdf:about="&a;105245560">
	<b:glossaryEntry>a family of languages widely spoken in the southern half of the African continent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105246126">
	<b:glossaryEntry>the Bantu language of the Chewa people of east central Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105246242"
	 b:glossaryEntry="a Bantu language spoken in southern Somalia"/>
<rdf:Description rdf:about="&a;105246340">
	<b:glossaryEntry>a Bantu language that is one of the two major languages of Zimbabwe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105246462"
	 b:glossaryEntry="a Bantu language spoken in Cameroon"/>
<rdf:Description rdf:about="&a;105246548"
	 b:glossaryEntry="a Bantu language spoken in western Kenya"/>
<rdf:Description rdf:about="&a;105246641">
	<b:glossaryEntry>a Bantu language spoken in the coastal regions of eastern Kenya</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105246758"
	 b:glossaryEntry="a Bantu language spoken by the Kamba people in Kenya"/>
<rdf:Description rdf:about="&a;105246862">
	<b:glossaryEntry>a Bantu language spoken by the Chaga people in northern Tanzania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105246997"
	 b:glossaryEntry="a Bantu language"/>
<rdf:Description rdf:about="&a;105247071"
	 b:glossaryEntry="a Bantu language"/>
<rdf:Description rdf:about="&a;105247143">
	<b:glossaryEntry>the Bantu language spoken by the Kongo people living in the tropical forests of Zaire and Congo and Angola</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105247301"
	 b:glossaryEntry="a Bantu language spoken in southern Zaire"/>
<rdf:Description rdf:about="&a;105247393"
	 b:glossaryEntry="the Bantu language of the Buganda people; spoken in Uganda"/>
<rdf:Description rdf:about="&a;105247505"
	 b:glossaryEntry="a Bantu language"/>
<rdf:Description rdf:about="&a;105247573"
	 b:glossaryEntry="a Bantu language"/>
<rdf:Description rdf:about="&a;105247641"
	 b:glossaryEntry="a Bantu language spoken in southern coastal Tanzania"/>
<rdf:Description rdf:about="&a;105247745"
	 b:glossaryEntry="a group of southern Bantu languages"/>
<rdf:Description rdf:about="&a;105247904"
	 b:glossaryEntry="a Bantu language sometimes considered a dialect of Zulu"/>
<rdf:Description rdf:about="&a;105248024"
	 b:glossaryEntry="a Bantu language closely related to Zulu"/>
<rdf:Description rdf:about="&a;105248116"
	 b:glossaryEntry="a Bantu language closely related to Zulu"/>
<rdf:Description rdf:about="&a;105248208">
	<b:glossaryEntry>a Bantu language of considerable literary importance in southeastern Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105248334"
	 b:glossaryEntry="a Bantu language spoken in central Tanzania"/>
<rdf:Description rdf:about="&a;105248432">
	<b:glossaryEntry>a Bantu language spoken in the Kenyan coastal areas of East Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105248551">
	<b:glossaryEntry>any of the mutually intelligible southern Bantu languages of the Sotho people in Botswana and South Africa and Lesotho</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105248757"
	 b:glossaryEntry="a Bantu language spoken in Angola"/>
<rdf:Description rdf:about="&a;105248844">
	<b:glossaryEntry>the dialect of Sotho spoken by the Basotho; an official language of Lesotho</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105248982"
	 b:glossaryEntry="the dialect of Sotho spoken by the Tswana people in Botswana"/>
<rdf:Description rdf:about="&a;105249117">
	<b:glossaryEntry>the most widely spoken Bantu languages; the official language of Kenya and Tanzania and widely used as a lingua franca in east and central Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105249316">
	<b:glossaryEntry>the language of the Tonga people of south central Africa (Zambia and Rhodesia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105249446">
	<b:glossaryEntry>a group of Niger-Congo languages spoken primarily in SE Mali and N Ghana</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105249578">
	<b:glossaryEntry>a group of languages spoken in the extreme western part of West Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105249761">
	<b:glossaryEntry>a family of languages of the Fula people of west Africa in the sub-Shara regions from Senegal to Chad; the best known of the West African Niger-Congo languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105249988">
	<b:glossaryEntry>a West African language closely related to Fula; spoken primarily in Senegal and Gambia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105250127"
	 b:glossaryEntry="the West AFrican language of the Wolof people in Senegal"/>
<rdf:Description rdf:about="&a;105250235">
	<b:glossaryEntry>a group of African languages in the Niger-Congo group spoken from Senegal east as far as the Ivory Coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105250391">
	<b:glossaryEntry>a group of African language in the Niger-Congo group spoken from the Ivory Coast east to Nigeria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105250591"
	 b:glossaryEntry="a Kwa language spoken by the Yoruba people in SW Nigeria"/>
<rdf:Description rdf:about="&a;105250706"
	 b:glossaryEntry="a Kwa language spoken in Ghana and the Ivory Coast"/>
<rdf:Description rdf:about="&a;105250807">
	<b:glossaryEntry>a Kwa language spoken by the Ewe people in Ghana and Togo and Benin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105250924">
	<b:glossaryEntry>a family of E African languages spoken by Nilotic peoples from the Sahara south to Kenya and Tanzania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105251162">
	<b:glossaryEntry>a group of Nilo-Saharan language spoken in parts of the Sudan and Zaire and Uganda and Tanzania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105251332">
	<b:glossaryEntry>a group of languages of East Africa belonging to the Chari-Nile group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105251528"
	 b:glossaryEntry="a Nilotic language"/>
<rdf:Description rdf:about="&a;105251598"
	 b:glossaryEntry="a Nilotic language"/>
<rdf:Description rdf:about="&a;105251666"
	 b:glossaryEntry="a Nilotic language"/>
<rdf:Description rdf:about="&a;105251736"
	 b:glossaryEntry="a Nilo-Saharan language spoken in parts of Chad"/>
<rdf:Description rdf:about="&a;105251837">
	<b:glossaryEntry>a Nilo-Saharan language spoken by the Songhai people in Mali and Niger</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105251961">
	<b:glossaryEntry>photographs or other visual representations in a printed publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105252175"
	 b:glossaryEntry="artwork that helps make something clear or attractive"/>
<rdf:Description rdf:about="&a;105252378">
	<b:glossaryEntry>illustrations used to decorate or explain a text; "the dictionary had many pictures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105252535">
	<b:glossaryEntry>a diagram or picture illustrating textual material; "the area covered can be seen from Figure 2"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105252690"
	 b:glossaryEntry="a visual display of information"/>
<rdf:Description rdf:about="&a;105252935">
	<b:glossaryEntry>a chart or map showing the movements or progress of an object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105253047">
	<b:glossaryEntry>a drawing illustrating the relations between certain quantities plotted with reference to a set of axes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105253348">
	<b:glossaryEntry>(electronics) a graph of frequency response with signal amplitude or gain plotted against frequency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105253576"
	 b:glossaryEntry="a line on a graph representing data"/>
<rdf:Description rdf:about="&a;105253700">
	<b:glossaryEntry>a chart showing the lines of responsibility between departments of a large organization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105253852"
	 b:glossaryEntry="a chart displaying colors"/>
<rdf:Description rdf:about="&a;105253953">
	<b:glossaryEntry>a chart in which complementary colors (or their names) are arranged on opposite sides of a circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105254123">
	<b:glossaryEntry>a chart with bars whose lengths are proportional to quantities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105254271">
	<b:glossaryEntry>a bar chart representing a frequency distribution; heights of the bars represent observed frequencies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105254428">
	<b:glossaryEntry>a chart that is read from a fixed distance; used as a test of vision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105254552">
	<b:glossaryEntry>a chart with several sheets hinged at the top; sheets can be flipped over to present information sequentially</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105254718">
	<b:glossaryEntry>a circular chart divided into triangular areas proportional to the percentages of the whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105254865">
	<b:glossaryEntry>a chart showing the relative positions of the stars in a particular part of the sky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105255005">
	<b:glossaryEntry>a graph representing the extent to which something exhibits various characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105255160">
	<b:glossaryEntry>a chart showing the number of people as a function of their ages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105255289"
	 b:glossaryEntry="information set out in tabular form"/>
<rdf:Description rdf:about="&a;105255398">
	<b:glossaryEntry>an illustration that is drawn by hand and published in a book or magazine; "it is shown by the drawing in Fig. 7"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105255565"
	 b:glossaryEntry="a sequence of drawings in a newspaper telling a story"/>
<rdf:Description rdf:about="&a;105255719">
	<b:glossaryEntry>a graphical record of the cardiac cycle produced by an electrocardiograph</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105255900">
	<b:glossaryEntry>a graphical record of electrical activity of the brain; produced by an electroencephalograph</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105256081">
	<b:glossaryEntry>a graphical record of electric currents associated with muscular contractions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105256219">
	<b:glossaryEntry>a graphical record of speed and distance produced by a tachograph</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105256340"
	 b:glossaryEntry="the art of writing and producing plays"/>
<rdf:Description rdf:about="&a;105256519">
	<b:glossaryEntry>(usually "the stage"); the theater as a profession; "an early movie simply showed a long kiss by two actors of the contemporary stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105256705">
	<b:glossaryEntry>a presentation for the stage or screen or radio or television; "have you seen the new production of Hamlet?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105256907"
	 b:glossaryEntry="the production of a drama on the stage"/>
<rdf:Description rdf:about="&a;105257041"
	 b:glossaryEntry="a highly successful theatrical production"/>
<rdf:Description rdf:about="&a;105257144"
	 b:glossaryEntry="a sensational bit of stagecraft"/>
<rdf:Description rdf:about="&a;105257256">
	<b:glossaryEntry>a play for performance on the stage or television or in a movie etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105257517">
	<b:glossaryEntry>a dramatic work intended for performance by actors on a stage; "he wrote several plays but only one was produced on Broadway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105257865">
	<b:glossaryEntry>a brief dramatic piece (usually comic) presented after a play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105258001">
	<b:glossaryEntry>plays stressing the irrational or illogical aspects of life, usually to show that modern life is pointless; "Samuel Beckett and Eugene Ionesco have written plays for the theater of the absurd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105258261"
	 b:glossaryEntry="an introduction to a play"/>
<rdf:Description rdf:about="&a;105258360"
	 b:glossaryEntry="a short play"/>
<rdf:Description rdf:about="&a;105258426"
	 b:glossaryEntry="a subdivision of a play or opera or ballet"/>
<rdf:Description rdf:about="&a;105258594">
	<b:glossaryEntry>a subdivision of an act of a play; "the first act has three scenes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105258732">
	<b:glossaryEntry>a written version of a play or other dramatic composition; used in preparing for a performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105259025"
	 b:glossaryEntry="the copy of the playscript used by the prompter"/>
<rdf:Description rdf:about="&a;105259143">
	<b:glossaryEntry>a detailed script used in making a film in order to avoid discontinuities from shot to shot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105259291"
	 b:glossaryEntry="the lines spoken by characters in drama or fiction"/>
<rdf:Description rdf:about="&a;105259442">
	<b:glossaryEntry>a part of the script in which the speaking roles are limited to two actors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105259571">
	<b:glossaryEntry>words making up the dialogue of a play; "the actor forgot his lines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105259824">
	<b:glossaryEntry>a line spoken by an actor to the audience but not intended for others on the stage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105259958">
	<b:glossaryEntry>an actor''s line that immediately precedes and serves as a reminder for some action or speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105260118"
	 b:glossaryEntry="a (usually long) dramatic speech by a single actor"/>
<rdf:Description rdf:about="&a;105260224">
	<b:glossaryEntry>a (usually long) dramatic speech intended to give the illusion of unspoken reflections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105260366"
	 b:glossaryEntry="words spoken in a casual way with conscious under-emphasis"/>
<rdf:Description rdf:about="&a;105260480">
	<b:glossaryEntry>a cue given to a performer (usually the beginning of the next line to be spoken)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105260613"
	 b:glossaryEntry="the words of an opera or musical play"/>
<rdf:Description rdf:about="&a;105260705"
	 b:glossaryEntry="an outline or synopsis of a play"/>
<rdf:Description rdf:about="&a;105260792">
	<b:glossaryEntry>a script for a film including dialogue and descriptions of characters and sets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105260927"
	 b:glossaryEntry="the final detailed script for making a movie or TV program"/>
<rdf:Description rdf:about="&a;105261047">
	<b:glossaryEntry>a linear string of words expressing some idea; "the letter consisted of three short lines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105261386"
	 b:glossaryEntry="plausible glib talk (especially useful to a salesperson)"/>
<rdf:Description rdf:about="&a;105261517"
	 b:glossaryEntry="a linear sequence of words as spoken or written"/>
<rdf:Description rdf:about="&a;105261742">
	<b:glossaryEntry>a manifestation of insincerity; "he put on quite an act for her benefit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105261864"
	 b:glossaryEntry="an unrestrained expression of emotion"/>
<rdf:Description rdf:about="&a;105262010"
	 b:glossaryEntry='a fit of weeping; "had a good cry"'/>
<rdf:Description rdf:about="&a;105262094">
	<b:glossaryEntry>a (usually irritating) impulsive and uncontrollable outburst by a problem child or a neurotic adult</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105262250"
	 b:glossaryEntry="a grouping of words in a sentence"/>
<rdf:Description rdf:about="&a;105262341"
	 b:glossaryEntry="drama more suitable for reading that for performing"/>
<rdf:Description rdf:about="&a;105262451"
	 b:glossaryEntry="light and humorous drama with a happy ending"/>
<rdf:Description rdf:about="&a;105262692"
	 b:glossaryEntry="a comedy with serious elements or overtones"/>
<rdf:Description rdf:about="&a;105262807">
	<b:glossaryEntry>drama in which the protagonist is overcome by some superior force or circumstance; excites terror or pity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105263002">
	<b:glossaryEntry>a dramatic composition involving elements of both tragedy and comedy usually with the tragic predominating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105263166">
	<b:glossaryEntry>a humorous television program based on situations that could arise in everyday life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105263312">
	<b:glossaryEntry>a television production that features a particular person or work or topic; "the last of a series of BBC specials on Iran is being shown tonight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105263511">
	<b:glossaryEntry>a humorous drama based on situations that might arise in day-to-day life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105263646">
	<b:glossaryEntry>Italian comedy of the 16th to 18th centuries improvised from standardized situations and stock characters</b:glossaryEntry>
</rdf:Description>
