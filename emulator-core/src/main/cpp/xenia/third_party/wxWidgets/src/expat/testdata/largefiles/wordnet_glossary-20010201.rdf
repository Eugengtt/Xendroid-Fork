	 b:glossaryEntry="do the shag"/>
<rdf:Description rdf:about="&a;201294527"
	 b:glossaryEntry="dance the foxtrot"/>
<rdf:Description rdf:about="&a;201294609"
	 b:glossaryEntry="perform a contradance"/>
<rdf:Description rdf:about="&a;201294744">
	<b:glossaryEntry>do a break dance; "Kids were break-dancing at the street corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201294899"
	 b:glossaryEntry="perform the cakewalk"/>
<rdf:Description rdf:about="&a;201294985"
	 b:glossaryEntry="dance the conga"/>
<rdf:Description rdf:about="&a;201295063"
	 b:glossaryEntry="dance the samba"/>
<rdf:Description rdf:about="&a;201295141"
	 b:glossaryEntry="dance the rhumba"/>
