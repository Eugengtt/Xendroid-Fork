	 b:glossaryEntry="type genus of the Clupeidae: typical herrings"/>
<rdf:Description rdf:about="&a;102024769">
	<b:glossaryEntry>commercially important food fish of northern waters of both Atlantic and Pacific</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102025013">
	<b:glossaryEntry>important food fish; found in enormous shoals in North Atlantic</b:glossaryEntry>
</rdf:Description>
