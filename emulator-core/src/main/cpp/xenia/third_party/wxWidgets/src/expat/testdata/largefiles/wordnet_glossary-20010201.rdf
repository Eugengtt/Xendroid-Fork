<rdf:Description rdf:about="&a;106651118">
	<b:glossaryEntry>capital and largest city and chief port of Yemen; located on the Gulf of Aden; its strategic location have made it a major trading center of S Arabia since ancient times</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106651357">
	<b:glossaryEntry>a republic on the southwestern corner of the Arabian Peninsula on the Red Sea; formerly North Yemen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106651579"
	 b:glossaryEntry="the capital and largest city of the Yemen Arab Republic"/>
<rdf:Description rdf:about="&a;106651693">
	<b:glossaryEntry>a republic in central Africa; formerly controlled (as part of Northern Rhodesia) by Great Britain until it gained independence within the Commonwealth in 1964</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106652018"
	 b:glossaryEntry="the capital and largest city of Zambia"/>
<rdf:Description rdf:about="&a;106652148">
	<b:glossaryEntry>the lowland region of western Europe on the North Sea: Belgium and Luxembourg and the Netherlands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106652324">
	<b:glossaryEntry>ancient region and Roman province of the Iberian peninsula; corresponds roughly to modern Portugal and parts of Spain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106652535">
	<b:glossaryEntry>a region of central Europe rich in deposits of coal and iron ore; annexed by Prussia in 1742 but now largely in Poland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106652756">
	<b:glossaryEntry>a picturesque coastal region of California south of San Francisco</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106652894">
	<b:glossaryEntry>a region in California south of San Francisco that is noted for its concentration of high-technology industries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106653085">
	<b:glossaryEntry>a landlocked republic in south central Africa formerly called Rhodesia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106653355"
	 b:glossaryEntry="the capital and largest city of Zimbabwe"/>
<rdf:Description rdf:about="&a;106653501"
	 b:glossaryEntry="a desert on the Arabian Peninsula in southwestern Asia"/>
<rdf:Description rdf:about="&a;106653635">
	<b:glossaryEntry>a desert in northern Chile rich in nitrate and copper deposits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106653777"
	 b:glossaryEntry="general name given to all desert areas in Australia"/>
<rdf:Description rdf:about="&a;106653930">
	<b:glossaryEntry>a desert area in eastern California and southern Nevada; the lowest point in North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106654136"
	 b:glossaryEntry="a desert area in S Arizona"/>
<rdf:Description rdf:about="&a;106654239"
	 b:glossaryEntry="a desert in central Asia"/>
<rdf:Description rdf:about="&a;106654347"
	 b:glossaryEntry="a desert in southwestern Africa - largely Botswana"/>
<rdf:Description rdf:about="&a;106654489"
	 b:glossaryEntry="the eastern part of the Sahara Desert"/>
<rdf:Description rdf:about="&a;106654605"
	 b:glossaryEntry="a desert area in Southern California"/>
<rdf:Description rdf:about="&a;106654773">
	<b:glossaryEntry>a desert in Namibia between the high plateau and the Atlantic Ocean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106654918"
	 b:glossaryEntry="a desert in S Israel"/>
<rdf:Description rdf:about="&a;106655024"
	 b:glossaryEntry="an arid sandstone plateau between the Nile and the Red Sea"/>
<rdf:Description rdf:about="&a;106655161"
	 b:glossaryEntry="a desert on a high plateau in northeastern Arizona"/>
<rdf:Description rdf:about="&a;106655291"
	 b:glossaryEntry="a semi-arid region in southern South America"/>
<rdf:Description rdf:about="&a;106655418">
	<b:glossaryEntry>the world''s largest desert (3,500,000 square miles) in North Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106655611"
	 b:glossaryEntry="the region of Africa south of the Sahara Desert"/>
<rdf:Description rdf:about="&a;106655757"
	 b:glossaryEntry="a desert on the Sinai Peninsula in northeastern Egypt"/>
<rdf:Description rdf:about="&a;106655896">
	<b:glossaryEntry>an inactive volcano in western Cameroon; highest peak on the West African coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106656049">
	<b:glossaryEntry>an extinct volcano in S Mexico between Mexico City and Veracruz; the highest peak in Mexico (18,695 feet)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106656279"
	 b:glossaryEntry="an active volcano in southwestern Mexico"/>
<rdf:Description rdf:about="&a;106656429"
	 b:glossaryEntry="an Andean volcano in northern Ecuador; last erupted in 1955"/>
<rdf:Description rdf:about="&a;106656563">
	<b:glossaryEntry>the world''s largest active volcano; located in the Andes in north central Ecuador</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106656718"
	 b:glossaryEntry="an active volcano in northern Iran"/>
<rdf:Description rdf:about="&a;106656826">
	<b:glossaryEntry>the world''s 2nd largest active volcano; located in the Andes in S Peru</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106656970">
	<b:glossaryEntry>an inactive volcano in Sicily; last erupted in 1961; the highest volcano in Europe (10,500 feet)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106657159"
	 b:glossaryEntry="a volcano in south central Guatemala"/>
<rdf:Description rdf:about="&a;106657266">
	<b:glossaryEntry>an extinct volcano in south central Honshu; last erupted in 1707; famous for its symmetrical snow-capped peak</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106657467"
	 b:glossaryEntry="an active volcano in southeastern Colombia in the Andes"/>
<rdf:Description rdf:about="&a;106657603">
	<b:glossaryEntry>the world''s highest volcano; in the Andes in northern Chile; last erupted in 1959</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106657760">
	<b:glossaryEntry>an inactive volcano in the Andes in S Peru; last erupted in 1783</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106657902">
	<b:glossaryEntry>an inactive volcano on the Kamchatka Peninsula; last erupted in 1946</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106658049">
	<b:glossaryEntry>a small volcanic island in Indonesia between Java and Sumatra; its violent eruption in 1883 was the greatest in recorded history</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106658291"
	 b:glossaryEntry="a volcano in the Andes in Chile"/>
<rdf:Description rdf:about="&a;106658394">
	<b:glossaryEntry>an active volcano on north central Hawaii Island; highest peak in the Hawaiian Islands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106658555"
	 b:glossaryEntry="an active volcano on south central Hawaii Island"/>
<rdf:Description rdf:about="&a;106658678">
	<b:glossaryEntry>an inactive volcano in the Andes in S Colombia; last erupted in 1950</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106658818">
	<b:glossaryEntry>an inactive volcano in the Andes in central Ecuador; last erupted in 1946</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106658963"
	 b:glossaryEntry="an inactive volcano in central Chile; last erupted in 1959"/>
<rdf:Description rdf:about="&a;106659098">
	<b:glossaryEntry>an active volcano in the Cascade Range in southwestern Washington state; erupted violently in 1980 after 123 years of inactivity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106659365">
	<b:glossaryEntry>a volcano in southwestern Italy on the Mediterranean coast; erupted in 79 AD and buried Pompeii; last erupted in 1944</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106659588"
	 b:glossaryEntry='a motive for living; "pottery was his life"'/>
<rdf:Description rdf:about="&a;106659682">
	<b:glossaryEntry>a motive that can be defended by reasoning or logical argument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106659860">
	<b:glossaryEntry>a rational motive for a belief or action; "the reason that war was declared"; "the grounds for their declaration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106660089"
	 b:glossaryEntry='reason; "there was no occasion for complaint"'/>
<rdf:Description rdf:about="&a;106660189">
	<b:glossaryEntry xml:space='preserve'><![CDATA[grounds; "don''t do it on my account"; "the paper was rejected on acount of its length"; "he tried to blame the victim but his success on that score was doubtful"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106660412">
	<b:glossaryEntry>the cause or intention underlying an action or situation esp in the phrase "the whys and wherefores"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106660574"
	 b:glossaryEntry="a positive motivational influence"/>
<rdf:Description rdf:about="&a;106660712">
	<b:glossaryEntry>an efficient incentive; "they hoped it would act as a spiritual dynamic on all churches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106660868"
	 b:glossaryEntry="a negative motivational influence"/>
<rdf:Description rdf:about="&a;106660991"
	 b:glossaryEntry="a motivation that is inconsistent with reason or logic"/>
<rdf:Description rdf:about="&a;106661163"
	 b:glossaryEntry='an instinctive motive; "profound religious impulses"'/>
<rdf:Description rdf:about="&a;106661330">
	<b:glossaryEntry>(psychology) an urge to withdraw or avoid a situation or an object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106661468">
	<b:glossaryEntry>(psychology) an urge to accept or approach a situation or an object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106661607">
	<b:glossaryEntry>a strong spontaneous and irrational motivation; "his first impulse was to denounce them"; "the urge to find out got him into trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106661823">
	<b:glossaryEntry>an urge to do or say something that might be better left undone or unsaid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106661976"
	 b:glossaryEntry="an irrational but irresistible motive for a belief or action"/>
<rdf:Description rdf:about="&a;106662290"
	 b:glossaryEntry="an intense desire to be alone or out in the open"/>
<rdf:Description rdf:about="&a;106662394">
	<b:glossaryEntry>an intense persistent desire to drink alcoholic beverages to excess</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106662543">
	<b:glossaryEntry>an intense and irresistible love for yourself and concern for your own needs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106662674">
	<b:glossaryEntry>an irresistible impulse to steal in the absence of any economic motive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106662802"
	 b:glossaryEntry="pathologically excessive (and often incoherent) talking"/>
<rdf:Description rdf:about="&a;106662925"
	 b:glossaryEntry="a mania restricted to one thing or idea"/>
<rdf:Description rdf:about="&a;106663033"
	 b:glossaryEntry="an irresistible sexual attraction to dead bodies"/>
<rdf:Description rdf:about="&a;106663167">
	<b:glossaryEntry>an irresistible desire to pick a superficial body parts (as in obsessive nail-biting)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106663311"
	 b:glossaryEntry="a desire to set fire to things"/>
<rdf:Description rdf:about="&a;106663397"
	 b:glossaryEntry="an irresistible urge to pull out your own hair"/>
<rdf:Description rdf:about="&a;106663506"
	 b:glossaryEntry="very strong or irresistible impulse to travel"/>
<rdf:Description rdf:about="&a;106663608">
	<b:glossaryEntry>an irrational motive for performing trivial or repetitive actions against your will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106663760"
	 b:glossaryEntry="motivation based on ideas of right and wrong"/>
<rdf:Description rdf:about="&a;106663948"
	 b:glossaryEntry="the pursuit of pleasure as a matter of ethical principle"/>
<rdf:Description rdf:about="&a;106664059">
	<b:glossaryEntry>motivation deriving logically from ethical or moral principles that govern a person''s thoughts and actions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106664328"
	 b:glossaryEntry="an inner voice that judges your behavior"/>
<rdf:Description rdf:about="&a;106664466"
	 b:glossaryEntry="a motivating awareness of ethical responsibility"/>
<rdf:Description rdf:about="&a;106664591">
	<b:glossaryEntry>a divine presence believed by Quakers to enlighten and guide the soul</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106664757"
	 b:glossaryEntry="an actuating force or factor"/>
<rdf:Description rdf:about="&a;106664898"
	 b:glossaryEntry="a means of arousing or stirring to action"/>
<rdf:Description rdf:about="&a;106665028">
	<b:glossaryEntry>any incitement to action; "he awaited the signal to start"; "the victory was a signal for wild celebration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106665188"
	 b:glossaryEntry="(psychoanalysis) psychic energy produced by the libido"/>
<rdf:Description rdf:about="&a;106665341">
	<b:glossaryEntry>(psychoanalysis) the libidinal energy invested in some idea or person or object; "Freud thought of cathexis as a psychic analog of an electrical charge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106665557">
	<b:glossaryEntry>(psychoanalysis) a lack of cathexis; a condition in which significant objects or memories arouse no emotion in an individual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106665737">
	<b:glossaryEntry>an active and efficient cause; capable of producing a certain effect; "their research uncovered new disease agents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106665994">
	<b:glossaryEntry>any agent that interferes with normal embryonic development: alcohol or thalidomide or X-rays or rubella are examples</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106666185">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the part of the earth''s surface covered with water; "they invaded our territorial waters"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106666813">
	<b:glossaryEntry>anything that is caught (especially if it is worth catching); "he shared his catch with the others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106666964"
	 b:glossaryEntry="a naturally enclosed space"/>
<rdf:Description rdf:about="&a;106667120"
	 b:glossaryEntry="a wide and open space or area as of surface or land or sky"/>
<rdf:Description rdf:about="&a;106667277">
	<b:glossaryEntry>something that is found; "the findings in the gastrointestinal tract indicate that he died several hours after dinner"; "an area rich in archaelogical findings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106667491"
	 b:glossaryEntry='something grown or growing; "a growth of hair"'/>
<rdf:Description rdf:about="&a;106667608"
	 b:glossaryEntry="something that grows inward"/>
<rdf:Description rdf:about="&a;106667690"
	 b:glossaryEntry='a rounded compact mass; "the head of a comet"'/>
<rdf:Description rdf:about="&a;106667786"
	 b:glossaryEntry="the frozen part of a body of water"/>
<rdf:Description rdf:about="&a;106667942">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the solid part of the earth''s surface; "the plane turned away from the sea and moved back over land"; "the earth shook for several minutes"; "he dropped the logs on the ground"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106668569">
	<b:glossaryEntry>what plants grow in (especially with reference to its quality or use); "the land had never been plowed"; "good agricultural soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106668927">
	<b:glossaryEntry>any object resembling a moon; "he made a moon lamp that he used as a night light"; "the clock had a moon that showed various phases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106669110">
	<b:glossaryEntry>a nearby object of the same kind; "Fort Worth is a neighbor of Dallas"; "what is the closest neighbor to the Earth?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106669293">
	<b:glossaryEntry>a lump of hard consolidated mineral matter; "he threw a rock at me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106669653"
	 b:glossaryEntry="a rock of meteoric origin containing chondrules"/>
<rdf:Description rdf:about="&a;106669775"
	 b:glossaryEntry="a stony meteor lacking chondrules"/>
<rdf:Description rdf:about="&a;106669865">
	<b:glossaryEntry>small granule (of e.g. chrysolite) found in some meteoric rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106670003">
	<b:glossaryEntry>the part of a rock formation that appears above the surface of the surrounding land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106670205"
	 b:glossaryEntry="an outcropping of rock that extends outward"/>
<rdf:Description rdf:about="&a;106670304"
	 b:glossaryEntry="something to which a mountain climber''s rope can be secured"/>
<rdf:Description rdf:about="&a;106670415">
	<b:glossaryEntry>something weighing a given number of pounds; "the fisherman caught a 10-pounder" or "their linemen are all 300-pounders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106670589">
	<b:glossaryEntry>any object that is left unused or still extant; "I threw out the remains of my dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106670747">
	<b:glossaryEntry>a relic or impression of a plant or animal that existed in a past geological age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106670994">
	<b:glossaryEntry>one of the coiled chambered fossil shells of extinct mollusks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106671121"
	 b:glossaryEntry="a fossil that must be studied microscopically"/>
<rdf:Description rdf:about="&a;106671224"
	 b:glossaryEntry="fossil trail of a worm"/>
<rdf:Description rdf:about="&a;106671301">
	<b:glossaryEntry>all or part of a natural object that is collected and preserved as an example of its class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106671498">
	<b:glossaryEntry>a cylindrical sample of soil or rock obtained with a hollow drill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106671614"
	 b:glossaryEntry='anything that covers; "there was a blanket of snow"'/>
<rdf:Description rdf:about="&a;106671728"
	 b:glossaryEntry="a hard outer layer that covers something"/>
<rdf:Description rdf:about="&a;106671868">
	<b:glossaryEntry>a natural covering (as by a fluid); "the spacecraft detected an envelope of gas around the comet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106672020"
	 b:glossaryEntry="the exterior covering of a bird''s egg"/>
<rdf:Description rdf:about="&a;106672139">
	<b:glossaryEntry>a rigid covering that envelops an object; "the satellite is covered with a smooth shell of ice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106672286">
	<b:glossaryEntry>a natural object that covers or envelops; "the fox was flushed from its cover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106672770"
	 b:glossaryEntry="an incrustation that forms on the teeth and gums"/>
<rdf:Description rdf:about="&a;106672882">
	<b:glossaryEntry>any outer covering that can be shed or cast off (such as the cast-off skin of a snake)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106673021">
	<b:glossaryEntry>a stone produced by concretion of mineral salts; found in hollow organs or ducts of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106673240"
	 b:glossaryEntry="a calculus formed in the bladder"/>
<rdf:Description rdf:about="&a;106673344"
	 b:glossaryEntry="a calculus formed in the kidney"/>
<rdf:Description rdf:about="&a;106673483"
	 b:glossaryEntry="a calculus formed in the gall bladder or its ducts"/>
<rdf:Description rdf:about="&a;106673601"
	 b:glossaryEntry="a stone formed in the salivary gland"/>
<rdf:Description rdf:about="&a;106673713">
	<b:glossaryEntry>a stone in a marsh or shallow water that can be stepped on in crossing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106673844">
	<b:glossaryEntry>an individual 3-dimensional object that has mass and that is distinguishable from other objects; "heavenly body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106674079">
	<b:glossaryEntry>an small intracellular body found within another (characteristic of certain diseases); "an inclusion in the cytoplasm of the cell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106674300"
	 b:glossaryEntry="an inclusion body found in plasma cells in cases of cancer"/>
<rdf:Description rdf:about="&a;106674433">
	<b:glossaryEntry>a hypothetical object capable of absorbing all the electromagnetic radiation falling on it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106674595">
	<b:glossaryEntry>a large body of matter without definite shape; "a huge ice mass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106674728"
	 b:glossaryEntry='any soft or soggy mass; "he pounded it to a pulp"'/>
<rdf:Description rdf:about="&a;106674828">
	<b:glossaryEntry>a body having finite mass and internal structure but negligible dimensions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106675155">
	<b:glossaryEntry>a hypothetical particle with a single magnetic pole instead of the usual two</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106675295">
	<b:glossaryEntry>a hypothetical particle that is the elementary particle in a theory of space-time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106675434">
	<b:glossaryEntry>a particle that is less complex than an atom; regarded as constituents of all matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106675773">
	<b:glossaryEntry>a particle that has the same mass as another particle but has opposite values for its other properties; interaction of a particle and its antiparticle results in annihilation and the production of radiant energy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106676043">
	<b:glossaryEntry>any particle that obeys Bose-Einstein statistics but not the Pauli exclusion principle; all nuclei with an even mass number are bosons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106676265">
	<b:glossaryEntry>a particle that mediates the interaction of two elementary particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106676463">
	<b:glossaryEntry>a quantum of electromagnetic radiation; an elementary particle that is its own antiparticle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106676626"
	 b:glossaryEntry="a gauge boson that mediates strong interaction among quarks"/>
<rdf:Description rdf:about="&a;106676737">
	<b:glossaryEntry>a gauge boson that mediates weak interactions between particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106676873">
	<b:glossaryEntry>a gauge boson that mediates the (extremely weak) gravitational interactions between particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106677022">
	<b:glossaryEntry>any particle that obeys Fermi-Dirac statistics and is subject to the Pauli exclusion principle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106677206">
	<b:glossaryEntry>an elementary particle responsible for the forces in the atomic nucleus; a hadron with a baryon number of 0</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106677466"
	 b:glossaryEntry="the antiparticle of a meson"/>
<rdf:Description rdf:about="&a;106677549">
	<b:glossaryEntry>a meson produced as the result of high-energy particle collision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106677675">
	<b:glossaryEntry>an unstable meson produced as the result of a high-energy particle collision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106677839"
	 b:glossaryEntry="exceedingly short-lived meson"/>
<rdf:Description rdf:about="&a;106677922"
	 b:glossaryEntry="a neutral meson with a large mass"/>
<rdf:Description rdf:about="&a;106678027">
	<b:glossaryEntry>an elementary particle that participates in weak interactions; has a baryon number of 0</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106678257"
	 b:glossaryEntry="the antiparticle of a lepton"/>
<rdf:Description rdf:about="&a;106678414"
	 b:glossaryEntry="an elementary particle with negative charge"/>
<rdf:Description rdf:about="&a;106678548">
	<b:glossaryEntry>an elementary particle with positive charge; interaction of a positron and an electron results in annihilation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106678728"
	 b:glossaryEntry="an electron ejected from matter by ionizing radiation"/>
<rdf:Description rdf:about="&a;106678837">
	<b:glossaryEntry>a electron that is emited from an atom or molecule by an incident photon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106678969">
	<b:glossaryEntry>an electrically charged particle (electron or ion) emitted by a substance at a high temperature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106679119"
	 b:glossaryEntry="an elementary particle with zero charge and zero mass"/>
<rdf:Description rdf:about="&a;106679227"
	 b:glossaryEntry="the antiparticle of a neutrino"/>
<rdf:Description rdf:about="&a;106679316">
	<b:glossaryEntry>an elementary particle with a negative charge and a half-life of 2 microsecond; decays to electron and neutrino and antineutrino</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106679522">
	<b:glossaryEntry>the antiparticle of a muon; decays to positron and neutrino and antineutrino</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106679669"
	 b:glossaryEntry="a lepton of very great mass"/>
<rdf:Description rdf:about="&a;106679769"
	 b:glossaryEntry="an antilepton of very great mass"/>
<rdf:Description rdf:about="&a;106679877">
	<b:glossaryEntry>any elementary particle that interacts strongly with other particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106680108">
	<b:glossaryEntry>any of the elementary particles having a mass equal to or greater than that of a proton and that participate in strong interactions; a hadron with a baryon number of +1</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106680400">
	<b:glossaryEntry>the antiparticle of a baryon; a hadron with a baryon number of -1</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106680522">
	<b:glossaryEntry>any baryon that is not a nucleon; unstable particle with mass greater than a neutron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106680678"
	 b:glossaryEntry="an electrically neutral baryon with isotopic spin 1"/>
<rdf:Description rdf:about="&a;106680808"
	 b:glossaryEntry="a constituent (proton or neutron) of an atomic nucleus"/>
<rdf:Description rdf:about="&a;106681007">
	<b:glossaryEntry>a stable particle with positive charge equal to the negative charge of an electron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106681160">
	<b:glossaryEntry>an unstable negatively charged proton; the antiparticle of a proton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106681284">
	<b:glossaryEntry>an elementary particle with 0 charge and mass about equal to a proton; enters into the structure of the atomic nucleus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106681456"
	 b:glossaryEntry="the antiparticle of a neutron"/>
<rdf:Description rdf:about="&a;106681543">
	<b:glossaryEntry>hypothetical truly fundamental particle in mesons and baryons; there are supposed to be six kinds of quarks (and their antiquarks), which come in pairs; has an electric charge of +2/3 or -1/3</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106681913"
	 b:glossaryEntry="the antiparticle of a quark"/>
<rdf:Description rdf:about="&a;106682015">
	<b:glossaryEntry>a stable quark with an electric charge of +2/3 and a mass 607 times that of an electron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106682157">
	<b:glossaryEntry>a stable quark with an electric charge of -1/3 and a mass 607 times that of an electron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106682301">
	<b:glossaryEntry>a quark with an electric charge of +2/3 and a mass 2900 times that of an electron and a charm of +1</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106682458">
	<b:glossaryEntry>a quark with an electric charge of -1/3 and a mass 988 times that of an electron and a strangeness of -1</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106682631">
	<b:glossaryEntry>a hypothetical quark with a charge of +2/3 and a mass more than 100,000 times that of an electron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106682798">
	<b:glossaryEntry>a quark with a charge of -1/3 and a mass about 10,000 times that of an electron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106682951"
	 b:glossaryEntry="an elementary particle with non-zero strangeness"/>
<rdf:Description rdf:about="&a;106683062">
	<b:glossaryEntry>an electrically charged particle built up from polymeric molecules or ions and occurring in certain colloidal electrolytic solutions like soaps and detergents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106683274">
	<b:glossaryEntry>a positively charged particle that is the nucleus of the helium atom; emitted from natural or radioactive isotopes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106683449">
	<b:glossaryEntry>a high-speed electron or positron emitted in the decay of a radioactive isotope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106683588">
	<b:glossaryEntry>the nucleus of deuterium; consists of one proton and one neutron; used as a bombarding particle in accelerators</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106683754">
	<b:glossaryEntry>any large molecule containing chains of amino acids linked by peptide bonds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106683928">
	<b:glossaryEntry>a single undivided natural entity occurring in the composition of something else; "units of nucleic acids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106684175">
	<b:glossaryEntry>a portion of a natural object; "they analyzed the river into three parts"; "he needed a piece of granite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106684592"
	 b:glossaryEntry='the bottom or lowest part; "the base of the mountain"'/>
<rdf:Description rdf:about="&a;106684696">
	<b:glossaryEntry>a projecting part that is corner-shaped; "he knocked off the corners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106684818">
	<b:glossaryEntry>a part of the earth that can be considered separately; "the outdoor world"; "the world of insects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106684968">
	<b:glossaryEntry>a needle-like part or structure of a plant or animal or crystal; as a spine or bristle or crystal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106685119"
	 b:glossaryEntry="a piece cut off from the main part of something"/>
<rdf:Description rdf:about="&a;106685238"
	 b:glossaryEntry="something that has been pruned off of a plant"/>
<rdf:Description rdf:about="&a;106685337">
	<b:glossaryEntry>a short piece remaining on a trunk or stem where a branch is lost</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106685453"
	 b:glossaryEntry='a piece broken off of something else; "a fragment of rock"'/>
<rdf:Description rdf:about="&a;106685692">
	<b:glossaryEntry>a large piece of something without definite shape; "a hunk of bread" or "a lump of coal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106685856">
	<b:glossaryEntry>a solid lump of a precious metal (especially gold) as found in the earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106685981"
	 b:glossaryEntry='a small piece; "a nub of coal" or "a stub of a pencil"'/>
<rdf:Description rdf:about="&a;106686110"
	 b:glossaryEntry="a small nub (especially an undeveloped fruit or ear of corn)"/>
<rdf:Description rdf:about="&a;106686223">
	<b:glossaryEntry>one of the parts into which something naturally divides: "a segment of an orange"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106686412"
	 b:glossaryEntry="a thin flat piece cut off of some object"/>
<rdf:Description rdf:about="&a;106686522">
	<b:glossaryEntry>a relatively long narrow piece of something; "he felt a flat strip of muscle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106686669">
	<b:glossaryEntry>a long continuous strip (usually running horizontally); "a mackerel sky filled with rows of clouds"; "rows of barbed wire protected the trenches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106686864">
	<b:glossaryEntry>a very thin slice (of tissue or mineral or other substance) for examination under a microscope; "sections from the left ventricle showed diseased tissue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106687090">
	<b:glossaryEntry>a small fragment of something broken off from the whole; "a bit of rock caught him in the eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106687337">
	<b:glossaryEntry>a thin flake of dead epidermis shed from the surface of the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106687479">
	<b:glossaryEntry>(botany) a covering that resembles scales or bran that covers some plant parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106687609"
	 b:glossaryEntry="loose scales shed from the scalp"/>
<rdf:Description rdf:about="&a;106687696">
	<b:glossaryEntry>a small thin sharp bit or wood or glass or metal; "he got a splinter in his finger"; "it flew into flinders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106687879">
	<b:glossaryEntry>a fragment scraped off of something and collected (usually plural); "they collected blood scrapings for analysis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106688047"
	 b:glossaryEntry='fragments of wood; "it was smashed into matchwood'/>
<rdf:Description rdf:about="&a;106688152">
	<b:glossaryEntry>a thin fragment or slice (especially of wood) that has been shaved from something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106688323">
	<b:glossaryEntry>a thin sliver of wood; "he lit the fire with a burning splint"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106688438"
	 b:glossaryEntry="a fragment of brick used as a weapon"/>
<rdf:Description rdf:about="&a;106688529">
	<b:glossaryEntry>a fragment of incombustible matter left after a wood or coal or charcoal fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106688669">
	<b:glossaryEntry>a hot glowing or smouldering fragment of wood or coal left from a fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106688798">
	<b:glossaryEntry>a small fragment of a burning substance thrown out by burning material or by friction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106688935"
	 b:glossaryEntry="a series of linked atoms (generally in an organic molecule)"/>
<rdf:Description rdf:about="&a;106689118">
	<b:glossaryEntry>(chemistry) a chain of atoms in a molecule that forms a closed loop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106689269">
	<b:glossaryEntry>a chain of atoms in a molecule whose ends are not joined to form a ring</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106689451"
	 b:glossaryEntry="an open chain of atoms with no side chains"/>
<rdf:Description rdf:about="&a;106689554">
	<b:glossaryEntry>an open chain of atoms with one or more side chains attached to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106689681"
	 b:glossaryEntry="the positively charged dense center of an atom"/>
<rdf:Description rdf:about="&a;106689819">
	<b:glossaryEntry>an electrically charged particle; an atom that has lost one or more of its electrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106690007">
	<b:glossaryEntry>a positively charged atom of hydrogen; that is to say, a normal hydrogen atomic nucleus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106690190"
	 b:glossaryEntry="a positively charged atom"/>
<rdf:Description rdf:about="&a;106690304"
	 b:glossaryEntry="a negatively charged atom"/>
<rdf:Description rdf:about="&a;106690399">
	<b:glossaryEntry>something joined by two equal and opposite forces that act along parallel lines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106690568">
	<b:glossaryEntry>a pair of equal and opposite electric charges or magnetic poles separated by a small distance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106690750"
	 b:glossaryEntry="a molecule that is a permanent dipole"/>
<rdf:Description rdf:about="&a;106690849"
	 b:glossaryEntry="a dipole with opposing magnetic poles"/>
<rdf:Description rdf:about="&a;106690948"
	 b:glossaryEntry="a dipole with equal and opposite electric charges"/>
<rdf:Description rdf:about="&a;106691078">
	<b:glossaryEntry>everything that exists anywhere; "they study the evolution of the universe"; "the biggest tree in existence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106691339">
	<b:glossaryEntry>the physical universe considered as an orderly system subject to natural (not human or supernatural) laws</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106691504"
	 b:glossaryEntry="the geological features of the earth"/>
<rdf:Description rdf:about="&a;106692025">
	<b:glossaryEntry>underground bed or layer yielding ground water for wells and springs etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106692151"
	 b:glossaryEntry="a thin layer or stratum of (especially metamorphic) rock"/>
<rdf:Description rdf:about="&a;106692260">
	<b:glossaryEntry>a block of the earth''s crust bounded by faults and shifted to form peaks of a mountain range</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106692424"
	 b:glossaryEntry="a raised or elevated geological formation"/>
<rdf:Description rdf:about="&a;106692686"
	 b:glossaryEntry="a sunken or depressed geological formation"/>
<rdf:Description rdf:about="&a;106693004">
	<b:glossaryEntry>a depression forming the ground under a body of water; "he searched for treasure on the ocean bed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106693233"
	 b:glossaryEntry="deeply eroded barren land"/>
<rdf:Description rdf:about="&a;106693313"
	 b:glossaryEntry="low-lying alluvial land near a river"/>
<rdf:Description rdf:about="&a;106693415"
	 b:glossaryEntry="the bottom of a sea or ocean"/>
<rdf:Description rdf:about="&a;106693627"
	 b:glossaryEntry="land in a coastal area"/>
<rdf:Description rdf:about="&a;106693705">
	<b:glossaryEntry>the relatively shallow (up to 200 meters) seabed surrounding a continent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106693841">
	<b:glossaryEntry>the steep descent of the seabed from the continental shelf to the abyssal zone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106694017"
	 b:glossaryEntry="the deep sea (2000 meters or more) where there is no light"/>
<rdf:Description rdf:about="&a;106694134"
	 b:glossaryEntry="the bottom of a lake"/>
<rdf:Description rdf:about="&a;106694223"
	 b:glossaryEntry="a channel occupied (or formerly occupied) by a stream"/>
<rdf:Description rdf:about="&a;106694362">
	<b:glossaryEntry>(western United States) the dry bed of an intermittent stream (as at the bottom of a canyon)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106694516"
	 b:glossaryEntry="a channel occupied (or formerly occupied) by a river"/>
<rdf:Description rdf:about="&a;106694638"
	 b:glossaryEntry="something heaped up by the wind or current"/>
<rdf:Description rdf:about="&a;106694768"
	 b:glossaryEntry="a mass of snow heaped up by the wind"/>
<rdf:Description rdf:about="&a;106694860"
	 b:glossaryEntry="a mound of glacial drift"/>
<rdf:Description rdf:about="&a;106694938">
	<b:glossaryEntry>matter resulting from the process of grinding; "vegetable grindings clogged the drain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106695079"
	 b:glossaryEntry="matter deposited by water or ice or wind"/>
<rdf:Description rdf:about="&a;106695274">
	<b:glossaryEntry>clay or slit or gravel carried by rushing streams and deposited where the stream slows down</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106695496">
	<b:glossaryEntry>an alluvial deposit that contains particles of some valuable mineral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106695617"
	 b:glossaryEntry="sediment that has settled at the bottom of a liquid"/>
<rdf:Description rdf:about="&a;106695748"
	 b:glossaryEntry="the dregs remaining after brewing coffee"/>
<rdf:Description rdf:about="&a;106695849"
	 b:glossaryEntry="the sediment from fermentation of an alcoholic beverage"/>
<rdf:Description rdf:about="&a;106695955"
	 b:glossaryEntry="a salt deposit that animals regularly lick"/>
<rdf:Description rdf:about="&a;106696060"
	 b:glossaryEntry="a liquid lying above a sediment (floating on the surface)"/>
<rdf:Description rdf:about="&a;106696175">
	<b:glossaryEntry>a rock formed by the solidification of a substance; has regularly repeating internal structure; external plane faces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106696363">
	<b:glossaryEntry>the smallest group of atoms or molecules whose repetition at regular intervals in three dimensions produces the lattices of a crystal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106696552">
	<b:glossaryEntry>any of numerous minute rudimentary crystalline bodies of unknown composition found in glassy igneous rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106696715">
	<b:glossaryEntry>a large smooth mass of rock detached from its place of origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106696912">
	<b:glossaryEntry>solid unweathered rock lying beneath surface deposits of soil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106697027"
	 b:glossaryEntry="a small smooth rounded rock"/>
<rdf:Description rdf:about="&a;106697107">
	<b:glossaryEntry>a rock created by petrifaction; an organic object infiltrated with mineral matter and preserved in its original form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106697282">
	<b:glossaryEntry>a sandstone that withstands intense heat; used to line fireplaces and furnaces and kilns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106697426"
	 b:glossaryEntry="a soft sandstone used for scrubbing the decks of a ship"/>
<rdf:Description rdf:about="&a;106697537"
	 b:glossaryEntry="rock altered by pressure and heat"/>
<rdf:Description rdf:about="&a;106697651"
	 b:glossaryEntry="any metamorphic rock that can be split into thin layers"/>
<rdf:Description rdf:about="&a;106697759">
	<b:glossaryEntry>a boulder that has been carried by a glacier to a place far distant from its place of origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106697913">
	<b:glossaryEntry>a boulder that has been carried by a river to a place remote from its place of origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106698058"
	 b:glossaryEntry="a boulder found on a shore remote from its place of origin"/>
<rdf:Description rdf:about="&a;106698176">
	<b:glossaryEntry>an open or empty space in or between things; "there was a small opening between the trees"; "the explosion made a gap in the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106698547"
	 b:glossaryEntry="an opening in something"/>
<rdf:Description rdf:about="&a;106698679"
	 b:glossaryEntry="the trail of an animal (especially a deer)"/>
<rdf:Description rdf:about="&a;106698772">
	<b:glossaryEntry>an accidental hole that allows something (fluid or light etc.) to enter or escape; "one of the tires developed a leak"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106698941">
	<b:glossaryEntry>one of a series of small holes (especially such a series for separating a sheet into parts)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106699090">
	<b:glossaryEntry>an opening made forcibly as by pulling apart; "there was a rip in his pants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106699238"
	 b:glossaryEntry="a long narrow opening"/>
<rdf:Description rdf:about="&a;106699512">
	<b:glossaryEntry>a lengthwise crack in wood; "he inserted the wedge into a split in the log"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106699639"
	 b:glossaryEntry="a narrow fissure"/>
<rdf:Description rdf:about="&a;106699706"
	 b:glossaryEntry="a crack in metal resulting from metal fatigue"/>
<rdf:Description rdf:about="&a;106699811"
	 b:glossaryEntry="a crack in a lip caused usually by cold"/>
<rdf:Description rdf:about="&a;106699901"
	 b:glossaryEntry="a narrow opening as e.g. between planks in a wall"/>
<rdf:Description rdf:about="&a;106700002">
	<b:glossaryEntry>a small opening or crevice (especially in a rock face or wall)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106700117">
	<b:glossaryEntry>an opening that resembles a mouth (as of a cave or a gorge); "he rode into the mouth of the canyon"; "they built a fire at the mouth of the cave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106700314"
	 b:glossaryEntry="a steep high face of rock"/>
<rdf:Description rdf:about="&a;106700438"
	 b:glossaryEntry="a high steep bank (usually formed by river erosion)"/>
<rdf:Description rdf:about="&a;106700541"
	 b:glossaryEntry="a steep rugged rock or cliff"/>
<rdf:Description rdf:about="&a;106700620"
	 b:glossaryEntry="a very steep cliff"/>
<rdf:Description rdf:about="&a;106700694"
	 b:glossaryEntry="a sloping mass of rocks at the base of a cliff"/>
<rdf:Description rdf:about="&a;106700800">
	<b:glossaryEntry>a series of hills or mountains; "the valley was between two ranges of hills"; "the plains lay just beyond the mountain range"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106701639">
	<b:glossaryEntry>a range of mountains (usually with jagged peaks and irregular outline)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106701762">
	<b:glossaryEntry>geological feature that is a remnant of a pre-existing formation after other parts have disappeared</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106701914">
	<b:glossaryEntry>a mountain range in northeastern New York State; a popular resort area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106702084">
	<b:glossaryEntry>the western part of the Appalachian Mountains; extending from northern Pennsylvania to southwestern Virginia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106702310">
	<b:glossaryEntry>a mountain range in the eastern United States extending from Quebec to the Gulf of Mexico; a historic barrier to early westward expansion of the United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106702684">
	<b:glossaryEntry>a range of the Appalachians extending from Pennsylvania to northern Georgia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106702845"
	 b:glossaryEntry="a low mountain range in western Massachusetts; a resort area"/>
<rdf:Description rdf:about="&a;106702999">
	<b:glossaryEntry>mountains in southwestern South Dakota and northeastern Wyoming; sacred to the Sioux (whites settling in the Black Hills led to the Battle of Little Bighorn); site of Mount Rushmore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106703295">
	<b:glossaryEntry>a mountain range in the northwestern United States extending through Washington and Oregon and northern California; a part of the Coast Range</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106703564">
	<b:glossaryEntry>a range of the Appalachians west of the Hudson in southeastern New York; includes many popular resort areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106703786">
	<b:glossaryEntry>a string of mountain ranges along the Pacific coast of North America from southeastern Alaska to Lower California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106704013"
	 b:glossaryEntry="the southwestern part of the Appalachians"/>
<rdf:Description rdf:about="&a;106704180">
	<b:glossaryEntry>a pass through the Cumberland Mountains between Virginia and Kentucky that early settlers used in order to move west</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106704376">
	<b:glossaryEntry>part of the Appalachians between North Carolina and Tennessee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106704524">
	<b:glossaryEntry>a mountain range extending 1500 miles on the border between India and Tibet; this range contains the world''s highest mountain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106705026">
	<b:glossaryEntry>a mountain range in northern Kashmir; an extension of the Hindu Kush; contains the 2nd highest peak</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106705319"
	 b:glossaryEntry="a mountain range in China"/>
<rdf:Description rdf:about="&a;106705503"
	 b:glossaryEntry="a mountain range extending west of the Himalayas"/>
<rdf:Description rdf:about="&a;106705688"
	 b:glossaryEntry="a major mountain range of central Asia; extends 1,500 miles"/>
<rdf:Description rdf:about="&a;106705891">
	<b:glossaryEntry>a mountain range in South America running 5000 miles along the Pacific coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106706532">
	<b:glossaryEntry>a mountain range in south central Alaska; contains Mount McKinley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106706713">
	<b:glossaryEntry>a large mountain system in south-central Europe; scenic beauty and winter sports make them a popular tourist attraction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106707046">
	<b:glossaryEntry>the major mountain range of Bulgaria and the Balkan Peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106707223">
	<b:glossaryEntry>an area of low mountains in northwestern Arkansas and southeastern Missouri and northeastern Oklahoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106707414"
	 b:glossaryEntry="a chain of mountains between France and Spain"/>
<rdf:Description rdf:about="&a;106707552">
	<b:glossaryEntry>the chief mountain range of western North America; extends from British Columbia to New Mexico; forms the continental divide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106707804">
	<b:glossaryEntry>a mountain range in eastern California; contains Mount Whitney</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106707990">
	<b:glossaryEntry>a mountain range in northwest Wyoming; contains the Grand Teton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106708149"
	 b:glossaryEntry="a range of mountains between Alaska and the Yukon territory"/>
<rdf:Description rdf:about="&a;106708349">
	<b:glossaryEntry>a mountain range extending the length of the Italian peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106708505">
	<b:glossaryEntry>the mountain range in Caucasia between the Black Sea and the Caspian Sea that forms part of the traditional border between Europe and Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106708719">
	<b:glossaryEntry>a mountain range in western Russia extending from the arctic to the Caspian Sea; forms part of the traditional boundary between Europe and Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106708950">
	<b:glossaryEntry>the location in a range of mountains of a geological formation that is lower than the surrounding peaks; "we got through the pass before it started to snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106709272">
	<b:glossaryEntry>a line or route along which something travels or moves: "the hurricane demolished houses in its path"; "the track of an animal"; "the course of the river"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106709584">
	<b:glossaryEntry>the course along which communications spread; "the story is going the rounds in Washington"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106709727">
	<b:glossaryEntry>the course along which a person has walked or is walking in; "I followed in his steps"; "he retraced his steps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106709890"
	 b:glossaryEntry="the inner side of a curved racecourse"/>
<rdf:Description rdf:about="&a;106710005">
	<b:glossaryEntry>a track or mark left by something that has passed; "there as a trail of blood"; "a tear left its trail on her cheek"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106710209">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the trail left by a person or an animal; what the hunter follows in pursuing game; "the hounds followed the fox''s spoor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106710381"
	 b:glossaryEntry="a path or strip (as cut by one course of mowing)"/>
<rdf:Description rdf:about="&a;106710488"
	 b:glossaryEntry="a narrow pass (especially one between mountains)"/>
<rdf:Description rdf:about="&a;106710597"
	 b:glossaryEntry="a pass between mountain peaks"/>
<rdf:Description rdf:about="&a;106710718">
	<b:glossaryEntry>a pass or ridge that slopes gently between two peaks (is shaped like a saddle)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106710862"
	 b:glossaryEntry="a pass in a mountain ridge through which a stream flows"/>
<rdf:Description rdf:about="&a;106710973"
	 b:glossaryEntry="a pass in a mountain ridge with no stream flowing through it"/>
<rdf:Description rdf:about="&a;106711088">
	<b:glossaryEntry>a land mass that projects well above its surroundings; higher than a hill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106711352">
