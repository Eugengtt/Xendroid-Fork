</rdf:Description>
<rdf:Description rdf:about="&a;101395356"
	 b:glossaryEntry="tree wallabies"/>
<rdf:Description rdf:about="&a;101395486">
	<b:glossaryEntry>arboreal wallabies of New Guinea and northern Australia having hind and forelegs of similar length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101395678"
	 b:glossaryEntry="musk kangaroos"/>
<rdf:Description rdf:about="&a;101395814"
	 b:glossaryEntry="small kangaroo of northeastern Australia"/>
<rdf:Description rdf:about="&a;101395960"
	 b:glossaryEntry="rat kangaroos"/>
<rdf:Description rdf:about="&a;101396129"
	 b:glossaryEntry="any of several rabbit-sized rat-like Australian kangaroos"/>
<rdf:Description rdf:about="&a;101396333"
	 b:glossaryEntry="potoroos"/>
<rdf:Description rdf:about="&a;101396451"
	 b:glossaryEntry="Australian rat kangaroos"/>
<rdf:Description rdf:about="&a;101396548"
	 b:glossaryEntry="jerboa kangaroo"/>
<rdf:Description rdf:about="&a;101396694"
	 b:glossaryEntry="short-nosed rat kangaroo"/>
<rdf:Description rdf:about="&a;101396791"
	 b:glossaryEntry="brush-tailed rat kangaroo"/>
<rdf:Description rdf:about="&a;101396915"
	 b:glossaryEntry="phalangers; koalas"/>
<rdf:Description rdf:about="&a;101397149">
	<b:glossaryEntry>small furry Australian arboreal marsupials having long usually prehensile tails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101397394"
	 b:glossaryEntry="type genus of the family_Phalangeridae: cuscuses"/>
<rdf:Description rdf:about="&a;101397542">
	<b:glossaryEntry>woolly-haired monkey-like arboreal marsupial of New Guinea and North Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101397692"
	 b:glossaryEntry="a genus of Phalangeridae"/>
<rdf:Description rdf:about="&a;101397832"
	 b:glossaryEntry="bushy-tailed phalanger"/>
<rdf:Description rdf:about="&a;101397966"
	 b:glossaryEntry="a genus of Phalangeridae"/>
<rdf:Description rdf:about="&a;101398100">
	<b:glossaryEntry>nocturnal phalangers that move with gliding leaps using parachute-like folds of skin along the sides of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101398347"
	 b:glossaryEntry="a genus of Phalangeridae"/>
<rdf:Description rdf:about="&a;101398483"
	 b:glossaryEntry="tiny flying phalanger"/>
<rdf:Description rdf:about="&a;101398582"
	 b:glossaryEntry="koalas"/>
<rdf:Description rdf:about="&a;101398689">
	<b:glossaryEntry>sluggish tailless Australian arboreal marsupial with gray furry ears and coat; feeds on eucalyptus leaves and bark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101398923"
	 b:glossaryEntry="wombats"/>
<rdf:Description rdf:about="&a;101399045">
	<b:glossaryEntry>burrowing herbivorous Australian marsupials about the size of a badger</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101399187">
	<b:glossaryEntry>dasyures; native cats; pouched mice; banded_anteaters; Tasmanian devils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101399488">
	<b:glossaryEntry>small carnivorous nocturnal marsupials of Australia and Tasmania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101399737"
	 b:glossaryEntry="type genus of the family Dasyuridae: native cats"/>
<rdf:Description rdf:about="&a;101399895">
	<b:glossaryEntry>any of several more or less arboreal marsupials somewhat resembling martens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101400079"
	 b:glossaryEntry="a variety of dasyure"/>
<rdf:Description rdf:about="&a;101400178">
	<b:glossaryEntry>carnivorous arboreal catlike marsupials of Australia and Tasmania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101400322"
	 b:glossaryEntry="Tasmanian wolf"/>
<rdf:Description rdf:about="&a;101400450">
	<b:glossaryEntry>rare doglike carnivorous marsupial of Tasmania having stripes on its back; probably extinct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101400677"
	 b:glossaryEntry="Tasmanian devil"/>
<rdf:Description rdf:about="&a;101400808">
	<b:glossaryEntry>small ferocious carnivorous marsupial having a mostly black coat and long tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101401006"
	 b:glossaryEntry="pouched mice"/>
<rdf:Description rdf:about="&a;101401132">
	<b:glossaryEntry>any of numerous small sharp-nosed insectivorous marsupials superficially resembling mice or rats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101401341"
	 b:glossaryEntry="banded anteater"/>
<rdf:Description rdf:about="&a;101401472">
	<b:glossaryEntry>small Australian marsupial having long snout and strong claws for feeding on termites; nearly extinct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101401698"
	 b:glossaryEntry="pouched moles"/>
<rdf:Description rdf:about="&a;101401830">
	<b:glossaryEntry>type genus of the family Notoryctidae: comprising solely the marsupial mole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101402019"
	 b:glossaryEntry="small burrowing Australian marsupial that resembles a mole"/>
<rdf:Description rdf:about="&a;101402194"
	 b:glossaryEntry="all mammals except monotremes and marsupials"/>
<rdf:Description rdf:about="&a;101402712">
	<b:glossaryEntry>mammals having a placenta; all mammals except monotremes and marsupials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101403412"
	 b:glossaryEntry="not used technically; any animals kept for use or profit"/>
<rdf:Description rdf:about="&a;101403546">
	<b:glossaryEntry>mature male of various mammals of which the female is called `cow''; e.g. whales or elephants or especially cattle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101403710"
	 b:glossaryEntry="mature female of mammals of which the male is called `bull''"/>
<rdf:Description rdf:about="&a;101403819"
	 b:glossaryEntry="young of domestic cattle"/>
<rdf:Description rdf:about="&a;101403968">
	<b:glossaryEntry>young of various large placental mammals e.g. whale or giraffe or elephant or buffalo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101404104"
	 b:glossaryEntry="an animal in its second year"/>
<rdf:Description rdf:about="&a;101404187"
	 b:glossaryEntry="mature male of various mammals (especially deer or antelope)"/>
<rdf:Description rdf:about="&a;101404316"
	 b:glossaryEntry="mature female of mammals of which the male is called `buck''"/>
<rdf:Description rdf:about="&a;101404425"
	 b:glossaryEntry="shrews; moles; hedgehogs; tenrecs"/>
<rdf:Description rdf:about="&a;101404726"
	 b:glossaryEntry="moles; hedgehogs; true shrews"/>
<rdf:Description rdf:about="&a;101404853"
	 b:glossaryEntry="elephant shrews; tree shrews"/>
<rdf:Description rdf:about="&a;101404979">
	<b:glossaryEntry>small insect-eating mainly nocturnal terrestrial or fossorial mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101405215"
	 b:glossaryEntry="moles"/>
<rdf:Description rdf:about="&a;101405407">
	<b:glossaryEntry>small velvety-furred burrowing mammal having small eyes and fossorial forefeet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101405627"
	 b:glossaryEntry="sar-nosed moles"/>
<rdf:Description rdf:about="&a;101405735">
	<b:glossaryEntry>amphibious mole of eastern North America having pink fleshy tentacles around the nose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101405919"
	 b:glossaryEntry="brewer''s moles"/>
<rdf:Description rdf:about="&a;101406030"
	 b:glossaryEntry="mole of eastern North America"/>
<rdf:Description rdf:about="&a;101406160"
	 b:glossaryEntry="golden moles"/>
<rdf:Description rdf:about="&a;101406297"
	 b:glossaryEntry="type genus of the Chrysochloridae"/>
<rdf:Description rdf:about="&a;101406450">
	<b:glossaryEntry>mole of southern Africa having iridescent guard hairs mixed with the underfur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101406604"
	 b:glossaryEntry="shrew moles"/>
<rdf:Description rdf:about="&a;101406746"
	 b:glossaryEntry="slender mole having a long snout and tail"/>
<rdf:Description rdf:about="&a;101406899"
	 b:glossaryEntry="shrew mole of eastern Asia"/>
<rdf:Description rdf:about="&a;101407031"
	 b:glossaryEntry="shrew moles"/>
<rdf:Description rdf:about="&a;101407160"
	 b:glossaryEntry="grayish-black shrew mole of the United States and Canada"/>
<rdf:Description rdf:about="&a;101407324"
	 b:glossaryEntry="shrews"/>
<rdf:Description rdf:about="&a;101407519"
	 b:glossaryEntry="small mouselike long-snouted mammal related to moles"/>
<rdf:Description rdf:about="&a;101407745"
	 b:glossaryEntry="type genus of the family Soricidae: shrews"/>
<rdf:Description rdf:about="&a;101407910"
	 b:glossaryEntry="common American shrew"/>
<rdf:Description rdf:about="&a;101408025"
	 b:glossaryEntry="commonest shrew of moist habitats in North America"/>
<rdf:Description rdf:about="&a;101408151"
	 b:glossaryEntry="shrews"/>
<rdf:Description rdf:about="&a;101408265">
	<b:glossaryEntry>North American shrew with tail less than half its body length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101408431">
	<b:glossaryEntry>any of several small semiaquatic shrews usually living near swift-flowing streams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101408624"
	 b:glossaryEntry="water shrew of North America"/>
<rdf:Description rdf:about="&a;101408756"
	 b:glossaryEntry="a genus of Soricidae"/>
<rdf:Description rdf:about="&a;101408901"
	 b:glossaryEntry="widely distributed Old World water shrew"/>
<rdf:Description rdf:about="&a;101409044"
	 b:glossaryEntry="a type of water shrew"/>
<rdf:Description rdf:about="&a;101409174"
	 b:glossaryEntry="least shrews"/>
<rdf:Description rdf:about="&a;101409279"
	 b:glossaryEntry="small brown shrew of grassy regions of eastern United States"/>
<rdf:Description rdf:about="&a;101409415"
	 b:glossaryEntry="true hedgehogs"/>
<rdf:Description rdf:about="&a;101409546"
	 b:glossaryEntry="type genus of the family Erinaceidae: hedgehogs"/>
<rdf:Description rdf:about="&a;101409705">
	<b:glossaryEntry>small nocturnal Old World mammal covered with both hair and protective spines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101409920"
	 b:glossaryEntry="tenrecs and extinct related forms"/>
<rdf:Description rdf:about="&a;101410087">
	<b:glossaryEntry>small often spiny insectivorous mammal of Madagascar; resembles a hedgehog</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101410261"
	 b:glossaryEntry="type genus of the family Tenrecidae: tenrecs"/>
<rdf:Description rdf:about="&a;101410402"
	 b:glossaryEntry="prolific animal that feeds chiefly on earthworms"/>
<rdf:Description rdf:about="&a;101410550"
	 b:glossaryEntry="otter shrews"/>
<rdf:Description rdf:about="&a;101410683"
	 b:glossaryEntry="type genus of the family Potamogalidae: otter shrews"/>
<rdf:Description rdf:about="&a;101410836">
	<b:glossaryEntry>amphibious African insectivorous mammal that resembles an otter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101411008"
	 b:glossaryEntry="backbone of an animal"/>
<rdf:Description rdf:about="&a;101411081"
	 b:glossaryEntry="posterior part of the back of a domestic fowl"/>
<rdf:Description rdf:about="&a;101411217">
	<b:glossaryEntry>a forked bone formed by the fusion of the clavicles of most birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101411373"
	 b:glossaryEntry="the furcula of a domestic fowl"/>
<rdf:Description rdf:about="&a;101411492">
	<b:glossaryEntry>the hard protective layer covering the body of many invertebrates especially arthropods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101411651"
	 b:glossaryEntry="the outer body wall of an insect"/>
<rdf:Description rdf:about="&a;101411738"
	 b:glossaryEntry="body covering of a living animal"/>
<rdf:Description rdf:about="&a;101411835">
	<b:glossaryEntry>layer of cells that secretes the chitinous cuticle in e.g. arthropods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101411980">
	<b:glossaryEntry>the light horny waterproof structure forming the external covering of birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101412402"
	 b:glossaryEntry="soft fine feathers"/>
<rdf:Description rdf:about="&a;101412507"
	 b:glossaryEntry="down of the eider duck"/>
<rdf:Description rdf:about="&a;101412623"
	 b:glossaryEntry="down of the swan"/>
<rdf:Description rdf:about="&a;101412716">
	<b:glossaryEntry>a supplementary feather (usually small) on the underside of the base of the shaft of some feathers in some birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101412885"
	 b:glossaryEntry="one of the long curved tail feathers of a rooster"/>
<rdf:Description rdf:about="&a;101412995">
	<b:glossaryEntry>feathers covering the body of an adult bird and determining its shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101413126">
	<b:glossaryEntry>tuft of small stiff feathers on the first digit of a bird''s wing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101413292"
	 b:glossaryEntry="downy feathers of marabou storks used for trimming garments"/>
<rdf:Description rdf:about="&a;101413424">
	<b:glossaryEntry>the flattened weblike part of a feather consisting of a series of barbs on either side of the shaft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101413618">
	<b:glossaryEntry>one of the parallel filaments projecting from the main shaft of a feather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101413761">
	<b:glossaryEntry>membrane connecting the toes of some aquatic birds and mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101413892">
	<b:glossaryEntry>long slender feather on the necks of e.g. turkeys and pheasants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101414026">
	<b:glossaryEntry>a long narrow feather on the back (saddle) of a domestic fowl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101414164"
	 b:glossaryEntry="growth of hair or wool or fur covering the body of an animal"/>
<rdf:Description rdf:about="&a;101414330">
	<b:glossaryEntry>a compact mass of hair in the stomach of an animal formed as a result of licking fur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101414481">
	<b:glossaryEntry>coarse hairs that form the outer fur and protect the underfur of certain mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101414637">
	<b:glossaryEntry>dense coat of fine silky hairs on an mammals e.g. cat or seal or weasel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101414795">
	<b:glossaryEntry>thick soft fur lying beneath the longer and coarser guard hair</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101414924">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a part lying on the lower side or underneath an animal''s body; "the warbler has a white throat and underparts"; "a woodland mouse with white underparts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101415150"
	 b:glossaryEntry="outer coat of esp. sheep and yaks"/>
<rdf:Description rdf:about="&a;101415243">
	<b:glossaryEntry>long coarse hair growing from the crest of the animal''s neck</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101415391"
	 b:glossaryEntry="the mane of a horse"/>
<rdf:Description rdf:about="&a;101415503">
	<b:glossaryEntry>a lock of a horse''s mane that grows forward between the ears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101415647"
	 b:glossaryEntry="a filamentous projection or process on an organism"/>
<rdf:Description rdf:about="&a;101415820">
	<b:glossaryEntry>a slender flexible animal appendage as on barnacles or crinoids or many insects; often tactile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101415967">
	<b:glossaryEntry>a sharp rigid animal process or appendage; as a porcupine quill or a ridge on a bone or a ray of a fish fin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101416162"
	 b:glossaryEntry="any of the stiff bony rods in the fin of a fish"/>
<rdf:Description rdf:about="&a;101416278"
	 b:glossaryEntry="a stiff hollow protective spine on a porcupine or hedgehog"/>
<rdf:Description rdf:about="&a;101416426"
	 b:glossaryEntry="small spiny outgrowth on the wings of certain insects"/>
<rdf:Description rdf:about="&a;101416532">
	<b:glossaryEntry>a sharp-pointed process especially a sting of a hymenopterous insect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101416654">
	<b:glossaryEntry>a slender bristlelike or tubular process: "a cartilaginous style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101416789">
	<b:glossaryEntry>small needle-like appendage; especially the feeding organ of a tardigrade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101416934"
	 b:glossaryEntry="a minute hairlike projection on mucous membrane"/>
<rdf:Description rdf:about="&a;101417052"
	 b:glossaryEntry="a stiff hair"/>
<rdf:Description rdf:about="&a;101417118">
	<b:glossaryEntry>a stiff chitinous seta or bristle especially of an annelid worm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101417234">
	<b:glossaryEntry>a long stiff hair growing from the snout or brow of most mammals as e.g. a cat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101417392"
	 b:glossaryEntry="a stiff hair or bristle"/>
<rdf:Description rdf:about="&a;101417484">
	<b:glossaryEntry>hairlike structure especially on the surface of a cell or microorganism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101417626"
	 b:glossaryEntry="the back of a horse"/>
<rdf:Description rdf:about="&a;101417720">
	<b:glossaryEntry>a hard flap serving as a cover for (a) the gill slits in fishes or (b) the opening of the shell in certain gastropods when the body is retracted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101417920"
	 b:glossaryEntry="tough natural covering of some organisms"/>
<rdf:Description rdf:about="&a;101418098">
	<b:glossaryEntry>tough more-or-less rigid protective covering of an animal or plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101418225">
	<b:glossaryEntry>a flattened rigid plate forming part of the body covering of many animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101418386"
	 b:glossaryEntry="scale of the kind that covers the bodies of fish"/>
<rdf:Description rdf:about="&a;101418510"
	 b:glossaryEntry="a protective structure resembling a scale"/>
<rdf:Description rdf:about="&a;101418622"
	 b:glossaryEntry="large bony or horny plate as on an armadillo or turtle"/>
<rdf:Description rdf:about="&a;101418728"
	 b:glossaryEntry="hard plate or element of the exoskeleton of some arthropods"/>
<rdf:Description rdf:about="&a;101418861"
	 b:glossaryEntry="a shield-like plate on the front of an insect''s head"/>
<rdf:Description rdf:about="&a;101418986">
	<b:glossaryEntry>hard outer covering or case of certain organisms such as arthropods and turtles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101419204"
	 b:glossaryEntry="the hard largely calcareous covering of a mollusc"/>
<rdf:Description rdf:about="&a;101419395"
	 b:glossaryEntry="a hard outer covering as of some amoebas and sea urchins"/>
<rdf:Description rdf:about="&a;101419502"
	 b:glossaryEntry="a shell of a scallop"/>
<rdf:Description rdf:about="&a;101419582"
	 b:glossaryEntry="a shell of an oyster"/>
<rdf:Description rdf:about="&a;101419661">
	<b:glossaryEntry>the thin conical chambered internal shell (either straight or curved) of a belemnite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101419817">
	<b:glossaryEntry>ridge-like ingrowth of the exoskeleton of an arthropod that supports internal organs and provides attachment points for muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101420017"
	 b:glossaryEntry="outer sheath of the pupa of certain insects"/>
<rdf:Description rdf:about="&a;101420112">
	<b:glossaryEntry>a hard protective sheath as secreted by certain protoctists e.g.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101420229"
	 b:glossaryEntry="the saclike body cavity of a coelenterate"/>
<rdf:Description rdf:about="&a;101420347">
	<b:glossaryEntry>any animal lacking a backbone or notochord; the term is not used as a scientific classification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101420845">
	<b:glossaryEntry>any of various invertebrate animals resembling a plant such as a sea anemone or coral or sponge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101420995">
	<b:glossaryEntry>multicellular organisms having less-specialized cells than in the Metazoa; comprises the single phylum Porifera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101421219"
	 b:glossaryEntry="coextensive with the subkingdom Parazoa: sponges"/>
<rdf:Description rdf:about="&a;101421416">
	<b:glossaryEntry>primitive multicellular marine animal whose porous body is supported by a fibrous skeletal framework; usually occurs in sessile colonies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101421665"
	 b:glossaryEntry="a genus of Porifera"/>
<rdf:Description rdf:about="&a;101421780"
	 b:glossaryEntry="any cell or one-celled organism equipped with a flagellum"/>
<rdf:Description rdf:about="&a;101421918">
	<b:glossaryEntry>any of the flagellated cells in sponges having a collar of cytoplasm around the flagellum; they maintain a flow of water through the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101422126">
	<b:glossaryEntry>sponges with 6-rayed siliceous spicules; choanocytes are restricted to finger-shaped chambers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101422358">
	<b:glossaryEntry>a siliceous sponge (with glassy spicules) of the class Hyalospongiae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101422522"
	 b:glossaryEntry="a genus of Hyalospongiae"/>
<rdf:Description rdf:about="&a;101422662">
	<b:glossaryEntry>deep-water marine sponge having a cylindrical skeleton of intricate glassy latticework; East Indian and East Asian coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101422869"
	 b:glossaryEntry="a family of coelenterates"/>
<rdf:Description rdf:about="&a;101422997"
	 b:glossaryEntry="a genus of coelenterates"/>
<rdf:Description rdf:about="&a;101423285">
	<b:glossaryEntry>multicellular animals having cells differentiated into tissues and organs and usually a digestive cavity and nervous system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101423521"
	 b:glossaryEntry="hydras; polyps; jellyfishes; sea anemones; corals"/>
<rdf:Description rdf:about="&a;101423832">
	<b:glossaryEntry>radially symmetrical animals having saclike bodies with only one opening and tentacles with stinging structures; they occur in polyp and medusa forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101424198">
	<b:glossaryEntry>one of two forms that coelenterates take e.g. a hydra or coral: usually sedentary and has a hollow cylindrical body usually with a ring of tentacles around the mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101424434">
	<b:glossaryEntry>one of two forms that coelenterates take: is the free-swimming sexual stage in the life cycle of a coelenterate and has a gelatinous umbrella-shaped body and tentacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101424673">
	<b:glossaryEntry>coelenterates in which the polyp stage is absent or at least inconspicuous: jellyfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101424891">
	<b:glossaryEntry>any of numerous usually marine and free-swimming coelenterates that constitute the sexually reproductive forms of hydrozoans and scyphozoans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101425161"
	 b:glossaryEntry="small medusa"/>
<rdf:Description rdf:about="&a;101425226">
	<b:glossaryEntry>any of various usually free-swimming marine coelenterates having a gelatinous medusoid stage as the dominant phase of its life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101425434"
	 b:glossaryEntry="a genus of Scyphozoa"/>
<rdf:Description rdf:about="&a;101425566"
	 b:glossaryEntry="a type of jellyfish"/>
<rdf:Description rdf:about="&a;101425674">
	<b:glossaryEntry>coelenterates typically having alternation of generations; hydroid phase is usually colonial giving rise to the medusoid phase by budding: hydras and jellyfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101426002"
	 b:glossaryEntry="colonial coelenterates having the polyp phase dominant"/>
<rdf:Description rdf:about="&a;101426195"
	 b:glossaryEntry="hydras"/>
<rdf:Description rdf:about="&a;101426297"
	 b:glossaryEntry="small tubular solitary freshwater hydrozoan polyp"/>
<rdf:Description rdf:about="&a;101426417"
	 b:glossaryEntry="marine colonial hydrozoans"/>
<rdf:Description rdf:about="&a;101426599">
	<b:glossaryEntry>a floating or swimming oceanic colony of polyps often transparent or showily colored</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101426833"
	 b:glossaryEntry="a genus of Siphonophora"/>
<rdf:Description rdf:about="&a;101426954">
	<b:glossaryEntry>small creatures resembling pieces of fuzzy rope; each with a cluster of swimming bells serving as the head and long elastic tentacles for drawing in prey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101427180"
	 b:glossaryEntry="Portuguese man-of-war"/>
<rdf:Description rdf:about="&a;101427311">
	<b:glossaryEntry>large siphonophore having a bladderlike float and stinging tentacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101427491"
	 b:glossaryEntry="colonial siphonophore of up to 130 ft long"/>
<rdf:Description rdf:about="&a;101427585"
	 b:glossaryEntry="large siphonophore of up to 50 ft long"/>
<rdf:Description rdf:about="&a;101427678"
	 b:glossaryEntry="sessile hydroid that forms feathery colonies"/>
<rdf:Description rdf:about="&a;101427836">
	<b:glossaryEntry>feathery colony of long-branched stems bearing stalkless paired polyps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101427983">
	<b:glossaryEntry>no alternation of generations the medusoid phase being entirely suppressed: sea anemones; corals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101428276">
	<b:glossaryEntry>sessile marine coelenterates including solitary and colonial polyps; the medusoid phase is entirely suppressed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101428528"
	 b:glossaryEntry="sea anemones"/>
<rdf:Description rdf:about="&a;101428722">
	<b:glossaryEntry>marine polyps that resemble flowers but have oral rings of tentacles; differ from corals in forming no hard skeleton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101428933"
	 b:glossaryEntry="any sea anemone or related animal"/>
<rdf:Description rdf:about="&a;101429064"
	 b:glossaryEntry="a genus of sea anemone common in rock pools"/>
<rdf:Description rdf:about="&a;101429196"
	 b:glossaryEntry="corals and sea anemones having eight branches"/>
<rdf:Description rdf:about="&a;101429393"
	 b:glossaryEntry="comprising the soft corals"/>
<rdf:Description rdf:about="&a;101429517"
	 b:glossaryEntry="sea pens"/>
<rdf:Description rdf:about="&a;101429644"
	 b:glossaryEntry="type genus of the family Pennatulidae: sea pens"/>
<rdf:Description rdf:about="&a;101429803"
	 b:glossaryEntry="fleshy featherlike warm-water colonies"/>
<rdf:Description rdf:about="&a;101429914">
	<b:glossaryEntry>marine colonial polyp characterized by a calcareous skeleton; masses in a variety of shapes often forming reefs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101430113"
	 b:glossaryEntry="red corals and sea fans"/>
<rdf:Description rdf:about="&a;101430290"
	 b:glossaryEntry="corals having a horny of calcareous branching skeleton"/>
<rdf:Description rdf:about="&a;101430491"
	 b:glossaryEntry="corals forming featherlike colonies"/>
<rdf:Description rdf:about="&a;101430584"
	 b:glossaryEntry="corals having a treelike or fan-shaped horny skeleton"/>
<rdf:Description rdf:about="&a;101430691">
	<b:glossaryEntry>corals of esp. the Mediterranean having pink or red color used for ornaments and jewelry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101430835"
	 b:glossaryEntry="stony corals"/>
<rdf:Description rdf:about="&a;101431022">
	<b:glossaryEntry>corals having calcareous skeletons aggregations of which form reefs and islands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101431264"
	 b:glossaryEntry="brain corals"/>
<rdf:Description rdf:about="&a;101431386">
	<b:glossaryEntry>massive reef-building coral having a convoluted and furrowed surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101431531">
	<b:glossaryEntry>coelanterate genus of order Madreporaria, including staghorn corals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101431708"
	 b:glossaryEntry="large branching coral resembling antlers"/>
<rdf:Description rdf:about="&a;101431848"
	 b:glossaryEntry="mushroom corals"/>
<rdf:Description rdf:about="&a;101431950"
	 b:glossaryEntry="flattened disk-shaped stony coral usually solitary"/>
<rdf:Description rdf:about="&a;101432061"
	 b:glossaryEntry="a family of ctenophores"/>
<rdf:Description rdf:about="&a;101432203"
	 b:glossaryEntry="a genus of ctenophores"/>
<rdf:Description rdf:about="&a;101432361">
	<b:glossaryEntry>comb jellies; sea acorns; a small phylum formerly considered a class of Coelenterata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101432636">
	<b:glossaryEntry>comb-plate or locomotor organ consisting of a row of strong cilia whose bases are fused</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101432794">
	<b:glossaryEntry>biradially symmetrical hermaphroditic solitary marine animals resembling jellyfishes having for locomotion eight rows of cilia arranged like teeth in a comb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101433149"
	 b:glossaryEntry="ctenophores lacking tentacles; comprises one genus: Beroe"/>
<rdf:Description rdf:about="&a;101433308"
	 b:glossaryEntry="coextensive with the class Nuda"/>
<rdf:Description rdf:about="&a;101433435"
	 b:glossaryEntry="delicately iridescent thimble-shaped ctenophores"/>
<rdf:Description rdf:about="&a;101433554"
	 b:glossaryEntry="ctenophores have retractile tentacles"/>
<rdf:Description rdf:about="&a;101433764"
	 b:glossaryEntry="ctenophores having two long pinnate tentacles"/>
<rdf:Description rdf:about="&a;101433962"
	 b:glossaryEntry="an order of Tentaculata"/>
<rdf:Description rdf:about="&a;101434101"
	 b:glossaryEntry="ctenophore have long tentacles and flattened body"/>
<rdf:Description rdf:about="&a;101434228"
	 b:glossaryEntry="sea gooseberries"/>
<rdf:Description rdf:about="&a;101434352"
	 b:glossaryEntry="sea gooseberries"/>
<rdf:Description rdf:about="&a;101434488">
	<b:glossaryEntry>ctenophore having a rounded body with longitudinal rows of cilia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101434632"
	 b:glossaryEntry="ctenophore having short tentacles; one family"/>
<rdf:Description rdf:about="&a;101434785">
	<b:glossaryEntry>coextensive with the order Cestida; ctenophores having a greatly flattened and elongated body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101434989"
	 b:glossaryEntry="Venus''s girdle"/>
<rdf:Description rdf:about="&a;101435109"
	 b:glossaryEntry="ctenophore having a ribbon-shaped iridescent gelatinous body"/>
<rdf:Description rdf:about="&a;101435266">
	<b:glossaryEntry>ctenophore having tentacles only in the immature stage; body compressed vertically having two large oral lobes and four pointed processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101435490"
	 b:glossaryEntry="ciliated comb-like swimming plate of a ctenophore"/>
<rdf:Description rdf:about="&a;101435609"
	 b:glossaryEntry="a family of worms"/>
<rdf:Description rdf:about="&a;101435937"
	 b:glossaryEntry="a genus of worms"/>
<rdf:Description rdf:about="&a;101436335">
	<b:glossaryEntry>any of numerous relatively small elongated soft-bodied animals especially of the phyla Annelida and Chaetognatha and Nematoda and Nemertea and Platyhelminthes; also many insect larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101436731">
	<b:glossaryEntry>worm that is parasitic on the intestines of vertebrates especially roundworms and tapeworms and flukes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101436962"
	 b:glossaryEntry="a larva of a woodborer"/>
<rdf:Description rdf:about="&a;101437039">
	<b:glossaryEntry>any of various insects or larvae or mollusks that bore into wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101437167">
	<b:glossaryEntry>phylum or class of elongated wormlike parasites that live in the intestines of vertebrates: spiny-headed worms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101437400">
	<b:glossaryEntry>any of various worms living parasitically in intestines of vertebrates having a retractile proboscis covered with many hooked spines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101437633"
	 b:glossaryEntry="arrowworms: a group of small active transparent marine worms"/>
<rdf:Description rdf:about="&a;101437850">
	<b:glossaryEntry>any worm of the Chaetognatha; transparent marine worm with horizontal lateral and caudal fins and a row of movable curved spines at each side of the mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101438111"
	 b:glossaryEntry="chief genus of Chaetognatha including the largest arrowworms"/>
<rdf:Description rdf:about="&a;101438269"
	 b:glossaryEntry="any arrowworm of the genus Sagitta"/>
<rdf:Description rdf:about="&a;101438376">
	<b:glossaryEntry>marine worms resembling the sagittas but with a broader body and only one pair of lateral fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101438550"
	 b:glossaryEntry="flatworms"/>
<rdf:Description rdf:about="&a;101438760"
	 b:glossaryEntry="encysted saclike larva of the tapeworm"/>
<rdf:Description rdf:about="&a;101438876"
	 b:glossaryEntry="parasitic or free-living worms having a flattened body"/>
<rdf:Description rdf:about="&a;101439093"
	 b:glossaryEntry="free-living flatworms"/>
<rdf:Description rdf:about="&a;101439230">
	<b:glossaryEntry>free-swimming mostly freshwater flatworms; popular in laboratory studies for the ability to regenerate lost parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101439429"
	 b:glossaryEntry="flukes"/>
<rdf:Description rdf:about="&a;101439623">
	<b:glossaryEntry>parasitic flatworms having external suckers for attaching to a host</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101439809">
	<b:glossaryEntry>tadpole-shaped parasitic larva of a trematode worm; tail disappears in adult stage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101439965"
	 b:glossaryEntry="a family of Trematoda"/>
<rdf:Description rdf:about="&a;101440103"
	 b:glossaryEntry="a genus of Fasciolidae"/>
<rdf:Description rdf:about="&a;101440235">
	<b:glossaryEntry>flatworm parasitic in liver and bile ducts of domestic animals and humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101440405"
	 b:glossaryEntry="a family of Trematoda"/>
<rdf:Description rdf:about="&a;101440553"
	 b:glossaryEntry="type genus of the family Schistosomatidae: blood flukes"/>
<rdf:Description rdf:about="&a;101440724"
	 b:glossaryEntry="flatworms parasitic in the blood vessels of mammals"/>
<rdf:Description rdf:about="&a;101440866"
	 b:glossaryEntry="tapeworms"/>
<rdf:Description rdf:about="&a;101441021">
	<b:glossaryEntry>ribbon-like flatworms that are parasitic in the intestines of humans and other vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101441231"
	 b:glossaryEntry="a family of Cestoda"/>
<rdf:Description rdf:about="&a;101441382"
	 b:glossaryEntry="tapeworms"/>
<rdf:Description rdf:about="&a;101441494">
	<b:glossaryEntry>tapeworms whose larvae are parasitic in humans and domestic animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101441639"
	 b:glossaryEntry="type genus of the family Taeniidae: tapeworms"/>
<rdf:Description rdf:about="&a;101441781">
	<b:glossaryEntry>tapeworms parasitic in humans which uses the pig as its intermediate host</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101441926"
	 b:glossaryEntry="proboscis worms"/>
<rdf:Description rdf:about="&a;101442083">
	<b:glossaryEntry>soft unsegmented marine worms having a threadlike proboscis and the ability to stretch and contract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101442300"
	 b:glossaryEntry="beard worms"/>
<rdf:Description rdf:about="&a;101442428">
	<b:glossaryEntry>slender animal with tentacles and a tubelike outer covering; lives on the deep ocean bottom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101442610"
	 b:glossaryEntry="a phylum including: rotifers"/>
<rdf:Description rdf:about="&a;101442749">
	<b:glossaryEntry>minute aquatic multicellular organisms having a ciliated wheel-like organ for feeding and locomotion; constituents of freshwater plankton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101442959"
	 b:glossaryEntry="unsegmented worms: roundworms; threadworms; eelworms"/>
<rdf:Description rdf:about="&a;101443351">
	<b:glossaryEntry>one of two subgroups of Nematoda used in some classification systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101443514">
	<b:glossaryEntry>one of two subgroups of Nematoda used in some classification systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101443675">
	<b:glossaryEntry>unsegmented worms with elongated rounded body pointed at both ends; mostly free-living but some are parasitic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101444014"
	 b:glossaryEntry="large roundworms parasitic in intestines of vertebrates"/>
<rdf:Description rdf:about="&a;101444201">
	<b:glossaryEntry>type genus of the family Ascaridae: roundworms with a three-lipped mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101444381"
	 b:glossaryEntry="intestinal parasite of humans and pigs"/>
<rdf:Description rdf:about="&a;101444524"
	 b:glossaryEntry="roundworm having a preanal sucker"/>
<rdf:Description rdf:about="&a;101444669"
	 b:glossaryEntry="intestinal parasite of domestic fowl"/>
<rdf:Description rdf:about="&a;101444806"
	 b:glossaryEntry="pinworms"/>
<rdf:Description rdf:about="&a;101444927"
	 b:glossaryEntry="pinworms"/>
<rdf:Description rdf:about="&a;101445049">
	<b:glossaryEntry>small threadlike worm infesting human intestines and rectum esp. in children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101445237"
	 b:glossaryEntry="any of various small free-living plant-parasitic roundworms"/>
<rdf:Description rdf:about="&a;101445368"
	 b:glossaryEntry="a family of Nematoda"/>
<rdf:Description rdf:about="&a;101445507"
	 b:glossaryEntry="a genus of Cephalobidae"/>
<rdf:Description rdf:about="&a;101445674">
	<b:glossaryEntry>minute eelworm that feeds on organisms that cause fermentation in e.g. vinegar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101445881"
	 b:glossaryEntry="a family of Nematoda"/>
<rdf:Description rdf:about="&a;101446018"
	 b:glossaryEntry="type genus of the family Tylenchidae"/>
<rdf:Description rdf:about="&a;101446166"
	 b:glossaryEntry="small roundworm parasitic on wheat"/>
<rdf:Description rdf:about="&a;101446323"
	 b:glossaryEntry="hookworms"/>
<rdf:Description rdf:about="&a;101446459">
	<b:glossaryEntry>parasitic blood-sucking roundworms having hooked mouth parts to fasten to the intestinal wall of human and other hosts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101446651"
	 b:glossaryEntry="threadlike roundworms"/>
<rdf:Description rdf:about="&a;101446787">
	<b:glossaryEntry>slender threadlike roundworms living in the blood and tissues of vertebrates; transmitted as larvae by biting insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101446977"
	 b:glossaryEntry="greatly elongated roundworm"/>
<rdf:Description rdf:about="&a;101447125"
	 b:glossaryEntry="type genus of the family Dracunculidae"/>
<rdf:Description rdf:about="&a;101447279">
	<b:glossaryEntry>parasitic roundworm of India and Africa that lives beneath the skin of man and other vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101447477"
	 b:glossaryEntry="segmented worms: earthworms; lugworms; leeches"/>
<rdf:Description rdf:about="&a;101447710">
	<b:glossaryEntry>worms with cylindrical bodies segmented both internally and externally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101447957"
	 b:glossaryEntry="a class of Annelida"/>
<rdf:Description rdf:about="&a;101448096">
	<b:glossaryEntry>small primitive marine worm lacking external segmentation and resembling polychaete larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101448264"
	 b:glossaryEntry="earthworms"/>
<rdf:Description rdf:about="&a;101448428">
	<b:glossaryEntry>hermaphroditic terrestrial and aquatic annelids having bristles borne singly along the length of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101448647">
	<b:glossaryEntry>terrestrial worm that burrows into and helps aerate soil; often surfaces when the ground is cool or wet; used as bait by anglers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101448949">
	<b:glossaryEntry>small annelid worms with the posterior end modified into an adhesive sucker; especially formerly regarded as modified leeches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101449203">
	<b:glossaryEntry>type genus of the Branchiobdellidae: a small worm that lives on the gills or surface of a crayfish attached by a sucker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101449425"
	 b:glossaryEntry="marine annelid worms"/>
<rdf:Description rdf:about="&a;101449597">
	<b:glossaryEntry>chiefly marine annelids possessing both sexes and having paired appendages (parapodia) bearing bristles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101449877">
	<b:glossaryEntry>marine worms having a row of tufted gills along each side of the back; often used for fishing bait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101450064">
	<b:glossaryEntry>any of several large worms having a broad flattened body with a mat of coarse hairs covering the back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101450221">
	<b:glossaryEntry>marine burrowing or tube-forming polychete worms usually having long thick bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101450440">
