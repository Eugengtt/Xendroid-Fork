</rdf:Description>
<rdf:Description rdf:about="&a;104638407">
	<b:glossaryEntry>the branch of biology concerned with the development of malformations or serious deviations from the normal type of organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104638588">
	<b:glossaryEntry>the branch of biology that studies microorganisms and their effects on humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104638724">
	<b:glossaryEntry>the branch of biology that studies the structure and activity of macromolecules essential to life (and especially with their genetic role)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104638944">
	<b:glossaryEntry>the organic chemistry of compounds and processes occuring in organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104639091">
	<b:glossaryEntry>the branch of chemistry concerned with fermentation (as in making wine or brewing or distilling)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104639241">
	<b:glossaryEntry>the branch of the biological sciences dealing with the functioning of organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104639395">
	<b:glossaryEntry>the branch of neuroscience that studies the physiology of the nervous system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104639533"
	 b:glossaryEntry="the scientific study of the nervous system"/>
<rdf:Description rdf:about="&a;104639670"
	 b:glossaryEntry="the branch of neuroscience concerned with the brain"/>
<rdf:Description rdf:about="&a;104639781"
	 b:glossaryEntry="the branch of physiology that studies muscles"/>
<rdf:Description rdf:about="&a;104639880">
	<b:glossaryEntry>the branch of biology concerned with the relations between organisms and their environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104640060">
	<b:glossaryEntry>dealing with the geographical distribution of animals and plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104640183">
	<b:glossaryEntry>the branch of biology that conducts comparative studies of the social organization of animals (including human beings) with regard to its evolutionary history</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104640400">
	<b:glossaryEntry>the branch of the natural sciences dealing with the composition of substances and their properties and reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104640732">
	<b:glossaryEntry>the chemistry of compounds containing carbon (originally defined as the chemistry of substances produced by living organisms but now extended to substances synthesized artificially)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104640995">
	<b:glossaryEntry>the chemistry of compounds that do not contain hydrocarbon radicals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104641128">
	<b:glossaryEntry>the branch of chemistry dealing with the physical properties of chemical substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104641276">
	<b:glossaryEntry>branch of chemistry that deals with the chemical action of electricity and the production of electricity by chemical reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104641465"
	 b:glossaryEntry="the chemistry of the earth''s crust"/>
<rdf:Description rdf:about="&a;104641558">
	<b:glossaryEntry>branch of chemistry that deals with the chemical action of light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104641683"
	 b:glossaryEntry="the chemistry of radioactive substances"/>
<rdf:Description rdf:about="&a;104641783"
	 b:glossaryEntry="the science of matter and energy and their interactions"/>
<rdf:Description rdf:about="&a;104642333"
	 b:glossaryEntry="the study of the physical properties of sound"/>
<rdf:Description rdf:about="&a;104642470">
	<b:glossaryEntry>the branch of physics that studies celestial bodies and the universe as a whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104642725">
	<b:glossaryEntry>the branch of astronomy that studies the motion of natural and artificial bodies in space</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104642874">
	<b:glossaryEntry>the branch of astronomy that deals with the measurement of the position and motion of celestial bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104643033">
	<b:glossaryEntry>the branch of astronomy that detects and studies the radio waves emitted by celestial bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104643187"
	 b:glossaryEntry="the theory and practice of navigation through air or space"/>
<rdf:Description rdf:about="&a;104643336">
	<b:glossaryEntry>science and technology of electronic systems and devices for aeronautics and astronautics: "avionics has become even more important with the development of the space program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104643565"
	 b:glossaryEntry="physics as applied to biological problems"/>
<rdf:Description rdf:about="&a;104643664">
	<b:glossaryEntry>the branch of astronomy concerned with the application of Newton''s laws of motion to the motions of heavenly bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104643845">
	<b:glossaryEntry>the branch of astronomy concerned with the physical and chemical properties of celestial bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104644017"
	 b:glossaryEntry="the branch of astronomy that deals with the sun"/>
<rdf:Description rdf:about="&a;104644124">
	<b:glossaryEntry>the branch of astrophysics that studies the origins and structure of the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104644273">
	<b:glossaryEntry>the branch of physics that studies the phenomena that occur at very low temperatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104644425">
	<b:glossaryEntry>the branch of science that studies the formation and structure of crystals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104644561">
	<b:glossaryEntry>the branch of physics concerned with electromagnetic phenomena</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104644705">
	<b:glossaryEntry>the branch of physics that deals with the emission and effects of electrons and with the use of electronic devices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104644931">
	<b:glossaryEntry>the branch of physics concerned with the motion of bodies in a frame of reference</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104645194">
	<b:glossaryEntry>the branch of physics that studies the internal structure of atomic nuclei</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104645366"
	 b:glossaryEntry="the study of the physical properties of light"/>
<rdf:Description rdf:about="&a;104645500"
	 b:glossaryEntry="branch of optics dealing with formation of images by mirrors"/>
<rdf:Description rdf:about="&a;104645617">
	<b:glossaryEntry>the branch of optics that deals with the use of coherent light from a laser in order to make a hologram that can then be used to create a three-dimensional image</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104645835">
	<b:glossaryEntry>the branch of physics that studies subatomic particles and their interactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104645997">
	<b:glossaryEntry>the branch of physics concerned with matter in its plasma phase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104646121">
	<b:glossaryEntry>the branch of physics that studies the deformation and flow of matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104646245"
	 b:glossaryEntry="a theory in which matter consists of atoms"/>
<rdf:Description rdf:about="&a;104646366"
	 b:glossaryEntry="a theory of the structure of the atom"/>
<rdf:Description rdf:about="&a;104646500">
	<b:glossaryEntry>a theory of atomic structure that assumes an electron orbiting a nucleus can only be at certain energy levels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104646668">
	<b:glossaryEntry>(physics) the maintenance of a certain quantities unchanged during chemical reactions or physical transformations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104646949">
	<b:glossaryEntry>the principle that the total electric charge of a system remains constant despite changes inside the system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104647155">
	<b:glossaryEntry>the fundamental principle of physics that the total energy of an isolated system is constant despite internal changes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104647373">
	<b:glossaryEntry>a fundamental principle of classical physics that matter cannot be created or destroyed in an isolated system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104647636">
	<b:glossaryEntry>the principle that the total linear momentum in a closed system is constant and is not affected by processes occurring inside the system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104647843">
	<b:glossaryEntry>parity is conserved in a universe in which the laws of physics are the same in a right-handed system of coordinates as in a left-handed system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104648109"
	 b:glossaryEntry="the theory that light is transmitted as waves"/>
<rdf:Description rdf:about="&a;104648269">
	<b:glossaryEntry>the theory that light is transmitted as a stream of particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104648432">
	<b:glossaryEntry>a theory that gases consist of small particles in random movement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104648621">
	<b:glossaryEntry>(physics) the theory that space and time are relative concepts rather than absolute concepts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104648868"
	 b:glossaryEntry="a generalization of special relativity to include gravity"/>
<rdf:Description rdf:about="&a;104649049">
	<b:glossaryEntry>a physical theory of relativity based on the assumption that the speed of light in a vacuum is a constant and the assumption that the laws of physics are invariant in all inertial systems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104649360">
	<b:glossaryEntry>a theory that tries to link the four fundamental forces; "according to supersymmetry each force emerged separately during the big bang"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104649555">
	<b:glossaryEntry>a physical theory that certain properties occur only in discrete amounts (quanta)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104649735">
	<b:glossaryEntry>the modern form of quantum theory; an extension of of quantum mechanics based on Schrodinger''s equation; atomic events are explained as interactions between particle waves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104649967">
	<b:glossaryEntry>the theory that it is impossible to measure both energy and time (or position and momentum) completely accurately at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104650210">
	<b:glossaryEntry>a theory that the temperature of a body increases when kinetic energy increases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104650358">
	<b:glossaryEntry>the theory that all contagious diseases are caused by microorganisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104650503">
	<b:glossaryEntry>a statistical theory dealing with the limits and efficiency of information processing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104650691">
	<b:glossaryEntry>a scientific theory of the origin of species of plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104650889">
	<b:glossaryEntry>a theory of how characteristics of one generation are derived from earlier generations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104651061"
	 b:glossaryEntry="the theory of inheritance based on Mendel''s laws"/>
<rdf:Description rdf:about="&a;104651180">
	<b:glossaryEntry>a theory of organic evolution claiming that new species arise and are perpetuated by natural selection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104651356">
	<b:glossaryEntry>a modern Darwinian theory that explains new species in terms of genetic mutations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104651497">
	<b:glossaryEntry>a theory of organic evolution claiming that acquired characteristics are transmitted to offspring</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104651669">
	<b:glossaryEntry>a modern Lamarckian theory emphasizing the importance of environmental factors in genetic changes and retaining the notion of the inheritance of acquired characters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104651894"
	 b:glossaryEntry="the study of musical sound"/>
<rdf:Description rdf:about="&a;104651976"
	 b:glossaryEntry="the branch of mechanics based on Newton''s laws of motion"/>
<rdf:Description rdf:about="&a;104652120">
	<b:glossaryEntry>the branch of physics that studies the properties of materials in the solid state: electrical conduction in crystals of semiconductors and metals; superconductivity; photoconductivity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104652369">
	<b:glossaryEntry>the branch of physics that makes theoretical predictions about the behavior of macroscopic systems on the basis of statistical laws governing its component particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104652620">
	<b:glossaryEntry>an extension of statistical mechanics based on quantum theory (especially the Pauli exclusion principle); applies to the behavior of atoms and particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104652854"
	 b:glossaryEntry="study of the mechanics of fluids"/>
<rdf:Description rdf:about="&a;104652997">
	<b:glossaryEntry>the branch of mechanics that deals with the mechanical properties of gases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104653128"
	 b:glossaryEntry="the branch of mechanics concerned with forces in equilibrium"/>
<rdf:Description rdf:about="&a;104653242">
	<b:glossaryEntry>study of the mechanical properties of fluids that are not in motion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104653368">
	<b:glossaryEntry>the branch of mechanics concerned with the forces that cause motions of bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104653530">
	<b:glossaryEntry>the branch of mechanics concerned with motion without reference to force or mass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104653667"
	 b:glossaryEntry="study of fluids in motion"/>
<rdf:Description rdf:about="&a;104653786">
	<b:glossaryEntry>the study of the interaction of magnetic fields and electrically conducting fluids (as plasma or molten metal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104653963"
	 b:glossaryEntry="the science of flight dynamics"/>
<rdf:Description rdf:about="&a;104654050">
	<b:glossaryEntry>the branch of mechanics that deals with the motion of gases (especially air) and their effects on bodies in the flow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104654241">
	<b:glossaryEntry>the branch of physics concerned with the conversion of different forms of energy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104654400">
	<b:glossaryEntry>the aspect of thermodynamics concerned with thermal equilibrium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104654555">
	<b:glossaryEntry>the branch of electronics that deals with beams of electrons and their focusing and deflection by magnetic fields</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104654730">
	<b:glossaryEntry>the branch of electronics that deals with miniature components</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104654855">
	<b:glossaryEntry>the branch of electronics dealing with thermionic phenomena (especially thermionic vacuum tubes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104655009"
	 b:glossaryEntry="any of the sciences that deal with the earth or its parts"/>
<rdf:Description rdf:about="&a;104655198">
	<b:glossaryEntry>a science that deals with the history of the earth as recorded in rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104655413">
	<b:glossaryEntry>the study of geologic features once at the surface of the earth but now buried beneath rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104655580">
	<b:glossaryEntry>geology that uses physical principles to study properties of the earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104655855">
	<b:glossaryEntry>the branch of geology that studies the characteristics and configuration and evolution of rocks and land forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104656074">
	<b:glossaryEntry>the branch of geology studying the folding and faulting of the earth''s crust</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104656224">
	<b:glossaryEntry>science dealing with phenomena of the atmosphere; especially weather processes and weather forecasting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104656420"
	 b:glossaryEntry="meteorology of climates and their phenomena"/>
<rdf:Description rdf:about="&a;104656539"
	 b:glossaryEntry="the study of effects of climate on living organisms"/>
<rdf:Description rdf:about="&a;104656651">
	<b:glossaryEntry>meteorology of the total extent of the atmosphere; especially the upper layers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104656784">
	<b:glossaryEntry>the branch of geology that studies water on the earth and in the atmosphere: its distribution and uses and conservation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104656959">
	<b:glossaryEntry>the branch of science dealing with physical and biological aspects of the oceans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104657116">
	<b:glossaryEntry>the science of the measurement and description and mapping of the surface waters of the earth with special reference to navigation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104657304">
	<b:glossaryEntry>the scientific study of bodies of fresh water for their biological and physical and geological properties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104657465"
	 b:glossaryEntry="the branch of geology that studies earthquakes"/>
<rdf:Description rdf:about="&a;104657568"
	 b:glossaryEntry="the branch of geology that studies volcanoes"/>
<rdf:Description rdf:about="&a;104657684"
	 b:glossaryEntry="the branch of science that studies magnetism"/>
<rdf:Description rdf:about="&a;104657796">
	<b:glossaryEntry>the branch of geology that studies the shape of the earth and the determination of the exact position of geographical points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104657974">
	<b:glossaryEntry>the branch of geology that studies minerals: their structure and properties and the ways of distinguishing them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104658142">
	<b:glossaryEntry>the branch of geology that studies rocks: their origin and formation and composition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104658282"
	 b:glossaryEntry="the scientific study of caves"/>
<rdf:Description rdf:about="&a;104658382">
	<b:glossaryEntry>the branch of economic geology that deals with the occurrence and exploitation of oil and gas fields</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104658546">
	<b:glossaryEntry>the branch of geology that deals with economically valuable geological materials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104658725">
	<b:glossaryEntry>the branch of economic geology that deals with the applications of geology to mining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104658870">
	<b:glossaryEntry>study of the earth''s surface; includes people''s responses to topography and climate and soil and vegetation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104659101"
	 b:glossaryEntry="the study of physical features of the earth''s surface"/>
<rdf:Description rdf:about="&a;104659234"
	 b:glossaryEntry="precise detailed study of the surface features of a region"/>
<rdf:Description rdf:about="&a;104659349">
	<b:glossaryEntry>the branch of geography concerned with the production and distribution of commodities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104659499">
	<b:glossaryEntry>the science that maps the general features of the universe; describes both heaven and earth (but without encroaching on geography or astronomy)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104659700">
	<b:glossaryEntry>the discipline dealing with the principles of design and construction and ornamentation of fine buildings; "architecture and eloquence are mixed arts whose end is sometimes beauty and sometimes use"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104660030"
	 b:glossaryEntry="the science of architecture"/>
<rdf:Description rdf:about="&a;104660149">
	<b:glossaryEntry>the branch of architecture dealing with the arrangement of land and buildings for human use and enjoyment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104660323">
	<b:glossaryEntry>the branch of architecture dealing with the design and organization of urban space and activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104660481">
	<b:glossaryEntry>the branch of architecture dealing with the selection and organization of furnishings for an architectural interior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104660658">
	<b:glossaryEntry>the discipline dealing with the art or science of applying scientific knowledge to practical problems; "he had trouble deciding which branch of engineering to study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104661150"
	 b:glossaryEntry="the science and technology of metals"/>
<rdf:Description rdf:about="&a;104661261">
	<b:glossaryEntry>the metallurgy of powdered metals; how to produce solid metal objects from powdered metal by compaction and sintering</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104661442">
	<b:glossaryEntry>the branch of engineering science concerned with the design and construction of aircraft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104661601">
	<b:glossaryEntry>application of biological principals to the study and design of engineering systems (especially electronic systems)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104661770">
	<b:glossaryEntry>the branch of engineering science in which biological science is used to study the relation between workers and their environments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104661990">
	<b:glossaryEntry>the branch of molecular biology that studies the use of microorganisms to perform specific industrial processes; "biotechnology produced genetically altered bacteria that solved the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104662276">
	<b:glossaryEntry>the branch of biotechnology that uses biological process to overcome environmental problems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104662428">
	<b:glossaryEntry>the technology of preparing recombinant DNA in vitro by cutting up DNA molecules and splicing together fragments from more than one organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104662679">
	<b:glossaryEntry>the branch of engineering that is concerned with the design and construction and operation of the plants and machinery used in industrial chemical processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104662902">
	<b:glossaryEntry>the branch of engineering concerned with the design and construction of such public works as dams or bridges</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104663074">
	<b:glossaryEntry>the branch of engineering science that studies the uses of electricity and the equipment for power generation and distribution and the control of machines and communication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104663338">
	<b:glossaryEntry>(often plural) the branch of electrical engineering concerned with the technology of electronic communication at a distance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104663525">
	<b:glossaryEntry>the branch of engineering science that studies (with the aid of computers) computable processes and structures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104663754">
	<b:glossaryEntry>the branch of computer science that deal with writing computer programs that can solve problems creatively; "workers in AI hope to imitate or duplicate intelligence in computers and robots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104664054">
	<b:glossaryEntry>the use of computers to translate from one language to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104664182"
	 b:glossaryEntry="the area of AI concerned with the practical use of robots"/>
<rdf:Description rdf:about="&a;104664330">
	<b:glossaryEntry>the construction of robots to look like animals (developed for Disneyland)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104664463">
	<b:glossaryEntry>the area of robotics that is concerned with the control of robots from a distance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104664603">
	<b:glossaryEntry>the branch of engineering that deals with the construction of buildings (as distinguished from architecture as a design art)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104664799">
	<b:glossaryEntry>the branch of engineering that deals with the design and construction and operation of machinery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104664982">
	<b:glossaryEntry>the branch of engineering that deals with the interaction of surfaces in relative motion (as in bearings or gears): their design and friction and wear and lubrication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104665204">
	<b:glossaryEntry>the branch of engineering concerned with the design and construction and operation of nuclear reactors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104665372">
	<b:glossaryEntry>the branch of engineering that deals with the design and construction and operation of ships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104665528">
	<b:glossaryEntry>the branch of engineering science that studies rocket design and operation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104665657"
	 b:glossaryEntry="the science of mental life"/>
<rdf:Description rdf:about="&a;104665998">
	<b:glossaryEntry>theory that association is the basic principle of mental activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104666124">
	<b:glossaryEntry>the branch of psychology that studies measurable differences between individuals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104666274">
	<b:glossaryEntry>the branch of psychology that uses experimental methods to study psychological issues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104666462">
	<b:glossaryEntry>the branch of psychology concerned with quantitative relations between physical stimuli and their psychological effects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104666641">
	<b:glossaryEntry>an approach to psychology that emphasizes observable measurable behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104666841">
	<b:glossaryEntry>a psychology based on the assumption that all mental process are useful to an organism in adapting to the environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104667018">
	<b:glossaryEntry>an approach to psychology that emphasizes internal mental processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104667225">
	<b:glossaryEntry>the area of cognitive psychology that studies memory processes; "he taught a graduate course on learning and memory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104667394">
	<b:glossaryEntry>the area of cognitive psychology that studies the processes involved in solving problems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104667544">
	<b:glossaryEntry>the branch of cognitive psychology that studies the psychological basis of linguistic competence and performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104667720">
	<b:glossaryEntry>any of several branches of psychology that seek to apply psychological principles to practical problems of education or industry or marketing etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104667955">
	<b:glossaryEntry>any branch of psychology concerned with psychological measurements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104668112">
	<b:glossaryEntry>the branch of psychology that studies the social and mental development of children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104668306">
	<b:glossaryEntry>the branch of psychology concerned with the behavior of animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104668458">
	<b:glossaryEntry>the branch of psychology that is concerned with the physiological bases of psychological processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104668664">
	<b:glossaryEntry>an approach to psychology that emphasizes the importance of configurational properties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104668834">
	<b:glossaryEntry>the branch of psychology that studies persons and their relationships with others and with groups and with society as a whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104669041">
	<b:glossaryEntry>the branch of social psychology that studies the dynamics of interaction in social groups</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104669191">
	<b:glossaryEntry>the sciences concerned with gathering and manipulating and storing and retrieving and classifying recorded information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104669412">
	<b:glossaryEntry>the field of science concerned with processes of communication and control (especially the comparison of these processes in biological and artificial systems)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104669628">
	<b:glossaryEntry>the field of science concerned with cognition; includes parts of cognitive psychology and linguistics and computer science and neuroscience and philosophy of mind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104669892">
	<b:glossaryEntry>the branch of science that studies society and the relationships of individual within a society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104670174"
	 b:glossaryEntry="the social science of municipal affairs"/>
<rdf:Description rdf:about="&a;104670266">
	<b:glossaryEntry>the social science that studies the origins and social relationships of human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104670536">
	<b:glossaryEntry>the branch of anthropology that studies prehistoric people and their cultures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104670918"
	 b:glossaryEntry="archeology of the ancient Assyrians"/>
<rdf:Description rdf:about="&a;104671011"
	 b:glossaryEntry="archeology of ancient Egyptian artifacts"/>
<rdf:Description rdf:about="&a;104671108"
	 b:glossaryEntry="the archeology of ancient Sumerians"/>
<rdf:Description rdf:about="&a;104671200"
	 b:glossaryEntry="the paleontology of microfossils"/>
<rdf:Description rdf:about="&a;104671296"
	 b:glossaryEntry="the archeology of underwater sites"/>
<rdf:Description rdf:about="&a;104671464"
	 b:glossaryEntry="the study of the climate of past ages"/>
<rdf:Description rdf:about="&a;104671584">
	<b:glossaryEntry>the study of the geography of ancient times or ancient epochs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104671724">
	<b:glossaryEntry>the study of ancient forms of writing (and the deciphering of them)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104671867">
	<b:glossaryEntry>the study of disease of former times (as inferred from fossil evidence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104672035">
	<b:glossaryEntry>the explanation of past events in terms of scientific causes (as geological causes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104672191"
	 b:glossaryEntry="the study of ancient inscriptions"/>
<rdf:Description rdf:about="&a;104672280"
	 b:glossaryEntry="the study of (especially prehistoric) antiquities"/>
<rdf:Description rdf:about="&a;104672398"
	 b:glossaryEntry="the study humans prior to the invention of writing"/>
<rdf:Description rdf:about="&a;104672545"
	 b:glossaryEntry="the study of prehistoric human artifacts and human fossils"/>
<rdf:Description rdf:about="&a;104672684">
	<b:glossaryEntry>the branch of anthropology that provides scientific description of individual human societies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104672862"
	 b:glossaryEntry="the ethnography of paleolithic humans"/>
<rdf:Description rdf:about="&a;104672982">
	<b:glossaryEntry>the branch of anthropology that deals with the division of humankind into races and with their origins and distribution and distinctive characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104673189">
	<b:glossaryEntry>the branch of anthropology dealing with the genesis and variation of human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104673338">
	<b:glossaryEntry>the branch of anthropology that deals with human culture and society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104673550"
	 b:glossaryEntry="the study of a society by analyzing its garbage"/>
<rdf:Description rdf:about="&a;104673653"
	 b:glossaryEntry="the study of myths"/>
<rdf:Description rdf:about="&a;104673727"
	 b:glossaryEntry="the study of religious or magical rites and ceremonies"/>
<rdf:Description rdf:about="&a;104673837"
	 b:glossaryEntry="the study of government of states and other political units"/>
<rdf:Description rdf:about="&a;104674002">
	<b:glossaryEntry>the study of the effects of economic geography on the powers of the state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104674133"
	 b:glossaryEntry="the opinion you hold with respect to political questions"/>
<rdf:Description rdf:about="&a;104674267"
	 b:glossaryEntry="theory and practice of homemaking"/>
<rdf:Description rdf:about="&a;104674380">
	<b:glossaryEntry>the branch of social science that deals with the production and distribution and consumption of goods and services and their management</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104674702">
	<b:glossaryEntry>a theory of competition stated in terms of gains and losses among opposing players</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104674879">
	<b:glossaryEntry>the application of mathematics and statistics to the study of economic and financial data</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104675027">
	<b:glossaryEntry>the branch of economics that studies the management of money and other assets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104675158">
	<b:glossaryEntry>the school of economic theory that stresses the costs of production as a means of stimulating the economy; advocates policies that raise capital and labor output by increasing the incentive to produce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104675426">
	<b:glossaryEntry>the study of spatial distances between individuals in different cultures and situations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104675569"
	 b:glossaryEntry="the study and classification of human societies"/>
<rdf:Description rdf:about="&a;104675763">
	<b:glossaryEntry>the scientific study of crime and criminal behavior and law enforcement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104675910">
	<b:glossaryEntry>the branch of sociology that studies the characteristics of human populations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104676060">
	<b:glossaryEntry>the branch of sociology that studies election trends (as by opinion polls)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104676191">
	<b:glossaryEntry>the branch of criminology concerned with prison management and prisoner rehabilitation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104676344"
	 b:glossaryEntry="the quantitative study of social relationships"/>
<rdf:Description rdf:about="&a;104676447"
	 b:glossaryEntry="the science or art of strategy"/>
<rdf:Description rdf:about="&a;104676534"
	 b:glossaryEntry="the science of systematic classification"/>
<rdf:Description rdf:about="&a;104676668">
	<b:glossaryEntry>use of data (e.g. cytogenetic or biochemical) to assess taxonomic relations especially within an evolutionary framework</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104676863">
	<b:glossaryEntry>(biology) study of the general principles of scientific classification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104677006">
	<b:glossaryEntry>a system of biological taxonomy based on the quantitative analysis of comparative data and used to reconstruct trees summarizing the (assumed) phylogenetic relations and evolutionary history of groups of organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104677276">
	<b:glossaryEntry>studies intended to provide general knowledge and intellectual skills (rather than occupational or professional skills); "the college of arts and sciences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104677732"
	 b:glossaryEntry="the principles of classical literature and art"/>
<rdf:Description rdf:about="&a;104677871"
	 b:glossaryEntry="the principles of romantic literature and art"/>
<rdf:Description rdf:about="&a;104677992">
	<b:glossaryEntry>the discipline that studies the English language and literature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104678109">
	<b:glossaryEntry>the discipline that records and interprets past events involving human beings: "he teaches Medieval history"; "history takes the long view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104678302">
	<b:glossaryEntry>the determination of the actual temporal sequence of past events</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104678441">
	<b:glossaryEntry>the determination of how long ago different languages evolved from a common source language; "he mapped the glottochronology of the Romance languages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104678654">
	<b:glossaryEntry>all that is remembered of the past as preserved in writing; a body of knowledge: "the dawn of recorded history"; "from the beginning of history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104678852"
	 b:glossaryEntry="the study and creation of works of art"/>
<rdf:Description rdf:about="&a;104678959">
	<b:glossaryEntry>the rational investigation of questions about existence and knowledge and ethics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104679276"
	 b:glossaryEntry="the philosophical study of moral values and rules"/>
<rdf:Description rdf:about="&a;104679451">
	<b:glossaryEntry>moral philosophy based on the application of general ethical principles to resolve moral dilemmas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104679622">
	<b:glossaryEntry>argumentation that is specious or excessively subtle and intended to be misleading</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104679760">
	<b:glossaryEntry>an ethical system that evaluates actions by reference to personal well-being through a life based on reason</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104679938">
	<b:glossaryEntry>an ethical system that evaluates the pursuit of pleasure as the highest good</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104680069">
	<b:glossaryEntry>a Roman Catholic system of casuistry that when expert opinions differ an actor can follow any solidly probable opinion that he wishes even though some different opinion might be more probable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104680318"
	 b:glossaryEntry="the philosophical study of causation"/>
<rdf:Description rdf:about="&a;104680421"
	 b:glossaryEntry="the branch of philosophy dealing with beauty and taste"/>
<rdf:Description rdf:about="&a;104680544"
	 b:glossaryEntry="the study of values and value judgments"/>
<rdf:Description rdf:about="&a;104680638"
	 b:glossaryEntry="the branch of philosophy concerned with the law"/>
<rdf:Description rdf:about="&a;104680770"
	 b:glossaryEntry="the philosophical study of being and knowing"/>
<rdf:Description rdf:about="&a;104680908"
	 b:glossaryEntry="the metaphysical study of the nature of being and existence"/>
<rdf:Description rdf:about="&a;104681022">
	<b:glossaryEntry>the metaphysical study of the origin and nature of the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104681141">
	<b:glossaryEntry>a rationale for dialectical materialism based on change through the conflict of opposing forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104681293">
	<b:glossaryEntry>any formal system of reasoning that arrives at the truth by the exchange of logical arguments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104681442"
	 b:glossaryEntry="the branch of philosophy that analyzes inference"/>
<rdf:Description rdf:about="&a;104681560">
	<b:glossaryEntry>any logical system that abstracts the form of statements away from their content in order to establish abstract criteria of consistency and validity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104681895">
	<b:glossaryEntry>a system of symbolic logic devised by George Boole; used in computers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104682042">
	<b:glossaryEntry>a branch of symbolic logic dealing with propositions as units and with their combinations and the connectives that relate them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104682259">
	<b:glossaryEntry>a system of symbolic logic that represents individuals and predicates and quantification over individuals (as well as the relations between propositions)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104682518">
	<b:glossaryEntry>a limitation imposed on the variables of a proposition (as by the quantifiers `some'' or `all'' or `no'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104682700">
	<b:glossaryEntry>a system of logic whose formal properties resemble certain moral and epistemological concepts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104682923"
	 b:glossaryEntry="the modal logic of necessity and possibility and contingency"/>
<rdf:Description rdf:about="&a;104683043"
	 b:glossaryEntry="the modal logic of obligation and permissibility"/>
<rdf:Description rdf:about="&a;104683151"
	 b:glossaryEntry="the modal logic of knowledge and uncertainty and ignorance"/>
<rdf:Description rdf:about="&a;104683271"
	 b:glossaryEntry="the modal logic of belief and disbelief"/>
<rdf:Description rdf:about="&a;104683371">
	<b:glossaryEntry>a form of mathematical logic in which truth can assume a continuum of values between 0 and 1</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104683521"
	 b:glossaryEntry="the logical study of necessity and possibility"/>
<rdf:Description rdf:about="&a;104683625"
	 b:glossaryEntry="the philosophical theory of knowledge"/>
<rdf:Description rdf:about="&a;104683739">
	<b:glossaryEntry>the branch of philosophy that analyzes the principles and procedures of inquiry in a particular discipline</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104683929"
	 b:glossaryEntry="a doctrine accepted by adherents to a philosophy"/>
<rdf:Description rdf:about="&a;104684681">
	<b:glossaryEntry>a sociological theory based on the premise that society comes before individuals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104684840">
	<b:glossaryEntry>an anthropological theory that there are unobservable social structures that generate observable social phenomena</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104685032">
	<b:glossaryEntry>linguistics defined as the analysis of formal structures in a text or discourse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104685171"
	 b:glossaryEntry="the humanistic study of literature"/>
<rdf:Description rdf:about="&a;104685374">
	<b:glossaryEntry>the humanistic study of a body of literature; "he took a course in French literature"</b:glossaryEntry>
</rdf:Description>
