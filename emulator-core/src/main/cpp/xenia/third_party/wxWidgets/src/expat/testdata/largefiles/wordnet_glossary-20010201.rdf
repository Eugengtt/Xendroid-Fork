	 b:glossaryEntry="the foot of a bird"/>
<rdf:Description rdf:about="&a;101662577"
	 b:glossaryEntry="a foot having the toes connected by folds of skin"/>
<rdf:Description rdf:about="&a;101662699"
	 b:glossaryEntry="a bird''s foot that has claws"/>
<rdf:Description rdf:about="&a;101662778">
	<b:glossaryEntry>having the the first and fourth toes of each foot directed backward and the second and third forward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101662958">
	<b:glossaryEntry>having the first and second toes of each foot directed backward and the third and fourth forward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101663136"
	 b:glossaryEntry="a bird''s foot with folds of skin between the toes"/>
<rdf:Description rdf:about="&a;101663243">
	<b:glossaryEntry>a foot having separate toes each with membranous flaps along the sides</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101663371">
	<b:glossaryEntry>a small cup-shaped structure (as a taste bud or optic cup or cavity of a coral containing a polyp)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101663565">
	<b:glossaryEntry>(embryology) a two-walled cuplike depression that develops into the pigmented and sensory layers of the retina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101663740">
