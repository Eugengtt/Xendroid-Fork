	<b:glossaryEntry>large edible marine fish of northern coastal waters; related to cod</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102018308"
	 b:glossaryEntry="grenadiers"/>
<rdf:Description rdf:about="&a;102018468">
	<b:glossaryEntry>deep-sea fish with a large head and body and long tapering tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102018631">
	<b:glossaryEntry>elongate fishes with pelvic fins and girdle absent or reduced</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102018886">
