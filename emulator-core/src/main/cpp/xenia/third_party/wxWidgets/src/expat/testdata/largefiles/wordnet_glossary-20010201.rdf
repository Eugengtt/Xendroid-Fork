</rdf:Description>
<rdf:Description rdf:about="&a;201585512"
	 b:glossaryEntry="reduce the price of"/>
<rdf:Description rdf:about="&a;201585634"
	 b:glossaryEntry="give a rebate"/>
<rdf:Description rdf:about="&a;201585711">
	<b:glossaryEntry>demand payment; "Will I get charged for this service?" "We were billed for 4 nights in the hotel, although e stayed only 3 nights"</b:glossaryEntry>
</rdf:Description>
