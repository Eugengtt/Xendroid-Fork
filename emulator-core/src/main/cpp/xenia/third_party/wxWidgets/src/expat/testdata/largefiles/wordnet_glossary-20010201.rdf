	 b:glossaryEntry="the pelt of a leopard"/>
<rdf:Description rdf:about="&a;110585935"
	 b:glossaryEntry="the expensive fur of a mink"/>
<rdf:Description rdf:about="&a;110586013"
	 b:glossaryEntry="the brown fur of a muskrat"/>
