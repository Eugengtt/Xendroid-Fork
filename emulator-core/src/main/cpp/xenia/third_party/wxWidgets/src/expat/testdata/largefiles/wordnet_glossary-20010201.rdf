<rdf:Description rdf:about="&a;100586357"
	 b:glossaryEntry="the construction of ships"/>
<rdf:Description rdf:about="&a;100586441">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act or process of producing something; "Shakespeare''s production of poetry was enormous"; "the production of white blood cells"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100586701">
