<rdf:Description rdf:about="&a;108918394">
	<b:glossaryEntry>used in some classifications: essentially equivalent to Potamogetonaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108918582">
	<b:glossaryEntry>(or in some classifications family Zosteraceae) small genus of widely distributed marine plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108918785">
