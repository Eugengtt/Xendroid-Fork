</rdf:Description>
<rdf:Description rdf:about="&a;101116516"
	 b:glossaryEntry="swallows and martins"/>
<rdf:Description rdf:about="&a;101116731">
	<b:glossaryEntry>small long-winged songbird noted for swift graceful flight and the regularity of its migrations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101116970"
	 b:glossaryEntry="type genus of the Hirundinidae"/>
<rdf:Description rdf:about="&a;101117146">
	<b:glossaryEntry>common swallow of North America and Europe that nests in barns etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101117327">
	<b:glossaryEntry>North American swallow that lives in colonies and builds bottle-shaped mud nests on cliffs and walls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101117527"
	 b:glossaryEntry="of Australia and Polynesia; nests in tree cavities"/>
<rdf:Description rdf:about="&a;101117689"
	 b:glossaryEntry="a genus of Hirundinidae"/>
<rdf:Description rdf:about="&a;101117809">
	<b:glossaryEntry>bluish-green-and-white North American swallow; nests in tree cavities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101117983">
	<b:glossaryEntry>any of various swallows with squarish or slightly forked tail and long pointed wings; migrate around Martinmas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101118200"
	 b:glossaryEntry="a genus of Hirundinidae"/>
<rdf:Description rdf:about="&a;101118333">
	<b:glossaryEntry>common small European martin that builds nests under the eaves of houses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101118501"
	 b:glossaryEntry="a genus of Hirundinidae"/>
<rdf:Description rdf:about="&a;101118632">
	<b:glossaryEntry>swallow of the northern hemisphere that nests in tunnels dug in clay or sand banks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101118838"
	 b:glossaryEntry="a genus of Hirundinidae"/>
<rdf:Description rdf:about="&a;101118967"
	 b:glossaryEntry="large North American martin of which the male is blue-black"/>
<rdf:Description rdf:about="&a;101119120"
	 b:glossaryEntry="wood swallows"/>
<rdf:Description rdf:about="&a;101119246"
	 b:glossaryEntry="type genus of the Artamidae"/>
<rdf:Description rdf:about="&a;101119381">
