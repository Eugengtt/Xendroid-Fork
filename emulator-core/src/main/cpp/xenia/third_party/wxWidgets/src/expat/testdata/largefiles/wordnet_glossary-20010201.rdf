<rdf:Description rdf:about="&a;201345256"
	 b:glossaryEntry="take and lift upward"/>
<rdf:Description rdf:about="&a;201345387"
	 b:glossaryEntry='dip into a liquid: "He dipped into the pool"'/>
<rdf:Description rdf:about="&a;201345515"
	 b:glossaryEntry="dip a foot or hand briefly into a liquid"/>
<rdf:Description rdf:about="&a;201345619"
	 b:glossaryEntry="fall down, as if collapsing"/>
<rdf:Description rdf:about="&a;201345745"
	 b:glossaryEntry="turn over and fall"/>
<rdf:Description rdf:about="&a;201345838">
	<b:glossaryEntry>to fall vertically: "the bombs are dropping on enemy targets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201346059"
	 b:glossaryEntry='fall abruptly; "It plunged to the bottom of the well"'/>
<rdf:Description rdf:about="&a;201346191"
	 b:glossaryEntry="drop with the sound of something falling into water"/>
<rdf:Description rdf:about="&a;201346328"
	 b:glossaryEntry="fall vertically and sharply"/>
<rdf:Description rdf:about="&a;201346440">
	<b:glossaryEntry>flow, run, or fall out, over, or off and become wasted or lost; "The wine spilled onto the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201346645"
	 b:glossaryEntry="drop something with a plopping sound"/>
<rdf:Description rdf:about="&a;201346751"
	 b:glossaryEntry="drop in a heap or mass"/>
<rdf:Description rdf:about="&a;201346835">
	<b:glossaryEntry xml:space='preserve'><![CDATA[let fall to the ground; "Don''t drop the dishes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201347042">
	<b:glossaryEntry xml:space='preserve'><![CDATA[let drop or droop; "Hang one''s head in shame"]]></b:glossaryEntry>
