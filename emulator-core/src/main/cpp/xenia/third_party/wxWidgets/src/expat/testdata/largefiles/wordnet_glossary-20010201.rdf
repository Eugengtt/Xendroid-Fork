</rdf:Description>
<rdf:Description rdf:about="&a;108919000">
	<b:glossaryEntry>in some classifications this category does not include Leguminosae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108919364">
