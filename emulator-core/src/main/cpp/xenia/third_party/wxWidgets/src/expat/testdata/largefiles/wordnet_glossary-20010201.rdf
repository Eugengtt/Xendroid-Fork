</rdf:Description>
<rdf:Description rdf:about="&a;109003738"
	 b:glossaryEntry="South American wood sorrel cultivated for its edible tubers"/>
<rdf:Description rdf:about="&a;109003888">
	<b:glossaryEntry>trees native to East Indies having pinnate leaves: carambolas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109004040"
	 b:glossaryEntry="East Indian tree bearing deeply ridged yellow-brown fruit"/>
<rdf:Description rdf:about="&a;109004210"
	 b:glossaryEntry="East Indian evergreen tree bearing very acid fruit"/>
<rdf:Description rdf:about="&a;109004333">
