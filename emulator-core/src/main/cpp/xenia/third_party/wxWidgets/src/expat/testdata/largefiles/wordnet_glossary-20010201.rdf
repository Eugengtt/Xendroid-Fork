	<b:glossaryEntry>a customs document listing the contents put on a ship or plane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104880008"
	 b:glossaryEntry="a last-in first-out kind of queue (LIFO)"/>
<rdf:Description rdf:about="&a;104880110">
