<rdf:Description rdf:about="&a;109868379"
	 b:glossaryEntry="a unit of pain intensity"/>
<rdf:Description rdf:about="&a;109868453">
	<b:glossaryEntry>a unit of pressure: the pressure that will support a column of mercury 760 mm high at sea level and 0 degrees centigrade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109868636"
	 b:glossaryEntry="a unit of pressure equal to one newton per square meter"/>
<rdf:Description rdf:about="&a;109868749">
	<b:glossaryEntry>a unit of pressure equal to 0.001316 atmosphere; named after Torricelli</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109868903"
	 b:glossaryEntry="a unit of pressure"/>
<rdf:Description rdf:about="&a;109868996">
	<b:glossaryEntry>a unit of atmospheric pressure equal to one thousandth of a bar; "atmospheric pressure at sea level is 1013 millibars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109869188">
	<b:glossaryEntry>a unit of pressure equal to a million dynes per square centimeter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109869341">
	<b:glossaryEntry>the absolute unit of pressure equal to one dyne per square centimeter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109869507">
	<b:glossaryEntry>a linear unit used to measure the size of type; approximately 1/72 inch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109869649"
	 b:glossaryEntry="a linear unit (1/6 inch) used in printing"/>
<rdf:Description rdf:about="&a;109869813"
	 b:glossaryEntry="half the width of an em"/>
<rdf:Description rdf:about="&a;109869910"
	 b:glossaryEntry="the square of a body of any size of type"/>
<rdf:Description rdf:about="&a;109870014"
	 b:glossaryEntry="a linear unit of the size of type slightly larger than an em"/>
<rdf:Description rdf:about="&a;109870127">
	<b:glossaryEntry>space for one line of print (one column wide and 1/14 inch deep) used to measure advertising</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109870283">
	<b:glossaryEntry>an advertising measure; one agate line appearing in one million copies of a publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109870424"
	 b:glossaryEntry="a unit of measurement for advertising space"/>
<rdf:Description rdf:about="&a;109870532"
	 b:glossaryEntry="the number of lines in a piece of printed material"/>
<rdf:Description rdf:about="&a;109870645"
	 b:glossaryEntry="a logarithmic unit of sound intensity equal to 10 decibels"/>
<rdf:Description rdf:about="&a;109870757">
	<b:glossaryEntry>a logarithmic unit of sound intensity; 10 times the logarithm of the ratio of the sound intensity to some reference intensity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109870946">
	<b:glossaryEntry>a unit of perceived loudness equal to the loudness of a 1000-hertz tone at 40 dB above threshold</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109871112"
	 b:glossaryEntry="a unit of subjective loudness"/>
<rdf:Description rdf:about="&a;109871211"
	 b:glossaryEntry="a unit of traffic intensity in a telephone system"/>
<rdf:Description rdf:about="&a;109871313">
	<b:glossaryEntry>a unit of temperature on a specified scale; "the game was played in spite of the 40-degree temperature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109871505"
	 b:glossaryEntry="a unit of temperature equal to one-thousandth of a degree"/>
<rdf:Description rdf:about="&a;109871620"
	 b:glossaryEntry="a degree on the Centigrade scale of temperature"/>
<rdf:Description rdf:about="&a;109871752"
	 b:glossaryEntry="a degree on the Fahrenheit scale of temperature"/>
<rdf:Description rdf:about="&a;109871867">
	<b:glossaryEntry>the basic unit of thermodynamic temperature adopted under the System International d''Unites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109872015"
	 b:glossaryEntry="an absolute temperature scale in Fahrenheit degrees"/>
<rdf:Description rdf:about="&a;109872136">
	<b:glossaryEntry>a unit used in estimating fuel requirements for heating a building</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109872259">
	<b:glossaryEntry>a system of measuring temperature; 0 is the melting point of ice and 100 is the boiling point of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109872440">
	<b:glossaryEntry>a system of measuring temperature; 32 is the melting point of ice and 212 is the boiling point of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109872606">
	<b:glossaryEntry>a cgs unit of dynamic viscosity equal to one dyne-second per square centimeter; the viscosity of a fluid in which a force of one dyne per square centimeter maintains a velocity of 1 centimeter per second</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109872861"
	 b:glossaryEntry="unit of mass for expressing masses of atoms or molecules"/>
<rdf:Description rdf:about="&a;109872980">
	<b:glossaryEntry>the sum of the number of neutrons and protons in an atomic nucleus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109873121"
	 b:glossaryEntry="a system of units used to express the weight of something"/>
<rdf:Description rdf:about="&a;109873287">
	<b:glossaryEntry>a system of weights based on the 16-ounce pound (or 7,000 grains)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109873451"
	 b:glossaryEntry="any of the units of the avoirdupois system of weights"/>
<rdf:Description rdf:about="&a;109873802">
	<b:glossaryEntry>a system of weights used for precious metals and gemstones; based on a 12-ounce pound and an ounce of 480 grains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109873998"
	 b:glossaryEntry="any of the unit of the troy system of weights"/>
<rdf:Description rdf:about="&a;109874190">
	<b:glossaryEntry>any weight unit used in pharmacy; an ounce is equal to 480 grains and a pound is equal to 12 ounces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109874467"
	 b:glossaryEntry="a decimal unit of weight based on the gram"/>
<rdf:Description rdf:about="&a;109874876"
	 b:glossaryEntry="a unit of weight used in some Spanish speaking countries"/>
<rdf:Description rdf:about="&a;109874985">
	<b:glossaryEntry>any of various units of weight used in SE Asia (especially a Chinese measure equal to 500 grams)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109875142">
	<b:glossaryEntry>the weight of a liter of hydrogen (at 0 Centigrade and 760 millimeters pressure)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109875274">
	<b:glossaryEntry>the weight of a frail (basket) full of raisins or figs; between 50 and 75 pounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109875406"
	 b:glossaryEntry="a unit of weight equal to 4,000 pounds"/>
<rdf:Description rdf:about="&a;109875495">
	<b:glossaryEntry>a unit of weight used in Asia; has different values in different countries; "the official maund in India is 82.6 pounds avoirdupois"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109875679"
	 b:glossaryEntry="a Greek unit of weight equal to one tenth of a gram"/>
<rdf:Description rdf:about="&a;109875802"
	 b:glossaryEntry="a Turkish unit of weight equal to about 2.75 pounds"/>
<rdf:Description rdf:about="&a;109875903">
	<b:glossaryEntry>a unit of weight used in some parts of Asia; approximately equal to 133 pounds (the load a grown man can carry)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109876066"
	 b:glossaryEntry="a Russian unit of weight equal to approximately 36 pounds"/>
<rdf:Description rdf:about="&a;109876174">
	<b:glossaryEntry>a unit of weight used in some Moslem countries near the Mediterranean; varies between one and five pounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109876330">
	<b:glossaryEntry>a unit of weight used in east Asia approximately equal to 1.3 ounces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109876449">
	<b:glossaryEntry>a weight of 28 pounds; sometimes imposed as a handicap in a horse race (such as a steeple chase or hurdle race)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109876619"
	 b:glossaryEntry="1/7000 pound; equals a troy grain or 64.799 milligrams"/>
<rdf:Description rdf:about="&a;109876744"
	 b:glossaryEntry="1/16 ounce"/>
<rdf:Description rdf:about="&a;109876843"
	 b:glossaryEntry="16 drams"/>
<rdf:Description rdf:about="&a;109876941"
	 b:glossaryEntry='16 ounces; "he tried to lieft 100 pounds"'/>
<rdf:Description rdf:about="&a;109877096">
	<b:glossaryEntry>(British) an avoirdupois unit used to measure the weight of a human body; equal to 14 pounds</b:glossaryEntry>
</rdf:Description>
