	 b:glossaryEntry="an agent that makes things white or colorless"/>
<rdf:Description rdf:about="&a;110598275"
	 b:glossaryEntry="an agent that produces chemical reactions"/>
<rdf:Description rdf:about="&a;110598521">
	<b:glossaryEntry>a substance (such as calcium oxide) that absorbs water and is used to remove moisture</b:glossaryEntry>
</rdf:Description>
