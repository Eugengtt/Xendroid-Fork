	 b:glossaryEntry='to this writing or document; "the charts hereto attached"'/>
<rdf:Description rdf:about="&a;400350801">
	<b:glossaryEntry>immediately after this; "hereupon, the passengers stumbled aboard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400350904"
	 b:glossaryEntry='in an airtight manner; "this bag is hermetically sealed"'/>
<rdf:Description rdf:about="&a;400351019">
	<b:glossaryEntry>in a heroic manner; "he become reconciled to not dying heroically in her arms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400351154">
	<b:glossaryEntry>in a hideous manner; "her face was hideously disfigured after the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400351346"
	 b:glossaryEntry='at a great altitude; "he climbed high on the ladder"'/>
<rdf:Description rdf:about="&a;400351441"
	 b:glossaryEntry='far up toward the source; "he lives high up the river"'/>
<rdf:Description rdf:about="&a;400351528">
	<b:glossaryEntry>in or to a high position, amount, or degree; "prices have gone up far too high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400351640"
	 b:glossaryEntry='in a rich manner; "he lives high"'/>
<rdf:Description rdf:about="&a;400351765">
	<b:glossaryEntry>in a domineering high-handed manner; "he behaved high-handedly toward his employees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400351909">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a high-minded manner; "he talks high-mindedly, but we don''t know whether he acts according to his principles"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400352081">
	<b:glossaryEntry>in a mysterious way; "the book had been mysteriously moved from its customary place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400352224">
	<b:glossaryEntry>in a curious and questioning manner; "they turned their heads questioningly, as if awaiting further instructions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400352429">
	<b:glossaryEntry>in an insolent manner; "he had replied insolently to his superiors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400352553"
	 b:glossaryEntry='without restraint; "cows in India are running loose"'/>
<rdf:Description rdf:about="&a;400352664"
	 b:glossaryEntry='in rotation or succession; "turn about is fair play"'/>
<rdf:Description rdf:about="&a;400352750">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a hoarse or husky voice; "`Excuse me,'' he said hoarsely"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400352892">
	<b:glossaryEntry>in a horizontal direction; "a gallery quite often is added to make use of space vertically as well as horizontally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400353066">
	<b:glossaryEntry>in a vertical direction; "a gallery quite often is added to make use of space vertically as well as horizontally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400353236">
	<b:glossaryEntry>in a hospitable manner; "she was received hospitably by her new family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400353382">
	<b:glossaryEntry>in an inhospitable manner; "she was received inhospitably by her new family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400353535"
	 b:glossaryEntry='every hour; "daily, hourly, I grew stronger"'/>
<rdf:Description rdf:about="&a;400353628">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a huffy manner; "`Don''t bother to call me back,'' he said huffily"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400353750"
	 b:glossaryEntry='in secrecy; "they did it all hugger-mugger"'/>
<rdf:Description rdf:about="&a;400353835">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a humane manner; "let''s treat the prisoners of war humanely"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400353971">
	<b:glossaryEntry>in an inhumane manner; "the prisoners of war were treated inhumanely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400354115">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a humorous manner; "Dickens had humorously suggested a special service of intercession at St. Paul''s Cathedral"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400354331">
	<b:glossaryEntry>in a humorless manner; "he reacted rather humorlessly to these rumors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400354508">
	<b:glossaryEntry>by a factor of one hundred; "they money increased a hundredfold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400354630">
	<b:glossaryEntry>in the manner of someone who is very hungry; "he pounced on the food hungrily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400354794">
	<b:glossaryEntry>in a hydraulic manner; "the block is then tested hydraulically to its full design test pressure on each stream separately"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400354990"
	 b:glossaryEntry='in a hygienic manner; "the body must cared for hygienically"'/>
<rdf:Description rdf:about="&a;400355127">
	<b:glossaryEntry>in an unhygienic manner; "the meat is unhygienically processed on wooden tables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400355286">
	<b:glossaryEntry>in a hysterical manner; "she screamed hysterically when she heard the news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400355420">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a cold and icy manner; "`Mr. Powell finds it easier to take it out of mothers, children and sick people than to take on this vast industry,'' Mr Brown commented icily"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400355641">
	<b:glossaryEntry>with complete identity; in an identical manner; "he is fitted with an identically similar one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400355793">
	<b:glossaryEntry>in an identifiable manner; "they were identifiably different"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400355913">
	<b:glossaryEntry>with respect to ideology; "ideologically, we do not see eye to eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400356040"
	 b:glossaryEntry='in an idiomatic manner; "he expressed himself idiomatically"'/>
<rdf:Description rdf:about="&a;400356160">
	<b:glossaryEntry>in an idiotic manner; "what arouses the indignation of thehonest satirist is not the fact that people in positions of power or influence behave idiotically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400356374">
	<b:glossaryEntry>in an idle manner; "this is what I always imagined myself doing in the south of France, sitting idly, drinking coffee, watching the people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400356591">
	<b:glossaryEntry>in an idolatrous manner; "the people idolatrously worshipped the Golden Calf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400356727">
	<b:glossaryEntry>in ignorance; in an ignorant manner; "they lived ignorantly in their own small world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400356869"
	 b:glossaryEntry='in a legible manner; "you must write legibly"'/>
<rdf:Description rdf:about="&a;400357048"
	 b:glossaryEntry='in an illegible manner; "this student writes illegibly"'/>
<rdf:Description rdf:about="&a;400357243">
	<b:glossaryEntry>of biological parents not married to each other; "this child was born illegitimately"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400357424">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a lawfully recognized manner; "let''s get married so our child can be born legitimately"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400357591">
	<b:glossaryEntry>in an manner disapproved or not allowed by custom; "He acted illegitimately when he increased the rent fourfold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400357812">
	<b:glossaryEntry>in a manner acceptable to common custom; "you cannot do this legitimately!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358057">
	<b:glossaryEntry>in a logical manner; "he acted logically under the circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358196">
	<b:glossaryEntry>in an illogical manner; "she acted illogically under the pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358338">
	<b:glossaryEntry>according to logical reasoning; "logically, you should now do the same to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358472">
	<b:glossaryEntry>in an illustrious manner; "Einstein, the illustriously famous physicist of the 20th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358624">
	<b:glossaryEntry>in an immaculate manner; "gone was the casually dressed Canadian she had thought a backwoodsman--this man was immaculately tailored"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358815">
	<b:glossaryEntry>so as to be incapable of moving; "the mountains brooded immovably above the river"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400358953"
	 b:glossaryEntry='in an impartial manner; "he smiled at them both impartially"'/>
<rdf:Description rdf:about="&a;400359071">
	<b:glossaryEntry>in a moral manner; "he acted morally under the circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400359235">
	<b:glossaryEntry>without regard for morality; "he acted immorally when his own interests were at stake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400359406">
	<b:glossaryEntry>in an impassive manner; "he submitted impassively to his arrest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400359528">
	<b:glossaryEntry>in an impenitent manner; "he repeated his position unrepentantly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400359722"
	 b:glossaryEntry="showing remorse"/>
<rdf:Description rdf:about="&a;400359896"
	 b:glossaryEntry="in an imperative and commanding manner"/>
<rdf:Description rdf:about="&a;400360026">
	<b:glossaryEntry>in an imperceptible manner or to an imperceptible degree; "the power of the Secretary of State in London increased gradually but imperceptibly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400360311">
	<b:glossaryEntry>in a noticeable manner; "he changed noticeably over the years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400360480"
	 b:glossaryEntry='in an imperious manner; "imperiously he cut her short"'/>
<rdf:Description rdf:about="&a;400360592">
	<b:glossaryEntry>in an impersonal manner; "when I told him about Russ I found it difficult to speak impersonally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400360747"
	 b:glossaryEntry='without warmth; "he treated his patients impersonally"'/>
<rdf:Description rdf:about="&a;400360878"
	 b:glossaryEntry='in a personal way; "he took her comments personally"'/>
<rdf:Description rdf:about="&a;400361005"
	 b:glossaryEntry='as oneself; "speaking personally, I would not want to go"'/>
<rdf:Description rdf:about="&a;400361101">
	<b:glossaryEntry>in an impudent or impertinent manner; "a lean, swarthy fellow was peering through the window, grinning impudently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400361389">
	<b:glossaryEntry>in an impulsive or impetuous way; without taking cautions; "he often acts impulsively and later regrets it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400361586">
	<b:glossaryEntry>in an impious manner; "the young members challenged their leader impiously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400361735">
	<b:glossaryEntry>in a pious manner; "this received opinion is piously affirmed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400361851">
	<b:glossaryEntry>in an appealing but bold manner; "she asked him impishly to come in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400362004">
	<b:glossaryEntry>without ever expressing so clearly; "he implicitly assumes that you know the answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400362163">
	<b:glossaryEntry>in an explicit manner; "in his foreword Professor Clark puts it explicitly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400362313"
	 b:glossaryEntry='without doubting or questioning; "I implicitly trust him"'/>
<rdf:Description rdf:about="&a;400362427">
	<b:glossaryEntry>in an important way; "for centuries jellies have figured importantly among English desserts, particularly upon festive occasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400362613">
	<b:glossaryEntry>in an important way or to an important degree; "more importantly, Weber held that the manifold meaning attached to the event by the social scientist could alter his definition of the concrete event itself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400362910">
	<b:glossaryEntry>to an impracticable degree; "this is still impracticably high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400363032">
	<b:glossaryEntry>in a precise manner; "she always expressed herself precisely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400363226"
	 b:glossaryEntry='in an imprecise manner; "he expressed himself imprecisely"'/>
<rdf:Description rdf:about="&a;400363408">
	<b:glossaryEntry xml:space='preserve'><![CDATA[just as it should be; "`Precisely, my lord,'' he said"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400363552">
	<b:glossaryEntry>in an impregnable manner; "the sight of that bland, impregnably righteous face has been enough to make their blood run cold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400363734">
	<b:glossaryEntry>in an improvident manner; "he lived improvidently for the moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400363877">
	<b:glossaryEntry>in a provident manner; "providently, he had saved up some money for emergencies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400364033">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a prudent manner; "I had allotted my own bedroom for necking, prudently removing both the bed and the key, and taken both myself and my typewriter into my son''s bedroom."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400364297">
	<b:glossaryEntry>in an imprudent manner; "imprudently, he downed tools and ran home to make his wife happy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400364463">
	<b:glossaryEntry>in an adequate manner or to an adequate degree; "he was adequately prepared"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400364614">
	<b:glossaryEntry>in an inadequate manner or to an inadequate degree; "the temporary camps were inadequately equipped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400364791"
	 b:glossaryEntry='in an incisive manner; "he was incisively critical"'/>
<rdf:Description rdf:about="&a;400364899"
	 b:glossaryEntry='in an intentionally unkind way; "a cutting remark"'/>
<rdf:Description rdf:about="&a;400365005">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without revealing one''s identity; "in Holland he lived incognito as a carpenter in the shipyards of the East India company"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400365166">
	<b:glossaryEntry>in an incomparable manner or to an incomparable degree; "she is incomparably gifted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400365342">
	<b:glossaryEntry>in a comparable manner or to a comparable degree; "you will have to work comparably harder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400365508">
	<b:glossaryEntry>in an incongruous manner; "his shirttails stuck out from his tuxedo pants somewhat incongruously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400365665">
	<b:glossaryEntry>in a manner tending to attract attention; "there have been plenty of general declarations about willingness to meet and talk, but conspicuously no mention of time and place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400365916">
	<b:glossaryEntry>in a manner intended to avoid attracting attention; "he had entered the room inconspicuously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400366089"
	 b:glossaryEntry="in an incriminating manner"/>
<rdf:Description rdf:about="&a;400366177"
	 b:glossaryEntry='in a manner impossible to cure; "he is incurably ill"'/>
<rdf:Description rdf:about="&a;400366286"
	 b:glossaryEntry='to an incurable degree; "she was incurably optimistic"'/>
<rdf:Description rdf:about="&a;400366396">
	<b:glossaryEntry>in an indelible manner; "this tradition has left its mark indelibly upon the social, political, educational and industrial fabric of this country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400366598">
	<b:glossaryEntry>to an inexpressible degree; "she was looking very young tonight, and, as usual, indescribably beautiful, in a simple strapless dress of a green and white silky cotton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400366919">
	<b:glossaryEntry>in an indeterminable manner; "their relationship was of an indeterminably vague nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400367067">
	<b:glossaryEntry>with indifference; in an indifferent manner; "she shrugged indifferently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400367200">
	<b:glossaryEntry>in an indignant manner; "Miss Burney protested indignantly, her long thin nose turning pink with mortification at this irreverent piece of mimicry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400367405">
	<b:glossaryEntry>with discretion; prudently and with wise self-restraint; "I sent for the sergeant of the platoon both men were in and asked him to try to find out discreetly what lay behind this"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400367659">
	<b:glossaryEntry>without discretion or wisdom or self-restraint; "she inquired indiscreetly after the state of his health"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400367841">
	<b:glossaryEntry>in an indolent manner; "he lives indolently with his relatives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400367961">
	<b:glossaryEntry>in a manner or to a degree that could not be doubted; "it was immediately and indubitably apparent that I had interrupted a scene of lovers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400368159">
	<b:glossaryEntry>in an indulgent manner; "I was indulgently advised to give the kids what they wanted unless I wished my son to be socially ostracised"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400368351">
	<b:glossaryEntry>in an industrious manner; "they hoed up weeds industriously all morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400368483">
	<b:glossaryEntry>in an inextricable manner; "motives inspired by Mammon were often inextricably blended with things pertaining to Caesar and to God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400368673"
	 b:glossaryEntry="exerting influence"/>
<rdf:Description rdf:about="&a;400368751"
	 b:glossaryEntry="in an informative manner"/>
<rdf:Description rdf:about="&a;400368905">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an uninformative manner; "I can''t tell you when the manager will arrive," he said rather uninformatively"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400369147">
	<b:glossaryEntry>not many times; "in your 1850 church you not infrequently find a dramatic contrast between the sumptuous appointments of the building itself and the inhuman barrack-like living conditions in the church room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400369431">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an ingenious manner; "a Hampshire farmer had fowls of different breeds, including dorkings, and he discriminated ingeniously between the `dark ones'' and the `white ones''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400369662">
	<b:glossaryEntry>in a pleasingly ingratiating manner; "she smiled ingratiatingly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400369787">
	<b:glossaryEntry>in a flattering and ingratiating manner; "she behaves ingratiatingly toward her boss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400369933">
	<b:glossaryEntry>in an inherent manner; "the subject matter is sexual activity of any overt kind, which is depicted as inherently desirable and exciting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400370126">
	<b:glossaryEntry>in an unreproducible manner; "he has an inimitably verbose style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400370283">
	<b:glossaryEntry>in an iniquitous manner; "they really believed that the treaty of Versailles was iniquitously injust"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400370443">
	<b:glossaryEntry>in an innate manner; "the child is said to be innately disposed to learn language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400370580"
	 b:glossaryEntry='in a naively innocent manner; "she smiled at him innocently"'/>
<rdf:Description rdf:about="&a;400370697">
	<b:glossaryEntry>in a not unlawful manner; "he claimed to have purchased the contraband innocently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400370836">
	<b:glossaryEntry>at an inconvenient time; "he arrived inopportunely just as we sat down for dinner"; "she answered malapropos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400371036">
	<b:glossaryEntry>at an opportune time; "he arrived rather opportunely just when we needed a new butler"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400371198">
	<b:glossaryEntry>in an inquiring manner; "Tom Swift looked at his cabin mates inquiringly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400371343">
	<b:glossaryEntry>in an insatiable manner; with persistence but without satisfaction; "he clawed insatiably at the traditional precepts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400371531"
	 b:glossaryEntry='to an insatiable degree; "she was insatiably hungry"'/>
<rdf:Description rdf:about="&a;400371653">
	<b:glossaryEntry>in an invulnerable manner; "the agreed line was to involve at several points the withdrawal of French troops from positions which they had quite securely held"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400371867">
	<b:glossaryEntry>in a manner free from fear or risk; "the outcome of expansion in the sixties and seventies will be an academic hierarchy securely supported by scholastic selection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400372104">
	<b:glossaryEntry>in a manner involving risk; "our positions here at the university are rather insecurely supported by grant money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400372292">
	<b:glossaryEntry>in a confident and unselfconscious manner; "he acts very securely in fron of the camera"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400372453">
	<b:glossaryEntry>in a tentative and self-conscious manner; "she always acts very insecurely in the presence of her father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400372633">
	<b:glossaryEntry>in a sensitive manner; "she questioned the rape victim very sensitively about the attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400372798">
	<b:glossaryEntry>in an insensitive manner; "the police officer questioned the woman rather insensitively about the attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400372981">
	<b:glossaryEntry>in a harmfully insidious manner; "these drugs act insidiously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400373134">
	<b:glossaryEntry>with sincerity; without pretense; "she praised him sincerely for his victory"; "was unfeignedly glad to see his old teacher"; "we are truly sorry for the inconvenience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400373434">
	<b:glossaryEntry>without sincerity; "she congratulated him somewhat insincerely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400373573"
	 b:glossaryEntry='very sincerely; "he spoke from the heart"'/>
<rdf:Description rdf:about="&a;400373657">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an insinuating manner; "the art book has art to sell, insinuatingly, and for a purpose, like the American muse, which has in fact a tradition to sell, and one which doesn''t exist, in painting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400373894"
	 b:glossaryEntry='in an insipid manner; "insipidly expressed thoughts"'/>
<rdf:Description rdf:about="&a;400374002"
	 b:glossaryEntry="to such an extent or degree; so"/>
<rdf:Description rdf:about="&a;400374070"
	 b:glossaryEntry='in an inspiring manner, "he talked inspirationally"'/>
<rdf:Description rdf:about="&a;400374202">
	<b:glossaryEntry>in a strong substantial way; "the house was substantially built"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400374326">
	<b:glossaryEntry>lacking expression or fullness; "the finale of the symphony was played just a shade too fast and not quite insubstantially enough to convey the full, hollow horror of its implications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400374554">
	<b:glossaryEntry>in a disrespectful and insulting manner; "he behaves insultingly toward his parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400374696">
	<b:glossaryEntry>to an insuperable degree; "these various courses all seemed insuperably difficult to the student"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400374851">
	<b:glossaryEntry>in an interchangeable manner; "these terms can be used interchangeably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400374984">
	<b:glossaryEntry>between departments; "this memo was circulated interdepartmentally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400375115"
	 b:glossaryEntry='to an intermediate degree; "intermediately hot"'/>
<rdf:Description rdf:about="&a;400375205">
	<b:glossaryEntry>(spatial sense) seeming to have no bounds; "the Nubian desert seemed to strech out before them endlessly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400375362">
	<b:glossaryEntry>in an intermittent manner; "intermittently we questioned the barometer"</b:glossaryEntry>
