<rdf:Description rdf:about="&a;200282060">
	<b:glossaryEntry>prepare for social life; "Children have to be socialized in school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200282202">
	<b:glossaryEntry>make ready or suitable in advance for a particular purpose or for some use, event, etc; "Get the children ready for school!"; "prepare for war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200282688"
	 b:glossaryEntry="put into the required condition beforehand"/>
<rdf:Description rdf:about="&a;200282800">
	<b:glossaryEntry>kill, preserve, and harden (tissue) in order to prepare for microscopic study; in cytology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200282951">
	<b:glossaryEntry>fix onto a backing, setting, or support; "mount slides for macroscopic analysis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200283094">
	<b:glossaryEntry>get ready for a particular purpose or event; "set up an experiment"</b:glossaryEntry>
