</rdf:Description>
<rdf:Description rdf:about="&a;110586595"
	 b:glossaryEntry="the fur of a squirrel"/>
<rdf:Description rdf:about="&a;110586671"
	 b:glossaryEntry="any of various resins or oleoresins"/>
<rdf:Description rdf:about="&a;110586770">
	<b:glossaryEntry>a liquid added to the water in a cooling system to lower its freezing point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110586938">
	<b:glossaryEntry>used especially in the production of fertilizers and explosives and rocket fuels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110587090">
	<b:glossaryEntry>an unstable inorganic acid known only in solution and as nitrite salts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110587219">
	<b:glossaryEntry>any of several oxides of nitrogen formed by the action of nitric acid on oxidizable materials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110587373"
	 b:glossaryEntry="a highly poisonous gas"/>
<rdf:Description rdf:about="&a;110587476"
	 b:glossaryEntry="a poisonous red-brown gas (NO)"/>
<rdf:Description rdf:about="&a;110587565">
	<b:glossaryEntry>a compound formed from one or more other compounds in a reaction resulting in removal of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110587733">
	<b:glossaryEntry>a yellow fuming corrosive mixture of nitric and hydrochloric acid that dissolves metals (including gold)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110587894"
	 b:glossaryEntry="a transparent variety of beryl that is blue green in color"/>
<rdf:Description rdf:about="&a;110588027">
	<b:glossaryEntry>a bitter tasting amino acid found in proteins and necessary for nutrition; its absence from the diet leads to a reduced production of spermatozoa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110588227">
	<b:glossaryEntry>a white powdered poisonous trioxide of arsenic; used in manufacturing glass and as a pesticide and weed killer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110588448">
	<b:glossaryEntry>a liquid that can carry large amounts of oxygen and can serve as a temporary substitute for blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110588608"
	 b:glossaryEntry="a white cyclic anhydride"/>
<rdf:Description rdf:about="&a;110588697"
	 b:glossaryEntry="a high-quality paper (usually having a filler of china clay)"/>
<rdf:Description rdf:about="&a;110588813">
	<b:glossaryEntry>the gum resin of various plants; has strong taste and odor; formerly used as an antispasmodic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110588962"
	 b:glossaryEntry="the residue that remains when something is burned"/>
<rdf:Description rdf:about="&a;110589097">
	<b:glossaryEntry>fine solid particles of ash that are carried into the air when fuel is combusted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110589231">
	<b:glossaryEntry>mixed asphalt and crushed gravel or sand; used especially for paving but also for roofing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110589374"
	 b:glossaryEntry="a light fibrous material used as an insulator"/>
<rdf:Description rdf:about="&a;110589490">
	<b:glossaryEntry>a solid solution of ferric carbide or carbon in iron; cools to form pearlite or martensite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110589674">
	<b:glossaryEntry>steel that has enough nickel and chromium or manganese to retain austenite at atmospheric temperatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110589858">
	<b:glossaryEntry>a chemical compound containing the azido group combined with an element or radical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110590010"
	 b:glossaryEntry="a salt of hydrazoic acid"/>
<rdf:Description rdf:about="&a;110590110"
	 b:glossaryEntry="the univalent group N3- derived from hydrazoic acid"/>
<rdf:Description rdf:about="&a;110590235"
	 b:glossaryEntry="any dye containing one or more azo groups"/>
<rdf:Description rdf:about="&a;110590348">
	<b:glossaryEntry>a red-brown powder used as a dye, especially as a chemical pH indicator (congo red is red in basic and blue in acidic solutions)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110590532">
	<b:glossaryEntry>a green crystal (violet in water) used as a dye or stain or bactericide or fungicide or anthelmintic or burn treatment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110590728">
	<b:glossaryEntry>a compound made up of a ring of four carbon atoms and one sulfur atom and one nitrogen atom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110590910">
	<b:glossaryEntry>a dark green dye used as a stain, an antiseptic, a chemical indicator, and an antidote in cyanide poisoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110591122">
	<b:glossaryEntry>a compound used primarily in veterinary medicine to rid farm animals of internal parasites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110591310"
	 b:glossaryEntry="the bivalent group -N=N- united to two hydrocarbon groups"/>
<rdf:Description rdf:about="&a;110591437">
	<b:glossaryEntry>the univalent cation R-N:N- (where R is an aromatic hydrocarbon); found in salts that are used in manufacturing azo dyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110591613">
	<b:glossaryEntry>a alloy of tin with some copper and antimony; an anti-friction lining for bearings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110591765"
	 b:glossaryEntry="any chemical agent that destroys bacteria"/>
<rdf:Description rdf:about="&a;110591879">
	<b:glossaryEntry>the dry dusty pulp that remains after juice is extracted from sugar cane or similar plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110592023">
	<b:glossaryEntry>any of various powdered mixtures used in baking as a substitute for yeast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110592156">
	<b:glossaryEntry>a liquid ester derived from amyl alcohol; has the odor of bananas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110592278">
	<b:glossaryEntry>a white crystalline acid derived from pyrimidine; used in preparing barbiturate drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110592439"
	 b:glossaryEntry="a white insoluble radiopaque powder used as a pigment"/>
<rdf:Description rdf:about="&a;110592567">
	<b:glossaryEntry>the commonest type of solidified lava; a dense dark gray fine-grained igneous rock composed chiefly of calcium-rich plagioclase feldspar and pyroxene</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110592807">
	<b:glossaryEntry>pig iron containing a high percentage of phosphorus; used in making steel by a process that removes the phosphorus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110592978">
	<b:glossaryEntry>slag produced in making steel; low in silica but having large amounts of calcium phosphate; useful as fertilizer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110593147"
	 b:glossaryEntry="water used for a bath"/>
<rdf:Description rdf:about="&a;110593225"
	 b:glossaryEntry="dilute sulfuric acid used in storage batteries"/>
<rdf:Description rdf:about="&a;110593349"
	 b:glossaryEntry="a brass bushing or a lining for a bearing"/>
<rdf:Description rdf:about="&a;110593450">
