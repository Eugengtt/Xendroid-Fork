<rdf:Description rdf:about="&a;400274571"
	 b:glossaryEntry='twice a year; "we hold our big sale biannually"'/>
<rdf:Description rdf:about="&a;400274657"
	 b:glossaryEntry='in a blank manner; "she stared at him blankly"'/>
<rdf:Description rdf:about="&a;400274778">
	<b:glossaryEntry>in a blasphemous manner; "the sailors were cursing blasphemously"</b:glossaryEntry>
