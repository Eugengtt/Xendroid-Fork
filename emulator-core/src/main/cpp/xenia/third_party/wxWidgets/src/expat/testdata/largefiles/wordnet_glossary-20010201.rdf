	 b:glossaryEntry="large blue-gray black-striped damselfish; nearly worldwide"/>
<rdf:Description rdf:about="&a;102097305"
	 b:glossaryEntry="wrasses"/>
<rdf:Description rdf:about="&a;102097537">
	<b:glossaryEntry>chiefly tropical marine fishes with fleshy lips and powerful teeth; usually brightly colored</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102097826"
	 b:glossaryEntry="a genus of Labridae"/>
<rdf:Description rdf:about="&a;102097959"
	 b:glossaryEntry="found around the Great Barrier Reef"/>
<rdf:Description rdf:about="&a;102098104"
	 b:glossaryEntry="a genus of Labridae"/>
