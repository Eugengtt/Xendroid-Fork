	 b:glossaryEntry='make a hole into; "The needle pierced her flesh"'/>
<rdf:Description rdf:about="&a;200988428">
	<b:glossaryEntry>penetrate or cut, as with a knife; "The fork bit into the surface"</b:glossaryEntry>
