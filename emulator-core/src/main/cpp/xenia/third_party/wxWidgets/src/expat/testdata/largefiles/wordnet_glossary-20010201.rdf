	 b:glossaryEntry="(archaic as adverb) in a brotherly manner"/>
<rdf:Description rdf:about="&a;400284312"
	 b:glossaryEntry="on the affirmative side"/>
<rdf:Description rdf:about="&a;400284385"
	 b:glossaryEntry='on the negative side; "much was written pro and con"'/>
<rdf:Description rdf:about="&a;400284503"
	 b:glossaryEntry='in a conceited manner; "he always acts so conceitedly!"'/>
