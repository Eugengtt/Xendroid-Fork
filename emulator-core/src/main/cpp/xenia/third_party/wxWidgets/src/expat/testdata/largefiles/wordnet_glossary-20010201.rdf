<rdf:Description rdf:about="&a;201350182"
	 b:glossaryEntry="start with anger or resentment or in protest"/>
<rdf:Description rdf:about="&a;201350293"
	 b:glossaryEntry="rise_up"/>
<rdf:Description rdf:about="&a;201350473">
	<b:glossaryEntry>open involuntarily; "His mouth dropped open"; "Her jaw dropped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201350615">
	<b:glossaryEntry>occupy or take on, as of a position or posture; "He assumes the lotus position"; "She took her seat on the stage"; We took our seats in the orchestra"; "She took up her position behind the tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201350890">
	<b:glossaryEntry>straighten oneself; "He drew himself up when he talked to his superior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201351052"
	 b:glossaryEntry="cause to rise up"/>
<rdf:Description rdf:about="&a;201351174">
