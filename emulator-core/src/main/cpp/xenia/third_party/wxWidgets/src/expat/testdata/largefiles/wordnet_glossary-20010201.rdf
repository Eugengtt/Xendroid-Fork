</rdf:Description>
<rdf:Description rdf:about="&a;200759246"
	 b:glossaryEntry="attack viciously and ferociously"/>
<rdf:Description rdf:about="&a;200759367">
	<b:glossaryEntry>launch an attack or assault on; begin hostilities with, as in warfare; "Hitler attacked Poland on September 1, 1939 and started World War II"; "Serbian forces assailed Bosnian towns all week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200759909"
	 b:glossaryEntry="attack suddenly"/>
<rdf:Description rdf:about="&a;200760028">
