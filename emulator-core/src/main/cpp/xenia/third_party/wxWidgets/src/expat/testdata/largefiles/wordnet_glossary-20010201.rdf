	 b:glossaryEntry="California plant with small pale yellow flowers"/>
<rdf:Description rdf:about="&a;108215228"
	 b:glossaryEntry="1 species: matilija poppy"/>
<rdf:Description rdf:about="&a;108215361">
	<b:glossaryEntry>tall branching subshrub of California and Mexico often cultivated for its silvery-blue foliage and large fragrant white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108215611"
	 b:glossaryEntry="1 species: bloodroot"/>
<rdf:Description rdf:about="&a;108215747">
