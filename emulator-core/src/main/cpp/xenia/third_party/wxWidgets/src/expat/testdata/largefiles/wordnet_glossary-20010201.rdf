<rdf:Description rdf:about="&a;201107110">
	<b:glossaryEntry>bring together all the elements or parts of: "Management closed ranks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201107267"
	 b:glossaryEntry="fix in a border, as of precious stones"/>
<rdf:Description rdf:about="&a;201107366"
	 b:glossaryEntry='put quickly or forcibly; "The judge clapped him in jail"'/>
<rdf:Description rdf:about="&a;201107492">
	<b:glossaryEntry>surround in a restrictive manner; "The building was hemmed in by flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201107629">
	<b:glossaryEntry>form mounds over; "The huts can be mounded over to form shelters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201107762"
	 b:glossaryEntry="fasten with, or as if with, a toggle"/>
<rdf:Description rdf:about="&a;201107862">
	<b:glossaryEntry>cut a girdle around (a plant) so as to kill by interrupting the circulation of water and nutrients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201108033">
	<b:glossaryEntry>cover or provide with or as if with straw; "cows were strawed to weather the snowstorm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201108183">
	<b:glossaryEntry>break the skin (of a body part) by scraping; "She was grazed by the stray bullet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201108327">
	<b:glossaryEntry>remove all contents or possession from, or empty completely; "The boys cleaned the sandwich platters"; "The trees were cleaned of apples by the storm"; deprive wholly of money in a gambling game, robbery, etc.; "The other players cleaned him completely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201108675">
	<b:glossaryEntry>pluck or pull at with the fingers; "She picked nervously at the buttons of her blouse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201108847">
	<b:glossaryEntry>apply force so as to cause motion towards the source of the motion; "Pull the rope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201109028">
	<b:glossaryEntry>put something in a resting position, as for support or steadying; "Rest your head on my shoulder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201109187">
	<b:glossaryEntry>cover or stiffen or glaze a porous material with size or sizing (a glutinous substance)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201109336">
	<b:glossaryEntry>destroy the completeness of a set of related items; "The book dealer would not break the set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201109521">
	<b:glossaryEntry>exchange for smaller units of money; "I had to break a $100 bill just to buy the candy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201109689"
	 b:glossaryEntry='make an incision or separation; "cut along the dotted line"'/>
<rdf:Description rdf:about="&a;201109809"
	 b:glossaryEntry='allow incision or separation; "This bread cuts easily"'/>
<rdf:Description rdf:about="&a;201109942"
	 b:glossaryEntry='function as a cutting instrument; "This knife cuts well"'/>
<rdf:Description rdf:about="&a;201110059"
	 b:glossaryEntry='cause to perch or sit; "She perched her hat on her head"'/>
<rdf:Description rdf:about="&a;201110178">
	<b:glossaryEntry>move from one place to another by lifting; "They hoisted the patient onto the operating table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201110335">
	<b:glossaryEntry>let or cause to fall in drops; "dribble oil into the mixture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201110468">
	<b:glossaryEntry>distribute over a surface in a layer; "bread cheese on a piece of bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201110586">
	<b:glossaryEntry>cover by spreading something over; "spread the bread with cheese"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201110733">
	<b:glossaryEntry>put (something) on a structure or conveyance; "load the bags onto the trucks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201110872">
	<b:glossaryEntry>put something somewhere so that the space is completely filled; "cram books into the suitcase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201111028">
	<b:glossaryEntry>cover or dress loosely with cloth; "drape the statue with a sheet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201111165">
	<b:glossaryEntry>cover with a light dusting of a substance; "dust the bread with flour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201111305">
	<b:glossaryEntry>affix conspicuously; "She plastered warnings all over the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201111451">
	<b:glossaryEntry>cover conspicuously, as by pasting something on; "The demonstrators plastered the hallways with posters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201111638">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make or cause to be or to become; "make a mess in one''s office"; "create a furor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201112752"
	 b:glossaryEntry="make tracks upon"/>
<rdf:Description rdf:about="&a;201112831">
	<b:glossaryEntry>advance or set forth in court; "bring charges", "institute proceedings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201112995"
	 b:glossaryEntry='bring in or establish; "introduce a new rule"'/>
<rdf:Description rdf:about="&a;201113133"
	 b:glossaryEntry="create a short-circuit in"/>
<rdf:Description rdf:about="&a;201113245">
	<b:glossaryEntry>create or design, often in a certain way; "Do my room in blue"; "I did this piece in wood to express my love for the forest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201113462"
	 b:glossaryEntry="deprive of certain characteristics"/>
<rdf:Description rdf:about="&a;201113585">
	<b:glossaryEntry>create anew; "Re-create the boom of the West on a small scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201113920"
	 b:glossaryEntry="make anew"/>
<rdf:Description rdf:about="&a;201114042">
	<b:glossaryEntry>do away with, cause the destruction or undoing of; "The fire destroyed the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201114394">
	<b:glossaryEntry>put an end to; "The terrible news destroyed our hopes that he had survived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201114538">
	<b:glossaryEntry>interrupt, break, or destroy; "fracture the balance of power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201114673">
	<b:glossaryEntry>eliminate completely and without a trace; "The old values have been wiped out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201114854">
	<b:glossaryEntry>destroy by firepower, such as an enemy''s line of communication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201114991">
	<b:glossaryEntry>create or manufacture a man-made product: "We produce more cars than we can sell"; "The company has been making toys for two centuries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201115683">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to create or manufacture a specific amount; "the computer is outputting the data from the job I''m running"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201115862">
	<b:glossaryEntry>produce or modulate (as electromagnetic waves) in the form of short bursts or pulses; "pulse waves," or cause an apparatus to produce pulses: "a transmitter pulsed by an electronic tube"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201116129"
	 b:glossaryEntry="make hastily and carelessly"/>
<rdf:Description rdf:about="&a;201116253"
	 b:glossaryEntry="make to specifications"/>
<rdf:Description rdf:about="&a;201116371"
	 b:glossaryEntry="make a dummy of; as of books or pages to be published"/>
<rdf:Description rdf:about="&a;201116498"
	 b:glossaryEntry="produce quickly or regularly, usually with machinery"/>
<rdf:Description rdf:about="&a;201116624"
	 b:glossaryEntry="make by machinery"/>
<rdf:Description rdf:about="&a;201116706"
	 b:glossaryEntry="turn, shape, mold, or otherwise finish by machinery"/>
<rdf:Description rdf:about="&a;201116822">
	<b:glossaryEntry>subject to puddling, as of iron; form by puddling, as of metal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201116948"
	 b:glossaryEntry='shape by beating; "beat swords into ploughshares"'/>
<rdf:Description rdf:about="&a;201117077">
	<b:glossaryEntry>produce something at a fast rate: "He churns out papers, but they are all about the same topic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201117239"
	 b:glossaryEntry='produce in excess; "The country overproduces cars"'/>
<rdf:Description rdf:about="&a;201117358"
	 b:glossaryEntry="produce by labor"/>
<rdf:Description rdf:about="&a;201117441">
	<b:glossaryEntry>put out considerable effort: "He put out the same for seven managers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201117575">
	<b:glossaryEntry>create laminate by putting together several thin sheets of a material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201117710"
	 b:glossaryEntry="produce on a large scale"/>
<rdf:Description rdf:about="&a;201117804"
	 b:glossaryEntry="produce alcohol illegally"/>
<rdf:Description rdf:about="&a;201117894"
	 b:glossaryEntry='put together out of existing material; "compile a list"'/>
<rdf:Description rdf:about="&a;201118086"
	 b:glossaryEntry='prepare from ingredients: "This medicine is home-confected"'/>
<rdf:Description rdf:about="&a;201118232"
	 b:glossaryEntry="put together hastily"/>
<rdf:Description rdf:about="&a;201118337"
	 b:glossaryEntry="compile an anthology"/>
<rdf:Description rdf:about="&a;201118426"
	 b:glossaryEntry="make a catalogue, compile a catalogue of something"/>
<rdf:Description rdf:about="&a;201118553">
	<b:glossaryEntry>use a computer program to translate source code written in a particular programming language into computer-readable machine code that can be executed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201118767">
	<b:glossaryEntry>bring into existence; "The new manager generated a lot of problems"; "The computer bug generated chaos in the office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201119026">
	<b:glossaryEntry>bring forth, usually something desirable; "The committee came up with some interesting recommendations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201119194">
	<b:glossaryEntry>generate gradually; "We must develop more potential customers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201119363">
	<b:glossaryEntry xml:space='preserve'><![CDATA[produce (electricity); "We can''t generate enough power for the entire city"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201119504">
	<b:glossaryEntry>bring into being; "He initiated a new program"; "Start a foundation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201119738"
	 b:glossaryEntry='apply or start; "set fire to a building"'/>
<rdf:Description rdf:about="&a;201119839">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give or supply; "The cow brings in 5 liters of milk"; "This year''s crop yielded 1,000 bushels of corn"; "The cow won''t give much milk"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201120116"
	 b:glossaryEntry='bring about; "His two singles gave the team the victory"'/>
<rdf:Description rdf:about="&a;201120290">
	<b:glossaryEntry>cause to happen or to occur as a consequence; "wreak havoc"; "bring comments"; "play a joke"; "The rain brought relief to the drought-stricken area"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201120650">
	<b:glossaryEntry>evoke or call forth: "raise the specter of unemployment"; "he conjured wild birds in the air"; "stir a disturbance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201120934"
	 b:glossaryEntry="deduce (a principle) or construe (a meaning)"/>
<rdf:Description rdf:about="&a;201121079"
	 b:glossaryEntry="get or cause to become in a difficult or laborious manner"/>
<rdf:Description rdf:about="&a;201121231">
	<b:glossaryEntry>make an uninvited or presumptuous inquiry; "They pried the information out of him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201121382">
	<b:glossaryEntry>re-establish on a new, usually improved, basis; "We renewed our friendship after a hiatus of twenty years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201121572"
	 b:glossaryEntry="create mentally and abstractly rather than with one''s hands"/>
<rdf:Description rdf:about="&a;201121943">
	<b:glossaryEntry>create or produce an idea; "Marx and Engels gave birth to communism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201122087"
	 b:glossaryEntry="form into a scheme"/>
<rdf:Description rdf:about="&a;201122191"
	 b:glossaryEntry="come up with"/>
<rdf:Description rdf:about="&a;201122320">
	<b:glossaryEntry>put or send forth; "She threw the flashlight beam into the corner"; "The setting sun threw long shadows"; "cast a spell"; "cast a warm light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201122578"
	 b:glossaryEntry="prepare according to a formula, of chemicals"/>
<rdf:Description rdf:about="&a;201122689">
	<b:glossaryEntry>have the idea for; "He conceived of a robot that would help paralyzed patients"; "This library was well conceived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201122972">
	<b:glossaryEntry>conceive or fashion in the mind; invent; "She designed a good excuse for not attending classes that day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201123140"
	 b:glossaryEntry='conceive beforehand: "a preconceived notion"'/>
<rdf:Description rdf:about="&a;201123253">
	<b:glossaryEntry>devise or invent; "He thought up a plan to get rich quickly"; "no-one had ever thought of such a clever piece of software"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201123517"
	 b:glossaryEntry="make up something artificial or untrue"/>
<rdf:Description rdf:about="&a;201123719"
	 b:glossaryEntry="of charges"/>
<rdf:Description rdf:about="&a;201123805"
	 b:glossaryEntry="make into fiction"/>
<rdf:Description rdf:about="&a;201123901">
	<b:glossaryEntry xml:space='preserve'><![CDATA[imagine; see in one''s mind; "I can''t see him on horseback!" "I can see what will happen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201124126"
	 b:glossaryEntry="picture to oneself"/>
<rdf:Description rdf:about="&a;201124228">
	<b:glossaryEntry>form a mental image of something that is not present or that is not the case; "Can you conceive of him as the president?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201124547">
	<b:glossaryEntry>imagine or visualize; "Just think--you could be rich one day!"; "Think what a scene it must have been!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201124713"
	 b:glossaryEntry="have fantasies"/>
<rdf:Description rdf:about="&a;201124810"
	 b:glossaryEntry="have a daydream; indulge in a fantasy"/>
<rdf:Description rdf:about="&a;201124979">
	<b:glossaryEntry>make a discovery, make a new finding; "Roentgen discovered X-rays"; "Darwin found many new species on the Galapagos Islands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201125184">
	<b:glossaryEntry>make or work out a plan for; devise; "They contrived to murder their boss"; design a new sales strategy"; "plan an attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201125442"
	 b:glossaryEntry="contrive by mutual agreement, as of a plan"/>
<rdf:Description rdf:about="&a;201125549"
	 b:glossaryEntry="of coins"/>
<rdf:Description rdf:about="&a;201125635"
	 b:glossaryEntry="form a web by making a thread, as of spiders"/>
<rdf:Description rdf:about="&a;201125759"
	 b:glossaryEntry='make up a story, as in "spin a yarn"'/>
<rdf:Description rdf:about="&a;201125857"
	 b:glossaryEntry="interpolate or insert into a sentence or story, as of words"/>
<rdf:Description rdf:about="&a;201125984">
	<b:glossaryEntry>make a design of; plan out in systematic, often graphic form; "design a better mousetrap"; "plan the new wing of the museum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201126233"
	 b:glossaryEntry="design anew, make a new design for"/>
<rdf:Description rdf:about="&a;201126333">
	<b:glossaryEntry>create by artistic means; "create a poem; "Schoenberg created twelve-tone music"; "Picasso created Cubism"; "Auden made verses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201126603">
	<b:glossaryEntry>create the design for; create or execute in an artistic or highly skilled manner; "Chanel designed the famous suit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201126836"
	 b:glossaryEntry="carry out a task"/>
<rdf:Description rdf:about="&a;201127085">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to bring (a necessary but unpleasant task) to an end; "Let''s get this job over with"; "It''s a question of getting over an unpleasant task"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201127290"
	 b:glossaryEntry='carry out; "run an errand"'/>
<rdf:Description rdf:about="&a;201127377"
	 b:glossaryEntry="make perfect; bring to perfection"/>
<rdf:Description rdf:about="&a;201127488"
	 b:glossaryEntry="of marriages"/>
<rdf:Description rdf:about="&a;201127586">
	<b:glossaryEntry>take the lead or initiative in; participate in the development of; "This South African surgeon pioneered heart transplants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201127947"
	 b:glossaryEntry="of conversations or friendships"/>
<rdf:Description rdf:about="&a;201128045">
	<b:glossaryEntry>bring something new to an environment; "A new word processor was introduced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201128253"
	 b:glossaryEntry="introduce gradually"/>
<rdf:Description rdf:about="&a;201128356"
	 b:glossaryEntry="terminate gradually"/>
<rdf:Description rdf:about="&a;201128460">
	<b:glossaryEntry>cause to happen or occur; "The scientists set up a shockwave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201128737">
	<b:glossaryEntry>in baseball: earn or achieve a base by being walked by the pitcher; "He drew a base on balls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201128898"
	 b:glossaryEntry='engage in drawing; "He spent the day drawing in the garden"'/>
<rdf:Description rdf:about="&a;201129019"
	 b:glossaryEntry='actuate; "trigger a reaction"'/>
<rdf:Description rdf:about="&a;201129223"
	 b:glossaryEntry='cause to arise; "induce a crisis"'/>
<rdf:Description rdf:about="&a;201129339"
	 b:glossaryEntry='cause to appear; "bring on the birthday cake"'/>
<rdf:Description rdf:about="&a;201129440">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bring about abruptly: "The crisis precipitated by Russia''s revolution"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201129587"
	 b:glossaryEntry="of bodily processes such as fever, illness, etc."/>
<rdf:Description rdf:about="&a;201129735"
	 b:glossaryEntry="make real or concrete; give reality to"/>
<rdf:Description rdf:about="&a;201129869"
	 b:glossaryEntry="make concrete and real"/>
<rdf:Description rdf:about="&a;201129984"
	 b:glossaryEntry="make immaterial; remove the real essence of"/>
<rdf:Description rdf:about="&a;201130115">
	<b:glossaryEntry>open up an area or prepare a way; "She pioneered a graduate program for women students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201130277">
	<b:glossaryEntry>give rise to; cause to happen or occur, not always intentionally; "cause a commotion"; "make a stir"; "cause an accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201130643">
	<b:glossaryEntry>compel or make somebody or something to act in a certain way; "People cannot be made to integrate just by passing a law!"; Heat makes you sweat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201130867">
	<b:glossaryEntry>compel somebody to do something, often against his own will or judgment; "She finally drove him to change jobs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201131041"
	 b:glossaryEntry="give occasion to"/>
<rdf:Description rdf:about="&a;201131141">
	<b:glossaryEntry>supply the inspiration for; "The article about the artist inspired the exhibition of his recent work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201131307">
	<b:glossaryEntry>call forth; "Her behavior provoked a quarrel between the couple"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201131493"
	 b:glossaryEntry='provoke: "pick a fight or a quarrel"'/>
<rdf:Description rdf:about="&a;201131591">
	<b:glossaryEntry>set up or lay the groundwork for; "establish a new department"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201131797">
	<b:glossaryEntry xml:space='preserve'><![CDATA[set or place definitely; "Let''s fix the date for the party!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201131926">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bring about; "The trompe l''oeil-illusion establishes depth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201132085"
	 b:glossaryEntry="plan, organize, and carry out (an event)"/>
<rdf:Description rdf:about="&a;201132230"
	 b:glossaryEntry='make arrangements for; "Arrange a party for the newly-weds"'/>
<rdf:Description rdf:about="&a;201132372"
	 b:glossaryEntry="make detailed arrangements or preparations"/>
<rdf:Description rdf:about="&a;201132478"
	 b:glossaryEntry="arrange beforehand"/>
<rdf:Description rdf:about="&a;201132564"
	 b:glossaryEntry='arrange in phases or stages: "phase a withdrawal"'/>
<rdf:Description rdf:about="&a;201132676"
	 b:glossaryEntry="call forth"/>
<rdf:Description rdf:about="&a;201132776"
	 b:glossaryEntry="put up"/>
<rdf:Description rdf:about="&a;201132862">
	<b:glossaryEntry xml:space='preserve'><![CDATA[prepare and supply with the necessary equipment for execution or performance; "mount a theater production"; "mount an attack''; "mount a play"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201133093"
	 b:glossaryEntry="rerun a performance of a play, for example"/>
<rdf:Description rdf:about="&a;201133198"
	 b:glossaryEntry="play incorrectly, e.g., play a wrong note"/>
<rdf:Description rdf:about="&a;201133312"
	 b:glossaryEntry='of performances: "They turned in a splendid effort"'/>
<rdf:Description rdf:about="&a;201133437"
	 b:glossaryEntry='give an incentive; "This moved me to sacrifice my career"'/>
<rdf:Description rdf:about="&a;201133626"
	 b:glossaryEntry="urge or force (a person) to an action; constrain or motivate"/>
<rdf:Description rdf:about="&a;201133757">
	<b:glossaryEntry>get off the ground; "Who started this company?" "We embarked on an exciting enterprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201133993"
	 b:glossaryEntry="start playing, as of musicians"/>
<rdf:Description rdf:about="&a;201134102"
	 b:glossaryEntry="enter upon an activity or enterprise"/>
<rdf:Description rdf:about="&a;201134235"
	 b:glossaryEntry="arrange by systematic planning and united effort"/>
<rdf:Description rdf:about="&a;201134449">
	<b:glossaryEntry>prepare or position for action or operation; "lay a fire"; "lay the foundation for a new health care plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201134616">
	<b:glossaryEntry>bring forth, "The apple tree bore delicious apples this year"; "The unidentified plant bore gorgeous flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201134906"
	 b:glossaryEntry="bear seeds"/>
<rdf:Description rdf:about="&a;201134978"
	 b:glossaryEntry='yield crops, of land: "This land crops well"'/>
<rdf:Description rdf:about="&a;201135084"
	 b:glossaryEntry="bear too much"/>
<rdf:Description rdf:about="&a;201135163"
	 b:glossaryEntry="bear fruit, as of trees and plants"/>
<rdf:Description rdf:about="&a;201135260"
	 b:glossaryEntry="cause to bear fruit"/>
<rdf:Description rdf:about="&a;201135342"
	 b:glossaryEntry="make from scratch"/>
<rdf:Description rdf:about="&a;201135771">
	<b:glossaryEntry>put together out of components or parts; "Ford makes cars"; "They manufacture small toys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201135997">
	<b:glossaryEntry>make by shaping or bringing together constituents; "make a dress"; "make a cake"; "make a wall of stones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201136262"
	 b:glossaryEntry='make into a raft; "raft these logs"'/>
<rdf:Description rdf:about="&a;201136359"
	 b:glossaryEntry="make a copy of with the intent to deceive"/>
<rdf:Description rdf:about="&a;201136484">
	<b:glossaryEntry>make by combining materials and parts: "this little pig made his house out of straw"; "Some eccentric constructed an electric brassiere warmer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201136879"
	 b:glossaryEntry='build or establish something abstract; "build a reputation"'/>
<rdf:Description rdf:about="&a;201137013"
	 b:glossaryEntry="build of or with wattle"/>
<rdf:Description rdf:about="&a;201137100"
	 b:glossaryEntry="construct by fitting or uniting parts together"/>
<rdf:Description rdf:about="&a;201137221">
	<b:glossaryEntry>build again; "The house was rebuild after it was hit by a bomb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201137371"
	 b:glossaryEntry='build with groins: "The ceiling was groined"'/>
<rdf:Description rdf:about="&a;201137478">
	<b:glossaryEntry>construct such that only one end is fixed; as of girders and beams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201137612"
	 b:glossaryEntry="destroy completely"/>
<rdf:Description rdf:about="&a;201137704"
	 b:glossaryEntry='make by putting pieces together; "She pieced a quilt"'/>
<rdf:Description rdf:about="&a;201138007">
	<b:glossaryEntry>assemble without order or sense; "She jumbles the words when she is supposed to write a sentence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201138223"
	 b:glossaryEntry="assemble once again, after taking something apart"/>
<rdf:Description rdf:about="&a;201138340">
	<b:glossaryEntry>set up for a particular purpose, as of a plane for a combat mission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201138474"
	 b:glossaryEntry="create by mixing or combining"/>
<rdf:Description rdf:about="&a;201138569"
	 b:glossaryEntry="take apart into its constituent pieces"/>
<rdf:Description rdf:about="&a;201138744">
	<b:glossaryEntry>make out of components; often in an improvising manner; "She made a tent out of a sheet and a few sticks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201138976">
	<b:glossaryEntry>make by tying pieces together: "The fishermen tied their flies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201139100">
	<b:glossaryEntry>cast or model anew; "She had to recast her image to please the electorate in her home state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201139276"
	 b:glossaryEntry="make by hand and with much skill"/>
<rdf:Description rdf:about="&a;201139389"
	 b:glossaryEntry='make something by hand; "We handcraft all our paper"'/>
<rdf:Description rdf:about="&a;201139508"
	 b:glossaryEntry="make barrels and casks"/>
<rdf:Description rdf:about="&a;201139594">
	<b:glossaryEntry>make something, usually for a specific function; "She molded the riceballs carefully"; "Form the dough into cylinders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201140101"
	 b:glossaryEntry="form into a mound, as of earth"/>
<rdf:Description rdf:about="&a;201140212"
	 b:glossaryEntry="form a mound over"/>
<rdf:Description rdf:about="&a;201140305"
	 b:glossaryEntry="form into a hill"/>
<rdf:Description rdf:about="&a;201140383"
	 b:glossaryEntry="shape roughly"/>
<rdf:Description rdf:about="&a;201140463"
	 b:glossaryEntry="shape again or shape differently"/>
<rdf:Description rdf:about="&a;201140569"
	 b:glossaryEntry="of candles; by dipping the wick into hot, liquid wax"/>
<rdf:Description rdf:about="&a;201140682">
	<b:glossaryEntry>used of powdery metals or ores; to cause to become a coherent mass by heating without melting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201140839"
	 b:glossaryEntry='construct, build, or erect; "Raise a barn"'/>
<rdf:Description rdf:about="&a;201140995">
	<b:glossaryEntry>begin, or enable someone else to begin, a venture by providing the means, logistics, etc.; "set up an election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201141178">
	<b:glossaryEntry>erect or construct, esp. as a temporary measure; "Can he rig up a P.A. system?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201141322">
	<b:glossaryEntry>tear down so as to make flat with the ground; "The building was levelled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201141564">
	<b:glossaryEntry>destroy completely, as if down to the roots; "the vestiges of political democracy were soon uprooted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201141775">
	<b:glossaryEntry>bring into a condition of decay or partial ruin by neglect or misuse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201141919"
	 b:glossaryEntry="press from a plastic, as of records"/>
<rdf:Description rdf:about="&a;201142037"
	 b:glossaryEntry="make by pouring into a cast or mold"/>
<rdf:Description rdf:about="&a;201142203"
	 b:glossaryEntry='cast again: "The bell cracked and had to be recast"'/>
<rdf:Description rdf:about="&a;201142337"
	 b:glossaryEntry="pour molten metal into a mold of sand"/>
<rdf:Description rdf:about="&a;201142441"
	 b:glossaryEntry="make on a potter''s wheel; of pottery"/>
<rdf:Description rdf:about="&a;201142540"
	 b:glossaryEntry="make without a wheel; of pottery"/>
<rdf:Description rdf:about="&a;201142646"
	 b:glossaryEntry='prepare with dry heat in an oven; "bake a cake"'/>
<rdf:Description rdf:about="&a;201142763"
	 b:glossaryEntry="prepare by brewing; of alcoholic beverages"/>
<rdf:Description rdf:about="&a;201142893">
	<b:glossaryEntry>prepare for eating by applying heat; "Cook me dinner, please"; "can you make me an omelette?" "fix breakfast for the guests, please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201143244">
	<b:glossaryEntry>put on the stove or ready for cooking; "put on the tea, please!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201143372"
	 b:glossaryEntry="prepare for eating if or as if a spatchcock, of foul"/>
<rdf:Description rdf:about="&a;201143492"
	 b:glossaryEntry='coat or stuff with a spicy paste: "devilled eggs"'/>
<rdf:Description rdf:about="&a;201143604">
	<b:glossaryEntry xml:space='preserve'><![CDATA[prepare a hot meal; "My husband doesn''t cook"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201143729">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cook beforehand so that the actual preparation won''t take long; "precook the rice"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201143876"
	 b:glossaryEntry="prepare or cook quickly or hastily"/>
<rdf:Description rdf:about="&a;201143986">
	<b:glossaryEntry>prepare or cook by mixing ingredients; "concoct a strange mixture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201144127"
	 b:glossaryEntry="create with cloth; of textiles"/>
<rdf:Description rdf:about="&a;201144285"
	 b:glossaryEntry='make by sewing together quickly; "run up a skirt"'/>
<rdf:Description rdf:about="&a;201144398">
	<b:glossaryEntry>style and tailor in a certain fashion; "cut a dress"; "style a wedding dress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201144571"
	 b:glossaryEntry="make stylish; in fashion or hairdressing"/>
<rdf:Description rdf:about="&a;201144692"
	 b:glossaryEntry='make an alteration to; "This dress needs to be altered"'/>
<rdf:Description rdf:about="&a;201144828"
	 b:glossaryEntry="create by stitching together"/>
<rdf:Description rdf:about="&a;201144937"
	 b:glossaryEntry="stitch or sew together; of textiles"/>
<rdf:Description rdf:about="&a;201145053"
	 b:glossaryEntry="decorate with needlework"/>
<rdf:Description rdf:about="&a;201145208"
	 b:glossaryEntry="embroider with gold or silver thread"/>
<rdf:Description rdf:about="&a;201145306"
	 b:glossaryEntry="edge or border with gold or silver embroidery"/>
<rdf:Description rdf:about="&a;201145413"
	 b:glossaryEntry="e.g., illustrate a book with drawings"/>
<rdf:Description rdf:about="&a;201145518">
	<b:glossaryEntry>shape, form, or improve something: "work stone into tools"; "process iron"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201145764"
	 b:glossaryEntry='use too much; "This play has been overworked"'/>
<rdf:Description rdf:about="&a;201145875"
	 b:glossaryEntry='use again in altered form; "retread an old plot"'/>
