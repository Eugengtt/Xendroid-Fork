<rdf:Description rdf:about="&a;200757654"
	 b:glossaryEntry="refuse to back down; remain solid under criticism or attack"/>
<rdf:Description rdf:about="&a;200757787"
	 b:glossaryEntry='resist bravely; "He outbraved the enemy"'/>
<rdf:Description rdf:about="&a;200757893">
