</rdf:Description>
<rdf:Description rdf:about="&a;400377052">
	<b:glossaryEntry>without being seen; "these organisms enter the body invisibly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400377188"
	 b:glossaryEntry='in a visible manner; "he was visibly upset"'/>
<rdf:Description rdf:about="&a;400377303">
