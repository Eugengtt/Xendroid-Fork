	<b:glossaryEntry>any of several South African plants of the genus Ixia having grasslike leaves and clusters of showy variously colored lilylike flowers; widely cultivated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108719930"
	 b:glossaryEntry="chiefly North American grasslike herbs"/>
<rdf:Description rdf:about="&a;108720086"
	 b:glossaryEntry="plant with grasslike foliage and delicate blue flowers"/>
<rdf:Description rdf:about="&a;108720221"
	 b:glossaryEntry="deciduous perennial herbs of South Africa"/>
<rdf:Description rdf:about="&a;108720372">
