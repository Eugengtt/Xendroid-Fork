<rdf:Description rdf:about="&a;200984362"
	 b:glossaryEntry="bring to a certain spiritual state"/>
<rdf:Description rdf:about="&a;200984463"
	 b:glossaryEntry="bring in through pipes, as of liquids such as oil"/>
<rdf:Description rdf:about="&a;200984577"
	 b:glossaryEntry="release something from a container"/>
<rdf:Description rdf:about="&a;200984719">
