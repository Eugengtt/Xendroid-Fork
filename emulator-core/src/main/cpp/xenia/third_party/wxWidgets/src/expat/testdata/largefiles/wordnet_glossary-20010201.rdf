<rdf:Description rdf:about="&a;103899612"
	 b:glossaryEntry="barely audible"/>
<rdf:Description rdf:about="&a;103899682"
	 b:glossaryEntry="(music) a gradual decrease in loudness"/>
<rdf:Description rdf:about="&a;103899791"
	 b:glossaryEntry="(music) low loudness"/>
