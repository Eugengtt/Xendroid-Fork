</rdf:Description>
<rdf:Description rdf:about="&a;108747776">
	<b:glossaryEntry>any of several plants of the genus Calochortus having tulip-shaped flowers with 3 sepals and 3 petals; southwestern United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108748095">
