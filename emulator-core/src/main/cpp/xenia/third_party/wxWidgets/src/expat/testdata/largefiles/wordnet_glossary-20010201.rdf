	 b:glossaryEntry="an island in Antigua and Barbuda"/>
<rdf:Description rdf:about="&a;106409415">
	<b:glossaryEntry>the capital of Antigua and Barbuda; located on the island of Antigua</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106409574">
	<b:glossaryEntry>a region whose eastern part is Bangladesh and western part is included in India</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106409706">
	<b:glossaryEntry>a group of islands in the Atlantic off the Carolina coast; British colony; a popular resort</b:glossaryEntry>
