	<b:glossaryEntry>the land around a house or other building; "it was a small house with almost no yard at all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103639249">
	<b:glossaryEntry>an area having a network of railway tracks and sidings for storage and maintenance of cars and engines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103639435"
	 b:glossaryEntry="either end of the yard of a square-rigged ship"/>
<rdf:Description rdf:about="&a;103639554"
	 b:glossaryEntry="fabrics sold by the yard"/>
<rdf:Description rdf:about="&a;103639649"
	 b:glossaryEntry="a three-foot-long measuring stick or tape etc"/>
<rdf:Description rdf:about="&a;103639765"
	 b:glossaryEntry="a skullcap worn by religious Jews (especially at prayer)"/>
<rdf:Description rdf:about="&a;103639898"
	 b:glossaryEntry="the face veil worn by Muslim women"/>
<rdf:Description rdf:about="&a;103639996"
	 b:glossaryEntry="a long Turkish knife with a curved single-edged blade"/>
<rdf:Description rdf:about="&a;103640104"
	 b:glossaryEntry="a two-masted sailing vessel"/>
<rdf:Description rdf:about="&a;103640182"
	 b:glossaryEntry="a ship''s small boat (usually rowed by 4 or 6 oars)"/>
<rdf:Description rdf:about="&a;103640301"
	 b:glossaryEntry="yellow flag hoist on a ship in quarantine"/>
<rdf:Description rdf:about="&a;103640400"
	 b:glossaryEntry="an amount of a product"/>
<rdf:Description rdf:about="&a;103640482">
	<b:glossaryEntry>joins two draft animals at the neck so they can work together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103640594"
	 b:glossaryEntry="a fitted part at the top of a garment"/>
<rdf:Description rdf:about="&a;103640719"
	 b:glossaryEntry="connects two things so they move together"/>
<rdf:Description rdf:about="&a;103640822">
	<b:glossaryEntry>a wooden frame across the shoulders that enables a person to carry buckets hanging from each end</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103640969">
	<b:glossaryEntry>a toy consisting of a spool that is reeled up and down on a string by motions of the hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103641110">
	<b:glossaryEntry>(Middle East) an ornamental metal cup-shaped holder for a hot coffee cup</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103641233">
	<b:glossaryEntry>a large rigid dirigible designed to carry passengers or bombs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103641365">
	<b:glossaryEntry>one of a pair of small metallic cymbals worn on the thumb and middle finger; used in belly dancing in rhythm with the dance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103641539">
	<b:glossaryEntry>an ointment containing zinc that is used to treat certain skin diseases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103641670"
	 b:glossaryEntry="a crude homemade pistol"/>
<rdf:Description rdf:about="&a;103641747">
	<b:glossaryEntry>a musical instrument with strings stretch over a flat sounding box; played with a plectrum and with fingers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103641944">
	<b:glossaryEntry>(astrology) a circular diagram representing the 12 zodiacal constellations and showing their signs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103642095"
	 b:glossaryEntry="a flashy suit of extreme cut"/>
<rdf:Description rdf:about="&a;103642179"
	 b:glossaryEntry="a distinguishing feature of one''s personal nature"/>
<rdf:Description rdf:about="&a;103643019">
	<b:glossaryEntry>(genetics) a character inherited on an all-or-none basis and dependent on the presence of a single gene</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103643183">
	<b:glossaryEntry>any attribute or quality considered as having its own existence: "the thing I like about her is ..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103643335"
	 b:glossaryEntry="an attribute that is common to all members of a category"/>
<rdf:Description rdf:about="&a;103643456">
	<b:glossaryEntry>the complex of all the attributes--behavioral, temperamental, emotional and mental--that characterize a unique individual; "their different reactions reflected their very different personalities"; "it is his nature to help others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103643928">
	<b:glossaryEntry>the distinct personality of an individual regarded as a persisting entity: "you can lose your identity when you join the army"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103644161">
	<b:glossaryEntry>attribution to yourself (consciously or unconsciously) of the characteristics of another person (or group of persons)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103644339">
	<b:glossaryEntry>being a person: "finding her own personhood as a campus activist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103644461">
	<b:glossaryEntry>the complex of attributes that make a person socially attractive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103644605">
	<b:glossaryEntry>(psychoanalysis) a personality characterized by meticulous neatness and suspicion and reserve; formed in early childhood by fixation during the anal stage of development (as a consequence of toilet training)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103644904">
	<b:glossaryEntry>(psychoanalysis) the mature personality which is not dominated by infantile pleasure drives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103645061">
	<b:glossaryEntry>(psychoanalysis) a personality characterized either by generous optimism or aggressive and ambitious selfishness; formed in early childhood by fixation during the oral stage of development</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103645312">
	<b:glossaryEntry>the inherent complex of attributes that determine a persons moral and ethical actions and reactions: "educaton has for its object the formation of character"- Herbert Spencer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103645652">
	<b:glossaryEntry>a fundamental emotional and activating principle determining one''s character</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103645817">
	<b:glossaryEntry>concern with or responsiveness to outward things esp material objects as opposed to ideal concepts: "hearty showmanship and all-round outwardness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103646057">
	<b:glossaryEntry xml:space='preserve'><![CDATA[preoccupation with what concerns human inner nature esp ethical or ideological values: "Socrates'' inwardness, integrity, and inquisitiveness"- H.R.Finch]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103646320"
	 b:glossaryEntry="concern with things of the spirit"/>
<rdf:Description rdf:about="&a;103646431">
	<b:glossaryEntry>an extroverted disposition; concern with what is outside the self</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103646609">
	<b:glossaryEntry>an introverted disposition; concern with one''s own thoughts and feelings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103646812">
	<b:glossaryEntry>a balanced disposition intermediate between extroversion and introversion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103646979"
	 b:glossaryEntry="the disposition to enjoy being alone"/>
<rdf:Description rdf:about="&a;103647110"
	 b:glossaryEntry="a disposition toward being alone"/>
<rdf:Description rdf:about="&a;103647237"
	 b:glossaryEntry="being without friends"/>
<rdf:Description rdf:about="&a;103647319"
	 b:glossaryEntry="preference for seclusion or isolation"/>
<rdf:Description rdf:about="&a;103647446">
	<b:glossaryEntry>the quality of being secluded from the presence or view of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103647591">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the complex of emotional and intellectual attributes that determine a person''s characteristic actions and reactions: "it is his nature to help others"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103647903">
	<b:glossaryEntry>the physical (or animal) side of a person as opposed to the spirit or intellect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103648054"
	 b:glossaryEntry='your usual mood; "he has a happy disposition"'/>
<rdf:Description rdf:about="&a;103648677">
	<b:glossaryEntry>preoccupation with satisfaction of physical drives and appetites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103648811">
	<b:glossaryEntry>an inclination or tendency of a certain kind; "he had a change of heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103648944"
	 b:glossaryEntry="a sensitive or highly strung temperament"/>
<rdf:Description rdf:about="&a;103649078">
	<b:glossaryEntry>the spirit of a group that makes the members want the group to succeed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103649233"
	 b:glossaryEntry="inability to rest or relax or be still"/>
<rdf:Description rdf:about="&a;103649361">
	<b:glossaryEntry>(pathology) extremely restless tossing and twitching usually by a person with a severe illness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103649525"
	 b:glossaryEntry="characterized by nervousness and quickness to take fright"/>
<rdf:Description rdf:about="&a;103649655"
	 b:glossaryEntry="the trait of acting compulsively"/>
<rdf:Description rdf:about="&a;103649781"
	 b:glossaryEntry="extreme compulsiveness"/>
<rdf:Description rdf:about="&a;103649877"
	 b:glossaryEntry="emotional nature or quality"/>
<rdf:Description rdf:about="&a;103650230"
	 b:glossaryEntry="the quality of being arresting or highly emotional"/>
<rdf:Description rdf:about="&a;103650368"
	 b:glossaryEntry="tending to express your feelings freely"/>
<rdf:Description rdf:about="&a;103650471"
	 b:glossaryEntry="a quality proceeding from feelings of affection or love"/>
<rdf:Description rdf:about="&a;103650658"
	 b:glossaryEntry="a tendency to express warm and affectionate feeling"/>
<rdf:Description rdf:about="&a;103650766">
	<b:glossaryEntry>foolish fondness for or excessive submissiveness to one''s wife</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103650887"
	 b:glossaryEntry="falsely emotional in a maudlin way"/>
<rdf:Description rdf:about="&a;103651014"
	 b:glossaryEntry="(informal) excessive sentimentality"/>
<rdf:Description rdf:about="&a;103651126"
	 b:glossaryEntry="intense passion or emotion"/>
<rdf:Description rdf:about="&a;103651222">
	<b:glossaryEntry>excessive emotionalism or irritability and excitability (especially when displayed openly)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103651370"
	 b:glossaryEntry="temperamental and changeable"/>
<rdf:Description rdf:about="&a;103651454"
	 b:glossaryEntry='temperament or disposition; "a person of hot blood"'/>
<rdf:Description rdf:about="&a;103651557"
	 b:glossaryEntry="being easily excited"/>
<rdf:Description rdf:about="&a;103651683">
	<b:glossaryEntry>being highly angry or excited; ready to boil over; "after an hour of waiting I was at the boiling point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103651847"
	 b:glossaryEntry="absence of emotion"/>
<rdf:Description rdf:about="&a;103652034">
	<b:glossaryEntry>the trait of exhibiting no personal embarrassment or concern; "the blandness of his confession enraged the judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103652203"
	 b:glossaryEntry="a lack of passion or enthusiasm"/>
<rdf:Description rdf:about="&a;103652330"
	 b:glossaryEntry="objectivity and detachment"/>
<rdf:Description rdf:about="&a;103652433"
	 b:glossaryEntry="an indifference to pleasure or pain"/>
<rdf:Description rdf:about="&a;103652548"
	 b:glossaryEntry="lack of passion, force or animation"/>
<rdf:Description rdf:about="&a;103652654">
	<b:glossaryEntry>the quality of being cheerful and dispelling gloom; "flowers added a note of cheerfulness to the drab room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103652919"
	 b:glossaryEntry="a cheerful willingness to be obliging"/>
<rdf:Description rdf:about="&a;103653078"
	 b:glossaryEntry="not conducive to cheer or good spirits"/>
<rdf:Description rdf:about="&a;103653232"
	 b:glossaryEntry="excessive sadness and mournfulness"/>
<rdf:Description rdf:about="&a;103653340"
	 b:glossaryEntry="quality of being active or spirited or vigorous"/>
<rdf:Description rdf:about="&a;103653530"
	 b:glossaryEntry="cheerful and lively"/>
<rdf:Description rdf:about="&a;103653606">
	<b:glossaryEntry>animation and energy in action or expression; "it was a heavy play and the actors tried in vain to give life to it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103654008"
	 b:glossaryEntry="lightness in movement or manner"/>
<rdf:Description rdf:about="&a;103654105"
	 b:glossaryEntry='liveliness and eagerness; "he accepted with alacrity"'/>
<rdf:Description rdf:about="&a;103654225">
	<b:glossaryEntry>an imaginative lively style (especially style of writing); "his writing conveys great energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103654412"
	 b:glossaryEntry="an energetic style"/>
<rdf:Description rdf:about="&a;103654511">
	<b:glossaryEntry>enthusiastic and assured vigor and liveliness; "a performance of great elan and sophistication"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103654657"
	 b:glossaryEntry="liveliness of mind or spirit"/>
<rdf:Description rdf:about="&a;103654738"
	 b:glossaryEntry='a breezy liveliness; "a delightful breeziness of manner"'/>
<rdf:Description rdf:about="&a;103654864">
	<b:glossaryEntry>irrepressible liveliness and good spirit; "I admired his bouyancy and persistent good humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103655056"
	 b:glossaryEntry="exuberant liveliness"/>
<rdf:Description rdf:about="&a;103655191"
	 b:glossaryEntry="characterized by high spirits and animation"/>
<rdf:Description rdf:about="&a;103655289"
	 b:glossaryEntry="courageous high-spiritedness"/>
<rdf:Description rdf:about="&a;103655378"
	 b:glossaryEntry="overflowing with enthusiasm"/>
<rdf:Description rdf:about="&a;103655506"
	 b:glossaryEntry="unrestrained and exaggerated enthusiasm"/>
<rdf:Description rdf:about="&a;103655600">
	<b:glossaryEntry>liveliness and energy; "this tonic is guaranteed to give you more pep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103655741"
	 b:glossaryEntry="exhaustion resulting from lack of food"/>
<rdf:Description rdf:about="&a;103655835">
	<b:glossaryEntry>the trait of being active; moving or acting rapidly and energetically; "the level of activity declines with age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103656123"
	 b:glossaryEntry="a activeness of an energetic personality"/>
<rdf:Description rdf:about="&a;103656252">
	<b:glossaryEntry>a disposition to remain inactive or inert; "he had to overcome his inertia and get back to work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103656520"
	 b:glossaryEntry="an unusual lack of energy"/>
<rdf:Description rdf:about="&a;103656625">
	<b:glossaryEntry>the attribute of being restful; "he longed for the restfulness of home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103656754"
	 b:glossaryEntry="the trait of remaining inactive; a lack of initiative"/>
<rdf:Description rdf:about="&a;103656931">
	<b:glossaryEntry>the trait of lacking enthusiasm for or interest in things generally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103657083">
	<b:glossaryEntry>inactivity resulting from torpidity and lack of vigor or energy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103657239"
	 b:glossaryEntry="inactivity resulting from a dislike of work"/>
<rdf:Description rdf:about="&a;103657385"
	 b:glossaryEntry="the trait of being idle out of a reluctance to work"/>
<rdf:Description rdf:about="&a;103657503"
	 b:glossaryEntry="a disinclination to work or exert yourself"/>
<rdf:Description rdf:about="&a;103657612">
	<b:glossaryEntry>a failure to be active as a consequence of lack of initiative or ambition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103657745">
	<b:glossaryEntry>a disposition to feel that anything less than perfect is unacceptable; "his perfectionism seemed excessive to his students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103657928"
	 b:glossaryEntry="a disposition to allow freedom of choice and behavior"/>
<rdf:Description rdf:about="&a;103658162"
	 b:glossaryEntry="a disposition to tolerate or accept people or situations"/>
<rdf:Description rdf:about="&a;103658319"
	 b:glossaryEntry="an acceptance of yourself as you are, warts and all"/>
<rdf:Description rdf:about="&a;103658432">
	<b:glossaryEntry>a disposition to yield to the wishes of someone; "too much indulgence spoils a child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103658614">
	<b:glossaryEntry>a disposition to be lenient in judging others; "softness is not something permitted of good leaders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103658769"
	 b:glossaryEntry="too much permissiveness"/>
<rdf:Description rdf:about="&a;103658852"
	 b:glossaryEntry="lack of permissiveness or indulgence"/>
<rdf:Description rdf:about="&a;103658987"
	 b:glossaryEntry="uncompromising resolution"/>
<rdf:Description rdf:about="&a;103659117"
	 b:glossaryEntry="strictness and austerity in conduct and religion"/>
<rdf:Description rdf:about="&a;103659222">
	<b:glossaryEntry>excessive sternness; "the severity of his punishment was inhuman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103659390"
	 b:glossaryEntry="a cheerful, obliging disposition"/>
<rdf:Description rdf:about="&a;103659570">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a disposition to kindness and compassion; benign good will: "the victor''s grace in treating the vanquished"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103659752"
	 b:glossaryEntry="good-natured tolerance of delay or incompetence"/>
<rdf:Description rdf:about="&a;103659900"
	 b:glossaryEntry="being without worry or concern"/>
<rdf:Description rdf:about="&a;103659990"
	 b:glossaryEntry="a disposition to laugh"/>
<rdf:Description rdf:about="&a;103660069"
	 b:glossaryEntry="a temperamental disposition to be agreeable"/>
<rdf:Description rdf:about="&a;103660241"
	 b:glossaryEntry="a disposition or tendency to yield to the will of others"/>
<rdf:Description rdf:about="&a;103660409"
	 b:glossaryEntry="a disagreeable, irritable, or malevolent disposition"/>
<rdf:Description rdf:about="&a;103660662"
	 b:glossaryEntry="a disposition to be ill tempered"/>
<rdf:Description rdf:about="&a;103660777"
	 b:glossaryEntry="a fussy and eccentric disposition"/>
<rdf:Description rdf:about="&a;103660911"
	 b:glossaryEntry="a sullen moody resentful disposition"/>
<rdf:Description rdf:about="&a;103661040">
	<b:glossaryEntry>a disposition to exhibit uncontrolled anger; "his temper was well known to all his employees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103661288"
	 b:glossaryEntry="a dislike of anything that causes delay"/>
<rdf:Description rdf:about="&a;103661420">
	<b:glossaryEntry>impatience with annoyances: "his intolerance of interruptions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103661540"
	 b:glossaryEntry="a nature given to nagging or scolding"/>
<rdf:Description rdf:about="&a;103661636"
	 b:glossaryEntry="the quality of being given to complaining"/>
<rdf:Description rdf:about="&a;103661737"
	 b:glossaryEntry="harshness of manner"/>
<rdf:Description rdf:about="&a;103661841"
	 b:glossaryEntry="an ill-tempered and offensive disposition"/>
<rdf:Description rdf:about="&a;103662017"
	 b:glossaryEntry="a sharp and bitter manner"/>
<rdf:Description rdf:about="&a;103662132"
	 b:glossaryEntry="a disposition to fight"/>
<rdf:Description rdf:about="&a;103662296"
	 b:glossaryEntry="obstreperous and defiant aggressiveness"/>
<rdf:Description rdf:about="&a;103662405"
	 b:glossaryEntry='cheerful compliance: "he expressed his willingness to help"'/>
<rdf:Description rdf:about="&a;103662594"
	 b:glossaryEntry='prompt willingness: "readiness to continue discussions"'/>
<rdf:Description rdf:about="&a;103662705">
	<b:glossaryEntry>willingness or readiness to receive esp impressions or ideas: "their receptivity to the proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103662887"
	 b:glossaryEntry="undivided commitment or unreserved enthusiasm"/>
<rdf:Description rdf:about="&a;103662995">
	<b:glossaryEntry>the trait of being unwilling; "his unwillingness to cooperate vetoed every proposal I made"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103663200">
	<b:glossaryEntry>a certain degree of unwillingness; "a reluctance to commit himself"; "after some hesitation he agreed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103663435">
	<b:glossaryEntry>(psychiatry) an unwillingness to bring repressed feelings into conscious awareness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103663574">
	<b:glossaryEntry>the trait of being serious; "a lack of solemnity is not necessarily a lack of seriousness"- Robert Rice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103663890">
	<b:glossaryEntry>the trait of sincere and steadfast fixity of purpose; "a man of energy and commitment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103664048"
	 b:glossaryEntry="a manner that is serious and solemn"/>
<rdf:Description rdf:about="&a;103664203"
	 b:glossaryEntry="a trait of dignified seriousness"/>
<rdf:Description rdf:about="&a;103664328"
	 b:glossaryEntry="dull and pompous gravity"/>
<rdf:Description rdf:about="&a;103664422"
	 b:glossaryEntry="the trait of being frivolous; not serious or sensible"/>
<rdf:Description rdf:about="&a;103664619"
	 b:glossaryEntry="an impulsive scatterbrained manner"/>
<rdf:Description rdf:about="&a;103664739"
	 b:glossaryEntry="the trait of being lighthearted and frivolous"/>
<rdf:Description rdf:about="&a;103664844"
	 b:glossaryEntry="lightness of manner"/>
<rdf:Description rdf:about="&a;103664952"
	 b:glossaryEntry="inappropriate levity"/>
<rdf:Description rdf:about="&a;103665047"
	 b:glossaryEntry="the trait of merry joking"/>
<rdf:Description rdf:about="&a;103665167">
	<b:glossaryEntry>a disposition to find (or make) causes for amusement; "her playfulness surprised me"; "he was fun to be with"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103665466"
	 b:glossaryEntry="playful humor"/>
<rdf:Description rdf:about="&a;103665539"
	 b:glossaryEntry="inappropriate playfulness"/>
<rdf:Description rdf:about="&a;103665669"
	 b:glossaryEntry="lively high-spirited playfulness"/>
<rdf:Description rdf:about="&a;103665790"
	 b:glossaryEntry="the trait of behaving like an imp"/>
<rdf:Description rdf:about="&a;103665927">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the trait of appreciating (and being able to express) the humorous; "she didn''t appreciate my humor;" "you can''t survive in the army without a sense of humor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103666181"
	 b:glossaryEntry="the trait of being communicative"/>
<rdf:Description rdf:about="&a;103666367"
	 b:glossaryEntry="the trait of being blunt and outspoken"/>
<rdf:Description rdf:about="&a;103666495"
	 b:glossaryEntry="good-natured frankness"/>
<rdf:Description rdf:about="&a;103666573"
	 b:glossaryEntry="a friendly open trait of a talkative person"/>
<rdf:Description rdf:about="&a;103666691"
	 b:glossaryEntry="the quality of being facile in speech and writing"/>
<rdf:Description rdf:about="&a;103666824"
	 b:glossaryEntry="the quality of being wordy and talkative"/>
<rdf:Description rdf:about="&a;103666981"
	 b:glossaryEntry="the trait of being uncommunicative"/>
<rdf:Description rdf:about="&a;103667153">
	<b:glossaryEntry>a refusal to speak when expected; "his silence about my contribution was surprising"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103667302"
	 b:glossaryEntry="the trait of keeping things secret"/>
<rdf:Description rdf:about="&a;103667434">
	<b:glossaryEntry xml:space='preserve'><![CDATA[secrecy; "mum''s the word"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103667509">
	<b:glossaryEntry>the trait of being uncommunicative; not volunteering anything more than necessary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103667670">
	<b:glossaryEntry>the tendency to associate with others and to form social groups: "mammals as a class are not strong on sociality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103667893">
	<b:glossaryEntry>the relative tendency or disposition to be sociable or associate with one''s fellows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103668248"
	 b:glossaryEntry="a jovial nature"/>
<rdf:Description rdf:about="&a;103668334"
	 b:glossaryEntry="suitability to be a companion"/>
<rdf:Description rdf:about="&a;103668446"
	 b:glossaryEntry="the quality of affording easy familiarity and sociability"/>
<rdf:Description rdf:about="&a;103668602">
	<b:glossaryEntry>the quality of being gregarious--having a dislike of being alone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103668763">
	<b:glossaryEntry>characterized by an attitude of ready accessibility esp about one''s actions or purposes; not secretive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103668938"
	 b:glossaryEntry="a friendly disposition"/>
<rdf:Description rdf:about="&a;103669235">
	<b:glossaryEntry>a disposition to be friendly and approachable (easy to talk to)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103669437">
	<b:glossaryEntry>having a disposition characterized by warmth and friendliness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103669571">
	<b:glossaryEntry>close or warm friendship; "the absence of fences created a mysterious intimacy in which no one knew privacy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103669778"
	 b:glossaryEntry="spirit of friendly familiarity and goodwill between comrades"/>
<rdf:Description rdf:about="&a;103669914"
	 b:glossaryEntry="the attribute of being easy to meet or deal with"/>
<rdf:Description rdf:about="&a;103670058"
	 b:glossaryEntry="a congenial disposition"/>
<rdf:Description rdf:about="&a;103670158"
	 b:glossaryEntry="a cordial disposition"/>
<rdf:Description rdf:about="&a;103670244"
	 b:glossaryEntry="a disposition to be friendly and helpful to neighbors"/>
<rdf:Description rdf:about="&a;103670439">
	<b:glossaryEntry>a disposition that welcomes guests and is fond of entertaining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103670580">
	<b:glossaryEntry>a mild reasonableness; "when he learned who I was he became all sweetness and light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103670730">
	<b:glossaryEntry>an unsociable disposition; avoiding friendship or companionship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103670942"
	 b:glossaryEntry="a disposition to be distant and unsympathetic in manner"/>
<rdf:Description rdf:about="&a;103671118">
	<b:glossaryEntry>a disposition to be unapproachable; unfriendly and inaccessible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103671263">
	<b:glossaryEntry>characterized by a lack of openness esp about one''s actions or purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103671442">
	<b:glossaryEntry>a disposition to be sly and stealthy and to do things surreptitiously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103671597"
	 b:glossaryEntry="an unfriendly disposition"/>
<rdf:Description rdf:about="&a;103671809">
	<b:glossaryEntry>a hostile (very unfriendly) disposition; "he could not conceal his hostility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103671971"
	 b:glossaryEntry="a disposition to behave aggressively"/>
<rdf:Description rdf:about="&a;103672064"
	 b:glossaryEntry='extreme hostility; "the virulence of the malicious old man"'/>
<rdf:Description rdf:about="&a;103672179"
	 b:glossaryEntry="a disposition to dislike and mistrust other people"/>
<rdf:Description rdf:about="&a;103672287"
	 b:glossaryEntry="a disposition not to be congenial"/>
<rdf:Description rdf:about="&a;103672399"
	 b:glossaryEntry="an unneighborly disposition"/>
<rdf:Description rdf:about="&a;103672507"
	 b:glossaryEntry="an inhospitable disposition"/>
<rdf:Description rdf:about="&a;103672615">
	<b:glossaryEntry>the ability to change or be changed to fit changed circumstances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103672792">
	<b:glossaryEntry>the quality of being adaptable or variable; "he enjoyed the flexibility of his working arrangement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103672967"
	 b:glossaryEntry="the quality of being easily adaptable"/>
<rdf:Description rdf:about="&a;103673084">
	<b:glossaryEntry>the inability to change or be changed to fit changed circumstances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103673247"
	 b:glossaryEntry="the quality of being rigid and rigorously severe"/>
<rdf:Description rdf:about="&a;103673384"
	 b:glossaryEntry="the trait of thinking carefully before acting"/>
<rdf:Description rdf:about="&a;103673617"
	 b:glossaryEntry="deep serious thoughtfulness"/>
<rdf:Description rdf:about="&a;103673739"
	 b:glossaryEntry="thoughtfulness about your own situation and feelings"/>
<rdf:Description rdf:about="&a;103673891">
	<b:glossaryEntry>the trait of thoughtfulness in action or decision; "he was a man of judicial deliberation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103674075"
	 b:glossaryEntry="expressive of intentions"/>
<rdf:Description rdf:about="&a;103674196"
	 b:glossaryEntry="the trait of not thinking carefully before acting"/>
<rdf:Description rdf:about="&a;103674380"
	 b:glossaryEntry="the trait of giving little thought to danger"/>
<rdf:Description rdf:about="&a;103674564"
	 b:glossaryEntry="recklessness in politics or foreign affairs"/>
<rdf:Description rdf:about="&a;103674665"
	 b:glossaryEntry="the trait of being rash and hasty"/>
<rdf:Description rdf:about="&a;103674754"
	 b:glossaryEntry='desperate recklessness; "it was a policy of desperation"'/>
<rdf:Description rdf:about="&a;103674868"
	 b:glossaryEntry="the trait of acting suddenly on impulse without reflection"/>
<rdf:Description rdf:about="&a;103675022"
	 b:glossaryEntry="rash impulsiveness"/>
<rdf:Description rdf:about="&a;103675114"
	 b:glossaryEntry="hasty impulsiveness"/>
<rdf:Description rdf:about="&a;103675189"
	 b:glossaryEntry="the trait of being observant and paying attention"/>
<rdf:Description rdf:about="&a;103675442"
	 b:glossaryEntry="the trait of being considerate and thoughtful of others"/>
<rdf:Description rdf:about="&a;103675557"
	 b:glossaryEntry="the trait of not being considerate and thoughtful of others"/>
<rdf:Description rdf:about="&a;103675696">
	<b:glossaryEntry>the quality of being careful and painstaking; "I admired the carefulness of his work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103675911">
	<b:glossaryEntry>the trait of staying aware of (paying close attention to) your responsibilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103676134">
	<b:glossaryEntry>the trait of being cautious; being attentive to possible danger; "a man of caution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103676318"
	 b:glossaryEntry="the trait of practicing caution in advance"/>
<rdf:Description rdf:about="&a;103676417"
	 b:glossaryEntry="the trait of being cautious and watchful"/>
<rdf:Description rdf:about="&a;103676578"
	 b:glossaryEntry="lively attentiveness"/>
<rdf:Description rdf:about="&a;103676672">
	<b:glossaryEntry>vigilant attentiveness; "he keeps a weather eye open for trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103676822"
	 b:glossaryEntry="the quality of not being careful or taking pains"/>
<rdf:Description rdf:about="&a;103677001"
	 b:glossaryEntry="the trait of forgetting or ignoring possible danger"/>
<rdf:Description rdf:about="&a;103677179"
	 b:glossaryEntry="the trait of not being cautious and watchful"/>
<rdf:Description rdf:about="&a;103677298"
	 b:glossaryEntry="the trait of forgetting or ignoring your responsibilities"/>
<rdf:Description rdf:about="&a;103677496"
	 b:glossaryEntry="the trait of neglecting responsibilities and lacking concern"/>
<rdf:Description rdf:about="&a;103677676">
	<b:glossaryEntry>a tendency to be negligent and uncaring; "he inherited his delinquency from his father"; "his derelictions were not really intended as crimes"; "his adolescent protest consisted of willful neglect of all his responsibilities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103677991"
	 b:glossaryEntry="the quality of being lax and neglectful"/>
<rdf:Description rdf:about="&a;103678106"
	 b:glossaryEntry="the trait of behaving in ways considered typical for men"/>
<rdf:Description rdf:about="&a;103678310">
	<b:glossaryEntry>the trait of being manly; having the characteristics of an adult male</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103678459"
	 b:glossaryEntry="being characteristic of a boy"/>
<rdf:Description rdf:about="&a;103678545"
	 b:glossaryEntry="exaggerated masculinity"/>
<rdf:Description rdf:about="&a;103678623"
	 b:glossaryEntry="masculinity in women (especially in girls and young women)"/>
<rdf:Description rdf:about="&a;103678753"
	 b:glossaryEntry="the trait of behaving in ways considered typical for women"/>
<rdf:Description rdf:about="&a;103678976">
	<b:glossaryEntry>the trait of being womanly; having the characteristics of an adult female</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103679119"
	 b:glossaryEntry="behavior befitting a lady"/>
<rdf:Description rdf:about="&a;103679203"
	 b:glossaryEntry="behavior befitting a young maiden"/>
<rdf:Description rdf:about="&a;103679295"
	 b:glossaryEntry="being characteristic of a girl"/>
<rdf:Description rdf:about="&a;103679383"
	 b:glossaryEntry="the trait of being effeminate (derogatory of a man)"/>
<rdf:Description rdf:about="&a;103679549"
	 b:glossaryEntry="the trait of deserving trust and confidence"/>
<rdf:Description rdf:about="&a;103679739"
	 b:glossaryEntry="trustworthiness with money"/>
<rdf:Description rdf:about="&a;103679828">
	<b:glossaryEntry xml:space='preserve'><![CDATA[ability or necessity to answer for or be responsible for one''s conduct; "he holds a position of great responsibility"; "young children on a farm are often given responsibilities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103680230">
	<b:glossaryEntry xml:space='preserve'><![CDATA[responsibility for a bad situation or event; "it was John''s fault"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103680348"
	 b:glossaryEntry="responsibility to someone or for some activity"/>
<rdf:Description rdf:about="&a;103680488"
	 b:glossaryEntry="the trait of being dependable or reliable"/>
<rdf:Description rdf:about="&a;103680743"
	 b:glossaryEntry="the trait of not deserving trust or confidence"/>
<rdf:Description rdf:about="&a;103680922"
	 b:glossaryEntry="the trait of lacking a sense of responsibility"/>
<rdf:Description rdf:about="&a;103681159"
	 b:glossaryEntry="the trait of not being dependable or reliable"/>
<rdf:Description rdf:about="&a;103681444">
	<b:glossaryEntry>the trait of acting more from whim or caprice than from reason or judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103681643"
	 b:glossaryEntry="the trait of being without worry or responsibility"/>
<rdf:Description rdf:about="&a;103681770"
	 b:glossaryEntry="the trait of being painstaking and careful"/>
<rdf:Description rdf:about="&a;103681984"
	 b:glossaryEntry="strict attention to minute details"/>
<rdf:Description rdf:about="&a;103682129"
	 b:glossaryEntry="conscientiousness in performing all aspects of a task"/>
<rdf:Description rdf:about="&a;103682241">
	<b:glossaryEntry>conscientiousness in paying proper attention to a task; giving the degree of care required in a given situation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103682408"
	 b:glossaryEntry="conscientious attention to rules and details"/>
<rdf:Description rdf:about="&a;103682522"
	 b:glossaryEntry="the trait of not being painstaking or careful"/>
<rdf:Description rdf:about="&a;103682651">
	<b:glossaryEntry>the trait of remaining calm and seeming not to care; a casual lack of concern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103682813">
	<b:glossaryEntry>any quality or characteristic that gains a person acceptance or admission; "his wealth was not a passport into the exclusive circles of society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103683012"
	 b:glossaryEntry="outward or visible aspect of a person or thing"/>
<rdf:Description rdf:about="&a;103683581"
	 b:glossaryEntry="youthful appearance in an old person"/>
<rdf:Description rdf:about="&a;103683672">
	<b:glossaryEntry xml:space='preserve'><![CDATA[physical appearance; "I don''t like the looks of this place"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103683782"
	 b:glossaryEntry='outward appearance; "they look the same in outward view"'/>
<rdf:Description rdf:about="&a;103683889"
	 b:glossaryEntry="texture and appearance of the skin of the face"/>
<rdf:Description rdf:about="&a;103684009">
	<b:glossaryEntry>an outward appearance; "he made a good impression"; "I wanted to create an impression of success"; "she retained that bold effect in her reproductions of the original painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103684305">
	<b:glossaryEntry>the impression produced by a person; "he cut a fine figure"; "a heroic figure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103684436">
	<b:glossaryEntry>the impression created by doing something unusual or extraordinary that people notice and remember; "it was in London that he made his mark"; "he left an indelible mark on the American theater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103684680">
	<b:glossaryEntry>the appearance of things relative to one another as determined by their distance from the viewer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103684912">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(astronomy) the particular appearance of a body''s state of illumination (especially one of the recurring shapes of the part of Earth''s moon that is illuminated by the sun); "the full phase of the moon"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103685183">
	<b:glossaryEntry>a total impression or effect of something made up of individual parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103685312">
	<b:glossaryEntry>the appearance of a point on the horizon at which parallel lines converge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103685466">
	<b:glossaryEntry>the purely external aspect of a thing; superficial appearance: "the audience was held by the substance of the play rather than by the superficies of the production"-R.W.Speaight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103685701"
	 b:glossaryEntry="the general appearance of a publication"/>
<rdf:Description rdf:about="&a;103685812">
	<b:glossaryEntry>the visual appearance of something or someone; "the delicate cast of his features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103685960">
	<b:glossaryEntry>(Jungian psychology) a personal facade one presents to the world; "a public image is as fragile as Humpty Dumpty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103686135">
	<b:glossaryEntry>outward or token appearance or form; "he tried to give his actions a semblance of authenticity"; "the situation soon took on a different color"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103686441"
	 b:glossaryEntry="an insubstantial or vague semblance"/>
<rdf:Description rdf:about="&a;103686533"
	 b:glossaryEntry="the apparent worth as opposed to the real worth"/>
<rdf:Description rdf:about="&a;103686637">
	<b:glossaryEntry>an artful or simulated semblance; "under the guise of friendship he betrayed them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103686792">
	<b:glossaryEntry>an outward semblance that misrepresents the true nature of something; "the theatrical notion of disguise is always associated with catastrophe in his stories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103687018"
	 b:glossaryEntry="the appearance of truth; the quality of seeming to be true"/>
<rdf:Description rdf:about="&a;103687137">
	<b:glossaryEntry>the general outward appearance of something; "the face of the city is changing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103687267">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the appearance conveyed by a person''s face; "a pleasant countenance"; "a stern visage"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103687456">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the expression on a person''s face; "a sad expression"; "a look of triumph"; "an angry face"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103687683"
	 b:glossaryEntry="a suggestive or sneering look or grin"/>
<rdf:Description rdf:about="&a;103687771">
	<b:glossaryEntry>a face without any interpretable expression (as that of a good poker player)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103687904"
	 b:glossaryEntry="a pattern of marks"/>
<rdf:Description rdf:about="&a;103688084">
	<b:glossaryEntry>a stripe of contrasting color; "chromosomes exhibit characteristic bands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103688246">
	<b:glossaryEntry>a narrow band resulting from tension on the skin (as on abdominal skin after pregnancy)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103688392">
	<b:glossaryEntry>a light-colored marking; "they chipped off bark to mark the trail with blazes"; "the horse had a blaze between its eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103688564"
	 b:glossaryEntry='a very small spot; "the plane was just a speck in the sky"'/>
<rdf:Description rdf:about="&a;103688685"
	 b:glossaryEntry="marking consisting of crossing lines"/>
<rdf:Description rdf:about="&a;103688793">
	<b:glossaryEntry>an eyelike marking (as on the wings of some butterflies); usually a spot of color inside a ring of another color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103688969"
	 b:glossaryEntry="shading consisting of multiple crossing lines"/>
<rdf:Description rdf:about="&a;103689100">
	<b:glossaryEntry>graded markings that indicate light or dark areas in a drawing or painting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103689246">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a small contrasting part of something; "a bald spot"; "a leopard''s spots"; "a patch of clouds"; "a fleck of red"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103689511">
	<b:glossaryEntry>a marking of a different color or texture from the background</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103689652"
	 b:glossaryEntry="the quality of having hair"/>
<rdf:Description rdf:about="&a;103689770"
	 b:glossaryEntry="excessive hairiness"/>
<rdf:Description rdf:about="&a;103689859"
	 b:glossaryEntry="the quality of not having hair"/>
<rdf:Description rdf:about="&a;103689966"
	 b:glossaryEntry="the qualities that give pleasure to the senses"/>
<rdf:Description rdf:about="&a;103690317"
	 b:glossaryEntry="beauty that is stark and powerfully impressive"/>
<rdf:Description rdf:about="&a;103690420"
	 b:glossaryEntry='brilliant radiant beauty; "the glory of the sunrise"'/>
<rdf:Description rdf:about="&a;103690554"
	 b:glossaryEntry="extreme beauty of a delicate sort"/>
<rdf:Description rdf:about="&a;103690647"
	 b:glossaryEntry="visually vivid and pleasing"/>
<rdf:Description rdf:about="&a;103690736">
	<b:glossaryEntry>a likeable beauty; "the liveliness and pleasingness of dark eyes"- T.N. Carver</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103690891"
	 b:glossaryEntry="physical beauty (especially of a woman)"/>
<rdf:Description rdf:about="&a;103691006"
	 b:glossaryEntry="alluring beauty or charm (often with sex-appeal)"/>
<rdf:Description rdf:about="&a;103691117"
	 b:glossaryEntry="the quality of being good looking and attractive"/>
<rdf:Description rdf:about="&a;103691262">
	<b:glossaryEntry>the quality of being appealing in a delicate or graceful way (of a girl or young woman)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103691417">
	<b:glossaryEntry>the quality of having regular well-defined features (especially of a man)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103691562"
	 b:glossaryEntry="a beauty that appeals to the senses"/>
<rdf:Description rdf:about="&a;103691802"
	 b:glossaryEntry="extreme attractiveness"/>
<rdf:Description rdf:about="&a;103691897"
	 b:glossaryEntry="magnetic personal charm"/>
<rdf:Description rdf:about="&a;103692010">
	<b:glossaryEntry>a personal attractiveness that enables you to influence others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103692166"
	 b:glossaryEntry="the quality of having a well-rounded body"/>
<rdf:Description rdf:about="&a;103692299"
	 b:glossaryEntry="attractiveness to the opposite sex"/>
<rdf:Description rdf:about="&a;103692429"
	 b:glossaryEntry="attractiveness that interests or pleases or stimulates"/>
<rdf:Description rdf:about="&a;103692578"
	 b:glossaryEntry="childlike charm or appeal"/>
<rdf:Description rdf:about="&a;103692661">
	<b:glossaryEntry>the capability of being easily associated or joined or connected in thought</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103692813">
	<b:glossaryEntry>the quality of arousing interest; being attractive or something that attracts; "her personality held a strange attraction for him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103693107">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a natural attraction or feeling of kinship: "an affinity for politics"; "the mysterious affinity between them"; "James''s affinity with Sam"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103693301"
	 b:glossaryEntry="the power to entice or attract through personal charm"/>
<rdf:Description rdf:about="&a;103693435"
	 b:glossaryEntry="the capacity to attract and hold something"/>
<rdf:Description rdf:about="&a;103693531"
	 b:glossaryEntry="the capacity for attracting people (customers or supporters)"/>
<rdf:Description rdf:about="&a;103693651">
	<b:glossaryEntry>qualities that attract by seeming to promise some kind of reward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103693789"
	 b:glossaryEntry="qualities that do not give pleasure to the senses"/>
<rdf:Description rdf:about="&a;103694055"
	 b:glossaryEntry="ugliness that is unpleasant to look at"/>
<rdf:Description rdf:about="&a;103694153"
	 b:glossaryEntry="ludicrous or incongruous unnaturalness or distortion"/>
<rdf:Description rdf:about="&a;103694294"
	 b:glossaryEntry="strident color or excessive ornamentation"/>
<rdf:Description rdf:about="&a;103694404"
	 b:glossaryEntry="the quality of being unpleasant"/>
<rdf:Description rdf:about="&a;103694514"
	 b:glossaryEntry="extreme ugliness"/>
<rdf:Description rdf:about="&a;103694588"
	 b:glossaryEntry="an appearance that has been spoiled or is misshapen"/>
<rdf:Description rdf:about="&a;103694711"
	 b:glossaryEntry="ugliness that is not appealing"/>
<rdf:Description rdf:about="&a;103694840">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an appearance that is not attractive or beautiful; "fine clothes could not conceal the girl''s homeliness"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103695014"
	 b:glossaryEntry="the quality of lacking an esthetically pleasing shape"/>
<rdf:Description rdf:about="&a;103695127">
	<b:glossaryEntry>a mark or flaw that spoils the appearance of something (especially on a person''s body)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103695492"
	 b:glossaryEntry="a blemish on the skin formed before birth"/>
<rdf:Description rdf:about="&a;103695615">
	<b:glossaryEntry>a mark made by a chattering tool on the surface of a workpiece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103695736">
	<b:glossaryEntry>a mark left after a small piece has been chopped or broken off of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103695878"
	 b:glossaryEntry="an impression in a surface (as made by a blow)"/>
<rdf:Description rdf:about="&a;103695990"
	 b:glossaryEntry="something very ugly and offensive"/>
<rdf:Description rdf:about="&a;103696077"
	 b:glossaryEntry="a small congenital pigmented spot on the skin"/>
<rdf:Description rdf:about="&a;103696173"
	 b:glossaryEntry="an indication of damage"/>
<rdf:Description rdf:about="&a;103696273"
	 b:glossaryEntry="a burned place or area"/>
<rdf:Description rdf:about="&a;103696376">
	<b:glossaryEntry>a burn mark left by a smoldering cigarette; "a cigarette burn on the edge of the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103696524"
	 b:glossaryEntry='a blemish made by dirt; "he had a smudge on his cheek"'/>
<rdf:Description rdf:about="&a;103696712"
	 b:glossaryEntry="an irregularly shaped spot"/>
<rdf:Description rdf:about="&a;103696811"
	 b:glossaryEntry="a smudge made by a (dirty) finger"/>
<rdf:Description rdf:about="&a;103696915">
	<b:glossaryEntry>a soiled or discolored appearance; "the wine left a dark stain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103697171"
	 b:glossaryEntry="a discoloration caused by heat"/>
<rdf:Description rdf:about="&a;103697254"
	 b:glossaryEntry="a discoloration caused by blood"/>
<rdf:Description rdf:about="&a;103697342"
	 b:glossaryEntry="a spot caused the staining with rust or ink"/>
<rdf:Description rdf:about="&a;103697454"
	 b:glossaryEntry="a stain produced by mud"/>
<rdf:Description rdf:about="&a;103697533"
	 b:glossaryEntry="a stain produced by oil"/>
<rdf:Description rdf:about="&a;103697612"
	 b:glossaryEntry="discoloration of metal surface caused by oxidation"/>
<rdf:Description rdf:about="&a;103697716"
	 b:glossaryEntry="a skin lesion that is a diagnostic sign of some disease"/>
<rdf:Description rdf:about="&a;103697824"
	 b:glossaryEntry="a soft red birthmark"/>
<rdf:Description rdf:about="&a;103697940">
	<b:glossaryEntry>(pathology) a firm abnormal elevated blemish on the skin; caused by a virus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103698166"
	 b:glossaryEntry="a benign growth (often with a rough surface)"/>
<rdf:Description rdf:about="&a;103698268"
	 b:glossaryEntry="a small benign wart on or around the genitals and anus"/>
<rdf:Description rdf:about="&a;103698440"
	 b:glossaryEntry="a small benign growth on the faces of hands of children"/>
<rdf:Description rdf:about="&a;103698555">
	<b:glossaryEntry>a wart occurring on the sole of the foot; "pressure causes plantar warts to develop a painful callus around the soft center"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103698738"
	 b:glossaryEntry="the appearance of being plain and unpretentious"/>
<rdf:Description rdf:about="&a;103698895"
	 b:glossaryEntry="lack of ornamentation"/>
<rdf:Description rdf:about="&a;103698998"
	 b:glossaryEntry="extreme plainness"/>
<rdf:Description rdf:about="&a;103699086"
	 b:glossaryEntry="an extreme lack of furnishings or ornamentation"/>
<rdf:Description rdf:about="&a;103699200"
	 b:glossaryEntry="an ornate appearance; being elaborately decorated"/>
<rdf:Description rdf:about="&a;103699394"
	 b:glossaryEntry="elaborate symmetrical ornamentation"/>
<rdf:Description rdf:about="&a;103699497"
	 b:glossaryEntry="fanciful asymmetric ornamentation"/>
<rdf:Description rdf:about="&a;103699583"
	 b:glossaryEntry="extravagant elaborateness"/>
<rdf:Description rdf:about="&a;103699691"
	 b:glossaryEntry="unnecessary elaborateness in details"/>
<rdf:Description rdf:about="&a;103699783">
	<b:glossaryEntry>an appearance that serves to decorate and make something more attractive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103699934">
	<b:glossaryEntry>a decorative texture or appearance of a surface; "the boat had a metallic finish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103700108"
	 b:glossaryEntry="coating for fabrics, ceramics, metal, etc."/>
<rdf:Description rdf:about="&a;103700220"
	 b:glossaryEntry="a surface coating for ceramics or porcelain"/>
<rdf:Description rdf:about="&a;103700325">
	<b:glossaryEntry>the quality of clear water; "when she awoke the clarity was back in her eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103700592"
	 b:glossaryEntry="passing light without diffusion or distortion"/>
<rdf:Description rdf:about="&a;103700722"
	 b:glossaryEntry="the quality of being clear and transparent"/>
<rdf:Description rdf:about="&a;103700874"
	 b:glossaryEntry="the quality of allowing light to pass diffusely"/>
<rdf:Description rdf:about="&a;103701014">
	<b:glossaryEntry>capability of providing a clear unobstructed view: "a windshield with good visibility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103701157"
	 b:glossaryEntry="the quality of being sharp and clear"/>
<rdf:Description rdf:about="&a;103701336">
	<b:glossaryEntry>clarity of outline; "exercise had give his muscles superior definition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103701464"
	 b:glossaryEntry="distinctness that makes perception easy"/>
<rdf:Description rdf:about="&a;103701577">
	<b:glossaryEntry>maximum clarity or distinctness of an image rendered by an optical system: "in focus"; "out of focus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103701730">
	<b:glossaryEntry>the quality of being opaque to a degree; the degree to which something reduces the passage of light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103701968"
	 b:glossaryEntry="the quality of being cloudy"/>
<rdf:Description rdf:about="&a;103702112">
	<b:glossaryEntry>muddiness created by stirring up sediment or having foreign particles suspended</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103702260"
	 b:glossaryEntry="cloudiness resulting from haze or mist"/>
<rdf:Description rdf:about="&a;103702365"
	 b:glossaryEntry="the quality of being indistinct"/>
<rdf:Description rdf:about="&a;103702530"
	 b:glossaryEntry="the quality of being dim"/>
<rdf:Description rdf:about="&a;103702620"
	 b:glossaryEntry="thinness of edge or fineness of point"/>
<rdf:Description rdf:about="&a;103702778"
	 b:glossaryEntry="the quality of having a sharp edge or point"/>
<rdf:Description rdf:about="&a;103702895"
	 b:glossaryEntry="without sharpness of edge or point"/>
<rdf:Description rdf:about="&a;103703060"
	 b:glossaryEntry="the quality of lacking a sharp edge or point"/>
<rdf:Description rdf:about="&a;103703179"
	 b:glossaryEntry="high visibility"/>
<rdf:Description rdf:about="&a;103703364"
	 b:glossaryEntry="the property of being easy to see and understand"/>
<rdf:Description rdf:about="&a;103703629"
	 b:glossaryEntry="the property of being apparent"/>
<rdf:Description rdf:about="&a;103703730">
	<b:glossaryEntry>the property of being both obvious and offensive; "the blatancy of his attempt to whitewash the crime was unforgivable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103703922"
	 b:glossaryEntry="an unwelcome conspicuousness"/>
<rdf:Description rdf:about="&a;103704028"
	 b:glossaryEntry="the quality of standing out strongly and distinctly"/>
<rdf:Description rdf:about="&a;103704149">
	<b:glossaryEntry>the quality of being more noticeable than anything else; "the predomination of blues gave the painting a quiet tone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103704340"
	 b:glossaryEntry="the quality of being not easily seen"/>
<rdf:Description rdf:about="&a;103704494"
	 b:glossaryEntry="the quality of being not easily noticed"/>
<rdf:Description rdf:about="&a;103704596"
	 b:glossaryEntry="the quality of not sticking out in an unwelcome way"/>
<rdf:Description rdf:about="&a;103704727">
	<b:glossaryEntry>freedom from difficulty or hardship or effort: "he rose through the ranks with apparent ease"; "they put it into containers for ease of transportation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103705007">
	<b:glossaryEntry>the quality of requiring little effort; "such effortlessness is achieved only after hours of practice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103705224">
	<b:glossaryEntry>a natural effortlessness; "a happy readiness of conversation"--Jane Austen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103705365"
	 b:glossaryEntry="the quality of being free from errors or interruptions"/>
<rdf:Description rdf:about="&a;103705476">
	<b:glossaryEntry>the quality of being difficult; "they agreed about the difficulty of the climb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103705790"
	 b:glossaryEntry="the quality of requiring deliberate effort"/>
<rdf:Description rdf:about="&a;103705946"
	 b:glossaryEntry="extreme effortfulness"/>
<rdf:Description rdf:about="&a;103706041"
	 b:glossaryEntry="the quality of requiring extended effort"/>
<rdf:Description rdf:about="&a;103706170"
	 b:glossaryEntry='something hard to endure; "the asperity of northern winters"'/>
<rdf:Description rdf:about="&a;103706350">
	<b:glossaryEntry>the quality of being difficult to do; "he assigned a series of problems of increasing hardness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103706500"
	 b:glossaryEntry="impressive difficulty"/>
<rdf:Description rdf:about="&a;103706593"
	 b:glossaryEntry="unwelcome burdensome difficulty"/>
<rdf:Description rdf:about="&a;103706716">
	<b:glossaryEntry>the quality of being difficult to detect or analyze; "you had to admire the subtlety of the distinctions he drew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103706895"
	 b:glossaryEntry="a difficulty that causes anxiety"/>
<rdf:Description rdf:about="&a;103707071">
	<b:glossaryEntry>trouble in carrying or managing caused by bulk or shape: "the movers cursed the unwieldiness of the big piano"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103707271"
	 b:glossaryEntry="a very minor inconvenience"/>
<rdf:Description rdf:about="&a;103707353">
	<b:glossaryEntry>an inconvenience that detracts from the usefulness of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103707482">
	<b:glossaryEntry>capability of existing or performing in harmonious or congenial combination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103707707"
	 b:glossaryEntry="compatibility between persons"/>
<rdf:Description rdf:about="&a;103707811"
	 b:glossaryEntry="compatibility in opinion and action"/>
<rdf:Description rdf:about="&a;103707935"
	 b:glossaryEntry="sympathetic compatibility"/>
<rdf:Description rdf:about="&a;103708023">
	<b:glossaryEntry>compatibility of observations; "there was no agreement between theory and measurment"; "the results of two tests were in correspondence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103708250"
	 b:glossaryEntry="correspondence in form or appearance"/>
<rdf:Description rdf:about="&a;103708375">
	<b:glossaryEntry>conformity with some esthetic standard of correctness or propriety; "it was performed with justness and beauty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103708562"
	 b:glossaryEntry="the quality of agreeing; being suitable and appropriate"/>
<rdf:Description rdf:about="&a;103708738">
	<b:glossaryEntry>the quality of being unable to exist or work in congenial combination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103708941">
	<b:glossaryEntry>being an opposing principle or force or factor: "inherent antagonism of capitalism and socialism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103709095">
	<b:glossaryEntry>an incompatibility of dates or events; "he noticed a conflict in the dates of the two meetings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103709245">
	<b:glossaryEntry>the quality of disagreeing; being unsuitable and inappropriate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103709437">
	<b:glossaryEntry xml:space='preserve'><![CDATA[incongruity between what might be expected and what actually occurs: "the irony of Ireland''s copying the nation she most hated"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103709634">
	<b:glossaryEntry>admission of your own ignorance and willingness to learn while exposing someone''s inconsistencies by close questioning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103709813">
	<b:glossaryEntry>the quality of having the properties that are right for a specific purpose; "an important requirement is suitability for long trips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103710162"
	 b:glossaryEntry="the suitability of land for cultivation"/>
<rdf:Description rdf:about="&a;103710257"
	 b:glossaryEntry="the quality of being specially suitable"/>
<rdf:Description rdf:about="&a;103710484"
	 b:glossaryEntry="pleasing and appropriate manner or style esp of expression"/>
<rdf:Description rdf:about="&a;103710668"
	 b:glossaryEntry='appropriateness; "the phrase had considerable aptness"'/>
<rdf:Description rdf:about="&a;103710827">
	<b:glossaryEntry>the condition of being suitable; "they had to prove their fitness for the position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103711014">
	<b:glossaryEntry>an attribute that fits a person for something: "her qualifications for the job are excellent"; "one of the qualifications for admission is an academic degree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103711286">
	<b:glossaryEntry>the quality or state of being eligible: "eligibility of a candidate for office"; "eligibility for a loan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103711485"
	 b:glossaryEntry="eligibility for marriage"/>
<rdf:Description rdf:about="&a;103711571"
	 b:glossaryEntry="the quality or state of being ineligible"/>
<rdf:Description rdf:about="&a;103711689">
	<b:glossaryEntry>the quality of being useful and convenient; "they offered the convenience of an installment plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103711934"
	 b:glossaryEntry="timely convenience"/>
<rdf:Description rdf:about="&a;103712053"
	 b:glossaryEntry="the quality of being at hand when needed"/>
<rdf:Description rdf:about="&a;103712322">
	<b:glossaryEntry>availability for use; "the materials at the command of the potters grew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103712448"
	 b:glossaryEntry="suitability for the passage of a ship or aircraft"/>
<rdf:Description rdf:about="&a;103712556">
	<b:glossaryEntry>suitability for spinning or capability of being spun (used of textile fibers)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103712692">
	<b:glossaryEntry>the quality of having the wrong properties for a specific purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103712936">
	<b:glossaryEntry>in appropriateness; "greater inaptness of expression would be hard to imagine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103713123"
	 b:glossaryEntry="the quality of not being particularly suitable"/>
<rdf:Description rdf:about="&a;103713287">
	<b:glossaryEntry>inappropriate and unpleasing manner or style esp of expression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103713424">
	<b:glossaryEntry>the condition of not being suitable; "the judges agreed on his unfirness for the appointment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103713609"
	 b:glossaryEntry="unfitness that bars you from participation"/>
<rdf:Description rdf:about="&a;103713714"
	 b:glossaryEntry="the quality of not being useful or convenient"/>
<rdf:Description rdf:about="&a;103713873"
	 b:glossaryEntry="the quality of not being unavailable when needed"/>
<rdf:Description rdf:about="&a;103714036"
	 b:glossaryEntry="the quality of occurring at an inconvenient time"/>
<rdf:Description rdf:about="&a;103714179">
	<b:glossaryEntry>the distinctive spirit of a people or an era; "the Greek ethos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103714294">
	<b:glossaryEntry>an essential and distinguishing attribute of something or someone; "the quality of mercy is not strained"--Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103716446">
	<b:glossaryEntry>the essential qualities or characteristics by which something is recognized; "it is the nature of fire to burn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103716629"
	 b:glossaryEntry="the quality of being human"/>
<rdf:Description rdf:about="&a;103716758">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a distinctive but intangible quality surrounding a person or thing: "an atmosphere of defeat pervaded the candidate''s headquarters"; "the place had an aura of romance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103717031">
	<b:glossaryEntry>an aura of heightened value or interest or meaning surrounding a person or thing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103717166">
	<b:glossaryEntry>a characteristic emotional quality; "it ended on a sour note"; "there was a note of gaiety in her manner"; "he detected a note of sarcasm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103717355">
	<b:glossaryEntry>a degree or grade of excellence or worth: "the quality of students has risen"; "an executive of low caliber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103717609"
	 b:glossaryEntry="the quality of being superior"/>
<rdf:Description rdf:about="&a;103717819">
	<b:glossaryEntry>the quality of being very good indeed; "the inn is distinguished by the fineness of its cuisine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103717983">
	<b:glossaryEntry>the quality of excelling; possessing good qualities in high degree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103718142"
	 b:glossaryEntry="admirable excellence"/>
<rdf:Description rdf:about="&a;103718253">
	<b:glossaryEntry>splendid or imposing in size or appearance; "the grandness of the architecture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103718456">
	<b:glossaryEntry>a quality characterized by magnificence of scale; "the expansiveness of their extravagant life style was soon curtailed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103718636"
	 b:glossaryEntry="impressiveness in scale or proportion"/>
<rdf:Description rdf:about="&a;103718753"
	 b:glossaryEntry="the highest rank in a classification"/>
<rdf:Description rdf:about="&a;103718847"
	 b:glossaryEntry="the highest quality gems"/>
<rdf:Description rdf:about="&a;103718929">
	<b:glossaryEntry>the property of being ingenious; "a plot of great ingenuity"; "the cleverness of its design"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103719106"
	 b:glossaryEntry="an inferior quality"/>
<rdf:Description rdf:about="&a;103719269">
	<b:glossaryEntry>the quality of being poorly made or maintained; "she was unrecognizable because of the poorness of the photography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103719439"
	 b:glossaryEntry="not the highest rank in a classification"/>
<rdf:Description rdf:about="&a;103719538"
	 b:glossaryEntry="a distinguishing quality"/>
<rdf:Description rdf:about="&a;103719894">
	<b:glossaryEntry>an outstanding characteristic; "his acting was one of the high points of the movie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103720036">
	<b:glossaryEntry>a distinguishing or individuating characteristic; "he knows my bad points as well as my good points"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103720188"
	 b:glossaryEntry="a distinctive characteristic or attribute"/>
<rdf:Description rdf:about="&a;103720318"
	 b:glossaryEntry="a characteristic to be considered"/>
<rdf:Description rdf:about="&a;103720404"
	 b:glossaryEntry="having the consistency of a gas"/>
<rdf:Description rdf:about="&a;103720529"
	 b:glossaryEntry="the property of giving off bubbles"/>
<rdf:Description rdf:about="&a;103720649"
	 b:glossaryEntry="the property of being foamy"/>
<rdf:Description rdf:about="&a;103720732">
	<b:glossaryEntry>the quality of being changeable; having a marked tendency to change; "the changeableness of the weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103721093"
	 b:glossaryEntry="the quality of being commutable"/>
<rdf:Description rdf:about="&a;103721202"
	 b:glossaryEntry="the quality of being reversible in either direction"/>
<rdf:Description rdf:about="&a;103721331"
	 b:glossaryEntry="the quality of being changeable and variable"/>
<rdf:Description rdf:about="&a;103721485"
	 b:glossaryEntry="the quality of being guided by sudden unpredictable impulses"/>
<rdf:Description rdf:about="&a;103721625"
	 b:glossaryEntry="the quality of being subject to variation"/>
<rdf:Description rdf:about="&a;103721804"
	 b:glossaryEntry="characterized by variation"/>
<rdf:Description rdf:about="&a;103721937"
	 b:glossaryEntry="the condition or result of being variable"/>
<rdf:Description rdf:about="&a;103722034"
	 b:glossaryEntry="the quality of being capable of exchange or interchange"/>
<rdf:Description rdf:about="&a;103722338">
	<b:glossaryEntry>the quality of being transferable or exchangeable: "sterling transferability affords a means of multilateral settlement for....trade between nondollar countries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103722561">
	<b:glossaryEntry>the quality of being exchangeable (esp the ability to convert a currency into gold or other currencies without restriction)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103722799">
	<b:glossaryEntry>the quality of not being exchangeable; "the inconvertibility of their currency made international trade impossible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103722995"
	 b:glossaryEntry="exchangeability by virtue of being replaceable"/>
<rdf:Description rdf:about="&a;103723137"
	 b:glossaryEntry="being regularly exchangeable"/>
<rdf:Description rdf:about="&a;103723223"
	 b:glossaryEntry="being in cash or easily convertible to cash"/>
<rdf:Description rdf:about="&a;103723322"
	 b:glossaryEntry="ability to change sequence"/>
<rdf:Description rdf:about="&a;103723443"
	 b:glossaryEntry="advancement toward better conditions or policies or methods"/>
<rdf:Description rdf:about="&a;103723580">
	<b:glossaryEntry>the quality of being unchangeable; having a marked tendency to remain unchanged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103723918">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the quality of being absolute; "the absoluteness of the Pope''s decree could not be challenged"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103724071"
	 b:glossaryEntry="the quality of being free from change or variation"/>
<rdf:Description rdf:about="&a;103724243">
	<b:glossaryEntry>the quality of being irreversible (once done it cannot be changed)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103724389"
	 b:glossaryEntry="the quality of being resistant to variation"/>
<rdf:Description rdf:about="&a;103724576"
	 b:glossaryEntry="characterized by an absence of variation"/>
<rdf:Description rdf:about="&a;103724711">
	<b:glossaryEntry>the quality of wearisome constancy and lack of variety; "he had never grown accustomed to the monotony of his work"; "he hated the sameness of the food the college served"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103724948">
	<b:glossaryEntry>the quality of being fixed and unchangeable; "the fixedness of his gaze upset her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103725103"
	 b:glossaryEntry="the quality of being incapable of exchange or interchange"/>
<rdf:Description rdf:about="&a;103725278"
	 b:glossaryEntry="the quality of being not interchangeable"/>
<rdf:Description rdf:about="&a;103725380"
	 b:glossaryEntry="the quality of being irreplaceable"/>
<rdf:Description rdf:about="&a;103725478"
	 b:glossaryEntry="the quality of being capable of mutation"/>
<rdf:Description rdf:about="&a;103725661"
	 b:glossaryEntry="the quality of being alterable"/>
<rdf:Description rdf:about="&a;103725768">
	<b:glossaryEntry>mutability in life or nature (especially successive alternation from one condition to another)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103725920"
	 b:glossaryEntry="the quality of being incapable of mutation"/>
<rdf:Description rdf:about="&a;103726109"
	 b:glossaryEntry="the quality of not being alterable"/>
<rdf:Description rdf:about="&a;103726240">
	<b:glossaryEntry>incapability of being altered in disposition or habits: "the incurability of his optimism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103726389"
	 b:glossaryEntry="the quality of being timeless and eternal"/>
<rdf:Description rdf:about="&a;103726488">
	<b:glossaryEntry>the quality of being alike: "sameness of purpose kept them together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103726701">
	<b:glossaryEntry>the quality of being not alike; being distinct or different from that otherwise experienced or known</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103726905"
	 b:glossaryEntry='exact sameness; "they shared an identity of interests"'/>
<rdf:Description rdf:about="&a;103727089"
	 b:glossaryEntry="the quality of being united into one"/>
<rdf:Description rdf:about="&a;103727187"
	 b:glossaryEntry="the quality of being identical with itself"/>
<rdf:Description rdf:about="&a;103727288"
	 b:glossaryEntry="the quality of being similar"/>
<rdf:Description rdf:about="&a;103727571">
	<b:glossaryEntry>similarity in some respect between things that are otherwise dissimilar: "the operation of a computer presents an interesting analogy to the working of the brain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103727805"
	 b:glossaryEntry="the quality of of being similar (especially close in value)"/>
<rdf:Description rdf:about="&a;103727960"
	 b:glossaryEntry="(biology) similarity because of common evolution"/>
<rdf:Description rdf:about="&a;103728063">
	<b:glossaryEntry>the quality of being similar or corresponding in position or value or structure or function</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103728209"
	 b:glossaryEntry="(biology) similarity of form or shape or structure"/>
<rdf:Description rdf:about="&a;103728317">
	<b:glossaryEntry>similarity in appearance or character or nature between persons or things: "man created God in his own likeness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103728635"
	 b:glossaryEntry="similarity by virtue of correspondence"/>
<rdf:Description rdf:about="&a;103728748">
	<b:glossaryEntry>the quality of lacking diversity or variation (even to the point of boredom)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103728949">
	<b:glossaryEntry>the quality of being similar or comparable in kind or nature; "there is a remarkable homogeneity between the two companies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103729166"
	 b:glossaryEntry="a harmonious uniformity or agreement among things or parts"/>
<rdf:Description rdf:about="&a;103729314"
	 b:glossaryEntry='a close approximation; "the nearest approach to genius"'/>
<rdf:Description rdf:about="&a;103729424">
	<b:glossaryEntry>an approximate definition or example; "she wore a sort of magenta dress"; "she served a creamy sort of dessert thing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103729592">
	<b:glossaryEntry>something having the property of being analogous to something else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103729733"
	 b:glossaryEntry="a likeness in which left and right are reversed"/>
<rdf:Description rdf:about="&a;103729864">
	<b:glossaryEntry>qualities that are comparable; "no comparison between the two books"; "beyond compare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103730047"
	 b:glossaryEntry="similarity in appearance or external or superficial details"/>
<rdf:Description rdf:about="&a;103730200"
	 b:glossaryEntry="symmetrical resemblance"/>
<rdf:Description rdf:about="&a;103730288"
	 b:glossaryEntry="inherent resemblance between persons or things"/>
<rdf:Description rdf:about="&a;103730389">
	<b:glossaryEntry>the quality or state of being the same in quantity or measure or value or status</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103730632"
	 b:glossaryEntry="capability of being equated"/>
<rdf:Description rdf:about="&a;103730718"
	 b:glossaryEntry="essential equality and interchangeability"/>
<rdf:Description rdf:about="&a;103730853"
	 b:glossaryEntry="functional equality"/>
<rdf:Description rdf:about="&a;103730925"
	 b:glossaryEntry="the quality of being balanced"/>
<rdf:Description rdf:about="&a;103731027">
	<b:glossaryEntry>the quality of being unlike or dissimilar: "there are many differences between jazz and rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103731357"
	 b:glossaryEntry="a quality that differentiates between similar things"/>
<rdf:Description rdf:about="&a;103731468">
	<b:glossaryEntry>a distinguishing characteristic esp in different species of a genus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103731593">
	<b:glossaryEntry>a distinguishing difference: "he learned the distinction between gold and lead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103731730">
	<b:glossaryEntry>a difference between conflicting facts or claims or opinions; "a growing divergence of opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103731940"
	 b:glossaryEntry="a permissible difference"/>
<rdf:Description rdf:about="&a;103732050"
	 b:glossaryEntry="the quality of being dissimilar"/>
<rdf:Description rdf:about="&a;103732228"
	 b:glossaryEntry="utter dissimilarity"/>
<rdf:Description rdf:about="&a;103732325"
	 b:glossaryEntry="dissimilarity evidenced by an absence of likeness"/>
<rdf:Description rdf:about="&a;103732483"
	 b:glossaryEntry="the quality of being diverse and interesting"/>
<rdf:Description rdf:about="&a;103732641"
	 b:glossaryEntry="the quality of being diverse and not comparable in kind"/>
<rdf:Description rdf:about="&a;103732812">
	<b:glossaryEntry>noticeable heterogeneity; "a diversity of possibilities"; "the range and variety of his work is amazing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103733051">
	<b:glossaryEntry>the quality of being inconsistent and lacking a harmonious uniformity among things or parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103733220">
	<b:glossaryEntry>a difference that is usually pleasant; "he goes to France for variety"; "it is a refreshing change to meet a woman mechanic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103733407">
	<b:glossaryEntry>lack of equality: "the growing inequality between rich and poor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103733600"
	 b:glossaryEntry="not interchangeable"/>
<rdf:Description rdf:about="&a;103733698"
	 b:glossaryEntry="inequality or difference in some respect"/>
<rdf:Description rdf:about="&a;103733866">
	<b:glossaryEntry>a disappointing disparity; "it was a far cry from what he had expected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103733991">
	<b:glossaryEntry>a conspicuous disparity or difference as between two figures: "gap between income and outgo"; "the spread between lending and borrowing costs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103734192">
	<b:glossaryEntry>an unbridgeable disparity (as from a failure of understanding); "he felt a gulf between himself and his former friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103734362"
	 b:glossaryEntry="the quality of being unbalanced"/>
<rdf:Description rdf:about="&a;103734468"
	 b:glossaryEntry='something that is certain; "his victory is a certainty"'/>
<rdf:Description rdf:about="&a;103734723">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(British slang) an absolute certainty; "it''s a dead cert"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103734831"
	 b:glossaryEntry="the quality of being unavoidable"/>
<rdf:Description rdf:about="&a;103734940"
	 b:glossaryEntry="the quality of being predictable with great confidence"/>
<rdf:Description rdf:about="&a;103735089">
	<b:glossaryEntry>the quality of being final or definitely settled: "the finality of death"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103735303"
	 b:glossaryEntry="something clearly established"/>
<rdf:Description rdf:about="&a;103735385"
	 b:glossaryEntry="the quality of being beyond question or dispute or doubt"/>
<rdf:Description rdf:about="&a;103735615"
	 b:glossaryEntry="the quality of being undeniable and not worth arguing about"/>
<rdf:Description rdf:about="&a;103735763"
	 b:glossaryEntry="capability of being demonstrated or logically proved"/>
<rdf:Description rdf:about="&a;103735891">
	<b:glossaryEntry>the quality of being granted as a supposition; of being acknowledged or assumed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103736026"
	 b:glossaryEntry="the quality of being predictable"/>
<rdf:Description rdf:about="&a;103736155"
	 b:glossaryEntry="the quality of being probable"/>
<rdf:Description rdf:about="&a;103736278"
	 b:glossaryEntry="the probability of a specified outcome"/>
<rdf:Description rdf:about="&a;103736465">
	<b:glossaryEntry>being unsettled or in doubt: "the uncertainty of the outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103736708">
	<b:glossaryEntry>uncertainty about the truth or factuality of existence of something; "the dubiousness of his claim"; "there is no question about the validity of the enterprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103736960"
	 b:glossaryEntry="the quality of being vague and poorly defined"/>
<rdf:Description rdf:about="&a;103737152"
	 b:glossaryEntry="the quality of being inconclusive"/>
<rdf:Description rdf:about="&a;103737266"
	 b:glossaryEntry="lacking predictability"/>
<rdf:Description rdf:about="&a;103737369"
	 b:glossaryEntry="the quality of being improbable"/>
<rdf:Description rdf:about="&a;103737513"
	 b:glossaryEntry="the improbability of a specified outcome"/>
<rdf:Description rdf:about="&a;103737663"
	 b:glossaryEntry="the quality of happening accidentally and by lucky chance"/>
<rdf:Description rdf:about="&a;103737781">
	<b:glossaryEntry>the quality of being actual or based on fact; "the realm of factuality must be distinguished from the realm of imagination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103737993"
	 b:glossaryEntry="the quality of being contrary to fact"/>
<rdf:Description rdf:about="&a;103738112"
	 b:glossaryEntry="the quality of being concrete (not abstract)"/>
<rdf:Description rdf:about="&a;103738269"
	 b:glossaryEntry="the quality of being perceivable by touch"/>
<rdf:Description rdf:about="&a;103738433"
	 b:glossaryEntry="the quality of being intangible"/>
<rdf:Description rdf:about="&a;103738593"
	 b:glossaryEntry="adhereing to the concrete construal of something"/>
<rdf:Description rdf:about="&a;103738699"
	 b:glossaryEntry="the quality of being physical; consisting of matter"/>
<rdf:Description rdf:about="&a;103739018"
	 b:glossaryEntry="the quality of being substantial or having substance"/>
<rdf:Description rdf:about="&a;103739203"
	 b:glossaryEntry="the quality of not being physical; not consisting of matter"/>
<rdf:Description rdf:about="&a;103739447"
	 b:glossaryEntry="lacking substance or reality"/>
<rdf:Description rdf:about="&a;103739574">
	<b:glossaryEntry>(informal) something with no concrete substance; "his dreams all turned to smoke"; "it was just smoke and mirrors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103739740">
	<b:glossaryEntry>the quality of being considered apart from an specific instance or object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103739908"
	 b:glossaryEntry="the quality possessed by something that is real"/>
<rdf:Description rdf:about="&a;103740027"
	 b:glossaryEntry="the quality possessed by something that is unreal"/>
<rdf:Description rdf:about="&a;103740150">
	<b:glossaryEntry>the quality of being particular and pertaining to a specific case or instance; "the particularity of human situations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103740382">
	<b:glossaryEntry>the quality of being specific rather than general: "add a desirable note of specificity to the discussion"; "the specificity of the symptoms of the disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103740596">
	<b:glossaryEntry>the quality of being specific to a particular organism: "host specificity of a parasite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103740742">
	<b:glossaryEntry>the quality of being individual: "so absorbed by the movement that she lost all sense of individuality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103740993">
	<b:glossaryEntry>the quality of being one of a kind; "that singularity distinguished him from all his companions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103741160"
	 b:glossaryEntry="a distinguishing trait"/>
<rdf:Description rdf:about="&a;103741315">
	<b:glossaryEntry>an behavioral attribute that is distinctive and peculiar to an individual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103741468">
	<b:glossaryEntry>the quality of being general or widespread or having general applicability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103741743"
	 b:glossaryEntry="sharing of common attributes"/>
<rdf:Description rdf:about="&a;103741896">
	<b:glossaryEntry>a union of interests or purposes or sympathies among members of a group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103742024">
	<b:glossaryEntry>the quality of filling or spreading throughout: "the pervasiveness of the odor of cabbage in tenement hallways"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103742195">
	<b:glossaryEntry>the quality of prevailing generally; being widespread; "the prevalence of dysentery is horrible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103742366"
	 b:glossaryEntry='general acceptance or use: "the currency of ideas"'/>
<rdf:Description rdf:about="&a;103742471"
	 b:glossaryEntry="the quality of being universal; existing everywhere"/>
<rdf:Description rdf:about="&a;103742595">
	<b:glossaryEntry>the quality of being complete and indiscriminate: "the totality of war and its consequences"; "the all-embracing totality of the state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103742785">
	<b:glossaryEntry>the quality of being simple or uncompounded; "the simplicity of a crystal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103742947">
	<b:glossaryEntry>the quality of being intricate and compounded; "he enjoyed the complexity of modern computers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103743220"
	 b:glossaryEntry="puzzling complexity"/>
<rdf:Description rdf:about="&a;103743329"
	 b:glossaryEntry="marked by elaborately complex detail"/>
<rdf:Description rdf:about="&a;103743451">
	<b:glossaryEntry>something that is felt to resemble a tapestry in its complexity; "the tapestry of European history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103743605">
	<b:glossaryEntry>the quality of being characterized by a fixed principle or rate; "he was famous for the regularity of his habits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103743937"
	 b:glossaryEntry="the quality of recurring at intervals"/>
<rdf:Description rdf:about="&a;103744098"
	 b:glossaryEntry='recurring at regular intervals; "the rhythm of the seasons"'/>
<rdf:Description rdf:about="&a;103744231"
	 b:glossaryEntry="the quality of appreciating method and system"/>
<rdf:Description rdf:about="&a;103744369">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an ordered manner; orderliness by virtue of being methodical and well organized; "his compulsive organization was not an endearing quality"; "we can''t do it unless we establish some system around here"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103744653"
	 b:glossaryEntry="a condition in which everything is regular and unvarying"/>
<rdf:Description rdf:about="&a;103744784">
	<b:glossaryEntry>the quality of being of uniform throughout in composition or structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103744912"
	 b:glossaryEntry="a quality of uniformity and lack of variation"/>
<rdf:Description rdf:about="&a;103745100"
	 b:glossaryEntry="regularity of spacing"/>
<rdf:Description rdf:about="&a;103745180"
	 b:glossaryEntry="the quality of being steady--regular and unvarying"/>
<rdf:Description rdf:about="&a;103745305">
	<b:glossaryEntry>not characterized by a fixed principle or rate; at irregular intervals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103745575"
	 b:glossaryEntry="the quality of being spasmodic and irregular"/>
<rdf:Description rdf:about="&a;103745706">
	<b:glossaryEntry>the quality of being intermittent; subject to interruption or periodic stopping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103745861">
	<b:glossaryEntry>the quality of being unsteady and subject to fluctuations; "he kept a record of price fluctuations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103746029"
	 b:glossaryEntry="the quality of lacking any predictable order or plan"/>
<rdf:Description rdf:about="&a;103746154"
	 b:glossaryEntry="the quality of moving or acting in spasms"/>
<rdf:Description rdf:about="&a;103746252"
	 b:glossaryEntry="a quality of variability and lack of uniformity"/>
<rdf:Description rdf:about="&a;103746460"
	 b:glossaryEntry="something irregular like a bump or crack in a smooth surface"/>
<rdf:Description rdf:about="&a;103746577"
	 b:glossaryEntry="unevenness in quality or performance"/>
<rdf:Description rdf:about="&a;103746670"
	 b:glossaryEntry="variability attributable to individual differences"/>
<rdf:Description rdf:about="&a;103746784"
	 b:glossaryEntry="the quality of being unsteady--varying and irregular"/>
<rdf:Description rdf:about="&a;103746913"
	 b:glossaryEntry="the quality of moving freely"/>
<rdf:Description rdf:about="&a;103747122"
	 b:glossaryEntry="the power or ability to move"/>
<rdf:Description rdf:about="&a;103747233"
	 b:glossaryEntry="ability to move spontaneously and independently"/>
<rdf:Description rdf:about="&a;103747353">
	<b:glossaryEntry>the quality of being movable; capable of being moved or rearranged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103747580"
	 b:glossaryEntry="the quality of being maneuverable"/>
<rdf:Description rdf:about="&a;103747694">
	<b:glossaryEntry>the quality of being controllable by skilled movements of the hands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103747822">
	<b:glossaryEntry>movement or space for movement; "there was too much play in the steering wheel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103748018">
	<b:glossaryEntry>the quality of being ceaselessly moving or active; "the restlessness of the wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103748158">
	<b:glossaryEntry>a jerky back and forth kind of mobility; "he walked with the wiggliness of a child on high heels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103748312">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the condition of being loose (not taut); "he hadn''t counted on the slackness of the rope"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103748465"
	 b:glossaryEntry="the quality of not being steady or securely fixed in place"/>
<rdf:Description rdf:about="&a;103748618"
	 b:glossaryEntry="the quality or attribute of being unstable"/>
<rdf:Description rdf:about="&a;103748787">
	<b:glossaryEntry>the quality of being unstable and insecure; "the shakiness of the present regime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103748938"
	 b:glossaryEntry="the quality of being light enough to be carried"/>
<rdf:Description rdf:about="&a;103749043"
	 b:glossaryEntry="the quality of not moving"/>
<rdf:Description rdf:about="&a;103749197"
	 b:glossaryEntry="lacking an ability to move"/>
<rdf:Description rdf:about="&a;103749298"
	 b:glossaryEntry="immobility by virtue of being inert"/>
<rdf:Description rdf:about="&a;103749389"
	 b:glossaryEntry="no capable of being moved or rearranged"/>
<rdf:Description rdf:about="&a;103749593"
	 b:glossaryEntry="lack of movement or room for movement"/>
<rdf:Description rdf:about="&a;103749715"
	 b:glossaryEntry="the quality of being fixed in place"/>
<rdf:Description rdf:about="&a;103749857">
	<b:glossaryEntry>the state or quality of being lodged or fixed even temporarily: "the lodgment of the balloon in the tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103750039">
	<b:glossaryEntry>the quality of being steady or securely and immovably fixed in place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103750247">
	<b:glossaryEntry>something having the quality of granite (unyielding firmness); "a man of granite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103750382">
	<b:glossaryEntry>the quality of being steady and unfailing; "sureness of hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103750498"
	 b:glossaryEntry="the quality or attribute of being stable"/>
<rdf:Description rdf:about="&a;103750643">
	<b:glossaryEntry>the quality of giving pleasure; "he was charmed by the sweetness of her manner"; "the pleasantness of a cool breeze on a hot summer day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103750976">
	<b:glossaryEntry>pleasantness resulting from agreeable conditions; "a well trained staff saw to the agreeableness of our accommodations"; "he discovered the amenities of reading at an early age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103751241">
	<b:glossaryEntry>pleasantness resulting from something that can be enjoyed; "the enjoyableness of an afternoon at the beach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103751408"
	 b:glossaryEntry="the quality of nice"/>
<rdf:Description rdf:about="&a;103751518">
	<b:glossaryEntry>the quality of giving displeasure; "the recent unpleasantness of the weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103751728"
	 b:glossaryEntry="the quality of being disagreeable; and unpleasant"/>
<rdf:Description rdf:about="&a;103751858">
	<b:glossaryEntry>the quality of being unpleasant; "I flinched at the nastiness of his wound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103752043"
	 b:glossaryEntry="the quality of being offensive"/>
<rdf:Description rdf:about="&a;103752290"
	 b:glossaryEntry="the quality of being disgusting to the senses or emotions"/>
<rdf:Description rdf:about="&a;103752446"
	 b:glossaryEntry="the quality of being hateful"/>
<rdf:Description rdf:about="&a;103752568">
	<b:glossaryEntry>(British) unpleasant nastiness; used especially of nasty weather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103752690"
	 b:glossaryEntry="a quality of extreme unpleasantness"/>
<rdf:Description rdf:about="&a;103752842"
	 b:glossaryEntry="the quality of being frightful"/>
<rdf:Description rdf:about="&a;103752950"
	 b:glossaryEntry="the quality of being ghastly"/>
<rdf:Description rdf:about="&a;103753074"
	 b:glossaryEntry="the quality of being believable or trustworthy"/>
<rdf:Description rdf:about="&a;103753317"
	 b:glossaryEntry="undisputed credibility"/>
<rdf:Description rdf:about="&a;103753443"
	 b:glossaryEntry="informal usage attributing authenticity"/>
<rdf:Description rdf:about="&a;103753565"
	 b:glossaryEntry="the quality of being logically valid"/>
<rdf:Description rdf:about="&a;103753683"
	 b:glossaryEntry="apparent validity"/>
<rdf:Description rdf:about="&a;103753811">
	<b:glossaryEntry>the quality of being plausible or acceptable to a reasonable person; "he questioned the tenability of my claims"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103754011"
	 b:glossaryEntry="the quality of being incredible"/>
<rdf:Description rdf:about="&a;103754155"
	 b:glossaryEntry="the quality of provoking disbelief"/>
<rdf:Description rdf:about="&a;103754286"
	 b:glossaryEntry="correct and valid reasoning"/>
<rdf:Description rdf:about="&a;103754510"
	 b:glossaryEntry="the quality of being consistent with or based on logic"/>
<rdf:Description rdf:about="&a;103754637">
	<b:glossaryEntry>(logic) an attribute of a logical system that is so constituted that none of the propositions deducible from the axioms contradict one another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103754837">
	<b:glossaryEntry>(logic) an attribute of a logical system that is so constituted that a contradiction arises if any proposition is introduced that cannot be derived from the axioms of the system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103755073"
	 b:glossaryEntry="invalid or incorrect reasoning"/>
<rdf:Description rdf:about="&a;103755242">
	<b:glossaryEntry>the quality of being natural or based on natural principles: "he accepted the naturalness of death"; "the spontaneous naturalness of his manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103755624">
	<b:glossaryEntry>not affected; a personal manner that is not consciously constrained</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103755770"
	 b:glossaryEntry="absence of affectation or pretense"/>
<rdf:Description rdf:about="&a;103755861">
	<b:glossaryEntry>a quality of naturalness and simplicity; "the simple sincerity of folk songs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103756011">
	<b:glossaryEntry>the quality of being spontaneous and coming from natural feelings without constraint; "the spontaneity of his laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103756206">
	<b:glossaryEntry>freedom from constraint or embarrassment; "I am never at ease with strangers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103756348"
	 b:glossaryEntry="the quality of being natural and without pretensions"/>
<rdf:Description rdf:about="&a;103756482"
	 b:glossaryEntry="the quality of being brought into conformity with nature"/>
<rdf:Description rdf:about="&a;103756599">
	<b:glossaryEntry>the quality of being unnatural or not based on natural principles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103756814"
	 b:glossaryEntry="the quality of being false or artificial"/>
<rdf:Description rdf:about="&a;103757021">
	<b:glossaryEntry xml:space='preserve'><![CDATA[affected manners intended to impress others; "don''t put on airs with me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103757151"
	 b:glossaryEntry="the affectation of being demure in a provocative way"/>
<rdf:Description rdf:about="&a;103757270"
	 b:glossaryEntry="the quality of being fastidious or excessively refined"/>
<rdf:Description rdf:about="&a;103757381">
	<b:glossaryEntry>the quality of being produced by people and not occurring naturally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103757544"
	 b:glossaryEntry="an artificial and mannered quality"/>
<rdf:Description rdf:about="&a;103757650"
	 b:glossaryEntry="a false or unsupportable quality"/>
<rdf:Description rdf:about="&a;103757761">
	<b:glossaryEntry>the quality of being pretentious (creating a false appearance of great importance or worth)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103757963"
	 b:glossaryEntry="pretentious or showy or vulgar display"/>
<rdf:Description rdf:about="&a;103758059">
	<b:glossaryEntry>the quality of being attributed to power that seems to violate or go beyond natural forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103758230"
	 b:glossaryEntry="artistic quality"/>
<rdf:Description rdf:about="&a;103758306"
	 b:glossaryEntry="the quality of being beneficial and generally good for you"/>
<rdf:Description rdf:about="&a;103758478"
	 b:glossaryEntry="the quality of being nourishing and promoting healthy growth"/>
<rdf:Description rdf:about="&a;103758615"
	 b:glossaryEntry="the quality of promoting good health"/>
<rdf:Description rdf:about="&a;103758747"
	 b:glossaryEntry="the quality of being salubrious and invigorating"/>
<rdf:Description rdf:about="&a;103758904"
	 b:glossaryEntry="the quality of being unhealthful and generally bad for you"/>
<rdf:Description rdf:about="&a;103759175"
	 b:glossaryEntry="the quality of being noxious"/>
<rdf:Description rdf:about="&a;103759289"
	 b:glossaryEntry="grave harmfulness or deadliness"/>
<rdf:Description rdf:about="&a;103759392"
	 b:glossaryEntry="the quality of being deadly"/>
<rdf:Description rdf:about="&a;103759506"
	 b:glossaryEntry="the quality of being able to cause death or fatal disasters"/>
<rdf:Description rdf:about="&a;103759620"
	 b:glossaryEntry="quality of lacking nutritive value"/>
<rdf:Description rdf:about="&a;103759722"
	 b:glossaryEntry="the quality of rotting and becoming putrid"/>
<rdf:Description rdf:about="&a;103759835"
	 b:glossaryEntry="the quality of promoting poor health"/>
<rdf:Description rdf:about="&a;103759969"
	 b:glossaryEntry="the quality of being insalubrious and debilitating"/>
<rdf:Description rdf:about="&a;103760132">
	<b:glossaryEntry>the quality of giving satisfaction sufficient to meet a demand or requirement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103760326">
	<b:glossaryEntry>the quality of being able to meet a need satisfactorily: "he questioned the adequacy of the usual sentimental interpretation of the Golden Rule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103760593">
	<b:glossaryEntry>satisfactoriness by virtue of conforming to approved standards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103760768"
	 b:glossaryEntry="acceptability by virtue of being admissible"/>
<rdf:Description rdf:about="&a;103760943"
	 b:glossaryEntry="admissibility as a consequence of being permitted"/>
<rdf:Description rdf:about="&a;103761071"
	 b:glossaryEntry="the quality of being adequate or suitable"/>
<rdf:Description rdf:about="&a;103761231"
	 b:glossaryEntry="unsatisfactoriness by virtue of being inadequate"/>
<rdf:Description rdf:about="&a;103761371">
	<b:glossaryEntry>unsatisfactoriness by virtue of not conforming to approved standards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103761574"
	 b:glossaryEntry="unacceptability as a consequence of not being admissible"/>
<rdf:Description rdf:about="&a;103761728"
	 b:glossaryEntry="inadmissibility as a consequence of not being permitted"/>
<rdf:Description rdf:about="&a;103761864"
	 b:glossaryEntry="the quality of being ordinary"/>
<rdf:Description rdf:about="&a;103762060">
	<b:glossaryEntry>ordinariness as a consequence of being average and not outstanding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103762197">
	<b:glossaryEntry>ordinariness as a consequence of being expected and not surprising</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103762340">
	<b:glossaryEntry>ordinariness as a consequence of being frequent and commonplace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103762583">
	<b:glossaryEntry>commonplaceness as a consequence of being humdrum and not exciting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103762719"
	 b:glossaryEntry="commonness by virtue of not being unusual"/>
<rdf:Description rdf:about="&a;103762888"
	 b:glossaryEntry="usualness by virtue of being familiar or well known"/>
<rdf:Description rdf:about="&a;103763051">
	<b:glossaryEntry>the quality of being extraordinary and not commonly encountered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103763232">
	<b:glossaryEntry>extraordinariness by virtue of being unexpected; "the unexpectedness of the warm welcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103763417">
	<b:glossaryEntry>extraordinariness as a consequence of being rare and uncommon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103763573"
	 b:glossaryEntry="uncommonness by virtue of being unusual"/>
<rdf:Description rdf:about="&a;103763706"
	 b:glossaryEntry="unusualness as a consequence of not being well known"/>
<rdf:Description rdf:about="&a;103763994"
	 b:glossaryEntry="a strange attitude or habit"/>
<rdf:Description rdf:about="&a;103764118"
	 b:glossaryEntry="strangeness by virtue of being mysterious and inspiring fear"/>
<rdf:Description rdf:about="&a;103764247"
	 b:glossaryEntry="marked strangeness as a consequence of being abnormal"/>
<rdf:Description rdf:about="&a;103764373"
	 b:glossaryEntry="strangeness by virtue of being remarkable or unusual"/>
<rdf:Description rdf:about="&a;103764483"
	 b:glossaryEntry="strikingly out of the ordinary"/>
<rdf:Description rdf:about="&a;103764600">
	<b:glossaryEntry>strangeness as a consequence of being old fashioned; "some words in her dialect had a charming quaintness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103764763"
	 b:glossaryEntry="strange and unconventional behavior"/>
<rdf:Description rdf:about="&a;103764875"
	 b:glossaryEntry="eccentricity that is not easily explained"/>
<rdf:Description rdf:about="&a;103764979">
	<b:glossaryEntry>an ethnic quality or affiliation resulting from racial or cultural ties; "ethnicity has a strong influence on community status relations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103765172">
	<b:glossaryEntry>the quality of being alien or not native: "the strangeness of a foreigner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103765404">
	<b:glossaryEntry>the quality of being exotic; "he loved the exocitism of Egypt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103765545"
	 b:glossaryEntry="the quality of being alien"/>
<rdf:Description rdf:about="&a;103765637">
	<b:glossaryEntry>the quality of belonging to or being connected with a certain place or region by virtue of birth or origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103765836">
	<b:glossaryEntry>nativeness by virtue or originating or occurring naturally (as in a particular place)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103766007">
	<b:glossaryEntry>the quality of being new and original (not derived from something else)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103766226"
	 b:glossaryEntry="originality by virtue of being refreshingly novel"/>
<rdf:Description rdf:about="&a;103766341"
	 b:glossaryEntry="the quality of being unorthodox"/>
<rdf:Description rdf:about="&a;103766497"
	 b:glossaryEntry="unorthodoxy by virtue of being unconventional"/>
<rdf:Description rdf:about="&a;103766624">
	<b:glossaryEntry>unorthodoxy as a consequence of not conforming to expected standards or values</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103766762"
	 b:glossaryEntry="the quality of being unoriginal"/>
<rdf:Description rdf:about="&a;103766889"
	 b:glossaryEntry="the quality of being orthodox (especially in religion)"/>
<rdf:Description rdf:about="&a;103767089"
	 b:glossaryEntry="orthodoxy as a consequence of being conventional"/>
<rdf:Description rdf:about="&a;103767302"
	 b:glossaryEntry="hardened conventionality"/>
<rdf:Description rdf:about="&a;103767398"
	 b:glossaryEntry="strict adherence to traditional methods or teachings"/>
<rdf:Description rdf:about="&a;103767546"
	 b:glossaryEntry="orthodoxy of a scholastic variety"/>
<rdf:Description rdf:about="&a;103767665"
	 b:glossaryEntry="conformity to fact or truth"/>
<rdf:Description rdf:about="&a;103767834"
	 b:glossaryEntry="the quality of not conforming to fact or truth"/>
<rdf:Description rdf:about="&a;103768006"
	 b:glossaryEntry="inadvertent incorrectness"/>
<rdf:Description rdf:about="&a;103768117"
	 b:glossaryEntry="the error of a compass due to local magnetic disturbances"/>
<rdf:Description rdf:about="&a;103768230">
	<b:glossaryEntry>the quality of being accurate and without error; "the lawyer questioned the accuracy of my account"; "he was beginning to doubt the truth of his compass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103768536">
	<b:glossaryEntry>(mathematics) the number of significant figures given in a number; "the atomic clock enabled scientists to measure time with much greater accuracy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103768738">
	<b:glossaryEntry>the quality of being exact; "he demanded exactness in all details"; "a man of great exactitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103768956">
	<b:glossaryEntry>the quality of being precise in amount or performance; "he handled it with the preciseness of an automaton"; "note the meticulous precision of his measurements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103769222">
	<b:glossaryEntry>exactness of adjustment; "I marveled at the trueness of his aim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103769341">
	<b:glossaryEntry>accuracy with which an electronic system reproduces the sound or image of its input signal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103769486"
	 b:glossaryEntry="the quality of being inaccurate and having errors"/>
<rdf:Description rdf:about="&a;103769628"
	 b:glossaryEntry="the quality of being inaccurate and having errors"/>
<rdf:Description rdf:about="&a;103769786"
	 b:glossaryEntry="the quality of lacking precision"/>
<rdf:Description rdf:about="&a;103769928"
	 b:glossaryEntry="the quality of never making an error"/>
<rdf:Description rdf:about="&a;103770060"
	 b:glossaryEntry='(Christianity) exemption from error; "biblical inerrancy"'/>
<rdf:Description rdf:about="&a;103770191"
	 b:glossaryEntry="a tendency to err"/>
<rdf:Description rdf:about="&a;103770280">
	<b:glossaryEntry>(Christianity) holding views that disagree with accepted doctrine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103770399"
	 b:glossaryEntry="unreliability attributable to being unstable"/>
<rdf:Description rdf:about="&a;103770501"
	 b:glossaryEntry="the quality of being reproducible"/>
<rdf:Description rdf:about="&a;103770612">
	<b:glossaryEntry>the quality of being unreproducible; "he could not explain the irreproducibility of the results of his experiment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103770790"
	 b:glossaryEntry="the likelihood of making errors"/>
<rdf:Description rdf:about="&a;103770915">
	<b:glossaryEntry>a distinguishing quality; "it has the distinction of being the cheapest restaurant in town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103771064"
	 b:glossaryEntry="the quality or state of having merit or value"/>
<rdf:Description rdf:about="&a;103771292">
	<b:glossaryEntry>the quality of being deserving (e.g., deserving assistance); "there were many children whose deservingness he recognized and rewarded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103771512"
	 b:glossaryEntry="the quality of being worthy of praise"/>
<rdf:Description rdf:about="&a;103771612"
	 b:glossaryEntry="the quality of being worthy of being quoted"/>
<rdf:Description rdf:about="&a;103771713">
	<b:glossaryEntry>(of motor vehicles) the quality of being fit to drive on the open road</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103771844"
	 b:glossaryEntry="the quality of being bad by virtue of lacking merit or value"/>
<rdf:Description rdf:about="&a;103772017"
	 b:glossaryEntry="unworthiness by virtue of lacking higher values"/>
<rdf:Description rdf:about="&a;103772170"
	 b:glossaryEntry="unworthiness meriting public disgrace and dishonor"/>
<rdf:Description rdf:about="&a;103772333"
	 b:glossaryEntry="disgracefulness that offends public morality"/>
<rdf:Description rdf:about="&a;103772438">
	<b:glossaryEntry>the quality of being widely admired or accepted or sought after: "his charm soon won him affection and popularity"; "the universal popularity of American movies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103772728">
	<b:glossaryEntry>the quality of being popular; "skiing is hot stuff in New Hampshire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103772852"
	 b:glossaryEntry="the quality of lacking general approval or acceptance"/>
<rdf:Description rdf:about="&a;103772982"
	 b:glossaryEntry="lawfulness by virtue of conformity to a legal statute"/>
<rdf:Description rdf:about="&a;103773162"
	 b:glossaryEntry="the quality of having legal force or effectiveness"/>
<rdf:Description rdf:about="&a;103773297">
	<b:glossaryEntry>(of a law) having legal validity; "the law is still in effect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103773420"
	 b:glossaryEntry="the quality of conforming to law"/>
<rdf:Description rdf:about="&a;103773617">
	<b:glossaryEntry>lawfulness by virtue of being authorized or in accordance with law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103773758"
	 b:glossaryEntry="the quality of strictly conforming to law"/>
<rdf:Description rdf:about="&a;103773873"
	 b:glossaryEntry="unlawfulness by virtue of violating some legal statute"/>
<rdf:Description rdf:about="&a;103774020">
	<b:glossaryEntry>illogicality as a consequence of having a conclusion that does not follow from the premisses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103774201"
	 b:glossaryEntry="result of a fallacy or error in reasoning"/>
<rdf:Description rdf:about="&a;103774303"
	 b:glossaryEntry="the quality of failing to conform to law"/>
<rdf:Description rdf:about="&a;103774474"
	 b:glossaryEntry="illegality as a consequence of unlawful acts"/>
<rdf:Description rdf:about="&a;103774587">
	<b:glossaryEntry>unlawfulness by virtue of not being authorized by or in accordance with law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103774739"
	 b:glossaryEntry="the quality of not conforming strictly to law"/>
<rdf:Description rdf:about="&a;103774860"
	 b:glossaryEntry="a quality of refined gracefulness and good taste"/>
<rdf:Description rdf:about="&a;103775143">
	<b:glossaryEntry>distinctive and stylish elegance; "he wooed her with the confident dash of a cavalry officer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103775320">
	<b:glossaryEntry>the quality of being beautiful and delicate in appearance; "the daintiness of her touch"; "the fineness of her features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103775519"
	 b:glossaryEntry="elegance suggestive of a royal court"/>
<rdf:Description rdf:about="&a;103775613"
	 b:glossaryEntry="elegance indicated by good taste"/>
<rdf:Description rdf:about="&a;103775722"
	 b:glossaryEntry="elegance by virtue of fineness of manner and expression"/>
<rdf:Description rdf:about="&a;103775871"
	 b:glossaryEntry="elegance by virtue of being fashionable"/>
<rdf:Description rdf:about="&a;103776037"
	 b:glossaryEntry="stylishness as evidenced by a smart appearance"/>
<rdf:Description rdf:about="&a;103776178"
	 b:glossaryEntry="the quality of being magnificent or splendid or grand"/>
<rdf:Description rdf:about="&a;103776367">
	<b:glossaryEntry>brilliant or conspicuous success or effect: "the eclat of a great achievement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103776497">
	<b:glossaryEntry>ceremonial elegance and splendor; "entered with much eclat in a coach drawn by eight white horses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103776654">
	<b:glossaryEntry>(informal) elegance in dress or behavior; "she has a lot of class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103776772"
	 b:glossaryEntry="the quality of lacking refinement and good taste"/>
<rdf:Description rdf:about="&a;103777039">
	<b:glossaryEntry>the inelegance of someone stiff and unrelaxed (as by embarrassment)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103777223"
	 b:glossaryEntry="the quality of being rustic or gauche"/>
<rdf:Description rdf:about="&a;103777328"
	 b:glossaryEntry="lacking stylishness or neatness"/>
<rdf:Description rdf:about="&a;103777439">
	<b:glossaryEntry>a lack of elegance as a consequence of wearing threadbare or dirty clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103777613"
	 b:glossaryEntry="shabbiness by virtue of being in rags"/>
<rdf:Description rdf:about="&a;103777707"
	 b:glossaryEntry="the quality of lacking taste and refinement"/>
<rdf:Description rdf:about="&a;103777856">
	<b:glossaryEntry>an unpolished unrefined quality; "the crudeness of frontier dwellings depressed her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103778008"
	 b:glossaryEntry="inelegance by virtue of being an uncouth boor"/>
<rdf:Description rdf:about="&a;103778125"
	 b:glossaryEntry="lack of elegance as a consequence of pomposity"/>
<rdf:Description rdf:about="&a;103778306"
	 b:glossaryEntry="inelegance indicated by a lack of good taste"/>
<rdf:Description rdf:about="&a;103778464"
	 b:glossaryEntry="tastelessness by virtue of being cheap and vulgar"/>
<rdf:Description rdf:about="&a;103778596"
	 b:glossaryEntry="tasteless showiness"/>
<rdf:Description rdf:about="&a;103778760"
	 b:glossaryEntry="the quality of comprehensible language or thought"/>
<rdf:Description rdf:about="&a;103778983"
	 b:glossaryEntry="writing (print or handwriting) that can be easily read"/>
<rdf:Description rdf:about="&a;103779126"
	 b:glossaryEntry="language that can be understood"/>
<rdf:Description rdf:about="&a;103779255"
	 b:glossaryEntry="the quality of being expressive"/>
<rdf:Description rdf:about="&a;103779347"
	 b:glossaryEntry="written language that is readily intelligible"/>
<rdf:Description rdf:about="&a;103779450">
	<b:glossaryEntry>free from obscurity and easy to understand; the comprehensibility of clear expression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103779818">
	<b:glossaryEntry>having a single meaning (absence of ambiguity) usually of individual words or phrases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103779976">
	<b:glossaryEntry>maximum clarity or distinctness of an idea; "the controversy brought clearly into focus an important difference of opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103780151"
	 b:glossaryEntry="logical and orderly and consistent relation of parts"/>
<rdf:Description rdf:about="&a;103780271"
	 b:glossaryEntry="clarity as a consequence of precision"/>
<rdf:Description rdf:about="&a;103780381"
	 b:glossaryEntry="clarity as a consequence of being perspicuous"/>
<rdf:Description rdf:about="&a;103780514"
	 b:glossaryEntry="clarity achieved by the avoidance of ambiguity"/>
<rdf:Description rdf:about="&a;103780672"
	 b:glossaryEntry="clarity as a consequence of being explicit"/>
<rdf:Description rdf:about="&a;103780827"
	 b:glossaryEntry="the quality of being incomprehensible"/>
<rdf:Description rdf:about="&a;103781074">
	<b:glossaryEntry>the quality of being impossible to investigate; "the inscrutability of the future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103781217"
	 b:glossaryEntry="writing (print or handwriting) that cannot be deciphered"/>
<rdf:Description rdf:about="&a;103781350">
	<b:glossaryEntry>incomprehensibility by virtue of being too dense to understand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103781493"
	 b:glossaryEntry="incomprehensibility resulting from obscurity of meaning"/>
<rdf:Description rdf:about="&a;103781615">
	<b:glossaryEntry>the quality of being unclear or abstruse and hard to understand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103781797"
	 b:glossaryEntry="incomprehensibility as a consequence of being unintelligible"/>
<rdf:Description rdf:about="&a;103781939"
	 b:glossaryEntry="incomprehensibility as a result of not being clear"/>
<rdf:Description rdf:about="&a;103782137">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the quality of being difficult to grasp or pin down: "the author''s elusiveness may at times be construed as evasiveness"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103782315"
	 b:glossaryEntry="unclearness by virtue of being vague"/>
<rdf:Description rdf:about="&a;103782425"
	 b:glossaryEntry="vagueness attributable to being not clearly defined"/>
<rdf:Description rdf:about="&a;103782531"
	 b:glossaryEntry="unclearness by virtue of not being explicit"/>
<rdf:Description rdf:about="&a;103782671"
	 b:glossaryEntry="inexplicitness as a consequence of being implied or indirect"/>
<rdf:Description rdf:about="&a;103782790"
	 b:glossaryEntry="unclearness by virtue of having more than one meaning"/>
<rdf:Description rdf:about="&a;103782987"
	 b:glossaryEntry="deliberate vagueness or ambiguity"/>
<rdf:Description rdf:about="&a;103783093">
	<b:glossaryEntry>the ambiguity of an individual word or phrase that can be used (in different contexts) to express two or more different meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103783294"
	 b:glossaryEntry="adhering to moral principles"/>
<rdf:Description rdf:about="&a;103783526"
	 b:glossaryEntry="uprightness as a consequence of being honorable and honest"/>
<rdf:Description rdf:about="&a;103783654"
	 b:glossaryEntry="righteousness by virtue of being pious"/>
<rdf:Description rdf:about="&a;103783864"
	 b:glossaryEntry="piety by virtue of being devout"/>
<rdf:Description rdf:about="&a;103783986"
	 b:glossaryEntry="exaggerated or affected piety"/>
<rdf:Description rdf:about="&a;103784083"
	 b:glossaryEntry="piety by virtue of devotion to duty"/>
<rdf:Description rdf:about="&a;103784176"
	 b:glossaryEntry="piety by virtue of being a godly person"/>
<rdf:Description rdf:about="&a;103784289"
	 b:glossaryEntry="failure to adhere to moral principles"/>
<rdf:Description rdf:about="&a;103784496"
	 b:glossaryEntry="estrangement from god"/>
<rdf:Description rdf:about="&a;103784611">
	<b:glossaryEntry>the mark that God set upon Cain now refers to a person''s sinful nature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103784740"
	 b:glossaryEntry="unrighteousness by virtue of lacking respect for a god"/>
<rdf:Description rdf:about="&a;103784934"
	 b:glossaryEntry="impiety characterized by lack of devotion to duty"/>
<rdf:Description rdf:about="&a;103785043"
	 b:glossaryEntry="the quality of not being devout"/>
<rdf:Description rdf:about="&a;103785149"
	 b:glossaryEntry="impiety by virtue of not being a godly person"/>
<rdf:Description rdf:about="&a;103785284">
	<b:glossaryEntry>the quality of compassion or consideration for others (people or animals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103785504"
	 b:glossaryEntry="the quality of being humane"/>
<rdf:Description rdf:about="&a;103785586">
	<b:glossaryEntry>a disposition to be kind and forgiving; "in those days a wife had to depend on the mercifulness of her husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103785836">
	<b:glossaryEntry>the humane quality of understanding the suffering of others and wanting to do something about it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103785996"
	 b:glossaryEntry="tendency to be kind and forgiving"/>
<rdf:Description rdf:about="&a;103786100"
	 b:glossaryEntry="mercifulness as a consequence of being lenient or tolerant"/>
<rdf:Description rdf:about="&a;103786244">
	<b:glossaryEntry>the quality of lacking compassion or consideration for others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103786431"
	 b:glossaryEntry="the quality of being shockingly cruel and inhumane"/>
<rdf:Description rdf:about="&a;103786594"
	 b:glossaryEntry="the trait of extreme cruelty"/>
<rdf:Description rdf:about="&a;103786732"
	 b:glossaryEntry="cruelty evidence by a capability to commit murder"/>
<rdf:Description rdf:about="&a;103786860">
	<b:glossaryEntry>inhumaneness evidenced by an unwillingness to be kind or forgiving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103787057"
	 b:glossaryEntry="mercilessness characterized by a lack of pity"/>
<rdf:Description rdf:about="&a;103787176">
	<b:glossaryEntry>mercilessness characterized by an unwillingness to relent or let up; "the relentlessness or their pursuit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103787376"
	 b:glossaryEntry="the trait of being willing to give your money or time"/>
<rdf:Description rdf:about="&a;103787645">
	<b:glossaryEntry>generosity as manifested by practicing charity (as for the poor or unfortunate)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103787785"
	 b:glossaryEntry="generosity evidenced by a willingness to give freely"/>
<rdf:Description rdf:about="&a;103787906"
	 b:glossaryEntry="the quality of being kind and generous"/>
<rdf:Description rdf:about="&a;103788005"
	 b:glossaryEntry="the trait of being generous in behavior and temperament"/>
<rdf:Description rdf:about="&a;103788167"
	 b:glossaryEntry="extremely liberal generosity of spirit"/>
<rdf:Description rdf:about="&a;103788315">
	<b:glossaryEntry>the quality of not putting yourself first but being willing to give your time or money or effort etc. for others; "rural people show more devotion and unselfishness than do their urban cousins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103788604"
	 b:glossaryEntry="the quality of unselfish concern for the welfare of others"/>
<rdf:Description rdf:about="&a;103788750">
	<b:glossaryEntry>a lack of generosity; a general unwillingness to part with money</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103788961"
	 b:glossaryEntry="extreme stinginess"/>
<rdf:Description rdf:about="&a;103789185"
	 b:glossaryEntry="lack of generosity in trifling matters"/>
<rdf:Description rdf:about="&a;103789279"
	 b:glossaryEntry="total lack of generosity with money"/>
<rdf:Description rdf:about="&a;103789372"
	 b:glossaryEntry="a disposition to be niggardly with money"/>
<rdf:Description rdf:about="&a;103789472"
	 b:glossaryEntry="a disposition not to be liberal (generous) with money"/>
<rdf:Description rdf:about="&a;103789602">
	<b:glossaryEntry>stinginess resulting from a concern for your own welfare and a disregard of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103789796">
	<b:glossaryEntry>an excessive desire for wealth (usually in large amounts); "the greediness of lawyers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103789939">
	<b:glossaryEntry>attempting to get personal recognition for yourself (especially by unacceptable means)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103790179"
	 b:glossaryEntry="an exceptional interest in and admiration for yourself"/>
<rdf:Description rdf:about="&a;103790312">
	<b:glossaryEntry>taking advantage of opportunities without regard for the consequences for others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103790494">
	<b:glossaryEntry>the trait of being highly motivated; "his drive and energy exhausted his co-workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103790720">
	<b:glossaryEntry>the trait of being active and energetic and forceful; "a man of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103790844"
	 b:glossaryEntry="readiness to embark on bold new ventures"/>
<rdf:Description rdf:about="&a;103790984"
	 b:glossaryEntry="a strong drive for success"/>
<rdf:Description rdf:about="&a;103791153"
	 b:glossaryEntry="a will to succeed"/>
<rdf:Description rdf:about="&a;103791227"
	 b:glossaryEntry="a drive to acquire power"/>
<rdf:Description rdf:about="&a;103791327">
	<b:glossaryEntry>enterprising or ambitious drive; "Europeans often laugh at American energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103791478"
	 b:glossaryEntry="the quality of being bold and enterprising"/>
<rdf:Description rdf:about="&a;103791653">
	<b:glossaryEntry>an aggressive willingness to compete; "the team was full of fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103791789"
	 b:glossaryEntry="a militant aggressiveness"/>
<rdf:Description rdf:about="&a;103791916"
	 b:glossaryEntry="the trait of being scrappy and pugnacious"/>
<rdf:Description rdf:about="&a;103792015">
	<b:glossaryEntry>aggressiveness as evidenced by intruding--by advancing oneself or one''s ideas without invitation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103792240">
	<b:glossaryEntry xml:space='preserve'><![CDATA[impudent aggressiveness; "I couldn''t believe her boldness"; "he had the effrontery to question my honesty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103792463">
	<b:glossaryEntry>aggressive boldness or unmitigated effrontery; "he had the audacity to question my decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103792664">
	<b:glossaryEntry>audacious (even arrogant) behavior that you have no right to; "he despised them for their presumptuousness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103792879"
	 b:glossaryEntry="assumption of airs beyond one''s station"/>
<rdf:Description rdf:about="&a;103792988">
	<b:glossaryEntry>conformity with rules or standards; "the judge recognized the fairness of my claim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103793243"
	 b:glossaryEntry="fairness in treating people without prejudice"/>
<rdf:Description rdf:about="&a;103793353"
	 b:glossaryEntry="fairness in following the rules of the game"/>
<rdf:Description rdf:about="&a;103793456"
	 b:glossaryEntry="injustice by virtue of not being equitable"/>
<rdf:Description rdf:about="&a;103793620">
	<b:glossaryEntry>the use of dubious (although not technically illegal) methods to win a game</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103793754">
	<b:glossaryEntry>the quality of being warm-hearted and considerate and humane and sympathetic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103794011"
	 b:glossaryEntry="an inclination to do kind or charitable acts"/>
<rdf:Description rdf:about="&a;103794149"
	 b:glossaryEntry="a kindly and lenient attitude toward people"/>
<rdf:Description rdf:about="&a;103794281"
	 b:glossaryEntry="the quality of being kind or helpful or generous"/>
<rdf:Description rdf:about="&a;103794441">
	<b:glossaryEntry>free and unmerited favor or beneficence of God: "there but for the grace of God go I"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103794578"
	 b:glossaryEntry="the quality of being kind and gentle"/>
<rdf:Description rdf:about="&a;103794752"
	 b:glossaryEntry="tender kindness motivated by a feeling of affection"/>
<rdf:Description rdf:about="&a;103794865">
	<b:glossaryEntry>kind and considerate regard for others; "he showed no consideration for her feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103795117"
	 b:glossaryEntry="friendliness evidence by a kindly and helpful disposition"/>
<rdf:Description rdf:about="&a;103795245">
	<b:glossaryEntry>consideration in dealing with others and avoiding giving offence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103795428"
	 b:glossaryEntry="subtly skillful handling of a situation"/>
<rdf:Description rdf:about="&a;103795559"
	 b:glossaryEntry="social skill"/>
<rdf:Description rdf:about="&a;103795640"
	 b:glossaryEntry="the quality of threatening evil"/>
<rdf:Description rdf:about="&a;103795824">
	<b:glossaryEntry>malevolence by virtue of being malicious or spiteful or nasty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103795989"
	 b:glossaryEntry="quality of being disposed to evil; intense ill will"/>
<rdf:Description rdf:about="&a;103796176">
	<b:glossaryEntry>the ability to respond to affective changes in your interpersonal environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103796381">
	<b:glossaryEntry>sensitivity similar to that of a receptor organ; "he had a special antenna for public relations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103796540"
	 b:glossaryEntry="the quality of insight and sympathetic understanding"/>
<rdf:Description rdf:about="&a;103796671">
	<b:glossaryEntry>the inability to respond to affective changes in your interpersonal environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103796936"
	 b:glossaryEntry="the quality of being crass--devoid of refinement"/>
<rdf:Description rdf:about="&a;103797053"
	 b:glossaryEntry="devoid of passion or feeling"/>
<rdf:Description rdf:about="&a;103797182"
	 b:glossaryEntry="the lack of insight and sympathetic understanding"/>
<rdf:Description rdf:about="&a;103797312"
	 b:glossaryEntry="lack of sympathy"/>
<rdf:Description rdf:about="&a;103797439"
	 b:glossaryEntry="the quality of being cruel and causing tension or annoyance"/>
<rdf:Description rdf:about="&a;103797612"
	 b:glossaryEntry="the quality of being deliberately mean"/>
<rdf:Description rdf:about="&a;103797719"
	 b:glossaryEntry="an inability to be helpful"/>
<rdf:Description rdf:about="&a;103797805"
	 b:glossaryEntry="the quality of failing to be considerate of others"/>
<rdf:Description rdf:about="&a;103798027"
	 b:glossaryEntry="the quality of lacking tact"/>
<rdf:Description rdf:about="&a;103798131">
	<b:glossaryEntry>the quality of being direct and outspoken; "the bluntness of a Yorkshireman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103798263"
	 b:glossaryEntry="the quality or nature of being harmful or evil"/>
<rdf:Description rdf:about="&a;103798428">
	<b:glossaryEntry>concern with the distinction between good and evil or right and wrong; right or good conduct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103798773"
	 b:glossaryEntry="according with conscience or morality"/>
<rdf:Description rdf:about="&a;103798920">
	<b:glossaryEntry>the quality of doing what is right and avoiding what is wrong</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103799068"
	 b:glossaryEntry="a particular moral excellence"/>
<rdf:Description rdf:about="&a;103799168"
	 b:glossaryEntry="one of the seven preeminent virtues"/>
<rdf:Description rdf:about="&a;103799301">
	<b:glossaryEntry>(scholasticism) one of the four virtues (prudence and justice and fortitude and temperance) derived from nature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103799545">
	<b:glossaryEntry>according to Christian ethics: one of the three virtues (faith and hope and charity) created by God to round out the natural virtues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103799818"
	 b:glossaryEntry="the quality of resembling a saint"/>
<rdf:Description rdf:about="&a;103799909">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conformity to one''s own sense of right conduct: "a person of unflagging conscience"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103800085">
	<b:glossaryEntry>the quality of being in accord with the dictates of conscience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103800229">
	<b:glossaryEntry>the quality of being willing to ignore the dictates of conscience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103800378">
	<b:glossaryEntry>moral excellence or admirableness: "there is much good to be found in people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103800697">
	<b:glossaryEntry>the supreme good in which all moral values are included or from which they are derived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103800842"
	 b:glossaryEntry="morality with respect to sexual relations"/>
<rdf:Description rdf:about="&a;103801019"
	 b:glossaryEntry="a woman''s virtue or chastity"/>
<rdf:Description rdf:about="&a;103801117"
	 b:glossaryEntry="the quality of being just or fair"/>
<rdf:Description rdf:about="&a;103801287">
	<b:glossaryEntry>anything in accord with principles of justice; "he feels he is in the right"; "the rightfulness of his claim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103801499">
	<b:glossaryEntry>the quality of not being in accord with standards of right or good conduct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103801774">
	<b:glossaryEntry>moral perversion; impairment of virtue and moral principles: "the luxury and corruption among the upper classes"; "moral degeneracy followed intellectual degeneration"; "its brothels; its opium parlors; its depravity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103802073"
	 b:glossaryEntry="the capability of being corrupted"/>
<rdf:Description rdf:about="&a;103802185"
	 b:glossaryEntry="the quality of being lewd and lascivious"/>
<rdf:Description rdf:about="&a;103802319"
	 b:glossaryEntry="lack of moral standards in a society"/>
<rdf:Description rdf:about="&a;103802408"
	 b:glossaryEntry="contrary to conscience or morality"/>
<rdf:Description rdf:about="&a;103802516">
	<b:glossaryEntry>the quality of being morally wrong in principle or practice: "attempts to explain the origin of evil in the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103802926">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the greatest damage or wickedness of which one is capable: "the invaders did their worst"; "so pure of heart that his worst is another man''s best"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103803124"
	 b:glossaryEntry="the quality of being wicked"/>
<rdf:Description rdf:about="&a;103803253"
	 b:glossaryEntry="the quality of extreme wickedness"/>
<rdf:Description rdf:about="&a;103803341">
	<b:glossaryEntry>being reprehensible; worthy of and deserving reprehension or reproof</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103803472"
	 b:glossaryEntry="the quality of evil by virtue of villainous behavior"/>
<rdf:Description rdf:about="&a;103803596"
	 b:glossaryEntry="deliberately deviating from what is good"/>
<rdf:Description rdf:about="&a;103803693"
	 b:glossaryEntry="departure from what is ethically acceptable"/>
<rdf:Description rdf:about="&a;103803801"
	 b:glossaryEntry="moral weakness"/>
<rdf:Description rdf:about="&a;103803876">
	<b:glossaryEntry>lack of integrity or honesty; esp susceptibility to bribery; use of a position of trust for dishonest gain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103804143"
	 b:glossaryEntry="prostitution of talents or offices or services for reward"/>
<rdf:Description rdf:about="&a;103804255"
	 b:glossaryEntry="the practice of being unjust or unfair"/>
<rdf:Description rdf:about="&a;103804416">
	<b:glossaryEntry>that which is contrary to the principles of justice or law; "he feels that you are in the wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103804615">
	<b:glossaryEntry>the quality of being divine; "ancient Egyptians believed in the divinity of the Pharaohs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103804759"
	 b:glossaryEntry="the quality of being holy"/>
<rdf:Description rdf:about="&a;103804922"
	 b:glossaryEntry="the quality of being sacred"/>
<rdf:Description rdf:about="&a;103805006"
	 b:glossaryEntry="the quality of being unholy"/>
<rdf:Description rdf:about="&a;103805126"
	 b:glossaryEntry="unholiness by virtue of being profane"/>
<rdf:Description rdf:about="&a;103805258"
	 b:glossaryEntry="profaneness by virtue of committing sacrilege"/>
<rdf:Description rdf:about="&a;103805366"
	 b:glossaryEntry="the quality of being safe"/>
<rdf:Description rdf:about="&a;103805464"
	 b:glossaryEntry="the quality of not being safe"/>
<rdf:Description rdf:about="&a;103805589"
	 b:glossaryEntry="extreme dangerousness"/>
<rdf:Description rdf:about="&a;103805671"
	 b:glossaryEntry="capability of being cured or healed"/>
<rdf:Description rdf:about="&a;103805813"
	 b:glossaryEntry="incapability of being cured or healed"/>
<rdf:Description rdf:about="&a;103805961">
	<b:glossaryEntry>a quality of spirit that enables you to face danger of pain without showing fear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103806284">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the courage to carry on: "he kept fighting on pure spunk"; "you haven''t got the heart for baseball"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103806460">
	<b:glossaryEntry>the qualities of a hero or heroine; exceptional or heroic courage when facing danger (especially in battle); "he showed great heroism in battle"; "he received a medal for valor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103806773"
	 b:glossaryEntry="resolute courageousness"/>
<rdf:Description rdf:about="&a;103806870"
	 b:glossaryEntry="courage resulting from intoxication"/>
<rdf:Description rdf:about="&a;103806965"
	 b:glossaryEntry="the trait of having a courageous spirit"/>
<rdf:Description rdf:about="&a;103807085"
	 b:glossaryEntry="the trait of feeling no fear"/>
<rdf:Description rdf:about="&a;103807244"
	 b:glossaryEntry="fearless self-possession in the face of danger"/>
<rdf:Description rdf:about="&a;103807361">
	<b:glossaryEntry>the trait of being willing to undertake things that involve risk or danger; "the proposal required great boldness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103807659"
	 b:glossaryEntry="the trait of being adventurous"/>
<rdf:Description rdf:about="&a;103807769"
	 b:glossaryEntry="boldness as manifested in rash and daredevil behavior"/>
<rdf:Description rdf:about="&a;103807895"
	 b:glossaryEntry="fearless daring"/>
<rdf:Description rdf:about="&a;103807992">
	<b:glossaryEntry>behavior marked by a bold defiance of the proprieties and lack of shame</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103808136">
	<b:glossaryEntry>the trait of showing courage and determination in spite of possible loss or injury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103808313"
	 b:glossaryEntry="the trait of lacking courage"/>
<rdf:Description rdf:about="&a;103808502"
	 b:glossaryEntry="mean-spirited cowardice"/>
<rdf:Description rdf:about="&a;103808582"
	 b:glossaryEntry="the trait of lacking boldness and courage"/>
<rdf:Description rdf:about="&a;103808704"
	 b:glossaryEntry="the trait of being afraid"/>
<rdf:Description rdf:about="&a;103808859">
	<b:glossaryEntry>fearfulness in venturing into new and unknown places or activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103809049"
	 b:glossaryEntry="contemptible fearfulness"/>
<rdf:Description rdf:about="&a;103809171"
	 b:glossaryEntry="abject pusillanimity"/>
<rdf:Description rdf:about="&a;103809249"
	 b:glossaryEntry="treacherous cowardice"/>
<rdf:Description rdf:about="&a;103809330">
	<b:glossaryEntry>the trait of lacking courage and determination; fearful of loss or injury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103809479">
	<b:glossaryEntry>the trait of being resolute; firmness of purpose; "his resoluteness carried him through the battle"; "it was his unshakeable resolution to finish the work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103809871"
	 b:glossaryEntry="control of one''s behavior"/>
<rdf:Description rdf:about="&a;103810030">
	<b:glossaryEntry>control of your emotions; "this kind of tension is not good for my nerves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103810157">
	<b:glossaryEntry>self-control in a crisis; ability to say or do the right thing in an emergency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103810298"
	 b:glossaryEntry="resolute adherence to your own ideas or desires"/>
<rdf:Description rdf:about="&a;103810510"
	 b:glossaryEntry="the trait of refusing to repent"/>
<rdf:Description rdf:about="&a;103810613">
	<b:glossaryEntry>the trait of being intransigent; stubbornly refusing to compromise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103810755"
	 b:glossaryEntry="characterized by one unified purpose"/>
<rdf:Description rdf:about="&a;103810855"
	 b:glossaryEntry="resoluteness by virtue of being unyielding and inflexible"/>
<rdf:Description rdf:about="&a;103810995">
	<b:glossaryEntry>the trait of resoluteness as evidenced by firmness of character or purpose; "a man of unusual decisiveness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103811208">
	<b:glossaryEntry>the quality of being determined to do or achieve something; "his determination showed in his every movement"; "he is a man of purpose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103811466"
	 b:glossaryEntry="persistent determination"/>
<rdf:Description rdf:about="&a;103811631"
	 b:glossaryEntry="tireless determination"/>
<rdf:Description rdf:about="&a;103811751"
	 b:glossaryEntry="steadfast resolution"/>
<rdf:Description rdf:about="&a;103811831">
	<b:glossaryEntry>persevering determination to perform a task; "his diligence won him quick promotions"; "frugality and industry are still regarded as virtues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103812111"
	 b:glossaryEntry="great diligence"/>
<rdf:Description rdf:about="&a;103812250">
	<b:glossaryEntry>the quality of being intent and concentrated; "the intentness of his gaze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103812395">
	<b:glossaryEntry>the quality of concentrating on one central objective: "his singleness of purpose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103812534"
	 b:glossaryEntry="the quality of constantly diligent and attentive"/>
<rdf:Description rdf:about="&a;103812652"
	 b:glossaryEntry="diligent study"/>
<rdf:Description rdf:about="&a;103812743"
	 b:glossaryEntry="exaggerated studiousness"/>
<rdf:Description rdf:about="&a;103812825"
	 b:glossaryEntry="the trait of being irresolute; lacking firmness of purpose"/>
<rdf:Description rdf:about="&a;103813013"
	 b:glossaryEntry="the trait of being unpredictably irresolute"/>
<rdf:Description rdf:about="&a;103813132">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the trait of irresolution; a lack of firmness of character or purpose; "the king''s incurable indecisiveness caused turmoil in his court"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103813378">
	<b:glossaryEntry>the quality of being open and truthful; not deceitful or hypocritical; "his sincerity inspired belief"; "they demanded some proof of my sincerity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103813670"
	 b:glossaryEntry='(archaic) truth or reality; "in sooth"'/>
<rdf:Description rdf:about="&a;103813760"
	 b:glossaryEntry="the quality of hearty sincerity"/>
<rdf:Description rdf:about="&a;103813867">
	<b:glossaryEntry>without hypocrisy: "the singleness of his motives could not be questioned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103814020">
	<b:glossaryEntry>the quality of not being open or truthful; deceitful or hypocritical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103814194">
	<b:glossaryEntry>insincerity by virtue of pretending to have qualities or beliefs that you do not really have</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103814378"
	 b:glossaryEntry="the quality of being hypocritically devout"/>
<rdf:Description rdf:about="&a;103814497"
	 b:glossaryEntry="smug self-serving earnestness"/>
<rdf:Description rdf:about="&a;103814650">
	<b:glossaryEntry>the quality of deserving honor or respect; characterized by honor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103814900">
	<b:glossaryEntry>the quality of being honorable and having a good name; "a man of honor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103815050"
	 b:glossaryEntry="conformity to high standards of ethics or excellence"/>
<rdf:Description rdf:about="&a;103815181"
	 b:glossaryEntry="moral soundness"/>
<rdf:Description rdf:about="&a;103815289"
	 b:glossaryEntry="complete and confirmed integrity"/>
<rdf:Description rdf:about="&a;103815375"
	 b:glossaryEntry="characterized by integrity or probity"/>
<rdf:Description rdf:about="&a;103815505"
	 b:glossaryEntry="the incapability of being corrupted"/>
<rdf:Description rdf:about="&a;103815621">
	<b:glossaryEntry>the quality of being exalted in character or ideals or conduct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103815839">
	<b:glossaryEntry>elevated ideals or conduct; the quality of believing that ideals should be pursued</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103816013"
	 b:glossaryEntry="nobility in thought or feeling or style"/>
<rdf:Description rdf:about="&a;103816122">
	<b:glossaryEntry>honorableness by virtue of being respectable and having a good reputation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103816325"
	 b:glossaryEntry="the quality of being polite and respectable"/>
<rdf:Description rdf:about="&a;103816422"
	 b:glossaryEntry="the quality of being honest"/>
<rdf:Description rdf:about="&a;103816696">
	<b:glossaryEntry>the quality of being honest and straightforward in attitude and speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103816889">
	<b:glossaryEntry>having honest intentions; "he acted in good faith"; "doubt was expressed as to the good faith of the immigrants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103817073"
	 b:glossaryEntry="the quality of being truthful"/>
<rdf:Description rdf:about="&a;103817233"
	 b:glossaryEntry="unwillingness to tell lies"/>
<rdf:Description rdf:about="&a;103817332"
	 b:glossaryEntry="openly straightforward or frank"/>
<rdf:Description rdf:about="&a;103817459"
	 b:glossaryEntry="ingenuousness by virtue of being free from artful deceit"/>
<rdf:Description rdf:about="&a;103817591"
	 b:glossaryEntry="a quality appropriate to a parent"/>
<rdf:Description rdf:about="&a;103817723">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the tenderness and warmth and affection of or befitting a mother: "the girl''s motherliness made her invaluable in caring for the children"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103817957">
	<b:glossaryEntry>the benignity and protectiveness of or befitting a father: "the gentleness and fatherliness of the strange old man eased her fears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103818184"
	 b:glossaryEntry="the quality of not deserving honor or respect"/>
<rdf:Description rdf:about="&a;103818366"
	 b:glossaryEntry="the quality of being ignoble"/>
<rdf:Description rdf:about="&a;103818452"
	 b:glossaryEntry="lacking honor or integrity"/>
<rdf:Description rdf:about="&a;103818581"
	 b:glossaryEntry="the quality of unscrupulous dishonesty"/>
<rdf:Description rdf:about="&a;103818700">
	<b:glossaryEntry>dishonorableness by virtue of lacking respectability or a good reputation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103818909"
	 b:glossaryEntry="the quality of being dishonest"/>
<rdf:Description rdf:about="&a;103819176"
	 b:glossaryEntry="the quality of being deceptive"/>
<rdf:Description rdf:about="&a;103819296">
	<b:glossaryEntry>an appearance of truth that is false or deceptive; seeming plausibility: "the speciousness of his argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103819481"
	 b:glossaryEntry="the quality of being fraudulent"/>
<rdf:Description rdf:about="&a;103819579"
	 b:glossaryEntry="corruptness among public officials"/>
<rdf:Description rdf:about="&a;103819667"
	 b:glossaryEntry="the quality of being deceitful and underhanded"/>
<rdf:Description rdf:about="&a;103819785"
	 b:glossaryEntry="the quality of being a slippery rascal"/>
<rdf:Description rdf:about="&a;103819920"
	 b:glossaryEntry="having a disposition to steal"/>
<rdf:Description rdf:about="&a;103820020"
	 b:glossaryEntry="the quality of being untruthful"/>
<rdf:Description rdf:about="&a;103820184"
	 b:glossaryEntry="the tendency to be untruthful"/>
<rdf:Description rdf:about="&a;103820287"
	 b:glossaryEntry="intentionally vague or ambiguous"/>
<rdf:Description rdf:about="&a;103820408"
	 b:glossaryEntry="the quality of being disingenuous and lacking candor"/>
<rdf:Description rdf:about="&a;103820577"
	 b:glossaryEntry="the quality of being crafty"/>
<rdf:Description rdf:about="&a;103820685"
	 b:glossaryEntry="the quality of being adroit in taking unfair advantage"/>
<rdf:Description rdf:about="&a;103820832"
	 b:glossaryEntry="drafty artfulness (especially in deception)"/>
<rdf:Description rdf:about="&a;103820929"
	 b:glossaryEntry="the quality of being faithful"/>
<rdf:Description rdf:about="&a;103821154">
	<b:glossaryEntry>faithfulness in personal attachment (especially sexual fidelity)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103821274"
	 b:glossaryEntry="complete and wholehearted fidelity"/>
<rdf:Description rdf:about="&a;103821365"
	 b:glossaryEntry="the quality of being loyal"/>
<rdf:Description rdf:about="&a;103821553"
	 b:glossaryEntry="loyalty in the face of trouble and difficulty"/>
<rdf:Description rdf:about="&a;103821672">
	<b:glossaryEntry>the loyalty that citizens owe to their country (or subjects to their sovereign)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103821817"
	 b:glossaryEntry="love of country and willingness to sacrifice for it"/>
<rdf:Description rdf:about="&a;103821975"
	 b:glossaryEntry="loyalty to the USA and its institutions"/>
<rdf:Description rdf:about="&a;103822072"
	 b:glossaryEntry="fanatical patriotism"/>
<rdf:Description rdf:about="&a;103822197"
	 b:glossaryEntry="the quality of being unfaithful"/>
<rdf:Description rdf:about="&a;103822374"
	 b:glossaryEntry="unfaithfulness by virtue of being unreliable or treacherous"/>
<rdf:Description rdf:about="&a;103822532"
	 b:glossaryEntry="the quality of being disloyal"/>
<rdf:Description rdf:about="&a;103822672"
	 b:glossaryEntry="disloyalty by virtue of subversive behavior"/>
<rdf:Description rdf:about="&a;103822821"
	 b:glossaryEntry="the quality of aiding an enemy"/>
<rdf:Description rdf:about="&a;103822906"
	 b:glossaryEntry="betrayal of a trust"/>
<rdf:Description rdf:about="&a;103823026"
	 b:glossaryEntry="the quality of being designed to entrap"/>
<rdf:Description rdf:about="&a;103823125">
	<b:glossaryEntry>the quality or character of being intellectually sophisticated through cultivation or experience or disillusionment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103823333"
	 b:glossaryEntry="lack of sophistication or worldliness"/>
<rdf:Description rdf:about="&a;103823518"
	 b:glossaryEntry="the quality of innocent naivete"/>
<rdf:Description rdf:about="&a;103823649">
	<b:glossaryEntry>tendency to believe too readily and therefore to be easily deceived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103823790">
	<b:glossaryEntry>a lack of penetration or subtlety; "they took advantage of her simplicity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103823941">
	<b:glossaryEntry>the trait of being well behaved; "he insisted on discipline among the troops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103824129"
	 b:glossaryEntry="the trait of practicing self discipline"/>
<rdf:Description rdf:about="&a;103824298">
	<b:glossaryEntry>the trait of great self-denial (especially refraining from worldly pleasures)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103824478"
	 b:glossaryEntry="asceticism practiced in a monastery"/>
<rdf:Description rdf:about="&a;103824571"
	 b:glossaryEntry="the trait of abstaining (especially from alcohol)"/>
<rdf:Description rdf:about="&a;103824690"
	 b:glossaryEntry="the exercise of self constraint in sexual matters"/>
<rdf:Description rdf:about="&a;103824809">
	<b:glossaryEntry>discipline in personal and social activities; "he was a model of polite restraint"; "she never lost control of herself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103825084">
	<b:glossaryEntry>exhibiting restraint imposed on the self; "an effective temperateness in debate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103825241"
	 b:glossaryEntry="the trait of avoiding excesses"/>
<rdf:Description rdf:about="&a;103825413"
	 b:glossaryEntry="moderation in or abstinence from alcohol or drugs"/>
<rdf:Description rdf:about="&a;103825517"
	 b:glossaryEntry="moderation in eating and drinking"/>
<rdf:Description rdf:about="&a;103825629"
	 b:glossaryEntry="the quality of being inhibited"/>
<rdf:Description rdf:about="&a;103825734"
	 b:glossaryEntry="voluntary control over urinary and fecal discharge"/>
<rdf:Description rdf:about="&a;103825841">
	<b:glossaryEntry>an inhibition or ban resulting from social custom or emotional aversion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103825971"
	 b:glossaryEntry="the trait of lacking discipline"/>
<rdf:Description rdf:about="&a;103826148">
	<b:glossaryEntry>an inability to resist the gratification of whims and desires</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103826302"
	 b:glossaryEntry="indiscipline with regard to sensuous pleasures"/>
<rdf:Description rdf:about="&a;103826462"
	 b:glossaryEntry="the quality of a rake"/>
<rdf:Description rdf:about="&a;103826540"
	 b:glossaryEntry="the quality of lacking restraint"/>
<rdf:Description rdf:about="&a;103826702"
	 b:glossaryEntry="the quality of being intemperate"/>
<rdf:Description rdf:about="&a;103826829">
	<b:glossaryEntry>the trait of lacking restraint or control; freedom from inhibition or worry; "she danced with abandon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103827013"
	 b:glossaryEntry="lack of restraint in use of alcohol"/>
<rdf:Description rdf:about="&a;103827106"
	 b:glossaryEntry="habitual eating to excess"/>
<rdf:Description rdf:about="&a;103827240"
	 b:glossaryEntry="an excessive desire for food"/>
<rdf:Description rdf:about="&a;103827353"
	 b:glossaryEntry="extreme gluttony"/>
<rdf:Description rdf:about="&a;103827489">
	<b:glossaryEntry>the trait of being spurred on by a dislike of falling below your standards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103827723"
	 b:glossaryEntry="pride in your city"/>
<rdf:Description rdf:about="&a;103827814">
	<b:glossaryEntry>the quality of being worthy of esteem or respect: "it was beneath his dignity to cheat"; "showed his true dignity when under pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103828045"
	 b:glossaryEntry="the trait of being vain and conceited"/>
<rdf:Description rdf:about="&a;103828199"
	 b:glossaryEntry="outspoken conceit"/>
<rdf:Description rdf:about="&a;103828287"
	 b:glossaryEntry="an exaggerated opinion of your own importance"/>
<rdf:Description rdf:about="&a;103828437"
	 b:glossaryEntry="adopting a vain conceited posture"/>
<rdf:Description rdf:about="&a;103828526"
	 b:glossaryEntry="an exaggerated estimate of your own value and importance"/>
<rdf:Description rdf:about="&a;103828648">
	<b:glossaryEntry>overbearing pride evidenced by a superior manner toward inferiors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103828886"
	 b:glossaryEntry="overbearing pride or presumption"/>
<rdf:Description rdf:about="&a;103828971"
	 b:glossaryEntry="the trait of being imperious and overbearing"/>
<rdf:Description rdf:about="&a;103829111">
	<b:glossaryEntry>the trait of displaying arrogance by patronizing those considered inferior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103829281">
	<b:glossaryEntry xml:space='preserve'><![CDATA[displaying a sense of being better than others; "he hated the white man''s superiority and condecension"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103829442"
	 b:glossaryEntry="the trait of condescending to those of lower social status"/>
<rdf:Description rdf:about="&a;103829588"
	 b:glossaryEntry="tendency to associate with only a select group"/>
<rdf:Description rdf:about="&a;103829724">
	<b:glossaryEntry>a disposition to be humble; a lack of false pride; "not everyone regards humility as a virtue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103829940"
	 b:glossaryEntry="a disposition to be patient and long suffering"/>
<rdf:Description rdf:about="&a;103830059">
	<b:glossaryEntry>the quality of lacking a strong character; an irresolute disposition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103830187">
	<b:glossaryEntry>the trait of utilizing knowledge and experience with common sense and insight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103830400">
	<b:glossaryEntry>the mental ability to form an opinion by distinguishing and evaluating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103830557"
	 b:glossaryEntry="wisdom in the management of public affairs"/>
<rdf:Description rdf:about="&a;103830684">
	<b:glossaryEntry>the trait of judging wisely and objectively; "a man of discenment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103830857"
	 b:glossaryEntry="the trait of being circumspect and prudent"/>
<rdf:Description rdf:about="&a;103831006"
	 b:glossaryEntry="the trait of acting stupidly or rashly"/>
<rdf:Description rdf:about="&a;103831177"
	 b:glossaryEntry="the trait of being injudicious"/>
<rdf:Description rdf:about="&a;103831284">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a ludicrous folly; "the crowd laughed at the absurdity of the clown''s behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103831455">
	<b:glossaryEntry>the capacity to assess situations or circumstances shrewdly and to draw sound conclusions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103831698">
	<b:glossaryEntry>judgment based on observable phenomena and uninfluenced by emotions or personal prejudices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103831862">
	<b:glossaryEntry>judgment based on individual personal impressions and feelings and opinions rather than external facts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103832040"
	 b:glossaryEntry="discretion in practical affairs"/>
<rdf:Description rdf:about="&a;103832198">
	<b:glossaryEntry>the prudence and care exercised by someone in the management of resources</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103832364"
	 b:glossaryEntry="providence by virtue of planning prudently for the future"/>
<rdf:Description rdf:about="&a;103832514"
	 b:glossaryEntry="prudence in avoiding waste"/>
<rdf:Description rdf:about="&a;103832645">
	<b:glossaryEntry>extreme care in spending money; reluctance to spend money unnecessarily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103832817">
	<b:glossaryEntry>frugality in the expenditure of money or resources; "the Scots are famous for their economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103832977"
	 b:glossaryEntry="a lack of caution in practical affairs"/>
<rdf:Description rdf:about="&a;103833126"
	 b:glossaryEntry="the trait of acting rashly and without prudence"/>
<rdf:Description rdf:about="&a;103833276"
	 b:glossaryEntry="a frivolous lack of prudence"/>
<rdf:Description rdf:about="&a;103833366">
	<b:glossaryEntry>a lack of prudence and care by someone in the management of resources</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103833567"
	 b:glossaryEntry="the trait of spending extravagantly"/>
<rdf:Description rdf:about="&a;103833688">
	<b:glossaryEntry>the trait of wasting resources; "a life characterized by thriftlessness and waste"; "the wastefulness of missed opportunities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103833898">
	<b:glossaryEntry>the trait of trusting; of believing in the honesty and reliability of others; "the experience destroyed his trust and personal dignity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103834151"
	 b:glossaryEntry="tendency to believe readily"/>
<rdf:Description rdf:about="&a;103834252"
	 b:glossaryEntry="too much credulity"/>
<rdf:Description rdf:about="&a;103834330"
	 b:glossaryEntry="the trait of not trusting others"/>
<rdf:Description rdf:about="&a;103834482">
	<b:glossaryEntry>being of a suspicious nature; "his suspiciousness destroyed his marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103834628"
	 b:glossaryEntry="diligence in keeping clean"/>
<rdf:Description rdf:about="&a;103834766">
	<b:glossaryEntry>the trait of being meticulous about matters of taste or style; "neatness and fastidiousness of dress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103834928"
	 b:glossaryEntry="the trait of being neat and orderly"/>
<rdf:Description rdf:about="&a;103835047"
	 b:glossaryEntry="lack of cleanly habits"/>
<rdf:Description rdf:about="&a;103835201"
	 b:glossaryEntry="habitual uncleanliness"/>
<rdf:Description rdf:about="&a;103835300"
	 b:glossaryEntry="in the manner of a slattern"/>
<rdf:Description rdf:about="&a;103835403"
	 b:glossaryEntry="an uncleanliness characteristic of peasants"/>
<rdf:Description rdf:about="&a;103835504"
	 b:glossaryEntry="the trait of being untidy and messy"/>
<rdf:Description rdf:about="&a;103835644"
	 b:glossaryEntry="untidiness (especially of clothing and appearance)"/>
<rdf:Description rdf:about="&a;103835766"
	 b:glossaryEntry="behavioral attributes"/>
<rdf:Description rdf:about="&a;103836008"
	 b:glossaryEntry='social deportment; "he has the manners of a pig"'/>
<rdf:Description rdf:about="&a;103836110"
	 b:glossaryEntry='conduct as a citizen; "award for good citizenship"'/>
<rdf:Description rdf:about="&a;103836218"
	 b:glossaryEntry="flamboyantly reckless and boastful behavior"/>
<rdf:Description rdf:about="&a;103836321"
	 b:glossaryEntry="correct or appropriate behavior"/>
<rdf:Description rdf:about="&a;103836634"
	 b:glossaryEntry="propriety in manners and conduct"/>
<rdf:Description rdf:about="&a;103836789"
	 b:glossaryEntry="appropriate conduct; doing the right thing"/>
<rdf:Description rdf:about="&a;103836923"
	 b:glossaryEntry="conformity to social expectations"/>
<rdf:Description rdf:about="&a;103837032"
	 b:glossaryEntry="exaggerated and arrogant properness"/>
<rdf:Description rdf:about="&a;103837137"
	 b:glossaryEntry="formality and propriety of manner"/>
<rdf:Description rdf:about="&a;103837252"
	 b:glossaryEntry="the trait of behaving with reserve and decorum"/>
<rdf:Description rdf:about="&a;103837355"
	 b:glossaryEntry="a sense of propriety and consideration for others"/>
<rdf:Description rdf:about="&a;103837487"
	 b:glossaryEntry="the quality of being becoming"/>
<rdf:Description rdf:about="&a;103837593">
	<b:glossaryEntry>the quality of conforming to standards of propriety and morality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103837747"
	 b:glossaryEntry="freedom from vanity or conceit"/>
<rdf:Description rdf:about="&a;103837903"
	 b:glossaryEntry="excessive or affected modesty"/>
<rdf:Description rdf:about="&a;103838023"
	 b:glossaryEntry="an improper demeanor"/>
<rdf:Description rdf:about="&a;103838242"
	 b:glossaryEntry="lack of conformity to social expectations"/>
<rdf:Description rdf:about="&a;103838361"
	 b:glossaryEntry="inappropriate conduct"/>
<rdf:Description rdf:about="&a;103838476"
	 b:glossaryEntry="the trait of being indelicate and offensive"/>
<rdf:Description rdf:about="&a;103838594"
	 b:glossaryEntry="behavior or language bordering on indelicacy"/>
<rdf:Description rdf:about="&a;103838727"
	 b:glossaryEntry="a lack of decorum"/>
<rdf:Description rdf:about="&a;103838889"
	 b:glossaryEntry="a lack of consideration for others"/>
<rdf:Description rdf:about="&a;103839000"
	 b:glossaryEntry="the quality of being unbecoming"/>
<rdf:Description rdf:about="&a;103839110"
	 b:glossaryEntry="the quality of being indecent"/>
<rdf:Description rdf:about="&a;103839267"
	 b:glossaryEntry="the trait of being vain and conceited"/>
<rdf:Description rdf:about="&a;103839378"
	 b:glossaryEntry="the quality of being outrageous"/>
<rdf:Description rdf:about="&a;103839481"
	 b:glossaryEntry="the trait of behaving in an obscene manner"/>
<rdf:Description rdf:about="&a;103839647"
	 b:glossaryEntry="obscenity in speech or writing"/>
<rdf:Description rdf:about="&a;103839746">
	<b:glossaryEntry>steadiness of mind under stress; "he accepted their problems with composure and she with equanimity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103839987"
	 b:glossaryEntry='great coolness and composure under strain; "keep your cool"'/>
<rdf:Description rdf:about="&a;103840159"
	 b:glossaryEntry="a disposition free from stress or emotion"/>
<rdf:Description rdf:about="&a;103840316"
	 b:glossaryEntry="peace of mind"/>
<rdf:Description rdf:about="&a;103840384"
	 b:glossaryEntry="a temperament that is perturbed and lacking in composure"/>
<rdf:Description rdf:about="&a;103840553"
	 b:glossaryEntry="the trait of seeming ill at ease"/>
<rdf:Description rdf:about="&a;103840662"
	 b:glossaryEntry="a disposition that is confused or nervous and upset"/>
<rdf:Description rdf:about="&a;103840782"
	 b:glossaryEntry="the trait of being easily persuaded"/>
<rdf:Description rdf:about="&a;103841050"
	 b:glossaryEntry="capable of being managed or controlled"/>
<rdf:Description rdf:about="&a;103841165"
	 b:glossaryEntry="the trait of being agreeably submissive and manageable"/>
<rdf:Description rdf:about="&a;103841274"
	 b:glossaryEntry="the attribute of having been domesticated"/>
<rdf:Description rdf:about="&a;103841422"
	 b:glossaryEntry="the trait of being cooperative"/>
<rdf:Description rdf:about="&a;103841543"
	 b:glossaryEntry="the trait of being willing to obey"/>
<rdf:Description rdf:about="&a;103841705">
	<b:glossaryEntry>the trait of being willing to yield to the will of another person or a superior force etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103841910"
	 b:glossaryEntry="abject or cringing submissiveness"/>
<rdf:Description rdf:about="&a;103842049"
	 b:glossaryEntry="fawning obsequiousness"/>
<rdf:Description rdf:about="&a;103842128"
	 b:glossaryEntry="submission to others or to outside influences"/>
<rdf:Description rdf:about="&a;103842243"
	 b:glossaryEntry="the quality of obedient submissiveness"/>
<rdf:Description rdf:about="&a;103842359"
	 b:glossaryEntry="the trait of being hard to influence or control"/>
<rdf:Description rdf:about="&a;103842629"
	 b:glossaryEntry="the trait of being unmanageable"/>
<rdf:Description rdf:about="&a;103842772"
	 b:glossaryEntry="a state of nature"/>
<rdf:Description rdf:about="&a;103842880"
	 b:glossaryEntry="intentionally contemptuous behavior or attitude"/>
<rdf:Description rdf:about="&a;103843035"
	 b:glossaryEntry="defiance of authority"/>
<rdf:Description rdf:about="&a;103843136"
	 b:glossaryEntry="noisy defiance"/>
<rdf:Description rdf:about="&a;103843213">
	<b:glossaryEntry>the trait of being prone to disobedience and lack of discipline</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103843394"
	 b:glossaryEntry="likely to stop abruptly and unexpectedly"/>
<rdf:Description rdf:about="&a;103843490"
	 b:glossaryEntry="the trait of being difficult to handle or overcome"/>
<rdf:Description rdf:about="&a;103843637"
	 b:glossaryEntry="deliberate unruliness"/>
<rdf:Description rdf:about="&a;103843763"
	 b:glossaryEntry="mean-spirited disagreeable contrariness"/>
<rdf:Description rdf:about="&a;103843872"
	 b:glossaryEntry="the trait of being unwilling to obey"/>
<rdf:Description rdf:about="&a;103844003"
	 b:glossaryEntry="an attribute of mischievous children"/>
<rdf:Description rdf:about="&a;103844143"
	 b:glossaryEntry="the trait of indulging in disreputable pranks"/>
<rdf:Description rdf:about="&a;103844273"
	 b:glossaryEntry="a way of acting or behaving"/>
<rdf:Description rdf:about="&a;103844515"
	 b:glossaryEntry="mildness of manner or disposition"/>
<rdf:Description rdf:about="&a;103844605"
	 b:glossaryEntry='a distinctive manner; "an air of mystery"'/>
<rdf:Description rdf:about="&a;103844696"
	 b:glossaryEntry="dignified manner or conduct"/>
<rdf:Description rdf:about="&a;103844827">
	<b:glossaryEntry>formality in bearing and appearance: "he behaved with great dignity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103844962">
	<b:glossaryEntry>manner or conduct of a physician in the presence of a patient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103845084"
	 b:glossaryEntry="a manner that strictly observes all forms and ceremonies"/>
<rdf:Description rdf:about="&a;103845335"
	 b:glossaryEntry="a ceremonial manner"/>
<rdf:Description rdf:about="&a;103845434">
	<b:glossaryEntry>a elaborate manner of doing something; "she served coffee with great stateliness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103845573"
	 b:glossaryEntry="a manner that does not take forms and ceremonies seriously"/>
<rdf:Description rdf:about="&a;103845743"
	 b:glossaryEntry="a casual manner"/>
<rdf:Description rdf:about="&a;103845847"
	 b:glossaryEntry="casualness in use of language"/>
<rdf:Description rdf:about="&a;103845933"
	 b:glossaryEntry="an unceremonial manner"/>
<rdf:Description rdf:about="&a;103846037"
	 b:glossaryEntry="a courteous manner"/>
<rdf:Description rdf:about="&a;103846287"
	 b:glossaryEntry="a courteous manner that respects accepted social usage"/>
<rdf:Description rdf:about="&a;103846463"
	 b:glossaryEntry="polished courtesy; elegance of manner"/>
<rdf:Description rdf:about="&a;103846555"
	 b:glossaryEntry="smooth and gracious in manner"/>
<rdf:Description rdf:about="&a;103846662"
	 b:glossaryEntry="excellence of manners or social conduct"/>
<rdf:Description rdf:about="&a;103846796"
	 b:glossaryEntry="courtesy towards women"/>
<rdf:Description rdf:about="&a;103846897">
	<b:glossaryEntry xml:space='preserve'><![CDATA[courteous regard for people''s feelings; "in deference to your wishes"; "out of respect for his privacy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103847083"
	 b:glossaryEntry="formal or perfunctory politeness"/>
<rdf:Description rdf:about="&a;103847224"
	 b:glossaryEntry="a manner that is rude and insulting"/>
<rdf:Description rdf:about="&a;103847472"
	 b:glossaryEntry="the manner of a rude or insensitive person"/>
<rdf:Description rdf:about="&a;103847572"
	 b:glossaryEntry="a discourteous manner that ignores accepted social usage"/>
<rdf:Description rdf:about="&a;103847741"
	 b:glossaryEntry="impoliteness resulting from ignorance"/>
<rdf:Description rdf:about="&a;103847851"
	 b:glossaryEntry="an offensive lack of good manners"/>
<rdf:Description rdf:about="&a;103847963">
	<b:glossaryEntry>an impolite manner that is vulgar and lacking tact or refinement; "the whole town was famous for its crudeness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103848153"
	 b:glossaryEntry="deliberate discourtesy"/>
<rdf:Description rdf:about="&a;103848250"
	 b:glossaryEntry="an abrupt discourteous manner"/>
<rdf:Description rdf:about="&a;103848385"
	 b:glossaryEntry="a manner that is generally disrespectful and contemptuous"/>
<rdf:Description rdf:about="&a;103848510">
	<b:glossaryEntry>the trait of being rude and impertinent; inclined to take liberties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103848700">
	<b:glossaryEntry>a basic or essential attribute shared by all members of a class; "a study of the physical properties of atomic particles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103849326">
	<b:glossaryEntry>the property of radiation that enables it to produce photochemical effects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103849455">
	<b:glossaryEntry>trueness of course toward a goal: "rivaling a hawk in directness of aim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103849689">
	<b:glossaryEntry>the quality of being direct and straightforward; "what some people take for rudeness is really straightforwardness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103849886">
	<b:glossaryEntry>lack of an intervening or mediating agency: "the immediacy of television coverage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103850094">
	<b:glossaryEntry>having the characteristic of lacking a true course toward a goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103850307"
	 b:glossaryEntry="a quality characterized by indirect reference"/>
<rdf:Description rdf:about="&a;103850411"
	 b:glossaryEntry="the quality of being mediate"/>
<rdf:Description rdf:about="&a;103850525"
	 b:glossaryEntry="the quality of being oblique and rambling indirectly"/>
<rdf:Description rdf:about="&a;103850649"
	 b:glossaryEntry="the quality of being discursive"/>
<rdf:Description rdf:about="&a;103850741">
	<b:glossaryEntry>a distinctive characteristic; "he has a stubborn streak"; "a streak of wildness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103850874"
	 b:glossaryEntry="the total of inherited attributes"/>
<rdf:Description rdf:about="&a;103851000"
	 b:glossaryEntry="any attribute that passes from parent to offspring"/>
<rdf:Description rdf:about="&a;103851191"
	 b:glossaryEntry="personal characteristics that are inherited at birth"/>
<rdf:Description rdf:about="&a;103851300">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a person''s social heritage: previous experience or training; "he is a lawyer with a sports background"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103851459">
	<b:glossaryEntry>a right or privilege that you are entitled to at birth; "free public education is the birthright of every American child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103851637"
	 b:glossaryEntry="properties acquired during a person''s formative years"/>
<rdf:Description rdf:about="&a;103851783">
	<b:glossaryEntry>the result of good upbringing (especially knowledge of correct social behavior); "a woman of breeding and refinement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103851978">
	<b:glossaryEntry>the properties acquired as a consequence of the way you were treated as a child</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103852131"
	 b:glossaryEntry="attributes acquired via biological heredity"/>
<rdf:Description rdf:about="&a;103852268"
	 b:glossaryEntry="inherited properties shared with others of your bloodline"/>
<rdf:Description rdf:about="&a;103852505">
	<b:glossaryEntry>(genetics) traits that tend to be inherited together as a consequence of an association between their genes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103852666"
	 b:glossaryEntry="a lineage or race of people"/>
<rdf:Description rdf:about="&a;103852754">
	<b:glossaryEntry>properties attributable to your ancestry; "he comes from good origins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103852918"
	 b:glossaryEntry="ancestry of a purebred animal"/>
<rdf:Description rdf:about="&a;103853014"
	 b:glossaryEntry="descent from parents both of one pure breed"/>
<rdf:Description rdf:about="&a;103853114">
	<b:glossaryEntry>how long something has existed; "it was replaced because of its age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103853484">
	<b:glossaryEntry>age measured by the time (years and months) that something or someone has existed; "his chronological age was 71 years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103853667">
	<b:glossaryEntry>a person''s age measured by matching their bone development (as shown by X rays) with with the bone development of an average person of known chronological age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103853880">
	<b:glossaryEntry>a measure of a child''s development (in body size or motor skill or psychological function) expressed in terms of age norms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103854066">
	<b:glossaryEntry>the level of intellectual development as measured by an intelligence test</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103854196"
	 b:glossaryEntry="the opposite of newness"/>
<rdf:Description rdf:about="&a;103854381"
	 b:glossaryEntry="the property of being out of date and not current"/>
<rdf:Description rdf:about="&a;103854521"
	 b:glossaryEntry="extreme oldness"/>
<rdf:Description rdf:about="&a;103854606"
	 b:glossaryEntry="the property of being no longer fashionable"/>
<rdf:Description rdf:about="&a;103854731">
	<b:glossaryEntry>the quality of being quaint and old-fshioned; "she liked the old cottage; its quaintness was appealing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103854891"
	 b:glossaryEntry="the oldness of wines"/>
<rdf:Description rdf:about="&a;103854982"
	 b:glossaryEntry="great age esp gray or white with age"/>
<rdf:Description rdf:about="&a;103855074"
	 b:glossaryEntry="the opposite of oldness"/>
<rdf:Description rdf:about="&a;103855223"
	 b:glossaryEntry="the property of being very new"/>
<rdf:Description rdf:about="&a;103855313">
	<b:glossaryEntry>the property of being pure and fresh (as if newly made); not stale or deteriorated; "she loved the freshness of newly baked bread"; "the freshness of the air revived him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103855593">
	<b:glossaryEntry>a pleasing firmness and freshness: "crispness of new dollar bills"; "crispness of fresh lettuce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103855745"
	 b:glossaryEntry="the property of having happened or appeared not long ago"/>
<rdf:Description rdf:about="&a;103855868"
	 b:glossaryEntry="the opposite of youngness"/>
<rdf:Description rdf:about="&a;103856037"
	 b:glossaryEntry="the property characteristic of old age"/>
<rdf:Description rdf:about="&a;103856143"
	 b:glossaryEntry="the state of being senile"/>
<rdf:Description rdf:about="&a;103856223"
	 b:glossaryEntry="the property of being long-lived"/>
<rdf:Description rdf:about="&a;103856323"
	 b:glossaryEntry="having lost purity and freshness as a consequence of aging"/>
<rdf:Description rdf:about="&a;103856491"
	 b:glossaryEntry="the quality of smelling or tasting old or stale or mouldy"/>
<rdf:Description rdf:about="&a;103856616"
	 b:glossaryEntry="the opposite of oldness"/>
<rdf:Description rdf:about="&a;103856749"
	 b:glossaryEntry="the freshness and vitality characteristic of a young person"/>
<rdf:Description rdf:about="&a;103856888"
	 b:glossaryEntry="a property characteristic of a child"/>
<rdf:Description rdf:about="&a;103856995">
	<b:glossaryEntry>a manner of performance; "a manner of living"; "in the characteristic New York style"; "a way of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103857307">
	<b:glossaryEntry>the style of a particular artist or school or movement; "an imaginative orchestral idiom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103857483">
	<b:glossaryEntry>a manner of dealing with something artistically; "his treatment of space borrows from Italian architecture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103857646">
	<b:glossaryEntry>the manner in which something fits; "I admired the fit of her coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103857781">
	<b:glossaryEntry>a particular mode in which something is manifested; "his resentment took the form of extreme hostility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103857935">
	<b:glossaryEntry>a manner of living that reflects the person''s values and attitudes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103858099">
	<b:glossaryEntry>(informal) the way something is organized or arranged; "it takes time to learn the setup around here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103858252">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a distinguishing style; "this room needs a woman''s touch"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103858391">
	<b:glossaryEntry>the property of appealing to people in general (usually by appearing to have qualities in common with them)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103858557"
	 b:glossaryEntry='a way of doing or being: "in no wise"; "in this wise"'/>
<rdf:Description rdf:about="&a;103858670"
	 b:glossaryEntry='the way a garment hangs; "he adjusted the hang of his coat"'/>
<rdf:Description rdf:about="&a;103858780">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the manner of construction of something and the disposition of its parts; "artists must study the structure of the human body"; "the architecture of a computer''s system software"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103859083">
	<b:glossaryEntry>(computer science) the structure and organization of a computer''s hardware or system software</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103859280">
	<b:glossaryEntry>(computer science) a kind of computer architecture that has a large number of instructions hard coded into the cpu chip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103859575">
	<b:glossaryEntry>(computer science) a kind of computer architecture that has a relatively small set of computer instructions that it can perform</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103859878"
	 b:glossaryEntry="the cellular composition of a bodily structure"/>
<rdf:Description rdf:about="&a;103860008">
	<b:glossaryEntry>the underlying structure; "restoring the framework of the bombed building"; "it is part of the fabric of society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103860186"
	 b:glossaryEntry="the way in which someone or something is composed"/>
<rdf:Description rdf:about="&a;103860389">
	<b:glossaryEntry>the constitution of an organism as determined by the interaction of its genetic constitution and the environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103860557">
	<b:glossaryEntry>the particular alleles at specified loci present in an organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103860698">
	<b:glossaryEntry>the property of holding together and retaining its shape; "when the dough has enough consistency it is ready to bake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103861110"
	 b:glossaryEntry="resistance of a liquid to sheer forces (and hence to flow)"/>
<rdf:Description rdf:about="&a;103861310"
	 b:glossaryEntry="the property of sticking to a surface"/>
<rdf:Description rdf:about="&a;103861422"
	 b:glossaryEntry="a property resembling or being covered with slime"/>
<rdf:Description rdf:about="&a;103861527"
	 b:glossaryEntry="the property of sticking together (as of glue and wood)"/>
<rdf:Description rdf:about="&a;103861671"
	 b:glossaryEntry="the property of being cohesive and sticky"/>
<rdf:Description rdf:about="&a;103861842"
	 b:glossaryEntry="the property of having a viscosity like jelly"/>
<rdf:Description rdf:about="&a;103861978"
	 b:glossaryEntry="resistance to flow"/>
<rdf:Description rdf:about="&a;103862142"
	 b:glossaryEntry="a property midway between a solid and a liquid"/>
<rdf:Description rdf:about="&a;103862247"
	 b:glossaryEntry="the property of having the thickness of heavy cream"/>
<rdf:Description rdf:about="&a;103862367">
	<b:glossaryEntry>a consistency of low viscosity; "he disliked the thinness of the soup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103862546"
	 b:glossaryEntry="the property of flowing easily"/>
<rdf:Description rdf:about="&a;103862680"
	 b:glossaryEntry="the property of resembling the viscosity of water"/>
<rdf:Description rdf:about="&a;103862786">
	<b:glossaryEntry>the property of being rigid and resistant to pressure; not easily scratched</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103863006"
	 b:glossaryEntry="the property of being unyielding to the touch"/>
<rdf:Description rdf:about="&a;103863106"
	 b:glossaryEntry="the property of giving little resistance to pressure"/>
<rdf:Description rdf:about="&a;103863303"
	 b:glossaryEntry="the property of being able to occupy less space"/>
<rdf:Description rdf:about="&a;103863459"
	 b:glossaryEntry="the property of being incompressible"/>
<rdf:Description rdf:about="&a;103863577"
	 b:glossaryEntry="a light softness"/>
<rdf:Description rdf:about="&a;103863677"
	 b:glossaryEntry="a flabby softness"/>
<rdf:Description rdf:about="&a;103863775"
	 b:glossaryEntry="a mushy pulpy softness"/>
<rdf:Description rdf:about="&a;103863853"
	 b:glossaryEntry="the consistency of something that breaks under pressure"/>
<rdf:Description rdf:about="&a;103864058"
	 b:glossaryEntry="firm but easily broken"/>
<rdf:Description rdf:about="&a;103864181"
	 b:glossaryEntry="excessive breakableness"/>
<rdf:Description rdf:about="&a;103864275"
	 b:glossaryEntry="having or breaking into thin crisp flakes"/>
<rdf:Description rdf:about="&a;103864372">
	<b:glossaryEntry>a consistency of something that does not break under pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103864513"
	 b:glossaryEntry="the property of being porous; being able to absorb fluids"/>
<rdf:Description rdf:about="&a;103864692"
	 b:glossaryEntry="the porosity of a sponge"/>
<rdf:Description rdf:about="&a;103864773">
	<b:glossaryEntry>the property of something that can be pervaded by a liquid (as by osmosis or diffusion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103864989">
	<b:glossaryEntry>the permeability of something that can be penetrated by a liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103865164"
	 b:glossaryEntry="the property of being absorbent"/>
<rdf:Description rdf:about="&a;103865306"
	 b:glossaryEntry="the consistency of a solid"/>
<rdf:Description rdf:about="&a;103865453"
	 b:glossaryEntry="the consistency of a compact solid"/>
<rdf:Description rdf:about="&a;103865563"
	 b:glossaryEntry="the amount per unit size"/>
<rdf:Description rdf:about="&a;103865689">
	<b:glossaryEntry>the ratio of the density of something to the density of a standard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103865854"
	 b:glossaryEntry="the density of a substance relative to the density of water"/>
<rdf:Description rdf:about="&a;103865976"
	 b:glossaryEntry="the density of a gas relative to the density of hydrogen"/>
<rdf:Description rdf:about="&a;103866109"
	 b:glossaryEntry='a rarified quality: "the tenuity of the upper atmosphere"'/>
<rdf:Description rdf:about="&a;103866243">
	<b:glossaryEntry>the property of something that cannot be pervaded by a liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103866455">
	<b:glossaryEntry>the power of retaining liquid: "moisture retentivity of soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103866602"
	 b:glossaryEntry="resistance to penetration by a liquid"/>
<rdf:Description rdf:about="&a;103866754"
	 b:glossaryEntry="the property of not being absorbent"/>
<rdf:Description rdf:about="&a;103866867">
	<b:glossaryEntry>a natural or acquired habit or characteristic tendency in a person or thing: "a swelling with a disposition to rupture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103867116">
	<b:glossaryEntry>a disposition to behave in a certain way; "the aptness of iron to rust"; "the propensity of disease to spread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103867293"
	 b:glossaryEntry="a disposition in advance to react in a particular way"/>
<rdf:Description rdf:about="&a;103867407">
	<b:glossaryEntry>a characteristic likelihood of or natural disposition toward a certain condition or character or effect: "the alkaline inclination of the local waters"; "fabric with a tendency to shrink"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103867699">
	<b:glossaryEntry>(cytology) the capacity of cells or cell parts to stain specifically with certain dyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103867862">
	<b:glossaryEntry>the tendency of cells to stain with basic dyes; "cytoplasmic basophilia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103867991"
	 b:glossaryEntry='being disposed to do something; "accident proneness"'/>
<rdf:Description rdf:about="&a;103868099"
	 b:glossaryEntry='an inclination to want things; "a man of many desires"'/>
<rdf:Description rdf:about="&a;103868242">
	<b:glossaryEntry>strong desire for something (not food or drink): "a thirst for knowledge"; "hunger for affection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103868401">
	<b:glossaryEntry>excessive desire to acquire or possess more (esp material wealth) than one needs or deserves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103868599"
	 b:glossaryEntry="extreme greed for material wealth"/>
<rdf:Description rdf:about="&a;103868729"
	 b:glossaryEntry="excessive desire to possess or dominate"/>
<rdf:Description rdf:about="&a;103868829"
	 b:glossaryEntry="strong desire to acquire and possess"/>
<rdf:Description rdf:about="&a;103868999"
	 b:glossaryEntry="preoccupation with the acquisition and possession of books"/>
<rdf:Description rdf:about="&a;103869115">
	<b:glossaryEntry>the property of retaining possessions that have been acquired</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103869236"
	 b:glossaryEntry="a property perceived by touch"/>
<rdf:Description rdf:about="&a;103869371">
	<b:glossaryEntry>the feel of mechanical action: "this piano has a wonderful touch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103869488">
	<b:glossaryEntry>the feel of a surface or a fabric; "the wall had a smooth texture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103869698"
	 b:glossaryEntry="a soft or fuzzy surface texture"/>
<rdf:Description rdf:about="&a;103869779"
	 b:glossaryEntry="a texture without roughness; smooth to the touch"/>
<rdf:Description rdf:about="&a;103869974"
	 b:glossaryEntry="the smooth feel of silk fabric"/>
<rdf:Description rdf:about="&a;103870072">
	<b:glossaryEntry>a slippery smoothness; "he could feel the slickness of the tiller"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103870224">
	<b:glossaryEntry>having a very fine texture; "the fineness of the sand on the beach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103870360"
	 b:glossaryEntry="a texture that is not smooth but is irregular and uneven"/>
<rdf:Description rdf:about="&a;103870598"
	 b:glossaryEntry="looseness or roughness in texture (as of cloth)"/>
<rdf:Description rdf:about="&a;103870727">
	<b:glossaryEntry>soft lump or unevenness in a yarn; either an imperfection or created by design</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103870871"
	 b:glossaryEntry="the roughness of a substance that causes abrasions"/>
<rdf:Description rdf:about="&a;103871007"
	 b:glossaryEntry="the quality of being composed of relatively large particles"/>
<rdf:Description rdf:about="&a;103871168"
	 b:glossaryEntry="a texture resembling that of sand"/>
<rdf:Description rdf:about="&a;103871257"
	 b:glossaryEntry="roughness of nap produced by long woolly hairs"/>
<rdf:Description rdf:about="&a;103871360"
	 b:glossaryEntry="the texture of a surface that has many bumps"/>
<rdf:Description rdf:about="&a;103871460"
	 b:glossaryEntry="an attribute of vision"/>
<rdf:Description rdf:about="&a;103871652">
	<b:glossaryEntry>(fine arts) the characteristic appearance of a surface having a tactile quality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103871821">
	<b:glossaryEntry>the direction or texture of fibers found in wood or leather or stone or in a woven fabric: "saw the board across the grain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103872032"
	 b:glossaryEntry="texture of fibers in wood"/>
<rdf:Description rdf:about="&a;103872113"
	 b:glossaryEntry="a texture like that of wood"/>
<rdf:Description rdf:about="&a;103872210"
	 b:glossaryEntry="a texture like that of marble"/>
<rdf:Description rdf:about="&a;103872297">
	<b:glossaryEntry>the visual effect of illumination on objects or scenes as created in pictures; "he could paint the lightest light and the darkest dark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103872604">
	<b:glossaryEntry>an indication of radiant light drawn around the head of a saint</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103872742"
	 b:glossaryEntry="lightness created by sunlight"/>
<rdf:Description rdf:about="&a;103872845">
	<b:glossaryEntry>the lightness of a sunny day when there are no clouds in the sky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103872969"
	 b:glossaryEntry="an area of lightness in a picture"/>
<rdf:Description rdf:about="&a;103873073">
	<b:glossaryEntry>the location of a visual perception along the black-to-white continuum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103873344">
	<b:glossaryEntry>great brightness; "a glare of sunlight"; "the flowers were a blaze of color"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103873493"
	 b:glossaryEntry="brightness enough to blind partially and temporarily"/>
<rdf:Description rdf:about="&a;103873598"
	 b:glossaryEntry="the quality of glittering or sparkling brightly"/>
<rdf:Description rdf:about="&a;103873745"
	 b:glossaryEntry="a momentary brightness"/>
<rdf:Description rdf:about="&a;103873827">
	<b:glossaryEntry>brightness and animation of countenance; "he had a sparkle in his eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103873985"
	 b:glossaryEntry="the visual property of something having a milky brightness"/>
<rdf:Description rdf:about="&a;103874115"
	 b:glossaryEntry="the quality of being bright and sending out rays of light"/>
<rdf:Description rdf:about="&a;103874339"
	 b:glossaryEntry="the strength of a radio wave picked up by a radio telescope"/>
<rdf:Description rdf:about="&a;103874461"
	 b:glossaryEntry="an appearance of reflected light"/>
<rdf:Description rdf:about="&a;103874574">
	<b:glossaryEntry>the visual property of something that shines with reflected light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103874721"
	 b:glossaryEntry="a quality that outshines the usual"/>
<rdf:Description rdf:about="&a;103874853"
	 b:glossaryEntry="the property of being smooth and shiny"/>
<rdf:Description rdf:about="&a;103875011"
	 b:glossaryEntry="a glossy finish on a fabric"/>
<rdf:Description rdf:about="&a;103875090"
	 b:glossaryEntry="a lack of visual brightness"/>
<rdf:Description rdf:about="&a;103875236"
	 b:glossaryEntry="the property of lacking brilliance"/>
<rdf:Description rdf:about="&a;103875338"
	 b:glossaryEntry="the property of having little or no contrast"/>
<rdf:Description rdf:about="&a;103875475">
	<b:glossaryEntry>a visual attribute of things that results from the light they emit or transmit or reflect; "white is the coolest summer color"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103875865">
	<b:glossaryEntry>interwoven yarns of mixed colors producing muted grayish shades with flecks of color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103876021"
	 b:glossaryEntry="the visual property of being without color"/>
<rdf:Description rdf:about="&a;103876173">
	<b:glossaryEntry>(medical) an absence of normal pigmentation especially in the skin (as in albinism) or in red blood cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103876333">
	<b:glossaryEntry>a quality of a given color that differs slightly from a primary color; "after several trials he mixed the shade of pink that she wanted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103876564"
	 b:glossaryEntry="a pale or subdued color"/>
<rdf:Description rdf:about="&a;103876651"
	 b:glossaryEntry="a color that has hue"/>
<rdf:Description rdf:about="&a;103877004"
	 b:glossaryEntry="a color lacking hue; white or gray or black"/>
<rdf:Description rdf:about="&a;103877202">
	<b:glossaryEntry>the quality or state of the achromatic color of least lightness (bearing the least resemblance to white)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103877406"
	 b:glossaryEntry="a very dark black"/>
<rdf:Description rdf:about="&a;103877535">
