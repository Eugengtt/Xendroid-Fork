</rdf:Description>
<rdf:Description rdf:about="&a;110723334"
	 b:glossaryEntry="a strong solution of sodium or potassium hydroxide"/>
<rdf:Description rdf:about="&a;110723434">
	<b:glossaryEntry>an essential amino acid; occurs especially in gelatin and casein</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110723551">
