	 b:glossaryEntry="goatsuckers; frogmouths; oilbirds"/>
<rdf:Description rdf:about="&a;101351774"
	 b:glossaryEntry="long-winged nonpasserine birds"/>
<rdf:Description rdf:about="&a;101351943"
	 b:glossaryEntry="goatsuckers"/>
