</rdf:Description>
<rdf:Description rdf:about="&a;100580612"
	 b:glossaryEntry="the act of taking and printing photographs"/>
<rdf:Description rdf:about="&a;100580801">
	<b:glossaryEntry>photography that uses other kinds of radiation than visible light</b:glossaryEntry>
</rdf:Description>
