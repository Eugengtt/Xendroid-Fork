	<b:glossaryEntry>the capital and largest city of Iran; located in northern Iran</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106514986">
	<b:glossaryEntry>the holy city of Shiite Muslims; located in northeastern Iran</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106515129">
	<b:glossaryEntry>a city in central southwestern Iran; ruins of ancient Persepolis are nearby</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106515276"
	 b:glossaryEntry="an ancient city in northwestern Iran; known for hot springs"/>
