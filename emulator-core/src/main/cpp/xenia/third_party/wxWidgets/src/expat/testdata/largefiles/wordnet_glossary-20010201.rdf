<rdf:Description rdf:about="&a;201560555"
	 b:glossaryEntry="hold on to"/>
<rdf:Description rdf:about="&a;201560664"
	 b:glossaryEntry="retain rights to; as of a job or a seat"/>
<rdf:Description rdf:about="&a;201560796"
	 b:glossaryEntry='pay in advance; "Can you advance me some money?"'/>
<rdf:Description rdf:about="&a;201560925">
	<b:glossaryEntry>make illegal payments to in exchange for favors or influence; "This judge can be bought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201561128"
	 b:glossaryEntry="give a conciliatory gift or bribe to"/>
<rdf:Description rdf:about="&a;201561225"
	 b:glossaryEntry="buy stocks or shares of a company"/>
<rdf:Description rdf:about="&a;201561324"
	 b:glossaryEntry="take money from an illegal transaction"/>
<rdf:Description rdf:about="&a;201561428"
	 b:glossaryEntry="pay someone with influence in order to receive a favor"/>
<rdf:Description rdf:about="&a;201561557"
	 b:glossaryEntry='pay back; "Please refund me my money"'/>
<rdf:Description rdf:about="&a;201561739">
	<b:glossaryEntry>pay back for some expense incurred; "Can the company reimburse me for my professional travel?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201561908"
	 b:glossaryEntry='have on hand; "Do you carry kerosene heaters?"'/>
<rdf:Description rdf:about="&a;201562037">
	<b:glossaryEntry>come upon after searching; find the location of something that was missed or lost; "Did you find your glasses?" "I cannot find my gloves!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201562344">
	<b:glossaryEntry>find by testing or cautious exploration; "He felt his way around the dark room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201562485">
	<b:glossaryEntry>discover the location of; determine the place of; find by searching or examining; "Can you locate your cousins in the Midwest?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201562746">
	<b:glossaryEntry>bring to light; "The CIA unearthed a plot to kill the President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201562883"
	 b:glossaryEntry='find unexpectedly: "she struck a goldmine"'/>
<rdf:Description rdf:about="&a;201563079">
	<b:glossaryEntry>buy casually or spontaneously; "I picked up some food for a snack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201563210">
	<b:glossaryEntry>pay for something; "pick up the tab"; "pick up the burden of high_interest mortgages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201563364">
	<b:glossaryEntry>locate exactly; "can you pinpoint the position of the enemy?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201563515">
	<b:glossaryEntry xml:space='preserve'><![CDATA[miss from one''s possessions; lose sight of; "I''ve lost my glasses again!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201563668">
	<b:glossaryEntry>fail to keep or to maintain; cease to have, either physically or in an abstract sense; fail to keep in mind or in sight; "She lost her purse when she left it unattended on her seat"; "She lost her husband a year ago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201563990"
	 b:glossaryEntry="get rid off by sleeping, as of a hangover"/>
<rdf:Description rdf:about="&a;201564098">
	<b:glossaryEntry>fail to get or obtain; "I lost the opportunity to spend a year abroad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201564238"
	 b:glossaryEntry="win something through one''s efforts"/>
<rdf:Description rdf:about="&a;201564385"
	 b:glossaryEntry='cheat or trick; "He cozened the money out of the old man"'/>
<rdf:Description rdf:about="&a;201564539">
	<b:glossaryEntry>fail to make money in a business; make a loss or fail to profit; "I lost thousands of dollars on that bad investment!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201564745">
	<b:glossaryEntry>be debited and credited to the proper bank accounts; "The check will clear within 2 buisness days."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201564908">
	<b:glossaryEntry>earn on some commercial or business transaction; earn as salary or wages; "How much do you make a month in your new job?" "She earns a lot in her new job"; "this merger brought in lots of money"; "He clears $5,000 each month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201565420"
	 b:glossaryEntry="earn as a salary or wage"/>
<rdf:Description rdf:about="&a;201565524"
	 b:glossaryEntry="earn large sums of money"/>
<rdf:Description rdf:about="&a;201565625"
	 b:glossaryEntry="acquire or deserve by one''s efforts or actions"/>
<rdf:Description rdf:about="&a;201565760"
	 b:glossaryEntry="win an athletic letter, in sports"/>
<rdf:Description rdf:about="&a;201565865"
	 b:glossaryEntry="derive benefit from"/>
<rdf:Description rdf:about="&a;201566063">
	<b:glossaryEntry>enlarge one''s holdings on an exchange on a continued rise by using paper profits as margin to buy additional amounts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201566244"
	 b:glossaryEntry='be beneficial for; "This will do you good"'/>
<rdf:Description rdf:about="&a;201566369">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be agreeable or suitable; "White wine doesn''t agree with me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201566492"
	 b:glossaryEntry='make as a net profit; "The company cleared $1 million"'/>
<rdf:Description rdf:about="&a;201566668"
	 b:glossaryEntry="earn before taxes, expenses, etc."/>
<rdf:Description rdf:about="&a;201566764"
	 b:glossaryEntry='yield as a net profit; "This sale netted me $1 million"'/>
<rdf:Description rdf:about="&a;201566906">
	<b:glossaryEntry>bring in; as of investments; "interest-bearing accounts"; "How much does this savings certificate pay annually?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201567130"
	 b:glossaryEntry='yield a profit or result; "His efforts finally paid off"'/>
<rdf:Description rdf:about="&a;201567251">
	<b:glossaryEntry xml:space='preserve'><![CDATA[obtain: "derive pleasure from one''s garden"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201567391">
	<b:glossaryEntry>get or find by searching; "What did you rout out in the library?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201567558"
	 b:glossaryEntry="take unlawfully"/>
<rdf:Description rdf:about="&a;201567643">
	<b:glossaryEntry>appropriate (as property entrusted to one''s care) fraudulently to one''s own use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201567824">
	<b:glossaryEntry>get or derive; "He drew great benefits from his membership in the association"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201567979">
	<b:glossaryEntry>get inspiration or ideas from or be based on; "This play draws on the famous bestseller by the same name"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201568149">
	<b:glossaryEntry>to surrender someone or something to another; "the guard delivered the criminal to the police"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201568400">
	<b:glossaryEntry>deliver something in trust to somebody for a special purpose and for a limited period</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201568547">
	<b:glossaryEntry>formally hand over to the bridegroom in marriage; of a bride by her father</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201568688"
	 b:glossaryEntry="trade in in a bartering transaction"/>
<rdf:Description rdf:about="&a;201568792"
	 b:glossaryEntry="give out as one''s portion or share"/>
<rdf:Description rdf:about="&a;201568959">
	<b:glossaryEntry>administer or bestow, as in small portions; "administer critical remarks to everyone present"; "dole out some money"; "shell out pocket money for the children"; "deal a blow to someone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201569388"
	 b:glossaryEntry="determine the quantity of someone''s share"/>
<rdf:Description rdf:about="&a;201569514"
	 b:glossaryEntry='have, give, or receive a share of: "We shared the cake"'/>
