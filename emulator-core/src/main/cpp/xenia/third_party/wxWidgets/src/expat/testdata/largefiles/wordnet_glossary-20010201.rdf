	 b:glossaryEntry="stop running, functioning, or operating, as of power"/>
<rdf:Description rdf:about="&a;201049907"
	 b:glossaryEntry='line or stuff with soft material; "pad a bra"'/>
<rdf:Description rdf:about="&a;201050050"
	 b:glossaryEntry="give (hair) the appearance of being fuller by using a rat"/>
<rdf:Description rdf:about="&a;201050168">
	<b:glossaryEntry>squeeze like a wedge into a tight space; "I squeezed myself into the corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201050369">
	<b:glossaryEntry>remove or force from a position of dwelling previously occupied; "The new employee dislodged her by moving into her office space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201050608"
	 b:glossaryEntry='cause to fall off; "The horse threw its unexperienced rider"'/>
<rdf:Description rdf:about="&a;201050731">
	<b:glossaryEntry>expel through adjuration or prayers; of evil spirits; in certain religions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201050882"
	 b:glossaryEntry='fix, force, or implant; "lodge a bullet in the table"'/>
<rdf:Description rdf:about="&a;201051078"
	 b:glossaryEntry='sit or recline comfortably; "He was lounging on the sofa"'/>
<rdf:Description rdf:about="&a;201051207">
	<b:glossaryEntry>remove or force out from a position; "The dentist dislodged the piece of food that had been stuck under my gums"; "He finally could free the legs of the earthquake victim who was buried in the rubble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201051506">
	<b:glossaryEntry>to fix or set securely or deeply: "Kneeling, Cobb planted a sturdy knee in the small of his back,"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201051765"
	 b:glossaryEntry="dip into mud before planting, of young plants"/>
<rdf:Description rdf:about="&a;201051874"
	 b:glossaryEntry="plant in checkrows"/>
<rdf:Description rdf:about="&a;201051958"
	 b:glossaryEntry='plant in a pot; "He potted the palm"'/>
<rdf:Description rdf:about="&a;201052073">
	<b:glossaryEntry>put in a new, usually larger, pot, as of a plant that has grown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201052199"
	 b:glossaryEntry="fit together or fit inside"/>
<rdf:Description rdf:about="&a;201052287"
	 b:glossaryEntry="insert or squeeze tightly between two people or objects"/>
<rdf:Description rdf:about="&a;201052416"
	 b:glossaryEntry='embed deeply; "She sank her fingers into the soft sand"'/>
<rdf:Description rdf:about="&a;201052558"
	 b:glossaryEntry="insert (a nail below the surface)"/>
<rdf:Description rdf:about="&a;201052666"
	 b:glossaryEntry="in surgery"/>
<rdf:Description rdf:about="&a;201052778">
	<b:glossaryEntry>cause to grow together parts from different plants; "graft the cherry tree branch onto the plum tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201052962"
	 b:glossaryEntry='thoroughly work in; "His hands were grained with dirt"'/>
<rdf:Description rdf:about="&a;201053089"
	 b:glossaryEntry="fix firmly or securely"/>
<rdf:Description rdf:about="&a;201053188">
	<b:glossaryEntry>occupy a trench or secured area; "The troops dug in for the night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201053311"
	 b:glossaryEntry='raise in a relief; "embossed stationary"'/>
<rdf:Description rdf:about="&a;201053448">
	<b:glossaryEntry>stamp or emboss a title or design on a book with a block; "block the book cover"</b:glossaryEntry>
</rdf:Description>
