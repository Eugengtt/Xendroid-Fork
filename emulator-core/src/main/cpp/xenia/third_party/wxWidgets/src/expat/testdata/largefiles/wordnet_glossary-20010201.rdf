</rdf:Description>
<rdf:Description rdf:about="&a;104869955"
	 b:glossaryEntry="a list of people who are out of favor"/>
<rdf:Description rdf:about="&a;104870072">
	<b:glossaryEntry>a list or register of events (appointments or social events or court cases etc); "I have you on my calendar for next Monday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104870251"
	 b:glossaryEntry="a list of foods and information about their caloric content"/>
<rdf:Description rdf:about="&a;104870370">
	<b:glossaryEntry>a complete list of things; usually arranged systematically; "it does not pretend to be a catalogue of his achievements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104870609"
	 b:glossaryEntry="an enumeration of all the resources of a library"/>
<rdf:Description rdf:about="&a;104870733"
	 b:glossaryEntry="a list advertising parts for machinery along with prices"/>
<rdf:Description rdf:about="&a;104870867"
	 b:glossaryEntry="a list advertising seeds and their prices"/>
<rdf:Description rdf:about="&a;104870984">
	<b:glossaryEntry>an ordered list of characters that are used together in writing or printing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104871173">
	<b:glossaryEntry>a list of items (names or tasks etc.) to be checked or consulted</b:glossaryEntry>
</rdf:Description>
