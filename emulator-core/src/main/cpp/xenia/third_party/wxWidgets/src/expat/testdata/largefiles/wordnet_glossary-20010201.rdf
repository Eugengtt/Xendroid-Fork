	 b:glossaryEntry="(music) a gradual increase in loudness"/>
<rdf:Description rdf:about="&a;103899248"
	 b:glossaryEntry="a crescendo followed by a decrescendo"/>
<rdf:Description rdf:about="&a;103899337"
	 b:glossaryEntry="(music) with great loudness"/>
<rdf:Description rdf:about="&a;103899429"
