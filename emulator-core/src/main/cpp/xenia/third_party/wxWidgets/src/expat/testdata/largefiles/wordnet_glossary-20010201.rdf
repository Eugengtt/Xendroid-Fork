	 b:glossaryEntry='of plants or animals; "She breeds dogs"'/>
<rdf:Description rdf:about="&a;200979879"
	 b:glossaryEntry="cause to become mongrels"/>
<rdf:Description rdf:about="&a;200979971"
	 b:glossaryEntry="copulate, of animals"/>
<rdf:Description rdf:about="&a;200980071">
