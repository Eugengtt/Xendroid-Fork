<rdf:Description rdf:about="&a;400375899"
	 b:glossaryEntry="showing intolerance"/>
<rdf:Description rdf:about="&a;400375995">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a transitive manner; "you can use the verb `eat'' transitively or intransitively"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400376155">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an intransitive manner; "you can use the verb `drink'' intransitively, without a direct object"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400376331">
	<b:glossaryEntry>in an intravenous manner; "the patient had to be fed intravenously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400376458">
	<b:glossaryEntry>in an intuitive manner; "inventors seem to have chosen intuitively a combination of explosive and aggressive sounds as warning signals to be used on automobiles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400376677">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an inventive manner; "Picasso''s liberated shapes and excitingly applied and inventively combined colours"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400376843"
	 b:glossaryEntry="in a manner arousing resentment"/>
<rdf:Description rdf:about="&a;400376932">
