	 b:glossaryEntry="a resort city on the Pacific in central Chile"/>
<rdf:Description rdf:about="&a;106416818"
	 b:glossaryEntry="a port city on the Pacific in northern Chile"/>
<rdf:Description rdf:about="&a;106416939">
	<b:glossaryEntry>a city in S Chile on the Strait of Magellan; the southernmost city in the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106417096">
	<b:glossaryEntry>the capital and largest city of Chile; one of the largest cities in South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106417270">
	<b:glossaryEntry>an archipelago off S South America; separated from the continent by the Strait of Magellan; islands are administered by Chile and by Argentina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106417513">
	<b:glossaryEntry>the chief port and second largest city of Chile; located on a wide harbor in central Chile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106417679"
	 b:glossaryEntry="a region in northeastern China"/>
<rdf:Description rdf:about="&a;106417803">
	<b:glossaryEntry>a communist nation in eastern Asia; the most populous country in the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106418485"
	 b:glossaryEntry="an archaic or literary name for China"/>
<rdf:Description rdf:about="&a;106418575">
	<b:glossaryEntry>a historical region of central Asia that was a center for trade between the East and the West</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106418755">
	<b:glossaryEntry>capital of the People''s Republic of China in the Hopeh province in northeastern China; 2nd largest Chinese city</b:glossaryEntry>
</rdf:Description>
