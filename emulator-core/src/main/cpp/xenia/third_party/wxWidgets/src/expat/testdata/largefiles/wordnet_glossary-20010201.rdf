	<b:glossaryEntry>so as to scatter or be distributed widely or in all directions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400275906"
	 b:glossaryEntry='in an inhumane manner; "she treated her husband bestially"'/>
<rdf:Description rdf:about="&a;400276072">
	<b:glossaryEntry>in a bumptious manner; "he behaved rather bumptiously and offended the hostess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400276209">
