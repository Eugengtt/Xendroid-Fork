	 b:glossaryEntry="a kind of drumfish"/>
<rdf:Description rdf:about="&a;102084866"
	 b:glossaryEntry="black-and-white drumfish with an erect elongated dorsal fin"/>
<rdf:Description rdf:about="&a;102085027"
	 b:glossaryEntry="drumfish"/>
<rdf:Description rdf:about="&a;102085149">
	<b:glossaryEntry>small silvery drumfish often mistaken for white perch; found along coasts of United States from New York to Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102085379"
	 b:glossaryEntry="a genus of Sciaenidae"/>
<rdf:Description rdf:about="&a;102085512">
	<b:glossaryEntry>large edible fish found off coast of United States from Massachusetts to Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102085712"
	 b:glossaryEntry="type genus of the Sciaenidae: croakers"/>
<rdf:Description rdf:about="&a;102085877">
	<b:glossaryEntry>large important food fish of Australia; almost indistinguishable from the maigre</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102086062"
	 b:glossaryEntry="large European marine food fish"/>
