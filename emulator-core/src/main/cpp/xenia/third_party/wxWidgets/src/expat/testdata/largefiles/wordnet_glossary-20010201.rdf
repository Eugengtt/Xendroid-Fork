	<b:glossaryEntry>any of various tropical Asian palm trees the trunks of which yield sago</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108883112"
	 b:glossaryEntry="palm having pinnate or featherlike leaves"/>
