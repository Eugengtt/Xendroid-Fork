<rdf:Description rdf:about="&a;100570753"
	 b:glossaryEntry="teaching people to speak and understand a foreign language"/>
<rdf:Description rdf:about="&a;100570875"
	 b:glossaryEntry="teaching beginners to read"/>
<rdf:Description rdf:about="&a;100571000">
	<b:glossaryEntry>teaching reading by training beginners to associate letters with their sound values</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100571137">
	<b:glossaryEntry>teaching reading by training beginners to associate printed words with spoken words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100571284"
	 b:glossaryEntry="the act of teaching at school"/>
<rdf:Description rdf:about="&a;100571369"
	 b:glossaryEntry="teaching someone to accept doctrines uncritically"/>
<rdf:Description rdf:about="&a;100571515">
