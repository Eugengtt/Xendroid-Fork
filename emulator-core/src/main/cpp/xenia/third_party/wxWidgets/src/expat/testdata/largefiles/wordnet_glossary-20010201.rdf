<rdf:Description rdf:about="&a;201060417"
	 b:glossaryEntry="remove body fluids such as blood"/>
<rdf:Description rdf:about="&a;201060535"
	 b:glossaryEntry='accept; "The cloth takes up the liquid"'/>
<rdf:Description rdf:about="&a;201060691">
	<b:glossaryEntry>unite or merge with something already in existence; "incorporate this document with those pertaining to the same case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201060886">
	<b:glossaryEntry>cause to flow out or over; "spill the beans all over the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201061056">
	<b:glossaryEntry>pour in drops; "shed tears"; "spill blood"; also metaphorically, as in "God shed His grace on Thee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201061238"
	 b:glossaryEntry='go to seed; shed seeds; "The dandelions went to seed"'/>
<rdf:Description rdf:about="&a;201061371"
	 b:glossaryEntry='cause to flow or overflow; "spill blood"'/>
<rdf:Description rdf:about="&a;201061500"
	 b:glossaryEntry='arrange in a particular way; "drape a cloth"'/>
<rdf:Description rdf:about="&a;201061625">
