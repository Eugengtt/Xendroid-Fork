<rdf:Description rdf:about="&a;201338210"
	 b:glossaryEntry="jump across"/>
<rdf:Description rdf:about="&a;201338287"
	 b:glossaryEntry='move or jump suddenly: "She bolted from her seat"'/>
<rdf:Description rdf:about="&a;201338398"
	 b:glossaryEntry="jump across or leap over (an obstacle)"/>
<rdf:Description rdf:about="&a;201338528"
	 b:glossaryEntry="perform a curvet, of a horse"/>
