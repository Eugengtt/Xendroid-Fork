</rdf:Description>
<rdf:Description rdf:about="&a;200782270"
	 b:glossaryEntry="direct a question at someone"/>
<rdf:Description rdf:about="&a;200782363">
	<b:glossaryEntry xml:space='preserve'><![CDATA[aim or direct at; as of blows, weapons, or objects such as photographic equipment; "Please don''t aim at your little brother!" "He trained his gun on the burglar"; "Don''t train your camera on the women"; "Take a swipe at one''s opponent"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200782800">
	<b:glossaryEntry>aim, point, or direct: "Hold the fire extinguisher directly on the flames"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200782936">
	<b:glossaryEntry>hit or aim at with a sweeping arm movement; "The soccer player began to swing at the referee"</b:glossaryEntry>
</rdf:Description>
