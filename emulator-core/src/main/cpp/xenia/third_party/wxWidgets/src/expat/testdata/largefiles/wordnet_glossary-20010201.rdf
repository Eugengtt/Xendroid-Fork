<rdf:Description rdf:about="&a;101661246"
	 b:glossaryEntry="animal hunted or caught for food"/>
<rdf:Description rdf:about="&a;101661356"
	 b:glossaryEntry="animal hunted for food or sport"/>
<rdf:Description rdf:about="&a;101661456"
	 b:glossaryEntry="large animals that are hunted for sport"/>
