<rdf:Description rdf:about="&a;201302575"
	 b:glossaryEntry="turn, usually 180 degrees"/>
<rdf:Description rdf:about="&a;201302676"
	 b:glossaryEntry="make a half turn on a horse, in dressage"/>
<rdf:Description rdf:about="&a;201302790"
	 b:glossaryEntry='turn a corner: "the car corners"'/>
<rdf:Description rdf:about="&a;201302894">
	<b:glossaryEntry>turn from an upright or normal position; "The big vase overturned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201303067"
	 b:glossaryEntry="pass to the other side; of a corner, for example"/>
<rdf:Description rdf:about="&a;201303191">
	<b:glossaryEntry>cause to overturn from an upright or normal position; "The cat knocked over the flower vase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201303431">
	<b:glossaryEntry>move or jump suddenly, as if in surprise or alarm; "She startled when I walked into the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201303666"
	 b:glossaryEntry="start suddenly, as from fight"/>
<rdf:Description rdf:about="&a;201303764"
	 b:glossaryEntry="startle with amazement or fear"/>
<rdf:Description rdf:about="&a;201303858"
	 b:glossaryEntry="walk or tramp about"/>
<rdf:Description rdf:about="&a;201303950"
	 b:glossaryEntry="stroll"/>
<rdf:Description rdf:about="&a;201304052"
	 b:glossaryEntry="walk around something"/>
<rdf:Description rdf:about="&a;201304159"
	 b:glossaryEntry='travel around something; "circle the globe"'/>
<rdf:Description rdf:about="&a;201304328">
	<b:glossaryEntry>travel around, either by plane or ship: "We compassed the earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201304482"
	 b:glossaryEntry="walk about; not be bedridden or incapable of walking"/>
<rdf:Description rdf:about="&a;201304600">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to go stealthily or furtively: "..stead of sneaking around spying on the Dronk house''''."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201304824">
	<b:glossaryEntry>travel across or pass over; "The caravan covered almost 100 miles each day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201305194">
	<b:glossaryEntry>cover or traverse by striding; "She strode several miles towards the woods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201305333"
	 b:glossaryEntry='traverse by walking; "Walk the tightrope"'/>
<rdf:Description rdf:about="&a;201305436"
	 b:glossaryEntry="cross in a pattern, often random"/>
<rdf:Description rdf:about="&a;201305544"
	 b:glossaryEntry="pass through an enemy-line; in a military conflict"/>
<rdf:Description rdf:about="&a;201305677"
	 b:glossaryEntry="cause (a liquid) to enter by penetrating the interstices"/>
<rdf:Description rdf:about="&a;201305801"
	 b:glossaryEntry="cross a river where it''s shallow"/>
<rdf:Description rdf:about="&a;201305895"
	 b:glossaryEntry='meet and pass; "the trains crossed"'/>
<rdf:Description rdf:about="&a;201305993">
	<b:glossaryEntry>move as if by clawing, seizing, or digging; "They clawed their way to the top of the mountain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201306149">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make one''s way by jostling, pushing, or shoving; "We had to jostle our way to the front of the platform"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201306317"
	 b:glossaryEntry='fold so as to resemble a cross; "she crossed her legs"'/>
<rdf:Description rdf:about="&a;201306452">
	<b:glossaryEntry>change from a crossed to an uncrossed position; "She uncrossed her legs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201306607">
	<b:glossaryEntry>cover by running; run a certain distance; "She ran 10 miles that day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201306737"
	 b:glossaryEntry="cross over on a bridge"/>
<rdf:Description rdf:about="&a;201306823"
	 b:glossaryEntry="cross the road at a red light"/>
<rdf:Description rdf:about="&a;201306917"
	 b:glossaryEntry="make a transit"/>
<rdf:Description rdf:about="&a;201307063"
	 b:glossaryEntry='pass through or across; "The boat cut the water"'/>
<rdf:Description rdf:about="&a;201307198">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pass directly and often in haste; "We cut through the neighbor''s yard to get home sooner"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201307366">
	<b:glossaryEntry>e.g., move through a body or an object with a slicing motion: "His hand sliced through the air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201307553">
	<b:glossaryEntry>walk (through relatively shallow water); "Can we wade across the river to the other side?"; "Wade the pond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201307756"
	 b:glossaryEntry="wade or dabble in a puddle, as of ducks or geese"/>
<rdf:Description rdf:about="&a;201307876">
	<b:glossaryEntry>to walk with a lofty proud gait, often in an attempt to impress others: "He strut around like a rooster in a hen house."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201308121"
	 b:glossaryEntry="walk in one''s sleep"/>
<rdf:Description rdf:about="&a;201308230"
	 b:glossaryEntry='walk stealthily; "I saw a cougar slinking toward its prey"'/>
<rdf:Description rdf:about="&a;201308351">
	<b:glossaryEntry>walk impeded by some physical limitation or injury; "The old woman hobbles down to the store every day."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201308542">
	<b:glossaryEntry xml:space='preserve'><![CDATA[walk by dragging one''s feet; "he shuffled out of the room"; "We heard his feet shuffling down the hall"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201308748"
	 b:glossaryEntry="walk without lifting the feet"/>
<rdf:Description rdf:about="&a;201308847"
	 b:glossaryEntry="walk leisurely and with no apparent aim"/>
<rdf:Description rdf:about="&a;201308960"
	 b:glossaryEntry="walk leisurely"/>
<rdf:Description rdf:about="&a;201309045"
	 b:glossaryEntry='move stealthily; "he prowls that streets"'/>
<rdf:Description rdf:about="&a;201309173"
	 b:glossaryEntry="move around slowly and aimlessly"/>
<rdf:Description rdf:about="&a;201309289"
	 b:glossaryEntry="walk unsteadily, as of small children"/>
<rdf:Description rdf:about="&a;201309435"
	 b:glossaryEntry="move without being stable, as if threatening to fall"/>
<rdf:Description rdf:about="&a;201309575"
	 b:glossaryEntry="take a walk"/>
<rdf:Description rdf:about="&a;201309662">
	<b:glossaryEntry>walk fast, with regular or measured steps; walk with a stride; "He strode confidently across the hall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201309880">
	<b:glossaryEntry>move or march as if in a crowd; "They children trooped into the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201310012"
	 b:glossaryEntry="proceed in file"/>
<rdf:Description rdf:about="&a;201310125"
	 b:glossaryEntry="enter by marching in a file"/>
<rdf:Description rdf:about="&a;201310235"
	 b:glossaryEntry='enter briefly; "He popped in for two minutes"'/>
<rdf:Description rdf:about="&a;201310362"
	 b:glossaryEntry='exit briefly; "He popped out for a quick coffee break"'/>
<rdf:Description rdf:about="&a;201310499"
	 b:glossaryEntry="march out, in a file"/>
<rdf:Description rdf:about="&a;201310603"
	 b:glossaryEntry="move along on foot"/>
<rdf:Description rdf:about="&a;201310684">
	<b:glossaryEntry>walk a long way, as for pleasure or physical exercise; "We were hiking in Colorado"; "hike the Rockies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201310919">
	<b:glossaryEntry>walk heavily, as when weary, or through mud; "Donkeys that plodded wearily in a circle around a gin" D.H. Lawrence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201311148">
	<b:glossaryEntry>walk through mud or mire; "We had to splosh across the wet meadow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201311329"
	 b:glossaryEntry="climb awkwardly, as if by scrambling"/>
<rdf:Description rdf:about="&a;201311485">
	<b:glossaryEntry>go upward with gradual or continuous progress; "Did you ever climb up the hill behind yur house?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201311806"
	 b:glossaryEntry="climb up by means of a ladder"/>
<rdf:Description rdf:about="&a;201311898">
	<b:glossaryEntry>creep up -- used esp. of plants; "The roses ramped over the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201312034"
	 b:glossaryEntry="climb mountains for pleasure, as a sport"/>
<rdf:Description rdf:about="&a;201312143"
	 b:glossaryEntry="lower oneself with a rope from a mountainside"/>
<rdf:Description rdf:about="&a;201312270"
	 b:glossaryEntry='get on the back of; "mount a horse"'/>
<rdf:Description rdf:about="&a;201312465"
	 b:glossaryEntry="mount again, as of a horse"/>
<rdf:Description rdf:about="&a;201312556">
	<b:glossaryEntry>get out of quickly; "The officer hopped out when he spotted an illegally parked car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201312733"
	 b:glossaryEntry="move with difficulty, by grasping"/>
<rdf:Description rdf:about="&a;201312847"
	 b:glossaryEntry="grow upward"/>
<rdf:Description rdf:about="&a;201312939"
	 b:glossaryEntry="walk on one''s toes"/>
<rdf:Description rdf:about="&a;201313046"
	 b:glossaryEntry="walk stiffly"/>
<rdf:Description rdf:about="&a;201313129"
	 b:glossaryEntry='fly low; "Planes buzzed the crowds in the square"'/>
<rdf:Description rdf:about="&a;201313248"
	 b:glossaryEntry="walk emphatically"/>
<rdf:Description rdf:about="&a;201313330"
	 b:glossaryEntry="march in a procession"/>
<rdf:Description rdf:about="&a;201313443">
	<b:glossaryEntry>walk ostentatiously; "She parades her new husband around town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201313595"
	 b:glossaryEntry="walk as if unable to control one''s movements"/>
<rdf:Description rdf:about="&a;201313750"
	 b:glossaryEntry="walk with great difficulty; as in snow or mud"/>
<rdf:Description rdf:about="&a;201313879">
	<b:glossaryEntry>walk heavily; "The men stomped through the snow i their heavy boots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201314034"
	 b:glossaryEntry="move heavily or clumsily"/>
<rdf:Description rdf:about="&a;201314138"
	 b:glossaryEntry="wander from a direct course or at random"/>
