</rdf:Description>
<rdf:Description rdf:about="&a;103426879">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a car that runs on rails and is propelled by electricity: "`tram'' and `tramcar'' are British terms"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103427111">
