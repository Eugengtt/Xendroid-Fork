<rdf:Description rdf:about="&a;200981318"
	 b:glossaryEntry="kiss lightly"/>
<rdf:Description rdf:about="&a;200981408"
	 b:glossaryEntry='touch or stroke lightly; "The grass tickled her calves"'/>
<rdf:Description rdf:about="&a;200981543"
	 b:glossaryEntry="pass the tongue over"/>
<rdf:Description rdf:about="&a;200981657"
	 b:glossaryEntry="lick or explore with the tongue"/>
<rdf:Description rdf:about="&a;200981760"
	 b:glossaryEntry="touch with the mouth"/>
<rdf:Description rdf:about="&a;200981851">
	<b:glossaryEntry>move while holding up or supporting; "Bear gifts"; "bear a heavy load"; also with communication nouns: "bear news"; "bearing orders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200982141"
	 b:glossaryEntry="carry away rapidly and secretly, as if mysteriously"/>
<rdf:Description rdf:about="&a;200982269"
	 b:glossaryEntry="carry in a bucket"/>
<rdf:Description rdf:about="&a;200982350"
	 b:glossaryEntry="make a return, as of a punt or a kickback, in football"/>
<rdf:Description rdf:about="&a;200982468">
	<b:glossaryEntry>bring or fetch; "Get me those books over there, please"; "Could you bring over the wine?"; "The dog fetched the hat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200982792"
	 b:glossaryEntry="of trained dogs"/>
<rdf:Description rdf:about="&a;200982881"
	 b:glossaryEntry='be accompanied by; "Can I bring my cousing to the dinner?"'/>
<rdf:Description rdf:about="&a;200983020">
	<b:glossaryEntry xml:space='preserve'><![CDATA[remove from a certain place or environment; "Their dreams carried the Romantics away into distant lands"; "The car carried us off to the meeting"; "I''ll take you away on a holiday"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200983429"
	 b:glossaryEntry="carry off mysteriously; as if by magic"/>
<rdf:Description rdf:about="&a;200983557"
	 b:glossaryEntry="take away quickly and suddenly"/>
<rdf:Description rdf:about="&a;200983683"
	 b:glossaryEntry="brush or wipe off lightly"/>
<rdf:Description rdf:about="&a;200983791">
	<b:glossaryEntry>send from one person or place to another; "transmit a message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200984089">
	<b:glossaryEntry>transfer from one domain into another, as of ideas and principles</b:glossaryEntry>
