	<b:glossaryEntry>in some classifications an alternative name for the Falconiformes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101127392"
	 b:glossaryEntry="hawks; Old World vultures; kites; harriers; eagles"/>
<rdf:Description rdf:about="&a;101127903">
	<b:glossaryEntry>diurnal bird of prey typically having short rounded wings and a long tail</b:glossaryEntry>
</rdf:Description>
