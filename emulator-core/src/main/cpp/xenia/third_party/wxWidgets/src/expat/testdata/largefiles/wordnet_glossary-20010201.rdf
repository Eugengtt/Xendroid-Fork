</rdf:Description>
<rdf:Description rdf:about="&a;400449748"
	 b:glossaryEntry='in the sixth place; "sixthly, we cannot afford a vacation"'/>
<rdf:Description rdf:about="&a;400449842">
	<b:glossaryEntry>in a sketchy incomplete manner; "he explained sketchily"; "the dishes were only sketchily washed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400449995">
	<b:glossaryEntry>with skill; "fragments of a nearly complete jug, skillfully restored at the institute of archaeology"</b:glossaryEntry>
