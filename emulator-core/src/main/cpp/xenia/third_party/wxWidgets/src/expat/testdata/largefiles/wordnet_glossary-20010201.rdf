</rdf:Description>
<rdf:Description rdf:about="&a;100575364"
	 b:glossaryEntry="(military) a prescribed drill in handling a rifle"/>
<rdf:Description rdf:about="&a;100575502">
	<b:glossaryEntry>a position in the manual of arms; the rifle is held vertically on the right side with the butt on the ground; often used as a command</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100575711"
	 b:glossaryEntry="training soldiers in military procedures"/>
<rdf:Description rdf:about="&a;100575853"
	 b:glossaryEntry="training for a new occupation"/>
<rdf:Description rdf:about="&a;100575939">
	<b:glossaryEntry>the training of an animal (especially the training of a horse for dressage)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100576070"
	 b:glossaryEntry="teaching strategy to an athletic team"/>
<rdf:Description rdf:about="&a;100576184"
	 b:glossaryEntry="training in marching and the use of weapons"/>
<rdf:Description rdf:about="&a;100576351">
