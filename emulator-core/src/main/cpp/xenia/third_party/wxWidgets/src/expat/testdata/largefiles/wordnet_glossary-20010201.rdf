	 b:glossaryEntry="a very hard heat-resistant steel containing tungsten"/>
<rdf:Description rdf:about="&a;110820047"
	 b:glossaryEntry="a salt of tungstic acid"/>
<rdf:Description rdf:about="&a;110820126">
