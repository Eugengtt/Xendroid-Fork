<rdf:Description rdf:about="&a;200264663"
	 b:glossaryEntry='get blistery; "Her feet blistered during the long hike"'/>
<rdf:Description rdf:about="&a;200264783">
	<b:glossaryEntry>make a shift in or exchange of; "First Joe led; then we switched"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200264990">
	<b:glossaryEntry>change the order or arrangement of; "Dyslexics often transpose letters in a word"</b:glossaryEntry>
</rdf:Description>
