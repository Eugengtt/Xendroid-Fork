</rdf:Description>
<rdf:Description rdf:about="&a;101732398"
	 b:glossaryEntry="long-horned grasshoppers"/>
<rdf:Description rdf:about="&a;101732547"
	 b:glossaryEntry="sand crickets"/>
<rdf:Description rdf:about="&a;101732680">
	<b:glossaryEntry>large wingless nocturnal grasshopper that burrows in loose soil along the United States Pacific coast</b:glossaryEntry>
</rdf:Description>
