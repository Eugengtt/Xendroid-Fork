	 b:glossaryEntry="type genus of the Anacardiaceae: cashew"/>
<rdf:Description rdf:about="&a;109058351">
	<b:glossaryEntry>tropical American evergreen tree bearing kidney-shaped nuts that are edible only when roasted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109058574"
	 b:glossaryEntry="a genus of dicotyledonous plants of the family Anacardiaceae"/>
