</rdf:Description>
<rdf:Description rdf:about="&a;201179144">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pretend to be somebody in the framework of a game or playful activity; "Let''s play like I am mommy"; "Play cowboy and Indians"]]></b:glossaryEntry>
