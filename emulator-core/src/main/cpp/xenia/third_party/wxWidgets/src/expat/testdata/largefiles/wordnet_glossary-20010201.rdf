</rdf:Description>
<rdf:Description rdf:about="&a;105224591">
	<b:glossaryEntry>the language of the Basque people; of no known relation to any other language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105224721">
	<b:glossaryEntry>the Romance language spoken in most of Spain and the countries colonized by Spain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105224856">
	<b:glossaryEntry>the Romance language spoken in Catalonia in E Spain (related to Spanish and Occitan)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105224994"
	 b:glossaryEntry="an eastern Romance language spoken in Rumania"/>
<rdf:Description rdf:about="&a;105225094">
	<b:glossaryEntry>an extinct ancient language of unknown affinities; spoken by the Elamites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105225241"
	 b:glossaryEntry="an ancient language spoken by the Kassite people"/>
<rdf:Description rdf:about="&a;105225353">
	<b:glossaryEntry>a branch of the Indo-European language family that originated in central Asia during the first millennium A.D.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105225555"
	 b:glossaryEntry="a dialect of Tocharian"/>
<rdf:Description rdf:about="&a;105225664"
	 b:glossaryEntry="a dialect of Tocharian"/>
<rdf:Description rdf:about="&a;105225775">
	<b:glossaryEntry>an ancient language of India (the language of the Vedas and of Hinduism); an official language of India although it is now used only for religious purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105226187"
	 b:glossaryEntry="the Indic language of the Sindhi people"/>
<rdf:Description rdf:about="&a;105226279"
	 b:glossaryEntry="the Indic language of the Gypsies"/>
<rdf:Description rdf:about="&a;105226373">
	<b:glossaryEntry>the official literary language of Pakistan, closely related to Hindi; widely used in India (mostly by Moslems); written in Arabic script</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105226560">
	<b:glossaryEntry>the most widely spoken of modern Indic vernaculars; spoken mostly in the north of India; along with English it is the official language of India; usually written in Devanagari script</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105226812"
	 b:glossaryEntry="a form of Hindi spoken around Delhi"/>
<rdf:Description rdf:about="&a;105226931">
	<b:glossaryEntry>the Indic language spoken in Bihar (and by some people in Pakistan and Bangladesh)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105227066"
	 b:glossaryEntry="a subfamily of Indic languages"/>
<rdf:Description rdf:about="&a;105227205">
	<b:glossaryEntry>the Magadhan language spoken by the Assamese people; closely related to Bengali</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105227349">
	<b:glossaryEntry>a Magadhan language spoken by the Bengali people; the official language of Bangladesh and West Bengal</b:glossaryEntry>
</rdf:Description>
