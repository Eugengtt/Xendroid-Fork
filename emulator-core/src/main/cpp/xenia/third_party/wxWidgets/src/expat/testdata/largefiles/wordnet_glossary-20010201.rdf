</rdf:Description>
<rdf:Description rdf:about="&a;101162935">
	<b:glossaryEntry>largest North American frog; highly aquatic with a deep-pitched voice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101163097">
