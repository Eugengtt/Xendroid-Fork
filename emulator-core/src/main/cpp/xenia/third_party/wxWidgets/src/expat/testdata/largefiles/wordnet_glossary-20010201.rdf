	<b:glossaryEntry>an oil from chaulmoogra trees; used in treatment of skin diseases and leprosy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110823160">
	<b:glossaryEntry>a salt or ester of vanadic acid; an anion containing pentavalent vanadium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110823288">
	<b:glossaryEntry>a mineral consisting of chloride and vanadate of lead; a source of vanadium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110823439">
	<b:glossaryEntry>any of various oxyacids of vanadium; known mostly in the form of its salts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110823593">
	<b:glossaryEntry>steel alloyed with vanadium for greater strength and high-temperature stability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110823733"
	 b:glossaryEntry="a heavy creamy-colored paper resembling parchment"/>
<rdf:Description rdf:about="&a;110823835">
	<b:glossaryEntry>a green or yellow or brown mineral consisting of a hydrated silicate; it occurs as crystals in limestone and is used a gemstone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110824042"
	 b:glossaryEntry="dilute acetic acid"/>
<rdf:Description rdf:about="&a;110824114">
	<b:glossaryEntry>shiny and tough and flexible; used especially for floor coverings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110824231">
	<b:glossaryEntry>a red pigment in the retinal rods of vertebrates; dissociates into retinene by light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110824442">
	<b:glossaryEntry>any of a group of organic substances essential in small quantities to normal metabolism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110824630"
	 b:glossaryEntry="any vitamin that is soluble in fats"/>
<rdf:Description rdf:about="&a;110824803"
	 b:glossaryEntry="any vitamin that is soluble in water"/>
