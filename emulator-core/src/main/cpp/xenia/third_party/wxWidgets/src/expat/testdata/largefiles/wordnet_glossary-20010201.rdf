	 b:glossaryEntry="crossing one another in opposite directions"/>
<rdf:Description rdf:about="&a;400287823"
	 b:glossaryEntry='in the opposite direction; "run counter"'/>
<rdf:Description rdf:about="&a;400287899"
	 b:glossaryEntry='across the countryside; "the river runs crosscountry"'/>
<rdf:Description rdf:about="&a;400287994">
	<b:glossaryEntry>in an ill-natured manner; "she looked at her husband crossly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400288168">
	<b:glossaryEntry>in an artful manner; "he craftily arranged to be there when the decision was announced"; "had ever circumstances conspired so cunningly?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400288531">
	<b:glossaryEntry>in a confused manner; "Queen Augusta wrote him an hysterical letter in which she confusedly sympathised with him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400288701">
	<b:glossaryEntry>as a consequence; "he had good reason to be grateful for the opportunities which they had made available to him and which consequently led to the good position he now held"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400288944"
	 b:glossaryEntry="having consequence"/>
<rdf:Description rdf:about="&a;400289024">
