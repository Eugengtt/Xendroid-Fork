</rdf:Description>
<rdf:Description rdf:about="&a;109228524"
	 b:glossaryEntry="fool''s parsley"/>
<rdf:Description rdf:about="&a;109228646">
	<b:glossaryEntry>European weed naturalized in America that resembles parsley but causes nausea and poisoning when eaten</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109228864"
	 b:glossaryEntry="dill"/>
<rdf:Description rdf:about="&a;109228957">
	<b:glossaryEntry>aromatic Old World herb having aromatic threadlike foliage and seeds used as seasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109229153"
	 b:glossaryEntry="biennial of perennial taprooted herbs of northern hemisphere"/>
<rdf:Description rdf:about="&a;109229311">
	<b:glossaryEntry>any of various tall and stout herbs of the genus Angelica having pinnately compound leaves and small white or greenish flowers in compound umbels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109229578">
	<b:glossaryEntry>a biennial cultivated herb; its stems are candied and eaten and its roots are used medicinally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109229770">
	<b:glossaryEntry>European herb with compound leaves and white flowers; adventive on Cape Breton Island</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109229937"
	 b:glossaryEntry="chervil: of Europe, North Africa and Asia"/>
<rdf:Description rdf:about="&a;109230111">
	<b:glossaryEntry>aromatic annual Old World herb cultivated for its finely divided and often curly leaves for use especially in soups and salads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109230371">
	<b:glossaryEntry>coarse erect biennial Old World herb introduced as a weed in eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109230569"
	 b:glossaryEntry="celery"/>
<rdf:Description rdf:about="&a;109230679"
	 b:glossaryEntry="herb of Europe and temperate Asia"/>
<rdf:Description rdf:about="&a;109230808">
	<b:glossaryEntry>widely cultivated herb with aromatic leaf stalks that are eaten raw or cooked</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109231021"
	 b:glossaryEntry="grown for its thickened edible aromatic root"/>
<rdf:Description rdf:about="&a;109231232"
	 b:glossaryEntry="masterworts"/>
<rdf:Description rdf:about="&a;109231343"
	 b:glossaryEntry="any plant of the genus Astrantia"/>
<rdf:Description rdf:about="&a;109231468">
	<b:glossaryEntry>European herb with aromatic roots and leaves in a basal tuft and showy compound umbels of white to rosy flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109231662"
	 b:glossaryEntry="caraway"/>
<rdf:Description rdf:about="&a;109231773">
	<b:glossaryEntry>a Eurasian plant with small white flowers yielding caraway seed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109231979"
	 b:glossaryEntry="a caraway with whorled leaves"/>
<rdf:Description rdf:about="&a;109232070">
	<b:glossaryEntry>small genus of perennial herbs having deadly poisonous tuberous roots: water hemlock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109232279">
	<b:glossaryEntry>tall erect highly poisonous Eurasiatic perennial herb locally abundant in marshy areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109232460">
	<b:glossaryEntry>tall biennial water hemlock of northeastern North America having purple-spotted stems and clusters of extremely poisonous tuberous roots resembling small sweet potatoes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109232751"
	 b:glossaryEntry="small genus of highly toxic biennials: hemlock"/>
<rdf:Description rdf:about="&a;109232903">
	<b:glossaryEntry>large branching biennial herb native to Eurasia and Africa and adventive in North America having large fernlike leaves and white flowers; usually found in damp habitats; all parts extremely poisonous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109233276"
	 b:glossaryEntry="a genus of dicotyledonous plants of the family Umbelliferae"/>
<rdf:Description rdf:about="&a;109233449">
	<b:glossaryEntry>a common European plant having edible tubers with the flavor of roasted chestnuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109233627"
	 b:glossaryEntry="small genus of annual Mediterranean herbs"/>
<rdf:Description rdf:about="&a;109233763"
	 b:glossaryEntry="Old World herb with aromatic parsleylike leaves and seed"/>
<rdf:Description rdf:about="&a;109234000"
	 b:glossaryEntry="cumin"/>
<rdf:Description rdf:about="&a;109234113">
	<b:glossaryEntry>dwarf Mediterranean annual long cultivated for its aromatic seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109234286"
	 b:glossaryEntry="carrot"/>
<rdf:Description rdf:about="&a;109234417">
	<b:glossaryEntry>a widely naturalized Eurasian herb with finely cut foliage and white compound umbels of small white or yellowish flowers and thin yellowish roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109234675">
	<b:glossaryEntry>perennial plant widely cultivated as an annual in many varieties for its long conical deep-orange edible roots; temperate and tropical regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109234970"
	 b:glossaryEntry="deep orange edible root of the cultivated carrot plant"/>
<rdf:Description rdf:about="&a;109235096">
	<b:glossaryEntry>large genus of decorative plants with thistlelike flower heads; cosmopolitan in distribution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109235355"
	 b:glossaryEntry="any plant of the genus Eryngium"/>
<rdf:Description rdf:about="&a;109235467">
	<b:glossaryEntry>European evergreen eryngo with twisted spiny leaves naturalized on United States east coast; roots formerly used as an aphrodisiac</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109235719">
	<b:glossaryEntry>coarse prickly perennial eryngo with aromatic roots; southeastern United States; often confused with rattlesnake master</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109235941">
	<b:glossaryEntry>coarse prickly perennial eryngo of United States thought to cure rattlesnake bite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109236171">
	<b:glossaryEntry>very small genus of aromatic European herbs with pinnately compound leaves and yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109236378">
	<b:glossaryEntry>any of several aromatic herbs having edible seeds and leaves and stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109236556">
	<b:glossaryEntry>strongly aromatic with a smell of aniseed; leaves and seeds used for seasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109236753"
	 b:glossaryEntry="grown especially for its edible aromatic bulbous stem base"/>
<rdf:Description rdf:about="&a;109236938">
	<b:glossaryEntry>widely distributed genus of plants with usually thick rootstocks and large umbels of white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109237148">
	<b:glossaryEntry>tall coarse plant having thick stems and cluster of white to purple flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109237334"
	 b:glossaryEntry="genus of aromatic European herbs with yellow flowers"/>
<rdf:Description rdf:about="&a;109237500">
	<b:glossaryEntry>native to southern Europe; cultivated for its edible stalks and foliage and seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109237696">
	<b:glossaryEntry>European perennial herbs having pinnate leaves and umbels of white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109237878"
	 b:glossaryEntry="European herb with soft ferny leaves and white flowers"/>
<rdf:Description rdf:about="&a;109238047"
	 b:glossaryEntry="poisonous herbs: water dropworts"/>
<rdf:Description rdf:about="&a;109238208">
	<b:glossaryEntry>European poisonous herb having tuberous roots, yellow juice that stains the skin, yellow flowers and foliage resembling celery; all parts extremely poisonous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109238489"
	 b:glossaryEntry="European poisonous herb with fibrous roots"/>
<rdf:Description rdf:about="&a;109238629">
	<b:glossaryEntry>a rosid dicot genus of the family Umbelliferae; includes parsnips</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109238805"
	 b:glossaryEntry="a strong-scented plant cultivated for its edible root"/>
<rdf:Description rdf:about="&a;109238986">
	<b:glossaryEntry>European biennial having a long fusiform root that has been made palatable through cultivation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109239183"
	 b:glossaryEntry="the whitish root of cultivated parsnip"/>
<rdf:Description rdf:about="&a;109239294">
	<b:glossaryEntry>biennial weed in Europe and America having large pinnate leaves and yellow flowers and a bitter and somewhat poisonous root; the ancestor of cultivated parsnip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109239539"
	 b:glossaryEntry="parsley"/>
<rdf:Description rdf:about="&a;109239664"
	 b:glossaryEntry="annual or perennial herb with aromatic finely-cut leaves"/>
<rdf:Description rdf:about="&a;109239852"
	 b:glossaryEntry="a variety of parsley having flat leaves"/>
<rdf:Description rdf:about="&a;109240009">
	<b:glossaryEntry>parsley with smooth leaves and enlarged edible taproot resembling a savory parsnip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109240210"
	 b:glossaryEntry="anise"/>
<rdf:Description rdf:about="&a;109240329">
	<b:glossaryEntry>native to Egypt but cultivated widely for its aromatic seeds and the oil from them used medicinally and as a flavoring in cookery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109240582"
	 b:glossaryEntry="chiefly American herbs: sanicle"/>
<rdf:Description rdf:about="&a;109240723">
	<b:glossaryEntry>a plant of the genus Sanicula having palmately compound leaves and unisexual flowers in panicled umbels followed by bristly fruit; reputed to have healing powers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109241023">
	<b:glossaryEntry>sanicle of northwestern United States and British Columbia having yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109241192">
	<b:glossaryEntry>sanicle of northwestern United States and British Columbia having yellow or red or purple flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109241375"
	 b:glossaryEntry="sanicle of Europe and Asia having white to pale pink flowers"/>
<rdf:Description rdf:about="&a;109241518"
	 b:glossaryEntry="moon carrots"/>
<rdf:Description rdf:about="&a;109241636">
	<b:glossaryEntry>any plant of the genus Seseli having dense umbels of small white or pink flowers and finely divided foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109241836"
	 b:glossaryEntry="stone parsley"/>
