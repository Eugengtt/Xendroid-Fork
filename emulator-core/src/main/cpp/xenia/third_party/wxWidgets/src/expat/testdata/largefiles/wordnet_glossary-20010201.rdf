</rdf:Description>
<rdf:Description rdf:about="&a;201557594"
	 b:glossaryEntry="make a lot of money"/>
<rdf:Description rdf:about="&a;201557697"
	 b:glossaryEntry="make a profit; gain money or materially"/>
<rdf:Description rdf:about="&a;201557898">
	<b:glossaryEntry>make a big profit; often in a short period of time; "The investor really cleaned up when the stock market went up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201558078"
	 b:glossaryEntry="take advantage of or capitalize on"/>
<rdf:Description rdf:about="&a;201558180">
	<b:glossaryEntry>make an unreasonable profit, as on the sale of difficult to obtain goods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201558319">
	<b:glossaryEntry>draw advantages from; "he is capitalizing on her mistake"; "she took advantage of his absence to meet her lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201558516"
	 b:glossaryEntry="make neither profit nor loss"/>
<rdf:Description rdf:about="&a;201558630"
	 b:glossaryEntry="profit suddenly"/>
<rdf:Description rdf:about="&a;201558731">
	<b:glossaryEntry>keep in perfect or unaltered condition; "We preserve these archeological findings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201558918">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deplete; "exhaust one''s savings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201559048"
	 b:glossaryEntry="lay away for future use"/>
<rdf:Description rdf:about="&a;201559274">
	<b:glossaryEntry>lay in provisions; "The vessel victualled before the long voyage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201559412"
	 b:glossaryEntry="put into long-term storage"/>
<rdf:Description rdf:about="&a;201559504"
	 b:glossaryEntry="store in a tank by causing (something) to flow into it"/>
