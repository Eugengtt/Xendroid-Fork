	 b:glossaryEntry="make incapable of military action"/>
<rdf:Description rdf:about="&a;200758527"
	 b:glossaryEntry="yield to the control of another"/>
<rdf:Description rdf:about="&a;200758648">
	<b:glossaryEntry>make accountable for: "He did not want to subject himself to the judgments of his superiors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200758805">
	<b:glossaryEntry>take the initiative and go on the offensive: "The Serbs attacked the village at night"; "The visting team started to attack"</b:glossaryEntry>
</rdf:Description>
