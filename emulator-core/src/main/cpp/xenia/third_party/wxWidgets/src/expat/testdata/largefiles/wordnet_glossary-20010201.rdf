</rdf:Description>
<rdf:Description rdf:about="&a;108125805">
	<b:glossaryEntry>large widely distributed genus of plants having mostly showy flowers of various colors: campion; catchfly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108126102"
	 b:glossaryEntry="any plant of the genus Silene"/>
<rdf:Description rdf:about="&a;108126332">
