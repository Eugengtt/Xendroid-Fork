	 b:glossaryEntry="a genus of Sciaenidae"/>
<rdf:Description rdf:about="&a;102088347"
	 b:glossaryEntry="small silvery marine food fish found off California"/>
<rdf:Description rdf:about="&a;102088521"
	 b:glossaryEntry="a genus of Sciaenidae"/>
