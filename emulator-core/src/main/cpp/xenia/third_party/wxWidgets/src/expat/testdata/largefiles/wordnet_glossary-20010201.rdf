</rdf:Description>
<rdf:Description rdf:about="&a;108598931"
	 b:glossaryEntry="similar to Gentiana andrewsii but with larger flowers"/>
<rdf:Description rdf:about="&a;108599079"
	 b:glossaryEntry="robust European perennial having clusters of yellow flowers"/>
<rdf:Description rdf:about="&a;108599241">
	<b:glossaryEntry>perennial Eurasian gentian with sky-blue funnel-shaped flowers of damp open heaths</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108599445">
	<b:glossaryEntry>erect perennial of wet woodlands of North America having leaves and flower buds resembling those of soapwort</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108599637"
	 b:glossaryEntry="a perennial marsh ventian of eastern North America"/>
<rdf:Description rdf:about="&a;108599768">
