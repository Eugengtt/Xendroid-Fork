	 b:glossaryEntry="herbivorous dinosaurs of the Cretaceous"/>
<rdf:Description rdf:about="&a;101231156">
	<b:glossaryEntry>genus of herbivorous dinosaurs flourishing during the Cretaceous in South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101231374">
