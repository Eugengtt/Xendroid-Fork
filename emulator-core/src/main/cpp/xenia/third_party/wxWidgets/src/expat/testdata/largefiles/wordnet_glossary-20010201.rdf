<rdf:Description rdf:about="&a;106110498"
	 b:glossaryEntry="club that promotes and supports yachting and boating"/>
<rdf:Description rdf:about="&a;106110607">
	<b:glossaryEntry>an association of sports teams that organizes matches for its members</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106110886"
	 b:glossaryEntry="the most important league in any sport (especially baseball)"/>
<rdf:Description rdf:about="&a;106111046">
	<b:glossaryEntry>a league of teams that do not belong to a major league (especially baseball)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106111209"
	 b:glossaryEntry="a league of baseball teams"/>
<rdf:Description rdf:about="&a;106111334">
	<b:glossaryEntry>a commercially sponsored baseball league for players between 8 and 12 years of age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106111495"
	 b:glossaryEntry="a team that plays in a little league"/>
<rdf:Description rdf:about="&a;106111634"
	 b:glossaryEntry="a league of basketball teams"/>
<rdf:Description rdf:about="&a;106111745"
	 b:glossaryEntry="a league of bowling teams"/>
<rdf:Description rdf:about="&a;106111831"
	 b:glossaryEntry="a league of football teams"/>
<rdf:Description rdf:about="&a;106111938"
	 b:glossaryEntry="a league of hockey teams"/>
<rdf:Description rdf:about="&a;106112041">
	<b:glossaryEntry>an organization of employees formed to bargain with the employer; "you have to join the union in order to get a job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106112339">
	<b:glossaryEntry>a labor union that admits all workers in a given industry irrespective of their craft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106112504">
	<b:glossaryEntry>a labor union whose membership is restricted to workers in a particular craft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106112639">
	<b:glossaryEntry>a cooperative depository financial institution whose members can obtain loans from their combined savings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106112803">
	<b:glossaryEntry>a union of workers for a single company; a union not affiliated with with a larger union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106112951">
	<b:glossaryEntry>a company whose workers are hired without regard to their membership in a labor union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106113092"
	 b:glossaryEntry="a company that hires only union members"/>
<rdf:Description rdf:about="&a;106113189">
	<b:glossaryEntry>a company allowed to hire nonunion workers on the condition that they will join the union within a specified time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106113359"
	 b:glossaryEntry="a social club for male undergraduates"/>
<rdf:Description rdf:about="&a;106113479"
	 b:glossaryEntry="a social club for female undergraduates"/>
<rdf:Description rdf:about="&a;106113573"
	 b:glossaryEntry="a society that conceals its activities from nonmembers"/>
<rdf:Description rdf:about="&a;106113724"
	 b:glossaryEntry="Freemasons collectively"/>
<rdf:Description rdf:about="&a;106113834">
	<b:glossaryEntry>a club of professional or business people organized for their coordination and active in public services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106114033">
	<b:glossaryEntry>club dedicated to promoting responsible citizenship and good government and community and national and international welfare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106114257">
	<b:glossaryEntry>a group of businessmen in a town organized as a service club and to promote world peace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106114444"
	 b:glossaryEntry="an association of companies for some definite purpose"/>
<rdf:Description rdf:about="&a;106114591">
	<b:glossaryEntry>a consortium of companies formed to limit competition; "they set up the trust in the hope of gaining a monopoly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106114774"
	 b:glossaryEntry="the actors in a play"/>
<rdf:Description rdf:about="&a;106114923"
	 b:glossaryEntry="a cast other than the principles"/>
<rdf:Description rdf:about="&a;106115031"
	 b:glossaryEntry="the body of voters who elect a representative for their area"/>
<rdf:Description rdf:about="&a;106115188">
	<b:glossaryEntry>the body of electors who formally elect the US president and vice-president</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106115327">
	<b:glossaryEntry>a body of students who are taught together; "early morning classes are always sleepy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106115587">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a body of students who graduate together: "the class of ''97"; "she was in my year at Hoehandle High"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106115836"
	 b:glossaryEntry="the body of students who graduate together this year"/>
<rdf:Description rdf:about="&a;106115951"
	 b:glossaryEntry="students taking a course in biology together"/>
<rdf:Description rdf:about="&a;106116055"
	 b:glossaryEntry="students taking a course in chemistry together"/>
<rdf:Description rdf:about="&a;106116163"
	 b:glossaryEntry="students taking a course in English together"/>
<rdf:Description rdf:about="&a;106116267"
	 b:glossaryEntry="students beginning elementary school"/>
<rdf:Description rdf:about="&a;106116361"
	 b:glossaryEntry="students taking a course in physics together"/>
<rdf:Description rdf:about="&a;106116465"
	 b:glossaryEntry="final grade or class in high school or college"/>
<rdf:Description rdf:about="&a;106116570"
	 b:glossaryEntry="penultimate class in high school or college"/>
<rdf:Description rdf:about="&a;106116672"
	 b:glossaryEntry="the second class in a four-year college or high school"/>
<rdf:Description rdf:about="&a;106116788"
	 b:glossaryEntry="the first class in college or high school"/>
<rdf:Description rdf:about="&a;106116890">
	<b:glossaryEntry>a league ranked by quality; "he played baseball in class D for two years"; "Princeton is in the NCAA Division 1-AA"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106117068">
	<b:glossaryEntry>an unofficial association of people or groups; "the smart set goes there"; "they were an angry lot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106117365"
	 b:glossaryEntry="an exclusive circle of people with a common purpose"/>
<rdf:Description rdf:about="&a;106117608">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an inner circle of advisors (especially under President Reagan); "he''s no longer in the loop"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106117752"
	 b:glossaryEntry="a clique that seeks power usually through intrigue"/>
<rdf:Description rdf:about="&a;106117892"
	 b:glossaryEntry="a nucleus of military personnel capable of expansion"/>
<rdf:Description rdf:about="&a;106118015">
	<b:glossaryEntry>a small group of indispensable persons or things; "five periodicals make up the core of their publishing program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106118220"
	 b:glossaryEntry="an association of practitioners of a given profession"/>
<rdf:Description rdf:about="&a;106118344"
	 b:glossaryEntry="an organized group of workmen"/>
<rdf:Description rdf:about="&a;106118590">
	<b:glossaryEntry>a crew of workers selected for a particular task; "a detail was sent to remove the fallen trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106118739"
	 b:glossaryEntry="a gang of convicts chained together"/>
<rdf:Description rdf:about="&a;106118831">
	<b:glossaryEntry>the crew of technicians and mechanics who service aircraft on the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106118983"
	 b:glossaryEntry="a gang of road workers"/>
<rdf:Description rdf:about="&a;106119061"
	 b:glossaryEntry="a work crew assigned to a section of a railroad"/>
<rdf:Description rdf:about="&a;106119186">
	<b:glossaryEntry>crew of workers who move scenery or handle properties in a theatrical production</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106119342">
	<b:glossaryEntry>an association of British socialists who advocate gradual reforms within the law leading to democratic socialism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106119534">
	<b:glossaryEntry>an association of criminals; "police tried to break up the gang"; "a pack of thieves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106119764">
	<b:glossaryEntry>a gang of criminals assembled in one place; "a nest of thieves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106119878"
	 b:glossaryEntry="a gang whose members are teenagers"/>
<rdf:Description rdf:about="&a;106120007">
	<b:glossaryEntry>a class of woman not considered respectable because of indiscreet or promiscuous behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106120171"
	 b:glossaryEntry="the criminal class"/>
<rdf:Description rdf:about="&a;106120284"
	 b:glossaryEntry="underworld organizations"/>
<rdf:Description rdf:about="&a;106120501"
	 b:glossaryEntry="(informal) any tightly knit group of trusted associates"/>
<rdf:Description rdf:about="&a;106120617">
	<b:glossaryEntry>a secret terrorist group in Sicily; originally opposed tyranny but evolved into a criminal organization in the middle of the 19th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106120832">
	<b:glossaryEntry>a crime syndicate in the United States; organized in families; believed to have important relations to the Sicilian Mafia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106121028">
	<b:glossaryEntry>a secret terrorist society in the US early in the 20th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106121147">
	<b:glossaryEntry>a secret society in Naples notorious for violence and blackmail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106121264">
	<b:glossaryEntry>a loose affiliation of gangsters in charge of organized criminal activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106121419"
	 b:glossaryEntry="class of small freeholders who cultivated their own land"/>
<rdf:Description rdf:about="&a;106121530"
	 b:glossaryEntry="an organization of musicians who perform together"/>
<rdf:Description rdf:about="&a;106121915"
	 b:glossaryEntry="two performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122027"
	 b:glossaryEntry="three performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122126"
	 b:glossaryEntry="four performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122257">
	<b:glossaryEntry>an instrumental quartet with 2 violins and a viola and a cello</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106122399"
	 b:glossaryEntry="five performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122512"
	 b:glossaryEntry="six performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122631"
	 b:glossaryEntry="seven performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122743"
	 b:glossaryEntry="eight performers or singers who perform together"/>
<rdf:Description rdf:about="&a;106122853"
	 b:glossaryEntry="instrumentalists including string players"/>
<rdf:Description rdf:about="&a;106123023"
	 b:glossaryEntry="small orchestra; usually plays classical music"/>
<rdf:Description rdf:about="&a;106123133"
	 b:glossaryEntry="an orchestra playing only string instruments"/>
<rdf:Description rdf:about="&a;106123240">
	<b:glossaryEntry>a large orchestra; can perform symphonies; "we heard the Vienna symphony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106123389"
	 b:glossaryEntry="instrumentalists not including string players"/>
<rdf:Description rdf:about="&a;106123540">
	<b:glossaryEntry>a group of musicians playing only brass and percussion instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106123663">
	<b:glossaryEntry>a group of musicians playing brass and woodwind and percussion instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106123812">
	<b:glossaryEntry>a musical group that uses jugs and washboards and kazoos and other improvised instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106123956"
	 b:glossaryEntry="a group of musicians playing popular music for dancing"/>
<rdf:Description rdf:about="&a;106124164">
	<b:glossaryEntry>a large dance or jazz band usually featuring improvised solos by lead musicians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106124298"
	 b:glossaryEntry="a small band of jazz musicians"/>
<rdf:Description rdf:about="&a;106124405"
	 b:glossaryEntry="a group of street musicians in Mexico"/>
<rdf:Description rdf:about="&a;106124497"
	 b:glossaryEntry="a band of musicians who play rock-''n''-roll music"/>
<rdf:Description rdf:about="&a;106124614"
	 b:glossaryEntry="(British) a band of musicians who play skiffle"/>
<rdf:Description rdf:about="&a;106124720">
	<b:glossaryEntry>a band that plays instruments made from the heads of oil drums (Caribbean Islands)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106124859"
	 b:glossaryEntry="a nomadic community"/>
<rdf:Description rdf:about="&a;106124948">
	<b:glossaryEntry>a Mongolian army that swept over eastern Europe in the 13th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106125074"
	 b:glossaryEntry="a band of warriors (originally a unit of a Roman Legion)"/>
<rdf:Description rdf:about="&a;106125183"
	 b:glossaryEntry="a company of companions or supporters"/>
<rdf:Description rdf:about="&a;106125273">
	<b:glossaryEntry>a group of conspirators banded together to achieve some harmful or illegal purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106125445"
	 b:glossaryEntry="the exclusive social set of a city"/>
<rdf:Description rdf:about="&a;106125557">
	<b:glossaryEntry>a set of people sharing a devotion to horses and horseback riding and horse racing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106125708">
	<b:glossaryEntry>a set of rich and fashionable people who travel widely for pleasure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106125829"
	 b:glossaryEntry="a dissenting clique"/>
<rdf:Description rdf:about="&a;106126017">
	<b:glossaryEntry>a faction or sect that has broken away from its parent organization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106126145"
	 b:glossaryEntry="a gathering for the purpose of promoting fellowship"/>
<rdf:Description rdf:about="&a;106126401">
	<b:glossaryEntry>a formal or official social gathering or ceremony; "it was a black-tie function"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106126536">
	<b:glossaryEntry>a group of people gathered together for pleasure; "she joined the party after dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106126979"
	 b:glossaryEntry="a large and noisy party of people"/>
<rdf:Description rdf:about="&a;106127075"
	 b:glossaryEntry="a party of people assembled for dancing"/>
<rdf:Description rdf:about="&a;106127202">
	<b:glossaryEntry>a formal dance held for a school class toward the end of the academic year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106127339"
	 b:glossaryEntry="an informal dance where popular music is played"/>
<rdf:Description rdf:about="&a;106127449">
	<b:glossaryEntry>a lavish formal dance; "she was the loveliest girl at the ball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106127636"
	 b:glossaryEntry="a ball at which young ladies are presented to society"/>
<rdf:Description rdf:about="&a;106127756"
	 b:glossaryEntry="a ball at which guests wear costumes and masks"/>
<rdf:Description rdf:about="&a;106127915"
	 b:glossaryEntry="a party of guests wearing costumes and masks"/>
<rdf:Description rdf:about="&a;106128050"
	 b:glossaryEntry="a ceremonial dinner party for many people"/>
<rdf:Description rdf:about="&a;106128171">
	<b:glossaryEntry>a party of people assembled to have dinner together; "guests should never be late to a dinner party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106128375">
	<b:glossaryEntry>(British) a celebratory feast held annually at one of the colleges in a British university</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106128517">
	<b:glossaryEntry>(British) an annual dinner party given by an employer for the employees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106128644"
	 b:glossaryEntry="a formal party of people; as after a wedding"/>
<rdf:Description rdf:about="&a;106128817"
	 b:glossaryEntry="a reception held in your own home"/>
<rdf:Description rdf:about="&a;106128904">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a reception or party at which tea is served; "we met at the Dean''s tea for newcomers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106129039"
	 b:glossaryEntry="a reception wedding guests held after the wedding"/>
<rdf:Description rdf:about="&a;106129152"
	 b:glossaryEntry="an informal party of people with hospitality for all comers"/>
<rdf:Description rdf:about="&a;106129268">
	<b:glossaryEntry>a party of people assembled to celebrate moving into a new home</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106129390">
	<b:glossaryEntry>a party of people assembled in the evening (usually at a private house)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106129532"
	 b:glossaryEntry="a soiree assembled for the purpose of listening to music"/>
<rdf:Description rdf:about="&a;106129667">
	<b:glossaryEntry>a party of people assembled for social interaction out of doors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106129819">
	<b:glossaryEntry>stag party held for a bachelor (usually on the night before he is married)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106129954">
	<b:glossaryEntry>a party of friends assembled to present gifts (usually of a specified kind) to a person; "her friends organized a baby shower for her when she was expecting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106130164">
	<b:glossaryEntry>a party for men only (or one considered suitable for men only)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106130310"
	 b:glossaryEntry="a party for women only"/>
<rdf:Description rdf:about="&a;106130388">
	<b:glossaryEntry>an overnight party of girls who dress in nightclothes and and pass the night talking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106130532">
	<b:glossaryEntry>a party of people assembled to promote sociability and communal activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106130676">
	<b:glossaryEntry>a social gathering where a light evening meal is served; "her suppers often included celebrities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106130826"
	 b:glossaryEntry="a party of people at a wedding"/>
<rdf:Description rdf:about="&a;106131059">
	<b:glossaryEntry>(British) a party of people assembled to play progressive whist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106131180">
	<b:glossaryEntry>an organization to gain political power; "in 1992 Perot tried to organize a third party at the national level"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106131883">
	<b:glossaryEntry>a former political party in the US; formed in 1936 in New York when labor and liberals bolted the Democratic Party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106132064">
	<b:glossaryEntry>a former political party in the US; active in the 1850s to keep power out of the hands of immigrants and Roman Catholics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106132266">
	<b:glossaryEntry>a former political party in the US; founded in 1825 in opposition to Freemasonry in public affairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106132429"
	 b:glossaryEntry="a political party advocating communism in the US"/>
<rdf:Description rdf:about="&a;106132539">
	<b:glossaryEntry>in Communist countries: the sole political party of the state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106132681">
	<b:glossaryEntry>a political party in Great Britain which developed from the Tories in the 1830s; advocates a mixed economy and encourages property owning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106132883">
	<b:glossaryEntry>a former political party in the US; formed in 1859 by former Whigs who hoped to preserve the Union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106133054"
	 b:glossaryEntry="the older of two major political parties in the US"/>
<rdf:Description rdf:about="&a;106133186">
	<b:glossaryEntry>a former major political party in the US in the early 19th century; opposed the old Federalist party; favored a strict interpretation of the constitution in order to limit the powers of the federal government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106133468">
	<b:glossaryEntry>a former minor political party in the US in the early 20th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106133599">
	<b:glossaryEntry>a major political party in the US in the early 19th century; founded by Alexander Hamilton; favored a strong centralized government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106133837">
	<b:glossaryEntry>a former political party in the US; formed in 1848 to oppose the extension of slavery into the territories; merged with the Liberty Party in 1848</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106134044">
	<b:glossaryEntry>a former political party in the US; organized in 1874; opposed any reduction in the amount of paper money in circulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106134226">
	<b:glossaryEntry>a political party formed in Great Britain in 1900; characterized by the promotion of labor''s interests and the socialization of key industries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106134477">
	<b:glossaryEntry>a major political party in Great Britain in the 19th century; now the third largest; advocated reforms and improvement of the conditions of working people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106134691">
	<b:glossaryEntry>a former political party in the US; formed in 1839 to oppose the practice of slavery; merged with the Free Soil Party in 1848</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106134876">
	<b:glossaryEntry>a Trotskyist political organization in Great Britain set up in 1964 inside the Labour Party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106135031">
	<b:glossaryEntry>the National Socialist German Workers'' Party founded in Germany in 1919 and brought to power by Hitler in 1933</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106135198">
	<b:glossaryEntry>a former political party in the US; formed in 1891 to advocate currency expansion and state control of railroads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106135388">
	<b:glossaryEntry>a former political party in the US; founded by Theodore Roosevelt during the presidential campaign of 1912; its emblem was a picture of a bull moose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106135619">
	<b:glossaryEntry>a political party in the US; formed in 1869 to oppose the manufacture and sale of alcoholic beverages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106135784">
	<b:glossaryEntry>the younger of 2 major political parties in the US; GOP stands for Grand Old Party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106135954">
	<b:glossaryEntry>a political party in Germany and Britain (and elsewhere) founded in late 19th century; originally Marxist; now advocates the gradual transformation of capitalism into democratic socialism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106136211">
	<b:glossaryEntry>a political party in the US; formed in 1874 to advocate the peaceful introduction of socialism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106136373">
	<b:glossaryEntry>a political party in the US formed in 1900 to advocate socialism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106136499">
	<b:glossaryEntry>a former political party in the US; formed in 1948 by Southern Democrats opposed to the candidacy of Harry S Truman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106136705">
	<b:glossaryEntry>a former political party in the US; formed in 1834 in opposition to the Democratic Party; advocated a loose interpretation of the Constitution and high protective tariffs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106136932">
	<b:glossaryEntry>a political party organized in opposition to the major parties in a two-party system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106137074">
	<b:glossaryEntry>a group that controls the activities of a political party; "he was endorsed by the Democratic machine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106137250">
	<b:glossaryEntry>an intricate organization that accomplishes its goals efficiently; "the war machine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106137388">
	<b:glossaryEntry>a band of people associated temporarily in some activity; "they organized a party to search for food"; "the company of cooks walked into the kitchen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106137707"
	 b:glossaryEntry="a group of soldiers on fatigue duty"/>
<rdf:Description rdf:about="&a;106137802">
	<b:glossaryEntry>a part of a ship''s company organized for special duties ashore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106137924"
	 b:glossaryEntry="a party of people taking a role in legal proceedings"/>
<rdf:Description rdf:about="&a;106138069"
	 b:glossaryEntry="a party of rescuers"/>
<rdf:Description rdf:about="&a;106138147"
	 b:glossaryEntry="a party of people to search for someone"/>
<rdf:Description rdf:about="&a;106138245"
	 b:glossaryEntry="a party of people with stretchers to carry an injured person"/>
<rdf:Description rdf:about="&a;106138367"
	 b:glossaryEntry='a set of data arranged in rows and columns; "see table 1"'/>
<rdf:Description rdf:about="&a;106138620"
	 b:glossaryEntry="a table of statistical data"/>
<rdf:Description rdf:about="&a;106138747">
	<b:glossaryEntry>an actuarial table indicating life expectancy and probability of death as a function or age and sex and occupation etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106138927"
	 b:glossaryEntry="a tabular array of the days (usually for one year)"/>
<rdf:Description rdf:about="&a;106139032">
	<b:glossaryEntry>a tabular arrangement of the chemical elements according to atomic number as based on the periodic law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106139195"
	 b:glossaryEntry="a rectangular array of elements set out by rows and columns"/>
<rdf:Description rdf:about="&a;106139361"
	 b:glossaryEntry="a matrix with the same number of rows and columns"/>
<rdf:Description rdf:about="&a;106139578"
	 b:glossaryEntry="a square matrix with all off-diagonal elements equal to zero"/>
<rdf:Description rdf:about="&a;106139718">
	<b:glossaryEntry>a diagonal matrix in which all of the diagonal elements are equal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106139861">
	<b:glossaryEntry>a scalar matrix in which all of the diagonal elements are unity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106140000"
	 b:glossaryEntry="a square matrix used to solve simultaneous equations"/>
<rdf:Description rdf:about="&a;106140110">
	<b:glossaryEntry>a square matrix of n rows and columns; cells contain n different symbols so arranged that no symbol occurs more than once in any row or column</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106140311">
	<b:glossaryEntry>a square matrix of n rows and columns; the first n-squared integers are arranged in the cells of the matrix is such a way that the sum of any row or column or diagonal is the same</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106140549"
	 b:glossaryEntry="a square matrix whose determinant is not zero"/>
<rdf:Description rdf:about="&a;106140677"
	 b:glossaryEntry="a matrix whose elements are all real numbers"/>
<rdf:Description rdf:about="&a;106140779"
	 b:glossaryEntry="a square matrix whose determinant is zero"/>
<rdf:Description rdf:about="&a;106140900">
	<b:glossaryEntry>(astronomy) a hypothetical huge collection of comets orbiting the sun far beyond the orbit of Pluto; perturbations (as by other stars) can upset a comet''s orbit and may send it tumbling toward the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106141157"
	 b:glossaryEntry="a splendid assemblage (especially of famous people)"/>
<rdf:Description rdf:about="&a;106141261">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(astronomy) a collection of star systems; any of the billions of systems each having many stars and nebulae and dust; "`extragalactic nebula'' is a former name for `galaxy''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106141620">
	<b:glossaryEntry>a galaxy having a spiral structure; arms containing younger stars spiral out from old stars at the center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106141801"
	 b:glossaryEntry="the whole collection of existing things"/>
<rdf:Description rdf:about="&a;106141923"
	 b:glossaryEntry='a large military unit; "the French Foreign Legion"'/>
<rdf:Description rdf:about="&a;106142045"
	 b:glossaryEntry='association of ex-servicemen; "the American Legion"'/>
<rdf:Description rdf:about="&a;106142149"
	 b:glossaryEntry="a body of troops arranged in a line"/>
<rdf:Description rdf:about="&a;106142238"
	 b:glossaryEntry="a body of troops in close array"/>
<rdf:Description rdf:about="&a;106142323"
	 b:glossaryEntry="any closely ranked crowd of people"/>
<rdf:Description rdf:about="&a;106142411"
	 b:glossaryEntry='a set of twenty members; "four score and seven years ago"'/>
<rdf:Description rdf:about="&a;106142520"
	 b:glossaryEntry="a set with 3 times 20 members"/>
<rdf:Description rdf:about="&a;106142606">
	<b:glossaryEntry>a group of people (often temporary) having a common purpose; "they were a winning combination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106142758"
	 b:glossaryEntry="the men who man a ship or aircraft"/>
<rdf:Description rdf:about="&a;106142955"
	 b:glossaryEntry="the crew of an aircraft"/>
<rdf:Description rdf:about="&a;106143069"
	 b:glossaryEntry="the crew of a bomber"/>
<rdf:Description rdf:about="&a;106143183"
	 b:glossaryEntry="the crew of a merchant vessel"/>
<rdf:Description rdf:about="&a;106143274"
	 b:glossaryEntry="the team of men manning a racing shell"/>
<rdf:Description rdf:about="&a;106143363">
	<b:glossaryEntry>an informal body of friends; "he still hangs out with the same crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106143506">
	<b:glossaryEntry>soldiers who are specially trained and armed to lead an assault</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106143628"
	 b:glossaryEntry="a group of soldiers"/>
<rdf:Description rdf:about="&a;106143717"
	 b:glossaryEntry="a cavalry unit corresponding to an infantry company"/>
<rdf:Description rdf:about="&a;106143839"
	 b:glossaryEntry='an orderly crowd; "a troop of children"'/>
<rdf:Description rdf:about="&a;106143938"
	 b:glossaryEntry="a unit of girl or boy scouts"/>
<rdf:Description rdf:about="&a;106144046"
	 b:glossaryEntry="any cohesive unit such as a military company"/>
<rdf:Description rdf:about="&a;106144143"
	 b:glossaryEntry="the academic world"/>
<rdf:Description rdf:about="&a;106144264"
	 b:glossaryEntry="the world of literary hacks"/>
<rdf:Description rdf:about="&a;106144368">
	<b:glossaryEntry>a body of creative artists or writers or thinkers linked by a similar style or by similar teachers; "the Venetian school of painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106144572">
	<b:glossaryEntry>a school of 19th C German economists and legal philosophers who tried to explain modern economic systems in evolutionary or historical terms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106144776"
	 b:glossaryEntry="an institution dedicated to education"/>
<rdf:Description rdf:about="&a;106144973">
	<b:glossaryEntry>an educational institution for children too young for elementary school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106145154"
	 b:glossaryEntry='an educational institution; "the school was founded in 1900"'/>
<rdf:Description rdf:about="&a;106145755">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an educational institution''s faculty and students; "the school keeps parents informed"; "the whole school turned out for the game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106145938"
	 b:glossaryEntry="British school for children aged 7-11"/>
<rdf:Description rdf:about="&a;106146035"
	 b:glossaryEntry="British school for children aged 5-7"/>
<rdf:Description rdf:about="&a;106146131"
	 b:glossaryEntry="a school for special training"/>
<rdf:Description rdf:about="&a;106146304"
	 b:glossaryEntry="the body of faculty and students of a college"/>
<rdf:Description rdf:about="&a;106146495">
	<b:glossaryEntry>an institution of higher education created to educate and grant degrees; often a part of a university</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106146688"
	 b:glossaryEntry="a school that teaches nonresident students by mail"/>
<rdf:Description rdf:about="&a;106146806"
	 b:glossaryEntry="a special school where students are crammed"/>
<rdf:Description rdf:about="&a;106146903"
	 b:glossaryEntry="a school in which students learn to dance"/>
<rdf:Description rdf:about="&a;106147005"
	 b:glossaryEntry="a school where people are taught to drive automobiles"/>
<rdf:Description rdf:about="&a;106147119"
	 b:glossaryEntry="a secondary school (usually private)"/>
<rdf:Description rdf:about="&a;106147209"
	 b:glossaryEntry="an academy for training police officers"/>
<rdf:Description rdf:about="&a;106147309"
	 b:glossaryEntry="an academy for training military officers"/>
<rdf:Description rdf:about="&a;106147413"
	 b:glossaryEntry="an academy for training naval officers"/>
<rdf:Description rdf:about="&a;106147511"
	 b:glossaryEntry="an academy for train air force officers"/>
<rdf:Description rdf:about="&a;106147614">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a school established by Plato in ancient Athens; "Plato''s Academy continued for several hundred years after Plato died"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106147795">
	<b:glossaryEntry>an institution for the advancement of art or science or literature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106147971">
	<b:glossaryEntry>an honorary group of French writers and thinkers supported by the French government; "the French Academy sets standards for the use of the French language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106148187">
	<b:glossaryEntry>a school for teaching the clerical aspects of business and commerce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106148317">
	<b:glossaryEntry>a graduate school offering study leading to a Masters of Business Administration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106148459">
	<b:glossaryEntry>a graduate school offering study leading to degrees in dentistry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106148605"
	 b:glossaryEntry="a school for teaching students to fly airplanes"/>
<rdf:Description rdf:about="&a;106148712">
	<b:glossaryEntry>a college that offers only the first two years terminating in an associate degree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106148890">
	<b:glossaryEntry>a nonresidential junior college offering a curriculum fitted to the needs of the community</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106149044">
	<b:glossaryEntry>a school in a university offering study leading to degrees beyond the bachelor''s degree</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106149284"
	 b:glossaryEntry="a school for teaching foreign languages"/>
<rdf:Description rdf:about="&a;106149385"
	 b:glossaryEntry="a graduate school offering study leading to a law degree"/>
<rdf:Description rdf:about="&a;106149514"
	 b:glossaryEntry="a graduate school offering study leading to a medical degree"/>
<rdf:Description rdf:about="&a;106149656"
	 b:glossaryEntry="a school for the study of music"/>
<rdf:Description rdf:about="&a;106149764"
	 b:glossaryEntry="a school for training nurses"/>
<rdf:Description rdf:about="&a;106149873"
	 b:glossaryEntry="a private school run by a religious body"/>
<rdf:Description rdf:about="&a;106150029"
	 b:glossaryEntry="a school where horsemanship is taught and practiced"/>
<rdf:Description rdf:about="&a;106150140">
	<b:glossaryEntry>a school for students intermediate between elementary school and college; usually grades 9 to 12</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106150506">
	<b:glossaryEntry>a school where secretarial skills (typing and shorthand and filing etc) are taught</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106150653"
	 b:glossaryEntry="a private place of education for the young"/>
<rdf:Description rdf:about="&a;106150750">
	<b:glossaryEntry>a theological school for training ministers or priests or rabbis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106150869">
	<b:glossaryEntry>a school teaching mechanical and industrial arts and the applied sciences</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106151030">
	<b:glossaryEntry>a technical school offering instruction in many industrial arts and applied sciences</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106151217"
	 b:glossaryEntry="a secondary school teaching the skilled trades"/>
<rdf:Description rdf:about="&a;106151342">
	<b:glossaryEntry>(Brit) a school providing training for a special field or profession</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106151473">
	<b:glossaryEntry>a school providing practical vocational and technical training</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106151597"
	 b:glossaryEntry="the body of faculty and students of a university"/>
<rdf:Description rdf:about="&a;106151796">
	<b:glossaryEntry>a large and diverse institution of higher education created to educate for life and for a profession and to grant degrees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106151993">
	<b:glossaryEntry>a British abbreviation; usually Oxford and Cambridge Universities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106152112"
	 b:glossaryEntry="a school teaching veterinary medicine"/>
<rdf:Description rdf:about="&a;106152213">
	<b:glossaryEntry>the faculty and students of a school specializing in one of the fine arts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106152363">
	<b:glossaryEntry>the body of teachers and administrators at a school; "the dean addressed the letter to the entire staff of the university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106152585"
	 b:glossaryEntry="a particular civilization at a particular stage"/>
<rdf:Description rdf:about="&a;106152795"
	 b:glossaryEntry="the culture and organization of a tribe"/>
<rdf:Description rdf:about="&a;106152890">
	<b:glossaryEntry>a social group within a national culture that has distinctive patterns of behavior and beliefs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106153114"
	 b:glossaryEntry="suburbanites considered as a cultural class or subculture"/>
<rdf:Description rdf:about="&a;106153226">
	<b:glossaryEntry>young people (hippies) advocating universal love and peace; in US during 1960s and 70s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106153391">
	<b:glossaryEntry>the prehistoric civilization on the islands in the Aegean sea and the surrounding countries; "by 800 BC the entire Aegean had adopted this style of pottery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106153648"
	 b:glossaryEntry="the bronze-age culture of Crete 3000-1100 BC"/>
<rdf:Description rdf:about="&a;106153775">
	<b:glossaryEntry>the pre-Mycenaean civilization on the Cyclades islands in the S Aegean sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106153947"
	 b:glossaryEntry="the bronze-age culture of Mycenae 1400-1100 BC"/>
<rdf:Description rdf:about="&a;106154082"
	 b:glossaryEntry="the bronze-age culture of mainland Greece 2500-1100 BC"/>
<rdf:Description rdf:about="&a;106154223"
	 b:glossaryEntry="the subculture of users of psychedelic drugs"/>
<rdf:Description rdf:about="&a;106154325"
	 b:glossaryEntry="a group of warships organized as a tactical unit"/>
<rdf:Description rdf:about="&a;106154554"
	 b:glossaryEntry="a large fleet"/>
<rdf:Description rdf:about="&a;106154620">
	<b:glossaryEntry>a group of steamships operating together under the same ownership</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106154774">
	<b:glossaryEntry>group of motor vehicles operating together under the same ownership</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106154968">
	<b:glossaryEntry>a fleet of military vehicles controlled by a single agency and available for use as needed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106155115">
	<b:glossaryEntry>group of aircraft operating together under the same ownership</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106155266">
	<b:glossaryEntry>an organization of people (or countries) involved in a pact or treaty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106155571">
	<b:glossaryEntry>people (or countries) who are not aligned with other people (or countries) in a pact or treaty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106155757"
	 b:glossaryEntry="a leftist coalition organized against a common opponent"/>
<rdf:Description rdf:about="&a;106155872"
	 b:glossaryEntry="an international alliance involving many different countries"/>
<rdf:Description rdf:about="&a;106156188">
	<b:glossaryEntry>an alliance made up of states that had been Soviet Socialist Republics in the Soviet Union prior to its dissolution in Dec 1991</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106156630">
	<b:glossaryEntry>an organization of independent states to promote international peace and security</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106156929"
	 b:glossaryEntry="the supreme deliberative assembly of the United Nations"/>
<rdf:Description rdf:about="&a;106157066"
	 b:glossaryEntry="the administrative arm of the United Nations"/>
<rdf:Description rdf:about="&a;106157202">
	<b:glossaryEntry>a permanent council of the United Nations; responsible for preserving world peace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106157370">
	<b:glossaryEntry>a permanent council of the United Nations that commissions a country (or countries) to undertake the administration of a territory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106157590">
	<b:glossaryEntry>a permanent council of the United Nations; responsible for economic and social conditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106157781">
	<b:glossaryEntry>a commission of the Economic and Social Council of the United Nations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106158154">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with human rights</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106158334">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with drug traffic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106158516">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with the status of women in different societies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106158733">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with economic development of African nations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106158944">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with economic development of countries in Asia and the Far East</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106159189">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with economic development in Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106159391">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with economic development in Latin America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106159607">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with population control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106159788">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with social development</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106159977">
	<b:glossaryEntry>the commission of the Economic and Social Council of the United Nations that is concerned with statistical data from member nations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106160177">
	<b:glossaryEntry>a court established to settle disputes between members of the United Nations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106160363"
	 b:glossaryEntry="an agency of the United Nations"/>
<rdf:Description rdf:about="&a;106160745">
	<b:glossaryEntry>an agency of the United Nations responsible for programs to aid education and the health of children and mothers in developing countries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106161024">
	<b:glossaryEntry>the United Nations agency concerned with the international organization of food and agriculture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106161263">
	<b:glossaryEntry>a United Nations agency created by a multinational treaty to promote trade by the reduction of tariffs and import quotas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106161475"
	 b:glossaryEntry="the United Nations agency concerned with atomic energy"/>
<rdf:Description rdf:about="&a;106161617">
	<b:glossaryEntry>a United Nations agency created to assist developing nations by loans guaranteed by member governments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106161839"
	 b:glossaryEntry="the United Nations agency concerned with civil aviation"/>
<rdf:Description rdf:about="&a;106161989">
	<b:glossaryEntry>an agency of the United Nations affiliated with the World Bank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106162141">
	<b:glossaryEntry>a United Nations agency that invest directly in companies and guarantees loans to private investors; affiliated with the World Bank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106162358">
	<b:glossaryEntry>the United Nations agency concerned with the interests of labor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106162542">
	<b:glossaryEntry>the United Nations agency concerned with international maritime activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106162704">
	<b:glossaryEntry>a United Nations agency to promote trade by increasing the exchange stability of the major currencies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106162885">
	<b:glossaryEntry>an agency of the United Nations that promotes education and communication and the arts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106163090">
	<b:glossaryEntry>a United Nations agency to coordinate international health activities and to help governments improve health services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106163285">
	<b:glossaryEntry>the United Nations agency concerned with the international collection of meteorological data</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106163463">
	<b:glossaryEntry>the group of countries whose currencies are tied to the British pound sterling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106163641"
	 b:glossaryEntry="a union of political organizations"/>
<rdf:Description rdf:about="&a;106163798"
	 b:glossaryEntry="an organization formed by merging several groups or parties"/>
<rdf:Description rdf:about="&a;106163932">
	<b:glossaryEntry>the largest federation of labor unions in the United States; formed in 1955</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106164129">
	<b:glossaryEntry>a federation of tribes (especially native American tribes); "the Shawnee nation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106164280">
	<b:glossaryEntry>a North American Indian Confederacy organized by the Muskogee that dominated the SE US before being removed to Oklahoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106164520">
	<b:glossaryEntry>a political unit formed from previously independent people or organizations; "the Soviet Union"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106164721">
	<b:glossaryEntry>an association of states or organizations or individuals for common action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106164848">
	<b:glossaryEntry>an association of nations to promote free trade within the union and set common tariffs for for nations that are not members</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106165050">
	<b:glossaryEntry>a customs union comprising BElgium and NEtherlands and LUXembourg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106165226"
	 b:glossaryEntry="a friendly nation"/>
<rdf:Description rdf:about="&a;106165313">
	<b:glossaryEntry>a social class separated from others by distinctions of hereditary rank or profession or wealth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106165460">
	<b:glossaryEntry>(Hindu) a hereditary social class stratified according to ritual purity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106165655">
	<b:glossaryEntry>the highest of the four main Hindu castes: the priestly caste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106165799">
	<b:glossaryEntry>the second highest of the four main Hindu castes: the royal or warrior caste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106165950">
	<b:glossaryEntry>the third of the four main Hindu castes: the mercantile and professional caste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106166100"
	 b:glossaryEntry="the lowest of the four main Hindu castes: the worker caste"/>
<rdf:Description rdf:about="&a;106166238">
	<b:glossaryEntry>a formally arranged gathering; "next year the meeting will be in Chicago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106166581">
	<b:glossaryEntry>a prearranged meeting for consultation or or exchange of information or discussion (especially one with a formal agenda)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106166831">
	<b:glossaryEntry>a meeting of people to develop mutual understanding by openly expressing their feelings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106166980"
	 b:glossaryEntry="a meeting for administrative purposes"/>
<rdf:Description rdf:about="&a;106167097">
	<b:glossaryEntry>a meeting at which the management reports to the stockholders of a company</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106167238"
	 b:glossaryEntry="a small collection of people"/>
<rdf:Description rdf:about="&a;106167318">
	<b:glossaryEntry>a small informal social gathering; "there was an informal meeting in my livingroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106167560"
	 b:glossaryEntry='a meeting of people for consultation; "emergency council"'/>
<rdf:Description rdf:about="&a;106167708">
	<b:glossaryEntry>a body serving in an administrative capacity; "student council"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106167987">
	<b:glossaryEntry>a municipal body that can pass ordnances and appropriate funds etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106168113"
	 b:glossaryEntry="a council that shares the supreme executive power"/>
<rdf:Description rdf:about="&a;106168226">
	<b:glossaryEntry>an advisory council to a ruler (especially to the British crown)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106168368"
	 b:glossaryEntry="a Muslim council of state"/>
<rdf:Description rdf:about="&a;106168453">
	<b:glossaryEntry>(chiefly Brit) a council representing employer and employees of a plant or business to discuss working conditions etc; also: a committee representing the workers elected to negotiate with management about grievances and wages etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106168742"
	 b:glossaryEntry="government of a town by an assembly of the qualified voters"/>
<rdf:Description rdf:about="&a;106168860"
	 b:glossaryEntry="a meeting of the inhabitants of a town"/>
<rdf:Description rdf:about="&a;106168957"
	 b:glossaryEntry="a meeting of elected or appointed representatives"/>
<rdf:Description rdf:about="&a;106169061"
	 b:glossaryEntry="a national legislative assembly"/>
<rdf:Description rdf:about="&a;106169147"
	 b:glossaryEntry="a legislative assembly in certain countries (e.g., Japan)"/>
<rdf:Description rdf:about="&a;106169255">
	<b:glossaryEntry>a deliberative or legislative or administrative or judicial assembly; "the upper chamber is the senate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106169412">
	<b:glossaryEntry>an association of businessmen to protect and promote business interests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106169549">
	<b:glossaryEntry>a legislative assembly in certain countries (e.g., Great Britain)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106169745"
	 b:glossaryEntry="the lower house of the parliament of the Republic of Ireland"/>
<rdf:Description rdf:about="&a;106169890"
	 b:glossaryEntry="the Israeli unicameral parliament"/>
<rdf:Description rdf:about="&a;106169988"
	 b:glossaryEntry="the parliament of the Republic of Ireland"/>
<rdf:Description rdf:about="&a;106170124"
	 b:glossaryEntry="the upper house of the parliament of the Republic of Ireland"/>
<rdf:Description rdf:about="&a;106170273"
	 b:glossaryEntry="an elected governmental council in a Communist country"/>
<rdf:Description rdf:about="&a;106170380">
	<b:glossaryEntry>an Irish republican political movement founded in 1905 to promote independence from England and unification of Ireland; became the political branch of the Irish Republican Army</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106170631">
	<b:glossaryEntry>a radical political movement that advocates bringing industry and government under the control of labor unions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106170799"
	 b:glossaryEntry="a council convened to discuss ecclesiastical business"/>
<rdf:Description rdf:about="&a;106170904"
	 b:glossaryEntry="a council with representatives from different nations"/>
<rdf:Description rdf:about="&a;106171035">
	<b:glossaryEntry>a committee having supervisory powers; "the board has seven members"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106171355">
	<b:glossaryEntry>a board of officials that are not judicial but are appointed to hear appeals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106171525">
	<b:glossaryEntry>a board of officials elected to administer the public business of a New England town</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106171712">
	<b:glossaryEntry>a committee of university officers who have general supervision over the welfare and conduct of students</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106171879">
	<b:glossaryEntry>a governing board elected or appointed to direct the policies of an educational institution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106172034"
	 b:glossaryEntry="the 7-member board governing the Federal Reserve System"/>
<rdf:Description rdf:about="&a;106172157"
	 b:glossaryEntry="a board that manages the affairs of an institution"/>
<rdf:Description rdf:about="&a;106172324">
	<b:glossaryEntry>an administrative unit responsible for maintaining records and other secretarial duties; especially for international organizations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106172564"
	 b:glossaryEntry="a special group delegated to consider some matter"/>
<rdf:Description rdf:about="&a;106173026"
	 b:glossaryEntry="a commission delegated to supervise an election"/>
<rdf:Description rdf:about="&a;106173139">
	<b:glossaryEntry>a commission delegated to ensure opportunities for the expression of opposing views</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106173288">
	<b:glossaryEntry>a commission delegated to propose plans for future activities and developments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106173432">
	<b:glossaryEntry>a commission delegated to supervise the zoning of areas for residential or commercial use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106173585">
	<b:glossaryEntry>(British) a commission with jurisdiction over fisheries and navigation in a port or river</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106173732"
	 b:glossaryEntry="a self-constituted organization to promote something"/>
<rdf:Description rdf:about="&a;106173897">
	<b:glossaryEntry>a subset of committee members organized for a specific purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106174018">
	<b:glossaryEntry>a volunteer committee to maintain order where an efficient legal system does not exist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106174170"
	 b:glossaryEntry="a committee to welcome new residents to a community"/>
<rdf:Description rdf:about="&a;106174287"
	 b:glossaryEntry="a permanent committee"/>
<rdf:Description rdf:about="&a;106174391">
	<b:glossaryEntry>a permanent committee of the US House of Representatives that makes recommendations to the House on all bills that would raise revenue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106174596">
	<b:glossaryEntry>a committee to arrange the order of business for some larger (legislative) body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106174740"
	 b:glossaryEntry="a committee appointed to consider ethical issues"/>
<rdf:Description rdf:about="&a;106174866"
	 b:glossaryEntry="a committee appointed to consider financial issues"/>
<rdf:Description rdf:about="&a;106174980">
	<b:glossaryEntry>the chief executive and political committee of the Communist Party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106175102">
	<b:glossaryEntry>committee formed by a special-interest group to raise money for their favorite political candidates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106175280">
	<b:glossaryEntry>a permanent executive committee in socialist countries that has all the powers of some larger legislative body and that acts for it when it is not in session</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106175506"
	 b:glossaryEntry="a public meeting or assembly for open discussion"/>
<rdf:Description rdf:about="&a;106175606">
	<b:glossaryEntry>a meeting or conference for the public discussion of some topic especially one in which the participants form an audience and make presentations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106175806"
	 b:glossaryEntry="any meeting for an exchange of ideas"/>
<rdf:Description rdf:about="&a;106175896">
	<b:glossaryEntry>an academic meeting or seminar usually led by a different lecturer and on a different topic at each meeting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106176078">
	<b:glossaryEntry>a colloquium at which the results of (scientific) research are reported</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106176215"
	 b:glossaryEntry="a confidential or secret meeting"/>
<rdf:Description rdf:about="&a;106176302">
	<b:glossaryEntry>the magistrate or judge or judges sitting in court in judicial capacity to compose the court collectively</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106176478"
	 b:glossaryEntry="a group of officers who patrol the borders of a country"/>
<rdf:Description rdf:about="&a;106176612">
	<b:glossaryEntry>a group that goes through a region at regular intervals for the purpose of security</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106176785"
	 b:glossaryEntry="the family and retinue of a sovereign or prince"/>
<rdf:Description rdf:about="&a;106176884">
	<b:glossaryEntry>an assembly (including one or more judges) to conduct judicial business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106177465"
	 b:glossaryEntry="a court authorized to hear appeals"/>
<rdf:Description rdf:about="&a;106177614">
	<b:glossaryEntry>one of the twelve federal U.S. courts of appeals that cover a group of states known as a `circuit''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106177802">
	<b:glossaryEntry>(law) one of the twelve groups of states in the U.S. that is covered by a particular circuit court of appeals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106177965">
	<b:glossaryEntry>the county courts of England (replaced in 1971 by crown courts)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106178133"
	 b:glossaryEntry="a court with jurisdiction in equity"/>
<rdf:Description rdf:about="&a;106178243"
	 b:glossaryEntry="a church tribunal or governing body"/>
<rdf:Description rdf:about="&a;106178335"
	 b:glossaryEntry="a court having jurisdiction over criminal cases"/>
<rdf:Description rdf:about="&a;106178461"
	 b:glossaryEntry="a military court to try serious breaches of martial law"/>
<rdf:Description rdf:about="&a;106178612">
	<b:glossaryEntry>a military court convened to hear urgent charges of offences committed in action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106178761">
	<b:glossaryEntry>a court-martial to try soldiers for offences less serious that than those comitted in action; consists of at least three officers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106178958">
	<b:glossaryEntry>a court having jurisdiction over the termination of marriage contracts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106179088"
	 b:glossaryEntry="a court establish by the authority of a federal government"/>
<rdf:Description rdf:about="&a;106179243"
	 b:glossaryEntry="any court whose decisions can be appealed to a higher court"/>
<rdf:Description rdf:about="&a;106179377">
	<b:glossaryEntry>a court having jurisdiction over dependent and delinquent children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106179504"
	 b:glossaryEntry="an irregular unauthorized court"/>
<rdf:Description rdf:about="&a;106179596">
	<b:glossaryEntry>a court of commissioned officers for the discipline and punishment of military personnel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106179781"
	 b:glossaryEntry="a mock court where law students argue hypothetical cases"/>
<rdf:Description rdf:about="&a;106179894"
	 b:glossaryEntry="a criminal court (in large cities) that sits at night"/>
<rdf:Description rdf:about="&a;106180005">
	<b:glossaryEntry>a military court for trying people charged with minor offenses in an occupied area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106180147">
	<b:glossaryEntry>a court that has power to prosecute for minor offenses and to bind over for trial in a superior court anyone accused serious offenses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106180339">
	<b:glossaryEntry>a court having jurisdiction over the probate of will and the administration of estates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106180485">
	<b:glossaryEntry>a local court with criminal jurisdiction and sometimes administrative functions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106180627">
	<b:glossaryEntry>(Roman Catholic Church) the supreme ecclesiastical tribunal for cases appealed to the Holy See from diocesan courts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106180793">
	<b:glossaryEntry>a former English court that became notorious for its arbitrary methods and severe punishments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106180945"
	 b:glossaryEntry="any court that has jurisdiction above an inferior court"/>
<rdf:Description rdf:about="&a;106181061">
	<b:glossaryEntry>the highest federal court in the US; has final appellate jurisdiction and has jurisdiction over all other courts in the nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106181266"
	 b:glossaryEntry="the highest court in most states of the US"/>
<rdf:Description rdf:about="&a;106181403"
	 b:glossaryEntry="a court that has power to prosecute for traffic offences"/>
<rdf:Description rdf:about="&a;106181519"
	 b:glossaryEntry="the first court before which the facts of a case are decided"/>
<rdf:Description rdf:about="&a;106181637"
	 b:glossaryEntry="a collection of works that an artist or company can perform"/>
<rdf:Description rdf:about="&a;106181753">
	<b:glossaryEntry>the entire range of skills or aptitudes or devices used in a particular field or occupation: "the repertory of the supposed feats of mesmerism"; "has a large repertory of dialects and characters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106182017">
	<b:glossaryEntry>an administrative unit of government; "the Central Intelligence Agency"; "the Census Bureau"; "Office of Management and Budget"; "Tennessee Valley Authority"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106182763">
	<b:glossaryEntry>a unit responsible for gathering and interpreting intelligence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106182884">
	<b:glossaryEntry>a government agency or instrument devoted to the performance of some specific function; "The Census Bureau is an organ of the Commerce Department"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106183082"
	 b:glossaryEntry="the department in charge of the navy (as in Great Britain)"/>
<rdf:Description rdf:about="&a;106183196">
	<b:glossaryEntry>the government bureau that keeps a record of patents and grants new ones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106183328">
	<b:glossaryEntry>a government monetary authority that issues currency and regulates the supply of credit and holds the reserves of other banks and sells new issues of securities for the government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106183656">
	<b:glossaryEntry>the central bank of the US; incorporates 12 Federal Reserve branch banks and all national banks and stated charted commercial banks and some trust companies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106183962">
	<b:glossaryEntry>one of 12 regional banks that monitor and act as depositories for banks in their region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106184150"
	 b:glossaryEntry="the central bank of England"/>
<rdf:Description rdf:about="&a;106184239"
	 b:glossaryEntry="the central bank of Germany"/>
<rdf:Description rdf:about="&a;106184323"
	 b:glossaryEntry="the central bank of Japan"/>
<rdf:Description rdf:about="&a;106184408">
	<b:glossaryEntry>professional or clerical workers in an office; "the whole office was late the morning of the blizzard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106184578">
	<b:glossaryEntry>a group of associated research workers in a university or library or laboratory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106184718"
	 b:glossaryEntry="those in a business who are responsible for sales"/>
<rdf:Description rdf:about="&a;106184825">
	<b:glossaryEntry>those in an organization responsible for preventing spying or theft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106184953">
	<b:glossaryEntry>those in a business responsible for maintaining the physical plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106185099"
	 b:glossaryEntry="a government agency that conducts intelligence operations"/>
<rdf:Description rdf:about="&a;106185235">
	<b:glossaryEntry>a public agency given responsibility for the renovation of blighted urban areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106185384">
	<b:glossaryEntry>a government agency that regulates businesses in the public interest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106185539">
	<b:glossaryEntry>a federal agency that administers compulsory military service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106185691">
	<b:glossaryEntry>agency responsible for gathering and interpreting meteorological data for weather study and forecasts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106185853">
	<b:glossaryEntry>an agency that designs advertisement to call public attention to its clients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106186006">
	<b:glossaryEntry>a private firm that maintains consumer credit data files and provides credit information to authorized users for a fee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106186184"
	 b:glossaryEntry="an agency that makes inquiries for its clients"/>
<rdf:Description rdf:about="&a;106186293">
	<b:glossaryEntry>an agency that finds people to fill particular jobs or finds jobs for unemployed people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106186444"
	 b:glossaryEntry="an office that finds suitable employment for applicants"/>
<rdf:Description rdf:about="&a;106186599">
	<b:glossaryEntry>a union-operated placement office where jobs are allotted to applicants according to seniority or rotation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106186763">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an organization that provides businesses with credit ratings of other firms; "Dun & Bradstreet is the largest mercantile agency in the United States"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106186996">
	<b:glossaryEntry>an agency to collects news reports for newspapers and distributes it electronically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106187167">
	<b:glossaryEntry>a business that makes its facilities available to others for a fee; achieves economy of scale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106187353"
	 b:glossaryEntry="an agency that arranges personal travel"/>
<rdf:Description rdf:about="&a;106187452">
	<b:glossaryEntry>the executive and legislative and judicial branches of the federal government of the US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106187708">
	<b:glossaryEntry>the branch of the United States government that is responsible for carrying out the laws</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106187954">
	<b:glossaryEntry>the branch of the United States government that has the power of legislating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106188133">
	<b:glossaryEntry>the branch of the United States government responsible for the administration of justice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106188340"
	 b:glossaryEntry="the federal government of the United States"/>
<rdf:Description rdf:about="&a;106188450">
	<b:glossaryEntry>government workers; usually hired on the basis of competitive examinations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106188622"
	 b:glossaryEntry="the body of diplomatic personnel"/>
<rdf:Description rdf:about="&a;106188759"
	 b:glossaryEntry="people elected or appointed to administer a government"/>
<rdf:Description rdf:about="&a;106188949">
	<b:glossaryEntry>a gathering of members of an organization large enough to transact business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106189096"
	 b:glossaryEntry="a large gathering of people intended to arouse enthusiasm"/>
<rdf:Description rdf:about="&a;106189256"
	 b:glossaryEntry="a rally (especially of students) before a game"/>
<rdf:Description rdf:about="&a;106189358">
	<b:glossaryEntry>a small unit serving as the nucleus of a larger political movement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106189502">
	<b:glossaryEntry>a subversive group that supports the enemy and engages in espionage or sabotage; an enemy in your midst</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106189698"
	 b:glossaryEntry="a unit with political responsibilities"/>
<rdf:Description rdf:about="&a;106189942">
	<b:glossaryEntry>an association of neighboring states or tribes in ancient Greece; established originally to defend a common religious center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106190124"
	 b:glossaryEntry="a political unit with extreme and fanatical views"/>
<rdf:Description rdf:about="&a;106190234"
	 b:glossaryEntry="a political unit organized to promote revolution"/>
<rdf:Description rdf:about="&a;106190366">
	<b:glossaryEntry>a secret group organized to overthrow a government or occupation force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106190525">
	<b:glossaryEntry>the French underground that fought against the German occupation in World War II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106190677"
	 b:glossaryEntry="a political system governed by a single individual"/>
<rdf:Description rdf:about="&a;106190866">
	<b:glossaryEntry>a constitutional system of government (usually with a written constitution)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106191005">
	<b:glossaryEntry>a political system governed by the people or their representatives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106191189"
	 b:glossaryEntry="the domination of one state over its allies"/>
<rdf:Description rdf:about="&a;106191287"
	 b:glossaryEntry="a political system governed by a few people"/>
<rdf:Description rdf:about="&a;106191386"
	 b:glossaryEntry="a political system governed by the wealthy people"/>
<rdf:Description rdf:about="&a;106191492">
	<b:glossaryEntry>a form of government in which scientists and technical experts are in control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106191627">
	<b:glossaryEntry>a political unit governed by a deity (or by officials thought to be divinely guided)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106191785"
	 b:glossaryEntry="a democracy having a parliament"/>
<rdf:Description rdf:about="&a;106191886">
	<b:glossaryEntry>an autocracy governed by a monarch who usually inherits the authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106192064"
	 b:glossaryEntry="an autocracy governed by two rulers"/>
<rdf:Description rdf:about="&a;106192163"
	 b:glossaryEntry="a monarchy having a parliament"/>
<rdf:Description rdf:about="&a;106192262"
	 b:glossaryEntry="an economic system based on private ownership of capital"/>
<rdf:Description rdf:about="&a;106192414">
	<b:glossaryEntry>an economic system built on large industries rather than on agriculture or craftsmanship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106192562">
	<b:glossaryEntry>an economy that relies chiefly on market forces to allocate goods and resources and to determine prices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106192804"
	 b:glossaryEntry="an economy that is not a market economy"/>
<rdf:Description rdf:about="&a;106192944">
	<b:glossaryEntry>an economic system that is primarily capitalistic but there is some degree of government ownership of the means of production</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106193132">
	<b:glossaryEntry>an economic system in which the government owns most means of production but some degree of private capitalism is allowed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106193315"
	 b:glossaryEntry="a form of socialism that abolishes private ownership"/>
<rdf:Description rdf:about="&a;106193477"
	 b:glossaryEntry="any of several international socialist organizations"/>
<rdf:Description rdf:about="&a;106193608"
	 b:glossaryEntry="an economic system based on state ownership of capital"/>
<rdf:Description rdf:about="&a;106193810"
	 b:glossaryEntry="a form of socialism featuring racism and expansionism"/>
<rdf:Description rdf:about="&a;106193947"
	 b:glossaryEntry="the system of production and distribution and consumption"/>
<rdf:Description rdf:about="&a;106194185">
	<b:glossaryEntry>a non-market economy in which government intervention is important in allocating goods and resources and determining prices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106194424">
	<b:glossaryEntry>an economic system (Europe in 18th C) to increase a nation''s wealth by government regulation of all of the nation''s commercial interests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106194639"
	 b:glossaryEntry="the managed economy of a communist state"/>
<rdf:Description rdf:about="&a;106194743"
	 b:glossaryEntry="the members of a social organization who are in power"/>
<rdf:Description rdf:about="&a;106195081"
	 b:glossaryEntry="a form of communism based on the writings of Marx and Lenin"/>
<rdf:Description rdf:about="&a;106195312"
	 b:glossaryEntry="a moderate evolutionary form of Marxism"/>
<rdf:Description rdf:about="&a;106195409"
	 b:glossaryEntry="any dangerous departure from the teachings of Marx"/>
<rdf:Description rdf:about="&a;106195517"
	 b:glossaryEntry="a form of communism developed in Cuba by Fidel Castro"/>
<rdf:Description rdf:about="&a;106195626"
	 b:glossaryEntry="a form of communism developed in China by Mao Zedong"/>
<rdf:Description rdf:about="&a;106195731">
	<b:glossaryEntry>a system formed by the interaction of a community of organisms with their physical environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106195881">
	<b:glossaryEntry>group of genetically related organisms constituting a single step in the line of descent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106196062"
	 b:glossaryEntry="all future generations"/>
<rdf:Description rdf:about="&a;106196140">
	<b:glossaryEntry>all of the offspring of a given progenitor; "we must secure the benefits of freedom for ourselves and our posterity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106196326">
	<b:glossaryEntry>all the people living at the same time or of approximately the same age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106196517">
	<b:glossaryEntry>a US generation of the 1950s; rejected possessions or regular work or traditional dress; for communal living and psychedelic drugs and anarchism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106196742">
	<b:glossaryEntry>the larger than expected generation in US born shortly after World War II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106196890"
	 b:glossaryEntry="contemporaries of the same status"/>
<rdf:Description rdf:about="&a;106196999"
	 b:glossaryEntry="one of two basic subdivisions of a tribe"/>
<rdf:Description rdf:about="&a;106197111"
	 b:glossaryEntry="a social division of (usually preliterate) people"/>
<rdf:Description rdf:about="&a;106197256">
	<b:glossaryEntry>a clan identified by their kinship to a common totemic object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106197369">
	<b:glossaryEntry>a group of people attractively arranged (as if in a painting)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106197501">
	<b:glossaryEntry>a sequence of numbers or letters that opens a combination lock; "he forgot the combination to the safe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106197662"
	 b:glossaryEntry="a tribe of ancient Athenians"/>
<rdf:Description rdf:about="&a;106197742"
	 b:glossaryEntry="a closed political meeting"/>
<rdf:Description rdf:about="&a;106197821"
	 b:glossaryEntry="a meeting of heads of governments"/>
<rdf:Description rdf:about="&a;106197924">
	<b:glossaryEntry>a body of people who settle far from home but maintain ties with their homeland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106198124"
	 b:glossaryEntry="a settlement on the frontier of civilization"/>
<rdf:Description rdf:about="&a;106198244"
	 b:glossaryEntry="a colony given to a proprietor to govern (in 17th century)"/>
<rdf:Description rdf:about="&a;106198367">
	<b:glossaryEntry>a body of people or families living together and sharing everything</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106198488"
	 b:glossaryEntry="a group of people who try actively to influence legislation"/>
<rdf:Description rdf:about="&a;106198630">
	<b:glossaryEntry>the organization of people at different ranks in an administrative body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106198810">
	<b:glossaryEntry>a series of ordered groupings of people or things within a system: "put honesty first in her hierarchy of values"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106199034">
	<b:glossaryEntry>a classification of organisms into groups based on similarities of structure or origin etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106199179">
	<b:glossaryEntry>an arrangement of data consisting of sets and subsets such that every subset of a set is of lower rank than the set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106199355"
	 b:glossaryEntry="the organization of classes within a society"/>
<rdf:Description rdf:about="&a;106199498">
	<b:glossaryEntry>a social structure in which classes are determined by heredity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106199619">
	<b:glossaryEntry>the people in a society considered as a system organized by a characteristic pattern of relationships; "the social organization of England and America is very different"; "sociologists have studied the changing structure of the family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106200113"
	 b:glossaryEntry="segregation by race"/>
<rdf:Description rdf:about="&a;106200209">
	<b:glossaryEntry>segregation (especially in schools) that happens in fact although not required by law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106200361"
	 b:glossaryEntry="segregation that is imposed by law"/>
<rdf:Description rdf:about="&a;106200461"
	 b:glossaryEntry="the Hindu or Moslem system of keeping women secluded"/>
<rdf:Description rdf:about="&a;106200584">
	<b:glossaryEntry>a social system that provides separate facilities for minority groups</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106200783">
	<b:glossaryEntry>a group of persons chosen to govern the affairs of a corporation or other large institution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106200990">
	<b:glossaryEntry>a board of directors a portion of whose members are elected each year instead of all members being elected annually</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106201180"
	 b:glossaryEntry="those in charge of running a business"/>
<rdf:Description rdf:about="&a;106201293">
	<b:glossaryEntry>the body of people who lead a group; "the national leadership adopted his plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106201475"
	 b:glossaryEntry="a board appointed to advise the chief administrator"/>
<rdf:Description rdf:about="&a;106201641">
	<b:glossaryEntry>persons appointed by a head of state to head executive departments of government and act as official advisers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106201840"
	 b:glossaryEntry="the senior ministers of the British government"/>
<rdf:Description rdf:about="&a;106202100">
	<b:glossaryEntry>a board to advise the President; members are the secretaries of executive departments; the US constitution does not provide for the Cabinet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106202586"
	 b:glossaryEntry="a board to select personnel for involuntary military service"/>
<rdf:Description rdf:about="&a;106202704">
	<b:glossaryEntry>a company (usually unincorporated) which has the capital of its members pooled in a common fund; transferable shares represent ownership interest; shareholders are legally liable for all debts of the company</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106202977">
	<b:glossaryEntry>a corporation owned by a few people; shares have no public market</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106203196">
	<b:glossaryEntry>a corporation that is entirely owned by the members of a single family</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106203328">
	<b:glossaryEntry>stock is publicly traded but most is held by a few shareholders who have no plans to sell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106203488">
	<b:glossaryEntry>a company that is incorporated but has no assets or operations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106203629">
	<b:glossaryEntry>a federally sponsored corporation that insures accounts in national banks and other qualified institutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106203826">
	<b:glossaryEntry>a corporation authorized by Congress to provide a secondary market for residential mortgages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106204025"
	 b:glossaryEntry="a federally chartered corporation that purchases mortgages"/>
<rdf:Description rdf:about="&a;106204187"
	 b:glossaryEntry="a secret unauthorized meeting for religious worship"/>
<rdf:Description rdf:about="&a;106204296">
	<b:glossaryEntry>a meeting arranged in advance; "she asked how to avoid kissing at the end of a date"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106204513">
	<b:glossaryEntry>a meeting arranged by the visitor; "he scheduled a visit to the dentist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106204637"
	 b:glossaryEntry="a date; usually with a member of the opposite sex"/>
<rdf:Description rdf:about="&a;106204751">
	<b:glossaryEntry>a meeting for lunch; usually to conduct business while eating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106204891"
	 b:glossaryEntry='a date with a stranger; "she never goes on blind dates"'/>
<rdf:Description rdf:about="&a;106205003"
	 b:glossaryEntry="an evangelistic meeting"/>
<rdf:Description rdf:about="&a;106205081"
	 b:glossaryEntry="one or more large merchant ships"/>
<rdf:Description rdf:about="&a;106205166">
	<b:glossaryEntry>the class occupying the highest position in the social hierarchy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106205356">
	<b:glossaryEntry>a group or class of persons enjoying superior intellectual or social or economic status</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106205603">
	<b:glossaryEntry>an exclusive group of people: "one of the elect who have power inside the government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106205749">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the best people or things in a group; "the cream of England''s young men were killed in the Great War"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106205909"
	 b:glossaryEntry="the most powerful members of a society"/>
<rdf:Description rdf:about="&a;106206032"
	 b:glossaryEntry="an educated and intellectual elite"/>
<rdf:Description rdf:about="&a;106206155"
	 b:glossaryEntry="the literary intelligentsia"/>
<rdf:Description rdf:about="&a;106206237"
	 b:glossaryEntry="the gentry who own land (considered as a class)"/>
<rdf:Description rdf:about="&a;106206358"
	 b:glossaryEntry="the class of people exerting power or authority"/>
<rdf:Description rdf:about="&a;106206464"
	 b:glossaryEntry="the fashionable elite"/>
<rdf:Description rdf:about="&a;106206608">
	<b:glossaryEntry>a small elite group; "it was designed for the discriminating few"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106206723"
	 b:glossaryEntry="a privileged class holding hereditary titles"/>
<rdf:Description rdf:about="&a;106206945"
	 b:glossaryEntry="members of the nobility (especially of the French nobility)"/>
<rdf:Description rdf:about="&a;106207059"
	 b:glossaryEntry="the peers of a kingdom considered as a group"/>
<rdf:Description rdf:about="&a;106207186">
	<b:glossaryEntry>the third estate of the realm: the nobility (especially British nobility) of the rank of duke or marquess or earl or viscount or baron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106207397"
	 b:glossaryEntry="aristocrats holding the rank of knight"/>
<rdf:Description rdf:about="&a;106207492"
	 b:glossaryEntry="feudal Japanese military aristocracy"/>
<rdf:Description rdf:about="&a;106207601"
	 b:glossaryEntry="an army unit that uses big guns"/>
<rdf:Description rdf:about="&a;106207723"
	 b:glossaryEntry="musketeers and their muskets collectively"/>
<rdf:Description rdf:about="&a;106207838">
	<b:glossaryEntry>group of guns or missile launchers operated together at one place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106207957"
	 b:glossaryEntry="a highly mobile army unit"/>
<rdf:Description rdf:about="&a;106208128"
	 b:glossaryEntry="an army unit mounted on horseback"/>
<rdf:Description rdf:about="&a;106208221">
	<b:glossaryEntry>an armored unit of a modern army equipped with motor vehicles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106208347">
	<b:glossaryEntry>an army unit consisting of soldiers who fight on foot; "there came ten thousand horsemen and as many fully-armed foot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106208545"
	 b:glossaryEntry="infantry trained and equipped to parachute"/>
<rdf:Description rdf:about="&a;106208663">
	<b:glossaryEntry>civilians trained as soldiers but not part of the regular army</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106208827"
	 b:glossaryEntry="a territorial military unit"/>
<rdf:Description rdf:about="&a;106208970">
	<b:glossaryEntry>US military reserves recruited by the states and equipped by the federal government; subject to call by either</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106209194">
	<b:glossaryEntry>British unit of nonprofessional soldiers organized for defense of GB</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106209363"
	 b:glossaryEntry="a permanent army of paid soldiers"/>
<rdf:Description rdf:about="&a;106209456"
	 b:glossaryEntry="the northern army during the American Civil War"/>
<rdf:Description rdf:about="&a;106209578"
	 b:glossaryEntry="the southern army during the American Civil War"/>
<rdf:Description rdf:about="&a;106209706"
	 b:glossaryEntry="the army of the United States of America"/>
<rdf:Description rdf:about="&a;106209853"
	 b:glossaryEntry="soldiers collectively"/>
<rdf:Description rdf:about="&a;106210014">
	<b:glossaryEntry>troops trained to fight on horseback: "500 horse led the attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106210175"
	 b:glossaryEntry="the troops who maintain and guard a fortified place"/>
<rdf:Description rdf:about="&a;106210281">
	<b:glossaryEntry>the ordinary members of an organization (such as the soldiers excluding the officers of an army); "the strike was supported by the union rank and file"; "he rose from the ranks to become a colonel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106210545"
	 b:glossaryEntry="an assembly of witches; usually 13 witches"/>
<rdf:Description rdf:about="&a;106210658">
	<b:glossaryEntry>a midnight meeting of witches to practice witchcraft and sorcery; in the Middle Ages it was supposed to be a demonic orgy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106210851">
	<b:glossaryEntry>a collection containing a variety of sorts of things; "a great assortment of cars was on display"; "he had a variety of disorders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106211160">
	<b:glossaryEntry>a variety of different things or activities; "he answered a range of questions"; "he was impressed by the range and diversity of the collection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106211356">
	<b:glossaryEntry>an assortment of things from which a choice can be made; "the store carried a large selection of shoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106211515"
	 b:glossaryEntry="a motley assortment of things"/>
<rdf:Description rdf:about="&a;106211704"
	 b:glossaryEntry="the offspring at one birth of a multiparous mammal"/>
<rdf:Description rdf:about="&a;106211807"
	 b:glossaryEntry="a collection of things or persons to be handled together"/>
<rdf:Description rdf:about="&a;106211942">
	<b:glossaryEntry>(slang) a batch of things that go together; "he bought the whole schmeer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106212088"
	 b:glossaryEntry="all the loaves of bread baked at the same time"/>
<rdf:Description rdf:about="&a;106212186"
	 b:glossaryEntry="a number of birds hatched at the same time"/>
<rdf:Description rdf:about="&a;106212281">
	<b:glossaryEntry>the body of members of an organization or group; "they polled their membership"; "they found dissension in their own ranks"; "he joined the ranks of the unemployed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106212528">
	<b:glossaryEntry>an administrative division of some larger or more complex organization; "a branch of Congress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106212767"
	 b:glossaryEntry='customers collectively; "they have an upper class clientele"'/>
<rdf:Description rdf:about="&a;106212906"
	 b:glossaryEntry="people who constitute the main body of any group"/>
<rdf:Description rdf:about="&a;106213014"
	 b:glossaryEntry="disparaging terms for the common people"/>
<rdf:Description rdf:about="&a;106213165">
	<b:glossaryEntry>people who are highly experienced or who have inside information; "the smart money said Truman would lose the election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106213342"
	 b:glossaryEntry="worthless people"/>
<rdf:Description rdf:about="&a;106213417"
	 b:glossaryEntry="a group gathered in response to a summons"/>
<rdf:Description rdf:about="&a;106213516"
	 b:glossaryEntry="your alma mater is a school you graduated from"/>
<rdf:Description rdf:about="&a;106213619"
	 b:glossaryEntry="a group of representatives or delegates"/>
<rdf:Description rdf:about="&a;106213780"
	 b:glossaryEntry="a mission serving diplomatic ends"/>
<rdf:Description rdf:about="&a;106213915"
	 b:glossaryEntry="a permanent diplomatic mission headed by a minister"/>
<rdf:Description rdf:about="&a;106214058">
	<b:glossaryEntry>an organization of missionaries in a foreign land sent to carry on religious work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106214250"
	 b:glossaryEntry="newspaper writers and photographers"/>
<rdf:Description rdf:about="&a;106214371">
	<b:glossaryEntry>a group of journalists representing different publications who all cover the same topics; "the White House press corps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106214548"
	 b:glossaryEntry="a body of people doing the same kind of work"/>
<rdf:Description rdf:about="&a;106214699"
	 b:glossaryEntry="a body of people united in opposing something"/>
<rdf:Description rdf:about="&a;106214801">
	<b:glossaryEntry>an amphibious military unit trained for raids into enemy territory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106214922">
	<b:glossaryEntry>a temporary military unit; "the peace-keeping force includes one British contingent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106215072">
	<b:glossaryEntry>military officers assigned to assist a senior officer in planning military policy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106215213">
	<b:glossaryEntry>a military unit consisting of a commander and the headquarters staff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106215359"
	 b:glossaryEntry="military staff stationed at headquarters"/>
<rdf:Description rdf:about="&a;106215483">
	<b:glossaryEntry>the highest leaders in an organization (e.g. the commander-in-chief and senior officers of the military)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106215669"
	 b:glossaryEntry="a temporary police force"/>
<rdf:Description rdf:about="&a;106215782">
	<b:glossaryEntry>a secret society of white Southerners to resist Black emancipation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106215939"
	 b:glossaryEntry="a monarchy with a king or queen as head of state"/>
<rdf:Description rdf:about="&a;106216041"
	 b:glossaryEntry="a monarchy with an emperor as head of state"/>
<rdf:Description rdf:about="&a;106216137"
	 b:glossaryEntry="a collection of pictures of criminals"/>
<rdf:Description rdf:about="&a;106216236"
	 b:glossaryEntry="a coterie of undesirable people"/>
<rdf:Description rdf:about="&a;106216338"
	 b:glossaryEntry="an institution supported by an endowment"/>
<rdf:Description rdf:about="&a;106216453">
	<b:glossaryEntry>a foundation created to promote the public good (not for assistance to any particular individuals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106216659">
	<b:glossaryEntry>a foundation that provides funds for science or art or education or religion or relief from disease etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106216834">
	<b:glossaryEntry>a charity that does not receive a major part of its support from the public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106216974">
	<b:glossaryEntry>a charity that is deemed to receive the major part of its support from the public (rather than from a small group of individuals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106217164">
	<b:glossaryEntry>an association organized to promote art or science or education</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106217283">
	<b:glossaryEntry>a collection of things (goods or works of art etc.) for public display</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106217484"
	 b:glossaryEntry="an exhibition of art objects (paintings or statues)"/>
<rdf:Description rdf:about="&a;106217614">
	<b:glossaryEntry>an exhibition of a representative selection of an artist''s life work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106217742">
	<b:glossaryEntry>an exhibition of pictures or objects viewed through a small hole or magnifying glass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106217894">
	<b:glossaryEntry>a competitive exhibition of farm products; "she won a blue ribbon for her baking at the county fair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106218045">
	<b:glossaryEntry>a gathering of producers to promote business: "world fair"; "trade fair"; "book fair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106218181">
	<b:glossaryEntry>one of two or more contesting groups (in games or war or politics); "the Confederate side was prepared to attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106218345">
	<b:glossaryEntry>a group of people working together temporarily until some goal is achieved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106218497">
	<b:glossaryEntry>an organized group of people undertaking a journey for a particular purpose; "an expedition was sent to explore Mars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106218671">
	<b:glossaryEntry>a public secondary school usually including grades 9 through 12; "he goes to the neighborhood highschool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106218889"
	 b:glossaryEntry="a secondary school usually including 7th and 8th grades"/>
<rdf:Description rdf:about="&a;106219023"
	 b:glossaryEntry="a private secondary school"/>
<rdf:Description rdf:about="&a;106219146">
	<b:glossaryEntry>a school that is part of a cathedral or monastery where boys with singing ability can receive a general education</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106219336">
	<b:glossaryEntry>a free school supported by taxes and controlled by a school board</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106219461">
	<b:glossaryEntry>(British) private independent secondary school supported by endowment and tuition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106219602">
	<b:glossaryEntry>a school established and controlled privately and supported by endowment and tuition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106219819"
	 b:glossaryEntry="a parochial school maintained by the Catholic Church"/>
<rdf:Description rdf:about="&a;106219933"
	 b:glossaryEntry="a school where students are taught to dance"/>
<rdf:Description rdf:about="&a;106220035"
	 b:glossaryEntry="a private school taking day students only"/>
<rdf:Description rdf:about="&a;106220151">
	<b:glossaryEntry>a private school where students are lodged and fed as well as taught</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106220299"
	 b:glossaryEntry="a school giving instruction during the daytime"/>
<rdf:Description rdf:about="&a;106220420">
	<b:glossaryEntry>a school that holds classes in the evenings for students who cannot attend during the day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106220586">
	<b:glossaryEntry>a preschool for children age 4 to 6 to prepare them for primary school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106220715"
	 b:glossaryEntry="a small preschool for small children"/>
<rdf:Description rdf:about="&a;106220812"
	 b:glossaryEntry="a small informal nursery group meeting for half-day sessions"/>
<rdf:Description rdf:about="&a;106220942"
	 b:glossaryEntry="school meeting on Sundays for religious instruction"/>
<rdf:Description rdf:about="&a;106221070"
	 b:glossaryEntry="a class in a Sunday school"/>
<rdf:Description rdf:about="&a;106221162"
	 b:glossaryEntry="a two-year school for training elementary teachers"/>
<rdf:Description rdf:about="&a;106221291"
	 b:glossaryEntry="a school for young children; usually the first 6 or 8 grades"/>
<rdf:Description rdf:about="&a;106221500">
	<b:glossaryEntry>a secondary_school emphasizing Latin and Greek in preparation for college</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106221634">
	<b:glossaryEntry>a former British secondary school emphasizing practical rather than academic education</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106221790">
	<b:glossaryEntry>a large British or Canadian secondary school for children of all abilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106221950"
	 b:glossaryEntry="a board in charge of local public schools"/>
<rdf:Description rdf:about="&a;106222071">
	<b:glossaryEntry>a board of officials who divide an area into zones subject to different restrictions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106222214"
	 b:glossaryEntry="a body of inspectors"/>
<rdf:Description rdf:about="&a;106222293">
	<b:glossaryEntry>a body of citizens sworn to give a true verdict according to the evidence presented in a court of law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106222537">
	<b:glossaryEntry>a group of people gathered for a special purpose as to plan or discuss an issue or judge a contest etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106222691"
	 b:glossaryEntry="(law) a group of people summoned for jury service"/>
<rdf:Description rdf:about="&a;106222792"
	 b:glossaryEntry="a committee appointed to judge a competition"/>
<rdf:Description rdf:about="&a;106222895">
	<b:glossaryEntry>a jury to inquire in accusations of crime and to evaluate the grounds for indictments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106223037">
	<b:glossaryEntry>a jury of 12 to determine the facts and decide the issue in civil or criminal proceedings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106223196">
	<b:glossaryEntry>a jury whose members are selected for special knowledge for a case involving complicated issues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106223369"
	 b:glossaryEntry="a group of girls or young women"/>
<rdf:Description rdf:about="&a;106223451">
	<b:glossaryEntry>the most advanced and responsible group in an activity; "the firing line is where the action is"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106223605">
	<b:glossaryEntry>recent immigrants who are lumped together as a class by their low socioeconomic status in spite of different cultural backgrounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106223796"
	 b:glossaryEntry="those trying to overthrow the established order"/>
<rdf:Description rdf:about="&a;106223906"
	 b:glossaryEntry="politically moderate persons; centrists"/>
<rdf:Description rdf:about="&a;106224017"
	 b:glossaryEntry="the conservative faction of a political party"/>
<rdf:Description rdf:about="&a;106224127"
	 b:glossaryEntry="a faction that is unwilling to accept new ideas"/>
<rdf:Description rdf:about="&a;106224230">
	<b:glossaryEntry>those who argue that the decision to have an induced abortion should be made by the mother</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106224385">
	<b:glossaryEntry>those who argue that induced abortion is killing and should be prohibited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106224521"
	 b:glossaryEntry="a class of people favoring traditional ideas"/>
<rdf:Description rdf:about="&a;106224622"
	 b:glossaryEntry="a collection of merchant ships with an escort of warships"/>
<rdf:Description rdf:about="&a;106224732"
	 b:glossaryEntry="a procession of land vehicles traveling together"/>
<rdf:Description rdf:about="&a;106224833">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a meeting of spiritualists; "the seance was held in the medium''s parlor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106225016"
	 b:glossaryEntry="a sum total of many miscellaneous things"/>
<rdf:Description rdf:about="&a;106225179"
	 b:glossaryEntry="a bank that acts as an agent for a foreign bank"/>
<rdf:Description rdf:about="&a;106225283">
	<b:glossaryEntry>a financial institution that accepts demand deposits and makes loans and provides other services for the public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106225494"
	 b:glossaryEntry="a commercial bank chartered by the federal government"/>
<rdf:Description rdf:about="&a;106225626">
	<b:glossaryEntry>a bank chartered by a state rather than by the federal government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106225748">
	<b:glossaryEntry>a bank named by a multi-bank lending syndicate to protect their interests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106225890"
	 b:glossaryEntry="a bank that is a member of the Federal Reserve System"/>
<rdf:Description rdf:about="&a;106226020">
	<b:glossaryEntry>a credit card processing bank; merchants receive credit for credit card receipts less a processing fee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106226193">
	<b:glossaryEntry>the financial institution that dispenses cash in automated teller machines and collects a fee from the bank that issued the credit card</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106226383">
	<b:glossaryEntry>a bank gaining financial control over another financial institution through a payment in cash or an exchange of stock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106226555">
	<b:glossaryEntry>an agency (usually a bank) that is appointed by a corporation to keep records of its stock and bond owners and to resolve problems about certificates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106226765">
	<b:glossaryEntry>a financial institution that funds their investment activities from the sale of securities or insurance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106227059">
	<b:glossaryEntry>a financial institution that accepts deposits and channels the money into lending activities; "he cashed a check at the bank"; "that bank holds the mortgage on my home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106227566">
	<b:glossaryEntry>a financial institution (often affiliated with a holding company or manufacturer) that makes loans to individuals or businesses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106227827">
	<b:glossaryEntry>a finance company that makes loans to people who have trouble getting a bank loan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106228018">
	<b:glossaryEntry>a finance company that makes small loans to industrial workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106228168">
	<b:glossaryEntry>a finance company owned by a manufacturer to finance dealers'' inventories or to make loans to consumers buying the company''s products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106228371">
	<b:glossaryEntry>a finance company that buys (at a discount) the installment sales contracts of retail merchants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106228534">
	<b:glossaryEntry>a finance company that makes loans to manufacturers and wholesalers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106228702"
	 b:glossaryEntry="banks collectively"/>
<rdf:Description rdf:about="&a;106228802">
	<b:glossaryEntry>a depository financial institution intended to encourage personal savings and home buying</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106228992">
	<b:glossaryEntry>a thrift institution that is required by law to make a certain percentage of its loans as home mortgages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106229208"
	 b:glossaryEntry="British equivalent of US savings and loan association"/>
<rdf:Description rdf:about="&a;106229324">
	<b:glossaryEntry>a thrift institution in the NE US; since deregulation in the 1980s they offer services competitive with many commercial banks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106229544">
	<b:glossaryEntry>one of 11 regional banks that monitor and make short-term credit advances to thrift institutions in their region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106229736"
	 b:glossaryEntry="the central credit system for thrift institutions"/>
<rdf:Description rdf:about="&a;106229880"
	 b:glossaryEntry="the federal agency that insures residential mortgages"/>
<rdf:Description rdf:about="&a;106230016">
	<b:glossaryEntry>an agency responsible for social work concerned with the welfare and vocational training of children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106230207">
	<b:glossaryEntry>an organization (usually with a commercial bank) that is engaged as a trustee or fiduciary or agent in handling trust funds or estates of custodial arrangements or stock transfers or related services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106230486">
	<b:glossaryEntry>a state-chartered savings bank owned by its depositors and managed by a board of trustees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106230647"
	 b:glossaryEntry="a federally chartered savings bank"/>
<rdf:Description rdf:about="&a;106230754">
	<b:glossaryEntry>a squad formed to fire volleys at a military funeral or to carry out a military execution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106230917">
	<b:glossaryEntry>the customers for a particular product or service; "before they publish any book they try to determine the size of the market for it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106231121"
	 b:glossaryEntry="people who engage in illicit trade"/>
<rdf:Description rdf:about="&a;106231214">
	<b:glossaryEntry>the aggregation of things (pedestrians or vehicles or messages) coming and going in a particular locality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106231427"
	 b:glossaryEntry="traffic created by people going to or returning from work"/>
<rdf:Description rdf:about="&a;106231547"
	 b:glossaryEntry="people coming and going on foot"/>
<rdf:Description rdf:about="&a;106231658">
	<b:glossaryEntry>the aggregation of vehicles coming and going in a particular locality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106231881"
	 b:glossaryEntry="cars coming and going"/>
<rdf:Description rdf:about="&a;106231981"
	 b:glossaryEntry="bicycles coming and going"/>
<rdf:Description rdf:about="&a;106232068"
	 b:glossaryEntry="buses coming and going"/>
<rdf:Description rdf:about="&a;106232148"
	 b:glossaryEntry="trucks coming and going"/>
<rdf:Description rdf:about="&a;106232231"
	 b:glossaryEntry="an arrangement of people or things acting as a unit"/>
<rdf:Description rdf:about="&a;106232518"
	 b:glossaryEntry="a formation of troops"/>
<rdf:Description rdf:about="&a;106232676">
	<b:glossaryEntry>a military formation leaving enough space between ranks to allow an inspecting officer to pass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106232827"
	 b:glossaryEntry="a military formation for drill or marching"/>
<rdf:Description rdf:about="&a;106232927">
	<b:glossaryEntry>a military formation for skirmishing; as widely separated as the tactical situation permits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106233079">
	<b:glossaryEntry>the daily military formation at which individuals report to the medical officer as sick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106233236"
	 b:glossaryEntry="a collection of things moving ahead in an orderly manner"/>
<rdf:Description rdf:about="&a;106233475">
	<b:glossaryEntry>a procession (of wagons or mules or camels) traveling together in single file; "we were part of a caravan of almost a thousand camels"; "they joined the wagon train for safety"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106233746"
	 b:glossaryEntry="a procession of people traveling on horseback"/>
<rdf:Description rdf:about="&a;106233847">
	<b:glossaryEntry>a procession of people walking together; "the march went up Fifth Avenue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106233990"
	 b:glossaryEntry="a march of protest or demonstration by the unemployed"/>
<rdf:Description rdf:about="&a;106234121"
	 b:glossaryEntry="a procession of people traveling in motor cars"/>
<rdf:Description rdf:about="&a;106234223"
	 b:glossaryEntry="a ceremonial procession including people marching"/>
<rdf:Description rdf:about="&a;106234343"
	 b:glossaryEntry="a noisy boisterous parade"/>
<rdf:Description rdf:about="&a;106234458"
	 b:glossaryEntry="a line of persons or things ranged one behind the other"/>
<rdf:Description rdf:about="&a;106234628"
	 b:glossaryEntry="a group advancing in a single-file serpentine path"/>
<rdf:Description rdf:about="&a;106234736">
	<b:glossaryEntry>a line of (usually military) units following one after another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106234851"
	 b:glossaryEntry="the group following and attending to some important person"/>
<rdf:Description rdf:about="&a;106235030"
	 b:glossaryEntry="the elite bodyguard of a Roman Emperor"/>
<rdf:Description rdf:about="&a;106235150"
	 b:glossaryEntry="a funeral procession"/>
<rdf:Description rdf:about="&a;106235224">
	<b:glossaryEntry>the offensive football players who line up behind the linemen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106235379">
	<b:glossaryEntry>the defensive football players who line up behind the linemen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106235534"
	 b:glossaryEntry="the football players who line up on the line of scrimmage"/>
<rdf:Description rdf:about="&a;106235683">
	<b:glossaryEntry>a formation of people or things one after another; "the line stretched clear around the corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106235973">
	<b:glossaryEntry>a formation of people or things beside one another; "the line of soldiers advanced with their bayonets fixed"; "they were arrayed in line of battle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106236262"
	 b:glossaryEntry="the arrangement of people in a line for marching"/>
<rdf:Description rdf:about="&a;106236370">
	<b:glossaryEntry>the order in which individuals are expected to succeed one another in some official position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106236527">
	<b:glossaryEntry>a line of persons arranged by police for inspection or identification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106236649"
	 b:glossaryEntry="a line of people acting as pickets"/>
<rdf:Description rdf:about="&a;106236741">
	<b:glossaryEntry>an arrangement of objects or people side by side in a line: "a row of chairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106236904">
	<b:glossaryEntry>a row of notches; "the pliers had serrations to improve the grip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106237025">
	<b:glossaryEntry>a row or line of people (especially soldiers or police) standing abreast of one another; "the entrance was guarded by ranks of policemen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106237232"
	 b:glossaryEntry="one of a set of rows placed one above or behind the other"/>
<rdf:Description rdf:about="&a;106237340"
	 b:glossaryEntry="a line of people in single file performing the conga dance"/>
<rdf:Description rdf:about="&a;106237455"
	 b:glossaryEntry="a line or series of traps"/>
<rdf:Description rdf:about="&a;106237536"
	 b:glossaryEntry="a line of people or vehicles waiting for something"/>
<rdf:Description rdf:about="&a;106237761"
	 b:glossaryEntry="a queue of people waiting for free food"/>
<rdf:Description rdf:about="&a;106237869">
	<b:glossaryEntry>a queue of people waiting for food to be served (especially at a military camp)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106238004"
	 b:glossaryEntry="a queue of vehicles waiting to purchase gasoline"/>
<rdf:Description rdf:about="&a;106238107"
	 b:glossaryEntry="a queue of people waiting to buy tickets"/>
<rdf:Description rdf:about="&a;106238205"
	 b:glossaryEntry="a queue of people waiting for employment"/>
<rdf:Description rdf:about="&a;106238309">
	<b:glossaryEntry>a line of people (hosts and guests of honor) who welcome the guests at a reception party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106238477"
	 b:glossaryEntry="a linear array of numbers side by side"/>
<rdf:Description rdf:about="&a;106238584"
	 b:glossaryEntry="a linear array of numbers one above another"/>
<rdf:Description rdf:about="&a;106238699"
	 b:glossaryEntry="the aggregation of a country''s military aircraft"/>
<rdf:Description rdf:about="&a;106238814">
	<b:glossaryEntry>a system of means and activities whereby a social institution functions; "the complex machinery of negotiation"; "the machinery of command labored and brought forth an order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106239044">
	<b:glossaryEntry>an intricately connected system of things or people; "a network of spies" or "a web of intrigue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106239218">
	<b:glossaryEntry>the network of people and facilities that supports you (enables you to live in a certain style)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106239374">
	<b:glossaryEntry>a group of independent but interrelated elements comprising a unified whole; "a vast system of production and distribution and consumption keep the country going"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106239860"
	 b:glossaryEntry="a system that is part of some larger system"/>
<rdf:Description rdf:about="&a;106239959">
	<b:glossaryEntry>a system considered analogous in structure or function to a living body: "the social organism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106240108"
	 b:glossaryEntry="a systematic orderly arrangement"/>
<rdf:Description rdf:about="&a;106240193">
	<b:glossaryEntry>a collection of particulars considered as a system; "a body of law"; "a body of doctrine"; "a body of precedents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106240357"
	 b:glossaryEntry='an entire system; used in the phrase "the whole shebang"'/>
<rdf:Description rdf:about="&a;106240467"
	 b:glossaryEntry='a large formal assembly; "political convention"'/>
<rdf:Description rdf:about="&a;106240571">
	<b:glossaryEntry>people who perform a particular kind of skilled work; "he represented the craft of brewers"; "as they say in the trade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106240750"
	 b:glossaryEntry="all the plant life in a particular region"/>
<rdf:Description rdf:about="&a;106241055"
	 b:glossaryEntry="a dense growth of bushes"/>
<rdf:Description rdf:about="&a;106241243"
	 b:glossaryEntry="an area thickly overgrown usually with one kind of plant"/>
<rdf:Description rdf:about="&a;106241351"
	 b:glossaryEntry="a dense growth of cane (especially giant cane)"/>
<rdf:Description rdf:about="&a;106241472"
	 b:glossaryEntry="(British) a copse that shelters game"/>
<rdf:Description rdf:about="&a;106241562">
	<b:glossaryEntry>vegetation that has grown; "a growth of trees"; "the only growth was some salt grass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106241700"
	 b:glossaryEntry="dense vegetation consisting of stunted trees or bushes"/>
<rdf:Description rdf:about="&a;106241825">
	<b:glossaryEntry>a growth of similar plants (usually trees) in a particular area; "they cut down a stand of trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106241974"
	 b:glossaryEntry="the trees and other plants in a large densely wooded area"/>
<rdf:Description rdf:about="&a;106242210"
	 b:glossaryEntry="a small growth of trees without underbrush"/>
<rdf:Description rdf:about="&a;106242304">
	<b:glossaryEntry>the brush (small trees and bushes and ferns etc.) growing beneath taller trees in a wood or forest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106242541"
	 b:glossaryEntry="a collection of shrubs growing together"/>
<rdf:Description rdf:about="&a;106242655">
	<b:glossaryEntry>the flowers or vegetables or fruits or herbs that are cultivated in a garden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106242784">
	<b:glossaryEntry>personnel who assist their superior in carrying out an assigned task; "the hospital has an excellent nursing staff"; "the general relied on his staff to make routine decisions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106243157"
	 b:glossaryEntry="personnel having direct job performance responsibilities"/>
<rdf:Description rdf:about="&a;106243274">
	<b:glossaryEntry>personnel having overall planning and direction responsibilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106243405">
	<b:glossaryEntry>a form of government in which the ruler is an absolute dictator (not restricted by a constitution or laws or opposition etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106243742">
	<b:glossaryEntry>a country that maintains repressive control over the people by means of police (especially secret police)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106243906">
	<b:glossaryEntry>the collection of rules imposed by authority; "civilization presupposes respect for the law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106244281">
	<b:glossaryEntry>the body of rules and regulations and orders and decisions created by administrative agencies of government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106244453">
	<b:glossaryEntry>the body of codified laws governing the affairs of a Christian church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106244599">
	<b:glossaryEntry>the body of laws established by a state or nation for its own regulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106244781"
	 b:glossaryEntry="the body of laws governing relations between nations"/>
<rdf:Description rdf:about="&a;106244932">
	<b:glossaryEntry>a phrase used in the Magna Carta to refer to the then established law of the Kingdom (as distinct from Roman or civil law); today it refers to fundamental principles of justice commensurate with due process (the US Constitution establishes itself as "the supreme law of the land")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106245274">
	<b:glossaryEntry>the traditional body of rules and practices relating to commerce and navigation or to business transacted at sea or to general maritime affairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106245492">
	<b:glossaryEntry>the body of law imposed by the military over civilian affairs (usually in time of war or civil crisis); overrides civil law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106245673">
	<b:glossaryEntry>the body of rules applied to commercial transactions; derived from the practices of traders rather than from jurisprudence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106245888">
	<b:glossaryEntry>the laws (beginning with the Ten Commandments) that God gave to the Israelites through Moses; it includes many rules of religious observance given in the first five books of the Old Testament (in Judaism these books are called the Torah)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106246198"
	 b:glossaryEntry="the body of laws created by legislative statutes"/>
<rdf:Description rdf:about="&a;106246306">
	<b:glossaryEntry>the body of laws governing the issuance and selling of securities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106246432"
	 b:glossaryEntry="nonelective government officials"/>
<rdf:Description rdf:about="&a;106246575"
	 b:glossaryEntry="a collection of live animals for study or display"/>
<rdf:Description rdf:about="&a;106246680">
	<b:glossaryEntry>logical or comprehensible arrangement of separate elements of a group; "we shall consider these questions in the inverse order of their presentation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106246946">
	<b:glossaryEntry>similar things placed or happening one after another; "they were investigating a series of bank robberies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106247375">
	<b:glossaryEntry>arrangement in which things follow in logical order or a recurrent pattern; "the sequence of names was alphabetical"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106247582">
	<b:glossaryEntry>a sequentially ordered set of things or events or ideas in which each successive member is related to the preceding: "a string of islands"; "train of mourners"; "a train of thought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106247825">
	<b:glossaryEntry>a series of things depending on each other as if linked together: "the chain of command"; "a complicated concatenation of circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106248029">
	<b:glossaryEntry>a group of people or things arranged or following in order: "a succession of stalls offering soft drinks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106248227">
	<b:glossaryEntry>an extended (often showy) succession of persons or things: "a parade of strollers on the mall"; "a parade of witnesses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106248399">
	<b:glossaryEntry>an unbroken series of events: "a succession of failures"; "had a streak of bad luck"; "Nicklaus had a run of birdies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106248611"
	 b:glossaryEntry="a streak of losses"/>
<rdf:Description rdf:about="&a;106248689"
	 b:glossaryEntry="a streak of wins"/>
<rdf:Description rdf:about="&a;106248766"
	 b:glossaryEntry="a series with a definite pattern of advance"/>
<rdf:Description rdf:about="&a;106248941">
	<b:glossaryEntry>(math) a progression in which a constant is added to each term in order to obtain the next term; "1-4-7-10-13- is the start of an arithmetic progression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106249163">
	<b:glossaryEntry>(math) a progression in which each term is multiplied by a constant in order to obtain the next term; "1-4-16-64-256- is the start of a geometric progression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106249389">
	<b:glossaryEntry>(math) a progression of terms whose reciprocals form an arithmetic progression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106249534"
	 b:glossaryEntry="a connected series or group"/>
<rdf:Description rdf:about="&a;106249613">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a series of poems or songs on the same theme: "schubert''s song cycles"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106249735">
	<b:glossaryEntry>a connected series of events or actions or developments; "the government took a firm course" or "historians can only point out those lines for which evidence is available"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106249984">
	<b:glossaryEntry>a series of unexpected unpleasant occurrences; "a rash of bank robberies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106250108">
	<b:glossaryEntry>dominant course (suggestive of running water) of successive events or ideas: "two streams of development run through American history"; "stream of consciousness"; "the flow of thought"; "the current of history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106250388">
	<b:glossaryEntry>a series from actinium to lawrencium of 15 radioactive elements with increasing atomic numbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106250544"
	 b:glossaryEntry="a succession of waves spaced at regular intervals"/>
<rdf:Description rdf:about="&a;106250650"
	 b:glossaryEntry="a complete and impressive array"/>
<rdf:Description rdf:about="&a;106250735">
	<b:glossaryEntry>an arrangement of similar objects in a row or in tiers; "he operated a bank of switches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106250874"
	 b:glossaryEntry="a storage pile accumulated for future use"/>
<rdf:Description rdf:about="&a;106250971">
	<b:glossaryEntry>a collection of facts from which conclusions may be drawn; "statistical data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106251131"
	 b:glossaryEntry="unanalyzed data; data not yet subjected to analysis"/>
<rdf:Description rdf:about="&a;106251237"
	 b:glossaryEntry="a collection of anecdotes about a person or place"/>
<rdf:Description rdf:about="&a;106251336">
	<b:glossaryEntry>any particular collection of letters or packages that is delivered; "your mail is on the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106251482">
	<b:glossaryEntry>a collection of precious things; "the trunk held all her meager treasures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106251611">
	<b:glossaryEntry xml:space='preserve'><![CDATA[any collection of valuables that is discovered; "her book was a treasure trove of new ideas" or "mother''s attic was a treasure trove when we were looking for antiques"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106251839">
	<b:glossaryEntry>a group of people with a common ideology who try together to achieve certain general goals; "he was a charter member of the movement"; "politicians have to respect a mass movement"; "he led the national liberation front"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106252230">
	<b:glossaryEntry>a style of design that was popular in the 1920s and 1930s; marked by stylized forms and geometric designs adapted to mass production</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106252417"
	 b:glossaryEntry="artists or writers whose ideas are ahead of their time"/>
<rdf:Description rdf:about="&a;106252546">
	<b:glossaryEntry>an abstractionist artistic movement in Russia after World War I; industrial materials were used to construct nonrepresentational objects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106252762">
	<b:glossaryEntry>an artistic movement in France beginning in 1907 that featured surfaces of geometrical planes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106252963">
	<b:glossaryEntry>a nihilistic art movement (especially in painting) that flourished in Europe early in the 20th century; based on irrationality and negation of the accepted laws of beauty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106253194"
	 b:glossaryEntry="a group of artists who agree on general principles"/>
<rdf:Description rdf:about="&a;106253539">
	<b:glossaryEntry>an art movement early in the 20th century; the artist''s subjective expression of inner experiences was emphasized</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106253748">
	<b:glossaryEntry>an art movement based on expressionism; developed in 1980s in Europe and US; crudely drawn garish paintings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106253918"
	 b:glossaryEntry="a movement that tried to go beyond expressionism"/>
<rdf:Description rdf:about="&a;106254032">
	<b:glossaryEntry>an artistic movement in Italy around 1910 that tried to express the energy and values of the machine age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106254191">
	<b:glossaryEntry>a movement by American and English poets early in the 20th century in reaction to Victorian sentimentality; used common speech in free verse with clear concrete imagery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106254413">
	<b:glossaryEntry>an artistic movement in 19th century France; artists and writers strove for detailed realistic and factual description</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106254598">
	<b:glossaryEntry>an art movement based on a revival of romanticism in art and literature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106254730"
	 b:glossaryEntry="an art movement in French cinema in the 1960s"/>
<rdf:Description rdf:about="&a;106254847">
	<b:glossaryEntry>a 20th century movement in art and literature (developing out of Dadaism) that used fantastic images and incongruous juxtapositions in order to represent unconscious thoughts and dreams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106255108">
	<b:glossaryEntry>a movement in which several individuals or groups with different interests join together; "the unions presented a common front at the bargaining table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106255318">
	<b:glossaryEntry>a group of people working together to advance certain cultural goals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106255468">
	<b:glossaryEntry>a group of people working together to achieve a political goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106255650">
	<b:glossaryEntry>a movement in the 18th century that advocated the use of reason in the reappraisal of accepted ideas and social institutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106255850">
	<b:glossaryEntry>an organized attempt by workers to improve their status by united action especially via labor unions (especially the leaders of this movement)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106256121"
	 b:glossaryEntry="the system or principles and theory of labor unions"/>
<rdf:Description rdf:about="&a;106256244">
	<b:glossaryEntry>a movement intended to bring about social and humanitarian reforms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106256408"
	 b:glossaryEntry="a movement intended to bring about religious reforms"/>
<rdf:Description rdf:about="&a;106256615">
	<b:glossaryEntry>the reaction of the Roman Catholic Church to the Reformation reaffirming the veneration of saints and the authority of the Pope (to which Protestants objected); many leaders were Jesuits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106256867">
	<b:glossaryEntry>a movement (especially among Protestant denominations) aimed to promote understanding and cooperation among Christian churches; aimed ultimately at universal Christian unity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106257106">
	<b:glossaryEntry>19th-century movement in the Church of England opposing liberal tendencies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106257242">
	<b:glossaryEntry>17th and 18th-century movement in the German Lutheran Church stressing personal piety and devotion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106257394">
	<b:glossaryEntry>a religious movement of the 16th century that began as an attempt to reform the Roman Catholic Church and resulted in the creation of Protestant churches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106257605">
	<b:glossaryEntry>the cultural movement of the Renaissance; based on classical studies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106257728"
	 b:glossaryEntry="the early phase of cubism"/>
<rdf:Description rdf:about="&a;106257817"
	 b:glossaryEntry="the late phase of cubism"/>
<rdf:Description rdf:about="&a;106257904">
	<b:glossaryEntry>people who have not confessed; "the unconfessed cannot be forgiven"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106258029">
	<b:glossaryEntry>a group of submarines operating together in attacking enemy convoys</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106258152">
	<b:glossaryEntry xml:space='preserve'><![CDATA[women as a class; "it''s an insult to American womanhood"; "woman is the glory of creation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106258325"
	 b:glossaryEntry="women as distinguished from men"/>
<rdf:Description rdf:about="&a;106258431">
	<b:glossaryEntry>a group of people living together in a camp; "the whole camp laughed at his mistake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106258566"
	 b:glossaryEntry="a party of former associates who have come together again"/>
<rdf:Description rdf:about="&a;106258677">
	<b:glossaryEntry>a company that moves the possessions of a family or business from one site to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106258879">
	<b:glossaryEntry>a company that does research for hire and issues reports on the implications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106259028">
	<b:glossaryEntry>in the Protestant Episcopal Church: a committee elected by the congregation to work with the churchwardens in managing the temporal affairs of the church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106259272">
	<b:glossaryEntry>a gathering of military personnel for duty; "he was thrown in the brig for missing muster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106259415"
	 b:glossaryEntry="a gathering of people holding a rap session"/>
<rdf:Description rdf:about="&a;106259514"
	 b:glossaryEntry="(British) a raucous gathering"/>
<rdf:Description rdf:about="&a;106259597">
	<b:glossaryEntry>a company of people assembled at a table for a meal or game; "he entertained the whole table with his witty remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106259765">
	<b:glossaryEntry>an ecumenical organization of Protestant and Eastern churches; intended to promote unity and cooperation in religious and secular matters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106259974">
	<b:glossaryEntry>a select company of people; "I hope to become one of their number before I die"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106260106">
	<b:glossaryEntry>a body of voters who have the same interests; "he failed to get the Black vote"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106260255">
	<b:glossaryEntry>any organization or party whose uniforms or badges are blue; "the Union army was a vast blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106260417">
	<b:glossaryEntry>any organization or party whose uniforms or badges are gray; "the Confederate army was a vast gray"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106260592">
	<b:glossaryEntry>any organization that provides resources and facilities for a function or event; "Atlanta was chosen to be host for the Olympic Games"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106260777">
	<b:glossaryEntry>an organization of people or resources that can be shared; "a car pool"; "a secretarial pool"; "when he was first hired he was assigned to the pool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106260976">
	<b:glossaryEntry>the middle of a military or naval formation; "they had to reinforce the center"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106261108">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the side of military or naval formation; "they attacked the enemy''s right flank"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106261247">
	<b:glossaryEntry>the front of a military formation or procession; "the head of the column advanced boldly"; "they were at the head of the attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106261444">
	<b:glossaryEntry>the back of a military formation or procession; "infantrymen were in the rear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106261591"
	 b:glossaryEntry="any people believing themselves to be chosen by God"/>
<rdf:Description rdf:about="&a;106261720">
	<b:glossaryEntry>(Old Testament) the ethnic group claiming descent from Abraham and Isaac (especially from Isaac''s son Jacob); the nation whom God chose to receive his revelation and with whom God chose to make a covenant (Exodus 19)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106262021">
	<b:glossaryEntry>(New Testament) the sages who visited Jesus and Mary and Joseph shortly after Jesus was born; according to the Gospel of Matthew they were guided by a star and brought gifts of gold and frankincense and myrrh; because there were three gifts it is usually assumed that there were three of them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106262375">
	<b:glossaryEntry>an association of people to promote the welfare of senior citizens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106262545">
	<b:glossaryEntry>the present location; this place; "where do we go from here?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106262675">
	<b:glossaryEntry>a location other than here; that place; "you can take it from there"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106262813">
	<b:glossaryEntry>the country or state or city where you live; "Canadian tariffs enabled United States lumber companies to raise prices at home"; "his home is New Jersey"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106263016">
	<b:glossaryEntry>the place where you are stationed and from which missions start and end</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106263145">
	<b:glossaryEntry>(in the Gospel of Luke 16:22); the place where the just enjoy the peace of heaven after death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106263319">
	<b:glossaryEntry>an imaginary line paralleling the equator where a magnetic needle has no dip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106263473">
	<b:glossaryEntry>an imaginary line connecting points on the Earth''s surface where the magnetic declination is zero</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106263628">
	<b:glossaryEntry>an imaginary line connecting points on the Earth''s surface where the magnetic declination is the same</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106263815">
	<b:glossaryEntry>the place where a person or organization can be found or communicated with</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106264015">
	<b:glossaryEntry>the address where a person or organization can be communicated with</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106264180">
	<b:glossaryEntry>the mailing address to which answers to a newspaper ad can be sent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106264303">
	<b:glossaryEntry>the number of a letter box at the post office where mail is collected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106264469"
	 b:glossaryEntry="the address where a person or organization can be found"/>
<rdf:Description rdf:about="&a;106264585"
	 b:glossaryEntry="a district defined for administrative purposes"/>
<rdf:Description rdf:about="&a;106265038"
	 b:glossaryEntry="any habitation at a high altitude"/>
<rdf:Description rdf:about="&a;106265145"
	 b:glossaryEntry="the place where you are after you die"/>
<rdf:Description rdf:about="&a;106265239"
	 b:glossaryEntry="the marketplace in ancient Greece"/>
<rdf:Description rdf:about="&a;106265324">
	<b:glossaryEntry>a designated route followed by airplanes in flying from one airport to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106265498">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the path that is prescribed for an airplane that is preparing to land at an airport; "the traffic patterns around O''Hare are very crowded"; "they stayed in the pattern until the fog lifted"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106265797">
	<b:glossaryEntry>a region in southern Spain on the Atlantic and the Mediterranean; formerly a center of Moorish civilization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106265991">
	<b:glossaryEntry>an impoverished coal mining area in the Appalachian Mountains (from Pennsylvania to North Carolina)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106266166"
	 b:glossaryEntry="the path of an aircraft or rocket through the air"/>
<rdf:Description rdf:about="&a;106266273"
	 b:glossaryEntry="the final path followed by an aircraft as it is landing"/>
<rdf:Description rdf:about="&a;106266445"
	 b:glossaryEntry="the atmosphere of an environment"/>
<rdf:Description rdf:about="&a;106266543">
	<b:glossaryEntry>a commercially operated park with stalls and shows for amusement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106266715">
	<b:glossaryEntry>the region around the south pole: Antarctica and surrounding waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106266875"
	 b:glossaryEntry="a line of latitude north of the south pole"/>
<rdf:Description rdf:about="&a;106266980">
	<b:glossaryEntry>the point on the celestial sphere toward which the sun and solar system appear to be moving relative to the fixed stars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106267224">
	<b:glossaryEntry>the point opposite in direction from the solar_apex; the point the solar system is moving away from</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106267395">
	<b:glossaryEntry>apoapsis in Earth orbit; the point in its orbit where a satellite is at the greatest distance from the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106267574">
	<b:glossaryEntry>(astronomy) the point in an orbit farthest from the body being orbited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106267846">
	<b:glossaryEntry>apoapsis in solar orbit; the point in the orbit of a planet or comet that is at the greatest distance from the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106268033"
	 b:glossaryEntry="apoapsis in orbit around Jupiter"/>
<rdf:Description rdf:about="&a;106268137"
	 b:glossaryEntry="apoapsis in orbit around the moon"/>
<rdf:Description rdf:about="&a;106268272">
	<b:glossaryEntry>the regions north of the Arctic Circle centered on the North Pole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106268424"
	 b:glossaryEntry="a line of latitude at the north or south poles"/>
<rdf:Description rdf:about="&a;106268565"
	 b:glossaryEntry="a line of latitude south of the north pole"/>
<rdf:Description rdf:about="&a;106268667">
	<b:glossaryEntry>the central area of an ancient Roman amphitheater where contests and spectacles were held; especially a sand-strewn area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106268839">
	<b:glossaryEntry>a particular geographical region of indefinite boundary (usually serving some special purpose or distinguished by its people or culture or geography); "it was a mountainous area"; "Bible country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106269617">
	<b:glossaryEntry>the point at which an orbit crosses the ecliptic plane going north</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106269762"
	 b:glossaryEntry="(astronomy) a point where an orbit crosses a plane"/>
<rdf:Description rdf:about="&a;106269899">
	<b:glossaryEntry>the region of interplanetary space between Mars and Jupiter where most asteroids are found</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106270068">
	<b:glossaryEntry>the mass of air surrounding the Earth; "there was great heat as the comet entered the atmosphere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106270278">
	<b:glossaryEntry>an area on which a drove of cattle or sheep can sleep for a night</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106270399">
	<b:glossaryEntry>(usually plural) the deepest and most remote part; "from the depths of darkest Africa"; "signals received from the depths of space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106270582">
	<b:glossaryEntry xml:space='preserve'><![CDATA[any region in space outside the Earth''s atmosphere; "the astronauts walked in space without a tether"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106270844"
	 b:glossaryEntry="the part of outer space within the solar system"/>
<rdf:Description rdf:about="&a;106271014"
	 b:glossaryEntry="the space between stars"/>
<rdf:Description rdf:about="&a;106271139">
	<b:glossaryEntry>the boundary marking the edge of the sun''s influence; the boundary (roughly 100 AU from the sun) between the interplanetary medium and the interstellar medium; where the solar wind and the wind from other stars meet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106271411">
	<b:glossaryEntry>the region inside the heliopause containing the sun and solar system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106271575">
	<b:glossaryEntry>the space between galaxies; "the Milky Way travels through intergalactic space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106271739"
	 b:glossaryEntry="any region in space outside the solar system"/>
<rdf:Description rdf:about="&a;106271859"
	 b:glossaryEntry="the atmosphere and outer space considered as a whole"/>
<rdf:Description rdf:about="&a;106272005">
	<b:glossaryEntry>the atmosphere above a nation and deemed to be under its jurisdiction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106272129">
	<b:glossaryEntry>any backward region that is isolated from the world and resists progress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106272257"
	 b:glossaryEntry="a remote and undeveloped area"/>
<rdf:Description rdf:about="&a;106272382">
	<b:glossaryEntry>an eroded and barren region in southwestern South Dakota and northwestern Nebraska</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106272569">
	<b:glossaryEntry>a region of North Africa on the Mediterranean coast between Egypt and Gibraltar; was used as a base for pirates from the 16th to 19th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106272804">
	<b:glossaryEntry>the Mediterranean coast of North Africa that was famous for its Moorish pirates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106272962">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a part of a city that is notorious for gambling dens and brothels and saloons and riotous night life (especially the waterfront of San Francisco after the gold rush of 1849); "we''ll tolerate no Barbary Coast in this city!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106273244">
	<b:glossaryEntry>an uninhabited wilderness that is worthless for cultivation; "the barrens of central Africa"; "the trackless wastes of the desert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106273465">
	<b:glossaryEntry>(British) a tract of level wasteland; uncultivated land with sandy soil and scrubby vegetation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106273623"
	 b:glossaryEntry="a large wilderness area"/>
<rdf:Description rdf:about="&a;106273715"
	 b:glossaryEntry="the remote bush country of Australia"/>
<rdf:Description rdf:about="&a;106273824">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a wilderness at the edge of a settled area of a country; "the individualism of the frontier in Andrew Jackson''s day"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106273995"
	 b:glossaryEntry="an arid region with little or no vegetation"/>
<rdf:Description rdf:about="&a;106274379">
	<b:glossaryEntry>a region much like a desert but usually located between a desert and the surrounding regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106274528">
	<b:glossaryEntry>a fertile tract in a desert (where the water table approaches the surface)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106274654">
	<b:glossaryEntry>a region where a battle is being (or has been) fought; "they made a tour of Civil War battlefields"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106274908">
	<b:glossaryEntry>(New Testament) the scene of the final battle between the kings of the Earth at the end of the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106275065"
	 b:glossaryEntry="a region in which explosives mines have been placed"/>
<rdf:Description rdf:about="&a;106275172">
	<b:glossaryEntry>a regular route for a sentry or policeman; "in the old days a policeman walked a beat and knew all his people by name"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106275359">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the place where something begins, where it springs into being; "the Italian beginning of the Renaissance"; "Jupiter was the origin of the radiation"; "Pittsburgh is the source of the Ohio River"; "communism''s Russian root"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106275824">
	<b:glossaryEntry>the source from which something derives (i.e. comes or issues); "he prefers shoes of Italian derivation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106275985"
	 b:glossaryEntry="a point at which water issues forth"/>
<rdf:Description rdf:about="&a;106276073">
	<b:glossaryEntry>the source of water from which a stream arises; "they tracked him back toward the head of the stream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106276253"
	 b:glossaryEntry='the source of a river; "the headwaters of the Nile"'/>
<rdf:Description rdf:about="&a;106276361"
	 b:glossaryEntry="the source of water for a well"/>
<rdf:Description rdf:about="&a;106276459"
	 b:glossaryEntry="a place from which an enterprise or expedition is launched"/>
<rdf:Description rdf:about="&a;106276601">
	<b:glossaryEntry>an area or region distinguished from adjacent parts by a distinctive feature or characteristic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106276818">
	<b:glossaryEntry>an elongated region where a specific condition is found; "a belt of high pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106277041">
	<b:glossaryEntry>southern United States; where Protestant fundamentalism is dominant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106277165"
	 b:glossaryEntry="the country where you were born"/>
<rdf:Description rdf:about="&a;106277346"
	 b:glossaryEntry="the place where someone was born"/>
<rdf:Description rdf:about="&a;106277452">
	<b:glossaryEntry>where something originated or was nurtured in its early existence; "the birthplace of civilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106277648">
	<b:glossaryEntry>a surface forming part of the outside of an object; "he examined all sides of the crystal"; "dew dripped from the face of the leaf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106277945">
	<b:glossaryEntry>(nautical) at the ends of the transverse deck beams of a vessel; "on her beam-ends" means heeled over on the side so that the deck is almost vertical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106278150"
	 b:glossaryEntry="the lower side of anything"/>
<rdf:Description rdf:about="&a;106278364"
	 b:glossaryEntry='lower side: "the underbellies of clouds"'/>
<rdf:Description rdf:about="&a;106278461">
	<b:glossaryEntry>the lower part of anything; "curled up on the foot of the bed"; "the foot of the page"; "the foot of the list"; "the foot of the mountain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106278668">
	<b:glossaryEntry>(anatomy) the part of an organ nearest its point of attachment: "the base of the skull"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106278806">
	<b:glossaryEntry>the lowest part of anything; "they started at the bottom of the hill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106278982"
	 b:glossaryEntry="the absolute bottom"/>
<rdf:Description rdf:about="&a;106279059">
	<b:glossaryEntry>the line or plane indicating the limit or extent of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106279444"
	 b:glossaryEntry="a line that indicates a boundary"/>
<rdf:Description rdf:about="&a;106279627"
	 b:glossaryEntry="an archaic term for a boundary"/>
<rdf:Description rdf:about="&a;106279718"
	 b:glossaryEntry="the area on either side of a border or boundary"/>
<rdf:Description rdf:about="&a;106279834">
	<b:glossaryEntry>any area set aside for a particular purpose; "who owns this place?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106280000">
	<b:glossaryEntry>a place where some particular activity is concentrated; "they received messages from several centers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106280163"
	 b:glossaryEntry="a boundary line created by a fence"/>
<rdf:Description rdf:about="&a;106280273"
	 b:glossaryEntry="the boundary line between two pieces of property"/>
<rdf:Description rdf:about="&a;106280381"
	 b:glossaryEntry="the boundary between two states"/>
<rdf:Description rdf:about="&a;106280504">
	<b:glossaryEntry>the boundary between Maryland and Pennsylvania; symbolic dividing line between North and South before the Civil War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106280730"
	 b:glossaryEntry="the boundary between two districts"/>
<rdf:Description rdf:about="&a;106280824"
	 b:glossaryEntry="the boundary between two counties"/>
<rdf:Description rdf:about="&a;106280915"
	 b:glossaryEntry="the boundary of a city"/>
<rdf:Description rdf:about="&a;106280993">
	<b:glossaryEntry>line across a billiard table behind which the cue balls are placed at the start of a game</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106281164">
	<b:glossaryEntry>an area in a town that has been devastated by bombs; "they opened a parking lot on the bomb site"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106281317"
	 b:glossaryEntry="the center of the Earth"/>
<rdf:Description rdf:about="&a;106281393"
	 b:glossaryEntry="a field of closely mowed turf for playing bowls"/>
<rdf:Description rdf:about="&a;106281500"
	 b:glossaryEntry="a place where animals breed"/>
<rdf:Description rdf:about="&a;106281625"
	 b:glossaryEntry="a defensive post at the end of a bridge nearest to the enemy"/>
<rdf:Description rdf:about="&a;106281742"
	 b:glossaryEntry="the edge of a steep place"/>
<rdf:Description rdf:about="&a;106281819">
	<b:glossaryEntry>the area over which a radio or tv transmission can be received</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106281942"
	 b:glossaryEntry="a small neutral state between two rival powers"/>
<rdf:Description rdf:about="&a;106282064"
	 b:glossaryEntry="the center of a target"/>
<rdf:Description rdf:about="&a;106282169"
	 b:glossaryEntry="the route regularly followed by a passenger bus"/>
<rdf:Description rdf:about="&a;106282291">
	<b:glossaryEntry>a place on a bus route where buses stop to discharge and take on passengers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106282440">
	<b:glossaryEntry>a place (as at a frontier) where travellers are stopped for inspection and clearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106282581"
	 b:glossaryEntry="a place where taxis park while awaiting customers"/>
<rdf:Description rdf:about="&a;106282697"
	 b:glossaryEntry="a site where people on holiday can pitch a tent"/>
<rdf:Description rdf:about="&a;106282882"
	 b:glossaryEntry="a field on which the buildings of a university are situated"/>
<rdf:Description rdf:about="&a;106283013"
	 b:glossaryEntry="a seat of government"/>
<rdf:Description rdf:about="&a;106283483"
	 b:glossaryEntry="the geographical area draining into a river or reservoir"/>
<rdf:Description rdf:about="&a;106283651">
	<b:glossaryEntry>the entire geographical area drained by a river and its tributaries; "flood control in the Missouri basin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106283823">
	<b:glossaryEntry>a large region between the Black and Caspian seas; oil is its major resource</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106283984">
	<b:glossaryEntry xml:space='preserve'><![CDATA[other phrases used to refer to heaven; "the Celestial City was Christian''s goal in Bunyan''s `Pilgrim''s Progress''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106284200">
	<b:glossaryEntry>the great circle on the celestial sphere midway between the celestial poles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106284411"
	 b:glossaryEntry="a point in the heavens (on the celestial sphere)"/>
<rdf:Description rdf:about="&a;106284702">
	<b:glossaryEntry>(astronomy) either of the two celestial points at which the celestial equator intersects the ecliptic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106284913">
	<b:glossaryEntry>(astronomy) the equinoctial point that lies in the constellation of Pisces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106285048">
	<b:glossaryEntry>(astronomy) the equinoctial point that lies in the constellation of Virgo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106285184">
	<b:glossaryEntry>the apparent surface of the imaginary sphere on which celestial bodies appear to be projected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106285522"
	 b:glossaryEntry="a tract of land used for burials"/>
<rdf:Description rdf:about="&a;106285699">
	<b:glossaryEntry>a point equidistant from the ends of a line or the extremities of a figure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106286080"
	 b:glossaryEntry="point representing the mean position of the matter in a body"/>
<rdf:Description rdf:about="&a;106286230">
	<b:glossaryEntry>(astronomy) the common center of mass around which two or more bodies revolve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106286364"
	 b:glossaryEntry="point where the hairline meets the midpoint of the forehead"/>
<rdf:Description rdf:about="&a;106286507">
	<b:glossaryEntry>the point within something at which gravity can be considered to act</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106286659">
	<b:glossaryEntry>an area that is approximately central within some larger region; "it is in the center of town"; "they ran forward into the heart of the struggle"; "they were in the eye of the storm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106287070"
	 b:glossaryEntry="the central part of a city"/>
<rdf:Description rdf:about="&a;106287188">
	<b:glossaryEntry>the central area or place of lowest barometric pressure within a storm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106287351">
	<b:glossaryEntry>a large and densely populated urban area; may include several independent administrative districts; "Ancient Troy was a great city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106293560">
	<b:glossaryEntry>a very large urban complex (usually involving several cities and towns)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106293689"
	 b:glossaryEntry="a district of a town or city"/>
<rdf:Description rdf:about="&a;106294174">
	<b:glossaryEntry>a district of a city or town marked out for administrative purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106294332">
	<b:glossaryEntry>a precinct in which law enforcement is the responsibility of particular police force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106294478">
	<b:glossaryEntry>one of several districts into which a city or town is divided for voting; each contains one polling place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106294665"
	 b:glossaryEntry="a place where voters go to cast their votes in an election"/>
<rdf:Description rdf:about="&a;106294820"
	 b:glossaryEntry="the commercial center of a town or city"/>
<rdf:Description rdf:about="&a;106294952">
	<b:glossaryEntry>outlying areas (as of a city or town); "they lived on the outskirts of Houston" or "they mingled in the outskirts of the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106295135">
	<b:glossaryEntry>a city district (originally in New York) where composers and publishers of popular music do business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106295295"
	 b:glossaryEntry="an aggregation or continuous network of urban communities"/>
<rdf:Description rdf:about="&a;106295443"
	 b:glossaryEntry="(Brit) monotonous urban sprawl of standardized buildings"/>
<rdf:Description rdf:about="&a;106295554">
	<b:glossaryEntry>an English town that forms the constituency of a member of Parliament</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106295731"
	 b:glossaryEntry="a borough in Scotland"/>
<rdf:Description rdf:about="&a;106295804">
	<b:glossaryEntry>a sparsely populated borough in which all or most of the land is owned by a single family</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106295954"
	 b:glossaryEntry="an English parliamentary constituency with few electors"/>
<rdf:Description rdf:about="&a;106296070"
	 b:glossaryEntry="one of the administrative divisions of a large city"/>
<rdf:Description rdf:about="&a;106296283"
	 b:glossaryEntry="a small administrative division of a country"/>
<rdf:Description rdf:about="&a;106296380">
	<b:glossaryEntry>an incorporated administrative district established by state charter; "the city raised the tax rate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106296625"
	 b:glossaryEntry="the limits of the area occupied by a city or town"/>
<rdf:Description rdf:about="&a;106296783">
	<b:glossaryEntry>a tract of land with few or no trees in the middle of a wooded area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106296913">
	<b:glossaryEntry>the smallest administrative district of several European countries (Belgium and France and Italy and Switzerland)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106297080">
	<b:glossaryEntry>any of the regions of the surface of the Earth loosely divided according to latitude or longitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106297284">
	<b:glossaryEntry>any of the geographical zones loosely divided according to prevailing climate and latitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106297506">
	<b:glossaryEntry>a place where you say people are when they seem optimistically out of touch with reality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106297658"
	 b:glossaryEntry="a pasture subject to common use"/>
<rdf:Description rdf:about="&a;106297757">
	<b:glossaryEntry>the official name of some states in the United States (Massachusetts and Pennsylvania and Virginia and Kentucky) and associated territories (Puerto Rico)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106297988">
	<b:glossaryEntry>a place where two things come together; "Pittsburgh is located at the confluence of the Allegheny and Monongahela rivers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106298187">
	<b:glossaryEntry>a territorial division of a state; entitled to elect one member to the United States House of Representatives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106298384"
	 b:glossaryEntry='the center of an object; "do not eat the apple core"'/>
<rdf:Description rdf:about="&a;106298505"
	 b:glossaryEntry="the part of a city where financial institutions are centered"/>
<rdf:Description rdf:about="&a;106298647"
	 b:glossaryEntry="the center of a city"/>
<rdf:Description rdf:about="&a;106298782">
	<b:glossaryEntry>the older and more populated and (usually) poorer central section of a city</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106298933">
	<b:glossaryEntry>midwestern United States (Iowa Illinois Indiana); excellent for raising corn and corn-fed livestock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106299088">
	<b:glossaryEntry>the hard cylindrical core that bears the kernels of an ear of corn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106299227">
	<b:glossaryEntry>the point where two lines meet or intersect; "the corners of a rectangle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106299371">
	<b:glossaryEntry>a place off to the side of an area; "he tripled to the rightfield corner"; "he glanced out of the corner of his eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106299540">
	<b:glossaryEntry>a remote area; "in many corners of the world they still practice slavery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106299666"
	 b:glossaryEntry="a field planted with corn"/>
<rdf:Description rdf:about="&a;106299747">
	<b:glossaryEntry>the territory occupied by a nation; "he returned to the land of his birth"; "he visited several European countries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106300934"
	 b:glossaryEntry="a territorial division for local government"/>
<rdf:Description rdf:about="&a;106301193"
	 b:glossaryEntry="the territory of a count palatine"/>
<rdf:Description rdf:about="&a;106301288"
	 b:glossaryEntry="the town or city that is the seat of government for a county"/>
<rdf:Description rdf:about="&a;106301445">
	<b:glossaryEntry>(British) the town or city that is the seat of government for a shire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106301604"
	 b:glossaryEntry="the top line of a hill, mountain, or wave"/>
<rdf:Description rdf:about="&a;106301697">
	<b:glossaryEntry>line marking the upper limit of tree growth in mountains or northern latitudes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106301858">
	<b:glossaryEntry>the line on a mountain above which there is perpetual snow and ice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106301980"
	 b:glossaryEntry="a point where two lines (paths or arcs etc.) intersect"/>
<rdf:Description rdf:about="&a;106302089">
	<b:glossaryEntry>a section created by a plane cutting a solid perpendicular to its longest axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106302245">
	<b:glossaryEntry>a vertical section of the Earth''s crust showing the different horizons or layers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106302435">
	<b:glossaryEntry>a vertical section of soil from the ground surface to the parent rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106302563">
	<b:glossaryEntry>the territorial and administrative division of some countries (such as France)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106302717">
	<b:glossaryEntry>the point at which an orbit crosses the ecliptic plane going south</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106302863"
	 b:glossaryEntry="place where something (e.g., a journey or race) ends"/>
<rdf:Description rdf:about="&a;106302980">
	<b:glossaryEntry>a district that has been developed to serve some purpose; "such land is practical for small park developments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106303166">
	<b:glossaryEntry>a residential area of dwellings built by property developers; "they live in the new housing development"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106303355">
	<b:glossaryEntry>the site of an archeological exploration; "they set up camp next to the dig"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106303494"
	 b:glossaryEntry="the territorial jurisdiction of a bishop"/>
<rdf:Description rdf:about="&a;106303674"
	 b:glossaryEntry="the jurisdiction or office of an abbot"/>
<rdf:Description rdf:about="&a;106303765"
	 b:glossaryEntry="the territorial jurisdiction of an archbishop"/>
<rdf:Description rdf:about="&a;106303870"
	 b:glossaryEntry="the territorial jurisdiction of an archdeacon"/>
<rdf:Description rdf:about="&a;106303974"
	 b:glossaryEntry="the territorial jurisdiction of a caliph"/>
<rdf:Description rdf:about="&a;106304070"
	 b:glossaryEntry="the see of the pope (as the bishop of Rome)"/>
<rdf:Description rdf:about="&a;106304168"
	 b:glossaryEntry="the diocese of an archbishop"/>
<rdf:Description rdf:about="&a;106304254"
	 b:glossaryEntry="a diocese of the Eastern Christian Church"/>
<rdf:Description rdf:about="&a;106304349"
	 b:glossaryEntry="a region whose population is affected by a general disaster"/>
<rdf:Description rdf:about="&a;106304468">
	<b:glossaryEntry>a region in which military operations are in progress; "the army was in the field awaiting action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106304618"
	 b:glossaryEntry="a region marked off for administrative or other purposes"/>
<rdf:Description rdf:about="&a;106305263">
	<b:glossaryEntry>an enclosed territory that is culturally distinct from the foreign territory that surrounds it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106305411">
	<b:glossaryEntry>a district set apart as the seat of government of a federation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106305554">
	<b:glossaryEntry>a district where people live; occupied primarily by private residences</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106305885">
	<b:glossaryEntry>a residential part of town away from the central commercial district</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106306025"
	 b:glossaryEntry="a district with many brothels"/>
<rdf:Description rdf:about="&a;106306119"
	 b:glossaryEntry="a residential district located on the outskirts of a city"/>
<rdf:Description rdf:about="&a;106306329"
	 b:glossaryEntry="a residential area outside of a city and beyond suburbia"/>
<rdf:Description rdf:about="&a;106306439">
	<b:glossaryEntry>a suburban area laid out in streets and lots for a future residential area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106306568">
	<b:glossaryEntry>a New Orleans district lying outside the original city limits; used in combination with the names of various quarters of the city: "in Faubourg Sainte Marie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106306799">
	<b:glossaryEntry>a residential district occupied primarily with tenement houses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106306925"
	 b:glossaryEntry="(computer science) the space available on a magnetic disk"/>
<rdf:Description rdf:about="&a;106307088">
	<b:glossaryEntry>(computer science) the disk space required for non-data information (used for location and timing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106307257"
	 b:glossaryEntry="the disk space that is set aside for virtual memory"/>
<rdf:Description rdf:about="&a;106307377"
	 b:glossaryEntry='a distant region; "I could see it in the distance"'/>
<rdf:Description rdf:about="&a;106307482">
	<b:glossaryEntry>territory over which rule or control is exercised; "his domain extended into Europe"; "he made it the law of the land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106307923"
	 b:glossaryEntry="the domain controlled by an archduke or archduchess"/>
<rdf:Description rdf:about="&a;106308030"
	 b:glossaryEntry="the domain of a baron"/>
<rdf:Description rdf:about="&a;106308104"
	 b:glossaryEntry="the domain controlled by a duke or duchess"/>
<rdf:Description rdf:about="&a;106308208"
	 b:glossaryEntry="the domain controlled by an earl or count or countess"/>
<rdf:Description rdf:about="&a;106308315"
	 b:glossaryEntry="the domain controlled by an emir"/>
<rdf:Description rdf:about="&a;106308401"
	 b:glossaryEntry="the domain ruled by an emperor or empress"/>
<rdf:Description rdf:about="&a;106308549"
	 b:glossaryEntry="the domain controlled by a grand duke or grand duchess"/>
<rdf:Description rdf:about="&a;106308661"
	 b:glossaryEntry="the domain controlled by a viscount or viscountess"/>
<rdf:Description rdf:about="&a;106308767"
	 b:glossaryEntry="the domain ruled by a king or queen"/>
<rdf:Description rdf:about="&a;106308864">
	<b:glossaryEntry>(Arthurian legends) the capital of King Arthur''s kingdom; according to the legend, truth and goodness and beauty reigned there</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106309044"
	 b:glossaryEntry="territory ruled by a prince"/>
<rdf:Description rdf:about="&a;106309196"
	 b:glossaryEntry="the domain over which God is spiritually sovereign"/>
<rdf:Description rdf:about="&a;106309307"
	 b:glossaryEntry="the domain ruled by a sheik"/>
<rdf:Description rdf:about="&a;106309401"
	 b:glossaryEntry="the domain of a suzerain"/>
<rdf:Description rdf:about="&a;106309482">
	<b:glossaryEntry>the set of values of the independent variable for which a function is defined</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106309630"
	 b:glossaryEntry="a person''s legal place of residence"/>
<rdf:Description rdf:about="&a;106309747">
	<b:glossaryEntry xml:space='preserve'><![CDATA[where you live; "deliver the package to my home"; "he doesn''t have a home to go to"; "your place or mine?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106309912"
	 b:glossaryEntry="the address at which a business is located"/>
<rdf:Description rdf:about="&a;106310017"
	 b:glossaryEntry="a piece of land where waste materials are dumped"/>
<rdf:Description rdf:about="&a;106310239">
	<b:glossaryEntry>a holiday resort offering ranch activities (riding and camping)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106310359">
	<b:glossaryEntry>(archeology) a mound of domestic refuse containing shells and animal bones marking the site of a prehistoric settlement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106310565">
	<b:glossaryEntry>the range within which a voice can be heard; "the children were told to stay within earshot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106310732"
	 b:glossaryEntry='the range of the eye; "they were soon out of view"'/>
<rdf:Description rdf:about="&a;106310843">
	<b:glossaryEntry>the abode of mortals (as contrasted with heaven or hell); "it was hell on earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106310975">
	<b:glossaryEntry>the hemisphere that includes Eurasia and Africa and Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106311186">
	<b:glossaryEntry>the regions of the world that were known to Europeans before the discovery of the Americas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106311351"
	 b:glossaryEntry="the countries of Asia"/>
<rdf:Description rdf:about="&a;106311469">
	<b:glossaryEntry>a popular expression for the countries of eastern Asia (usually including China and Mongolia and Taiwan and Japan and Korea and Indochina and eastern Siberia)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106311701"
	 b:glossaryEntry="any region lying in or toward the north"/>
<rdf:Description rdf:about="&a;106311854"
	 b:glossaryEntry="any region lying in or toward the south"/>
<rdf:Description rdf:about="&a;106311975">
	<b:glossaryEntry>the region of the United States lying north of the Ohio River and east of the Mississippi River</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106312253"
	 b:glossaryEntry="the southeastern region of the United States"/>
<rdf:Description rdf:about="&a;106312372"
	 b:glossaryEntry="the southwestern region of the United States"/>
<rdf:Description rdf:about="&a;106312491"
	 b:glossaryEntry="the northeastern region of the United States"/>
<rdf:Description rdf:about="&a;106312610"
	 b:glossaryEntry="the northwestern region of the United States"/>
<rdf:Description rdf:about="&a;106312748"
	 b:glossaryEntry="the north central region of the United States"/>
<rdf:Description rdf:about="&a;106313070">
	<b:glossaryEntry>urban areas in New England and Middle West characterized by concentrations of declining industries (steel or textiles)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106313243">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the great circle representing the apparent annual path of the sun; the plane of the Earth''s orbit around the sun; makes an angle of about 23 degrees with the equator; "all of the planets rotate the sun in approximately the same ecliptic"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106313535"
	 b:glossaryEntry="(Welsh myth) the other world; land of fairies"/>
<rdf:Description rdf:about="&a;106313641">
	<b:glossaryEntry>a beautiful garden where Adam and Eve were placed at the Creation; when they disobeyed and ate the forbidden fruit from the tree of knowledge of good and evil they were driven from their paradise (the fall of man)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106313922"
	 b:glossaryEntry="any place of complete bliss and delight and peace"/>
<rdf:Description rdf:about="&a;106314081"
	 b:glossaryEntry="the boundary of a surface"/>
<rdf:Description rdf:about="&a;106314184">
	<b:glossaryEntry>an imaginary place of great wealth and opportunity; sought in South America by 16th-century explorers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106314352">
	<b:glossaryEntry>a heavenly place--preaceful and beautiful--where those who are favored by the gods can go when they die</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106314548">
	<b:glossaryEntry>fictitious land described in the novel Erewhon by Samuel Butler</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106314665"
	 b:glossaryEntry="an imaginary realm of marvels or wonders"/>
<rdf:Description rdf:about="&a;106314762">
	<b:glossaryEntry>a boundary marking the extremities of something: "the end of town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106314878">
	<b:glossaryEntry>either extremity of something that has length: "the end of the pier"; "she knotted the end of the thread"; "they had reached the end of the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106315235"
	 b:glossaryEntry="a point of termination or completion"/>
<rdf:Description rdf:about="&a;106315338">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the surface at either extremity of a three-dimensional object: "one end of the box was marked `This side up''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106315497">
	<b:glossaryEntry>one of two places from which people are communicating to each other; "the phone rang at the other end" or "both ends wrote at the same time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106315687">
	<b:glossaryEntry>the area in which something exists or lives: "the country--the flat agricultural surround"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106315998">
	<b:glossaryEntry>the surrounding environment; "fish require an aqueous medium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106316112">
	<b:glossaryEntry>the context and environment in which something is set: "the perfect setting for a ghost story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106316268">
	<b:glossaryEntry>the most favorable environment for a plant or animal; "water is the element of fishes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106316408">
	<b:glossaryEntry>an imaginary line around the Earth forming the great circle that is equidistant from the north and south poles; "the equator is the boundary between the northern and southern hemispheres"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106316649"
	 b:glossaryEntry="the outermost or farthest region or point"/>
<rdf:Description rdf:about="&a;106316818"
	 b:glossaryEntry="the point located farthest from the middle of something"/>
<rdf:Description rdf:about="&a;106316972">
	<b:glossaryEntry>the area between the tee and putting green where the grass is cut short</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106317116"
	 b:glossaryEntry="the enchanted realm of fairies"/>
<rdf:Description rdf:about="&a;106317219"
	 b:glossaryEntry="a rural area where farming is practiced"/>
<rdf:Description rdf:about="&a;106317328">
	<b:glossaryEntry>somewhere (away from a studio or office or library or laboratory) where practical work is done or data is collected; "anthropologists do much of their work in the field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106317549">
	<b:glossaryEntry>a piece of land cleared of trees and usually enclosed; "he planted a field of wheat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106317793">
	<b:glossaryEntry>a tract of land cleared for some special purposes (recreation or burial etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106317924"
	 b:glossaryEntry="a field where grass or alfalfa are grown to be made into hay"/>
<rdf:Description rdf:about="&a;106318048">
	<b:glossaryEntry>a piece of land prepared for playing a game; "the home crowd cheered when Princeton took the field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106318375"
	 b:glossaryEntry="the part of a city where medical facilities are centered"/>
<rdf:Description rdf:about="&a;106318511">
	<b:glossaryEntry>the middle part of a playing field (as in football or lacrosse)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106318648"
	 b:glossaryEntry="a line indicating the location of the finish of a race"/>
<rdf:Description rdf:about="&a;106318813">
	<b:glossaryEntry>a narrow field that has been cleared to check the spread of a prairie fire or forest fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106318970"
	 b:glossaryEntry="the line from which soldiers deliver fire"/>
<rdf:Description rdf:about="&a;106319069">
	<b:glossaryEntry>an open-air street market for inexpensive or secondhand articles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106319191">
	<b:glossaryEntry>a street in central London where newspaper offices are situated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106319332">
	<b:glossaryEntry>a fixed reference point on the concave side of a conic section</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106319446">
	<b:glossaryEntry>the part in the front or nearest the viewer; "he was in the forefront"; "he was at the head of the column"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106319615">
	<b:glossaryEntry>lines through 1st and 3rd base indicating the boundaries of a baseball field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106319747"
	 b:glossaryEntry="a line across a bowling alley that a bowler must not cross"/>
<rdf:Description rdf:about="&a;106319861"
	 b:glossaryEntry="a line from which basketball players take penalty shots"/>
<rdf:Description rdf:about="&a;106319972">
	<b:glossaryEntry>the lines a baseball player must follow while running the bases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106320090"
	 b:glossaryEntry="the back line at each end of a tennis court"/>
<rdf:Description rdf:about="&a;106320188">
	<b:glossaryEntry>the part of the Earth''s surface forming a cap over a pole; characterized by frigid climate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106320385"
	 b:glossaryEntry="the side that is forward or prominent"/>
<rdf:Description rdf:about="&a;106320533"
	 b:glossaryEntry="the line along which opposing armies face each other"/>
<rdf:Description rdf:about="&a;106320683"
	 b:glossaryEntry="an accumulation of refuse and discarded matter"/>
<rdf:Description rdf:about="&a;106320865">
	<b:glossaryEntry>a location where toxic wastes have been disposed of (often illegally)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106321016"
	 b:glossaryEntry="a favorite haunt where people gather"/>
<rdf:Description rdf:about="&a;106321114"
	 b:glossaryEntry="a place where the wicked are punished after death"/>
<rdf:Description rdf:about="&a;106321228"
	 b:glossaryEntry="a demarcated area of the Earth"/>
<rdf:Description rdf:about="&a;106323560">
	<b:glossaryEntry>the point on the Earth''s surface directly above the focus of an earthquake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106323702">
	<b:glossaryEntry>a region subject to dust storms; especially the central region of United States subject to dust storms in the 1930s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106323892">
	<b:glossaryEntry>an area of the Earth determined by distribution of flora and fauna</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106324045">
	<b:glossaryEntry>a region including the bottom of the sea and the littoral zones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106324198"
	 b:glossaryEntry="a point on the surface of the Earth"/>
<rdf:Description rdf:about="&a;106324443">
	<b:glossaryEntry>a residential district of a city in which Jews are required to live</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106324563">
	<b:glossaryEntry>a line marking each end of the playing field or pitch; where the goals stand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106324695"
	 b:glossaryEntry="a district where gold is mined"/>
<rdf:Description rdf:about="&a;106324781"
	 b:glossaryEntry="a field where grain is grown"/>
<rdf:Description rdf:about="&a;106324902">
	<b:glossaryEntry>a circular line on the surface of a sphere formed by intersecting it with a plane passing through the center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106325195">
	<b:glossaryEntry>an area of closely cropped grass surrounding the hole on a golf course</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106325352"
	 b:glossaryEntry="a belt of parks or rural land surrounding a town or city"/>
<rdf:Description rdf:about="&a;106325475">
	<b:glossaryEntry>a position to be won or defended in battle (or as if in battle); "they gained ground step by step"; "they fought to regain the lost ground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106325667">
	<b:glossaryEntry>the type of environment in which an organism or group normally lives or occurs: "a marine habitat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106325837"
	 b:glossaryEntry="the native habitat or home of an animal or plant"/>
<rdf:Description rdf:about="&a;106325978">
	<b:glossaryEntry>a position some distance below the top of the mast to which a flag is lowered in mourning or to signal distress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106326145">
	<b:glossaryEntry>a place where eggs are hatched under artificial conditions (especially fish eggs); "the park authorities operated a trout hatchery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106326331"
	 b:glossaryEntry="a frequently visited place"/>
<rdf:Description rdf:about="&a;106326473">
	<b:glossaryEntry>an area near a fireplace (usually paved and extending out into a room)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106326607">
	<b:glossaryEntry>the abode of God and the angels and the souls of those who have gained salvation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106326830"
	 b:glossaryEntry="an area in which game is hunted"/>
<rdf:Description rdf:about="&a;106326922">
	<b:glossaryEntry>the lowest region of the ionosphere (35 to 50 miles up) that reflects low-frequency radio waves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106327101">
	<b:glossaryEntry>the highest region of the ionosphere (from 90 to 600 miles up) that contains the highest concentration of free electrons and is most useful for long-range radio transmission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106327375">
	<b:glossaryEntry>a region of the ionosphere (from 50 to 90 miles up) that reflects radio waves of medium length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106327598">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(in various religions) the world of the dead; "he didn''t want to go to hell when he died"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106327882">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(Christianity) the abode of Satan and the forces of evil; where sinners suffer eternal punishment: "Hurl''d headlong...To bottomless perdition, there to dwell"- John Milton; "a demon from the depths of the pit"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106328262">
	<b:glossaryEntry>a place of eternal fire envisaged as punishment for the damned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106328392">
	<b:glossaryEntry xml:space='preserve'><![CDATA[any place of pain and turmoil: "the hell of battle"; "the inferno of the engine room"; "when you''re alone Christmas is the pits";]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106328609"
	 b:glossaryEntry="half of the terrestrial globe"/>
<rdf:Description rdf:about="&a;106328786"
	 b:glossaryEntry="the line formed by the lower edge of a skirt or coat"/>
<rdf:Description rdf:about="&a;106328949"
	 b:glossaryEntry="a breeding ground for herons; a heron rookery"/>
<rdf:Description rdf:about="&a;106329048"
	 b:glossaryEntry="the line formed by the lower edge of hip-length garment"/>
<rdf:Description rdf:about="&a;106329176"
	 b:glossaryEntry="the line formed by measuring the hip at its greatest part"/>
<rdf:Description rdf:about="&a;106329287">
	<b:glossaryEntry>a predetermined hiding place for the deposit and distribution of illicit goods (such as drugs or stolen property)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106329451"
	 b:glossaryEntry="a hiding place; usually a remote place used by outlaws"/>
<rdf:Description rdf:about="&a;106329576"
	 b:glossaryEntry="a place suitable for lurking"/>
<rdf:Description rdf:about="&a;106329664"
	 b:glossaryEntry="a place suitable for hiding something (such as yourself)"/>
<rdf:Description rdf:about="&a;106329833">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a high place; "they stood on high and observed the coutryside" or "he doesn''t like heights"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106329985">
	<b:glossaryEntry>the peak of a hill; "the sun set behind the brow of distant hills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106330112"
	 b:glossaryEntry="a sacred place of pilgrimage"/>
<rdf:Description rdf:about="&a;106330214">
	<b:glossaryEntry>place where something began and flourished; "the U.S. is the home of basketball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106330345">
	<b:glossaryEntry>a spatially constricted by concentrated source (especially of radiation or pollution)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106330489"
	 b:glossaryEntry="the area in which an animal normally ranges"/>
<rdf:Description rdf:about="&a;106330606"
	 b:glossaryEntry="the line at which the sky and Earth appear to meet"/>
<rdf:Description rdf:about="&a;106330795">
	<b:glossaryEntry>the great circle on the celestial sphere whose plane passes through the sensible horizon and the center of the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106330985">
	<b:glossaryEntry>either of two belts or regions near 30N or 30S characterized by calms and light baffling winds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106331140">
	<b:glossaryEntry>the angular distance along the celestial equator from the observer''s meridian to the hour circle of a given celestial body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106331319">
	<b:glossaryEntry>a great circle on the celestial sphere that passes through both celestial poles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106331456">
	<b:glossaryEntry>the place within a bishop''s diocese where his cathedral is located</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106331609"
	 b:glossaryEntry="a field where junk is collected and stored for resale"/>
<rdf:Description rdf:about="&a;106331717"
	 b:glossaryEntry="the jurisdiction of a justiciar"/>
<rdf:Description rdf:about="&a;106331805"
	 b:glossaryEntry="a place said to exist in religious or fictional writings"/>
<rdf:Description rdf:about="&a;106332265"
	 b:glossaryEntry="a district that is reserved for particular purpose"/>
<rdf:Description rdf:about="&a;106332419"
	 b:glossaryEntry="a reservation set aside for the use of indians"/>
<rdf:Description rdf:about="&a;106332530"
	 b:glossaryEntry="a reservation where animals are protected"/>
<rdf:Description rdf:about="&a;106332644">
	<b:glossaryEntry>a preserve on which hunting is permitted during certain months of the year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106332782">
	<b:glossaryEntry>(British) a former administrative district of England; equivalent to a county</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106332930">
	<b:glossaryEntry>a tract at a distance from city center that is designed for a community of businesses and factories</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106333091"
	 b:glossaryEntry="the inner or enclosed surface of something"/>
<rdf:Description rdf:about="&a;106333215"
	 b:glossaryEntry="the region that is inside of something"/>
<rdf:Description rdf:about="&a;106333371"
	 b:glossaryEntry="the interior part of a country"/>
<rdf:Description rdf:about="&a;106333474">
	<b:glossaryEntry>the location of something surrounded by other things; "in the midst of the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106333615">
	<b:glossaryEntry>the outer region of the Earth''s atmosphere; contains a high concentration of free electrons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106333839">
	<b:glossaryEntry>a region that is related ethnically or historically to one country but is controlled politically by another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106334014">
	<b:glossaryEntry>an isogram connecting points having equal barometric pressure at a given time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106334144">
	<b:glossaryEntry>an isogram connecting points at which something occurs or arrives at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106334282">
	<b:glossaryEntry>a line drawn on a map connecting points having the same numerical value of some variable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106334518">
	<b:glossaryEntry>an isogram connecting points receiving equal amounts of sunshine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106334635">
	<b:glossaryEntry>an isogram connecting points having the same temperature at a given time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106334762"
	 b:glossaryEntry="in law; the territory within which power can be exercised"/>
<rdf:Description rdf:about="&a;106335076">
	<b:glossaryEntry>(informal) range of jurisdiction or influence: "a bureaucracy...chiefly concerned with turf...and protecting the retirement system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106335258"
	 b:glossaryEntry="a country with a king as head of state"/>
<rdf:Description rdf:about="&a;106335368"
	 b:glossaryEntry="the habitation of wild animals"/>
<rdf:Description rdf:about="&a;106335455"
	 b:glossaryEntry="a place for launching pads"/>
<rdf:Description rdf:about="&a;106335561"
	 b:glossaryEntry="a field of cultivated and mowed grass"/>
<rdf:Description rdf:about="&a;106335649">
	<b:glossaryEntry>a relatively thin sheetlike expanse or region lying over or under another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106336080">
	<b:glossaryEntry>(baseball) the position taken by a base runner preparing to advance to the next base; "he took a long lead off first"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106336248"
	 b:glossaryEntry="the side of something that is sheltered from the wind"/>
<rdf:Description rdf:about="&a;106336372">
	<b:glossaryEntry>an imaginary land inhabited by tiny people (in Swift''s Gulliver''s Travels)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106336501"
	 b:glossaryEntry="(theology) the abode of infants who die before baptism"/>
<rdf:Description rdf:about="&a;106336607"
	 b:glossaryEntry="an imaginary place for lost or neglected things"/>
<rdf:Description rdf:about="&a;106336706"
	 b:glossaryEntry="the boundary of a specific area"/>
<rdf:Description rdf:about="&a;106336894"
	 b:glossaryEntry="the limit on the upper (or northernmost) side of something"/>
<rdf:Description rdf:about="&a;106337010"
	 b:glossaryEntry="the limit on the lower (or southernmost) side of something"/>
<rdf:Description rdf:about="&a;106337126">
	<b:glossaryEntry>a mathematical value toward which a function goes as the independent variable approaches infinity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106337331"
	 b:glossaryEntry="as far as something can go"/>
<rdf:Description rdf:about="&a;106337463">
	<b:glossaryEntry>a spatial location defined by a real or imaginary unidimensional extent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106338089">
	<b:glossaryEntry>in games or sports; a mark indicating positions or bounds of the playing area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106338451">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a fortified position (especially one marking the most forward position of troops); "they attacked the enemy''s line"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106338689"
	 b:glossaryEntry="place where airplanes are parked"/>
<rdf:Description rdf:about="&a;106338779">
	<b:glossaryEntry>a line formed by troops or ships prepared to deliver or receive an attack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106338932">
	<b:glossaryEntry>(military) the part of the line of battle that projects closest to the enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106339081"
	 b:glossaryEntry="the line along which warring troops meet"/>
<rdf:Description rdf:about="&a;106339179">
	<b:glossaryEntry>the path along which a freely moving object travels through the air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106339307"
	 b:glossaryEntry="the route along which a column advances"/>
<rdf:Description rdf:about="&a;106339406"
	 b:glossaryEntry="a straight line along which an observer looks"/>
<rdf:Description rdf:about="&a;106339528">
	<b:glossaryEntry>the angular distance between an imaginary line around a heavenly body parallel to its equator and the equator itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106339699"
	 b:glossaryEntry="an imaginary line around the Earth parallel to the equator"/>
<rdf:Description rdf:about="&a;106339919"
	 b:glossaryEntry="an imaginary line around the moon parallel to its equator"/>
<rdf:Description rdf:about="&a;106340037"
	 b:glossaryEntry="the region of the shore of a lake or sea or ocean"/>
<rdf:Description rdf:about="&a;106340175"
	 b:glossaryEntry="a stop where carriers can be loaded and unloaded"/>
<rdf:Description rdf:about="&a;106340297">
	<b:glossaryEntry>waterlines to show the level the water should reach when the ship is properly loaded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106340480"
	 b:glossaryEntry="an elevated post affording a wide view"/>
<rdf:Description rdf:about="&a;106340609">
	<b:glossaryEntry>either of two points where the lines of force of the Earth''s magnetic field are vertical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106340757">
	<b:glossaryEntry>a cross-shaped monument set up in the marketplace of a town where public business is often conducted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106340916">
	<b:glossaryEntry>the point on a curve where the tangent changes from positive on the left to negative on the right</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106341085"
	 b:glossaryEntry="land where grass or grasslike vegetation grows"/>
<rdf:Description rdf:about="&a;106341277">
	<b:glossaryEntry>a place that attracts many visitors; "New York is a mecca for young artists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106341405">
	<b:glossaryEntry>an environment in which many ideas and races are socially assimilated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106341532">
	<b:glossaryEntry>an imaginary great circle on the surface of the earth passing through the north and south poles at right angles to the equator; "all points on the same meridian have the same longitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106341876"
	 b:glossaryEntry="a meridian that passes through the observer''s zenith"/>
<rdf:Description rdf:about="&a;106341994">
	<b:glossaryEntry>a meridian from which east and west are reckoned (usually the Greenwich (England) longitude)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106342147">
	<b:glossaryEntry>an imaginary line passing through both magnetic poles of the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106342277">
	<b:glossaryEntry>an imaginary line on the surface of the earth following (approximately) the 180th meridian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106342460">
	<b:glossaryEntry>one of a networks of observation posts where meteorological data is recorded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106342632">
	<b:glossaryEntry>some point in the air; above ground level; "the planes collided in midair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106342759"
	 b:glossaryEntry="the abode of humans in Norse mythology"/>
<rdf:Description rdf:about="&a;106342851">
	<b:glossaryEntry>the point on a curve where the tangent changes from negative on the left to positive on the right</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106343020">
	<b:glossaryEntry>an important site that is marked and preserved as public property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106343158">
	<b:glossaryEntry>a tract of low muddy land near an estuary; covered at high tide and exposed at low tide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106343300">
	<b:glossaryEntry>the point below the observer that is directly opposite the zenith on the imaginary sphere against which celestial bodies appear to be projected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106343532">
	<b:glossaryEntry>a tract of land declared by the national government to be public property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106343701">
	<b:glossaryEntry>the first national park in the United States; located in Wyoming; famous for Old Faithful geyser and for buffalo and bears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106343914">
	<b:glossaryEntry>a national park in California famous for its waterfalls and rock formations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106344077"
	 b:glossaryEntry="the center point or middle of something"/>
<rdf:Description rdf:about="&a;106344182"
	 b:glossaryEntry="a place suitable for nesting"/>
<rdf:Description rdf:about="&a;106344270"
	 b:glossaryEntry="a pleasing country existing only in dreams or imagination"/>
<rdf:Description rdf:about="&a;106344415"
	 b:glossaryEntry="an unoccupied area between opposing armies"/>
<rdf:Description rdf:about="&a;106344533"
	 b:glossaryEntry="the center point on a shield"/>
<rdf:Description rdf:about="&a;106344615">
	<b:glossaryEntry>the celestial pole above the northern hemisphere; near Polaris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106344744"
	 b:glossaryEntry="the hemisphere north of the equator"/>
<rdf:Description rdf:about="&a;106344902"
	 b:glossaryEntry="the northernmost point of the Earth''s axis"/>
<rdf:Description rdf:about="&a;106345001"
	 b:glossaryEntry="the country of origin of an immigrant"/>
<rdf:Description rdf:about="&a;106345096">
	<b:glossaryEntry>the (usually elliptical) path described by one celestial body in its revolution about another; "he plotted the orbit of the moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106345333">
	<b:glossaryEntry>a circular orbit around the Earth having a period of 24 hours; a satellite in such an orbit will be stationary relative to the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106345554"
	 b:glossaryEntry="the line that appears to bound an object"/>
<rdf:Description rdf:about="&a;106345702"
	 b:glossaryEntry="the outline of a coast"/>
<rdf:Description rdf:about="&a;106345780">
	<b:glossaryEntry>a side view representation of an object (especially a human face)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106345899"
	 b:glossaryEntry="an outline of a solid object (as cast by its shadow)"/>
<rdf:Description rdf:about="&a;106346008"
	 b:glossaryEntry="the outer side or surface of something"/>
<rdf:Description rdf:about="&a;106346129"
	 b:glossaryEntry="the region that is outside of something"/>
<rdf:Description rdf:about="&a;106346269">
	<b:glossaryEntry>where the air is unconfined; "he wanted to get out in the air a little"; "the concert was held in the open air"; "camping in the open"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106346497"
	 b:glossaryEntry="a station in a remote or sparsely populated location"/>
<rdf:Description rdf:about="&a;106346616"
	 b:glossaryEntry="a high place affording a good view"/>
<rdf:Description rdf:about="&a;106346705"
	 b:glossaryEntry="an irrigated or flooded field where rice is grown"/>
<rdf:Description rdf:about="&a;106346833">
	<b:glossaryEntry>a relatively narrow strip of land projecting from some larger area; "Wheeling is located in the northern panhandle of West Virginia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106347021"
	 b:glossaryEntry="an area for holding parades"/>
<rdf:Description rdf:about="&a;106347108"
	 b:glossaryEntry="an open area for holding fairs or exhibitions or circuses"/>
<rdf:Description rdf:about="&a;106347222">
	<b:glossaryEntry>the place at a fair or carnival where sideshows and similar amusements are located</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106347376"
	 b:glossaryEntry="a tract of ground free of obstacles to movement"/>
<rdf:Description rdf:about="&a;106347477"
	 b:glossaryEntry="the local subdivision of a diocese committed to one pastor"/>
<rdf:Description rdf:about="&a;106347607">
	<b:glossaryEntry>a large area of land preserved in its natural state as public property; "there are laws that protect the wildlife in this park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106347803">
	<b:glossaryEntry>a piece of open land for recreational use in an urban area; "they went for a walk in the park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106348048"
	 b:glossaryEntry="a lot where cars are parked"/>
<rdf:Description rdf:about="&a;106348159"
	 b:glossaryEntry="a space where an automobile can be parked"/>
<rdf:Description rdf:about="&a;106348260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the local environment; "he hasn''t been seen around these parts in years"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106348384">
	<b:glossaryEntry>a field covered with grass or herbage and suitable for grazing by livestock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106348591"
	 b:glossaryEntry="an established line of travel or access"/>
<rdf:Description rdf:about="&a;106349031"
	 b:glossaryEntry='the most direct route; "he made a beeline for the bathroom"'/>
<rdf:Description rdf:about="&a;106349144"
	 b:glossaryEntry="a diagonal path"/>
<rdf:Description rdf:about="&a;106349214"
	 b:glossaryEntry="a route over which supplies can be delivered"/>
<rdf:Description rdf:about="&a;106349331"
	 b:glossaryEntry="the path of a missile discharged from a firearm"/>
<rdf:Description rdf:about="&a;106349437"
	 b:glossaryEntry="the geographic route along which birds customarily migrate"/>
<rdf:Description rdf:about="&a;106349566">
	<b:glossaryEntry>the usual course taken by vessels through a harbor or costal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106349687"
	 b:glossaryEntry="the jurisdiction of a patriarch"/>
<rdf:Description rdf:about="&a;106349777">
	<b:glossaryEntry>the top point of a mountain or hill; "the view from the peak was magnificent"; "they clambered to the summit of Monadnock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106350041">
	<b:glossaryEntry>(astronomy) the point in as orbit closest to the body being orbited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106350312">
	<b:glossaryEntry>periapsis in Earth orbit; the point in its orbit where a satellite is nearest to the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106350474">
	<b:glossaryEntry>periapsis in solar orbit; the point in the orbit of a planet or comet where it is nearest to the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106350649"
	 b:glossaryEntry="periapsis in orbit around Jupiter"/>
<rdf:Description rdf:about="&a;106350755"
	 b:glossaryEntry="periapsis in orbit around the moon"/>
<rdf:Description rdf:about="&a;106350893"
	 b:glossaryEntry="a breeding ground for epidemic disease"/>
<rdf:Description rdf:about="&a;106350986"
	 b:glossaryEntry="a tract of land set aside for picnicking"/>
<rdf:Description rdf:about="&a;106351100"
	 b:glossaryEntry="a lofty peak"/>
<rdf:Description rdf:about="&a;106351167"
	 b:glossaryEntry="a treeless grassy plain"/>
<rdf:Description rdf:about="&a;106351262"
	 b:glossaryEntry="an open area at the meeting of two or more streets"/>
<rdf:Description rdf:about="&a;106351418">
	<b:glossaryEntry>a public square with room for pedestrians; "they met at Elm Plaza"; "Grosvenor Place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106351572"
	 b:glossaryEntry="an area where tollbooths are located"/>
<rdf:Description rdf:about="&a;106351684">
	<b:glossaryEntry>the precise location of something; a spatially limited location; "she walked to a point where she could survey the whole street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106352296"
	 b:glossaryEntry="point of contact between two objects or parts"/>
<rdf:Description rdf:about="&a;106352396">
	<b:glossaryEntry>one of two antipodal points where the Earth''s axis of rotation intersects the Earth''s surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106352576">
	<b:glossaryEntry>one of two points of intersection of the Earth''s axis and the celestial sphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106352758"
	 b:glossaryEntry="the place where people vote"/>
<rdf:Description rdf:about="&a;106352837">
	<b:glossaryEntry>the particular portion of space occupied by a physical object: "he put the lamp back in its place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106353358">
	<b:glossaryEntry>the appropriate or customary location; "the cars were in position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106353479"
	 b:glossaryEntry="a point occupied by troops for tactical reasons"/>
<rdf:Description rdf:about="&a;106353637">
	<b:glossaryEntry>(astronomy) position of a planet as defined by its angular distance from its perihelion (as observed from the sun)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106353805"
	 b:glossaryEntry="physical position in relation to the surroundings"/>
<rdf:Description rdf:about="&a;106353917">
	<b:glossaryEntry>the physical position of something; "he changed the setting on the thermostat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106354049"
	 b:glossaryEntry="position or manner in which something is situated"/>
<rdf:Description rdf:about="&a;106354148">
	<b:glossaryEntry>the position where something or someone (as a guard or sentry) stands or is assigned to stand: "a sentry station"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106354376">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(British) a vendor''s position (especially on the sidewalk); "he was employed to see that his paper''s news pitches were not trespassed upon by rival vendors"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106354584">
	<b:glossaryEntry>the position of a prominent or well-known object in a particular landscape; "the church steeple provided a convenient landmark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106354766">
	<b:glossaryEntry>location near or direction toward the right side; i.e. the side to the south when a person or object faces east: "he stood on the right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106354990"
	 b:glossaryEntry="the part of the stage on the actor''s right"/>
<rdf:Description rdf:about="&a;106355123">
	<b:glossaryEntry>location near or direction toward the left side; i.e. the side to the north when a person or object faces east: "she stood on the left"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106355345"
	 b:glossaryEntry="the part of the stage on the actor''s left"/>
<rdf:Description rdf:about="&a;106355475">
	<b:glossaryEntry>the part of something that is furthest from the normal viewer: "he stood at the back of the stage"; "it was hidden in the rear of the store"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106355691">
	<b:glossaryEntry>the part of something that is nearest to the normal viewer; "he walked to the front of the stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106355858">
	<b:glossaryEntry>an urban district having corporate status and powers of self-government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106356061"
	 b:glossaryEntry="an elevated place serving as a seat"/>
<rdf:Description rdf:about="&a;106356148"
	 b:glossaryEntry="a cemetery for unknown or indigent people"/>
<rdf:Description rdf:about="&a;106356250">
	<b:glossaryEntry>the district administered by a prefect (as in France or Japan or the Roman Empire)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106356389">
	<b:glossaryEntry>land and buildings together considered as a place of business; "bread is baked on the premises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106356539"
	 b:glossaryEntry="the goal towards which Christians strive"/>
<rdf:Description rdf:about="&a;106356639">
	<b:glossaryEntry>a territory controlled by (but not a possession of) a stronger state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106356766">
	<b:glossaryEntry>(theology) a place where Roman Catholics think those who have died in a state of grace undergo limited torment to expiate their sins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106356954"
	 b:glossaryEntry="the area enclosed by two perpendicular radii of a circle"/>
<rdf:Description rdf:about="&a;106357065">
	<b:glossaryEntry>any of the four areas into which a plane is divided by two orthogonal coordinate axes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106357205"
	 b:glossaryEntry="a quarter of the circumference of a circle"/>
<rdf:Description rdf:about="&a;106357319">
	<b:glossaryEntry>a district of a city having some distinguishing character; "the Latin Quarter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106357451">
	<b:glossaryEntry>a circular region whose area is indicated by the length of its radius; "they located it within a radius of 2 miles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106357619">
	<b:glossaryEntry>the limits within which something can be effective; "he was beyond the range of their fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106357824">
	<b:glossaryEntry>a large tract of grassy open land on which livestock can graze; "they used to drive the cattle across the open range every spring"; "he dreamed of a home on the range"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106358061">
	<b:glossaryEntry>the limits of the values a function can take; "the range of this function is the interval from 0 to 1"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106358233">
	<b:glossaryEntry>the side of an object that is opposite its front; "his room was toward the rear of the hotel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106358453">
	<b:glossaryEntry>direction toward the rear; "his outfit marched to the rearward of the tank divisions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106358593"
	 b:glossaryEntry="a line that is colored red bisects an ice hockey rink"/>
<rdf:Description rdf:about="&a;106358701">
	<b:glossaryEntry>the extended spatial location of something; "the farming regions of France"; "religions in all parts of the world"; "regions of outer space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106359477">
	<b:glossaryEntry>a large indefinite location on the surface of the Earth; "penguins inhabit the polar regions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106359911">
	<b:glossaryEntry>any two places or regions on diametrically opposite sides of the Earth; "the North Pole and the South Pole are antipodes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106360088">
	<b:glossaryEntry>the distance that a rifle bullet will carry; "the target was out of rifle range"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106360239">
	<b:glossaryEntry>an unknown and unexplored region; "they came like angels out the unknown"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106360401">
	<b:glossaryEntry>an area where troops and equipment in transit are assembled before a military operation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106360547">
	<b:glossaryEntry>a clear or unobstructed space or expanse of land or water: "finally broke out of the forest into the open"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106360712">
	<b:glossaryEntry>a line on a sphere that cuts all meridians at the same angle; the path taken by a ship or plane that maintains a constant compass direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106360928">
	<b:glossaryEntry>an arc of the celestial equator eastward from the vernal equinox</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106361054">
	<b:glossaryEntry>the area of a city (such as a harbor or dockyard) alongside a body of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106361222"
	 b:glossaryEntry="the waterfront of a seaside town"/>
<rdf:Description rdf:about="&a;106361328">
	<b:glossaryEntry>a place (seaport or airport) where people and merchandise can enter or leave a country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106361627">
	<b:glossaryEntry>a port where merchandise can be imported and re-exported with paying import duties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106361787"
	 b:glossaryEntry="a port open on equal terms to all commercial vessels"/>
<rdf:Description rdf:about="&a;106361895">
	<b:glossaryEntry>(British) a subsidiary port built in deeper water than the original port (but usually farther from the center of trade)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106362068">
	<b:glossaryEntry>a port where customs officials are stationed to oversee the entry and exit of people and merchandise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106362245"
	 b:glossaryEntry="a place where ships can take on or discharge cargo"/>
<rdf:Description rdf:about="&a;106362487"
	 b:glossaryEntry="a seaport where ships can take on supplies of coal"/>
<rdf:Description rdf:about="&a;106362599"
	 b:glossaryEntry="any port where a ship stops except its home port"/>
<rdf:Description rdf:about="&a;106362706">
	<b:glossaryEntry>an area adjoining a port where goods that are intended for reshipment can be received and stored without payment of duties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106362896"
	 b:glossaryEntry="place for vessels to anchor"/>
<rdf:Description rdf:about="&a;106363053">
	<b:glossaryEntry>a port in China or Korea or Japan that once was open to foreign trade on the basis of a trading treaty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106363213"
	 b:glossaryEntry="a place where a craft can be made fast"/>
<rdf:Description rdf:about="&a;106363330"
	 b:glossaryEntry="a partly sheltered anchorage"/>
<rdf:Description rdf:about="&a;106363422">
	<b:glossaryEntry>an establishment on the waterfront where vessels are built or fitted out or repaired</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106363561"
	 b:glossaryEntry="an area where many people go for recreation"/>
<rdf:Description rdf:about="&a;106363739">
	<b:glossaryEntry>the part of a golf course bordering the fairway where the grass is not cut short</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106363890">
	<b:glossaryEntry>a surrounding or nearby region; "the plane crashed in the vicinty of Asheville"; "it is a rugged locality"; "he always blames someone else in the immediate neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106364246"
	 b:glossaryEntry='a general vicinity; "He comes from a place near Chicago"'/>
<rdf:Description rdf:about="&a;106364354">
	<b:glossaryEntry>a rectangular area in a city surrounded by streets and usually containing several buildings; "he lives in the next block"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106364540"
	 b:glossaryEntry="the region close around a person or thing"/>
<rdf:Description rdf:about="&a;106364655">
	<b:glossaryEntry>the immediate proximity of someone or something; "she blushed in his presence"; "he sensed the presence of danger"; "he was well behaved in front of company"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106364875">
	<b:glossaryEntry>a place where people meet; "he was waiting for them at the rendezvous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106365002"
	 b:glossaryEntry="a place of privacy; a place affording peace and quiet"/>
<rdf:Description rdf:about="&a;106365181"
	 b:glossaryEntry="a sheltered and secluded place"/>
<rdf:Description rdf:about="&a;106365262"
	 b:glossaryEntry="a cosy or secluded retreat"/>
<rdf:Description rdf:about="&a;106365339">
	<b:glossaryEntry>a pleasant and secluded part of a garden; usually attached to a mansion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106365466">
	<b:glossaryEntry>an imaginary kingdom somewhere in central Europe; a setting for romance and adventure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106365607"
	 b:glossaryEntry='a safe place; "He ran to safety"'/>
<rdf:Description rdf:about="&a;106365719"
	 b:glossaryEntry="a place of refuge (as for a ship)"/>
<rdf:Description rdf:about="&a;106365821"
	 b:glossaryEntry='a dangerous place; "He moved out of danger"'/>
<rdf:Description rdf:about="&a;106365917"
	 b:glossaryEntry="a line beyond which it is dangerous to go"/>
<rdf:Description rdf:about="&a;106366016"
	 b:glossaryEntry="a breeding ground for gregarious birds (such as rooks)"/>
<rdf:Description rdf:about="&a;106366142">
	<b:glossaryEntry>the boundary in ancient times between Italy and Gaul; Caesar''s crossing it with his army in 49 BC was an act of war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106366311">
	<b:glossaryEntry>an area outside of cities and towns; "his poetry celebrated the slower pace of life in the country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106366622"
	 b:glossaryEntry="rural regions"/>
<rdf:Description rdf:about="&a;106366693"
	 b:glossaryEntry="an uncultivated region covered with scrub vegetation"/>
<rdf:Description rdf:about="&a;106366801"
	 b:glossaryEntry="(Brit) an area of open or forested country"/>
<rdf:Description rdf:about="&a;106366895"
	 b:glossaryEntry="a tract of open rolling country (especially upland)"/>
<rdf:Description rdf:about="&a;106366997"
	 b:glossaryEntry="a place of inviolable privacy"/>
<rdf:Description rdf:about="&a;106367080"
	 b:glossaryEntry="a vacant lot used by city boys to play games"/>
<rdf:Description rdf:about="&a;106367178"
	 b:glossaryEntry="a flat grassland in tropical or subtropical regions"/>
<rdf:Description rdf:about="&a;106367294">
	<b:glossaryEntry>the place where some action occurs; "the police returned to the scene of the crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106367501"
	 b:glossaryEntry='an illuminated area; "he stepped into the light"'/>
<rdf:Description rdf:about="&a;106367601"
	 b:glossaryEntry='an unilluminated area; "he moved off into the darkness"'/>
<rdf:Description rdf:about="&a;106367727">
	<b:glossaryEntry xml:space='preserve'><![CDATA[any scene regarded as a setting for exhibiting or doing something; "All the world''s a stage"--Shakespeare; "it set the stage for peaceful negotiations"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106367930"
	 b:glossaryEntry="the appearance of a place"/>
<rdf:Description rdf:about="&a;106368045"
	 b:glossaryEntry="an expanse of scenery that can be seen in a single view"/>
<rdf:Description rdf:about="&a;106368156"
	 b:glossaryEntry="a view of the sea"/>
<rdf:Description rdf:about="&a;106368228"
	 b:glossaryEntry="the yard associated with a school"/>
<rdf:Description rdf:about="&a;106368318"
	 b:glossaryEntry="the yard associated with a church"/>
<rdf:Description rdf:about="&a;106368421"
	 b:glossaryEntry="a place that is scoured (especially by running water)"/>
<rdf:Description rdf:about="&a;106368526">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a space reserved for sitting (as in a theater or on a train or airplane); "he booked their seats in advance"; "he sat in someone else''s place"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106368745">
	<b:glossaryEntry>a center of authority (as a city from which authority is exercised)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106368935">
	<b:glossaryEntry>(geometry) the area created by a plane cutting through a solid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106369085">
	<b:glossaryEntry>a distinct region or subdivision of a territorial or political area or community or group of people; "no section of the nation is more ardent than the South"; "there are three synagogues in the Jewish section"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106369402"
	 b:glossaryEntry="a portion of a military position"/>
<rdf:Description rdf:about="&a;106369506">
	<b:glossaryEntry>place on a highway providing garage services and eating and toilet facilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106369642">
	<b:glossaryEntry>a place that is frequently exhibited and visited for its historical interest or natural beauty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106369792"
	 b:glossaryEntry="an area where a number of shrubs are planted"/>
<rdf:Description rdf:about="&a;106369892">
	<b:glossaryEntry>a line segment forming part of the perimeter of a plane figure; "the hypotenuse of a right triangle is always the longest side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106370070">
	<b:glossaryEntry>a place within a region identified relative to a center or reference location; "they always sat on the right side of the church"; "he never left my side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106370418"
	 b:glossaryEntry="the region adjacent to a boat dock"/>
<rdf:Description rdf:about="&a;106370507"
	 b:glossaryEntry="the side that is on the north"/>
<rdf:Description rdf:about="&a;106370593"
	 b:glossaryEntry="the side that is on the east"/>
<rdf:Description rdf:about="&a;106370677"
	 b:glossaryEntry="the side that is on the west"/>
<rdf:Description rdf:about="&a;106370761"
	 b:glossaryEntry="the side that is on the south"/>
<rdf:Description rdf:about="&a;106370847">
	<b:glossaryEntry>space by the side of a bed (especially the bed of a sick or dying person); "the doctor stood at her bedside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106371009">
	<b:glossaryEntry>a position given by its location to the side of an object; "objections were voiced on every hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106371157"
	 b:glossaryEntry="the part of a wharf that is next to a ship"/>
<rdf:Description rdf:about="&a;106371273">
	<b:glossaryEntry>line parallel to the goal lines where football linesmen line up at the start of each play in American football; "the runner was tackled at the line of scrimmage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106371515"
	 b:glossaryEntry="a line that marks the side boundary of a playing field"/>
<rdf:Description rdf:about="&a;106371658">
	<b:glossaryEntry>the piece of land on which something is located (or is to be located): "a good site for the school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106372036"
	 b:glossaryEntry="the outline of objects seen against the sky"/>
<rdf:Description rdf:about="&a;106372133">
	<b:glossaryEntry>a district of a city marked by poverty and inferior living conditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106372301">
	<b:glossaryEntry>a city district inhabited by people living in huts and shanties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106372421">
	<b:glossaryEntry>a city district frequented by vagrants and alcoholics and addicts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106372541"
	 b:glossaryEntry="a solitary place"/>
<rdf:Description rdf:about="&a;106372612"
	 b:glossaryEntry="the hemisphere south of the equator"/>
<rdf:Description rdf:about="&a;106372789"
	 b:glossaryEntry="the southernmost point of the Earth''s axis"/>
<rdf:Description rdf:about="&a;106372888"
	 b:glossaryEntry="the celestial pole above the southern hemisphere"/>
<rdf:Description rdf:about="&a;106373003">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an area reserved for some particular purpose; "the laboratory''s floor space"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106373203">
	<b:glossaryEntry>the region above the ground; "her hand stopped in mid air"; "the hanged man danced on air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106373343"
	 b:glossaryEntry="a region empty of matter"/>
<rdf:Description rdf:about="&a;106373430">
	<b:glossaryEntry>the geographical area in which one nation is very influential</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106373566">
	<b:glossaryEntry>any imaginary place where spiritual beings (demons or fairies or angels or the like) abide; "science has emptied the spirit world of its former inhabitants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106373781"
	 b:glossaryEntry="the position where a thing or person stands"/>
<rdf:Description rdf:about="&a;106373894"
	 b:glossaryEntry="a line indicating the location of the start of a race"/>
<rdf:Description rdf:about="&a;106374015"
	 b:glossaryEntry="either of the sidelines in soccer or Rugby"/>
<rdf:Description rdf:about="&a;106374113">
	<b:glossaryEntry>in football; line parallel to the goal lines indicating position on the field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106374245">
	<b:glossaryEntry>the territory occupied by one of the constituent administrative districts of a nation; "his state is in the deep south"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106374806"
	 b:glossaryEntry="one of the 50 states of the United States"/>
<rdf:Description rdf:about="&a;106375882">
	<b:glossaryEntry>(Navy) the location to which a ship or fleet is assigned for duty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106376001">
	<b:glossaryEntry>a spot where something halts or pauses; "his next stop is Atlanta"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106376190">
	<b:glossaryEntry>a stopping place on a journey; "there is a stopover to change planes in Chicago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106376325">
	<b:glossaryEntry>one of several parallel layers of material arranged one on top of another (such as a layer of tissue or cells in an organism)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106376720">
	<b:glossaryEntry>a street in west central London famous for its theaters and hotels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106376858"
	 b:glossaryEntry="any stratum lying underneath another"/>
<rdf:Description rdf:about="&a;106376963">
	<b:glossaryEntry>a specific layer or stratum of soil or subsoil in a vertical cross section of land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106377154"
	 b:glossaryEntry="a layer in a soil profile"/>
<rdf:Description rdf:about="&a;106377311"
	 b:glossaryEntry="the top layer of a soil profile; usually contains humus"/>
<rdf:Description rdf:about="&a;106377453">
	<b:glossaryEntry>immediately below the A-horizon; contains deposits of organic matter leached from surface soils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106377616">
	<b:glossaryEntry>beneath the B-horizon and above the bedrock; consisting of weathered rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106377757">
	<b:glossaryEntry>a layer of rock with a particular composition (especially of fossils); for dating the stratum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106377915">
	<b:glossaryEntry>a stratum of ore or coal thick enough to be mined with profit; "he worked in the coal beds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106378081"
	 b:glossaryEntry="a seam of coal"/>
<rdf:Description rdf:about="&a;106378170"
	 b:glossaryEntry="the part of a coal seam that is being cut"/>
<rdf:Description rdf:about="&a;106378285">
	<b:glossaryEntry>a geographic region (land or sea) under which something valuable is found; "the diamond fields of South Africa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106378502"
	 b:glossaryEntry="a region where there is coal underground"/>
<rdf:Description rdf:about="&a;106378598"
	 b:glossaryEntry="a region where there is natural gas underground"/>
<rdf:Description rdf:about="&a;106378700">
	<b:glossaryEntry>a region rich in petroleum deposits (especially one with producing oil wells)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106378832">
	<b:glossaryEntry>the point where three areas or surfaces meet or intersect; "the corners of a cube"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106378967">
	<b:glossaryEntry>the extended two-dimensional outer boundary of a three-dimensional object; "they skimmed over the surface of the water"; "a brush small enough to clean every dental surface"; "the sun has no distinct surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106379373"
	 b:glossaryEntry="the location of the target that is to be hit"/>
<rdf:Description rdf:about="&a;106379484"
	 b:glossaryEntry="the starting place for each hole on a golf course"/>
<rdf:Description rdf:about="&a;106379618">
	<b:glossaryEntry>the part of the Earth''s surface between the Arctic Circle and the Tropic of Cancer or between the Antarctic Circle and the Tropic of Capricorn; characterized by temperate climate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106379893"
	 b:glossaryEntry="between the Arctic Circle and the Tropic of Cancer"/>
<rdf:Description rdf:about="&a;106380010"
	 b:glossaryEntry="between the Antarctic Circle and the Tropic of Capricorn"/>
<rdf:Description rdf:about="&a;106380133"
	 b:glossaryEntry="the limit of a nation''s territorial waters"/>
<rdf:Description rdf:about="&a;106380238"
	 b:glossaryEntry="the extreme end of something; especially something pointed"/>
<rdf:Description rdf:about="&a;106380382">
	<b:glossaryEntry>the highest or uppermost side of anything; "put your books on top of the desk"; "only the top side of the box was painted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106380677"
	 b:glossaryEntry="the top of a desk"/>
<rdf:Description rdf:about="&a;106380748"
	 b:glossaryEntry="the top of a (usually flat) roof"/>
<rdf:Description rdf:about="&a;106380834">
	<b:glossaryEntry>the upper part of anything; "the mower cuts off the tops of the grass"; "the title should be written at the top of the first page"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106381104">
	<b:glossaryEntry>the top of something; "the head of the stairs"; "the head of the page"; "the head of the list"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106381267">
	<b:glossaryEntry>a point located with respect to surface features of some region; "this is a nice place for a picnic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106381842">
	<b:glossaryEntry>something resembling a pool of liquid; "he stood in a pool of light"; "his chair sat in a puddle of books and magazines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106382022">
	<b:glossaryEntry>the part of the Earth''s surface between the Tropics of Cancer and Capricorn; characterized by a hot climate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106382213">
	<b:glossaryEntry>an urban area with a fixed boundary that is smaller than a city; "they drive through town on their way to work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106382754">
	<b:glossaryEntry xml:space='preserve'><![CDATA[colloquial American term for a town; "I''ve lived in this burg all my life"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106382879"
	 b:glossaryEntry="a town enjoying sudden prosperity"/>
<rdf:Description rdf:about="&a;106382968"
	 b:glossaryEntry="a deserted town (especially in Western United States)"/>
<rdf:Description rdf:about="&a;106383078">
	<b:glossaryEntry>the town (or city) where you grew up or where you have your principal residence; "he never went back to his hometown again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106383256">
	<b:glossaryEntry>a (usually small) town where a public market is held at stated times</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106383382">
	<b:glossaryEntry>an administrative division of a county; "the town is responsible for snow removal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106383526">
	<b:glossaryEntry>a district into which a city or town is divided for the purpose of administration and elections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106383691"
	 b:glossaryEntry="an area where a group of families live together"/>
<rdf:Description rdf:about="&a;106383813"
	 b:glossaryEntry="a settlement smaller than a town"/>
<rdf:Description rdf:about="&a;106383980"
	 b:glossaryEntry="a native village in Malaysia"/>
<rdf:Description rdf:about="&a;106384072">
	<b:glossaryEntry>a village of huts for native Africans in southern Africa; usually surrounded by a stockade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106384214"
	 b:glossaryEntry="a communal village built by Indians in the southwestern U.S."/>
<rdf:Description rdf:about="&a;106384327"
	 b:glossaryEntry="an extended area of land"/>
<rdf:Description rdf:about="&a;106385111"
	 b:glossaryEntry="an area composed of subdivided lots"/>
<rdf:Description rdf:about="&a;106385204"
	 b:glossaryEntry="regions adjacent to the tropics"/>
<rdf:Description rdf:about="&a;106385306"
	 b:glossaryEntry="a tract of land containing explosive mines"/>
<rdf:Description rdf:about="&a;106385405">
	<b:glossaryEntry>a piece of ground having specific characteristics or military potential; "they decided to attack across the rocky terrain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106385581"
	 b:glossaryEntry='a small area of planted ground; "a cabbage patch"'/>
<rdf:Description rdf:about="&a;106385742">
	<b:glossaryEntry>a parcel of land having fixed boundaries; "he bought a lot on the lake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106385899">
	<b:glossaryEntry>either of two parallels of latitude about 23.5 degrees north and south of the equator representing the points farthest north and south at which the sun can shine directly overhead and constituting the boundaries of the torrid zone or tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106386229"
	 b:glossaryEntry="a line of latitude about 23 degrees North of the equator"/>
<rdf:Description rdf:about="&a;106386348"
	 b:glossaryEntry="a line of latitude about 23 degrees South of the equator"/>
<rdf:Description rdf:about="&a;106386470"
	 b:glossaryEntry="a geographical area constituting a city or town"/>
<rdf:Description rdf:about="&a;106386701"
	 b:glossaryEntry="an imaginary place considered to be perfect or ideal"/>
<rdf:Description rdf:about="&a;106386831"
	 b:glossaryEntry="a lot on which there are no permanent buildings"/>
<rdf:Description rdf:about="&a;106386969">
	<b:glossaryEntry>a belt of charged particles (resulting from cosmic rays) above the Earth trapped by the Earth''s magnetic field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106387159">
	<b:glossaryEntry>the point beyond which something disappears or ceases to exist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106387283">
	<b:glossaryEntry>place or situation affording some advantage (especially a comprehensive view or commanding perspective)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106387458">
	<b:glossaryEntry>a place from which something can be viewed; "from that vantage point he could survey the whole valley"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106387632"
	 b:glossaryEntry="elevated open grassland in southern Africa"/>
<rdf:Description rdf:about="&a;106387733"
	 b:glossaryEntry="in law: the jurisdiction where a trial will be held"/>
<rdf:Description rdf:about="&a;106387836">
	<b:glossaryEntry>the scene of any event or action (especially the place of a meeting)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106387973"
	 b:glossaryEntry="the highest point of something"/>
<rdf:Description rdf:about="&a;106388095">
	<b:glossaryEntry>a great circle on the celestial sphere passing through the zenith and perpendicular to the horizon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106388255"
	 b:glossaryEntry="a district or province governed by a viceroy"/>
<rdf:Description rdf:about="&a;106388357"
	 b:glossaryEntry="a village park consisting of a plot of grassy land"/>
<rdf:Description rdf:about="&a;106388467"
	 b:glossaryEntry="an overcrowded residential area"/>
<rdf:Description rdf:about="&a;106388567"
	 b:glossaryEntry="a health resort near a spring or at the seaside"/>
<rdf:Description rdf:about="&a;106388716">
	<b:glossaryEntry>a line painted on the hull of a ship to correspond with the surface of the water when the ship is afloat on an even keel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106388937"
	 b:glossaryEntry="a line marking the level reached by a body of water"/>
<rdf:Description rdf:about="&a;106389093"
	 b:glossaryEntry="a line marking the highest level reached"/>
<rdf:Description rdf:about="&a;106389195"
	 b:glossaryEntry="a line marking the lowest level reached"/>
<rdf:Description rdf:about="&a;106389295"
	 b:glossaryEntry="a line that divides two adjacent river systems"/>
<rdf:Description rdf:about="&a;106389440"
	 b:glossaryEntry="the watershed of a continent"/>
<rdf:Description rdf:about="&a;106389551"
	 b:glossaryEntry="North American watershed; formed by the Rocky Mountains"/>
<rdf:Description rdf:about="&a;106389665">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a line leading to a place or point: "he looked the other direction"; "didn''t know the way home"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106389876"
	 b:glossaryEntry="a route followed by traders (usually in caravans)"/>
<rdf:Description rdf:about="&a;106390001">
	<b:glossaryEntry>an ancient trade route between China and the Mediterranean (4,000 miles); followed by Marco Polo in the 13th century to reach Cathay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106390208">
	<b:glossaryEntry>the direction or path along which something moves or along which it lies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106390368">
	<b:glossaryEntry>the heading or position of a vessel relative to the trim of its sails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106390488">
	<b:glossaryEntry>general line of orientation: "the river takes a southern course"; "the northeastern trend of the coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106390652">
	<b:glossaryEntry>a general direction in which something tends to move: "the shoreward tendency of the current"; "the trend of the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106390841"
	 b:glossaryEntry="the hemisphere that includes North and South America"/>
<rdf:Description rdf:about="&a;106391019">
	<b:glossaryEntry>the countries of (originally) Europe and (now including) North and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106391179">
	<b:glossaryEntry>the region of the United States lying to the west of the Mississippi River</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106391416"
	 b:glossaryEntry="the western United States during its frontier period"/>
<rdf:Description rdf:about="&a;106391524"
	 b:glossaryEntry="a field planted with wheat"/>
<rdf:Description rdf:about="&a;106391607">
	<b:glossaryEntry>the general location where something is; "I questioned him about his whereabouts on the night of the crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106391772"
	 b:glossaryEntry="a wild and uninhabited area"/>
<rdf:Description rdf:about="&a;106391917">
	<b:glossaryEntry>a small area at a racecourse where awards are given to the owners of winning horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106392062">
	<b:glossaryEntry>the finishing line for a foot race; "he broke the tape in record time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106392183"
	 b:glossaryEntry="the finishing line on a racetrack"/>
<rdf:Description rdf:about="&a;106392267"
	 b:glossaryEntry="space allocated for your work (as in an office)"/>
<rdf:Description rdf:about="&a;106392370">
	<b:glossaryEntry>a tract of land enclosed for particular activities (sometimes paved and usually associated with buildings); "they opened a repair yard on the edge of town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106392648"
	 b:glossaryEntry="(formerly) an enclosed field for tilting contests"/>
<rdf:Description rdf:about="&a;106392752">
	<b:glossaryEntry>the point above the observer that is directly opposite the nadir on the imaginary sphere against which celestial bodies appear to be projected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106392984">
	<b:glossaryEntry>a belt-shaped region in the heavens on either side to the ecliptic; divided into 12 constellations or signs for astrological purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106393436"
	 b:glossaryEntry="one of 12 equal areas into which the zodiac is divided"/>
<rdf:Description rdf:about="&a;106393833">
	<b:glossaryEntry>the first sign of the zodiac; the sun is in this sign from March 21 to April 19</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106393980">
	<b:glossaryEntry>the second sign of the zodiac; the sun is in this sign from April 20 to May 20</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106394129">
	<b:glossaryEntry>the third sign of the zodiac; the sun is in this sign from May 21 to June 20</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106394277">
	<b:glossaryEntry>the fourth sign of the zodiac; the sun is in this sign from June 21 to July 22</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106394426">
	<b:glossaryEntry>the fifth sign of the zodiac; the sun is in this sign from July 23 to August 22</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106394570">
	<b:glossaryEntry>the sixth sign of the zodiac; the sun is in this sign from August 23 to September 22</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106394725">
	<b:glossaryEntry>the seventh sign of the zodiac; the sun is in this sign from September 23 to October 22</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106394903">
	<b:glossaryEntry>the eighth sign of the zodiac; the sun is in this sign from October 23 to November 21</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106395065">
	<b:glossaryEntry>the ninth sign of the zodiac; the sun is in this sign from November 22 to December 21</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106395233">
	<b:glossaryEntry>the tenth sign of the zodiac; the sun is in this sign from December 22 to January 19</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106395393">
	<b:glossaryEntry>the eleventh sign of the zodiac; the sun is in this sign from January 20 to February 18</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106395563">
	<b:glossaryEntry>the twelfth sign of the zodiac; the sun is in this sign from February 19 to March 20</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106395720">
	<b:glossaryEntry>a circumscribed geographical region characterized by some distinctive features</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106395867"
	 b:glossaryEntry="a military area where combat forces operate"/>
<rdf:Description rdf:about="&a;106395986">
	<b:glossaryEntry>an area in hostile territory that has been occupied and is held for further troops and supplies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106396161"
	 b:glossaryEntry="a city district known for its vice and high crime rate"/>
<rdf:Description rdf:about="&a;106396286"
	 b:glossaryEntry="the territory claimed by a juvenile gang as its own"/>
<rdf:Description rdf:about="&a;106396388"
	 b:glossaryEntry="a dangerous area"/>
<rdf:Description rdf:about="&a;106396462">
	<b:glossaryEntry>an agreed area where military supplies are dropped to ground troops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106396601">
	<b:glossaryEntry>a city district where development receives special tax advantages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106396728">
	<b:glossaryEntry>a part of the city far removed from the center; "they built a factory on the outskirts of the city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106396910"
	 b:glossaryEntry="an area subject to tidal action"/>
<rdf:Description rdf:about="&a;106396998">
	<b:glossaryEntry>any of the 24 regions of the globe (loosely divided by longitude) throughout which the same standard time is used</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106397167"
	 b:glossaryEntry="the capital city of a nation"/>
<rdf:Description rdf:about="&a;106400102"
	 b:glossaryEntry="the capital city of a province"/>
<rdf:Description rdf:about="&a;106400413"
	 b:glossaryEntry="the capital city of a United States state"/>
<rdf:Description rdf:about="&a;106401522">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the European mainland; "Englishmen like to visit the Continent but they wouldn''t like to live there"]]></b:glossaryEntry>
</rdf:Description>
