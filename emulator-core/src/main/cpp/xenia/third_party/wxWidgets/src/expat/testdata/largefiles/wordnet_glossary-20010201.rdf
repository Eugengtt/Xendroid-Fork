<rdf:Description rdf:about="&a;101480235">
	<b:glossaryEntry>marine bivalve that bores into rock or clay or wood by means of saw-like shells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101480387"
	 b:glossaryEntry="octopuses; squids; cuttlefish; pearly nautilus"/>
<rdf:Description rdf:about="&a;101480587">
	<b:glossaryEntry>marine mollusk characterized by well-developed head and eyes and sucker-bearing tentacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101480845"
	 b:glossaryEntry="spiral-shelled cephalopods"/>
<rdf:Description rdf:about="&a;101480986">
	<b:glossaryEntry>type genus and sole recent representative of the family Nautilidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101481151">
	<b:glossaryEntry>cephalopod of the Indian and Pacific oceans having a spiral shell with pale pearly partitions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101481357">
	<b:glossaryEntry>comprising all living cephalopods except the family Nautilidae: the orders Octopoda (octopuses) and Decapoda (squids and cuttlefish)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101481683"
	 b:glossaryEntry="cephalopods having two gills"/>
<rdf:Description rdf:about="&a;101481804"
	 b:glossaryEntry="octopuses and paper nautilus"/>
<rdf:Description rdf:about="&a;101481980"
	 b:glossaryEntry="eight-armed cephalopod lacking an internal shell"/>
<rdf:Description rdf:about="&a;101482137"
	 b:glossaryEntry="a family of Octopoda"/>
<rdf:Description rdf:about="&a;101482274"
	 b:glossaryEntry="type genus of the family Octopodidae"/>
<rdf:Description rdf:about="&a;101482408">
	<b:glossaryEntry>bottom-living cephalopod having a soft oval body with eight long tentacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101482586"
	 b:glossaryEntry="represented solely by the genus Argonauta"/>
<rdf:Description rdf:about="&a;101482746"
	 b:glossaryEntry="type genus of the family Argonautidae: paper nautilus"/>
<rdf:Description rdf:about="&a;101482911">
	<b:glossaryEntry>cephalopod mollusk of warm seas whose females have delicate papery spiral shells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101483099"
	 b:glossaryEntry="squids and cuttlefishes"/>
<rdf:Description rdf:about="&a;101483327"
	 b:glossaryEntry="cephalopods having eight short tentacles plus two long ones"/>
<rdf:Description rdf:about="&a;101483513">
	<b:glossaryEntry>widely distributed fast-moving ten-armed cephalopod mollusk having a long tapered body with triangular tail fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101483750"
	 b:glossaryEntry="squids"/>
<rdf:Description rdf:about="&a;101483853"
	 b:glossaryEntry="somewhat flattened cylindrical squid"/>
<rdf:Description rdf:about="&a;101483961"
	 b:glossaryEntry="a genus of Decapoda"/>
<rdf:Description rdf:about="&a;101484083">
	<b:glossaryEntry>extremely active cylindrical squid with short strong arms and large rhombic terminal fins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101484250"
	 b:glossaryEntry="giant squid"/>
<rdf:Description rdf:about="&a;101484364"
	 b:glossaryEntry="largest mollusk known about but never seen (to 60 feet long)"/>
<rdf:Description rdf:about="&a;101484516"
	 b:glossaryEntry="true cuttlefishes"/>
<rdf:Description rdf:about="&a;101484644"
	 b:glossaryEntry="type genus of the Sepiidae"/>
<rdf:Description rdf:about="&a;101484774">
	<b:glossaryEntry>ten-armed oval-bodied cephalopod with narrow fins as long as the body and a large calcareous internal shell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101484966">
	<b:glossaryEntry>coextensive with the genus Spirula; included in the order Belemnoidea in some older classifications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101485180">
	<b:glossaryEntry>genus of small cephalopods with many-chambered spiral shells resembling those of the extinct belemnites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101485381">
	<b:glossaryEntry>a small tropical cephalopod of the genus Spirula having prominent eyes and short arms and a many-chambered shell coiled in a flat spiral</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101485608">
	<b:glossaryEntry>order of extinct dibranchiate cephalopods related to the surviving spirulas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101485799"
	 b:glossaryEntry="family of extinct Mesozoic cephalopods"/>
<rdf:Description rdf:about="&a;101485956">
	<b:glossaryEntry>a conical calcareous fossil tapering to a point at one end and with a conical cavity at the other end containing (when unbroken) a small chambered phragmocone from the shell of any of numerous extinct cephalopods of the family Belemnitidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101486270">
	<b:glossaryEntry>a pouch in many birds and some lower animals that resembles a stomach for storage and preliminary maceration of food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101486444">
	<b:glossaryEntry>thick-walled muscular pouch below the crop in many birds and reptiles for grinding food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101486614">
	<b:glossaryEntry>class of mandibulate arthropods including: lobsters; crabs; shrimps; woodlice; barnacles; decapods; water fleas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101486970">
	<b:glossaryEntry>any mainly aquatic arthropod usually having a segmented body and chitinous exoskeleton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101487314">
	<b:glossaryEntry>one of a pair of glands (believed to have excretory functions) in some crustaceans near the base of the large antennae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101487509">
	<b:glossaryEntry>largest subclass of Crustacea including most of the well-known marine, freshwater, and terrestrial crustaceans: crabs; lobsters; shrimps; sow bugs; beach flies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101487884"
	 b:glossaryEntry="a major subclass of crustaceans"/>
<rdf:Description rdf:about="&a;101488077"
	 b:glossaryEntry="lobsters; crayfish; crabs; shrimps; prawns"/>
<rdf:Description rdf:about="&a;101488343">
	<b:glossaryEntry>crustaceans characteristically having five pairs of locomotor appendages each joined to a segment of the thorax</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101488674">
	<b:glossaryEntry>an order of crustaceans (including true crabs) having a reduced abdomen folded against the ventral surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101489047"
	 b:glossaryEntry="typical crabs"/>
<rdf:Description rdf:about="&a;101489136">
	<b:glossaryEntry>decapod having eyes on short stalks and a broad flattened carapace with a small abdomen folded under the thorax and pincers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101489527"
	 b:glossaryEntry="stone crabs"/>
<rdf:Description rdf:about="&a;101489646">
	<b:glossaryEntry>large edible crab of S coat of United States especially Florida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101489825"
	 b:glossaryEntry="many of the best known edible crabs"/>
<rdf:Description rdf:about="&a;101489973"
	 b:glossaryEntry="type genus of the family Cancridae"/>
<rdf:Description rdf:about="&a;101490151">
	<b:glossaryEntry>edible crab that has not recently molted and so has a hard shell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101490277">
	<b:glossaryEntry>edible crab that has recently molted and not yet formed its new shell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101490428"
	 b:glossaryEntry="small edible crab of Pacific coast of North America"/>
<rdf:Description rdf:about="&a;101490596"
	 b:glossaryEntry="crab of eastern coast of North America"/>
<rdf:Description rdf:about="&a;101490728">
	<b:glossaryEntry>large red deep-water crab of the eastern coast of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101490885"
	 b:glossaryEntry="swimming crabs"/>
<rdf:Description rdf:about="&a;101491071">
	<b:glossaryEntry>marine crab with some legs flattened and fringed for swimming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101491265"
	 b:glossaryEntry="type genus of the family Portunidae"/>
<rdf:Description rdf:about="&a;101491410"
	 b:glossaryEntry="crab of the English coasts"/>
<rdf:Description rdf:about="&a;101491536"
	 b:glossaryEntry="a genus of Portunidae"/>
<rdf:Description rdf:about="&a;101491667">
	<b:glossaryEntry>brightly spotted crab of sandy beaches of the United States Atlantic coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101491872"
	 b:glossaryEntry="New World blue crabs"/>
<rdf:Description rdf:about="&a;101492008">
	<b:glossaryEntry>bluish edible crab of Atlantic and Gulf coasts of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101492187"
	 b:glossaryEntry="fiddler crabs"/>
<rdf:Description rdf:about="&a;101492300">
	<b:glossaryEntry>burrowing crab of American coastal regions having one claw much enlarged in the male</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101492462"
	 b:glossaryEntry="tiny soft-bodied crabs"/>
<rdf:Description rdf:about="&a;101492605"
	 b:glossaryEntry="type genus of the family Pinnotheridae: pea crabs"/>
<rdf:Description rdf:about="&a;101492789">
	<b:glossaryEntry>tiny soft-bodied crab living commensally in the mantles of certain bivalve mollusks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101492964">
	<b:glossaryEntry>tiny soft-bodied crab living within the mantle cavity of oysters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101493127"
	 b:glossaryEntry="deep-sea crabs of cold waters"/>
<rdf:Description rdf:about="&a;101493271"
	 b:glossaryEntry="a genus of Lithodidae"/>
<rdf:Description rdf:about="&a;101493410">
	<b:glossaryEntry>large edible crab of North Pacific waters esp. along the coasts of Alaska and Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101493668"
	 b:glossaryEntry="spider crabs"/>
<rdf:Description rdf:about="&a;101493827">
	<b:glossaryEntry>any of numerous crabs with very long legs and small triangular bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101494009"
	 b:glossaryEntry="type genus of the Majidae; nearly cosmopolitan"/>
<rdf:Description rdf:about="&a;101494177"
	 b:glossaryEntry="large European spider crab"/>
<rdf:Description rdf:about="&a;101494317"
	 b:glossaryEntry="giant crabs of Japan"/>
<rdf:Description rdf:about="&a;101494453"
	 b:glossaryEntry="very large deep-water Japanese crab"/>
<rdf:Description rdf:about="&a;101494588"
	 b:glossaryEntry="lobsters; crabs"/>
<rdf:Description rdf:about="&a;101494756">
	<b:glossaryEntry>any of several edible marine crustaceans of the families Homaridae and Nephropsidae and Palinuridae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101495001"
	 b:glossaryEntry="large-clawed lobsters"/>
<rdf:Description rdf:about="&a;101495154">
	<b:glossaryEntry>large edible marine crustaceans having large pincers on the first pair of legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101495383"
	 b:glossaryEntry="type genus of the family Homaridae: common edible lobsters"/>
<rdf:Description rdf:about="&a;101495587"
	 b:glossaryEntry="lobster of Atlantic coast of America"/>
<rdf:Description rdf:about="&a;101495780"
	 b:glossaryEntry="lobster of Atlantic coast of Europe"/>
<rdf:Description rdf:about="&a;101495935"
	 b:glossaryEntry="small lobster of southern Africa"/>
<rdf:Description rdf:about="&a;101496064"
	 b:glossaryEntry="in some classifications coextensive with the Homaridae"/>
<rdf:Description rdf:about="&a;101496237"
	 b:glossaryEntry="a genus of Nephropsidae"/>
<rdf:Description rdf:about="&a;101496351">
	<b:glossaryEntry>edible European lobster resembling the American lobster but slenderer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101496522"
	 b:glossaryEntry="spiny lobsters"/>
<rdf:Description rdf:about="&a;101496653"
	 b:glossaryEntry="type genus of the family Palinuridae"/>
<rdf:Description rdf:about="&a;101496801">
	<b:glossaryEntry>large edible marine crustacean having a spiny carapace but lacking the large pincers of true lobsters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101497064"
	 b:glossaryEntry="crayfish"/>
<rdf:Description rdf:about="&a;101497234"
	 b:glossaryEntry="small freshwater decapod crustacean that resembles a lobster"/>
<rdf:Description rdf:about="&a;101497437"
	 b:glossaryEntry="type genus of the family Astacidae; Old World crayfish"/>
<rdf:Description rdf:about="&a;101497599"
	 b:glossaryEntry="small crayfish of Europe and Asia and western North America"/>
<rdf:Description rdf:about="&a;101497773"
	 b:glossaryEntry="a genus of Astacidae"/>
<rdf:Description rdf:about="&a;101497903"
	 b:glossaryEntry="common large crayfishes of eastern North America"/>
<rdf:Description rdf:about="&a;101498053"
	 b:glossaryEntry="hermit crabs"/>
<rdf:Description rdf:about="&a;101498178"
	 b:glossaryEntry="type genus of the family Paguridae"/>
<rdf:Description rdf:about="&a;101498320">
	<b:glossaryEntry>small soft-bodied marine crustaceans living in cast-off shells of gastropods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101498473"
	 b:glossaryEntry="shrimp; prawns; etc."/>
<rdf:Description rdf:about="&a;101498644"
	 b:glossaryEntry="shrimps"/>
<rdf:Description rdf:about="&a;101498787"
	 b:glossaryEntry="type genus of the family Crangonidae"/>
<rdf:Description rdf:about="&a;101498912">
	<b:glossaryEntry>small slender-bodied chiefly marine decapod crustaceans with a long tail and single pair of pincers; many species are edible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101499164">
	<b:glossaryEntry>small shrimp that makes a snapping noise with one of their enlarged chelae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101499316"
	 b:glossaryEntry="prawns"/>
<rdf:Description rdf:about="&a;101499441">
	<b:glossaryEntry>type genus of the family Palaemonidae; widely distributed genus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101499633">
	<b:glossaryEntry>shrimp-like decapod crustacean having two pairs of pincers; most are edible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101499797">
	<b:glossaryEntry>large (a foot or more) edible freshwater prawn common in Australian rivers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101500008"
	 b:glossaryEntry="tropical prawns"/>
<rdf:Description rdf:about="&a;101500134"
	 b:glossaryEntry="type genus of the family Peneidae"/>
<rdf:Description rdf:about="&a;101500273"
	 b:glossaryEntry="edible tropical and warm-water prawn"/>
<rdf:Description rdf:about="&a;101500389">
	<b:glossaryEntry>in former classifications a division of Malacostraca; superseded by the orders Mysidacea and Euphausiacea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101500551">
	<b:glossaryEntry>small commonly luminescent crustaceans; important element of marine plankton: krill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101500771">
	<b:glossaryEntry>shrimp-like planktonic crustaceans; major source of food for e.g. baleen whales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101500939"
	 b:glossaryEntry="food for jellyfish"/>
<rdf:Description rdf:about="&a;101501041"
	 b:glossaryEntry="opossum shrimp"/>
<rdf:Description rdf:about="&a;101501167"
	 b:glossaryEntry="small shrimp-like crustaceans"/>
<rdf:Description rdf:about="&a;101501324"
	 b:glossaryEntry="type genus of the family Mysidae"/>
<rdf:Description rdf:about="&a;101501460"
	 b:glossaryEntry="a genus of Mysidae"/>
<rdf:Description rdf:about="&a;101501586">
	<b:glossaryEntry>shrimp-like crustaceans whose females carry eggs and young in a pouch between the legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101501771"
	 b:glossaryEntry="mantis shrimps"/>
<rdf:Description rdf:about="&a;101501939"
	 b:glossaryEntry="a kind of crustacean"/>
<rdf:Description rdf:about="&a;101502077">
	<b:glossaryEntry>tropical marine burrowing crustaceans with large grasping appendages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101502256">
	<b:glossaryEntry>crustaceans that burrow in mud or under stones in shallow water along the seashore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101502453"
	 b:glossaryEntry="type genus of the family Squillidae"/>
<rdf:Description rdf:about="&a;101502586"
	 b:glossaryEntry="a kind of mantis shrimp"/>
<rdf:Description rdf:about="&a;101502697"
	 b:glossaryEntry="woodlice"/>
<rdf:Description rdf:about="&a;101502870">
	<b:glossaryEntry>any of various small terrestrial or aquatic crustaceans with seven pairs of legs adapted for crawling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101503098">
	<b:glossaryEntry>any of various small terrestrial isopods having a flat elliptical segmented body; found in damp habitats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101503303"
	 b:glossaryEntry="pill bugs"/>
<rdf:Description rdf:about="&a;101503437"
	 b:glossaryEntry="type genus of the Armadillidiidae"/>
<rdf:Description rdf:about="&a;101503590">
	<b:glossaryEntry>small terrestrial isopod with a convex segmented body that can roll up into a ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101503746"
	 b:glossaryEntry="a family of Isopoda"/>
<rdf:Description rdf:about="&a;101503878">
	<b:glossaryEntry>type genus of the Oniscidae; woodlice that cannot roll into a ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101504052"
	 b:glossaryEntry="sow bugs"/>
<rdf:Description rdf:about="&a;101504183"
	 b:glossaryEntry="Old World genus of isopod crustaceans"/>
<rdf:Description rdf:about="&a;101504332">
	<b:glossaryEntry>terrestrial isopod having an oval segmented body (a shape like a sow)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101504494"
	 b:glossaryEntry="marine isopod crustacean"/>
<rdf:Description rdf:about="&a;101504587">
	<b:glossaryEntry>small flat-bodied semi-terrestrial crustaceans: whale lice; sand-hoppers; skeleton shrimp</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101504845"
	 b:glossaryEntry="a kind of malacostracan crustacean"/>
<rdf:Description rdf:about="&a;101505007"
	 b:glossaryEntry="beach fleas"/>
<rdf:Description rdf:about="&a;101505137"
	 b:glossaryEntry="type genus of the family Orchestiidae"/>
<rdf:Description rdf:about="&a;101505286">
	<b:glossaryEntry>small amphipod crustaceans that hop like fleas; common on ocean beaches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101505472"
	 b:glossaryEntry="skeleton shrimp"/>
<rdf:Description rdf:about="&a;101505597">
	<b:glossaryEntry>small amphipod crustacean having a grotesque form suggestive of the praying mantis; found chiefly on seaweed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101505786"
	 b:glossaryEntry="whale lice"/>
<rdf:Description rdf:about="&a;101505902"
	 b:glossaryEntry="amphipod crustacean parasitic on cetaceans"/>
<rdf:Description rdf:about="&a;101506021">
	<b:glossaryEntry>in some older classifications includes the Branchiopoda and Copepoda and Ostracoda and Cirripedia; no longer in technical use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101506248">
	<b:glossaryEntry>primitive aquatic mainly freshwater crustaceans: fairy shrimps; brine shrimps; tadpole shrimps; can shrimps; water fleas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101506546">
	<b:glossaryEntry>aquatic crustaceans typically having a carapace and many pairs of leaflike appendages used for swimming as well as respiration and feeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101506855"
	 b:glossaryEntry="water fleas"/>
<rdf:Description rdf:about="&a;101506964">
	<b:glossaryEntry>minute freshwater crustacean having a round body enclosed in a transparent shell; moves about like a flea by means of hairy branched antennae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101507191">
	<b:glossaryEntry>small aquatic crustaceans lacking a carapace: fairy shrimps; brine shrimps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101507377"
	 b:glossaryEntry="fairy shrimp; brine shrimp"/>
<rdf:Description rdf:about="&a;101507568">
	<b:glossaryEntry>small freshwater branchiopod having a transparent body with many appendages; swims on its back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101507740"
	 b:glossaryEntry="common to saline lakes"/>
<rdf:Description rdf:about="&a;101507857"
	 b:glossaryEntry="small freshwater crustaceans with a shield-shaped carapace"/>
<rdf:Description rdf:about="&a;101508029"
	 b:glossaryEntry="a family of Notostraca"/>
<rdf:Description rdf:about="&a;101508145">
	<b:glossaryEntry>type genus of the family Triopidae: small crustaceans with a small third median eye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101508334"
	 b:glossaryEntry="a kind of branchiopod crustacean"/>
<rdf:Description rdf:about="&a;101508446"
	 b:glossaryEntry="minute planktonic or parasitic crustaceans"/>
<rdf:Description rdf:about="&a;101508639">
	<b:glossaryEntry>minute marine or fresh-water crustaceans usually having six pairs of limbs on the thorax; some abundant in plankton and others parasitic on fish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101508950"
	 b:glossaryEntry="minute crustaceans forming food for right whales"/>
<rdf:Description rdf:about="&a;101509057"
	 b:glossaryEntry="copepod water fleas"/>
<rdf:Description rdf:about="&a;101509174">
	<b:glossaryEntry>minute free-swimming freshwater copepod having a large median eye and pear-shaped body and long antennae used in swimming; important in some food chains and as intermediate hosts of parasitic worms that affect man e.g. Guinea worms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101509491"
	 b:glossaryEntry="copepods with suctorial mouthparts; parasitic on fishes"/>
<rdf:Description rdf:about="&a;101509660"
	 b:glossaryEntry="a kind of copepod"/>
<rdf:Description rdf:about="&a;101509753"
	 b:glossaryEntry="seed shrimps"/>
<rdf:Description rdf:about="&a;101509880">
	<b:glossaryEntry>tiny marine and freshwater crustaceans with a shrimp-like body enclosed in a bivalve shell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101510074"
	 b:glossaryEntry="barnacles"/>
<rdf:Description rdf:about="&a;101510238">
	<b:glossaryEntry>marine crustaceans with feathery food-catching appendages; free-swimming as larvae; as adults form a hard shell and live attached to submerged surfaces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101510522"
	 b:glossaryEntry="stalkless barnacles"/>
<rdf:Description rdf:about="&a;101510654"
	 b:glossaryEntry="type genus of the family Balanidae"/>
<rdf:Description rdf:about="&a;101510796"
	 b:glossaryEntry="barnacle that attaches to rocks esp. in intertidal zones"/>
<rdf:Description rdf:about="&a;101510969"
	 b:glossaryEntry="goose barnacles"/>
<rdf:Description rdf:about="&a;101511097"
	 b:glossaryEntry="type genus of the family Lepadidae"/>
<rdf:Description rdf:about="&a;101511235">
	<b:glossaryEntry>stalked barnacle that attaches to ship bottoms or floating timbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101511402">
	<b:glossaryEntry>enigmatic small elongated wormlike terrestrial invertebrates of damp dark habitats in warm regions; distinct from the phylum Annelida; resemble slugs with legs and are sometimes described as the missing link between arthropods and annelids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101511795">
	<b:glossaryEntry>any of numerous velvety-skinned wormlike carnivorous animals common in tropical forests having characteristics of both arthropods and annelid worms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101512064"
	 b:glossaryEntry="a family of Onychophora"/>
<rdf:Description rdf:about="&a;101512223">
	<b:glossaryEntry>type genus of Peripatidae; onychophorans of chiefly New World tropical regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101512382"
	 b:glossaryEntry="a genus of Peripatidae"/>
<rdf:Description rdf:about="&a;101512530"
	 b:glossaryEntry="a kind of onychophoran"/>
<rdf:Description rdf:about="&a;101512646"
	 b:glossaryEntry="a family of Onychophora"/>
<rdf:Description rdf:about="&a;101512792">
	<b:glossaryEntry>type genus of Peripatopsidae; onychophorans of chiefly Asiatic and African tropical regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101512982">
	<b:glossaryEntry>any of many long-legged birds that wade in water in search of food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101513438">
	<b:glossaryEntry>order of chiefly tropical marsh-dwelling fish-eating wading birds with long legs and bills and (except for flamingos) unwebbed feet: herons; storks; spoonbills; flamingos; ibises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101513831"
	 b:glossaryEntry="storks"/>
<rdf:Description rdf:about="&a;101514085">
	<b:glossaryEntry>large mostly Old World wading birds typically having white-and-black plumage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101514394"
	 b:glossaryEntry="type genus of the Ciconiidae: European storks"/>
<rdf:Description rdf:about="&a;101514566">
	<b:glossaryEntry>the common stork of Europe; white with black wing feathers and a red bill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101514734"
	 b:glossaryEntry="Old World stork that is glossy black above and white below"/>
<rdf:Description rdf:about="&a;101514885"
	 b:glossaryEntry="adjutant birds and marabous"/>
<rdf:Description rdf:about="&a;101515047"
	 b:glossaryEntry="large Indian stork with a military gait"/>
<rdf:Description rdf:about="&a;101515214">
	<b:glossaryEntry>large African black-and-white carion-eating stork; downy under-wing feathers are used to trim garments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101515462"
	 b:glossaryEntry="openbills"/>
<rdf:Description rdf:about="&a;101515583">
	<b:glossaryEntry>stork with a grooved bill whose upper and lower parts touch only at the base and tip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101515741"
	 b:glossaryEntry="jabirus"/>
<rdf:Description rdf:about="&a;101515845"
	 b:glossaryEntry="large white stork of warm regions of the world esp. America"/>
<rdf:Description rdf:about="&a;101515994"
	 b:glossaryEntry="saddlebills"/>
<rdf:Description rdf:about="&a;101516131">
	<b:glossaryEntry>large black-and-white stork of tropical Africa; its red bill has a black band around the middle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101516343"
	 b:glossaryEntry="East Indian and Australian storks"/>
<rdf:Description rdf:about="&a;101516492"
	 b:glossaryEntry="large mostly white Australian stork"/>
<rdf:Description rdf:about="&a;101516661">
	<b:glossaryEntry>a genus of birds of the family Ciconiidae including wood ibises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101516834">
	<b:glossaryEntry>American stork resembling the true ibises in having a curved bill; inhabits wooded swamps of New World tropics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101517053"
	 b:glossaryEntry="shoebills"/>
<rdf:Description rdf:about="&a;101517189"
	 b:glossaryEntry="type genus of the Balaenicipitidae: shoebills"/>
<rdf:Description rdf:about="&a;101517350">
	<b:glossaryEntry>large stork-like bird of the valley of the White Nile with a broad bill suggesting a wooden shoe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101517549"
	 b:glossaryEntry="ibises"/>
<rdf:Description rdf:about="&a;101517741">
	<b:glossaryEntry>wading birds of warm regions having long slender down-curved bills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101517913"
	 b:glossaryEntry="ibises"/>
<rdf:Description rdf:about="&a;101518014"
	 b:glossaryEntry="Old World wood ibis"/>
<rdf:Description rdf:about="&a;101518133"
	 b:glossaryEntry="type genus of the Threskiornithidae"/>
<rdf:Description rdf:about="&a;101518286"
	 b:glossaryEntry="African ibis venerated by ancient Egyptians"/>
<rdf:Description rdf:about="&a;101518432"
	 b:glossaryEntry="spoonbills"/>
<rdf:Description rdf:about="&a;101518578"
	 b:glossaryEntry="wading birds having a long flat bill with a tip like a spoon"/>
<rdf:Description rdf:about="&a;101518750"
	 b:glossaryEntry="type genus of the Plataleidae"/>
<rdf:Description rdf:about="&a;101518908">
	<b:glossaryEntry>pure white crested spoonbill of southern Eurasia and northeastern Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101519084"
	 b:glossaryEntry="a genus of Platalea"/>
<rdf:Description rdf:about="&a;101519207"
	 b:glossaryEntry="tropical rose-colored New World spoonbill"/>
<rdf:Description rdf:about="&a;101519345"
	 b:glossaryEntry="flamingos"/>
<rdf:Description rdf:about="&a;101519481">
	<b:glossaryEntry>large pink to scarlet web-footed wading bird with down-bent bill; inhabits brackish lakes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101519644"
	 b:glossaryEntry="herons; egrets; night herons; bitterns"/>
<rdf:Description rdf:about="&a;101519964">
	<b:glossaryEntry>gray or white wading bird with long neck and long legs and (usually) long bill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101520239"
	 b:glossaryEntry="type genus of the Ardeidae: large New and Old World herons"/>
<rdf:Description rdf:about="&a;101520420"
	 b:glossaryEntry="large American heron having bluish-gray plumage"/>
<rdf:Description rdf:about="&a;101520566"
	 b:glossaryEntry="large white heron of Florida and the Florida Keys"/>
<rdf:Description rdf:about="&a;101520719">
	<b:glossaryEntry>any of various usually white herons having long plumes during breeding season</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101520938"
	 b:glossaryEntry="small Old and New World herons"/>
<rdf:Description rdf:about="&a;101521152"
	 b:glossaryEntry="small bluish-gray heron of the westrn hemisphere"/>
<rdf:Description rdf:about="&a;101521302"
	 b:glossaryEntry="small New World egret"/>
<rdf:Description rdf:about="&a;101521430"
	 b:glossaryEntry="Old World egret"/>
<rdf:Description rdf:about="&a;101521542"
	 b:glossaryEntry="white egrets"/>
<rdf:Description rdf:about="&a;101521670"
	 b:glossaryEntry="widely distributed Old World white egret"/>
<rdf:Description rdf:about="&a;101521832">
	<b:glossaryEntry>the common American egret; a variety of the Old World Casmerodius albus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101522019"
	 b:glossaryEntry="small white egrets"/>
<rdf:Description rdf:about="&a;101522147">
	<b:glossaryEntry>small white egret widely distributed in warm regions often found around grazing animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101522328"
	 b:glossaryEntry="nocturnal or crepuscular herons"/>
<rdf:Description rdf:about="&a;101522467"
	 b:glossaryEntry="Old World night herons"/>
<rdf:Description rdf:about="&a;101522603"
	 b:glossaryEntry="night heron of both Old and New Worlds"/>
<rdf:Description rdf:about="&a;101522756"
	 b:glossaryEntry="American night herons"/>
<rdf:Description rdf:about="&a;101522891"
	 b:glossaryEntry="North American night heron"/>
<rdf:Description rdf:about="&a;101523031"
	 b:glossaryEntry="boatbills"/>
<rdf:Description rdf:about="&a;101523156"
	 b:glossaryEntry="tropical American heron related to night herons"/>
<rdf:Description rdf:about="&a;101523335">
	<b:glossaryEntry>relatively small compact tawny-brown heron with nocturnal habits and a booming cry; found in marshes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101523543"
	 b:glossaryEntry="bitterns"/>
<rdf:Description rdf:about="&a;101523680"
	 b:glossaryEntry="a kind of bittern"/>
<rdf:Description rdf:about="&a;101523818"
	 b:glossaryEntry="a kind of bittern"/>
<rdf:Description rdf:about="&a;101523938"
	 b:glossaryEntry="bitterns"/>
<rdf:Description rdf:about="&a;101524060"
	 b:glossaryEntry="small American bittern"/>
<rdf:Description rdf:about="&a;101524181">
	<b:glossaryEntry>inland marsh-dwelling birds with long legs and necks and bills that wade in water in search of food: cranes; rails; bustards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101524590"
	 b:glossaryEntry="cranes"/>
<rdf:Description rdf:about="&a;101524724">
	<b:glossaryEntry>large long-necked wading bird of marshes and plains in many parts of the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101524891"
	 b:glossaryEntry="type genus of the Gruidae: typical cranes"/>
<rdf:Description rdf:about="&a;101525034">
	<b:glossaryEntry>rare North American crane having black-and-white plumage and a trumpeting call</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101525209">
	<b:glossaryEntry>genus of large brown long-billed wading birds found in warm swampy regions of the Western Hemisphere: courlan; limpkin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101525414"
	 b:glossaryEntry="wading bird of South and Central America"/>
<rdf:Description rdf:about="&a;101525545">
	<b:glossaryEntry>wading bird of Florida, Cuba and Jamaica having a drooping bill and a distinctive wailing call</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101525728"
	 b:glossaryEntry="cranelike South American wading birds"/>
<rdf:Description rdf:about="&a;101525899">
	<b:glossaryEntry>type genus of the Cariamidae comprising only the crested cariama</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101526071"
	 b:glossaryEntry="Brazilian cariama; sole representative of the genus Cariama"/>
<rdf:Description rdf:about="&a;101526240"
	 b:glossaryEntry="a genus of Cariamidae"/>
<rdf:Description rdf:about="&a;101526358"
	 b:glossaryEntry="Argentinian cariama"/>
<rdf:Description rdf:about="&a;101526480"
	 b:glossaryEntry="rails; crakes; gallinules; coots"/>
<rdf:Description rdf:about="&a;101526775">
	<b:glossaryEntry>any of numerous widely distributed small wading birds of the family Rallidae having short wings and very long toes for running on soft mud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101527055"
	 b:glossaryEntry="rails of New Zealand"/>
<rdf:Description rdf:about="&a;101527191">
	<b:glossaryEntry>flightless New Zealand rail of thievish disposition having short wings each with a spur used in fighting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101527388"
	 b:glossaryEntry="any of several short-billed Old World rails"/>
<rdf:Description rdf:about="&a;101527519"
	 b:glossaryEntry="corncrakes"/>
<rdf:Description rdf:about="&a;101527631"
	 b:glossaryEntry="common Eurasian rail that frequents grain fields"/>
<rdf:Description rdf:about="&a;101527778"
	 b:glossaryEntry="spotted crakes"/>
<rdf:Description rdf:about="&a;101527900"
	 b:glossaryEntry="Eurasian rail of swamps and marshes"/>
<rdf:Description rdf:about="&a;101528032"
	 b:glossaryEntry="gallinules"/>
<rdf:Description rdf:about="&a;101528192">
	<b:glossaryEntry>any of various small aquatic birds of the genus Gallinula distinguished from rails by a frontal shield and a resemblance to domestic hens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101528493"
	 b:glossaryEntry="North American dark bluish-gray gallinule"/>
<rdf:Description rdf:about="&a;101528650"
	 b:glossaryEntry="black gallinule that inhabits ponds and lakes"/>
<rdf:Description rdf:about="&a;101528790"
	 b:glossaryEntry="gallinules with showy purplish plumage"/>
<rdf:Description rdf:about="&a;101528927"
	 b:glossaryEntry="Old World purple gallinules"/>
<rdf:Description rdf:about="&a;101529047"
	 b:glossaryEntry="purple gallinule of southern Europe"/>
<rdf:Description rdf:about="&a;101529169"
	 b:glossaryEntry="American purple gallinules"/>
<rdf:Description rdf:about="&a;101529309"
	 b:glossaryEntry="American purple gallinule"/>
<rdf:Description rdf:about="&a;101529441"
	 b:glossaryEntry="a genus of Rallidae"/>
<rdf:Description rdf:about="&a;101529559"
	 b:glossaryEntry="flightless New Zealand birds similar to gallinules"/>
<rdf:Description rdf:about="&a;101529712"
	 b:glossaryEntry="coots"/>
<rdf:Description rdf:about="&a;101529861"
	 b:glossaryEntry="slaty-black slow-flying birds somewhat resembling ducks"/>
<rdf:Description rdf:about="&a;101530041"
	 b:glossaryEntry="North American coot"/>
<rdf:Description rdf:about="&a;101530192"
	 b:glossaryEntry="Eurasian coot"/>
<rdf:Description rdf:about="&a;101530299">
	<b:glossaryEntry>terrestrial game birds of the Old World and Australia: bustards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101530452"
	 b:glossaryEntry="bustards"/>
<rdf:Description rdf:about="&a;101530609">
	<b:glossaryEntry>large heavy-bodied chiefly terrestrial game bird capable of powerful swift flight; classified with wading birds but frequents grassy steppes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101530858"
	 b:glossaryEntry="type genus of the Otididae: European bustard"/>
<rdf:Description rdf:about="&a;101531004"
	 b:glossaryEntry="largest European land bird"/>
<rdf:Description rdf:about="&a;101531122"
	 b:glossaryEntry="Australian bustard"/>
<rdf:Description rdf:about="&a;101531252"
	 b:glossaryEntry="popular Australian game bird"/>
<rdf:Description rdf:about="&a;101531380">
	<b:glossaryEntry>small Old World birds resembling but not related to true quail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101531576"
	 b:glossaryEntry="type genus of the Turnicidae: button quail"/>
<rdf:Description rdf:about="&a;101531743">
	<b:glossaryEntry>small quail-like terrestrial bird of southern Eurasia and North Africa that lacks a hind toe; classified with wading birds but inhabits grassy plains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101532029"
	 b:glossaryEntry="a variety of button quail having stripes"/>
<rdf:Description rdf:about="&a;101532155"
	 b:glossaryEntry="any of several East Indian birds"/>
<rdf:Description rdf:about="&a;101532260"
	 b:glossaryEntry="plain wanderer"/>
<rdf:Description rdf:about="&a;101532388">
	<b:glossaryEntry>small Australian bird related to the button quail; classified as wading bird but inhabits plains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101532587"
	 b:glossaryEntry="trumpeters"/>
<rdf:Description rdf:about="&a;101532712"
	 b:glossaryEntry="type genus of the Psophiidae: trumpeters"/>
<rdf:Description rdf:about="&a;101532860">
	<b:glossaryEntry>large gregarious forest-dwelling cranelike bird of South America having glossy black plumage and a loud prolonged cry; easily domesticated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101533091">
	<b:glossaryEntry>trumpeter of Brazil and Guiana; often kept to protect poultry in Brazil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101533248">
	<b:glossaryEntry>large diverse order of aquatic birds found along seacoasts and inland waters: shorebirds and coastal diving birds; most feed on anima life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101533605">
	<b:glossaryEntry>a bird that frequents coastal waters and the open ocean: gulls; pelicans; gannets; cormorants; albatrosses; petrels; etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101533945">
	<b:glossaryEntry>shorebirds: plovers; sandpipers; avocets; phalaropes; coursers; stone curlews</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101534308">
	<b:glossaryEntry>term used in some classifications for migratory shorebirds; coextensive with the Charadrii</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101534494">
	<b:glossaryEntry>any of numerous wading birds that frequent mostly seashores and estuaries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101534943"
	 b:glossaryEntry="plover family"/>
<rdf:Description rdf:about="&a;101535151">
	<b:glossaryEntry>any of numerous chiefly shorebirds of relatively compact build having straight bills and large pointed wings; closely related to the sandpipers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101535474"
	 b:glossaryEntry="type genus of the Charadriidae: plovers"/>
<rdf:Description rdf:about="&a;101535665"
	 b:glossaryEntry="small plover of eastern North America"/>
<rdf:Description rdf:about="&a;101535802">
	<b:glossaryEntry>American plover of inland waters and fields having a distinctive cry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101535995"
	 b:glossaryEntry="rare plover of upland areas of Eurasia"/>
<rdf:Description rdf:about="&a;101536163"
	 b:glossaryEntry="golden plovers"/>
<rdf:Description rdf:about="&a;101536289">
	<b:glossaryEntry>plovers of Europe and America having the backs marked with golden-yellow spots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101536446"
	 b:glossaryEntry="Eurasian lapwings"/>
<rdf:Description rdf:about="&a;101536573"
	 b:glossaryEntry="large crested Old World plover having wattles and spurs"/>
<rdf:Description rdf:about="&a;101536733"
	 b:glossaryEntry="turnstones"/>
<rdf:Description rdf:about="&a;101536853">
	<b:glossaryEntry>migratory shorebirds of the plover family that turn over stones in searching for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101537049">
	<b:glossaryEntry>common arctic turnstone that winters south to South America and Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101537205"
	 b:glossaryEntry="common turnstone of North American Pacific coast"/>
<rdf:Description rdf:about="&a;101537340">
	<b:glossaryEntry>sandpiper family: sandpipers; woodcocks; snipes; tattlers; curlews; godwits; dowitchers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101537869">
	<b:glossaryEntry>any of numerous usually small wading birds having a slender bill and piping call; closely related to the plovers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101538308"
	 b:glossaryEntry="a genus of Scolopacidae"/>
<rdf:Description rdf:about="&a;101538439">
	<b:glossaryEntry>sandpiper-like shorebird of Pacific coasts of North and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101538600"
	 b:glossaryEntry="a genus of Scolopacidae"/>
