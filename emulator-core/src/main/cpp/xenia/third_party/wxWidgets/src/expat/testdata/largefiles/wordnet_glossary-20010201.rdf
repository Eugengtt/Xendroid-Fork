	 b:glossaryEntry="roentgenographic examination of veins"/>
<rdf:Description rdf:about="&a;100581685">
	<b:glossaryEntry>roentgenographic examination of the bile ducts after a contrast medium has been injected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100581835"
	 b:glossaryEntry="photography using a telephoto lens"/>
<rdf:Description rdf:about="&a;100581931">
	<b:glossaryEntry>transmission and reproduction of photographs and charts and pictures over a distance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100582077"
	 b:glossaryEntry="the act of exposing film to light"/>
<rdf:Description rdf:about="&a;100582219">
	<b:glossaryEntry>the act of exposing film to too much light or for too long a time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100582343">
	<b:glossaryEntry>the act of exposing film to too little light or for too short a time</b:glossaryEntry>
