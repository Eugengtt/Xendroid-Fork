	 b:glossaryEntry="a printed copy of the order of the day"/>
<rdf:Description rdf:about="&a;104869197"
	 b:glossaryEntry="the schedule of programs to be broadcast on a network"/>
<rdf:Description rdf:about="&a;104869316">
