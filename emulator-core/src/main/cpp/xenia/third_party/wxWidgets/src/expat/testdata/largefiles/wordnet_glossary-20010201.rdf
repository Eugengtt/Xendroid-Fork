<rdf:Description rdf:about="&a;400275143"
	 b:glossaryEntry='like a boor, "he behaved boorishly at the party"'/>
<rdf:Description rdf:about="&a;400275247"
	 b:glossaryEntry="in a bountiful manner"/>
<rdf:Description rdf:about="&a;400275422"
	 b:glossaryEntry='in the direction of the breadth; "cut the cloth breadthwise"'/>
<rdf:Description rdf:about="&a;400275548"
	 b:glossaryEntry='in a breezy manner; "he swings beezily into the title song"'/>
<rdf:Description rdf:about="&a;400275662">
