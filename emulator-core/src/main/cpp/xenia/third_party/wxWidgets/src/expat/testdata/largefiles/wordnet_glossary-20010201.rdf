<rdf:Description rdf:about="&a;201075495"
	 b:glossaryEntry='cut off from a whole; "His head was severed from his body"'/>
<rdf:Description rdf:about="&a;201075648"
	 b:glossaryEntry='set or keep apart; "sever a reatlionship"'/>
<rdf:Description rdf:about="&a;201075789">
	<b:glossaryEntry>crash together with violent impact: "The cars collided"; "Two meteors clashed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201076000"
	 b:glossaryEntry="collide violently"/>
<rdf:Description rdf:about="&a;201076088">
	<b:glossaryEntry>undergo damage or destruction on impact; "the plane crashed into the ocean"; "The car crashed into the lamp post"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201076294"
	 b:glossaryEntry="break violently or noisily; smash;"/>
<rdf:Description rdf:about="&a;201076442">
	<b:glossaryEntry>cause to crash; "The terorists crashed the car into the gate of the palace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201076634"
	 b:glossaryEntry="cause to collide"/>
<rdf:Description rdf:about="&a;201076715"
	 b:glossaryEntry='crash or crash-land; "ditch a car"; "ditch a plane"'/>
<rdf:Description rdf:about="&a;201076829">
	<b:glossaryEntry>divide into segments; "segment an orange"; "segment a compound word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201077017"
	 b:glossaryEntry='divide into syllables; "syllabify the words"'/>
<rdf:Description rdf:about="&a;201077154"
	 b:glossaryEntry='divide into quarters; "quarter an apple"'/>
<rdf:Description rdf:about="&a;201077267">
	<b:glossaryEntry>divide into parts, pieces, or sections; "The Arab peninsula was partitioned by the British"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201077449">
	<b:glossaryEntry>destroy completely; damage irreparably; "You have ruined my car by pouring sugar in the tank!"; "The tears ruined her make-up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201077907">
	<b:glossaryEntry>overcome or destroy; "The ice storm got my hibiscus"; "the cat got the goldfish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201078056"
	 b:glossaryEntry='destroy completely; "Fire had devoured our home"'/>
<rdf:Description rdf:about="&a;201078168">
	<b:glossaryEntry>destroy and strip of its possession; "The soldiers raped the beautiful country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201078339"
	 b:glossaryEntry='destroy by exploding: "The enemy destroyed the bridge"'/>
<rdf:Description rdf:about="&a;201078466"
	 b:glossaryEntry='destroy completely; "The fire consumed the building"'/>
<rdf:Description rdf:about="&a;201078583"
	 b:glossaryEntry='destroy a ship: "The vessel was shipwrecked"'/>
<rdf:Description rdf:about="&a;201078694"
	 b:glossaryEntry='smash or break forcefully; "The kid busted up the car"'/>
<rdf:Description rdf:about="&a;201078837"
	 b:glossaryEntry='reduce to ruins; "The country lay ruined after the war"'/>
<rdf:Description rdf:about="&a;201078962">
	<b:glossaryEntry>damage or destroy as if by violence; "The teenager banged up the car of his mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201079137">
	<b:glossaryEntry>pull up by or as if by the roots; "uproot the vine that has spread all over the garden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201079342">
	<b:glossaryEntry xml:space='preserve'><![CDATA[put or set (seeds or seedlings) into the ground; "Let''s plant flowers in the garden"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201079585"
	 b:glossaryEntry="plant with a dibble"/>
<rdf:Description rdf:about="&a;201079668">
	<b:glossaryEntry>establish a forest on previously unforested land; "afforest the mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201079853">
	<b:glossaryEntry>re-establish a forest after clear-cutting or fire, etc.; "re-afforest the area that was burned during the fighting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201080037"
	 b:glossaryEntry='forest anew; "After the fire, they reforested the mountain"'/>
<rdf:Description rdf:about="&a;201080162">
	<b:glossaryEntry>plant again or anew; "They replanted the land"; "He replanted the seedlings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201080303"
	 b:glossaryEntry='conceal, suppress, or hide; "smother a yawn"'/>
<rdf:Description rdf:about="&a;201080454"
	 b:glossaryEntry='envelop completely; "smother the meat in gravy"'/>
<rdf:Description rdf:about="&a;201080585">
	<b:glossaryEntry>deprive of the oxygen necessary for combustion; "smother fires"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201080749"
	 b:glossaryEntry='suffocate; "Othello smothered Desdemona with a pillow"'/>
<rdf:Description rdf:about="&a;201080919">
	<b:glossaryEntry>set up for use; "install the washer and dryer"; "We put in a new sink"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201081141"
	 b:glossaryEntry='place; "Her manager had set her up at the Ritz"'/>
<rdf:Description rdf:about="&a;201081273">
	<b:glossaryEntry>install again; "She reinstalled the the washer after it had been repaired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201081422"
	 b:glossaryEntry='put up; "post a sign"; "post a warning at the dump"'/>
<rdf:Description rdf:about="&a;201081544">
	<b:glossaryEntry>be too tight; rub or press; "This neckband is chocking the cat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201081691"
	 b:glossaryEntry='wring the neck of; "The man choked his opponent"'/>
<rdf:Description rdf:about="&a;201081810"
	 b:glossaryEntry='squeeze the throat of; "he tried to strangle his opponent"'/>
<rdf:Description rdf:about="&a;201082003">
	<b:glossaryEntry>cut the head of; "the French King was beheaded during the Revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201082176">
	<b:glossaryEntry>kill by cutting the head off with a guillotine; "The French guillotined many Vietnamese while they occupied the country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201082364">
	<b:glossaryEntry>strangle with an iron collar; "people were garrotted during the Inquisition in Spain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201082541">
	<b:glossaryEntry>kill by piercing with a spear or sharp pole; "the enemies were impaled and left to die"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201082726">
	<b:glossaryEntry xml:space='preserve'><![CDATA[kill by pulling the victim''s body into pieces by having horses pull on each extremity; "people were executed by being quartered"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201082938">
	<b:glossaryEntry>separate the limbs from the body; "the tiger dismembered the tourist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201083100">
	<b:glossaryEntry>tear into pieces; "tease tissue for microscopic examinations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201083224">
	<b:glossaryEntry>divide into pieces; "our department was dismembered when our funding dried up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201083390"
	 b:glossaryEntry='stretch or force to the limit; "strain the rope"'/>
<rdf:Description rdf:about="&a;201083534">
	<b:glossaryEntry>hold in a tight grasp; "The boxer clinched his opponent"; "clench a steering wheel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201083698">
	<b:glossaryEntry>tear or be torn violently; "The curtain ripped from top to bottom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201083862">
	<b:glossaryEntry>separate or cause to separate abruptly; "The rope snapped"; "tear the paper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201084148"
	 b:glossaryEntry="tear into shreds"/>
<rdf:Description rdf:about="&a;201084280">
	<b:glossaryEntry>to grip or seize, as in a wrestling match; "the two men grappled with each other for several minutes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201084469">
	<b:glossaryEntry>press down tightly; "tamp the coffee grinds in the container to make espresso"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201084628"
	 b:glossaryEntry='press down; "Depress the space key"'/>
<rdf:Description rdf:about="&a;201084749">
	<b:glossaryEntry>cause to drop or sink; "The lack of rain had depressed the water level in the reservoir"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201084918">
	<b:glossaryEntry>strike or drive against with a heavy impact; "ram the gate with a sledgehammer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201085085"
	 b:glossaryEntry="flatten with or as if with a bulldozer"/>
<rdf:Description rdf:about="&a;201085215">
	<b:glossaryEntry>drive forcibly as if by a punch; "the nail punched through the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201085355"
	 b:glossaryEntry="place firmly"/>
<rdf:Description rdf:about="&a;201085489"
	 b:glossaryEntry='feed as in a meadow or pasture; "the herd was grazing"'/>
<rdf:Description rdf:about="&a;201085640"
	 b:glossaryEntry="let (animals) feed in a field or pasture or meadow"/>
<rdf:Description rdf:about="&a;201085770"
	 b:glossaryEntry='protect from impact; "cushion the blow"'/>
<rdf:Description rdf:about="&a;201085892"
	 b:glossaryEntry='immerse into a liquid; "dunk the bread into the soup"'/>
<rdf:Description rdf:about="&a;201086100"
	 b:glossaryEntry='dip into liquid; "sop bread into the sauce"'/>
<rdf:Description rdf:about="&a;201086204"
	 b:glossaryEntry='Thrust or throw into; "Immerse yourself in the hot water"'/>
<rdf:Description rdf:about="&a;201086431"
	 b:glossaryEntry='put under water; "submerge yur head completely"'/>
<rdf:Description rdf:about="&a;201086552"
	 b:glossaryEntry='submerge in a liquid; "I soaked in the hot tub for an hour"'/>
<rdf:Description rdf:about="&a;201086681"
	 b:glossaryEntry="plunge or bury in flesh, as of a knife, sword, or tusk"/>
<rdf:Description rdf:about="&a;201086800"
	 b:glossaryEntry="remove with or as if with a ladle; of liquids"/>
<rdf:Description rdf:about="&a;201086949">
	<b:glossaryEntry>take hold of something and move it to a different location; "lift the box onto the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201087136"
	 b:glossaryEntry='lift with a pitchfork; "pitchfork hay"'/>
<rdf:Description rdf:about="&a;201087248"
	 b:glossaryEntry='ladle clumsily; "slop the food onto the plate"'/>
<rdf:Description rdf:about="&a;201087364">
	<b:glossaryEntry>scoop up or take up with a spoon; "spoon the sauce over the roast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201087519"
	 b:glossaryEntry='spread out or open from a folded state; "open the map"'/>
<rdf:Description rdf:about="&a;201087782">
	<b:glossaryEntry xml:space='preserve'><![CDATA[spread apart; "divaricate one''s fingers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201087890"
	 b:glossaryEntry="spread by opening the leaves of"/>
<rdf:Description rdf:about="&a;201087988"
	 b:glossaryEntry="spread out clothes on the grass to let it dry and bleach"/>
<rdf:Description rdf:about="&a;201088107">
	<b:glossaryEntry>enclose or enfold completely with or as if with a covering; "Fog enveloped the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201088442"
	 b:glossaryEntry='wrap; "The tower was involved in mist"'/>
<rdf:Description rdf:about="&a;201088545">
	<b:glossaryEntry>flow over or cover completely; "The bright light engulfed him completely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201088690"
	 b:glossaryEntry="enclose with a sheath, as of a knife or sword"/>
<rdf:Description rdf:about="&a;201088818"
	 b:glossaryEntry="draw from a sheathe or scabbard, as of a sword"/>
<rdf:Description rdf:about="&a;201088949">
	<b:glossaryEntry>cover with a protective sheathing, as of a ship''s bottom, for example</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201089083"
	 b:glossaryEntry="wrap in or as if in a cocoon"/>
<rdf:Description rdf:about="&a;201089183">
	<b:glossaryEntry>suffuse with or as if with light; "The room was bathed in sunlight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201089313">
	<b:glossaryEntry>cover as if with a shroud; "The origins of this civilization are shrouded in mystery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201089504">
	<b:glossaryEntry>enclose or envelop completely, as if by swallowing; "The huge waves swallowed the small boat and it sank shortly thereafter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201089750">
	<b:glossaryEntry>make a mark or lines on a surface; "draw a line"; "draw the outlines of a figure in the sand"; "trace an animal shape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201090084">
	<b:glossaryEntry>draw with suitable instruments and under specified conditions, of geometrical figures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201090236">
	<b:glossaryEntry>draw within a figure so as to touch in as many places as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201090367"
	 b:glossaryEntry='draw a line around; "He drew a circle around the points"'/>
<rdf:Description rdf:about="&a;201090493">
	<b:glossaryEntry>to draw a geometric figure around another figure so that the two are in contact but do not intersect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201090663"
	 b:glossaryEntry='cut a groove into; "chase silver"'/>
<rdf:Description rdf:about="&a;201090775"
	 b:glossaryEntry='cut a bevel on; shape to a bevel; "bevel the surface"'/>
<rdf:Description rdf:about="&a;201090945"
	 b:glossaryEntry="bevel the edges of, to make a miter joint"/>
<rdf:Description rdf:about="&a;201091049"
	 b:glossaryEntry='make cione-shaped; "cone a tire"'/>
<rdf:Description rdf:about="&a;201091143"
	 b:glossaryEntry='shape by rotating on a lathe; "turn the legs of the table"'/>
<rdf:Description rdf:about="&a;201091263"
	 b:glossaryEntry='push roughly; "the people pushed and shoved to get in line"'/>
<rdf:Description rdf:about="&a;201091401"
	 b:glossaryEntry='make formless; "the heat deformed the plastic sculpture"'/>
<rdf:Description rdf:about="&a;201091547"
	 b:glossaryEntry='form into breccia; "brecciated rock"'/>
<rdf:Description rdf:about="&a;201091650"
	 b:glossaryEntry='give shape to; "form the clay into a head"'/>
<rdf:Description rdf:about="&a;201091924"
	 b:glossaryEntry="divide so as to form a network"/>
<rdf:Description rdf:about="&a;201092022"
	 b:glossaryEntry="form into flakes"/>
<rdf:Description rdf:about="&a;201092101"
	 b:glossaryEntry='form with a strickle; "strickle in sand"'/>
<rdf:Description rdf:about="&a;201092207">
	<b:glossaryEntry>force or drive (a fluid or gas) into by piercing; "inject hydrogen into the balloon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201092371">
	<b:glossaryEntry>release from entanglement of difficulty; "i cannot extricate myself from this task"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201092576">
	<b:glossaryEntry>fool or play around with; "Someone tampered with the documents on my desk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201092723">
	<b:glossaryEntry xml:space='preserve'><![CDATA[manipulate manually with no purpose or aim; often without being conscious of doing so; "She played nervously with her wedding ring"; "Don''t fiddle with the screws"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201092990"
	 b:glossaryEntry='take by force; "Storm the fort"'/>
<rdf:Description rdf:about="&a;201093092"
	 b:glossaryEntry='open violently; "kick in the doors"'/>
<rdf:Description rdf:about="&a;201093204"
	 b:glossaryEntry='enclose in or as if in a frame; "frame a picture"'/>
<rdf:Description rdf:about="&a;201093344"
	 b:glossaryEntry='surround completely; "Darkness enclosed him"'/>
<rdf:Description rdf:about="&a;201093769"
	 b:glossaryEntry='enclose with glass; "glass in a porch"'/>
<rdf:Description rdf:about="&a;201093881"
	 b:glossaryEntry='enclose with a bank; "bank roads"'/>
<rdf:Description rdf:about="&a;201093976">
	<b:glossaryEntry>enclose with a dike; "dike the land to protect it from water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201094106"
	 b:glossaryEntry="enclose in a capsule or other small container"/>
<rdf:Description rdf:about="&a;201094220"
	 b:glossaryEntry='enclose with a fence; "we fenced in our yard"'/>
<rdf:Description rdf:about="&a;201094347"
	 b:glossaryEntry="divide by means of a rope"/>
<rdf:Description rdf:about="&a;201094485"
	 b:glossaryEntry='attach a tag or label to; "label these bottles"'/>
<rdf:Description rdf:about="&a;201094688">
	<b:glossaryEntry>attach a code to; "Code the pieces with numbers so that you can identify them later"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201094834"
	 b:glossaryEntry='put a badge on; "The workers here must be badged"'/>
<rdf:Description rdf:about="&a;201094954"
	 b:glossaryEntry='rest on for support; "you can lean on me if you get tired"'/>
<rdf:Description rdf:about="&a;201095118"
	 b:glossaryEntry='to join or unite the pieces of; "patch the skirt"'/>
<rdf:Description rdf:about="&a;201095264">
	<b:glossaryEntry>piece (something old) with a new part; "vamp up an old speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201095397"
	 b:glossaryEntry='remove the core or center from; "core an apple"'/>
<rdf:Description rdf:about="&a;201095514"
	 b:glossaryEntry='remove; "He doffed his hat"'/>
<rdf:Description rdf:about="&a;201095614"
	 b:glossaryEntry='remove the guts of; "gut the sheep"'/>
<rdf:Description rdf:about="&a;201095710"
	 b:glossaryEntry='empty completely; destroy the inside of; "Gut the building"'/>
<rdf:Description rdf:about="&a;201095838">
	<b:glossaryEntry>throw or toss with a quick motion; "flick a piece of paper across the table"; "jerk his head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201096008"
	 b:glossaryEntry='twitch or flutter; "the paper flicked"'/>
<rdf:Description rdf:about="&a;201096127"
	 b:glossaryEntry='mark with a stake; "stake out the path"'/>
<rdf:Description rdf:about="&a;201096237">
	<b:glossaryEntry>affix in a public place or for public notice; "post a warning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201096397"
	 b:glossaryEntry="post in a public place"/>
<rdf:Description rdf:about="&a;201096484"
	 b:glossaryEntry='tie or fasten to a stake; "stake your goat"'/>
<rdf:Description rdf:about="&a;201096598">
	<b:glossaryEntry>pull, or move with a sudden movement: "Shayne turned the handle and jerked the door open.."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201096766"
	 b:glossaryEntry="pull or lift with a winch"/>
<rdf:Description rdf:about="&a;201096854"
	 b:glossaryEntry='pull or pull out sharply; "pluck the flowers off the bush"'/>
<rdf:Description rdf:about="&a;201097031">
	<b:glossaryEntry>remove by drawing or pulling; "She placed the tray down and drew off the cloth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201097199"
	 b:glossaryEntry='pluck with tweezers; "tweeze facial hair"'/>
<rdf:Description rdf:about="&a;201097304"
	 b:glossaryEntry='pull up; "hitch socks and pants"'/>
<rdf:Description rdf:about="&a;201097412">
	<b:glossaryEntry>to move or force, esp. in an effort to get something open; "The burglar jimmied the lock", "Raccoons managed to pry the lid off the garbage pail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201097676"
	 b:glossaryEntry="make an opening or gap in"/>
<rdf:Description rdf:about="&a;201097771"
	 b:glossaryEntry="make a big sweeping gesture or movement"/>
<rdf:Description rdf:about="&a;201097909">
	<b:glossaryEntry>to compress with violence, out of natural shape or condition; "crush an aluminum can"; "squeeze a lemon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201098190"
	 b:glossaryEntry="crush with a steamroller"/>
<rdf:Description rdf:about="&a;201098283"
	 b:glossaryEntry="crush as if by treading on, as of grapes"/>
<rdf:Description rdf:about="&a;201098386"
	 b:glossaryEntry="crush together, as of cars in a collision"/>
<rdf:Description rdf:about="&a;201098494"
	 b:glossaryEntry="press or grind with a crunching noise"/>
<rdf:Description rdf:about="&a;201098648"
	 b:glossaryEntry="rotate with a crank"/>
<rdf:Description rdf:about="&a;201098741"
	 b:glossaryEntry='join or fuse with solder; "solder these two pipes together"'/>
<rdf:Description rdf:about="&a;201098900"
	 b:glossaryEntry="repair with soft-solder"/>
<rdf:Description rdf:about="&a;201098992">
	<b:glossaryEntry>solder together by using hard solder with a high melting point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201099125"
	 b:glossaryEntry="join together by heating, as of metals"/>
<rdf:Description rdf:about="&a;201099261"
	 b:glossaryEntry='make circular welds; "These pipes are only spotwelded"'/>
<rdf:Description rdf:about="&a;201099382"
	 b:glossaryEntry='straighten with a comb; "comb your hair"; "comb the wool"'/>
<rdf:Description rdf:about="&a;201099519"
