	 b:glossaryEntry="flightless cold-water seabirds: penguins"/>
<rdf:Description rdf:about="&a;101567458">
	<b:glossaryEntry>short-legged flightless birds of cold southern esp. Antarctic regions having webbed feet and wings modified as flippers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101567740"
	 b:glossaryEntry="a genus of Spheniscidae"/>
<rdf:Description rdf:about="&a;101567877">
	<b:glossaryEntry>medium-sized penguins occurring in large colonies on the Adelie coast of Antarctica</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101568070"
	 b:glossaryEntry="large penguins"/>
<rdf:Description rdf:about="&a;101568219"
	 b:glossaryEntry="large penguin on islands bordering the Antarctic Circle"/>
<rdf:Description rdf:about="&a;101568377"
	 b:glossaryEntry="the largest penguin; an Antarctic penguin"/>
<rdf:Description rdf:about="&a;101568522"
	 b:glossaryEntry="type genus of the Spheniscidae: jackass penguins"/>
<rdf:Description rdf:about="&a;101568684">
	<b:glossaryEntry>small penguin of South America and southern Africa with a braying call</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101568857"
	 b:glossaryEntry="rock hoppers"/>
<rdf:Description rdf:about="&a;101568979"
	 b:glossaryEntry="small penguin of the Falkland Islands and New Zealand"/>
<rdf:Description rdf:about="&a;101569127"
	 b:glossaryEntry="petrels; albatrosses; shearwaters; diving petrels"/>
<rdf:Description rdf:about="&a;101569380"
	 b:glossaryEntry="bird of the open seas"/>
<rdf:Description rdf:about="&a;101569565">
	<b:glossaryEntry>large long-winged bird with hooked bill and tubular nostrils that wanders the open seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101569741"
	 b:glossaryEntry="albatrosses"/>
<rdf:Description rdf:about="&a;101569888">
	<b:glossaryEntry>large web-footed birds of the southern hemisphere having long narrow wings; noted for powerful gliding flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101570108"
	 b:glossaryEntry="type of the Diomedeidae"/>
<rdf:Description rdf:about="&a;101570249"
	 b:glossaryEntry="very large albatross; white with wide black wings"/>
<rdf:Description rdf:about="&a;101570402"
	 b:glossaryEntry="a variety of albatross with black feet"/>
<rdf:Description rdf:about="&a;101570588"
	 b:glossaryEntry="petrels; fulmars; shearwaters;"/>
<rdf:Description rdf:about="&a;101570817">
	<b:glossaryEntry>relatively small long-winged tube-nosed bird that flies far from land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101571030"
	 b:glossaryEntry="type genus of the Procellariidae"/>
<rdf:Description rdf:about="&a;101571178">
	<b:glossaryEntry>large black petrel of southern seas having a white mark on the chin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101571360"
	 b:glossaryEntry="giant petrels"/>
<rdf:Description rdf:about="&a;101571489"
	 b:glossaryEntry="large brownish petrel chiefly of Antarctic seas"/>
<rdf:Description rdf:about="&a;101571653"
	 b:glossaryEntry="fulmars"/>
<rdf:Description rdf:about="&a;101571770"
	 b:glossaryEntry="heavy short-tailed oceanic bird of polar regions"/>
<rdf:Description rdf:about="&a;101571927"
	 b:glossaryEntry="shearwaters"/>
<rdf:Description rdf:about="&a;101572048">
	<b:glossaryEntry>long-winged oceanic bird that in flight skims close to the waves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101572206">
	<b:glossaryEntry>small black-and-white shearwater common in the eastern North Atlantic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101572357"
	 b:glossaryEntry="storm petrels"/>
<rdf:Description rdf:about="&a;101572527">
	<b:glossaryEntry>any of various small petrels having dark plumage with paler underparts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101572711"
	 b:glossaryEntry="type genus of the Hydrobatidae"/>
<rdf:Description rdf:about="&a;101572855">
	<b:glossaryEntry>sooty black petrel with white markings; of the north Atlantic and Mediterranean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101573060"
	 b:glossaryEntry="a genus of Hydrobatidae"/>
<rdf:Description rdf:about="&a;101573195"
	 b:glossaryEntry="medium-sized storm petrel"/>
<rdf:Description rdf:about="&a;101573351"
	 b:glossaryEntry="diving petrels"/>
<rdf:Description rdf:about="&a;101573488">
	<b:glossaryEntry>any of several small diving birds of S hemisphere seas; somewhat resemble auks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101573645"
	 b:glossaryEntry="whales and dolphins; manatees and dugongs; walruses; seals"/>
<rdf:Description rdf:about="&a;101573837"
	 b:glossaryEntry="an order of Eutheria"/>
<rdf:Description rdf:about="&a;101574022">
	<b:glossaryEntry>large aquatic carnivorous mammal with fin-like forelimbs no hind limbs, including: whales; dolphins; porpoises; narwhals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101574318">
	<b:glossaryEntry>any of the larger cetacean mammals having a streamlined body and breathing through a blowhole on the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101574529">
	<b:glossaryEntry>baleen whales: right whales; rorquals; blue whales; humpbacks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101574762">
	<b:glossaryEntry>whale with plates of whalebone along the upper jaw for filtering plankton from the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101575054"
	 b:glossaryEntry="right whales"/>
<rdf:Description rdf:about="&a;101575200">
	<b:glossaryEntry>large arctic whalebone whale; allegedly the `right'' whale to hunt because of its valuable whalebone and oil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101575384"
	 b:glossaryEntry="type genus of the Balaenidae: Greenland whales"/>
<rdf:Description rdf:about="&a;101575538"
	 b:glossaryEntry="large-mouthed arctic whale"/>
<rdf:Description rdf:about="&a;101575692"
	 b:glossaryEntry="rorquals; blue whales"/>
<rdf:Description rdf:about="&a;101575876">
	<b:glossaryEntry>any of several baleen whales of of the family Balaenopteridae having longitudinal grooves on the throat and a small pointed dorsal fin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101576149"
	 b:glossaryEntry="type genus of the Balaenopteridae"/>
<rdf:Description rdf:about="&a;101576357">
	<b:glossaryEntry>largest mammal ever known; bluish-gray migratory whalebone whale mostly of southern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101576567">
	<b:glossaryEntry>large flat-headed whalebone whale having deep furrows along the throat; of Atlantic and Pacific</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101576804"
	 b:glossaryEntry="similar to but smaller than the finback whale"/>
<rdf:Description rdf:about="&a;101576948"
	 b:glossaryEntry="small finback of coastal waters of Atlantic and Pacific"/>
<rdf:Description rdf:about="&a;101577140"
	 b:glossaryEntry="humpback whales"/>
<rdf:Description rdf:about="&a;101577267">
	<b:glossaryEntry>large whalebone whale with long flippers noted for arching or humping its back as it dives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101577473"
	 b:glossaryEntry="comprising only the gray whales"/>
<rdf:Description rdf:about="&a;101577627"
	 b:glossaryEntry="type and sole genus of the Eschrichtiidae"/>
<rdf:Description rdf:about="&a;101577786"
	 b:glossaryEntry="medium-sized grayish-black whale of the north Pacific"/>
<rdf:Description rdf:about="&a;101577975">
	<b:glossaryEntry>toothed whales: dolphins; porpoises; sperm whales; beaked whales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101578232">
	<b:glossaryEntry>any of several whales having simple conical teeth and feeding on fish etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101578475"
	 b:glossaryEntry="sperm whales"/>
<rdf:Description rdf:about="&a;101578625"
	 b:glossaryEntry="type genus of the Physeteridae"/>
<rdf:Description rdf:about="&a;101578765">
	<b:glossaryEntry>large whale with a large cavity in the head containing spermaceti and oil; also a source of ambergris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101578987"
	 b:glossaryEntry="pygmy sperm whales"/>
<rdf:Description rdf:about="&a;101579128">
	<b:glossaryEntry>small sperm whale of warm waters of both coasts of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101579293">
	<b:glossaryEntry>very small (to 8 feet) sperm whale of central coasts of Atlantic and Pacific</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101579466">
	<b:glossaryEntry>beaked whales; in some esp. former classifications included in the family Physeteridae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101579726">
	<b:glossaryEntry>any of several whales inhabiting all oceans and having beaklike jaws with vestigial teeth in the upper jaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101579928"
	 b:glossaryEntry="bottle-nosed whales"/>
<rdf:Description rdf:about="&a;101580061"
	 b:glossaryEntry="North Atlantic beaked whale with a bulbous forehead"/>
<rdf:Description rdf:about="&a;101580252"
	 b:glossaryEntry="dolphins"/>
<rdf:Description rdf:about="&a;101580491">
	<b:glossaryEntry>any of various small toothed whales with a beaklike snout; larger than porpoises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101580788"
	 b:glossaryEntry="type genus of the Delphinidae"/>
<rdf:Description rdf:about="&a;101580929">
	<b:glossaryEntry>black-and-white dolphin that leaps high out of the water; one of the dolphins displayed at the Marinelands of California and Florida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101581161"
	 b:glossaryEntry="a genus of Delphinidae"/>
<rdf:Description rdf:about="&a;101581293">
	<b:glossaryEntry>any of several dolphins with rounded forehead and well-developed beak; chiefly of North Atlantic and Mediterranean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101581563">
	<b:glossaryEntry>the most common dolphin of North Atlantic and Mediterranean; often kept captive and trained to perform</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101581760"
	 b:glossaryEntry="a bottlenose dolphin found in the Pacific Ocean"/>
<rdf:Description rdf:about="&a;101581897"
	 b:glossaryEntry="porpoises"/>
<rdf:Description rdf:about="&a;101582016">
	<b:glossaryEntry>any of several small gregarious cetacean mammals having a blunt snout and many teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101582192"
	 b:glossaryEntry="the common porpoise of the North Atlantic and Pacific"/>
<rdf:Description rdf:about="&a;101582341"
	 b:glossaryEntry="grampus"/>
<rdf:Description rdf:about="&a;101582446"
	 b:glossaryEntry="slaty-gray blunt-nosed dolphin common in northern seas"/>
<rdf:Description rdf:about="&a;101582591"
	 b:glossaryEntry="killer whales"/>
<rdf:Description rdf:about="&a;101582712">
	<b:glossaryEntry>predatory black-and-white toothed whale with large dorsal fin; common in cold seas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101582924"
	 b:glossaryEntry="pilot whales"/>
<rdf:Description rdf:about="&a;101583054">
	<b:glossaryEntry>small dark-colored whaled of United States Atlantic coast; the largest male acts as pilot or leader for the school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101583313"
	 b:glossaryEntry="river dolphins"/>
<rdf:Description rdf:about="&a;101583448">
	<b:glossaryEntry>any of several long-snouted usually freshwater dolphins of South America and southern Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101583617"
	 b:glossaryEntry="narwhals"/>
<rdf:Description rdf:about="&a;101583763"
	 b:glossaryEntry="type genus of the Monodontidae"/>
<rdf:Description rdf:about="&a;101583901"
	 b:glossaryEntry="small arctic whale the male having a long spiral ivory tusk"/>
<rdf:Description rdf:about="&a;101584073"
	 b:glossaryEntry="white whale"/>
<rdf:Description rdf:about="&a;101584206"
	 b:glossaryEntry="small northern whale that is white when adult"/>
<rdf:Description rdf:about="&a;101584361"
	 b:glossaryEntry="manatees; dugongs; Stellar''s sea cow"/>
<rdf:Description rdf:about="&a;101584543">
	<b:glossaryEntry>any of two families of large herbivorous aquatic mammals with paddle-shaped tails and flipper-like forelimbs and no hind limbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101584825"
	 b:glossaryEntry="comprising only the manatees"/>
<rdf:Description rdf:about="&a;101584972"
	 b:glossaryEntry="type and sole genus of the Trichechidae"/>
<rdf:Description rdf:about="&a;101585124">
	<b:glossaryEntry>sirenian mammal of tropical coastal waters of America; the flat tail is rounded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101585297">
	<b:glossaryEntry>a family of mammals of order Sirenia including dugongs and Steller''s sea cow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101585507"
	 b:glossaryEntry="type genus of the Dugongidae comprising only the dugongs"/>
<rdf:Description rdf:about="&a;101585660">
	<b:glossaryEntry>sirenian tusked mammal found from eastern Africa to Australia; the flat tail is bilobate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101585835">
	<b:glossaryEntry>a genus of the family Dugongidae comprising only Steller''s sea cow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101586019">
	<b:glossaryEntry>extinct large sirenian mammal formerly found near Asiatic coast of the Bering Sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101586204">
	<b:glossaryEntry>cats; lions; tigers; panthers; dogs; wolves; jackals; bears; raccoons; skunks; and members of the suborder Pinnipedia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101586585">
	<b:glossaryEntry>terrestrial or aquatic flesh-eating mammal; terrestrial carnivores have four or five clawed digits on each limb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101586897"
	 b:glossaryEntry="an animal that feeds on both animal and vegetable substances"/>
<rdf:Description rdf:about="&a;101587012"
	 b:glossaryEntry="seals; sea lions; walruses"/>
<rdf:Description rdf:about="&a;101587212">
	<b:glossaryEntry>aquatic carnivorous mammal having a streamlined body specialized for swimming with limbs modified as flippers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101587481">
	<b:glossaryEntry>any of numerous marine mammals that come on shore to breed; chiefly of cold regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101587669"
	 b:glossaryEntry="silvery gray Antarctic seal subsisting on crustaceans"/>
<rdf:Description rdf:about="&a;101587802"
	 b:glossaryEntry="eared seals: sea lions and fur seals"/>
<rdf:Description rdf:about="&a;101588046">
	<b:glossaryEntry>pinniped mammal having external ear flaps and hind limbs used for locomotion on land; valued for its soft underfur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101588290"
	 b:glossaryEntry="fur seals"/>
<rdf:Description rdf:about="&a;101588419">
	<b:glossaryEntry>eared seal of the S hemisphere; the thick soft underfur is the source of sealskin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101588592"
	 b:glossaryEntry="of Pacific coast of California and southward"/>
<rdf:Description rdf:about="&a;101588726"
	 b:glossaryEntry="fur seals"/>
<rdf:Description rdf:about="&a;101588851"
	 b:glossaryEntry="fur seal of the north Pacific"/>
<rdf:Description rdf:about="&a;101588972"
	 b:glossaryEntry="of Pacific coast from Alaska southward to California"/>
<rdf:Description rdf:about="&a;101589108">
	<b:glossaryEntry>any of several large eared seals of the north Pacific related to fur seals but lacking their valuable coat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101589341"
	 b:glossaryEntry="type genus of the Otariidae"/>
<rdf:Description rdf:about="&a;101589474"
	 b:glossaryEntry="of the southern coast of South America"/>
<rdf:Description rdf:about="&a;101589618"
	 b:glossaryEntry="sea lions"/>
<rdf:Description rdf:about="&a;101589756"
	 b:glossaryEntry="often trained as a show animal"/>
<rdf:Description rdf:about="&a;101589920"
	 b:glossaryEntry="a variety of sea lion found in Australia"/>
<rdf:Description rdf:about="&a;101590064"
	 b:glossaryEntry="sea lions"/>
<rdf:Description rdf:about="&a;101590187"
	 b:glossaryEntry="largest sea lion; of the north Pacific"/>
<rdf:Description rdf:about="&a;101590349"
	 b:glossaryEntry="earless seals"/>
<rdf:Description rdf:about="&a;101590568">
	<b:glossaryEntry>any of several seals lacking external ear flaps and having a stiff hairlike coat with hind limbs reduced to swimming flippers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101590885"
	 b:glossaryEntry="type genus of the Phocidae: earless seals"/>
<rdf:Description rdf:about="&a;101591030">
	<b:glossaryEntry>small spotted seal of coastal waters of the northern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101591201"
	 b:glossaryEntry="harp seals"/>
<rdf:Description rdf:about="&a;101591325"
	 b:glossaryEntry="common arctic seal; the young are all white"/>
<rdf:Description rdf:about="&a;101591470"
	 b:glossaryEntry="elephant seals"/>
<rdf:Description rdf:about="&a;101591594">
	<b:glossaryEntry>either of two large North Atlantic earless seals having snouts like trunks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101591762"
	 b:glossaryEntry="bearded seals"/>
<rdf:Description rdf:about="&a;101591889">
	<b:glossaryEntry>medium-sized grayish to yellow seal with bristles each side of muzzle; of Arctic Ocean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101592106"
	 b:glossaryEntry="hooded seals"/>
<rdf:Description rdf:about="&a;101592232">
	<b:glossaryEntry>medium-sized blackish-gray seal with large inflatable sac on the head; of Arctic-Atlantic waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101592441"
	 b:glossaryEntry="walruses and extinct forms"/>
<rdf:Description rdf:about="&a;101592582"
	 b:glossaryEntry="type genus of the Odobenidae: walruses"/>
<rdf:Description rdf:about="&a;101592730">
	<b:glossaryEntry>either of two large northern marine mammals having ivory tusks and tough hide over thick blubber</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101592957"
	 b:glossaryEntry="of North Atlantic and Arctic waters"/>
<rdf:Description rdf:about="&a;101593074"
	 b:glossaryEntry="of the Bering Sea and north Pacific"/>
<rdf:Description rdf:about="&a;101593191"
	 b:glossaryEntry="in some classifications considered a suborder of Carnivora"/>
<rdf:Description rdf:about="&a;101593325">
	<b:glossaryEntry>terrestrial carnivores; having toes separated to the base: dogs; cats; bears; badgers; raccoons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101593493"
	 b:glossaryEntry="an order of Eutheria"/>
<rdf:Description rdf:about="&a;101593633"
	 b:glossaryEntry="aardvarks"/>
<rdf:Description rdf:about="&a;101593767"
	 b:glossaryEntry="coextensive with the family Orycteropodidae"/>
<rdf:Description rdf:about="&a;101593926">
	<b:glossaryEntry>nocturnal burrowing mammal of the grasslands of Africa that feeds on termites; sole extant representative of the order Tubulidentata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101594173"
	 b:glossaryEntry="dogs; wolves; jackals; foxes"/>
<rdf:Description rdf:about="&a;101594481">
	<b:glossaryEntry>any of various fissiped mammals with nonretractile claws and typically long muzzles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101594789"
	 b:glossaryEntry="female of any member of the dog family"/>
<rdf:Description rdf:about="&a;101594897"
	 b:glossaryEntry="a bitch used for breeding"/>
<rdf:Description rdf:about="&a;101594980">
	<b:glossaryEntry>type genus of the Canidae: domestic and wild dogs; wolves; jackals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101595188">
	<b:glossaryEntry>a member of the genus Canis (probably descended from the common wolf) that has been domesticated by man since prehistoric times; occurs in many breeds; "the dog barked all night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101595795"
	 b:glossaryEntry="informal terms"/>
<rdf:Description rdf:about="&a;101595888"
	 b:glossaryEntry="an inferior dog or one of mixed breed"/>
<rdf:Description rdf:about="&a;101596010">
	<b:glossaryEntry>ownerless half-wild mongrel dog common around Asian villages especially India</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101596164"
	 b:glossaryEntry="a dog small and tame enough to be held in the lap"/>
<rdf:Description rdf:about="&a;101596266"
	 b:glossaryEntry="any of several breeds of very small dogs kept purely as pets"/>
<rdf:Description rdf:about="&a;101596512">
	<b:glossaryEntry>old breed of tiny short-coated dog with protruding eyes from Mexico held to antedate Aztec civilization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101596671">
	<b:glossaryEntry>breed of toy dogs originating in Japan having a silky black-and-white or red-and-white coat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101596825"
	 b:glossaryEntry="breed of toy dogs having a long straight silky white coat"/>
