	 b:glossaryEntry="adherent of Baptistic doctrines"/>
<rdf:Description rdf:about="&a;106995825"
	 b:glossaryEntry="people noted for their plain dress and simple life style"/>
<rdf:Description rdf:about="&a;106995978">
	<b:glossaryEntry>a religious person who believes Jesus is the Christ and is a member of a Christian denomination</b:glossaryEntry>
</rdf:Description>
