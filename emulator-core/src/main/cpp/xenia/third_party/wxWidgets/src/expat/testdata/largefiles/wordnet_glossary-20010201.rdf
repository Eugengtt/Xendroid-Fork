	 b:glossaryEntry="give a discount on"/>
<rdf:Description rdf:about="&a;201585121">
	<b:glossaryEntry>grant as a discount or in exchange; "The camera store owner allowed me $50 on my old camera"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201585276"
	 b:glossaryEntry="increase the price of"/>
<rdf:Description rdf:about="&a;201585380">
