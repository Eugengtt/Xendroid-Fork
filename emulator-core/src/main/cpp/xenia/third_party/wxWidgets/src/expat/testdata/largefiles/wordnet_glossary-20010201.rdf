	<b:glossaryEntry>give over to another for care or safekeeping; "consign your baggage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201603090">
	<b:glossaryEntry>consign for shipment on a vehicle, as of luggage; "check your luggage before boarding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201603257"
	 b:glossaryEntry='commit again; "It was recommitted into her custody"'/>
