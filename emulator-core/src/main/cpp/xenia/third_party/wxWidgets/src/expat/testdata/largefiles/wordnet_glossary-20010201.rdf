</rdf:Description>
<rdf:Description rdf:about="&a;201580115">
	<b:glossaryEntry>draw more money from than is available: "She overdrew her account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201580247">
	<b:glossaryEntry xml:space='preserve'><![CDATA[draw from or dip into; "tap one''s memory"; "tap a source of money"]]></b:glossaryEntry>
