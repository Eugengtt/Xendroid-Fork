</rdf:Description>
<rdf:Description rdf:about="&a;103878065"
	 b:glossaryEntry="a shade of white the color of bleached bones"/>
<rdf:Description rdf:about="&a;103878188"
	 b:glossaryEntry="a pure flat white with little reflectance"/>
<rdf:Description rdf:about="&a;103878281"
	 b:glossaryEntry="a silvery-white color"/>
<rdf:Description rdf:about="&a;103878371"
