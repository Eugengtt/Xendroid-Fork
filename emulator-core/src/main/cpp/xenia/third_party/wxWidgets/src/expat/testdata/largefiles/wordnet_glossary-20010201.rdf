	 b:glossaryEntry="essential oil or perfume obtained from flowers"/>
<rdf:Description rdf:about="&a;110684285">
	<b:glossaryEntry>a volatile fragrant oil obtained from fresh roses by steam distillation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110684428">
	<b:glossaryEntry>essential oil obtained from cloves and used to flavor medicines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110684563">
	<b:glossaryEntry>a yellow volatile essential oil obtained from costusroot; used in perfumes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110684694"
	 b:glossaryEntry="an essential oil obtained from the leaves of eucalypts"/>
