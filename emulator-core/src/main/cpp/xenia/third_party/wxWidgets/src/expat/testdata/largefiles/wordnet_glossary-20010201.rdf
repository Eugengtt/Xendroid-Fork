<rdf:Description rdf:about="&a;100392670"
	 b:glossaryEntry="the office of premier"/>
<rdf:Description rdf:about="&a;100392749"
	 b:glossaryEntry="the office and function of president"/>
<rdf:Description rdf:about="&a;100392876">
	<b:glossaryEntry>the office of the US head of state; "a President is elected every four years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100393060"
	 b:glossaryEntry="the office of primate"/>
<rdf:Description rdf:about="&a;100393139"
	 b:glossaryEntry="the post of principal"/>
<rdf:Description rdf:about="&a;100393220"
