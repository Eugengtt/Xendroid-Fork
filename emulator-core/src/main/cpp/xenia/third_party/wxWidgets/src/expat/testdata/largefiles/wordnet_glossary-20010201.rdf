	 b:glossaryEntry="inflammation of the spermatic cord"/>
<rdf:Description rdf:about="&a;110292407"
	 b:glossaryEntry="inflammation at the junction of a rib and its cartilage"/>
<rdf:Description rdf:about="&a;110292524"
	 b:glossaryEntry="inflammation of the skin"/>
<rdf:Description rdf:about="&a;110292767">
	<b:glossaryEntry>inflammation of a diverticulum in the digestive tract (especially the colon); characterized by painful abdominal cramping and fever and constipation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110292976">
	<b:glossaryEntry>inflammation of the brain usually caused by a virus; symptoms include headache and neck pain and drowsiness and nausea and fever</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110293199"
	 b:glossaryEntry="inflammation of the entire brain"/>
<rdf:Description rdf:about="&a;110293293"
	 b:glossaryEntry="inflammation of the intestine"/>
<rdf:Description rdf:about="&a;110293396">
	<b:glossaryEntry>enteritis characterized by bloody diarrhea and severe abdominal pain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110293532">
	<b:glossaryEntry>inflammation of white fibrous tissues (especially muscle sheaths)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110293654">
	<b:glossaryEntry>inflammation of the lining of the stomach; nausea and loss of appetite and discomfort after eating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110293844">
	<b:glossaryEntry>gastritis caused by ingesting an irritant (as too much aspirin)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110293969">
	<b:glossaryEntry>persistent gastritis can be a symptom of a gastric ulcer or pernicious anemia or stomach cancer or other disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110294147"
	 b:glossaryEntry="inflammation of the tongue"/>
<rdf:Description rdf:about="&a;110294283">
