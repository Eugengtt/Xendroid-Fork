</rdf:Description>
<rdf:Description rdf:about="&a;108744710">
	<b:glossaryEntry>genus of eastern Asiatic herbs; sometimes placed in the family Convallariaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108744889">
	<b:glossaryEntry>evergreen perennial with large handsome basal leaves; grown primarily as a foliage houseplant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108745113">
