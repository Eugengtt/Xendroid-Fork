	 b:glossaryEntry="a genus of Psittacidae"/>
<rdf:Description rdf:about="&a;101339600"
	 b:glossaryEntry="African parakeet"/>
<rdf:Description rdf:about="&a;101339723"
	 b:glossaryEntry="cuckoos; touracos; etc."/>
<rdf:Description rdf:about="&a;101339902"
	 b:glossaryEntry="birds having zygodactyl feet (except for the touracos)"/>
<rdf:Description rdf:about="&a;101340073"
	 b:glossaryEntry="includes cuckoo; ani; roadrunner"/>
