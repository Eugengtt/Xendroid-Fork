	 b:glossaryEntry="dark brownish to purplish red"/>
<rdf:Description rdf:about="&a;300360977"
	 b:glossaryEntry="of a pale to moderate grayish violet color"/>
<rdf:Description rdf:about="&a;300361071"
	 b:glossaryEntry="of a moderate somewhat dull yellow-green color"/>
<rdf:Description rdf:about="&a;300361186"
	 b:glossaryEntry="resembling moss"/>
<rdf:Description rdf:about="&a;300361264">
	<b:glossaryEntry>having a drab pale brown color resembling a mouse; "a mousy grownish-gray color"; "mouse-colored hair"; "a mouselike rodent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300361468"
	 b:glossaryEntry="of a moderate orange-yellow color"/>
<rdf:Description rdf:about="&a;300361561"
	 b:glossaryEntry="of a brown color with a greenish tinge"/>
<rdf:Description rdf:about="&a;300361657"
	 b:glossaryEntry="of an olive-brown color similar to khaki"/>
<rdf:Description rdf:about="&a;300361754"
	 b:glossaryEntry="of a yellow-green color similar to that of an unripe olive"/>
<rdf:Description rdf:about="&a;300361864"
	 b:glossaryEntry="similar to the color of a ripe orange"/>
<rdf:Description rdf:about="&a;300361965"
	 b:glossaryEntry="bright greenish blue"/>
<rdf:Description rdf:about="&a;300362044"
	 b:glossaryEntry="of a moderate slightly yellowish-green color"/>
<rdf:Description rdf:about="&a;300362144"
	 b:glossaryEntry="similar to the natural color of pinks"/>
<rdf:Description rdf:about="&a;300362242"
	 b:glossaryEntry="moderate to pale blue or purplish blue"/>
<rdf:Description rdf:about="&a;300362338"
	 b:glossaryEntry="of a color midway between red and blue"/>
<rdf:Description rdf:about="&a;300362449">
	<b:glossaryEntry>having any of numerous bright or strong colors reminiscent of the color of blood or cherries or tomatoes or rubies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300362722">
	<b:glossaryEntry>having a dusty purplish pink color; "the roseate glow of dawn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300362857"
	 b:glossaryEntry="of a deep slightly bluish red color"/>
<rdf:Description rdf:about="&a;300362947"
	 b:glossaryEntry="brown with a reddish tinge"/>
<rdf:Description rdf:about="&a;300363026"
	 b:glossaryEntry="of the color of rust"/>
<rdf:Description rdf:about="&a;300363105"
	 b:glossaryEntry="of the gray-green color of sage leaves"/>
<rdf:Description rdf:about="&a;300363207"
	 b:glossaryEntry='having the color of a blue sapphire; "sapphire eyes"'/>
<rdf:Description rdf:about="&a;300363314"
	 b:glossaryEntry="of the color of the sea; bluish green"/>
<rdf:Description rdf:about="&a;300363407"
	 b:glossaryEntry="snuff colored; grayish to yellowish brown"/>
<rdf:Description rdf:about="&a;300363544"
	 b:glossaryEntry="of a light brownish color"/>
<rdf:Description rdf:about="&a;300363640"
	 b:glossaryEntry="of any of various dull tannish-gray colors"/>
<rdf:Description rdf:about="&a;300363734"
	 b:glossaryEntry="of a pale yellow color like straw; straw colored"/>
<rdf:Description rdf:about="&a;300363834"
	 b:glossaryEntry="of a light yellowish-brown color"/>
<rdf:Description rdf:about="&a;300363916"
	 b:glossaryEntry="of a strong reddish orange color"/>
<rdf:Description rdf:about="&a;300364004"
	 b:glossaryEntry="of a light brown to brownish orange color"/>
<rdf:Description rdf:about="&a;300364097"
	 b:glossaryEntry="of a brilliant pure blue to purplish blue color"/>
<rdf:Description rdf:about="&a;300364202"
	 b:glossaryEntry="of the color of any of various natural brown earth pigments"/>
<rdf:Description rdf:about="&a;300364313"
	 b:glossaryEntry="of a vivid red to reddish-orange color"/>
<rdf:Description rdf:about="&a;300364444"
	 b:glossaryEntry="similar to the color of an egg yolk"/>
<rdf:Description rdf:about="&a;300364544"
	 b:glossaryEntry="midway between yellow and green"/>
<rdf:Description rdf:about="&a;300364634"
	 b:glossaryEntry="having no hue"/>
<rdf:Description rdf:about="&a;300365148">
	<b:glossaryEntry>lustrous gray; covered with or tinged with the color of silver; "silvery hair</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300365309"
	 b:glossaryEntry="pale gray; ash-colored"/>
<rdf:Description rdf:about="&a;300365404"
	 b:glossaryEntry='somewhat black; "blackish clouds"'/>
<rdf:Description rdf:about="&a;300365492"
	 b:glossaryEntry="black with a tinge of blue and no hint of brown"/>
<rdf:Description rdf:about="&a;300365596"
	 b:glossaryEntry='grayish white; "the canescent moon"'/>
<rdf:Description rdf:about="&a;300365687"
	 b:glossaryEntry='having the color of chalk; "she turned chalky white"'/>
<rdf:Description rdf:about="&a;300365792"
	 b:glossaryEntry="very dark gray"/>
<rdf:Description rdf:about="&a;300365893"
	 b:glossaryEntry="of the blackest black; similar to the color of jet or coal"/>
<rdf:Description rdf:about="&a;300366043"
	 b:glossaryEntry="very dark black"/>
<rdf:Description rdf:about="&a;300366117">
	<b:glossaryEntry>an achromatic color of any lightness between the extremes of black and white; "gray flannel suit"; "hair just turning gray"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300366318"
	 b:glossaryEntry="totally lacking in saturation and therefore having no hue"/>
<rdf:Description rdf:about="&a;300366429"
	 b:glossaryEntry="of the color of black ink"/>
<rdf:Description rdf:about="&a;300366530"
	 b:glossaryEntry="the gray color of iron"/>
<rdf:Description rdf:about="&a;300366620"
	 b:glossaryEntry="a pure white color"/>
<rdf:Description rdf:about="&a;300366695"
	 b:glossaryEntry="a white the color of fresh milk"/>
<rdf:Description rdf:about="&a;300366783"
	 b:glossaryEntry="dark gray"/>
<rdf:Description rdf:about="&a;300366864"
	 b:glossaryEntry='lacking hue; "neutral colors like back or white"'/>
<rdf:Description rdf:about="&a;300366966"
	 b:glossaryEntry="a white the color of pearls"/>
<rdf:Description rdf:about="&a;300367061"
	 b:glossaryEntry="dark somewhat brownish black"/>
<rdf:Description rdf:about="&a;300367141"
	 b:glossaryEntry='of the color of slate or granite; "the slaty sky of dawn"'/>
<rdf:Description rdf:about="&a;300367285"
	 b:glossaryEntry="the white color of snow"/>
<rdf:Description rdf:about="&a;300367373"
	 b:glossaryEntry="tending toward white"/>
<rdf:Description rdf:about="&a;300367459">
	<b:glossaryEntry>being of the achromatic color of maximum darkness; having little or no hue owing to absorption of almost all incident light; "black leather jackets"; "as black as coal"; "rich black soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300367747">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being of the achromatic color of maximum lightness; having little or no hue owing to reflection of almost all incident light; "as white as fresh snow"; "a bride''s white dress"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300368023">
	<b:glossaryEntry>(of color) being chromatically pure; not diluted with white or gray or black</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300368180">
	<b:glossaryEntry>(of color) having the highest saturation; "vivid green"; "intense blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300368313">
	<b:glossaryEntry>(of color) not chromatically pure; diluted; "an unsaturated red"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300368453">
	<b:glossaryEntry>(of color) very low in saturation; highly diluted; "dull greens and blues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300368578">
	<b:glossaryEntry>(photography) "color film"; "he rented a color television"; "in glorious color"; "marvelous color illustrations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300368769"
	 b:glossaryEntry='sensitive to all colors; "panchromatic film"'/>
<rdf:Description rdf:about="&a;300368872">
	<b:glossaryEntry>(photography) "black-and-white film"; "a black-and-white TV"; "the movie was in black and white"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300369051">
	<b:glossaryEntry>having color or a certain color; sometimes used in combination; "colored crepe paper"; "the film was in color"; "amber-colored heads of grain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300369643">
	<b:glossaryEntry>(especially of the face) reddened or suffused with or as if with blood from emotion or exertion; "crimson with fury"; "turned red from exertion"; "with puffy reddened eyes"; "red-faced and violent"; "flushed (or crimson) with embarrassment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300369988"
	 b:glossaryEntry='(of hair) "auburn hair"'/>
<rdf:Description rdf:about="&a;300370080">
	<b:glossaryEntry>(used of animals especially a horse) of a moderate reddish-brown color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300370200">
	<b:glossaryEntry>having two colors; "a bicolor flower"; "a bicolored postage stamp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300370367">
	<b:glossaryEntry>(of the face) made black especially as with suffused blood; "a face black with fury"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300370515">
	<b:glossaryEntry>characterized by or marked with a bluish color; "a blue fox"; "the great blue whale"; "a blue spruce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300370667">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tinged with blue or purple from cold or contusion; "the children''s lips are blue from cold"; "a blue bruise"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300370845"
	 b:glossaryEntry="having or involving two colors"/>
<rdf:Description rdf:about="&a;300370933">
	<b:glossaryEntry>made purple especially as with suffused blood; "empurpled with rage"; "purple with suppressed anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300371098">
	<b:glossaryEntry>(used especially of hair or fur) having a bright orange-brown color; "a man with gingery hair and bright blue eyes"; "a ginger kitten"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300371295"
	 b:glossaryEntry='used in combination; having a given hue; "rosy-hued"'/>
<rdf:Description rdf:about="&a;300371401"
	 b:glossaryEntry="having or appearing to have only one color"/>
<rdf:Description rdf:about="&a;300371545">
	<b:glossaryEntry>having sections or patches colored differently and usually brightly; "a jester dressed in motley"; "the painted desert,"; "a particolored dress"; "a piebald horse"; "pied daisies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300371922"
	 b:glossaryEntry="having or exhibiting many colors"/>
<rdf:Description rdf:about="&a;300372041">
	<b:glossaryEntry>(used of hair or fur) of a reddish brown color; "red deer"; reddish hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300372174">
	<b:glossaryEntry>(used of especially horses) having a brownish coat thickly sprinkled with white or gray; "a roan horse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300372328">
	<b:glossaryEntry>having or given a shade of color; especially a pale shade; often used in combination; "amber-tinted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300372481">
	<b:glossaryEntry>being colored slightly; sometimes used in combination; "white petals touched with pink"; "the resplendent sun-touched flag"; "pink-tinged apple blossoms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300372697">
	<b:glossaryEntry>having or involving three colors; "trichromatic vision"; "a trichromatic printing process"; "trichromatic staining is the staining of tissue samples differentially in three colors"; "tricolor plumage"; "a tricolor process in photography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300373016"
	 b:glossaryEntry='without color; "pure water is colorless"'/>
<rdf:Description rdf:about="&a;300373222"
	 b:glossaryEntry="having little or inadequate color"/>
<rdf:Description rdf:about="&a;300373313"
	 b:glossaryEntry="having no color"/>
<rdf:Description rdf:about="&a;300373395">
	<b:glossaryEntry>(of wine) almost colorless; "white wines such as chardonnays or rieslings"; "a white burgundy"; "white Italian wines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300373564">
	<b:glossaryEntry>(of wine) deep reddish in color; "a red wine such as a claret or burgundy"; "a pinot noir is a red burgundy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300373722"
	 b:glossaryEntry="colored or impregnated with dye"/>
<rdf:Description rdf:about="&a;300373867"
	 b:glossaryEntry="dyed before being spun or woven into cloth"/>
<rdf:Description rdf:about="&a;300373984"
	 b:glossaryEntry='permanently dyed; "fast colors"; "colorfast fabrics"'/>
<rdf:Description rdf:about="&a;300374099"
	 b:glossaryEntry="dyed with henna; used especially of hair"/>
<rdf:Description rdf:about="&a;300374193"
	 b:glossaryEntry="not dyed or tinted"/>
<rdf:Description rdf:about="&a;300374275">
	<b:glossaryEntry>marked or dyed or discolored with foreign matter; "a badly stained tablecloth"; "tear-stained cheeks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300374466"
	 b:glossaryEntry="having the color spoiled with spots or streaks"/>
<rdf:Description rdf:about="&a;300374583">
	<b:glossaryEntry>(of a specimen for study under a microscope) treated with a reagent or dye that colors only certain structures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300374747"
	 b:glossaryEntry='not stained; "An apron keeps his clothing unstained"'/>
<rdf:Description rdf:about="&a;300374873">
	<b:glossaryEntry>(of a specimen for study under a microscope) not treated with a reagent or dye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300375007"
	 b:glossaryEntry='having striking color; "colorful autumn leaves"'/>
<rdf:Description rdf:about="&a;300375265">
	<b:glossaryEntry>resembling flame in brilliance or color; "maple trees ablaze in autumn"; "flaming autumn leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300375424">
	<b:glossaryEntry>having striking color; "bright greens"; "brilliant tapestries"; "a bird with vivid plumage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300375588">
	<b:glossaryEntry>varying in color when seen in different lights or from different angles; "changeable taffeta"; "chatoyant (or shot) silk"; "a dragonfly hovered, vibrating and iridescent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300375847"
	 b:glossaryEntry='strong; intense; "deep purple"; "a rich red"'/>
<rdf:Description rdf:about="&a;300375949">
	<b:glossaryEntry>brilliantly colored and apparently giving off light; "fluorescent colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300376080">
	<b:glossaryEntry>exhibiting spectral colors formed by refraction of light through a prism; "prismatic light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300376227">
	<b:glossaryEntry>having the vivid colors and bizarre patterns associated with psychedelic states; "a psychedelic painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300376390"
	 b:glossaryEntry='weak in color; "colorless green ideas sleep furiously"'/>
<rdf:Description rdf:about="&a;300376711">
	<b:glossaryEntry xml:space='preserve'><![CDATA[ash-colored or anemic looking from illness or emotion; "a face turned ashen"; "the invalid''s blanched cheeks"; "tried to speak with bloodless lips"; "a face livid with shock"; "lips...livid with the hue of death"- Mary W. Shelley; "lips white with terror"; "a face white with rage"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300377083">
	<b:glossaryEntry>having lost freshness or brilliance of color; "sun-bleached deck chairs"; "faded jeans"; "a very pale washed-out blue"; "washy colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300377301">
	<b:glossaryEntry>lacking brightness or color; dull; "drab faded curtains"; "sober Puritan gray"; "children in somber brown clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300377492">
	<b:glossaryEntry>deprived of color; "colors dulled by too much sun"; "grayed with the dust of the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300377640">
	<b:glossaryEntry>(especially of plants) developed without chlorophyll by being deprived of light; "etiolated celery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300377817"
	 b:glossaryEntry='ghastly pale; "moonlight gave the statue a lurid luminence"'/>
<rdf:Description rdf:about="&a;300377928">
	<b:glossaryEntry>abnormally deficient in color as suggesting physical or emotional distress; "the pallid face of the invalid"; "her wan face suddenly flushed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300378135">
	<b:glossaryEntry>resembling paste in color; pallid; "the looked pasty and red-eyed"; "a complexion that had been pastelike was now chalky white"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300378326">
	<b:glossaryEntry>having the paleness of wax; "the poor face with the same awful waxen pallor"- Bram Stoker; "the soldier turned his waxlike features toward him"; "a thin face with a waxy paleness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300378574">
	<b:glossaryEntry>(of hair) having lost its color; "the white hairs of old age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300378698">
	<b:glossaryEntry>striking in variety and interest; "a colorful period of history"; "a colorful character"; "colorful language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300378952">
	<b:glossaryEntry xml:space='preserve'><![CDATA[brightly colored and showy; "girls decked out in brave new dresses"; "brave banners flying"; "`braw'' is a Scottish word"; "a dress a bit too gay for her years"; "birds with gay plumage"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300379202"
	 b:glossaryEntry="richly and brilliantly colorful"/>
<rdf:Description rdf:about="&a;300379319"
	 b:glossaryEntry="(used especially of clothes) marked by conspicuous display"/>
<rdf:Description rdf:about="&a;300379463"
	 b:glossaryEntry='full of variety or interest; "a many-sided personality"'/>
<rdf:Description rdf:about="&a;300379575">
	<b:glossaryEntry>strikingly expressive; "a picturesque description of the rainforest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300379701">
	<b:glossaryEntry>lacking in variety and interest; "a colorless and unimaginative person"; "a colorless description of the parade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300379923">
	<b:glossaryEntry>lacking distinguishing quality or characteristics; "a neutral personality that made no impression whatever"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300380084">
	<b:glossaryEntry>lacking in vitality or interest or effectiveness; "a pale rendition of the aria"; "pale prose with the faint sweetness of lavender"; "a pallid performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300380299">
	<b:glossaryEntry>(used of color) having a relatively small amount of coloring agent; "light blue"; "light colors such as pastels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300380571">
	<b:glossaryEntry>very light colored; highly diluted with white; "pale seagreen"; "pale blue eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300380702"
	 b:glossaryEntry="slightly pale"/>
<rdf:Description rdf:about="&a;300380768"
	 b:glossaryEntry='delicate and pale in color; "pastel pink"'/>
<rdf:Description rdf:about="&a;300380862">
	<b:glossaryEntry>as if dulled in color with a sprinkling of powder; "a powdery blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300380983">
	<b:glossaryEntry>(used of color) having a dark hue; "dark green"; "dark glasses"; "dark colors like wine red or navy blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300381193"
	 b:glossaryEntry='slightly dark; "darkish red"'/>
<rdf:Description rdf:about="&a;300381275">
	<b:glossaryEntry>(music) based on a scale consisting of 12 semitones; "a chromatic scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300381403">
	<b:glossaryEntry>(music) based on the standard major or minor scales consisting of 5 tones and 2 semitones without modulation by accidentals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300381581">
	<b:glossaryEntry xml:space='preserve'><![CDATA[on this (the speaker''s) side of the mountains; "a contest in Virginia between a cismontane and a tramontane people"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300381771">
	<b:glossaryEntry>on the Italian or Roman side of the Alps; "ancient cisalpine Gaul included an area south and east of the Alps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300381952">
	<b:glossaryEntry>on or coming from the other side of the mountains (from the the speaker); "the transmontane section of the state"; "tramontane winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300382175">
	<b:glossaryEntry>on or relating to or characteristic of the region or peoples beyond the Alps from Italy (or north of the Alps); "ancient transalpine Gaul was an area northwest of the Alps and included modern France and Belgium"; "Cracow was a transalpine university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300382498">
	<b:glossaryEntry>following the teachings or manifesting the qualities or spirit of Jesus Christ</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300382668">
	<b:glossaryEntry>becoming to or like a Christian; "gentle christianly behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300382788"
	 b:glossaryEntry="resembling or showing the spirit of Christ"/>
<rdf:Description rdf:about="&a;300382898"
	 b:glossaryEntry="not of a Christian faith"/>
<rdf:Description rdf:about="&a;300383016"
	 b:glossaryEntry="not believing in Christ"/>
<rdf:Description rdf:about="&a;300383111">
	<b:glossaryEntry>not becoming to or like a Christian; "ashamed to have to recognize how unchristianly his assumptions and motives are"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300383303">
	<b:glossaryEntry>having a high state of culture and development both social and technological; "terrorist acts that shocked the civilized world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300383612">
	<b:glossaryEntry>(of societies) highly developed especially in technology or industry; "advanced societies"; "an advanced country technologically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300383796"
	 b:glossaryEntry='of or in a condition of social order; "civil peoples"'/>
<rdf:Description rdf:about="&a;300383901"
	 b:glossaryEntry="showing evidence of moral and intellectual advancement"/>
<rdf:Description rdf:about="&a;300384008"
	 b:glossaryEntry="not having a high state of culture and social development"/>
<rdf:Description rdf:about="&a;300384214">
	<b:glossaryEntry>without civilizing influences; "barbarian invaders"; "barbaric practices"; "a savage people"; "fighting is crude and uncivilized especially if the weapons are efficient"-Margaret Meade; "wild tribes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300384510"
	 b:glossaryEntry="primitive in customs and culture"/>
<rdf:Description rdf:about="&a;300384598"
	 b:glossaryEntry="used of a society that has not developed writing"/>
<rdf:Description rdf:about="&a;300384718">
	<b:glossaryEntry>(anthropology; of societies) preliterate or tribal or nonindustrial; "primitive societies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300384864">
	<b:glossaryEntry>(fine arts) of or characteristic of a form or system felt to be of first significance before modern times</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300385079">
	<b:glossaryEntry>characteristic of the classical artistic and literary traditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300385197"
	 b:glossaryEntry="characteristic of the ancient Greek and Roman cultures"/>
<rdf:Description rdf:about="&a;300385320"
	 b:glossaryEntry="characteristic of a revival of an earlier classical style"/>
<rdf:Description rdf:about="&a;300385449"
	 b:glossaryEntry="(fine arts) not classical"/>
<rdf:Description rdf:about="&a;300385587"
	 b:glossaryEntry="(of music) characteristic of rural life"/>
<rdf:Description rdf:about="&a;300385718"
	 b:glossaryEntry="characteristic of present-day art and literature"/>
<rdf:Description rdf:about="&a;300385819">
	<b:glossaryEntry>(of music or art) new and of general appeal (especially among young people)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300385954"
	 b:glossaryEntry="arranged into classes"/>
<rdf:Description rdf:about="&a;300386068"
	 b:glossaryEntry="arranged into categories"/>
<rdf:Description rdf:about="&a;300386150"
	 b:glossaryEntry="arranged into groups"/>
<rdf:Description rdf:about="&a;300386233"
	 b:glossaryEntry="not arranged in any specific grouping"/>
<rdf:Description rdf:about="&a;300386347"
	 b:glossaryEntry="not categorized or sorted"/>
<rdf:Description rdf:about="&a;300386443">
	<b:glossaryEntry>official classification of information or documents; withheld from general circulation; "thousands of classified documents have now been declassified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300386758">
	<b:glossaryEntry>official classification for documents; meant to be seen by only the person to whom it is directed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300386911">
	<b:glossaryEntry>the level of official classification for documents next above restricted and below secret; available only to persons authorized to see documents so classified</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300387128"
	 b:glossaryEntry="the lowest level of official classification for documents"/>
<rdf:Description rdf:about="&a;300387242">
	<b:glossaryEntry>the next to highest level of official classification for documents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300387361">
	<b:glossaryEntry>used officially of classified information or matters affecting national security</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300387497"
	 b:glossaryEntry="the highest official level of classification of documents"/>
<rdf:Description rdf:about="&a;300387611"
	 b:glossaryEntry="not subject to a security classification"/>
<rdf:Description rdf:about="&a;300387746"
	 b:glossaryEntry="having had security classification removed"/>
<rdf:Description rdf:about="&a;300387847"
	 b:glossaryEntry="never having had security classification"/>
<rdf:Description rdf:about="&a;300387961">
	<b:glossaryEntry>examined carefully and methodically; broken down for consideration of constituent parts; "the analyzed data indicated surprising trends"; "a carefully analyzed poem can be like a dead butterfly pinned to a board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300388228">
	<b:glossaryEntry>not analyzed or broken down for detailed examination; "an unalyzed compound"; "unanalyzed data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300388398">
	<b:glossaryEntry>not processed or subjected to analysis; "raw data"; "the raw cost of production"; "only the crude vital statistics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300388571">
	<b:glossaryEntry>free from dirt or impurities; or having clean habits; "children with clean shining faces"; "clean white shirts"; "clean dishes"; "a spotlessly clean house"; "cats are clean animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300389074"
	 b:glossaryEntry="capable of being cleaned"/>
<rdf:Description rdf:about="&a;300389154"
	 b:glossaryEntry="made clean"/>
<rdf:Description rdf:about="&a;300389229"
	 b:glossaryEntry='habitually clean; "cleanly in their persons and habitations"'/>
<rdf:Description rdf:about="&a;300389343"
	 b:glossaryEntry="cleaned with chemical solvents"/>
<rdf:Description rdf:about="&a;300389431">
	<b:glossaryEntry>not yet used or soiled; "a fresh shirt"; "a fresh sheet of paper"; "an unused envelope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300389579">
	<b:glossaryEntry>completely neat and clean; "the apartment was immaculate"; "in her immaculate white uniform"; "a spick-and-span kitchen"; "their spic red-visored caps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300389858">
	<b:glossaryEntry>immaculately clean and unused; "handed her his pristine white handkerchief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300389988">
	<b:glossaryEntry>made clean by scrubbing; "fresh-scrubbed floors"; "boys with scrubbed necks and faces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300390129"
	 b:glossaryEntry="without soil or spot or stain"/>
<rdf:Description rdf:about="&a;300390237">
	<b:glossaryEntry>spotlessly clean and fresh; "the unsullied snow of mountains"; "the unsullied splender of eternal youth"- Oscar Wilde</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300390410"
	 b:glossaryEntry="clean by virtue of having been washed in water"/>
<rdf:Description rdf:about="&a;300390524">
	<b:glossaryEntry>soiled or likely to soil with dirt or grime; "dirty unswept sidewalks"; "a child in dirty overalls"; "dirty slums"; "piles of dirty dishes"; "put his dirty feet on the clean sheet"; "wore an unclean shirt"; "mining is a dirty job"; "Cinderella did the dirty work while her sisters preened themselves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300391309">
	<b:glossaryEntry xml:space='preserve'><![CDATA[limp and soiled as if dragged in the mud; "the beggar''s bedraggled clothes"; "scarecrows in battered hats or draggled skirts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300391502">
	<b:glossaryEntry>made dirty or foul; "a building befouled with soot"; "breathing air fouled and darkened with factory soot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300391672">
	<b:glossaryEntry xml:space='preserve'><![CDATA[thickly covered with ingrained dirt or soot; "a miner''s begrimed face"; "dingy linen"; "grimy hands"; "grubby little fingers"; "a grungy kitchen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300391906">
	<b:glossaryEntry>spattered or spotted with dirt or filth; often used in combination; "dingy bespattered walls"; "a grease-spattered floor"; "a besplashed coach"; "mud-splashed trouser legs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300392172">
	<b:glossaryEntry>soiled with dirt or soot; "with feet black from playing outdoors"; "his shirt was black within an hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300392327"
	 b:glossaryEntry="infested with bugs"/>
<rdf:Description rdf:about="&a;300392397"
	 b:glossaryEntry='covered with a layer of dusty; "a dusty pile of books"'/>
<rdf:Description rdf:about="&a;300392518"
	 b:glossaryEntry="foul with waste matter"/>
<rdf:Description rdf:about="&a;300392603">
	<b:glossaryEntry>disgustingly dirty; filled or smeared with offensive matter; "as filthy as a pigsty"; "a foul pond"; "a nasty pigsty of a room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300392798">
	<b:glossaryEntry>foul and run-down and repulsive; "a flyblown bar on the edge of town"; "a squalid overcrowded apartment in the poorest part of town"; "squalid living conditions"; "sordid shantytowns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300393055">
	<b:glossaryEntry>smeared or soiled with grease or oil; "greasy coveralls"; "get rid of rubbish and oily rags"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300393207"
	 b:glossaryEntry='infested with lice; "burned their lousy clothes"'/>
<rdf:Description rdf:about="&a;300393307"
	 b:glossaryEntry="spotted or blotched"/>
<rdf:Description rdf:about="&a;300393381">
	<b:glossaryEntry>dirty and messy; covered with mud or muck; "muddy boots"; "a mucky stable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300393515"
	 b:glossaryEntry='covered with scum; "the scummy surface of the polluted pond"'/>
<rdf:Description rdf:about="&a;300393628">
	<b:glossaryEntry>smeared with something that soils or stains; these words are often used in combination; "oil-smeared work clothes"; "hostile faces smirched by the grime and rust"- Henry Roth; "ink-smudged fingers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300393909">
	<b:glossaryEntry>dirty with nasal discharge; "a snotty nose"; "a house full of snot-nosed kids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300394053"
	 b:glossaryEntry='soiled from travel; "travel-soiled clothes"'/>
<rdf:Description rdf:about="&a;300394173"
	 b:glossaryEntry='not having been swept; "unswept floors"'/>
<rdf:Description rdf:about="&a;300394266">
	<b:glossaryEntry>not cleaned with or as if with soap and water; "a sink full of unwashed dishes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300394400">
	<b:glossaryEntry>(of behavior or especially language) free from objectionable elements; fit for all observers; "good clean fun"; "a clean joke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300394632">
	<b:glossaryEntry>(extended sense) of exceptionally clean language; "lyrics as antiseptic as Sunday School"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300394778">
	<b:glossaryEntry>(of behavior or especially language) characterized by obscenity or indecency; "dirty words"; "a dirty old man"; "dirty books and movies"; "boys telling dirty jokes"; "has a dirty mouth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300395177">
	<b:glossaryEntry>humorously vulgar; "bawdy songs"; "off-color jokes"; "ribald language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300395320">
	<b:glossaryEntry>characterized by profanity or cursing; "foul-mouthed and blasphemous"; "blue language"; "profane words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300395498"
	 b:glossaryEntry="having lewd thoughts"/>
<rdf:Description rdf:about="&a;300395577">
	<b:glossaryEntry>characterized by obscenity; "had a filthy mouth"; "foul language"; "smutty jokes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300395735">
	<b:glossaryEntry>using foul or obscene language; "noisy foul-mouthed women all shouting at once"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300395887">
	<b:glossaryEntry>suggestive of or tending to moral looseness; "lewd whisperings of a dirty old man"; "an indecent gesture"; "obscene telephone calls"; "salacious limericks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300396115">
	<b:glossaryEntry>dealing with salacious or indecent material; "a scabrous novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300396233">
	<b:glossaryEntry>dealing pruriently with excrement and excretory functions; "scatological literature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300396376">
	<b:glossaryEntry>not spreading pollution or contamination; especially radioactive contamination; "a clean fuel"; "cleaner and more efficient engines"; "the tactical bomb is reasonably clean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300396619">
	<b:glossaryEntry>spreading pollution or contamination; especially radioactive contamination; "the air near the foundry was always dirty"; "the air near the foundry was always dirty"; "a dirty bomb releases enormous amounts of long-lived radioactive fallout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300396927">
	<b:glossaryEntry>exhibiting or caused by radioactivity; "radioactive isotope"; "radioactive decay"; "radioactive fallout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300397107">
	<b:glossaryEntry>having or dealing with dangerously high levels of radioactivity; "hot fuel rods"; "a hot laboratory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300397257"
	 b:glossaryEntry="not radioactive"/>
<rdf:Description rdf:about="&a;300397333"
	 b:glossaryEntry="(religion) ritually clean or pure"/>
<rdf:Description rdf:about="&a;300397472">
	<b:glossaryEntry>(Judaism) conforming to dietary laws; "kosher meat"; "a kosher kitchen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300397605">
	<b:glossaryEntry>(religion) ritually unclean or impure; "and the swine...is unclean to you"-Leviticus 11:3</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300397847">
	<b:glossaryEntry>having the purity corrupted; made unclean; "the defiled Temple"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300397964"
	 b:glossaryEntry="(Judaism) not conforming to dietary laws"/>
<rdf:Description rdf:about="&a;300398077">
	<b:glossaryEntry>defiling to the touch; especially used in traditional Hindu belief of the lowest caste or castes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300398231">
	<b:glossaryEntry>clear to the mind; "a clear and present danger"; "a clear explanation"; "a clear case of murder"; "a clear indication that she was angry"; "gave us a clear idea of human nature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300398675">
	<b:glossaryEntry>lacking subtlety; obvious; "gave us a broad hint that it was time to leave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300398813">
	<b:glossaryEntry>clearly or sharply defined to the mind; "clear-cut evidence of tampering"; "Claudius was the first to invade Britain with distinct...intentions of conquest"; "trenchant distinctions between right and wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300399098">
	<b:glossaryEntry>(of language) transparently clear; easily understandable; "writes in a limpid style"; "lucid directions"; "a luculent oration"- Robert Burton; "pellucid prose"; "a crystal clear explanation"; "a perspicuous argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300399427"
	 b:glossaryEntry='as it seems at first sight; "a prima facie case of murder"'/>
<rdf:Description rdf:about="&a;300399543">
	<b:glossaryEntry>clearly evident to the mind; "his opposition to slavery was unmistakable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300399675">
	<b:glossaryEntry>having the clarity and freshness of immediate experience; "a vivid recollection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300399807">
	<b:glossaryEntry>not clear to the mind; "the law itself was unclear on that point"; "the reason for their actions is unclear to this day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300400161">
	<b:glossaryEntry>causing bafflement; "the play was at the same time a bewildering and an exciting experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300400311">
	<b:glossaryEntry>unclear in form or expression; "the blurred aims of the group"; "sometimes one understood clearly and sometimes the meaning was clouded"- H.G.Wells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300400522">
	<b:glossaryEntry>lacking clarity of meaning; causing confusion or perplexity; "sent confusing signals to Iraq"; "perplexing to someone who knew nothing about it"; "a puzzling statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300400770">
	<b:glossaryEntry>not clearly understood or expressed; "an indeterminate turn of phrase"; "an impulse to go off and fight certain obscure battles of his own spirit"-Anatole Broyard; "their descriptions of human behavior become vague, dull, and unclear"- P.A.Sorokin; "vague...forms of speech...have so long passed for mysteries of science"- John Locke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300401181">
	<b:glossaryEntry>free from cloudiness; allowing light to pass through; "clear water"; "clear plastic bags"; "clear glass"; "the air is clear and clean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300401511">
	<b:glossaryEntry>transmitting light; able to be seen through with clarity; "the cold crystalline water of melted snow"; "crystal clear skies"; "could see the sand on the bottom of the limpid pool"; "lucid air"; "a pellucid brook"; "transparent cristal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300401862">
	<b:glossaryEntry>resembling glass in transparency or translucency; "the morning is as clear as diamond or as hyaline"-Sacheverell Sitwell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300402036">
	<b:glossaryEntry>clear and bright; "the liquid air of a spring morning"; "eyes shining with a liquid luster"; "limpid blue eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300402209">
	<b:glossaryEntry>almost transparent; allowing light to pass through diffusely; "translucent amber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300402366">
	<b:glossaryEntry>not made opaque or cloudy by sediment; "the wine was unclouded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300402485">
	<b:glossaryEntry>(of glass) lacking a frosted coating; "unfrosted light bulbs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300402602">
	<b:glossaryEntry>not clear; not transmitting or reflecting light or radiant energy; "opaque windows of the jail"; "opaque to X-rays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300402914">
	<b:glossaryEntry>(of especially liquids) clouded as with sediment; "a cloudy liquid"; "muddy coffee"; "murky waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300403099">
	<b:glossaryEntry>obscured by fog; "he could barely see through the fogged window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300403224">
	<b:glossaryEntry>(of glass) having a roughened coating resembling frost; "frosted glass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300403349">
	<b:glossaryEntry>having a frosted look from a powdery coating, as on plants; "glaucous stems"; "glaucous plums"; "glaucous grapes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300403517">
	<b:glossaryEntry>resembling milk in color or cloudiness; not clear; "milk glass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300403663"
	 b:glossaryEntry='incapable of being seen through; "solid blackness"'/>
<rdf:Description rdf:about="&a;300403765">
	<b:glossaryEntry>almost complete transparent to X-rays or other forms of radiation; "radiolucent tissues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300403911">
	<b:glossaryEntry>not transparent to X-rays or other forms of radiation; "barium sulfate is radiopaque"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300404053">
	<b:glossaryEntry>not mentally confused; able to think clearly and act intelligently</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300404230">
	<b:glossaryEntry>free from confusion or doubt; "a complex problem requiring a clear head"; "not clear about what is expected of us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300404396"
	 b:glossaryEntry='not mentally disordered; "an unclouded mind"'/>
<rdf:Description rdf:about="&a;300404496">
	<b:glossaryEntry>mentally confused; unable to think with clarity or act intelligently; "the flood of questions left her bewildered and confused"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300404840">
	<b:glossaryEntry>stupid and confused; used especially of persons; "blathering like the addlepated nincompoop that you are"; "a confused puddingheaded, muddleheaded fellow"- Isaac Sterne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300405119">
	<b:glossaryEntry>confused and vague; used especially of thinking; "muddleheaded ideas"; "your addled little brain"; "woolly thinking"; "woolly-headed ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300405389">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stupefied by alcoholic drink; "the wino''s poor befuddled mind"; "a mind befogged with drink"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300405548"
	 b:glossaryEntry='mentally disordered; "a mind clouded by sorrow"'/>
<rdf:Description rdf:about="&a;300405649">
	<b:glossaryEntry>in a state of mental numbness especially as resulting from shock; "he had a dazed expression on his face"; "lay semiconscious, stunned (or stupefied) by the blow"; "was stupid from fatigue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300405924">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stupefied or dizzied by something overpowering; "I fall back dazzled at beholding myself all rosy red, / At having, I myself, caused the sun to rise."- `Chanticler'' by Rostand]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300406153"
	 b:glossaryEntry="as if in a trance"/>
<rdf:Description rdf:about="&a;300406227">
	<b:glossaryEntry>(informal) dazed from or as if from repeated blows; "knocked silly by the impact"; "slaphappy with exhaustion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300406415">
	<b:glossaryEntry>(used of persons or behavior) inclined to show mercy; "a more clement judge reduced the sentence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300406602"
	 b:glossaryEntry="characterized by tolerance and mercy"/>
<rdf:Description rdf:about="&a;300406692">
	<b:glossaryEntry>used of persons or behavior; showing no clemency or mercy; "the harse sentence of an inclement judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300406885"
	 b:glossaryEntry='not forbearing; ruthless; "an unsparing critic"'/>
<rdf:Description rdf:about="&a;300406988"
	 b:glossaryEntry='(of weather or climate) physically mild; "clement weather"'/>
<rdf:Description rdf:about="&a;300407154">
	<b:glossaryEntry>mild and pleasant; "balmy days and nights"; "the climate was mild and conducive to life or growth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300407311"
	 b:glossaryEntry="(of weather of climate) physically severe"/>
<rdf:Description rdf:about="&a;300407480">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) thoroughly unpleasant; "filthy (or foul or nasty or vile) weather we''re having"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300407645">
	<b:glossaryEntry>marked by rain; "their vacation turned out to be a series of rainy days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300407769"
	 b:glossaryEntry="showing mental alertness and calculation and resourcefulness"/>
<rdf:Description rdf:about="&a;300407935">
	<b:glossaryEntry>marked by practical hardheaded intelligence; "a smart businessman"; "an astute tenant always reads the small print in a lease"; "he was too shrewd to go along with them on a road that could lead only to their overthrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300408224">
	<b:glossaryEntry>showing self-interest and shrewdness in dealing with others; "a cagey lawyer"; "too clever to be sound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300408403"
	 b:glossaryEntry="lacking or marked by lack of intellectual acuity"/>
<rdf:Description rdf:about="&a;300408666">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) having or revealing stupidity; "ridiculous anserine behavior"; "a dopey answer"; "a dopey kid"; "some fool idea about rewriting authors'' books"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300408939"
	 b:glossaryEntry="used informally"/>
<rdf:Description rdf:about="&a;300409106"
	 b:glossaryEntry="heavy and dull and stupid"/>
<rdf:Description rdf:about="&a;300409196">
	<b:glossaryEntry>slow to learn or understand; lacking intellectual acuity; "so dense he never understands anything I say to him"; "never met anyone quite so dim"; "although dull at classical learning, at mathematics he was uncommonly quick"- Thackeray; "dumb officials make some really dumb decisions"; "he was either normally stupid or being deliberately obtuse"; "worked with the slow students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300409663"
	 b:glossaryEntry="British informal"/>
<rdf:Description rdf:about="&a;300409745"
	 b:glossaryEntry="mentally sluggish"/>
<rdf:Description rdf:about="&a;300409838">
	<b:glossaryEntry>(of especially persons) lacking sense or understanding or judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300409996">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stupid and ignorant like proverbial rural inhabitants; ''the boy''s empty yokel-like expression"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300410147"
	 b:glossaryEntry="in the same direction as the rotating hands of a clock"/>
<rdf:Description rdf:about="&a;300410293"
	 b:glossaryEntry="rotating to the right"/>
<rdf:Description rdf:about="&a;300410405">
	<b:glossaryEntry>in the direction opposite to the rotation of the hands of a clock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300410603"
	 b:glossaryEntry="rotating to the left"/>
<rdf:Description rdf:about="&a;300410709">
	<b:glossaryEntry>at a great distance in time or space or degree; "we come from a far country"; "far corners of the earth"; "the far future"; "a far journey"; "the far side of the road"; "far from the truth"; "far in the future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300411149"
	 b:glossaryEntry="of a seeker; far from the object sought"/>
<rdf:Description rdf:about="&a;300411239">
	<b:glossaryEntry>far distant in space; "distant lands"; "remote stars"; "a remote outpost of civilization"; "a hideaway far removed from towns and cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300411449">
	<b:glossaryEntry>far distant in time; "distant events"; "the remote past or future"; "a civilization ten centuries removed from modern times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300411646">
	<b:glossaryEntry>very far away in space or time; "faraway mountains"; "the faraway future"; "troops landing on far-off shores"; "far-off happier times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300411844">
	<b:glossaryEntry>more distant in especially space or time; "they live in the farther house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300411972">
	<b:glossaryEntry xml:space='preserve'><![CDATA[comparatives of "far"; most remote in space or time or order; "had traveled to the farthest frontier"; "don''t go beyond the farthermost (or furthermost) tree"; "explored the furthest reaches of space"; "the utmost tip of the peninsula"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300412322">
	<b:glossaryEntry>more distant in especially degree; "nothing could be further from the truth"; "further from our expectations"; "farther from the truth"; "farther from our expectations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300412554">
	<b:glossaryEntry>remote from populous or much-traveled regions; "found a quiet out-of-the-way resort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300412728">
	<b:glossaryEntry>relatively far from a center or middle; "outlying settlements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300412848">
	<b:glossaryEntry>not far distant in time or space or degree or circumstances; "near neighbors"; "in the near future"; "they are near equals"; "his nearest approach to success"; "a very near thing"; "a near hit by the bomb"; "she was near tears"; "she was close to tears"; "had a close call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300413342">
	<b:glossaryEntry>near or close to but not necessarily touching; "lands adjacent to the mountains"; "New York and adjacent cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300413509">
	<b:glossaryEntry>based on strong likelihood or firm conviction rather than actual evidence; "a moral certainty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300413658">
	<b:glossaryEntry>close at hand; "the nearby towns"; "concentrated his study on the nearby planet Venus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300413797">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `near'') being the one of two that is less distant in space; "we walked to the nearer house"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300413957"
	 b:glossaryEntry='situated near one another; "neighbor states"'/>
<rdf:Description rdf:about="&a;300414103"
	 b:glossaryEntry="near in space or time"/>
<rdf:Description rdf:about="&a;300414175"
	 b:glossaryEntry="(superlative of `near'' or `nigh'') most near"/>
<rdf:Description rdf:about="&a;300414282">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a seeker; near to the object sought; "you''re getting warm"; "hot on the trail"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300414420">
	<b:glossaryEntry>separated in space or time or coming from or going to a distance; "the distant past"; "distant villages"; "the sound of distant traffic"; "a distant sound"; "a distant telephone call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300414801">
	<b:glossaryEntry>distant in either space or time; "the town is a mile away"; "a country far away"; "the game is a week away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300414962">
	<b:glossaryEntry>very distant in time or space; "deep in the past"; "deep in enemy territory"; "deep in the woods"; "a deep space probe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300415132"
	 b:glossaryEntry='most distant in any direction; "the extreme edge of town"'/>
<rdf:Description rdf:about="&a;300415243"
	 b:glossaryEntry='remote; "far-flung corners of the Empire"'/>
<rdf:Description rdf:about="&a;300415340"
	 b:glossaryEntry="not adjacent; not next"/>
<rdf:Description rdf:about="&a;300415420">
	<b:glossaryEntry>happening in or being of another town or city; "an out-of-town tryout"; "an out-of-town school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300415573">
	<b:glossaryEntry xml:space='preserve'><![CDATA[distant but within sight; "yonder valley"; "the hills yonder"; (`yon'' is dialectal, as in "what is yon place?")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300415743">
	<b:glossaryEntry>at or within a short distance in space or time or having elements near each other; "close to noon"; "how close are we to town?"; "a close formation of ships"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300416294">
	<b:glossaryEntry>nearest in space or position; immediately adjoining without intervening space; "had adjacent rooms"; "in the next room"; "the person sitting next to me"; "our rooms were side by side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300416557">
	<b:glossaryEntry>completely enveloping; "the ambient air"; "ambient sound"; "the ambient temperature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300416695">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pressed close to or lying flat against something; "adpressed hairs along the plant''s stem"; "igneous rocks...closely appressed by this force"-L.V.Pirsson]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300416916">
	<b:glossaryEntry>located close together; "with heads close together"; "approximate leaves grow together but are not united"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300417100">
	<b:glossaryEntry>close in time; about to occur; "retribution is at hand"; "some people believe the day of judgment is close at hand"; "in imminent danger"; "his impending retirement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300417364"
	 b:glossaryEntry='close in space; within reach; "the town is close at hand"'/>
<rdf:Description rdf:about="&a;300417497">
	<b:glossaryEntry>(nautical) having the sails trimmed for sailing as close to the wind as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300417636">
	<b:glossaryEntry>set close together; "close-set eyes"; "close-set teeth"; "her eyes are close set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300417791">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `close'') indicating the one of two that is the shorter distance away; "take the near street and ten turn right"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300417978">
	<b:glossaryEntry>(superlative of `close'') indicating the one of several that is the shortest distance away</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300418121">
	<b:glossaryEntry>very close or connected in space or time; "contiguous events"; "immediate contact"; "the immediate vicinity"; "the immediate past"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300418320">
	<b:glossaryEntry>closely encircling; "encompassing mountain ranges"; "the surrounding countryside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300418480">
	<b:glossaryEntry xml:space='preserve'><![CDATA[surrounding and closing in on or hemming in; "the army''s enveloping maneuver"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300418617"
	 b:glossaryEntry='being at close quarters; "hand-to-hand fighting"'/>
<rdf:Description rdf:about="&a;300418724">
	<b:glossaryEntry>placed side by side often for comparison; "juxtaposed pictures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300418844">
	<b:glossaryEntry xml:space='preserve'><![CDATA[drawn or pressed close to someone or something for or as if for affection or protection; "saw a number of small houses nestled against the hillside"; "like a baby snuggled in its mother''s arms"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300419102">
	<b:glossaryEntry>very close in space or time; "proximate words"; "proximate houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300419224">
	<b:glossaryEntry>close enough to be walked to; "walking distance"; "the factory with the big parking lot...is more convenient than the walk-to factory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300419428">
	<b:glossaryEntry>far apart in relevance or relationship; "a distant cousin"; "a distant likeness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300419652">
	<b:glossaryEntry>far removed mentally; "a faraway (or distant) look in her eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300419769">
	<b:glossaryEntry>having only distant social or legal ties; "a loosely knit group"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300419892">
	<b:glossaryEntry>far apart in nature; "considerations entirely removed (or remote) from politics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300420038">
	<b:glossaryEntry>separated in relationship by a given degree of descent; "a cousin once removed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300420174">
	<b:glossaryEntry>beyond or outside an area of immediate interest; remote; "a suggestion ulterior to the present discussion"; "without...any purpose, immediate or ulterior"- G.B.Shaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300420393">
	<b:glossaryEntry>close in relevance or relationship; "a close family"; "we are all...in close sympathy with..."; "close kin"; "a close resemblance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300420737">
	<b:glossaryEntry>very close in resemblance; "sketched in an approximate likeness"; "a near likeness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300420885"
	 b:glossaryEntry='very close and convivial; "boon companions"'/>
<rdf:Description rdf:about="&a;300420979">
	<b:glossaryEntry>very close in friendship or affection; "a bosom buddy"; "an intimate friendship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300421125">
	<b:glossaryEntry>(used informally) associated on close terms; "a close friend"; "the bartender was chummy with the regular customers"; "the two were thick as thieves for months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300421349">
	<b:glossaryEntry>held together as by social or cultural ties; "a close-knit family"; "close-knit little villages"; "the group was closely knit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300421547">
	<b:glossaryEntry>denoting confidence or intimacy; "a confidential approach"; "in confidential tone of voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300421697"
	 b:glossaryEntry='suggesting connivance; "a cozy arrangement with the police"'/>
<rdf:Description rdf:about="&a;300421807">
	<b:glossaryEntry>with or in a close or intimate relationship; "a good friend"; "my sisters and brothers are near and dear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300421977">
	<b:glossaryEntry>having mutual interests or affections; of established friendship; "on familiar terms"; "pretending she is on an intimate footing with those she slanders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300422196"
	 b:glossaryEntry='like or befitting a cousin; "a cousinly kiss"'/>
<rdf:Description rdf:about="&a;300422314">
	<b:glossaryEntry>like an uncle in kindness or indulgence; "showed avuncular concern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300422437"
	 b:glossaryEntry="not befitting a cousin"/>
<rdf:Description rdf:about="&a;300422516">
	<b:glossaryEntry>wearing or provided with clothing; sometimes used in combination; "clothed and in his right mind"- Bible; "proud of her well-clothed family"; "nurses clad in white"; "white-clad nurses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300423284"
	 b:glossaryEntry="clothed or adorned with finery"/>
<rdf:Description rdf:about="&a;300423413">
	<b:glossaryEntry>dressed or clothed especially in fine attire; often used in combination; "the elegantly attired gentleman"; "neatly dressed workers"; "monks garbed in hooded robes"; "went about oddly garmented"; "professors robed in crimson"; "tuxedo-attired gentlemen"; "crimson-robed Harvard professors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300423822">
	<b:glossaryEntry>in ceremonial attire and paraphernalia; "professors arrayed in robes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300423957"
	 b:glossaryEntry='dressed in black; "a black knight"; "black friars"'/>
<rdf:Description rdf:about="&a;300424059"
	 b:glossaryEntry="dressed in trousers"/>
<rdf:Description rdf:about="&a;300424159"
	 b:glossaryEntry='dressed warmly; "bundled-up sailors and soldiers"'/>
<rdf:Description rdf:about="&a;300424265">
	<b:glossaryEntry>clothed in finery (especially a horse in ornamental trappings)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300424385"
	 b:glossaryEntry='dressed in a cassock; "cassocked monks"'/>
<rdf:Description rdf:about="&a;300424480"
	 b:glossaryEntry="having or dressed in a coat"/>
<rdf:Description rdf:about="&a;300424560">
	<b:glossaryEntry>dressed in clothing characteristic of a period, country, or class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300424680"
	 b:glossaryEntry='having the head enclosed in a cowl or hood; "a cowled monk"'/>
<rdf:Description rdf:about="&a;300424792"
	 b:glossaryEntry="(archaic) dressed or adorned (as for battle)"/>
<rdf:Description rdf:about="&a;300424890"
	 b:glossaryEntry="dressed in fancy or formal clothing"/>
<rdf:Description rdf:about="&a;300425080"
	 b:glossaryEntry='wearing a gown; "beautifully gowned women"'/>
<rdf:Description rdf:about="&a;300425175"
	 b:glossaryEntry='dressed in a habit; "the habited men of the monastery"'/>
<rdf:Description rdf:about="&a;300425283">
	<b:glossaryEntry>wearing a heavy coat; "heavy-coated policemen astride noble horses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300425409"
	 b:glossaryEntry="dressed too elaborately"/>
<rdf:Description rdf:about="&a;300425490">
	<b:glossaryEntry>wearing or furnished with a petticoat; "petticoated ladies"; "a petticoated table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300425630">
	<b:glossaryEntry>used of British soldiers during the Revolutionary War because of their red coats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300425784">
	<b:glossaryEntry>outfitted or supplied with clothing; "recruits suited in green"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300425900"
	 b:glossaryEntry="wearing a surplice"/>
<rdf:Description rdf:about="&a;300425974"
	 b:glossaryEntry="(informal) dressed especially in smart clothes"/>
<rdf:Description rdf:about="&a;300426073">
	<b:glossaryEntry>dressed well or smartly; "the girls were well turned out and smart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300426197"
	 b:glossaryEntry='dressed in a tuxedo; "a tuxedoed gentleman"'/>
<rdf:Description rdf:about="&a;300426295"
	 b:glossaryEntry="inadequately or too informally clothed"/>
<rdf:Description rdf:about="&a;300426392">
	<b:glossaryEntry xml:space='preserve'><![CDATA[dressed in a uniform; "uniformed policemen lined the President''s route"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300426519"
	 b:glossaryEntry="dressed in ceremonial garments especially clerical vestment"/>
<rdf:Description rdf:about="&a;300426635"
	 b:glossaryEntry='dressed (or especially habited) in white; "white nuns"'/>
<rdf:Description rdf:about="&a;300426741"
	 b:glossaryEntry="not wearing clothing"/>
<rdf:Description rdf:about="&a;300427123">
	<b:glossaryEntry>completely unclothed; "bare bodies"; "naked from the waste up"; "a nude model"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300427283"
	 b:glossaryEntry="(used informally) completely unclothed"/>
<rdf:Description rdf:about="&a;300427486">
	<b:glossaryEntry>having the breasts uncovered or featuring such nudity; "topless waitresses"; "a topless cabaret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300427662">
	<b:glossaryEntry>having the head uncovered; "caught bareheaded by the downpour"; "with bared head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300427808">
	<b:glossaryEntry>having the legs uncovered by clothing; "barelegged children on the beach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300427938">
	<b:glossaryEntry>unclothed especially below the waist or featuring such nudeness; "bottomless dancers"; "a bottomless bar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300428100"
	 b:glossaryEntry="possessing no clothing"/>
<rdf:Description rdf:about="&a;300428208"
	 b:glossaryEntry="partly dressed in a loose or careless manner"/>
<rdf:Description rdf:about="&a;300428328"
	 b:glossaryEntry='not covered with clothing; "her exposed breast"'/>
<rdf:Description rdf:about="&a;300428441"
	 b:glossaryEntry="inadequately clothed"/>
<rdf:Description rdf:about="&a;300428551"
	 b:glossaryEntry="as naked as at birth"/>
<rdf:Description rdf:about="&a;300428744"
	 b:glossaryEntry="partially clothed"/>
<rdf:Description rdf:about="&a;300428816"
	 b:glossaryEntry="(British informal) stark naked"/>
<rdf:Description rdf:about="&a;300428901"
	 b:glossaryEntry="with clothing stripped off"/>
<rdf:Description rdf:about="&a;300428982"
	 b:glossaryEntry="having removed clothing"/>
<rdf:Description rdf:about="&a;300429121"
	 b:glossaryEntry="without any clothing at all"/>
<rdf:Description rdf:about="&a;300429211">
	<b:glossaryEntry>having a saddle on or being mounted on a saddled animal; "saddled and spurred and ready to ride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300429361"
	 b:glossaryEntry="with no saddle"/>
<rdf:Description rdf:about="&a;300429449"
	 b:glossaryEntry='riding without a saddle; "a bareback rider"'/>
<rdf:Description rdf:about="&a;300429560">
	<b:glossaryEntry>(meteorology) free from clouds or mist or haze; "on a clear day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300429748">
	<b:glossaryEntry>abounding with sunlight; "a bright sunny day"; "one shining norming"- John Muir; "when it is warm and shiny"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300429946"
	 b:glossaryEntry='free from clouds; "under a cloudless sky"'/>
<rdf:Description rdf:about="&a;300430055"
	 b:glossaryEntry='free of clouds or rain; "today will be fair and warm"'/>
<rdf:Description rdf:about="&a;300430159">
	<b:glossaryEntry>completely clear and fine; "serene skies and a bright blue sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300430275"
	 b:glossaryEntry='(meteorology) full of or covered with clouds; "cloudy skies"'/>
<rdf:Description rdf:about="&a;300430514">
	<b:glossaryEntry>filled or abounding with fog or mist; "a brumous October morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300430656"
	 b:glossaryEntry="filled or abounding with clouds"/>
<rdf:Description rdf:about="&a;300430778"
	 b:glossaryEntry="resembling a cloud"/>
<rdf:Description rdf:about="&a;300430862">
	<b:glossaryEntry>darkened with overcast; "a dark day"; "a dull sky"; "a gray rainy afternoon"; "gray clouds"; "the sky was leaden and thick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300431059"
	 b:glossaryEntry='darkened by clouds; "a heavy sky"'/>
<rdf:Description rdf:about="&a;300431178"
	 b:glossaryEntry='filled with vapor; "miasmic jungles"; "a vaporous bog"'/>
<rdf:Description rdf:about="&a;300431307">
	<b:glossaryEntry>clouded with a mixture of smoke and fog; "the smoggy atmosphere of Los Angeles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300431439">
	<b:glossaryEntry>located on or near or bordering on a coast; "coastal marshes"; "coastal waters"; "the Atlantic coastal plain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300431710">
	<b:glossaryEntry>along or following a coast; "coastal shipping"; "coastwise winds contributed to the storm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300431856"
	 b:glossaryEntry='close to a shore; "inshore fisheries"'/>
<rdf:Description rdf:about="&a;300431947">
	<b:glossaryEntry>bordering on or living or characteristic of those near the sea; "a maritime province"; "maritime farmers"; "maritime cultures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300432128">
	<b:glossaryEntry>pertaining to or located on or near the seacoast; "coastal towns"; "seaboard towns"; "seaside cottages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300432302">
	<b:glossaryEntry>of or on or relating to the seashore; "seashore resorts"; "a shore dinner"; "a marine on shore duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300432471">
	<b:glossaryEntry>directed or situated away from inland regions and toward the sea or coast; "from the hill he took a seaward course"; "on the seaward side of the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300432675"
	 b:glossaryEntry="situated away from an area''s coast or border"/>
<rdf:Description rdf:about="&a;300432808">
	<b:glossaryEntry>of or coming from the middle of a region or country; "upcountry districts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300432959">
	<b:glossaryEntry>surrounded entirely or almost entirely by land; "a landlocked country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300433086">
	<b:glossaryEntry>(of winds) coming from the sea toward the land; "an inshore breeze"; "an onshore gale"; "seaward winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300433263"
	 b:glossaryEntry='(of winds) coming from the land; "offshore winds"'/>
<rdf:Description rdf:about="&a;300433367">
	<b:glossaryEntry>marked by an orderly, logical, and aesthetically consistent relation of parts; "a coherent argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300433594">
	<b:glossaryEntry>marked by an orderly, logical, and aesthetically consistent relation of parts; "a logical argument"; "the orderly presentation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300433808">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perfectly consistent and coherent; "the novel''s seamless plot"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300433925">
	<b:glossaryEntry>without logical or meaningful connection; "a turgid incoherent presentation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300434112">
	<b:glossaryEntry>lacking orderly continuity; "a confused set of instructions"; "a confused dream about the end of the world"; "disconnected fragments of a story"; "scattered thoughts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300434422">
	<b:glossaryEntry>capable of collapsing or being collapsed; "a collapsible boat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300434628"
	 b:glossaryEntry='capable of being folded up and stored; "a foldaway bed"'/>
<rdf:Description rdf:about="&a;300434762">
	<b:glossaryEntry>having parts that slide one within another; "a telescopic antenna"; "a telescopic drinking cup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300434914">
	<b:glossaryEntry>constructed so as to tip up or out of the way; "the little tip-up seat of the taxi"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300435050"
	 b:glossaryEntry="not capable of collapsing"/>
<rdf:Description rdf:about="&a;300435171"
	 b:glossaryEntry="not telescopic"/>
<rdf:Description rdf:about="&a;300435262">
	<b:glossaryEntry>having small chinks or crannies (especially in or between rocks or stones); "a crannied wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300435410"
	 b:glossaryEntry="without chinks or crannies"/>
<rdf:Description rdf:about="&a;300435502"
	 b:glossaryEntry="forming a whole or aggregate"/>
<rdf:Description rdf:about="&a;300435713">
	<b:glossaryEntry>clustered together but not coherent; "an agglomerated flower head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300435879">
	<b:glossaryEntry>gathered or tending to gather into a mass or whole; "the aggregate amount of indebtedness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300436046"
	 b:glossaryEntry="formed by fitting or joining components together"/>
<rdf:Description rdf:about="&a;300436171">
	<b:glossaryEntry>characterized by the principle of ownership by the state or the people of the means of production</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300436328"
	 b:glossaryEntry="serving to distribute or allot or disperse"/>
<rdf:Description rdf:about="&a;300436555"
	 b:glossaryEntry="possible to distribute"/>
<rdf:Description rdf:about="&a;300436663"
	 b:glossaryEntry="spreading by diffusion"/>
<rdf:Description rdf:about="&a;300436826">
	<b:glossaryEntry>spreading throughout; "armed with permeative irony...he punctures affectations"; "the pervasive odor of garlic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300437029">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of a word) referring singly and without exception to the members of a group; "whereas `each,'' `every,'' `either,'' `neither,'' and `none'' are distributive or referring to a single member of a group, `which'' in `which of the men'' is separative"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300437327"
	 b:glossaryEntry='spreading through; "suffusive purple light"'/>
<rdf:Description rdf:about="&a;300437426"
	 b:glossaryEntry="made known; especially made widely known"/>
<rdf:Description rdf:about="&a;300437595"
	 b:glossaryEntry='called to public attention; "these advertised products"'/>
<rdf:Description rdf:about="&a;300437707">
	<b:glossaryEntry>made widely known especially by radio or television; "the broadcast news"; "everyone heard the broadcast rumors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300437883">
	<b:glossaryEntry xml:space='preserve'><![CDATA[publicly announced; "the royal couple''s much heralded world tour"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300438003"
	 b:glossaryEntry='formally made public; "published accounts"'/>
<rdf:Description rdf:about="&a;300438115"
	 b:glossaryEntry="kept from public knowledge by various means;"/>
<rdf:Description rdf:about="&a;300438289"
	 b:glossaryEntry="suppressed quietly or indirectly"/>
<rdf:Description rdf:about="&a;300438377">
	<b:glossaryEntry>(used of information or news) kept secret by using influence; "hushed-up stories sometimes leak out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300438533">
	<b:glossaryEntry>subdued or overcome; "the quelled rebellion"; "an uprising quenched almost before it started"; "a squelched rumor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300438724">
	<b:glossaryEntry>not (or not yet) made available for distribution or publication; "someone leaked the unreleased announcement"; "a film that remained unreleased for years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300438935">
	<b:glossaryEntry>prepared and printed for distribution and sale; "the complete published works Dickens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300439077"
	 b:glossaryEntry='not published; "unpublished letters and diaries"'/>
<rdf:Description rdf:about="&a;300439183"
	 b:glossaryEntry="suitable for publication"/>
<rdf:Description rdf:about="&a;300439265"
	 b:glossaryEntry="not suitable for publication"/>
<rdf:Description rdf:about="&a;300439353">
	<b:glossaryEntry>made known or told about; especially presented in a formal account; "his reported opinion"; "the reported findings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300439577">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') as reported or stated by; "according to historians"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300439703">
	<b:glossaryEntry>meriting report; "years of research produced no reportable results"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300439827"
	 b:glossaryEntry='reported or spread by word of mouth; "their rumored breakup"'/>
<rdf:Description rdf:about="&a;300439941"
	 b:glossaryEntry='not reported; "unreported results"'/>
<rdf:Description rdf:about="&a;300440032">
	<b:glossaryEntry>(of income) required by law to be reported; "reportable income"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300440152">
	<b:glossaryEntry>(of income) not reportable; not required by law to be reported; "very little income is unreportable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300440311"
	 b:glossaryEntry="marked by or relating to or resulting from combination"/>
<rdf:Description rdf:about="&a;300440491">
	<b:glossaryEntry>(mathematics) relating to the combination and arrangement of elements in sets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300440628"
	 b:glossaryEntry="able to or tending to combine"/>
<rdf:Description rdf:about="&a;300440759"
	 b:glossaryEntry="not involving combination"/>
<rdf:Description rdf:about="&a;300440863"
	 b:glossaryEntry="not able to combine"/>
<rdf:Description rdf:about="&a;300440941"
	 b:glossaryEntry="capable of igniting and burning"/>
<rdf:Description rdf:about="&a;300441120"
	 b:glossaryEntry="possible to burn"/>
<rdf:Description rdf:about="&a;300441241"
	 b:glossaryEntry="supporting combustion"/>
<rdf:Description rdf:about="&a;300441343"
	 b:glossaryEntry="can emit sparks or burst into flame"/>
<rdf:Description rdf:about="&a;300441434">
	<b:glossaryEntry>capable of catching fire spontaneously or causing fires or burning readily; "an incendiary agent"; "incendiary bombs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300441608"
	 b:glossaryEntry="like peat; rich in combustible carbonized vegetable matter"/>
<rdf:Description rdf:about="&a;300441718"
	 b:glossaryEntry="not capable of igniting and burning"/>
<rdf:Description rdf:about="&a;300441902"
	 b:glossaryEntry="impervious to damage by fire"/>
<rdf:Description rdf:about="&a;300441986"
	 b:glossaryEntry="difficult to burn"/>
<rdf:Description rdf:about="&a;300442115"
	 b:glossaryEntry="resistant to catching fire"/>
<rdf:Description rdf:about="&a;300442216"
	 b:glossaryEntry="impossible to ignite"/>
<rdf:Description rdf:about="&a;300442295">
	<b:glossaryEntry>tending or serving to explode or characterized by explosion or sudden outburst; "an explosive device"; "explosive gas"; "explosive force"; "explosive violence"; "an explosive temper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300442569">
	<b:glossaryEntry>(of munitions) going off; "bursting bombs"; "an exploding nuclear device"; "a spectacular display of detonating anti-tank mines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300442777"
	 b:glossaryEntry="exploding almost instantaneously"/>
<rdf:Description rdf:about="&a;300442866"
	 b:glossaryEntry='not explosive; "nonexplosive gases"; "a nonexplosive fuel"'/>
<rdf:Description rdf:about="&a;300442983">
	<b:glossaryEntry>set afire or burning; "the lighted candles"; "a lighted cigarette"; "a lit firecracker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300443166">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lighted up by or as by fire or flame; "forests set ablaze (or afire) by lightning"; "even the car''s tires were aflame"; "a night aflare with fireworks"; "candles alight on the tables"; "blazing logs in the fireplace"; "a burning cigarette"; "a flaming crackling fire"; "houses on fire"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300443597"
	 b:glossaryEntry='set afire; "the ignited paper"; "a kindled fire"'/>
<rdf:Description rdf:about="&a;300443721">
	<b:glossaryEntry>not set afire or burning; "the table was bare, the candles unlighted"; "held an unlit cigarette"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300443899"
	 b:glossaryEntry="not set afire"/>
<rdf:Description rdf:about="&a;300443968">
	<b:glossaryEntry xml:space='preserve'><![CDATA[large and and roomy; "a commodious harbor"; "a commodious building suitable for conventions"; (`convenient'' is archaic in this sense)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300444189">
	<b:glossaryEntry>(of buildings and rooms) having ample space; "a roomy but sparcely furnished apartment"; "a spacious ballroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300444362">
	<b:glossaryEntry>uncomfortably or inconveniently small; "incommodious hotel accommodations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300444513">
	<b:glossaryEntry>constricted in size; "cramped quarters"; "trying to bring children up in cramped high-rise apartments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300444669">
	<b:glossaryEntry xml:space='preserve'><![CDATA[providing or experiencing physical well-being or relief; "comfortable clothes"; "comfortable suburban houses"; "made himself comfortable in an armchair"; "the antihistamine made her feel more comfortable"; "are you comfortable?"; (`comfy'' is informal as in "feeling comfy now?")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300445103">
	<b:glossaryEntry>enjoying or affording comforting warmth and shelter especially in a small space; "a cozy nook near the fire"; "snug in bed"; "a snug little apartment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300445318"
	 b:glossaryEntry='affording comfort; "soft light that was easy on the eyes"'/>
<rdf:Description rdf:about="&a;300445426">
	<b:glossaryEntry>having a feeling of home; cozy and comfortable; "the homely everyday atmosphere"; "a homey little inn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300445607">
	<b:glossaryEntry>affording physical relief; "a soothing ointment for her sunburn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300445726">
	<b:glossaryEntry>providing or experiencing physical discomfort; "an uncomfortable chair"; "an uncomfortable day in the hot sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300446004">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feeling physical discomfort or pain; "my throat feels bad"; "she felt bad all over"; (''tough'' is occasionally used colloquially for `bad'' as in "he was feeling tough after a restless night")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300446252"
	 b:glossaryEntry='without comfort; "a comfortless room"'/>
<rdf:Description rdf:about="&a;300446347">
	<b:glossaryEntry>causing physical discomfort; "bites of black flies are more than irritating; they can be very painful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300446516">
	<b:glossaryEntry>characterized by physical misery; "a wet miserable weekend"; "spent a wretched night on the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300446681">
	<b:glossaryEntry>uncomfortable because of possible danger or trouble; "made things warm for the bookies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300446819">
	<b:glossaryEntry xml:space='preserve'><![CDATA[free from stress or conducive to mental ease; having or affording peace of mind; "was settled in a comfortable job, one for which he was well prepared"; "the comfortable thought that nothing could go wrong"; "was comfortable in his religious beliefs"; "she''s a comfortable person to be with"; "she felt comfortable with her fiance''s parents"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300447272"
	 b:glossaryEntry='socially at ease; "was at ease with strangers"'/>
<rdf:Description rdf:about="&a;300447375">
	<b:glossaryEntry>made comfortable or more comfortable in a time of distress; "the news make her feel comforted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300447525">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conducive to or feeling mental discomfort; "this kind of life can prove disruptive and uncomfortable"; "the uncomfortable truth"; "grew uncomfortable beneath his appraising eye"; "an uncomfortable way of surprising me just when I felt surest"; "the teacher''s presence at the conference made the child very uncomfortable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300447995">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not at ease socially; unsure and constrained in manner; "awkward and reserved at parties"; "ill at ease among eddies of people he didn''t know"; "was always uneasy with strangers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300448253">
	<b:glossaryEntry>caused to feel self-conscious and uncomfortable; "was discomfited by the personal questions"; "the child felt embarrassed by the attention of the adults"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300448478">
	<b:glossaryEntry>causing mental discomfort; "the disquieting sounds of nearby gunfire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300448605">
	<b:glossaryEntry>excessively and uncomfortably conscious of your appearance or behavior; "self-conscious teenagers"; "wondered if she could ever be untidy without feeling self-conscious about it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300448844">
	<b:glossaryEntry>corresponding in size or degree or extent; "pay should be commensurate with the time worked"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300449067"
	 b:glossaryEntry="of equal extent or duration"/>
<rdf:Description rdf:about="&a;300449166">
	<b:glossaryEntry>able to be measured by a common standard; "hours and minutes are commensurable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300449305">
	<b:glossaryEntry>agreeing in amount, magnitude, or degree; "the figures are large but the corresponding totals next year will be larger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300449519">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `with'') not corresponding in size or degree or extent; "a reward incommensurate with his effort"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300449749"
	 b:glossaryEntry="not proportionate"/>
<rdf:Description rdf:about="&a;300449829"
	 b:glossaryEntry="not having a common factor"/>
<rdf:Description rdf:about="&a;300449917"
	 b:glossaryEntry="being in due proportion"/>
<rdf:Description rdf:about="&a;300450072">
	<b:glossaryEntry>per person; "among the states Connecticut has a high per capita income"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300450200"
	 b:glossaryEntry="(archaic) proportionate"/>
<rdf:Description rdf:about="&a;300450284">
	<b:glossaryEntry xml:space='preserve'><![CDATA[properly related in size or degree or other measurable characteristics; usually followed by `to''; "punishment oughtt to be proportional to the crime"; "earnings relative to production"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300450538"
	 b:glossaryEntry="out of proportion"/>
<rdf:Description rdf:about="&a;300450636">
	<b:glossaryEntry>connected with or engaged in or sponsored by or used in commerce or commercial enterprises; "commercial trucker"; "commercial TV"; "commercial diamonds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300450971">
	<b:glossaryEntry>organized principally for financial gain; "Christmas has become a commercialized spectacle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300451123">
	<b:glossaryEntry>of or relating to or characteristic of trade or traders; "the mercantile North was forging ahead"- Van Wyck Brooks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300451308">
	<b:glossaryEntry>profit oriented; "a commercial book"; "preached a mercantile and militant patriotism"- John Buchan; "a mercenary enterprise"; "a moneymaking business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300451544">
	<b:glossaryEntry>(chemistry) of production of chemicals for commercial purposes especially on a large scale; "technical (or commercial) sulfuric acid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300451733">
	<b:glossaryEntry>resulting from or dependent on market factors rather than fundamental economic considerations; "analysts content that the stock market is due for a technical rally"; "the fall is only a technical correction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300451996">
	<b:glossaryEntry>relating to or used in or intended for trade or commerce; "a trade fair"; "trade journals"; "trade goods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300452156"
	 b:glossaryEntry="not connected with or engaged in commercial enterprises"/>
<rdf:Description rdf:about="&a;300452343"
	 b:glossaryEntry="not commercially motivated"/>
<rdf:Description rdf:about="&a;300452445">
	<b:glossaryEntry>not conducive to commercial success; "might prove arty and hence uncommercial"- H.E.Clurman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300452595"
	 b:glossaryEntry="not having been commercialized"/>
<rdf:Description rdf:about="&a;300452688">
	<b:glossaryEntry>used or designed for residence or limited to residences; "a residential hotel"; "a residential quarter"; "a residential college"; "residential zoning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300452896">
	<b:glossaryEntry>not residential; "the commercial or nonresidential areas of a town"; "community colleges are typically nonresidential"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300453075">
	<b:glossaryEntry>of military officers; holding by virtue of a commission a rank of second lieutenant or ensign or above</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300453236"
	 b:glossaryEntry="of military officers; appointed from enlisted personnel"/>
<rdf:Description rdf:about="&a;300453371"
	 b:glossaryEntry='of someone who has joined the military; "an enlisted man"'/>
<rdf:Description rdf:about="&a;300453486">
	<b:glossaryEntry>of no special distinction or quality; widely known or commonly encountered; average or ordinary or usual; "the common man"; "a common sailor"; "the common cold"; "a common nuisance"; "followed common procedure"; "it is common knowledge that she lives alone"; "the common housefly"; "a common brand of soap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300454025">
	<b:glossaryEntry>lacking special distinction, rank, or status; commonly encountered; "average people"; "the ordinary (or common) man in the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300454220">
	<b:glossaryEntry>representing or appealing to or adapted for the benefit of the people at large; "democratic art forms"; "a democratic or popular movement"; "popular thought"; "popular science"; "popular fiction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300454482">
	<b:glossaryEntry>of or for the common people; "demotic entertainments"; "demotic speech"; "a poet with a keen ear for demotic rhythms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300454653">
	<b:glossaryEntry xml:space='preserve'><![CDATA[frequently encountered; "a frequent (or common) error is using the transitive verb `lay'' for the intransitive `lie''";]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300454826">
	<b:glossaryEntry>prevailing among and common to the general public; "the general discontent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300454955">
	<b:glossaryEntry>of or involving the common people as constituting a fundamental politico-economic group; "a grassroots movement for nuclear disarmament"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300455148">
	<b:glossaryEntry>commonly used or supplied; "standard procedure"; "standard car equipment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300455276">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not common or ordinarily encountered; unusually great in amount or remarkable in character or kind; "uncommon birds"; "frost and floods are uncommon during these months"; "doing an uncommon amount of business"; "an uncommon liking for money"; "he owed his greatest debt to his mother''s uncommon character and ability"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300455774">
	<b:glossaryEntry xml:space='preserve'><![CDATA[surpassing what is common or usual or expected; "he paid especial attention to her"; "exceptional kindness"; "a matter of particular and unusual importance"; "a special occasion"; "a special reason to confide in her"; "what''s so special about the year 2000?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300456130">
	<b:glossaryEntry>not widely known; especially valued for its uncommonness; "a rare word"; "rare books"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300456266">
	<b:glossaryEntry>not commonly encountered; "two-career families are no longer unusual"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300456389"
	 b:glossaryEntry='out of the ordinary; "an unwonted softness in her face"'/>
<rdf:Description rdf:about="&a;300456499">
	<b:glossaryEntry xml:space='preserve'><![CDATA[occurring or encountered or experienced or observed frequently or in accordance with regular practice or procedure; "grew the usual vegetables"; "the usual summer heat"; "came at the usual time"; "the child''s usual bedtime"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300456846">
	<b:glossaryEntry>commonly used or practiced; usual; "his accustomed thoroughness"; "took his customary morning walk"; "his habitual comment"; "with her wonted candor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300457087">
	<b:glossaryEntry>in accord with regular practice or procedure; "took his regular morning walk"; "her regular bedtime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300457241">
	<b:glossaryEntry>not usual or common or ordinary; "a scene of unusual beauty"; "a man of unusual ability"; "cruel and unusual punishment"; "an unusual meteorite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300457601">
	<b:glossaryEntry xml:space='preserve'><![CDATA[differing from all others; not ordinary; "advertising that strives continually to be different"; "this new music is certainly different but I don''t really like it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300457820">
	<b:glossaryEntry>(of an official) serving an unusual or special function in addition to those of the regular officials; "an ambassador extraordinary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300458015">
	<b:glossaryEntry>not easily explained; "it is odd that his name is never mentioned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300458131"
	 b:glossaryEntry='out of the ordinary; "out-of-the-way information"'/>
<rdf:Description rdf:about="&a;300458241">
	<b:glossaryEntry>markedly different from the usual; "a peculiar hobby of stuffing and mounting bats"; "a man...feels it a peculiar insult to be taunted with cowardice by a woman"-Virginia Woolf</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300458472">
	<b:glossaryEntry>not customary or usual; "an unaccustomed pleasure"; "many varieties of unaccustomed foods"; "a new budget of unaccustomed austerity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300458663">
	<b:glossaryEntry>highly unusual or rare but not the single instance; "spoke with a unique accent"; "had unique ability in raising funds"; "a frankness unique in literature"; "a unique dining experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300458901">
	<b:glossaryEntry>producing or having flowers; "a flowering branch"; "flowering plants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300459062"
	 b:glossaryEntry='in bloom; "a field carpeted with blooming violets"'/>
<rdf:Description rdf:about="&a;300459167">
	<b:glossaryEntry>abounding in or covered with flowers; "flowering meadows"; "a flowery field"; "a bloomy sunlit slope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300459342"
	 b:glossaryEntry="producing or having no flowers or only unnoticeable ones"/>
<rdf:Description rdf:about="&a;300459467">
	<b:glossaryEntry>(chemistry) lacking affinity for water; tending not to dissolve in, mix with, or be wetted by water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300459624">
	<b:glossaryEntry>(chemistry) having a strong affinity for water; tending to dissolve in, mix with, or be wetted by water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300459803">
	<b:glossaryEntry>(especially of certain salts) becoming liquid by absorbing moisture from the air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300459942">
	<b:glossaryEntry>(chemistry) having a strong affinity for oils rather than water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300460080"
	 b:glossaryEntry="(chemistry) having an affinity for lipids"/>
<rdf:Description rdf:about="&a;300460191"
	 b:glossaryEntry="lacking affinity for oils"/>
<rdf:Description rdf:about="&a;300460273">
	<b:glossaryEntry>belonging to or participated in by a community as a whole; public; "for the common good"; "common lands are set aside for use by all members of a community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300460554">
	<b:glossaryEntry>for or by a group rather than individuals; "dipping each his bread into a communal dish of stew"- Paul Roche; "a communal settlement in which all earnings and food were shared"; "a group effort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300460814">
	<b:glossaryEntry>affecting the people or community as a whole; "community leaders"; "community interests"; "the public welfare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300460992">
	<b:glossaryEntry>being or characteristic of a single thing or person; "individual drops of rain"; "please mark the individual pages"; "they went their individual ways"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300461379">
	<b:glossaryEntry xml:space='preserve'><![CDATA[peculiar to the individual; "we all have our own idiosyncratic gestures"; "Michelangelo''s highly idiosyncratic style of painting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300461568">
	<b:glossaryEntry>marked by or expressing individuality; "an individualistic way of dressing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300461721">
	<b:glossaryEntry>(sports) being a system of play in which an individual defensive player guards an individual offensive player; "one-on-one defense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300461922">
	<b:glossaryEntry>separate and distinct from others; "an exception in this particular case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300462055">
	<b:glossaryEntry>considered individually; "the respective club members"; "specialists in their several fields"; "the various reports all agreed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300462268">
	<b:glossaryEntry>individual and distinct; "pegged down each separate branch to the earth"; "a gift for every single child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300462440"
	 b:glossaryEntry='involved two individuals; "single combat"'/>
<rdf:Description rdf:about="&a;300462537">
	<b:glossaryEntry>being a single and separate person or thing; "can the singular person be understood apart from his culture?"; "every fact in the world might be singular...unlike any other fact and sole of its kind"-William James</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300462804">
	<b:glossaryEntry>able or tending to communicate; "was a communicative person and quickly told all she knew"- W.M.Thackeray</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300463489">
	<b:glossaryEntry>characterized by or given to telling anecdotes; "anecdotal conversation"; "an anectodal history of jazz"; "he was at his anecdotic best"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300463707"
	 b:glossaryEntry="prone to communicate confidential information"/>
<rdf:Description rdf:about="&a;300463852"
	 b:glossaryEntry="prone to friendly informal communication"/>
<rdf:Description rdf:about="&a;300463963"
	 b:glossaryEntry='readily communicated; "communicable ideas"'/>
<rdf:Description rdf:about="&a;300464064">
	<b:glossaryEntry>used in communication; "he had few communicational grooves available for use"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300464203"
	 b:glossaryEntry="able to communicate in English"/>
<rdf:Description rdf:about="&a;300464296">
	<b:glossaryEntry>friendly and open and willing to talk; "wine made the guest expansive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300464434">
	<b:glossaryEntry>characterized by expression; "an expressive glance"; "a very expressive face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300464568">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `of'') giving expression to; "actons indicative of fear"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300464736"
	 b:glossaryEntry="able to communicate in French"/>
<rdf:Description rdf:about="&a;300464827"
	 b:glossaryEntry="able to communicate in German"/>
<rdf:Description rdf:about="&a;300464918">
	<b:glossaryEntry>making gestures while speaking; "her gesticulating hands and arms made words almost unnecessary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300465074">
	<b:glossaryEntry>being other than verbal communication; "the study of gestural communication"; "art like gesture is a form of nonverbal expression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300465271"
	 b:glossaryEntry="used of the language of the deaf"/>
<rdf:Description rdf:about="&a;300465396">
	<b:glossaryEntry>indicative of or announcing something to come; "the Beetles were heraldic of a new style of music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300465549"
	 b:glossaryEntry="able to communicate in Icelandic"/>
<rdf:Description rdf:about="&a;300465646"
	 b:glossaryEntry="able to communicate in Italian"/>
<rdf:Description rdf:about="&a;300465739">
	<b:glossaryEntry>consisting of or characterized by the telling of a story; "narrative poetry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300465871">
	<b:glossaryEntry>involving little use of language; "a nonverbal intelligence test"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300465992">
	<b:glossaryEntry>lacking verbal skill; "rural students often come from nonverbal backgrounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300466125">
	<b:glossaryEntry>freely communicative; candidly straightforward; "openhearted advice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300466251">
	<b:glossaryEntry>given to expressing yourself freely or insistently; "outspoken in their opposition to segregation"; "a vocal assembly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300466433"
	 b:glossaryEntry="able to communicate in Russian"/>
<rdf:Description rdf:about="&a;300466526"
	 b:glossaryEntry="able to communicate in Spanish"/>
<rdf:Description rdf:about="&a;300466619">
	<b:glossaryEntry>communicated in the form of words; "verbal imagery"; "a verbal protest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300466743">
	<b:glossaryEntry>inclined to tell long and involved stories (often of incredible happenings)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300466878"
	 b:glossaryEntry="not inclined to talk or give information or express opinions"/>
<rdf:Description rdf:about="&a;300467198"
	 b:glossaryEntry='void of expression; "a blank stare"'/>
<rdf:Description rdf:about="&a;300467285">
	<b:glossaryEntry>inclined to secrecy or reticence about divulging information; "although they knew her whereabouts her friends kept close about it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300467522">
	<b:glossaryEntry>deliberately impassive in manner; "deadpan humor"; "his face remained expressionless as the verdict was read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300467743"
	 b:glossaryEntry="very reluctant to give out information"/>
<rdf:Description rdf:about="&a;300467864">
	<b:glossaryEntry>without the means or right to communicate; "a prisoner held incommunicado"; "incommunicado political detainees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300468035"
	 b:glossaryEntry='not expressive; "an inexpressive face"'/>
<rdf:Description rdf:about="&a;300468132">
	<b:glossaryEntry>failing to speak or communicate etc when expected to; "the witness remained silent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300468274">
	<b:glossaryEntry>very difficult to pronounce correctly; "an unpronounceable foreign word"; "unutterable consonant clusters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300468456">
	<b:glossaryEntry>closely and firmly united or packed together; "compact soil"; "compact clusters of flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300468745">
	<b:glossaryEntry>(used of soil) compact and fine-grained; "the clayey soil was heavy and easily saturated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300468904"
	 b:glossaryEntry="packed especially tightly"/>
<rdf:Description rdf:about="&a;300468988"
	 b:glossaryEntry="forming a solid mass"/>
<rdf:Description rdf:about="&a;300469067"
	 b:glossaryEntry='wedged or packed in together; "an impacted tooth"'/>
<rdf:Description rdf:about="&a;300469180"
	 b:glossaryEntry='pressed together or compressed; "packed snow"'/>
<rdf:Description rdf:about="&a;300469278">
	<b:glossaryEntry>(especially of rows as of troops or mountains) pressed together; "in serried ranks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300469415">
	<b:glossaryEntry>packed closely together; "the stood in a tight little group"; "hair in tight curls"; "the pub was packed tight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300469578">
	<b:glossaryEntry>not compact or dense in structure or arrangement; "loose gravel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300469766">
	<b:glossaryEntry>(used of soil) loose and large-grained in consistency; "light sandy soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300469909"
	 b:glossaryEntry='(of soil) unstable; "shifting sands"; "unfirm earth"'/>
<rdf:Description rdf:about="&a;300470025"
	 b:glossaryEntry='full of silt; "silty soil"'/>
<rdf:Description rdf:about="&a;300470103"
	 b:glossaryEntry='loose and unstratified; "unconsolidated soil"'/>
<rdf:Description rdf:about="&a;300470209"
	 b:glossaryEntry="able to be compared or worthy of comparison"/>
<rdf:Description rdf:about="&a;300470381">
	<b:glossaryEntry>similar in some respect and so able to be compared in order to show differences and similarities; "pianists of comparable ability"; "cars comparable with each other in terms of fuel consumption"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300470640">
	<b:glossaryEntry>worthy of comparison; as good as; "at that moment nothing in the world seemed comparable to sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300470801">
	<b:glossaryEntry>such that comparison is impossible; unsuitable for comparison or lacking features that can be compared; "an incomparable week of rest and pleasure"; "the computer proceeds with its incomparable logic and efficiency"; "this report is incomparable with the earlier ones because of different breakdowns of the data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300471295">
	<b:glossaryEntry>unsurpassed in some respect up to the present; "prices at an all-time high"; "morale at an all-time low"; "among the all-time great lefthanders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300471494">
	<b:glossaryEntry>impossible to measure or compare in value or size or excellence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300471619">
	<b:glossaryEntry xml:space='preserve'><![CDATA[eminent beyond or above comparison; "matchless beauty"; "the team''s nonpareil center fielder"; "she''s one girl in a million"; "the one and only Muhammad Ali"; "a peerless scholar"; "infamy unmatched in the Western world"; "wrote with unmatchable clarity"; "unrivaled mastery of her art"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300472062">
	<b:glossaryEntry>radically distinctive and without equal; "he is alone in the field of microbiology"; "this theory is altogether alone in its penetration of the problem"; "Bach was unique in his handling of counterpoint"; "craftsmen whose skill is unequaled"; "unparalleled athletic ability"; "a breakdown of law unparalleled in our history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300472490">
	<b:glossaryEntry>showing or having compassion; "heard the soft and compassionate voices of women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300472720">
	<b:glossaryEntry>feeling and exhibiting concern and empathy for others; "caring friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300472844">
	<b:glossaryEntry>feeling or expressing sorrow or pity; "a pitying observer threw his coat around her shoulders"; "let him perish without a pitying thought of ours wasted upon him"- Thomas De Quincey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300473102">
	<b:glossaryEntry xml:space='preserve'><![CDATA[easily moved by another''s distress; "a noble tenderhearted creature who sympathizes with all the human race"- W.M.Thackeray]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300473285">
	<b:glossaryEntry>lacking compassion or feeling for others; "nor silver-shedding tears could penetrate her uncompassionate sire"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300473524"
	 b:glossaryEntry='devoid of feeling for others; "an unfeeling wretch"'/>
<rdf:Description rdf:about="&a;300473660">
	<b:glossaryEntry>able to exist and perform in harmonious or agreeable combination; "a compatible married couple";"her deeds were compatible with her ideology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300473966">
	<b:glossaryEntry>used of plants; capable of cross-fertilization or of being grafted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300474088"
	 b:glossaryEntry="suitable or appropriate together"/>
<rdf:Description rdf:about="&a;300474176">
	<b:glossaryEntry>existing together in harmony; "harmonious family relationships"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300474296">
	<b:glossaryEntry>not compatible; "incompatible personalities"; "incompatible colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300474566"
	 b:glossaryEntry="incapable of harmonious association"/>
<rdf:Description rdf:about="&a;300474660">
	<b:glossaryEntry>sharply and harshly discordant; "clashing interests of loggers and conservationists"; "clashing colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300474818"
	 b:glossaryEntry="unable to be both true at the same time"/>
<rdf:Description rdf:about="&a;300474938"
	 b:glossaryEntry="used of plant stock or scions; incapable of being grafted"/>
<rdf:Description rdf:about="&a;300475053">
	<b:glossaryEntry>(computers) capable of being used with or connected to other devices or components without modification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300475213">
	<b:glossaryEntry>(computers) incapable of being used with or connected to other devices or components without modification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300475377"
	 b:glossaryEntry="(chemistry, physics) capable of mixing"/>
<rdf:Description rdf:about="&a;300475498">
	<b:glossaryEntry>capable of forming a homogeneous mixture that neither separates nor is altered by chemical interaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300475657"
	 b:glossaryEntry="(chemistry, physics) incapable of mixing"/>
<rdf:Description rdf:about="&a;300475784">
	<b:glossaryEntry>used especially of solids or solutions; incapable of blending into a stable homogeneous mixture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300475938">
	<b:glossaryEntry>properly or sufficiently qualified or capable or efficient; "a competent typist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300476218">
	<b:glossaryEntry>have the skills and qualifications to do things well; "able teachers"; "a capable administrator"; "children as young as 14 can be extremely capable and dependable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300476442">
	<b:glossaryEntry>able to accomplish a purpose; functioning effectively; "people who will do nothing unless they get something out of it for themselves are often highly effective persons..."-G.B.Shaw; "effective personnel"; "an efficient secretary"; "the efficient cause of the revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300476781"
	 b:glossaryEntry='(law) legally qualified; "a competent witness"'/>
<rdf:Description rdf:about="&a;300476883">
	<b:glossaryEntry>worthy of a good workman; "a competent job"; "the book is a workmanlike job with chronology and bibliography and index"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300477060">
	<b:glossaryEntry>not qualified or suited for a purpose; "an incompetent secret service"; "the filming was hopeless incompetent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300477390">
	<b:glossaryEntry>generally incompetent and ineffectual; "feckless attempts to repair the plumbing"; "inept handling of the account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300477567">
	<b:glossaryEntry>lacking the necessary skill or knowledge etc.; "an incapable helper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300477705">
	<b:glossaryEntry>lacking the ability or skill to perform effectively; inadequate; "an ineffective administration"; "inefficient workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300477896">
	<b:glossaryEntry>(law) lacking specific legal qualifications; "a wife is usually considered unqualified to testify against her husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300478072">
	<b:glossaryEntry>not characteristic of or suitable for a good workman; "an unworkmanlike result"; "an unworkmanlike tool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300478236">
	<b:glossaryEntry xml:space='preserve'><![CDATA[involving competition or competitiveness; "competitive games"; "to improve one''s competitive position"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300478500">
	<b:glossaryEntry>striving to overcome in argument; "a dialectical and agonistic approach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300478654">
	<b:glossaryEntry>being in competition; "rival suitors"; "competing businesses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300478785">
	<b:glossaryEntry>striving or struggling in rivalry or battle; "contending armies"; "two contending parties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300478932"
	 b:glossaryEntry="eager to surpass others"/>
<rdf:Description rdf:about="&a;300479021">
	<b:glossaryEntry>provided with a worthy adversary or competitor; "matched teams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300479138">
	<b:glossaryEntry>not involving competition or competitiveness; "noncompetitive positions"; "noncompetitive interest in games"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300479361">
	<b:glossaryEntry>willing to adjust to differences in order to obtain agreement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300479496">
	<b:glossaryEntry>having exclusive control over a commercial activity by possession or legal grant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300479635"
	 b:glossaryEntry="not inclined to compete"/>
<rdf:Description rdf:about="&a;300479718">
	<b:glossaryEntry>expressing pain or dissatisfaction of resentment; "a complaining wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300479936"
	 b:glossaryEntry='habitually complaining; "a whining child"'/>
<rdf:Description rdf:about="&a;300480073">
	<b:glossaryEntry>muttering discontentedly; "the grumbling boarders requested a meeting with the cook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300480213"
	 b:glossaryEntry="making a protest"/>
<rdf:Description rdf:about="&a;300480302"
	 b:glossaryEntry="wishing discontentedly"/>
<rdf:Description rdf:about="&a;300480379"
	 b:glossaryEntry='not complaining; "uncomplaining courage"'/>
<rdf:Description rdf:about="&a;300480533"
	 b:glossaryEntry="enduring without protest or complaint"/>
<rdf:Description rdf:about="&a;300480624"
	 b:glossaryEntry="without any murmur of discontent or protest"/>
<rdf:Description rdf:about="&a;300480740">
	<b:glossaryEntry>capable of being compressed or made more compact; "compressible packing materials"; "a compressible box"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300480921"
	 b:glossaryEntry='reduced in volume by pressure; "compressed air"'/>
<rdf:Description rdf:about="&a;300481025">
	<b:glossaryEntry>impossible to compress; resisting compression; "mounds of incompressible garbage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300481167">
	<b:glossaryEntry>including all components without exception; being one unit or constituting the full amount or extent or duration; complete; "gave his whole attention"; "a whole wardrobe for the tropics"; "the whole hog"; "a whole week"; "the baby cried the whole trip home"; "a whole loaf of bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300481645">
	<b:glossaryEntry>constituting the full quantity or extent; complete; "an entire town devastated by an earthquake"; "gave full attention"; "a total failure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300481851">
	<b:glossaryEntry>representing the full height of the human figure; "a full-length portrait"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300481983">
	<b:glossaryEntry>occupying an entire page in a book or paper; "a full-page ad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300482100">
	<b:glossaryEntry>constituting the undiminished entirety; lacking nothing essential especially not damaged; "a local motion keepeth bodies integral"- Bacon; "was able to keep the collection entire during his lifetime"; "fought to keep the union intact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300482407">
	<b:glossaryEntry>(of time) constituting the full extent or duration; "all the livelong day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300482536">
	<b:glossaryEntry>not separated into parts or shares; constituting an undivided unit; "an undivided interest in the property"; "a full share"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300482722">
	<b:glossaryEntry>constituting or comprising a part or fraction of a possible whole or entirety; "a fractional share of the vote"; "a partial dose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300483160"
	 b:glossaryEntry="signifying an exact divisor or factor of a quantity"/>
<rdf:Description rdf:about="&a;300483265">
	<b:glossaryEntry>forming or functioning as part of a whole; "component parts"; "a constituent element"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300483426">
	<b:glossaryEntry>constituting a division or an aliquot part of the basic monetary unit; "American divisional (fractional) coins include the dime and the nickel"; "fractional currency is currency in denominations less than the basic monetary unit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300483712">
	<b:glossaryEntry>the fractional price paid in cash at time of purchase; "the down payment"; "a payment of $200 down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300483862">
	<b:glossaryEntry>consisting of small disconnected parts; "fragmentary remains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300483994">
	<b:glossaryEntry>consisting of one of two equivalent parts in value or quantity; "a half chicken"; "lasted a half hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300484150"
	 b:glossaryEntry='including only half or a portion; "halfway measures"'/>
<rdf:Description rdf:about="&a;300484256"
	 b:glossaryEntry='relating to only part of a whole; "part owner"'/>
<rdf:Description rdf:about="&a;300484356">
	<b:glossaryEntry>consisting of one of four equivalent parts; "a quarter pound of butter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300484484">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) half or partial; "`semi'' is a prefix in such words as `semicircular'' and `semiannual'' and `semiconscious''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300484650"
	 b:glossaryEntry='being one of three equal parts; "a third share of the money"'/>
<rdf:Description rdf:about="&a;300484765">
	<b:glossaryEntry>representing three quarters of something; "a three-quarter-length portrait"; "a three-quarter view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300484924">
	<b:glossaryEntry>(of siblings) having the same parents; "whole brothers and sisters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300485043">
	<b:glossaryEntry>(of siblings) related through one parent only; "a half brother"; "half sister"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300485172">
	<b:glossaryEntry>bound or obligated, as under a pledge to a particular cause, action, or attitude; "committed church members"; "a committed Marxist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300485395">
	<b:glossaryEntry>deeply devoted to; "bound up in her teaching"; "is wrapped up in his family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300485539">
	<b:glossaryEntry>bound by or as if by an oath; "according to an early tradition became his sworn brother"; "sworn enemies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300485706"
	 b:glossaryEntry="not bound or pledged"/>
<rdf:Description rdf:about="&a;300485838">
	<b:glossaryEntry>having no commitments or responsibilities; carefree; "a fancy-free bachelor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300485971">
	<b:glossaryEntry>not definitely committed to a party or policy; "floating voters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300486093"
	 b:glossaryEntry='not yet having made a commitment; "undecided voters"'/>
<rdf:Description rdf:about="&a;300486201">
	<b:glossaryEntry>devoted to a cause or ideal or purpose; "a dedicated dancer"; "dedicated teachers"; "dedicated to the proposition that all men are created equal"- A.Lincoln</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300486467">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') dedicated exclusively to a purpose or use; "large sums devoted to the care of the poor"; "a life devoted to poetry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300486658">
	<b:glossaryEntry>zealous in devotion or affection; "a devoted husband and father"; "devoted friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300486795">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `to'') devoted exclusively to a single use or purpose or person; "a fund sacred to charity"; "a morning hour sacred to study"; "a private office sacred to the President"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300487035">
	<b:glossaryEntry>not dedicated; "the playground has been completed but is still undedicated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300487168">
	<b:glossaryEntry>having every necessary or normal part or component or step; "a complete meal"; "a complete wardrobe"; "a complete set pf the Britannica"; "a complete set of china"; "a complete defeat"; "a complete accounting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300487828">
	<b:glossaryEntry>complete and without restriction or qualification; sometimes used informally as intensifiers; "absolute freedom"; "an absolute dimwit"; "a downright lie"; "out-and-out mayhem"; "an out-and-out lie"; "a rank outsider"; "many right-down vices"; "got the job through sheer persistence"; "sheer stupidity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300488247">
	<b:glossaryEntry>successfully completed or brought to an end; "his mission accomplished he took a vacation"; "the completed project"; "the joy of a realized ambition overcame him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300488491"
	 b:glossaryEntry='completely given to or absorbed by; "became all attention"'/>
<rdf:Description rdf:about="&a;300488599">
	<b:glossaryEntry>using all available resources; "all-out war"; "a full-scale compaign against nuclear power plants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300488764">
	<b:glossaryEntry>covering the entire surface; "an allover pattern"; "got an allover tan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300488889">
	<b:glossaryEntry>thorough and without qualification; "a clean getaway"; "a clean sweep"; "a clean break"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300489028"
	 b:glossaryEntry='(football) caught; "a completed forward pass"'/>
<rdf:Description rdf:about="&a;300489129"
	 b:glossaryEntry='sudden and complete; "came to a dead stop"'/>
<rdf:Description rdf:about="&a;300489225">
	<b:glossaryEntry>very thorough; exhaustively complete; "an exhaustive study"; "made a thorough search"; "thoroughgoing research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300489420">
	<b:glossaryEntry>given substance or detail; completed; "did not spring full-clad from his imagination"; "a plan fleshed out with statistics and details"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300489625">
	<b:glossaryEntry>complete in extent or degree and in every particular; "a full game"; "a total eclipse"; "a total disaster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300489790">
	<b:glossaryEntry>having or displaying all the characteristics necessary for completeness; "a full-blown financial crisis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300489951">
	<b:glossaryEntry>complete in every respect; "a full-dress debate"; "a full-dress investigation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300490086">
	<b:glossaryEntry>thorough; "had a good workout"; "gave the house a good cleaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300490201"
	 b:glossaryEntry='without reservation; "hearty support"'/>
<rdf:Description rdf:about="&a;300490291">
	<b:glossaryEntry>constituting a complete and independent unit in and of itself; "the university is like a self-contained city with shops and all amenities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300490490"
	 b:glossaryEntry='thorough; "a sound thrashing"'/>
<rdf:Description rdf:about="&a;300490571"
	 b:glossaryEntry="(electronics) capable of operating independently"/>
<rdf:Description rdf:about="&a;300490677">
	<b:glossaryEntry>not complete or total; not completed; "an incomplete account of his life"; "political consequences of incomplete military success"; "an incomplete forward pass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300491051"
	 b:glossaryEntry='lacking a part or parts; "a broken set of encyclopedia"'/>
<rdf:Description rdf:about="&a;300491159"
	 b:glossaryEntry='partial; "gave me a half smile"; "he did only a half job"'/>
<rdf:Description rdf:about="&a;300491270">
	<b:glossaryEntry>being or affecting only a part; not total; "a partial description of the suspect"; "partial collapse"; "a partial eclipse"; "a partial monopoly"; "partial immunity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300491488">
	<b:glossaryEntry>being in the earliest stages of development; "rudimentary plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300491610">
	<b:glossaryEntry>giving only major points; lacking completeness; "a sketchy account"; "details of the plan remain sketchy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300491784">
	<b:glossaryEntry>(football) not caught or not caught within bounds; "an uncompleted pass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300491914">
	<b:glossaryEntry>(botany) having all four whorls or principal parts--sepals and petals and stamens and carpels (or pistils); "complete flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300492095">
	<b:glossaryEntry>(botany) lacking one or more of the four whorls of the complete flower--sepals or petals or stamens or pistils; "an incomplete flower"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300492304">
	<b:glossaryEntry>including all or everything; "comprehensive coverage"; "a comprehensive history of the revolution"; "a comprehensive survey"; "a comprehensive education"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300492805">
	<b:glossaryEntry>broad in scope or content; "across-the-board pay increases"; "an all-embracing definition"; "blanket sanctions against human-rights violators"; "an invention with broad applications"; "a panoptic study of Soviet nationality"- T.G.Winner; "granted him wide powers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300493236">
	<b:glossaryEntry>many-sided; "an all-around athlete"; "a well-rounded curriculum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300493390">
	<b:glossaryEntry>of worldwide scope or applicability; "an issue of cosmopolitan import"; "the shrewdest political and ecumenical comment of our time"- Christopher Morley; "universal experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300493686">
	<b:glossaryEntry>omitting no one; from the door of one house to that of the next; "a door-to-door campaign"; "house-to-house coverage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300493879"
	 b:glossaryEntry='broad in scope or content; "encyclopedic knowledge"'/>
<rdf:Description rdf:about="&a;300494005">
	<b:glossaryEntry>having broad range or effect; "had extensive press coverage"; "far-reaching changes in the social structure"; "sweeping reforms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300494215">
	<b:glossaryEntry>having broad power and range and scope; "taking the large view"; "a large effect"; "a large sympathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300494368"
	 b:glossaryEntry='providing for many things at once; "an omnibus law"'/>
<rdf:Description rdf:about="&a;300494476">
	<b:glossaryEntry>full in all respects; "a plenary session of the legislature"; "a diplomat with plenary powers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300494624">
	<b:glossaryEntry>existing in both space and time; having both spatial extension and temporal duration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300494786">
	<b:glossaryEntry>including more than a specified category; "a super experiment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300494900">
	<b:glossaryEntry>covering or applying simultaneously to a number of similar items or elements or groups; "an umbrella organization"; "umbrella insurance coverage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300495100"
	 b:glossaryEntry="not comprehensive"/>
<rdf:Description rdf:about="&a;300495216"
	 b:glossaryEntry="including only a part"/>
<rdf:Description rdf:about="&a;300495291">
	<b:glossaryEntry>serenely self-possessed and free from agitation especially in times of stress; "the performer seemed completely composed as she stepped onto the stage"; "I felt calm and more composed than I had in a long time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300495682">
	<b:glossaryEntry>not agitated; without losing self-possession; "spoke in a calm voice"; "remained calm throughout the uproar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300495854">
	<b:glossaryEntry>not easily perturbed or excited or upset; marked by extreme calm and composure; "hitherto imperturbable, he now showed signs of alarm"; "an imperturbable self-possession"; "unflappable in a crisis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300496125">
	<b:glossaryEntry>in full control of your faculties; "the witness remained collected throughout the cross-examination"; "perfectly poised and sure of himself"; "more self-contained and more dependable than many of the early frontiersmen"; "strong and self-possessed in the face of trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300496525">
	<b:glossaryEntry>marked by calm self-control especially in trying circumstances; "a cool negotiator"; "play it cool"; "keep cool"; "remained coolheaded in the crisis"; "one of the most nerveless champions in the history of the tournament"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300496822">
	<b:glossaryEntry>free from emotional agitation or nervous tension; "the waiters were unflurried and good natured"; "with contented mind and unruffled spirit"- Anthony Trollope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300497077">
	<b:glossaryEntry>having your composure disturbed; "looked about with a wandering and discomposed air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300497363">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feeling or caused to feel uneasy and self-conscious; "felt abashed at the extravagant praise"; "chagrined at the poor sales of his book"; "was embarrassed by her child''s tantrums"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300497622">
	<b:glossaryEntry>having a red face from embarrassment or shame or agitation or emotional upset; "the blushing boy was brought before the Principal"; "her blushful beau"; "was red-faced with anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300497882">
	<b:glossaryEntry>caused to show discomposure; "refused to be fazed by the objections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300498023">
	<b:glossaryEntry>having self-possession upset; thrown into confusion; "the hecklers pelted the discombobulated speaker with anything that came to hand"; "looked at each other dumbly, quite disconcerted"- G.B.Shaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300498295">
	<b:glossaryEntry>thrown into a state of agitated confusion; (`rattled'' is an informal term)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300498469">
	<b:glossaryEntry>emotionally upset; "the incident left him unstrung and incapable of rational effort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300498608">
	<b:glossaryEntry>readily comprehended or understood; "an idea comprehensible to the average mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300498892">
	<b:glossaryEntry>capable of being read with comprehension; "readily accessible to the nonprofessional reader"; "the tales seem more approachable than his more difficult novels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300499123"
	 b:glossaryEntry="capable of being apprehended or understood"/>
<rdf:Description rdf:about="&a;300499283"
	 b:glossaryEntry="capable of being known"/>
<rdf:Description rdf:about="&a;300499386">
	<b:glossaryEntry>difficult to understand; "the most incomprehensible thing about the universe is that it is comprehensible"- A. Einstein</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300499767">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by difficulty of style or expression; "much that was dark is now quite clear to me"; "those who do not appreciate Kafka''s work say his style is obscure"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300499987">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not clear to the understanding; "I didn''t grasp the meaning of that enigmatic comment until much later"; "prophetic texts so enigmatic that their meaning has been disputed for centuries"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300500254"
	 b:glossaryEntry='impossible to understand; "impenetrable jargon"'/>
<rdf:Description rdf:about="&a;300500360">
	<b:glossaryEntry>impossible to determine the meaning of; "an indecipherable message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300500488">
	<b:glossaryEntry>not caught with the senses or the mind; "words lost in the din"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300500611"
	 b:glossaryEntry="not clearly understood or expressed"/>
<rdf:Description rdf:about="&a;300500716"
	 b:glossaryEntry="curving inward"/>
<rdf:Description rdf:about="&a;300500982">
	<b:glossaryEntry>of the cup-shaped socket that receives the head of the thigh bone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300501128"
	 b:glossaryEntry="concave on both sides"/>
<rdf:Description rdf:about="&a;300501223"
	 b:glossaryEntry="shaped like a pouch"/>
<rdf:Description rdf:about="&a;300501323">
	<b:glossaryEntry>concave on one side and convex on the other with the concavity being greater than the convexity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300501479"
	 b:glossaryEntry="shaped like (or supporting) a cupule"/>
<rdf:Description rdf:about="&a;300501593">
	<b:glossaryEntry>having the central portion lower than the margin; "a depressed pustule"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300501731"
	 b:glossaryEntry="shaped like a dish"/>
<rdf:Description rdf:about="&a;300501816"
	 b:glossaryEntry="flat on one side and concave on the other"/>
<rdf:Description rdf:about="&a;300501916"
	 b:glossaryEntry="resembling an alcove"/>
<rdf:Description rdf:about="&a;300501991"
	 b:glossaryEntry="depressed like a naval"/>
<rdf:Description rdf:about="&a;300502070"
	 b:glossaryEntry="curving or bulging outward"/>
<rdf:Description rdf:about="&a;300502267"
	 b:glossaryEntry="convex on both sides; lentil-shaped"/>
<rdf:Description rdf:about="&a;300502399"
	 b:glossaryEntry="(of a ship) so weakened as to sag at each end"/>
<rdf:Description rdf:about="&a;300502513">
	<b:glossaryEntry>convex on one side and concave on the other with the convexity being greater than the concavity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300502670"
	 b:glossaryEntry="(used of the moon) more than half full"/>
<rdf:Description rdf:about="&a;300502772"
	 b:glossaryEntry="flat on one side and convex on the other"/>
<rdf:Description rdf:about="&a;300502870">
	<b:glossaryEntry>gathered together or made less diffuse; "their concentrated efforts"; "his concentrated attention"; "concentrated study"; "a narrow thread of concentrated ore"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300503286">
	<b:glossaryEntry>brought together into a group or crowd; "the accumulated letters in my office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300503478"
	 b:glossaryEntry="occurring close together in bunches or clusters"/>
<rdf:Description rdf:about="&a;300503600">
	<b:glossaryEntry>concentrated on or clustered around a central point or purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300503751">
	<b:glossaryEntry>closely crowded together; "a compact shopping center"; "a dense population"; "thick crowds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300503912">
	<b:glossaryEntry>directed with intense concentration; "a fixed stare"; "an intent gaze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300504043">
	<b:glossaryEntry>thrown together in a pile; "a desk heaped with books"; "heaped-up ears of corn"; "ungraded papers piled high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300504225">
	<b:glossaryEntry>having accumulated or become more intense; "the deepened gloom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300504354">
	<b:glossaryEntry>amassed and put away for future use; "had some money saved up"; "many stored-up grievances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300504533">
	<b:glossaryEntry>not divided among or brought to bear on more than one object or objective; "judging a contest with a single eye"; "a single devotion to duty"; "undivided affection"; "gained their exclusive attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300504813"
	 b:glossaryEntry='planted or growing close together; "thickset trees"'/>
<rdf:Description rdf:about="&a;300504919"
	 b:glossaryEntry="spread out or scattered about or divided up"/>
<rdf:Description rdf:about="&a;300505416"
	 b:glossaryEntry="given out in portions"/>
<rdf:Description rdf:about="&a;300505546">
	<b:glossaryEntry>sown by casting over a wide area especially by hand; "the broadcast sowing of wheat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300505686">
	<b:glossaryEntry>(meteorology) discontinuous; "broken clouds"; "broken sunshine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300505802">
	<b:glossaryEntry>spread out; not concentrated in one place; "a large diffuse organization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300505929">
	<b:glossaryEntry>(of light rays) subjected to scattering by reflection from a rough surface or transmission through a translucent material; "diffused light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300506123">
	<b:glossaryEntry>distributed or weighted out in carefully determined portions; "medicines dispensed to the sick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300506274">
	<b:glossaryEntry>distributed or spread over a considerable extent; "has ties with many widely dispersed friends"; "eleven million Jews are spread throughout Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300506486">
	<b:glossaryEntry>distributed in portions (often equal) on the basis of a plan or purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300506646"
	 b:glossaryEntry='intended for wide distribution; "an encyclical letter"'/>
<rdf:Description rdf:about="&a;300506757">
	<b:glossaryEntry xml:space='preserve'><![CDATA[especially spread in a fan shape; "the peacock''s fanned tail"; "the spread-out cards"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300506911">
	<b:glossaryEntry xml:space='preserve'><![CDATA[distributed over a considerable extent; "far-flung trading operations"; "the West''s far-flung mountain ranges"; "widespread nuclear fallout"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300507120"
	 b:glossaryEntry='having low concentration; "low-density urban areas"'/>
<rdf:Description rdf:about="&a;300507232">
	<b:glossaryEntry>distributed equitably in limited individual portions; "got along as best we could on rationed meat and sugar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300507396">
	<b:glossaryEntry>occurring or distributed over widely spaced and irregular intervals in time or space; "scattered showers"; "scattered villages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300507579">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being distributed here and there without order; "scattered leaves littered the sidewalk"; "don''t forget to pick up the clothes lying strewn all over the floor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300507803"
	 b:glossaryEntry="spaced apart"/>
<rdf:Description rdf:about="&a;300507880"
	 b:glossaryEntry='not dense; "a thin beard"; "trees were sparse"'/>
<rdf:Description rdf:about="&a;300507986">
	<b:glossaryEntry>(of a fluid) having been propelled about in flying drops or masses; "with clothes wet by splashed water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300508145"
	 b:glossaryEntry='growing or spreading sparsely or irregularly; "straggly ivy"'/>
<rdf:Description rdf:about="&a;300508260">
	<b:glossaryEntry>being spread through with or as with color or light or liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300508376">
	<b:glossaryEntry>not concentrated at one point or upon one objective; "diversity...in our huge unfocused country"- Owen Wister</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300508554"
	 b:glossaryEntry='having a common center; "concentric rings"'/>
<rdf:Description rdf:about="&a;300508700"
	 b:glossaryEntry="having a common axis"/>
<rdf:Description rdf:about="&a;300508783">
	<b:glossaryEntry>not having a common center; not concentric; "eccentric circles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300508954"
	 b:glossaryEntry="not centered or having no center"/>
<rdf:Description rdf:about="&a;300509041"
	 b:glossaryEntry="situated away from the center or axis"/>
<rdf:Description rdf:about="&a;300509150">
	<b:glossaryEntry>feeling or showing worry or solicitude; "concerned parents of youthful offenders"; "was concerned about the future"; "we feel concerned about accomplishing the task at hand"; "greatly concerned not to disappoint a small child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300509558">
	<b:glossaryEntry xml:space='preserve'><![CDATA[filled with regret or concern; used often to soften an unpleasant statement; "I''m afraid I won''t be able to come"; "he was afraid he would have to let her go"; "I''m afraid you''re wrong"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300509796">
	<b:glossaryEntry>feeling worry or concern or insecurity; "She was afraid that I might be embarrassed"; "terribly afraid of offending someone"; "I am afraid we have witnessed only the first phase of the conflict"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300510043">
	<b:glossaryEntry>having or showing excessive or compulsive concern with something; "became more and more haunted by the stupid riddle"; "was absolutely obsessed with the girl"; "got no help from his wife who was preoccupied with the children"; "he was taken up in worry for the old woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300510407">
	<b:glossaryEntry>full of anxiety and concern; "solicitous parents"; "solicitous about the future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300510544">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking in interest or care or feeling; "the average American...is unconcerned that his or her plight is the result of a complex of personal and economic and governmental actions...beyond the normal citizen''s comprehension and control"; "blithely unconcerned about his friend''s plight"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300511013">
	<b:glossaryEntry>nonchalantly unconcerned; "a blase attitude about housecleaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300511129">
	<b:glossaryEntry>lacking or showing a lack of due concern; "spoke with blithe ignorance of the true situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300511275">
	<b:glossaryEntry>marked by blithe unconcern; "an ability to interest casual students"; "showed a casual disregard for cold weather"; "an utterly insouciant financial policy"; "an elegantly insouciant manner"; "drove his car with nonchalant abandon"; "was polite in a teasing nonchalant manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300511630">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing lack of emotional involvement; "adopted a degage pose on the arm of the easy chair"- J.S.Perelman; "she may be detached or even unfeeling but at least she''s not hypocritically effusive"; "an uninvolved bystander"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300511928">
	<b:glossaryEntry>showing no care or concern in attitude or action; "indifferent to the sufferings of others"; "indifferent to her plea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300512104"
	 b:glossaryEntry='expressing much in few words; "a concise explanation"'/>
<rdf:Description rdf:about="&a;300512391">
	<b:glossaryEntry>terse and witty and like a maxim; "much given to apothegmatic instruction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300512552">
	<b:glossaryEntry>concise and succinct; "covered the matter in a brief statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300512667">
	<b:glossaryEntry>briefly giving the gist of something; "a short and compendious book"; "a compact style is brief and pithy"; "succinct comparisons"; "a summary formulation of a wide-ranging subject"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300512937">
	<b:glossaryEntry xml:space='preserve'><![CDATA[brief and to the point; effectively cut short; "a crisp retort"; "a response so curt as to be almost rude"; "the laconic reply; `yes''"; "short and terse and easy to understand"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300513190"
	 b:glossaryEntry='having a puzzling terseness; "a cryptic note"'/>
<rdf:Description rdf:about="&a;300513289">
	<b:glossaryEntry>characterized by extreme economy of expression or omission of superfluous elements; "the dialogue is elliptic and full of dark hints"; "the explanation was concise, even elliptical to the verge of obscurity"- H.O.Taylor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300513576">
	<b:glossaryEntry>concise and full of meaning; "welcomed her pithy comments"; "the peculiarly sardonic and sententious style in which Don Luis composed his epigrams"- Hervey Allen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300513803">
	<b:glossaryEntry>having the style of a telegram with many short words left out; "telegraphic economy of words"; "the strange telegraphic speech of some aphasics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300514005">
	<b:glossaryEntry>tediously prolonged or tending to speak or write at great length; "editing a prolix manuscript"; "a prolix lecturer telling you more than you want to know"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300514357"
	 b:glossaryEntry='lacking conciseness; "a diffuse historical novel"'/>
<rdf:Description rdf:about="&a;300514460">
	<b:glossaryEntry>using or containing too many words; "long-winded (or windy) speakers"; "verbose and ineffective instructional methods"; "newspapers of the day printed long wordy editorials"; "proceedings were delayed by wordy disputes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300514773">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(archaic) "you put me to forget a lady''s manners by being so verbal"- Shakespeare]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300514907">
	<b:glossaryEntry xml:space='preserve'><![CDATA[repetition of same sense in different words; "`a true fact'' and `a free gift'' are pleonastic expressions"; "the phrase `a beginner who has just started'' is tautological"; "at the risk of being redundant I return to my original proposition"- J.B.Conant]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300515255">
	<b:glossaryEntry>use of more words than required to express an idea; "a wordy gossipy account of a simple incident"; "a redundant text crammed with amplifications of the obvious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300515480">
	<b:glossaryEntry>forming an end or termination; especially putting an end to doubt or question; "conclusive proof"; "the evidence is conclusive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300515736"
	 b:glossaryEntry='capable of convincing or persuading; "a convincing argument"'/>
<rdf:Description rdf:about="&a;300515853">
	<b:glossaryEntry>supplying or being a final or conclusive settlement; "a definitive verdict"; "a determinate answer to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300516038">
	<b:glossaryEntry>not conclusive; not putting an end to doubt or question; "an inconclusive reply"; "inconclusive evidence"; "the inconclusive committee vote"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300516345">
	<b:glossaryEntry>uncertain as a sign or indication; "the evidence from bacteriologic analysis was equivocal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300516492">
	<b:glossaryEntry>not leading to a definite ending or result; "an indeterminate campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300516623"
	 b:glossaryEntry='not final or absolute; "the decree is nisi and not absolute"'/>
<rdf:Description rdf:about="&a;300516734"
	 b:glossaryEntry='brought to completion; "a consummated transaction"'/>
<rdf:Description rdf:about="&a;300516878">
	<b:glossaryEntry>(of a marriage) completed by the first act of sexual intercourse after the ceremony</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300517017"
	 b:glossaryEntry="completed to perfection"/>
<rdf:Description rdf:about="&a;300517096">
	<b:glossaryEntry>not consummated (especially of a marriage); "an unconsummated marriage can be annulled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300517243">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) serving to connect two grammatical constituents of identical construction; "`and'' in `John and Mary'' or in `John walked and Mary rode'' is a coordinating conjunction; and so is `or'' in `will you go or stay?''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300517537">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) serving to connect a subordinate clause to a main clause; "`when'' in `I will come when I can'' is a subordinating conjunction"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300517769">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of words such as relative pronouns and subordinating conjunctions that serve to subordinate sentence constituents; "`that'' in `the house that we bought'' is a subordinator"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300518004">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being in agreement or harmony; often followed by `with''; "a place perfectly accordant with man''s nature"-Thomas Hardy]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300518267">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') in agreement with or accordant with; "according to instructions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300518406"
	 b:glossaryEntry='prepared to agree or consent; "agreeable to the plan"'/>
<rdf:Description rdf:about="&a;300518515"
	 b:glossaryEntry="being of the same opinion"/>
<rdf:Description rdf:about="&a;300518667"
	 b:glossaryEntry='(law) existing by consent; "a consensual contract"'/>
<rdf:Description rdf:about="&a;300518774"
	 b:glossaryEntry='in complete agreement; "a unanimous decision"'/>
<rdf:Description rdf:about="&a;300518922">
	<b:glossaryEntry>not in agreement or harmony; "views discordant with present-day ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300519085">
	<b:glossaryEntry>not in accord; "desires at variance with his duty"; "widely discrepant statements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300519241"
	 b:glossaryEntry="dissenting (especially dissenting with the majority opinion)"/>
<rdf:Description rdf:about="&a;300519381">
	<b:glossaryEntry>reduced to a stronger or more concentrated form; "condensed milk"; "concentrated sulfuric acid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300519583">
	<b:glossaryEntry>expressing the essence of; "the final boiled-down crux of the matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300519710"
	 b:glossaryEntry='pressed into less space; "compressed gases"'/>
<rdf:Description rdf:about="&a;300519810"
	 b:glossaryEntry="not reduced to a stronger or more concentrated form"/>
<rdf:Description rdf:about="&a;300519936">
	<b:glossaryEntry>of printers'' type; narrower than usual for a particular height</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300520054"
	 b:glossaryEntry="of printers'' type; wider than usual for a particular height"/>
<rdf:Description rdf:about="&a;300520179">
	<b:glossaryEntry>reduced in size or pulled together; "the contracted pupils of her eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300520361">
	<b:glossaryEntry>capable of contracting or being contracted; "the contractile wings of an insect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300520499"
	 b:glossaryEntry="having the opening reduced squeezed"/>
<rdf:Description rdf:about="&a;300520589">
	<b:glossaryEntry>reduced in size by being drawn together; "the shrunken dress was entirely too tight to wear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300520745"
	 b:glossaryEntry="increased in extent or size or bulk or scope"/>
<rdf:Description rdf:about="&a;300520898"
	 b:glossaryEntry='made wider or larger in all dimensions; "a dilated pupil"'/>
<rdf:Description rdf:about="&a;300521009">
	<b:glossaryEntry xml:space='preserve'><![CDATA[abnormally expanded or increased in size; (`swollen'' is sometimes used in combination); "distended wineskins"; "the need to clean out swollen inventories"; "the raisins were plump and soft and swollen from being soaked"; "huge blood-swollen mosquitoes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300521327"
	 b:glossaryEntry='expanded in scope; "the enlarged authority of the committee"'/>
<rdf:Description rdf:about="&a;300521442"
	 b:glossaryEntry='expanded by (or as if by) gas or air; "an inflated balloon"'/>
<rdf:Description rdf:about="&a;300521574"
	 b:glossaryEntry="having been inflated"/>
<rdf:Description rdf:about="&a;300521666"
	 b:glossaryEntry="collapsed through the release of gas or air"/>
<rdf:Description rdf:about="&a;300521782"
	 b:glossaryEntry="(of a tire) completely or partially deflated"/>
<rdf:Description rdf:about="&a;300521877">
	<b:glossaryEntry>(of an organ or body part) diminished in size or strength as a result of disease or injury or lack of use; "partial paralysis resulted in an atrophied left arm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300522115">
	<b:glossaryEntry>(of an organ or body part) excessively enlarged as a result of increased size in the constituent cells; "hypertrophied myocardial fibers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300522323">
	<b:glossaryEntry>imposing or depending on or containing a condition; "conditional acceptance of the terms"; "lent conditional support"; "the conditional sale will not be complete until the full purchase price is paid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300522689"
	 b:glossaryEntry="going counter to the facts (usually as a hypothesis)"/>
<rdf:Description rdf:about="&a;300522821">
	<b:glossaryEntry>determined by conditions or circumstances not yet established; "arms sales contingent on the approval of congress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300523065"
	 b:glossaryEntry="contingent on something else"/>
<rdf:Description rdf:about="&a;300523173">
	<b:glossaryEntry>under terms not final or fully worked out or agreed upon; "probationary employees"; "a provisional government"; "just a tentative schedule"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300523412"
	 b:glossaryEntry='subject to a proviso; "a provisory clause"'/>
<rdf:Description rdf:about="&a;300523510"
	 b:glossaryEntry='not conditional; "unconditional surrender"'/>
<rdf:Description rdf:about="&a;300523702"
	 b:glossaryEntry='without conditions or limitations; "a total ban"'/>
<rdf:Description rdf:about="&a;300523829">
	<b:glossaryEntry>devoid of any qualifications or disguise or adornment; "the blunt truth"; "the crude facts"; "facing the stark reality of the deadline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300524038"
	 b:glossaryEntry="not contingent"/>
<rdf:Description rdf:about="&a;300524110"
	 b:glossaryEntry='fixed and absolute and without contingency; "a vested right"'/>
<rdf:Description rdf:about="&a;300524223"
	 b:glossaryEntry="capable of being enforced"/>
<rdf:Description rdf:about="&a;300524306">
	<b:glossaryEntry>not enforceable; not capable of being brought about by compulsion; "an unenforceable law"; "unenforceable reforms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300524480">
	<b:glossaryEntry>forced or compelled or put in force; "a life of enforced inactivity"; "enforced obedience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300524639">
	<b:glossaryEntry>not enforced; not compelled especially by legal or police action; "too many unenforced laws can breed contempt for law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300524815">
	<b:glossaryEntry>having the quality or power of conducting heat or electricity or sound; exhibiting conductivity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300524985">
	<b:glossaryEntry>having characteristics of a semiconductor; that is having electrical conductivity greater than insulators but less than good conductors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300525198"
	 b:glossaryEntry="not able to conduct heat or electricity or sound"/>
<rdf:Description rdf:about="&a;300525322"
	 b:glossaryEntry="not free to move about"/>
<rdf:Description rdf:about="&a;300525579">
	<b:glossaryEntry>uncomfortably closed or hemmed in; "a claustrophobic little room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300525705"
	 b:glossaryEntry='crowded; "close quarters"'/>
<rdf:Description rdf:about="&a;300525794"
	 b:glossaryEntry="confined usually by illness"/>
<rdf:Description rdf:about="&a;300525900"
	 b:glossaryEntry="undergoing childbirth"/>
<rdf:Description rdf:about="&a;300525982"
	 b:glossaryEntry="closely confined"/>
<rdf:Description rdf:about="&a;300526062"
	 b:glossaryEntry="confined or shut in by heavy snow"/>
<rdf:Description rdf:about="&a;300526151">
	<b:glossaryEntry>delayed or confined or cut off by a storm; "the airport was filled with stormbound passengers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300526302">
	<b:glossaryEntry>delayed or shut in by bad weather; "weather-bound traffic"; "irritable weather-bound children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300526456"
	 b:glossaryEntry="not confined"/>
<rdf:Description rdf:about="&a;300526561">
	<b:glossaryEntry>of livestock and domestic poultry; permitted to graze or forage rather than being confined to a feedlot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300526734">
	<b:glossaryEntry xml:space='preserve'><![CDATA[overfilled or compacted or concentrated; "a crowded theater"; "a crowded program"; "crowded trains"; "a young mother''s crowded days"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300526974">
	<b:glossaryEntry>crowded or massed together; "give me...your huddled masses"; "the huddled sheep turned their backs against the wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300527144">
	<b:glossaryEntry>filled to capacity; "a suitcase jammed with dirty clothes"; "stands jam-packed with fans"; "a packed theater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300527328">
	<b:glossaryEntry>filled with great numbers crowded together; "I try to avoid the thronged streets and stores just before Christmas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300527497">
	<b:glossaryEntry>having or allowing sufficient room; "an uncrowded train"; "an uncrowded view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300527630">
	<b:glossaryEntry>suitable to your needs or similar to your nature"; "a congenial atmosphere to work in"; "two congenial spirits united...by mutual confidence and reciprocal virtues"- T.L.Peacock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300527965">
	<b:glossaryEntry>having similar disposition and tastes; "a compatible married couple"; "with their many similar tastes, he found her a most sympathetic companion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300528181"
	 b:glossaryEntry='friendly and pleasant; "a sociable gathering"'/>
<rdf:Description rdf:about="&a;300528281">
	<b:glossaryEntry>not suitable to your tastes or needs; "the uncongenial roommates were always fighting"; "the task was uncongenial to one sensitive to rebuffs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300528568">
	<b:glossaryEntry>not agreeing with your tastes or expectations; "found the task disagreeable and decided to abandon it"; "a job temperamentally unsympathetic to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300528791"
	 b:glossaryEntry="(geometry) coinciding when superimposed"/>
<rdf:Description rdf:about="&a;300528922"
	 b:glossaryEntry='matching point for point; "coincident circles"'/>
<rdf:Description rdf:about="&a;300529038"
	 b:glossaryEntry='coinciding exactly when superimposed; "identical triangles"'/>
<rdf:Description rdf:about="&a;300529168"
	 b:glossaryEntry="(geometry) not congruent"/>
<rdf:Description rdf:about="&a;300529250"
	 b:glossaryEntry="corresponding in character or kind"/>
<rdf:Description rdf:about="&a;300529370">
	<b:glossaryEntry>suitable and fitting; "the tailored clothes were harmonious with her military bearing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300529527">
	<b:glossaryEntry>lacking in harmony or compatibility or appropriateness; "a plan incongruous with reason"; "incongruous behavior"; "a joke that was incongruous with polite conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300529825"
	 b:glossaryEntry="not in agreement"/>
<rdf:Description rdf:about="&a;300529913">
	<b:glossaryEntry>not in keeping with what is correct or proper; "completely inappropriate behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300530102">
	<b:glossaryEntry>lacking in harmony of parts; "an inharmonious (or incongruous) mixture of architectural styles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300530256">
	<b:glossaryEntry>characterized by often poignant difference or incongruity between what is expected and what actually is; "madness, an ironic fate for such a clear thinker"; "it was ironical that the well-planned scheme failed so completely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300530544"
	 b:glossaryEntry="serving or tending to connect"/>
<rdf:Description rdf:about="&a;300530667">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) syntactically connecting sentences or elements of a sentence; "`and'' is a copulative conjunction"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300530844">
	<b:glossaryEntry>connecting or tending to connect; "connective remarks between chapters"; "connective tissue in animals"; "conjunctive tissue in plants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300531036"
	 b:glossaryEntry="serving or tending to divide or separate"/>
<rdf:Description rdf:about="&a;300531260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expressing antithesis or opposition; "the adversative conjunction `but'' in `poor but happy''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300531423">
	<b:glossaryEntry xml:space='preserve'><![CDATA[necessitating a choice between mutually exclusive possibilities; "`either'' and `or'' in `either this or that'']]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300531610">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) syntactically establishing a relationship of contrast between sentences or elements of a sentence; "disjunctive conjunctions like `but'', `or'', or `though'' serve a contrastive function"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300531862">
	<b:glossaryEntry>serving to divide or marking a division; "the divisional line between two states"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300532011">
	<b:glossaryEntry>standing between or separating two objects or areas; "Paris--where the same city lies on both sides of an intervening river"; "after reaching the top of the hill he looked across an intervening meadow to another line of hills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300532295">
	<b:glossaryEntry>serving to separate or divide into parts; "partitive tendencies in education"; "the uniting influence was stronger than the separative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300532499">
	<b:glossaryEntry>(Hebrew orthography; used of an accent) indicating that the word marked is separated to a greater or lesser degree rhythmically and grammatically from the word at follows it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300532729">
	<b:glossaryEntry>(music) progressing melodically by intervals of a second; "conjunct motion of an ascending scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300532881">
	<b:glossaryEntry>(music) progressing melodically by intervals larger than a major second</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300533007"
	 b:glossaryEntry="joined or linked together"/>
<rdf:Description rdf:about="&a;300533304">
	<b:glossaryEntry>having a common boundary or edge; touching; "abutting lots"; "adjoining rooms"; "Rhode Island has two bordering states; Massachusetts and Conncecticut"; "the side of Germany conterminous with France"; "Utah and the contiguous state of Idaho"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300533666"
	 b:glossaryEntry="joining; forming an adjunct"/>
<rdf:Description rdf:about="&a;300533750">
	<b:glossaryEntry>closely related; "syllable to blessed syllable affined"- Wallace Stevens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300533876"
	 b:glossaryEntry='fastened together; "a picnic table with attached benches"'/>
<rdf:Description rdf:about="&a;300533988"
	 b:glossaryEntry='having a connection; "connecting rooms"'/>
<rdf:Description rdf:about="&a;300534084">
	<b:glossaryEntry>connecting without a break; within a common boundary; "the 48 conterminous states"; "the contiguous 48 states"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300534266"
	 b:glossaryEntry="connected by a link, as railway cars or trailer trucks"/>
<rdf:Description rdf:about="&a;300534392">
	<b:glossaryEntry>(architecture) built against or attached to a wall; "engaged columns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300534515">
	<b:glossaryEntry>closely interconnected or interrelated; "the intimate relations...beween economics, politics, and legal principles"- V.L.Parrington</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300534701">
	<b:glossaryEntry>connecting two or more pipes or hoses or having such a connection; "a Y-shaped siamese joint"; "siamese fire-hose lines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300534875">
	<b:glossaryEntry>connected by blood or close acquaintance with people of wealth or social position; "a well-connected Edinburgh family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300535075"
	 b:glossaryEntry="not joined or linked together"/>
<rdf:Description rdf:about="&a;300535306">
	<b:glossaryEntry>remote and separate physically or socially; "existed over the centuries as a world apart"; "preserved because they inhabited a place apart"- W.H.Hudson; "tiny isolated villages remote from centers of civilization"; "an obscure village"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300535617">
	<b:glossaryEntry>(anatomy) not connected to the sternum or breastbone; "asternal ribs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300535741">
	<b:glossaryEntry>no longer connected or joined; "a detached part"; "on one side of the island was a hugh rock, almost detached"; "the separated spacecraft will return to their home bases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300535978"
	 b:glossaryEntry="have the connection undone; having become separate"/>
<rdf:Description rdf:about="&a;300536095"
	 b:glossaryEntry="not fastened together"/>
<rdf:Description rdf:about="&a;300536173">
	<b:glossaryEntry>having the coupling undone; "the uncoupled caboose rolled down the incline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300536304">
	<b:glossaryEntry>subject to being conquered or overcome; "knew her fears were ultimately conquerable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300536536"
	 b:glossaryEntry="susceptible to being defeated"/>
<rdf:Description rdf:about="&a;300536646"
	 b:glossaryEntry="susceptible to being stormed"/>
<rdf:Description rdf:about="&a;300536743"
	 b:glossaryEntry="susceptible to being subjugated"/>
<rdf:Description rdf:about="&a;300536843">
	<b:glossaryEntry>not capable of being conquered or vanquished or overcome; "a tribute to his courage...and his unconquerable will"- R.E.Danielson; "faced unconquerable difficulties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300537193"
	 b:glossaryEntry="impossible to take by storm"/>
<rdf:Description rdf:about="&a;300537293"
	 b:glossaryEntry="impossible to subdue"/>
<rdf:Description rdf:about="&a;300537401"
	 b:glossaryEntry="impossible to surmount"/>
<rdf:Description rdf:about="&a;300537498">
	<b:glossaryEntry>incapable of being overcome or subdued; "an invincible army"; "her invincible spirit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300537670"
	 b:glossaryEntry="never having lost"/>
<rdf:Description rdf:about="&a;300537748">
	<b:glossaryEntry>knowing and perceiving; having awareness of surroundings and sensations and thoughts; "remained conscious during the operation"; "conscious of his faults"; "became conscious that he was being followed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300538149">
	<b:glossaryEntry>not unconscious; especially having become conscious; "the patient is now awake and alert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300538301">
	<b:glossaryEntry>aware of yourself as an individual or of your own being and actions and thoughts; "self-conscious awareness"; "self-conscious about their roles as guardians of the social values"- D.M.Potter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300538552"
	 b:glossaryEntry="partially conscious; not completely aware of sensations"/>
<rdf:Description rdf:about="&a;300538667">
	<b:glossaryEntry>consciously perceiving; "sentient of the intolerable load"; "a boy so sentient of his surroundings"- W.A.White</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300538832">
	<b:glossaryEntry>not conscious; lacking awareness and the capacity for sensory perception as if asleep or dead; "lay unconscious on the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300539231">
	<b:glossaryEntry>unconscious from a blow or shock or intoxication; "the boxer was out cold"; "pass out cold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300539373">
	<b:glossaryEntry>in a state of deep and usually prolonged unconsciousness; unable to respond to external stimuli; "a comatose patient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300539545">
	<b:glossaryEntry>(archaic) used of things; lacking sense or awareness; "ignorant hope"; "fine innocent weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300539705">
	<b:glossaryEntry>unresponsive to stimulation; "he lay insensible where he had fallen"; "drugged and senseless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300539867"
	 b:glossaryEntry="knocked unconscious by a heavy blow"/>
<rdf:Description rdf:about="&a;300539998">
	<b:glossaryEntry>concerning mental functioning that is not represented in consciousness; "nonconscious psychic processes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300540161"
	 b:glossaryEntry="in a state of partial coma"/>
<rdf:Description rdf:about="&a;300540246"
	 b:glossaryEntry="just below the level of consciousness"/>
<rdf:Description rdf:about="&a;300540342">
	<b:glossaryEntry>solemnly dedicated to or set apart for a high purpose; "a life consecrated to science"; "the consecrated chapel"; "a chapel dedicated to the dead of World War II"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300540659">
	<b:glossaryEntry>invested with ministerial or priestly functions; "an ordained priest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300540783"
	 b:glossaryEntry='dedicated in fulfillment of a vow; "votive prayers"'/>
<rdf:Description rdf:about="&a;300540887">
	<b:glossaryEntry>treated with contempt; "many desecrated shrines and cemeteries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300541043"
	 b:glossaryEntry="divested of consecration"/>
<rdf:Description rdf:about="&a;300541127"
	 b:glossaryEntry="treated irreverently or sacrilegiously"/>
<rdf:Description rdf:about="&a;300541231">
	<b:glossaryEntry>befitting or characteristic of a priest or the priesthood; "priestly dedication to the people of his parish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300541407"
	 b:glossaryEntry='not priestly; unbefitting a priest; "unpriestly behavior"'/>
<rdf:Description rdf:about="&a;300541521"
	 b:glossaryEntry="resistant to change"/>
<rdf:Description rdf:about="&a;300541743"
	 b:glossaryEntry="pompously ultraconservative and nationalistic"/>
<rdf:Description rdf:about="&a;300541843">
	<b:glossaryEntry>conservative in professional manner; "employers are looking for buttoned-up types"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300541983"
	 b:glossaryEntry="old-fashioned and out of date"/>
<rdf:Description rdf:about="&a;300542111"
	 b:glossaryEntry="stubbornly conservative and narrow-minded"/>
<rdf:Description rdf:about="&a;300542225"
	 b:glossaryEntry="extremely conservative"/>
<rdf:Description rdf:about="&a;300542311">
	<b:glossaryEntry>tolerant of change; not bound by authoritarianism, orthodoxy, or tradition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300542583">
	<b:glossaryEntry>having or showing active concern for protection of civil liberties protected by law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300542730">
	<b:glossaryEntry>having or demonstrating belief in the essential goodness of man and the autonomy of the individual; favoring civil and political liberties, government by law with the consent of the governed, and protection from arbitrary authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300543020">
	<b:glossaryEntry>having or showing belief in the need for economic growth in addition to traditional liberalistic values</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300543180"
	 b:glossaryEntry="favoring or promoting reform (often by government action)"/>
<rdf:Description rdf:about="&a;300543307">
	<b:glossaryEntry>under group or government control; "socialized ownership"; "socialized medicine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300543444"
	 b:glossaryEntry="of or relating to a welfare state"/>
<rdf:Description rdf:about="&a;300543564">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `with'') in agreement or consistent or reliable; "testimony consistent with the known facts"; "I have decided that the course of conduct which I am following is consistent with my sense of responsibility as president in time of war"- FDR]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300543988">
	<b:glossaryEntry>in keeping; "salaries agreeable with current trends"; "plans conformable with your wishes"; "expressed views concordant with his background"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300544268">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') in conformance to or agreement with; "pursuant to our agreement"; "pursuant to the dictates of one''s conscience"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300544457"
	 b:glossaryEntry="made compatible or consistent"/>
<rdf:Description rdf:about="&a;300544543"
	 b:glossaryEntry="not self-contradictory"/>
<rdf:Description rdf:about="&a;300544627">
	<b:glossaryEntry>conforming to the same principles or course of action over time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300544747">
	<b:glossaryEntry>displaying a lack of consistency; "inconsistent statements"; "inconsistent with the roadmap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300545006">
	<b:glossaryEntry>in disagreement; "the figures are at odds with our findings"; "contradictory attributes of unjust justice and loving vindictiveness"- John Morley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300545259"
	 b:glossaryEntry="not compatible with other facts"/>
<rdf:Description rdf:about="&a;300545362"
	 b:glossaryEntry="inconsistent in quality"/>
<rdf:Description rdf:about="&a;300545447">
	<b:glossaryEntry>not correspondent; "a description unconformable to previous accounts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300545576">
	<b:glossaryEntry>not made consistent or compatible; "two unreconciled accountings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300545700">
	<b:glossaryEntry>obvious to the eye or mind; "a tower conspicuous at a great distance"; "wore conspicuous neckties"; "made herself conspicuous by her exhibitionistic preening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300546142"
	 b:glossaryEntry='seizing the attention; "eye-catching posters"'/>
<rdf:Description rdf:about="&a;300546266">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conspicuous in position or importance; "a big figure in the movement"; "big man on campus"; "he''s very large in financial circles"; "a prominent citizen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300546489">
	<b:glossaryEntry>clear and distinct; "bold handwriting"; "a figure carved in bold relief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300546612">
	<b:glossaryEntry>conspicuously and outrageously bad or reprehensible; "a crying shame"; "an egregious lie"; "flagrant violation of human rights"; "a glaring error"; "gross ineptitude"; "gross injustice"; "rank treachery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300546919">
	<b:glossaryEntry>compulsively attracting attention to yourself especially by boasting or exaggerated behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300547092">
	<b:glossaryEntry>made a feature or highlight; given prominence; "a featured actor"; "a featured item at the sale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300547243">
	<b:glossaryEntry>clearly to be seen; "they were much in evidence during the fighting"; "she made certain that her engagement ring was in evidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300547430">
	<b:glossaryEntry>singled out for notice or especially for a dire fate; "a marked man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300547551">
	<b:glossaryEntry>having a quality that thrusts itself into attention; "an outstanding fact of our time is that nations poisoned by anti_semitism proved less fortunate in regard to their own freedom"; "a new theory is the most prominent feature of the book"; "salient traits"; "a spectacular rise in prices"; "a striking thing about Picadilly Circus is the statue of Eros in the center"; "a striking resemblance between parent and child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300548075"
	 b:glossaryEntry='being often in the public eye; "a visible public figure"'/>
<rdf:Description rdf:about="&a;300548185">
	<b:glossaryEntry>not prominent or readily noticeable; "he pushed the string through an inconspicuous hole"; "the invisible man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300548403">
	<b:glossaryEntry>not drawing attention; "an unnoticeable cigarette burn on the carpet"; "an obscure flaw"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300548560">
	<b:glossaryEntry>perceptible by the senses or intellect; "things happen in the earth and sky with no discernible cause"; "the newspaper reports no discernible progress in the negotiations"; "the skyline is easily discernible even at a distance of several miles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300548876">
	<b:glossaryEntry>difficult or impossible to perceive or discern; "an indiscernible increase in temperature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300549026">
	<b:glossaryEntry>capable of being perceived as different or distinct; "only the shine of their metal was distinguishable in the gloom"; "a project distinguishable into four stages of progress"; "distinguishable differences between the twins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300549348">
	<b:glossaryEntry>capable of being perceived as different; "differentiable species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300549474"
	 b:glossaryEntry='capable of being discriminated; "discriminable faults"'/>
<rdf:Description rdf:about="&a;300549588">
	<b:glossaryEntry>not capable of being distinguished or differentiated; "the two specimens are actually different from each other but the differences are almost indistinguishable"; "the twins were indistinguishable"; "a colorless person quite indistinguishable from the colorless mass of humanity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300549951">
	<b:glossaryEntry>steadfast in purpose or devotion or affection; "a man constant in adherence to his ideals"; "a constant lover"; "constant as the northern star"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300550293">
	<b:glossaryEntry>(used of persons) dependable in devotion or allegiance or affection; "a faithful old dog"; "a faithful friend"; "fast friends"; "a loyal companion"; "she proved a true friend"; "a lover absolutely true in act and word and thought"- H.O.Taylor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300550615">
	<b:glossaryEntry>firm and dependable especially in loyalty; "a steadfast ally"; "a staunch defender of free speech"; "unswerving devotion"; "unswerving allegiance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300550840">
	<b:glossaryEntry>unceasing; "unfailing loyalty"; "unfailing good spirits"; "unflagging courtesy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300550988">
	<b:glossaryEntry>likely to change frequently often without apparent or cogent reason; variable; "inconstant affections"; "an inconstant lover"; "swear not by...the inconstant moon"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300551365">
	<b:glossaryEntry>(used especially of persons) not dependable in devotion or affection; unfaithful; "a false friend; "when lovers prove untrue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300551551">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by erratic changeableness in affections or attachments; "fickle friends"; "a flirt''s volatile affections"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300551727">
	<b:glossaryEntry>constructing or tending to construct or improve or promote development; "constructive criticism"; "a constructive attitude"; "a constructive philosophy"; "constructive permission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300552091"
	 b:glossaryEntry='promoting construction or creation; "creative work"'/>
<rdf:Description rdf:about="&a;300552197">
	<b:glossaryEntry>forming or capable of forming or molding; "a formative influence"; "a formative experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300552354">
	<b:glossaryEntry>(biology) capable of forming new cells and tissues; "a formative zone in developing bone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300552499"
	 b:glossaryEntry="based on interpretation; not directly expressed"/>
<rdf:Description rdf:about="&a;300552604">
	<b:glossaryEntry>helping to restore to good condition; "reconstructive surgery"; "rehabilitative exercises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300552772">
	<b:glossaryEntry>concerned with systematic structure in a particular field of study</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300552895">
	<b:glossaryEntry>causing destruction or much damage; "a policy that is destructive to the economy"; "destructive criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300553293">
	<b:glossaryEntry>wreaking or capable of wreaking complete destruction; "possessing annihilative power"; "a devastating hurricane"; "the guns opened a withering fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300553541">
	<b:glossaryEntry>causing injury or blight; especially affecting with sudden violence or plague or ruin; "the blasting effects of the intense cold on the budding fruit"; "the blasting force of the wind blowing sharp needles of sleet in our faces"; "a ruinous war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300553851">
	<b:glossaryEntry>severely destructive; "cataclysmic nuclear war"; "a cataclysmic earthquake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300553998">
	<b:glossaryEntry>of a substance, especially a strong acid; capable of destroying or eating away by chemical action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300554183">
	<b:glossaryEntry>physically or spiritually devastating; often used in combination; "a crushing blow"; "a crushing rejection"; "bone-crushing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300554376">
	<b:glossaryEntry>designed or tending to discredit, especially without positive or helpful suggestions; "negative criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300554548">
	<b:glossaryEntry>wearing away by friction; "the erosive effects of waves on the shoreline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300554675">
	<b:glossaryEntry>making undecipherable or imperceptible; "obliterating mists; "an obscurant bank of clouds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300554836"
	 b:glossaryEntry='ruinously destructive and wasting; "a ravaging illness"'/>
<rdf:Description rdf:about="&a;300554946"
	 b:glossaryEntry='destructive to the spirit or soul; "soul-destroying labor"'/>
<rdf:Description rdf:about="&a;300555066">
	<b:glossaryEntry>laying waste; "when wasteful war shall statues overturn"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300555190"
	 b:glossaryEntry="having been taken into the mouth for consumption"/>
<rdf:Description rdf:about="&a;300555344"
	 b:glossaryEntry="eaten or drunk up"/>
<rdf:Description rdf:about="&a;300555416">
	<b:glossaryEntry>destroyed or wasted as if by eating; "forests devoured by flame"; "an inheritance eaten up by debt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300555584"
	 b:glossaryEntry="taken into the stomach"/>
<rdf:Description rdf:about="&a;300555661">
	<b:glossaryEntry>not eaten or used up; "gave the dog the uneaten remnants of the roast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300555821">
	<b:glossaryEntry xml:space='preserve'><![CDATA[uneaten and saved for eating later; "leftover food served at a later meal"; "yesterday''s reheated soup"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300556018">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not eaten or drunk up; "the cat found the baby''s undrunk milk"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300556147">
	<b:glossaryEntry>satisfied or showing satisfaction with things as they are; "a contented smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300556438">
	<b:glossaryEntry>in a state of tranquil contentment; "at peace with herself and her friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300556568">
	<b:glossaryEntry>contented to a fault; "he had become complacent after years of success"; "his self-satisfied dignity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300556743">
	<b:glossaryEntry>satisfied; enjoying well-being and contentment; "felt content with her lot"; "quite happy to let things go on as they are"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300556930">
	<b:glossaryEntry>taking life easy; "an easygoing man rarely stirred to anger"; "an air of placid sufficiency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300557087"
	 b:glossaryEntry='filled with satisfaction; "a satisfied customer"'/>
<rdf:Description rdf:about="&a;300557191">
	<b:glossaryEntry>marked by excessive complacency or self-satisfaction; "a smug glow of self-congratulation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300557349">
	<b:glossaryEntry>showing or experiencing dissatisfaction or restless longing; "saw many discontented faces in the room"; "was discontented with his position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300557654"
	 b:glossaryEntry="discontented as toward authority"/>
<rdf:Description rdf:about="&a;300557785"
	 b:glossaryEntry="in a state of sulky dissatisfaction"/>
<rdf:Description rdf:about="&a;300557893"
	 b:glossaryEntry="worried and uneasy"/>
<rdf:Description rdf:about="&a;300557994"
	 b:glossaryEntry="capable of being contested"/>
<rdf:Description rdf:about="&a;300558150"
	 b:glossaryEntry="capable of being challenged"/>
<rdf:Description rdf:about="&a;300558237"
	 b:glossaryEntry="capable of being disproved"/>
<rdf:Description rdf:about="&a;300558339">
	<b:glossaryEntry>capable of being weakened; "the crisis proved his confidence was shakable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300558480"
	 b:glossaryEntry="incapable of being contested or disputed"/>
<rdf:Description rdf:about="&a;300558704"
	 b:glossaryEntry='necessarily or demonstrably true; "demonstrable truths"'/>
<rdf:Description rdf:about="&a;300558837"
	 b:glossaryEntry="having been demonstrated or verified beyond doubt"/>
<rdf:Description rdf:about="&a;300558945"
	 b:glossaryEntry="against which no argument can be made"/>
<rdf:Description rdf:about="&a;300559052">
	<b:glossaryEntry>without flaws or loopholes; "an ironclad contract"; "a watertight alibi"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300559220"
	 b:glossaryEntry='impossible to answer; "an unanswerable argument"'/>
<rdf:Description rdf:about="&a;300559327"
	 b:glossaryEntry="having control over urination and defecation"/>
<rdf:Description rdf:about="&a;300559427"
	 b:glossaryEntry="not having control over urination and defecation"/>
<rdf:Description rdf:about="&a;300559551"
	 b:glossaryEntry="used informally; unable to retain urine"/>
<rdf:Description rdf:about="&a;300559642">
	<b:glossaryEntry>seemingly without interruption; chiefly restricted to what recurs regularly or frequently in a prolonged and closely spaced series; "the continual banging of the shutters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300559995">
	<b:glossaryEntry>continually recurring or continuing without interruption; "constant repetition of the exercise"; "constant chatter of monkeys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300560176"
	 b:glossaryEntry='(informal) continuing too long; "everlasting complaints"'/>
<rdf:Description rdf:about="&a;300560290">
	<b:glossaryEntry xml:space='preserve'><![CDATA[occurring so frequently as to seem ceaseless or uninterrupted; "a child''s incessant questions"; "your perpetual (or continual) complaints"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300560506">
	<b:glossaryEntry xml:space='preserve'><![CDATA[persistently continual; "the bluejay''s insistent cry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300560628">
	<b:glossaryEntry>continually repeated over a period of time; "a running joke among us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300560754">
	<b:glossaryEntry>recurring again and again; "perennial efforts to stipulate the requirements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300560909"
	 b:glossaryEntry='never-ceasing; "the relentless beat of the drums"'/>
<rdf:Description rdf:about="&a;300561042">
	<b:glossaryEntry>recurring in scattered and irregular or unpredictable instances; "a city subjected to sporadic bombing raids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300561332">
	<b:glossaryEntry>occurring in spells and often abruptly; "fitful bursts of energy"; "spasmodic rifle fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300561486">
	<b:glossaryEntry>stopping and starting at irregular intervals; "intermittent rain showers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300561618">
	<b:glossaryEntry>recurring or reappearing from time to time; "periodic feelings of anxiety"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300561747"
	 b:glossaryEntry="not occurring at expected times"/>
<rdf:Description rdf:about="&a;300561850">
	<b:glossaryEntry>not close together in time; "isolated instances of rebellion"; "scattered fire"; "a stray bullet grazed his thigh"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300562039">
	<b:glossaryEntry>continuing in time or space without interruption; "a continuous rearrangement of electrons in the solar atoms results in the emission of light"- James Jeans; "a continuous bout of illness lasting six months"; "lived in continuous fear"; "a continuous row of warehouses"; "a continuous line has no gaps or breaks in it"; "moving midweek holidays to the nearest Monday or Friday allows uninterrupted work weeks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300562701"
	 b:glossaryEntry='at all times; "around-the-clock nursing care"'/>
<rdf:Description rdf:about="&a;300562853">
	<b:glossaryEntry xml:space='preserve'><![CDATA[uninterrupted in time and indefinitely long continuing; "the ceaseless thunder of surf"; "in constant pain"; "night and day we live with the incessant noise of the city"; "the never-ending search for happiness"; "the perpetual struggle to maintain standards in a democracy"; "man''s unceasing warfare with drought and isolation"; "unremitting demands of hunger"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300563345">
	<b:glossaryEntry>`continual'' (meaning seemingly uninterrupted) is often used interchangeably with `continuous'' (meaning without interruption)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300563525">
	<b:glossaryEntry>relentless and indefatigable in pursuit or as if in pursuit; "impossible to escape the dogging fears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300563693">
	<b:glossaryEntry>having the ends united so as to form a continuous whole; "an endless chain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300563822">
	<b:glossaryEntry>(of an electric arc); "heat transfer to the anode in free burning arcs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300563963"
	 b:glossaryEntry='successive (without a break); "sick for five straight days"'/>
<rdf:Description rdf:about="&a;300564091">
	<b:glossaryEntry>maintained at length without interruption or weakening; "sustained flight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300564221">
	<b:glossaryEntry>not continuing without interruption in time or space; "discontinuous applause"; "the landscape was a discontinuous mosaic of fields and forest areas"; "he received a somewhat haphazard and discontinuous schooling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300564582">
	<b:glossaryEntry>maked by breaks or gaps; "many routes are unsafe or disrupted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300564700">
	<b:glossaryEntry>used of distributions, as of statistical or natural populations; "disjunct distribution of king crabs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300564857">
	<b:glossaryEntry>(mathematics) of a function or curve; extending without break or irregularity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300564991">
	<b:glossaryEntry>(mathematics) of a function or curve; possessing one or more discontinuities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300565127">
	<b:glossaryEntry>without stop or interruption; "to insure the continued success of the war"; "the continued existence of nationalism"; "the continued popularity of Westerns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300565357">
	<b:glossaryEntry>remaining in force or being carried on without letup; "the act provided a continuing annual appropriation"; "the continuing struggle to put food on the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300565572">
	<b:glossaryEntry>stopped permanently or temporarily; "discontinued models"; "a discontinued magazine"; "a discontinued conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300565782">
	<b:glossaryEntry>discontinued temporarily; "we resumed the interrupted discussion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300565905">
	<b:glossaryEntry>(of books) no longer offered for sale by a publisher; "that edition is out of print"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300566069">
	<b:glossaryEntry>restrained or managed or kept within certain bounds; "controlled emotions"; "the controlled release of water from reservoirs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300566467"
	 b:glossaryEntry='gotten under control; "the oil spill is contained"'/>
<rdf:Description rdf:about="&a;300566573"
	 b:glossaryEntry='being acted upon; "kept the situation well in hand"'/>
<rdf:Description rdf:about="&a;300566700"
	 b:glossaryEntry="obeying the rules"/>
<rdf:Description rdf:about="&a;300566794"
	 b:glossaryEntry="controlled or ruled by superior authority or power"/>
<rdf:Description rdf:about="&a;300566939">
	<b:glossaryEntry>brought under control and put to use; "electricity from the harnessed Colorado River"; "the harnessed power of the atom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300567115">
	<b:glossaryEntry>influenced or controlled by a powerful force such as a strong emotion; "by love possessed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300567275">
	<b:glossaryEntry>maintained at a certain atmospheric pressure; "in a pressurized cabin the air pressure is comfortable for breathing"; "cooking with pressurized steam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300567483"
	 b:glossaryEntry="having the price regulated or controlled by government"/>
<rdf:Description rdf:about="&a;300567600"
	 b:glossaryEntry="ruled by or oppressed by a priest"/>
<rdf:Description rdf:about="&a;300567693"
	 b:glossaryEntry="strictly controlled"/>
<rdf:Description rdf:about="&a;300567769">
	<b:glossaryEntry>(used in combination) dominated or obsessed by; "grief-ridden"; "war-ridden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300567902">
	<b:glossaryEntry>not being under control; out of control; "the greatest uncontrolled health problem is AIDS"; "uncontrolled growth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300568273">
	<b:glossaryEntry>without law or control; "the system is economically inefficient and politically anarchic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300568440">
	<b:glossaryEntry>impossible to repress or control; "an irrepressible chatterbox"; "uncontrollable laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300568607">
	<b:glossaryEntry>(of a ball in sport) not in the possession or control of any player; "a loose ball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300568742">
	<b:glossaryEntry>having no lord or master; "harsh punishments for sturdy vagabonds and masterless men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300568895"
	 b:glossaryEntry='unrestrained and violent; "rampant aggression"'/>
<rdf:Description rdf:about="&a;300568995"
	 b:glossaryEntry='completely out of control; "runaway inflation"'/>
<rdf:Description rdf:about="&a;300569095">
	<b:glossaryEntry>resembling a torrent in force and abundance; "torrential applause"; "torrential abuse"; "the torrential facility and fecundity characteristic of his style"- Winthrop Sargeant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300569326">
	<b:glossaryEntry>lacking in discipline or control; "undisciplined behavior"; "ungoverned youth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300569477">
	<b:glossaryEntry>not subjected to control or restraint; "a piano played with a wild exuberance"- Louis Bromfield</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300569623">
	<b:glossaryEntry>deviating widely from an intended course; "a wild bullet"; "a wild pitch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300569747">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by or capable of arousing controversy; "the issue of the death penalty is highly controversial"; "Rushdie''s controversial book"; "a controversial decision on affirmative action"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300570063"
	 b:glossaryEntry="open to argument or debate"/>
<rdf:Description rdf:about="&a;300570169">
	<b:glossaryEntry>involving or likely to cause controversy; "a central and contentious element of the book"- Tim W.Ferfuson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300570332"
	 b:glossaryEntry="open to debate"/>
<rdf:Description rdf:about="&a;300570408"
	 b:glossaryEntry="of or involving dispute or controversy"/>
<rdf:Description rdf:about="&a;300570512"
	 b:glossaryEntry="not likely to arouse controversy"/>
<rdf:Description rdf:about="&a;300570661">
	<b:glossaryEntry>generally agreed upon; not subject to dispute; "the accepted interpretation of the poem"; "an accepted theory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300570839">
	<b:glossaryEntry>constituted or contracted by stipulation or agreement; "stipulatory obligations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300570994">
	<b:glossaryEntry>given to or characterized by argument; "an argumentative discourse"; "argumentative to the point of being cantankerous"; "an intelligent but argumentative child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300571251">
	<b:glossaryEntry>given to quarreling; "arguing children"; "quarrelsome when drinking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300571387">
	<b:glossaryEntry>inclined or showing an inclination to dispute or disagree, even to engage in law suits; "a style described as abrasive and contentious"; "a disputatious lawyer"; "a litigious and acrimonious spirit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300571684"
	 b:glossaryEntry="not given to or characterized by argument"/>
<rdf:Description rdf:about="&a;300571805"
	 b:glossaryEntry="of persons; not given to controversy"/>
<rdf:Description rdf:about="&a;300571902">
	<b:glossaryEntry>suited to your comfort or purpose or needs; "a convenient excuse for not going"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300572128"
	 b:glossaryEntry='easy to use; "a handy gadget"'/>
<rdf:Description rdf:about="&a;300572209">
	<b:glossaryEntry>at a convenient or suitable time; "an opportune time to receive guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300572361">
	<b:glossaryEntry>not suited to your comfort, purpose or needs; "it is inconvenient not to have a telephone in the kitchen"; "the back hall is an inconvenient place for the telephone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300572621"
	 b:glossaryEntry='causing inconvenience; "they arrived at an awkward time"'/>
<rdf:Description rdf:about="&a;300572731">
	<b:glossaryEntry>following accepted customs and proprieties; "conventional wisdom"; "she had strayed from the path of conventional behavior"; "conventional forms of address"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300573090">
	<b:glossaryEntry>widely accepted as true or worthy; "the accepted wisdom about old age"; "a received moral idea"; "Received political wisdom says not; surveys show otherwise"- Economist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300573324">
	<b:glossaryEntry>in accordance with convention or custom; "sealed the deal with the customary handshake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300573467"
	 b:glossaryEntry="characterized by or in accordance with some formula"/>
<rdf:Description rdf:about="&a;300573574">
	<b:glossaryEntry>excessively conventional and unimaginative and hence dull; "why is the middle class so stodgy, so utterly without a sense of humor?"; "a stodgy dinner party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300573793">
	<b:glossaryEntry>not conforming to accepted rules or standards; "her unconventional dress and hair style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300574032">
	<b:glossaryEntry>unconventional in especially appearance and behavior; "a bohemian life style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300574164">
	<b:glossaryEntry>not bound by rule or law or convention; "bewildered by the old go-as-you-please liberty of alliterative rhythm"- George Saintsbury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300574357">
	<b:glossaryEntry>independent in behavior or thought; "she led a somewhat irregular private life"; "maverick politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300574540">
	<b:glossaryEntry>unimaginative and conformist; "conventional bourgeois lives"; "conventional attitudes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300574739">
	<b:glossaryEntry>unimaginatively conventional; "a colorful character in the buttoned-down, dull-gray world of business"- Newsweek</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300574940"
	 b:glossaryEntry="(slang) rigidly conventional or old-fashioned"/>
<rdf:Description rdf:about="&a;300575049">
	<b:glossaryEntry>lacking spontaneity or originality or individuality; "stereotyped phrases of condolence"; "even his profanity was unimaginative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300575281"
	 b:glossaryEntry='not conventional or conformist; "unconventional life styles"'/>
<rdf:Description rdf:about="&a;300575492">
	<b:glossaryEntry>pertaining to unconventional choices; "an alternative life style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300575615">
	<b:glossaryEntry>conspicuously or grossly unconventional or unusual; "restaurants of bizarre design--one like a hat, another like a rabbit"; "famed for his eccentric spelling"; "a freakish combination of styles"; "the outlandish clothes of teenagers"; "outre and affected stage antics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300575998">
	<b:glossaryEntry>marked by a carefree unconventionality or disreputableness; "a cocktail party given by some...raffish bachelors"- Crary Moore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300576203"
	 b:glossaryEntry="informal terms; strikingly unconventional"/>
<rdf:Description rdf:about="&a;300576335">
	<b:glossaryEntry>marked by conformity or convention; not corresponding to current customs or rules or styles; "underneath the radical image teenagers are surprisingly conformist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300576553">
	<b:glossaryEntry>not conforming to some norm or socially approved pattern of behavior or thought; "their rabidly nonformist deportment has made them legendary"; "the old stubborn nonconformist spirit of the early settlers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300576833">
	<b:glossaryEntry>(of power and warfare and weaponry) using atomic energy; "nuclear (or atomic) submarines"; "nuclear war"; "nuclear weapons"; "atomic bombs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300577053">
	<b:glossaryEntry>using atomic weapons based on fusion as distinguished from fission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300577179">
	<b:glossaryEntry>(of power and warfare and weaponry) not nuclear; "conventional power plants"; "conventional warfare"; "conventional weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300577362">
	<b:glossaryEntry>consisting of or derived from tradition; "traditional history"; "traditional morality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300577578">
	<b:glossaryEntry>in accord with or being a tradition or practice accepted from the past; "a conventional church wedding with the bride in traditional white"; "the conventional handshake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300577806">
	<b:glossaryEntry>having been passed along from generation to generation; "among Biblical critics a tralatitious interpretation is one received by expositor from expositor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300578034"
	 b:glossaryEntry='of long standing and acceptance; "time-honored customs"'/>
<rdf:Description rdf:about="&a;300578164">
	<b:glossaryEntry>adhering to tradition especially in cultural or religious practices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300578294">
	<b:glossaryEntry>not conforming to or in accord with tradition; "nontraditional designs"; "nontraditional practices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300578470"
	 b:glossaryEntry="tending to come together from different directions"/>
<rdf:Description rdf:about="&a;300578649"
	 b:glossaryEntry="flowing together"/>
<rdf:Description rdf:about="&a;300578734"
	 b:glossaryEntry="meeting or joining"/>
<rdf:Description rdf:about="&a;300578812">
	<b:glossaryEntry>(of light rays) converging on a point; "focused light rays can set something afire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300578960"
	 b:glossaryEntry="tending to move apart in different directions"/>
<rdf:Description rdf:about="&a;300579127"
	 b:glossaryEntry="resembling the branches of a tree"/>
<rdf:Description rdf:about="&a;300579216"
	 b:glossaryEntry="diverging from a common point"/>
<rdf:Description rdf:about="&a;300579304"
	 b:glossaryEntry='having many branches; "a branchy tree trunk"'/>
<rdf:Description rdf:about="&a;300579492">
	<b:glossaryEntry>resembling a tree in form and branching structure; "arborescent coral found off the coast of Bermuda"; "dendriform sponges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300579784">
	<b:glossaryEntry>(botany) having widely spreading paired branches; "maples are brachiate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300579912"
	 b:glossaryEntry="having branches"/>
<rdf:Description rdf:about="&a;300579994"
	 b:glossaryEntry="resembling a bush in being thickly branched and spreading"/>
<rdf:Description rdf:about="&a;300580118">
	<b:glossaryEntry>(of trees) having a bushy top without a leader; "mop-headed cabbage palms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300580249"
	 b:glossaryEntry="having no branches"/>
<rdf:Description rdf:about="&a;300580342"
	 b:glossaryEntry='without branches; "a tree with an unbranched trunk"'/>
<rdf:Description rdf:about="&a;300580464">
	<b:glossaryEntry>causing one to believe the truth of something; "a convincing story"; "a convincing manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300580683">
	<b:glossaryEntry>appearing to merit belief or acceptance; "a credible witness"; "a plausible story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300580832"
	 b:glossaryEntry="freeing from illusion or false belief"/>
<rdf:Description rdf:about="&a;300580946"
	 b:glossaryEntry='capable of convincing; "a persuasive argument"'/>
<rdf:Description rdf:about="&a;300581049">
	<b:glossaryEntry>not convincing; "unconvincing excuses"; "as unconvincing as a forced smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300581219"
	 b:glossaryEntry="not capable of persuading"/>
<rdf:Description rdf:about="&a;300581303"
	 b:glossaryEntry="having been prepared for eating by the application of heat"/>
<rdf:Description rdf:about="&a;300581792">
	<b:glossaryEntry>(of bread and pastries) cooked by dry heat (as in an oven); "baked goods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300581917"
	 b:glossaryEntry="cooked over an outdoor grill"/>
<rdf:Description rdf:about="&a;300582011"
	 b:glossaryEntry="cooked in hot water"/>
<rdf:Description rdf:about="&a;300582102">
	<b:glossaryEntry>cooked by browning in fat and then simmering in a closed container</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300582222"
	 b:glossaryEntry="cooked by radiant heat (as over a grill)"/>
<rdf:Description rdf:about="&a;300582326">
	<b:glossaryEntry>ruined by overcooking; "she served us underdone bacon and burnt buscuits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300582460"
	 b:glossaryEntry="cooked until ready to serve"/>
<rdf:Description rdf:about="&a;300582538"
	 b:glossaryEntry="cooked by frying in fat"/>
<rdf:Description rdf:about="&a;300582626"
	 b:glossaryEntry="baked until hard"/>
<rdf:Description rdf:about="&a;300582699"
	 b:glossaryEntry="(used of eggs) cooked until the yolk is solid"/>
<rdf:Description rdf:about="&a;300582802"
	 b:glossaryEntry="cooked with onions"/>
<rdf:Description rdf:about="&a;300582876">
	<b:glossaryEntry>(of meat) cooked until there is just a little pink meat inside</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300582991"
	 b:glossaryEntry="cooked too long but still edible"/>
<rdf:Description rdf:about="&a;300583078">
	<b:glossaryEntry>toasted or roasted slightly; "parched corn was a staple of the Indian diet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300583207"
	 b:glossaryEntry="(of meat) to cook by dry heat in an oven"/>
<rdf:Description rdf:about="&a;300583309"
	 b:glossaryEntry="fried quickly in a little fat"/>
<rdf:Description rdf:about="&a;300583400">
	<b:glossaryEntry>having the surface burned quickly with intense heat; "the seared meat is then covered with hot liquid for braising"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300583568">
	<b:glossaryEntry>used of eggs; having the yolk still liquid; "soft-boiled eggs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300583688"
	 b:glossaryEntry='cooked in steam; "steamed clams"'/>
<rdf:Description rdf:about="&a;300583774">
	<b:glossaryEntry>browned over by exposure to heat; "he liked toasted marshmallows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300583893"
	 b:glossaryEntry="(of meat) cooked until there is no pink meat left inside"/>
<rdf:Description rdf:about="&a;300584005"
	 b:glossaryEntry="not treated with heat to prepare it for eating"/>
<rdf:Description rdf:about="&a;300584173"
	 b:glossaryEntry="insufficiently cooked"/>
<rdf:Description rdf:about="&a;300584263">
	<b:glossaryEntry>(of meat) cooked a short time; still red inside; "rare roast beef"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300584380"
	 b:glossaryEntry="not cooked"/>
<rdf:Description rdf:about="&a;300584445"
	 b:glossaryEntry="not having been brown by exposure to heat"/>
<rdf:Description rdf:about="&a;300584542">
	<b:glossaryEntry>done with or working with others for a common purpose or benefit; "a cooperative effort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300584742">
	<b:glossaryEntry>showing a willingness to cooperate; "a helpful cooperative patient"; "parents hope to raise children who are considerate and helpful to others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300584939">
	<b:glossaryEntry>working together; used especially of groups, as subsidiaries of a corporation, cooperating for an enhanced effect; "a synergistic effect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300585147"
	 b:glossaryEntry='unwilling to cooperate; "an uncooperative witness"'/>
<rdf:Description rdf:about="&a;300585311"
	 b:glossaryEntry='resistant to authority or control; "as refractory as a mule"'/>
<rdf:Description rdf:about="&a;300585428"
	 b:glossaryEntry='showing no willingness to cooperate; "an unhelpful attitude"'/>
<rdf:Description rdf:about="&a;300585544">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking in integrity; "humanity they knew to be corrupt...from the day of Adam''s creation"; "a corrupt and incompetent city government"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300585895">
	<b:glossaryEntry>extremely dirty and corrupt; "every government ought to attend to cleaning its own Augean stables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300586046"
	 b:glossaryEntry="ruined in character or quality"/>
<rdf:Description rdf:about="&a;300586153">
	<b:glossaryEntry>capable of being corrupted; "corruptible judges"; "dishonest politicians"; "a purchasable senator"; "a venal police officer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300586380">
	<b:glossaryEntry>marked by immorality; deviating from what is considered right or proper or good; "depraved criminals"; "a perverted sense of loyalty"; "the reprobate conduct of a gambling aristocrat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300586663">
	<b:glossaryEntry>unethical or dishonest; "dirty police officers"; "a sordid political campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300586802">
	<b:glossaryEntry>characteristic of Praetorian soldiers in respect to corruption or political venality; "a large praetorian bureaucracy filled with ambitious...and often sycophantic people makes work and makes trouble"- Arthur M.Schlesinger Jr.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300587097">
	<b:glossaryEntry>morally corrupt or evil; "the putrid atmosphere of the court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300587211"
	 b:glossaryEntry='having taken a bribe or bribes; "a sold-out politician"'/>
<rdf:Description rdf:about="&a;300587324">
	<b:glossaryEntry>free of corruption or immorality; "a policeman who was incorrupt and incorruptible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300587553"
	 b:glossaryEntry='clean and honest; "antiseptic financial practices"'/>
<rdf:Description rdf:about="&a;300587660">
	<b:glossaryEntry>incapable of being morally corrupted; "incorruptible judges are the backbone of the society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300587812">
	<b:glossaryEntry>not debased; "though his associates were dishonest, he remained uncorrupted"; "uncorrupted values"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300587968"
	 b:glossaryEntry="not decayed or decomposed"/>
<rdf:Description rdf:about="&a;300588063">
	<b:glossaryEntry>used especially of drugs or muscles that work together so the total effect is greater than the sum of the two (or more)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300588254">
	<b:glossaryEntry>used especially of drugs or muscles that counteract or neutralize each other''s effect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300588413">
	<b:glossaryEntry>(architecture) most ornate of the three orders of classical Greek architecture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300588584">
	<b:glossaryEntry>a modified Corinthian style of architecture (a combination of Corinthian and Ionic)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300588723">
	<b:glossaryEntry>(architecture) oldest and simplest of the three orders of classical Greek architecture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300588897"
	 b:glossaryEntry="a classical order similar to Roman Doric"/>
<rdf:Description rdf:about="&a;300588990"
	 b:glossaryEntry="(architecture) an order of classical Greek architecture"/>
<rdf:Description rdf:about="&a;300589115">
	<b:glossaryEntry>large or relatively large in number or amount or extent or degree; "a considerable quantity"; "the economy was a considerable issue in the campaign"; "went to considerable trouble for us"; "spent a considerable amount of time on the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300589505">
	<b:glossaryEntry>enough to be estimated or measured; "appreciable amounts of noxious wastes are dumped into the harbor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300589665">
	<b:glossaryEntry>great in range or scope; "an extended vocabulary"; "surgeons with extended experience"; "extensive examples of picture writing"; "suffered extensive damage"; "a wide selection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300589915">
	<b:glossaryEntry>large in amount or extent or degree; "it cost a considerable amount"; "a goodly amount"; "received a hefty bonus"; "a respectable sum"; "a tidy sum of money"; "a sizable fortune"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300590206">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(regional; S and Midland) "it''s a right smart distance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300590319"
	 b:glossaryEntry='fairly large; "won by a substantial margin"'/>
<rdf:Description rdf:about="&a;300590434">
	<b:glossaryEntry>too small or unimportant to merit attention; "passed his life in an inconsiderble village"; "their duties were inconsiderable"; "had no inconsiderable influence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300590674"
	 b:glossaryEntry="not large enough to consider or notice"/>
<rdf:Description rdf:about="&a;300590782">
	<b:glossaryEntry>having substance or capable of being treated as fact; not imaginary; "the substantial world"; "a mere dream, neither substantial nor practical"; "most ponderous and substantial things"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300591091">
	<b:glossaryEntry>lacking material form or substance; unreal; "as insubstantial as a dream"; "an insubstantial mirage on the horizon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300591363">
	<b:glossaryEntry>characterized by lightness and insubstantiality; as impalpable or intangible as air; "figures light and aeriform come unlooked for and melt away"- Thomas Carlyle; "aerial fancies"; "an airy apparition"; "physical rather than ethereal forms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300591692">
	<b:glossaryEntry>lacking in substance; "strange fancies of unreal and shadowy worlds"- W.A.Butler; "dim shadowy forms"; "a wraithlike column of smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300591892"
	 b:glossaryEntry='derived from or composed of matter; "the material universe"'/>
<rdf:Description rdf:about="&a;300592078">
	<b:glossaryEntry>having substance or material existence; perceptible to the senses; "a physical manifestation"; "surrounded by tangible objects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300592283">
	<b:glossaryEntry>concerned with material things; "physical properties"; "the physical characteristics of the earth"; "the physical size of a computer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300592471">
	<b:glossaryEntry>not consisting of matter; "immaterial apparitions"; "ghosts and other immaterial entities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300592686">
	<b:glossaryEntry>lacking substance or reality; incapable of being touched or seen; "that intangible thing--the soul"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300592856">
	<b:glossaryEntry>having a body or a body of a specified kind; often used in combination; "strong-bodied"; "big-bodied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300593046">
	<b:glossaryEntry>invested with a bodily form especially of a human body; "a monarch...regarded as a god incarnate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300593199"
	 b:glossaryEntry="having no body"/>
<rdf:Description rdf:about="&a;300593322"
	 b:glossaryEntry='having no trunk or main part; "a bodiless head"'/>
<rdf:Description rdf:about="&a;300593435">
	<b:glossaryEntry>having no physical form; "belief in a world filled with...formless but often malevolent beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300593584">
	<b:glossaryEntry>subjected to intensive forced indoctrination resulting in the rejection of old beliefs and acceptance of new ones; "brainwashed prisoners of war"; "captive audiences for TV commercials can become brainwashed consumers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300593860">
	<b:glossaryEntry>not successfully subjected to brainwashing; "despite the torture and the psychological pressure some POWs remained unbrainwashed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300594049">
	<b:glossaryEntry>having material or physical form or substance; "that which is created is of necessity corporeal and visible and tangible" - Benjamin Jowett</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300594345">
	<b:glossaryEntry>having or relating to a physical material body; "bodily existence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300594464">
	<b:glossaryEntry xml:space='preserve'><![CDATA[possessing or existing in bodily form; "what seemed corporal melted as breath into the wind"- Shakespeare; "an incarnate spirit"; "`corporate'' is an archaic term"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300594725"
	 b:glossaryEntry="having a new body"/>
<rdf:Description rdf:about="&a;300594800"
	 b:glossaryEntry='without material form or substance; "an incorporeal spirit"'/>
<rdf:Description rdf:about="&a;300595002"
	 b:glossaryEntry='not having a material body; "bodiless ghosts"'/>
<rdf:Description rdf:about="&a;300595155">
	<b:glossaryEntry>lacking material body or form or substance; "spiritual beings"; "the vital transcendental soul belonging to the spiritual realm"-Lewis Mumford</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300595353">
	<b:glossaryEntry>free from error; especially conforming to fact or truth; "the correct answer"; "the correct version"; "the right answer"; "took the right road"; "the right decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300595724">
	<b:glossaryEntry>exact in performance or amount; strictly correct; "a precise instrument"; "a precise measurement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300595894">
	<b:glossaryEntry>correct to the last detail; especially being in or following the exact words; "a letter-perfect rendition of the soliloquy "she was word-perfect in her part"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300596127"
	 b:glossaryEntry='following a correct or logical method; "straight reasoning"'/>
<rdf:Description rdf:about="&a;300596241">
	<b:glossaryEntry>not correct; not in conformity with fact or truth; "an incorrect calculation"; "the report in the paper is wrong"; "your information is wrong"; "the clock showed the wrong time"; "found themselves on the wrong road"; "based on the wrong assumptions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300596698">
	<b:glossaryEntry>containing or characterized by error; "erroneous conclusions"; "the answer was inaccurate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300596857">
	<b:glossaryEntry>based on an incorrect or misleading notion or information; "fallacious hope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300596990">
	<b:glossaryEntry>arising from error; "a false assumption"; "a mistaken view of the situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300597129"
	 b:glossaryEntry='correct in opinion or judgment; "time proved him right"'/>
<rdf:Description rdf:about="&a;300597264">
	<b:glossaryEntry>disposed toward or having views based on what is right; "respect for law which every right-minded citizen ought to have"- Bertrand Russell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300597461">
	<b:glossaryEntry>based on or acting or judging in error; "it is wrong to think that way"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300597602">
	<b:glossaryEntry>obstinately perverse in judgment or opinion; "a wrongheaded policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300597727">
	<b:glossaryEntry>having something undesirable neutralized; "with glasses her corrected vision was 20:20"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300597924">
	<b:glossaryEntry>(optics) free from or corrected for spherical aberration; "an aplanatic mirror"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300598059">
	<b:glossaryEntry>(optics) corrected for both chromatic and spherical aberration; "an apochromatic lens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300598204"
	 b:glossaryEntry="having been put right"/>
<rdf:Description rdf:about="&a;300598281"
	 b:glossaryEntry='left faulty or wrong; "uncorrected astigmatism"'/>
<rdf:Description rdf:about="&a;300598404"
	 b:glossaryEntry='not having been put right; "unremedied errors"'/>
<rdf:Description rdf:about="&a;300598507">
	<b:glossaryEntry>capable of being corrected or set right; "a corrigible defect"; "a corrigible prisoner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300598705"
	 b:glossaryEntry='capable of being corrected by additions; "an amendable flaw"'/>
<rdf:Description rdf:about="&a;300598835"
	 b:glossaryEntry="susceptible of improvement"/>
<rdf:Description rdf:about="&a;300598918"
	 b:glossaryEntry='susceptible to improvement or reform; "a redeemable sinner"'/>
<rdf:Description rdf:about="&a;300599047"
	 b:glossaryEntry="impervious to correction by punishment"/>
<rdf:Description rdf:about="&a;300599216"
	 b:glossaryEntry='persistently bad; "school for delinquent boys"'/>
<rdf:Description rdf:about="&a;300599319"
	 b:glossaryEntry='hopelessly bad; "an unregenerate criminal"'/>
<rdf:Description rdf:about="&a;300599446">
	<b:glossaryEntry>not susceptible of improvement; "uncontrollable children"; "an uncorrectable habit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300599621">
	<b:glossaryEntry>composed of people from or at home in many parts of the world ; especially not provincial in attitudes or interests; "his cosmopolitan benevolence impartially extended to all races and to all creeds"- T.B. Macaulay; "the ancient and cosmopolitan societies of Syria and Egypt"; "that queer, cosmopolitan, rather sinister crowd found around the Marseilles docks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300600076">
	<b:glossaryEntry>marked by wide-ranging knowledge and appreciation of many parts of the world arising from urban life and wide travel; "the sophisticated manners of a true cosmopolite"; "urbane and pliant...he was at ease even in the drawing rooms of Paris"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300600385">
	<b:glossaryEntry>familiar with many parts of the world; "a traveled, educated man"; "well-traveled people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300600541">
	<b:glossaryEntry>characteristic of the provinces or their people; "deeply provincial and conformist"; "in that well-educated company I felt uncomfortably provincial"; "narrow provincial attitudes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300600867">
	<b:glossaryEntry>awkwardly simple and provincial; "bumpkinly country boys"; "rustic farmers"; "a hick town"; "the nightlife of Montmartre awed the unsophisticated tourists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300601112"
	 b:glossaryEntry="strong and healthy but not sophisticated"/>
<rdf:Description rdf:about="&a;300601207">
	<b:glossaryEntry>narrowly restricted in outlook or scope; "little sympathy with parocial mentality"; "insular attitudes toward foreigners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300601394">
	<b:glossaryEntry>small and remote and insignificant; "a jerkwater college"; "passed a series of poky little one-horse towns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300601584"
	 b:glossaryEntry='not given to travel; "a stay-at-home friend"'/>
<rdf:Description rdf:about="&a;300601690"
	 b:glossaryEntry="retarding evacuation of feces"/>
<rdf:Description rdf:about="&a;300601791"
	 b:glossaryEntry="causing constipation"/>
<rdf:Description rdf:about="&a;300601880"
	 b:glossaryEntry="stimulating evacuation of feces"/>
<rdf:Description rdf:about="&a;300602002"
	 b:glossaryEntry="mildly laxative"/>
<rdf:Description rdf:about="&a;300602072"
	 b:glossaryEntry="strongly laxative"/>
<rdf:Description rdf:about="&a;300602168">
	<b:glossaryEntry>have difficult or incomplete or infrequent evacuation of the bowels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300602311"
	 b:glossaryEntry='confined in the bowels; "he is bound in the belly"'/>
<rdf:Description rdf:about="&a;300602416"
	 b:glossaryEntry="not constipated"/>
<rdf:Description rdf:about="&a;300602537"
	 b:glossaryEntry="of or relating to diarrhea"/>
<rdf:Description rdf:about="&a;300602632"
	 b:glossaryEntry='emptying easily or excessively; "loose bowels"'/>
<rdf:Description rdf:about="&a;300602736">
	<b:glossaryEntry>showing concern for the rights and feelings of others; "friends considerate enough to leave us alone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300602967">
	<b:glossaryEntry>showing consideration and anticipation of needs; "it was thoughtful of you to bring flowers"; "a neighbor showed thoughtful attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300603165">
	<b:glossaryEntry>lacking regard for the rights or feelings of others; "shockingly inconsiderate behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300603403">
	<b:glossaryEntry>showing an unthinking lack of consideration; "a careless remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300603522">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without care or thought for others; "the thoughtless saying of a great princess on being informed that the people had no bread; `Let them eat cake''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300603752">
	<b:glossaryEntry>characterized by courtesy and gracious good manners; "if a man be gracious and courteous to strangers it shows he is a citizen of the world"-Francis Bacon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300604016">
	<b:glossaryEntry>having the qualities of gallantry attributed to an ideal knight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300604157">
	<b:glossaryEntry>showing no courtesy; rude; "a distant and at times discourteous young"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300604394">
	<b:glossaryEntry>surprisingly and unceremoniously brusque in manner; "an abrupt reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300604516">
	<b:glossaryEntry>marked by rude or peremptory shortness; "try to cultivate a less brusque manner"; "a curt reply"; "the salesgirl was very short with him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300604733"
	 b:glossaryEntry="offensively discourteous"/>
<rdf:Description rdf:about="&a;300604838">
	<b:glossaryEntry>without due formalities; "unceremonious dismissal from office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300604960"
	 b:glossaryEntry="showing regard for others in manners, speech, behavior, etc."/>
<rdf:Description rdf:about="&a;300605127"
	 b:glossaryEntry="socially correct in behavior"/>
<rdf:Description rdf:about="&a;300605226"
	 b:glossaryEntry='exhibiting courtesy and politeness; "a nice gesture"'/>
<rdf:Description rdf:about="&a;300605352"
	 b:glossaryEntry="not polite"/>
<rdf:Description rdf:about="&a;300605525"
	 b:glossaryEntry="(used of an ill-mannered child) impolitely unruly"/>
<rdf:Description rdf:about="&a;300605638">
	<b:glossaryEntry>socially incorrect in behavior; "resentment flared at such an unmannered intrusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300605813"
	 b:glossaryEntry="lacking social graces"/>
<rdf:Description rdf:about="&a;300605906"
	 b:glossaryEntry="so rude and abusive as to be unsuitable for Parliament"/>
<rdf:Description rdf:about="&a;300606022">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not rude; marked by satisfactory (or especially minimal) adherence to social usages and sufficient but not noteworthy consideration for others; "even if he didn''t like them he should have been civil"- W.S. Maugham]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300606314">
	<b:glossaryEntry>lacking civility or good manners; "want nothing from you but to get away from your uncivil tongue"- Willa Cather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300606505">
	<b:glossaryEntry>(of divisions of time) legally recognized in ordinary affairs of life; "the civil calendar"; "a civil day begins at mean midnight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300606687">
	<b:glossaryEntry>(of divisions of time) determined by daily motion of the stars; "sidereal time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300606821">
	<b:glossaryEntry>having the ability or power to create; "a creative imagination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300607079">
	<b:glossaryEntry>indulging in or influenced by fancy; "a fanciful mind"; "all the notional vagaries of childhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300607241"
	 b:glossaryEntry='capable of imaginative creation; "fictive talent"'/>
<rdf:Description rdf:about="&a;300607344">
	<b:glossaryEntry>(used of persons or artifacts) marked by independence and creativity in thought or action; "an imaginative use of material"; "the invention of the knitting frame by another ingenious English clergyman"- Lewis Mumford; "an ingenious device"; "had an inventive turn of mind"; "inventive ceramics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300607720"
	 b:glossaryEntry="exuberantly creative"/>
<rdf:Description rdf:about="&a;300607793"
	 b:glossaryEntry='not creative; "an uncreative imagination"'/>
<rdf:Description rdf:about="&a;300607963">
	<b:glossaryEntry>deficient in originality or creativity; lacking powers of invention:i "a sterile ideology lacking in originality"; "unimaginative development of a musical theme"; "uninspired writing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300608243">
	<b:glossaryEntry>capable of being believed; "completely credible testimony"; "credible information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300608483">
	<b:glossaryEntry>within the realm of credibility; "not a very likely excuse"; "a plausible story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300608628">
	<b:glossaryEntry>affording reasonable grounds for belief or acceptance; "presumptive evidence"; "a strong presumptive case is made out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300608804">
	<b:glossaryEntry xml:space='preserve'><![CDATA[beyond belief or understanding; "at incredible speed"; "the book''s plot is simply incredible"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300609131"
	 b:glossaryEntry="bewildering or striking dumb with wonder"/>
<rdf:Description rdf:about="&a;300609257">
	<b:glossaryEntry>barely credible; "the fabulous endurance of a marathon runner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300609374"
	 b:glossaryEntry='too improbable to admit of belief; "a tall story"'/>
<rdf:Description rdf:about="&a;300609515"
	 b:glossaryEntry="not imagined even in a dream"/>
<rdf:Description rdf:about="&a;300609652">
	<b:glossaryEntry>disposed to believe on little evidence; "the gimmick would convince none but the most credulous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300609912">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a common but incorrect usage where `credulous'' would be appropriate; "she was not the...credible fool he expected"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300610081"
	 b:glossaryEntry="too credulous for your own good"/>
<rdf:Description rdf:about="&a;300610172"
	 b:glossaryEntry="not inclined to ask questions"/>
<rdf:Description rdf:about="&a;300610261"
	 b:glossaryEntry="not disposed or willing to believe"/>
<rdf:Description rdf:about="&a;300610425">
	<b:glossaryEntry>denying or questioning the tenets of especially a religion; "a skeptical approach to the nature of miracles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300610630"
	 b:glossaryEntry="incredulous by virtue of distrust"/>
<rdf:Description rdf:about="&a;300610721">
	<b:glossaryEntry>marked by a tendency to find and call attention to errors and flaws; "a critical attitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300610992">
	<b:glossaryEntry>tending to find and call attention to faults; "a captious pedant"; "an excessively demanding and faultfinding tutor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300611178">
	<b:glossaryEntry xml:space='preserve'><![CDATA[quibbling over insignificant details; "caviling pettifoggers and quiggling pleaders"-Edmund Burke; "her nagging and carping attack"; "thought her editor unnecessarily nitpicking"; "a pettifogging lawyer''s mind"; "had no patience with quibbling critics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300611535">
	<b:glossaryEntry>harshly critical or expressing censure; "was censorious of petty failings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300611666">
	<b:glossaryEntry>inclined to judge too severely; "hypercritical of colloquial speech"; "the overcritical teacher can discourage originality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300611864">
	<b:glossaryEntry>marked by harshly abusive criticism; "his scathing remarks about silly lady novelists"; "her vituperative railing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300612048">
	<b:glossaryEntry>not critical; not tending to find or call attention to errors; "a devoted and almost uncritical admirer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300612209">
	<b:glossaryEntry>depending on judgment; "a judgmental error"; "I think that she is too judgmental to be a good therapist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300612388">
	<b:glossaryEntry>tending to make moral judgments or judgments based on personal opinions; "a counselor tries not to be faultfinding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300612565">
	<b:glossaryEntry>refraining from making judgments especially ones based on personal opinions or standards; "sympathetic and nonjudgmental"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300612746">
	<b:glossaryEntry xml:space='preserve'><![CDATA[characterized by careful evaluation and judgment; "a critical reading"; "a critical dissertation"; "a critical analysis of Melville''s writings]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300613015">
	<b:glossaryEntry>exercising or involving careful evaluations; "looked him over with an appraising eye"; "the literary judge uses many evaluative terms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300613222">
	<b:glossaryEntry>expressing careful judgment; "discriminative censure"; "a biography ...appreciative and yet judicial in purpose"-Tyler Dennett</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300613420">
	<b:glossaryEntry>marked by disregard for critical standards or procedures; "news sources reflected uncritical estimates of the number of juvenile addicts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300613646">
	<b:glossaryEntry>being in or verging on a state of crisis or emergency; "a critical shortage of food"; "a critical illness"; "an illness at the critical stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300613933">
	<b:glossaryEntry>of critical importance and consequence; "an acute (or critical) lack of research funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300614072">
	<b:glossaryEntry>causing fear or anxiety by threatening great harm; "a dangerous operation"; "a grave situation"; "a grave illness"; "grievous bodily harm"; "a serious wound"; "a serious turn of events"; "a severe case of pneumonia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300614381">
	<b:glossaryEntry>fraught with extreme danger; nearly hopeless; "a desperate illness"; "on all fronts the Allies were in a desperate situation due to lack of materiel"- G.C.Marshall; "a dire emergency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300614627"
	 b:glossaryEntry="not in a state of crisis or emergency"/>
<rdf:Description rdf:about="&a;300614771"
	 b:glossaryEntry="without a crisis (as of some diseases)"/>
<rdf:Description rdf:about="&a;300614865">
	<b:glossaryEntry>(chemistry and physics) at or of a point at which a property or phenomenon suffers an abrupt change especially having enough mass to sustain a chain reaction; "a critical temperature of water is 100 degrees C--its boiling point at standard atmospheric pressure"; "critical mass"; "go critical"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300615249">
	<b:glossaryEntry>(especially of fissionable material) able to sustain a chain reaction in such a manner that the rate of reaction increases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300615431">
	<b:glossaryEntry>(chemistry and physics) not critical; not at a point of abrupt change</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300615576">
	<b:glossaryEntry>placed crosswise; "spoken with a straight face but crossed fingers"; "crossed forks"; "seated with arms across"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300615768"
	 b:glossaryEntry="crossed or intersected in the form of an X"/>
<rdf:Description rdf:about="&a;300615896"
	 b:glossaryEntry='not crossed; "sitting primly with uncrossed legs"'/>
<rdf:Description rdf:about="&a;300616001">
	<b:glossaryEntry>(of a check) for deposit only as indicated by having two lines drawn across it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300616133"
	 b:glossaryEntry="(of a check) not crosses"/>
<rdf:Description rdf:about="&a;300616213"
	 b:glossaryEntry="having convergent strabismus"/>
<rdf:Description rdf:about="&a;300616316"
	 b:glossaryEntry="(British informal) cross-eyed"/>
<rdf:Description rdf:about="&a;300616401"
	 b:glossaryEntry="having divergent strabismus"/>
<rdf:Description rdf:about="&a;300616483">
	<b:glossaryEntry>moving across open country rather than following tracks or roads; "a cross-country race"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300616649">
	<b:glossaryEntry>designed for or used for or taking place on trails and beaches etc instead of public roads; "off-road vehicles such as dune buggies"; "off-road sports such as snowmobiling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300616876"
	 b:glossaryEntry='taking place over public roads; "road racing"'/>
<rdf:Description rdf:about="&a;300616993">
	<b:glossaryEntry>(of vehicles) fit to be driven on the open road; "a roadworthy truck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300617119">
	<b:glossaryEntry>provided with or as if with a crown or a crown as specified; often used in combination; "a high-crowned hat"; "an orange-crowned bird"; "a crowned signet ring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300617404">
	<b:glossaryEntry>covered as if with a cap or crown especially of a specified kind; "cloud-capped mountains"; "snow-capped peaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300617568"
	 b:glossaryEntry="provided with a chaplet"/>
<rdf:Description rdf:about="&a;300617647">
	<b:glossaryEntry>(botany) bearing a coma; crowned with an assemblage of branches or leaves or bracts; "comate royal palms"; "pineapples are comate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300617839">
	<b:glossaryEntry>invested with royal power as symbolized by a crown; "the royal (or crowned) heads of Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300617983">
	<b:glossaryEntry>not (especially not yet) provided with a crown; "the uncrowned king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300618137">
	<b:glossaryEntry>having the power but not the rank or title of a king; "one of the quasi-royal rulers of Africa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300618290">
	<b:glossaryEntry>(dentistry) having an artificial crown on a tooth; "had many crowned teeth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300618437">
	<b:glossaryEntry>used especially of front teeth having artificial crowns; "capped teeth gave her a beautiful smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300618588">
	<b:glossaryEntry>(dentistry) not having an artificial crown on a tooth; used especially of molars and bicuspids; "uncrowned teeth badly in need of attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300618802"
	 b:glossaryEntry='used especially of front teeth; "natural uncapped teeth"'/>
<rdf:Description rdf:about="&a;300618913">
	<b:glossaryEntry>of extreme importance; vital to the resolution of a crisis; "a crucial moment in his career"; "a crucial election"; "a crucial issue for women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300619212">
	<b:glossaryEntry>forming or having the nature of a turning point or crisis; "a critical point in the campaign"; "the critical test"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300619392">
	<b:glossaryEntry>being of crucial importance; "a pivotal event"; "Its pivotal location has also exposed it to periodic invasions"- Henry Kissinger; "the polar events of this study"; "a polar principal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300619638"
	 b:glossaryEntry="of little importance; not decisive"/>
<rdf:Description rdf:about="&a;300619729">
	<b:glossaryEntry>having become fixed and definite in form; "distinguish between crystallized and uncrystallized opinion"- Psychological Abstracts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300619916"
	 b:glossaryEntry='not finally or definitely formed; "uncrystallized ideas"'/>
<rdf:Description rdf:about="&a;300620033"
	 b:glossaryEntry="having three dimensions"/>
<rdf:Description rdf:about="&a;300620254"
	 b:glossaryEntry="resembling a block in shape"/>
<rdf:Description rdf:about="&a;300620345"
	 b:glossaryEntry="resembling a box in rectangularity"/>
<rdf:Description rdf:about="&a;300620440"
	 b:glossaryEntry="shaped like a cube"/>
<rdf:Description rdf:about="&a;300620568">
	<b:glossaryEntry>(crystallography) of a crystal system characterized by three equal axes at right angles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300620711"
	 b:glossaryEntry='having three dimensions; "a solid object"'/>
<rdf:Description rdf:about="&a;300620804">
	<b:glossaryEntry>of or in or along or relating to a line; involving a single dimension; "a linear foot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300621051"
	 b:glossaryEntry="lying on the same line"/>
<rdf:Description rdf:about="&a;300621129"
	 b:glossaryEntry="arranged in a line"/>
<rdf:Description rdf:about="&a;300621200"
	 b:glossaryEntry="resembling a line"/>
<rdf:Description rdf:about="&a;300621272">
	<b:glossaryEntry>characterized by a straight line or lines; "rectilinear patterns in wallpaper"; "the rectilinear propagation of light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300621462"
	 b:glossaryEntry="involving two dimensions"/>
<rdf:Description rdf:about="&a;300621665"
	 b:glossaryEntry="lying in the same plane"/>
<rdf:Description rdf:about="&a;300621743"
	 b:glossaryEntry="having no depth or thickness"/>
<rdf:Description rdf:about="&a;300621822"
	 b:glossaryEntry="as the hard flattened scales of e.g. sharks"/>
<rdf:Description rdf:about="&a;300621931"
	 b:glossaryEntry="having been flattened"/>
<rdf:Description rdf:about="&a;300622018"
	 b:glossaryEntry="flat; like a table in form"/>
<rdf:Description rdf:about="&a;300622098">
	<b:glossaryEntry>relating to a single dimension or aspect; having no depth or scope; "a prose statement of fact is unidimensional, its value being measured wholly in terms of its truth"- Mary Sheehan; "a novel with one-dimensional characters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300622402">
	<b:glossaryEntry>having or involving or marked by several dimensions or aspects; "multidimensional problems"; "a multidimensional proposition"; "a multidimensional personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300622696">
	<b:glossaryEntry>having dimension--the quality or character or stature proper to a person; "never matures as a dimensional character; he is pasty, bland, faceless"- Norman Cousins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300622916">
	<b:glossaryEntry>lacking the expected range or depth; not designed to give an illusion or depth; "a film with two-dimensional characters"; "a flat two-dimensional painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300623140">
	<b:glossaryEntry>involving or relating to three dimensions or aspects; giving the illusion of depth; "lifelike three-dimensional characters"; "a three-dimensional account of conditions under the new government"; "they shot the movie in three-D"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300623461"
	 b:glossaryEntry="involving or relating to the fourth dimension or time"/>
<rdf:Description rdf:about="&a;300623577">
	<b:glossaryEntry>separated into parts or laid open or penetrated with a sharp edge or instrument; "the cut surface was mottled"; "cut tobacco"; "blood from his cut forehead"; "bandages on her cut wrists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300623957">
	<b:glossaryEntry>prepared by cutting; "sliced tomatoes"; "sliced ham"; "chopped clams"; "chopped meat"; "shredded cabbage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300624136">
	<b:glossaryEntry>cut or used for cutting crosswise or across the grain; "a crosscut slice of beef"; "a crosscut saw"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300624290"
	 b:glossaryEntry="cut into pieces"/>
<rdf:Description rdf:about="&a;300624358"
	 b:glossaryEntry="cut into with a sharp instrument"/>
<rdf:Description rdf:about="&a;300624444">
	<b:glossaryEntry>having a number or series of holes; "a perforated steel plate"; "perforated cancellation"; "perforated stamp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300624610">
	<b:glossaryEntry>having a hole cut through; "pierced ears"; "a perforated eardrum"; "a punctured balloon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300624789">
	<b:glossaryEntry>detached by cutting; "cut flowers"; "a severed head"; "an old tale of Anne Bolyn walking the castle walls with her poor cut-off head under her arm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300625000">
	<b:glossaryEntry>(especially of wood) cut or ripped longitudinally with the grain; "we bought split logs for the fireplace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300625158"
	 b:glossaryEntry="not cut"/>
<rdf:Description rdf:about="&a;300625253"
	 b:glossaryEntry="not perforated; having no opening"/>
<rdf:Description rdf:about="&a;300625344"
	 b:glossaryEntry='not pierced; "unpierced ears"'/>
<rdf:Description rdf:about="&a;300625429">
	<b:glossaryEntry>(of pages of a book) having the folds of the leaves trimmed or slit; "the cut pages of the book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300625575">
	<b:glossaryEntry>(of pages of a book) having adjacent leaves still joined at the fore edge; "a book with its leaves still uncut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300625738">
	<b:glossaryEntry>fashioned or shaped by cutting; "a well-cut suit"; "cut diamonds"; "cut velvet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300625957"
	 b:glossaryEntry='having been cut out; "the cut-out pieces of the dress"'/>
<rdf:Description rdf:about="&a;300626065">
	<b:glossaryEntry>cut or shaped with hard blows of a heavy cutting instrument like an ax or chisel; "a house built of hewn logs"; "rough-hewn stone"; "a path hewn through the underbrush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300626296">
	<b:glossaryEntry>(used especially of fur or wool) shaped or finished by cutting or trimming to a uniform length; "a coat of sheared lamb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300626470">
	<b:glossaryEntry>having long and narrow ornamental cuts showing an underlying fabric; "a slashed doublet"; "slashed cuffs showing the scarlet lining"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300626656">
	<b:glossaryEntry>having a narrow opening; "a slit skirt revealed shapely legs"; "a knife with a slitted blade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300626810">
	<b:glossaryEntry>not shaped by cutting or trimming; "an uncut diamond"; "rough gemstones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300626960">
	<b:glossaryEntry>(used especially of fur or wool) not having been sheared; "unsheared beaver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300627092">
	<b:glossaryEntry xml:space='preserve'><![CDATA[eager to investigate and learn or learn more (sometimes about others'' concerns); "a curious child is a teacher''s delight"; "a trap door that made me curious"; "curious investigators"; "traffic was slowed by curious rubberneckers"; "curious about the neighbor''s doings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300627486">
	<b:glossaryEntry>showing curiosity; "if someone saw a man climbing a light post they might get inquisitive"; "raised a speculative eyebrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300627709">
	<b:glossaryEntry xml:space='preserve'><![CDATA[offensively curious or inquisitive; "curious about the neighbor''s doings"; "he flipped through my letters in his nosy way"; "prying eyes"; "the snoopy neighbor watched us all day"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300627965"
	 b:glossaryEntry="showing excessive curiosity"/>
<rdf:Description rdf:about="&a;300628050">
	<b:glossaryEntry>showing absence of intellectual inquisitiveness or natural curiosity; "strangely incurious about the cause of the political upheaval surrounding them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300628292">
	<b:glossaryEntry>having no care or interest in knowing; "she appeared totally uninterested"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300628425"
	 b:glossaryEntry="deficient in curiosity"/>
<rdf:Description rdf:about="&a;300628521">
	<b:glossaryEntry xml:space='preserve'><![CDATA[occurring in or belonging to the present time; "current events"; "the current topic"; "current negotiations"; "current psychoanalytic theories"; "the ship''s current position"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300629037">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being or existing at the present moment; "the ship''s actual position is 22 miles due south of Key West"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300629193">
	<b:glossaryEntry>currently in progress; "there is mischief afoot"; "plans are afoot"; "preparations for the trial are underway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300629369"
	 b:glossaryEntry='passing from one to another; "circulating bills and coins"'/>
<rdf:Description rdf:about="&a;300629488"
	 b:glossaryEntry='belonging to the present time; "contemporary leaders"'/>
<rdf:Description rdf:about="&a;300629617"
	 b:glossaryEntry='currently holding an office; "the incumbent governor"'/>
<rdf:Description rdf:about="&a;300629726"
	 b:glossaryEntry='of current relevance; "a live issue"; "still a live option"'/>
<rdf:Description rdf:about="&a;300629836">
	<b:glossaryEntry>(printing) in current use or ready for use; "live copy is ready to be set in type or already set but not yet proofread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300630006">
	<b:glossaryEntry>currently happening; "an ongoing economic crisis"; "negotiations are in progress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300630158"
	 b:glossaryEntry='being in progress now; "on-line editorial projects"'/>
<rdf:Description rdf:about="&a;300630266">
	<b:glossaryEntry>encountered generally especially at the present time; "the prevailing opinion was that a trade war could be averted"; "the most prevalent religion in our area"; "speculation concerning the books author was rife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300630553">
	<b:glossaryEntry>of interest at the present time; "a topical reference"; "a topical and timely study of civil liberty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300630708">
	<b:glossaryEntry>reflecting the latest information or changes; "an up-to-date issue of the magazine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300630848">
	<b:glossaryEntry>up to the immediate present; most recent or most up-to-date; "the news is up-to-the-minute"; "the very latest scientific discoveries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300631053"
	 b:glossaryEntry="not current or belonging to the present time"/>
<rdf:Description rdf:about="&a;300631298"
	 b:glossaryEntry='of an earlier date; "back issues of the magazine"'/>
<rdf:Description rdf:about="&a;300631401"
	 b:glossaryEntry='no longer having force or relevance; "a dead issue"'/>
<rdf:Description rdf:about="&a;300631503"
	 b:glossaryEntry='no longer in use; "obsolete words"'/>
<rdf:Description rdf:about="&a;300631602">
	<b:glossaryEntry>old; no longer in use or valid or fashionable; "obsolete words"; "an obsolete locomotive"; "outdated equipment"; "superannuated laws"; "out-of-date ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300631852"
	 b:glossaryEntry="becoming obsolete"/>
<rdf:Description rdf:about="&a;300631927">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deserving a curse; sometimes used as an intensifier; "villagers shun the area believing it to be cursed"; "cursed with four daughter"; "not a cursed drop"; "his cursed stupidity"; "I''ll be cursed if I can see your reasoning"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300632302"
	 b:glossaryEntry="under a curse"/>
<rdf:Description rdf:about="&a;300632391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expletives used informally as intensifiers; "he''s a blasted idiot"; "it''s a blamed shame"; "a blame cold winter"; "not a blessed dime"; "I''ll be damned (or blessed or darned or goddamned) if I''ll do any such thing"; "he''s a damn (or goddam or goddamned) fool"; "a deuced idiot"; "tired or his everlasting whimpering"; "an infernal nuisance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300632902"
	 b:glossaryEntry='burdened with; "stuck with the tab"'/>
<rdf:Description rdf:about="&a;300633014"
	 b:glossaryEntry='used as expletives; "oh, damn (or goddamn)!"'/>
<rdf:Description rdf:about="&a;300633119"
	 b:glossaryEntry='deserving a curse; "her damnable pride"'/>
<rdf:Description rdf:about="&a;300633225">
	<b:glossaryEntry>highly favored or fortunate (as e.g. by divine grace); "our blessed land"; "the blessed assurance of a steady income"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300633440">
	<b:glossaryEntry>supremely favored or fortunate; "golden lads and girls all must / like chimney sweepers come to dust"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300633616">
	<b:glossaryEntry>bringing great happiness and thankfulness; "glorious freedom"; "glorious times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300633750">
	<b:glossaryEntry>provided or supplied or equipped with (especially as by inheritance or nature); "an well-endowed college"; "endowed with good eyesight"; "endowed by their Creator with certain unalienable rights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300634053">
	<b:glossaryEntry>having good fortune bestowed or conferred upon; sometimes used as in combination; "blessed with a strong healthy body"; "a nation blessed with peace"; "a peace-blessed era"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300634314"
	 b:glossaryEntry="supplied with (especially a dower or dowry)"/>
<rdf:Description rdf:about="&a;300634411">
	<b:glossaryEntry>officially endowed with authority or power; "by the Constitution...the president is invested with certain...powers"- John Marshall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300634612">
	<b:glossaryEntry>not equipped or or provided; "unendowed with genius"- J.L.Lowes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300634767"
	 b:glossaryEntry="(archaic) lacking a dowry"/>
<rdf:Description rdf:about="&a;300634848">
	<b:glossaryEntry>not provided with something desirable; "a hovel unblessed with electricity or running water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300634996">
	<b:glossaryEntry>furnished or concealed with curtains or draperies; "a curtained alcove"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300635141"
	 b:glossaryEntry='covered in folds of cloth; "velvet-draped windows"'/>
<rdf:Description rdf:about="&a;300635244">
	<b:glossaryEntry>not provided with curtains; "blank, curtainless windows stared back at her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300635391"
	 b:glossaryEntry="made according to the specifications of an individual"/>
<rdf:Description rdf:about="&a;300635556"
	 b:glossaryEntry="of clothing"/>
<rdf:Description rdf:about="&a;300635682"
	 b:glossaryEntry="built for a particular individual"/>
<rdf:Description rdf:about="&a;300635790">
	<b:glossaryEntry>bearing the name of a particular designer; "a designer dress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300635909"
	 b:glossaryEntry="made for purchase and immediate use"/>
<rdf:Description rdf:about="&a;300636055">
	<b:glossaryEntry>produced by a manufacturing process; "bought some made goods at the local store; rope and nails"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300636202"
	 b:glossaryEntry='(of clothing) "a ready-made jacket"; "ready-to-wear clothes"'/>
<rdf:Description rdf:about="&a;300636353">
	<b:glossaryEntry>manufactured in standard sizes to be shipped and assembled elsewhere; "a prefabricated structure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300636519">
	<b:glossaryEntry>made by hand or a hand process; "delicate handmade baby dresses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300636725">
	<b:glossaryEntry>made as part of the arts-and-crafts program at summer camp; "my camp-made leather wallet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300636870"
	 b:glossaryEntry='made on a handloom; "handwoven tablecloth"'/>
<rdf:Description rdf:about="&a;300636982"
	 b:glossaryEntry="sewn by hand rather than machine"/>
<rdf:Description rdf:about="&a;300637084">
	<b:glossaryEntry>sewn together with overhand stitches (close vertical stitches that pass over and draw the two edges together)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300637259"
	 b:glossaryEntry="made by machine"/>
<rdf:Description rdf:about="&a;300637333">
	<b:glossaryEntry>made or produced in the home or by yourself; "homemade bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300637539"
	 b:glossaryEntry='done by yourself; "their house was a do-it-yourself project"'/>
<rdf:Description rdf:about="&a;300637660"
	 b:glossaryEntry='baked at home; "home-baked cakes and pies"'/>
<rdf:Description rdf:about="&a;300637759"
	 b:glossaryEntry='brewed at home; "home-brewed beer"'/>
<rdf:Description rdf:about="&a;300637851"
	 b:glossaryEntry='cured at home; "home-cured hams"'/>
<rdf:Description rdf:about="&a;300637940">
	<b:glossaryEntry>made of cloth spun or woven in the home; "homespun linen"; "homespun garments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300638073"
	 b:glossaryEntry="produced in quantity at a factory"/>
<rdf:Description rdf:about="&a;300638237">
	<b:glossaryEntry>purchased; not homemade; "my boughten clothes"; "store teeth"; "store bread"; "a store-bought dress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300638415"
	 b:glossaryEntry="produced in a large-scale industrial operation"/>
<rdf:Description rdf:about="&a;300638520"
	 b:glossaryEntry="produced in quantity often by assembly-line techniques"/>
<rdf:Description rdf:about="&a;300638634"
	 b:glossaryEntry='commercially produced; not homemade; "ready-made clothes"'/>
<rdf:Description rdf:about="&a;300638748"
	 b:glossaryEntry="recurring in cycles"/>
<rdf:Description rdf:about="&a;300638939">
	<b:glossaryEntry>occurring by turns; first one and then the other; "alternating feelings of love and hate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300639104">
	<b:glossaryEntry>every second one of a series; "the cleaning lady comes on alternate Wednesdays"; "jam every other day"- the White Queen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300639299"
	 b:glossaryEntry="(biology) exhibiting 24-hour periodicity"/>
<rdf:Description rdf:about="&a;300639395"
	 b:glossaryEntry="marked by or moving in a cycle"/>
<rdf:Description rdf:about="&a;300639480">
	<b:glossaryEntry>having a daily cycle or occurring every day; "diurnal rhythms"; "diurnal rotation of the heavens"; "the diurnal slumber of bats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300639662"
	 b:glossaryEntry="not cyclic"/>
<rdf:Description rdf:about="&a;300639761"
	 b:glossaryEntry="chemistry; having atoms arranged in a ring structure"/>
<rdf:Description rdf:about="&a;300639938"
	 b:glossaryEntry="having molecules consisting of two fused rings"/>
<rdf:Description rdf:about="&a;300640039">
	<b:glossaryEntry>having atoms linked by bonds represented in circular or triangular form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300640183">
	<b:glossaryEntry>containing a closed ring of atoms of which at least one is not a carbon atom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300640318">
	<b:glossaryEntry>containing a closed ring of atoms of the same kind especially carbon atoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300640461"
	 b:glossaryEntry="chemistry; not cyclic; having an open chain structure"/>
<rdf:Description rdf:about="&a;300640599"
	 b:glossaryEntry="having carbon atoms linked in open chains"/>
<rdf:Description rdf:about="&a;300640696">
	<b:glossaryEntry>botany; forming a whorl or having parts arranged in a whorl; "cyclic petals"; "cyclic flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300640861">
	<b:glossaryEntry>forming one or more whorls (especially a whorl of leaves around a stem)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300641017">
	<b:glossaryEntry>botany; not cyclic; especially having parts arranged in spirals rather than whorls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300641153">
	<b:glossaryEntry>(botany) completing its life cycle within a year; "a border of annual flowering plants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300641322">
	<b:glossaryEntry>(botany) having a life cycle lasting two seasons; "a biennial life cycle"; "parsnips and carrots are biennial plants often grown as annuals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300641546">
	<b:glossaryEntry>(botany) lasting three seasons or more; "the common buttercup is a popular perennial plant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300641711">
	<b:glossaryEntry>(biology) belonging to or active during the day; "diurnal animals are active during the day"; "diurnal flowers are open during the day and closed at night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300641938">
	<b:glossaryEntry>(biology) belonging to or active during the night; "nocturnal animals are active at night"; "nocturnal plants have flowers that open at night and close by day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300642171">
	<b:glossaryEntry>happening during or appropriate to the day; "a daytime job"; "daytime television"; "daytime clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300642343">
	<b:glossaryEntry xml:space='preserve'><![CDATA[happening during or appropriate to the night; "nighttime attire"; "the cat''s nighttime prowls"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300642547">
	<b:glossaryEntry>happening every night; "nightly television now goes on until 3:00 or 4:00 a.m."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300642680">
	<b:glossaryEntry>of or during or relating to the night; "a nocturnal journey"; "nocturnal stillness"; "nocturnal predators"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300642842">
	<b:glossaryEntry xml:space='preserve'><![CDATA[harmed or injured or spoiled; "I wont''t buy damaged goods"; "the storm left a wake of badly damaged buildings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300643420">
	<b:glossaryEntry>damaged by blows or hard usage; "a battered old car"; "the beaten-up old Ford"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300643575">
	<b:glossaryEntry>in deplorable condition; "a street of bedraggled tenements"; "a broken-down fence"; "a ramshackle old pier"; "a tumble-down shack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300643827">
	<b:glossaryEntry>of metal e.g.; "bent nails"; "a car with a crumpled front end"; "dented fenders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300643978">
	<b:glossaryEntry>shattered or torn up or torn apart violently as by e.g. wind or lightning or explosive; "an old blasted apple tree"; "a tree rent by lightning"; "cities torn by bombs"; "earthquake-torn streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300644249">
	<b:glossaryEntry xml:space='preserve'><![CDATA[out of working order; "a broken washing machine"; "the coke machine is broken"; (`busted'' is an informal substitute for `broken'' as in "the coke machine is busted")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300644475">
	<b:glossaryEntry>having the spine damaged; "a broken-backed book"; "a broken-backed old horse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300644612">
	<b:glossaryEntry xml:space='preserve'><![CDATA[suddenly and violently broken open especially from internal pressure; "a burst balloon"; "burst pipes"; "burst seams"; "a ruptured appendix"; (`busted'' is an informal term for `burst'' as in "a busted balloon")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300644893"
	 b:glossaryEntry="of a ceramic surface; covered with a network of fine cracks"/>
<rdf:Description rdf:about="&a;300645026"
	 b:glossaryEntry="having the surface damaged or disfigured"/>
<rdf:Description rdf:about="&a;300645129"
	 b:glossaryEntry="used of inanimate objects or their value"/>
<rdf:Description rdf:about="&a;300645231">
	<b:glossaryEntry>(informal) "the gym has some of the most knocked-out equipment since Vic Tanny"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300645371"
	 b:glossaryEntry='(of compositions e.g.) "a mutilated text"'/>
<rdf:Description rdf:about="&a;300645478">
	<b:glossaryEntry>having the paint loose and peeling away; "a dilapidated house with peeling paint"; "peeling row houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300645635">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `with'') damaged throughout by numerous perforations or holes; "a sweater riddled with moth holes"; "cliffs riddled with caves"; "the bullet-riddled target"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300645863">
	<b:glossaryEntry>damaged or discolored by superficial burning:"the scorched blouse tore easily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300645996"
	 b:glossaryEntry="having surface damage"/>
<rdf:Description rdf:about="&a;300646083"
	 b:glossaryEntry="damaged by storm"/>
<rdf:Description rdf:about="&a;300646158">
	<b:glossaryEntry>crushed or broken by being stepped upon heavily; "her trampled flowers lay crushed and broken"; "the grass was trodden and muddy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300646352"
	 b:glossaryEntry="not harmed or spoiled; sound"/>
<rdf:Description rdf:about="&a;300646544">
	<b:glossaryEntry>undamaged in any way; whole; "the vase remained intact despite rough handling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300646675">
	<b:glossaryEntry>without a mar or blemish; "fragile tracery that must be preserved unmutilated and distinct"- B.N.Cardozo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300646848">
	<b:glossaryEntry>that can be given a date; "a concrete and datable happening"- C.W.Shumaker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300647005"
	 b:glossaryEntry='bearing a date; "dated and stamped documents"'/>
<rdf:Description rdf:about="&a;300647102"
	 b:glossaryEntry="not capable of being given a date"/>
<rdf:Description rdf:about="&a;300647227"
	 b:glossaryEntry='not bearing a date; "a dateless letter"'/>
<rdf:Description rdf:about="&a;300647331">
	<b:glossaryEntry>of such great duration as to preclude the possibility of being assigned a date; "dateless customs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300647484"
	 b:glossaryEntry="lacking or deprive of the sense of hearing wholly or in part"/>
<rdf:Description rdf:about="&a;300647703"
	 b:glossaryEntry="lacking the sense of hearing and the ability to speak"/>
<rdf:Description rdf:about="&a;300647828"
	 b:glossaryEntry="caused to hear poorly or not at all"/>
<rdf:Description rdf:about="&a;300647918"
	 b:glossaryEntry="having a hearing loss"/>
<rdf:Description rdf:about="&a;300648020"
	 b:glossaryEntry="unwilling to hear"/>
<rdf:Description rdf:about="&a;300648137"
	 b:glossaryEntry="totally deaf; unable to hear anything"/>
<rdf:Description rdf:about="&a;300648278"
	 b:glossaryEntry="unable to appreciate music"/>
<rdf:Description rdf:about="&a;300648360"
	 b:glossaryEntry="able to perceive sound"/>
<rdf:Description rdf:about="&a;300648457"
	 b:glossaryEntry="having keen hearing"/>
<rdf:Description rdf:about="&a;300648548">
	<b:glossaryEntry>conforming to conventions of sexual behavior; "speech in this circle, if not always decent, never became lewd"- George Santayana</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300648783">
	<b:glossaryEntry>offensive to good taste especially in sexual matters; "an earthy but not indecent story"; "an indecent gesture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300649057">
	<b:glossaryEntry>conspicuously and tastelessly indecent; "coarse language"; "a crude joke"; "crude behavior"; "an earthy sense of humor"; "a revoltingly gross expletive"; "a vulgar gesture"; "full of language so vulgar it should have been edited"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300649373"
	 b:glossaryEntry='verging on the indecent; "an indelicate proposition"'/>
<rdf:Description rdf:about="&a;300649482">
	<b:glossaryEntry>designed to incite to indecency or lust; "the dance often becomes flagrantly obscene"- Margaret Mead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300649636">
	<b:glossaryEntry>determining or having the power to determine an outcome; "cast the decisive vote"; "two factors had a decisive influence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300649920"
	 b:glossaryEntry='final and deciding; "the conclusive reason"'/>
<rdf:Description rdf:about="&a;300650020">
	<b:glossaryEntry>having the power or quality of deciding; "the crucial experiment"; "cast the deciding vote"; "the determinative (or determinant) battle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300650271">
	<b:glossaryEntry>having momentous consequences; of decisive importance; "that fateful meeting of the U.N. when...it declared war on North Korea"- Saturday Rev; "the fatal day of the election finally arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300650523">
	<b:glossaryEntry>putting an end to all debate or action; "a peremptory decree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300650641">
	<b:glossaryEntry>not definitely settling something; "a long and indecisive war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300650814">
	<b:glossaryEntry>leading to no final results or outcome; "an inconclusive experiment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300650941">
	<b:glossaryEntry>characterized by decision and firmness; "an able an decisive young woman"; "we needed decisive leadership"; "she gave him a decisive answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300651172">
	<b:glossaryEntry>characterized by quickness and firmness; "his reply was unhesitating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300651311">
	<b:glossaryEntry>characterized by lack of decision and firmness; "an indecisive manager brought the enterprise to a standstill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300651550">
	<b:glossaryEntry>characterized by indecision; "some who had been on the fence came out in favor of the plan"; "too many voters still declare they are undecided"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300651767">
	<b:glossaryEntry>lacking decisiveness of character; unable to act or decide quickly or firmly; "stood irresolute waiting for some inspiration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300651973"
	 b:glossaryEntry="undecided or characterized by indecisiveness"/>
<rdf:Description rdf:about="&a;300652074"
	 b:glossaryEntry="relating to the use of or having the nature of a declaration"/>
<rdf:Description rdf:about="&a;300652239">
	<b:glossaryEntry>relating to the use of or having the nature of an interrogation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300652408">
	<b:glossaryEntry>made known or openly avowed; "their declared and their covert objectives"; "a declared liberal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300652648">
	<b:glossaryEntry>declared but not proved; "alleged abuses of housing benefits"- Wall Street Journal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300652784">
	<b:glossaryEntry xml:space='preserve'><![CDATA[declared publicly; made widely known; "their announced intentions"; "the newspaper''s proclaimed adherence to the government''s policy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300652986">
	<b:glossaryEntry>confidently declared to be so; "the asserted value of the painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300653108">
	<b:glossaryEntry>openly declared as such; "an avowed enemy"; "her professed love of everything about that country"; "McKinley was assassinated by a professed anarchist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300653330"
	 b:glossaryEntry='claimed with intent to deceive; "his professed intentions"'/>
<rdf:Description rdf:about="&a;300653447">
	<b:glossaryEntry>not announced or openly acknowledged; "fighting an undeclared war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300653606"
	 b:glossaryEntry='not openly acknowledged; "an unacknowledged emergency"'/>
<rdf:Description rdf:about="&a;300653721"
	 b:glossaryEntry="not affirmed or mentioned or declared"/>
<rdf:Description rdf:about="&a;300653813">
	<b:glossaryEntry>characterized by propriety and dignity and good taste in manners and conduct; "the tete-a-tete was decorous in the extreme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300654045"
	 b:glossaryEntry="satisfying generally accepted social or esthetic standards"/>
<rdf:Description rdf:about="&a;300654166"
	 b:glossaryEntry="characterized by dignity and propriety"/>
<rdf:Description rdf:about="&a;300654265">
	<b:glossaryEntry>lacking propriety and good taste in manners and conduct; "indecorous behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300654449"
	 b:glossaryEntry="acceptable as a deduction (especially as a tax deduction)"/>
<rdf:Description rdf:about="&a;300654581"
	 b:glossaryEntry="deductible according to the tax laws"/>
<rdf:Description rdf:about="&a;300654673"
	 b:glossaryEntry="not allowable as a deduction"/>
<rdf:Description rdf:about="&a;300654761">
	<b:glossaryEntry>having great spatial extension or penetration; downward ("a deep well"; "a deep dive"; "deep water"; "a deep casserole"); or inward from an outer surface ("a deep gash"; "deep massage"; "deep pressure receptors in muscles"); or backward ("deep shelves"; "a deep closet"); or laterally ("surrounded by a deep yard"); or outward from a center ((sports) "hit the ball to deep center field"); sometimes used in combination; "waist-deep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300655388">
	<b:glossaryEntry>so deep as to be unmeasurable; unfathomable; "the abyssal depths of the ocean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300655530"
	 b:glossaryEntry='extremely deep; "a bottomless pit"; "a bottomless lake"'/>
<rdf:Description rdf:about="&a;300655642">
	<b:glossaryEntry>of or carried on in waters of great depth; "a deep-water port"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300655761"
	 b:glossaryEntry='having a specified depth; six feet in depth (or deep)"'/>
<rdf:Description rdf:about="&a;300655873">
	<b:glossaryEntry>situated at or extending to great depth; too deep to have been sounded or plumbed; "the profound depths of the sea"; "the dark unfathomed caves of ocean"-Thomas Gray; "unplumbed depths of the sea"; "remote and unsounded caverns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300656193">
	<b:glossaryEntry>(of e.g. closets or refrigerators) extending very far enough back to allow a person to enter; "a deep walk-in refrigerator"; "walk-in closets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300656392">
	<b:glossaryEntry>lacking physical depth; having little spatial extension; downward ("shallow water"; "a shallow dish"); or inward from an outer surface ("a shallow cut"); or backward ("a shallow closet"; "established a shallow beachhead"); or outward from a center ((sports) "hit the ball to shallow left field")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300656813"
	 b:glossaryEntry="coming only to the ankle or knee"/>
<rdf:Description rdf:about="&a;300656914">
	<b:glossaryEntry>shallow enough to be crossed by walking or riding on an animal or in a vehicle; "the stream was fordable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300657074">
	<b:glossaryEntry>full of submerged reefs or sandbanks or shoals; "reefy shallows"; "shoaly waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300657242">
	<b:glossaryEntry>relatively deep or strong; affecting one deeply; "a deep breath"; "a deep sigh"; "deep concentration"; "deep emotion"; "a deep trance"; "in a deep sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300657500">
	<b:glossaryEntry>(of sleep) deep and complete; "a heavy sleep"; "fell into a profound sleep"; "a sound sleeper"; "deep wakeless sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300657699"
	 b:glossaryEntry='coming from deep within one; "a profound sigh"'/>
<rdf:Description rdf:about="&a;300657800">
	<b:glossaryEntry>not deep or strong; not affecting one deeply; "shallow breathing"; "a night of shallow fretful sleep"; "in a shallow trance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300658032">
	<b:glossaryEntry>(of sleep) easily disturbed; "in a light doze"; "a light sleeper"; "a restless wakeful night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300658187">
	<b:glossaryEntry>involving a surface only; "her beauty is only skin-deep"; "superficial bruising"; "a surface wound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300658369">
	<b:glossaryEntry>existing in fact whether with lawful authority or not; "de facto segregation is as real as segration imposed by law"; "a de facto state of war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300658586">
	<b:glossaryEntry>by right; according to law; "de jure recognition of the new government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300658711">
	<b:glossaryEntry>capable of being annulled or voided or terminated; "a claim to an estate may be defeasible so long as the claimant is under 21 and unmarried"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300658909">
	<b:glossaryEntry>not liable to being annulled or voided or undone; "an indefeasible right to freedom"; "an indefeasible claim to the title"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300659108"
	 b:glossaryEntry='not subject to forfeiture; "an unforfeitable right"'/>
<rdf:Description rdf:about="&a;300659233"
	 b:glossaryEntry='beaten or overcome; not victorious; "the defeated enemy"'/>
<rdf:Description rdf:about="&a;300659470"
	 b:glossaryEntry="used especially of feelings of defeat and discouragement"/>
<rdf:Description rdf:about="&a;300659616"
	 b:glossaryEntry="decisively defeated in combat"/>
<rdf:Description rdf:about="&a;300659770"
	 b:glossaryEntry="defeated in a competition"/>
<rdf:Description rdf:about="&a;300659858"
	 b:glossaryEntry="humiliated in defeat"/>
<rdf:Description rdf:about="&a;300659932">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) having been got the better of; "I''m pretty beat up but I don''t feel licked yet"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300660075"
	 b:glossaryEntry='reduced to submission; "subjugated peoples"'/>
<rdf:Description rdf:about="&a;300660175"
	 b:glossaryEntry='victorious; "undefeated in battle"; "an undefeated team"'/>
<rdf:Description rdf:about="&a;300660378"
	 b:glossaryEntry="overcoming the opposition"/>
<rdf:Description rdf:about="&a;300660463"
	 b:glossaryEntry="experiencing triumph"/>
<rdf:Description rdf:about="&a;300660553"
	 b:glossaryEntry="not conquered"/>
<rdf:Description rdf:about="&a;300660650"
	 b:glossaryEntry="not forced to bow down to a conqueror"/>
<rdf:Description rdf:about="&a;300660741"
	 b:glossaryEntry="overpowered and subjugated as by military force"/>
<rdf:Description rdf:about="&a;300660842">
	<b:glossaryEntry>not conquered; "despite facing overpowering odds the partisan froces remained unsubdued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300660986">
	<b:glossaryEntry>boldly resisting authority or an opposing force; "brought up to be aggressive and defiant"; "a defiant attitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300661296"
	 b:glossaryEntry="disposed to or engaged in defiance of established authority"/>
<rdf:Description rdf:about="&a;300661439"
	 b:glossaryEntry='noisily and stubbornly defiant; "obstreperous boys"'/>
<rdf:Description rdf:about="&a;300661549">
	<b:glossaryEntry>marked by stubborn resistance to authority; "the University suspended the most recalcitrant demonstraters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300661714">
	<b:glossaryEntry>disposed or willing to comply; "children compliant with the parental will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300661988">
	<b:glossaryEntry>disposed or willing to comply; "someone amenable to persuasion"; "the spirit indeed is willing but the flesh is weak"- Matthew 26:41</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300662185"
	 b:glossaryEntry="happy to comply"/>
<rdf:Description rdf:about="&a;300662278"
	 b:glossaryEntry="like a lamb in meekness and gentleness"/>
<rdf:Description rdf:about="&a;300662371"
	 b:glossaryEntry="offering no resistance"/>
<rdf:Description rdf:about="&a;300662452">
	<b:glossaryEntry>clearly characterized or delimited; "lost in a maze of words both defined and undefined"; "each child has clearly defined duties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300662689"
	 b:glossaryEntry="of the meaning of words or concepts; stated precisely"/>
<rdf:Description rdf:about="&a;300662802">
	<b:glossaryEntry>showing or determining a boundary; "it is impossible to specify a clearly circumscribed (or delimited) area for any particular science"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300663009">
	<b:glossaryEntry>not precisely limited, determined, or distinguished; "an undefined term"; "undefined authority"; "some undefined sense of excitement"; "vague feelings of sadness"; "a vague uneasiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300663293">
	<b:glossaryEntry>not capable of being precisely or readily described; not easily put into words; "an indefinable feeling of terror"; "an abstract concept that seems indefinable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300663525">
	<b:glossaryEntry>accurately stated or described; "a set of well-defined values"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300663654">
	<b:glossaryEntry>poorly stated or described; "he confuses the reader with ill-defined terms and concepts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300663810">
	<b:glossaryEntry>formed or developed from something else; not original; "the belief that classes and organizations are secondary and derived"- John Dewey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300664072">
	<b:glossaryEntry>derived by copying something else; especially by following lines seen through a transparent sheet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300664231"
	 b:glossaryEntry="capable of being derived"/>
<rdf:Description rdf:about="&a;300664311">
	<b:glossaryEntry>resulting from or employing derivation; "a derivative process"; "a highly derivative prose style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300664465">
	<b:glossaryEntry>copied and passed off as your own; "used plagiarized data in his thesis"; "a work dotted with plagiarized phrases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300664652"
	 b:glossaryEntry="not derived; primary or simple"/>
<rdf:Description rdf:about="&a;300664801">
	<b:glossaryEntry>not derived or copied or translated from something else; "the play is original; not an adaptation"; "he kept the original copy and gave her only a xerox"; "the translation misses much of the subtlety of the original French"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300665079">
	<b:glossaryEntry>not derived from or reducible to something else; basic; "a primary instinct"; "seeks excellence at its primitive source--nature"- John Dewey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300665285">
	<b:glossaryEntry>(mathematics) being an algebraic or geometric expression from which another expression is derived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300665438">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(linguistics) serving as the basis for derived or inflected forms; "`pick'' is the primitive word from which `picket'' is derived"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300665640">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not inflected; "`swim'' and `boy'' are uninflected forms"; "is any language completely uninflected?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300665796">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(linguistics) formed by inflection or derivation; "from the primitive word `electric'' comes the derivative word `electricity''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300665997">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) showing alteration in form especially by addition of affixes; "`swam'' and `boys'' are inflected words"; "German is an inflected language"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300666199">
	<b:glossaryEntry>(of the voice) altered in tone or pitch; "his southern Yorkshire voice was less inflected and singing than her northern one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300666397"
	 b:glossaryEntry="altered in volume as well as tone or pitch"/>
<rdf:Description rdf:about="&a;300666495">
	<b:glossaryEntry>(of the voice) not inflected; "uninflected words"; "a monotonic uninflected voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300666635">
	<b:glossaryEntry>precise; explicit and clearly defined; "I want a definite answer"; "a definite statement of the terms of the will"; "a definite amount"; "definite restrictions on the sale of alcohol"; "the wedding date is now definite"; "a definite drop in attendance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300667086">
	<b:glossaryEntry>definite but not specified or identified; "set aside a certain sum each week"; "to a certain degree"; "certain breeds do not make good pets"; "certain members have not paid their dues"; "a certain popular teacher"; "a certain Mrs. Jones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300667380"
	 b:glossaryEntry='unmistakable; "had a decisive lead in the polls"'/>
<rdf:Description rdf:about="&a;300667483">
	<b:glossaryEntry>clearly defined; "I have no formed opinion about the chances of success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300667628">
	<b:glossaryEntry>recognizable; marked; "noticed a distinct improvement"; "at a distinct (or decided) disadvantage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300667790">
	<b:glossaryEntry>vague or not clearly defined or stated; "must you be so indefinite?"; "amorphous blots of color having vague and indefinite edges"; "he would not answer so indefinite a proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300668151">
	<b:glossaryEntry>showing marked and often playful or irritating evasiveness or reluctance to make a definite or committing statement; "a politician coy about his intentions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300668357">
	<b:glossaryEntry>not clearly defined; "indecisive boundaries running through mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300668484">
	<b:glossaryEntry>lacking definition or definite content; "nebulous reasons"; "unfixed as were her general notions of what men ought to be"- Jane Austen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300668683">
	<b:glossaryEntry>indefinite in time or position; "he will come one day"; "one place or another"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300668814">
	<b:glossaryEntry>(of e.g. fruits and anthers) opening spontaneously at maturity to release seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300668967">
	<b:glossaryEntry>(of e.g. fruits) not opening spontaneously at maturity to release seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300669114">
	<b:glossaryEntry>affected or marked by low spirits; "is dejected but trying to look cheerful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300669371"
	 b:glossaryEntry="(archaic) utterly cast down"/>
<rdf:Description rdf:about="&a;300669450">
	<b:glossaryEntry>brought low in spirit; "left us fatigued and deflated spiritually"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300669611">
	<b:glossaryEntry>low in spirits; "lonely and blue in a strange city"; "depressed by the loss of his job"; "a dispirited and resigned expression on her face"; "downcast after his defeat"; "feeling discouraged and downhearted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300669950"
	 b:glossaryEntry='reflecting gloom; "gloomy faces"'/>
<rdf:Description rdf:about="&a;300670055">
	<b:glossaryEntry>marked by dejection from being alone; "felt sad and lonely"; "the loneliest night of the week"; "lonesome when her husband is away"; "spent a lonesome hour in the bar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300670286">
	<b:glossaryEntry>exultantly proud and joyful; in high spirits; "the elated winner"; "felt elated and excited"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300670575">
	<b:glossaryEntry>joyful and proud especially because of triumph or success; "rejoicing crowds filled the streets on VJ Day"; "a triumphal success"; "a triumphant shout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300670851">
	<b:glossaryEntry>made joyful; "the sun and the wind on his back made him feel exhilarated--happy to be alive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300671013"
	 b:glossaryEntry="excited as if by alcohol or drugs"/>
<rdf:Description rdf:about="&a;300671115">
	<b:glossaryEntry>(archaic) lifted up or set high; "their hearts were jocund and sublime"- Milton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300671248"
	 b:glossaryEntry="(archaic) exalted emotionally especially with pride"/>
<rdf:Description rdf:about="&a;300671354">
	<b:glossaryEntry>exquisitely fine and subtle and pleasing; susceptible to injury; "a delicate violin passage"; "delicate china"; "a delicate flavor"; "the delicate wing of a butterfly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300671810">
	<b:glossaryEntry>of delicate composition and artistry; "a dainty teacup"; "an exquisite cameo"; "fine china and crystal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300671985">
	<b:glossaryEntry>characterized by unusual lightness and delicacy; "this smallest and most ethereal of birds"; "gossamer shading through his playing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300672182"
	 b:glossaryEntry='vulnerably delicate; "she has the fragile beauty of youth"'/>
<rdf:Description rdf:about="&a;300672294">
	<b:glossaryEntry>(of plants) requiring protection from frost; "half-hardy annuals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300672416">
	<b:glossaryEntry>having a metaphorically delicate touch; "the translation is...light-handed...and generally unobtrusive"- New Yorker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300672590"
	 b:glossaryEntry='extremely delicate; "an overdelicate digestive system"'/>
<rdf:Description rdf:about="&a;300672703">
	<b:glossaryEntry>lacking in body or vigor; "faded pastel charms of the naive music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300672822"
	 b:glossaryEntry='faint and difficult to analyze; "subtle aromas"'/>
<rdf:Description rdf:about="&a;300672922">
	<b:glossaryEntry>(of plants) not hardy; easily killed by adverse growing condition; "tender green shoots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300673063">
	<b:glossaryEntry>sturdy and strong in constitution or construction; enduring; "a rugged trapper who spent months in the winderness"; "those that survive are stalwart rugged men"; "with a house full of boys you have to have rugged furniture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300673483">
	<b:glossaryEntry>able to survive under unfavorable conditions; "strawberries are hardy and easy to grow"; "camels are tough and hardy creatures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300673662">
	<b:glossaryEntry>suitable for rough use; "a knockabout overcoat"; "a knockabout old car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300673790">
	<b:glossaryEntry>substantially made or constructed; "sturdy steel shelves"; "sturdy canvas"; "a tough all-weather fabric"; "some plastics are as tough as metal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300673994">
	<b:glossaryEntry>capable of being broken or damaged; "earthenware pottery is breakable"; "breakable articles should be packed carefully"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300674295">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having little elasticity; hence easily cracked or fractured or snapped; "brittle bones"; "glass is brittle"; "`brickle'' and `brickly'' are dialectal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300674517">
	<b:glossaryEntry>apt to break into small fragments or disintegrate; "crumbly cookies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300674639">
	<b:glossaryEntry>easily broken into small fragments or reduced to powder; "friable sandstone"; "friable carcinomatous tissue"; "friable curds formed in the stomach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300674840">
	<b:glossaryEntry>easily broken or damaged or destroyed; "a kite too delicate to fly safely"; "fragile porcelain plates"; "fragile old bones"; "a frail craft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300675053">
	<b:glossaryEntry>capable of being broken; "the museum stored all frangible articles in locked showcases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300675196"
	 b:glossaryEntry="subject to breaking into sharp slender pieces"/>
<rdf:Description rdf:about="&a;300675297">
	<b:glossaryEntry>impossible to break especially under ordinary usage; "unbreakable plastic dinnerwear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300675494">
	<b:glossaryEntry>difficult or impossible to break or separate into parts; "an infrangible series"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300675632">
	<b:glossaryEntry>resistant to shattering or splintering; "shatterproof automobile windows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300675795">
	<b:glossaryEntry>requiring more than usually expected or thought due; especially great patience and effort and skill; "found the job very demanding"; "a baby can be so demanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300676120">
	<b:glossaryEntry>requiring precise accuracy; "an exacting job"; "became more exigent over his pronunciation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300676276">
	<b:glossaryEntry>of persons; "his father was a hard-to-please taskmaster"; "was very hard to please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300676443">
	<b:glossaryEntry>demanding strict attention to rules and procedures; "rigorous discipline"; "tight security"; "stringent safety measures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300676638">
	<b:glossaryEntry>severe and unremitting in making demands; "an exacting instructor"; "a stern disciplinarian"; "strict standards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300676822">
	<b:glossaryEntry>made tighter or more stringent; "endured tightened economic controls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300676947">
	<b:glossaryEntry>not demanding; requiring little if any patience or effort or skill; "the pay was adequate and the job undemanding"; "simple undemanding affection"; "an undemanding boss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300677264">
	<b:glossaryEntry>not strict; "an easy teacher"; "easy standards"; "lenient rules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300677389"
	 b:glossaryEntry='not stressful; "an easygoing life as a parttime consultant"'/>
<rdf:Description rdf:about="&a;300677504">
	<b:glossaryEntry>demanding little effort; not burdensome; "light housework"; "light exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300677632"
	 b:glossaryEntry='not rigorous; "relaxed and unexacting standards"'/>
<rdf:Description rdf:about="&a;300677737">
	<b:glossaryEntry>requiring attention or action; "as nuclear weapons proliferate, preventing war becomes imperative"; "requests that grew more and more imperative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300678047"
	 b:glossaryEntry="containing a solemn charge or command"/>
<rdf:Description rdf:about="&a;300678141">
	<b:glossaryEntry>demanding attention; "clamant needs"; "a crying need"; "regarded literary questions as exigent and momentous"- H.L.Mencken; "insistent hunger"; "an instant need"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300678397">
	<b:glossaryEntry>not allowing contradiction or refusal; "spoke in commanding (or peremptory) tones"; "peremptory commands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300678572">
	<b:glossaryEntry>showing extreme urgency or intensity especially because of great need or desire; "felt a desperate urge to confess"; "a desperate need for recognition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300678779">
	<b:glossaryEntry xml:space='preserve'><![CDATA[compelling immediate action; "too pressing to permit of longer delay"; "the urgent words `Hurry! Hurry!''"; "bridges in urgent need of repair"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300678984"
	 b:glossaryEntry="begging"/>
<rdf:Description rdf:about="&a;300679156"
	 b:glossaryEntry='earnestly or solemnly entreating; "in adjuratory terms"'/>
<rdf:Description rdf:about="&a;300679268">
	<b:glossaryEntry>expressing earnest entreaty; "the appealing and frightened look worn by an injured dog"; "she holds out her hand for money, importunate, insistent"; "a pleading note in her voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300679540"
	 b:glossaryEntry='practicing beggary; "mendicant friars"'/>
<rdf:Description rdf:about="&a;300679634">
	<b:glossaryEntry>of the nature of or expressing a petition; "the petitionary procedure had a quality of indecisiveness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300679794"
	 b:glossaryEntry='expressing entreaty or supplication; "precatory overtures"'/>
<rdf:Description rdf:about="&a;300679920"
	 b:glossaryEntry='humbly entreating; "a suppliant sinner seeking forgiveness"'/>
<rdf:Description rdf:about="&a;300680063">
	<b:glossaryEntry>characterized by or advocating or based upon the principles of democracy or social equality; "democratic government"; "a democratic country"; "a democratic scorn for bloated dukes and lords"- George du Maurier</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300680509"
	 b:glossaryEntry="opposed to authoritarianism"/>
<rdf:Description rdf:about="&a;300680600"
	 b:glossaryEntry='favoring social equality; "a classless society"'/>
<rdf:Description rdf:about="&a;300680717">
	<b:glossaryEntry>effected directly by action of the voters rather than through elected representatives; "many people favor direct election of the President rather than election by the Electoral College"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300680955">
	<b:glossaryEntry>having the supreme legislative power resting with a body of cabinet ministers chosen from and responsible to the legislature or parliament; "parliamentary government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300681181">
	<b:glossaryEntry>in accord with rules and customs of a legislative or deliberative assembly; "parliamentary law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300681336">
	<b:glossaryEntry>affording the opportunity for individual participation; "participatory democracy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300681477">
	<b:glossaryEntry>carried on by or for the people (or citizens) at large; "the popular vote"; "popular representation"; "institutions of popular government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300681669">
	<b:glossaryEntry>being or characteristic of government by representation in which citizens exercise power through elected officers and representatives; "representative government as defined by Abraham Lincoln is government of the people, by the people, for the people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300681981">
	<b:glossaryEntry>having the supreme power lying in the body of citizens entitled to vote for officers and representatives responsible to them or characteristic of such government; "the United States shall guarantee to every state in this union a republican form of government"- United States Constitution; "a very republican notion"; "so little republican and so much aristocratic sentiment"- Philip Marsh; "our republican and artistic simplicity"-Nathaniel Hawthorne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300682488">
	<b:glossaryEntry>not in agreement with or according to democratic doctrine or practice or ideals; "the union broke with its past undemocratic procedures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300682755">
	<b:glossaryEntry>characteristic of an absolute ruler or absolute rule; having absolute sovereignty; "an authoritarian regime"; "autocratic government"; "despotic rulers"; "a dictatorial rule that lasted for the duration of the war"; "a tyrannical government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300683107">
	<b:glossaryEntry>ruled by or characteristic of a despot; "moved from a feudal to a despotic order"; "his administration was arrogant and despotic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300683291">
	<b:glossaryEntry>ruled by or having the supreme power resting with a monarch; "monarchal government"; "monarchical systems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300683479">
	<b:glossaryEntry>characterized by a government in which the political authority exercises absolute and centralized control; "a totalitarian regime crushes all autonomous institutions in its drive to seize the human soul"- Arthur M.Schlesinger, Jr.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300683768">
	<b:glossaryEntry>based on or subject to individual discretion or preference or sometimes impulse or caprice; "an arbitrary decision"; "the arbitrary rule of a dictator";"an arbitrary penalty"; "of arbitrary size and shape"; "an arbitrary choice"; "arbitrary division of the group into halves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300684153"
	 b:glossaryEntry='not limited by law; "an absolute monarch"'/>
<rdf:Description rdf:about="&a;300684249">
	<b:glossaryEntry>determined by chance or impulse or whim rather than by necessity or reason; "a capricious refusal"; "authoritarian rulers are frequently capricious"; "the victim of whimsical persecutions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300684518">
	<b:glossaryEntry>having or using the ability to act or decide according to your own discretion or judgment; "The commission has discretionary power to award extra funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300684745"
	 b:glossaryEntry="not subject to individual determination"/>
<rdf:Description rdf:about="&a;300684875"
	 b:glossaryEntry="set down as a rule or guide"/>
<rdf:Description rdf:about="&a;300684959">
	<b:glossaryEntry>given to or marked by the open expression of emotion; "an affectionate and demonstrative family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300685151">
	<b:glossaryEntry>extravagantly demonstrative; "insincere and effusive demonstrations of sentimental friendship"; "a large gushing female"; "write unrestrained and gushy poetry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300685398"
	 b:glossaryEntry="not given to open expression of emotion"/>
<rdf:Description rdf:about="&a;300685535"
	 b:glossaryEntry="cool and formal in manner"/>
<rdf:Description rdf:about="&a;300685653"
	 b:glossaryEntry="capable of being denied or contradicted"/>
<rdf:Description rdf:about="&a;300685783"
	 b:glossaryEntry="possible to disavow"/>
<rdf:Description rdf:about="&a;300685860"
	 b:glossaryEntry="able to be refuted"/>
<rdf:Description rdf:about="&a;300685949"
	 b:glossaryEntry="not possible to deny"/>
<rdf:Description rdf:about="&a;300686080">
	<b:glossaryEntry>not open to question; obviously true; "undeniable guilt"; "indisputable evidence of a witness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300686264">
	<b:glossaryEntry xml:space='preserve'><![CDATA[impossible to deny or disprove; "incontrovertible proof of the defendant''s innocence"; "proof positive"; "an irrefutable argument"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300686482">
	<b:glossaryEntry>having the power of explicitly denoting or designating or naming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300686722">
	<b:glossaryEntry>inclined to or serving for the giving of names; "the appellative faculty of children"; "the appellative function of some primitive rites"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300686929"
	 b:glossaryEntry="serving to designate"/>
<rdf:Description rdf:about="&a;300687007">
	<b:glossaryEntry>(logic) used of the class of entities to which a given word correctly applies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300687142">
	<b:glossaryEntry>designated by or expressed in numbers; "numerical symbols"; "a very simple numeric code"; "numerical equations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300687319">
	<b:glossaryEntry>referring or pointing to something; "symbols are inherently referential"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300687449">
	<b:glossaryEntry>having the power of implying or suggesting something in addition to what is explicit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300687681"
	 b:glossaryEntry="of or relating to a connotation"/>
<rdf:Description rdf:about="&a;300687792">
	<b:glossaryEntry>tending to suggest or imply; "artifacts suggestive of an ancient society"; "an implicative statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300687999"
	 b:glossaryEntry="derived or capable of being derived by inference"/>
<rdf:Description rdf:about="&a;300688105">
	<b:glossaryEntry>(logic) used of the set of attributes that distinguish the referents of a given word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300688247">
	<b:glossaryEntry>worthy of reliance or trust; "a reliable source of information"; "a dependable worker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300688545">
	<b:glossaryEntry>capable of being depended on; "a quick and certain remedy"; "a sure way to distinguish the two"; "wood dust is a sure sign of termites"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300688741">
	<b:glossaryEntry>consistently reliable or dependable; "a faithful old car that always gets us home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300688878">
	<b:glossaryEntry>reliable in matters of fact; "he was always straight with me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300688994"
	 b:glossaryEntry="tested and proved to be reliable"/>
<rdf:Description rdf:about="&a;300689118"
	 b:glossaryEntry='reliable as a basis for action; "a true prophesy"'/>
<rdf:Description rdf:about="&a;300689218">
	<b:glossaryEntry>used of values and principles; not subject to change; steady; "undeviating loyalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300689359">
	<b:glossaryEntry>not worthy of reliance or trust; "in the early 1950s computers were large and expensive and unreliable"; "an undependable assistant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300689653">
	<b:glossaryEntry xml:space='preserve'><![CDATA[likely to perform unpredictably; "erratic winds are the bane of a sailor"; "a temperamental motor; sometimes it would start and sometimes it wouldn''t"; "that beautiful but temperamental instrument the flute"- Osbert Lancaster]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300689948">
	<b:glossaryEntry>not consistent or dependable; "an uncertain recollection of events"; "a gun with a rather uncertain trigger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300690112"
	 b:glossaryEntry="of e.g. advice"/>
<rdf:Description rdf:about="&a;300690180"
	 b:glossaryEntry='not independent; "dependent children"'/>
<rdf:Description rdf:about="&a;300690453">
	<b:glossaryEntry>like a baby especially in dependence; "babelike innocence and dependence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300690581"
	 b:glossaryEntry='unable to manage independently; "as helpless as a baby"'/>
<rdf:Description rdf:about="&a;300690691"
	 b:glossaryEntry="mutually dependent"/>
<rdf:Description rdf:about="&a;300690804">
	<b:glossaryEntry>(biology) used or benefited by ants through sharing their nest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300690927">
	<b:glossaryEntry>of plants or persons; having the nature or habits of a parasite or leech; living off another; "a wealthy class parasitic upon the labor of the masses"; "parasitic vines that strangle the trees"; "bloodsucking blackmailer"; "his indolent leechlike existence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300691281">
	<b:glossaryEntry>relying on another for support; "dependent on Middle Eastern oil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300691434">
	<b:glossaryEntry>(biology; used of organisms (especially of different species)) living together but not necessarily in a relationship beneficial to each</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300691625"
	 b:glossaryEntry="dependent by virtue of youth"/>
<rdf:Description rdf:about="&a;300691708">
	<b:glossaryEntry>free from external control and constraint; "an independent mind"; "a series of independent judgments"; "fiercely independent individualism"; "an independent republic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300692238"
	 b:glossaryEntry="of countries; not relying on imports"/>
<rdf:Description rdf:about="&a;300692342">
	<b:glossaryEntry>of persons; free from external control and constraint in e.g. action and judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300692511">
	<b:glossaryEntry>existing as an independent entity; "the partitioning of India created two separate and autonomous jute economies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300692681">
	<b:glossaryEntry>having separated or advocating separation from another entity or policy or attitude; "a breakaway faction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300692856">
	<b:glossaryEntry>(mathematics) of a binary operation; independent of order; as in e.g. "a x b = b x a"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300692999"
	 b:glossaryEntry="(biology) not parasitic on another organism"/>
<rdf:Description rdf:about="&a;300693130">
	<b:glossaryEntry>separate and distinct from others of the same kind; "mark the individual pages"; "on a case-by-case basis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300693323">
	<b:glossaryEntry>responsible for yourself; "now out of college and on their own"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300693515">
	<b:glossaryEntry>able to provide for your own needs without help from others; "a self-sufficing economic unit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300693705">
	<b:glossaryEntry>financially independent; "now that my children are self-supporting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300693834"
	 b:glossaryEntry='without help from others; "a single-handed accomplishment"'/>
<rdf:Description rdf:about="&a;300693952"
	 b:glossaryEntry="marked by vigorous independence of thought and judgment"/>
<rdf:Description rdf:about="&a;300694067"
	 b:glossaryEntry="not affiliated"/>
<rdf:Description rdf:about="&a;300694140">
	<b:glossaryEntry>not contingent; not determined or influenced by someone or something else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300694273">
	<b:glossaryEntry>(grammar) of a clause; able to stand alone syntactically as a complete sentence; "the main (or independent) clause in a complex sentence has at least a subject and a verb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300694512">
	<b:glossaryEntry>(grammar) of a clause; unable to stand alone syntactically as a complete sentence; "a subordinate (or dependent) clause functions as a noun or adjective or adverb within a sentence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300694763"
	 b:glossaryEntry="devoted to a cause or party"/>
<rdf:Description rdf:about="&a;300694946">
	<b:glossaryEntry>used of independent armed resistance forces; "guerrilla warfare"; "partisan forces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300695128"
	 b:glossaryEntry="excessively devoted to one faction"/>
<rdf:Description rdf:about="&a;300695227">
	<b:glossaryEntry>based upon or representing political parties; "party politics"; "party leaders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300695361"
	 b:glossaryEntry="devoted to a political party"/>
<rdf:Description rdf:about="&a;300695450">
	<b:glossaryEntry>having or marked by a strong tendency especially a controversial one; "a tendentious account of recent elections"; "distinguishing between verifiable fact and tendentious assertion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300695703"
	 b:glossaryEntry="free from party affiliation or bias"/>
<rdf:Description rdf:about="&a;300695882"
	 b:glossaryEntry='supported by both sides; "a two-way treaty"'/>
<rdf:Description rdf:about="&a;300696017"
	 b:glossaryEntry="not controlled by a party or interest group"/>
<rdf:Description rdf:about="&a;300696118">
	<b:glossaryEntry>not based upon or representing political parties; "a nonparty regime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300696242"
	 b:glossaryEntry="without bias"/>
<rdf:Description rdf:about="&a;300696321">
	<b:glossaryEntry>brought into agreement or cooperation on the side of a faction, party, or cause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300696490"
	 b:glossaryEntry="joined by treaty or agreement"/>
<rdf:Description rdf:about="&a;300696572"
	 b:glossaryEntry="affiliated with one party or faction"/>
<rdf:Description rdf:about="&a;300696663"
	 b:glossaryEntry="not affiliated with any faction, party, or cause"/>
<rdf:Description rdf:about="&a;300696804">
	<b:glossaryEntry>not supporting or favoring either side in a war, dispute, or contest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300696926"
	 b:glossaryEntry="not affiliated with any one party"/>
<rdf:Description rdf:about="&a;300697017">
	<b:glossaryEntry>(of spatial position) in or brought into line with or into proper relative position; "well-aligned wheels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300697204">
	<b:glossaryEntry>beside one another in a row or rank; "they came down the street two abreast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300697341">
	<b:glossaryEntry>(of spatial position) out of line with or not in proper relative position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300697470">
	<b:glossaryEntry>(grammar) describing the structure of a language; "descriptive linguistics simply describes language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300697629">
	<b:glossaryEntry>(grammar) giving directives or rules; "prescriptive grammar is concerned with norms of or rules for correct usage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300697814">
	<b:glossaryEntry>serving to describe or inform or characterized by description; "the descriptive variable"; "a descriptive passage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300697986"
	 b:glossaryEntry='not successful in describing"'/>
<rdf:Description rdf:about="&a;300698075">
	<b:glossaryEntry>worth having or seeking or achieving; "a desirable job"; "computer with many desirable features"; "a desirable outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300698394">
	<b:glossaryEntry>likely to be of benefit or advantage; "in an advantageous position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300698520"
	 b:glossaryEntry="greatly desired"/>
<rdf:Description rdf:about="&a;300698629"
	 b:glossaryEntry='capable of arousing desire; "the delectable Miss Haynes"'/>
<rdf:Description rdf:about="&a;300698764"
	 b:glossaryEntry='causing envy; "an enviable position"'/>
<rdf:Description rdf:about="&a;300698855"
	 b:glossaryEntry='(informal) "a plummy leading role"'/>
<rdf:Description rdf:about="&a;300698942">
	<b:glossaryEntry xml:space='preserve'><![CDATA[more desirable than another; "coffee is preferable to tea"; "Danny''s preferred name is ''Dan''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300699104">
	<b:glossaryEntry>not desirable; "undesirable impurities in steel"; "legislation excluding undesirable aliens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300699326">
	<b:glossaryEntry>so undesirable as to be incapable of arousing envy; "unenviable notoriety"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300699457">
	<b:glossaryEntry>interfering; "unwanted shadows distort the picture"; "removed the unwanted vegetation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300699598">
	<b:glossaryEntry xml:space='preserve'><![CDATA[spoiled or ruined or demolished; "war left many cities destroyed"; "Alzheimer''s is responsible for her destroyed mind"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300700096"
	 b:glossaryEntry="destroyed completely"/>
<rdf:Description rdf:about="&a;300700204">
	<b:glossaryEntry>made uninhabitable; "upon this blasted heath"- Shakespeare; "a wasted landscape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300700402">
	<b:glossaryEntry>affected by blight--anything that mars or events growth or prosperity; "a blighted rose"; "blighted urtan districts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300700582"
	 b:glossaryEntry="reduced to nothingness"/>
<rdf:Description rdf:about="&a;300700689"
	 b:glossaryEntry='destroyed financially; "the broken fortunes of the family"'/>
<rdf:Description rdf:about="&a;300700830">
	<b:glossaryEntry>destroyed or badly damaged by fire; "a row of burned houses"; "a charred bit of burnt wood"; "barricaded the street with burnt-out cars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300701052"
	 b:glossaryEntry="torn down and broken up"/>
<rdf:Description rdf:about="&a;300701153">
	<b:glossaryEntry>having been robbed and destroyed by force and violence; "the raped countryside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300701326"
	 b:glossaryEntry='(informal) destroyed or killed; "we are gone geese"'/>
<rdf:Description rdf:about="&a;300701456">
	<b:glossaryEntry>(psychology) of a conditioned response; caused to die out because of the absence or withdrawal of reinforcement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300701626"
	 b:glossaryEntry='having fallen in or collapsed; "a fallen building"'/>
<rdf:Description rdf:about="&a;300701729">
	<b:glossaryEntry>brought to ruin; "after the revolution the aristocracy was finished"; "the unsuccessful run for office left him ruined politically and economically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300701941">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having everything destroyed so nothing is left salvageable by an enemy; "Sherman''s scorched earth policy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300702101">
	<b:glossaryEntry>ruined or disrupted; "our shattered dreams of peace and prosperity"; "a tattered remnant of its former strength"; "my torn and tattered past"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300702309">
	<b:glossaryEntry>used of automobiles; completely demolished; "the insurance adjuster declared the automobile totaled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300702463"
	 b:glossaryEntry="laid waste by war"/>
<rdf:Description rdf:about="&a;300702546">
	<b:glossaryEntry>destroyed in an accident; "a wrecked ship"; "a highway full of wrecked cars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300702676"
	 b:glossaryEntry="kept intact or in a particular condition"/>
<rdf:Description rdf:about="&a;300702862"
	 b:glossaryEntry="protected from harm or loss"/>
<rdf:Description rdf:about="&a;300702945"
	 b:glossaryEntry="kept in good condition"/>
<rdf:Description rdf:about="&a;300703049"
	 b:glossaryEntry="capable of being preserved"/>
<rdf:Description rdf:about="&a;300703133"
	 b:glossaryEntry="guarded from injury or destruction"/>
<rdf:Description rdf:about="&a;300703231">
	<b:glossaryEntry>continued in your keeping or use or memory; "in...the retained pattern of dancers and guests remembered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300703403"
	 b:glossaryEntry='easily destroyed; "destructible glassware"'/>
<rdf:Description rdf:about="&a;300703558"
	 b:glossaryEntry="capable of being abolished"/>
<rdf:Description rdf:about="&a;300703642"
	 b:glossaryEntry="capable of being destroyed"/>
<rdf:Description rdf:about="&a;300703726"
	 b:glossaryEntry="not easily destroyed"/>
<rdf:Description rdf:about="&a;300703843"
	 b:glossaryEntry="not capable of being destroyed"/>
<rdf:Description rdf:about="&a;300703933">
	<b:glossaryEntry>capable of being determined or limited or fixed; determinable velocities"; "matters determinable by law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300704168">
	<b:glossaryEntry>capable of being ascertained or found out; "ascertainable facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300704307">
	<b:glossaryEntry>capable of being defined, limited, or explained; "definable terms"; "definable rules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300704448"
	 b:glossaryEntry='capable of being judged or decided; "judicable issues"'/>
<rdf:Description rdf:about="&a;300704558"
	 b:glossaryEntry="not capable of being definitely decided or ascertained"/>
<rdf:Description rdf:about="&a;300704780">
	<b:glossaryEntry>not capable of being determined; "an indeterminate number of plant species in the jungle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300704929"
	 b:glossaryEntry="not able to be ascertained; resisting discovery"/>
<rdf:Description rdf:about="&a;300705055">
	<b:glossaryEntry>unknown in advance; "an unpredictable (or indeterminable) future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300705180">
	<b:glossaryEntry>precisely determined or limited or defined; especially fixed by rule or by a specific and constant cause; "a determinate distance"; "a determinate number"; "determinate variations in animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300705447"
	 b:glossaryEntry="(of a number) having a fixed and unchanging value"/>
<rdf:Description rdf:about="&a;300705548">
	<b:glossaryEntry>not precisely determined or established; not fixed or known in advance; "of indeterminate age"; "a zillion is a large indeterminate number"; "an indeterminate point of law"; "the influence of environment is indeterminate"; "an indeterminate future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300705961">
	<b:glossaryEntry>determining payment based on the actual cost of production plus an agreed-upon fee or rate of profit; "a cost-plus government contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300706152">
	<b:glossaryEntry>allowing for a spontaneous response; "an open-ended question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300706270">
	<b:glossaryEntry>(botany) not continuing to grow indefinitely at the apex; "determinate growth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300706424">
	<b:glossaryEntry>(botany) having a usually flat-topped flower cluster in which the main and branch stems each end in a flower that opens before those below it or to its side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300706633">
	<b:glossaryEntry>(botany) having a capacity for continuing to grow at the apex; "an indeterminate stem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300706797">
	<b:glossaryEntry>(botany) having stalked flowers along an elongated stem that continue to open in succession from below as the stem continues to grow; "lilies of the valley are racemose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300707021">
	<b:glossaryEntry>being changed over time so as to be e.g. stronger or more complete or more useful; "the developed qualities of the Hellenic outlook"; "they have very small limbs with only two fully developed toes on each"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300707336">
	<b:glossaryEntry>fully developed as by discipline or training"a fully formed literary style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300707464">
	<b:glossaryEntry>devised; developed according to an orderly plan; "he had well formulated opinions on schooling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300707616"
	 b:glossaryEntry='fully considered and perfected; "mature plans"'/>
<rdf:Description rdf:about="&a;300707725">
	<b:glossaryEntry>not developed; "courses in interior design were rare and undeveloped"; "undeveloped social awareness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300707938"
	 b:glossaryEntry='beginning to develop; "a budding genius"'/>
<rdf:Description rdf:about="&a;300708032">
	<b:glossaryEntry>lacking in development; "immature plans"; "an unformed character"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300708163">
	<b:glossaryEntry>(biology) not fully developed in mature animals; "rudimentary wings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300708301">
	<b:glossaryEntry>of or or on the right; "a dextral gastropod shell with the apex upward has its opening on the right when facing the observer"; "a dextral flatfish lies with the right eye uppermost"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300708608"
	 b:glossaryEntry="(heraldry) on or starting from the wearer''s left"/>
<rdf:Description rdf:about="&a;300708709">
	<b:glossaryEntry>(botany) spiraling upward from left to right; "dextrorse vines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300708841">
	<b:glossaryEntry>of or on the left; "a sinistral gastropod shell with the apex upward has its opening on the left when facing the observer"; "a sinistral flatfish lies with the left eye uppermost"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300709148">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(heraldry) on or starting from the wearer''s left; "bar sinister"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300709267">
	<b:glossaryEntry>(botany) spiraling upward from right to left; "sinistrorse vines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300709405"
	 b:glossaryEntry='(physics) involving a transfer of heat; "a diabatic process"'/>
<rdf:Description rdf:about="&a;300709520">
	<b:glossaryEntry>(physics) occurring without loss or gain of heat; "adiabatic expansion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300709647">
	<b:glossaryEntry>made different (especially in the course of development) or shown to be different; "the differentiated markings of butterflies"; "the regionally differentiated results"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300709894"
	 b:glossaryEntry="set apart from other such things"/>
<rdf:Description rdf:about="&a;300709986"
	 b:glossaryEntry="not differentiated"/>
<rdf:Description rdf:about="&a;300710095">
	<b:glossaryEntry>having experienced or undergone dedifferentiation or the loss of specialization in form or function; "the hebephrenic--the most severely dedifferentiated of all schizophrenic patients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300710342">
	<b:glossaryEntry>not easy; requiring great physical or mental effort to accomplish or comprehend or endure; "a difficult task"; "nesting places on the cliffs are difficult of access"; "difficult times"; "a difficult child"; "found himself in a difficult situation"; "why is it so hard for you to keep a secret?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300711113">
	<b:glossaryEntry>requiring full use of your abilities or resources; "ambitious schedule"; "performed the most challenging task without a mistake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300711311">
	<b:glossaryEntry>difficult to accomplish; demanding considerable mental effort and skill; "the arduous work of preparing a dictionary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300711482">
	<b:glossaryEntry>hard to deal with; especially causing pain or embarrassment; "awkward (or embarrassing or difficult) moments in the discussion"; "an awkward pause followed his remark"; "a sticky question"; "in the unenviable position of resorting to an act he had planned to save for the climax of the campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300711868">
	<b:glossaryEntry>making great mental demands; hard to comprehend or solve; "a baffling problem"; "I faced the knotty problem of what to have for breakfast"; "a problematic situation at home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300712135">
	<b:glossaryEntry>having concealed difficulty; "a catchy question"; "a tricky recipe to follow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300712274">
	<b:glossaryEntry>difficult to handle; requiring great tact; "delicate negotiations with the big powers"; "hesitates to be explicit on so ticklish a matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300712478">
	<b:glossaryEntry>unpredictably difficult in operation; likely to be troublesome; "rockets were much too fractious to be tested near thigkly populated areas"; "fractious components of a communication system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300712723"
	 b:glossaryEntry='requiring great effort; "a hard-fought primary"'/>
<rdf:Description rdf:about="&a;300712828">
	<b:glossaryEntry>of extreme difficulty; requiring the strength of a Hercules; "a herculean task"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300712975">
	<b:glossaryEntry>exasperatingly difficult to handle or circumvent; "a nasty problem"; "a good man to have on your side in a tight situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300713158">
	<b:glossaryEntry>full of hardship or trials; "the rocky road to success"; "they were having a rough time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300713306">
	<b:glossaryEntry xml:space='preserve'><![CDATA[very difficult; severely testing stamina or resolution; "a rugged competitive examination"; "the rugged conditions of frontier life"; "the competition was tough"; "it''s a tough life"; "it was a tough job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300713571">
	<b:glossaryEntry>requiring effort or concentration; complex and not easy to answer or solve; "raised serious objections to the proposal"; "the plan has a serious flaw"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300713775">
	<b:glossaryEntry>difficult to treat or deal with; "stubborn rust stains"; "a stubborn case of acne"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300713912"
	 b:glossaryEntry='(informal) impressively difficult; "a tall order"'/>
<rdf:Description rdf:about="&a;300714015">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bristling with perplexities; "the thorny question of states'' rights"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300714136">
	<b:glossaryEntry>difficult to deal with; "a troublesome infection"; "a troublesome situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300714270"
	 b:glossaryEntry='hard to endure; "fell upon trying times"'/>
<rdf:Description rdf:about="&a;300714363">
	<b:glossaryEntry>causing difficulty in finding an answer or solution; much disputed; "the vexed issue of priorities"; "we live in vexed and troubled times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300714553">
	<b:glossaryEntry>posing no difficulty; requiring little effort; "an easy job"; "an easy problem"; "an easy victory"; "the house is easy to heat"; "satisfied with easy answers"; "took the easy way out of his dilemma"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300715018">
	<b:glossaryEntry>not showing effort or strain; "a difficult feat performed with casual mastery"; "careless grace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300715180">
	<b:glossaryEntry>(informal) not burdensome or demanding; borne or done easily and without hardship; "what a cushy job!"; "a soft job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300715355">
	<b:glossaryEntry>not involved or complicated; "an elementary problem in statistics"; "elementary, my dear Watson"; "a simple game"; "found an uncomplicated solution to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300715616"
	 b:glossaryEntry='achieved without great effort; "a hands-down victory"'/>
<rdf:Description rdf:about="&a;300715726">
	<b:glossaryEntry>requiring little hard work or exertion; "a painless solution to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300715857"
	 b:glossaryEntry="made easy or uncomplicated"/>
<rdf:Description rdf:about="&a;300715940">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking obstructions or difficulties; "the bill''s path through the legislature was smooth and orderly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300716095">
	<b:glossaryEntry>(of mammals) walking on the toes with the posterior part of the foot raised</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300716228"
	 b:glossaryEntry="(of mammals) walking on the whole sole of the foot"/>
<rdf:Description rdf:about="&a;300716336">
	<b:glossaryEntry>having or expressing dignity; especially formality or stateliness in bearing or appearance; "her dignified demeanor"; "the director of the school was a dignified white-haired gentleman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300716649">
	<b:glossaryEntry>refined or imposing in manner or appearance; befitting a royal court; "a courtly gentleman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300716823">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of a person''s appearance or behavior; befitting an eminent person; "his distinguished bearing"; "the monarch''s imposing presence"; "she reigned in magisterial beauty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300717079"
	 b:glossaryEntry="lacking dignity"/>
<rdf:Description rdf:about="&a;300717242">
	<b:glossaryEntry>causing awareness of your shortcomings; "golf is a humbling game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300717401">
	<b:glossaryEntry>beneath your dignity; "considered helping with the dishes to be infra dig"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300717534">
	<b:glossaryEntry>inspiring scornful pity; "how silly an ardent and unsuccessful wooer can be especially if he is getting on in years"- Dashiell Hammett</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300717744">
	<b:glossaryEntry>marked by the qualities of or befitting a statesman; "a man of statesmanlike judgment"; "a statesmanlike solution of the present perplexities"-V.L.Parrington</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300718011"
	 b:glossaryEntry="able to take a broad view of negotiations between states"/>
<rdf:Description rdf:about="&a;300718131"
	 b:glossaryEntry='not statesmanlike; "unstatesmanlike procedure"'/>
<rdf:Description rdf:about="&a;300718257">
	<b:glossaryEntry>befitting a president; "criticized the candidate for not looking presidential"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300718412"
	 b:glossaryEntry='not presidential; "very unpresidential behavior"'/>
<rdf:Description rdf:about="&a;300718539"
	 b:glossaryEntry="(of a flowering plant) having two cotyledons in the seed"/>
<rdf:Description rdf:about="&a;300718656">
	<b:glossaryEntry>(of a flowering plant) having a single cotyledon in the seed as in grasses and lilies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300718804">
	<b:glossaryEntry>characterized by care and perseverence in carrying out tasks; "a diligent detective investigates all clues"; "a diligent search of the files"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300719072">
	<b:glossaryEntry>marked by care and persistent effort; "her assiduous attempts to learn French"; "assiduous research"; "sedulous pursuit of legal and moral principles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300719289"
	 b:glossaryEntry="characterized by hard work and perseverance"/>
<rdf:Description rdf:about="&a;300719426">
	<b:glossaryEntry>characterized by neglect and undue lack of concern; "negligent parents"; "negligent of detail"; "negligent in his correspondence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300719719">
	<b:glossaryEntry>failing in what duty requires; "derelict (or delinquent) in his duty"; "neglectful of his duties"; "remiss of you not to pay your bills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300719945">
	<b:glossaryEntry>lacking in rigor or strictness; "such lax and slipshod ways are no longer acceptable"; "lax in attending classes"; "slack in maintaining discipline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300720151">
	<b:glossaryEntry>involving a driver of a motor vehicle who leaves the scene of an accident</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300720285">
	<b:glossaryEntry>not showing due care or attention; "inattentive students"; "an inattentive babysitter"; "neglectful parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300720464">
	<b:glossaryEntry>reduced in strength or concentration or quality or purity; "diluted alcohol"; "a dilute solution"; "dilute acetic acid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300720700">
	<b:glossaryEntry>mixed with water; "sold cut whiskey"; "a cup of thinned soup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300720832">
	<b:glossaryEntry>overly diluted; thin and insipid; "washy coffee"; "watery milk"; "weak tea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300720975"
	 b:glossaryEntry="(of coffee) having cream or milk added"/>
<rdf:Description rdf:about="&a;300721065"
	 b:glossaryEntry='not diluted; "undiluted milk"; "an undiluted racial strain"'/>
<rdf:Description rdf:about="&a;300721234"
	 b:glossaryEntry="(of coffee) without cream or sugar"/>
<rdf:Description rdf:about="&a;300721320"
	 b:glossaryEntry="of or relating to a solution whose dilution has been reduced"/>
<rdf:Description rdf:about="&a;300721439"
	 b:glossaryEntry='without water; "took his whiskey neat"'/>
<rdf:Description rdf:about="&a;300721555">
	<b:glossaryEntry>(chemistry) used especially of organic compounds; having all available valence bonds filled; "saturated fats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300721720">
	<b:glossaryEntry>(chemistry) used of a compound (especially of carbon) containing atoms sharing more than one valence bond; "unsaturated fats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300721921">
	<b:glossaryEntry>(of long-chain carbon compounds especially fats) having many unsaturated bonds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300722061">
	<b:glossaryEntry>being the most concentrated solution possible at a given temperature; unable to dissolve still more of a substance; "a saturated solution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300722288">
	<b:glossaryEntry>being more concentrated than normally possible and therefore not in equilibrium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300722428">
	<b:glossaryEntry>not saturated; capable of dissolving more of a substance at a given temperature; "an unsaturated salt solution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300722597"
	 b:glossaryEntry="skilled in dealing with sensitive matters or people"/>
<rdf:Description rdf:about="&a;300722774">
	<b:glossaryEntry>smoothly agreeable and courteous with a degree of sophistication; "he was too politic to quarrel with so important a personage"; "the hostess averted a confrontation between two guests with a diplomatic change of subject"; "the manager pacified the customer with a smooth apology for the error"; "affable, suave, moderate men...smugly convinced of their respectability"_ Ezra Pound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300723226">
	<b:glossaryEntry>showing skill and sensitivity in dealing with people; "by diplomatic conduct he avoided antagonizing anyone"; "a tactful way of correcting someone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300723427"
	 b:glossaryEntry="not skilled in dealing with others"/>
<rdf:Description rdf:about="&a;300723520">
	<b:glossaryEntry>overcoming animosity or hostility; "spoke in a conciliating tone"; "a conciliatory visit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300723734">
	<b:glossaryEntry>tending or intended to pacify by acceding to demands or granting concessions; "the appeasing concessions to the Nazis at Munich"; "placating (or placative) gestures"; "an astonishingly placatory speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300724031">
	<b:glossaryEntry>intended to reconcile or appease; "sent flowers as a propitiatory gesture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300724179">
	<b:glossaryEntry>arousing animosity or hostility; "his antagonizing brusqueness"; "a speech that was antagonizing to many voters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300724383">
	<b:glossaryEntry>causing hostility or loss of friendliness; "her sudden alienating aloofness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300724516">
	<b:glossaryEntry>direct in spatial dimensions; proceeding without deviation or interruption; straight and short; "a direct route"; "a direct flight"; "a direct hit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300724878">
	<b:glossaryEntry>of e.g. journeys or deliveries; "the limousine offers door-to-door service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300725012">
	<b:glossaryEntry>of a journey especially a flight; "a nonstop flight to Atlanta"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300725129">
	<b:glossaryEntry>close enough to go straight to the target; "point-blank range"; "a point-blank shot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300725271">
	<b:glossaryEntry>most direct; "took the shortest and most direct route to town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300725396"
	 b:glossaryEntry='pointed directly ahead; "a straightforward gaze"'/>
<rdf:Description rdf:about="&a;300725506">
	<b:glossaryEntry>going directly ahead from one point to another without veering or turning aside; "some people see evolution as an undeviating upward march from simple organisms to the very complex"; "a straight and narrow tree-lined road unswerving across the lowlands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300725830">
	<b:glossaryEntry>of a route or journey etc.; continuing without requiring stops or changes; "a through street"; "a through bus"; "through traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300726016">
	<b:glossaryEntry>not direct in spatial dimension; not leading by a straight line or course to a destination; "sometimes taking an indirect path saves time"; "must take an indirect couse in sailing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300726395">
	<b:glossaryEntry>(used especially of glances) directed to one side with or as if with doubt or suspicion or envy; "her eyes with their misted askance look"- Elizabeth Bowen; "sidelong glances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300726687">
	<b:glossaryEntry>deviating from a straight course; "a scenic but devious route"; "a long and circuitous journey by train and boat"; "a roundabout route avoided rush-hour traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300726929"
	 b:glossaryEntry="used of movement; at an angle"/>
<rdf:Description rdf:about="&a;300727034"
	 b:glossaryEntry="of tactics e.g.; likely or designed to confuse or deceive"/>
<rdf:Description rdf:about="&a;300727150">
	<b:glossaryEntry>of a path e.g.; "meandering streams"; "rambling forest paths"; "the river followed its wandering course"; "a winding country road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300727376">
	<b:glossaryEntry>(electricity) of a current flowing in one direction only; not alternating; "direct current"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300727520">
	<b:glossaryEntry>(electricity) of a current that reverses direction at regular intervals; "alternating current"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300727672">
	<b:glossaryEntry>extended senses; direct in means or manner or behavior or language or action; "a direct question"; "a direct response"; "a direct approach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300728026">
	<b:glossaryEntry>bluntly direct and outspoken but good-natured; "a bluff but pleasant manner"; "a bluff and rugged natural leader"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300728191">
	<b:glossaryEntry>characterized by disconcerting directness in manner or speech; without subtlety or evasion; "blunt talking and straight shooting"; "a blunt New England farmer"; "I gave them my candid opinion"; "forthright criticism"; "a forthright approach to the problem"; "tell me what you think--and you may just as well be frank"; "it is possible to be outspoken without being rude"; "plainspoken and to the point"; "a point-blank accusation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300728757"
	 b:glossaryEntry='(informal) without reservation; "a flat-footed refusal"'/>
<rdf:Description rdf:about="&a;300728870">
	<b:glossaryEntry>forthright and honest; "had a man-to-man talk about the facts of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300728997">
	<b:glossaryEntry>not tolerating irrelevancies; "the no-nonsense tones of a stern parent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300729126">
	<b:glossaryEntry>free from any effort to soften to disguise; "the plain and unvarnished truth"; "the unvarnished candor of old people and children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300729322">
	<b:glossaryEntry>direct and obvious in meaning or reference; often unpleasant; "a pointed critique"; "a pointed allusion to what was going on"; "another pointed look in their direction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300729544">
	<b:glossaryEntry>without evasion or compromise; "a square contradiction"; "he is not being as straightforward as it appears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300729725">
	<b:glossaryEntry>extended senses; not direct in manner or language or behavior or action; "making indirect but legitimate inquiries"; "an indirect insult"; "doubtless they had some indirect purpose in mind"; "though his methods are indirect they are not dishonest"; "known as a shady indirect fellow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300730225">
	<b:glossaryEntry>characterized by indirect references; "allusive speech is characterized by allusions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300730365">
	<b:glossaryEntry>roundabout or ambiguous; "attacks from tht source amounted to a backhanded compliment to his integrity"; "a backhanded and dishonest way of reaching his goal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300730580">
	<b:glossaryEntry>marked by obliqueness or indirection in speech or conduct; "the explanation was circuitous and puzzling"; "a roundabout paragraph"; "hear in a roundabout way that her ex-husband was marrying her best friend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300730857">
	<b:glossaryEntry xml:space='preserve'><![CDATA[roundabout and unnecessarily wordy; "had a preference for circumlocutious (or circumlocutory) rather than forthright expression"; "A periphrastic study in a worn-out poetical fashion,/ Leaving one still with the intolerable wrestle/ With words and meanings."-T.S.Eliot; (`ambagious'' is archaic)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300731257">
	<b:glossaryEntry>departing from the accepted or proper way; misleading; "used devious means to achieve success"; "gave oblique answers to direct questions"; "oblique political maneuvers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300731490">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of e.g. speech and writing) tending to depart from the main point or cover a wide range of subjects; "amusingly digressive with satirical thrusts at women''s fashions among other things"; "a rambling discursive book"; "his excursive remarks"; "a rambling speech about this and that"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300731865">
	<b:glossaryEntry>heard through another rather than directly; "hearsay information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300731984">
	<b:glossaryEntry>hesitant to state facts or opinions simply and directly as from e.g. timidity or hypocrisy; "a mealymouthed politician"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300732162"
	 b:glossaryEntry='not straightforward; "his tortuous reasoning"'/>
<rdf:Description rdf:about="&a;300732262">
	<b:glossaryEntry>(mathematics) varying in the same manner as another quantity; "a term is in direct proportion to another term if it increases (or decreases) as the other increases (or decreases)"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300732494">
	<b:glossaryEntry>(mathematics) varying in a manner opposite to that of another quantity; "a term is in inverse proportion to another term if it increases (or decreases) as the other decreases (or increases)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300732737">
	<b:glossaryEntry>(astronomy) moving from west to east on the celestial sphere; or--for planets--around the sun in the same direction as the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300732918">
	<b:glossaryEntry>(astronomy) moving from east to west on the celestial sphere; or--for planets--around the sun in a direction opposite to that of the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300733113"
	 b:glossaryEntry='having no intervening medium; "an immediate influence"'/>
<rdf:Description rdf:about="&a;300733277">
	<b:glossaryEntry>immediate or direct in bearing or force; having nothing intervening; "in direct sunlight"; "in direct contact with the voters"; "direct exposure to the disease"; "a direct link"; "the direct cause of the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300733543">
	<b:glossaryEntry>without the interposition of other agencies or conditions; "unmediated relations between God and man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300733701">
	<b:glossaryEntry>acting through or dependent on an intervening agency; "the disease spread by mediate as well as direct contact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300733920">
	<b:glossaryEntry>having intervening factors or persons or influences; "reflection from the ceiling provided a soft indirect light"; "indirect evidence"; "an indirect cause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300734130">
	<b:glossaryEntry>acting or brought about through an intervening agency; "the mediated settlement brought satisfaction to both sides"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300734300">
	<b:glossaryEntry>having or revealing keen insight and good judgment; "a discerning critic"; "a discerning reader"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300734543">
	<b:glossaryEntry>characterized by ease and quickness in perceiving; "clear mind"; "a percipient author"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300734694">
	<b:glossaryEntry>mentally acute or penetratingly discerning; "too clear-eyed not to see what problems would follow"; "chaos could be prevented only by clear-sighted leadership"; "much too perspicacious to be taken in by so spurious an argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300735010">
	<b:glossaryEntry>perceiving the significance of events before they occur; "extroardinarily prescient memoranda on the probable course of postwar relations"-R.H.Rovere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300735215"
	 b:glossaryEntry="lacking discernment"/>
<rdf:Description rdf:about="&a;300735347">
	<b:glossaryEntry>lacking in insight or discernment; "too obtuse to grasp the implications of his behavior"; "a purblind oligarchy that flatly refused to see that history was condemning it to the dustbin"- Jasper Griffin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300735613">
	<b:glossaryEntry>lacking understanding; "tried to explain to her uncomprehending husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300735747">
	<b:glossaryEntry>marked by prudence or modesty and wise self-restraint; "his trusted discreet aide"; "a discreet, finely wrought gold necklace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300735963">
	<b:glossaryEntry>free from ostentation or pretension; "the restrained elegance of the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300736120">
	<b:glossaryEntry>showing wise self-restraint in speech and behavior especially in preserving prudent silence; "maintained a prudent silence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300736297">
	<b:glossaryEntry>lacking discretion; injudicious; "her behavor was indiscreet at the very best"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300736468"
	 b:glossaryEntry="unwisely talking too much"/>
<rdf:Description rdf:about="&a;300736588"
	 b:glossaryEntry='lacking wise self-restraint; "an imprudent remark"'/>
<rdf:Description rdf:about="&a;300736694">
	<b:glossaryEntry>marked by the ability to see or make fine distinctions; "discriminate judgments"; "discriminate people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300736891">
	<b:glossaryEntry>not marked by fine distinctions; "indiscriminate reading habits"; "an indiscriminate mixture of colors and styles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300737138">
	<b:glossaryEntry>not selective of a single class or person; "Clinton was criticized for his promiscuous solicitation of campaign money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300737314">
	<b:glossaryEntry>ignoring distinctions; "indiscriminate slaughter of a population"; "sweeping generalizations"; "wholesale destruction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300737499">
	<b:glossaryEntry>showing or indicating careful judgment and discernment especially in matters of taste; "the discriminating eye of the connoisseur"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300737870">
	<b:glossaryEntry>having or showing appreciation or a favorable critical judgment or opinion; "appreciative of a beautiful landscape"; "an appreciative laugh from the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300738087">
	<b:glossaryEntry>capable of distinguishing; "students having superior diacritic powers"; "the diacritic elements in culture"- S.F.Nadel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300738275">
	<b:glossaryEntry>able to make or detect effects of great subtlety; sensitive; "discerning taste"; "a fine eye for color"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300738442">
	<b:glossaryEntry>noting distinctions with nicety; "a discriminating interior designer"; "a nice sense of color"; "a nice point in the argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300738634"
	 b:glossaryEntry="capable of making fine distinctions"/>
<rdf:Description rdf:about="&a;300738747"
	 b:glossaryEntry="selecting what seems best of various styles or ideas"/>
<rdf:Description rdf:about="&a;300738854"
	 b:glossaryEntry='generally admired; "good taste"'/>
<rdf:Description rdf:about="&a;300738936">
	<b:glossaryEntry>tending to select; characterized by careful choice; "an exceptionally quick and selective reader"- John Mason Brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300739107"
	 b:glossaryEntry="not discriminating"/>
<rdf:Description rdf:about="&a;300739297"
	 b:glossaryEntry="failing to make or recognize distinctions"/>
<rdf:Description rdf:about="&a;300739399">
	<b:glossaryEntry>lacking in discrimination; "she was absolutely uncritical, she believed everything"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300739539"
	 b:glossaryEntry="lacking sensitivity, taste, or judgment"/>
<rdf:Description rdf:about="&a;300739637">
	<b:glossaryEntry>not selective or discriminating; "unselective in her reading habits; her choices seemed completely random"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300739801">
	<b:glossaryEntry>designed to be disposed of after use; "disposable paper cups"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300739937"
	 b:glossaryEntry='intended to be thrown away after use; "throwaway diapers"'/>
<rdf:Description rdf:about="&a;300740053"
	 b:glossaryEntry="not designed to be thrown away after use"/>
<rdf:Description rdf:about="&a;300740164">
	<b:glossaryEntry>that may be returned; "returnable bottles and cans"; "sale merchandise is not returnable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300740328">
	<b:glossaryEntry>(law) to be returned to the former owner or that owner''s heirs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300740447"
	 b:glossaryEntry='that may not be returned; "nonreturnable bottles"'/>
<rdf:Description rdf:about="&a;300740556">
	<b:glossaryEntry>free or available for use or disposition; "every disposable piece of equipment was sent to the fire"; "disposable assets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300740788">
	<b:glossaryEntry>convenient for use or disposal; "the house is available after July 1"; "2000 square feet of usable office space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300740975"
	 b:glossaryEntry='(used of funds) remaining after taxes; "spendable income"'/>
<rdf:Description rdf:about="&a;300741101">
	<b:glossaryEntry>in cash or easily convertible to cash; "liquid (or fluid) assets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300741227"
	 b:glossaryEntry="of assets"/>
<rdf:Description rdf:about="&a;300741314"
	 b:glossaryEntry='not convertible to cash; "frozen assets"'/>
<rdf:Description rdf:about="&a;300741407">
	<b:glossaryEntry>(anatomy) situated farthest from point of attachment or origin, as of a limb or bone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300741544">
	<b:glossaryEntry>(anatomy) situated nearest to point of attachment or origin; "the proximal end of a bone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300741688">
	<b:glossaryEntry>(anatomy) directed away from the midline or mesial plane of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300741827">
	<b:glossaryEntry>lying away from the median and sagittal plane of a body; "lateral lemniscus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300741957">
	<b:glossaryEntry>(anatomy) being in or directed toward the midline or mesial plane of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300742123"
	 b:glossaryEntry="dividing an animal into right and left halves"/>
<rdf:Description rdf:about="&a;300742230">
	<b:glossaryEntry>located in a plane that is parallel to the central plane of the sagittal suture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300742364">
	<b:glossaryEntry>easy to perceive; especially clearly outlined; "a distinct flavor"; "a distinct odor of turpentine"; "a distinct outline"; "the ship appeared as a distinct silhouette"; "distinct fingerprints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300742791">
	<b:glossaryEntry>having a clean and distinct outline as if precisely cut along the edges; "a finely chiseled nose"; "well-defined features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300742983">
	<b:glossaryEntry>clear and distinct to the senses; easily perceptible; "as clear as a whistle"; "clear footprints in the snow"; "the letter brought back a clear image of his grandfather"; "a spire clean-cut against the sky"; "a clear-cut pattern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300743288">
	<b:glossaryEntry>(of something seen or heard) clearly defined; "a sharp photographic image"; "the sharp crack of a twig"; "the crisp snap of dry leaves underfoot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300743493">
	<b:glossaryEntry>distinctly or sharply outlined; "crystalline sharpness of outline"- John Buchan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300743630">
	<b:glossaryEntry>showing clearly the outline or profile or boundary; "hills defined against the evening sky"; "the setting sun showed the outlined figure of a man standing on the hill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300743862">
	<b:glossaryEntry>having a sharp or distinct edge; "a narrow knifelike profile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300743979"
	 b:glossaryEntry='very clearly delineated; "razor-sharp definition"'/>
<rdf:Description rdf:about="&a;300744086">
	<b:glossaryEntry>not clearly defined or easy to perceive or understand; "indistinct shapes in the gloom"; "an indistinct memory"; "only indistinct notions of what to do"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300744439"
	 b:glossaryEntry='made dim or indistinct; "a sun bedimmed by clouds"'/>
<rdf:Description rdf:about="&a;300744544">
	<b:glossaryEntry>indistinct or hazy in outline; "a landscape of blurred outlines"; "the trees were just blurry shapes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300744748">
	<b:glossaryEntry>lacking definite form or limits; "gropes among cloudy issues toward a feeble conclusion"- H.T.Moore; "nebulous distinction between pride and conceit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300744972">
	<b:glossaryEntry>lacking clarity or distinctness; "a dim figure in the distance"; "only a faint recollection"; "shadowy figures in the gloom"; "saw a vague outline of a building through the fog"; "a few wispy memories of childhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300745270">
	<b:glossaryEntry xml:space='preserve'><![CDATA[indistinctly understood or felt or perceived; "a faint clue to the origin of the mystery"; "haven''t the faintest idea"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300745440">
	<b:glossaryEntry>muted or unclear; "veiled sounds"; "the image is veiled or foggy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300745558"
	 b:glossaryEntry="being in focus or brought into focus"/>
<rdf:Description rdf:about="&a;300745677"
	 b:glossaryEntry="(of an image) clear and sharp"/>
<rdf:Description rdf:about="&a;300745764">
	<b:glossaryEntry>(of an image) not in or brought into focus; "at their edges things were pretty much out of focus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300745945">
	<b:glossaryEntry>having variety of character or form or components; or having increased variety; "a diversified musical program ranging from classical to modern"; "diversified farming"; "diversified manufacturing"; "diversified scenery"; "diversified investments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300746303"
	 b:glossaryEntry="(of investments) distributed among a variety of securities"/>
<rdf:Description rdf:about="&a;300746419">
	<b:glossaryEntry>widely different; "varied motives prompt people to join a political party"; "varied ethnic traditions of the immigrants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300746607"
	 b:glossaryEntry="not diversified"/>
<rdf:Description rdf:about="&a;300746783">
	<b:glossaryEntry>not specialized or limited to one class of things; "general studies"; "general knowledge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300746926">
	<b:glossaryEntry>characterized by massiveness and rigidity and total uniformity; "a monolithic society"; "a monolithic worldwide movement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300747104">
	<b:glossaryEntry>acting together as a single undiversified whole; "a solid voting bloc"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300747238">
	<b:glossaryEntry>(of investments) not distributed among a variety of securities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300747360">
	<b:glossaryEntry>capable of being or liable to be divided or separated; "even numbers are divisible by two"; "the Americans fought a bloody war to prove that their nation is not divisible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300747677"
	 b:glossaryEntry="capable of being cleaved"/>
<rdf:Description rdf:about="&a;300747757">
	<b:glossaryEntry>capable of being divided or dissociated; "often drugs and crime are not dissociable"; "the siamese twins were not considered seperable"; "a song...never conceived of as severable from the melody";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300748036"
	 b:glossaryEntry="tending to produce dissociation"/>
<rdf:Description rdf:about="&a;300748126">
	<b:glossaryEntry>(mathematics) can be divided usually without leaving a remainder; "15 is divisible by 3"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300748288">
	<b:glossaryEntry>(of e.g. property) can be parted or divided; "a partible estate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300748407">
	<b:glossaryEntry>impossible of undergoing division; "an indivisible union of states"; "one nation indivisible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300748612">
	<b:glossaryEntry>not divided or divisible into parts; "layers that were fused into an indiscrete mass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300748754"
	 b:glossaryEntry="(mathematics) cannot be divided without leaving a remainder"/>
<rdf:Description rdf:about="&a;300748891"
	 b:glossaryEntry='not capable of being separated; "inseparable pieces of rock"'/>
<rdf:Description rdf:about="&a;300749009">
	<b:glossaryEntry>furnished with or supported by documents; "the first documented case of shark attack in those waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300749203">
	<b:glossaryEntry>supported with written references or citations; "a carefully referenced biography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300749342">
	<b:glossaryEntry>(of a boat or vessel) furnished with necessary official documents specifying ownership etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300749489">
	<b:glossaryEntry>lacking necessary documents (as for e.g. permission to live or work in a country); "undocumented aliens"; "undocumented tax deductions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300749719"
	 b:glossaryEntry="(a boat or vessel) not furnished with official documents"/>
<rdf:Description rdf:about="&a;300749834"
	 b:glossaryEntry='not supported by written evidence; "unsupported accusations"'/>
<rdf:Description rdf:about="&a;300749952"
	 b:glossaryEntry="tending to domineer"/>
<rdf:Description rdf:about="&a;300750173">
	<b:glossaryEntry>expecting unquestioning obedience; "he was imperious and dictatorial"; "the timid child of authoritarian parents"; "insufferably overbearing behavior toward the waiter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300750429">
	<b:glossaryEntry>offensively self-assured or given to exercising usually unwarranted power; "an autocratic person"; "autocratic behavior"; "a bossy way of ordering others around"; "a rather aggressive and dominating character"; "managed the employees in an aloof magisterial way"; "a swaggering peremptory manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300750848"
	 b:glossaryEntry="noisily domineering; tending to browbeat others"/>
<rdf:Description rdf:about="&a;300750961"
	 b:glossaryEntry="given to haughty disregard of others"/>
<rdf:Description rdf:about="&a;300751066">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unjustly domineering; "incensed at the government''s heavy-handed economic economic policies"; "a manager who rode roughshod over all opposition"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300751281">
	<b:glossaryEntry>able to deal authoritatively with affairs; "dismissed the matter with an imperious wave of her hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300751449">
	<b:glossaryEntry>marked by unjust severity or arbitrary behavior; "the oppressive government"; "oppressive laws"; "a tyrannical parent"; "tyrannous disregard of human rights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300751688">
	<b:glossaryEntry>inclined or willing to submit to orders or wishes of others or showing such inclination; "submissive servants"; "a submissive reply"; "replacing troublemakers with more submissive people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300752094"
	 b:glossaryEntry='showing humiliation or submissiveness; "an abject apology"'/>
<rdf:Description rdf:about="&a;300752205"
	 b:glossaryEntry="showing an excessively deferential manner"/>
<rdf:Description rdf:about="&a;300752307">
	<b:glossaryEntry>evidencing little spirit or courage; overly submissive or compliant; "compliant and anxious to suit his opinions of those of others"; "a fine fiery blast against meek conformity"- Orville Prescott; "she looked meek but had the heart of a lion"; "was submissive and subservient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300752660"
	 b:glossaryEntry="totally submissive"/>
<rdf:Description rdf:about="&a;300752777"
	 b:glossaryEntry="harassed by persistent nagging"/>
<rdf:Description rdf:about="&a;300752875">
	<b:glossaryEntry>submissive or fawning in attitude or behavior; "spoke in a servile tone"; "the incurably servile housekeeper"; "servile tasks such as floor scrubbing and barn work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300753147">
	<b:glossaryEntry>attentive in an ingratiating or servile manner; "obsequious shop assistants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300753280">
	<b:glossaryEntry>abjectly submissive; characteristic of a slave or servant; "slavish devotion to her job ruled her life"; "a slavish yes-man to the party bosses"- S.H.Adams; "she has become submissive and subservient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300753561"
	 b:glossaryEntry="suitable for a slave or servant"/>
<rdf:Description rdf:about="&a;300753648"
	 b:glossaryEntry="not servile or submissive"/>
<rdf:Description rdf:about="&a;300753744">
	<b:glossaryEntry>exercising influence or control; "television plays a dominant role in molding public opinion"; "the dominant partner in the marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300754112">
	<b:glossaryEntry>most powerful or important or influential; "the economically ascendant class"; "D-day is considered the dominating event of the war in Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300754335">
	<b:glossaryEntry>able to control or determine policy; "a controlling interest in the firm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300754466">
	<b:glossaryEntry>responsible for making and enforcing rules and laws; "governing bodies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300754593"
	 b:glossaryEntry='in control; "who is the person in charge?"'/>
<rdf:Description rdf:about="&a;300754691">
	<b:glossaryEntry>having superior power and influence; "the predominant mood among policy-makers is optimism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300754911">
	<b:glossaryEntry>having or showing a desire to control or dominate; "a possessive parent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300755040">
	<b:glossaryEntry>greatest in status or authority or power; "a supreme tribunal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300755168">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `to'') not subject to or influenced by; "overcome by a superior opponent"; "trust magnates who felt themselves superior to law"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300755372"
	 b:glossaryEntry="lower in rank or importance"/>
<rdf:Description rdf:about="&a;300755631"
	 b:glossaryEntry="of or relating to a person who is subordinate to another"/>
<rdf:Description rdf:about="&a;300755753">
	<b:glossaryEntry>having partial rights and privileges or subordinate status; "an associate member"; "an associate professor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300755919"
	 b:glossaryEntry='of the lowest rank in a category; "a buck private"'/>
<rdf:Description rdf:about="&a;300756020"
	 b:glossaryEntry="acting as substitute for another"/>
<rdf:Description rdf:about="&a;300756119"
	 b:glossaryEntry="belonging to a lower class or rank"/>
<rdf:Description rdf:about="&a;300756209"
	 b:glossaryEntry='lower in rank, power, or authority; "an under secretary"'/>
<rdf:Description rdf:about="&a;300756320">
	<b:glossaryEntry>of genes; producing the same phenotype whether its allele is identical or dissimilar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300756459">
	<b:glossaryEntry>of genes; producing its characteristic phenotype only when its allele is identical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300756597"
	 b:glossaryEntry='having one barrel; "most guns are single-barreled"'/>
<rdf:Description rdf:about="&a;300756728">
	<b:glossaryEntry>having two barrels mounted side by side; "a double-barreled shotgun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300756877">
	<b:glossaryEntry>(of clothing) fastened by lapping one edge of the front well over the other usually with a double row of buttons; "double-breasted jacket"; "double-breasted suit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300757101">
	<b:glossaryEntry>(of clothing) closing with a narrow overlap and fastened with a single row of buttons; "a single-breasted jacket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300757276">
	<b:glossaryEntry>suitable to or characteristic of drama; "a dramatic entrance in a swirling cape"; "a dramatic rescue at sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300757511">
	<b:glossaryEntry>having the excitement and emotional appeal of melodrama; "a melodramatic account of two perilous days at sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300757679">
	<b:glossaryEntry>of the nature of spectacle or drama; "spectacular dives from the cliff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300757808"
	 b:glossaryEntry="affectedly dramatic; overacted"/>
<rdf:Description rdf:about="&a;300757890">
	<b:glossaryEntry>lacking dramatic force and quality; "moved with quiet force and undramatic bearing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300758066"
	 b:glossaryEntry='not spectacular; "an unspectacular but necessary task"'/>
<rdf:Description rdf:about="&a;300758180">
	<b:glossaryEntry>capable of being acted; suitable for the stage; "an actable scene"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300758300"
	 b:glossaryEntry='not actable; "an unactable play"'/>
<rdf:Description rdf:about="&a;300758388">
	<b:glossaryEntry>suited to or characteristic of the stage or theater; "a theatrical pose"; "one of the most theatrical figures in public life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300758624">
	<b:glossaryEntry>characteristic of acting or a stage performance; often affected; "histrionic gestures"; "an attitude of melodramatic despair"; "a theatrical pose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300758842"
	 b:glossaryEntry="marked by extravagant display"/>
<rdf:Description rdf:about="&a;300758923">
	<b:glossaryEntry>having characteristics of the stage especially an artificial and mannered quality; "stagy heroics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300759073">
	<b:glossaryEntry>not suited to or characteristic of the stage or theater; "a well-written but untheatrical play"; "an untheatrical personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300759258"
	 b:glossaryEntry="fit to drink"/>
<rdf:Description rdf:about="&a;300759344">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of alcoholic beverages that are suitable for drinking; "it''s an impudent young wine but I think you will find it quite potable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300759525"
	 b:glossaryEntry="not fit to drink"/>
<rdf:Description rdf:about="&a;300759599">
	<b:glossaryEntry>stupefied or excited by a chemical substance (especially alcohol); "a noisy crowd of intoxicated sailors"; "helplessly inebriated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300759952">
	<b:glossaryEntry>used of riotously drunken merrymaking; "a night of bacchanalian revelry"; "carousing bands of drunken soldiers"; "orgiastic festivity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300760191"
	 b:glossaryEntry="smelling of beer"/>
<rdf:Description rdf:about="&a;300760259"
	 b:glossaryEntry="slang for `drunk''"/>
<rdf:Description rdf:about="&a;300760549">
	<b:glossaryEntry>given to or marked by the consumption of alcohol; "a bibulous fellow"; "a bibulous evening"; "his boozy drinking companions"; "thick boozy singing"; "a drunken binge"; "two drunken gentleman holding each other up"; "sottish behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300760865">
	<b:glossaryEntry>under the influence of narcotics; "knocked out by doped wine"; "a drugged sleep"; "were under the effect of the drugged sweets"; "in a narcotized state; stuperous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300761103"
	 b:glossaryEntry="British informal for `intoxicated''"/>
<rdf:Description rdf:about="&a;300761198">
	<b:glossaryEntry>slightly and pleasantly intoxicated from alcohol or a drug especially marijuana</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300761337"
	 b:glossaryEntry="(informal) under the influence of narcotics"/>
<rdf:Description rdf:about="&a;300761445"
	 b:glossaryEntry="not affected by a chemical substance (especially alcohol)"/>
<rdf:Description rdf:about="&a;300761608"
	 b:glossaryEntry="totally sober"/>
<rdf:Description rdf:about="&a;300761692">
	<b:glossaryEntry xml:space='preserve'><![CDATA[practicing complete abstinence from alcoholic beverages; "he''s been dry for ten years"; "no thank you; I happen to be teetotal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300761880"
	 b:glossaryEntry="not inebriated"/>
<rdf:Description rdf:about="&a;300761969">
	<b:glossaryEntry>not having a sharp edge or point; "the knife was too dull to be of any use"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300762167">
	<b:glossaryEntry>used of a knife or other blade; not sharp; "a blunt instrument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300762282"
	 b:glossaryEntry="made dull or blunt"/>
<rdf:Description rdf:about="&a;300762363"
	 b:glossaryEntry="lacking a cutting edge"/>
<rdf:Description rdf:about="&a;300762440"
	 b:glossaryEntry="not sharpened"/>
<rdf:Description rdf:about="&a;300762511">
	<b:glossaryEntry>having or made by a thin edge or sharp point; suitable for cutting or piercing; "a sharp knife"; "a pencil with a sharp point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300762869">
	<b:glossaryEntry>(of a tooth) adapted for shearing flesh; "the carnassial teeth of carnivores"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300763003">
	<b:glossaryEntry>suitable for cutting or severing; "a cutting tool"; "the cutting edge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300763127">
	<b:glossaryEntry>having a cutting edge or especially an edge or edges as specified; often used in combination; "an edged knife"; "a two-edged sword"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300763310">
	<b:glossaryEntry>suitable for cutting or piercing; "incisive teeth"; "the piercing needle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300763449"
	 b:glossaryEntry='having a sharp cutting edge or point; "a keen blade"'/>
<rdf:Description rdf:about="&a;300763552"
	 b:glossaryEntry="cutting or able to cut as if with a knife"/>
<rdf:Description rdf:about="&a;300763649">
	<b:glossaryEntry>tending to penetrate; "a toxic penetrative spray applied to the bark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300763776"
	 b:glossaryEntry='made sharp or sharper; "a sharpened knife cuts more cleanly"'/>
<rdf:Description rdf:about="&a;300763892">
	<b:glossaryEntry>keenly and painfully felt; as if caused by a sharp edge or point; "a sharp pain"; "sharp winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300764129">
	<b:glossaryEntry>extremely sharp or intense; "acute pain"; "felt acute annoyance"; "intense itching and burning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300764286">
	<b:glossaryEntry>as physically painful as if caused by a sharp instrument; "a cutting wind"; "keen winds"; "knifelike cold"; "piercing knifelike pains"; "piercing cold"; "piercing criticism"; "a stabbing pain"; "a gray world with ice and toothed winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300764616"
	 b:glossaryEntry="(medicine) sharp and piercing"/>
<rdf:Description rdf:about="&a;300764703">
	<b:glossaryEntry>(rare; of speech) painful; bitter; "salt scorn"- Shakespeare; "a salt apology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300764832"
	 b:glossaryEntry="(of a pain) as if caused by scraping with nails or claws"/>
<rdf:Description rdf:about="&a;300764945"
	 b:glossaryEntry='not keenly felt; "a dull throbbing"; "dull pain"'/>
<rdf:Description rdf:about="&a;300765062"
	 b:glossaryEntry='made or become less intense; "the deadened pangs of hunger"'/>
<rdf:Description rdf:about="&a;300765176">
	<b:glossaryEntry>full of events or incidents; "the most exhausting and eventful day of my life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300765327"
	 b:glossaryEntry='filled with events or activity; "a lively period in history"'/>
<rdf:Description rdf:about="&a;300765440">
	<b:glossaryEntry>marked by no noteworthy or significant events; "an uneventful life"; "the voyage was pleasant and uneventful"; "recovery was uneventful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300765651">
	<b:glossaryEntry>without untoward incident or disruption; "a placid existence"; "quiet times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300765788">
	<b:glossaryEntry>full of life and energy; "a lively discussion"; "lively and attractive parents"; "a lively party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300766190">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `with'') full of life and spirit; "she was wonderfully alive for her age"; "a face alive with mischief"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300766366">
	<b:glossaryEntry>marked by lively action; "a bouncing gait"; "bouncy tunes"; "the peppy and interesting talk"; "a spirited dance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300766569"
	 b:glossaryEntry='fresh and animated; "her breezy nature"'/>
<rdf:Description rdf:about="&a;300766661">
	<b:glossaryEntry>full of or showing high spirits; "bright bubbly children"; "a bubbly personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300766795">
	<b:glossaryEntry>marked by high spirits or excitement; "his fertile effervescent mind"; "scintillating personality"; "sparkling conversation"; "a row of sparkly cheerleaders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300767060">
	<b:glossaryEntry>uttered with unrestrained enthusiasm; "a novel told in burbly panting tones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300767221">
	<b:glossaryEntry>(informal) abounding with life and energy; "the club members are a really live bunch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300767357">
	<b:glossaryEntry>characterized by liveliness or excitement or disagreement; "a warm debate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300767482">
	<b:glossaryEntry>lacking in liveliness or animation; "he was so dull at parties"; "a dull political campaign"; "a large dull impassive man"; "dull days with nothing to do"; "how dull and dreary the world is"; "fell back into one of her dull moods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300767943">
	<b:glossaryEntry>lacking vitality or spirit; lifeless; "a technically perfect but arid performance of the sonata";l "a desiccate romance"; "a prissy and emotionless creature...settles into a mold of desiccated snobbery"-C.J.Rolo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300768230">
	<b:glossaryEntry>dull and slow-moving and stolid; like an ox; "showed a bovine apathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300768352">
	<b:glossaryEntry>lacking in liveliness or charm or surprise; "her drab personality"; "life was drab compared with the more exciting life style overseas"; "a series of dreary dinner parties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300768584">
	<b:glossaryEntry>lacking lightness or liveliness; "heavy humor"; "a leaden conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300768716">
	<b:glossaryEntry>tediously repetitious or lacking in variety; "a humdrum existence; all work and no play"; "nothing is so monotonous as the sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300768910">
	<b:glossaryEntry>lacking brilliance or vitality; "a dull lackluster life"; "a lusterless performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300769090">
	<b:glossaryEntry>characterized by action or forcefulness or force of personality; "a dynamic market"; "a dynamic speaker"; "the dynamic president of the firm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300769513">
	<b:glossaryEntry>in a state of habitual or vigorous activity; "an active man is a man of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300769645">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(slang) "a can-do kind of person"; "the city''s indomitable optimism and can-do spirit"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300769784"
	 b:glossaryEntry="marked by continuous change or effective action"/>
<rdf:Description rdf:about="&a;300769902">
	<b:glossaryEntry>having the power of driving or impelling; "a driving personal ambition"; "the driving force was his innate enthusiasm"; "an impulsive force"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300770108">
	<b:glossaryEntry>supplying motive force; "the complex civilization of which Rome was the kinetic center"- H.O.Taylor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300770287">
	<b:glossaryEntry>vigorously energetic or forceful; "a high-octane sales manager"; "a high-octane marketing plan"; "high-powered executives"; "a high-voltage theatrical entrepreneur"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300770552">
	<b:glossaryEntry>impelling or impelled forward; "a projectile force"; "a projectile missile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300770684">
	<b:glossaryEntry>tending to or capable of propelling; "propellant fuel for submarines"; "the faster a jet plane goes the greater its propulsive efficiency"; "universities...the seats of propulsive thought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300770968"
	 b:glossaryEntry="surging or sweeping back again"/>
<rdf:Description rdf:about="&a;300771066">
	<b:glossaryEntry>moved forward by its own force or momentum; "a self-propelled egotist"; "the arms program is now self-propelled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300771257">
	<b:glossaryEntry>as if striking with slashing blows; "his slashing demon-ridden cadenza"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300771383"
	 b:glossaryEntry="characterized by an absence of force or forcefulness"/>
<rdf:Description rdf:about="&a;300771538"
	 b:glossaryEntry="not growing or changing; without force or vitality"/>
<rdf:Description rdf:about="&a;300771654">
	<b:glossaryEntry>not active or moving; "a static village community and a completely undynamic type of agriculture"; "static feudal societies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300771844">
	<b:glossaryEntry>having or showing keen interest or intense desire or impatient expectancy; "eager to learn"; "eager to travel abroad"; "eager for success"; "eager helpers"; "an eager look"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300772140">
	<b:glossaryEntry>(colloquial) eagerly desirous; "anxious to see the new show at the museum"; "dying to hear who won"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300772307">
	<b:glossaryEntry>having or showing great eagerness or enthusiasm; "hot for travel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300772422">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') full of eagerness; "impatient to begin"; "raring to go"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300772575"
	 b:glossaryEntry='excessively eager; "overeager in his pursuit of the girl"'/>
<rdf:Description rdf:about="&a;300772688">
	<b:glossaryEntry>lacking interest or spirit or animation; "decrepit, colorless uneager things"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300772837">
	<b:glossaryEntry>not eager; "foreigners stubbornly uneager to accept our ways"; "fresh from college and uneager for the moment to marry him"; "reluctant to help"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300773037">
	<b:glossaryEntry>having ears (or appendages resembling ears) or having ears of a specified kind; often used in combination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300773230"
	 b:glossaryEntry="having auricles"/>
<rdf:Description rdf:about="&a;300773316"
	 b:glossaryEntry='having bent or drooping ears; "a lop-eared hound"'/>
<rdf:Description rdf:about="&a;300773421"
	 b:glossaryEntry='lacking external ears; "earless seals"'/>
<rdf:Description rdf:about="&a;300773513">
	<b:glossaryEntry>at or near the beginning of a period of time or course of events or before the usual or expected time; "early morning"; "an early warning"; "early diagnosis"; "an early death"; "took early retirement"; "an early spring"; "early varieties of peas and tomatoes mature before most standard varieties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300774150">
	<b:glossaryEntry>having existed from the beginning; in an earliest or original stage or state; "aboriginal forests"; "primal eras before the appearance of life on earth"; "the forest primeval"; "primordial matter"; "primordial forms of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300774476">
	<b:glossaryEntry>being ahead of time or need; "gave advance warning"; "was beforehand with her report"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300774634"
	 b:glossaryEntry="(geology) used of the earliest known rocks"/>
<rdf:Description rdf:about="&a;300774741">
	<b:glossaryEntry>(geology) formed in the earlier of two divisions of the Precambrian era; "archeozoic life forms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300774908">
	<b:glossaryEntry>(geology) before the appearance of life; "azoic rocks contain not organic remains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300775042">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative and superlative of `early'') more early than; most early; "a fashion popular in earlier times"; "his earlier work reflects the influence of his teacher"; "Verdi''s earliest and most raucous opera"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300775314"
	 b:glossaryEntry='being somewhat early; "at an earlyish hour"'/>
<rdf:Description rdf:about="&a;300775412">
	<b:glossaryEntry>pertaining to or occurring in the morning; "took his matutinal walk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300775536">
	<b:glossaryEntry>uncommonly early or before the expected time; "illness led to his premature death"; "alcohol brought him to an untimely end"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300775727">
	<b:glossaryEntry>too soon or too hasty; "our condemnation of him was a bit previous"; "a premature judgment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300775888">
	<b:glossaryEntry>(geology) formed in the later of two divisions of the Precambrian era; "proterozoic life forms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300776041">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(combining form) indicating the first or earliest or original; "`proto'' is a combining form in a word like `protolanguage'' that refers to the hypothetical ancestor of another language or group of languages"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300776302"
	 b:glossaryEntry='very early; "the wee hours of the morning"'/>
<rdf:Description rdf:about="&a;300776394">
	<b:glossaryEntry>between an earlier and a later period of time; "in the middle years"; "in his middle thirties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300776613">
	<b:glossaryEntry>occurring or falling between events or points in time; "so much had happened during the intervening years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300776777">
	<b:glossaryEntry>used in combination to denote the middle; "midmorning"; "midsummer"; "in mid-1958"; a mid-June wedding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300776933">
	<b:glossaryEntry>being or occurring at an advanced period of time or after a usual or expected time; "late evening"; "late 18th century"; "a late movie"; "took a late flight"; "had a late breakfast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300777309">
	<b:glossaryEntry>far along in time; "a man of advanced age"; "advanced in years"; "a ripe old age"; "the ripe age of 90"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300777474">
	<b:glossaryEntry>after closing time especially a legally established closing time; "after-hours socializing"; "an after-hours club"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300777646">
	<b:glossaryEntry>late or behind in fulfilling obligations; "an account in arrears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300777771">
	<b:glossaryEntry>more advanced in time or nearer to the end in a sequence; "these latter days"; "the latter (or last) part of the book"; "latter (or later) part of the l8th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300778012"
	 b:glossaryEntry="somewhat late"/>
<rdf:Description rdf:about="&a;300778078">
	<b:glossaryEntry xml:space='preserve'><![CDATA[occurring after a person''s death; (in the case of a child) born after the father''s death; "a posthumous award"; "a posthumous book"; "a posthumous child"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300778288">
	<b:glossaryEntry>being or occurring at an early stage of development; "in an early stage"; "early forms of life"; "early man"; "an early computer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300778594">
	<b:glossaryEntry>little evolved from or characteristic of an earlier ancestral type; "archaic forms of life"; "primitive mammals"; "the okapi is a short-necked primitive cousin of the giraffe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300778835">
	<b:glossaryEntry>(of crops) harvested at an early stage of development; before complete maturity; "baby carrots"; "new potatoes"; "young corn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300779025">
	<b:glossaryEntry>at a first stage of development; just becoming familiar with the rudiments or skills or routines; "a beginning bodybuilder"; "a beginning reader"; "a novice cook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300779258">
	<b:glossaryEntry>belonging to an early stage of technical development; characterized by simplicity and (often) crudeness; "the crude weapons and rude agricultural implements of early man"; "primitive movies of the 1890s"; "primitive living conditions in the Appalachian mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300779592">
	<b:glossaryEntry>in an early stage of development; "the embryo government staffed by survivors of the massacre"; "an embryonic nation, not yet self-governing"; "an idea in embryo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300779846">
	<b:glossaryEntry>only partly in existence; imperfectly formed; "incipient civil disorder"; "an incipient tumor"; "a vague inchoate idea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300780032">
	<b:glossaryEntry>(botany) appearing or developing early; "precocious flowers appear before the leaves as in some species of magnolias"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300780206">
	<b:glossaryEntry>at or toward an end or late period or stage of development; "the late phase of feudalism"; "a later symptom of the disease"; "later medical science could have saved the child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300780461">
	<b:glossaryEntry>comparatively late in a course of development; "the illness had reached an advanced stage"; "an advanced state of exhaustion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300780644">
	<b:glossaryEntry>(linguistics) of an early stage in the development of a language or literature; "the Early Hebrew alphabetical script is that used mainly from the 11th to the 6th centuries B.C."; "Early Modern English is represented in documents printed from 1476 to 1700"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300780988">
	<b:glossaryEntry>(linguistics) of a very early stage in development; "Old English is also called Anglo Saxon"; "Old High German is High German from the middle of the 9th to the end of the 11th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300781222">
	<b:glossaryEntry>(linguistics) of a stage in the development of a language or literature between earlier and later stages; "Middle English is the English language from about 1100 to 1500"; "Middle Gaelic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300781480">
	<b:glossaryEntry>(linguistics) of a later stage in the development of a language or literature; used especially of dead languages; "Late Greek"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300781711">
	<b:glossaryEntry>(linguistics) used of a living language; being the current stage in its development; "Modern English"; "New Hebrew is Israeli Hebrew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300781903">
	<b:glossaryEntry>(linguistics) in use after Medieval times; "New Eqyptian was the language of the 18th to 21st dynasties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300782057">
	<b:glossaryEntry>gained or acquired; especially through merit or as a result of effort or action; "a well-earned reputation for honesty"; "earned income"; "an earned run in baseball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300782293">
	<b:glossaryEntry>achieved or reached; "the actual attained achievement test score"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300782413">
	<b:glossaryEntry>not gained by merit or labor or service; "accepted the unearned rewards that came his ways as well as the unearned criticism"; "unearned income"; "an unearned run"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300782649">
	<b:glossaryEntry>given as an honor without the normal duties; "an honorary degree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300782769">
	<b:glossaryEntry>free from worry or anxiety; "knowing that I had done my best, my mind was easy"; "an easy good-natured manner"; "by the time the child faced the actual problem of reading she was familiar and at ease with all the elements words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300783094">
	<b:glossaryEntry>lacking a sense of security or affording no ease or reassurance; "farmers were uneasy until rain finally came"; "uneasy about his health"; "gave an uneasy laugh"; "uneasy lies the head that wears the crown"; "an uneasy coalition government"; "an uneasy calm"; "an uneasy silence fell on the group"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300783553">
	<b:glossaryEntry>mentally upset over possible misfortune or danger etc; worried; "anxious parents"; "anxious about her job"; "not used to a city and anxious about small things"; "felt apprehensive about the consequences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300783825"
	 b:glossaryEntry='affording no ease or reassurance; "a precarious truce"'/>
<rdf:Description rdf:about="&a;300783947">
	<b:glossaryEntry>not at ease or comfortable; "felt strange among so many important people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300784074"
	 b:glossaryEntry="situated in or facing or moving toward the east"/>
<rdf:Description rdf:about="&a;300784280"
	 b:glossaryEntry='moving toward the east; "eastbound trains"'/>
<rdf:Description rdf:about="&a;300784389">
	<b:glossaryEntry>from the east; used especially of winds; "an east wind"; "the winds are easterly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300784535">
	<b:glossaryEntry>lying in or toward the east; "the east side of NY"; "eastern cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300784668">
	<b:glossaryEntry>lying toward or situated in the east; "the eastern end of the island"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300784791"
	 b:glossaryEntry="farthest to the east"/>
<rdf:Description rdf:about="&a;300784880">
	<b:glossaryEntry>of the eastern part of a city e.g. Manhattan; "the eastside silk-stocking district"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300785018"
	 b:glossaryEntry="situated in or facing or moving toward the west"/>
<rdf:Description rdf:about="&a;300785224"
	 b:glossaryEntry='moving toward the west; "westbound pioneers"'/>
<rdf:Description rdf:about="&a;300785346">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lying toward or situated in the west; "our company''s western office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300785468"
	 b:glossaryEntry="of wind; from the west"/>
<rdf:Description rdf:about="&a;300785555"
	 b:glossaryEntry="lying in or toward the west"/>
<rdf:Description rdf:about="&a;300785647"
	 b:glossaryEntry="farthest to the west"/>
<rdf:Description rdf:about="&a;300785736">
	<b:glossaryEntry>of the western part of a city; "he lives in upper westside Manhattan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300785860">
	<b:glossaryEntry>relating to or characteristic of regions of western parts of the world; "the Western Hemisphere"; "Western Europe"; "the Western Roman Empire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300786092">
	<b:glossaryEntry>denoting or characteristic of countries of Europe and the Western Hemisphere; "occidental civilization"; "Hesperian culture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300786285">
	<b:glossaryEntry>relating to or characteristic of regions of eastern parts of the world; "the Eastern Hemisphere"; "Eastern Europe"; "the Eastern religions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300786532">
	<b:glossaryEntry xml:space='preserve'><![CDATA[denoting or characteristic of the biogeographic region including southern Asia and the Malay Archipelago as far as the Philippines and Borneo and Java; "Oriental politeness"; "for people of South and East Asian ancestry the term `Asian'' is preferred to `Oriental''"; "Asian ancestry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300786877"
	 b:glossaryEntry='(poetic) "the orient sun"'/>
<rdf:Description rdf:about="&a;300786955">
	<b:glossaryEntry>of or characteristic of regions of the United States west of the Mississippi River; "a Western ranch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300787200">
	<b:glossaryEntry>of a region of the United States generally including New Mexico; Arizona; Texas; California; and sometimes Nevada; Utah; Colorado</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300787388">
	<b:glossaryEntry>of a region of the United States generally including Ohio; Indiana; Illinois; Iowa; Missouri; Kansas; Nebraska; and sometimes Michigan; Wisconsin; Minnesota; "a midwestern city"; "midwestern accent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300787643">
	<b:glossaryEntry>of a region of the United States generally including Washington; Oregon; Idaho; and sometimes Montana; Wyoming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300787812">
	<b:glossaryEntry>of a region of the United States usually including Colorado; Nevada; Utah</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300787944">
	<b:glossaryEntry>of or characteristic of eastern regions of the United States; "the Eastern establishment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300788177">
	<b:glossaryEntry>of a region of the United States generally including Kentucky, West_Virginia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300788312">
	<b:glossaryEntry>of a region of the United States generally including Delaware; Maryland; Virginia; and usually New York; Pennsylvania; New Jersey; "mid-Atlantic states"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300788541">
	<b:glossaryEntry>of a region of the United States generally including the New England states; New York; and sometimes New Jersey and Pennsylvania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300788728">
	<b:glossaryEntry>of a region of the United States generally including Alabama; Georgia; Florida; Tennessee; South Carolina; North Carolina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300788908"
	 b:glossaryEntry="having a lightly-muscled build with long limbs"/>
<rdf:Description rdf:about="&a;300789066"
	 b:glossaryEntry="having a slender physique"/>
<rdf:Description rdf:about="&a;300789146"
	 b:glossaryEntry='having a squat and fleshy build; "a pyknic practical joke"'/>
<rdf:Description rdf:about="&a;300789325"
	 b:glossaryEntry='a chubby body; "the boy had a rounded face and fat cheeks"'/>
<rdf:Description rdf:about="&a;300789443">
	<b:glossaryEntry>(anatomy) having a robust muscular body-build characterized by predominance of structures (bone and muscle and connective tissue) developed from the embryonic mesodermal layer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300789723">
	<b:glossaryEntry>having a sturdy and well proportioned body; "an athletic build"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300789841"
	 b:glossaryEntry="suitable for use as food"/>
<rdf:Description rdf:about="&a;300790031"
	 b:glossaryEntry="fit to kill, especially for food"/>
<rdf:Description rdf:about="&a;300790118"
	 b:glossaryEntry="safe to eat"/>
<rdf:Description rdf:about="&a;300790199"
	 b:glossaryEntry="not suitable for food"/>
<rdf:Description rdf:about="&a;300790359"
	 b:glossaryEntry="not safe to eat"/>
<rdf:Description rdf:about="&a;300790430">
	<b:glossaryEntry>possessing an education (especially having more than average knowledge)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300790754">
	<b:glossaryEntry>highly educated; having extensive information or understanding; "an enlightened public"; "knowing instructors"; "a knowledgeable critic"; "a knowledgeable audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300791051">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(all used chiefly with qualifiers `well'' or `poorly'' or `un-'') having received specific instruction; "unschooled ruffians"; "well tutored applicants"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300791287"
	 b:glossaryEntry="able to read and write"/>
<rdf:Description rdf:about="&a;300791364">
	<b:glossaryEntry>educated by your own efforts rather than by formal instruction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300791486"
	 b:glossaryEntry="literate but poorly informed"/>
<rdf:Description rdf:about="&a;300791573"
	 b:glossaryEntry="not having a good education"/>
<rdf:Description rdf:about="&a;300791837">
	<b:glossaryEntry>ignorant of the fundamentals of a given art or branch of knowledge; "ignorant of quantum mechanics"; "musically illiterate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300792028">
	<b:glossaryEntry>lacking general education or knowledge; "an ignorant man"; "nescient of contemporary literature"; "an unlearned group incapable of understanding complex issues"; "exhibiting contempt for his unlettered companions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300792348"
	 b:glossaryEntry="poorly or insufficiently educated"/>
<rdf:Description rdf:about="&a;300792441">
	<b:glossaryEntry>lacking in schooling; "untaught people whose verbal skills are grossly deficient"; "an untutored genius"; "uneducated children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300792648">
	<b:glossaryEntry>lacking knowledge gained by study often in a particular field; "is unstudied in Latin as he is in may other matters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300792820"
	 b:glossaryEntry="able to understand and use numbers"/>
<rdf:Description rdf:about="&a;300792963">
	<b:glossaryEntry>adequately educated in the use of numerical terms and concepts especially in arithmetical operations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300793118">
	<b:glossaryEntry>lacking knowledge and understanding of mathematical concepts and methods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300793301">
	<b:glossaryEntry>not adequately educated in the use of numerical terms and concepts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300793424">
	<b:glossaryEntry>being in force or having or exerting force; "operative regulations"; "the major tendencies operative in the American political system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300793686">
	<b:glossaryEntry>having influence or producing an effect; "many emotional determinants at work"; "an operant conscience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300793856">
	<b:glossaryEntry>exerting force or influence; "the law is effective immediately"; "a warranty good for two years"; "the law is already in effect (or in force)"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300794090">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being in effect or operation; ; "de facto apartheid is still operational even in the `new'' African nations"- Leslie Marmon Silko; "bus service is in operation during the emergency"; "the company had several operating divisions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300794408">
	<b:glossaryEntry>serving to permit or facilitate further work or activity; "discussed the working draft of a peace treaty"; "they need working agreements with their neighbor states on interstate projects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300794649"
	 b:glossaryEntry='not operating; "an inoperative law"'/>
<rdf:Description rdf:about="&a;300794778">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not functioning; "we can''t work because the computer is down"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300794890">
	<b:glossaryEntry>no longer in force or use; inactive; "a defunct (or dead) law"; "a defunct organization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300795039">
	<b:glossaryEntry xml:space='preserve'><![CDATA[producing or capable of producing an intended result or having a striking effect; "an air-cooled motor was more effective than a witch''s broomstick for rapid long-distance transportation"-LewisMumford; "effective teaching methods"; "effective steps toward peace"; "made an effective entrance"; "his complaint proved to be effectual in bringing action"; "an efficacious law"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300795656">
	<b:glossaryEntry>characterized by or full of force and vigor; "a hard-hitting expose"; "a trenchant argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300795819">
	<b:glossaryEntry>markedly effective as if by emotional pressure; "impelling skill as a teller of tales"; "an impelling personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300795989">
	<b:glossaryEntry>producing a strong effect; "gave an impressive performance as Othello"; "a telling gesture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300796147">
	<b:glossaryEntry>not producing an intended effect; "an ineffective teacher"; "ineffective legislation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300796462">
	<b:glossaryEntry>lacking necessary force for effectiveness; "a toothless piece of legislation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300796595">
	<b:glossaryEntry>not producing desired results; "the talks between labor and management were unproductive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300796743">
	<b:glossaryEntry>sufficient to produce a result; "a man to whom painting was but another and less effectual way of writing dramas or novels or history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300796951">
	<b:glossaryEntry>not sufficient to produce a desired result; "an ineffectual effort to block the legislation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300797119"
	 b:glossaryEntry="requiring great physical effort"/>
<rdf:Description rdf:about="&a;300797350">
	<b:glossaryEntry>characterized by toilsome effort to the point of exhaustion; especially physical effort; "worked their arduous way up the mining valley"; "a grueling campaign"; "hard labor"; "heavy work"; "heavy going"; "spent many laborious hours on the project"; "set a punishing pace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300797776">
	<b:glossaryEntry>requiring much effort and trouble; "the mountain climb was long, steep, and difficult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300797918">
	<b:glossaryEntry>marked by a painfully slow and effortful manner; "it was a strange dragging approach"; "years of dragging war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300798083">
	<b:glossaryEntry>producing exhaustion; "an exhausting march"; "the visit was especially wearing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300798249">
	<b:glossaryEntry>requiring or showing effort; "heavy breathing"; "the subject made for labored reading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300798408"
	 b:glossaryEntry='(of movement) slow and laborious; "leaden steps"'/>
<rdf:Description rdf:about="&a;300798520">
	<b:glossaryEntry>taxing to the utmost; testing powers of endurance; "his final, straining burst of speed"; "a strenuous task"; "your willingness after these six arduous days to remain here"- F.D.Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300798785">
	<b:glossaryEntry>requiring or apparently requiring no effort; "the swallows glided in an effortless way through the busy air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300799004">
	<b:glossaryEntry>performing adroitly and without effort; "her easy grace"; "a facile hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300799137">
	<b:glossaryEntry>not resulting from undue effort; not forced; "a voice with a pleasingly unforced quality"; "his playing is facile and unstrained"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300799334">
	<b:glossaryEntry>marked by qualities giving the power to produce an intended effect; "written propaganda is less efficacious than the habits and prejudices...of the readers"-Aldous Huxley; "the medicine is efficacious in stopping a cough"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300799667">
	<b:glossaryEntry>works well as a means or remedy; "an effective reprimand"; "a lotion that is effective in cases of prickly heat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300799835">
	<b:glossaryEntry>lacking the power to produce a desired effect; "laws that are inefficacious in stopping crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300800025">
	<b:glossaryEntry>being effective without wasting time or effort or expense; "an efficient production manager"; "efficient engines save gas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300800347">
	<b:glossaryEntry>exhibiting methodical and systematic characteristics that would be useful in business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300800491">
	<b:glossaryEntry>using the minimum of time or resources necessary for effectiveness; "an economic use of home heating oil"; "a modern economical heating system"; "an economical use of her time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300800735"
	 b:glossaryEntry="characterized by speed and efficiency"/>
<rdf:Description rdf:about="&a;300800852"
	 b:glossaryEntry="used of gasoline; having a high octane number"/>
<rdf:Description rdf:about="&a;300800955">
	<b:glossaryEntry>made efficient by stripping off nonessentials; "short streamlined meetings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300801088"
	 b:glossaryEntry="not spending at the normal rate"/>
<rdf:Description rdf:about="&a;300801176">
	<b:glossaryEntry>not producing desired results; wasteful; "an inefficient campaign against drugs"; "outdated and inefficient design and methods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300801415">
	<b:glossaryEntry>inefficient in use of time and effort and materials; "a clumsy and wasteful process"; "wasteful duplication of effort"; "uneconomical ebb and flow of power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300801641">
	<b:glossaryEntry>characterized by or full of force or strength (often but not necessarily physical); "a forceful speaker"; "a forceful personality"; "forceful measures"; "a forceful plan for peace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300802038">
	<b:glossaryEntry>brutally forceful and compelling; "protected from the bruising facts of battle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300802172">
	<b:glossaryEntry>powerfully persuasive; "a cogent argument"; "a telling presentation"; "a weighty argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300802335"
	 b:glossaryEntry='forceful and extreme and rigorous; "drastic measures"'/>
<rdf:Description rdf:about="&a;300802442"
	 b:glossaryEntry='sudden and strong; "an emphatic no"'/>
<rdf:Description rdf:about="&a;300802546">
	<b:glossaryEntry>strong and sure; "a firm grasp"; "gave a strong pull on the rope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300802671">
	<b:glossaryEntry>impelled by physical force especially against resistance; "forcible entry"; "a real cop would get physical"; "strong-arm tactics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300802879">
	<b:glossaryEntry>forcing forward or onward; impelling; "an impellent power"; "an impellent cause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300803015"
	 b:glossaryEntry='marked by violent force; "impetuous heving waves"'/>
<rdf:Description rdf:about="&a;300803120"
	 b:glossaryEntry='quick and forceful; "a sharp blow"'/>
<rdf:Description rdf:about="&a;300803206"
	 b:glossaryEntry='lacking force; feeble; "a forceless argument"'/>
<rdf:Description rdf:about="&a;300803345"
	 b:glossaryEntry="weak and ineffectual"/>
<rdf:Description rdf:about="&a;300803427">
	<b:glossaryEntry>capable of resuming original shape after stretching or compression; springy; "an elastic band"; "a youthful and elastic walk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300803840">
	<b:glossaryEntry>rebounds readily; "clean bouncy hair"; "a lively tennis ball"; "as resiliant as seasoned hickory"; "springy turf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300804053"
	 b:glossaryEntry='of a consistency requiring chewing; "chewy caramels"'/>
<rdf:Description rdf:about="&a;300804157">
	<b:glossaryEntry>capable of being shaped or bent or drawn out; "ductile copper"; "malleable metals such as gold"; "they soaked the leather to made it pliable"; "pliant molten glass"; "made of highly tensile steel alloy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300804465">
	<b:glossaryEntry>made with strands or inserts of elastic; "slacks with an elasticized waistband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300804602"
	 b:glossaryEntry="(of gases) capable of expansion"/>
<rdf:Description rdf:about="&a;300804728">
	<b:glossaryEntry>capable of being molded or modeled (especially of earth or clay or other soft material); "plastic substances such as wax or clay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300804932"
	 b:glossaryEntry="bends and snaps back readily without breaking"/>
<rdf:Description rdf:about="&a;300805032"
	 b:glossaryEntry="having a texture resembling rubber"/>
<rdf:Description rdf:about="&a;300805133"
	 b:glossaryEntry="resembling a spring or the action of a spring"/>
<rdf:Description rdf:about="&a;300805235"
	 b:glossaryEntry='easily stretched; "stretch hosiery"'/>
<rdf:Description rdf:about="&a;300805324">
	<b:glossaryEntry>capable of being easily stretched and resuming former size or shape</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300805460"
	 b:glossaryEntry="(physics) having viscous as well as elastic properties"/>
<rdf:Description rdf:about="&a;300805573">
	<b:glossaryEntry>not elastic; "economists speak of an inelastic price structure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300805764"
	 b:glossaryEntry='lacking resilience or bounce; "a dead tennis ball"'/>
<rdf:Description rdf:about="&a;300805865"
	 b:glossaryEntry="not resilient"/>
<rdf:Description rdf:about="&a;300805937">
	<b:glossaryEntry>lacking in elasticity or vitality; "went off with springless steps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300806061"
	 b:glossaryEntry='subject to popular election; "elective official"'/>
<rdf:Description rdf:about="&a;300806210"
	 b:glossaryEntry='relating to or composed of electors; "electoral college"'/>
<rdf:Description rdf:about="&a;300806322"
	 b:glossaryEntry="filled by popular election rather than by appointment"/>
<rdf:Description rdf:about="&a;300806435"
	 b:glossaryEntry="subject to appointment"/>
<rdf:Description rdf:about="&a;300806562"
	 b:glossaryEntry="appointed by nomination"/>
<rdf:Description rdf:about="&a;300806654">
	<b:glossaryEntry>filled by appointment rather than by election; "a nonappointive office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300806783">
	<b:glossaryEntry>appointed to a post or duty; "assigned personnel"; "assigned duties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300806942"
	 b:glossaryEntry='given as a task; "her allotted chores"'/>
<rdf:Description rdf:about="&a;300807035"
	 b:glossaryEntry='selected for a job; "the one appointed for guard duty"'/>
<rdf:Description rdf:about="&a;300807145"
	 b:glossaryEntry='not assigned; "unassigned personnel"'/>
<rdf:Description rdf:about="&a;300807238"
	 b:glossaryEntry="possible but not necessary; left to personal choice"/>
<rdf:Description rdf:about="&a;300807416">
	<b:glossaryEntry>not compulsory; "elective surgery"; "an elective course of study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300807536">
	<b:glossaryEntry>as a favor; not compelled by legal right; "ex gratia payments made to nonstriking workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300807682"
	 b:glossaryEntry='not compulsory; "facultative courses in the sciences"'/>
<rdf:Description rdf:about="&a;300807793"
	 b:glossaryEntry="not required by rule or law"/>
<rdf:Description rdf:about="&a;300807895">
	<b:glossaryEntry>morally or legally constraining or binding; "attendance is obligatory"; "an obligatory contribution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300808196"
	 b:glossaryEntry='morally obligatory; "my bounden duty"'/>
<rdf:Description rdf:about="&a;300808287">
	<b:glossaryEntry>required by rule; "in most schools physical education are compulsory"; "attendance is mandatory"; "required reading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300808483">
	<b:glossaryEntry>required by etiquette or usage or fashion; "instruction as to when and where a silk hat is de rigueur"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300808642">
	<b:glossaryEntry>set forth authoritatively as obligatory; "the imposed taxation"; "rules imposed by society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300808787">
	<b:glossaryEntry>morally binding or necessary; "it is incumbent on me to attend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300808912">
	<b:glossaryEntry>unavoidable; "the routine but indispensable ceremonies of state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300809036"
	 b:glossaryEntry="required as a prior condition or course of study"/>
<rdf:Description rdf:about="&a;300809143">
	<b:glossaryEntry>refined and tasteful in appearance or behavior or style; "elegant handwriting"; "an elegant dark suit"; "she was elegant to her fingertips"; "small churches with elegant white spires"; "an elegant mathematical solution--simple and precise and lucid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300809716">
	<b:glossaryEntry>small and elegant; "bijou villas"; "can Americans be persuaded to pay out dollars for bijou cars?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300809866"
	 b:glossaryEntry="affecting extreme elegance in dress and manner"/>
<rdf:Description rdf:about="&a;300809989">
	<b:glossaryEntry>elegant and sumptuous; "a deluxe car"; "luxe accommodations"; "a luxury condominium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300810155">
	<b:glossaryEntry>characterized by elegance or refinement; "looking fine in her Easter suit"; "a fine gentleman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300810300"
	 b:glossaryEntry='pretentiously elegant; "a high-toned restaurant"'/>
<rdf:Description rdf:about="&a;300810418"
	 b:glossaryEntry="lavishly elegant and refined"/>
<rdf:Description rdf:about="&a;300810514">
	<b:glossaryEntry>free from what is tawdry or unbecoming; "a neat style"; "a neat set of rules"; "she hated to have her neat plans upset"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300810705"
	 b:glossaryEntry="(informal) luxuriously elegant"/>
<rdf:Description rdf:about="&a;300810787">
	<b:glossaryEntry>cleverly simple; used of e.g. a solution to a problem; "his proposal is elegantly simple"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300810929"
	 b:glossaryEntry="polished and well-groomed; showing sophisticated elegance"/>
<rdf:Description rdf:about="&a;300811049"
	 b:glossaryEntry="lacking in refinement or grace or good taste"/>
<rdf:Description rdf:about="&a;300811257">
	<b:glossaryEntry>lacking social polish; "too gauche to leave the room when the conversation became intimate"; "their excellent manners always may be feel gauche"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300811479">
	<b:glossaryEntry>without artificial refinement or elegance; "plain homely furniture"; "homely manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300811617">
	<b:glossaryEntry xml:space='preserve'><![CDATA[qualified for or allowed or worthy of being chosen; "eligible to run for office"; "eligible for retirement benefits"; "an eligible bachelor'']]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300811939"
	 b:glossaryEntry='eligible for bail; "a bailable defendant"'/>
<rdf:Description rdf:about="&a;300812035">
	<b:glossaryEntry>worthy of being chosen especially as a spouse; "the parents found the girl suitable for their son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300812209">
	<b:glossaryEntry>qualified for by right according to law; "we are all entitled to equal protection under the law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300812360">
	<b:glossaryEntry>awaiting something; especially something due; "people were in line at the checkout counter"; "she was in line for promotion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300812538"
	 b:glossaryEntry='(sports) allowed by official rules; "a legal pass receiver"'/>
<rdf:Description rdf:about="&a;300812649"
	 b:glossaryEntry='entitled to receive a pension; "a pensionable employee"'/>
<rdf:Description rdf:about="&a;300812762">
	<b:glossaryEntry>not eligible; "ineligible to vote"; "ineligible for retirement benefits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300812981"
	 b:glossaryEntry="disqualified by law or rule or provision"/>
<rdf:Description rdf:about="&a;300813080">
	<b:glossaryEntry>(sports) barred from competition for violation of rules; "a disqualified player"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300813219"
	 b:glossaryEntry="not worthy of being chosen (especially as a spouse)"/>
<rdf:Description rdf:about="&a;300813341">
	<b:glossaryEntry>having no right or entitlement; "a distinction to which he was unentitled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300813486">
	<b:glossaryEntry>of more than usual emotion; "his behavior was highly emotional"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300813947"
	 b:glossaryEntry="characterized by emotion"/>
<rdf:Description rdf:about="&a;300814051">
	<b:glossaryEntry>effusively or insincerely emotional; "a bathetic novel"; "maudlin expressons of sympathy"; "mushy effusiveness"; "a schmaltzy song"; "sentimental soap operas"; "slushy poetry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300814355"
	 b:glossaryEntry="emotionally purging (of e.g. art)"/>
<rdf:Description rdf:about="&a;300814456">
	<b:glossaryEntry>fraught with great emotion; "an atmosphere charged with excitement"; "an emotionally charged speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300814625"
	 b:glossaryEntry="(of jazz) having the soulful feeling of early blues"/>
<rdf:Description rdf:about="&a;300814739">
	<b:glossaryEntry>(informal) worked up emotionally by anger or excitement; "was terribly het up over the killing of the eagle"; "got really het up over the new taxes"; "he was suddenly het up about racing cars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300814987"
	 b:glossaryEntry='prone to emotion; "hot-blooded Latin-Americans"'/>
<rdf:Description rdf:about="&a;300815092">
	<b:glossaryEntry>having or resembling the psychology or temper characteristic of people of Latin America; "very Latin in temperament"; "a Latin disdain"; "his hot Latin blood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300815302">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expressing deep personal emotion; "the dancer''s lyrical performance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300815432">
	<b:glossaryEntry>intensely affecting the mind or emotions; "spending a week in the jungle was a mind-blowing experience"; "a mind-blowing horror story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300815625">
	<b:glossaryEntry>subject to sharply varying moods; "a temperamental opera singer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300815757"
	 b:glossaryEntry="excessively or abnormally emotional"/>
<rdf:Description rdf:about="&a;300815852">
	<b:glossaryEntry>full of or expressing deep emotion; "soulful eyes"; "soulful music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300815973"
	 b:glossaryEntry="used of music"/>
<rdf:Description rdf:about="&a;300816043"
	 b:glossaryEntry="unsusceptible to or destitute of or showing no emotion"/>
<rdf:Description rdf:about="&a;300816371">
	<b:glossaryEntry>not characterized by emotion; "a female form in marble--a chilly but ideal medium for depicting abstract virtues"-C.W.Cunningham</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300816552">
	<b:glossaryEntry>lacking warmth or emotional involvement; "a dry greeting"; "a dry reading of the lines"; "a dry critique"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300816707">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having or revealing little emotion or sensibility; not easily aroused or excited; "her impassive remoteness"; "he remained impassive, showing neither interest in nor concern for our plight"- Nordhoff & Hall; "a silent stolid creature who took it all as a matter of course"-Virginia Woolf; "her face showed nothing but stolid indifference"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300817110">
	<b:glossaryEntry>characterized by the attitude of a philosopher; meeting trouble with level-headed detachment; "philosophical resignation"; "a philosophic attitude toward life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300817343">
	<b:glossaryEntry>showing little emotion; "a phlegmatic...and certainly undemonstrative man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300817489">
	<b:glossaryEntry>seeming unaffected by pleasure or pain; impassive; "stoic courage"; "stoic patience"; "a stoical sufferer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300817657">
	<b:glossaryEntry>showing no visible emotion; "stood unblinking and accepted a sentence of a year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300817794">
	<b:glossaryEntry>derived from experiment and observation rather than theory; "an empirical basis for an ethical theory"; "empirical laws"; "empirical data"; "an empirical treatment of a disease about which little is known"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300818181"
	 b:glossaryEntry="requiring evidence for validation or support"/>
<rdf:Description rdf:about="&a;300818284">
	<b:glossaryEntry>capable of being verified or disproved by experiment or observation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300818422">
	<b:glossaryEntry>derived from experience or the experience of existence; "the rich experiential content of the teachings of the older philosophers"- Benjamin Farrington; "formal logicians are not concerned with existential matters"- John Dewey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300818721">
	<b:glossaryEntry>relying on observation or experiment; "experimental results that supported the hypothesis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300818899">
	<b:glossaryEntry>of the nature of or undergoing an experiment; "an experimental drug"; "a pilot project"; "a test run"; "a trial separation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300819124"
	 b:glossaryEntry="relying to some extent on observation or experiment"/>
<rdf:Description rdf:about="&a;300819235">
	<b:glossaryEntry>trying out various means or theories until error is satisfactorily reduced or eliminated; "he argued that all learning is a trial-and-error process that resembles biological evolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300819481">
	<b:glossaryEntry>concerned primarily with theories or hypotheses rather than practical considerations; "theoretical science"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300819784">
	<b:glossaryEntry>of an abstracting nature or having the power of abstracting; "abstractive analysis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300819925"
	 b:glossaryEntry="based on hypothesis or theory rather than experiment"/>
<rdf:Description rdf:about="&a;300820032">
	<b:glossaryEntry>based primarily on surmise rather than adequate evidence; "theories about the extinction of dinosaurs are still highly conjectural"; "the supposed reason for his absence"; "suppositious reconstructions of dead languages"; "supposititious hypotheses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300820398">
	<b:glossaryEntry>based on hypothesis; "a hypothetical situation"; "the site of a hypothetical colony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300820554">
	<b:glossaryEntry>not based on fact or investigation; "a notional figure of cost helps in determining production costs"; "speculative knowledge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300820749">
	<b:glossaryEntry>highly abstract and over-theoretical; "metaphysical reasoning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300820870">
	<b:glossaryEntry>based in theory rather than experiment; "theory-based arguments and positions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300821007">
	<b:glossaryEntry>concerned with theories rather than their practical applications; "theoretical physics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300821206">
	<b:glossaryEntry>dealing with a subject in the abstract without practical purpose or intention; "abstract reasoning"; "abstract science"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300821380">
	<b:glossaryEntry>hypothetical or theoretical and not expected to produce an immediate or practical result; "an academic discussion"; "an academic question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300821573">
	<b:glossaryEntry>concerned with theory and data rather than practice; opposed to applied; "pure science"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300821711">
	<b:glossaryEntry>concerned with concrete problems or data rather than with fundamental principles; opposed to theoretical; "applied physics"; "applied psychology"; "technical problems in medicine, engineering, economics and other applied disciplines"- Sidney Hook</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300822029">
	<b:glossaryEntry>having or put to a practical purpose or use; "practical mathematics"; "practical applications of calculus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300822191">
	<b:glossaryEntry>having your services engaged for; or having a job especially one that pays wages or a salary; "most of our graduates are employed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300822466">
	<b:glossaryEntry>having services contracted for; "the carpenter engaged (or employed) for the job is sick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300822609"
	 b:glossaryEntry="working for yourself"/>
<rdf:Description rdf:about="&a;300822704">
	<b:glossaryEntry>having services engaged for a fee; "hired hands"; "a hired gun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300822819">
	<b:glossaryEntry>actively engaged in paid work; "the working population"; "the ratio of working men to unemployed"; "a working mother"; "robots can be on the job day and night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300823051">
	<b:glossaryEntry>not engaged in a gainful occupation; "unemployed workers marched on the capital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300823260"
	 b:glossaryEntry="idle; between jobs; (euphemism for `unemployed'')"/>
<rdf:Description rdf:about="&a;300823368"
	 b:glossaryEntry="having lost your job"/>
<rdf:Description rdf:about="&a;300823491">
	<b:glossaryEntry>not having a job; "idle carpenters"; "jobless transients"; "many people in the area were out of work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300823667">
	<b:glossaryEntry>physically and mentally capable of working a a regular job and available</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300823796">
	<b:glossaryEntry>not acceptable for employment as a worker; "his illiteracy made him unemployable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300823936"
	 b:glossaryEntry="influenced as by charms or incantations"/>
<rdf:Description rdf:about="&a;300824085"
	 b:glossaryEntry="filled with wonder and delight"/>
<rdf:Description rdf:about="&a;300824230"
	 b:glossaryEntry="under a spell"/>
<rdf:Description rdf:about="&a;300824313"
	 b:glossaryEntry="having your attention fixated as though by a spell"/>
<rdf:Description rdf:about="&a;300824498"
	 b:glossaryEntry="freed from enchantment"/>
<rdf:Description rdf:about="&a;300824633">
	<b:glossaryEntry>freed of a mistaken or misguided notion; "some people are still not disabused of the old idea that the universe revolves around the Earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300824843"
	 b:glossaryEntry="freed from illusion"/>
<rdf:Description rdf:about="&a;300824936">
	<b:glossaryEntry>giving courage or confidence or hope; "encouraging advances in medical research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300825200"
	 b:glossaryEntry="giving strong encouragement"/>
<rdf:Description rdf:about="&a;300825323"
	 b:glossaryEntry="cheerfully encouraging"/>
<rdf:Description rdf:about="&a;300825416"
	 b:glossaryEntry="tending to further or encourage"/>
<rdf:Description rdf:about="&a;300825503">
	<b:glossaryEntry>rousing or recalling to unity and renewed effort; "a rallying cry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300825624">
	<b:glossaryEntry>depriving of confidence or hope or enthusiasm and hence often deterring action; "where never is heard a discouraging word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300825931"
	 b:glossaryEntry="discouraging through fear"/>
<rdf:Description rdf:about="&a;300826026"
	 b:glossaryEntry="destructive of morale and self-reliance"/>
<rdf:Description rdf:about="&a;300826169"
	 b:glossaryEntry="discouraging by hindering"/>
<rdf:Description rdf:about="&a;300826252"
	 b:glossaryEntry="not encouraging"/>
<rdf:Description rdf:about="&a;300826327">
	<b:glossaryEntry>loaded to excess or impeded by a heavy load; "a summer resort...encumbered with great clapboard-and-stucco hotels"- A.J.Liebling; "a hiker encumbered with a heavy backpack"; "an encumbered estate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300826652">
	<b:glossaryEntry>bearing a physically heavy weight or load; "tree limbs burdened with ice"; "a heavy-laden cart"; "loaded down with packages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300826859">
	<b:glossaryEntry>loaded with something that hinders motion; "The wings of birds were clogged with ice and snow"-Dryden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300827014">
	<b:glossaryEntry>entangled or hindered as if e.g. in mire; "the difficulties in which the question is involved"; "brilliant leadership mired in details and confusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300827226">
	<b:glossaryEntry>burdened with legal or financial obligations; "his house, his business, indeed, his whole life was heavily mortgaged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300827399"
	 b:glossaryEntry='free of encumbrance; "inherited an unencumbered estate"'/>
<rdf:Description rdf:about="&a;300827549"
	 b:glossaryEntry="not encumbered with a physical burden or load"/>
<rdf:Description rdf:about="&a;300827664">
	<b:glossaryEntry>(especially of a title) "I have clear title to this property"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300827791">
	<b:glossaryEntry>bearing a heavy burden of work or difficulties or responsibilities; "she always felt burdened by the load of paper work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300828020">
	<b:glossaryEntry>heavily burdened with work or cares; "bowed_down with troubles"; "found himself loaded down with responsibilities"; "overburdened social workers"; "weighed down with cares"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300828302">
	<b:glossaryEntry>burdened psychologically or mentally; "laden with grief"; "oppressed by a sense of failure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300828457">
	<b:glossaryEntry>subject to an imposed burden; "left me saddled with the bill"; "found himself saddled with more responsibility than power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300828633">
	<b:glossaryEntry>not burdened with difficulties or responsibilities; "unburdened by an overarching theory"- Alex Inkeles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300828811">
	<b:glossaryEntry>not burdened with cares or responsibilities; "living an unencumbered life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300828944">
	<b:glossaryEntry>grammar; fulfilling the grammatical role of one of its constituents--as "three blind mice"--which serves as a noun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300829116">
	<b:glossaryEntry>grammar; not fulfilling the same grammatical role of any of its constituents--as "until last Easter"--which serves as an adverb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300829300"
	 b:glossaryEntry="(anthropology)"/>
<rdf:Description rdf:about="&a;300829389">
	<b:glossaryEntry>of marriage within a class or tribe as required by custom or law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300829524"
	 b:glossaryEntry="(anthropology)"/>
<rdf:Description rdf:about="&a;300829630">
	<b:glossaryEntry>of marriage outside a class or tribe as required by custom or law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300829766"
	 b:glossaryEntry="(biology)"/>
<rdf:Description rdf:about="&a;300829868"
	 b:glossaryEntry="fertilized by its own pollen"/>
<rdf:Description rdf:about="&a;300829976"
	 b:glossaryEntry="(biology)"/>
<rdf:Description rdf:about="&a;300830078"
	 b:glossaryEntry="fertilized by pollen from another flower of the same plant"/>
<rdf:Description rdf:about="&a;300830192"
	 b:glossaryEntry="(biology)"/>
<rdf:Description rdf:about="&a;300830293"
	 b:glossaryEntry="reproduced by fusion of gametes of different ancestries"/>
<rdf:Description rdf:about="&a;300830403"
	 b:glossaryEntry="(of a nuclear reaction) occurring with absorption of energy"/>
<rdf:Description rdf:about="&a;300830555">
	<b:glossaryEntry>(of a nuclear reaction) occurring with evolution or releasing of energy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300830718">
	<b:glossaryEntry>(of a chemical reaction or compound) occurring or formed with absorption of heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300830905">
	<b:glossaryEntry>(of a chemical reaction or compound) occurring or formed with evolution of heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300831089"
	 b:glossaryEntry="derived or originating internally"/>
<rdf:Description rdf:about="&a;300831197"
	 b:glossaryEntry="endogenous"/>
<rdf:Description rdf:about="&a;300831277"
	 b:glossaryEntry="derived or originating externally"/>
<rdf:Description rdf:about="&a;300831402"
	 b:glossaryEntry="exogenous"/>
<rdf:Description rdf:about="&a;300831479"
	 b:glossaryEntry="exogenous"/>
<rdf:Description rdf:about="&a;300831543"
	 b:glossaryEntry="(verse) having a rhetorical pause at the end of each line"/>
<rdf:Description rdf:about="&a;300831658"
	 b:glossaryEntry="(verse) without a rhetorical pause between lines"/>
<rdf:Description rdf:about="&a;300831759">
	<b:glossaryEntry>possessing or exerting or displaying energy; "an energetic fund raiser for the college"; "an energetic group of hikers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300832150">
	<b:glossaryEntry>characterized by energetic bodily activity; "tennis is an active sport"; "a very physical dance performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300832322">
	<b:glossaryEntry>quick and energetic; "a brisk walk in the park"; "a lively gait"; "a merry chase"; "traveling at a rattling rate"; "a snappy pace"; "a spanking breeze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300832581"
	 b:glossaryEntry="(British) lively and brisk"/>
<rdf:Description rdf:about="&a;300832659">
	<b:glossaryEntry>acting with vigor; "responsibility turned the spoiled playboy into a driving young executive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300832806">
	<b:glossaryEntry>showing sustained enthusiastic action with unflagging vitality; "an indefatigable advocate of equal rights"; "a tireless worker"; "unflagging pursuit of excellence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300833067">
	<b:glossaryEntry>characterized by or performed with much energy or force; "strenuous exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300833200">
	<b:glossaryEntry>characterized by forceful and energetic action or activity; "a vigorous hiker"; "gave her skirt a vigorous shake"; "a vigorous campaign"; "a vigorous foreign policy"; "vigorous opposition to the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300833454">
	<b:glossaryEntry>deficient in alertness or activity; "bullfrogs became lethargic with the first cold nights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300833685">
	<b:glossaryEntry>stunned or confused and slow to react (as from blows or drunkenness or exhaustion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300833855">
	<b:glossaryEntry>lacking spirit or liveliness; "a lackadaisical attempt"; "a languid mood"; "a languid wave of the hand"; "a hot languorous afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300834080"
	 b:glossaryEntry='lacking zest or vivacity; "he was listless and bored"'/>
<rdf:Description rdf:about="&a;300834188">
	<b:glossaryEntry>endowed with the rights of citizenship especially the right to vote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300834314">
	<b:glossaryEntry>deprived of the rights of citizenship especially the right to vote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300834469"
	 b:glossaryEntry='suitable for export; "exportable cultural schievements"'/>
<rdf:Description rdf:about="&a;300834599"
	 b:glossaryEntry='capable of being marketed; "the marketable surplus"'/>
<rdf:Description rdf:about="&a;300834707"
	 b:glossaryEntry="not suitable for export"/>
<rdf:Description rdf:about="&a;300834789">
	<b:glossaryEntry>serving in or intended for exploration or discovery; "an exploratory operation"; "exploratory reconnaisance"; "digging an exploratory well in the Gulf of Mexico"; "exploratory talks between diplomats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300835115">
	<b:glossaryEntry>designed to orient or acquaint with the a situation before proceeding; "a preliminary investigation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300835273"
	 b:glossaryEntry="exploring thoroughly"/>
<rdf:Description rdf:about="&a;300835349">
	<b:glossaryEntry>(of a mine or oil well) drilled speculatively in an area not known to be productive; "drilling there would be strictly a wildcat operation"; "a wildcat mine"; "wildcat drilling"; "wildcat wells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300835597"
	 b:glossaryEntry="not exploratory"/>
<rdf:Description rdf:about="&a;300835722"
	 b:glossaryEntry='given to inquiry; "an inquiring mind"'/>
<rdf:Description rdf:about="&a;300835923">
	<b:glossaryEntry>designed to find information or ascertain facts; "a fact-finding committee"; "investigative reporting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300836116">
	<b:glossaryEntry>inquiring or appearing to inquire; "an inquiring look"; "the police are proverbially inquisitive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300836271">
	<b:glossaryEntry>having the authority to conduct official investigations; "the inquisitorial power of the Senate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300836427">
	<b:glossaryEntry>marked by inquisitive interest; especially suggestive of an ecclesiastical inquisitor; "the press was inquisitorial to the point of antagonism"; "a practical police force with true inquisitorial talents"- Waldo Frank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300836703">
	<b:glossaryEntry>diligent and thorough in inquiry or investigation; "a probing inquiry"; "a searching investigation of their past dealings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300836905"
	 b:glossaryEntry="not inquiring"/>
<rdf:Description rdf:about="&a;300836992"
	 b:glossaryEntry="made greater in size or amount or degree"/>
<rdf:Description rdf:about="&a;300837232">
	<b:glossaryEntry>periodically accumulated over time; "accrued interest"; "accrued leave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300837371">
	<b:glossaryEntry>added to or made greater in amount or number or strength; "his augmented renown"; "a greatly augmented collection of books"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300837550">
	<b:glossaryEntry xml:space='preserve'><![CDATA[increased or intensified in value or beauty or quality; "her enhanced beauty was the result of a good night''s sleep rather than makeup"; "careful cleaning was responsible for the enhanced value of the painting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300837815">
	<b:glossaryEntry>enlarged beyond truth or reasonableness; "had an exaggerated (or inflated) opinion of himself"; "a hyperbolic style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300838013">
	<b:glossaryEntry>enlarged to an abnormal degree; "thick lenses exaggerated the size of her eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300838173"
	 b:glossaryEntry="greatly increased as by multiplication"/>
<rdf:Description rdf:about="&a;300838268">
	<b:glossaryEntry>increased especially to abnormal levels; "the raised prices frightened away customers"; "inflated wages"; "an inflated economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300838462">
	<b:glossaryEntry>become much greater in intensity or size or amount; "we faced redoubled attacks from the enemy"; "despite our redoubled efforts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300838646"
	 b:glossaryEntry="made less in size or amount or degree"/>
<rdf:Description rdf:about="&a;300838929">
	<b:glossaryEntry xml:space='preserve'><![CDATA[made smaller or less by melting or erosion or vaporization; "the rocket''s ablated head shield"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300839077"
	 b:glossaryEntry='reduced in strength; "the faded tones of an old recording"'/>
<rdf:Description rdf:about="&a;300839223">
	<b:glossaryEntry>(electronics) of an electrical signal; reduced in amplitude with little or no distortion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300839368">
	<b:glossaryEntry>diminished or moderated; "our bated enthusiasm"; "his bated hopes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300839486">
	<b:glossaryEntry>made to seem smaller or less (especially in worth); "her comments made me feel small"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300839648">
	<b:glossaryEntry>(used of rates or prices) reduced usually sharply; "the slashed prices attracted buyers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300839796">
	<b:glossaryEntry>(of musical intervals) reduction by a semitone of any perfect or minor musical interval; "a diminished fifth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300839962"
	 b:glossaryEntry="reduced to the smallest possible size or amount or degree"/>
<rdf:Description rdf:about="&a;300840075">
	<b:glossaryEntry>(of a disease) characterized by periods of diminished severity; "a remittent fever"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300840214">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reduced in efficacy or vitality or intensity; "our shriveled receipts during the storm"; "as the project wore on she found her enthusiasm shriveled"; "the dollar''s shrunken buying power"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300840480">
	<b:glossaryEntry>capable of being reduced; "reducible to a set of principles of human nature"- Edmund Wilson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300840627">
	<b:glossaryEntry>incapable of being made smaller or simpler; "an irreducible minimum"; "an irreducible formula"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300840779"
	 b:glossaryEntry="having knowledge and spiritual insight;"/>
<rdf:Description rdf:about="&a;300840931">
	<b:glossaryEntry>instructed and encouraged in moral, intellectual, and spiritual improvement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300841060">
	<b:glossaryEntry>not enlightened; ignorant; "the devices by which unenlightened men preserved the unjust social order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300841275">
	<b:glossaryEntry>lacking enlightenment or knowledge or culture; "this benighted country"; "benighted ages of barbarism and superstition"; "the dark ages"; "a dark age in the history of education"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300841516">
	<b:glossaryEntry>marked by imagination, initiative, and readiness to undertake new projects; "an enterprising foreign policy"; "an enterprising young man likely to go far"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300841837">
	<b:glossaryEntry xml:space='preserve'><![CDATA[willing to take risks and try new things; "a new venturesome spirit among today''s young people"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300841997"
	 b:glossaryEntry="working hard to promote an enterprise"/>
<rdf:Description rdf:about="&a;300842132"
	 b:glossaryEntry="willing to take risks in order to make a profit"/>
<rdf:Description rdf:about="&a;300842241"
	 b:glossaryEntry="lacking in enterprise; not bold or venturesome"/>
<rdf:Description rdf:about="&a;300842420"
	 b:glossaryEntry="not inclined to be enterprising"/>
<rdf:Description rdf:about="&a;300842521">
	<b:glossaryEntry>having or showing great excitement and interest; "enthusiastic crowds filled the streets"; "an enthusiastic response"; "was enthusiastic about taking ballet lessons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300842889">
	<b:glossaryEntry>characterized by strong enthusiasm; "ardent revolutionaries"; "warm support"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300843026">
	<b:glossaryEntry>marked by active interest and enthusiasm; "an avid sports fan"; "a great walker"; "an eager beaver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300843202">
	<b:glossaryEntry>(informal) intensely enthusiastic about or preoccupied with; "crazy about cars and racing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300843344"
	 b:glossaryEntry="marked by ardent or zealous enthusiasm for a cause"/>
<rdf:Description rdf:about="&a;300843467"
	 b:glossaryEntry='highly enthusiastic; "glowing praise"'/>
<rdf:Description rdf:about="&a;300843558"
	 b:glossaryEntry="unduly enthusiastic"/>
<rdf:Description rdf:about="&a;300843640">
	<b:glossaryEntry>not enthusiastic; lacking excitement or ardor; "an unenthusiastic performance by the orchestra"; "unenthusiastic applause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300843913">
	<b:glossaryEntry>feeling or showing no enthusiasm; "a cold audience"; "a cold response to the new play"; "a cool reply to the invitation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300844091">
	<b:glossaryEntry>feeling or showing little interest or enthusiasm; "a halfhearted effort"; "gave only lukewarm support to the candidate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300844279"
	 b:glossaryEntry='lacking spirit; "it was a spiritless attempt"'/>
<rdf:Description rdf:about="&a;300844381">
	<b:glossaryEntry>having or expressing desire for something; "desirous of high office"; "desirous of finding a quick solution to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300844631"
	 b:glossaryEntry='marked by eager desire; "a big rich appetent Western city"'/>
<rdf:Description rdf:about="&a;300844744">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `for'') extremely desirous; "athirst for knowledge"; "hungry for recognition"; "thirsty for informaton"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300844949">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `for'') ardently or excessively desirous; "avid for adventure"; "an avid ambition to succeed"; "fierce devouring affection"; "the esurient eyes of an avid curiosity"; "greedy for fame"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300845237">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing extreme cupidity; painfully desirous of another''s advantages; "he was never covetous before he met her"; "jealous of his success and covetous of his possessions"; "envious of their art collection"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300845516">
	<b:glossaryEntry>having or feeling no desire; "a very private man, totally undesirous of public office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300845672">
	<b:glossaryEntry>living within a living animal usually as a parasite; "entozoic worms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300845818">
	<b:glossaryEntry>living or growing on the exterior surface of an animal usually as a parasite; "an epizoic plant parasite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300845976">
	<b:glossaryEntry>well matched; having the same quantity, value, or measure as another; "on equal terms"; "all men are equal before the law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300846492">
	<b:glossaryEntry>being essentially equal to something; "a wish that was equivalent to a command"; "his statement was tantamount to an admission of guilt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300846726"
	 b:glossaryEntry='an equal number; "we went to three plays in as many days"'/>
<rdf:Description rdf:about="&a;300846840">
	<b:glossaryEntry>(accounting) total debits and credits are equal; "the books looked balanced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300846971">
	<b:glossaryEntry>(of a contest or contestants) evenly matched; "a close contest"; "a close election"; "a tight game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300847130"
	 b:glossaryEntry="having the same standing before the law"/>
<rdf:Description rdf:about="&a;300847223"
	 b:glossaryEntry="of equal importance, rank, or degree"/>
<rdf:Description rdf:about="&a;300847316"
	 b:glossaryEntry="caused to be equal"/>
<rdf:Description rdf:about="&a;300847402"
	 b:glossaryEntry="the same distance apart at every point"/>
<rdf:Description rdf:about="&a;300847498"
	 b:glossaryEntry="having all sides or faces equal"/>
<rdf:Description rdf:about="&a;300847587">
	<b:glossaryEntry>essentially equal; "women are paid less than men doing equivalent work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300847715">
	<b:glossaryEntry>equal in degree or extent or amount; or equally matched or balanced; "even amounts of butter and sugar"; "on even terms"; "it was a fifty-fifty (or even) split"; "had a fifty-fifty (or even) chance"; "an even fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300847995"
	 b:glossaryEntry="having equal dimensions or measurements"/>
<rdf:Description rdf:about="&a;300848104"
	 b:glossaryEntry="of a process or change taking place at constant temperature"/>
<rdf:Description rdf:about="&a;300848220">
	<b:glossaryEntry xml:space='preserve'><![CDATA[on equal terms by payment or requital; "we''re now quits"; "finally quits with the loan"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300848359"
	 b:glossaryEntry='of the score in a contest; "the score is even"'/>
<rdf:Description rdf:about="&a;300848466"
	 b:glossaryEntry="poorly balanced or matched in quantity or value or measure"/>
<rdf:Description rdf:about="&a;300848722">
	<b:glossaryEntry>having unsymmetrical parts or unequal dimensions or measurements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300848860">
	<b:glossaryEntry>(of a contest or contestants) not fairly matched as opponents; "vaudeville...waged an uneven battle against the church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300849045">
	<b:glossaryEntry>not equal or interchangeable in value, quantity, or significance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300849169">
	<b:glossaryEntry>having a better than even chance of success; "the odds-on favorite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300849290"
	 b:glossaryEntry="(accounting) debits and credits are not equal"/>
<rdf:Description rdf:about="&a;300849392"
	 b:glossaryEntry="not caused to be equal"/>
<rdf:Description rdf:about="&a;300849486">
	<b:glossaryEntry>being in a state of proper balance or equilibrium; "the carefully balanced seesaw"; "a properly balanced symphony orchestra"; "a balanced assessment of intellectual and cultural history"; "a balanced blend of whiskeys"; "the educated man shows a balanced development of all his powers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300849916">
	<b:glossaryEntry>brought into equipoise by means of a weight or force that offsets another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300850067">
	<b:glossaryEntry>exhibiting equivalence or correspondence among constituents of an entity or between different entities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300850256">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by balance or equilibrium and readiness for action; "a gull in poised flight"; "George''s poised hammer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300850419"
	 b:glossaryEntry="maintaining equilibrium"/>
<rdf:Description rdf:about="&a;300850495">
	<b:glossaryEntry>in an optimal state of balance or equilibrium; "a well-balanced wheel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300850625"
	 b:glossaryEntry="being or thrown out of equilibrium"/>
<rdf:Description rdf:about="&a;300850729"
	 b:glossaryEntry="used of solutions; having the same or equal osmotic pressure"/>
<rdf:Description rdf:about="&a;300850874">
	<b:glossaryEntry>of a solution; having a higher osmotic pressure than a comparison solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300851023">
	<b:glossaryEntry>of a solution; having a lower osmotic pressure than a comparison solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300851170">
	<b:glossaryEntry xml:space='preserve'><![CDATA[open to two or more interpretations; or of uncertain nature or significance; or (often) intended to mislead; "an equivocal statement"; "the polling had a complex and equivocal (or ambiguous) message for potential female candidates"; "the officer''s equivocal behavior increased the victim''s uneasiness"; "popularity is an equivocal crown"; "an equivocal response to an embarrassing question"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300851718">
	<b:glossaryEntry>characterized by a mixture of opposite feelings or attitudes; "she felt ambivalent about his proposal"; "an ambivalent position on rent control"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300851919">
	<b:glossaryEntry>having two meanings with intent to deceive; "a sly double meaning"; "spoke with forked tongue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300852075">
	<b:glossaryEntry>deliberately vague or ambiguous; "his answers were brief, constrained and evasive"; "an evasive statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300852235">
	<b:glossaryEntry>of uncertain or ambiguous nature; "the equivocal (or indeterminate) objects painted by surrealists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300852394">
	<b:glossaryEntry>admitting of no doubt or misunderstanding; having only one meaning or interpretation and leading to only one conclusion; "unequivocal evidence"; "took an unequivocal position"; "an unequivocal success"; "an unequivocal promise"; "an unequivocal (or univocal) statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300852818">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expressing finality with no implication of possible change; "an absolute (or unequivocal) quarantee to respect the nation''s authority"; "inability to make a conclusive (or unequivocal) refusal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300853079"
	 b:glossaryEntry='free from ambiguity; "a straightforward set of instructions"'/>
<rdf:Description rdf:about="&a;300853201">
	<b:glossaryEntry>not open to question; "an unquestionable (or unequivocal) loss of prestige"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300853337"
	 b:glossaryEntry="able to be eradicated or rooted out"/>
<rdf:Description rdf:about="&a;300853501"
	 b:glossaryEntry="capable of being deleted"/>
<rdf:Description rdf:about="&a;300853579">
	<b:glossaryEntry xml:space='preserve'><![CDATA[capable of having having clear evidence of eliminated without trace; "the fire''s worst scars were effaceable by a comprehensive program of reforestation"; "a signal too loud to be erasable in a single pass through the erase head"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300853876"
	 b:glossaryEntry="capable of being totally destroyed or wiped out"/>
<rdf:Description rdf:about="&a;300853995"
	 b:glossaryEntry="able to be obliterated completely"/>
<rdf:Description rdf:about="&a;300854098">
	<b:glossaryEntry>not able to be destroyed or rooted out; "ineradicable superstitions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300854297">
	<b:glossaryEntry>cannot be removed, washed away or erased; "an indelible stain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300854428">
	<b:glossaryEntry>not capable of being expunged; "the inexpungible scent of a bottle of perfume he had broken"- Louis Auchincloss</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300854614">
	<b:glossaryEntry>incapable of extermination or extirpation; "some weeds seem inextirpable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300854763">
	<b:glossaryEntry>confined to and understandable by only an enlightened inner circle; "a compilation of esoteric philosophical theories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300855044">
	<b:glossaryEntry xml:space='preserve'><![CDATA[difficult to penetrate; incomprehensible to one of ordinary understanding or knowledge; "the professor''s lectures were so abstruse that students tended to avoid them"; "a deep metaphysical theory"; "some recondite problem in historiography"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300855358">
	<b:glossaryEntry>requiring secret or mysterious knowledge; "the arcane science of dowsing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300855484">
	<b:glossaryEntry>having a secret or hidden meaning; "cabalistic symbols engraved in stone"; "cryptic writings"; "thoroughly sibylline in most of his pronouncements"- John Gunther</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300855736">
	<b:glossaryEntry>having an import not apparent to the senses nor obvious to the intelligence; beyond ordinary understanding; "mysterious symbols"; "the mystical style of Blake"; "occult lore"; "the secret learning of the ancients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300856044">
	<b:glossaryEntry>suitable for the general public; "writings of an exoteric nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300856182"
	 b:glossaryEntry='basic and fundamental; "the essential feature"'/>
<rdf:Description rdf:about="&a;300856572"
	 b:glossaryEntry='of primary importance; "basic truths"'/>
<rdf:Description rdf:about="&a;300856679">
	<b:glossaryEntry>essential for maintaining the fundamental life processes; "sleep and food and water are among the biogenic needs of the organism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300856863">
	<b:glossaryEntry>constitutional in the structure of something (especially your physical makeup)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300857047"
	 b:glossaryEntry='highly recommended; "a book that is must reading"'/>
<rdf:Description rdf:about="&a;300857150"
	 b:glossaryEntry='necessary foods or commodities; "wheat is a staple crop"'/>
<rdf:Description rdf:about="&a;300857259">
	<b:glossaryEntry>being the essence or essential element of a thing; "substantial equivalents"; "substantive information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300857447">
	<b:glossaryEntry>being such in essence or effect though not in actual fact; "a virtual dependence on charity"; "a virtual revolution"; "virtual reality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300857639">
	<b:glossaryEntry>performing an essential function in the living body; "vital organs"; "blood and other vital fluids"; "the loss of vital heat in shock"; "a vital spot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300857859"
	 b:glossaryEntry="not basic or fundamental"/>
<rdf:Description rdf:about="&a;300858117">
	<b:glossaryEntry>not of prime or central importance; "nonessential to the integral meanings of poetry"- Pubs.MLA</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300858284">
	<b:glossaryEntry>acting as or providing a complement (something that completes the whole)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300858444">
	<b:glossaryEntry>capable of being dispensed with or done without; "dispensable items of personal property"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300858627">
	<b:glossaryEntry>not to be dispensed with; essential; "foods indispensable to good nutrition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300858817">
	<b:glossaryEntry>urgently needed; absolutely necessary; "a critical element of the plan"; "critical medical supplies"; "vital for a healthy society"; "foods indispensable to good nutrition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300859052"
	 b:glossaryEntry="deserving of respect or high regard"/>
<rdf:Description rdf:about="&a;300859179">
	<b:glossaryEntry>deserving of the highest esteem or admiration; "an estimable young professor"; "trains ran with admirable precision"; "his taste was impeccable, his health admirable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300859401"
	 b:glossaryEntry="deserving of contempt or scorn"/>
<rdf:Description rdf:about="&a;300859562">
	<b:glossaryEntry>of the most contemptible kind; "abject cowardice"; "a low stunt to pull"; "a low-down sneak"; "his miserable treatment of his family"; "You miserable skunk!"; "a scummy rabble"; "a scurvy trick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300859856">
	<b:glossaryEntry>inspiring mixed contempt and pity; "their efforts were pathetic"; "pitiable lack of character"; "pitiful exhibition of cowardice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300860061">
	<b:glossaryEntry>conforming to accepted standards of social or professional behavior; "an ethical lawyer"; "ethical medical practice"; "an ethical problem"; "had no ethical objection to drinking"; "Ours is a world of nuclear giants and ethical infants"- Omar N. Bradley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300860385">
	<b:glossaryEntry>not conforming to approved standards of social or professional behavior; "unethical business practices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300860562">
	<b:glossaryEntry>conveying or resembling a compliment; "a complimentary remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300860738"
	 b:glossaryEntry="formal expression of praise"/>
<rdf:Description rdf:about="&a;300860862"
	 b:glossaryEntry='full of or giving praise; "a laudatory remark"'/>
<rdf:Description rdf:about="&a;300860987"
	 b:glossaryEntry="tending to (or intended to) detract or disparage"/>
<rdf:Description rdf:about="&a;300861187">
	<b:glossaryEntry>tending to diminish or disparage; "belittling comments"; "managed a deprecating smile at the compliment"; "deprecatory remarks about the book"; "a slighting remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300861492">
	<b:glossaryEntry>expressive of low opinion; "derogatory comments"; "disparaging remarks about the new house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300861667">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expressing disapproval; "dyslogistic terms like `nitwit'' and `scalawag''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300861824">
	<b:glossaryEntry>expressive of contempt; "curled his lip in a supercilious smile"; "spoke in a sneering jeering manner"; "makes many a sharp comparison but never a mean or snide one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300862067"
	 b:glossaryEntry="tending to reveal or represent favorably"/>
<rdf:Description rdf:about="&a;300862218">
	<b:glossaryEntry>obsequiously complimentary; "they listened with flattering interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300862358">
	<b:glossaryEntry>displaying or setting off to best advantage; "a becoming new shade of rose"; "a becoming portrait"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300862511">
	<b:glossaryEntry>calculated to please or gain favor; "a smooth ingratiating manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300862651">
	<b:glossaryEntry>tending to reveal or represent unfavorably; "an unflattering portrait"; "the full unflattering light of morning"- Walter de la Mare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300862877">
	<b:glossaryEntry>starkly realistic; "I have never lacked candid critics in my own ranks"-Clement Atlee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300863015"
	 b:glossaryEntry='not complimentary; "uncomplimentary remarks"'/>
<rdf:Description rdf:about="&a;300863121">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of an inoffensive substitute for offensive terminology; "`peepee'' is a common euphemistic term"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300863288">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of an offensive substitute for inoffensive terminology; "`nigger'' is a dysphemistic term for `African-American''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300863471"
	 b:glossaryEntry="exaggerated feeling of well-being or elation"/>
<rdf:Description rdf:about="&a;300863650"
	 b:glossaryEntry="tending to produce euphoria"/>
<rdf:Description rdf:about="&a;300863734">
	<b:glossaryEntry>(psychiatry) marked by exaggerated feelings of euphoria and delusions of grandeur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300863871"
	 b:glossaryEntry="generalized feeling of distress"/>
<rdf:Description rdf:about="&a;300864017">
	<b:glossaryEntry>being level or straight or regular and without variation as e.g. in shape or texture; or being in the same plane or at the same height as something else (i.e. even with); "an even application of varnish"; "an even floor"; "the road was not very even"; "the picture is even with the window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300864501">
	<b:glossaryEntry>having a horizontal surface in which no part is higher or lower than another; "a flat desk"; "acres of level farmland"; "a plane surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300864705">
	<b:glossaryEntry>of a surface exactly even with an adjoining one, forming the same plane; "a door flush with the wall"; "the bottom of the window is flush with the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300864913">
	<b:glossaryEntry>(printing) having words so spaced that lines have straight even margins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300865040">
	<b:glossaryEntry>oriented at right angles to the plumb; "the picture is level"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300865153">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accurately fitted; level; "the window frame isn''t quite true"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300865276">
	<b:glossaryEntry>not even or uniform as e.g. in shape or texture; "an uneven color"; "uneven ground"; "uneven margins"; "wood with an uneven grain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300865675"
	 b:glossaryEntry="having wrinkles or waves"/>
<rdf:Description rdf:about="&a;300865792">
	<b:glossaryEntry>of timber; having fibers running irregularly rather than in parallel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300865920">
	<b:glossaryEntry>of a surface; not level or flat; "walking was difficult on the irregular cobblestoned surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300866070">
	<b:glossaryEntry>having a sharply uneven surface or outline; "the jagged outline of the crags"; "scraggy cliffs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300866236"
	 b:glossaryEntry='having lumps; not smooth and even in texture; "lumpy gravy"'/>
<rdf:Description rdf:about="&a;300866347">
	<b:glossaryEntry>not accurately fitted; not level; "the frame was out of true"; "off-level floors and untrue doors and windows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300866524">
	<b:glossaryEntry>irregular or uneven in quality, texture, etc.; "a patchy essay"; "patchy fog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300866654">
	<b:glossaryEntry>having an irregular outline; "text set with ragged right margins"; "herded the class into a ragged line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300866811"
	 b:glossaryEntry="not straight or parallel"/>
<rdf:Description rdf:about="&a;300866892"
	 b:glossaryEntry="divisible by two"/>
<rdf:Description rdf:about="&a;300866959"
	 b:glossaryEntry="not divisible by two"/>
<rdf:Description rdf:about="&a;300867029"
	 b:glossaryEntry="bearing foliage throughout the year"/>
<rdf:Description rdf:about="&a;300867138">
	<b:glossaryEntry>of or relating to or part of trees or shrubs bearing cones and evergreen leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300867289"
	 b:glossaryEntry="shedding foliage at the end of the growing season"/>
<rdf:Description rdf:about="&a;300867412">
	<b:glossaryEntry>having relatively broad rather than needle-like or scale-like leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300867566">
	<b:glossaryEntry>marked by strict and particular and complete accordance with fact; "an exact mind"; "an exact copy"; "hit the exact center of the target"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300867953">
	<b:glossaryEntry>in precisely the same words used by a writer or speaker; "a direct quotation"; "repeated their dialog verbatim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300868128">
	<b:glossaryEntry>without interpretation or embellishment; "a literal translation of the scene before him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300868270">
	<b:glossaryEntry>(of a translation) corresponding word for word with the original; "literal translation of the article"; "an awkward word-for-word translation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300868482">
	<b:glossaryEntry>(mathematics) characterized by the exactness or precision of mathematics; "mathematical precision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300868639"
	 b:glossaryEntry='precisely accurate or exact; "perfect timing"'/>
<rdf:Description rdf:about="&a;300868738">
	<b:glossaryEntry>representing people or nature with the exactness and fidelity of a photograph</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300868874">
	<b:glossaryEntry>rigidly accurate; allowing no deviation from a standard; "rigorous application of the law"; "a strict vegetarian"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300869051"
	 b:glossaryEntry="not exact"/>
<rdf:Description rdf:about="&a;300869222">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not quite exact or correct; "the approximate time was 10 o''clock"; "a rough estimate"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300869389">
	<b:glossaryEntry>not literal; "a loose interpretation of what she had been told"; "a free translation of the poem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300869555">
	<b:glossaryEntry>(in combination) an indefinite quantity more than that specified; "invited 30-odd guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300869694">
	<b:glossaryEntry>(of numbers) to the nearest ten, hundred, or thousand; "in round numbers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300869819">
	<b:glossaryEntry>capable of being exchanged for or replaced by something of equal value; "convertible securities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300870024">
	<b:glossaryEntry>able to be converted into ready money; "a cashable check"; "cashable gambling chips"; "redeemable stocks and bonds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300870207">
	<b:glossaryEntry>used especially of currencies; incapable of being exchanged for or replaced by another currency of equal value</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300870446">
	<b:glossaryEntry>(of paper money) not convertible into coin at the pleasure of the holder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300870577"
	 b:glossaryEntry="suitable to be exchanged"/>
<rdf:Description rdf:about="&a;300870696">
	<b:glossaryEntry>capable of being exchanged for another or for something else that is equivalent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300870848">
	<b:glossaryEntry>(law) of goods or commodities; freely exchangeable for or replaceable by another of like nature or kind in the satisfaction of an obligation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300871043"
	 b:glossaryEntry="not suitable to be exchanged"/>
<rdf:Description rdf:about="&a;300871150">
	<b:glossaryEntry>not interchangeable or able to substitute one for another; "a rare incommutable skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300871295"
	 b:glossaryEntry="easily excited"/>
<rdf:Description rdf:about="&a;300871419"
	 b:glossaryEntry="(of persons) excitable"/>
<rdf:Description rdf:about="&a;300871498"
	 b:glossaryEntry='easily aroused or excited; "a quick temper"; "a warm temper"'/>
<rdf:Description rdf:about="&a;300871617"
	 b:glossaryEntry="unpredictably excitable (especially of horses)"/>
<rdf:Description rdf:about="&a;300871737"
	 b:glossaryEntry='not easily excited; "an unexcitable temperament"'/>
<rdf:Description rdf:about="&a;300871861"
	 b:glossaryEntry='not easily excited or upset; "steady nerves"'/>
<rdf:Description rdf:about="&a;300871958"
	 b:glossaryEntry="in an aroused state"/>
<rdf:Description rdf:about="&a;300872229"
	 b:glossaryEntry="excited in anticipation"/>
<rdf:Description rdf:about="&a;300872317"
	 b:glossaryEntry="highly excited"/>
<rdf:Description rdf:about="&a;300872382">
	<b:glossaryEntry>(informal) possessed by inordinate excitement; "the crowd went crazy"; "was crazy to try his new bicycle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300872539"
	 b:glossaryEntry='highly excited; "a fevered imagination"'/>
<rdf:Description rdf:about="&a;300872632">
	<b:glossaryEntry>as if under the influence of alcohol; "felt intoxicated by her success"; "drunk with excitement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300872794"
	 b:glossaryEntry="unduly excited"/>
<rdf:Description rdf:about="&a;300872866"
	 b:glossaryEntry="emotionally aroused"/>
<rdf:Description rdf:about="&a;300872975"
	 b:glossaryEntry="feeling mild pleasurable excitement"/>
<rdf:Description rdf:about="&a;300873076"
	 b:glossaryEntry="feeling intense pleasurable excitement"/>
<rdf:Description rdf:about="&a;300873169"
	 b:glossaryEntry="full of excitement; thrilled"/>
<rdf:Description rdf:about="&a;300873253"
	 b:glossaryEntry='not excited; "made an unexcited appraisal of the situation"'/>
<rdf:Description rdf:about="&a;300873404">
	<b:glossaryEntry xml:space='preserve'><![CDATA[calm and unemotional; "play it cool"; "he doesn''t seem excited; on the contrary his demeanor is cool and nonchalant"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300873571">
	<b:glossaryEntry>creating or arousing excitement; "an exciting account of her trip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300873926">
	<b:glossaryEntry>tending to cause suspension of regular breathing; "a breathless flight"; "breathtaking adventure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300874095"
	 b:glossaryEntry="making lively and joyful"/>
<rdf:Description rdf:about="&a;300874188">
	<b:glossaryEntry>affected by emotion as if by electricity; thrilling; "gave an electric reading of the play"; "the new leader had a galvanic effect on morale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300874409">
	<b:glossaryEntry>causing a surge of emotion or excitement; "she gave a electrifying performance"; "a thrilling performer to watch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300874593">
	<b:glossaryEntry>having an air of allure, romance and excitement; "glamorous movie stars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300874734"
	 b:glossaryEntry="extremely exciting as if by alcohol or a narcotic"/>
<rdf:Description rdf:about="&a;300874850"
	 b:glossaryEntry="pleasantly and superficially exciting"/>
<rdf:Description rdf:about="&a;300874945">
	<b:glossaryEntry>exciting by touching lightly so as to cause laughter or twitching movements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300875100">
	<b:glossaryEntry>not exciting; "an unexciting novel"; "lived an unexciting life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300875346">
	<b:glossaryEntry>not challenging; dull and lacking excitement; "an unglamorous job greasing engines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300875536">
	<b:glossaryEntry>having no intellectual or emotional or spiritual excitement; "the production was professional but uninspired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300875702"
	 b:glossaryEntry="flat and uninspiring"/>
<rdf:Description rdf:about="&a;300875773"
	 b:glossaryEntry="clearing of guilt or blame"/>
<rdf:Description rdf:about="&a;300875929"
	 b:glossaryEntry="providing absolution"/>
<rdf:Description rdf:about="&a;300876033">
	<b:glossaryEntry>partially excusing or justifying; "extenuating circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300876152"
	 b:glossaryEntry="providing justification"/>
<rdf:Description rdf:about="&a;300876265"
	 b:glossaryEntry="causing blame to be imputed to"/>
<rdf:Description rdf:about="&a;300876493">
	<b:glossaryEntry>containing or expressing accusation; "an accusitive forefinger"; "black accusatory looks"; "accusive shoes and telltale trousers"- O.Henry; "his accusing glare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300876745"
	 b:glossaryEntry="containing warning of punishment"/>
<rdf:Description rdf:about="&a;300876865">
	<b:glossaryEntry>containing or imposing condemnation or censure; "a condemnatory decree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300877008">
	<b:glossaryEntry>charging or suggestive of guilt or blame; "incriminatory testimony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300877179"
	 b:glossaryEntry="threatening with damnation"/>
<rdf:Description rdf:about="&a;300877271">
	<b:glossaryEntry>countering one charge with another; "recriminatory arguments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300877408"
	 b:glossaryEntry="capable of being used up"/>
<rdf:Description rdf:about="&a;300877508"
	 b:glossaryEntry="capable of being depleted"/>
<rdf:Description rdf:about="&a;300877590">
	<b:glossaryEntry>incapable of being entirely consumed or used up; "an inexhaustible supply of coal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300877768">
	<b:glossaryEntry>capable of being renewed; replaceable; "renewable energy such as solar energy is theoretically inexhaustible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300877933">
	<b:glossaryEntry>always able to supply more; "an unfailing source of good stories"; "a subject of unfailing interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300878089">
	<b:glossaryEntry>completely emptied of resources or properties; "impossible to grow tobacco on the exhausted soil"; "the exhausted food sources"; "exhausted oil wells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300878367"
	 b:glossaryEntry="completely used up"/>
<rdf:Description rdf:about="&a;300878466">
	<b:glossaryEntry>having resources completely depleted; "our depleted resources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300878583">
	<b:glossaryEntry>emptied by being pumped out or having a vacuum created; "a highly evacuated glass tube"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300878726"
	 b:glossaryEntry='having all been spent; "the money is all gone"'/>
<rdf:Description rdf:about="&a;300878842"
	 b:glossaryEntry='not used up completely; "an unexhausted well"'/>
<rdf:Description rdf:about="&a;300878999">
	<b:glossaryEntry>not used up; "leftover meatloaf"; "she had a little money left over so she went to a movie"; "some odd dollars left"; "saved the remaining sandwiches for supper"; "unexpended provisions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300879296"
	 b:glossaryEntry="not consumed"/>
<rdf:Description rdf:about="&a;300879365">
	<b:glossaryEntry>(of financial resources) not spent; "unexpended funds"; "his unspent allowance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300879511">
	<b:glossaryEntry>having existence or being or actuality; "an attempt to refine the existent machinery to make it more efficient"; "much of the beluga caviar existing in the world is found in the Soviet Union and Iran"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300879831">
	<b:glossaryEntry>in operation; "keep hope alive"; "the tradition was still alive"; "an active tradition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300879982">
	<b:glossaryEntry>not having existence or being or actuality; "chimeras are nonexistent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300880182">
	<b:glossaryEntry>no longer existing or inaccessible through loss or destruction; "its nonextant original was written on vellum"- G.B.Saul</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300880358"
	 b:glossaryEntry='having passed out of existence; "vanished civilizations"'/>
<rdf:Description rdf:about="&a;300880469">
	<b:glossaryEntry>still in existence; not extinct or destroyed or lost; "extant manuscripts"; "specimens of graphic art found among extant barbaric folk"- Edward Clodd</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300880725"
	 b:glossaryEntry='still in active use; "a living language"'/>
<rdf:Description rdf:about="&a;300880818">
	<b:glossaryEntry>still in existence; "the Wollemi pine found in Australia is a surviving specimen of a conifer thought to have been long extinct and therefore known as a living fossil"; "the only surviving frontier blockhouse in Pennsylvania"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300881108">
	<b:glossaryEntry>no longer in existence; lost or especially having died out leaving no living representatives; "an extinct species of fish"; "an extinct royal family"; "extinct laws and customs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300881387"
	 b:glossaryEntry='not surviving in active use; "Latin is a dead language"'/>
<rdf:Description rdf:about="&a;300881493">
	<b:glossaryEntry>considered likely or probable to happen or arrive; "prepared for the expected attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300881759"
	 b:glossaryEntry="expected hopefully"/>
<rdf:Description rdf:about="&a;300881860"
	 b:glossaryEntry='scheduled to arrive; "the train is due in 15 minutes"'/>
<rdf:Description rdf:about="&a;300881966">
	<b:glossaryEntry>to be expected; "differences of opinion are quite expectable given the present information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300882114"
	 b:glossaryEntry="known beforehand"/>
<rdf:Description rdf:about="&a;300882208"
	 b:glossaryEntry="expected or depended upon as a natural or logical outcome"/>
<rdf:Description rdf:about="&a;300882328"
	 b:glossaryEntry='firmly believed; "the way things are supposed to be"'/>
<rdf:Description rdf:about="&a;300882438">
	<b:glossaryEntry>not expected or anticipated; "unexpected guests"; "unexpected news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300882670">
	<b:glossaryEntry>without warning or announcement; "they arrived unannounced"; "a totally unheralded telegram that his daughter...died last night"- M.A.D.Howe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300882895">
	<b:glossaryEntry>not anticipated; "unanticipated and disconcerting lines of development"- H.W.Glidden; "unforeseen circumstances"; "a virtue unlooked-for in people so full of energy"; "like a bolt out of the blue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300883200">
	<b:glossaryEntry>so unexpected as to have not been imagined; "an unhoped-for piece of luck"; "an unthought advantage"; "an unthought-of place to find the key"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300883436"
	 b:glossaryEntry="not prepared or ready for"/>
<rdf:Description rdf:about="&a;300883525">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of an unexpected defeat of a team favored to win; "the Bills'' upset victory over the Houson Oilers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300883684">
	<b:glossaryEntry>serving to promote your interest; "was merciful only when mercy was expedient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300883926">
	<b:glossaryEntry>appropriate for achieving a particular end; implies a lack of concern for fairness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300884081">
	<b:glossaryEntry>taking immediate advantage, often unethically, of any circumstance of possible benefit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300884255"
	 b:glossaryEntry='not suitable or advisable; "an inexpedient tactic"'/>
<rdf:Description rdf:about="&a;300884417"
	 b:glossaryEntry='not advisable; "an unnecessary and inadvisable action"'/>
<rdf:Description rdf:about="&a;300884529"
	 b:glossaryEntry="having been hastened to completion"/>
<rdf:Description rdf:about="&a;300884673"
	 b:glossaryEntry="caused to go more rapidly"/>
<rdf:Description rdf:about="&a;300884769"
	 b:glossaryEntry="freed from difficulty or impediment"/>
<rdf:Description rdf:about="&a;300884862">
	<b:glossaryEntry>caused to be slower or later; "the delayed plane finally arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300885071"
	 b:glossaryEntry="temporarily inactive"/>
<rdf:Description rdf:about="&a;300885185">
	<b:glossaryEntry>operating after a predetermined lapse of time; "a delayed-action bomb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300885316">
	<b:glossaryEntry>put off to later; "requested a deferred payment"; "our postponed trip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300885453"
	 b:glossaryEntry="delayed or obstructed"/>
<rdf:Description rdf:about="&a;300885531"
	 b:glossaryEntry="suitable to be expended"/>
<rdf:Description rdf:about="&a;300885665"
	 b:glossaryEntry="may be used up"/>
<rdf:Description rdf:about="&a;300885736"
	 b:glossaryEntry="may be deliberately sacrificed to achieve an objective"/>
<rdf:Description rdf:about="&a;300885850"
	 b:glossaryEntry="not suitable to be expended"/>
<rdf:Description rdf:about="&a;300886008"
	 b:glossaryEntry="absolutely required and not to be used up or sacrificed"/>
<rdf:Description rdf:about="&a;300886119"
	 b:glossaryEntry="not possible to replace"/>
<rdf:Description rdf:about="&a;300886202">
	<b:glossaryEntry>high in price or charging high prices; "expensive clothes"; "an expensive shop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300886427">
	<b:glossaryEntry>(informal) very expensive; "big-ticket items like cars and furs"; "a big-ticket government program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300886586">
	<b:glossaryEntry>having a high price; "costly jewelry"; "high-priced merchandise"; "much too dear for my pocketbook"; "a pricey restaurant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300886802"
	 b:glossaryEntry='entailing great loss or sacrifice; "a dearly-won victory"'/>
<rdf:Description rdf:about="&a;300886925"
	 b:glossaryEntry='too costly for the value; "overpriced items at resort shops"'/>
<rdf:Description rdf:about="&a;300887042">
	<b:glossaryEntry>relatively low in price or charging low prices; "it would have been cheap at twice the price"; "inexpensive family restaurants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300887361">
	<b:glossaryEntry>offering goods or services at less than standard price or rate; "a bargain outlet"; "cut-rate store"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300887544">
	<b:glossaryEntry>costing less than standard price; "buying bargain-priced clothes for the children"; "cut-rate goods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300887728">
	<b:glossaryEntry>designed to sell quickly without concern for quality; "catchpenny ornaments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300887864"
	 b:glossaryEntry='very cheap; "a dirt cheap property"'/>
<rdf:Description rdf:about="&a;300887956"
	 b:glossaryEntry='that you have the financial means for; "low-cost housing"'/>
<rdf:Description rdf:about="&a;300888094"
	 b:glossaryEntry='low-paying; "a nickel-and-dime job"'/>
<rdf:Description rdf:about="&a;300888194"
	 b:glossaryEntry="of trifling worth"/>
<rdf:Description rdf:about="&a;300888335">
	<b:glossaryEntry>having become knowledgeable or skillful from observation or participation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300888628">
	<b:glossaryEntry>(of persons e.g.) having gained full status; "a full-fledged lawyer"; "by the age of seventeen I was a full-fledged atheist"; "sees itself as a fully fledged rival party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300888873"
	 b:glossaryEntry="having been introduced to something new"/>
<rdf:Description rdf:about="&a;300888979">
	<b:glossaryEntry>thoroughly acquainted with through study or experience; "this girl, so intimate with nature"-W.H.Hudson; "knowledgeable about the technique of painting"- Herbert Read</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300889260"
	 b:glossaryEntry='old in experience; "an old offender"; "the older soldiers"'/>
<rdf:Description rdf:about="&a;300889376"
	 b:glossaryEntry="skillful after much practice"/>
<rdf:Description rdf:about="&a;300889472">
	<b:glossaryEntry>rendered competent through trial and experience; "troops seasoned in combat"; "a seasoned traveler"; "veteran steadiness"; "a veteran officer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300889682"
	 b:glossaryEntry="lacking practical experience or training"/>
<rdf:Description rdf:about="&a;300889926"
	 b:glossaryEntry='in training; "an apprentice carpenter"'/>
<rdf:Description rdf:about="&a;300890024">
	<b:glossaryEntry>young and inexperienced; "a fledgling enterprise"; "a fledgling skier"; "an unfledged lawyer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300890185">
	<b:glossaryEntry>lacking training or experience; "the new men were eager to fight"; "raw recruits"; "he shipped as a green hand on a vessel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300890397">
	<b:glossaryEntry>not initiated; deficient in relevant experience; "it seemed a bizarre ceremony to uninitiated western eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300890575"
	 b:glossaryEntry="not having had extensive practice"/>
<rdf:Description rdf:about="&a;300890680">
	<b:glossaryEntry>not tried or tested by experience; "unseasoned artillery volunteers"; "still untested in battle"; "an illustrator untried in mural painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300890898">
	<b:glossaryEntry>having come to an end or become void after passage of a period of time; "an expired passport"; "caught driving with an expired license"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300891123"
	 b:glossaryEntry='no longer valid; "the license is invalid"'/>
<rdf:Description rdf:about="&a;300891218"
	 b:glossaryEntry="(of e.g. a contract or term of office) having come to an end"/>
<rdf:Description rdf:about="&a;300891335">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not having come to an end or been terminated by passage of time; "elected to fill the senator''s unexpired term"; "an unexpired driver''s license"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300891553"
	 b:glossaryEntry='still legally acceptable; "the license is still valid"'/>
<rdf:Description rdf:about="&a;300891659">
	<b:glossaryEntry>capable of being explicated or accounted for; "explicable behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300891837"
	 b:glossaryEntry='capable of being understood; "explainable phenomena"'/>
<rdf:Description rdf:about="&a;300891963">
	<b:glossaryEntry>incapable of being explained or accounted for; "inexplicable errors"; "left the house at three in the morning for inexplicable reasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300892302">
	<b:glossaryEntry>of an obscure nature; "the new insurance policy is written without cryptic or mysterious terms"; "a deep dark secret"; "the inscrutible workings of Providence"; "in its mysterious past it encompasses all the dim origins of life"- Rachel Carson; "rituals totally mystifying to visitors from other lands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300892717">
	<b:glossaryEntry>seemingly contradictory but nonetheless possibly true; "it is paradoxical that standing is more tiring than walking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300892912">
	<b:glossaryEntry>not to be accounted for or explained; "perceptible only as unaccountable influences that hinder progress"; "an unexplainable fear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300893118">
	<b:glossaryEntry>having the reason or cause not made clear; "an unexplained error"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300893241">
	<b:glossaryEntry>precisely and clearly expressed or readily observable; leaving nothing to implication; "explicit instructions"; "she made her wishes explicit"; "explicit sexual scenes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300893638"
	 b:glossaryEntry="declared as fact; explicitly stated"/>
<rdf:Description rdf:about="&a;300893737">
	<b:glossaryEntry>clearly defined or formulated; "the plain and unequivocal language of the laws"- R.B.Taney</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300893898"
	 b:glossaryEntry='not tacit or implied; "her express wish"'/>
<rdf:Description rdf:about="&a;300893992">
	<b:glossaryEntry>describing nudity or sexual activity in graphic detail; "graphic sexual scenes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300894125">
	<b:glossaryEntry>implied though not directly expressed; inherent in the nature of something; "an implicit agreement not to raise the subject"; "there was implicit criticism in his voice"; "anger was implicit in the argument"; "the oak is implicit in the acorn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300894544">
	<b:glossaryEntry>in the nature of something though not readily apparent; "shortcomings inherent in our approach"; "an underlying meaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300894749">
	<b:glossaryEntry>indicated by necessary connotation though not expressed directly; "gave silent consent"; "a tacit agreement"; "the understood provisos of a custody agreement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300894991">
	<b:glossaryEntry>not made explicit; "the unexpressed terms of the agreement"; "things left unsaid"; "some kind of unspoken agreement"; "his action is clear but his reason remains unstated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300895289"
	 b:glossaryEntry="developed or used to greatest advantage"/>
<rdf:Description rdf:about="&a;300895402"
	 b:glossaryEntry="put to use"/>
<rdf:Description rdf:about="&a;300895484">
	<b:glossaryEntry>undeveloped or unused; "vast unexploited (or undeveloped) natural resources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300895668"
	 b:glossaryEntry='undeveloped but potentially useful; "a fallow gold market"'/>
<rdf:Description rdf:about="&a;300895779">
	<b:glossaryEntry>not drawn upon or used; "untapped reserves of coal"; "the untapped stockrooms of our minds"- G.R.Harrison</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300895939"
	 b:glossaryEntry='capable of being expressed; "an expressible emotion"'/>
<rdf:Description rdf:about="&a;300896103"
	 b:glossaryEntry="capable of being described"/>
<rdf:Description rdf:about="&a;300896187">
	<b:glossaryEntry>(mathematics) expressible in symbolic form; "uniquely representable in the form..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300896330"
	 b:glossaryEntry="capable of being uttered in words or sentences"/>
<rdf:Description rdf:about="&a;300896444"
	 b:glossaryEntry="defying expression"/>
<rdf:Description rdf:about="&a;300896556">
	<b:glossaryEntry>defying expression or description; "indefinable yearnings"; "indescribable beauty"; "ineffable ecstasy"; "inexpressible anguish"; "unspeakable happiness"; "unutterable contempt"; "a thing of untellable splendor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300896894">
	<b:glossaryEntry>capable of being protruded or stretched or opened out; "an extensile tongue"; "an extensible measuring rule"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300897107"
	 b:glossaryEntry='able to be extended; "protractile muscle"'/>
<rdf:Description rdf:about="&a;300897221"
	 b:glossaryEntry="capable of being thrust forward, as the tongue"/>
<rdf:Description rdf:about="&a;300897338"
	 b:glossaryEntry="not extensile"/>
<rdf:Description rdf:about="&a;300897442"
	 b:glossaryEntry="capable of being extricated"/>
<rdf:Description rdf:about="&a;300897526">
	<b:glossaryEntry>not permitting extrication; incapable of being disentangled or untied; "an inextricable knot"; "inextricable unity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300897718"
	 b:glossaryEntry='not capable of being resolved; "unresolvable confusion"'/>
<rdf:Description rdf:about="&a;300897832">
	<b:glossaryEntry>(music) of a stringed instrument; sounded by stroking with a bow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300897948">
	<b:glossaryEntry>(music) of a stringed instrument; sounded with the fingers or a plectrum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300898092">
	<b:glossaryEntry>(of instruments in the violin family) to be plucked with the finger</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300898215">
	<b:glossaryEntry>having or resembling a finger or fingers; often used in combination; "the fingered roots of giant trees"; "rosy-fingered"; "three-fingered cartoon characters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300898446"
	 b:glossaryEntry='resembling a finger; "digitate leaves of the horse chestnut"'/>
<rdf:Description rdf:about="&a;300898574"
	 b:glossaryEntry="not having or having lost fingers"/>
<rdf:Description rdf:about="&a;300898664">
	<b:glossaryEntry>drawn into the lungs; breathed in; "inhaled smoke can damage the lungs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300898807">
	<b:glossaryEntry>made by drawing the breath in suddenly; "an indrawn gasp"; "her announcement was greeted with several indrawn breaths from around the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300899001">
	<b:glossaryEntry>let or forced out of the lungs; breathed out; "an exhaled sigh"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300899118">
	<b:glossaryEntry>able or tending to expand or characterized by expansion; "Expansive materials"; "the expansive force of fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300899355">
	<b:glossaryEntry>capable of being distended; able to stretch and expand; "the stomach is a distensible organ"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300899505">
	<b:glossaryEntry>(physiology) filled with vascular sinuses and capable of becoming distended and rigid as the result of being filled with blood; "erectile tissue"; "the penis is an erectile organ</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300899750"
	 b:glossaryEntry="able to expand or be expanded"/>
<rdf:Description rdf:about="&a;300899862">
	<b:glossaryEntry>designed to be filled with air or gas; "an inflatable mattress"; "an inflatable boat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300900004"
	 b:glossaryEntry='showing no tendency to expand; "unexpansive bodies"'/>
<rdf:Description rdf:about="&a;300900113">
	<b:glossaryEntry>capable of being extinguished or killed; "an extinguishable fire"; "hope too is extinguishable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300900269">
	<b:glossaryEntry>difficult or impossible to extinguish; "an inextinguishable flame"; "an inextinguishable faith"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300900427">
	<b:glossaryEntry>happening or arising or located outside or beyond some limits or especially surface; "the external auditory canal"; "external pressures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300900690">
	<b:glossaryEntry>(anatomy) being on or toward the outside of the body; "the outer ear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300900811">
	<b:glossaryEntry>originating or belonging beyond some bounds:"the outside world"; "outside interests"; "an outside job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300900967">
	<b:glossaryEntry>happening or arising or located within some limits or especially surface; "internal organs"; "internal mechanism of a toy"; "internal party maneuvering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300901318">
	<b:glossaryEntry>inside e.g. an organization; used as a combining form; "an in-house editor"; "in-home nursing programs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300901470">
	<b:glossaryEntry>(anatomy) inside or closer to the inside of the body; "the inner ear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300901591">
	<b:glossaryEntry>within some bounds; especially of an organization; "an inside job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300901710"
	 b:glossaryEntry='inside and toward a center; "interior regions of the earth"'/>
<rdf:Description rdf:about="&a;300901824">
	<b:glossaryEntry>(of conflict) within a group or organization; "an internecine feud among proxy holders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300901969">
	<b:glossaryEntry>(anatomy) situated within or belonging solely to the organ or body part on which it acts; "intrinsic muscles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300902134">
	<b:glossaryEntry>being on the outside or further from a center; "spent hours adorning the outer man"; "the outer suburbs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300902383"
	 b:glossaryEntry='outer or outlying; "the out islands"'/>
<rdf:Description rdf:about="&a;300902469"
	 b:glossaryEntry="situated at the farthest possible point from a center"/>
<rdf:Description rdf:about="&a;300902588">
	<b:glossaryEntry>on or toward an outer edge; "an outer lane"; "the outside lane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300902705">
	<b:glossaryEntry>surrounding and dominated by a central authority or power; "a city and its satellite communities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300902858">
	<b:glossaryEntry>located or occurring within or closer to a center; "an inner room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300903051">
	<b:glossaryEntry>centrally located and easy to reach; "the central city has good bus service"; "the shop has a central location"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300903216">
	<b:glossaryEntry>situated or occurring farthest within; "the innermost chamber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300903343"
	 b:glossaryEntry='away from the outer edge; "an inner lane"; "the inside lane"'/>
<rdf:Description rdf:about="&a;300903456">
	<b:glossaryEntry>relating to physical reality rather than with thoughts or the mind; "a concern with outward beauty rather than with inward reflections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300903717">
	<b:glossaryEntry>purely outward or superficial; "external composure"; "an external concern for reputation"- A.R.Gurney,Jr.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300903877"
	 b:glossaryEntry='located outside; "outer reality"'/>
<rdf:Description rdf:about="&a;300903961">
	<b:glossaryEntry>relating to or existing in the mind or thoughts; "a concern with inward reflections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300904206">
	<b:glossaryEntry>existing or residing as an inner activating spirit or force or principle; "an indwelling divinity"; "an indwelling goodness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300904387">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being deepest within the self; "one''s innermost feelings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300904509">
	<b:glossaryEntry xml:space='preserve'><![CDATA[located inward; "Beethoven''s manuscript looks like a bloody record of a tremendous inner battle"- Leonard Bernstein; "she thinks she has no soul, no interior life, but the truth is that she has no access to it"- David Denby; "an internal sense of rightousness"- A.R.Gurney,Jr.]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300904859"
	 b:glossaryEntry='not expressed; "secret (or private) thoughts"'/>
<rdf:Description rdf:about="&a;300904967"
	 b:glossaryEntry="as if whispered to yourself"/>
<rdf:Description rdf:about="&a;300905055">
	<b:glossaryEntry>situated in or suitable for the outdoors or outside of a building; "an exterior scene"; "exterior grade plywood"; "exterior paints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300905313">
	<b:glossaryEntry xml:space='preserve'><![CDATA[outside or external; "the out surface of a ship''s hull"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300905421"
	 b:glossaryEntry='leading to or from the outside; "an outside door"'/>
<rdf:Description rdf:about="&a;300905527">
	<b:glossaryEntry>situated within or suitable for inside a building; "an interior scene"; "interior decoration"; "an interior bathroom without windows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300905787"
	 b:glossaryEntry='within doors; "an indoor setting"'/>
<rdf:Description rdf:about="&a;300905873">
	<b:glossaryEntry>being or applying to the inside of a building; "an inside wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300905992">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having an eye or eyes or eyelike feature especially as specified; often used in combination; "an eyed hook"; "a peacock''s eyed feathers"; "red-eyed"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300906353"
	 b:glossaryEntry="having almond-shaped eyes"/>
<rdf:Description rdf:about="&a;300906436"
	 b:glossaryEntry="having blue eyes"/>
<rdf:Description rdf:about="&a;300906508">
	<b:glossaryEntry xml:space='preserve'><![CDATA[suggesting an eye or eyes; "eyelike markings on a butterfly''s wings"; "the eyelike gleam of two distant windows in the dark"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300906686">
	<b:glossaryEntry>having or showing only one eye; "one-eyed Jacks are wild"; "the three one-eyed Cyclopes of Greek myth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300906843"
	 b:glossaryEntry='having large round eyes like those of an ox; "ox-eyed Juno"'/>
<rdf:Description rdf:about="&a;300906956"
	 b:glossaryEntry="having bulging eyes"/>
<rdf:Description rdf:about="&a;300907029"
	 b:glossaryEntry="having large round wide-open eyes"/>
<rdf:Description rdf:about="&a;300907133"
	 b:glossaryEntry="having keen eyesight"/>
<rdf:Description rdf:about="&a;300907210"
	 b:glossaryEntry="having eyes that look in different directions"/>
<rdf:Description rdf:about="&a;300907311">
	<b:glossaryEntry>lacking eyes or eyelike features; "eyeless fish that evolved in dark caves"; "an eyeless needle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300907461">
	<b:glossaryEntry>(prefix) between or among or in the midst of; "intercontinental flights"; "interscholastic athletics"; "interlobular connective tissue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300907648"
	 b:glossaryEntry='(prefix) within; e.g. "intravenous"; "intramural"'/>
<rdf:Description rdf:about="&a;300907749">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not out; "it''s ten o''clock and the children are in"; "the tide is in"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300907888">
	<b:glossaryEntry>in your own home or country; "they were at home when I stopped by"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300908011">
	<b:glossaryEntry>not in; or in or into the open; "has been out all day"; "out to lunch"; "the sun is out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300908170">
	<b:glossaryEntry xml:space='preserve'><![CDATA[away from home or business; "he didn''t leave an away phone number"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300908290">
	<b:glossaryEntry>capable of or suitable for being played or played on; "a playable lie in golf"; "the baseball fan reached out and caught a foul that was judged playable"; "the ball field was playable"; "harpsichord music is readily playable"- P.H.Lang</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300908580">
	<b:glossaryEntry>not capable of or suitable for being played or played on; "the golf ball was in an unplayable lie"; "the field was unplayable"; "some music seems almost unplayable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300908801">
	<b:glossaryEntry>(of a baseball) hit between the foul lines; "he hit a fair ball over the third base bag"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300908958"
	 b:glossaryEntry="(baseball) between the first and third base lines"/>
<rdf:Description rdf:about="&a;300909063"
	 b:glossaryEntry="(of a baseball) not hit between the foul lines"/>
<rdf:Description rdf:about="&a;300909178"
	 b:glossaryEntry="outside the foul lines"/>
<rdf:Description rdf:about="&a;300909260">
	<b:glossaryEntry>free from favoritism or self-interest or bias or deception; or conforming with established standards or rules; "a fair referee; "fair deal"; "on a fair footing"; "a fair fight"; "by fair means or foul"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300909663">
	<b:glossaryEntry>of laws and regulations; designed to protect trade and commerce from unfair business practices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300909828">
	<b:glossaryEntry>marked by or calling for sportsmanship or fair play; "a clean fight"; "a sporting solution of the disagreement"; "sportsmanlike conduct"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300910043"
	 b:glossaryEntry="of a person; just and impartial; not prejudiced"/>
<rdf:Description rdf:about="&a;300910148"
	 b:glossaryEntry="just and honest"/>
<rdf:Description rdf:about="&a;300910225">
	<b:glossaryEntry>not fair; marked by injustice or partiality or deception; "used unfair methods"; "it was an unfair trial"; "took an unfair advantage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300910510">
	<b:glossaryEntry>violating accepted standards or rules; "a dirty fighter"; "used foul means to gain power"; "a nasty unsporting serve"; "fined for unsportsmanlike behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300910769">
	<b:glossaryEntry>brutally unfair or harsh; "received raw treatment from his friends"; "a raw deal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300910900">
	<b:glossaryEntry>implying justice dictated by reason, conscience, and a natural sense of what is fair to all; "equitable treatment of all citizens"; "an equitable distribution of gifts among the children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300911168"
	 b:glossaryEntry='without partiality; "evenhanded justice"'/>
<rdf:Description rdf:about="&a;300911265">
	<b:glossaryEntry>not equitable or fair; "the inequitable division of wealth"; "inequitable taxation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300911415">
	<b:glossaryEntry>steadfast in affection or allegiance; "years of faithful service"; "faithful employees"; "we do not doubt that England has a faithful patriot in the Lord Chancellor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300911761">
	<b:glossaryEntry>unwavering in devotion to friend or vow or cause; "a firm ally"; "loyal supporters"; "a loyal friend"; "the true-hearted soldier...of Tippecanoe"- Campaign song for William Henry Harrison</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300912021"
	 b:glossaryEntry='sexually faithful; "remained true to his wife"'/>
<rdf:Description rdf:about="&a;300912131">
	<b:glossaryEntry>devoted (sometimes fanatically) to a cause or concept of truth; "true believers bonded together against all who disagreed with them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300912314">
	<b:glossaryEntry>not true to duty or obligation or promises; "an unfaithful lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300912562"
	 b:glossaryEntry="not faithful to religion or party or cause"/>
<rdf:Description rdf:about="&a;300912659">
	<b:glossaryEntry>not faithful to spouse or lover; sexually unfaithful; "a cheating lover"; "adulterous husbands and wives"; "my two-timing boy friend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300912879">
	<b:glossaryEntry>tending to betray; especially having a treacherous character as attributed to the Carthaginians by the Romans; "Punic faith"; "the perfidious Judas"; "the fiercest and most treacherous of foes"; "treacherous intrigues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300913176">
	<b:glossaryEntry>not true to an obligation or trust; "is untrue to his highest opportunity and duty"-Bruno Laske</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300913324">
	<b:glossaryEntry>steadfast in allegiance or duty; "loyal subjects"; "loyal friends stood by him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300913581">
	<b:glossaryEntry>steadfast in devotion (especially to your lawful monarch or government); "it is impossible to be allegiant to two opposing forces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300913767">
	<b:glossaryEntry>resembling a dog; especially in devotion; "a doglike affection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300913884">
	<b:glossaryEntry>(archaic or Scottish) faithful and true; "leal to the core of her intrepid Scottish heart"- Harry Lauder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300914039">
	<b:glossaryEntry xml:space='preserve'><![CDATA[owing or owed feudal allegiance and service; "one''s liege lord"; "a liege subject"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300914173">
	<b:glossaryEntry>marked by unswerving loyalty; "a true-blue American"; "a reliable true-blue country club conservative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300914331">
	<b:glossaryEntry>deserting your allegiance or duty to leader or cause or principle; "disloyal aides revealed his indiscretions to the papers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300914672">
	<b:glossaryEntry>(military) having deserted your post or station without leave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300914784">
	<b:glossaryEntry>deliberately and abominably disloyal or likely to betray trust or confidence; "the faithless Benedict Arnold"; "a lying traitorous insurrectionist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300915013"
	 b:glossaryEntry="in opposition to a civil authority or government"/>
<rdf:Description rdf:about="&a;300915142">
	<b:glossaryEntry>consisting of or characterized by or inciting to mutiny; "mutinous acts"; "mutinous thoughts"; "a mutinous speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300915311">
	<b:glossaryEntry>participating in organized resistance to a constituted government; "the rebelling confederacy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300915488">
	<b:glossaryEntry>having deserted a cause or principle; "some provinces had proved recreant"; "renegade supporters of the usurper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300915666">
	<b:glossaryEntry>constituting treason; "a traitorous act"; "treasonable acts like sabotage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300915824">
	<b:glossaryEntry>likely to fail or be inaccurate; "everyone is fallible to some degree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300915985"
	 b:glossaryEntry='capable of making an error; "all men are error-prone"'/>
<rdf:Description rdf:about="&a;300916114">
	<b:glossaryEntry>liable to be erroneous or misleading; "an undependable generalization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300916257">
	<b:glossaryEntry>incapable of failure or error; "an infallible antidote"; "an infallible memmory"; "the Catholic Church considers the Pope infallible"; "no doctor is infallible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300916510">
	<b:glossaryEntry>not liable to failure; "a foolproof identification system"; "the unfailing sign of an amateur"; "an unfailing test"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300916693">
	<b:glossaryEntry>not liable to error; "the Church was...theoretically inerrant and omnicompetent"-G.G.Coulton; "lack an inerrant literary sense"; "an unerring marksman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300916922">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `with'') well known or easily recognized; "a familiar figure"; "he was familiar with those roads"; "familiar songs"; "familiar guests"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300917237">
	<b:glossaryEntry>having fair knowledge of; "they were acquainted"; "fully acquainted with the facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300917420">
	<b:glossaryEntry>much trodden and worn smooth or bare; "did not stray from the beaten path"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300917550">
	<b:glossaryEntry>frequently experienced; known closely or intimately; "a long-familiar face"; "a well-known voice reached her ears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300917756">
	<b:glossaryEntry>(used for emphasis) very familiar; "good old boy"; "same old story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300917876">
	<b:glossaryEntry>not known or well known; "a name unfamiliar to most"; "be alert at night especially in unfamiliar surroundings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300918134">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not known before; "used many strange words"; "saw many strange faces in the crowd"; "don''t let anyone unknown into the house"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300918323">
	<b:glossaryEntry>having little or no knowledge of; "unacquainted with city ways"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300918492">
	<b:glossaryEntry>being definitely out of the ordinary and unexpected; slightly odd or even a bit weird; "a strange exaltation that was indefinable"; "a strange fantastical mind"; "what a strange sense of humor she has"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300918955">
	<b:glossaryEntry xml:space='preserve'><![CDATA[ludicrously odd; "Hamlet''s assumed antic disposition"; "fantastic Halloween costumes"; "a grotesque reflection in the mirror"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300919170">
	<b:glossaryEntry>bizarre or fantastic; "had a crazy dream"; "wore a crazy hat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300919283">
	<b:glossaryEntry>beyond or deviating from the usual or expected; "a curious hybrid accent"; "her speech has a funny twang"; "they have some funny ideas about war"; "had an odd name"; "the peculiar aromatic odor of cloves"; "something definitely queer about this town"; "what a rum fellow"; "singular behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300919687">
	<b:glossaryEntry>so strange as to inspire a feeling of fear; "an uncomfortable and eerie stillness in the woods"; "an eerie midnight howl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300919867">
	<b:glossaryEntry>strikingly strange or unusual; "exotic costumes from the Far East"; "an exotic hair style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300920010">
	<b:glossaryEntry>(slang) strange and somewhat frightening; "the whole experience was really freaky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300920145">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(literature) characterized by gloom and mystery and the grotesque; "gothic novels like `Frankenstein''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300920300">
	<b:glossaryEntry>very unusual; different in character or quality from the normal or expected; "a strange, other dimension...where his powers seemed to fail"- Lance Morrow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300920505">
	<b:glossaryEntry>strange in an interesting or pleasing way; "quaint dialect words"; "quaint streets of New Orleans, that most foreign of American cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300920694">
	<b:glossaryEntry>very strange or unusual; odd or even incongruous in character or appearance; "the head terminating in the quaint duck bill which gives the animal its vernacular name"- Bill Beatty; "came forth a quaint and fearful sight"- Sir Walter Scott; "a quaint sense of humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300921012">
	<b:glossaryEntry>strikingly odd or unusual; "some trick of the moonlight; some weird effect of shadow"- Bram Stoker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300921162">
	<b:glossaryEntry>within normal everyday experience; common and ordinary; "familiar ordinary objects found in every home"; "a familiar everyday scene"; "a familiar excuse"; "a day like any other filled with familiar duties and experiences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300921474">
	<b:glossaryEntry>commonly encountered; "a common (or familiar) complaint"; "the usual greeting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300921613"
	 b:glossaryEntry='commonplace and ordinary; "the familiar everyday world"'/>
<rdf:Description rdf:about="&a;300921723">
	<b:glossaryEntry>being or in accordance with current fashion; "fashionable clothing"; "the fashionable side of town"; "a fashionable cafe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300922092"
	 b:glossaryEntry="in the current fashion or style"/>
<rdf:Description rdf:about="&a;300922219">
	<b:glossaryEntry>marked by smartness in dress and manners; "a dapper young man"; "a jaunty red hat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300922426"
	 b:glossaryEntry="intensely fashionable for a short time"/>
<rdf:Description rdf:about="&a;300922526"
	 b:glossaryEntry='(British informal) very chic; "groovy clothes"'/>
<rdf:Description rdf:about="&a;300922635">
	<b:glossaryEntry>(informal) "the in thing to do"; "large shoulder pads are in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300922745"
	 b:glossaryEntry="relating to a recently developed fashion or style"/>
<rdf:Description rdf:about="&a;300922866"
	 b:glossaryEntry='of or associated with people of fashion; "the smart set"'/>
<rdf:Description rdf:about="&a;300922974"
	 b:glossaryEntry='imposingly fashionable and elegant; "a swank apartment"'/>
<rdf:Description rdf:about="&a;300923090"
	 b:glossaryEntry="initiating or popularizing a trend"/>
<rdf:Description rdf:about="&a;300923183">
	<b:glossaryEntry>in accord with the latest fad; "trendy ideas"; "trendy clothes"; "voguish terminology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300923332">
	<b:glossaryEntry>not in accord with or not following current fashion; "unfashionable clothes"; "melodrama of a now unfashionable kind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300923646">
	<b:glossaryEntry>out of fashion; "a suit of rather antique appearance"; "demode (or outmoded) attire"; "outmoded ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300923868">
	<b:glossaryEntry>marked by features of the immediate and usually discounted past</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300923983">
	<b:glossaryEntry xml:space='preserve'><![CDATA[primly out of date; "nothing so frumpish as last year''s gambling game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300924125"
	 b:glossaryEntry='no longer fashionable; "that style is out these days"'/>
<rdf:Description rdf:about="&a;300924228">
	<b:glossaryEntry>(informal) "my mother has these prehistoric ideas about proper clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300924357">
	<b:glossaryEntry>having elegance or taste or refinement in manners or dress; "a little less posh but every bit as stylish as Lord Peter Wimsey"; "the stylish resort of Gstadd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300924655">
	<b:glossaryEntry>elegant and stylish; "chic elegance"; "a smart new dress"; "a suit of voguish cut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300924806"
	 b:glossaryEntry="affectedly trendy"/>
<rdf:Description rdf:about="&a;300924876">
	<b:glossaryEntry>(informal) elegant and fashionable; "classy clothes"; "a posh restaurant"; "a swish pastry shop oon the Rue du Bac"- Julia Child</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300925072"
	 b:glossaryEntry='(informal) flashily stylish; "a snazzy outfit"'/>
<rdf:Description rdf:about="&a;300925171">
	<b:glossaryEntry>lacking in style or elegance; "a styleless way of dressing"; "expensive but styleless country tweeds"; "wearing unstylish clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300925387">
	<b:glossaryEntry>lacking in smartness or taste; "a dowdy gray outfit"; "a clean and sunny but completely dowdy room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300925538">
	<b:glossaryEntry>acting or moving or capable of acting or moving quickly; "fast film"; "on the fast track in school"; "set a fast pace"; "a fast car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300926153">
	<b:glossaryEntry>speeded up, as of an academic course; "in an accelerated program in school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300926286">
	<b:glossaryEntry>increasing in speed; becoming progressively faster; "the accelerating inflation was cause for great concern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300926453"
	 b:glossaryEntry='quick and eager; "an alacritous response to the invitation"'/>
<rdf:Description rdf:about="&a;300926569">
	<b:glossaryEntry>very fast; "a blistering pace"; "got off to a hot start"; "in hot pursuit"; "a red-hot line drive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300926740"
	 b:glossaryEntry="(of a marching cadence) very quick"/>
<rdf:Description rdf:about="&a;300926833">
	<b:glossaryEntry>moving very fast; "fleet of foot"; "the fleet scurrying of squirrels"; "a swift current"; "swift flight of an arrow"; "a swift runner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300927027">
	<b:glossaryEntry>proceeding quickly or in haste; "to hastening ills a prey"- Oliver Goldsmith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300927159"
	 b:glossaryEntry='operating at high speed; "a high-speed food processor"'/>
<rdf:Description rdf:about="&a;300927270"
	 b:glossaryEntry='taking place at high speed; "a high-speed chase"'/>
<rdf:Description rdf:about="&a;300927375">
	<b:glossaryEntry>capable of quick response and great speed; "a hot sports car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300927486">
	<b:glossaryEntry>moving with great haste; "affection for this hurrying driving...little man"; "lashed the scurrying horses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300927659">
	<b:glossaryEntry>performed with little or no delay; "an immediate reply to my letter"; "prompt obedience"; "was quick to respond"; "a straightaway denial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300927884">
	<b:glossaryEntry>occurring with no delay; "relief was instantaneous"; "instant gratification"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300928033"
	 b:glossaryEntry="driven by or as if driven by jet propulsion"/>
<rdf:Description rdf:about="&a;300928136">
	<b:glossaryEntry>like a meteor in speed or brilliance or transience; "a meteoric rise to fame"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300928268">
	<b:glossaryEntry>accomplished rapidly and without delay; "was quick to make friends"; "his quick reaction prevented an accident"; "hoped for a speedy resolution of the problem"; "a speedy recovery"; "he has a right to a speedy trial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300928545">
	<b:glossaryEntry>done or occurring in a brief period of time; "a rapid rise through the ranks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300928674">
	<b:glossaryEntry>characterized by speed; moving with or capable of moving with high speed; "a rapid movment"; "a speedy car"; "a speedy errand boy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300928865"
	 b:glossaryEntry='moving with great speed; "the speeding car"'/>
<rdf:Description rdf:about="&a;300928963"
	 b:glossaryEntry='very fast; as if with wings; "on winged feet"'/>
<rdf:Description rdf:about="&a;300929061">
	<b:glossaryEntry>not moving quickly; taking a comparatively long time; "a slow walker"; "the slow lane of traffic"; "her steps were slow"; "he was slow in reacting to the news"; "slow but steady growth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300929513"
	 b:glossaryEntry='used of traffic; "bumper-to-bumper traffic"'/>
<rdf:Description rdf:about="&a;300929630"
	 b:glossaryEntry="wasting time"/>
<rdf:Description rdf:about="&a;300929733">
	<b:glossaryEntry>passing painfully or tediously slowly; "the dragging minutes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300929849"
	 b:glossaryEntry="(used of speech) uttered slowly with prolonged vowels"/>
<rdf:Description rdf:about="&a;300929969">
	<b:glossaryEntry>moving slowly and gently; "up a lazy river"; "lazy white clouds"; "at a lazy pace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300930102">
	<b:glossaryEntry>(used of records) playing at a slower speed and for a longer time than earlier records</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300930259"
	 b:glossaryEntry='moving slowly; "slow-moving cars"'/>
<rdf:Description rdf:about="&a;300930350"
	 b:glossaryEntry='with little movement; very slow; "a sluggish stream"'/>
<rdf:Description rdf:about="&a;300930457"
	 b:glossaryEntry='(music) at a rapid tempo; "the band played a fast fox trot"'/>
<rdf:Description rdf:about="&a;300930675"
	 b:glossaryEntry="(of tempo) fast"/>
<rdf:Description rdf:about="&a;300930744"
	 b:glossaryEntry="(of tempo) faster than allegro"/>
<rdf:Description rdf:about="&a;300930831"
	 b:glossaryEntry="(of tempo) moderately fast"/>
<rdf:Description rdf:about="&a;300930913"
	 b:glossaryEntry="(of tempo) very fast"/>
<rdf:Description rdf:about="&a;300930986"
	 b:glossaryEntry="(of tempo) as fast as possible"/>
<rdf:Description rdf:about="&a;300931074"
	 b:glossaryEntry="(of tempo) very fast and lively"/>
<rdf:Description rdf:about="&a;300931158"
	 b:glossaryEntry='(music) at a slow tempo; "the band played a slow waltz"'/>
<rdf:Description rdf:about="&a;300931408"
	 b:glossaryEntry="(of tempo) leisurely"/>
<rdf:Description rdf:about="&a;300931481"
	 b:glossaryEntry="(of tempo) moderately slow"/>
<rdf:Description rdf:about="&a;300931561"
	 b:glossaryEntry="(of tempo) slow"/>
<rdf:Description rdf:about="&a;300931628"
	 b:glossaryEntry="(of tempo) very slow"/>
<rdf:Description rdf:about="&a;300931705"
	 b:glossaryEntry="very slow in tempo and broad in manner"/>
<rdf:Description rdf:about="&a;300931795"
	 b:glossaryEntry="(of tempo) less slow and broad than largo"/>
<rdf:Description rdf:about="&a;300931892"
	 b:glossaryEntry="(of tempo) as slow and broad as possible"/>
<rdf:Description rdf:about="&a;300931990"
	 b:glossaryEntry="(of tempo) moderate"/>
<rdf:Description rdf:about="&a;300932064">
	<b:glossaryEntry>(used of timepieces) indicating a time ahead of or later than the correct time; "my watch is fast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300932213">
	<b:glossaryEntry>(used of timepieces) indicating a time earlier than the correct time; "the clock is slow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300932353">
	<b:glossaryEntry>giving and careful attention to detail; hard to please; excessively concerned with cleanliness; "a fastidious and incisive intellect"; "fastidious about personal cleanliness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300932728"
	 b:glossaryEntry="difficult to please"/>
<rdf:Description rdf:about="&a;300932810">
	<b:glossaryEntry>excessively fastidious and easily disgusted; "too nice about his food to take to camp cooking"; "so squeamish he would only touch the toilet handle with his elbow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300933065">
	<b:glossaryEntry>exacting especially about details; "a finicky eater"; "fussy about clothes"; "very particular about how her food was prepared"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300933276">
	<b:glossaryEntry>marked by extreme care in treatment of details; "a meticulous craftsman"; "almost worryingly meticulous in his business formalities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300933465">
	<b:glossaryEntry>characterized by excessive precision and attention to trivial details; "a persnickety job"; "a persnickety school teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300933658"
	 b:glossaryEntry="primly fastidious"/>
<rdf:Description rdf:about="&a;300933748">
	<b:glossaryEntry>not fastidious; not concerned with cleanliness; "unfastidious in her dress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300933936"
	 b:glossaryEntry="careless and slovenly"/>
<rdf:Description rdf:about="&a;300934010">
	<b:glossaryEntry>(microbiology) having complicated nutritional requirements; especially growing only in special artificial cultures; "fastidious microorganisms"; "certain highly specialized xerophytes are extremely exacting in their requirements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300934307"
	 b:glossaryEntry="(microbiology) not exacting in nutritional requirements"/>
<rdf:Description rdf:about="&a;300934421">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having much flesh (especially fat); "he hadn''t remembered how fat she was"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300934815"
	 b:glossaryEntry="having a large belly"/>
<rdf:Description rdf:about="&a;300934915">
	<b:glossaryEntry>swollen with fat; "blubber cheeks"; "blubber lips"; "a coarse blubbery individual"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300935062">
	<b:glossaryEntry>euphemisms for slightly fat; "a generation ago...buxom actresses were popular"- Robt.A.Hamilton; "chubby babies"; "pleasingly plump"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300935294">
	<b:glossaryEntry>heavy and compact in form or stature; "a wrestler of compact build"; "he was tall and heavyset"; "stocky legs"; "a thick middle-aged man"; "a thickset young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300935548"
	 b:glossaryEntry='excessively fat; "a weighty man"'/>
<rdf:Description rdf:about="&a;300935663"
	 b:glossaryEntry="having sagging folds of flesh beneath the chin or lower jaw"/>
<rdf:Description rdf:about="&a;300935806"
	 b:glossaryEntry="short and fat"/>
<rdf:Description rdf:about="&a;300935895"
	 b:glossaryEntry="somewhat fat"/>
<rdf:Description rdf:about="&a;300935961">
	<b:glossaryEntry>usually describes a large person who is fat but has a large frame to carry it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300936112"
	 b:glossaryEntry='repellently fat; "a bald porcine old man"'/>
<rdf:Description rdf:about="&a;300936215">
	<b:glossaryEntry xml:space='preserve'><![CDATA[euphemisms for `fat''; "men are portly and women are stout"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300936334">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking excess flesh; "you can''t be too rich or too thin"; "Yon Cassius has a lean and hungry look"-Shakespeare]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300936863"
	 b:glossaryEntry="suffering from anorexia nervosa; pathologically thin"/>
<rdf:Description rdf:about="&a;300936982">
	<b:glossaryEntry>very thin especially from disease or hunger or cold; "emaciated bony hands"; "a nightmare population of gaunt men and skeletal boys"; "eyes were haggard and cavernous"; "small pinched faces"; kept life in his wasted frame only by grim concentration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300937355"
	 b:glossaryEntry="characteristic of the bony face of a cadaver"/>
<rdf:Description rdf:about="&a;300937483"
	 b:glossaryEntry="ungracefully tall and thin"/>
<rdf:Description rdf:about="&a;300937581"
	 b:glossaryEntry="long and lean"/>
<rdf:Description rdf:about="&a;300937655"
	 b:glossaryEntry='having a lean and bony physique; "a rawboned cow hand"'/>
<rdf:Description rdf:about="&a;300937764"
	 b:glossaryEntry="resembling a reed or twig in being slender and fragile"/>
<rdf:Description rdf:about="&a;300937890">
	<b:glossaryEntry>resembling a scarecrow in being thin and ragged; "a forlorn scarecrowish figure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300938029">
	<b:glossaryEntry>having unattractive thinness; "a child with skinny freckled legs"; "a long scrawny neck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300938212">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lean and wrinkled by shrinkage as from age or illness; "the old woman''s shriveled skin"; "he looked shriveled and ill"; "a shrunken old man"; "a lanky scarecrow of a man with withered face and lantern jaws"-W.F.Starkie; "he did well despite his withered arm"; "a wizened little man with frizzy gray hair"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300938625">
	<b:glossaryEntry>being of delicate or slender build; "she was slender as a willow shoot is slender"- Frank Norris; "a slim girl with straight blonde hair"; "watched her slight figure cross the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300938878"
	 b:glossaryEntry="having a small waist"/>
<rdf:Description rdf:about="&a;300938990">
	<b:glossaryEntry>thin and fit; "the spare figure of a marathon runner"; "a body kept trim by exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300939134"
	 b:glossaryEntry="having long slender legs"/>
<rdf:Description rdf:about="&a;300939237"
	 b:glossaryEntry="lean and sinewy"/>
<rdf:Description rdf:about="&a;300939313">
	<b:glossaryEntry>thin and weak; "a wispy little fellow with small hands and feet"- Edmund Wilson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300939455"
	 b:glossaryEntry='containing or composed of fat; "fatty food"; "fat tissue"'/>
<rdf:Description rdf:about="&a;300939660">
	<b:glossaryEntry>composed of animal fat; "adipose tissue constitutes the fat of meat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300939782">
	<b:glossaryEntry>resembling or containing or spread with butter; "a rich buttery cake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300939905">
	<b:glossaryEntry>containing an unusual amount of grease or oil; "greasy hamburgers"; "oily fried potatoes"; "oleaginous seeds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300940099"
	 b:glossaryEntry='like or full of suet; "suety lamb chops"'/>
<rdf:Description rdf:about="&a;300940191">
	<b:glossaryEntry>(of soap) containing extra unsaponified fat; "superfatted toilet soaps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300940320"
	 b:glossaryEntry='without fat or fat solids; "nonfat or fat-free milk"'/>
<rdf:Description rdf:about="&a;300940482">
	<b:glossaryEntry>having relatively few calories; "diet cola"; "light (or lite) beer"; "lite (or light) mayonnaise"; "a low-cal diet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300940676">
	<b:glossaryEntry>used of milk and milk products from which the cream has been removed; "yogurt made with skim milk"; "she can drink skimmed milk but should avoid butter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300940889"
	 b:glossaryEntry="bringing death"/>
<rdf:Description rdf:about="&a;300941009">
	<b:glossaryEntry>causing or capable of causing death; "a fatal accident"; "a deadly enemy"; "mortal combat"; "a mortal illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300941191">
	<b:glossaryEntry>of an instrument of certain death; "deadly poisons"; "lethal weapon"; "a lethal injection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300941343">
	<b:glossaryEntry>causing or ending in or approaching death; "a terminal patient"; "terminal cancer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300941480"
	 b:glossaryEntry="not bringing death"/>
<rdf:Description rdf:about="&a;300941571"
	 b:glossaryEntry="not capable of causing death"/>
<rdf:Description rdf:about="&a;300941655">
	<b:glossaryEntry>being such that curing or healing is possible; "curable diseases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300941774">
	<b:glossaryEntry>being such that a cure is impossible; "an incurable disease"; "an incurable addiction to smoking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300941927"
	 b:glossaryEntry="(of meaning) capable of being penetrated or comprehended"/>
<rdf:Description rdf:about="&a;300942075">
	<b:glossaryEntry>of meaning; not capable of being penetrated; "a philosophy complex and, to the ordinary thinker, quite fathomless"; "unfathomable theories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300942358">
	<b:glossaryEntry>too deep for understanding; "one of the bottomless mysteries of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300942484"
	 b:glossaryEntry="of depth; capable of being sounded or measured"/>
<rdf:Description rdf:about="&a;300942605"
	 b:glossaryEntry="possible to determine the depth of"/>
<rdf:Description rdf:about="&a;300942707"
	 b:glossaryEntry="of depth; not capable of being sounded or measured"/>
<rdf:Description rdf:about="&a;300942852"
	 b:glossaryEntry="too deep to determine the depth of"/>
<rdf:Description rdf:about="&a;300942944">
	<b:glossaryEntry>(of winds or weather) tending to promote or facilitate; "the days were fair and the winds were favorable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300943154"
	 b:glossaryEntry='in the desired direction; "a following wind"'/>
<rdf:Description rdf:about="&a;300943257">
	<b:glossaryEntry>(of winds or weather) tending to hinder or oppose; "unfavorable winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300943436">
	<b:glossaryEntry>in an opposing direction; "adverse currents"; "a contrary wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300943564">
	<b:glossaryEntry>encouraging or approving or pleasing; "a favorable reply"; "he received a favorable rating"; "listened with a favorable ear"; "made a favorable impression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300943914"
	 b:glossaryEntry='expressing or manifesting approval; "approbative criticism"'/>
<rdf:Description rdf:about="&a;300944057"
	 b:glossaryEntry='very favorable; "he has a high opinion of himself"'/>
<rdf:Description rdf:about="&a;300944158"
	 b:glossaryEntry='being favorably inclined; "an indulgent attitude"'/>
<rdf:Description rdf:about="&a;300944263"
	 b:glossaryEntry="able to please or win approval"/>
<rdf:Description rdf:about="&a;300944348">
	<b:glossaryEntry>not encouraging or approving or pleasing; "unfavorable conditions"; "an unfavorable comparison"; "unfavorable comments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300944702"
	 b:glossaryEntry="expressing reproof or reproach especially as a corrective"/>
<rdf:Description rdf:about="&a;300944856">
	<b:glossaryEntry>contrary to your interests or welfare; "adverse circumstances"; "made a place for themselves under the most untoward conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300945074">
	<b:glossaryEntry>marked by features that oppose constructive treatment or development; "not able to accomplish much in such a hostile environment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300945257"
	 b:glossaryEntry="expressing or manifesting disapproval"/>
<rdf:Description rdf:about="&a;300945353">
	<b:glossaryEntry>containing or implying a slight or showing prejudice; "discriminatory attitudes and practices"; "invidious comparisons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300945545">
	<b:glossaryEntry>having or covered with feathers or plumage; "our feathered friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300945848">
	<b:glossaryEntry>having an aftershaft (a small feather at the base of some feathers)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300945974">
	<b:glossaryEntry>characterized by a covering of feathers; "the feathery congregaton of jays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300946104"
	 b:glossaryEntry='resembling a feather or feathers; "feathery palm trees"'/>
<rdf:Description rdf:about="&a;300946228"
	 b:glossaryEntry="(of an arrow) equipped with feathers"/>
<rdf:Description rdf:about="&a;300946326"
	 b:glossaryEntry='(heraldry) "arrows flighted argent"'/>
<rdf:Description rdf:about="&a;300946420"
	 b:glossaryEntry="having feathered wings"/>
<rdf:Description rdf:about="&a;300946496">
	<b:glossaryEntry>often used as combining forms; "fully plumaged young bird"; "brightly feathered birds"; "brilliantly plumaged parrots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300946669"
	 b:glossaryEntry="(biology) having an ornamental plume or feathery tuft"/>
<rdf:Description rdf:about="&a;300946795">
	<b:glossaryEntry>having or covered with or abounding in plumes; "the plumed serpent"; "white-plumed egrets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300946946">
	<b:glossaryEntry xml:space='preserve'><![CDATA[resembling a plume; "the dog''s plumy tail"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300947052">
	<b:glossaryEntry>having no feathers; "a featherless biped"; "the unfeathered legs of an Orpington"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300947241">
	<b:glossaryEntry>having the feathers removed, as from a pelt or a fowl; "a plucked chicken"; "an unfeathered goose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300947393">
	<b:glossaryEntry>(of an arrow) not equipped with feathers; "shot an unfledged arrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300947539">
	<b:glossaryEntry>exhibiting an agreeably appropriate manner or style; "a felicitous speaker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300947797">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expressive of sympathetic pleasure or joy on account of someone''s success or good fortune; "a congratulatory telegram"; "the usual congratulatory crowd was conspicuously absent"; "a gratulatory address"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300948074">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) socially adept; "it''s not cool to arrive at a party too early"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300948198">
	<b:glossaryEntry>well expressed and to the point; "a happy turn of phrase"; "a few well-chosen words"; "a felicitous comment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300948372">
	<b:glossaryEntry>(of language) aptly and pleasingly expressed; "a well-turned phrase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300948498">
	<b:glossaryEntry>extending good wishes for success; "his well-wishing supporters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300948624">
	<b:glossaryEntry>not appropriate in application; defective; "an infelicitous remark"; "infelicitous phrasing"; "the infelicitous typesetting was due to illegible copy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300948905">
	<b:glossaryEntry>not elegant or graceful in expression; "an awkward prose style"; "a clumsy apology"; "his cumbersome writing style"; "if the rumor is true, can anything be more inept than to repeat it now?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300949200">
	<b:glossaryEntry>unsuitable or regrettable; "an unfortunate choice of words"; "an unfortunate speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300949342">
	<b:glossaryEntry>made to fall (as by striking or cutting or shooting or by illness or exhaustion); "the felled boxer lay stretched on the canvas"; "felled trees covered the hillside"; "the downed oxen lay panting in the heat"; "a downed deer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300949665"
	 b:glossaryEntry='cut down; "the tree is down"'/>
<rdf:Description rdf:about="&a;300949761"
	 b:glossaryEntry='cut down with an ax; "a hewn oak"'/>
<rdf:Description rdf:about="&a;300949845"
	 b:glossaryEntry='(of trees) not cut down; "unfelled trees"'/>
<rdf:Description rdf:about="&a;300949959"
	 b:glossaryEntry='not cut down; "standing timber"; "uncut trees"'/>
<rdf:Description rdf:about="&a;300950068"
	 b:glossaryEntry="capable of reproducing"/>
<rdf:Description rdf:about="&a;300950324"
	 b:glossaryEntry="capable of conceiving"/>
<rdf:Description rdf:about="&a;300950402"
	 b:glossaryEntry="capable of producing offspring or vegetation"/>
<rdf:Description rdf:about="&a;300950499"
	 b:glossaryEntry="capable of being fertilized"/>
<rdf:Description rdf:about="&a;300950585"
	 b:glossaryEntry="made pregnant"/>
<rdf:Description rdf:about="&a;300950696"
	 b:glossaryEntry='very fertile; producing profuse growth; "rank earth"'/>
<rdf:Description rdf:about="&a;300950799"
	 b:glossaryEntry='incapable of reproducing; "an infertile couple"'/>
<rdf:Description rdf:about="&a;300951040">
	<b:glossaryEntry>not bearing offspring; "a barren woman"; "learned early in his marriage that he was sterile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300951195"
	 b:glossaryEntry="made infertile"/>
<rdf:Description rdf:about="&a;300951266"
	 b:glossaryEntry='not having been fertilized; "an unfertilized egg"'/>
<rdf:Description rdf:about="&a;300951390">
	<b:glossaryEntry>ended or brought to an end; "are you finished?"; "gave me the finished manuscript"; "the manuscript is finished"; "almost finished with his studies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300951665">
	<b:glossaryEntry>having come or been brought to a conclusion; "the harvesting was complete"; "the affair is over, ended, finished"; "the abruptly terminated interview"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300951924">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having finished or arrived at completion; "certain to make history before he''s done"; "it''s a done deed"; "after the treatment, the patient is through except for follow-up"; "almost through with his studies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300952210">
	<b:glossaryEntry>having no further concern with; "he was through with school and he was through with family"- John Dos Passos; "done with gambling"; "done with drinking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300952439"
	 b:glossaryEntry='used up; "time is up"'/>
<rdf:Description rdf:about="&a;300952512">
	<b:glossaryEntry>not brought to an end or conclusion; "unfinished business"; "the building is still unfinished"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300952735">
	<b:glossaryEntry>not yet finished; "his thesis is still incomplete"; "an uncompleted play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300952879">
	<b:glossaryEntry>awaiting conclusion or confirmation; "business still pending"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300952994">
	<b:glossaryEntry>not done; "the work could be done or undone and nobody cared"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300953108">
	<b:glossaryEntry>not ended; lacking an end or conclusion; "he did with the book still unended"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300953239">
	<b:glossaryEntry>(of materials or goods) brought to the desired final state; "a finished product"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300953482"
	 b:glossaryEntry="(of lumber or stone) to trim and smooth"/>
<rdf:Description rdf:about="&a;300953586"
	 b:glossaryEntry="(of market animals) made ready for market"/>
<rdf:Description rdf:about="&a;300953682">
	<b:glossaryEntry>subject to or used in the process of finishing or fattening up for slaughter; "a fattening hog"; "fattening pens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300953851"
	 b:glossaryEntry="not brought to the desired final state"/>
<rdf:Description rdf:about="&a;300954090"
	 b:glossaryEntry='used of wood and furniture; "raw wood"'/>
<rdf:Description rdf:about="&a;300954192"
	 b:glossaryEntry="of stone or timber; shaped roughly without finishing"/>
<rdf:Description rdf:about="&a;300954300">
	<b:glossaryEntry>of lumber or stone or hides; not finished or dressed; "undressed granite"; "undressed hides"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300954448"
	 b:glossaryEntry="(of market animals) not optimal for marketing"/>
<rdf:Description rdf:about="&a;300954550">
	<b:glossaryEntry>(of stone especially) not given a finished form by or as if by hewing; "a house of unhewn gray stone roughly cemented together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300954730">
	<b:glossaryEntry>bounded or limited in magnitude or spatial or temporal extent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300954934">
	<b:glossaryEntry>having the limits or boundaries established; "a delimited frontier through the disputed region"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300955095">
	<b:glossaryEntry>capable of being used up; capable of being exhausted; "our exhaustible reserves of fossil fuel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300955248"
	 b:glossaryEntry="existing or enduring for a limited time only"/>
<rdf:Description rdf:about="&a;300955350"
	 b:glossaryEntry='not unlimited; "a limited list of choices"'/>
<rdf:Description rdf:about="&a;300955446">
	<b:glossaryEntry>having no limits or boundaries in time or space or extent or magnitude; "the infinite ingenuity of man"; "infinite wealth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300955713">
	<b:glossaryEntry>seemingly boundless in amount, number, degree, or especially extent; "unbounded enthusiasm"; "children with boundless energy"; "a limitless supply of money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300955949">
	<b:glossaryEntry>having no known beginning and presumably no end; "the dateless rise and fall of the tides"; "time is endless"; "sempiternal truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300956158"
	 b:glossaryEntry='infinitely great in number; "endless waves"'/>
<rdf:Description rdf:about="&a;300956255">
	<b:glossaryEntry>that cannot be entirely consumed or used up; "an inexhaustible supply of coal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300956405">
	<b:glossaryEntry>(grammar) of verbs; relating to forms of the verb that are limited in time by a tense and (usually) show agreement with number and person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300956613"
	 b:glossaryEntry="having inflections to indicate tense"/>
<rdf:Description rdf:about="&a;300956714">
	<b:glossaryEntry>(grammar) of verbs; having neither person nor number nor mood (as a participle or gerund or infinitive); "infinite verb form"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300956925"
	 b:glossaryEntry="not having inflections to indicate tense"/>
<rdf:Description rdf:about="&a;300957036">
	<b:glossaryEntry xml:space='preserve'><![CDATA[first or beginning; "the memorable opening bars of Beethoven''s Fifth"; "the play''s opening scene"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300957259">
	<b:glossaryEntry>serving to begin; "the beginning canto of the poem"; "the first verse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300957396">
	<b:glossaryEntry xml:space='preserve'><![CDATA[serving to set in motion; "the magazine''s inaugural issue"; "the initiative phase in the negotiations"; "an initiatory step toward a treaty"; "his first (or maiden) speech in Congress"; "the liner''s maiden voyage"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300957708">
	<b:glossaryEntry>serving to open or begin; "began the slide show with some introductory remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300957846">
	<b:glossaryEntry>appropriate to the beginning or start of an event; "the starting point"; "hands in the starting position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300958006">
	<b:glossaryEntry>final or ending; "the closing stages of the election"; "the closing weeks of the year"; "the closing scene of the film"; "closing remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300958252">
	<b:glossaryEntry>occurring at or forming an end or termination; "his concluding words came as a surprise"; "the final chapter"; "the last days of the dinosaurs"; "terminal leave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300958496">
	<b:glossaryEntry>coming to an end; "a contract terminative with the end of the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300958620"
	 b:glossaryEntry='taking place at the close of a fiscal year; "year-end audit"'/>
<rdf:Description rdf:about="&a;300958735">
	<b:glossaryEntry>preceding all others in time or space or degree; "the first house on the right"; "the first day of spring"; "his first political race"; "her first baby"; "the first time"; "the first meetings of the new party"; "the first phase of his training"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300959301">
	<b:glossaryEntry>representing or constituting an original type after which other similar things are patterned; "archetypal patterns"; "she was the prototypal student activist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300959572">
	<b:glossaryEntry>serving as a base or starting point; "a basic course in Russian"; "basic training for raw recruits"; "a set of basic tools"; "an introductory art course"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300959792">
	<b:glossaryEntry>occurring at the beginning; "took the initial step toward reconciliation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300959919"
	 b:glossaryEntry='first in order of birth; "the firstborn child"'/>
<rdf:Description rdf:about="&a;300960030">
	<b:glossaryEntry>used of a person in the first year of an experience (especially in United States high school or college); "a freshman senator"; "freshman year in high school or college"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300960267"
	 b:glossaryEntry='first in time; "the oldest rocks on the planet"'/>
<rdf:Description rdf:about="&a;300960367">
	<b:glossaryEntry>preceding all others in time or being as first made or performed; "the original inhabitants of the Americas"; "the book still has its original binding"; "restored the house to its original condition"; "the original performance of the opera"; "the original cast"; "retracted his original statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300960719"
	 b:glossaryEntry='preceding all others in time; "the premiere showing"'/>
<rdf:Description rdf:about="&a;300960836">
	<b:glossaryEntry>first in rank or degree; "an architect of premier rank"; "the prime minister"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300960981"
	 b:glossaryEntry='used of the first or originating agent; "prime mover"'/>
<rdf:Description rdf:about="&a;300961089">
	<b:glossaryEntry>coming after all others in time or space or degree or being the only one remaining; "the last time I saw Paris"; "the last day of the month"; "had the last word"; "waited until the last minute"; "he raised his voice in a last supreme call"; "the last game of the season"; "down to his last nickel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300961599"
	 b:glossaryEntry="third from last"/>
<rdf:Description rdf:about="&a;300961676">
	<b:glossaryEntry>being or situated at an end; "the endmost pillar"; "terminal buds on a branch"; "a terminal station"; "the terminal syllable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300961866">
	<b:glossaryEntry>delivered at the moment of parting as if in flight or retreat; "paused to deliver a parting shot at the door"; "a Parthian volley of expletives from Uncle Billy"- Bret Harte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300962104">
	<b:glossaryEntry>next to the last; "the author inadvertently reveals the murderer in the penultimate chapter"; "the figures in the next-to-last column"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300962311">
	<b:glossaryEntry>used of the fourth and final year in United States high school or college; "the senior prom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300962473">
	<b:glossaryEntry>near but not precisely at an end; "a subterminal band of color on the tail feathers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300962615">
	<b:glossaryEntry>providing for termination; "a program with a sunset provision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300962733">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being the last or concluding element of a series; "the ultimate sonata of that opus"; "a distinction between the verb and noun senses of `conflict'' is that in the verb the stress is on the ultimate (or last) syllable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300963005">
	<b:glossaryEntry>lying between two extremes in time or space or degree; "going from sitting to standing without intermediate pushes with the hands"; "intermediate stages in a process"; "intermediate stops on the route"; "an intermediate level"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300963416">
	<b:glossaryEntry>intermediate in character or position; "a gray area between clearly legal and strictly illegal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300963569">
	<b:glossaryEntry>at a point midway between two extremes; "at the halfway mark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300963684">
	<b:glossaryEntry>being neither at the beginning nor at the end in a series; "adolescence is an awkward in-between age"; "in a mediate position"; "the middle point on a line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300963916">
	<b:glossaryEntry>used of the third or next to final year in United States high school or college; "the junior class"; "a third-year student"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300964123">
	<b:glossaryEntry>coming next after first; "a second chance"; "the second vice president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300964247">
	<b:glossaryEntry>used of the second year in United States high school or college; "the sophomore class"; "his sophomore year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300964428">
	<b:glossaryEntry>(music) highest in pitch or chief among parts or voices or instruments or orchestra sections; "first soprano"; "the first violin section"; "played first horn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300964638">
	<b:glossaryEntry>(music) a part or voice or instrument or orchestra section lower in pitch than or subordinate to the first; "second flute"; "the second violins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300964835">
	<b:glossaryEntry>capable of being split or cleft or divided in the direction of the grain; "fissile crystals"; "fissile wood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300964997"
	 b:glossaryEntry="not fissile"/>
<rdf:Description rdf:about="&a;300965065">
	<b:glossaryEntry>(physics) capable of undergoing nuclear fission; "a fissionable nucleous"; "fissionable material"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300965230"
	 b:glossaryEntry="(physics) not capable of undergoing fission"/>
<rdf:Description rdf:about="&a;300965334">
	<b:glossaryEntry>physically and mentally sound or healthy; "felt relaxed and fit after their holiday"; "keeps fit with diet and exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300965604">
	<b:glossaryEntry>having a strong healthy body; "an able seaman"; "every able-bodied young man served in the army"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300965765">
	<b:glossaryEntry>physically fit; "exercised daily to keep herself in condition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300965903">
	<b:glossaryEntry>not in good physical or mental condition; out of condition; "fat and very unfit"; "certified as unfit for army service"; "drunk and unfit for service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300966429"
	 b:glossaryEntry="mentally or physically unfit"/>
<rdf:Description rdf:about="&a;300966524">
	<b:glossaryEntry>having uncoordinated muscular movements, symptomatic of a CNS disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300966659"
	 b:glossaryEntry="characteristic of or suffering from autism"/>
<rdf:Description rdf:about="&a;300966756"
	 b:glossaryEntry="have legs that curve outward at the knees"/>
<rdf:Description rdf:about="&a;300966893">
	<b:glossaryEntry>(of a horse) having bones of the back united by a bony growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300967014"
	 b:glossaryEntry="disabled in the feet or legs"/>
<rdf:Description rdf:about="&a;300967121"
	 b:glossaryEntry="characteristic of or suffering from kyphosis"/>
<rdf:Description rdf:about="&a;300967283"
	 b:glossaryEntry="incapacitated by injury or illness"/>
<rdf:Description rdf:about="&a;300967402"
	 b:glossaryEntry='(British informal) sore or lame; "a gammy foot"'/>
<rdf:Description rdf:about="&a;300967501">
	<b:glossaryEntry>having the knees abnormally close together and the ankles wide apart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300967627"
	 b:glossaryEntry="(of horses) disabled in the feet or legs"/>
<rdf:Description rdf:about="&a;300967729"
	 b:glossaryEntry="having abnormal sagging of the spine (especially in horses)"/>
<rdf:Description rdf:about="&a;300967876"
	 b:glossaryEntry="having a part of the body crippled or disabled"/>
<rdf:Description rdf:about="&a;300967987"
	 b:glossaryEntry="affected or subject to with paralysis"/>
<rdf:Description rdf:about="&a;300968092">
	<b:glossaryEntry>suffering complete paralysis of the lower half of the body usually resulting from damage to the spinal cord</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300968256">
	<b:glossaryEntry>meeting adequate standards for a purpose; "water fit to drink"; "fit for duty"; "do as you think fit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300968443">
	<b:glossaryEntry>adequate for the purpose; "the water was acceptable for drinking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300968565">
	<b:glossaryEntry>meant or adapted for an occasion or use; "a tractor suitable (or fit) for heavy duty"; "not an appropriate (or fit) time for flippancy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300968778">
	<b:glossaryEntry>below the required standards for a purpose; "an unfit parent"; "unfit for human consumption"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300968976">
	<b:glossaryEntry>officially pronounced unfit for use or consumption; "a row of condemned bulildings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300969115"
	 b:glossaryEntry='unfit for human beings; "subhuman conditions of life"'/>
<rdf:Description rdf:about="&a;300969223">
	<b:glossaryEntry>not meant or adapted for a particular purpose; "a solvent unsuitable for use on wood surfaces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300969374"
	 b:glossaryEntry="(photography) lacking contrast or shading between tones"/>
<rdf:Description rdf:about="&a;300969498">
	<b:glossaryEntry>(of a photograph) lacking in contrast because it was left in the developer for less than the required time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300969665">
	<b:glossaryEntry>(photography) having sharp differences between black and white</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300969783"
	 b:glossaryEntry='able to flex; able to bend easily; "slim flexible birches"'/>
<rdf:Description rdf:about="&a;300969996">
	<b:glossaryEntry>capable of being bent or flexed or twisted without breaking; "a flexible wire"; "a pliant young tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300970171">
	<b:glossaryEntry>having unusually flexible joints especially of the limbs or fingers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300970299">
	<b:glossaryEntry>(used of persons'' bodies) capable of moving or bending freely</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300970422">
	<b:glossaryEntry>(of muscles) relieved of stiffness by stretching; "well-stretched muscles are less susceptible to injury"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300970583">
	<b:glossaryEntry>literal meanings; "an inflexible iron bar"; "an inflexible knife blade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300970837">
	<b:glossaryEntry>having stiff muscles as the result of excessive exercise; "he arrived accompanied by two muscle-bound body guards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300971010">
	<b:glossaryEntry>incapable of or resistant to bending; "a rigid strip of metal"; "a table made of rigid plastic"; "a palace guardsman stiff as a poker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300971204"
	 b:glossaryEntry="not fully rigid"/>
<rdf:Description rdf:about="&a;300971275">
	<b:glossaryEntry>of a collar; standing up rather than folded down; "an uncomfortable standup collar"; "a stiff collar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300971439">
	<b:glossaryEntry>lacking ease in bending; not limber; "a stiff neck"; "stiff joints"; "stiff hairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300971573">
	<b:glossaryEntry>made or become difficult to move or bend; "felt the pain of stiffened joints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300971706">
	<b:glossaryEntry>extended meanings; capable of change; "a flexible character"; "flexible schedules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300971897">
	<b:glossaryEntry>(used of e.g. personality traits) readily adaptable; "a supple mind"; "a limber imagination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300972051">
	<b:glossaryEntry>able to be negotiated or arranged by compromise; "negotiable demands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300972177"
	 b:glossaryEntry="(used of persons) having many skills"/>
<rdf:Description rdf:about="&a;300972269">
	<b:glossaryEntry>extended meanings; incapable of change; "a man of inflexible purpose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300972485">
	<b:glossaryEntry>not capable of being swayed or diverted from a course; unsusceptible to persuasion; "he is adamant in his refusal to change his mind"; "Cynthia was inexorable; she would have none of him"- W.Churchill; "an intransigent conservative opposed to every liberal tendancy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300972846">
	<b:glossaryEntry>tradition-bound and obstinately opinionated; "an inflexible (or die-hard) conservative"; "rock-ribbed republican"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300973031">
	<b:glossaryEntry>having austere inflexibility; "a flinty manner"; "granitic morality"; "his unyielding mouth and glassy eyes"- Marchette Chute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300973233">
	<b:glossaryEntry>set in a rigidly conventional pattern of behavior, habits, or beliefs; "obsolete fossilized ways"; "an ossified bureaucratic system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300973433">
	<b:glossaryEntry>inflexibly entrenched and unchangeable; "brassbound traditions"; "brassbound party loyalists"; "an ironclad rule"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300973614">
	<b:glossaryEntry>not making concessions; "took an uncompromising stance in the peace talks"; "uncompromising honesty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300973806">
	<b:glossaryEntry>refusing to give way or compromise; "unyielding determination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300973925">
	<b:glossaryEntry>making or willing to make concessions; "loneliness tore through him...whenever he thought of...even the compromising Louis du Tillet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300974161">
	<b:glossaryEntry>tending to give in or surrender or agree; "too yielding to make a stand against any encroachments"- V.I.Parrington"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300974331">
	<b:glossaryEntry>(aeronautics) designating an airship or dirigible having a form maintained by a stiff unyielding frame or structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300974516">
	<b:glossaryEntry>(aeronautics) having a form maintained by a rigid keel-like structure as well as by internal gas pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300974677">
	<b:glossaryEntry>(aeronautics) designating an airship having a shape maintained only by internal gas pressure and without a supporting structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300974859">
	<b:glossaryEntry>capable of adapting (of becoming or being made suitable) to a particular situation or use; "to succeed one must be adaptable"; "the frame was adaptable to cloth bolts of different widths"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300975228">
	<b:glossaryEntry>capable of being changed so as to match or fit; "adjustable seat belts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300975356">
	<b:glossaryEntry>(British; of a radio receiver) adaptable to all voltages; "an all-mains set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300975491">
	<b:glossaryEntry>designed to be changed from one use or form to another; "a convertible sofa"; "a convertible coupe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300975648">
	<b:glossaryEntry>able to adjust readily to different conditions; "an adaptable person"; "a flexible personality"; "an elastic clause in a contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300975862">
	<b:glossaryEntry>(used of a story or literary work) capable of being adapted to motion picture form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300975999">
	<b:glossaryEntry>open to change; liable to change; "an emotionally labile person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300976116">
	<b:glossaryEntry>(used of a device) designed so that a property (as e.g. light) can be varied; "a variable capacitor"; "variable filters in front of the mercury xenon lights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300976328"
	 b:glossaryEntry="not adaptable"/>
<rdf:Description rdf:about="&a;300976417">
	<b:glossaryEntry>incapable of adapting or changing to meet circumstances; "a rigid disciplinarian"; "an inflexible law"; "an unbending will to dominate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300976629">
	<b:glossaryEntry>(of a plant ovule) curved with the micropyle near the base almost touching its stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300976774">
	<b:glossaryEntry>(of a plant ovule) completely straight with the micropyle at the apex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300976902">
	<b:glossaryEntry>(of a plant ovule) completely inverted; turned back 180 degrees on its stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300977046">
	<b:glossaryEntry>(of a plant ovule) partly inverted; turned back 90 degrees on its stalk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300977176">
	<b:glossaryEntry>(of hair) having curls or waves; "they envied her naturally curly hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300977407"
	 b:glossaryEntry="having curls"/>
<rdf:Description rdf:about="&a;300977482"
	 b:glossaryEntry="in small tight curls"/>
<rdf:Description rdf:about="&a;300977589"
	 b:glossaryEntry='treated with chemicals to make it curly; "permed hair"'/>
<rdf:Description rdf:about="&a;300977696"
	 b:glossaryEntry="in ringlets"/>
<rdf:Description rdf:about="&a;300977763"
	 b:glossaryEntry="in waves"/>
<rdf:Description rdf:about="&a;300977822">
	<b:glossaryEntry>(of hair) having no waves or curls; "her naturally straight hair hung long and silky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300978016"
	 b:glossaryEntry="not having been curled"/>
<rdf:Description rdf:about="&a;300978093">
	<b:glossaryEntry>not having had a permanent wave; "smooth glossy unpermed hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300978210">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bent over or doubled up so that one part lies on another; "a folded map"; "a folded tophat is collapsed"; "when a bird''s wings are brought close to the body they are spoken of as folded"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300978629"
	 b:glossaryEntry='arranged in parallel folds; "plicate leaves"'/>
<rdf:Description rdf:about="&a;300978739">
	<b:glossaryEntry>capable of being folded into two parts, as with doors that are hinged together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300978870"
	 b:glossaryEntry="(of the wings of birds and insects) closed together"/>
<rdf:Description rdf:about="&a;300978974"
	 b:glossaryEntry='folded compactly; "put the collapsed top hat into its box"'/>
<rdf:Description rdf:about="&a;300979088"
	 b:glossaryEntry='folded in two; "doubled sheets of paper"'/>
<rdf:Description rdf:about="&a;300979182">
	<b:glossaryEntry>made compact by doubling or bending over; "a folded-up newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300979303"
	 b:glossaryEntry="folded into pleats"/>
<rdf:Description rdf:about="&a;300979375">
	<b:glossaryEntry>folded in on itself to form a roll; "the edges of the handkerchief were rolled and whipped"; "jeans with rolled-up legs"; "swatted the fly with a rolled newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300979606">
	<b:glossaryEntry>pleated or tucked in lines radiating from a circular edge; "blouse with a sunburst yoke"; "sunray fan pleats below the hips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300979794">
	<b:glossaryEntry>spread or opened out; "an unfolded newspaper"; "unfolded wings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300979966"
	 b:glossaryEntry="without pleats"/>
<rdf:Description rdf:about="&a;300980043"
	 b:glossaryEntry='opened out; "an open newspaper"'/>
<rdf:Description rdf:about="&a;300980125"
	 b:glossaryEntry="unwound and spread out (of something rolled or coiled)"/>
<rdf:Description rdf:about="&a;300980234"
	 b:glossaryEntry='having feet; "footed creatures"'/>
<rdf:Description rdf:about="&a;300980372"
	 b:glossaryEntry="with feet flat on the ground; not tiptoe"/>
<rdf:Description rdf:about="&a;300980470"
	 b:glossaryEntry="(zoology) having or resembling a foot"/>
<rdf:Description rdf:about="&a;300980560"
	 b:glossaryEntry="having feet with webbed toes"/>
<rdf:Description rdf:about="&a;300980656"
	 b:glossaryEntry="having no feet or analogous appendages"/>
<rdf:Description rdf:about="&a;300980767"
	 b:glossaryEntry='(of snakes and eels) naturally footless; "eels are apodal"'/>
<rdf:Description rdf:about="&a;300980888">
	<b:glossaryEntry>having a toe or toes of a specified kind; often used in combination; "long-toed"; "five-toed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300981074"
	 b:glossaryEntry='having a pointed toe; "pointy-toed shoes"'/>
<rdf:Description rdf:about="&a;300981187"
	 b:glossaryEntry='having a square toe; "square-toed shoes"'/>
<rdf:Description rdf:about="&a;300981299"
	 b:glossaryEntry='lacking a toe or toes; "a toeless shoe"'/>
<rdf:Description rdf:about="&a;300981392"
	 b:glossaryEntry="having feet that turn inward"/>
<rdf:Description rdf:about="&a;300981478"
	 b:glossaryEntry="having feet that turn outward"/>
<rdf:Description rdf:about="&a;300981613">
	<b:glossaryEntry>having broad flat feet that usually turn outward; "a slow flat-footed walk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300981746"
	 b:glossaryEntry='turned outward in an ungainly manner; "splay knees"'/>
<rdf:Description rdf:about="&a;300981849"
	 b:glossaryEntry="(nautical) situated at or toward the bow of a vessel"/>
<rdf:Description rdf:about="&a;300982045"
	 b:glossaryEntry="pertaining to the forward part of a vessel"/>
<rdf:Description rdf:about="&a;300982140">
	<b:glossaryEntry>situated closest to the bow; "the foremost compartment of the ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300982262">
	<b:glossaryEntry>situated at or toward the front; "the fore cabins"; "the forward part of the ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300982398">
	<b:glossaryEntry>(nautical, aeronautical) situated at or toward the stern or tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300982605"
	 b:glossaryEntry="located farther aft"/>
<rdf:Description rdf:about="&a;300982679"
	 b:glossaryEntry="located closest to the stern or tail"/>
<rdf:Description rdf:about="&a;300982771"
	 b:glossaryEntry="(nautical) pertaining to the after part of a vessel"/>
<rdf:Description rdf:about="&a;300982877"
	 b:glossaryEntry="(aeronautical) pertaining to the tail section of a plane"/>
<rdf:Description rdf:about="&a;300982987">
	<b:glossaryEntry>(of racket strokes) made with palm facing direction of stroke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300983119">
	<b:glossaryEntry>(of racket strokes) made across the body with back of hand facing direction of stroke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300983275">
	<b:glossaryEntry xml:space='preserve'><![CDATA[belonging to one by birth; "my native land"; "one''s native language"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300983397">
	<b:glossaryEntry>acquired as your own by free choice; "my adopted state"; "an adoptive country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300983540">
	<b:glossaryEntry>relating to or originating in or characteristic of another place or part of the world; "foreign nations"; "a foreign accent"; "on business in a foreign city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300983931">
	<b:glossaryEntry>not native and not fully established; locally or temporarily naturalized; "an adventive weed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984080">
	<b:glossaryEntry>being or from or characteristic of another place or part of the world; "alien customs"; "exotic plants in a greenhouse"; "moved to a strange country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984300">
	<b:glossaryEntry>of plants or animals originating in a part of the world other than where they are growing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984445">
	<b:glossaryEntry>introduced from another region and persisting without cultivation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984582">
	<b:glossaryEntry>of persons born in another area or country than that lived in; "our large nonnative population"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984748">
	<b:glossaryEntry>used of especially merchandise brought from a foreign source; "imported wines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984881">
	<b:glossaryEntry>being or coming from another country; "tramontane influences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300984999"
	 b:glossaryEntry="not having acquired citizenship"/>
<rdf:Description rdf:about="&a;300985090">
	<b:glossaryEntry>being such by origin; "the native North American sugar maple"; "many native artists studied abroad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300985314">
	<b:glossaryEntry>originating where it is found; "the autochthonal fauna of Australia includes the kangaroo"; "autochthonous rocks and people and folktales"; "endemic folkways"; "the Ainu are indigenous to the northernmost islands of Japan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300985649">
	<b:glossaryEntry>produced in a particular country; "domestic wine"; "domestic oil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300985769">
	<b:glossaryEntry>grown or originating in a particular place; "stands selling local fruits and vegetables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300985921">
	<b:glossaryEntry>belonging to a place by birth; "a native-born Scot"; "a native Scot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300986047">
	<b:glossaryEntry>being or composed of people inhabiting a region from the beginning; "native Americans"; "the aboriginal peoples of Australia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300986238">
	<b:glossaryEntry>not being or composed of aborigines; "the nonnative population of South Africa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300986373">
	<b:glossaryEntry>of concern to or concerning the affairs of other nations (other than your own); "foreign trade"; "a foreign office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300986596"
	 b:glossaryEntry='in a foreign country; "markets abroad"; "overseas markets"'/>
<rdf:Description rdf:about="&a;300986718">
	<b:glossaryEntry>from or between other countries; "external commerce"; "international trade"; "developing nations need outside help"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300986917">
	<b:glossaryEntry>of concern to or concerning the internal affairs of a nation; "domestic issues such as tax rate and highway construction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300987147">
	<b:glossaryEntry xml:space='preserve'><![CDATA[inside the country; "the British Home Office has broader responsibilities than the United States Department of the Interior"; "the nation''s internal politics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300987395">
	<b:glossaryEntry>of or relating to the government of a municipality; "international law...only authorizes a belligerant to punish a spy under its municipal law"- J.L.kuntz</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300987605">
	<b:glossaryEntry>of or involving the home or family; "domestic worries"; "domestic happiness"; "they share the domestic chores"; "everything sounded very peaceful and domestic"; "an author of blood-and-thunder novels yet quite domestic in his taste"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300988018">
	<b:glossaryEntry>accustomed to home life; "some men think it unmanly to be domesticated; others find gratification in it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300988181">
	<b:glossaryEntry>relating to or taking place in a home or house or household; "home cooking"; "home furnishings"; "home care for the elderly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300988359"
	 b:glossaryEntry="devoted to home duties and pleasures"/>
<rdf:Description rdf:about="&a;300988453">
	<b:glossaryEntry>of or related to or used in the running of a household; "household chores"; "household management"; "household appliances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300988631"
	 b:glossaryEntry='related or suited to a housewife; "housewifely virtues"'/>
<rdf:Description rdf:about="&a;300988744">
	<b:glossaryEntry>related to or suited to a husband; "assumed husbandly duties like mowing the lawn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300988882">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not domestic or related to home; "had established herself in her career at the price of being so undomestic she didn''t even know how to light the oven"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300989126">
	<b:glossaryEntry>unaccustomed to home life; "after years of marriage he remained essentially undomesticated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300989278"
	 b:glossaryEntry="easily forgotten"/>
<rdf:Description rdf:about="&a;300989370"
	 b:glossaryEntry="not worth remembering"/>
<rdf:Description rdf:about="&a;300989449"
	 b:glossaryEntry="impossible to forget"/>
<rdf:Description rdf:about="&a;300989583">
	<b:glossaryEntry>continually recurring to the mind; "haunting memories"; "the cathedral organ and the distant voices have a haunting beauty"- Claudia Cassidy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300989791"
	 b:glossaryEntry='continuing for a long time; "a lingering sense of guilt"'/>
<rdf:Description rdf:about="&a;300989906"
	 b:glossaryEntry="worth remembering"/>
<rdf:Description rdf:about="&a;300989979">
	<b:glossaryEntry>inclined or able to forgive and show mercy; "a kindly forgiving nature"; "a forgiving embrace to the naughty child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300990186">
	<b:glossaryEntry>tolerant and forgiving under provocation; "our neighbor was very kind about the window our son broke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300990349"
	 b:glossaryEntry="not vindictive"/>
<rdf:Description rdf:about="&a;300990422">
	<b:glossaryEntry>unwilling or unable to forgive or show mercy; "a surly unforgiving old woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300990575">
	<b:glossaryEntry>disposed to seek revenge or intended for revenge; "more vindictive than jealous love"- Shakespeare; "punishments...essentially vindictive in their nature"- M.R.Cohen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300990821">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being in accord with established forms and conventions and requirements (as e.g. of formal dress); "pay one''s formal respects"; "formal dress"; "a formal ball"; "the requirement was only formal and often ignored"; "a formal education"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300991360">
	<b:glossaryEntry>marked by pomp or ceremony or formality; "a solemn occasion"; "ceremonial garb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300991505">
	<b:glossaryEntry>rigidly formal or bound by convention; "their ceremonious greetings did not seem heartfelt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300991669">
	<b:glossaryEntry>(of an occasion) requiring formal clothes; "a dress dinner"; "a full-dress ceremony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300991818">
	<b:glossaryEntry>being a matter of form only; lacking substance; "a form-only requirement that is usually ignored"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300991974">
	<b:glossaryEntry>suitable for formal occasions; "formal wear"; "a full-dress uniform"; "dress shoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300992122">
	<b:glossaryEntry>being such in name only; "the nominal (or titular) head of his party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300992255"
	 b:glossaryEntry='formally laid down or imposed; "positive laws"'/>
<rdf:Description rdf:about="&a;300992369"
	 b:glossaryEntry='as a formality only; "a one-candidate pro forma election"'/>
<rdf:Description rdf:about="&a;300992496">
	<b:glossaryEntry>moderately formal; requiring a dinner jacket; "he wore semiformal attire"; "a black-tie dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300992674">
	<b:glossaryEntry>rigidly formal; "a starchy manner"; "the letter was stiff and formal"; "his prose has a buckram quality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300992850">
	<b:glossaryEntry>requiring white ties and tailcoats for men; "a white-tie occasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300992972">
	<b:glossaryEntry>not formal; "conservative people unaccustomed to informal dress"; "an informal free-and-easy manner"; "an informal gathering of friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300993271">
	<b:glossaryEntry>suited for everyday use; "casual clothes"; "everyday clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300993396">
	<b:glossaryEntry>natural and unstudied; "using their Christian names in a casual way"; "lectured in a familiar style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300993576">
	<b:glossaryEntry>very informal and familiar; "a folksy radio commentator"; "a folksy style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300993703"
	 b:glossaryEntry='without ceremony or formality; "an unceremonious speech"'/>
<rdf:Description rdf:about="&a;300993834">
	<b:glossaryEntry>(of spoken and written language) adhering to traditional standards of correctness and without casual, contracted, and colloquial forms; "the paper was written in formal English"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300994136">
	<b:glossaryEntry>appropriate to literature rather than everyday speech or writing; "when trying to impress someone she spoke in an affected literary style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300994329"
	 b:glossaryEntry="used of spoken and written language"/>
<rdf:Description rdf:about="&a;300994581">
	<b:glossaryEntry>characteristic of informal spoken language or conversation; "wrote her letters in a colloquial style"; "the broken syntax and casual enunciation of conversational English"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300994826">
	<b:glossaryEntry>being or characteristic of or appropriate to everyday language; "common parlance"; "a vernacular term"; "vernacular speakers"; "the vulgar tongue of the masses"; "the technical and vulgar names for an animal species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300995117">
	<b:glossaryEntry>written in the form of or carried on by letters or correspondence; "an endless sequence of epistolary love affairs"; "the epistolatory novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300995330">
	<b:glossaryEntry>constituting or expressed in slang or given to the use of slang; "a slangy expression"; "slangy speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300995486">
	<b:glossaryEntry>not written as or intended to be literature; "subliterary works such as letters and diaries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300995636">
	<b:glossaryEntry>marked by lack of affectation or pedantry; "her talk was very unliterary"- W.D.Howells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300995793">
	<b:glossaryEntry>referring to the first of two things or persons mentioned (or the earlier one or ones of several); "the novel was made into a film in 1943 and again in 1967; I prefer the former version to the latter one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300996053">
	<b:glossaryEntry>referring to the the second of two things or persons mentioned (or the last one or ones of several); "in the latter case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300996248">
	<b:glossaryEntry>the one most recently mentioned; "the last mentioned pianist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300996370"
	 b:glossaryEntry='left entirely; "forsaken slopes where children once played"'/>
<rdf:Description rdf:about="&a;300996592">
	<b:glossaryEntry>left desolate or empty; "an abandoned child"; "their deserted wives and children"; "an abandoned shack"; "deserted villages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300996783">
	<b:glossaryEntry>(of a young animal) abandoned by its mother and raised by hand; "a cade calf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300996911"
	 b:glossaryEntry="cast off as valueless"/>
<rdf:Description rdf:about="&a;300997001"
	 b:glossaryEntry='deserted or abandoned as by an owner; "a derelict ship"'/>
<rdf:Description rdf:about="&a;300997111">
	<b:glossaryEntry>pitiable in circumstances especially through abandonment; "desolate and despairing"; "left forlorn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300997296">
	<b:glossaryEntry xml:space='preserve'><![CDATA[put ashore and abandoned on a desolate island or coast; "the marooned pirate in `Treasure Island''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300997449"
	 b:glossaryEntry="not forsaken"/>
<rdf:Description rdf:about="&a;300997536"
	 b:glossaryEntry="thought of and clung to fondly or reverentially"/>
<rdf:Description rdf:about="&a;300997654">
	<b:glossaryEntry>having unexpected good fortune; "other, less fortunate, children died"; "a fortunate choice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300997982">
	<b:glossaryEntry>in a more fortunate or prosperous condition; "she would have been better off if she had stuck with teaching"; "is better off than his classmate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300998186">
	<b:glossaryEntry>marked by good fortune; "a felicitous life"; "a happy outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300998313">
	<b:glossaryEntry>occurring by happy chance; "profits were enhanced by a fortuitous drop in the cost of raw materials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300998470">
	<b:glossaryEntry xml:space='preserve'><![CDATA[resulting favorably; "its a good thing that I wasn''t there"; "it is good that you stayed"; "it is well that no one saw you"; "all''s well that ends well"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300998683">
	<b:glossaryEntry>peculiarly fortunate or appropriate; as if by divine intervention; "a heaven-sent rain saved the crops"; "a providential recovery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300998899">
	<b:glossaryEntry>blessed with good fortune; "considered himself lucky that the tornado missed his house"; "a lucky guess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300999055">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fortunately situated; "doesn''t know when he''s well-off"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300999165">
	<b:glossaryEntry>not favored by fortune; marked or accompanied by or resulting in ill fortune; "an unfortunate turn of events"; "an unfortunate decision"; "unfortunate investments"; "an unfortunate night for all concerned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300999626">
	<b:glossaryEntry>most unfortunate or miserable; "the most abject slaves joined in the revolt"; "abject poverty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300999773">
	<b:glossaryEntry>(of events) having extremely unfortunate or dire consequences; bringing ruin; "the stock market crashed on Black Friday"; "a calamitous defeat"; "the battle was a disastrous end to a disastrous campaign"; "such doctrines, if true, would be absolutely fatal to my theory"- Charles Darwin; "it is fatal to enter any war without the will to win it"- Douglas MacArthur; "a fateful error"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301000252">
	<b:glossaryEntry>suffering the misfortune of shipwreck; "shipwrecked sailors"; "castaways marooned on a desert island"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301000422">
	<b:glossaryEntry>physically or spiritually homeless or deprived of security; "made a living out of shepherding dispossed people from one country to another"- James Stern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301000655">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deserving or inciting pity; "a hapless victim"; "miserable victims of war"; "the shabby room struck her as extraordinarily pathetic"- Galsworthy; "piteous appeals for help"; "pitiable homeless children"; "a pitiful fate"; "couldn''t rescue the poor fellow"; "his poor distorted limbs"; "a wretched life"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301001098">
	<b:glossaryEntry>marked by or promising bad fortune; "their business venture was doomed from the start"; "an ill-fated business venture"; "an ill-starred romance"; "the unlucky prisoner was again put in irons"- W.H.Prescott</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301001406">
	<b:glossaryEntry>marked by or producing unhappiness; "infelicitous circumstances"; "unhappy caravans, straggling afoot through swamps and canebrakes"- American Guide Series</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301001630">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deserving regret; "regrettable remarks"; "it''s regrettable that she didn''t go to college"; "it''s too bad he had no feeling himself for church"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301001840"
	 b:glossaryEntry="pleasant-smelling"/>
<rdf:Description rdf:about="&a;301001984">
	<b:glossaryEntry>having a strong distinctive fragrance; "the pine woods were more redolent"- Jean Stafford</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301002139">
	<b:glossaryEntry>having a natural fragrance; "odoriferous spices"; "the odorous air of the orchard"; "the perfumed air of June"; "scented flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301002398">
	<b:glossaryEntry>filled or impregnated with perfume; "perfumed boudoir"; "perfumed stationery"; "scented soap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301002556"
	 b:glossaryEntry="resembling the smell of musk"/>
<rdf:Description rdf:about="&a;301002636"
	 b:glossaryEntry="unpleasant-smelling"/>
<rdf:Description rdf:about="&a;301002892"
	 b:glossaryEntry="smelling of garlic or onions"/>
<rdf:Description rdf:about="&a;301002977"
	 b:glossaryEntry="smelling like bilge water"/>
<rdf:Description rdf:about="&a;301003054"
	 b:glossaryEntry='offensively malodorous; "a putrid smell"'/>
<rdf:Description rdf:about="&a;301003225"
	 b:glossaryEntry="stale and unclean smelling"/>
<rdf:Description rdf:about="&a;301003321"
	 b:glossaryEntry="used of the smell of game beginning to taint"/>
<rdf:Description rdf:about="&a;301003431"
	 b:glossaryEntry="of noxious stench from atmospheric pollution"/>
<rdf:Description rdf:about="&a;301003540"
	 b:glossaryEntry="(British informal) malodorous"/>
<rdf:Description rdf:about="&a;301003621">
	<b:glossaryEntry>emitting an odor; "odoriferous blossoms"; "odorous salt pork and weevily hardtack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301003771"
	 b:glossaryEntry="giving off a strong unpleasant smell"/>
<rdf:Description rdf:about="&a;301003861"
	 b:glossaryEntry="smelling of fermentation or staleness"/>
<rdf:Description rdf:about="&a;301003958">
	<b:glossaryEntry>having odor or a characteristic odor; "odorous jasmine flowers"; "odorous garbage"; "fresh odorous bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301004189"
	 b:glossaryEntry='giving off an odor; "the odoriferous elements in perfume"'/>
<rdf:Description rdf:about="&a;301004304">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used with `of'' or `with'') noticeably odorous; "the hall was redolent of floor wax"; "air redolent with the fumes of beer and whiskey"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301004510">
	<b:glossaryEntry>(used in combination) having the odor of; "clean-scented laundry"; "a manure-scented barnyard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301004658"
	 b:glossaryEntry='having no odor; "odorless gas"; "odorless flowers"'/>
<rdf:Description rdf:about="&a;301004811">
	<b:glossaryEntry>emitting or holding no odor; "scentless wisps of straw"; "a scentless stretch of rocky ground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301004961"
	 b:glossaryEntry='having the sense of smell; "keen-scented hounds"'/>
<rdf:Description rdf:about="&a;301005063"
	 b:glossaryEntry="lacking the sense of smell"/>
<rdf:Description rdf:about="&a;301005145">
	<b:glossaryEntry>(chemistry and physics) unconstrained or not chemically bound in a molecule or not fixed and capable of relatively unrestricted motion; "free expansion"; "free oxygen"; "a free electron"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301005418"
	 b:glossaryEntry="(of a gas e.g.) released from chemical combination"/>
<rdf:Description rdf:about="&a;301005524"
	 b:glossaryEntry="not held in chemical or physical combination"/>
<rdf:Description rdf:about="&a;301005622">
	<b:glossaryEntry>(chemistry and physics) held with another element, substance or material in chemical or physical union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301005812">
	<b:glossaryEntry>(chemistry) of an organic compound; containing two or more double bonds each separated from the other by a single bond</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301005999">
	<b:glossaryEntry>(chemistry) formed by the union of two compounds; "a conjugated protein"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301006140">
	<b:glossaryEntry>securely placed or fastened or set; "a fixed piece of wood"; "a fixed resistor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301006397">
	<b:glossaryEntry>securely fixed in place; "the post was still firm after being hit by the car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301006543">
	<b:glossaryEntry>marked by an orbit with a period of 24 hours so that a position in such an orbit is fixed with respect to the earth; "a geosynchronous satellite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301006765">
	<b:glossaryEntry>(of panes of glass) fixed in place by means of thin strips of lead; "leaded windowpanes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301006906"
	 b:glossaryEntry='not capable of being moved; "stationary machinery"'/>
<rdf:Description rdf:about="&a;301007013">
	<b:glossaryEntry>secured or held in place by tape; "carefully taped pieces of glass served as a windowpane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301007155"
	 b:glossaryEntry="not adjustable"/>
<rdf:Description rdf:about="&a;301007228"
	 b:glossaryEntry="not firmly placed or set or fastened"/>
<rdf:Description rdf:about="&a;301007390">
	<b:glossaryEntry>not fixed in position; "the detached shutter fell on him"; "he pulled his arm free and ran"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301007543">
	<b:glossaryEntry>(of a part of the body) not firmly connected; movable or out of normal position; "floating ribs are not connected with the sternum"; "a floating kidney"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301007753">
	<b:glossaryEntry>not firmly or solidly positioned; "climbing carefully up the unsteady ladder"; "an unfirm stance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301007914">
	<b:glossaryEntry>able to act at will; not hampered; not under compulsion or restraint; "free enterprise"; "a free port"; "a free country"; "I have an hour free"; "free will"; "free of racism"; "feel free to stay as long as you wish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301008594">
	<b:glossaryEntry>having escaped, especially from confinement; "a convict still at large"; "searching for two escaped prisoners"; "dogs loose on the streets"; "criminals on the loose in the neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301008889">
	<b:glossaryEntry>not under constraint of any kind; "sailors at liberty while their ship is in port"; "you are at liberty to go"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301009075">
	<b:glossaryEntry>of political bodies; "an autonomous judiciary"; "a sovereign state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301009242">
	<b:glossaryEntry>not busy; not otherwise committed; "he was not available for comment"; "he was available and willing to accompany her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301009430"
	 b:glossaryEntry="(nautical) of an anchor; just clear of the bottom"/>
<rdf:Description rdf:about="&a;301009540">
	<b:glossaryEntry>free from contact or proximity or connection; "we were clear of the danger"; "the ship was clear of the reef"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301009704"
	 b:glossaryEntry="set free as from prison or duty"/>
<rdf:Description rdf:about="&a;301009803"
	 b:glossaryEntry="having become freed from entanglement; disengaged"/>
<rdf:Description rdf:about="&a;301009932">
	<b:glossaryEntry>free from traditional social restraints; "an emancipated young woman pursuing her career"; "a liberated lifestyle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301010116">
	<b:glossaryEntry>free to go or do as one pleases; "Americans have always been a footloose people always moving on"; "a footloose young man eager to see the big city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301010320">
	<b:glossaryEntry>not restrained or confined or attached; "a pocket full of loose bills"; "knocked the ball loose"; "got loose from his attacker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301010499">
	<b:glossaryEntry>not attending school and therefore free to work; "opportunities for out-of-school youth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301010647">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `of'') released from something onerous (especially an obligation or duty); "quit of all further responsibility for their safety"; "well rid of him"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301010877"
	 b:glossaryEntry="free from confinement or physical restraint"/>
<rdf:Description rdf:about="&a;301010992">
	<b:glossaryEntry>not held in check or subject to control; "unhampered dissemination of news"; "this would give black people the opportunity to live unhampered by racism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301011214"
	 b:glossaryEntry='free of restrictions on conduct; "I had unrestricted access"'/>
<rdf:Description rdf:about="&a;301011333"
	 b:glossaryEntry="hampered and not free; not able to act at will"/>
<rdf:Description rdf:about="&a;301011684">
	<b:glossaryEntry>(used of persons) bound to a tract of land; hence their service is transferable from owner to owner; "an adscript serf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301011871"
	 b:glossaryEntry="bound by contract"/>
<rdf:Description rdf:about="&a;301011978">
	<b:glossaryEntry>forced to turn and face attackers; "a stag at bay"; "she had me cornered between the porch and her car"; "like a trapped animal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301012191"
	 b:glossaryEntry="in captivity"/>
<rdf:Description rdf:about="&a;301012290"
	 b:glossaryEntry="involved in difficulties"/>
<rdf:Description rdf:about="&a;301012370"
	 b:glossaryEntry="of peoples and political bodies"/>
<rdf:Description rdf:about="&a;301012476"
	 b:glossaryEntry="resembling a prison"/>
<rdf:Description rdf:about="&a;301012552"
	 b:glossaryEntry="like someone in servitude"/>
<rdf:Description rdf:about="&a;301012632">
	<b:glossaryEntry>not held in servitude; "after the Civil War he was a free man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301012817"
	 b:glossaryEntry="freed from bondage"/>
<rdf:Description rdf:about="&a;301012913"
	 b:glossaryEntry="born free of free parents"/>
<rdf:Description rdf:about="&a;301012993"
	 b:glossaryEntry='where slavery was prohibited; "a free-soil state"'/>
<rdf:Description rdf:about="&a;301013110"
	 b:glossaryEntry='held in servitude; "he was born of slave parents"'/>
<rdf:Description rdf:about="&a;301013304"
	 b:glossaryEntry='held in slavery; "born of enslaved parents"'/>
<rdf:Description rdf:about="&a;301013435">
	<b:glossaryEntry xml:space='preserve'><![CDATA[involving slaves; "Brown''s attempt at servile insurrection"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301013551">
	<b:glossaryEntry>where slavery was legal; "a slave state"; "the slaveholding South"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301013676">
	<b:glossaryEntry>concerned with slaves; "slave quarters"; slave trader"; "slave market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301013801">
	<b:glossaryEntry>coming at short intervals or habitually; "a frequent guest"; "frequent complaints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301013974"
	 b:glossaryEntry='most frequent or common; "prevailing winds"'/>
<rdf:Description rdf:about="&a;301014088">
	<b:glossaryEntry>relating to a person who does something regularly; "a regular customer"; "a steady drinker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301014242">
	<b:glossaryEntry>not frequent; not occurring regularly or at short intervals; "infrequent outbursts of temper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301014446">
	<b:glossaryEntry>occurring from time to time; "took an occasional glass of wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301014569">
	<b:glossaryEntry>recurring only at long intervals; "a rare appearance"; "total eclipses are rare events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301014707"
	 b:glossaryEntry='not stale or old; "fresh bread"; "a fresh scent"'/>
<rdf:Description rdf:about="&a;301014969"
	 b:glossaryEntry='(Scottish) "caller fish"'/>
<rdf:Description rdf:about="&a;301015046">
	<b:glossaryEntry>pleasingly firm and fresh and making a crunching noise when chewed; "crisp carrot and celery sticks"; "a firm apple"; "crunchy lettuce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301015250"
	 b:glossaryEntry='cut recently; "fresh-cut flowers"'/>
<rdf:Description rdf:about="&a;301015339"
	 b:glossaryEntry='not left to spoil; "the meat is still good"'/>
<rdf:Description rdf:about="&a;301015456"
	 b:glossaryEntry='newly made; "a hot scent"'/>
<rdf:Description rdf:about="&a;301015531"
	 b:glossaryEntry='newly made; "the aroma of new-made bread"'/>
<rdf:Description rdf:about="&a;301015627"
	 b:glossaryEntry='freshly made or left; "a warm trail"; "the scent is warm"'/>
<rdf:Description rdf:about="&a;301015744"
	 b:glossaryEntry='showing deterioration from age; "stale bread"'/>
<rdf:Description rdf:about="&a;301016057"
	 b:glossaryEntry='(of eggs) no longer edible; "an addled egg"'/>
<rdf:Description rdf:about="&a;301016153">
	<b:glossaryEntry>(of foodstuffs) not in an edible or usable condition; "bad meat"; "a refrigerator full of spoilt food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301016324">
	<b:glossaryEntry>having lost freshness through passage of time; "a cold trail"; "dogs attempting to catch a cold scent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301016477"
	 b:glossaryEntry='not fresh today; "day-old bread is cheaper than fresh"'/>
<rdf:Description rdf:about="&a;301016585"
	 b:glossaryEntry='dried out; "hard dry rolls left over from the day before"'/>
<rdf:Description rdf:about="&a;301016693">
	<b:glossaryEntry>spoiled and covered with eggs and larvae of flies; "flyblown meat"; "a sack of maggoty apricots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301016854"
	 b:glossaryEntry='not firm; "wilted lettuce"'/>
<rdf:Description rdf:about="&a;301016940">
	<b:glossaryEntry>covered with or smelling of mold; "moldy bread"; "a moldy (or musty) odor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301017083">
	<b:glossaryEntry>used of decomposing oils or fats; "rancid butter"; "rancid bacon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301017201">
	<b:glossaryEntry>having rotted or disintegrated; usually implies foulness; "dead and rotten in his grave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301017468">
	<b:glossaryEntry xml:space='preserve'><![CDATA[touched by rot or decay; "tainted bacon"; "`corrupt'' is archaic"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301017596"
	 b:glossaryEntry='deteriorated by decay or rot; "decayed teeth"'/>
<rdf:Description rdf:about="&a;301017695">
	<b:glossaryEntry>broken down or disintegrated by rot; "a badly decomposed body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301017814">
	<b:glossaryEntry xml:space='preserve'><![CDATA[becoming rotten; "a field covered with thousands of decomposing bodies"; "John Brown''s body lies a-moldering in the grave"; "rotting animal flesh is attractive to vultures"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301018079">
	<b:glossaryEntry>slowly broken down or crumbled into dust; "layers of moldered leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301018215">
	<b:glossaryEntry>in an advanced state of decomposition and having a foul odor; "horrible like raw and putrid flesh"- Somerset Maugham</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301018408"
	 b:glossaryEntry='becoming putrid; "a trail lined by putrescent carcasses"'/>
<rdf:Description rdf:about="&a;301018521"
	 b:glossaryEntry="not rotten"/>
<rdf:Description rdf:about="&a;301018615"
	 b:glossaryEntry="not disintegrated by rot"/>
<rdf:Description rdf:about="&a;301018698"
	 b:glossaryEntry='not canned or otherwise preserved; "fresh vegetables"'/>
<rdf:Description rdf:about="&a;301018839"
	 b:glossaryEntry="used of meats"/>
<rdf:Description rdf:about="&a;301018906"
	 b:glossaryEntry="not treated or prepared by a special process"/>
<rdf:Description rdf:about="&a;301019008">
	<b:glossaryEntry>prevented from decaying or spoiling and prepared for future use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301019397">
	<b:glossaryEntry>(used of tobacco) aging as a preservative process (`aged'' is pronounced as one syllable)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301019544"
	 b:glossaryEntry="used especially of fruits"/>
<rdf:Description rdf:about="&a;301019645"
	 b:glossaryEntry="sealed in a can or jar"/>
<rdf:Description rdf:about="&a;301019729">
	<b:glossaryEntry>used of milk; reduced in volume by having moisture expelled before canning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301019878"
	 b:glossaryEntry="(used especially of meat) cured in brine"/>
<rdf:Description rdf:about="&a;301019979"
	 b:glossaryEntry="(used of hay e.g.) allowed to dry"/>
<rdf:Description rdf:about="&a;301020064">
	<b:glossaryEntry>preserved by removing natural moisture; "dried beef"; "dried fruit"; "dehydrated eggs"; "shredded and desiccated coconut meat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301020268">
	<b:glossaryEntry>used of foods; preserved by freezing sufficiently rapidly to retain flavor and nutritional value; "frozen foods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301020463">
	<b:glossaryEntry>preserved by freezing and drying in a vacuum; "freeze-dried coffee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301020589">
	<b:glossaryEntry>used of tissue or blood or serum or other biological substances; dried by freezing in a high vacuum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301020775"
	 b:glossaryEntry="(used of foods) preserved in a pickling liquid"/>
<rdf:Description rdf:about="&a;301020875">
	<b:glossaryEntry>preserved in a pot or can or jar; "potted meat"; "potted shrimp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301020992"
	 b:glossaryEntry="(used especially of meats) preserved in salt"/>
<rdf:Description rdf:about="&a;301021112">
	<b:glossaryEntry>(used especially of meats and fish) dried and cured in wood smoke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301021258"
	 b:glossaryEntry='dried naturally by the sun; "sun-dried apricots"'/>
<rdf:Description rdf:about="&a;301021362"
	 b:glossaryEntry='not containing or composed of salt water; "fresh water"'/>
<rdf:Description rdf:about="&a;301021505">
	<b:glossaryEntry>relating to or living in or consisting of water that is not salty; "freshwater fish"; "freshwater lakes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301021666"
	 b:glossaryEntry='not having a salty taste; "sweet water"'/>
<rdf:Description rdf:about="&a;301021767"
	 b:glossaryEntry='containing or filled with salt; "salt water"'/>
<rdf:Description rdf:about="&a;301021934"
	 b:glossaryEntry='slightly salty; "a brackish lagoon"; "the briny deep"'/>
<rdf:Description rdf:about="&a;301022050">
	<b:glossaryEntry>containing or yielding salt; "saliferous formations"; "salt domes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301022173"
	 b:glossaryEntry='containing salt; "a saline solution"; "salty tears"'/>
<rdf:Description rdf:about="&a;301022285">
	<b:glossaryEntry>characteristic or or befitting a friend; "friendly advice"; "a friendly neighborhood"; "the only friendly person here"; "a friendly host and hostess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301022795">
	<b:glossaryEntry>diffusing warmth and friendliness; "an affable smile"; "an amiable gathering"; "cordial relations"; "a cordial greeting"; "a genial host"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301023015">
	<b:glossaryEntry>(used colloquially) having the relationship of friends or pals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301023160">
	<b:glossaryEntry>like a companion; "companionate marriage"; "a companionate dog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301023282"
	 b:glossaryEntry="heartily friendly and congenial"/>
<rdf:Description rdf:about="&a;301023406"
	 b:glossaryEntry="(chiefly Scottish) agreeable and genial"/>
<rdf:Description rdf:about="&a;301023508">
	<b:glossaryEntry>having or fostering a warm or friendly atmosphere; especially through smallness and informality; "had a cozy chat"; "a relaxed informal manner"; "an intimate cocktail lounge"; "the small room was cozy and intimate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301023795">
	<b:glossaryEntry>favorably disposed; not antagonistic; "a government favorable to our interests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301023946"
	 b:glossaryEntry="exhibiting the qualities expected in a friendly neighbor"/>
<rdf:Description rdf:about="&a;301024073">
	<b:glossaryEntry>marked by friendly companionship with others; "a social cup of coffee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301024196">
	<b:glossaryEntry>not disposed to friendship or friendliness; "an unfriendly coldness of manner"; "an unfriendly action to take"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301024543"
	 b:glossaryEntry="sullen or unfriendly in appearance"/>
<rdf:Description rdf:about="&a;301024648"
	 b:glossaryEntry='very unfriendly; "a hostile attitude"'/>
<rdf:Description rdf:about="&a;301024739">
	<b:glossaryEntry>lacking warmth or friendliness; "looked uncordial as we approached"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301024862"
	 b:glossaryEntry="not exhibiting the qualities expected in a friendly neighbor"/>
<rdf:Description rdf:about="&a;301024997">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of or belonging to your own country''s forces or those of an ally; "in friendly territory"; "he was accidentally killed by friendly fire"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301025188">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not belonging to your own country''s forces or those of an ally; "hostile naval and air forces"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301025354"
	 b:glossaryEntry='of or belonging to an enemy; "enemy planes"'/>
<rdf:Description rdf:about="&a;301025452">
	<b:glossaryEntry>(in combination) easy to understand or use; "user-friendly computers"; "a consumer-friendly policy"; "a reader-friendly novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301025633">
	<b:glossaryEntry>(in combination) not easy to understand or use; "user-unfriendly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301025755">
	<b:glossaryEntry>turned into ice; affected by freezing or by long and severe cold; "the frozen North"; "frozen pipes"; "children skating on a frozen brook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301026144">
	<b:glossaryEntry>injured by freezing or partial freezing; "frostbitten fingers"; "frostbitten grapes unsalable as fresh fruit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301026311"
	 b:glossaryEntry="(of the ground) made hard by frost"/>
<rdf:Description rdf:about="&a;301026403">
	<b:glossaryEntry>covered with ice (as by a glacier) or affected by glacial action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301026523"
	 b:glossaryEntry='locked in by ice; "icebound harbors"'/>
<rdf:Description rdf:about="&a;301026614"
	 b:glossaryEntry='obstructed by ice; "ice-clogged rivers"'/>
<rdf:Description rdf:about="&a;301026711">
	<b:glossaryEntry>covered with or containing or consisting of ice; "icy northern waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301026831">
	<b:glossaryEntry>consisting of or of the nature of frozen or partially frozen rain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301026949">
	<b:glossaryEntry>turned into or covered with thick ice; "a brook frozen solid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301027062">
	<b:glossaryEntry xml:space='preserve'><![CDATA[still frozen; "there was''nt time to cook the unthawed turkey, so they had to settle for hotdogs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301027213"
	 b:glossaryEntry='not frozen; "unfrozen ground"'/>
<rdf:Description rdf:about="&a;301027387">
	<b:glossaryEntry>free of ice and open to travel; "an ice-free channel in the river"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301027508"
	 b:glossaryEntry="becoming liquid"/>
<rdf:Description rdf:about="&a;301027590"
	 b:glossaryEntry='being or resembling melting snow; "slushy snow"'/>
<rdf:Description rdf:about="&a;301027690"
	 b:glossaryEntry='no longer frozen; "the thawed ground was muddy"'/>
<rdf:Description rdf:about="&a;301027790">
	<b:glossaryEntry>productive or conducive to producing in abundance; "be fruitful and multiply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301028084"
	 b:glossaryEntry="producing or bearing berries"/>
<rdf:Description rdf:about="&a;301028190">
	<b:glossaryEntry>producing in abundance; "the bountiful earth"; "a plentiful year"; "fruitful soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301028340">
	<b:glossaryEntry>producing offspring or set aside especially for producing offspring; "the breeding population"; "retained a few bulls for breeding purposes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301028535">
	<b:glossaryEntry>marked by great fruitfulness; "fertile farmland"; "a fat land"; "a productive vineyard"; "rich soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301028715">
	<b:glossaryEntry>producing new life or offspring; "the reproductive potential of a species is its relative capacity to reproduce itself under optimal conditions"; "the reproductive or generative organs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301028986">
	<b:glossaryEntry>bearing in abundance especially offspring; "flying foxes are extremely prolific"; "a prolific pear tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301029155"
	 b:glossaryEntry="green with growing things"/>
<rdf:Description rdf:about="&a;301029234"
	 b:glossaryEntry="not fruitful; not conducive to abundant production"/>
<rdf:Description rdf:about="&a;301029449">
	<b:glossaryEntry>failing to accomplish an intended result; "an abortive revolt"; "a stillborn plot to assassinate the President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301029642"
	 b:glossaryEntry="producing no fruit"/>
<rdf:Description rdf:about="&a;301029715">
	<b:glossaryEntry>not fertile or productive; "a barren tree"; "soil too infertile to sustain real pasture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301029868">
	<b:glossaryEntry>without offspring; "in some societies a barren woman is rejected by her tribesmen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301030015">
	<b:glossaryEntry>yielding little by great labor; "a hardscrabble farm"; "poor soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301030147">
	<b:glossaryEntry>containing as much or as many as is possible or normal; "a full glass"; "a sky full of stars"; "a full life"; "the auditorium was full to overflowing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301030708">
	<b:glossaryEntry>abundantly filled; "garden abounding with flowers"; "rich in ideas"; "slums rife with crime"; "the air was thick with snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301030957">
	<b:glossaryEntry>covered with water; "the main deck was afloat (or awash)"; "the monsoon left the whole place awash"; "a flooded bathroom"; "inundated farmlands"; "an overflowing tub"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301031226">
	<b:glossaryEntry>filled to overflowing with a vast number of moving or especially living things; sometimes used in combination; "ditches alive with frogs"; "a blanket alive with fleas"; "roads crawling with cars"; "a picnic table crawling with ants"; "a house overflowing with guests"; "fields overrun with locusts"; "swarming with insects"; "parade route swarming with spectators"; "a drop of water teeming with microorganisms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301031793">
	<b:glossaryEntry>filled to capacity; "a brimful cup"; "I am brimful of chowder"; "a child brimming over with curiosity"; "eyes brimming with tears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301032032">
	<b:glossaryEntry>packed full to capacity; "chowder chockablock with pieces of fish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301032221"
	 b:glossaryEntry="overfull as with blood"/>
<rdf:Description rdf:about="&a;301032310">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `with'' or used as a combining form) generously supplied with; "theirs was a house filled with laughter"; "a large hall filled with rows of desks"; "fog-filled air"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301032547">
	<b:glossaryEntry>filled with or attended with; "words fraught with meaning"; "an incident fraught with danger"; "a silence pregnant with suspense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301032744"
	 b:glossaryEntry='exceeding demand; "a glutted market"'/>
<rdf:Description rdf:about="&a;301032845">
	<b:glossaryEntry>full of; bearing great weight; "trees heavy with fruit"; "vines weighed down with grapes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301033001">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `with'') deeply filled or permeated; "imbued with the spirit of the Reformation"; "words instinct with love"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301033191">
	<b:glossaryEntry xml:space='preserve'><![CDATA[filled with a great quantity; "a tray loaded with dishes"; "table laden with food"; "`ladened'' is not current usage"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301033378"
	 b:glossaryEntry="loaded past capacity"/>
<rdf:Description rdf:about="&a;301033467"
	 b:glossaryEntry='spread throughout; "cities riddled with corruption"'/>
<rdf:Description rdf:about="&a;301033572"
	 b:glossaryEntry='filled with something; "a stuffed turkey"'/>
<rdf:Description rdf:about="&a;301033667">
	<b:glossaryEntry>(informal) crammed with food; "a full stomach"; "I feel stuffed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301033785">
	<b:glossaryEntry>filled by being spread over; sometimes used in combination; "the foe-swarming field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301033924"
	 b:glossaryEntry='still full; "an untouched cocktail in her hand"'/>
<rdf:Description rdf:about="&a;301034038"
	 b:glossaryEntry='full of money; "a well-lined purse"'/>
<rdf:Description rdf:about="&a;301034130">
	<b:glossaryEntry>holding or containing nothing; "an empty glass"; "an empty room"; "full of empty seats"; "empty hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301034554">
	<b:glossaryEntry>having extraneous everything removed including contents; "the bare walls"; "the cupboard was bare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301034714">
	<b:glossaryEntry>completely wanting or lacking; "writing barren of insight"; "young recruits destitute of experience"; "a novel devoid of wit and inventiveness"; "a life empty of happiness"; "innocent of literary merit"; "void of understanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301035077"
	 b:glossaryEntry='having had something taken away; "bereft of their dignity"'/>
<rdf:Description rdf:about="&a;301035211">
	<b:glossaryEntry>of a surface; not written or printed on; "blank pages"; "fill in the blank spaces"; "a clean page"; "wide white margins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301035399"
	 b:glossaryEntry="having been made empty"/>
<rdf:Description rdf:about="&a;301035475"
	 b:glossaryEntry="carrying nothing in the hands"/>
<rdf:Description rdf:about="&a;301035563">
	<b:glossaryEntry>used of eyes lacking liveliness; "empty eyes"; "a glassy stare"; "his eyes were glazed over with boredom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301035730">
	<b:glossaryEntry>destitute or having been emptied of life or living beings; "after the dance the littered and lifeless ballroom echoed hollowly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301035912">
	<b:glossaryEntry>wrongfully emptied or stripped of anything of value; "the robbers left the looted train"; "people returned to the plundered village"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301036132">
	<b:glossaryEntry>relatively empty of and unobstructed by fences or hedges or headlands or shoals; "in open country"; "the open countryside"; "open waters"; "on the open seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301036340"
	 b:glossaryEntry='not filled; "an unfilled bottle"; "unfilled spaces"'/>
<rdf:Description rdf:about="&a;301036446">
	<b:glossaryEntry>without an occupant or incumbent; "the throne is never vacant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301036561"
	 b:glossaryEntry='void of thought or knowledge; "a vacant mind"'/>
<rdf:Description rdf:about="&a;301036659"
	 b:glossaryEntry='containing nothing; "the earth was without form, and void"'/>
<rdf:Description rdf:about="&a;301036768">
	<b:glossaryEntry>emptied or exhausted of (as by drawing off e.g. water or other liquid); "a drained marsh"; "a drained tank"; "a drained and apathetic old man...not caring any longer about anything"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301037039">
	<b:glossaryEntry>emptied of emotion; "after the violent argument he felt empty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301037153">
	<b:glossaryEntry xml:space='preserve'><![CDATA[drained physically; "the day''s events left her completely exhausted--her strength drained"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301037299"
	 b:glossaryEntry='not drained; "preserve wetlands; keep them undrained"'/>
<rdf:Description rdf:about="&a;301037408">
	<b:glossaryEntry>for the entire time appropriate to an activity; "a full-time job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301037547"
	 b:glossaryEntry='officially full-time; "regular students"'/>
<rdf:Description rdf:about="&a;301037641">
	<b:glossaryEntry>involving less than the standard or customary time for an activity; "part-time employees"; "a part-time job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301037877">
	<b:glossaryEntry>involving half the standard or customary time for an activity; "he had two years of half-time training"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301038036">
	<b:glossaryEntry>lacking continuity or regularity; "an irregular worker"; "employed on a temporary basis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301038192"
	 b:glossaryEntry='not regular or skilled; "found only odd-job employment"'/>
<rdf:Description rdf:about="&a;301038304">
	<b:glossaryEntry>employed only part-time when one needs full-time employment or not making full use of your skills; "migrants are likely to be poor and underemployed"; "able people are kept underemployed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301038551">
	<b:glossaryEntry>designed for or capable of a particular function or use; "a style of writing in which every word is functional"; "functional architecture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301038818">
	<b:glossaryEntry>affecting or involved in structure or construction; "the structural details of a house such as beams and joists and rafters; not ornamental elements"; "structural damage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301039045"
	 b:glossaryEntry='having a useful function; "utilitarian steel tables"'/>
<rdf:Description rdf:about="&a;301039164"
	 b:glossaryEntry="not having or performing a function"/>
<rdf:Description rdf:about="&a;301039331"
	 b:glossaryEntry="not structural"/>
<rdf:Description rdf:about="&a;301039405">
	<b:glossaryEntry>serving an esthetic rather than a useful purpose; "cosmetic fenders on cars"; "the buildings were utilitarian rather than decorative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301039619">
	<b:glossaryEntry>performing or able to perform its regular function; "a functioning flashlight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301039791">
	<b:glossaryEntry>(of e.g. a machine) performing or capable of performing; "in running (or working) order"; "a functional set of brakes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301040004">
	<b:glossaryEntry>(used of computers) operating properly; "how soon will the computers be up?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301040132">
	<b:glossaryEntry>not performing or able to perform its regular function; "a malfunctioning valve"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301040379">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not functioning properly; "something is amiss"; "has gone completely haywire"; "the telephone is out of order"; "what''s the matter with your vacuum cleaner?"; "something is wrong with the engine"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301040694">
	<b:glossaryEntry>not working properly; "a bad telephone connection"; "a defective appliance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301040831">
	<b:glossaryEntry>out of use or operation because of a fault or breakdown; "a dead telephone line"; "the motor is dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301040983">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used of computers) temporarily not operating; "can''t do a thing because the computers are down"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301041133"
	 b:glossaryEntry='having the spring unwound; "a run-down watch"'/>
<rdf:Description rdf:about="&a;301041233">
	<b:glossaryEntry>(pathology) involving or affecting function rather than physiology; "functional deafness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301041379">
	<b:glossaryEntry>(pathology) involving or affecting physiology or bodily organs; "an organic disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301041517">
	<b:glossaryEntry>(nautical) fitted or equipped with necessary rigging (sails and shrouds and stays etc)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301041710"
	 b:glossaryEntry="rigged with a triangular (lateen) sail"/>
<rdf:Description rdf:about="&a;301041817">
	<b:glossaryEntry>rigged with a structure projecting from or over the side of a boat for various purposes; to prevent capsizing or to support an oarlock or to help secure a mast etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301042036"
	 b:glossaryEntry="rigged with square sails as the principal ones"/>
<rdf:Description rdf:about="&a;301042142"
	 b:glossaryEntry="(nautical) stripped of rigging"/>
<rdf:Description rdf:about="&a;301042227">
	<b:glossaryEntry>provided or fitted out with what is necessary or useful or appropriate; "a well equipped playground"; "a ship equipped with every mechanical aid to navigation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301042576">
	<b:glossaryEntry>provided with necessary articles of equipment for a specialized purpose especially military; "troops accoutered for battle"; "accoutered for the trip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301042794"
	 b:glossaryEntry="equipped with the complete arms and armor of a warrior"/>
<rdf:Description rdf:about="&a;301042914"
	 b:glossaryEntry="equipped with or wearing a helmet"/>
<rdf:Description rdf:about="&a;301043002">
	<b:glossaryEntry>equipped with appropriate wearing apparel and accessories; "children properly outfitted for school"; "equipt in the...national dress of the Scottish people"- Sir Walter Scott</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301043232">
	<b:glossaryEntry>equipped or prepared with necessary intellectual resources; "graduates well equipped to handle such problems"; "equipped to be a scholar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301043424"
	 b:glossaryEntry="(of an electronic device) equipped with transistors"/>
<rdf:Description rdf:about="&a;301043536">
	<b:glossaryEntry>having or provided with a visor or a visor of a particular kind; "their spic, red-visored caps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301043685">
	<b:glossaryEntry>without necessary physical or intellectual equipment; "guerrillas unequipped for a pitched battle"; "unequipped for jobs in a modern technological society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301043933">
	<b:glossaryEntry>poorly supplied with physical equipment; "the school was ill-equipped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301044062">
	<b:glossaryEntry>lacking with intellectual equipment; "unprepared to stand on his own feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301044193">
	<b:glossaryEntry>(of birds) having developed feathers or plumage; often used in combination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301044366">
	<b:glossaryEntry>of a young bird just having acquired its flight feathers; "a fledgling robin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301044518">
	<b:glossaryEntry>(of a bird) having reached full development with fully grown adult plumage; ready to fly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301044681">
	<b:glossaryEntry>(of birds) not yet having developed feathers; "a small unfledged sparrow on the window sill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301044858"
	 b:glossaryEntry='not having feathers; "the unfeathered brood"'/>
<rdf:Description rdf:about="&a;301044960">
	<b:glossaryEntry>provided with a frame; "there were framed snapshots of family and friends on her desk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301045099"
	 b:glossaryEntry='not provided with a frame; "unframed pictures"'/>
<rdf:Description rdf:about="&a;301045200">
	<b:glossaryEntry>provided with whatever is necessary for a purpose (as furniture or equipment or authority); "a furnished apartment"; "a completely furnished toolbox"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301045506">
	<b:glossaryEntry>provided with furnishing and accessories (especially of a tasteful kind); "a house that is beautifully appointed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301045675">
	<b:glossaryEntry>furnished with essential equipment for a particular occupation or undertaking occupation; "well-outfitted expedition to the South Pole"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301045879"
	 b:glossaryEntry="having a supply of"/>
<rdf:Description rdf:about="&a;301045990">
	<b:glossaryEntry>furnished with more than enough; "rivers well stocked with fish"; "a well-stocked store"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301046147">
	<b:glossaryEntry>having a full array of suitable equipment or furnishings; "a well-appointed kitchen"; "a well-appointed apartment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301046335">
	<b:glossaryEntry>not equipped with what is needed especially furniture; "an unfurnished apartment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301046505"
	 b:glossaryEntry='lacking; "unfurnished with money or skill"'/>
<rdf:Description rdf:about="&a;301046655"
	 b:glossaryEntry='furnished with funds; "well-funded research"'/>
<rdf:Description rdf:about="&a;301046752"
	 b:glossaryEntry='not furnished with funds; "an unfunded project"'/>
<rdf:Description rdf:about="&a;301046854"
	 b:glossaryEntry="supplied with or powered by fuel"/>
<rdf:Description rdf:about="&a;301046993">
	<b:glossaryEntry>consuming fuel; used in combination; "coal-burning (or wood-burning) stoves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301047124"
	 b:glossaryEntry='fueled with oil; "an oil-fired furnace"'/>
<rdf:Description rdf:about="&a;301047219">
	<b:glossaryEntry>of or using a mixture of acetylene and oxygen; "an oxyacetylene torch"; "oxyacetelyne welding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301047372"
	 b:glossaryEntry="not provided with fuel"/>
<rdf:Description rdf:about="&a;301047485"
	 b:glossaryEntry="needing no outside support"/>
<rdf:Description rdf:about="&a;301047572"
	 b:glossaryEntry='not given support; "a grudge that remained unfed"'/>
<rdf:Description rdf:about="&a;301047673">
	<b:glossaryEntry>clearly and explicitly stated; "meals are at specified times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301047898">
	<b:glossaryEntry>specified in advance; "a given number"; "we will meet at a given time and location"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301048044"
	 b:glossaryEntry='being nothing more than specified; "a mere child"'/>
<rdf:Description rdf:about="&a;301048147">
	<b:glossaryEntry>named; bearing the name of a specific person; "nominative shares of stock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301048288"
	 b:glossaryEntry='stated explicitly or in detail; "needed a specific amount"'/>
<rdf:Description rdf:about="&a;301048401">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a degree or quality specified (by the `that'' clause); "their anxiety was such that they could not sleep"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301048574">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a kind specified or understood; "it''s difficult to please such people"; "on such a night as this"; "animals such as lions and tigers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301048774">
	<b:glossaryEntry>not stated explicitly or in detail; "threatened unspecified reprisals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301048974">
	<b:glossaryEntry>being any unspecified one; used for emphasis; "any old time"; "any old place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301049108"
	 b:glossaryEntry='particular but unspecified; "early one evening"'/>
<rdf:Description rdf:about="&a;301049208">
	<b:glossaryEntry>unknown or unspecified; "some lunatic drove into my car"; "some man telephoned while you were out"; "some day my prince will come"; "some enchanted evening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301049418">
	<b:glossaryEntry>specific but unspecified; "agreed to meet at such-and-such an hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301049545"
	 b:glossaryEntry="equipped with or connected by gears or having gears engaged"/>
<rdf:Description rdf:about="&a;301049729">
	<b:glossaryEntry>(of a lathe) equipped with gearing for reducing the speed of the spindle from that of the driving pulley; "a back-geared lathe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301049930">
	<b:glossaryEntry>equipped with compound gearing consisting of 2 pinions and 2 wheels in mesh to increase the mechanical advantage; "the double-geared lifting mechanism of a crane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301050152">
	<b:glossaryEntry>(used of toothed parts or gears) interlocked and interacting; "the gears are engaged"; "meshed gears"; "intermeshed twin rotors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301050357"
	 b:glossaryEntry='having gears engaged; "the car is in gear"'/>
<rdf:Description rdf:about="&a;301050453">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having gears not engaged or disconnected; "the machine''s ungeared pinion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301050599">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not having gears engaged; "threw the machine''s pinion out of gear"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301050726">
	<b:glossaryEntry>applying to all or most members of a category or group; "the general public"; "general assistance"; "a general rule"; "in general terms"; "comprehensible to the general reader"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301051298">
	<b:glossaryEntry>considered altogether; "the country at large"; "I enjoyed the play as a whole though I thought the acting could have been better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301051520">
	<b:glossaryEntry>representing the whole of a state or body rather than one specific division or part of it; "ambassador-at-large"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301051691">
	<b:glossaryEntry>not detailed or specific; "a broad rule"; "the broad outlines of the plan"; "felt an unspecific dread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301051858">
	<b:glossaryEntry>made general; widely prevalent; "a problem of generalized human needs"; "a state of generalized discontent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301052023"
	 b:glossaryEntry="not limited in use or function"/>
<rdf:Description rdf:about="&a;301052129">
	<b:glossaryEntry>applicable to an entire class or group; "is there a generic Asian mind?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301052255">
	<b:glossaryEntry>of general aspects or broad distinctions; "the gross details of the structure appear reasonable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301052403"
	 b:glossaryEntry='occurring widely (as to many people); "mass destruction"'/>
<rdf:Description rdf:about="&a;301052524">
	<b:glossaryEntry>constituting a grab-bag category; "the usual collection of miscellaneous expenses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301052666">
	<b:glossaryEntry>involving only main features; "the overall pattern of his life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301052783"
	 b:glossaryEntry='existing everywhere; "pandemic fear of nuclear war"'/>
<rdf:Description rdf:about="&a;301052889">
	<b:glossaryEntry>spread throughout; "a pervasive anxiety overshadows the triumphs of individuals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301053037">
	<b:glossaryEntry>comprehensible to the general public; "written for the popular press in plain nontechnical language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301053199">
	<b:glossaryEntry>widely circulated or diffused; "a widespread doctrine"; "widespread fear of nuclear war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301053344">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `to'') applying to or characterized by or distinguishing something particular or special or unique; "rules with specific application"; "demands specific to the job"; "a specific and detailed account of the accident"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301053852">
	<b:glossaryEntry>for or concerned with one specific purpose; "a coordinated policy instead of ad hoc decisions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301053999">
	<b:glossaryEntry>fully detailed and specific about particulars; "a circumstantial report about the debate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301054149">
	<b:glossaryEntry>having a specific function or scope; "a special (or specific) role in the mission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301054295">
	<b:glossaryEntry>unique or specific to a person or thing or category; "the particular demands of the job"; "has a paraticular preference for Chinese art"; "a peculiar bond of sympathy between them"; "an expression peculiar to Canadians"; "rights peculiar to the rich"; "the special features of a computer"; "my own special chair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301054694">
	<b:glossaryEntry>separate and distinct from others of the same group or category; "interested in one particular artist"; "a man who wishes to make a particular woman fall in love with him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301054925">
	<b:glossaryEntry>directed toward a specific object; "particularized thinking as distinct from stereotyped sloganeering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301055105">
	<b:glossaryEntry>limited to the thing specified; "the city proper"; "his claim is connected with the deed proper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301055258">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') applying exclusively to a given category or condition or locality; "a species unique to Australia"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301055431">
	<b:glossaryEntry>(med and pathology) being or affecting a disease produced by a particular microorganism or condition; used also of stains or dyes used in making microscope slides; "quinine is highly specific for malaria"; "a specific remedy"; "a specific stain is one having a specific affinity for particular structural elements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301055799">
	<b:glossaryEntry>(medicine and pathology) not caused by a specific agent; used also of staining in making microscope slides; "nonspecific enteritis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301056006">
	<b:glossaryEntry>concerned with or applicable to or belonging to an entire nation or country; "the national government"; "national elections"; "of national concern"; "the national highway system"; "national forests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301056295">
	<b:glossaryEntry>national; especially in reference to the government of the United States as distinct from that of its member units; "the Federal Bureau of Investigation"; "federal courts"; "the federal highway program"; "federal property"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301056571"
	 b:glossaryEntry='of national scope; "a general election"'/>
<rdf:Description rdf:about="&a;301056664">
	<b:glossaryEntry>relating to applicable to or concerned with a city or town or district rather than a larger area; "local taxes"; "local schools and churches"; "a local bus line"; "local authorities"; "local streets and roads"; "local control"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301056978">
	<b:glossaryEntry>belonging to and maintained by and for the local community; "community parks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301057111">
	<b:glossaryEntry>applicable to or serving the needs of a particular district; "the district courts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301057248"
	 b:glossaryEntry='making all stops on its run; "a local train or bus"'/>
<rdf:Description rdf:about="&a;301057351">
	<b:glossaryEntry>fast and direct and usually nonstop; "an express train or bus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301057467">
	<b:glossaryEntry>(ecology) growing or occurring in many parts of the world; "a cosmopolitan herb"; "cosmopolitan in distribution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301057659">
	<b:glossaryEntry>(ecology) native to or confined to a certain region; "the islands have a number of interesting endemic species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301057824"
	 b:glossaryEntry='provided with gills; "a gilled tadpole"'/>
<rdf:Description rdf:about="&a;301057929"
	 b:glossaryEntry="having no gills"/>
<rdf:Description rdf:about="&a;301058041">
	<b:glossaryEntry>constituting a center or having controlling authority; where all the important decisions are made; "the central office is in Atlanta"; "our central government"; "the central library"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301058295">
	<b:glossaryEntry>relating to or being a place of origin or headquarters; "the home office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301058419">
	<b:glossaryEntry>having subordinate authority or serving the needs of a limited district; "the local office"; "local branches of the library"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301058595">
	<b:glossaryEntry>(government) characterized by or constituting a form of government in which power is divided between one central and several regional authorities; "a federal system like that of the United States"; "federal governments often evolved out of confederatons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301058903">
	<b:glossaryEntry>(government) characterized by or constituting a form of government in which power is held by one central authority; "a unitary as opposed to a federal form of government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301059127">
	<b:glossaryEntry>drawn toward a center or brought under the control of a central authority; "centralized control of emergency relief efforts"; "centralized government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301059335">
	<b:glossaryEntry>withdrawn from a center or place of concentration; especially having power or function dispersed from a central to local authorities; "a decentralized school administration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301059622">
	<b:glossaryEntry>made local or oriented locally; "a decentralized and localized political authority"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301059761">
	<b:glossaryEntry>having population and industries relocated from urban to outlying areas; "redistributed industries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301059920"
	 b:glossaryEntry='surrounded by many suburbs; "a highly suburbanized city"'/>
<rdf:Description rdf:about="&a;301060035">
	<b:glossaryEntry>characterizing or showing skill in or specialized knowledge of applied arts and sciences; "a technical problem"; "highly technical matters hardly suitable for the general public"; "a technical report"; "producing the A-bomb was a challenge to the technical people of this country"; "technical training"; "technical language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301060451"
	 b:glossaryEntry='based on specialized theory; "a theoretical analysis"'/>
<rdf:Description rdf:about="&a;301060574">
	<b:glossaryEntry>marked by or characteristic of specialization in a mechanical or scientific subject; "his specialized qualifications for the job"; "all kinds of specialized technical books"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301060805">
	<b:glossaryEntry>not characteristic of or skilled in applied arts and sciences; "nontechnical aspects of the job"; "nontechnical training"; "an untechnical reader"; "in clear effective nontechnical language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301061068">
	<b:glossaryEntry>not protected by trademark or patent or copyright; "nonproprietary products are in the public domain and anyone can produce or distribute them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301061308">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of drugs) not protected by trademark; "`Acetaminophen'' is the generic form of the proprietary drug `Tylenol''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301061472"
	 b:glossaryEntry='(of devices and processes) "unpatented inventions"'/>
<rdf:Description rdf:about="&a;301061579">
	<b:glossaryEntry xml:space='preserve'><![CDATA[protected by trademark or patent or copyright; made or produced or distributed by one having exclusive rights; "`Tylenol'' is a proprietary drug of which `acetaminophen'' is the generic form"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301061898">
	<b:glossaryEntry>(of goods and merchandise) marked or labeled by a distinctive word or symbol indicating exclusive rights; "branded merchandise is that bearing a standard brand name"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301062117">
	<b:glossaryEntry>(of literary or musical or dramatic or artistic work) protected by copyright; "permission to publish copyright material"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301062307">
	<b:glossaryEntry>(of devices and processes) protected by patent; "patented inventions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301062430">
	<b:glossaryEntry>(of goods and merchandise) labeled with proprietary (and legally registered) identification guaranteeing exclusive use; "trademarked goods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301062627">
	<b:glossaryEntry>willing to give and share unstintingly; "a generous donation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301062887"
	 b:glossaryEntry="generous in providing aid to others"/>
<rdf:Description rdf:about="&a;301062993">
	<b:glossaryEntry xml:space='preserve'><![CDATA[given or giving freely; "was a big tipper"; "the bounteous goodness of God"; "bountiful compliments"; "a freehanded host"; "a handsome allowance"; "Saturday''s child is loving and giving"; "a liberal backer of the arts"; "a munificent gift"; "her fond and openhanded grandfather"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301063414">
	<b:glossaryEntry>very generous; "distributed gifts with a lavish hand"; "the critics were lavish in their praise"; "a munificent gift"; "his father gave him a half-dollar and his mother a quarter and he thought them munificent"; "prodigal praise"; "unsparing generosity"; "his unstinted devotion"; "called for unstinting aid to Britain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301063877"
	 b:glossaryEntry="not greedy"/>
<rdf:Description rdf:about="&a;301063943">
	<b:glossaryEntry>not generous; "she practices economy without being stingy"; "an ungenerous response to the appeal for funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301064333">
	<b:glossaryEntry>used of sums of money; so small in amount as to deserve contempt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301064459"
	 b:glossaryEntry="embarrassingly stingy"/>
<rdf:Description rdf:about="&a;301064552">
	<b:glossaryEntry>giving or spending with reluctance; "our cheeseparing administration"; "very close (or near) with his money"; "a penny-pinching miserly old man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301064787"
	 b:glossaryEntry="unwilling to part with money"/>
<rdf:Description rdf:about="&a;301064900"
	 b:glossaryEntry='petty in giving or spending; "a niggardly tip"'/>
<rdf:Description rdf:about="&a;301065022"
	 b:glossaryEntry='barely adequate; "a meager allowance"'/>
<rdf:Description rdf:about="&a;301065122">
	<b:glossaryEntry>used of persons or behavior; characterized by or indicative of lack of generosity; "a small miserly man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301065320">
	<b:glossaryEntry>excessively unwilling to spend; "parsimonious thrift relieved by few generous impulses"; "lived in a most penurious manner--denying himself every indulgence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301065548">
	<b:glossaryEntry>not petty in character and mind; "unusually generous in his judgment of people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301065754">
	<b:glossaryEntry xml:space='preserve'><![CDATA[generous and understanding and tolerant; "a heart big enough to hold no grudges"; "that''s very big of you to be so forgiving"; "a large and generous spirit"; "a large heart"; "magnanimous toward his enemies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301066033"
	 b:glossaryEntry='liberal; "kind words of praise"'/>
<rdf:Description rdf:about="&a;301066115"
	 b:glossaryEntry='without envy or reluctance; "ungrudging admiration"'/>
<rdf:Description rdf:about="&a;301066223">
	<b:glossaryEntry>lacking in magnanimity; "it seems ungenerous to end this review of a splendid work of scholarship on a critical note"- Times Litt. Sup.; "a meanspirited man unwilling to forgive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301066527"
	 b:glossaryEntry='"grudging in her praise"'/>
<rdf:Description rdf:about="&a;301066607">
	<b:glossaryEntry xml:space='preserve'><![CDATA[harsh and severe; "I hope I''m not being uncharitable but he really is a bore"; "unjust and uncharitable criticism"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301066794">
	<b:glossaryEntry>not fake or counterfeit; "a genuine Picasso"; "genuine leather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301067073">
	<b:glossaryEntry>not counterfeit or copied; "an authentic signature"; "a bona fide manuscript"; "an unquestionable antique"; "photographs taken in a veritable bull ring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301067322"
	 b:glossaryEntry="established as genuine"/>
<rdf:Description rdf:about="&a;301067428"
	 b:glossaryEntry='not forged; "a good dollar bill"'/>
<rdf:Description rdf:about="&a;301067511">
	<b:glossaryEntry>used informally especially for emphasis; "a real honest-to-god live cowboy"; "had us a high old time"; "went upriver to look at a sure-enough fish wheel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301067771">
	<b:glossaryEntry>not synthetic or spurious; of real or natural origin; "real mink"; "true gold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301067907">
	<b:glossaryEntry>not genuine; imitating something superior; "counterfeit emotion"; "counterfeit money"; "counterfeit works of art"; "a counterfeit prince"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301068366">
	<b:glossaryEntry>adopted in order to deceive; "an assumed name"; "an assumed cheerfulness"; "a fictitious address"; "fictive sympathy"; "a pretended interest"; "a put-on childish voice"; "sham modesty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301068663">
	<b:glossaryEntry>reproduced fraudulently; "like a bad penny..."; "a forged twenty dollar bill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301068799">
	<b:glossaryEntry>debased; not genuine; "an attempt to eliminate the base coinage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301068914"
	 b:glossaryEntry="fraudulent; having a misleading appearance"/>
<rdf:Description rdf:about="&a;301069042"
	 b:glossaryEntry='intended to deceive; "a spurious work of art"'/>
<rdf:Description rdf:about="&a;301069170">
	<b:glossaryEntry>constituting a copy or imitation of something; "boys in mock battle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301069289">
	<b:glossaryEntry>represented or appearing as such; pretended; "His ostensible purpose was charity, his real goal popularity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301069465"
	 b:glossaryEntry='serving as an imitation or substitute; "pinchbeck heroism"'/>
<rdf:Description rdf:about="&a;301069579">
	<b:glossaryEntry>(often used in combination) not genuine but having the appearance of; "a pseudo esthete"; "pseudoclassic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301069737">
	<b:glossaryEntry>not genuine or natural; "counterfeit rhetoric that flourishes when passions are synthetic"- George Will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301069896"
	 b:glossaryEntry="having the earth as the center"/>
<rdf:Description rdf:about="&a;301070001">
	<b:glossaryEntry>or or relating to the geocentric Ptolemaic system; "in the Ptolemaic system of planetary motion the earth is fixed as the center of the universe with the sun and moon and planets revolving around it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301070256"
	 b:glossaryEntry="having the sun as the center"/>
<rdf:Description rdf:about="&a;301070361">
	<b:glossaryEntry>according to Copernicus; "in the Copernican system the earth and other planets revolve around the sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301070520">
	<b:glossaryEntry>having possession delivered or transferred without compensation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301070707"
	 b:glossaryEntry="given formally or officially"/>
<rdf:Description rdf:about="&a;301070814">
	<b:glossaryEntry>given freely especially to a cause or fund; "the donated van made their meal-on-wheels venture possible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301070972">
	<b:glossaryEntry>given as a grant; "the special funds granted for his research project"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301071096">
	<b:glossaryEntry>given up often unwillingly; "a relinquishment is a piece of relinquished or abandoned land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301071260"
	 b:glossaryEntry="having possession gained especially by force or effort"/>
<rdf:Description rdf:about="&a;301071474">
	<b:glossaryEntry>taken without permission or consent especially by public authority; "the condemned land was used for a highway cloverleaf"; "the confiscated liquor was poured down the drain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301071767">
	<b:glossaryEntry xml:space='preserve'><![CDATA[taken as your right without justification; "was hearing evidence in an assumed capacity"; "Congress''s arrogated powers over domains hitherto belonging to the states"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301071998">
	<b:glossaryEntry>taken for your own use in violation of a trust; "the embezzled funds amounted to millions of dollars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301072155">
	<b:glossaryEntry>taken out of the possession of another and transferred to your own use often without permission; "the expropriated land was developed into a public playground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301072373"
	 b:glossaryEntry='taken dishonestly; "the purloined letter"'/>
<rdf:Description rdf:about="&a;301072479">
	<b:glossaryEntry>(used especially of the rights of another) seized and held by force; "the usurped crown sat heavy on his head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301072643">
	<b:glossaryEntry>having a shiny surface or coating; "glazed fabrics"; "glazed doughnuts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301072830">
	<b:glossaryEntry>(of ceramics) having the surface made shiny and nonporous by fusing a vitreous solution to it; "glazed pottery"; "glassy porcelain"; "hard vitreous china used for plumbing fixtures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301073087">
	<b:glossaryEntry>(of paper and fabric and leather) having a surface made smooth and glossy especially by pressing between rollers; "calendered paper"; "a dress of glossy sateen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301073313">
	<b:glossaryEntry>shiny and slick as with a thin coating of ice; "roads and trees glazed with an icy film"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301073451"
	 b:glossaryEntry='not having a shiny coating; "unglazed paper"'/>
<rdf:Description rdf:about="&a;301073568">
	<b:glossaryEntry>(of ceramics) lacking a vitreous finish; "unvitrified pottery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301073688"
	 b:glossaryEntry='fitted or covered with glass; "four glazed walls"'/>
<rdf:Description rdf:about="&a;301073800">
	<b:glossaryEntry>not furnished with glass; "windows were unglazed to admit as much light and air as possible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301073959">
	<b:glossaryEntry>having or deserving or conferring glory; "a long and glorious career"; "our glorious literature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301074254">
	<b:glossaryEntry>splendid; "the bright stars of stage and screen"; "a bright moment in history"; "the bright pageantry of court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301074418"
	 b:glossaryEntry="having an illustrious past"/>
<rdf:Description rdf:about="&a;301074523">
	<b:glossaryEntry>of such surpassing excellence as to suggest divine inspiration; "her pies were simply divine"; "the divine Shakespeare"; "an elysian meal"; "an inspired performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301074762">
	<b:glossaryEntry>inspiring awe; "well-meaning ineptitude that rises to empyreal absurdity"- M.S.Dworkin; "empyrean aplomb"- Hamilton Basso; "the sublime beauty of the night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301074994"
	 b:glossaryEntry='having or conferring glory; "an illustrious achievement"'/>
<rdf:Description rdf:about="&a;301075108">
	<b:glossaryEntry>characterized by ardent emotion or intensity or brilliance; "an incandescent performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301075256">
	<b:glossaryEntry>brilliant; "set a lustrous example for others to follow"; "lustrous actors of the time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301075398">
	<b:glossaryEntry>not bringing honor and glory; "some mute inglorious Milton here may rest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301075597">
	<b:glossaryEntry>not famous or acclaimed; "an obscure family"; "unsung heroes of the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301075742">
	<b:glossaryEntry>functioning correctly and ready for action; "all systems are go"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301075873"
	 b:glossaryEntry="in perfect condition or order"/>
<rdf:Description rdf:about="&a;301075968">
	<b:glossaryEntry>not functioning properly or in suitable condition for proceeding; "the space launch was no-go"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301076114">
	<b:glossaryEntry>having desirable or positive qualities especially those suitable for a thing specified; "good news from the hospital"; "a good report card"; "when she was good she was very very good"; "a good knife is one good for cutting"; "this stump will make a good picnic table"; "a good check"; "a good joke"; "a good exterior paint"; "a good secretary"; "a good dress for the office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301076845">
	<b:glossaryEntry>(informal) very good; "a bully pulpit"; "a cool sports car"; "had a great time at the party"; "you look simply smashing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301077153">
	<b:glossaryEntry xml:space='preserve'><![CDATA[adequately good for the circumstances; "if it''s good enough for you it''s good enough for me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301077303"
	 b:glossaryEntry='moderately good of its kind; "a goodish wine"'/>
<rdf:Description rdf:about="&a;301077402">
	<b:glossaryEntry xml:space='preserve'><![CDATA[very good; often used in the negative; "he''s hot at math but not so hot at history"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301077535">
	<b:glossaryEntry>compensating for some fault or defect; "the redeeming feature of the plan is its simplicity"; "his saving grace was his sense of humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301077729"
	 b:glossaryEntry='meeting requirements; "the step makes a satisfactory seat"'/>
<rdf:Description rdf:about="&a;301077859">
	<b:glossaryEntry>of good substantial quality; "solid comfort"; "a solid base hit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301077975">
	<b:glossaryEntry>suitable for the desired purpose; "Is this a suitable dress for the office?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301078106"
	 b:glossaryEntry='surpassingly good; "a superb meal"'/>
<rdf:Description rdf:about="&a;301078193">
	<b:glossaryEntry>(usually of children) someone who behaves in a manner that the speaker believes is correct; "a well-behaved child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301078381">
	<b:glossaryEntry>having undesirable or negative qualities; "a bad report card"; "his sloppy appearance made a bad impression"; "a bad little boy"; "clothes in bad shape"; "a bad cut"; "bad luck"; "the news was very bad"; "the reviews were bad"; "the pay is bad"; "it was a bad light for reading"; "the movie was a bad choice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301079225">
	<b:glossaryEntry>exceptionally bad or displeasing; "atrocious taste"; "abominable workmanship"; "an awful voice"; "dreadful manners"; "a painful performance"; "terrible handwriting"; "an unspeakable odor came sweeping into the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301079563">
	<b:glossaryEntry>(of wine) tainted in flavor by a cork containing excess tannin; "a corked port"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301079703">
	<b:glossaryEntry>very bad; "my finances were in a deplorable state"; "a lamentable decision"; "her clothes were in sad shape"; "a sorry state of affairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301079947">
	<b:glossaryEntry>extremely distressing; "fearful slum conditions"; "a frightful mistake"; "suffered terrible thirst"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301080123"
	 b:glossaryEntry='used ironically; "a fine mess"; "a pretty kettle of fish"'/>
<rdf:Description rdf:about="&a;301080240">
	<b:glossaryEntry>unfortunate or hard to bear; "had hard luck"; "a tough break"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301080360">
	<b:glossaryEntry>(informal to emphasize how bad it is) beyond hope of management or reform; "she handed me a hopeless jumble of papers"; "he is a hopeless romantic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301080562"
	 b:glossaryEntry='exceedingly bad; "when she was bad she was horrid"'/>
<rdf:Description rdf:about="&a;301080665">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) very bad; "a lousy play"; "it''s a stinking world"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301080831"
	 b:glossaryEntry='distressing; "ill manners"; "of ill repute"'/>
<rdf:Description rdf:about="&a;301080924"
	 b:glossaryEntry='not doing a good job; "incompetent at chess"'/>
<rdf:Description rdf:about="&a;301081038">
	<b:glossaryEntry>poor to middling in quality; "there have been good and mediocre and bad artists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301081173">
	<b:glossaryEntry>badly behaved; "he was saucy and mischievous in school"; "a naughty boy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301081313">
	<b:glossaryEntry>having the quality of something harmful or unpleasant; "ran a negative campaign"; "delinquents retarded by their negative outlook on life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301081506"
	 b:glossaryEntry='unsatisfactory; "a poor light for reading"; "poor morale"'/>
<rdf:Description rdf:about="&a;301081614"
	 b:glossaryEntry='(informal) "a rubber check"; "a no-good check"'/>
<rdf:Description rdf:about="&a;301081723">
	<b:glossaryEntry>very bad in degree or extent; "a severe worldwide depression"; "the house suffered severe damage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301081873">
	<b:glossaryEntry>(British) severe; punishingly bad; "swingeing taxation"; "swingeing damages awarded by the judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301082026">
	<b:glossaryEntry>not favorable; "made an unfavorable impression"; "unfavorable reviews"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301082154">
	<b:glossaryEntry>not adequate recompense or expiation; "the pay is unsatisfactory and the conditions are unacceptable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301082316">
	<b:glossaryEntry>not conducive to good moral development; "the movie is unsuitable for children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301082452"
	 b:glossaryEntry="morally admirable"/>
<rdf:Description rdf:about="&a;301082754">
	<b:glossaryEntry>marked by utter benignity; resembling or befitting an angel or saint; "angelic benificence"; "a beatific smile"; "a saintly concern for his fellow men"; "my sainted mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301083035"
	 b:glossaryEntry="doing or producing good"/>
<rdf:Description rdf:about="&a;301083139"
	 b:glossaryEntry="affectedly or smugly good or self-righteous"/>
<rdf:Description rdf:about="&a;301083240">
	<b:glossaryEntry>bringing about salvation or redemption from sin; "saving faith"; "redemptive (or redeeming) love"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301083421">
	<b:glossaryEntry xml:space='preserve'><![CDATA[benevolent; without malicious intent; "white magic"; "a white lie"; "that''s white of you"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301083562"
	 b:glossaryEntry='morally admirable; "a worthy citizen"'/>
<rdf:Description rdf:about="&a;301083652">
	<b:glossaryEntry>morally bad or wrong; "evil purposes"; "an evil influence"; "evil deeds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301084054">
	<b:glossaryEntry>shockingly brutal or cruel; "murder is an atrocious crime"; "a grievous offense against morality"; "a grievous crime"; "no excess was too monstrous for them to commit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301084323">
	<b:glossaryEntry>characterized by wickedness or immorality; "led a very bad life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301084447">
	<b:glossaryEntry>stemming from evil characteristics or forces; wicked or dishonorable; "black deeds"; "a black lie"; "his black heart has concocted yet another black deed"; "Darth Vader of the dark side"; "a dark purpose"; "dark undercurrents of ethnic hostility"; "the scheme of some sinister intelligence bent on punishing him"-Thomas Hardy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301084842"
	 b:glossaryEntry="tending to corrupt or pervert"/>
<rdf:Description rdf:about="&a;301084941">
	<b:glossaryEntry>extremely evil or cruel; expressive of cruelty or befitting hell; "something demonic in him--something that could be cruel"; "fires lit up a diabolic scene"; "diabolical sorcerers under the influence of devils"; "a fiendish despot"; "hellish torture"; "infernal instruments of war"; "satanic cruelty"; "unholy grimaces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301085389">
	<b:glossaryEntry>morally reprehensible; "would do something as despicable as murder"; "ugly crimes"; "the vile development of slavery appalled them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301085602">
	<b:glossaryEntry>showing the cunning or ingenuity or wickedness typical of a devil; "devilish schemes"; "the cold calculation and diabolic art of some statesmen"; "the diabolical expression on his face"; "a mephistophelian glint in his eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301085940"
	 b:glossaryEntry="having evil thoughts or intentions"/>
<rdf:Description rdf:about="&a;301086032">
	<b:glossaryEntry>having an easygoing and cheerful disposition; "too good-natured to resent a little criticism"; "the good-natured policeman on our block"; "the sounds of good-natured play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301086370">
	<b:glossaryEntry>disposed to please; "an amiable villain with a cocky sidelong grin"- Hal Hinson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301086534">
	<b:glossaryEntry>not easily irritated; "an equable temper"; "not everyone shared his placid temperament"; "remained placid despite the repeated delays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301086763">
	<b:glossaryEntry>having an irritable and unpleasant disposition; "an ill-natured disagreeable old man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301087302"
	 b:glossaryEntry="irritable as if suffering from indigestion"/>
<rdf:Description rdf:about="&a;301087435">
	<b:glossaryEntry>very irritable; "bristly exchanges between the White House and the press"; "he became prickly and spiteful"; "witty and waspish about his colleagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301087670">
	<b:glossaryEntry>having a difficult and contrary disposition; "a cantankerous and venomous-tongued old lady"- Dorothy Sayers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301087857"
	 b:glossaryEntry='quickly aroused to anger; "a hotheaded commander"'/>
<rdf:Description rdf:about="&a;301088042">
	<b:glossaryEntry>having a bad disposition; surly; "churlish as a bear"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301088163"
	 b:glossaryEntry="perversely irritable"/>
<rdf:Description rdf:about="&a;301088311">
	<b:glossaryEntry>easily irritated or annoyed; "an incorrigibly fractious young man"; "not the least nettlesome of his countrymen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301088579">
	<b:glossaryEntry>brusque and surly and forbidding; "crusty remarks"; "a crusty old man"; "his curmudgeonly temper"; "gruff manner"; "a gruff reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301088814"
	 b:glossaryEntry="resembling a cur; snarling and rude"/>
<rdf:Description rdf:about="&a;301088903">
	<b:glossaryEntry>showing a brooding ill humor; "a dark scowl"; "the proverbially dour New England Puritan"; "a glum, hopeless shrug"; "he sat in moody silence"; "a morose and unsociable manner"; "a saturnine, almost misanthropic young genius"- Bruce Bliven; "a sour temper"; "a sullen crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301089299">
	<b:glossaryEntry>irritable and looking for trouble; "too touchy to make judicious decisions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301089436"
	 b:glossaryEntry="sullen or moody"/>
<rdf:Description rdf:about="&a;301089513"
	 b:glossaryEntry="hating mankind in general"/>
<rdf:Description rdf:about="&a;301089614"
	 b:glossaryEntry="hating women in particular"/>
<rdf:Description rdf:about="&a;301089697"
	 b:glossaryEntry="(British informal) ill-tempered or annoyed"/>
<rdf:Description rdf:about="&a;301089801">
	<b:glossaryEntry>continually complaining or faultfinding; "a shrewish wife"; "nagging parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301089943"
	 b:glossaryEntry='tending to speak irritably; "a snappish tone of voice"'/>
<rdf:Description rdf:about="&a;301090061">
	<b:glossaryEntry>having the character or disposition harmed by pampering or oversolicitous attention; "a spoiled child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301090226">
	<b:glossaryEntry>inclined to anger or bad feelings with overtones of menace; "a surly waiter"; "an ugly frame of mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301090386"
	 b:glossaryEntry="characterized by beauty of movement, style, form etc."/>
<rdf:Description rdf:about="&a;301090656"
	 b:glossaryEntry="quick and skillful in movement"/>
<rdf:Description rdf:about="&a;301090737"
	 b:glossaryEntry="of seemingly effortless beauty in form or proportion"/>
<rdf:Description rdf:about="&a;301090843">
	<b:glossaryEntry>smooth and unconstrained in movement; "a long, smooth stride"; "the fluid motion of a cat"; "the liquid grace of a ballerina"; "liquid prose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301091073">
	<b:glossaryEntry>easy and graceful in shape; "a yacht with long, fluent curves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301091188">
	<b:glossaryEntry>graceful and pleasing; "gainly conduct"; "a gainly youth with dark hair and eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301091321"
	 b:glossaryEntry="slender and graceful"/>
<rdf:Description rdf:about="&a;301091405"
	 b:glossaryEntry="gracefully slender; moving and bending with ease"/>
<rdf:Description rdf:about="&a;301091576">
	<b:glossaryEntry>lacking grace or skill in manner or movement or performance; "an awkward dancer"; "an awkward gesture"; "too awkward with a needle to make her own clothes"; "his clumsy fingers produced an awkward knot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301091940">
	<b:glossaryEntry>lacking grace in movement or posture; "a gawky lad with long ungainly legs"; "clumsy fingers"; "what an ungainly creature a giraffe is"; "heaved his unwieldy figure out of his chair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301092214">
	<b:glossaryEntry>lacking grace; clumsy; "a graceless production of the play"; "his stature low...his bearing ungraceful"- Sir Walter Scott</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301092404"
	 b:glossaryEntry='lacking natural ease; "a labored style of debating"'/>
<rdf:Description rdf:about="&a;301092531">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking ease or grace; "the actor''s performance was wooden;" "a wooden smile"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301092661">
	<b:glossaryEntry>characterized by charm, good taste, and generosity of spirit; "gracious even to unexpected visitors"; "gracious living"; "he bears insult with gracious good humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301092969"
	 b:glossaryEntry="suggesting taste, ease, and wealth"/>
<rdf:Description rdf:about="&a;301093078">
	<b:glossaryEntry>used conventionally of royalty and high nobility; "our merciful king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301093202"
	 b:glossaryEntry="characterized by tact and propriety"/>
<rdf:Description rdf:about="&a;301093290">
	<b:glossaryEntry>lacking charm and good taste; "an ungracious industrial city; "this curt summary is not meant to be ungracious"; "ungracious behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301093535"
	 b:glossaryEntry="rude and boorish"/>
<rdf:Description rdf:about="&a;301093606"
	 b:glossaryEntry='lacking graciousness; "a totally graceless hostess"'/>
<rdf:Description rdf:about="&a;301093726"
	 b:glossaryEntry='proceeding in small stages; "a gradual increase in prices"'/>
<rdf:Description rdf:about="&a;301093892"
	 b:glossaryEntry="one thing at a time"/>
<rdf:Description rdf:about="&a;301094024"
	 b:glossaryEntry="slowly and smoothly"/>
<rdf:Description rdf:about="&a;301094125">
	<b:glossaryEntry>happening without warning or in a short space of time; "a sudden storm"; "a sudden decision"; "a sudden cure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301094377">
	<b:glossaryEntry>exceedingly sudden and unexpected; "came to an abrupt stop"; "an abrupt change in the weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301094524"
	 b:glossaryEntry='sudden and loud; "an explosive laugh"'/>
<rdf:Description rdf:about="&a;301094617">
	<b:glossaryEntry>very sudden and in great amount or degree; "a sharp drop in the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301094746">
	<b:glossaryEntry>happening or coming quickly and without warning; "a sudden unexpected development"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301094898">
	<b:glossaryEntry>of a topographical gradient; not steep or abrupt; "a gradual slope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301095073">
	<b:glossaryEntry>marked by moderate steepness; "an easy climb"; "a gentle slope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301095196">
	<b:glossaryEntry>having a slanting form or direction; "an area of gently sloping hills"; "a room with a sloping ceiling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301095353">
	<b:glossaryEntry>having a sharp inclination; "the steep attic stairs"; "steep cliffs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301095581">
	<b:glossaryEntry>extremely steep; "an abrupt canyon"; "the precipitous rapids of the upper river"; "the precipitous hills of Chinese paintings"; "a sharp drop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301095798">
	<b:glossaryEntry>having a prominent and almost vertical front; "abluff headland"; "the bold face of the cliff"; "a sheer descent of rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301095985"
	 b:glossaryEntry='sharply inclined; "a heavy grade"'/>
<rdf:Description rdf:about="&a;301096070"
	 b:glossaryEntry='extremely steep; "the great perpendicular face of the cliff"'/>
<rdf:Description rdf:about="&a;301096190"
	 b:glossaryEntry="somewhat steep"/>
<rdf:Description rdf:about="&a;301096259">
	<b:glossaryEntry>(of a shore or shoreline) characterized by steep cliffs or precipices; "the cliffy shores of Dover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301096477"
	 b:glossaryEntry="rocky and steep"/>
<rdf:Description rdf:about="&a;301096554"
	 b:glossaryEntry='characterized by precipices; "a precipitous bluff"'/>
<rdf:Description rdf:about="&a;301096662">
	<b:glossaryEntry>abounding in or bordered by rocky cliffs or scarps; "the rock-ribbed coast of Maine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301096816">
	<b:glossaryEntry>(of a shore or shoreline) having an extensive gently sloping area covered with sand or gravel or shingle down to the water line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097044">
	<b:glossaryEntry xml:space='preserve'><![CDATA[abounding in sand; "Florida''s sandy beaches"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097140">
	<b:glossaryEntry>abounding in small stones; "landed at a shingly little beach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097275">
	<b:glossaryEntry>(of bacteria) being or relating to a bacterium that retains the violet stain used in Gram''s method</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097433">
	<b:glossaryEntry>(of bacteria) being or relating to a bacterium that does not retain the violet stain used in Gram''s method</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097599">
	<b:glossaryEntry>conforming to the rules of grammar or usage accepted by native speakers; "spoke in grammatical sentences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097776">
	<b:glossaryEntry>not grammatical; not conforming to the rules of grammar or accepted usage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301097922">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feeling or showing gratitude; "a grateful heart"; "grateful for the tree''s shade"; "a thankful smile"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301098125">
	<b:glossaryEntry>feeling or expressive of gratitude; "was appreciative of his efforts"; "an appreciative word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301098277">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feeling happy appreciation; "glad of the fire''s warmth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301098383">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not feeling or showing gratitude; "ungrateful heirs"; "How sharper than a serpent''s tooth it is / To have a thankless child!"- Shakespeare]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301098621">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not feeling or expressing gratitude; "unappreciative of nature''s bounty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301098754">
	<b:glossaryEntry>(genetics; of a cell or organism) having a single set of chromosomes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301098918">
	<b:glossaryEntry>(genetics; of a cell or organism) having two sets of chromosomes or twice the haploid number; "diploid somatic cells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301099107">
	<b:glossaryEntry>(genetics; of a cell or organism) having more than twice the haploid number of chromosomes; "a polyploid cell"; "a polyploid species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301099314">
	<b:glossaryEntry>enjoying or showing or marked by joy or pleasure or good fortune; "a happy smile"; "spent many happy days on the beach"; "a happy marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301099811">
	<b:glossaryEntry>characterized by happiness and good fortune; "a blessed time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301099926">
	<b:glossaryEntry>completely happy and contented; "blissful young lovers"; "in blissful ignorance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301100061">
	<b:glossaryEntry>characterized by happiness or gladness; "bright faces"; "all the world seems bright and gay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301100206">
	<b:glossaryEntry>resembling paradise; causing happiness; "elysian peace"; "a paradisal place without work or struggle"; "paradisial isles"; "an age of paradisiacal happiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301100498">
	<b:glossaryEntry>marked by peace and prosperity; "a golden era"; "the halcyon days of the clipper trade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301100661"
	 b:glossaryEntry='joyful and carefree; "halcyon days of youth"'/>
<rdf:Description rdf:about="&a;301100759">
	<b:glossaryEntry>full of or suggesting exultant happiness; "a joyful heart"; "a joyful occasion"; "the joyous news"; "joyous laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301100938">
	<b:glossaryEntry>showing or feeling mirth or pleasure or happiness; "laughing children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301101074">
	<b:glossaryEntry>experiencing or marked by or causing sadness or sorrow or discontent; "unhappy over her departure"; "unhappy with her raise"; "after the argument they lapsed into an unhappy silence"; "had an unhappy time at school"; "the unhappy (or sad) news"; "he looks so sad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301101631">
	<b:glossaryEntry>keenly sorry or regretful; "felt bad about letting the team down"; "was sorry that she had treated him so badly"; "felt bad about breaking the vase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301101837">
	<b:glossaryEntry>unhappy at being away and longing for familiar things or persons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301101968">
	<b:glossaryEntry>languishing because of love; "strong men behaving like lovesick boys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301102092">
	<b:glossaryEntry>very unhappy; full of misery; "he felt depressed and miserable"; "a message of hope for suffering humanity"; "wretched prisoners huddled in stinking cages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301102326">
	<b:glossaryEntry>having regret or sorrow or a sense of loss over something done or undone; "felt regretful over his vanished youth"; "regretful over mistakes she had made"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301102544">
	<b:glossaryEntry>feeling no regret; "was completely unregretful about what had happened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301102688">
	<b:glossaryEntry>not yielding to pressure or easily penetrated; "hard as rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301103106"
	 b:glossaryEntry="having the hardness of a diamond"/>
<rdf:Description rdf:about="&a;301103195"
	 b:glossaryEntry="made of horn (or of a substance resembling horn)"/>
<rdf:Description rdf:about="&a;301103317"
	 b:glossaryEntry="(physiology) of sexual organs; stiff and rigid"/>
<rdf:Description rdf:about="&a;301103423">
	<b:glossaryEntry>not soft or yielding to pressure; "a firm mattress"; "the snow was firm underfoot"; "solid ground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301103580"
	 b:glossaryEntry='hard as granite; "a granitic fist"'/>
<rdf:Description rdf:about="&a;301103702"
	 b:glossaryEntry="converted to solid form (as concrete)"/>
<rdf:Description rdf:about="&a;301103800">
	<b:glossaryEntry>made hard like wood as the result of the deposition of lignin in the cell walls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301103943"
	 b:glossaryEntry="like marble in hardness"/>
<rdf:Description rdf:about="&a;301104034">
	<b:glossaryEntry>changed into bone; hardened by deposits of mineral matter; "cartilages ossified with age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301104178"
	 b:glossaryEntry="converted into stone"/>
<rdf:Description rdf:about="&a;301104254">
	<b:glossaryEntry>(of bone especially the temporal bone) resembling stone in hardness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301104387"
	 b:glossaryEntry="somewhat hard"/>
<rdf:Description rdf:about="&a;301104455"
	 b:glossaryEntry="resembling or containing slate"/>
<rdf:Description rdf:about="&a;301104546"
	 b:glossaryEntry="resembling steel in hardness"/>
<rdf:Description rdf:about="&a;301104627"
	 b:glossaryEntry="not softened by the addition of padding"/>
<rdf:Description rdf:about="&a;301104721"
	 b:glossaryEntry="lacking in hardness relatively or comparatively"/>
<rdf:Description rdf:about="&a;301105125">
	<b:glossaryEntry>(of fabrics) having soft nap produced by brushing; "a dress of brushed cotton"; "a fleecy lining"; "napped fabrics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301105312"
	 b:glossaryEntry="having the consistency of cheese"/>
<rdf:Description rdf:about="&a;301105401"
	 b:glossaryEntry="capable of being easily compressed"/>
<rdf:Description rdf:about="&a;301105507"
	 b:glossaryEntry="resembling cotton; as soft as cotton"/>
<rdf:Description rdf:about="&a;301105597"
	 b:glossaryEntry="softened by the addition of cushions or padding"/>
<rdf:Description rdf:about="&a;301105720"
	 b:glossaryEntry="having a softening or soothing effect especially to the skin"/>
<rdf:Description rdf:about="&a;301105870"
	 b:glossaryEntry="like down or as soft as down"/>
<rdf:Description rdf:about="&a;301105979">
	<b:glossaryEntry>lacking firmness or stiffness; "flabby around the middle"; "flaccid cheeks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301106117"
	 b:glossaryEntry="having a fluffy character or appearance"/>
<rdf:Description rdf:about="&a;301106230">
	<b:glossaryEntry>lacking stiffness and giving way to pressure; "a deep yielding layer of foam rubber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301106369"
	 b:glossaryEntry="having the consistency of mush"/>
<rdf:Description rdf:about="&a;301106451"
	 b:glossaryEntry='upholstered thickly and deeply; "an overstuffed sofa"'/>
<rdf:Description rdf:about="&a;301106562"
	 b:glossaryEntry="somewhat soft"/>
<rdf:Description rdf:about="&a;301106640">
	<b:glossaryEntry>resembling a sponge in having soft texture and compressibility; "spongy bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301106791"
	 b:glossaryEntry="resembling velvet in having a smooth soft surface"/>
<rdf:Description rdf:about="&a;301106903">
	<b:glossaryEntry>metaphorically hard; "a hard fate"; "took a hard look"; "a hard bargainer"; "a hard climb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301107206">
	<b:glossaryEntry>(of circumstances; especially weather) causing suffering; "brutal weather"; "northern winters can be cruel"; "a cruel world"; "a harsh climate; "a rigorous climate"; "unkind winters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301107477">
	<b:glossaryEntry>used of persons; "the most calculating and selfish men in the community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301107653">
	<b:glossaryEntry>used of persons; emotionally hardened; "faced a case-hardened judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301107806">
	<b:glossaryEntry>resembling steel as in hardness; "steely eyes"; "steely nerves like those of a steeplejack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301107950">
	<b:glossaryEntry>hard to overcome or surmount; "a stiff hike"; "a stiff exam"; "an uphill battle against a popular incumbant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301108119">
	<b:glossaryEntry>metaphorically soft; "my father is a soft touch"; "soft light"; "a soft rain"; "a soft Southern drawl"; "soft brown eyes"; "a soft glance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301108542">
	<b:glossaryEntry>treated with excessive indulgence; "pampered from earliest childhood, he believed the world had been invented for his entertainment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301108749"
	 b:glossaryEntry="easily influenced or imposed on"/>
<rdf:Description rdf:about="&a;301108836">
	<b:glossaryEntry>(of light) not bright or glaring; "a softer diffused radiance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301108964">
	<b:glossaryEntry>readily exploited or tricked; "an easy mark"; "an easy victim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301109077">
	<b:glossaryEntry>characterized by excessive softness or self-indulgence; "an effeminate civilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301109225">
	<b:glossaryEntry>(of speech or dialect) pleasing in sound; not harsh or strident; "her euphonious Southern speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301109379">
	<b:glossaryEntry>yielding; lacking any hint of hardness; "the liquid stillness of the night enveloping him"; "the liquid brown eyes of a spaniel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301109560">
	<b:glossaryEntry>having or suggesting softness and richness in quality; "a mellow sound"; "the mellow air brought in the feel of imminent autumn"- Thomas Hardy; "a mellowing sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301109786"
	 b:glossaryEntry="of speech sounds"/>
<rdf:Description rdf:about="&a;301109889">
	<b:glossaryEntry>produced by complete closure of the oral passage and subsequent release with a burst of air (as `p'' and `d'' in `pit'' or `dog'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301110069">
	<b:glossaryEntry>produced with the back of the tongue touching or near the soft palate (as `k'' in `cat'' and `g'' in `gun'' and `ng'' in `sing'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301110244">
	<b:glossaryEntry>of speech sounds; characterized by a hissing or hushing sound (as `s'' and `sh'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301110428">
	<b:glossaryEntry>produced by forcing air through a constricted passage (as `f''. `s'', `z'', or `th'' (in both `thin'' and `then''))</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301110614">
	<b:glossaryEntry>produced with the front of the tongue near or touching the hard palate (as `y'') or with the blade of the tongue near the hard palate (as `ch'' in `chin'' or `j'' in `gin'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301110850"
	 b:glossaryEntry="lacking in feeling or pity or warmth"/>
<rdf:Description rdf:about="&a;301110974">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing unfeeling resistance to tender feelings; "the child''s misery would move even the most obdurate heart"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301111155"
	 b:glossaryEntry='easily moved to pity or sorrow; "a softhearted judge"'/>
<rdf:Description rdf:about="&a;301111280">
	<b:glossaryEntry>(used only in combination) having a heart as specified; "gave pleasure to lighter-hearted members of the staff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301111445">
	<b:glossaryEntry>marked by lack of heart or feeling; "a heartless tyrant"; "heartless words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301111594"
	 b:glossaryEntry="lacking or showing kindness or compassion or mercy"/>
<rdf:Description rdf:about="&a;301111705"
	 b:glossaryEntry='used of beverages; containing alcohol; "alcoholic beverages"'/>
<rdf:Description rdf:about="&a;301111929">
	<b:glossaryEntry>having a large proportion of strong liquor; "a very dry martini is almost straight gin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301112066"
	 b:glossaryEntry='having a high alcoholic content; "hard liquor"'/>
<rdf:Description rdf:about="&a;301112172"
	 b:glossaryEntry="able to intoxicate"/>
<rdf:Description rdf:about="&a;301112262">
	<b:glossaryEntry>having alcohol added; "a cup of brandy-laced coffee"; "he drank too much of the spiked punch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301112416">
	<b:glossaryEntry>containing or of the nature of alcohol; "spiritous beverages"; "spirituous liquors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301112568">
	<b:glossaryEntry>consisting of or trading in alcoholic liquor; "a wet cargo"; "a wet canteen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301112694">
	<b:glossaryEntry>used of beverages; not containing alcohol; "nonalcoholic beverages"; "soft drinks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301112842">
	<b:glossaryEntry>made of the hard-to-cut wood of a broad-leaved tree, as e.g. oak; "hardwood floors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301112980">
	<b:glossaryEntry>made of the easy-to-cut wood of a coniferous tree, as e.g. pine; "softwood lumber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301113117">
	<b:glossaryEntry>not causing or capable of causing harm; "harmless bacteria"; "rendered the bomb harmless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301113405"
	 b:glossaryEntry='lacking intent or capacity to injure; "an innocent prank"'/>
<rdf:Description rdf:about="&a;301113529"
	 b:glossaryEntry='causing no harm; "an inoffensive animal"'/>
<rdf:Description rdf:about="&a;301113641">
	<b:glossaryEntry>causing or capable of causing harm; "too much sun is harmful to the skin"; "harmful effects of smoking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301114176">
	<b:glossaryEntry>characterized by physical or psychological maltreatment; "abusive punishment"; "argued...that foster homes are abusive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301114349">
	<b:glossaryEntry>capable of harming; "bad habits"; "bad air"; "smoking is bad for you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301114468">
	<b:glossaryEntry>causing mental or emotional injury; "a bruising experience"; "protected from the bruising facts of battle"- John Mason Brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301114647">
	<b:glossaryEntry>having adverse effect on living things; "noxious chemical wastes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301114802">
	<b:glossaryEntry>(used of statements) harmful and often untrue; tending to discredit or malign</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301115042">
	<b:glossaryEntry>extremely harmful; bringing physical or financial ruin; "a catastrophic depression"; "catastrophic illness"; "a ruinous course of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301115248"
	 b:glossaryEntry="tending to hinder the achievement of a goal"/>
<rdf:Description rdf:about="&a;301115355">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `to'') causing harm or injury; "damaging to career and reputation"; "the reporter''s coverage resulted in prejudicial publicity for the defendant"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301115620">
	<b:glossaryEntry xml:space='preserve'><![CDATA[resulting in suffering or adversity; "ill effects"; "it''s an ill wind that blows no good"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301115759">
	<b:glossaryEntry>working or spreading in a hidden and usually injurious way; "a subtle poison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301115914">
	<b:glossaryEntry>deliberately causing harm or damage; "mischievous rumors and falsehoods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301116044"
	 b:glossaryEntry="having a tendency to cause harm"/>
<rdf:Description rdf:about="&a;301116128">
	<b:glossaryEntry>causing physical or especially psychological injury; "a stabbing remark"; "few experiences are more traumatic than losing a child"; "wounding and false charges of disloyalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301116381"
	 b:glossaryEntry="musically pleasing"/>
<rdf:Description rdf:about="&a;301116564"
	 b:glossaryEntry="involving or characterized by harmony"/>
<rdf:Description rdf:about="&a;301116707">
	<b:glossaryEntry>relating to vibrations that occur as a result of vibrations in a nearby body; "sympathetic vibration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301116877"
	 b:glossaryEntry='in tune; accurate in pitch; "a true note"'/>
<rdf:Description rdf:about="&a;301116978"
	 b:glossaryEntry="free from discordant qualities"/>
<rdf:Description rdf:about="&a;301117059">
	<b:glossaryEntry>harmonious in sound; "the symphonic hum of a million insects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301117190"
	 b:glossaryEntry="not in harmony"/>
<rdf:Description rdf:about="&a;301117350"
	 b:glossaryEntry="lacking in harmony"/>
<rdf:Description rdf:about="&a;301117466">
	<b:glossaryEntry>inaccurate in pitch; "a false (or sour) note"; "her singing was off key"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301117607">
	<b:glossaryEntry>(music) characterized by musical dissonance; harmonically unresolved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301117744">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conducive to good health of body or mind; "a healthful climate"; "a healthful environment"; "healthful nutrition"; "healthful sleep"; "Dickens''s relatively healthful exuberance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301118193"
	 b:glossaryEntry="capable of expelling or destroying parasitic worms"/>
<rdf:Description rdf:about="&a;301118347">
	<b:glossaryEntry>capable of destroying or inhibiting the growth of disease-causing microorganisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301118502">
	<b:glossaryEntry>relieving gas in the alimentary tract (colic or flatulence or griping)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301118649"
	 b:glossaryEntry="emotionally purging"/>
<rdf:Description rdf:about="&a;301118744">
	<b:glossaryEntry>tending to cure or restore to health; "curative powers of herbal remedies"; "her gentle healing hand"; "remedial surgery"; "a sanative environment of mountains and fresh air"; "a therapeutic agent"; "therapeutic diets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301119079"
	 b:glossaryEntry='without the use of drugs; "drugless therapy"'/>
<rdf:Description rdf:about="&a;301119178">
	<b:glossaryEntry xml:space='preserve'><![CDATA[tending to promote physical well-being; beneficial to health; "beneficial effects of a balanced diet"; "a good night''s sleep"; "the salutary influence of pure air"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301119416">
	<b:glossaryEntry>having the properties of medicine; "medicative drugs"; "medicinal herbs"; "medicinal properties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301119581">
	<b:glossaryEntry>preventing or contributing to the prevention of disease; "preventive medicine"; "vaccines are prophylactic"; "a prophylactic drug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301119798">
	<b:glossaryEntry>promoting recuperation; "recuperative powers"; "strongly recuperative remedies"; "restorative effects of exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301119985">
	<b:glossaryEntry>detrimental to good health; "unhealthful air pollution"; "unhealthful conditions in old apartments with peeling lead-based paint"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301120298">
	<b:glossaryEntry>that cripples or disables or incapacitates; "a crippling injury"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301120447">
	<b:glossaryEntry>able to cause disease; "infective agents"; "pathogenic bacteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301120591">
	<b:glossaryEntry>not having a medicinal effect or not medically prescribed; "he took mind-altering drugs for nonmedicinal reasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301120804">
	<b:glossaryEntry>not conducive to good health; "an unhealthy diet of fast foods"; "an unhealthy climate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301120947">
	<b:glossaryEntry>requiring or amenable to treatment by medicine especially as opposed to surgery; "medical treatment"; "pheumonia is a medical disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301121135">
	<b:glossaryEntry>relating to or requiring or amenable to treatment by surgery especially as opposed to medicine; "a surgical appendix"; "a surgical procedure"; "operative dentistry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301121384">
	<b:glossaryEntry>happening or done after a surgical operation; "postoperative complications"; "postoperative care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301121541">
	<b:glossaryEntry>capable of being treated by surgical operation; "an operable cancer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301121664">
	<b:glossaryEntry>not suitable for surgery; "metastasis has rendered the tumor inoperable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301121793"
	 b:glossaryEntry="causing fever"/>
<rdf:Description rdf:about="&a;301121860"
	 b:glossaryEntry="preventing or alleviating fever"/>
<rdf:Description rdf:about="&a;301121949">
	<b:glossaryEntry>having or indicating good health in body or mind; free from infirmity or disease; "a rosy healthy baby"; "staying fit and healthy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301122421"
	 b:glossaryEntry="having the pinkish flush of health"/>
<rdf:Description rdf:about="&a;301122557"
	 b:glossaryEntry='vigorously healthy; "a bouncing baby"'/>
<rdf:Description rdf:about="&a;301122649">
	<b:glossaryEntry>marked by the tone and resiliency of healthy tissue; "firm muscles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301122767">
	<b:glossaryEntry>having or showing vigorous vegetal or animal life; "flourishing crops"; "flourishing chicks"; "a growing boy"; "fast-growing weeds"; "a thriving deer population"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301123007">
	<b:glossaryEntry>in excellent physical condition; "good teeth"; "I still have one good leg"; "a sound mind in a sound body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301123172">
	<b:glossaryEntry>exhibiting or restored to vigorous good health; "hale and hearty"; "whole in mind and body"; "a whole person again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301123346">
	<b:glossaryEntry>consuming abundantly and with gusto; "a hearty (or healthy) appetite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301123468">
	<b:glossaryEntry>endowed with or exhibiting great bodily or mental health; "a hearty glow of health"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301123641">
	<b:glossaryEntry xml:space='preserve'><![CDATA[inclined to a healthy reddish color often associated with outdoor life; "a ruddy complexion"; "Santa''s rubicund cheeks"; "a fresh and sanguine complexion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301123869"
	 b:glossaryEntry="used of older persons who are healthy"/>
<rdf:Description rdf:about="&a;301123967">
	<b:glossaryEntry>sound or exhibiting soundness in body or mind; "exercise develops wholesome appetites"; "a grin on his ugly wholesome face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301124146">
	<b:glossaryEntry>not in or exhibiting good health in body or mind; "unhealthy ulcers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301124936"
	 b:glossaryEntry='severely inflamed and painful; "an angry sore"'/>
<rdf:Description rdf:about="&a;301125034"
	 b:glossaryEntry='of or pertaining to arthritis; "my creaky old joints"'/>
<rdf:Description rdf:about="&a;301125177"
	 b:glossaryEntry="relating to breathing with a whistling sound"/>
<rdf:Description rdf:about="&a;301125297">
	<b:glossaryEntry>physically unsound or diseased; "has a bad back"; "a bad heart"; "bad teeth"; "an unsound limb"; "unsound teeth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301125477"
	 b:glossaryEntry="covered with small blisters"/>
<rdf:Description rdf:about="&a;301125568">
	<b:glossaryEntry>abnormally distended especially by fluids or gas; "hungry children with bloated stomachs"; "he had a grossly distended stomach"; "eyes with puffed (or puffy) lids"; "swollen hands"; "tumescent tissue"; "puffy tumid flesh"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301125902">
	<b:glossaryEntry>reddened as a result of locally congested blood vessels; inflamed; "bloodshot eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301126041"
	 b:glossaryEntry="having an ulcer or canker"/>
<rdf:Description rdf:about="&a;301126145"
	 b:glossaryEntry="afflicted with or resembling a carbuncle"/>
<rdf:Description rdf:about="&a;301126256"
	 b:glossaryEntry="(of teeth) affected with cavities or decay"/>
<rdf:Description rdf:about="&a;301126352"
	 b:glossaryEntry="of damaged or necrotic tissue; cheeselike"/>
<rdf:Description rdf:about="&a;301126447"
	 b:glossaryEntry='having chilblains; "her poor chilblained hands"'/>
<rdf:Description rdf:about="&a;301126552"
	 b:glossaryEntry="suffering from excessive gas in the alimentary canal"/>
<rdf:Description rdf:about="&a;301126678">
	<b:glossaryEntry xml:space='preserve'><![CDATA[weak and feeble; "I''m feeling seedy today"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301126807">
	<b:glossaryEntry>suffering from excessive loss of water from the body; "fever resulted from becoming dehydrated"; "was dehydrated after the marathon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301126996">
	<b:glossaryEntry>caused by or altered by or manifesting disease or pathology; "diseased tonsils"; "a morbid growth"; "pathologic tissue"; "pathological bodily processes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301127240"
	 b:glossaryEntry="swollen with an excessive accumulation of fluid"/>
<rdf:Description rdf:about="&a;301127355"
	 b:glossaryEntry='larger than normal; "enlarged joints"'/>
<rdf:Description rdf:about="&a;301127447">
	<b:glossaryEntry xml:space='preserve'><![CDATA[producing or covered with lathery sweat or saliva from exhaustion or disease; "the rabid animal''s frothing mouth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301127633"
	 b:glossaryEntry="suffering from tissue death"/>
<rdf:Description rdf:about="&a;301127729">
	<b:glossaryEntry>resulting from inflammation; hot and swollen and reddened; "eyes inflamed with crying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301127870">
	<b:glossaryEntry>characterized or caused by inflammation; "an inflammatory process"; "an inflammatory response"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301128023"
	 b:glossaryEntry='growing abnormally into the flesh; "an ingrown toenail"'/>
<rdf:Description rdf:about="&a;301128144"
	 b:glossaryEntry="affected by jaundice which causes yellowing of skin etc"/>
<rdf:Description rdf:about="&a;301128264">
	<b:glossaryEntry>characterized by formation of a membrane (or something resembling a membrane); "membranous gastritis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301128441">
	<b:glossaryEntry>affected by a disorder of the mind; "a mental patient"; "mental illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301128566">
	<b:glossaryEntry>inflamed and painful; "his throat was raw"; "had a sore throat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301128686"
	 b:glossaryEntry="unhealthy looking"/>
<rdf:Description rdf:about="&a;301128765"
	 b:glossaryEntry="having sore eyes; suffering from pinkeye or conjunctivitis"/>
<rdf:Description rdf:about="&a;301128879"
	 b:glossaryEntry="suffering from overexposure to direct sunlight"/>
<rdf:Description rdf:about="&a;301128992"
	 b:glossaryEntry='abnormally swollen or knotty; "varicose veins"'/>
<rdf:Description rdf:about="&a;301129093">
	<b:glossaryEntry>without a mucous or watery discharge; "a dry cough"; "that rare thing in the wintertime; a small child with a dry nose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301129262"
	 b:glossaryEntry='characterized by phlegm; "a phlegmy discharge"'/>
<rdf:Description rdf:about="&a;301129380"
	 b:glossaryEntry='freely producing mucus; "a loose phlegmy cough"'/>
<rdf:Description rdf:about="&a;301129479"
	 b:glossaryEntry="of or belonging to heaven or god"/>
<rdf:Description rdf:about="&a;301129746"
	 b:glossaryEntry="worthy of the gods"/>
<rdf:Description rdf:about="&a;301129832">
	<b:glossaryEntry>of heaven or the spirit; "celestial peace"; "ethereal melodies"; "the supernal happiness of a quiet death"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301130016">
	<b:glossaryEntry>emanating from God; "divine judgment"; "divine guidance"; "everything is black1 or white...satanic or godlyt"-Saturday Rev.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301130200">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being or having the nature of a god; "the custom of killing the divine king upon any serious failure of his...powers"-J.G.Frazier; "the divine will"; "the divine capacity for love"; "''Tis wise to learn; ''tis God-like to create"-J.G.Saxe]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301130499">
	<b:glossaryEntry>relating to or befitting paradise; "together in that paradisal place"; "paradisiacal innocense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301130706"
	 b:glossaryEntry='resulting from divine providence; "providential care"'/>
<rdf:Description rdf:about="&a;301130827"
	 b:glossaryEntry='unworldly or ethereal; "high translunary dreams"'/>
<rdf:Description rdf:about="&a;301130973">
	<b:glossaryEntry>of or belonging to or characteristic of this earth as distinguished from heaven; "earthly beings"; "believed that our earthly life is all that matters"; "earthly love"; "our earthly home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301131376">
	<b:glossaryEntry>connected with earthly life; of earthly origin; "earthborn cares and pleasures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301131511"
	 b:glossaryEntry="confined to the earth"/>
<rdf:Description rdf:about="&a;301131589">
	<b:glossaryEntry>resembling or characteristic of earth; "earthlike atmosphere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301131706">
	<b:glossaryEntry>belonging to this earth or world; not ideal or heavenly; "not a fairy palace; yet a mundane wonder of unimagined kind"; "so terrene a being as himself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301131921">
	<b:glossaryEntry>of this earth; "transcendental motives for sublunary actions"; "fleeting sublunary pleasures"; "the nearest to an angelic being that treads this terrestrial ball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301132164">
	<b:glossaryEntry>of this earth or world; "temporal joys"; "our temporal existence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301132284">
	<b:glossaryEntry>capable of being converted into assimilable condition in the alimentary canal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301132508"
	 b:glossaryEntry="able to be absorbed and incorporated into body tissues"/>
<rdf:Description rdf:about="&a;301132620">
	<b:glossaryEntry>capable of undergoing digestion; "a supply of easily digested foods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301132743">
	<b:glossaryEntry>easily assimilated in the alimentary canal; not rich or heavily seasoned; "a light diet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301132883">
	<b:glossaryEntry>artificially partially digested as by enzymatic action; "predigested foods are a boon for those who are ill or have impaired digestion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301133076"
	 b:glossaryEntry="digested with difficulty"/>
<rdf:Description rdf:about="&a;301133249"
	 b:glossaryEntry="generating excessive gas in the alimentary canal"/>
<rdf:Description rdf:about="&a;301133353">
	<b:glossaryEntry>dense or inadequately leavened and hence likely to cause distress in the alimentary canal; "a heavy pudding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301133513"
	 b:glossaryEntry="not digestible"/>
<rdf:Description rdf:about="&a;301133587"
	 b:glossaryEntry='not digested; "undigested food"'/>
<rdf:Description rdf:about="&a;301133675">
	<b:glossaryEntry>having a head or anything that serves as a head; often used in combination; "headed bolts"; "three-headed Cerberus"; "a cool-headed fighter pilot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301133910">
	<b:glossaryEntry>having a head of straight hair cut very short (hence bristly)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301134029"
	 b:glossaryEntry="having a protuberance that resembles a head"/>
<rdf:Description rdf:about="&a;301134127">
	<b:glossaryEntry>not having a head or formed without a head ; "the headless horseman"; "brads are headless nails"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301134314">
	<b:glossaryEntry>(biology) lacking a head or a clearly defined head; "acephalous worms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301134441"
	 b:glossaryEntry='having had the head cut off; "the beheaded prisoners"'/>
<rdf:Description rdf:about="&a;301134563">
	<b:glossaryEntry>having a heading or caption; "a headed column"; "headed notepaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301134682"
	 b:glossaryEntry='not having a heading or caption; "unheaded sections"'/>
<rdf:Description rdf:about="&a;301134789">
	<b:glossaryEntry>(used in combination) having cheeks as specified; "hollow-cheeked"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301134909"
	 b:glossaryEntry="having no cheek"/>
<rdf:Description rdf:about="&a;301134980">
	<b:glossaryEntry>of comparatively great physical weight or density; "a heavy load"; "lead is a heavy metal"; "heavy mahogony furniture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301135312">
	<b:glossaryEntry>having high relative density or specific gravity; "dense as lead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301135429">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having the consistency of dough because of insufficient leavening or improper cooking; "the cake fell; it''s a doughy mess"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301135612">
	<b:glossaryEntry>heaviest in a category or of a heavyweight category (175+ lbs for boxers); "a heavyweight boxer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301135766"
	 b:glossaryEntry='of considerable weight and size; "a hefty dictionary"'/>
<rdf:Description rdf:about="&a;301135871">
	<b:glossaryEntry>consisting of great mass; containing a great quantity of matter; "Earth is the most massive of the terrestrial planets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301136044">
	<b:glossaryEntry>of middle weight or of a middleweight category (147-160 lbs for boxers); "a middleweight boxer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301136198">
	<b:glossaryEntry>having great mass and weight and unwieldiness; "a ponderous stone"; "a ponderous burden"; "ponderous weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301136363">
	<b:glossaryEntry>of a weight class of 135-147 lbs for boxers; "the welterweight championship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301136498">
	<b:glossaryEntry>of comparatively little physical weight or density; "a light load"; "magnesium is a light metal--having a specific gravity of 1.74 at 20 degrees C"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301136895">
	<b:glossaryEntry>having little or no perceptible weight; so light as to resemble air; "airy gauze curtains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301137036"
	 b:glossaryEntry="of a weight class of 112-118 lbs for boxers"/>
<rdf:Description rdf:about="&a;301137138">
	<b:glossaryEntry>tending to float on a liquid or rise in air or gas; "buoyant balloons"; "buoyant balsawood boats"; "a floaty scarf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301137316">
	<b:glossaryEntry>of pastry; having a light delicate texture achieved by whipping or adding whipped egg whites; "lemon chiffon pie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301137483"
	 b:glossaryEntry='suggestive of feathers in lightness; "feathery snowflakes"'/>
<rdf:Description rdf:about="&a;301137610">
	<b:glossaryEntry>of a weight class of 118-126 lbs for boxers; "the featherweight class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301137740">
	<b:glossaryEntry>of a weight class of less than 112 lbs for boxers; "a flyweight bout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301137865"
	 b:glossaryEntry='having relatively little weight; "lightweight fabrics"'/>
<rdf:Description rdf:about="&a;301137977">
	<b:glossaryEntry>of a weight class of 126-135 lbs for boxers; "the lightweight title"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301138103"
	 b:glossaryEntry="having low relative density or specific gravity"/>
<rdf:Description rdf:about="&a;301138211">
	<b:glossaryEntry>having relatively great weight; heavy; "a weighty load"; "a weighty package"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301138341">
	<b:glossaryEntry>having little or no weight or apparent gravitational pull; light; "floating freely in a weightless condition"; "a baby bat...fluffy and weightless as a moth"; "jackets made of a weightless polyester fabric"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301138604"
	 b:glossaryEntry='not designed for heavy work; "a light-duty detergent"'/>
<rdf:Description rdf:about="&a;301138732">
	<b:glossaryEntry>designed for ease of movement or to carry little weight; "light aircraft"; "a light truck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301138874">
	<b:glossaryEntry>designed for heavy work; "a heavy-duty detergent"; "heavy-duty gloves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301139037">
	<b:glossaryEntry>large and powerful; especially designed for heavy loads or rough work; "a heavy truck"; "heavy machinery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301139194"
	 b:glossaryEntry='used in industry; "industrial-weight carpeting"'/>
<rdf:Description rdf:about="&a;301139298">
	<b:glossaryEntry>marked by great psychological weight; weighted down especially with sadness or troubles or weariness; "a heavy heart"; "a heavy schedule"; "heavy news"; "a heavy silence"; "heavy eyelids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301139627">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not easily borne; wearing; "the burdensome task of preparing the income tax return"; "my duties weren''t onerous; I only had to greet the guests"; "a taxing schedule"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301139868">
	<b:glossaryEntry>causing distress or worry or anxiety; "distressing (or disturbing) news"; "lived in heroic if something distressful isolation"; "a disturbing amount of crime"; "a revelation that was most perturbing"; "a new and troubling thought"; "in a particularly worrisome predicament"; "a worrying situation"; "a worrying time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301140317">
	<b:glossaryEntry>made heavy or weighted down with weariness; "his leaden arms"; "weighted eyelids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301140462">
	<b:glossaryEntry>weighing heavily on the senses or spirit; "the atmosphere was oppressive"; "oppressive sorrows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301140614">
	<b:glossaryEntry>weighing heavily on the spirit; causing anxiety or worry; "weighty problems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301140744">
	<b:glossaryEntry>psychologically light; especially free from sadness or troubles; "a light heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301140894">
	<b:glossaryEntry>characterized by a feeling of irresponsibility; "a broken back is nothing to be casual about; it is no fooling matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301141075">
	<b:glossaryEntry>unusually great in degree or quantity or number; "heavy taxes"; "a heavy fine"; "heavy casualties"; "heavy losses"; "heavy rain"; "heavy traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301141308"
	 b:glossaryEntry='severe; "a harsh penalty"'/>
<rdf:Description rdf:about="&a;301141385"
	 b:glossaryEntry='abundant; "a thick head of hair"'/>
<rdf:Description rdf:about="&a;301141469">
	<b:glossaryEntry>not great in degree or quantity or number; "a light sentence"; "a light accent"; "casualties were light"; "light snow was falling"; "light misty rain"; "light smoke from the chimney"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301141721"
	 b:glossaryEntry='not harsh; causing little distress; "an easy penalty"'/>
<rdf:Description rdf:about="&a;301141825">
	<b:glossaryEntry>(physics, chemistry) being or containing an isotope with greater than average atomic mass or weight; "heavy hydrogen"; "heavy water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301142009">
	<b:glossaryEntry>(physics, chemistry) not having atomic weight greater than average; "light water is ordinary water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301142160">
	<b:glossaryEntry>of great intensity or power or force; "a heavy blow"; "the fighting was heavy"; "heavy seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301142322"
	 b:glossaryEntry='marked by intense physical force; "a big wind"; "high winds"'/>
<rdf:Description rdf:about="&a;301142439">
	<b:glossaryEntry>of little intensity or power or force; "the light touch of her fingers"; "a light breeze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301142598">
	<b:glossaryEntry>having little impact; "an easy pat on the shoulder"; "gentle rain"; "a gentle breeze"; "a soft (or light) tapping at the window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301142793">
	<b:glossaryEntry>(of movement) having a light and springy step; "a light-footed girl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301142938">
	<b:glossaryEntry>moving easily and quickly; nimble; "the dancer was light and graceful"; "a lightsome buoyant step"; "walked with a light tripping step"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301143148">
	<b:glossaryEntry>(of movement) lacking ease or lightness; "his tired heavy-footed walk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301143295">
	<b:glossaryEntry>slow and laborious because of weight; "the heavy tread of tired troops"; "moved with a lumbering sag-bellied trot"; "ponderous prehistoric beasts"; "a ponderous yawn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301143537">
	<b:glossaryEntry>of the military or industry; using (or being) relatively small or light arms or equipment; "light infantry"; "light cavalry"; "light industry"; "light weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301143766"
	 b:glossaryEntry="armed with light weapons"/>
<rdf:Description rdf:about="&a;301143864">
	<b:glossaryEntry>of the military or industry; using (or being) the heaviest and most powerful armaments or weapons or equipment; "heavy artillery"; "heavy infantry"; "a heavy cruiser"; "heavy guns"; "heavy industry involves large-scale production of basic products (such as steel) used by other industries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301144205">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by or paying little heed or attention; "We have always known that heedless self-interest was bad morals; we know now that it is bad economics"- "Franklin D. Roosevelt; "heedless of danger"; "heedless of the child''s crying"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301144569">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `of'') without due thought or consideration; "careless of the consequences"; "the proverbial grasshopper--thoughtless of tomorrow"; "crushing the blooms with regardless tread"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301144852">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') unwilling or refusing to pay heed; "deaf to her warnings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301145007">
	<b:glossaryEntry>taking heed; giving close and thoughtful attention; "heedful of the warnings"; "so heedful a writer"; "heedful of what they were doing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301145239">
	<b:glossaryEntry>providing legal power or sanction; "an enabling resolution"; "enabling power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301145408">
	<b:glossaryEntry>granting a privilege or permission or power to do or not do something; "a facultative enactment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301145562">
	<b:glossaryEntry xml:space='preserve'><![CDATA[implying sanction or serving to sanction; "the guardian''s duties were primarily sanctionative rather than administrative"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301145757">
	<b:glossaryEntry>depriving of legal right; rendering legally disqualified; "certain disabling restrictions disqualified him for citizenship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301145952"
	 b:glossaryEntry="providing assistance or serving a useful function"/>
<rdf:Description rdf:about="&a;301146379">
	<b:glossaryEntry>obliging; willing to do favors; "made a special effort to be accommodating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301146514">
	<b:glossaryEntry>(pharmacology) enhancing the action of a medical treatment; "the adjuvant action of certain bacteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301146670"
	 b:glossaryEntry="giving assistance"/>
<rdf:Description rdf:about="&a;301146743"
	 b:glossaryEntry='maintaining dignity or prestige; "a face-saving compromise"'/>
<rdf:Description rdf:about="&a;301146860">
	<b:glossaryEntry>freeing from difficulty or impediment; "facilitative changes in the economic structure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301147006"
	 b:glossaryEntry="inducing or aiding in facilitating neural activity"/>
<rdf:Description rdf:about="&a;301147115">
	<b:glossaryEntry>serving or acting as a means or aid; "instrumental in solving the crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301147260">
	<b:glossaryEntry>helpful to other people; "helping an old lady with her bundles was his kind deed for the day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301147404">
	<b:glossaryEntry>designed to replace or conserve human and especially manual labor; "laborsaving devices like washing machines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301147587">
	<b:glossaryEntry>serving attendance on someone; "a ministering angel"; "the angels ministrant sang"; "the attending physician"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301147779">
	<b:glossaryEntry>tending to reform; "reformative and rehabilitative agencies"; "reformatory punishment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301147937"
	 b:glossaryEntry='most helpful and reliable; "my right-hand man"'/>
<rdf:Description rdf:about="&a;301148040">
	<b:glossaryEntry>causing to become stable; "the family is one of the great stabilizing elements in society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301148188">
	<b:glossaryEntry>causing to become steady; "had a steadying effect on her nerves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301148308"
	 b:glossaryEntry="providing no assistance"/>
<rdf:Description rdf:about="&a;301148477">
	<b:glossaryEntry>offering no assistance; "rudely unaccommodating to the customers"; "icily neutral, disagreeably unhelpful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301148645"
	 b:glossaryEntry="not constructive"/>
<rdf:Description rdf:about="&a;301148722"
	 b:glossaryEntry='not useful; "a curiously unhelpful and useless manual"'/>
<rdf:Description rdf:about="&a;301148830">
	<b:glossaryEntry>(of bird feet) having the first and second toes directed backward the third and fourth forward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301148983">
	<b:glossaryEntry>(of bird feet) having the first and fourth toes directed backward the second and third forward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301149134">
	<b:glossaryEntry>consisting of elements that are not of the same kind or nature; "the population of the United States is vast and heterogeneous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301149429">
	<b:glossaryEntry>consisting of a haphazard assortment of different kinds (even to the point of incongruity); "an arrangement of assorted spring flowers"; "assorted sizes"; "miscellaneous accessories"; "a mixed program of baroque and contemporary music"; "a motley crew"; "sundry sciences commonly known as social"- I.A.Richards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301149839">
	<b:glossaryEntry>including markedly dissimilar elements; "a disparate aggregate of creeds and songs and prayers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301149990"
	 b:glossaryEntry="not homogeneous"/>
<rdf:Description rdf:about="&a;301150078">
	<b:glossaryEntry>of the same or similar kind or nature; "a tight-knit homogeneous society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301150299">
	<b:glossaryEntry>the same throughout in structure or composition; "bituminous coal is often treated as a consistent and homogeneous product"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301150489">
	<b:glossaryEntry>of one substance or character throughout; "solid gold"; "a solid color"; "carved out of solid rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301150640"
	 b:glossaryEntry="made homogeneous"/>
<rdf:Description rdf:about="&a;301150714">
	<b:glossaryEntry>(genetics) having identical alleles at corresponding chromosomal loci; "these two fruit flies are homozygous for red eye color"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301150898">
	<b:glossaryEntry>(genetics) having dissimilar alleles at corresponding chromosomal loci; "heterozygous for eye color"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301151057"
	 b:glossaryEntry="sexually attracted to members of the opposite sex"/>
<rdf:Description rdf:about="&a;301151219"
	 b:glossaryEntry="(informal) not homosexual"/>
<rdf:Description rdf:about="&a;301151299"
	 b:glossaryEntry="sexually attracted to members of your own sex"/>
<rdf:Description rdf:about="&a;301151581"
	 b:glossaryEntry="pejorative synonym for lesbian"/>
<rdf:Description rdf:about="&a;301151663"
	 b:glossaryEntry="homosexual or arousing homosexual desires"/>
<rdf:Description rdf:about="&a;301151777"
	 b:glossaryEntry="of or concerning homosexual love"/>
<rdf:Description rdf:about="&a;301151866"
	 b:glossaryEntry="of female homosexuality"/>
<rdf:Description rdf:about="&a;301151953"
	 b:glossaryEntry="of homosexuality between a man and a boy"/>
<rdf:Description rdf:about="&a;301152064">
	<b:glossaryEntry>overwhelmingly desirous of being, or completely identifying with, the opposite sex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301152207">
	<b:glossaryEntry>receiving sexual gratification from wearing clothing of the opposite sex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301152355">
	<b:glossaryEntry>of female homosexual behavior that atempts to simulate heterosexual behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301152489"
	 b:glossaryEntry="sexually attracted to both sexes"/>
<rdf:Description rdf:about="&a;301152594">
	<b:glossaryEntry>classified according to various criteria into successive levels or layers; "it has been said that only a hierarchical society with a leisure class at the top can produce works of art"; "in her hierarchical set of values honesty comes first"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301152973">
	<b:glossaryEntry>(used of society) "American society is becoming increasingly stratified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301153120"
	 b:glossaryEntry="capable of being graded (for quality or rank or size etc.)"/>
<rdf:Description rdf:about="&a;301153233">
	<b:glossaryEntry>arranged in a sequence of grades or ranks; "stratified areas of the distribution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301153389"
	 b:glossaryEntry="not classified hierarchically"/>
<rdf:Description rdf:about="&a;301153514"
	 b:glossaryEntry="not arranged in order hierarchically"/>
<rdf:Description rdf:about="&a;301153628">
	<b:glossaryEntry>(literal meanings) being at or having a relatively great or specific elevation or upward extension; "a high mountain"; "high ceilings"; "high buildings"; "a high forehead"; "a high incline"; "a foot high"; sometimes used in combination; "knee-high grass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301154149"
	 b:glossaryEntry="indefinitely high; lofty"/>
<rdf:Description rdf:about="&a;301154232">
	<b:glossaryEntry>used of a height or viewpoint; "a commanding view of the ocean"; "looked up at the castle dominating the countryside"; "the balcony overlooking the ballroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301154473">
	<b:glossaryEntry>of imposing height; especially standing out above others; "an eminent peak"; "lofty mountains"; "the soaring spires of the cathedral"; "towering iceburgs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301154710">
	<b:glossaryEntry>occurring at or from a relative high altitude; "high-level bombing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301154834">
	<b:glossaryEntry>having or moving with a high step; "his high-stepped stride"; "a high-stepping horse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301154994"
	 b:glossaryEntry="(of shoes or boots) having relatively high uppers"/>
<rdf:Description rdf:about="&a;301155112">
	<b:glossaryEntry>of a slope; set at a high angle; "note the steep incline"; "a steep roof sheds snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301155248">
	<b:glossaryEntry>higher in place or position; "the upper bunk"; "in the upper center of the picture"; "the upper stories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301155404">
	<b:glossaryEntry>literal meanings; being at or having a relatively small elevation or upward extension; "low ceilings"; "low clouds"; "low hills"; "the sun is low"; "low furniture"; "a low bow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301155792"
	 b:glossaryEntry='with head or back bent low; "a deep bow"'/>
<rdf:Description rdf:about="&a;301155883">
	<b:glossaryEntry>occurring at a relatively low altitude; "a low-level strafing run"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301156005">
	<b:glossaryEntry>having a small elevation above the ground or horizon or sea level; "low-lying clouds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301156146">
	<b:glossaryEntry>located below or beneath something else; "nether garments"; "the under parts of a machine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301156297"
	 b:glossaryEntry="having a low center of gravity; built low to the ground"/>
<rdf:Description rdf:about="&a;301156417">
	<b:glossaryEntry>above the surround or above the normal position; "a raised design"; "raised eyebrows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301156609"
	 b:glossaryEntry='raised above the ground; "an elevated platform"'/>
<rdf:Description rdf:about="&a;301156711"
	 b:glossaryEntry='open; "the windows are up"'/>
<rdf:Description rdf:about="&a;301156786">
	<b:glossaryEntry>held up in the air; "stood with arms upraised"; "her upraised flag"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301156917">
	<b:glossaryEntry>below the surround or below the normal position; "with lowered eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301157057"
	 b:glossaryEntry='shut; "the shades were down"'/>
<rdf:Description rdf:about="&a;301157136">
	<b:glossaryEntry>resembling or making use of highly advanced technology or devices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301157285">
	<b:glossaryEntry>ahead in development; complex or intricate; "advanced technology"; "a sophisticated electronic control system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301157466"
	 b:glossaryEntry="not involving high technology"/>
<rdf:Description rdf:about="&a;301157550">
	<b:glossaryEntry>having a neck or having a neck especially as specified (often used in combination; "red-necked")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301157807"
	 b:glossaryEntry='(of a garment) having a low-cut neckline; "a low neckline"'/>
<rdf:Description rdf:about="&a;301157944">
	<b:glossaryEntry>(of a garment) having a high neckline; "a high-necked blouse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301158063"
	 b:glossaryEntry="resembling a neck"/>
<rdf:Description rdf:about="&a;301158135"
	 b:glossaryEntry="having a close-fitting neckband or collar"/>
<rdf:Description rdf:about="&a;301158232">
	<b:glossaryEntry>(combining form) having a throat as specified; "deep-throated"; "white-throated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301158367"
	 b:glossaryEntry="having a high tubular collar fitting closely around the neck"/>
<rdf:Description rdf:about="&a;301158499"
	 b:glossaryEntry="lacking or apparently lacking a neck"/>
<rdf:Description rdf:about="&a;301158590">
	<b:glossaryEntry>provided with a ceiling especially the overhead interior surface; "the large beam-ceilinged living room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301158804"
	 b:glossaryEntry="having a higher than normal ceiling"/>
<rdf:Description rdf:about="&a;301158900"
	 b:glossaryEntry="having a lower than normal ceiling"/>
<rdf:Description rdf:about="&a;301158994">
	<b:glossaryEntry>having the rafters especially having them visible; "a raftered ceiling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301159120"
	 b:glossaryEntry="provided with a floor"/>
<rdf:Description rdf:about="&a;301159195"
	 b:glossaryEntry="used of e.g. detergents"/>
<rdf:Description rdf:about="&a;301159276"
	 b:glossaryEntry="used of e.g. detergents"/>
<rdf:Description rdf:about="&a;301159358">
	<b:glossaryEntry>greater than normal in degree or intensity or amount; "a high temperature"; "a high price"; "the high point of his career"; "high risks"; "has high hopes"; "high winds"; "the river is high"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301159832">
	<b:glossaryEntry>at a higher level in training or knowledge or skill; "an advanced degree"; "an advanced text in physics"; "special seminars for small groups of advanced students at the University"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301160067">
	<b:glossaryEntry>being at a peak or culminating point; "broad day"; "full summer"; "high noon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301160209"
	 b:glossaryEntry='consisting of or causing a climax; "a peak experience"'/>
<rdf:Description rdf:about="&a;301160343"
	 b:glossaryEntry='high or exalted in style or character; "high drama"'/>
<rdf:Description rdf:about="&a;301160448"
	 b:glossaryEntry='overfull with water; "swollen rivers and creeks"'/>
<rdf:Description rdf:about="&a;301160589">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of or relating to studies beyond a bachelor''s degree; "graduate courses"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301160734"
	 b:glossaryEntry='more than usual; "great expectations"; "great worry"'/>
<rdf:Description rdf:about="&a;301160838">
	<b:glossaryEntry>of education beyond the secondary level; "higher education"; "higher learning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301160972">
	<b:glossaryEntry>advanced in complexity or elaboration; "high finance"; "higher mathematics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301161103">
	<b:glossaryEntry>highest in extent or degree; "to the last measure of human endurance"; "whether they were accomplices in the last degree or a lesser one was...to be determined individually"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301161336">
	<b:glossaryEntry>ascending to a level markedly higher than the usual; "soaring prices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301161459">
	<b:glossaryEntry>less than normal in degree or intensity or amount; "low prices"; "the reservoire is low"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301161723"
	 b:glossaryEntry='lowered in value; "the dollar is low"; "a debased currency"'/>
<rdf:Description rdf:about="&a;301161858">
	<b:glossaryEntry>lower than previously; "the market is depressed"; "prices are down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301161991"
	 b:glossaryEntry='not intense; "low-level radiation"'/>
<rdf:Description rdf:about="&a;301162081"
	 b:glossaryEntry="well below normal (especially in price)"/>
<rdf:Description rdf:about="&a;301162188"
	 b:glossaryEntry='low in degree; "expectations were poor"'/>
<rdf:Description rdf:about="&a;301162278"
	 b:glossaryEntry="used of sounds and voices; high in pitch or frequency"/>
<rdf:Description rdf:about="&a;301162667">
	<b:glossaryEntry>sounding as if the nose were pinched; "a whining nasal voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301162802"
	 b:glossaryEntry="very high"/>
<rdf:Description rdf:about="&a;301162867">
	<b:glossaryEntry>(of a musical instrument) second highest member of a group; "alto clarinet or recorder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163005">
	<b:glossaryEntry>of or being the highest male voice; having a range above that of tenor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163141">
	<b:glossaryEntry>artificially high; above the normal voice range; "a falsetto voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163263">
	<b:glossaryEntry>having or as if having especially high-pitched spots; "absence of peaky highs and beefed-up bass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163419">
	<b:glossaryEntry>resembling the music of a pipe; "the piping voices of children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163535">
	<b:glossaryEntry>high-pitched and sharp; "piercing screams"; "a shrill whistle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163669">
	<b:glossaryEntry>having or making a high-pitched sound such as that made by a mouse or a rusty hinge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163851">
	<b:glossaryEntry>continuous and piercing; "clashing swords and shrilling trumpets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301163975">
	<b:glossaryEntry>having or denoting a high range; "soprano voice"; "soprano sax"; "the boy still had a fine treble voice"; "the treble clef"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301164161"
	 b:glossaryEntry='higher in range than soprano; "a sopranino recorder"'/>
<rdf:Description rdf:about="&a;301164269">
	<b:glossaryEntry>of or close in range to the highest natural adult male voice; "tenor voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301164396">
	<b:glossaryEntry>(of a musical instrument) intermediate between alto and baritone or bass; "a tenor sax"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301164535"
	 b:glossaryEntry="used of sounds and voices; low in pitch or frequency"/>
<rdf:Description rdf:about="&a;301164759"
	 b:glossaryEntry="of or being the lowest female voice"/>
<rdf:Description rdf:about="&a;301164857">
	<b:glossaryEntry>lower in range than tenor and higher than bass; "a baritone voice"; "baritone oboe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301164995">
	<b:glossaryEntry>having or denoting a low vocal or instrumental range; "a deep voice"; "a bass voice is lower than a baritone voice"; "a bass clarinet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301165187">
	<b:glossaryEntry>pitched an octave below normal bass instrumental or vocal range; "contrabass or double-bass clarinet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301165359">
	<b:glossaryEntry>sounding as if pronounced low in the throat; "a rich throaty voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301165480">
	<b:glossaryEntry>marked by or given to imitation; "acting is an imitative art"; "man is an imitative being"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301165716"
	 b:glossaryEntry="being or given to servile imitation"/>
<rdf:Description rdf:about="&a;301165813">
	<b:glossaryEntry>exhibiting mimicry; "mimetic coloring of a butterfly"; "the mimetic tendency of infancy"- R.W.Hamilton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301165969">
	<b:glossaryEntry>constituting an imitation; "the mimic warfare of the opera stage"- Archibald Alison</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301166104">
	<b:glossaryEntry>mechanically imitated or repeated without thought or understanding; "a mere parrotlike word-calling process"; "a voice quality sounding parrotlike"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301166308">
	<b:glossaryEntry>reproduced or made to resemble; imitative in character; "under simulated combat conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301166455"
	 b:glossaryEntry="not marked by or given to imitation"/>
<rdf:Description rdf:about="&a;301166549">
	<b:glossaryEntry>(of words) formed in imitation of a natural sound; "onomatopoeic words are imitative of noises"; "it was independently developed in more than one place as an onomatopoetic term"- Harry Hoijer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301166853"
	 b:glossaryEntry="not echoic or imitative of sound"/>
<rdf:Description rdf:about="&a;301166941">
	<b:glossaryEntry>of especially computer output devices; producing images that are sharp and finely detailed; also "high-resolution photography"; "high-resolution lens" e.g.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301167158">
	<b:glossaryEntry>of computer output devices; producing images that are not sharply defined</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301167292">
	<b:glossaryEntry>used of buildings of many stories equipped with elevators; tall; "avenues lined with high-rise apartment buildings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301167499"
	 b:glossaryEntry="having more than one story"/>
<rdf:Description rdf:about="&a;301167611">
	<b:glossaryEntry>(combining form) having stories as indicated; "a six-storied building</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301167745">
	<b:glossaryEntry>used of buildings of one or only a few stories and usually no elevator; low; "looking out over the roofs of low-rise apartment buildings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301167955"
	 b:glossaryEntry='a building with no elevator; "a walk-up apartment"'/>
<rdf:Description rdf:about="&a;301168059"
	 b:glossaryEntry="used of high or hilly country"/>
<rdf:Description rdf:about="&a;301168227"
	 b:glossaryEntry="growing at high altitudes"/>
<rdf:Description rdf:about="&a;301168321">
	<b:glossaryEntry>(biology) living or growing above the timber line; "alpine flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301168441"
	 b:glossaryEntry='relating to or located in mountains; "mountain people"'/>
<rdf:Description rdf:about="&a;301168553"
	 b:glossaryEntry="containing many mountains"/>
<rdf:Description rdf:about="&a;301168636"
	 b:glossaryEntry="of relatively low or level country"/>
<rdf:Description rdf:about="&a;301168742"
	 b:glossaryEntry='lying below the normal level; "a low-lying desert"'/>
<rdf:Description rdf:about="&a;301168860"
	 b:glossaryEntry='(sport) used of your own ground; "a home game"'/>
<rdf:Description rdf:about="&a;301168960">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sport) used of an opponent''s ground; "an away game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301169063">
	<b:glossaryEntry>corresponding or similar in position or structure or function or characteristics; especially derived from an organism of the same species; "a homologous tissue graft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301169304">
	<b:glossaryEntry>derived from organisms of a different but related species; "a heterologous graft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301169462">
	<b:glossaryEntry>derived from organisms of the selfsame individual; "autologous blood donation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301169615">
	<b:glossaryEntry>(biology) having the same evolutionary origin but serving different functions; "the wing of a bat and the arm of a man are homologous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301169842"
	 b:glossaryEntry="(biology) similar in evolutionary origin but not in function"/>
<rdf:Description rdf:about="&a;301169972">
	<b:glossaryEntry>(biology) not corresponding in structure or evolutionary origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301170142">
	<b:glossaryEntry>(biology) corresponding in function but not in evolutionary origin; "the wings of a bee and those of a hummingbird are analogous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301170344">
	<b:glossaryEntry>(of a roof) constructed with a single slope on each side of the ridge supported at the end by a gable or vertical triangular portion of an end wall; "a gabled roof"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301170579">
	<b:glossaryEntry>(of a roof) having two slopes each side of the ridge; "a big barn with a gambrel roof"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301170719">
	<b:glossaryEntry>(of a roof) sloping on all sides; "a hipped roof has sloping ends rather than gables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301170875">
	<b:glossaryEntry>(of a roof) having two slopes on all sides with the lower slope steeper than the upper; "the story formed by a mansard roof is usually called the garret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301171082">
	<b:glossaryEntry>having hips; or having hips as specified (usually in combination); "broad-hipped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301171216"
	 b:glossaryEntry='having or seeming to have no hips; "slim and hipless"'/>
<rdf:Description rdf:about="&a;301171323">
	<b:glossaryEntry>not disposed to cheat or defraud; not deceptive or fraudulent; "honest lawyers"; "honest reporting"; "an honest wage"; "honest weight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301171702">
	<b:glossaryEntry>characterized by plain blunt honesty; "a downright answer"; "a downright kind of person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301171846">
	<b:glossaryEntry>sincere and free of reserve in expression; "Please be open with me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301171964">
	<b:glossaryEntry>characterized by honesty and fairness; "a square deal"; "wanted to do the square thing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301172115">
	<b:glossaryEntry>deceptive or fraudulent; disposed to cheat or defraud or deceive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301172484">
	<b:glossaryEntry>marked by deliberate deceptiveness especially by pretending one set of feelings and acting under the influence of another; "she was a deceitful scheming little thing"- Israel Zangwill; "a double-dealing double agent"; "a double-faced infernal traitor and schemer"- W.M.Thackeray</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301172922">
	<b:glossaryEntry>misleading by means of pleasant or alluring methods; "taken in by beguiling tales of overnight fortunes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301173082">
	<b:glossaryEntry>intended to deceive; "deceitful advertising"; "fallacious testimony"; "smooth, shining, and deceitful as thin ice"_ S.T.Coleridge; "a fraudulent scheme to escape paying taxes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301173339">
	<b:glossaryEntry>tending to deceive or mislead either deliberately or inadvertently; "the deceptive calm in the eye of the storm"; "deliberately deceptive packaging"; "a misleading similarity"; "statistics can be presented in ways that are misleading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301173642"
	 b:glossaryEntry='designed to deceive; "a suitcase with a false bottom"'/>
<rdf:Description rdf:about="&a;301173747">
	<b:glossaryEntry>involving clever rogues or adventurers especially as in a type of fiction; "picaresque novels"; "waifs of the picaresque tradition"; "a picaresque hero"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301173956">
	<b:glossaryEntry>lacking principles or scruples; "the rascally rabble"; "the tyranny of a scoundrelly aristocracy"_ W.M. Thackaray; "the captain was set adrift by his roguish crew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301174213"
	 b:glossaryEntry="given to thievery"/>
<rdf:Description rdf:about="&a;301174299">
	<b:glossaryEntry>expressing or given to expressing the truth; "a true statement"; "gave truthful testimony"; "a truthful person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301174508"
	 b:glossaryEntry='marked by truth; "gave honest answers"'/>
<rdf:Description rdf:about="&a;301174599">
	<b:glossaryEntry>habitually speaking the truth; "an honest man"; "a veracious witness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301174733">
	<b:glossaryEntry>not expressing or given to expressing the truth; "the statement given under oath was untruthful"; "an untruthful person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301174946"
	 b:glossaryEntry='lacking truthfulness; "a dishonest answer"'/>
<rdf:Description rdf:about="&a;301175044"
	 b:glossaryEntry='given to lying; "a lying witness"; "a mendacious child"'/>
<rdf:Description rdf:about="&a;301175167">
	<b:glossaryEntry>showing or characterized by honor and integrity; "an honorable man"; "led an honorable life"; "honorable service to his country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301175562"
	 b:glossaryEntry='profoundly honored; "revered holy men"'/>
<rdf:Description rdf:about="&a;301175675">
	<b:glossaryEntry xml:space='preserve'><![CDATA[worthy of the greatest honor or distinction; "The nation''s pediatrician laureate is preparing to lay down his black bag"- James Traub]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301175863">
	<b:glossaryEntry>having high moral qualities; "a noble spirit"; "a solid citizen"; "an upstanding man"; "a worthy successor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301176052">
	<b:glossaryEntry>honored because of age or long usage; "time-honored institutions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301176192">
	<b:glossaryEntry>lacking honor or integrity; deserving dishonor; "dishonorable in thought and deed"; "a dishonorable discharge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301176593">
	<b:glossaryEntry>(used of conduct or character) deserving or bringing disgrace or shame; "Man...has written one of his blackest records as a destroyer on the oceanic islands"- Rachel Carson; "an ignominious retreat"; "inglorious defeat"; "an opprobrious monument to human greed"; "a shameful display of cowardice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301177007"
	 b:glossaryEntry="used of conduct; characterized by dishonor"/>
<rdf:Description rdf:about="&a;301177116"
	 b:glossaryEntry='mean and unworthy and despicable; "shabby treatment"'/>
<rdf:Description rdf:about="&a;301177221"
	 b:glossaryEntry="having little or no integrity"/>
<rdf:Description rdf:about="&a;301177309">
	<b:glossaryEntry>cowardly or treacherous; "the little yellow stain of treason"-M.W.Straight; "too yellow to stand and fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301177469">
	<b:glossaryEntry>having or manifesting or inspiring hope; "a line of people hopeful of obtaining tickets"; "found a hopeful way of attacking the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301177731"
	 b:glossaryEntry='marked by eager anticipation; "an expectant hush"'/>
<rdf:Description rdf:about="&a;301177864"
	 b:glossaryEntry="seeking advancement or recognition"/>
<rdf:Description rdf:about="&a;301177991">
	<b:glossaryEntry>without hope because there seems to be no possibility of comfort or success; "in an agony of hopeless grief"; "with a hopeless sigh he sat down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301178424">
	<b:glossaryEntry>showing utter resignation or hopelessness; "abject surrender"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301178561">
	<b:glossaryEntry>offering little or no hope; "the future looked black"; "prospects were bleak"; "Life in the Aran Islands has always been bleak and difficult"- J.M.Synge; "took a dim view of things"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301178808">
	<b:glossaryEntry>arising from or marked by despair or loss of hope; "a despairing view of the world situation"; "the last despairing plea of the condemned criminal"; "a desperate cry for help"; "helpless and desperate--as if at the end of his tether"; "her desperate screams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301179135">
	<b:glossaryEntry>without or almost without hope; "despondent about his failure"; "too heartsick to fight back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301179297">
	<b:glossaryEntry>marked by or showing hopelessness; "the last forlorn attempt"; "a forlorn cause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301179431"
	 b:glossaryEntry="having no prospect or hope of a future"/>
<rdf:Description rdf:about="&a;301179526">
	<b:glossaryEntry>characterized by hopelessness; filled with gloom; "gloomy at the thought of what he had to face"; "gloomy predictions"; "a gloomy silence"; "took a grim view of the economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301179759"
	 b:glossaryEntry="unable to function; without help"/>
<rdf:Description rdf:about="&a;301179853"
	 b:glossaryEntry='without hope of cure; "incurable cancer"'/>
<rdf:Description rdf:about="&a;301179949"
	 b:glossaryEntry='without hope of solution; "an insoluble problem"'/>
<rdf:Description rdf:about="&a;301180053">
	<b:glossaryEntry>officially placed in or committed to a specialized institution"; "had hopes of rehabilitating the institutionalized juvenile delinquents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301180254"
	 b:glossaryEntry="not committed to an institution"/>
<rdf:Description rdf:about="&a;301180352">
	<b:glossaryEntry>organized as or forming an institution; "institutional religion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301180512">
	<b:glossaryEntry>given the character of an institution or incorporated into a structured and usually well-established system; "institutionalized graft"; "institutionalized suicide as practiced in Japan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301180761">
	<b:glossaryEntry>characteristic or suggestive of an institution especially in being uniform or dull or unimaginative; "institutional food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301180942"
	 b:glossaryEntry="not institutional"/>
<rdf:Description rdf:about="&a;301181022">
	<b:glossaryEntry>(chemistry) combining or causing to combine with iodine; "the active iodinating species"; "the in vivo iodinating mechanism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301181203"
	 b:glossaryEntry="(chemistry) removing iodine from"/>
<rdf:Description rdf:about="&a;301181295"
	 b:glossaryEntry="able to be consoled"/>
<rdf:Description rdf:about="&a;301181371">
	<b:glossaryEntry>sad beyond comforting; incapable of being consoled; "inconsolable when her son died"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301181562">
	<b:glossaryEntry>crushed by grief; "depressed and desolate of soul"; "a low desolate wail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301181690">
	<b:glossaryEntry>parallel to or in the plane of the horizon or a base line; "a horizontal surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301181936"
	 b:glossaryEntry="in the shape of (a horizontal piece on) a cross"/>
<rdf:Description rdf:about="&a;301182039"
	 b:glossaryEntry='parallel to the ground; "a flat roof"'/>
<rdf:Description rdf:about="&a;301182127">
	<b:glossaryEntry>being on a precise horizontal plane; "a billiard table must be level"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301182248"
	 b:glossaryEntry="(heraldry) applied to a fish depicted horizontally"/>
<rdf:Description rdf:about="&a;301182362">
	<b:glossaryEntry>at right angles to the plane of the horizon or a base line; "a vertical camera angle"; "the monument consists of two vertical pillars supporting a horizontal slab"; "measure the perpendicular height"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301182758"
	 b:glossaryEntry='exactly vertical; "the tower of Pisa is far out of plumb'/>
<rdf:Description rdf:about="&a;301182866"
	 b:glossaryEntry="turned up on end"/>
<rdf:Description rdf:about="&a;301182936"
	 b:glossaryEntry='in a vertical position; not sloping; "an upright post"'/>
<rdf:Description rdf:about="&a;301183055">
	<b:glossaryEntry>at an angle to the horizontal or vertical position; "an inclined plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301183415">
	<b:glossaryEntry>departing or being caused to depart from the true vertical or horizontal; "the leaning tower of Pisa"; "the headstones were tilted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301183635"
	 b:glossaryEntry="having an oblique or slanted direction"/>
<rdf:Description rdf:about="&a;301183786">
	<b:glossaryEntry>having the slant of a bevel; "a bevel edge"; "a cant buttress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301183917"
	 b:glossaryEntry='set at a sharp or high angle or slant; "a high-pitched roof"'/>
<rdf:Description rdf:about="&a;301184036"
	 b:glossaryEntry='set at a low angle or slant; "a low-pitched roof"'/>
<rdf:Description rdf:about="&a;301184143"
	 b:glossaryEntry='set at a slant; "a pitched rather than a flat roof"'/>
<rdf:Description rdf:about="&a;301184248">
	<b:glossaryEntry>(heraldry) represented as leaping (rampant but leaning forward)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301184369">
	<b:glossaryEntry>inclining or directed to one side; "moved downward in a sidelong way"_ Bram Stoker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301184506">
	<b:glossaryEntry>having an oblique or slanting direction or position; "the picture was skew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301184641">
	<b:glossaryEntry>upright in position or posture; "an erect stature"; "erect flower stalks"; "for a dog, an erect tail indicates aggression"; "a column still vertical amid the ruins"; "he sat bolt upright"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301185081">
	<b:glossaryEntry>capable of being raised to an upright position; "erectile feathers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301185203">
	<b:glossaryEntry>(botany) having clusters of erect branches (often appearing to form a single column)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301185344"
	 b:glossaryEntry="(heraldry) in walking position with right foreleg raised"/>
<rdf:Description rdf:about="&a;301185458">
	<b:glossaryEntry>(heraldry) rearing on left hind leg with forelegs elevated and head usually in profile; "a lion rampant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301185630"
	 b:glossaryEntry='having a supporting base; "a standing lamp"'/>
<rdf:Description rdf:about="&a;301185731">
	<b:glossaryEntry>requiring a standing position; "a stand-up bar"; "a stand-up comic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301185853"
	 b:glossaryEntry="(heraldry) standing on four feet"/>
<rdf:Description rdf:about="&a;301185943"
	 b:glossaryEntry='of posture; "a slim straight-backed dancer"'/>
<rdf:Description rdf:about="&a;301186048">
	<b:glossaryEntry>erect in posture; "behind him sat old man Arthur; he was straight with something angry in his attitude"; "stood defiantly with unbowed back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301186272"
	 b:glossaryEntry="not upright in position or posture"/>
<rdf:Description rdf:about="&a;301186648"
	 b:glossaryEntry="lying down; in a position of comfort or rest"/>
<rdf:Description rdf:about="&a;301186784">
	<b:glossaryEntry>used especially of the head or upper back; "a bent head and sloping shoulders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301186932">
	<b:glossaryEntry>used of the back and knees; stooped; "on bended knee"; "with bent (or bended) back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301187075">
	<b:glossaryEntry>(biology) having branches or flower heads that bend downward; "nodding daffodils"; "the pendulous branches of a weeping willow"; "lilacs with drooping panicles of fragrant flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301187343">
	<b:glossaryEntry>(heraldry) lying on the stomach with head raised with legs pointed forward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301187476">
	<b:glossaryEntry>squatting close to the ground; "poorly clothed men huddled low against the wind"; "he stayed in the ditch hunkered down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301187700"
	 b:glossaryEntry="(heraldry) lying with head on paws as if sleeping"/>
<rdf:Description rdf:about="&a;301187818">
	<b:glossaryEntry>stretched out and lying at full length along the ground; "found himself lying flat on the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301187977">
	<b:glossaryEntry>having the back and shoulders rounded; not erect; "a little oldish misshapen stooping woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301188188"
	 b:glossaryEntry="on your knees"/>
<rdf:Description rdf:about="&a;301188256"
	 b:glossaryEntry="resting against a support"/>
<rdf:Description rdf:about="&a;301188335"
	 b:glossaryEntry="lying in a relaxed manner"/>
<rdf:Description rdf:about="&a;301188425"
	 b:glossaryEntry="lying face downward"/>
<rdf:Description rdf:about="&a;301188508"
	 b:glossaryEntry="with shoulders drooping"/>
<rdf:Description rdf:about="&a;301188608"
	 b:glossaryEntry="lying face upward"/>
<rdf:Description rdf:about="&a;301188689">
	<b:glossaryEntry>(of persons) on the feet; having the torso in an erect position supported by straight legs; "standing room only"; "a standing ovation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301188878">
	<b:glossaryEntry>(of persons) having the torso erect and legs bent with the body supported on the buttocks; "the seated Madonna"; "the audience remained seated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301189084">
	<b:glossaryEntry>executed in or initiated from a standing position; "a standing ovation"; "race from a standing start"; "a standing jump"; "a standing ovation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301189284">
	<b:glossaryEntry>executed or initiated by running; "running plays worked better than pass plays"; "took a running jump"; "a running start"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301189480">
	<b:glossaryEntry>done swiftly in or as if in the air; used e.g. of a racing start in which runners are already in motion as they cross the starting line; "a flying start"; "crossed the goal line with a flying leap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301189730">
	<b:glossaryEntry>(of fluids) moving or issuing in a stream; "a mountain stream with freely running water"; "hovels without running water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301189961"
	 b:glossaryEntry='(of liquids) moving freely; "a flowing brook"'/>
<rdf:Description rdf:about="&a;301190072">
	<b:glossaryEntry>flowing profusely; "a gushing hydrant"; "pouring flood waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301190198"
	 b:glossaryEntry="propelled violently in a usually narrow stream"/>
<rdf:Description rdf:about="&a;301190332">
	<b:glossaryEntry>(of fluids) not moving or flowing; "mosquitoes breed in standing water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301190515">
	<b:glossaryEntry>not circulating or flowing; "dead air"; "dead water"; "stagnant water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301190650">
	<b:glossaryEntry>flowing with little speed as e.g. at the turning of the tide; "slack water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301190777">
	<b:glossaryEntry>free from noticeable current; "a still pond"; "still waters run deep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301190898">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(football) of advancing the ball by running; "the team''s running plays worked better than its pass plays"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301191060">
	<b:glossaryEntry>(football) of advancing the ball by throwing it; "a team with a good passing attack"; "a pass play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301191226">
	<b:glossaryEntry>favorable to life and growth; "soil sufficiently hospitable for forest growth"; "a hospitable environment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301191407"
	 b:glossaryEntry='agreeable; "a dry climate kind to asthmatics"'/>
<rdf:Description rdf:about="&a;301191503">
	<b:glossaryEntry>unfavorable to life or growth; "the barren inhospitable dessert"; "inhospitable mountain areas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301191747">
	<b:glossaryEntry>providing no shelter or sustenance; "bare rocky hills"; "barren lands"; "the bleak treeless regions of the high Andes"; "the desolate surface of the moon"; "a stark landscape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301192009">
	<b:glossaryEntry>located in a dismal or remote area; desolate; "a desert island"; "a godforsaken wilderness crossroads"; "a wild stretch of land"; "waste places"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301192235">
	<b:glossaryEntry>very unfavorable to life or growth; "a hostile climate"; "an uncongenial atmosphere"; "an uncongenial soil"; "the unfriendly environment at high altitudes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301192471"
	 b:glossaryEntry="washed or swept with water especially waves of the sea"/>
<rdf:Description rdf:about="&a;301192584"
	 b:glossaryEntry='open to or swept by wind; "windswept headlands"'/>
<rdf:Description rdf:about="&a;301192687">
	<b:glossaryEntry>disposed to treat guests and strangers with cordiality and generosity; "a good-natured and hospitable man"; "a hospitable act"; "hospitable invitations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301192932"
	 b:glossaryEntry='very cordial; "a welcoming smile"'/>
<rdf:Description rdf:about="&a;301193021">
	<b:glossaryEntry>not hospitable; "they are extremely inhospitable these days"; "her greeting was cold and inhospitable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301193200">
	<b:glossaryEntry>characterized by enmity or ill will; "a hostile nation"; "a hostile remark"; "hostile actions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301193636">
	<b:glossaryEntry>characteristic of an enemy or one eager to fight; "aggressive acts against another country"; "a belligerent tone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301193820">
	<b:glossaryEntry>characterized by antagonism or antipathy; "slaves antagonistic to their masters"; "antipathetic factions within the party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194033">
	<b:glossaryEntry>in a dispute or confrontation; "Sam and his parents were at loggerheads over the question of car privileges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194202">
	<b:glossaryEntry>proceeding from or exhibiting great hostility or animosity; "a bitter struggle"; "bitter enemies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194352"
	 b:glossaryEntry='expressing or revealing hostility or dislike; "dirty looks"'/>
<rdf:Description rdf:about="&a;301194463">
	<b:glossaryEntry>characterized by direct opposition; "a head-on confrontation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194578">
	<b:glossaryEntry>indicating hostility or enmity; "you certainly did me an ill turn"; "ill feelings"; "ill will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194722">
	<b:glossaryEntry>characterized by active hostility; "opponent (or opposing) armies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194854">
	<b:glossaryEntry>aggressively hostile; "a truculent speech against the new government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301194979">
	<b:glossaryEntry>not friendly; "an unfriendly act of aggression"; "an inimical critic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301195116"
	 b:glossaryEntry="characterized by friendship and good will"/>
<rdf:Description rdf:about="&a;301195320">
	<b:glossaryEntry>favorably disposed; not antagonistic or hostile; "a government friendly to our interests"; "an amicable agreement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301195489"
	 b:glossaryEntry="not hostile"/>
<rdf:Description rdf:about="&a;301195556">
	<b:glossaryEntry>not unfriendly or threatening; "her well-meaning words were received in silence"; "the exasperation of a...well-meaning cow worried by dogs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301195771">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of physical heat; having a high or higher than desirable temperature or giving off heat or feeling or causing a sensation of heat or burning; "hot stove"; "hot water"; "a hot August day"; "a hot stuffy room"; "she''s hot and tired"; "a hot forehead"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301196506"
	 b:glossaryEntry="as hot as if in an oven"/>
<rdf:Description rdf:about="&a;301196595">
	<b:glossaryEntry>hot enough to raise (or as if to raise) blisters; "blistering sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301196729"
	 b:glossaryEntry='hot enough to boil; "boiling water"'/>
<rdf:Description rdf:about="&a;301196829"
	 b:glossaryEntry='intensely hot; "a burning fever"; "the burning sand"'/>
<rdf:Description rdf:about="&a;301196938">
	<b:glossaryEntry>producing the sensation of heat when applied to the body; "a mustard plaster is calefacient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301197098"
	 b:glossaryEntry='serving to heat; "a heating pad is calefactory"'/>
<rdf:Description rdf:about="&a;301197227">
	<b:glossaryEntry>producing heat; usually used of foods; "calorifacient chili peppers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301197355"
	 b:glossaryEntry='heat-generating; "the calorific properties of fuels"'/>
<rdf:Description rdf:about="&a;301197463">
	<b:glossaryEntry>extremely hot; "the fervent heat...merely communicated a genial warmth to their half-torpid systems"- Nathaniel Hawthorne; "set out...when the fervid heat subsides"- Frances Trollope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301197708">
	<b:glossaryEntry>like or suggestive of fire; "the burning sand"; "a fiery desert wind"; "an igneous desert atmosphere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301197871">
	<b:glossaryEntry>capable of becoming hot; "the heatable tip of a soldering iron"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301197989">
	<b:glossaryEntry xml:space='preserve'><![CDATA[made warm or hot; "a heated swimming pool"; "wiped his heated-up face with a large bandana"; (`het'' is a dialectal variant of `heated'' as in "he was all het up and sweaty")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301198241">
	<b:glossaryEntry>heated beyond a safe or desirable point; "the child became overheated"; "overheated metal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301198388"
	 b:glossaryEntry="glowing red with heat"/>
<rdf:Description rdf:about="&a;301198463">
	<b:glossaryEntry>hot and dry enough to burn or parch a surface; "scorching heat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301198582">
	<b:glossaryEntry>hot enough to burn with or as if with a hissing sound; "a sizzling steak"; "a sizzling spell of weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301198741">
	<b:glossaryEntry>characterized by oppressive heat and humidity; "the summer was sultry and oppressive"; "the stifling atmosphere"; "the sulfurous atmosphere preceding a thunderstorm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301198995">
	<b:glossaryEntry>excessively hot and humid or marked by sweating and faintness; "a sweltering room"; "sweltering athletes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301199167">
	<b:glossaryEntry>caused by or designed to retain heat; "thermal springs"; "a thermal burn"; "thermal underwear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301199315">
	<b:glossaryEntry>burning hot; extremely and unpleasantly hot; "the torrid noonday sun"; "sultry sands of the dessert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301199477">
	<b:glossaryEntry>of weather or climate; hot and humid as in the tropics; "tropical weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301199615">
	<b:glossaryEntry>glowing white with heat; "white flames"; a white-hot center of the fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301199751">
	<b:glossaryEntry>used of physical coldness; having a low or inadequate temperature or feeling a sensation of coldness or having been made cold by e.g. ice or refrigeration; "a cold climate"; "a cold room"; "dinner has gotten cold"; "cold fingers"; "if you are cold, turn up the heat"; "a cold beer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301200425">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(archaic) of persons; feeling cold; "Poor Tom''s acold"- Shakespeare]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301200544">
	<b:glossaryEntry>(medicine) chilly; "a person who is algid is marked by prostration and has cold clammy skin and low blood pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301200711">
	<b:glossaryEntry xml:space='preserve'><![CDATA[extremely cold; "an arctic climate"; "let''s get inside; I''m freezing"; "a frigid day"; "gelid waters of the North Atlantic"; "glacial winds"; "icy hands"; "polar weather"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301200986">
	<b:glossaryEntry>unpleasantly cold and damp; "bleak winds of the North Atlantic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301201117">
	<b:glossaryEntry>made agreeably cold (especially by ice); "a glass of chilled lemonade"; "iced tea"; "an ice-cold coke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301201291">
	<b:glossaryEntry>of persons and animals; feeling no warmth; "got chilled at the football game"; "shivering in her thin coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301201464">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pleasantly cold and invigorating; "crisp clear nights and frosty mornings"; "a nipping wind"; "a nippy fall day"; "snappy weather"; (`parky'' is a British term)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301201719"
	 b:glossaryEntry="causing cold; cooling or chilling"/>
<rdf:Description rdf:about="&a;301201809">
	<b:glossaryEntry>(archaic) very cold; "whatever the evenings be--frosty and frore or warm and wet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301201942">
	<b:glossaryEntry>covered with frost; "frosted windowpanes"; "a frosty glass"; "hedgerows were rimed and stiff with frost"-Wm.Faulkner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202136">
	<b:glossaryEntry>without generating heat; "luminescent organisms emit heatless light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202259">
	<b:glossaryEntry>causing cooling or freezing; "a refrigerant substance such as ice or solid carbon dioxide"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202423">
	<b:glossaryEntry>made or kept cold by refrigeration; "keep the milk refrigerated"; "a refrigerated truck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202570">
	<b:glossaryEntry>cold enough to cause shivers; "felt all shivery"; "shivery weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202691">
	<b:glossaryEntry>completely cold; "by the time he got back to his coffee it was stone-cold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202822">
	<b:glossaryEntry>not having been heated or warmed; "an unheated room"; "unwarmed rolls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301202958">
	<b:glossaryEntry>of or characteristic of or occurring in spring; "the vernal equinox"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301203146">
	<b:glossaryEntry>occurring in or appropriate to the season of spring; "spring rains"; "springtime activities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301203310">
	<b:glossaryEntry>belonging to or characteristic of or occurring in summer; "summery weather"; "summery dresses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301203530">
	<b:glossaryEntry>(rare) of or occurring in summer; "the sky was a burnished aestival blue"; "estival winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301203685">
	<b:glossaryEntry>occurring in or appropriate to the season of summer; "summer flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301203810">
	<b:glossaryEntry>of or characteristic of or occurring in autumn; "the autumnal equinox"; "autumnal fruits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301204008">
	<b:glossaryEntry>occurring in or appropriate to the season of autumn; "autumn leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301204132">
	<b:glossaryEntry>characteristic of or occurring in winter; "suffered severe wintry weather"; "brown wintry grasses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301204365">
	<b:glossaryEntry>characteristic of or relating to winter; "bears in brumal sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301204502">
	<b:glossaryEntry>occurring in or appropriate to the season of winter; "winter winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301204625">
	<b:glossaryEntry>extended meanings; especially of psychological heat; marked by intensity or vehemence especially of passion or enthusiasm; "a hot temper"; "a hot topic"; "a hot new book"; "a hot love affair"; "a hot argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301205046">
	<b:glossaryEntry>intensely stirred up especially by anger or resentment; "he is boiling with anger"; "still sizzling over the insult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301205227"
	 b:glossaryEntry='very intense; "a fiery temper"; "flaming passions"'/>
<rdf:Description rdf:about="&a;301205339"
	 b:glossaryEntry='marked by emotional heat; vehement; "a heated argument"'/>
<rdf:Description rdf:about="&a;301205447">
	<b:glossaryEntry>characterized by intense emotion or interest or excitement; "a red-hot speech"; "sizzling political issues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301205619">
	<b:glossaryEntry>sexually exciting or gratifying; "sensual excesses"; "a sultry look"; "a sultry dance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301205768">
	<b:glossaryEntry>emotionally charged and vigorously energetic; "a torrid dance"; "torrid jazz bands"; "hot trumpets and torrid rhythms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301205939"
	 b:glossaryEntry='intensely zealous or fervid; "fierce white-hot loyalty"'/>
<rdf:Description rdf:about="&a;301206050">
	<b:glossaryEntry>extended meanings; especially of psychological coldness; without human warmth or emotion; "a cold unfriendly nod"; "a cold and unaffectionate person"; "a cold impersonal manner"; "cold logic"; "the concert left me cold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301206410">
	<b:glossaryEntry>unmoved by feeling; "he kept his emotionless objectivity and faith in the cause he served"; "this passionless girl was like an icicle in the sunshine"-Margaret Deland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301206648">
	<b:glossaryEntry>devoid of warmth and cordiality; expressive of unfriendliness or disdain; "a frigid greeting"; "got a frosty reception"; "a frozen look on their faces"; "a glacial handshake"; "icy stare"; "wintry smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301206947">
	<b:glossaryEntry>(music) emotionally charged and intense and marked by strong rhythms and improvisation; "hot jazz"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301207095">
	<b:glossaryEntry>(music) restrained and fluid and marked by intricate harmonic structures often lagging slightly behind the beat; "cool jazz"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301207270">
	<b:glossaryEntry>having human form or attributes as opposed to those of animals or divine beings; "human beings"; "the human body"; "human kindness"; "human frailty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301207614"
	 b:glossaryEntry="resembling human beings"/>
<rdf:Description rdf:about="&a;301207704">
	<b:glossaryEntry>suggesting human characteristics for animals or inanimate things</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301207861"
	 b:glossaryEntry='springing from or born on the earth; "earthborn beings"'/>
<rdf:Description rdf:about="&a;301207972">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having the attributes of man as opposed to e.g. divine beings; "I''m only human"; "frail humanity"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301208151"
	 b:glossaryEntry='of humankind as a species; "the hominal kingdom"'/>
<rdf:Description rdf:about="&a;301208253">
	<b:glossaryEntry>characterizing the family Hominidae, which includes Homo sapiens sapiens as well as extinct species of manlike creatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301208438"
	 b:glossaryEntry="characteristic of humankind"/>
<rdf:Description rdf:about="&a;301208520">
	<b:glossaryEntry>not human; not belonging to or produced by or appropriate to human beings; "nonhuman primates such as chimpanzees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301208797"
	 b:glossaryEntry="resembling apes"/>
<rdf:Description rdf:about="&a;301208894">
	<b:glossaryEntry>devoid of human emotion or feeling; "charts of bloodless economic indicators"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301209027"
	 b:glossaryEntry="divested of human qualities or attributes"/>
<rdf:Description rdf:about="&a;301209136">
	<b:glossaryEntry>belonging to or resembling something nonhuman; "something dark and inhuman in form"; "a babel of inhuman noises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301209302"
	 b:glossaryEntry="lacking thought or feeling"/>
<rdf:Description rdf:about="&a;301209385">
	<b:glossaryEntry>above or beyond the human or demanding more than human power or endurance; "superhuman beings"; "superhuman strength"; "soldiers driven mad by superhuman misery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301209639">
	<b:glossaryEntry>appropriate to or befitting a god; "the divine strength of Achilles"; "a man of godlike sagacity"; "man must play God for he has acquired certain godlike powers"-R.H.Roveref</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301209876">
	<b:glossaryEntry>displaying superhuman strength or power; "herculean exertions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301210005">
	<b:glossaryEntry>less than human or not worthy of a human being; "treated natives as subhuman"; "a subhuman spectacle"; "the subhuman primates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301210204">
	<b:glossaryEntry>belonging to a group below humans in evolutionary development; "infrahuman animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301210344">
	<b:glossaryEntry>marked or motivated by concern with the alleviation of suffering</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301210605">
	<b:glossaryEntry>showing recognition of unusually distressful circumstances; "compassionate leave"; "considered for a compassionate discharge because of domestic difficulties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301210823">
	<b:glossaryEntry>characterized by mercy, and compassion; "compassionate toward disadvantaged people"; "kind to animals"; "a humane judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301211005">
	<b:glossaryEntry>marked by humanistic values and devotion to human welfare; "a humane physician"; "released the prisoner for humanitarian reasons"; "respect and humanistic regard for all members of our species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301211298">
	<b:glossaryEntry>with as little pain as possible; "a humanely painless killing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301211415">
	<b:glossaryEntry>lacking and reflecting lack of pity or compassion; "humans are innately inhumane; this explains much of the misery and suffering in the world"; "biological weapons are considered too inhumane to be used"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301211817">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of persons or their actions) able or disposed to inflict pain or suffering; "a barbarous crime"; "brutal beatings"; "cruel tortures"; "Stalin''s roughshod treatment of the kulaks"; "a savage slap"; "vicious kicks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301212141">
	<b:glossaryEntry>resembling a beast; showing lack of human sensibility; "beastly desires"; "a bestial nature"; "brute force"; "a dull and brutish man"; "bestial treatment of prisoners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301212393">
	<b:glossaryEntry>(of weapons or instruments) causing suffering and pain; "brutal instruments of torture"; "cruel weapons of war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301212565">
	<b:glossaryEntry>marked by barbarity suggestive of a cannibal; rapaciously savage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301212686">
	<b:glossaryEntry>without compunction or human feeling; "in cold blood"; "cold-blooded killing"; "insensate destruction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301212876"
	 b:glossaryEntry="deficient in humane and kindly feelings"/>
<rdf:Description rdf:about="&a;301212979">
	<b:glossaryEntry>full of or characterized by humor; "humorous stories"; "humorous cartoons"; "in a humorous vein"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301213430">
	<b:glossaryEntry>cleverly amusing in tone; "a bantering tone"; "facetious remarks"; "tongue-in-cheek advice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301213607">
	<b:glossaryEntry>like a clown; "a buffoonish walk"; "a clownish face"; "a zany sense of humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301213770">
	<b:glossaryEntry xml:space='preserve'><![CDATA[arousing or provoking laughter; "an amusing film with a steady stream of pranks and pratfalls"; "an amusing fellow"; "a comic hat"; "a comical look of surprise"; "funny stories that made everybody laugh"; "a very funny writer"; "it would have been laughable if it hadn''t hurt so much"; "a mirthful experience"; "risible courtroom antics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301214220">
	<b:glossaryEntry>comical in an odd or whimsical manner; "a droll little man with a quiet tongue-in-cheek kind of humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301214374">
	<b:glossaryEntry>humorously sarcastic or mocking; "dry humor"; "an ironic remark often conveys an intended meaning obliquely"; "an ironic novel"; "an ironical smile"; "with a wry Scottish wit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301214625">
	<b:glossaryEntry>broadly or extravagantly humorous; resembling farce; "the wild farcical exuberance of a clown"; "ludicrous green hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301214823">
	<b:glossaryEntry>wildly comic and improbable as in Gilbert and Sullivan operas; "a Gilbertian world people with foundlings and changelings"- T.C.Worsley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301215015">
	<b:glossaryEntry>marked by or causing boisterous merriment or convulsive laughter; "hilarious broad comedy"; "a screaming farce"; "uproarious stories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301215232"
	 b:glossaryEntry="characterized by jokes and good humor"/>
<rdf:Description rdf:about="&a;301215351">
	<b:glossaryEntry>(informal) very funny; "a killing joke"; "sidesplitting antics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301215484">
	<b:glossaryEntry>having a mixture of serious with the comic with comic predominating; "a seriocomic novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301215645">
	<b:glossaryEntry>characterized by horseplay and physical action; "slapstick style of humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301215775">
	<b:glossaryEntry>having pathetic as well as ludicrous characteristics; "her life...presented itself to me as a tragicomical adventure"- Joseph Conrad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301215980">
	<b:glossaryEntry>witty or joking; "Muskrat Castle as the house has been facetiously named by some waggish officer"- James Fenimore Cooper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301216154">
	<b:glossaryEntry>combining clever conception and facetious expression; "his sermons were unpredictably witty and satirical as well as eloquent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301216332">
	<b:glossaryEntry>lacking humor; "it was a humorless wink; a wink of warning"- Truman Capote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301216511">
	<b:glossaryEntry>completely lacking in humor or lightness of touch; "choreography that was sobersided and sententious"; "a play with a solemn social message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301216717">
	<b:glossaryEntry>not funny; especially failing to achieve the intended humor; "a very unfunny joke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301216853">
	<b:glossaryEntry>feeling hunger; feeling a need or desire to eat food; "a world full of hungry people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301217063">
	<b:glossaryEntry>needing nourishment; "after skipped lunch the men were empty by suppertime"; "empty-bellied children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301217232">
	<b:glossaryEntry>extremely hungry; "they were tired and famished for food and sleep"; "a ravenous boy"; "the family was starved and ragged"; "fell into the esurient embrance of a predatory enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301217509"
	 b:glossaryEntry="(British) somewhat hungry"/>
<rdf:Description rdf:about="&a;301217588"
	 b:glossaryEntry='without supper; "went to bed supperless"'/>
<rdf:Description rdf:about="&a;301217685">
	<b:glossaryEntry>feeling a need or desire to drink; "after playing hard the children were thirsty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301217838"
	 b:glossaryEntry='suffering from fluid deprivation; "his mouth was dry"'/>
<rdf:Description rdf:about="&a;301217941">
	<b:glossaryEntry>moving rapidly or performed quickly or in great haste; "a hurried trip to the store"; "the hurried life of a city"; "a hurried job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301218234">
	<b:glossaryEntry>hurried and brief; "paid a flying visit"; "took a flying glance at the book"; "a quick inspection"; "a fast visit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301218416">
	<b:glossaryEntry>excessively quick; "made a hasty exit"; "a headlong rush to sell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301218544">
	<b:glossaryEntry>done with very great haste and without due deliberation; "hasty marriage seldom proveth well"- Shakespeare; "hasty makeshifts take the place of planning"- Arthur Geddes; "rejected what was regarded as an overhasty plan for reconversion"; "wondered whether they had been rather precipitate in deposing the king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301218946">
	<b:glossaryEntry>with undue hurry and confusion; "a helter-skelter kind of existence with never a pause"; "a pell-mell dash for the train"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301219140"
	 b:glossaryEntry='done under pressure; "a rush job"'/>
<rdf:Description rdf:about="&a;301219236">
	<b:glossaryEntry>relaxed and leisurely; without hurry or haste; "people strolling about in an unhurried way"; "an unhurried walk"; "spoke in a calm and unhurried voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301219479">
	<b:glossaryEntry>with care and dignity; "walking at the same measured pace"; "with all deliberate speed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301219644">
	<b:glossaryEntry>not hurried or forced; "an easy walk around the block"; "at a leisurely (or easygoing) pace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301219811"
	 b:glossaryEntry="possible to identify"/>
<rdf:Description rdf:about="&a;301219980"
	 b:glossaryEntry="capable of being acknowledged"/>
<rdf:Description rdf:about="&a;301220071"
	 b:glossaryEntry="possible to classify"/>
<rdf:Description rdf:about="&a;301220164"
	 b:glossaryEntry="possible to diagnose"/>
<rdf:Description rdf:about="&a;301220242"
	 b:glossaryEntry="possible to recognize"/>
<rdf:Description rdf:about="&a;301220349"
	 b:glossaryEntry='capable of being specified; "specifiable complaints"'/>
<rdf:Description rdf:about="&a;301220459"
	 b:glossaryEntry="impossible to identify"/>
<rdf:Description rdf:about="&a;301220632"
	 b:glossaryEntry='difficult to describe; "a haunting elusive odor"'/>
<rdf:Description rdf:about="&a;301220734">
	<b:glossaryEntry>hard to pin down or identify; "an intangible feeling of impending disaster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301220866"
	 b:glossaryEntry="not possible to classify"/>
<rdf:Description rdf:about="&a;301220951"
	 b:glossaryEntry="not possible to diagnose"/>
<rdf:Description rdf:about="&a;301221035"
	 b:glossaryEntry="defying recognition as e.g. because of damage or alteration"/>
<rdf:Description rdf:about="&a;301221172">
	<b:glossaryEntry>(of a publication) provided with illustrations; "illustrated books for children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301221328"
	 b:glossaryEntry='illustrated with pictures; "a pictorial history"'/>
<rdf:Description rdf:about="&a;301221432">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of a publication) not provided with pictures; "unillustrated children''s books usually sell poorly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301221591">
	<b:glossaryEntry>(philosophy) of a mental act; occurring entirely within the mind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301221723">
	<b:glossaryEntry>(philosophy) of a mental act; causing effects outside the mind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301221853">
	<b:glossaryEntry>diminished in strength, quality, or utility; "impaired eyesight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301222134">
	<b:glossaryEntry>visual impairment resulting from faulty refraction of light rays in the eye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301222320"
	 b:glossaryEntry="having impaired sense of smell"/>
<rdf:Description rdf:about="&a;301222404">
	<b:glossaryEntry>weakened and infirm; "broken health resulting from alcoholism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301222519">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(British informal) faulty; "I''ve got this dicky heart"- John le Carre]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301222649"
	 b:glossaryEntry="impaired by diminution"/>
<rdf:Description rdf:about="&a;301222761"
	 b:glossaryEntry="impaired in function; especially of a bodily system or organ"/>
<rdf:Description rdf:about="&a;301222881">
	<b:glossaryEntry>having impaired ability to comprehend written words usually associated with a neurologic disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301223045">
	<b:glossaryEntry>not damaged or diminished in any respect; "his speech remained unimpaired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301223230">
	<b:glossaryEntry>not impaired or diminished in any way; "emerged from the trial with his prestige intact"; "the blast left his hearint intact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301223408">
	<b:glossaryEntry>of great significance or value; "important people"; "the important questions of the day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301223960">
	<b:glossaryEntry>of the greatest importance; "the all-important subject of disarmament"; "crucial information"; "in chess cool nerves are of the essence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301224220">
	<b:glossaryEntry>first in order of importance; "the alpha male in the group of chimpanzees"; "the alpha star in a constellation is the brightest or main star"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301224413">
	<b:glossaryEntry>(of persons) highest in rank or authority or office; "his arch rival"; "the boss man"; "the chief executive"; "head librarian"; "top administrators"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301224655"
	 b:glossaryEntry='(informal) "graduation was a big day in his life"'/>
<rdf:Description rdf:about="&a;301224754"
	 b:glossaryEntry='of immediate import; "burning issues of the day"'/>
<rdf:Description rdf:about="&a;301224859">
	<b:glossaryEntry>serving as an essential component; "a cardinal rule"; "the central cause of the problem"; "an example that was fundamental to the argument"; "computers are fundamental to modern industrial structure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301225152">
	<b:glossaryEntry>most important element; "the chief aim of living"; "the main doors were of solid glass"; "the principal rivers of America"; "the principal example"; "policemen were primary targets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301225426">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having important issues or results; "the year''s only really consequential legislation"; "an eventful decision"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301225607">
	<b:glossaryEntry>of radical or major importance; "a Copernican revolution in modern art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301225735">
	<b:glossaryEntry>(used of persons) standing above others in character or attainment or reputation; "our distinguished professor"; "an eminent scholar"; "a great statesman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301225967">
	<b:glossaryEntry>of great gravity or crucial import; requiring serious thought; "grave responsibilities"; "faced a grave decision in a time of crisis"; "a grievous fault"; "heavy matters of state"; "the weighty matters to be discussed at the peace conference"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301226290">
	<b:glossaryEntry>important in history; "the historic first voyage to outer space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301226409">
	<b:glossaryEntry>(combining form) indicating the head of a staff; "editor-in-chief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301226534">
	<b:glossaryEntry>of distinguished importance; "a measurable figure in literature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301226655">
	<b:glossaryEntry>(sports) designating the player judged to be the most important to the sport; "the most-valuable player award"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301226825"
	 b:glossaryEntry='of great consequence; "marriage is a serious matter"'/>
<rdf:Description rdf:about="&a;301226931">
	<b:glossaryEntry>highly important to or an integral part of a strategy or plan of action especially in war; "a strategic chess move"; "strategic withdrawal"; "strategic bombing missions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301227156">
	<b:glossaryEntry>of great importance or use or service; "useful information"; "valuable advice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301227309">
	<b:glossaryEntry>not important; "a relatively unimportant feature of the system"; "the question seems unimportant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301227644">
	<b:glossaryEntry>lacking worth or importance; "his work seems trivial and inconsequential"; "the quite inconsequent fellow was managed like a puppet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301227853">
	<b:glossaryEntry>lacking importance; not mattering one way or the other; often followed by "to"; "whether you choose to do it or not is a matter that is quite immaterial (or indifferent)"; "what others think is altogether indifferent to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301228148">
	<b:glossaryEntry>(informal terms) small and of little importance; "a fiddling sum of money"; "a footling gesture"; "our worries are lilliputian compared with those of countries that are at war"; "a little (or small) matter"; "a dispute over niggling details"; "limited to petty enterprises"; "piffling efforts"; "giving a police officer a free meal may be against the law, but it seems to be a picayune infraction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301228696"
	 b:glossaryEntry='having no importance or influence; "a lightweight intellect"'/>
<rdf:Description rdf:about="&a;301228814">
	<b:glossaryEntry>having no real backing; "a nickel-and-dime operation run out of a single rented room"; "a small-time actor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301228996"
	 b:glossaryEntry='(British informal) trivial; "potty little details"'/>
<rdf:Description rdf:about="&a;301229098">
	<b:glossaryEntry>making a strong or vivid impression; "an impressive ceremony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301229558">
	<b:glossaryEntry xml:space='preserve'><![CDATA[inspiring awe or admiration or wonder; "New York is an amazing city"; "the Grand Canyon is an awe-inspiring sight"; "the awesome complexity of the universe"; "this sea, whose gently awful stirrings seem to speak of some hidden soul beneath"- Melville; "Westminster Hall''s awing majesty, so vast, so high, so silent"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301229969">
	<b:glossaryEntry>commanding attention; "an arresting drawing of people turning into animals"; "a sensational concert--one never to be forgotten"; "a stunning performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301230203">
	<b:glossaryEntry>so surprisingly impressive as to stun or overwhelm; "such an enormous response was astonishing"; "an astounding achievement"; "the amount of money required was staggering"; "suffered a staggering defeat"; "the figure inside the boucle dress was stupefying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301230556">
	<b:glossaryEntry>impressive in appearance; "a baronial mansion"; "an imposing residence"; "a noble tree"; "severe-looking policemen sat astride noble horses"; "stately columns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301230799">
	<b:glossaryEntry xml:space='preserve'><![CDATA[dazzling; suggestive of the flashing of lightning; "the skater''s dazzling virtuosic leaps"; "these great best canvases still look as astonishing and as invitingly new as they did...when...his fulgurant popularity was in full growth"- Janet Flanner; "adventures related...in a style both vivid and fulgurous"- Idwal Jones]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301231198">
	<b:glossaryEntry>sensational in appearance or thrilling in effect; "a dramatic sunset"; "a dramatic pause"; "a spectacular display of northern lights"; "it was a spectacular play"; "his striking good looks always created a sensation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301231494">
	<b:glossaryEntry>impressive in scale; "an expansive lifestyle"; "in the grand manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301231626">
	<b:glossaryEntry xml:space='preserve'><![CDATA[extremely impressive in strength or excellence; "a formidable opponent"; "the challenge was formidable"; "had a formidable array of compositions to his credit"; "the formidable army of brains at the Prime Minister''s disposal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301231908">
	<b:glossaryEntry>having or displaying great dignity or nobility; "a gallant pageant"; "lofty ships"; "majestic cities"; "proud alpine peaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301232112">
	<b:glossaryEntry>characterized by or attended with brilliance or grandeur; "the brilliant court life at Versailles"; "a glorious work of art"; "magnificent cathedrals"; "the splendid coronation ceremony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301232390">
	<b:glossaryEntry>impressive because of unnecessary largeness or grandeur; used to show disapproval</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301232527"
	 b:glossaryEntry='impressive in size or scope; "heroic undertakings"'/>
<rdf:Description rdf:about="&a;301232638"
	 b:glossaryEntry="impressive in appearance"/>
<rdf:Description rdf:about="&a;301232726">
	<b:glossaryEntry>intellectually or emotionally overwhelming; "a mind-boggling display"; "a mind-boggling puzzle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301232881">
	<b:glossaryEntry>suitable for or like a palace; "palatial furnishings"; "a palatial yacht"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301233009">
	<b:glossaryEntry>notably out of the ordinary; "the year saw one signal triumph for the Labour party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301233145">
	<b:glossaryEntry>extraordinarily big or impressive; "a thundering success"; "the thundering silence of what was left unsaid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301233309"
	 b:glossaryEntry="not capable of impressing"/>
<rdf:Description rdf:about="&a;301233429">
	<b:glossaryEntry>lacking in impressiveness; "on the whole the results of this system are unimposing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301233569">
	<b:glossaryEntry>capable or worthy of drawing attention; "noticeable shadows under her eyes"; "noticeable for its vivid historical background"; "a noticeable lack of friendliness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301233896">
	<b:glossaryEntry>(of speech) heavily and noticeably regional; "a broad southern accent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301234018">
	<b:glossaryEntry>easily seen or detected; "a detectable note of sarcasm"; "he continued after a perceptible pause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301234186">
	<b:glossaryEntry>capable of being seen or noticed; "a discernible change in attitude"; "a clearly evident erasure in the manuscript"; "an observable change in behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301234418">
	<b:glossaryEntry>strongly marked; easily noticeable; "walked with a marked limp"; "a pronounced flavor of cinnamon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301234582">
	<b:glossaryEntry>worthy of notice or attention; "a noted increase in the crime rate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301234701">
	<b:glossaryEntry>not noticeable; not drawing attention; "her clothes were simple and unnoticeable"- J.G.Cozzens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301234890"
	 b:glossaryEntry="not worthy of notice"/>
<rdf:Description rdf:about="&a;301234988">
	<b:glossaryEntry>made more desirable or valuable or profitable; especially made ready for use or marketing; "new houses are springing up on an improved tract of land near the river"; "an improved breed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301235336">
	<b:glossaryEntry>(used of soaps or cleaning agents) having a substance (an abrasive or filler) added to increase effectiveness; "the built liquid detergents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301235541">
	<b:glossaryEntry>(of real estate) made more useful and profitable as by building or laying out roads; "condominiums were built on the developed site"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301235729"
	 b:glossaryEntry="(of domestic animals) improved by selective breeding"/>
<rdf:Description rdf:about="&a;301235833"
	 b:glossaryEntry="(of roads) leveled and drained but not paved"/>
<rdf:Description rdf:about="&a;301235941">
	<b:glossaryEntry>(of land) improved by gardening or landscape architecture; "carefully landscaped gardens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301236087">
	<b:glossaryEntry>not made more desirable or valuable or profitable; especially not made ready for use or marketing; "taxes on unimproved land are low"; "unimproved dirt roads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301236356">
	<b:glossaryEntry>(of roads) not leveled or drained; unsuitable for all year travel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301236483"
	 b:glossaryEntry="(of domestic animals) not selectively bred"/>
<rdf:Description rdf:about="&a;301236577">
	<b:glossaryEntry>(of real estate) not built upon or ready for building upon; "taxes on undeveloped lots are low"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301236730">
	<b:glossaryEntry>rid of objects or obstructions such as e.g. trees and brush; "cleared land"; "cleared streets free of fallen trees and debris"; "a cleared passage through the underbrush"; "played poker on the cleared dining room table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301237057">
	<b:glossaryEntry>having had all the trees removed at one time; "clear-cut hillsides subject to erosion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301237199">
	<b:glossaryEntry>(of land) made ready for development or agriculture by clearing of trees and brush; "improved farmlands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301237358">
	<b:glossaryEntry>not cleared; not rid of objects or obstructions; "uncleared land"; "many cars were stuck in the snow on uncleared streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301237572">
	<b:glossaryEntry>(of land) not cleared of trees and brush; in the wild or natural state; "a farm with 50 acres of unimproved and 68 acres of improved land"; "unimproved woodlands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301237791">
	<b:glossaryEntry xml:space='preserve'><![CDATA[occurring at or characteristic of a formal investiture or induction; "the President''s inaugural address"; "an inaugural ball"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301237972">
	<b:glossaryEntry>occurring at or marking the close of a term of office; "an exaugural message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301238123"
	 b:glossaryEntry='of a speech expressing leave-taking; "a valedictory address"'/>
<rdf:Description rdf:about="&a;301238255">
	<b:glossaryEntry>located within the hull or nearest the midline of a vessel or aircraft; "the inboard flaps on the wing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301238412">
	<b:glossaryEntry>located away from the midline of a vessel or aircraft; "the outboard section of a wing"; "outboard rigging"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301238592">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a motor designed to be attached to the outside of a boat''s hull; "a portable outboard motor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301238742"
	 b:glossaryEntry="produced by inbreeding"/>
<rdf:Description rdf:about="&a;301238835"
	 b:glossaryEntry="bred of closely related parents"/>
<rdf:Description rdf:about="&a;301238922">
	<b:glossaryEntry>bred of parents not closely related; (anthropology) having parents of different classes or tribes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301239127"
	 b:glossaryEntry="bred of parents of different races or strains"/>
<rdf:Description rdf:about="&a;301239240">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `to'') having a preference, disposition, or tendency; "wasn''t inclined to believe the excuse"; "inclined to be moody"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301239541">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') naturally disposed toward; "he is apt to ignore matters he considers unimportant"; "I am not minded to answer any questions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301239795">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `of'' or `to'') having a strong preference or liking for; "fond of chocolate"; "partial to horror movies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301239978">
	<b:glossaryEntry>(used in combination) being of a specified kind of inclination or disposition; "serious-minded"; "fair-minded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301240141">
	<b:glossaryEntry>having a tendency (to); often used in combination; "a child prone to mischief"; "failure-prone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301240288"
	 b:glossaryEntry="having more than the average number of accidents"/>
<rdf:Description rdf:about="&a;301240397">
	<b:glossaryEntry>unwilling because of mild dislike or disapproval; "disinclined to say anything to anybody"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301240635">
	<b:glossaryEntry>having feelings of aversion or unwillingness; "afraid of hard work"; "affaid to show emotion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301240781">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') strongly opposed; "antipathetic to new ideas"; "averse to taking risks"; "loath to go on such short notice"; "clearly indisposed to grant their request"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301241085">
	<b:glossaryEntry>unwilling to become involved; "they were usually reluctant to socialize"; "reluctant to help"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301241234">
	<b:glossaryEntry>coming in or succeeding or of the future; "incoming class"; "incoming mail"; "the incoming president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301241570">
	<b:glossaryEntry>that is going in; "the entering class"; "the ingoing administration"; "ingoing data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301241722">
	<b:glossaryEntry>directed or moving inward or toward a center; "the inbound train"; "inward flood of capital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301241891"
	 b:glossaryEntry="appointed but not yet installed in office"/>
<rdf:Description rdf:about="&a;301241992">
	<b:glossaryEntry>elected but not yet installed in office; "the president elect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301242110">
	<b:glossaryEntry>(of elected officers) elected but not yet serving; "our next president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301242260"
	 b:glossaryEntry='directed or bound inward; "took the in bus"; "the in basket"'/>
<rdf:Description rdf:about="&a;301242372"
	 b:glossaryEntry="that is flowing inward"/>
<rdf:Description rdf:about="&a;301242461"
	 b:glossaryEntry='that is pouring inward; "inpouring throngs of immigrants"'/>
<rdf:Description rdf:about="&a;301242574">
	<b:glossaryEntry>going out or away or of the past; "an outgoing steamship"; "the outgoing president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301242820">
	<b:glossaryEntry>that is going out or leaving; "the departing train"; "an outward journey"; "outward-bound ships"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301243012"
	 b:glossaryEntry="that is flowing outward"/>
<rdf:Description rdf:about="&a;301243103">
	<b:glossaryEntry>directed outward or serving to direct something outward; "the out doorway"; "the out basket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301243248">
	<b:glossaryEntry>of a person who has held and relinquished a position or office; "a retiring member of the board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301243427"
	 b:glossaryEntry='outgoing; "ebb tide"; "low tide"'/>
<rdf:Description rdf:about="&a;301243536">
	<b:glossaryEntry>that are flowing away; "the receding waters left muddy devastation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301243658"
	 b:glossaryEntry='incoming; "flood tide"; "high tide"'/>
<rdf:Description rdf:about="&a;301243773">
	<b:glossaryEntry>that are flowing inward; "the rising tide destroyed their sand castle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301243908">
	<b:glossaryEntry>(logic) of reasoning; proceeding from particular facts to a general conclusion; "inductive reasoning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301244101"
	 b:glossaryEntry="involving inferences from general principles"/>
<rdf:Description rdf:about="&a;301244309"
	 b:glossaryEntry="capable of being deduced"/>
<rdf:Description rdf:about="&a;301244389">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) expressing or preceding an inference; "`therefore'' is an illative word"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301244525">
	<b:glossaryEntry>resembling or dependent on or arrived at by inference; "an illative conclusion"; "inferential reasoning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301244698">
	<b:glossaryEntry>(logic) of reasoning; proceeding from general premisses to a necessary and specific conclusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301244850">
	<b:glossaryEntry>showing or characterized by or given to indulgence; "indulgent grandparents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301245144">
	<b:glossaryEntry>marked by excessive self-indulgence and moral decay; "a decadent life of excessive money and no sense of responsibility"; "a group of effete self-professed intellectuals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301245378">
	<b:glossaryEntry>preoccupied with the pursuit of pleasure and especially games of chance; "led a dissipated life"; "a betting man"; "a card-playing son of a bitch"; "a gambling fool"; "sporting gents and their ladies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301245682">
	<b:glossaryEntry>furnishing gratification of the senses; "an epicurean banquet"; "enjoyed a luxurious suite with a crystal chandelier and thick oriental rugs"; "Lucullus spent the remainder of his days in voluptuous magnificence"; "a chinchilla robe of sybaritic lavishness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301246045">
	<b:glossaryEntry>given to social pleasures often including dissipation; "led a gay Bohemian life"; "a gay old rogue with an eye for the ladies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301246221">
	<b:glossaryEntry>devoted to pleasure; "a hedonic thrill"; "lives of unending hedonistic delight"; "epicurean pleasures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301246402">
	<b:glossaryEntry>given to excessive indulgence of bodily appetites especially for intoxicating liquors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301246545">
	<b:glossaryEntry>overly indulgent; "pampering parents often have spoilt children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301246668">
	<b:glossaryEntry>indulgent of your own appetites and desires; "a self-indulgent...way of looking at life"- Havelock Ellis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301246833"
	 b:glossaryEntry="not indulgent"/>
<rdf:Description rdf:about="&a;301247049">
	<b:glossaryEntry>of a stern or strict bearing or demeanor; forbidding in aspect; "an austere expression"; "a stern face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301247214">
	<b:glossaryEntry>morally rigorous and strict; "blue laws"; "the puritan work ethic"; "puritanic distaste for alcohol"; "she was anything but puritanical in her behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301247456">
	<b:glossaryEntry xml:space='preserve'><![CDATA[designed to promote discipline; "the teacher''s action was corrective rather than instructional"; "disciplinal measures"; "the mother was stern and disciplinary"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301247702"
	 b:glossaryEntry="befitting a monk; inclined to self-denial"/>
<rdf:Description rdf:about="&a;301247797"
	 b:glossaryEntry="used especially of behavior"/>
<rdf:Description rdf:about="&a;301247929"
	 b:glossaryEntry="used of persons"/>
<rdf:Description rdf:about="&a;301248007">
	<b:glossaryEntry>unsparing and uncompromising in discipline or judgment; "a parent severe to the pitch of hostility"- H.G.Wells; "a hefty six-footer with a rather severe mien"; "a strict disciplinarian"; "a Spartan upbringing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301248288">
	<b:glossaryEntry>used especially of societies; "the industrial revolution"; "an industrial nation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301248480">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of societies; having high industrial development; "the state''s well-developed industries"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301248649">
	<b:glossaryEntry>made industrial; converted to industrialism; "industrialized areas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301248777"
	 b:glossaryEntry="(of societies) not industrial"/>
<rdf:Description rdf:about="&a;301248902">
	<b:glossaryEntry>relating to societies in which capital needed to industrialize is in short supply</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301249057"
	 b:glossaryEntry="not converted to industrialism"/>
<rdf:Description rdf:about="&a;301249150">
	<b:glossaryEntry>easily spread; "fear is exceedlingly infectious; children catch it from their elders"- Bertrand Russell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301249364"
	 b:glossaryEntry="(of disease) capable of being transmitted by infection"/>
<rdf:Description rdf:about="&a;301249548">
	<b:glossaryEntry>easily diffused or spread as from one person to another; "a contagious grin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301249681"
	 b:glossaryEntry="that infects or taints"/>
<rdf:Description rdf:about="&a;301249776"
	 b:glossaryEntry="not infectious"/>
<rdf:Description rdf:about="&a;301249868"
	 b:glossaryEntry="(of disease) not capable of being passed on"/>
<rdf:Description rdf:about="&a;301250008"
	 b:glossaryEntry='being of a lower world of the dead; "infernal regions"'/>
<rdf:Description rdf:about="&a;301250189"
	 b:glossaryEntry='of the underworld; "nether regions"'/>
<rdf:Description rdf:about="&a;301250308"
	 b:glossaryEntry="of or relating to or characteristic of Hades or Tartarus"/>
<rdf:Description rdf:about="&a;301250441">
	<b:glossaryEntry>hellish; "Hence loathed Melancholy.../In Stygian cave forlorn"- Milton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301250565">
	<b:glossaryEntry>being or coming from on high; "interpret the plague as a visitation from heaven, a supernal punishment for the sins of men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301250761"
	 b:glossaryEntry="providing or conveying information"/>
<rdf:Description rdf:about="&a;301250957">
	<b:glossaryEntry>giving advice; "an advisory memorandum", "his function was purely consultative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301251134"
	 b:glossaryEntry="clarifying by use of examples"/>
<rdf:Description rdf:about="&a;301251237"
	 b:glossaryEntry='full of news; "a newsy letter"'/>
<rdf:Description rdf:about="&a;301251319">
	<b:glossaryEntry>disclosing unintentionally; "a telling smile"; "a telltale panel of lights"; "a telltale patch of oil on the water marked where the boat went down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301251546"
	 b:glossaryEntry="not informative"/>
<rdf:Description rdf:about="&a;301251655"
	 b:glossaryEntry="not providing news or information"/>
<rdf:Description rdf:about="&a;301251743">
	<b:glossaryEntry>highly enlightening; making understandable or clarifying; "an illuminating lecture"; "illuminating pieces of information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301251938"
	 b:glossaryEntry='failing to enlighten or clarify; "an unilluminating report"'/>
<rdf:Description rdf:about="&a;301252075">
	<b:glossaryEntry>possessing intellectual or esoteric knowledge of spiritual things</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301252194"
	 b:glossaryEntry="uncertain of all claims to knowledge"/>
<rdf:Description rdf:about="&a;301252334">
	<b:glossaryEntry>holding that only material phenomena can be known and knowledge of spiritual matters or ultimate causes is impossible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301252520">
	<b:glossaryEntry>characterized by tolerance; "although favoring European unity he was noncommital about the form it should take"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301252717">
	<b:glossaryEntry>having much knowledge or education; "an informed public"; "informed opinion"; "the informed customer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301253089">
	<b:glossaryEntry>being up to particular standard or level especially in being up to date in knowledge; "kept abreast of the latest developments"; "constant revision keeps the book au courant"; "always au fait on the latest events"; "up on the news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301253414"
	 b:glossaryEntry='having received information; "be kept advised"'/>
<rdf:Description rdf:about="&a;301253514">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `with'') well informed about; "conversant with business trends"; "familiar with trends in education"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301253708">
	<b:glossaryEntry>having or based on relevant experience; "an educated guess"; "an enlightened electorate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301253865"
	 b:glossaryEntry="(informal) informed about the latest trends"/>
<rdf:Description rdf:about="&a;301253976"
	 b:glossaryEntry="evidencing the possession of inside information"/>
<rdf:Description rdf:about="&a;301254100">
	<b:glossaryEntry>alert and fully informed; "politically aware"; "a knowing collector of rare books"; "the most...technically aware of the novelists under thirty"- W.S.Graham; "surprisingly knowledgeable about what was going on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301254391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') informed about something secret or not generally known; "privy to the details of the conspiracy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301254561">
	<b:glossaryEntry>well informed or deeply versed through reading; "respect for a well-read man"; "well-read in medieval history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301254727">
	<b:glossaryEntry>not informed; lacking in knowledge or information; "the uniformed public"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301255019">
	<b:glossaryEntry>lacking information or knowledge; "an unknowledgeable assistant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301255180">
	<b:glossaryEntry>not knowledgeable about something specified; "American tourists wholly innocent of French"; "a person unacquainted with our customs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301255396"
	 b:glossaryEntry="not having or receiving news or information"/>
<rdf:Description rdf:about="&a;301255494">
	<b:glossaryEntry>having received no information; "a defendant unadvised of her legal rights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301255625">
	<b:glossaryEntry>lacking information or instruction; "lamentably unenlightened as to the laws"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301255777">
	<b:glossaryEntry>not informed through reading; "he seems to have been wholly unread in political theory"- V.L.Parrington</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301255933">
	<b:glossaryEntry>characterized by an inability to mask your feelings; not devious; "an ingenuous admission of responsibility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301256179">
	<b:glossaryEntry>openly straightforward and direct without reserve or secretiveness; "his candid eyes"; "an open and trusting nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301256355">
	<b:glossaryEntry>without alteration or misrepresentation; "his judgment was undistorted by emotion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301256495">
	<b:glossaryEntry>not straightforward or candid; giving a false appearance of frankness; "an ambitious, disingenuous, philistine, and hypocritical operator, who...exemplified...the most disagreeable traits of his time"- David Cannadine; "a disingenuous excuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301256841">
	<b:glossaryEntry>having an intended meaning altered or misrepresented; "many of the facts seemed twisted out of any semblance to reality"; "a perverted translation of the poem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301257095">
	<b:glossaryEntry>having inhabitants; lived in; "the inhabited regions of the earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301257361"
	 b:glossaryEntry="inhabited by colonists"/>
<rdf:Description rdf:about="&a;301257449"
	 b:glossaryEntry='inhabited by or as if by apparitions; "a haunted house"'/>
<rdf:Description rdf:about="&a;301257558">
	<b:glossaryEntry>resided in; having tenants; "not all the occupied (or tenanted) apartments were well kept up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301257717">
	<b:glossaryEntry>lived in by the owner; "one owner-occupied and three rental apartments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301257849"
	 b:glossaryEntry='furnished with people; "sparsely peopled arctic regions"'/>
<rdf:Description rdf:about="&a;301257959">
	<b:glossaryEntry>furnished with inhabitants; "the area is well populated"; "forests populated with all kinds of wild life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301258120"
	 b:glossaryEntry="densely populated"/>
<rdf:Description rdf:about="&a;301258210">
	<b:glossaryEntry>having a lower population density than normal or desirable; "the richly endowed but underpopulated Ivory Coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301258382">
	<b:glossaryEntry>not having inhabitants; not lived in; "an uninhabited island"; "gaping doors of uninhabited houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301258647">
	<b:glossaryEntry>no longer inhabited; "weed-grown yard of an abandoned farmhouse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301258767">
	<b:glossaryEntry>having lost inhabitants as by war or disease; "the 15th century plagues left vast areas of Europe depopulated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301258935">
	<b:glossaryEntry>not leased to or occupied by a tenant; "an unoccupied apartment"; "very little unclaimed and untenanted land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301259114"
	 b:glossaryEntry='with no people living there; "vast unpopulated plains"'/>
<rdf:Description rdf:about="&a;301259238"
	 b:glossaryEntry='not yet settled; "unsettled territory"'/>
<rdf:Description rdf:about="&a;301259332">
	<b:glossaryEntry>that can be inherited; "inheritable traits such as eye color"; "an inheritable title"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301259559">
	<b:glossaryEntry>inherited or inheritable by established rules (usually legal rules) of descent; "ancestral home"; "ancestral lore"; "hereditary monarchy"; "patrimonial estate"; "transmissible tradition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301259845">
	<b:glossaryEntry>tending to occur among members of a family usually by heredity; "an inherited disease"; "familial traits"; "genetically transmitted features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301260106"
	 b:glossaryEntry="having the legal right to inherit"/>
<rdf:Description rdf:about="&a;301260196">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(meaning literally `born'') used to indicate the maiden or family name of a married woman; "Hillary Clinton nee Rodham"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301260364"
	 b:glossaryEntry="not inheritable"/>
<rdf:Description rdf:about="&a;301260545">
	<b:glossaryEntry>gotten through environmental forces; "acquired characteristics (such as a suntan or a broken nose) cannot be passed on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301260719">
	<b:glossaryEntry>present at birth but not necessarily hereditary; acquired during fetal development</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301260876"
	 b:glossaryEntry='acquired by learning; "learned skills"'/>
<rdf:Description rdf:about="&a;301260968"
	 b:glossaryEntry="not acquirable by inheritance"/>
<rdf:Description rdf:about="&a;301261076"
	 b:glossaryEntry="resulting from nurture"/>
<rdf:Description rdf:about="&a;301261153">
	<b:glossaryEntry>held back or restrained or prevented; "in certain conditions previously inhibited conditioned reactions can reappear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301261398">
	<b:glossaryEntry>characterized by or showing the suppression of impulses or emotions; "her severe upbringing had left her inhibited"; "a very inhibited young man, anxious and ill at ease"; "their reactions were partly the product of pent-up emotions"; "repressed rage turned his face scarlet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301261739">
	<b:glossaryEntry>held in check with difficulty; "a smothered cough"; "a stifled yawn"; "a strangled scream"; "suppressed laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301261943"
	 b:glossaryEntry='not inhibited or restrained; "uninhibited exuberance"'/>
<rdf:Description rdf:about="&a;301262162">
	<b:glossaryEntry xml:space='preserve'><![CDATA[free from constraint; "an abandoned sadness born of grief"- Liam O''Flaherty]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301262293"
	 b:glossaryEntry='hearty and lusty; "an earthy enjoyment of life"'/>
<rdf:Description rdf:about="&a;301262393"
	 b:glossaryEntry='not repressed; "unrepressed hostilities"'/>
<rdf:Description rdf:about="&a;301262491"
	 b:glossaryEntry='given vent to; "unsuppressed rage"; "unsuppressed feelings"'/>
<rdf:Description rdf:about="&a;301262609"
	 b:glossaryEntry="(used of drugs) capable of being injected"/>
<rdf:Description rdf:about="&a;301262707"
	 b:glossaryEntry="(used of drugs) not capable of being injected"/>
<rdf:Description rdf:about="&a;301262811">
	<b:glossaryEntry>usually used of physical or mental injury to persons; "injured soldiers"; "injured feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301263425">
	<b:glossaryEntry>having the skin scraped off; "skinned knees and scraped elbows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301263562"
	 b:glossaryEntry="scarred by battle"/>
<rdf:Description rdf:about="&a;301263640">
	<b:glossaryEntry>injured by bites or stings; "leaving the biter bit"; "her poor mosquito-bitten legs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301263791">
	<b:glossaryEntry>discolored by coagulation of blood beneath the skin; "beaten black and blue"; "livid bruises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301263953">
	<b:glossaryEntry>(of skin) having blisters (swellings containing watery fluid) caused by burning or irritation; "escaped from the fire with only a blistered hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301264154">
	<b:glossaryEntry>injured without breaking the skin; "a cut forehead and bruised cheek"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301264302">
	<b:glossaryEntry>suffering from emotional injury; "a bruised ego"; "to salve her wounded feelings"; "an air of hurt innocence"; "a tone of hurt surprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301264509">
	<b:glossaryEntry>injured by intense heat (as of fire or the sun); "his cracked, black burned lips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301264643">
	<b:glossaryEntry>wounded by cutting deeply; "got a gashed arm in a knife fight"; "had a slashed cheek from the broken glass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301264819"
	 b:glossaryEntry='having a long rip or tear; "a split lip"'/>
<rdf:Description rdf:about="&a;301264917">
	<b:glossaryEntry>so badly injured as to be unable to continue; "disabled veterans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301265070">
	<b:glossaryEntry>separated at the joint; "a dislocated knee"; "a separated shoulder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301265219"
	 b:glossaryEntry="having had pain or loss or suffering inflicted"/>
<rdf:Description rdf:about="&a;301265318">
	<b:glossaryEntry>suffering from physical injury especially that suffered in battle; "nursing his wounded arm"; "ambulances...for the hurt men and women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301265514"
	 b:glossaryEntry="having edges that are jagged from injury"/>
<rdf:Description rdf:about="&a;301265638">
	<b:glossaryEntry>badly injured, perhaps with amputation; "the maimed right hand twisted and clutched"- P.B.Kyne; "mutilated victims of the rocket attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301265839"
	 b:glossaryEntry='having the surface exposed and painful; "a raw wound"'/>
<rdf:Description rdf:about="&a;301265942"
	 b:glossaryEntry='having a long narrow cut; "his poor slit throat"'/>
<rdf:Description rdf:about="&a;301266041"
	 b:glossaryEntry="pierced with with a pointed weapon"/>
<rdf:Description rdf:about="&a;301266129">
	<b:glossaryEntry>feeling sharp psychological pain; "stung by the remark, she retorted angrily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301266258">
	<b:glossaryEntry>becoming puffy as from internal bleeding or accumulation of other fluids; "put ice on the swelling ankle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301266418"
	 b:glossaryEntry="not injured physically or mentally"/>
<rdf:Description rdf:about="&a;301266688">
	<b:glossaryEntry>(of a woman) having the hymen unbroken; "she was intact, virginal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301266819">
	<b:glossaryEntry>not cut; "glad to get out of the house with my throat uncut"- Tobias Smollett</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301266948"
	 b:glossaryEntry="wholly unharmed"/>
<rdf:Description rdf:about="&a;301267039"
	 b:glossaryEntry="not wounded"/>
<rdf:Description rdf:about="&a;301267106">
	<b:glossaryEntry>free from evil or guilt; "an innocent child"; "the principle that one is innocent until proved guilty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301267380">
	<b:glossaryEntry>freed from any question of guilt; "is absolved from all blame"; "was now clear of the charge of cowardice"; "his official honor is vindicated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301267634">
	<b:glossaryEntry>declared not guilty of a specific offense or crime; legally blameless; "he stands acquitted on all charges"; "the jury found him not guilty by reason of insanity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301267865">
	<b:glossaryEntry>free of guilt; not subject to blame; "has lived a blameless life"; "of irreproachable character"; "an unimpeachable reputation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301268094">
	<b:glossaryEntry>responsible for or chargeable with a reprehensible act; or marked by guilt; "guilty of murder"; "the guilty person"; "secret guilty deeds"; "a guilty conscience"; "guilty behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301268561"
	 b:glossaryEntry='deserving blame; "admitted to being at fault"'/>
<rdf:Description rdf:about="&a;301268661">
	<b:glossaryEntry>deserving blame or censure as being wrong or evil or injurious; "blameworthy if not criminal behavior"; "censurable misconduct"; "culpable negligence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301268927"
	 b:glossaryEntry="guilty of murder or bloodshed"/>
<rdf:Description rdf:about="&a;301269014">
	<b:glossaryEntry>liable to be accused, or cause for such liability; "the suspect was chargeable"; "an indictable offense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301269188">
	<b:glossaryEntry>pronounced or proved guilty; "the condemned man faced the firing squad with dignity"; "a convicted criminal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301269364"
	 b:glossaryEntry="affected by conscience"/>
<rdf:Description rdf:about="&a;301269451">
	<b:glossaryEntry>guilty of crime or serious offense; "criminal in the sight of God and man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301269580"
	 b:glossaryEntry='guilty of a minor misdeed; "delinquent minors"'/>
<rdf:Description rdf:about="&a;301269683"
	 b:glossaryEntry="liable to a fine"/>
<rdf:Description rdf:about="&a;301269764">
	<b:glossaryEntry>feeling or revealing a sense of guilt; "so guilt-ridden he could not face his father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301269908"
	 b:glossaryEntry='liable to or deserving punishment; "punishable offenses"'/>
<rdf:Description rdf:about="&a;301270021"
	 b:glossaryEntry="stimulating or exalting to the spirit"/>
<rdf:Description rdf:about="&a;301270132"
	 b:glossaryEntry='tending to exalt; "an exalting eulogy"; "ennobling thoughts"'/>
<rdf:Description rdf:about="&a;301270259"
	 b:glossaryEntry='depressing to the spirit; "a villa of uninspiring design"'/>
<rdf:Description rdf:about="&a;301270374"
	 b:glossaryEntry="serving to instruct of enlighten or inform"/>
<rdf:Description rdf:about="&a;301270668"
	 b:glossaryEntry='that makes clear; "a clarifying example"'/>
<rdf:Description rdf:about="&a;301270779"
	 b:glossaryEntry="serving to demonstrate"/>
<rdf:Description rdf:about="&a;301270876"
	 b:glossaryEntry="instructive especially excessively"/>
<rdf:Description rdf:about="&a;301270978">
	<b:glossaryEntry>stubbornly insistent on theory without regard for practicality or suitability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301271113"
	 b:glossaryEntry='resulting in education; "an educative experience"'/>
<rdf:Description rdf:about="&a;301271218"
	 b:glossaryEntry='providing knowledge; "an educational film"'/>
<rdf:Description rdf:about="&a;301271318">
	<b:glossaryEntry>serving or intended to explain or make clear; "explanatory notes"; "an explanatory paragraph"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301271471"
	 b:glossaryEntry='serving to expound or set fourth; "clean expository writing"'/>
<rdf:Description rdf:about="&a;301271601"
	 b:glossaryEntry="that provides interpretation"/>
<rdf:Description rdf:about="&a;301271705"
	 b:glossaryEntry="not informative or enlightening"/>
<rdf:Description rdf:about="&a;301271812">
	<b:glossaryEntry>enlightening or uplifting so as to encourage intellectual or moral improvement; "the paintings in the church served an edifying purpose even for those who could not read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301272052"
	 b:glossaryEntry="not edifying"/>
<rdf:Description rdf:about="&a;301272138">
	<b:glossaryEntry>tending to increase knowledge or dissipate ignorance; "an enlightening glimpse of government in action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301272328">
	<b:glossaryEntry>not tending to inform or clarify; "an unenlightening comment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301272482">
	<b:glossaryEntry>not segregated; designated as available to all races or groups; "integrated schools"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301272749"
	 b:glossaryEntry="attended by members of both sexes"/>
<rdf:Description rdf:about="&a;301272850"
	 b:glossaryEntry="rid of segregation; having had segregation ended"/>
<rdf:Description rdf:about="&a;301272986">
	<b:glossaryEntry>involving or composed of different races; "interracial schools"; "a mixed neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301273139"
	 b:glossaryEntry="(of the handicapped) placed in regular school classes"/>
<rdf:Description rdf:about="&a;301273251">
	<b:glossaryEntry>separated or isolated from others or a main group; "a segregated school system"; "a segregated neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301273539">
	<b:glossaryEntry>under forced isolation especially for health reasons; "a quarantined animal"; "isolated patients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301273705">
	<b:glossaryEntry>separated according to race, sex, class, or religion; "separate but equal"; "girls and boys in separate classes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301273872"
	 b:glossaryEntry='kept separate and secluded; "a sequestered jury"'/>
<rdf:Description rdf:about="&a;301273978">
	<b:glossaryEntry>restricted to whites only; "under segregation there were even white restrooms and white drinking fountains"; "a lily-white movement which would expel Negroes from the organization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301274223">
	<b:glossaryEntry>formed into a whole or introduced into another entity; "a more closely integrated economic and political system"- Dwight D.Eisenhower; "an integrated Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301274527">
	<b:glossaryEntry>operating as a unit; "a unified utility system"; "a coordinated program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301274684">
	<b:glossaryEntry>inserted as an integral part of a surrounding whole; "confused by the embedded Latin quotations"; "an embedded subordinate clause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301274869">
	<b:glossaryEntry>introduced into as a part of the whole; "the ideas incorporated in his revised manuscript"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301275018"
	 b:glossaryEntry="(psychology) incorporated unconsciously into your own psyche"/>
<rdf:Description rdf:about="&a;301275136"
	 b:glossaryEntry='closely and firmly integrated; "a tight-knit organization"'/>
<rdf:Description rdf:about="&a;301275266"
	 b:glossaryEntry="not integrated; not taken into or made a part of a whole"/>
<rdf:Description rdf:about="&a;301275397">
	<b:glossaryEntry>combined or mixed together so that the constituent parts are indistinguishable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301275619"
	 b:glossaryEntry="(used of metals) blended to obtain a desired property"/>
<rdf:Description rdf:about="&a;301275726"
	 b:glossaryEntry="caused to combine or unite"/>
<rdf:Description rdf:about="&a;301275846"
	 b:glossaryEntry="combining or mixing"/>
<rdf:Description rdf:about="&a;301275941">
	<b:glossaryEntry>(of immiscible or not completely miscible liquids) blended by the suspending of small globules of one liquid (as oil) in another (as water or vinegar)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301276148">
	<b:glossaryEntry>formed by blending unlike elements especially by reducing one element to particles and dispersing them throughout another substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301276337"
	 b:glossaryEntry="not blended or mixed together"/>
<rdf:Description rdf:about="&a;301276440"
	 b:glossaryEntry="not having undergone homogenization"/>
<rdf:Description rdf:about="&a;301276535"
	 b:glossaryEntry="made or joined or united into one"/>
<rdf:Description rdf:about="&a;301276767">
	<b:glossaryEntry>made up of individual elements; "if perception is seen as composed of isolated sense data..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301276915"
	 b:glossaryEntry="combined into or constituting a chemical compound"/>
<rdf:Description rdf:about="&a;301277021">
	<b:glossaryEntry>(psychology) representing two or more ideas or emotions by a single symbol; "a condensed expression of various feelings and ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301277207">
	<b:glossaryEntry>composed of heterogeneous elements gathered into a mass; "the conglomerate peoples of New England"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301277364">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of words) combined by means of a hyphen to form a unit; "hyphenated words"; "many femninists have chosen hyphenated names their children--today''s so-called hyphenated babies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301277596">
	<b:glossaryEntry>(of a substance) taken into and retained in another substance; "the sorbed oil mass"; "large volumes of occluded hydrogen in palladium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301277795">
	<b:glossaryEntry>being a single entity made by combining separate components; "three chemicals combining into one solution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301277951"
	 b:glossaryEntry="made up of several components combined into a single entity"/>
<rdf:Description rdf:about="&a;301278075"
	 b:glossaryEntry="not joined or united into one"/>
<rdf:Description rdf:about="&a;301278179"
	 b:glossaryEntry="not constituting a compound"/>
<rdf:Description rdf:about="&a;301278275">
	<b:glossaryEntry>tending to combine and coordinate diverse elements into a whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301278522"
	 b:glossaryEntry="relating to or involving combinations"/>
<rdf:Description rdf:about="&a;301278647"
	 b:glossaryEntry="arranging or grouping"/>
<rdf:Description rdf:about="&a;301278728"
	 b:glossaryEntry="combining into a single unit"/>
<rdf:Description rdf:about="&a;301278827">
	<b:glossaryEntry>used of the imagination; "material...transformed by the plastic power of the imagination" (Coleridge)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301278982"
	 b:glossaryEntry="tending to cause breakup into constituent elements or parts"/>
<rdf:Description rdf:about="&a;301279120"
	 b:glossaryEntry="causing organic decay"/>
<rdf:Description rdf:about="&a;301279203">
	<b:glossaryEntry>appealing to or using the intellect; "satire is an intellectual weapon"; "intellectual workers engaged in creative literary or artistic or scientific labor"; "has tremendous intellectual sympathy for oppressed people"; "coldly intellectual"; "sort of the intellectual type"; "intellectual literature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301279724">
	<b:glossaryEntry>(informal) highly cultured or educated; "highbrow events such as the ballet or opera"; "a highbrowed literary critic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301279909">
	<b:glossaryEntry>having its source in or being guided by the intellect (distinguished from experience or emotion); "a rational analysis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301280083"
	 b:glossaryEntry='devoted to matters of the mind; "the reflective type"'/>
<rdf:Description rdf:about="&a;301280193"
	 b:glossaryEntry='appealing to the mind; "good music"; "a serious book"'/>
<rdf:Description rdf:about="&a;301280307"
	 b:glossaryEntry='intellectually appealing; "a sophisticated drama"'/>
<rdf:Description rdf:about="&a;301280416"
	 b:glossaryEntry="not intellectual"/>
<rdf:Description rdf:about="&a;301280584">
	<b:glossaryEntry>smug and ignorant and indifferent or hostile to artistic and cultural values</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301280737">
	<b:glossaryEntry>characteristic of a person who is not cultivated or does not have intellectual tastes; "lowbrow tastes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301280921"
	 b:glossaryEntry='requiring little mental effort; "mindless tasks"'/>
<rdf:Description rdf:about="&a;301281024">
	<b:glossaryEntry>having the capacity for thought and reason especially to a high degree; "is there intelligent life in the universe?"; "an intelligent question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301281477"
	 b:glossaryEntry='mentally quick; "an agile mind"; "nimble wits"'/>
<rdf:Description rdf:about="&a;301281584"
	 b:glossaryEntry='mentally responsive; "an alert mind"'/>
<rdf:Description rdf:about="&a;301281672">
	<b:glossaryEntry>mentally quick and resourceful; "an apt pupil"; "you are a clever man...you reason well and your wit is bold"-Bram Stoker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301281852">
	<b:glossaryEntry>having or marked by unusual and impressive intelligence; "some men dislike brainy women"; "a brilliant mind"; "a brilliant solution to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301282082">
	<b:glossaryEntry>characterized by quickness and ease in learning; "some children are brighter in one subject than another"; "smart children talk earlier than the average"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301282296">
	<b:glossaryEntry>very penetrating and clear and sharp in operation; "an incisive mind"; "a keen intelligence"; "of sharp and active intellect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301282491">
	<b:glossaryEntry>apprehending and responding with speed and sensitivity; "a quick mind"; "a ready wit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301282636">
	<b:glossaryEntry>having a keen intellect; "poets--those gifted strangely prehensile men"- A.T.Quiller-Couch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301282783">
	<b:glossaryEntry>brilliantly clever; "scintillating wit"; "a play full of scintillating dialogue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301282923">
	<b:glossaryEntry>having keenness and forcefulness and penetration in thought, expression, or intellect; "searching insights"; "trenchant criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301283121">
	<b:glossaryEntry>without much intelligence; "a dull job with lazy and unintelligent co-workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301283394"
	 b:glossaryEntry="not using intelligence"/>
<rdf:Description rdf:about="&a;301283483"
	 b:glossaryEntry="mentally deficient"/>
<rdf:Description rdf:about="&a;301283588"
	 b:glossaryEntry="having a mental age of three to seven years"/>
<rdf:Description rdf:about="&a;301283698"
	 b:glossaryEntry="having a mental age of between eight and twelve years"/>
<rdf:Description rdf:about="&a;301283805">
	<b:glossaryEntry>well articulated or enunciated, and loud enough to be heard distinctly; "intelligible pronunciation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301283982">
	<b:glossaryEntry>poorly articulated or enunciated, or drowned by noise; "unintelligible speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301284157">
	<b:glossaryEntry>spoken as if with a thick tongue; "the thick speech of a drunkard"; "his words were slurred"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301284311">
	<b:glossaryEntry>intentional or planned; "your intended trip abroud"; "an intended insult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301284583">
	<b:glossaryEntry>intentionally conceived; "a conscious effort to speak more slowly"; "a conscious policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301284737">
	<b:glossaryEntry>by conscious design or purpose; "intentional damage"; "a knowing attempt to defraud"; "a willful waste of time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301284948">
	<b:glossaryEntry xml:space='preserve'><![CDATA[designed to; "medication that is supposed to relieve pain"; "what''s that gadget supposed to do?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301285102">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by good intentions though often producing unfortunate results; "a well-intentioned but clumsy waiter"; "a well-meaning but tactless fellow"; "the son''s well-meaning efforts threw a singular chill upon the father''s admirers"- S.W.Maughm; "blunt but well-meant criticism"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301285469"
	 b:glossaryEntry="not deliberate"/>
<rdf:Description rdf:about="&a;301285648">
	<b:glossaryEntry>without intention; especially resulting from heedless action; "with an inadvertent gesture she swept the vase off the table"; "accidental poisoning";"an accidental shooting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301285892">
	<b:glossaryEntry>having no cause or apparent cause; "a causeless miracle"; "fortuitous encounters--strange accidents of fortune"; "we cannot regard artistic invention as...uncaused and unrelated to the times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301286163">
	<b:glossaryEntry>not intentional; "an unintended slight"; "an unintentional pun"; "the offense was unintentional"; "an unwitting mistake may be overlooked"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301286385">
	<b:glossaryEntry>done or made or performed with purpose and intent; "style...is more than the deliberate and designed creation"- Havelock Ellis; "games designed for all ages"; "well-designed houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301286653">
	<b:glossaryEntry>planned and made or fashioned artistically; "beautifully fashioned dresses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301286784"
	 b:glossaryEntry="not done or made or performed with purpose or intent"/>
<rdf:Description rdf:about="&a;301286909"
	 b:glossaryEntry="increasing in strength or intensity"/>
<rdf:Description rdf:about="&a;301287075"
	 b:glossaryEntry="making worse"/>
<rdf:Description rdf:about="&a;301287175"
	 b:glossaryEntry="intensifying by augmentation and enhancement"/>
<rdf:Description rdf:about="&a;301287290">
	<b:glossaryEntry>accumulating and becoming more intense; "the deepening gloom"; "felt a deepening love"; "the gathering darkness"; "the thickening dusk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301287515"
	 b:glossaryEntry='reaching a higher intensity; "their heightening fears"'/>
<rdf:Description rdf:about="&a;301287630"
	 b:glossaryEntry="lessening in intensity or strength"/>
<rdf:Description rdf:about="&a;301287793"
	 b:glossaryEntry="moderating pain or sorrow by making it easier to bear"/>
<rdf:Description rdf:about="&a;301287968">
	<b:glossaryEntry>capable of relieving pain; "the anodyne properties of certain drugs"; "an analgesic effect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301288137"
	 b:glossaryEntry="moderating by making more temperate"/>
<rdf:Description rdf:about="&a;301288228"
	 b:glossaryEntry="moderating by making pain or sorrow weaker"/>
<rdf:Description rdf:about="&a;301288326">
	<b:glossaryEntry>arising or occurring between species; "an interspecific hybrid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301288464">
	<b:glossaryEntry>arising or occurring within a species; involving the members of one species; "intraspecific competition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301288643">
	<b:glossaryEntry>having or showing interest; especially curiosity or fascination or concern; "an interested audience"; "interested in sports"; "was interested to hear about her family"; "interested in knowing who was on the telephone"; "interested spectators"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301288978">
	<b:glossaryEntry>having curiosity aroused; eagerly interested in learning more; "a trap door that made me curious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301289129">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intensely interested in or attracted by; "I''m very interested in birds; in fact I''m fascinated by them"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301289289"
	 b:glossaryEntry='not having or showing interest; "an uninterested spectator"'/>
<rdf:Description rdf:about="&a;301289497">
	<b:glossaryEntry>marked by a lack of interest; "an apathetic audience"; "the universe is neither hostile nor friendly; it is simply indifferent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301289694">
	<b:glossaryEntry>uninterested because of frequent exposure or indulgence; "his blase indifference"; "a petulent blase air"; "the bored gaze of the successful film star"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301289905"
	 b:glossaryEntry='showing indifference or disregard; "a dismissive shrug"'/>
<rdf:Description rdf:about="&a;301290017">
	<b:glossaryEntry>having lost or been caused to lose interest because of overexposure; "the mind of the audience is becoming dulled"; "the benumbed intellectual faculties can no longer respond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301290256"
	 b:glossaryEntry="inattentive because of lack of interest"/>
<rdf:Description rdf:about="&a;301290353"
	 b:glossaryEntry="arousing or holding the attention"/>
<rdf:Description rdf:about="&a;301290570">
	<b:glossaryEntry>capable of arousing and holding the attention; "a fascinating story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301290743">
	<b:glossaryEntry>capable of arousing interest or curiosity; "our team came up with some most intriguing finds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301290893"
	 b:glossaryEntry="sufficiently interesting to be reported in a newspaper"/>
<rdf:Description rdf:about="&a;301291004">
	<b:glossaryEntry>(of a book etc) so well written and entertaining as to be difficult to put down; "Unless the story is at once as unputdownable to a taxi driver as to a university professor it is not good enough"- Brian Burland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301291274">
	<b:glossaryEntry>arousing no interest or attention or curiosity or excitement; "a very uninteresting account of her trip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301291600">
	<b:glossaryEntry xml:space='preserve'><![CDATA[so lacking in interest as to cause mental weariness; "a boring evening with uninteresting people"; "the deadening effect of some routine tasks"; "a dull play"; "his competent but dull performance"; "a ho-hum speaker who couldn''t capture their attention"; "what an irksome task the writing of long letters is"- Edmund Burke; "tedious days on the train"; "the tiresome chirping of a cricket"- Mark Twain; "other people''s dreams are dreadfully wearisome"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301292182">
	<b:glossaryEntry>lacking interest or significance; "an insipid personality"; "jejune novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301292319"
	 b:glossaryEntry='inducing mental lethargy; "a narcotic speech"'/>
<rdf:Description rdf:about="&a;301292446"
	 b:glossaryEntry='lacking wit or imagination; "a pedestrian movie plot"'/>
<rdf:Description rdf:about="&a;301292587"
	 b:glossaryEntry='labored and dull; "a ponderous speech"'/>
<rdf:Description rdf:about="&a;301292681">
	<b:glossaryEntry>(of a book) so poorly written and unentertaining as to be easily put down</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301292812">
	<b:glossaryEntry xml:space='preserve'><![CDATA[carried on within the bounds of an institution or community; "most of the students participated actively in the college''s intramural sports program"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301293035">
	<b:glossaryEntry>occurring within an institution or community; "intragroup squabbling within the corporation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301293195">
	<b:glossaryEntry>carried on outside the bounds of an institution or community; "extramural sports"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301293405">
	<b:glossaryEntry>used of competition between colleges or universities; "intercollegiate basketball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301293549">
	<b:glossaryEntry>between two or more institutions etc; "an intermural track meet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301293670"
	 b:glossaryEntry="used of competition or cooperation between secondary schools"/>
<rdf:Description rdf:about="&a;301293806">
	<b:glossaryEntry>functioning outside the boundaries or precincts of an organized unit; "extramural hospital care and treatment"; "extramural studies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301293992">
	<b:glossaryEntry>(law) within the legal power or authority or a person or official or body etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301294127">
	<b:glossaryEntry>(law) beyond the legal power or authority of a person or official or body etc; "an ultra vires contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301294289">
	<b:glossaryEntry>belonging to a thing by its very nature; "form was treated as something intrinsic, as the very essence of the thing"- John Dewey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301294559">
	<b:glossaryEntry>existing as an essential constituent or characteristic; "the Ptolemaic system with its built-in concept of periodicity"; "a constitutional inability to tell the truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301294830">
	<b:glossaryEntry>innermost or essential; "the inner logic of Cubism"; "the internal contradictions of the theory"; "the intimate structure of matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301295036">
	<b:glossaryEntry>not forming an essential part of a thing or arising or originating from the outside; "extrinsic evidence"; "an extrinsic feature of the new building"; "that style is something extrinsic to the subject"; "looking for extrinsic aid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301295430">
	<b:glossaryEntry>associated by chance and not an integral part; "poetry is something to which words are the accidental, not by any means the essential form"- Frederick W. Robertson; "they had to decide whether his misconduct was adventitious or the result of a flaw in his character"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301295768">
	<b:glossaryEntry>added or derived from something outside; not inherent; "an adscititious habit rather than an inherent taste"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301295935">
	<b:glossaryEntry>not contained in or deriving from the essential nature of something; "an economic theory alien to the spirit of capitalism"; "the mysticism so foreign to the French mind and temper"; "jealousy is foreign to her nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301296215">
	<b:glossaryEntry>coming from the outside; "extraneous light in the camera spoiled the photograph"; "relying upon an extraneous income"; "disdaining outside pressure groups"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301296448">
	<b:glossaryEntry>not essential; "the ballet struck me as extraneous and somewhat out of keeping with the rest of the play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301296610"
	 b:glossaryEntry="examining own sensory and perceptual experiences"/>
<rdf:Description rdf:about="&a;301296769"
	 b:glossaryEntry="introspective"/>
<rdf:Description rdf:about="&a;301296843"
	 b:glossaryEntry="not introspective; examining what is outside yourself"/>
<rdf:Description rdf:about="&a;301296988">
	<b:glossaryEntry>(psychology) directed inward; marked by interest in yourself or concerned with inner feelings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301297230"
	 b:glossaryEntry="characterized by introversion"/>
<rdf:Description rdf:about="&a;301297344"
	 b:glossaryEntry="somewhat introverted"/>
<rdf:Description rdf:about="&a;301297433">
	<b:glossaryEntry>(psychology) directed outward; marked by interest in others or concerned with external reality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301297673"
	 b:glossaryEntry="characterized by extroversion"/>
<rdf:Description rdf:about="&a;301297828"
	 b:glossaryEntry="somewhat extroverted"/>
<rdf:Description rdf:about="&a;301297918">
	<b:glossaryEntry>(psychology) intermediate between introversive and extroversive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301298057">
	<b:glossaryEntry>tending to intrude (especially upon privacy); "she felt her presence there was intrusive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301298274">
	<b:glossaryEntry>gradually intrusive without right or permision; "we moved back from the encroaching tide"; "invasive tourists"; "trespassing hunters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301298496">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intrusive in a meddling or offensive manner; "an interfering old woman"; "bustling about self-importantly making an officious nuisance of himself"; "busy about other people''s business"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301298794"
	 b:glossaryEntry="not interfering or meddling"/>
<rdf:Description rdf:about="&a;301298913"
	 b:glossaryEntry='thrusting inward; "an intrusive arm of the sea"'/>
<rdf:Description rdf:about="&a;301299052"
	 b:glossaryEntry="projecting inward"/>
<rdf:Description rdf:about="&a;301299125"
	 b:glossaryEntry="thrusting outward"/>
<rdf:Description rdf:about="&a;301299379"
	 b:glossaryEntry='jutting or overhanging; "beetle brows"'/>
<rdf:Description rdf:about="&a;301299481"
	 b:glossaryEntry="curving outward"/>
<rdf:Description rdf:about="&a;301299603"
	 b:glossaryEntry='(of upper front teeth) projecting outward; "buck teeth"'/>
<rdf:Description rdf:about="&a;301299724"
	 b:glossaryEntry="sticking out; protruding"/>
<rdf:Description rdf:about="&a;301299804">
	<b:glossaryEntry>extending out above or beyond a surface or boundary; "the jutting limb of a tree"; "massive projected buttresses"; "his protruding ribs"; "a pile of boards sticking over the end of his truck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301300119">
	<b:glossaryEntry>having an upper part projecting beyond the lower; "an overshot jaw"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301300241">
	<b:glossaryEntry>(especially of eyes) bulging or protruding as with fear; "with eyes starting from their sockets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301300392">
	<b:glossaryEntry>having a lower part projecting beyond the upper; "an underhung jaw"; "undershot bulldog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301300561">
	<b:glossaryEntry>(biology; anatomy) having a swelling on one side; "the ventricose gullet of an insect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301300717">
	<b:glossaryEntry>(geology) of rock material; forced while molten into cracks between layers of other rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301300879">
	<b:glossaryEntry>igneous rock that has solidified beneath the earth''s surface; granite or diorite or gabbro</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301301047">
	<b:glossaryEntry>(geology) of rock material; forced out while molten through cracks in the earth''s surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301301210">
	<b:glossaryEntry xml:space='preserve'><![CDATA[igneous rock produced by eruption and solidified on or near the earth''s surface; rhyolite or andesite or basalt; "volcanic rock includes the volcanic glass obsidian"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301301441">
	<b:glossaryEntry>marked by a tendency to spread especially into healthy tissue; "invasive cancer cells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301301600"
	 b:glossaryEntry='tending to spread quickly; "an aggressive tumor"'/>
<rdf:Description rdf:about="&a;301301723"
	 b:glossaryEntry="not invading healthy tissue"/>
<rdf:Description rdf:about="&a;301301805">
	<b:glossaryEntry>(medicine) relating to a technique in which the body is entered by puncture or incision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301301947">
	<b:glossaryEntry>(medicine) relating to a technique that does not involve puncturing the skin or entering a body cavity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301302107">
	<b:glossaryEntry>imparting strength and vitality; "the invigorating mountain air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301302374"
	 b:glossaryEntry="giving spirit and vivacity"/>
<rdf:Description rdf:about="&a;301302469"
	 b:glossaryEntry='imparting vitality and energy; "the bracing mountain air"'/>
<rdf:Description rdf:about="&a;301302643"
	 b:glossaryEntry="(used of a medicine; archaic) strengthening"/>
<rdf:Description rdf:about="&a;301302744">
	<b:glossaryEntry>making lively and cheerful; "the exhilarating effect of mountain air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301302886"
	 b:glossaryEntry="invigorating physically or mentally"/>
<rdf:Description rdf:about="&a;301302994">
	<b:glossaryEntry>giving or having the power to give life and spirit; "returning the life-giving humus to the land"- Louis Bromfield; "life-giving love and praise"; "the vital rays of the warming sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301303255">
	<b:glossaryEntry>tending to impart new life and vigor to; "the renewing warmth of the sunshine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301303428"
	 b:glossaryEntry="impairing the strength and vitality"/>
<rdf:Description rdf:about="&a;301303558"
	 b:glossaryEntry="causing debilitation"/>
<rdf:Description rdf:about="&a;301303675"
	 b:glossaryEntry='having a debilitating effect; "a killing job in the hot sun"'/>
<rdf:Description rdf:about="&a;301303813"
	 b:glossaryEntry="done by invitation"/>
<rdf:Description rdf:about="&a;301303939"
	 b:glossaryEntry='only invitees are welcome; "an invitational tournament"'/>
<rdf:Description rdf:about="&a;301304069"
	 b:glossaryEntry='requested; "only solicited manuscripts will be considered"'/>
<rdf:Description rdf:about="&a;301304183"
	 b:glossaryEntry="not invited"/>
<rdf:Description rdf:about="&a;301304340">
	<b:glossaryEntry>of those who go where they are not invited; "gate-crashing guests disrupted the party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301304486">
	<b:glossaryEntry>not invited or requested; "unbidden guests"; "comments unbid and unwelcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301304634"
	 b:glossaryEntry='not requested; "an unsolicited nomination"'/>
<rdf:Description rdf:about="&a;301304745"
	 b:glossaryEntry='attractive and tempting; "an inviting offer"'/>
<rdf:Description rdf:about="&a;301304916"
	 b:glossaryEntry='conveying an invitation; "a brief invitatory note"'/>
<rdf:Description rdf:about="&a;301305023">
	<b:glossaryEntry>very pleasantly inviting; "a tantalizing aroma"; "a tempting repast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301305160">
	<b:glossaryEntry>arousing desire or expectation for something unattainable or mockingly out of reach; "a tantalizing taste of success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301305335"
	 b:glossaryEntry="neither attractive nor tempting"/>
<rdf:Description rdf:about="&a;301305459"
	 b:glossaryEntry='not appealing to the senses; "untempting food"'/>
<rdf:Description rdf:about="&a;301305577">
	<b:glossaryEntry>in an artificial environment outside the living organism; "an egg fertilized in vitro"; "in vitro fertilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301305744">
	<b:glossaryEntry>(biology) within a living organism; "metabolic studies conducted in vivo"; "in vivo techniques"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301305893"
	 b:glossaryEntry="(of linens or clothes) smoothed with a hot iron"/>
<rdf:Description rdf:about="&a;301306047"
	 b:glossaryEntry="compacted by ironing"/>
<rdf:Description rdf:about="&a;301306121"
	 b:glossaryEntry="made smooth by ironing"/>
<rdf:Description rdf:about="&a;301306211">
	<b:glossaryEntry>(of linens or clothes) not ironed; "a pile of unironed laundry"; "wore unironed jeans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301306435">
	<b:glossaryEntry>used of fabrics that do not require ironing; "drip-dry shirts for travel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301306581"
	 b:glossaryEntry="(of laundry) dried but not ironed"/>
<rdf:Description rdf:about="&a;301306671"
	 b:glossaryEntry="(of clothing) not smoothed with heat"/>
<rdf:Description rdf:about="&a;301306763">
	<b:glossaryEntry>made or become wrinkled as by crushing or folding; "tired travelers in wrinkled clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301306960">
	<b:glossaryEntry>having wrinkles; "crumpled paper"; "her skirt had become creased"; "a rumpled gray suit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301307123">
	<b:glossaryEntry>(used of the skin of the face) contracted into wrinkles; "a puckered-up mouth waiting to be kissed"; "her mischievous puckered nose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301307324">
	<b:glossaryEntry>not having been made smooth by having hands run over the surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301307445"
	 b:glossaryEntry="not wrinkled or creased"/>
<rdf:Description rdf:about="&a;301307539"
	 b:glossaryEntry="invariant with respect to direction"/>
<rdf:Description rdf:about="&a;301307661">
	<b:glossaryEntry>(physics) having properties with uniform values along all axes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301307779">
	<b:glossaryEntry>not invariant with respect to direction; "anisotropic crystals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301307918">
	<b:glossaryEntry>(physics) having properties with different values along different axes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301308059">
	<b:glossaryEntry>showing or causing joy and pleasure; especially made happy; "glad you are here"; "glad that they succeeded"; "gave a glad shout"; "a glad smile"; "heard the glad news"; "a glad occasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301308350">
	<b:glossaryEntry>experiencing or expressing gladness or joy; "a gladsome smile"; "a gladsome occasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301308490">
	<b:glossaryEntry>experiencing pleasure or joy; "happy you are here"; "pleased with the good news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301308632">
	<b:glossaryEntry>experiencing or showing or causing sorrow or unhappiness; "feeling sad because his dog had died"; "a sad movie"; "sad news"; "Better by far that you should forget and smile / Than that you should remember and be sad"- Christina Rossetti</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301309080"
	 b:glossaryEntry='tinged with sadness; "a movie with a bittersweet ending"'/>
<rdf:Description rdf:about="&a;301309194">
	<b:glossaryEntry>causing or suggestive of sorrow or gloom; "a gloomy outlook"; "gloomy news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301309360">
	<b:glossaryEntry xml:space='preserve'><![CDATA[filled with or evoking sadness; "the child''s doleful expression"; "stared with mournful eyes"; "mournful news"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301309535"
	 b:glossaryEntry="depressed"/>
<rdf:Description rdf:about="&a;301309603">
	<b:glossaryEntry>characterized by or causing or expressing sadness; "growing more melancholy every hour"; "her melancholic smile"; "we acquainted him with the melancholy truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301309833">
	<b:glossaryEntry>showing pensive sadness; "the sensitive and wistful response of a poet to the gentler phases of beauty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301310000">
	<b:glossaryEntry>very sad; especially involving grief or death or destruction; "a tragic face"; "a tragic plight"; "a tragic accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301310181">
	<b:glossaryEntry xml:space='preserve'><![CDATA[manifesting both tragic and comic aspects; "the tragicomic disparity...between''s man''s aspirations and his accomplishments"- B.R.Redman]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301310388">
	<b:glossaryEntry>full of longing or unfulfilled desire; "those wistful little ads that the lovelorn place in the classifieds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301310561">
	<b:glossaryEntry>full of or producing joy; "make a joyful noise"; "a joyful occasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301310754"
	 b:glossaryEntry='experiencing or bestowing celestial joy; "beatific peace"'/>
<rdf:Description rdf:about="&a;301310866"
	 b:glossaryEntry="extremely joyful"/>
<rdf:Description rdf:about="&a;301310938">
	<b:glossaryEntry>experiencing or marked by or expressing sorrow especially that associated with irreparable loss; "sorrowful widows"; "a sorrowful tale of death and despair"; "sorrowful news"; "even in laughter the heart is sorrowful"- Proverbs 14:13</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301311497">
	<b:glossaryEntry xml:space='preserve'><![CDATA[experiencing intense pain especially mental pain; "an anguished conscience"; "a small tormented schoolboy"; "a tortured witness to another''s humiliation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301311729"
	 b:glossaryEntry='sorrowful through loss or deprivation; "bereft of hope"'/>
<rdf:Description rdf:about="&a;301311905"
	 b:glossaryEntry='expressive of severe grief or regret; "shed bitter tears"'/>
<rdf:Description rdf:about="&a;301312015"
	 b:glossaryEntry="full of sorrow"/>
<rdf:Description rdf:about="&a;301312115"
	 b:glossaryEntry="showing sorrow"/>
<rdf:Description rdf:about="&a;301312229">
	<b:glossaryEntry>expressing sorrow often for something past; "an elegiac lament for youthful ideals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301312366">
	<b:glossaryEntry xml:space='preserve'><![CDATA[causing or marked by grief or anguish; "a grievous loss"; "a grievous cry"; "her sigh was heartbreaking"; "the heartrending words of Rabin''s granddaughter"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301312607">
	<b:glossaryEntry>an archaic word for mournful; "tell thou the lamentable tale of me, And send the hearers weeping to their beds"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301312788">
	<b:glossaryEntry>vocally expressing grief or sorrow or resembling such expression; "lamenting sinners"; "wailing mourners"; "the wailing wind"; "wailful bagpipes"; "tangle her desires with wailful sonnets"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301313065"
	 b:glossaryEntry="excessively mournful"/>
<rdf:Description rdf:about="&a;301313142"
	 b:glossaryEntry="expressing sorrow"/>
<rdf:Description rdf:about="&a;301313226">
	<b:glossaryEntry>expressive of sorrow; "When I am dead, my dearest, / Sing no sad songs for me"- Christina Rossetti</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301313374">
	<b:glossaryEntry>affected by or full of grief or woe; "his sorrow...made him look...haggard and...woebegone"- George du Maurier</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301313549"
	 b:glossaryEntry='full of or characterized by joy; "felt a joyous abandon"'/>
<rdf:Description rdf:about="&a;301313820"
	 b:glossaryEntry="feeling great rapture or delight"/>
<rdf:Description rdf:about="&a;301313944"
	 b:glossaryEntry="full of high-spirited delight"/>
<rdf:Description rdf:about="&a;301314056">
	<b:glossaryEntry>offering fun and gaiety; "a gala ball after the inauguration"; "a festive (or festal) occasion"; "gay and exciting night life"; "a merry evening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301314288">
	<b:glossaryEntry>full of or showing high-spirited merriment; "when hearts were young and gay"; "a poet could not but be gay, in such a jocund company"- Wordsworth; "the jolly crowd at the reunion"; "jolly old Saint Nick"; "a jovial old gentleman"; "have a merry Christmas"; "peals of merry laughter"; "a mirthful laugh"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301314685">
	<b:glossaryEntry>not experiencing or inspiring joy; "a joyless man"; "a joyless occasion"; "joyless evenings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301314939">
	<b:glossaryEntry>suited to or suggestive of a grave or burial; "funereal gloom"; "hollow sepulchral tones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301315096"
	 b:glossaryEntry="lacking mirth"/>
<rdf:Description rdf:about="&a;301315176"
	 b:glossaryEntry="not smiling"/>
<rdf:Description rdf:about="&a;301315243"
	 b:glossaryEntry="full of juice"/>
<rdf:Description rdf:about="&a;301315344">
	<b:glossaryEntry>full of juice; "lush fruits"; "succulent roast beef"; "succulent plants with thick fleshy leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301315504"
	 b:glossaryEntry='abounding in sap; "sappy maple trees"; "sappy kindling wood"'/>
<rdf:Description rdf:about="&a;301315616"
	 b:glossaryEntry="lacking juice"/>
<rdf:Description rdf:about="&a;301315703">
	<b:glossaryEntry>destitute of sap and other vital juices; dry; "the rats and roaches scurrying along the sapless planks"- Norman Mailer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301315875">
	<b:glossaryEntry>used especially of what is legally or ethically right or proper or fitting; "a just and lasting peace"- A.Lincoln; "a kind and just man"; "a just reward"; "his just inheritance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301316247"
	 b:glossaryEntry="acceptable to your conscience"/>
<rdf:Description rdf:about="&a;301316335"
	 b:glossaryEntry="being precisely fitting and right"/>
<rdf:Description rdf:about="&a;301316429">
	<b:glossaryEntry>given or inflicted in requital according to merits or deserts; "retributive justice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301316585"
	 b:glossaryEntry='legally valid; "a rightful inheritance"'/>
<rdf:Description rdf:about="&a;301316682">
	<b:glossaryEntry>violating principles of justice; "unjust punishment"; "an unjust judge"; "an unjust accusation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301316938">
	<b:glossaryEntry>affording grounds for legal action; "slander is an actionable offense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301317065"
	 b:glossaryEntry='not just or fair; "a wrongful act"; "a wrongful charge"'/>
<rdf:Description rdf:about="&a;301317175"
	 b:glossaryEntry='properly earned or deserved; "a merited success"'/>
<rdf:Description rdf:about="&a;301317331">
	<b:glossaryEntry>fitting or appropriate and deserved; used especially of punishment; "condign censure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301317470">
	<b:glossaryEntry>proper and appropriate; fitting; "richly deserved punishment"; "due esteem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301317606"
	 b:glossaryEntry='merited through behavior; "a well-earned rest"'/>
<rdf:Description rdf:about="&a;301317705">
	<b:glossaryEntry>not merited or deserved; "received an unmerited honorary degree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301317861"
	 b:glossaryEntry='without cause; "a gratuitous insult"'/>
<rdf:Description rdf:about="&a;301317954">
	<b:glossaryEntry>not deserved or earned; "has an undeserved reputation as a coward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301318088">
	<b:glossaryEntry>fitted with or secured by a key; "a keyed instrument"; "the locks have not yet been keyed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301318230">
	<b:glossaryEntry>lacking or not requiring a key; "a keyless lock operated by a series of pushbuttons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301318368">
	<b:glossaryEntry>having or showing a tender and considerate and helpful nature; used especially of persons and their behavior; "kind to sick patients"; "a kind master"; "kind words showing understanding and sympathy"; "thanked her for her kind letter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301318851">
	<b:glossaryEntry>characterized by kindness and warm courtesy especially of a king to his subjects; "our benignant king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301319020">
	<b:glossaryEntry>of disposition or manner; "the benign ruler of millions"; "benign intentions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301319150">
	<b:glossaryEntry>showing or motivated by sympathy and understanding; "was charitable in his opinions of others"; "kindly criticism"; "a kindly act"; "sympathetic words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301319381">
	<b:glossaryEntry>having or showing a kindly or tender nature; "the gentle touch of her hand"; "her gentle manner was comforting"; "a gentle sensitive nature"; "gentle blue eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301319594">
	<b:glossaryEntry>having or proceeding from an innately kind disposition; "a generous and kindhearted teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301319744">
	<b:glossaryEntry>lacking kindness; "a thoughtless and unkind remark"; "the unkindest cut of all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301320002">
	<b:glossaryEntry>(of speech) harsh or hurtful in tone or character; "cutting remarks"; "edged satire"; "a stinging comment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301320181">
	<b:glossaryEntry>extremely unkind or cruel; "had harsh words"; "a harsh and unlovable old tyrant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301320313"
	 b:glossaryEntry='causing hurt; "her hurtful unconsidered words"'/>
<rdf:Description rdf:about="&a;301320413"
	 b:glossaryEntry='lacking in sympathy and kindness; "unkindly acts"'/>
<rdf:Description rdf:about="&a;301320533">
	<b:glossaryEntry>apprehended with certainty; "a known quantity"; "the limits of the known world"; "a musician known throughout the world"; "a known criminal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301320905">
	<b:glossaryEntry xml:space='preserve'><![CDATA[most familiar or renowned; "Stevenson''s best-known work is probably ''Treasure Island''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301321048">
	<b:glossaryEntry>more familiar or renowned than the other of two; "the better-known book of the two"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301321211">
	<b:glossaryEntry>widely known and esteemed; "a famous actor"; "a celebrated musician"; "a famed scientist"; "an illustrious judge"; "a notable historian"; "a renowned painter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301321498">
	<b:glossaryEntry>having the identity known or established; "the identified bodies were released for burial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301321645">
	<b:glossaryEntry>so celebrated as to having taken on the nature of a legend; "the legendary exploits of the arctic trailblazers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301321812">
	<b:glossaryEntry>widely known and spoken of; "her proverbial lateness"; "the proverbial absentiminded professor"; "your proverbial dizzy blonde"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301321996">
	<b:glossaryEntry>widely or fully known; "a well-known politician"; "well-known facts"; "a politician who is well known"; "these facts are well known"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301322204">
	<b:glossaryEntry>not known; "an unknown amount"; "an unknown island"; "an unknown writer"; "an unknown source"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301322531">
	<b:glossaryEntry>(of unknown regions) not yet surveyed or investigated; "uncharted seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301322681">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually used with `to'') occurring or existing without the knowledge of; "a crisis unbeknown to me"; "she had been ill for months, unbeknownst to the family"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301322914"
	 b:glossaryEntry='eluding diagnosis; "undiagnosed disease"'/>
<rdf:Description rdf:about="&a;301323012"
	 b:glossaryEntry='not yet discovered; "undiscovered islands"'/>
<rdf:Description rdf:about="&a;301323126">
	<b:glossaryEntry>previously unknown; "a first novel by an unheard of writer"; "developments on an unheard-of scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301323281">
	<b:glossaryEntry>not yet identified; "an unidentifed species"; "an unidentified witness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301323411">
	<b:glossaryEntry>beyond and outside the ordinary range of human experience or understanding; "philosophers...often explicitly reject the notion of any transcendent reality beyond thought...and claim to be concerned only with thought itself..."- W.P.Alston; "the unknowable mysteries of lifer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301323759">
	<b:glossaryEntry>fully apprehended as to purport or meaning or explanation; "the understood conditions of troop withdrawal were clear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301323969">
	<b:glossaryEntry>fully understood or grasped; "dangers not yet appreciated"; "these apprehended truths"; "a thing comprehended is a thing known as fully as it can be known"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301324211">
	<b:glossaryEntry>understood in a certain way; made sense of; "a word taken literally"; "a smile taken as consent"; "an open door interpreted as an invitation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301324418">
	<b:glossaryEntry>not understood; "should not tamely submit to the unpredictable and ununderstood cycles of wars"- Psychiatry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301324656">
	<b:glossaryEntry>wrongly understood; "a misunderstood criticism"; "a misunderstood question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301324791"
	 b:glossaryEntry='not fully understood; "an uncomprehended mystery"'/>
<rdf:Description rdf:about="&a;301324901">
	<b:glossaryEntry>not thought over and arranged systematically in the mind; not absorbed or assimilated mentally; "an undigested mass of facts gathered at random"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325102">
	<b:glossaryEntry>not fully apprehended; "the ungrasped infinite ground of all being"- Philip Wheelwright</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325245">
	<b:glossaryEntry>bearing or marked with a label or tag; "properly labeled luggage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325384">
	<b:glossaryEntry>lacking a label or tag; "unlabeled luggage is liable to be lost"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325528">
	<b:glossaryEntry>mourned or grieved for; "the imprint of our wise and lamented friend"- A.E.Stevenson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325667">
	<b:glossaryEntry>not grieved for; causing no mourning; "interred in an unlamented grave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325807">
	<b:glossaryEntry>relating to or characteristic of or occurring on land; "land vehicles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301325985"
	 b:glossaryEntry='on the edge of the land; "an onshore lighthouse"'/>
<rdf:Description rdf:about="&a;301326087">
	<b:glossaryEntry>traveling or passing over land; "an overland journey"; "the overland route used by Marco Polo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301326236">
	<b:glossaryEntry>relating to or characteristic of or occurring on the sea or ships; "sea stories"; "sea smells"; "sea traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301326542">
	<b:glossaryEntry>of or taking place in the deeper parts of the sea; "deep-sea fishing"; "deep-sea exploration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301326690"
	 b:glossaryEntry='used on the high seas; "seafaring vessels"'/>
<rdf:Description rdf:about="&a;301326812">
	<b:glossaryEntry>constituting or living in the open sea; "oceanic waters"; "oceanic life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301326938"
	 b:glossaryEntry='at some distance from the shore; "offshore oil reserves"'/>
<rdf:Description rdf:about="&a;301327049">
	<b:glossaryEntry>being or passing over or across the sea; "some overseas trade in grain arose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301327191">
	<b:glossaryEntry>taking place or existing on board a ship; "a shipboard fire"; "shipboard romances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301327329">
	<b:glossaryEntry>formed or situated or occurring beneath th ocean or the ocean bed; "suboceanic oil resources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301327490">
	<b:glossaryEntry>relating to or characteristic of or occurring in the air; "air war"; "air safety"; "air travel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301327728">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in or consisting of or belonging to the air; "small aerial creatures such as butterflies"; "the hummingbird''s aerial dance among the flowers"; "aerial particles"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301327942"
	 b:glossaryEntry='(botany) growing in air; "aerial roots of a philodendron"'/>
<rdf:Description rdf:about="&a;301328052">
	<b:glossaryEntry>operating in the air; especially of or for or by means of aircraft; "aerial warfare"; "aerial photography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301328211">
	<b:glossaryEntry>of or relating to passage through the air especially aviation; "a flying time of three hours between cities"; "unidentified flying objects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301328403"
	 b:glossaryEntry="crowned with or as if with laurel symbolizing victory"/>
<rdf:Description rdf:about="&a;301328533">
	<b:glossaryEntry>not crowned with laurel; having no acclaim or reward; "the unlaureled heroism of endurance"- Francis Parkman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301328712">
	<b:glossaryEntry>above average in size or number or quantity or magnitude or extent; "a large city"; "set out for the big city"; "a large sum"; "a big (or large) barn"; "a large family"; "big businesses"; "a big expenditure"; "a large number of newspapers"; "a big group of scientists"; "large areas of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301329930">
	<b:glossaryEntry>fairly large; "a sizable fortune"; "an ample waistline"; "of ample proportions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301330082"
	 b:glossaryEntry="inconceivably large"/>
<rdf:Description rdf:about="&a;301330184">
	<b:glossaryEntry>of headlines; spanning the width of the page; "banner headlines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301330301"
	 b:glossaryEntry="large or big relative to something else"/>
<rdf:Description rdf:about="&a;301330402"
	 b:glossaryEntry="greatest in size of those under consideration"/>
<rdf:Description rdf:about="&a;301330522"
	 b:glossaryEntry="somewhat large"/>
<rdf:Description rdf:about="&a;301330600">
	<b:glossaryEntry>as of a photograph; made larger; "the enlarged photograph revealed many details"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301330746">
	<b:glossaryEntry>being puffed out; used of hair style or clothing; "a bouffant skirt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301330877">
	<b:glossaryEntry>very large in expanse or scope; "a broad lawn"; "the wide plains"; "a spacious view"; "spacious skies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301331049"
	 b:glossaryEntry="of large size for its weight"/>
<rdf:Description rdf:about="&a;301331129"
	 b:glossaryEntry='large in capacity; "she carried a capacious bag"'/>
<rdf:Description rdf:about="&a;301331233">
	<b:glossaryEntry>so great in size or force or extent as to elicit awe; "colossal crumbling ruins of an ancient temple"; "has a colossal nerve"; "a prodigious storm"; "a stupendous field of grass"; "stupendous demand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301331513"
	 b:glossaryEntry='large in quantity or size; "deep cuts in the budget"'/>
<rdf:Description rdf:about="&a;301331616"
	 b:glossaryEntry='large enough for two; "a double bed"; "a double room"'/>
<rdf:Description rdf:about="&a;301331722">
	<b:glossaryEntry>extraordinarily large in size or extent or amount or power or degree; "an enormous boulder"; "enormous expenses"; "tremendous sweeping plains"; "a tremendous face in human experience; that...civilization should be dependent on technology"- Walter Lippman; "a plane took off with a tremendous noise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301332088"
	 b:glossaryEntry="inconceivably extended in space or time"/>
<rdf:Description rdf:about="&a;301332180"
	 b:glossaryEntry='of great mass; huge and bulky; "a jumbo jeg"'/>
<rdf:Description rdf:about="&a;301332311">
	<b:glossaryEntry>surpassing the ordinary especially in size or scale; "an epic voyage"; "of heroic proportions"; "heroic sculpture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301332504">
	<b:glossaryEntry>large in extent or range; "an extensive Roman settlement in northwest England"; "extended farm lands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301332672">
	<b:glossaryEntry>so exceedingly large or extensive as to suggest a giant or mammoth; "a gigantic redwood"; "gigantic disappointment"; "a mammoth ship"; "a mammoth multinational corporation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301332909">
	<b:glossaryEntry>relatively large in size or number or extent; larger than others of its kind; "a great juicy steak"; "a great multitude"; "the great auk"; "a great old oak"; "a great ocean liner"; "a great delay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301333157">
	<b:glossaryEntry>unusually great in size or amount or degree or especially extent or scope; "huge government spending"; "huge country estates"; "huge popular demand for higher education"; "a huge wave"; "the Los Angeles aqueduct winds like an immense snake along the base of the mountains"; "immense numbers of birds"; "at vast (or immense) expense"; "the vast reaches of outer space"; "the vast accumulation of knowledge...which we call civilization"- W.R.Inge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301333669">
	<b:glossaryEntry>of great size and bulk; "a hulking figure of a man"; "three hulking battleships"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301333811"
	 b:glossaryEntry='(used informally) very large; "a thumping loss"'/>
<rdf:Description rdf:about="&a;301333948"
	 b:glossaryEntry='extra large; "a king-size bed"'/>
<rdf:Description rdf:about="&a;301334047">
	<b:glossaryEntry>unusually large in scope; "a large-scale attack on AIDS is needed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301334171"
	 b:glossaryEntry='constructed or drawn to a big scale; "large-scale maps"'/>
<rdf:Description rdf:about="&a;301334284">
	<b:glossaryEntry>being of the same size as an original; "a life-size sculpture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301334427">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(combining form) very large in scale or scope or capability; "`macro'' in the word `macroscopic'' is a combining form"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301334595">
	<b:glossaryEntry>(informal) appropriate to the size of a man; "a man-sized piece of cake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301334723">
	<b:glossaryEntry xml:space='preserve'><![CDATA[imposing in size or bulk or solidity; "massive oak doors"; "Moore''s massive sculptures"; "the monolithic proportions of Stalinist architecture"; "a monumental scale"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301334968">
	<b:glossaryEntry>imposing in scale or scope or degree or power; "massive retaliatory power"; "a massive increase in oil prices"; "massive changes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301335151"
	 b:glossaryEntry="abnormally large"/>
<rdf:Description rdf:about="&a;301335223">
	<b:glossaryEntry>like a mountain in size and impressiveness; "mountainous waves"; "a mountainous dark man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301335370"
	 b:glossaryEntry="larger than normal for its kind"/>
<rdf:Description rdf:about="&a;301335489"
	 b:glossaryEntry="excessively large"/>
<rdf:Description rdf:about="&a;301335574">
	<b:glossaryEntry>very large; of exceptional size for its kind; "won by a plumping majority"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301335703">
	<b:glossaryEntry>(used especially of beds) not as large as king-size; "a queen-sized bed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301335846"
	 b:glossaryEntry="allowing ample room for ranging"/>
<rdf:Description rdf:about="&a;301335929"
	 b:glossaryEntry='extremely large; "another super skyscraper"'/>
<rdf:Description rdf:about="&a;301336024"
	 b:glossaryEntry="of great force or power"/>
<rdf:Description rdf:about="&a;301336101"
	 b:glossaryEntry='large in volume or bulk; "a voluminous skirt"'/>
<rdf:Description rdf:about="&a;301336204">
	<b:glossaryEntry>(British informal) enormous; "a whacking phone bill"; "a whacking lie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301336329">
	<b:glossaryEntry xml:space='preserve'><![CDATA[including much; "the pianist''s wide-ranging repertoire"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301336443">
	<b:glossaryEntry>limited or below average in number or quantity or magnitude or extent; "a little dining room"; "a small house"; "read the small print"; "a little (or small) group"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301337063">
	<b:glossaryEntry>very small; "diminutive in stature"; "a lilliputian chest of drawers"; "her petite figure"; "tiny feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301337271"
	 b:glossaryEntry='used informally; very small; "a wee tot"'/>
<rdf:Description rdf:about="&a;301337438">
	<b:glossaryEntry>(informal) small and insignificant; "we stayed in a dinky old hotel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301337558"
	 b:glossaryEntry='atypically small; "dwarf tree"; "dwarf star"'/>
<rdf:Description rdf:about="&a;301337665">
	<b:glossaryEntry>small and delicate; "she was an elfin creature--graceful and delicate"; "obsessed by things elfin and small"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301337835"
	 b:glossaryEntry='very small; "be sure to read the fine print"'/>
<rdf:Description rdf:about="&a;301337930"
	 b:glossaryEntry="used of small deformed creatures"/>
<rdf:Description rdf:about="&a;301338016"
	 b:glossaryEntry="half the usual or regular size"/>
<rdf:Description rdf:about="&a;301338102">
	<b:glossaryEntry>infinitely or immeasurably small; "two minute whiplike threads of protoplasm"; "reduced to a microscopic scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301338296">
	<b:glossaryEntry>having or being distinguished by diminutive size; "the least bittern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301338439">
	<b:glossaryEntry>smaller in size or amount or value; "the lesser powers of Europe"; "the lesser anteater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301338580"
	 b:glossaryEntry="extremely small in scale or scope or capability"/>
<rdf:Description rdf:about="&a;301338679"
	 b:glossaryEntry='being on a very small scale; "a miniature camera"'/>
<rdf:Description rdf:about="&a;301338784">
	<b:glossaryEntry>very small; "a minuscule kitchen"; "a minuscule amount of rain fell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301338920"
	 b:glossaryEntry="(used especially of persons) of inferior size"/>
<rdf:Description rdf:about="&a;301339034">
	<b:glossaryEntry>small in quantity; "slender wages"; "a slim chance of winning"; "a small surplus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301339176"
	 b:glossaryEntry="small or little relative to something else"/>
<rdf:Description rdf:about="&a;301339282"
	 b:glossaryEntry="rather small"/>
<rdf:Description rdf:about="&a;301339349">
	<b:glossaryEntry>created or drawn on a small scale; "small-scale maps"; "a small-scale model"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301339483"
	 b:glossaryEntry="smaller than normal for its kind"/>
<rdf:Description rdf:about="&a;301339584">
	<b:glossaryEntry>greater in size or importance or degree; "for the greater good of the community"; "the greater Antilles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301339742">
	<b:glossaryEntry>of less size or importance; "the lesser anteater"; "the lesser of two evils"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301339871">
	<b:glossaryEntry>conformable to or allowed by law; "lawful methods of dissent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301340057">
	<b:glossaryEntry>(of individuals) adhering strictly to laws and rules and customs; "law-abiding citizens"; "observant of the speed limit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301340247">
	<b:glossaryEntry>contrary to or prohibited by or defiant of law; "unlawful measures"; "unlawful money"; "unlawful hunters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301340515">
	<b:glossaryEntry>disobedient to or defiant of law; "lawless bands roaming the plains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301340649"
	 b:glossaryEntry='lax in enforcing laws; "an open town"'/>
<rdf:Description rdf:about="&a;301340759">
	<b:glossaryEntry>unlawfully violating the rights of others; "wrongful death"; "a wrongful diversion of trust income"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301340913"
	 b:glossaryEntry='treated or mixed with lead; "leaded gasoline"; "leaded zinc"'/>
<rdf:Description rdf:about="&a;301341044">
	<b:glossaryEntry>(of gasoline) containing tetraethyl lead; "antiknock gasoline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301341162"
	 b:glossaryEntry='not treated with lead; "unleaded gasoline"'/>
<rdf:Description rdf:about="&a;301341288">
	<b:glossaryEntry>(of gasoline) not containing tetraethyl lead; "lead-free gasoline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301341422">
	<b:glossaryEntry>permitting leaks or leakage; "a leaky roof"; "a leaky defense system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301341651"
	 b:glossaryEntry="not airtight"/>
<rdf:Description rdf:about="&a;301341727"
	 b:glossaryEntry='leaking in drops; "a drippy faucet"'/>
<rdf:Description rdf:about="&a;301341815"
	 b:glossaryEntry="leaking out slowly"/>
<rdf:Description rdf:about="&a;301341903">
	<b:glossaryEntry>allowing passage in and out; "our unfenced and largely unpoliced border inevitably has been very porous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301342068">
	<b:glossaryEntry>of such close construction as to be impermeable; "a tight roof"; "warm in our tight little house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301342379"
	 b:glossaryEntry="not allowing air to pass in or out"/>
<rdf:Description rdf:about="&a;301342468"
	 b:glossaryEntry="completely sealed; completely airtight"/>
<rdf:Description rdf:about="&a;301342561"
	 b:glossaryEntry="not permitting the passage of water"/>
<rdf:Description rdf:about="&a;301342680"
	 b:glossaryEntry="closed so tightly as to be airtight or watertight"/>
<rdf:Description rdf:about="&a;301342782">
	<b:glossaryEntry>well and tightly constructed; "a snug house"; "a snug little sailboat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301342903"
	 b:glossaryEntry="not allowing water to pass in or out"/>
<rdf:Description rdf:about="&a;301342996"
	 b:glossaryEntry="having cracks and crevices stopped up with a filler"/>
<rdf:Description rdf:about="&a;301343137"
	 b:glossaryEntry="having narrow opening filled"/>
<rdf:Description rdf:about="&a;301343232"
	 b:glossaryEntry="having cracks blocked with weather stripping"/>
<rdf:Description rdf:about="&a;301343339"
	 b:glossaryEntry="not caulked or sealed"/>
<rdf:Description rdf:about="&a;301343416">
	<b:glossaryEntry>made light by aerating, as with yeast or baking powder; often used as a combining form; "leavened bread"; "well-leavened"; "yeast-leavened breads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301343671">
	<b:glossaryEntry>having a spongy or flaky texture; well-leavened; "light pastries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301343788"
	 b:glossaryEntry='leavened usually with yeast; "raised bread"'/>
<rdf:Description rdf:about="&a;301343884">
	<b:glossaryEntry>leavened with a small amount of fermented dough; "sourdough bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301344009">
	<b:glossaryEntry>made without leavening; "unleavened bread is often simply flour mixed with water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301344165">
	<b:glossaryEntry>not made with leavening; "most flat breads are made from unleavened dough"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301344301">
	<b:glossaryEntry>on the side away from the wind; "on the leeward side of the island"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301344440"
	 b:glossaryEntry="towards the side away from the wind"/>
<rdf:Description rdf:about="&a;301344539"
	 b:glossaryEntry='on the side exposed to the wind; "the windward islands"'/>
<rdf:Description rdf:about="&a;301344667"
	 b:glossaryEntry="towards the side exposed to wind"/>
<rdf:Description rdf:about="&a;301344765">
	<b:glossaryEntry>established by or founded upon law or official or accepted rules</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301345079">
	<b:glossaryEntry>(sports) prohibited by official rules; "an eligible pass receiver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301345200">
	<b:glossaryEntry>decreed by or proceeding from a court of justice; "a judicial decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301345326"
	 b:glossaryEntry="of or relating to law or to legal rights and obligations"/>
<rdf:Description rdf:about="&a;301345445">
	<b:glossaryEntry>authorized, sanctioned by, or in accordance with law; "a legitimate government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301345598"
	 b:glossaryEntry="formally approved and invested with legal authority"/>
<rdf:Description rdf:about="&a;301345717">
	<b:glossaryEntry>prescribed or authorized by or punishable under a statute; "statutory restrictions"; "a statutory age limit"; "statutory crimes"; "statutory rape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301345919">
	<b:glossaryEntry>before a judge or court of law; awaiting judicial determination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301346039">
	<b:glossaryEntry>prohibited by law or by official or accepted rules; "an illegal chess move"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301346510">
	<b:glossaryEntry>of a crime or misdemeanor; punishable by a fine set by a judge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301346629"
	 b:glossaryEntry="forbidden by law"/>
<rdf:Description rdf:about="&a;301346711">
	<b:glossaryEntry>distributed or sold illicitly; "the black economy pays no taxes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301346875">
	<b:glossaryEntry>involving or being or having the nature of a crime; "a criminal offense"; "criminal abuse"; "felonious intent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301347052">
	<b:glossaryEntry>obtained illegally or by improper means; "dirty money"; "ill-gotten gains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301347191">
	<b:glossaryEntry>taken for your own use in violation of a trust; "the banker absconded with embezzled funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301347356">
	<b:glossaryEntry>beyond the usual course of legal proceedings; legally unwarranted; "an extrajudicial penalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301347509">
	<b:glossaryEntry>not regulated or sanctioned by law; "there were only extralegal recourses for their grievances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301347672">
	<b:glossaryEntry>(informal) recently stolen or smuggled; "hot merchandise"; "a hot car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301347792">
	<b:glossaryEntry>contrary to or forbidden by law; "an illegitimate seizure of power"; "illicit trade"; "an outlaw strike"; "unlawful measures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301348020">
	<b:glossaryEntry>(sports) prohibited by official rules; "an ineligible pass receiver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301348163">
	<b:glossaryEntry>branded or labeled falsely and in violation of statutory requirements; "confiscated the misbranded drugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301348338"
	 b:glossaryEntry='subject to punishment by law; "a penal offense"'/>
<rdf:Description rdf:about="&a;301348450"
	 b:glossaryEntry="done or sold illicitly and secretly;"/>
<rdf:Description rdf:about="&a;301348551">
	<b:glossaryEntry>lacking legal authority; "the unratified Equal Right Amendment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301348671">
	<b:glossaryEntry>(of handwriting, print, etc.) able to be read; "legible handwriting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301348829">
	<b:glossaryEntry>(of a manuscript) having few alterations or corrections; "fair copy"; "a clean manuscript"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301348978"
	 b:glossaryEntry="easily deciphered"/>
<rdf:Description rdf:about="&a;301349073">
	<b:glossaryEntry>(of handwriting, print, etc.) not legible; "illegible handwriting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301349231">
	<b:glossaryEntry>(of a manuscript) defaced with changes; "foul (or dirty) copy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301349364"
	 b:glossaryEntry='not easily deciphered; "indecipherable handwriting"'/>
<rdf:Description rdf:about="&a;301349516"
	 b:glossaryEntry="converted from cryptic to intelligible language"/>
<rdf:Description rdf:about="&a;301349620"
	 b:glossaryEntry='not deciphered; "Linear A is still undeciphered"'/>
<rdf:Description rdf:about="&a;301349727"
	 b:glossaryEntry="of parents and children; related by blood"/>
<rdf:Description rdf:about="&a;301349861">
	<b:glossaryEntry>(of offspring) generated by procreation; "naturally begotten child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301349983">
	<b:glossaryEntry>related by blood; not adopted; "natural parent"; "biological child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301350104">
	<b:glossaryEntry>of parents and children; related by adoption; "adoptive parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301350259">
	<b:glossaryEntry>having been taken into a specific relationship; "an adopted child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301350379">
	<b:glossaryEntry>providing or receiving nurture or parental care though not related by blood or legal ties; "foster parent"; "foster child"; "foster home"; "surrogate father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301350601"
	 b:glossaryEntry="of marriages and offspring; recognized as lawful"/>
<rdf:Description rdf:about="&a;301350814"
	 b:glossaryEntry="born in wedlock; enjoying full filial rights"/>
<rdf:Description rdf:about="&a;301350922">
	<b:glossaryEntry>(of marriages) of a marriage between one of royal or noble birth and one of lower rank; valid but with the understanding that the rank of the inferior remains unchanged and offspring do not succeed to titles or property of the superior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301351228">
	<b:glossaryEntry>having a legally established claim; "the legitimate heir"; "the true and lawful king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301351390"
	 b:glossaryEntry="of marriages and offspring; not recognized as lawful"/>
<rdf:Description rdf:about="&a;301351663"
	 b:glossaryEntry="conceived in adultery"/>
<rdf:Description rdf:about="&a;301351741"
	 b:glossaryEntry="(archaic) illegitimate"/>
<rdf:Description rdf:about="&a;301351825">
	<b:glossaryEntry>born out of wedlock; "the dominions of both rulers passed away to their spurious or doubtful offspring"- E.A.Freeman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301352056"
	 b:glossaryEntry="not having a known or legally responsible father"/>
<rdf:Description rdf:about="&a;301352161">
	<b:glossaryEntry>(of marriages) illicit or informal; "in Colonial America left-handed marriages between Frenchmen and Indians were frequent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301352342">
	<b:glossaryEntry>having no legally established claim; "the wrongful heir to the throne"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301352478"
	 b:glossaryEntry="having a long narrow nose"/>
<rdf:Description rdf:about="&a;301352605"
	 b:glossaryEntry="having a broad flat-bridged nose"/>
<rdf:Description rdf:about="&a;301352767">
	<b:glossaryEntry>(of ferns) having each sporangium formed from a single epidermal cell; "leptosporangiate ferns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301352925">
	<b:glossaryEntry>(of ferns) having sporangia that arise from a group of epidermal cells; "eusporangiate ferns of the families Ophioglossaceae and Marattiaceae"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301353127">
	<b:glossaryEntry>resembling or similar; having the same or some of the same characteristics; often used in combination; "suits of like design"; "a limited circle of like minds"; "members of the cat family have like dispositions"; "as like as two peas in a pod"; "doglike devotion"; "a dreamlike quality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301353546">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(suffix) resembling or characteristic of something specified; "the `ish'' in `boyish enthusiasm'' and the `ly'' in `housewifely duties'' and the `y'' in `a long horsy face'' are all suffixes with similar semantic import"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301353831"
	 b:glossaryEntry="of the same turn of mind"/>
<rdf:Description rdf:about="&a;301353913">
	<b:glossaryEntry>of the same kind; "a locker that usually contained paper, ink, and suchlike equipment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301354054">
	<b:glossaryEntry>not like; marked by dissimilarity; "for twins they are very unlike"; "people are profoundly different"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301354252">
	<b:glossaryEntry>having the same or similar characteristics; "all politicians are alike"; "they looked utterly alike"; "friends are generaly alike in background and taste"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301354496"
	 b:glossaryEntry='not alike or similar; "as unalike as two people could be"'/>
<rdf:Description rdf:about="&a;301354638">
	<b:glossaryEntry>equal in amount or value; "like amounts"; "equivalent amounts"; "the same amount"; "gave one six blows and the other a like number"; "an equal number"; "the same number"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301354886">
	<b:glossaryEntry>not equal in amount; "they distributed unlike (or unequal) sums to the various charities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301355038">
	<b:glossaryEntry>has a good chance of being the case or of coming about; "these services are likely to be available to us all before long"; "she is likely to forget"; "a likely place for a restaurant"; "the broken limb is likely to fall"; "rain is likely"; "a likely topic for investigation"; "likely candidates for the job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301355488">
	<b:glossaryEntry>at risk of or subject to experiencing something usually unpleasant; "he is apt to lose"; "she is liable to forget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301355667">
	<b:glossaryEntry>apparently destined; "the probable consequences of going ahead with the scheme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301355801">
	<b:glossaryEntry>showing possibility of achievement or excellence; "a promising young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301355930">
	<b:glossaryEntry>has little chance of being the case or coming about; "an unlikely story; "an unlikely candidate for reelection"; "a butcher is unlikely to preach vegetarianism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301356217">
	<b:glossaryEntry>highly imaginative but unlikely; "a farfetched excuse"; "an implausible explanation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301356372">
	<b:glossaryEntry>most unlikely or unsuitable; "the last person we would have suspected"; "the last man they would have chosen for the job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301356544"
	 b:glossaryEntry='very unlikely; "outside chance"; "remote possibility"'/>
<rdf:Description rdf:about="&a;301356660">
	<b:glossaryEntry>likely but not certain to be or become true or real; "a likely result"; "he foresaw a probable loss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301356908"
	 b:glossaryEntry="equally probable"/>
<rdf:Description rdf:about="&a;301356983">
	<b:glossaryEntry>presumed to be true in the absence of proof to the contrary; "the presumed reason for his anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301357137">
	<b:glossaryEntry>having a reasonable basis for belief or acceptance; "the presumptive heir (or heir apparent)"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301357289"
	 b:glossaryEntry='appearing to be true or real; "a verisimilar tale"'/>
<rdf:Description rdf:about="&a;301357397">
	<b:glossaryEntry>not likely to be true or to occur or to have occurred; "legislation on the question is highly unlikely"; "an improbable event"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301357609"
	 b:glossaryEntry='mistakenly believed; "the supposed existence of ghosts"'/>
<rdf:Description rdf:about="&a;301357722">
	<b:glossaryEntry>having or as if having limbs (especially limbs of a specified kind); (usually used in combination; "strong-limbed")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301357918"
	 b:glossaryEntry="having sharp limbs"/>
<rdf:Description rdf:about="&a;301357995"
	 b:glossaryEntry="having no limbs"/>
<rdf:Description rdf:about="&a;301358077">
	<b:glossaryEntry>small in range or scope; "limited war"; "a limited success"; "a limited circle of friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301358311">
	<b:glossaryEntry>inhibited; "when modern man feels socially constricted his first impulse is to move"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301358453"
	 b:glossaryEntry='curbed or regulated; "controlled emotions"'/>
<rdf:Description rdf:about="&a;301358565">
	<b:glossaryEntry>limited in size or scope; "a small business"; "a newspaper with a modest circulation"; "small-scale plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301358755"
	 b:glossaryEntry='limited in size or scope; "the narrow sense of a word"'/>
<rdf:Description rdf:about="&a;301358862">
	<b:glossaryEntry>having no limits in range or scope; "to start with a theory of unlimited freedom is to end up with unlimited despotism"- Philip Rahv; "the limitless reaches of outer space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301359156">
	<b:glossaryEntry>having no apparent limits or bounds; "a bottomless supply of money"; "bottomless pockets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301359302">
	<b:glossaryEntry>resembling the ocean in apparent limitlessness in extent or degree; "the oceanic violence of his rage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301359458">
	<b:glossaryEntry>not confined or limited; "the gift of a fresh eye and an untrammeled curiosity"- Russell Lord; "the untrammeled rush that the snows had shown in the first spring sun"- Farley Mowat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301359711">
	<b:glossaryEntry>in a straight unbroken line of descent from parent to child; "lineal ancestors"; "lineal heirs"; "a direct descendant of the king"; "direct heredity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301359994">
	<b:glossaryEntry>based on or tracing descent through the female line; "matrilineal inheritance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301360144">
	<b:glossaryEntry>based on or tracing descent through the male line; "a patrilineal society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301360290">
	<b:glossaryEntry>tracing descent from either the paternal or the maternal line only</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301360429">
	<b:glossaryEntry>descended from a common ancestor but through different lines; "cousins are collateral relatives"; "an indirect descendant of the Stuarts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301360662"
	 b:glossaryEntry="(mathematics) directly proportional"/>
<rdf:Description rdf:about="&a;301360779"
	 b:glossaryEntry="linear with respect to each of two variables or positions"/>
<rdf:Description rdf:about="&a;301360891"
	 b:glossaryEntry="math; not directly proportional"/>
<rdf:Description rdf:about="&a;301360978">
	<b:glossaryEntry>having a lining or liner or a liner; often used in combination; "a lined skirt"; "a silk-lined jacket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301361132"
	 b:glossaryEntry='not having a lining or liner; "a thin unlined jacket"'/>
<rdf:Description rdf:about="&a;301361239"
	 b:glossaryEntry="on a list"/>
<rdf:Description rdf:about="&a;301361355"
	 b:glossaryEntry="entered in a catalogue"/>
<rdf:Description rdf:about="&a;301361434"
	 b:glossaryEntry='recorded or listed in a directory; "a recorded number"'/>
<rdf:Description rdf:about="&a;301361543"
	 b:glossaryEntry="(of securities) bought and sold on a stock exchange"/>
<rdf:Description rdf:about="&a;301361647"
	 b:glossaryEntry='not on a list; "an unlisted telephone number"'/>
<rdf:Description rdf:about="&a;301361801">
	<b:glossaryEntry>(of telephone numbers) not in the telephone directory; "an ex-directory number" (British usage)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301361968">
	<b:glossaryEntry>(of securities) not admitted to trading privileges in an exchange</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301362090">
	<b:glossaryEntry>(of securities) not quoted on a stock exchange; "over-the-counter stocks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301362226">
	<b:glossaryEntry>limited to the explicit meaning of a word or text; "a literal translation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301362408"
	 b:glossaryEntry="in accordance with fact or the primary meaning of a term"/>
<rdf:Description rdf:about="&a;301362532">
	<b:glossaryEntry>(used of the meanings of words or text) not literal; using figures of speech; "figurative language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301362845">
	<b:glossaryEntry>expressing, composed of, or based on an analogy; "the analogical use of a metaphor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301362985">
	<b:glossaryEntry xml:space='preserve'><![CDATA[beyond the literal or primary sense; "`hot off the press'' shows an extended sense of `hot''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301363131">
	<b:glossaryEntry>expressing one thing in terms normally denoting another; "a metaphorical expression"; "metaphoric language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301363310">
	<b:glossaryEntry xml:space='preserve'><![CDATA[using the name of one thing for that of another with which it is closely associated; "to say `he spent the evening reading Shakespeare'' is metonymic because it substitutes the author himself for the author''s works"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301363594">
	<b:glossaryEntry xml:space='preserve'><![CDATA[characterized by romantic imagery; "Turner''s vision of the rainbow...was poetic"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301363727">
	<b:glossaryEntry xml:space='preserve'><![CDATA[using the name of a part for that of the whole or the whole for the part; or the special for the general or the general for the special; or the material for the thing made of it; "to use `hand'' for `worker'' or `ten sail'' for `ten ships'' or `steel'' for `sword'' is to use a synecdochic figure of speech"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301364102">
	<b:glossaryEntry>(rhetoric) characterized by or of the nature of a trope or tropes; changed from its literal sense</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301364254"
	 b:glossaryEntry="able to read and write"/>
<rdf:Description rdf:about="&a;301364439"
	 b:glossaryEntry="written and regarded for aesthetic value rather than content"/>
<rdf:Description rdf:about="&a;301364558"
	 b:glossaryEntry="able to read and write well"/>
<rdf:Description rdf:about="&a;301364640"
	 b:glossaryEntry='knowledgeable about literature; "a literary style"'/>
<rdf:Description rdf:about="&a;301364760"
	 b:glossaryEntry="not able to read or write"/>
<rdf:Description rdf:about="&a;301364968">
	<b:glossaryEntry>having little acquaintance with writing; "special tutorials to assist the unlettered sector of society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301365143">
	<b:glossaryEntry>having reading and writing skills insufficient for ordinary practical needs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301365288"
	 b:glossaryEntry="not yet having acquired the ability to read and write"/>
<rdf:Description rdf:about="&a;301365399"
	 b:glossaryEntry='barely able to read and write; "an semiliterate scrawl"'/>
<rdf:Description rdf:about="&a;301365513"
	 b:glossaryEntry="able to read but not to write"/>
<rdf:Description rdf:about="&a;301365601">
	<b:glossaryEntry>actually being performed (or--for the audience--present) at the time of viewing; "a live television program"; "brought to you live from Lincoln Center"; "live entertainment" involves performers actually in the physical presence of a "live audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301365931"
	 b:glossaryEntry="not recorded on film or tape"/>
<rdf:Description rdf:about="&a;301366024">
	<b:glossaryEntry>set down or registered in a permanent form especially on film or tape for reproduction; "recorded music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301366255">
	<b:glossaryEntry xml:space='preserve'><![CDATA[recorded for broadcast; "a transcribed announcement"; (`canned'' is used informally as in "canned laughter")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301366429">
	<b:glossaryEntry>recorded on film; made into a movie; "a filmed documentary"; "the filmed version of the novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301366576"
	 b:glossaryEntry="recorded at one time for transmission later"/>
<rdf:Description rdf:about="&a;301366677"
	 b:glossaryEntry="recorded on tape"/>
<rdf:Description rdf:about="&a;301366761"
	 b:glossaryEntry='fit or suitable to live in or with; "livable conditions"'/>
<rdf:Description rdf:about="&a;301366900"
	 b:glossaryEntry='fit for habitation; "the habitable world"'/>
<rdf:Description rdf:about="&a;301367011">
	<b:glossaryEntry>unfit or unsuitable to live in or with; "unlivable substandard housing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301367169"
	 b:glossaryEntry="not fit for habitation"/>
<rdf:Description rdf:about="&a;301367251"
	 b:glossaryEntry='wearing livery; "liveried footmen stood on the palace steps"'/>
<rdf:Description rdf:about="&a;301367366"
	 b:glossaryEntry='not wearing livery; "an unliveried chauffeur"'/>
<rdf:Description rdf:about="&a;301367468"
	 b:glossaryEntry='(of weapons) charged with ammunition; "a loaded gun"'/>
<rdf:Description rdf:about="&a;301367609"
	 b:glossaryEntry='charged with an explosive; "live ammunition"; "a live bomb"'/>
<rdf:Description rdf:about="&a;301367719">
	<b:glossaryEntry>still capable of exploding or being fired; "undischarged ammunition"; "an unexploded bomb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301367881">
	<b:glossaryEntry>(of weapons) not charged with ammunition; "many people are killed by guns thought to be unloaded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301368069"
	 b:glossaryEntry='not charged with a bullet; "a blank cartridge"'/>
<rdf:Description rdf:about="&a;301368167">
	<b:glossaryEntry>failing to detonate; especially not charged with an active explosive; "he stepped on a dud mine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301368313">
	<b:glossaryEntry>consisting of or having the character of loam; "richy loamy soil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301368430"
	 b:glossaryEntry='having no loam; "a stony loamless yard"'/>
<rdf:Description rdf:about="&a;301368524">
	<b:glossaryEntry>(medicine) affecting only a restricted part or area of the body; "local anesthesia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301368695">
	<b:glossaryEntry>(medicine) confined or restricted to a particular location; "the localized infection formed a definite abscess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301368862">
	<b:glossaryEntry>(medicine) "a drug for topical (or local) application"; "a topical remedy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301368990">
	<b:glossaryEntry>(medicine) affecting the entire body; "a general anesthetic"; "general symptoms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301369160"
	 b:glossaryEntry='spread throughout a body or system; "generalized edema"'/>
<rdf:Description rdf:about="&a;301369273"
	 b:glossaryEntry='affecting an entire system; "a systemic poison"'/>
<rdf:Description rdf:about="&a;301369375">
	<b:glossaryEntry>(especially of medicine) of disease or anything resembling a disease; attacking or affecting many individuals in a community or a population simultaneously; "an epidemic outbreak of influenza"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301369694">
	<b:glossaryEntry>(of plants) epidemic among plants of a single kind especially over a wide area; "an epiphytotic blight of potatoes"; "epiphytotic conditions associated with a single-plant agriculture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301369936">
	<b:glossaryEntry>(of animals) epidemic among animals of a single kind within a particular region; "an epizootic disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301370095">
	<b:glossaryEntry>epidemic over a wide geographical area; "a pandemic outbreak of malaria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301370222">
	<b:glossaryEntry>likely to spread and cause an epidemic disease; "a pestilential malignancy in the air"- Jonathan Swift; "plaguelike diseases"; "plaguey fevers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301370459">
	<b:glossaryEntry>(of disease or anything resembling a disease) constantly present to greater or lesser extent in a particular locality; "diseases endemic to the tropics"; "endemic malaria"; "food shortages and starvation are endemic in certain parts of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301370759"
	 b:glossaryEntry="having the hands covered with gloves"/>
<rdf:Description rdf:about="&a;301370866">
	<b:glossaryEntry>wearing a protective glove; "gestured with his gauntleted hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301370986"
	 b:glossaryEntry="devoid of gloves"/>
<rdf:Description rdf:about="&a;301371058">
	<b:glossaryEntry>wearing a hat or a hat of a particular kind; "two old ladies, neatly hatted and gloved"; "a bearskin-hatted sentry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301371244"
	 b:glossaryEntry="wearing a turban"/>
<rdf:Description rdf:about="&a;301371315">
	<b:glossaryEntry>not wearing a hat; "stood hatless in the rain with water dripping down his neck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301371449"
	 b:glossaryEntry="having leadership guidance"/>
<rdf:Description rdf:about="&a;301371543">
	<b:glossaryEntry>accompanied by a leader or guide; "took me on a conducted tour of his fields"; "a guided tour of Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301371712">
	<b:glossaryEntry>lacking leadership; "the unled or misled welter of a commercial century"- John Masefield</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301371888">
	<b:glossaryEntry>lacking a leader; "an leaderless mob running riot in the streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301372010">
	<b:glossaryEntry>lacking guidance or direction; "earnest but undirected efforts"; "an unguided tour"; "unguided days and rotten times"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301372208">
	<b:glossaryEntry>subject to guidance or control especially after launching; "a guided missile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301372374"
	 b:glossaryEntry='operated and guided by radio; "a radio-controlled airplane"'/>
<rdf:Description rdf:about="&a;301372496"
	 b:glossaryEntry="guided automatically toward the target"/>
<rdf:Description rdf:about="&a;301372595">
	<b:glossaryEntry>not subject to guidance or control after launching; "unguided missiles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301372721">
	<b:glossaryEntry>having legs of a specified kind or number; "four-legged animals"; "a peg-legged man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301372894"
	 b:glossaryEntry='resembling or functioning like a leg; "leglike appendages"'/>
<rdf:Description rdf:about="&a;301373006">
	<b:glossaryEntry>having or as if having three legs; "a three-legged stool"; "a three-legged race"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301373145"
	 b:glossaryEntry='not having legs; "a legless man in a wheelchair"'/>
<rdf:Description rdf:about="&a;301373247">
	<b:glossaryEntry>capable of or reflecting the capability for correct and valid reasoning; "a logical mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301373552">
	<b:glossaryEntry>(philosophy) proceeding to a conclusion by reason or argument rather than intuition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301373704"
	 b:glossaryEntry='logically deductive; "formal proof"'/>
<rdf:Description rdf:about="&a;301373792">
	<b:glossaryEntry xml:space='preserve'><![CDATA[based on exact thinking; "one''s ratiocinative powers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301373905"
	 b:glossaryEntry="lacking in correct logical relation"/>
<rdf:Description rdf:about="&a;301374134">
	<b:glossaryEntry>inconsistent with reason or logic or common sense; "the absurd predicament of seeming to argue that virtue is highly desirable but intensely unpleasant"- Walter Lippman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301374384"
	 b:glossaryEntry="not following logically as a consequence"/>
<rdf:Description rdf:about="&a;301374486">
	<b:glossaryEntry>obtained through intuition rather than from reasoning or observation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301374624">
	<b:glossaryEntry>fully extended or stretched forth; "an extended telescope"; "his extended legs reached almost across the small room"; "refused to accept the extended hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301374960">
	<b:glossaryEntry>fully extended in width; "outspread wings"; "with arms spread wide"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301375092">
	<b:glossaryEntry>fully extended especially in length; "a kitten with one paw outstretched"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301375224">
	<b:glossaryEntry>extended or spread out fully before one; "saw miles of sand dunes rolled out to the horizon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301375387">
	<b:glossaryEntry>spread out irregularly; "sat sprawled in the big armchair"; "the sprawling suburbs"; "a big sprawly city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301375569">
	<b:glossaryEntry>with arms and legs stretched out and apart; "lay spread-eagle on the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301375703">
	<b:glossaryEntry>(of the body) extended to full length; "he lay stretched out on the bed"; "stretched her calves before running"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301375886">
	<b:glossaryEntry>extended or spread over a wide area or distance; "broad fields lay stretched on both sides of us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301376039"
	 b:glossaryEntry='not extended or stretched out; "an unextended arm"'/>
<rdf:Description rdf:about="&a;301376146">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of women''s clothing; often used in combination) very short with hemline above the knee; "a mini dress"; "miniskirts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301376332">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of women''s clothing; often used in combination) with hemline at mid-calf; "midiskirts"; "wore her dresses midi length"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301376520">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of women''s clothing; often used in combination) with hemline at the ankle; "wanted a maxi-length coat"; "a maxidress"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301376707">
	<b:glossaryEntry>primarily spatial sense; of relatively great or greater than average spatial extension or extension as specified; "a long road"; "a long distance"; "contained many long words"; "ten miles long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301377185">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having notably more length than width; being long and slender; "an elongate tail tapering to a point"; "the old man''s gaunt and elongated frame"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301377396">
	<b:glossaryEntry xml:space='preserve'><![CDATA[drawn out or made longer spatially; "Picasso''s elongated Don Quixote"; "lengthened skirts are fashionable this year"; "the extended airport runways can accommodate larger planes"; "a prolonged black line across the page"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301377708"
	 b:glossaryEntry="capable of being lengthened"/>
<rdf:Description rdf:about="&a;301377805"
	 b:glossaryEntry='being of a considerable distance or length; "a far trek"'/>
<rdf:Description rdf:about="&a;301377911"
	 b:glossaryEntry='of a specified length; "an inch in length"'/>
<rdf:Description rdf:about="&a;301378012">
	<b:glossaryEntry>long and thin and often limp; "grown lank with fasting"; "lank mousy hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301378137">
	<b:glossaryEntry>covering long distances; "a long-distance runner"; "long-distance telephone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301378273">
	<b:glossaryEntry>having the greater length of two or the greatest length of several; "the longer (or long) edge of the door"; "the hypotenuse is the longest (or long) side of a right triangle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301378511">
	<b:glossaryEntry>suitable for or reaching long distances; "long-range nuclear capability"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301378640">
	<b:glossaryEntry>deviating from a square or circle or sphere by being elongated in one direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301378772">
	<b:glossaryEntry>(of words) long and ponderous; having many syllables; "sesquipedalian technical terms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301378934"
	 b:glossaryEntry='having an elongated seating area; "a stretch limousine"'/>
<rdf:Description rdf:about="&a;301379046">
	<b:glossaryEntry>primarily spatial sense; having little length or lacking in length; "short skirts"; "short hair"; "the board was a foot short"; "a short toss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301379438">
	<b:glossaryEntry>(of clothing) very short; "an abbreviated swimsuit"; "a brief bikini"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301379573"
	 b:glossaryEntry='used of hair or haircuts; "a close military haircut"'/>
<rdf:Description rdf:about="&a;301379677"
	 b:glossaryEntry='(obsolete) cut short; "a dog with a curtal tail"'/>
<rdf:Description rdf:about="&a;301379778">
	<b:glossaryEntry>cut short; "a sawed-off broomstick"; "the shortened rope was easier to use"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301379921"
	 b:glossaryEntry="somewhat short"/>
<rdf:Description rdf:about="&a;301379990">
	<b:glossaryEntry>limited to short distances; "short-range planes"; "a short-range shot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301380118"
	 b:glossaryEntry='unusually short; "a snub nose"'/>
<rdf:Description rdf:about="&a;301380199"
	 b:glossaryEntry='short and blunt; "stubby fingers"; "a stubby pencil"'/>
<rdf:Description rdf:about="&a;301380304">
	<b:glossaryEntry>shortened by or as if by means of parts that slide one within another or are crushed one into another; "a miracle that anyone survived in the telescoped cars"; "years that seemed telescoped like time in a dream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301380602">
	<b:glossaryEntry>terminating abruptly by having or as if having an end or point cut off; "a truncate leaf"; "truncated volcanic mountains"; "a truncated pyramid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301380813">
	<b:glossaryEntry>primarily temporal sense; being or indicating a relatively great or greater than average duration or passage of time or a duration as specified; ; "a long life"; "a long boring speech"; "a long time"; "a long friendship"; "a long game"; "long ago"; "an hour long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301381451"
	 b:glossaryEntry='lasting through all time; "agelong struggle for freedom"'/>
<rdf:Description rdf:about="&a;301381561"
	 b:glossaryEntry="two months long; lasting two months"/>
<rdf:Description rdf:about="&a;301381653"
	 b:glossaryEntry="lasting through an entire day"/>
<rdf:Description rdf:about="&a;301381736">
	<b:glossaryEntry>relatively long in duration; tediously protracted; "a drawn-out argument"; "an extended discussion"; "a lengthy visit from her mother-in-law"; "a prolonged and bitter struggle"; "protracted negotiations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301382041">
	<b:glossaryEntry>existing for a long time; "hopes for a durable peace"; "a long-lasting friendship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301382215">
	<b:glossaryEntry>tiresomely long; seemingly without end; "endless debates"; "an endless conversation"; "the wait seemed eternal"; "eternal quarreling"; "an interminable sermon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301382453">
	<b:glossaryEntry>continuing through life; "a lifelong friend"; "from lifelong habit"i; "his lifelong study of Greek art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301382626"
	 b:glossaryEntry="active over a long period of time"/>
<rdf:Description rdf:about="&a;301382717">
	<b:glossaryEntry>(British) of a gilt-edged security; having more than 15 years to run before redemption</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301382860"
	 b:glossaryEntry="somewhat long"/>
<rdf:Description rdf:about="&a;301382927"
	 b:glossaryEntry='over an extended time; "a longitudinal study of twins"'/>
<rdf:Description rdf:about="&a;301383040"
	 b:glossaryEntry='involving an extended span of time; "long-range goals"'/>
<rdf:Description rdf:about="&a;301383151">
	<b:glossaryEntry>relating to or extending over a relatively long time; "the long-run significance of the elections"; "the long-term reconstruction of countries damaged by the war"; "a long-term investment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301383422">
	<b:glossaryEntry>having existed for a long time; "a longstanding friendship"; "the longstanding conflict"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301383569">
	<b:glossaryEntry>lasting through or extending over the whole night; "a nightlong vigil"; "an overnight trip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301383728">
	<b:glossaryEntry>lasting an indefinitely long time; suggesting self-renewal; "perennial happiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301383865"
	 b:glossaryEntry='lasting through a year; "attending yearlong courses"'/>
<rdf:Description rdf:about="&a;301383972">
	<b:glossaryEntry>primarily temporal sense; indicating or being or seeming to be limited in duration; "a short life"; "a short flight"; "a short holiday"; "a short story"; "only a few short months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301384383">
	<b:glossaryEntry>cut short in duration; "the abbreviated speech"; "a curtailed visit"; "her shortened life was clearly the result of smoking"; "an unsatisfactory truncated conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301384633">
	<b:glossaryEntry>of short duration; "a brief stay in the country"; "in a little while"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301384763">
	<b:glossaryEntry>(of speech) having quick short sounds; "a clipped upper-class accent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301384886">
	<b:glossaryEntry>lasting for a markedly brief time; "a fleeting glance"; "fugitive hours"; "rapid momentaneous association of things that meet and pass"; "a momentary glimpse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301385137">
	<b:glossaryEntry>dealt with very quickly; to the point; "the conference was short and sweet"; "make your statement short and sweet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301385316">
	<b:glossaryEntry>(British) of a gilt-edged security; having less than 5 years to run before redemption</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301385459"
	 b:glossaryEntry='relating to the near future; "a short-range policy"'/>
<rdf:Description rdf:about="&a;301385568">
	<b:glossaryEntry>relating to or extending over a limited period; "short-run planning"; "a short-term lease"; "short-term credit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301385748">
	<b:glossaryEntry>(phonetics) of speech sounds (especially vowels) of relatively long duration (as e.g. the English vowel sounds in `bate'', `beat'', `bite'', `boat'', `boot'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301385952">
	<b:glossaryEntry>(phonetics) of speech sounds (especially vowels) of relatively short duration (as e.g. the English vowel sounds in `pat'', `pet'', `pit'', `pot'', putt'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301386154">
	<b:glossaryEntry>(finance) holding securities or commodities in expectation of a rise in prices; "is long on coffee"; "a long position in gold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301386331">
	<b:glossaryEntry>(finance) not holding securities or commodities that one sells in expectation of a fall in prices; "a short sale"; "short in cotton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301386515">
	<b:glossaryEntry>running or extending in the direction of the length of a thing; "the lengthwise dimension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301386747"
	 b:glossaryEntry="situated on or along or in the direction of an axis"/>
<rdf:Description rdf:about="&a;301386850"
	 b:glossaryEntry="(nautical) parallel with the keel of a ship"/>
<rdf:Description rdf:about="&a;301386952"
	 b:glossaryEntry='measured lengthwise; "cost of lumber per running foot"'/>
<rdf:Description rdf:about="&a;301387072">
	<b:glossaryEntry>running lengthwise; "a thin longitudinal strip"; "longitudinal measurements of the hull"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301387219">
	<b:glossaryEntry>lying or extending across the length of a thing or in a cross direction; "a crosswise street"; "the crosswise dimension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301387449">
	<b:glossaryEntry>extending or lying across; in a crosswise direction; "cross members should be all steel"; "from the transverse hall the stairway ascends gracefully"; "transversal vibrations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301387732">
	<b:glossaryEntry>representing a plane made by cutting across something at right angles to its length; "cross-section views of the neck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301387931"
	 b:glossaryEntry="(prefix) across or crossing or on the opposite side"/>
<rdf:Description rdf:about="&a;301388037">
	<b:glossaryEntry>having or covered with a lid or lids; often used in combination; "milk is left in a large lidded mug"; "heavy-lidded eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301388212">
	<b:glossaryEntry>not having or covered with a lid or lids; "a lidless container"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301388329">
	<b:glossaryEntry>not tight; not closely constrained or constricted or constricting; "loose clothing"; "the large shoes were very loose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301388554">
	<b:glossaryEntry>not fitting closely; hanging loosely; "baggy trousers"; "a loose-fitting blouse is comfortable in hot weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301388732">
	<b:glossaryEntry>(of hair or clothing) worn loose; "her flyaway hair"; "a flyaway coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301388856">
	<b:glossaryEntry>closely constrained or constricted or constricting; "tight skirts"; "he hated tight starched collars"; "fingers closed in a tight fist"; "a tight feeling in his chest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301389237">
	<b:glossaryEntry>hindering freedom of movement; "tight garments are uncomfortably binding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301389379"
	 b:glossaryEntry='so tight as to tend to choke; "a choky collar"'/>
<rdf:Description rdf:about="&a;301389477">
	<b:glossaryEntry>closed or squeezed together tightly; "a clenched fist"; "his clenched (or clinched) teeth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301389633"
	 b:glossaryEntry='fitting closely but comfortably; "a close fit"'/>
<rdf:Description rdf:about="&a;301389754"
	 b:glossaryEntry='so tight as to cling to the skin; "skintight jeans"'/>
<rdf:Description rdf:about="&a;301389861">
	<b:glossaryEntry>fitting snugly; "a tightly-fitting cover"; "tight-fitting clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301390005"
	 b:glossaryEntry='clamped as in a vise; "a viselike grip"'/>
<rdf:Description rdf:about="&a;301390099">
	<b:glossaryEntry>drawn together or squeezed physically or by extension psychologically; "a constricted blood vessel"; "a constricted view of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301390322">
	<b:glossaryEntry>made narrow; limited in breadth; "narrowed arteries impair blood circulation"; "a narrowed view of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301390486">
	<b:glossaryEntry>as if squeezed uncomfortably tight; "her pinched toes in her pointed shoes were killing her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301390632">
	<b:glossaryEntry>not constricted physically or by extension psychologically; "healthy unconstricted arteries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301390802">
	<b:glossaryEntry>without undue constriction as from e.g. tenseness or inhibition; "the clarity and resonance of an open tone"; "her natural and open response"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301390994">
	<b:glossaryEntry>no longer in your possession or control; unable to be found or recovered; "a lost child"; "lost friends"; "his lost book"; "lost opportunities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301391296">
	<b:glossaryEntry>lost temporarily; as especially put in an unaccustomed or forgotten place; "the mislaid hat turned up eventually"; "misplaced tickets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301391496"
	 b:glossaryEntry='no longer retained; "gone with the wind"'/>
<rdf:Description rdf:about="&a;301391590">
	<b:glossaryEntry>not able to be found; "missing in action"; "a missing person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301391705">
	<b:glossaryEntry>not used to good advantage; "squandered money cannot be replaced"; "a wasted effort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301391855"
	 b:glossaryEntry='unable to find your way; "found the straying sheep"'/>
<rdf:Description rdf:about="&a;301391961">
	<b:glossaryEntry>come upon unexpectedly or after searching; "found art"; "the lost-and-found department"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301392136"
	 b:glossaryEntry="found after being lost"/>
<rdf:Description rdf:about="&a;301392217">
	<b:glossaryEntry>spiritually or physically doomed or destroyed; "lost souls"; "a lost generation"; "a lost ship"; "the lost platoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301392473">
	<b:glossaryEntry>(Christianity) in danger of the eternal punishment of hell; "poor damned souls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301392646"
	 b:glossaryEntry="destroyed physically or morally"/>
<rdf:Description rdf:about="&a;301392742">
	<b:glossaryEntry>rescued; especially from the power and consequences of sin; "a saved soul"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301393012"
	 b:glossaryEntry="enjoying the bliss of heaven"/>
<rdf:Description rdf:about="&a;301393094"
	 b:glossaryEntry="reclaimed by payment of a ransom"/>
<rdf:Description rdf:about="&a;301393181"
	 b:glossaryEntry="delivered from danger"/>
<rdf:Description rdf:about="&a;301393268"
	 b:glossaryEntry="(Christianity) saved from the bondage of sin"/>
<rdf:Description rdf:about="&a;301393378">
	<b:glossaryEntry>capable of being saved from ruin; "their marriage was not salvageable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301393506"
	 b:glossaryEntry='not gained or won; "a lost battle"; "a lost prize"'/>
<rdf:Description rdf:about="&a;301393625"
	 b:glossaryEntry="surrendered as a penalty"/>
<rdf:Description rdf:about="&a;301393728">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not subject to defeat; "with that move it''s a won game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301393833">
	<b:glossaryEntry>characterized by or producing sound of great volume or intensity; "a group of loud children"; "loud thunder"; "her voice was too loud"; "loud trombones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301394252"
	 b:glossaryEntry='loud and firm; "a big voice"; "big bold piano sounds"'/>
<rdf:Description rdf:about="&a;301394355">
	<b:glossaryEntry>unpleasantly loud and penetrating; "the blaring noise of trumpets"; "shut our ears against the blasting music from his car radio"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301394549"
	 b:glossaryEntry="loud enough to cause (temporary) hearing loss"/>
<rdf:Description rdf:about="&a;301394699"
	 b:glossaryEntry="loud enough to shake the very earth"/>
<rdf:Description rdf:about="&a;301394793"
	 b:glossaryEntry="given to loud offensive talk"/>
<rdf:Description rdf:about="&a;301394880"
	 b:glossaryEntry="having an unusually loud voice"/>
<rdf:Description rdf:about="&a;301394968">
	<b:glossaryEntry>seemingly loud enough to break something; violently rattling or clattering; "shattering rain striking the windowpanes"; "the shattering tones of the enormous carillon"; "the shattering peal of artillery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301395228">
	<b:glossaryEntry>in a vehement outcry; "his shouted words of encouragement could be heard over the crowd noises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301395386">
	<b:glossaryEntry>full of the sound of voices; "a playground vocal with the shouts and laughter of children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301395528">
	<b:glossaryEntry>of sound; relatively low in volume; "soft voices"; "soft music"; "</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301395843">
	<b:glossaryEntry>being or made softer or less loud or clear; "the dull boom of distant breaking waves"; "muffled drums"; "the muffled noises of the street"; "muted trumpets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301396079"
	 b:glossaryEntry='quiet and soothing; "a gentle voice"; "a gentle nocturne"'/>
<rdf:Description rdf:about="&a;301396189">
	<b:glossaryEntry>in a softened tone; "hushed voices"; "muted trumpets"; "a subdued whisper"; "a quiet reprimand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301396363"
	 b:glossaryEntry='(of a voice) faint; "a little voice"; "a still small voice"'/>
<rdf:Description rdf:about="&a;301396483">
	<b:glossaryEntry>very low in volume; "a low murmur"; "the low-toned murmur of the surf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301396615">
	<b:glossaryEntry>making a low continuous indistinct sound; "like murmuring waves"; "susurrant voices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301396780">
	<b:glossaryEntry>characterized by soft sounds; "a murmurous brook"; "a soughing wind in the pines"; "a slow sad susurrous rustle like the wind fingering the pines"- R.P.Warren</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301397028"
	 b:glossaryEntry="sound of quiet gentle steps"/>
<rdf:Description rdf:about="&a;301397113">
	<b:glossaryEntry>having a speaking manner that is not loud or harsh; "she was always soft-spoken"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301397251">
	<b:glossaryEntry>(of sound) having marked depth and body; "full tones"; "a full voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301397497"
	 b:glossaryEntry="used of the voice"/>
<rdf:Description rdf:about="&a;301397581">
	<b:glossaryEntry>continuous full and low-pitched throbbing sound; "the rumbling rolling sound of thunder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301397736"
	 b:glossaryEntry='loud and resounding; "plangent bells"'/>
<rdf:Description rdf:about="&a;301397828"
	 b:glossaryEntry='pleasantly full and mellow; "a rich tenor voice"'/>
<rdf:Description rdf:about="&a;301397927">
	<b:glossaryEntry>full and rich; "orotund tones"; "the rotund and reverberating phrase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301398067">
	<b:glossaryEntry>full and loud and deep; "heavy sounds"; "a herald chosen for his sonorous voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301398210">
	<b:glossaryEntry>having volume or depth; "sounding brass and a tinkling cymbal"; "the sounding cataract haunted me like a passion"- Wordsworth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301398390"
	 b:glossaryEntry='(of sound) lacking resonance or volume; "a thin feeble cry"'/>
<rdf:Description rdf:about="&a;301398518"
	 b:glossaryEntry='not full or rich; "high, pale, pure and lovely song"'/>
<rdf:Description rdf:about="&a;301398621">
	<b:glossaryEntry>used chiefly as a direction or description in music; "the piano passages in the composition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301398808"
	 b:glossaryEntry="chiefly a direction or description in music; very soft"/>
<rdf:Description rdf:about="&a;301398919"
	 b:glossaryEntry="chiefly a direction or description in music; very soft"/>
<rdf:Description rdf:about="&a;301399036">
	<b:glossaryEntry>used chiefly as a direction or description in music; "the forte passages in the composition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301399223"
	 b:glossaryEntry="chiefly a direction or description in music; loud and strong"/>
<rdf:Description rdf:about="&a;301399340"
	 b:glossaryEntry="chiefly a direction or description in music"/>
<rdf:Description rdf:about="&a;301399440">
	<b:glossaryEntry>having characteristics that attract love or affection; "a mischievous but lovable child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301399690"
	 b:glossaryEntry="lovable especially in a childlike or naive way"/>
<rdf:Description rdf:about="&a;301399812">
	<b:glossaryEntry>having a sweet nature befitting an angel or cherub; "an angelic smile"; "a cherubic face"; "looking so seraphic when he slept"; "a sweet disposition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301400057">
	<b:glossaryEntry>inviting cuddling or hugging; "a cuddlesome baby"; "a cuddly teddybear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301400194">
	<b:glossaryEntry>evoking or deserving hatred; "no vice is universally as hateful as ingratitude"- Joseph Priestly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301400452">
	<b:glossaryEntry>unequivocally detestable; "abominable treatment of prisoners"; "detestable vices"; "execrable crimes"; "consequences odious to those you govern"- Edmund Burke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301400701">
	<b:glossaryEntry>incapable of inspiring love or affection; "she was in some mysterious way...unlovable"-Joseph Conrad</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301400857">
	<b:glossaryEntry>found pleasant or attractive; often used as a combining form; "a well-liked teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301401011">
	<b:glossaryEntry>easy to like; agreeable; "an attractive and likable young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301401138"
	 b:glossaryEntry='regarded with aversion; "he was intensely disliked"'/>
<rdf:Description rdf:about="&a;301401280"
	 b:glossaryEntry="such as to provoke dislike"/>
<rdf:Description rdf:about="&a;301401363">
	<b:glossaryEntry>difficult or impossible to like; "a disagreeable and unlikable old woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301401505"
	 b:glossaryEntry='held dear; "his loved companion of many years"'/>
<rdf:Description rdf:about="&a;301401729"
	 b:glossaryEntry="regarded with admiration"/>
<rdf:Description rdf:about="&a;301401807">
	<b:glossaryEntry>regarded with deep or rapturous love (especially as if for a god); "adored grandchildren"; "an idolized wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301401996"
	 b:glossaryEntry="dearly loved"/>
<rdf:Description rdf:about="&a;301402079">
	<b:glossaryEntry>(informal) favorite; "the fair-haired boy of the literary set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301402235">
	<b:glossaryEntry>characterized by feeling or showing fond affection for; "a cherished friend"; "children are precious"; "a treasured heirloom"; "so good to feel wanted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301402474">
	<b:glossaryEntry>preferred above all others and treated with partiality; "the favored child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301402650"
	 b:glossaryEntry="not loved"/>
<rdf:Description rdf:about="&a;301402839"
	 b:glossaryEntry="caused to be unloved"/>
<rdf:Description rdf:about="&a;301402927"
	 b:glossaryEntry="unhappy in love; suffering from unrequited love"/>
<rdf:Description rdf:about="&a;301403050"
	 b:glossaryEntry="treated with contempt"/>
<rdf:Description rdf:about="&a;301403155"
	 b:glossaryEntry="deprived of your rightful heritage"/>
<rdf:Description rdf:about="&a;301403248"
	 b:glossaryEntry='rebuffed (by a lover) without warning; "jilted at the altar"'/>
<rdf:Description rdf:about="&a;301403382"
	 b:glossaryEntry='receiving no love; "a loveless childhood"'/>
<rdf:Description rdf:about="&a;301403478">
	<b:glossaryEntry>feeling or showing love and affection; "loving parents"; "loving glances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301403946">
	<b:glossaryEntry>showing or feeling admiration; "an admiring crowd"; "gave me one of her rare admiring looks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301404093">
	<b:glossaryEntry>extravagantly or foolishly loving and indulgent; "adoring grandparents"; "deceiving her preoccupied and doting husband with a young captain"; "hopelessly spoiled by a fond mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301404342">
	<b:glossaryEntry>having or displaying warmth or affection; "affectionate children"; "caring parents"; "a fond embrace"; "fond of his nephew"; "a tender glance"; "a warm embrace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301404604"
	 b:glossaryEntry="archaic"/>
<rdf:Description rdf:about="&a;301404669"
	 b:glossaryEntry='inclined toward or displaying love; "feeling amorous"'/>
<rdf:Description rdf:about="&a;301404786">
	<b:glossaryEntry>expressive of or exciting sexual love or romance; "her amatory affairs"; "amorous glances"; "a romantic adventure"; "a romantic moonlight ride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301405004"
	 b:glossaryEntry="strongly attracted"/>
<rdf:Description rdf:about="&a;301405089"
	 b:glossaryEntry='showing love; "caressive words"'/>
<rdf:Description rdf:about="&a;301405188">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by foolish or unreasoning fondness; "she was crazy about him"; "gaga over the rock group''s new album"; "he was infatuated with her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301405466"
	 b:glossaryEntry="showing the affection of a father"/>
<rdf:Description rdf:about="&a;301405554"
	 b:glossaryEntry="blindly or excessively devoted or adoring"/>
<rdf:Description rdf:about="&a;301405652"
	 b:glossaryEntry="like or in the manner of a lover"/>
<rdf:Description rdf:about="&a;301405750"
	 b:glossaryEntry="excessively fond"/>
<rdf:Description rdf:about="&a;301405821"
	 b:glossaryEntry="easily moved to love"/>
<rdf:Description rdf:about="&a;301405901"
	 b:glossaryEntry="foolishly fond of or submissive to your wife"/>
<rdf:Description rdf:about="&a;301406000"
	 b:glossaryEntry="not giving or reciprocating affection"/>
<rdf:Description rdf:about="&a;301406182">
	<b:glossaryEntry>sexually unresponsive; "was cold to his advances"; "a frigid woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301406309"
	 b:glossaryEntry='without love; "a loveless marriage"'/>
<rdf:Description rdf:about="&a;301406399"
	 b:glossaryEntry='lacking affection or warm feeling; "an uncaring person"'/>
<rdf:Description rdf:about="&a;301406526"
	 b:glossaryEntry="neither expressive of nor exciting sexual love or romance"/>
<rdf:Description rdf:about="&a;301406640">
	<b:glossaryEntry xml:space='preserve'><![CDATA[relating to small (not capitalized) letters that were kept in the lower half of a compositor''s type case; "lowercase letters; a and b and c etc"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301406876">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lowercase; "little a"; "small a"; "e.e.cummings''s poetry is written all in minuscule letters"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301407042">
	<b:glossaryEntry xml:space='preserve'><![CDATA[relating to capital letters which were kept in the top half of a compositor''s type case; "uppercase letters; X and Y and Z etc"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301407261">
	<b:glossaryEntry>uppercase; "capital A"; "great A"; "many medieval manuscripts are in majuscule script"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301407421"
	 b:glossaryEntry='having or bringing good fortune; "my lucky day"'/>
<rdf:Description rdf:about="&a;301407556">
	<b:glossaryEntry>having or bringing unusually good luck; "hot at craps"; "the dice are hot tonight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301407688">
	<b:glossaryEntry>having or bringing misfortune; "Friday the 13th is an unlucky date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301407855">
	<b:glossaryEntry>(usually used colloquially) causing or accompanied by misfortune</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301407980">
	<b:glossaryEntry>(music; of a singer or singing voice) being light in volume and modest in range; "a lyric soprano"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301408148">
	<b:glossaryEntry>(of lyric singing or a lyric singer) marked by florid virtuoso trills and runs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301408283">
	<b:glossaryEntry>(music; of a singer or singing voice) marked by power and expressiveness and a histrionic or theatrical style; "a dramatic tenor"; "a dramatic soprano"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301408489"
	 b:glossaryEntry="large enough to be visible to the naked eye"/>
<rdf:Description rdf:about="&a;301408632"
	 b:glossaryEntry="visible to the naked eye (especially of rocks)"/>
<rdf:Description rdf:about="&a;301408743"
	 b:glossaryEntry="too small to be seen except under a microscope"/>
<rdf:Description rdf:about="&a;301408925"
	 b:glossaryEntry="immeasurably small"/>
<rdf:Description rdf:about="&a;301409016"
	 b:glossaryEntry="of dimensions smaller than atomic dimensions"/>
<rdf:Description rdf:about="&a;301409116"
	 b:glossaryEntry="too small to be visible to the naked eye"/>
<rdf:Description rdf:about="&a;301409211">
	<b:glossaryEntry>(of a bed) having the sheets and blankets set in order; "a neatly made bed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301409337">
	<b:glossaryEntry>(of a bed) not having the sheets and blankets set in order; "an unmade bed with tangled sheets and blankets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301409498">
	<b:glossaryEntry>having the properties of a magnet; i.e. of attracting iron or steel; "the hard disk is covered with a thin coat of magnetic material"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301409717">
	<b:glossaryEntry>capable of being magnetized or attracted by a magnet; "the magnetic chips of steel produced by a cutting tool are attractable by a magnet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301409913">
	<b:glossaryEntry>impervious to the effects of a magnetic field; resistant to magnetization; "an antimagnetic watch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301410070">
	<b:glossaryEntry xml:space='preserve'><![CDATA[determined by earth''s magnetic fields; "magnetic north"; "the needle of a magnetic compass points to the magnetic north pole"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301410250">
	<b:glossaryEntry>determined by geography; "the north and south geographic poles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301410403">
	<b:glossaryEntry xml:space='preserve'><![CDATA[determined with reference to the earth''s axis rather than the magnetic poles; "true north is geographic north"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301410567"
	 b:glossaryEntry="capable of being magnetized"/>
<rdf:Description rdf:about="&a;301410649"
	 b:glossaryEntry="not capable of being magnetized"/>
<rdf:Description rdf:about="&a;301410738">
	<b:glossaryEntry>greater in number or size or amount; "a major portion (a majority) of the population"; "Ursa Major"; "a major portion of the winnings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301410960"
	 b:glossaryEntry='more than half; "argued for the better part of an hour"'/>
<rdf:Description rdf:about="&a;301411068">
	<b:glossaryEntry>inferior in number or size or amount; "a minor share of the profits"; "Ursa Minor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301411220">
	<b:glossaryEntry>greater in scope or effect; "a major contribution"; "a major improvement"; "a major break with tradition"; "a major misunderstanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301411405">
	<b:glossaryEntry>lesser in scope or effect; "had minor differences"; "a minor disturbance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301411530"
	 b:glossaryEntry='(law) of full legal age; "major children"'/>
<rdf:Description rdf:about="&a;301411623"
	 b:glossaryEntry='(law) not of legal age; "minor children"'/>
<rdf:Description rdf:about="&a;301411736">
	<b:glossaryEntry>(music) of a scale or mode; "major scales"; "the key of D major"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301411852">
	<b:glossaryEntry>(music) of a scale or mode; "the minor keys"; "in B flat minor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301411967">
	<b:glossaryEntry>of the field of academic study in which one concentrates or specializes; "his major field was mathematics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301412125">
	<b:glossaryEntry>of your secondary field of academic concentration or specialization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301412244">
	<b:glossaryEntry>of greater importance or stature or rank; "a major artist"; "a major role"; "major highways"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301412424">
	<b:glossaryEntry>of major significance or importance; "a great work of art"; "Einstein was one of the outstanding figures of the 20th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301412615">
	<b:glossaryEntry>indicating the most important performer or role; "the leading man"; "prima ballerina"; "prima donna"; "a star figure skater"; "the starring role"; "a stellar role"; "a stellar performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301412908">
	<b:glossaryEntry>of lesser importance or stature or rank; "a minor poet"; "had a minor part in the play"; "a minor official"; "many of these hardy adventurers were minor noblemen"; "minor back roads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301413178">
	<b:glossaryEntry>of little importance or influence or power; of minor status; "a minor, insignificant bureaucrat"; "the little man"; "peanut politicians"; "a crowd of small writers had vainly attempted to rival Addison"- Macaulay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301413476">
	<b:glossaryEntry>not of major importance; "played a secondary role in world events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301413598">
	<b:glossaryEntry>of greater seriousness or danger; "a major earthquake"; "a major hurricane"; "a major illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301413744">
	<b:glossaryEntry>of lesser seriousness or danger; "suffered only minor injuries"; "some minor flooding"; "a minor tropical disturbance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301413914">
	<b:glossaryEntry>of or relating to a style of writing characterized by somewhat rounded capital letters; 4th to 8th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301414096">
	<b:glossaryEntry>of or relating to a small cursive script developed from uncial; 7th to 9th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301414267"
	 b:glossaryEntry="capable of being managed or controlled"/>
<rdf:Description rdf:about="&a;301414488"
	 b:glossaryEntry="capable of being administered or managed"/>
<rdf:Description rdf:about="&a;301414588"
	 b:glossaryEntry="capable of being controlled"/>
<rdf:Description rdf:about="&a;301414687">
	<b:glossaryEntry>manageable by a supervising agent; "a directed program of study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301414806"
	 b:glossaryEntry="capable of being steered"/>
<rdf:Description rdf:about="&a;301414886"
	 b:glossaryEntry="difficult to manage or control"/>
<rdf:Description rdf:about="&a;301415065">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of persons; "the little boy''s parents think he is spirited, but his teacher finds him unruly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301415254"
	 b:glossaryEntry="incapable of being checked or restrained"/>
<rdf:Description rdf:about="&a;301415352"
	 b:glossaryEntry="possessing qualities befitting a man"/>
<rdf:Description rdf:about="&a;301415513"
	 b:glossaryEntry="resolute and without fear"/>
<rdf:Description rdf:about="&a;301415611"
	 b:glossaryEntry='calling for manly attributes; "a man-sized job"'/>
<rdf:Description rdf:about="&a;301415714"
	 b:glossaryEntry="not possessing qualities befitting a man"/>
<rdf:Description rdf:about="&a;301415885"
	 b:glossaryEntry="having unsuitable feminine qualities"/>
<rdf:Description rdf:about="&a;301416040"
	 b:glossaryEntry="contemptibly timid"/>
<rdf:Description rdf:about="&a;301416110">
	<b:glossaryEntry>having characteristics associated with women and considered undesirable in men; "womanish tears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301416261">
	<b:glossaryEntry>(biology) being the sex (of plant or animal) that produces gametes (spermatozoa) that perform the fertilizing function in generation; "a male infant"; "a male holly tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301416608"
	 b:glossaryEntry="(botany) capable of fertilizing female organs"/>
<rdf:Description rdf:about="&a;301416720">
	<b:glossaryEntry>resembling or being a phallus; "a phallic symbol"; "phallic eroticism"; "priapic figurines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301416875">
	<b:glossaryEntry>overly concerned with masculinity and male sexuality; "priapic episodes"; "priapic victories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301417022"
	 b:glossaryEntry="capable of fathering offspring"/>
<rdf:Description rdf:about="&a;301417117">
	<b:glossaryEntry>(biology) being the sex (of plant or animal) that produces fertilizable gametes (ova) from which offspring develop; "a female heir"; "female holly trees bear the berries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301417430"
	 b:glossaryEntry="capable of producing eggs and bearing offspring"/>
<rdf:Description rdf:about="&a;301417559">
	<b:glossaryEntry>(botany) having gynoecia, or pistils, the ovule-bearing organ of a seed plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301417693"
	 b:glossaryEntry="having both male and female characteristics"/>
<rdf:Description rdf:about="&a;301417938"
	 b:glossaryEntry="having an ambiguous sexual identity"/>
<rdf:Description rdf:about="&a;301418038"
	 b:glossaryEntry="having both male and female morphological characteristics"/>
<rdf:Description rdf:about="&a;301418176">
	<b:glossaryEntry>(biology) of animal or plant; having both male female reproductive organs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301418326">
	<b:glossaryEntry>having sexual characteristics intermediate between those of male and female</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301418459">
	<b:glossaryEntry>having internal reproductive organs of one sex and external sexual characteristics of the other sex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301418647"
	 b:glossaryEntry="not distinguished on the basis of sex"/>
<rdf:Description rdf:about="&a;301418737">
	<b:glossaryEntry>having a crew; "a manned earth satellite was considered a necessary research step"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301418872"
	 b:glossaryEntry='lacking a crew; "an unmanned satellite to Mars"'/>
<rdf:Description rdf:about="&a;301419012"
	 b:glossaryEntry='lacking a pilot; "a drone is a pilotless aircraft"'/>
<rdf:Description rdf:about="&a;301419118">
	<b:glossaryEntry>having or as if having an identifying mark or a mark as specified; often used in combination; "played with marked cards"; "a scar-marked face"; "well-marked roads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301419388"
	 b:glossaryEntry='marked with an asterisk; "the starred items"'/>
<rdf:Description rdf:about="&a;301419499">
	<b:glossaryEntry>deeply affected or marked by mental or physical pain or injury; "Could her scarred mind ever be free of fear?"; "a face scarred by anxiety"; "the fire left her arm badly scarred"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301419731"
	 b:glossaryEntry='clearly indicated; "a well-marked route"'/>
<rdf:Description rdf:about="&a;301419847">
	<b:glossaryEntry>not having an identifying mark; "unmarked cards"; "an unmarked police car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301420012"
	 b:glossaryEntry='not marked with an asterisk; "unasterisked items"'/>
<rdf:Description rdf:about="&a;301420132"
	 b:glossaryEntry='marked with a brand; "branded cattle"; "branded criminal"'/>
<rdf:Description rdf:about="&a;301420243"
	 b:glossaryEntry='not marked with a brand; "unbranded cattle"'/>
<rdf:Description rdf:about="&a;301420342"
	 b:glossaryEntry='joined in matrimony; "a married man"; "a married couple"'/>
<rdf:Description rdf:about="&a;301420542"
	 b:glossaryEntry="of or relating to two people who are married to each other"/>
<rdf:Description rdf:about="&a;301420662"
	 b:glossaryEntry="of or relating to a marriage partner"/>
<rdf:Description rdf:about="&a;301420750">
	<b:glossaryEntry>wearing a wedding ring; lawfully married; "a ringed wife"- Tennyson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301420870"
	 b:glossaryEntry="having been taken in marriage"/>
<rdf:Description rdf:about="&a;301420958">
	<b:glossaryEntry>not married or related to the unmarried state" "unmarried men and women"; "unmarried life"; "sex and the single girl"; "single parenthood"; "are you married or single?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301421281"
	 b:glossaryEntry="of someone whose marriage has been legally dissolved"/>
<rdf:Description rdf:about="&a;301421388"
	 b:glossaryEntry="of someone who has no marriage partner"/>
<rdf:Description rdf:about="&a;301421481"
	 b:glossaryEntry='of someone who has not been married; "unwed mother"'/>
<rdf:Description rdf:about="&a;301421595"
	 b:glossaryEntry="single because of death of the spouse"/>
<rdf:Description rdf:about="&a;301421686"
	 b:glossaryEntry="mated sexually"/>
<rdf:Description rdf:about="&a;301421806"
	 b:glossaryEntry="mated sexually"/>
<rdf:Description rdf:about="&a;301421873"
	 b:glossaryEntry="not mated sexually"/>
<rdf:Description rdf:about="&a;301421981"
	 b:glossaryEntry="not mated sexually"/>
<rdf:Description rdf:about="&a;301422054"
	 b:glossaryEntry="associated with men and not with women"/>
<rdf:Description rdf:about="&a;301422274">
	<b:glossaryEntry>for or composed of men or boys; "the male lead"; "masculine attire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301422392"
	 b:glossaryEntry="used of men; markedly masculine in appearance or manner"/>
<rdf:Description rdf:about="&a;301422507"
	 b:glossaryEntry='characteristic of a man; "a deep male voice"; "manly sports"'/>
<rdf:Description rdf:about="&a;301422654">
	<b:glossaryEntry>characteristic of a man as distinguished from a woman; "true mannish arrogance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301422787"
	 b:glossaryEntry='associated with women and not with men; "feminine intuition"'/>
<rdf:Description rdf:about="&a;301423028">
	<b:glossaryEntry>attractively feminine (especially in the phrase "the fair sex")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301423145">
	<b:glossaryEntry>for or composed of women or girls; "the female lead in the play"; "a female chorus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301423281">
	<b:glossaryEntry>characteristic of or peculiar to a woman; "female sensitiveness"; "female suffrage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301423427"
	 b:glossaryEntry='befitting or characteristic of a maiden; "a maidenly blush"'/>
<rdf:Description rdf:about="&a;301423554">
	<b:glossaryEntry>used of competitive activities in which only women take part; "powder-puff baseball"; "a powder-puff football game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301423727">
	<b:glossaryEntry>befitting or characteristic of a woman especially a mature woman; "womanly virtues of gentleness and compassion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301423940">
	<b:glossaryEntry>befitting or characteristic of a fully mature woman; "her matronly figure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301424069"
	 b:glossaryEntry='resembling a woman; "a womanlike stone image"'/>
<rdf:Description rdf:about="&a;301424170">
	<b:glossaryEntry>not womanly; "the logical clearness of her arguments...condemned her as eccentric and unwomanly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301424376"
	 b:glossaryEntry="used of girls; wild and boisterous"/>
<rdf:Description rdf:about="&a;301424478">
	<b:glossaryEntry>resembling or imitative of or suggestive of a man rather than a woman; "a mannish stride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301424621"
	 b:glossaryEntry='not suitable for a woman; "an unfeminine depth of voice"'/>
<rdf:Description rdf:about="&a;301424734"
	 b:glossaryEntry="of grammatical gender"/>
<rdf:Description rdf:about="&a;301424847"
	 b:glossaryEntry="of grammatical gender"/>
<rdf:Description rdf:about="&a;301424959">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of grammatical gender; "`it'' is the third-person singular neuter pronoun"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301425103"
	 b:glossaryEntry="going well together; possessing harmonizing qualities"/>
<rdf:Description rdf:about="&a;301425318"
	 b:glossaryEntry="(of a couple) existing together harmoniously"/>
<rdf:Description rdf:about="&a;301425434">
	<b:glossaryEntry>intentionally matched; "curtains and walls were color coordinated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301425569"
	 b:glossaryEntry="being two identical"/>
<rdf:Description rdf:about="&a;301425675"
	 b:glossaryEntry="used of gloves, socks, etc."/>
<rdf:Description rdf:about="&a;301425763"
	 b:glossaryEntry="either not matched or unsuitably matched"/>
<rdf:Description rdf:about="&a;301425914"
	 b:glossaryEntry="not easy to combine harmoniously"/>
<rdf:Description rdf:about="&a;301426040"
	 b:glossaryEntry="of the remaining member of a pair, of socks e.g."/>
<rdf:Description rdf:about="&a;301426171">
	<b:glossaryEntry>directly relevant to a matter especially a law case; "his support made a material difference"; "evidence material to the issue at hand"; "facts likely to influence the judgment are called material facts"; "a material witness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301426469">
	<b:glossaryEntry>having crucial relevance; "crucial to the case"; "relevant testimony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301426603">
	<b:glossaryEntry>of no importance or relevance especially to a law case; "an objection that is immaterial after the fact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301426764">
	<b:glossaryEntry>having reached full natural growth or development; "a mature cell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301427081">
	<b:glossaryEntry>(of animals) fully developed; "an adult animal"; "a grown woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301427248"
	 b:glossaryEntry='bursting into flower; "flowering spring trees"'/>
<rdf:Description rdf:about="&a;301427374"
	 b:glossaryEntry="capable of bearing fruit"/>
<rdf:Description rdf:about="&a;301427453"
	 b:glossaryEntry='fully ripe; at the height of bloom; "a full-blown rose"'/>
<rdf:Description rdf:about="&a;301427575">
	<b:glossaryEntry>of leafy vegetables; having formed into a head; "headed cabbages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301427693"
	 b:glossaryEntry="of girls or women"/>
<rdf:Description rdf:about="&a;301427778"
	 b:glossaryEntry='past the stage of full bloom; "overblown roses"'/>
<rdf:Description rdf:about="&a;301427881">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at the best stage; "our manhood''s prime vigor"- Robert Browning]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301427996"
	 b:glossaryEntry="not yet mature"/>
<rdf:Description rdf:about="&a;301428317">
	<b:glossaryEntry>in the state of development between puberty and maturity; "adolescent boys and girls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301428459">
	<b:glossaryEntry>of an organism prior to birth or hatching; "in the embryonic stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301428594"
	 b:glossaryEntry='beginning to develop; "inchoative stages"'/>
<rdf:Description rdf:about="&a;301428704">
	<b:glossaryEntry>immature of its kind; especially being or characteristic of immature insects in the newly hatched wormlike feeding stage; "larval societies"; "larval crayfishes"; "the larval stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301428938">
	<b:glossaryEntry>(especially of human beings) at the age immediately before puberty; often marked by accelerated growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301429113">
	<b:glossaryEntry>of an inactive stage in the development of some insects, between the larval and the pupal stages; "the prepupal stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301429286">
	<b:glossaryEntry>(of animals especially human beings) having arrived at the onset of puberty (the age at which sex glands become functional) but not yet fully mature; "the budding breasts of a pubescent girl and the downy chin of pubescent boy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301429569">
	<b:glossaryEntry>of the insects in the chrysalis (cocoon) or post larval stage; "the pupal stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301429701"
	 b:glossaryEntry="not yet fully developed"/>
<rdf:Description rdf:about="&a;301429785"
	 b:glossaryEntry='not yet fully formed; "unformed still in body and mind"'/>
<rdf:Description rdf:about="&a;301429895"
	 b:glossaryEntry='characteristic of maturity; "mature for her age"'/>
<rdf:Description rdf:about="&a;301430050">
	<b:glossaryEntry>characteristic of late maturity verging on decline; "a serene autumnal mood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301430181">
	<b:glossaryEntry>having attained to kindliness or gentleness through age and experience; "mellow wisdom"; "the peace of mellow age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301430359">
	<b:glossaryEntry>at the highest point of development especially in judgment or knowledge; "a ripe mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301430496"
	 b:glossaryEntry='characteristic of a lack of maturity; "immature behavior"'/>
<rdf:Description rdf:about="&a;301430680">
	<b:glossaryEntry>displaying or suggesting a lack of maturity; "adolescent insecurity"; "jejune responses to our problems"; "their behavior was juvenile"; "puerile jokes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301430919"
	 b:glossaryEntry='characteristic of a baby; "babyish tears and petulance"'/>
<rdf:Description rdf:about="&a;301431028">
	<b:glossaryEntry>indicating a lack of maturity; "childish tantrums"; "infantile behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301431167"
	 b:glossaryEntry='lacking experience of life; "a callow youth of seventeen"'/>
<rdf:Description rdf:about="&a;301431319">
	<b:glossaryEntry>fully developed or matured and ready to be eaten or used; "ripe peaches"; "full-bodies mature wines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301431533">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of wines, fruit, cheeses; having reached a desired or final condition; (`aged'' pronounced as one syllable); "mature well-aged cheeses"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301431728">
	<b:glossaryEntry>having a full and pleasing flavor through proper aging; "a mellow port"; "mellowed fruit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301431881"
	 b:glossaryEntry="too ripe"/>
<rdf:Description rdf:about="&a;301431944">
	<b:glossaryEntry>not fully developed or mature; "unripe fruit"; "fried green tomatoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301432115">
	<b:glossaryEntry>not subjected to an aging process; "vodka is an unaged liquor from Russia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301432242">
	<b:glossaryEntry>occurring at or dependent on a particular season; "seasonal labor"; "a seasonal rise in unemployment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301432398">
	<b:glossaryEntry>operating or continuing throughout the year; "a year-round resort"; "a year-round job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301432555">
	<b:glossaryEntry>in keeping with the season; "a hard but seasonable frost"; "seasonable clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301432691">
	<b:glossaryEntry>not in keeping with (and usually undesirable for) the season; "a sudden unseasonable blizzard"; "unseasonable bright blue weather in November"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301432892"
	 b:glossaryEntry='aged or processed; "seasoned wood"'/>
<rdf:Description rdf:about="&a;301432999">
	<b:glossaryEntry>(used of concrete or mortar) kept moist to assist the hardening</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301433114"
	 b:glossaryEntry='not aged or processed; "unseasoned timber"'/>
<rdf:Description rdf:about="&a;301433231"
	 b:glossaryEntry='not seasoned; "green wood"; "green pelts"'/>
<rdf:Description rdf:about="&a;301433334">
	<b:glossaryEntry>gestated for the entire duration of normal pregnancy; "a healthy full-term baby"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301433488">
	<b:glossaryEntry>born after a gestation period of less than the normal time; "a premature infant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301433642">
	<b:glossaryEntry>the greatest or most complete or best possible; "maximal expansion"; "maximum pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301433883"
	 b:glossaryEntry='not to be surpassed; "his top effort"'/>
<rdf:Description rdf:about="&a;301433981">
	<b:glossaryEntry>approaching or constituting a maximum; "maximal temperature"; "maximum speed"; "working at peak efficiency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301434152"
	 b:glossaryEntry='maximal in amount; "a maximal amount"; "an outside estimate"'/>
<rdf:Description rdf:about="&a;301434276"
	 b:glossaryEntry='greatest or maximal in degree; extreme; "supreme folly"'/>
<rdf:Description rdf:about="&a;301434385">
	<b:glossaryEntry>the least possible; "needed to enforce minimal standards"; "her grades were minimal"; "minimum wage"; "a minimal charge for the service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301434711">
	<b:glossaryEntry>of questionable or minimal quality; "borderline grades"; "marginal writing ability"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301434862"
	 b:glossaryEntry='at the bottom; lowest or last; "the bottom price"'/>
<rdf:Description rdf:about="&a;301434973">
	<b:glossaryEntry>minimal in magnitude; "lowest wages"; "the least amount of fat allowed"; "the smallest amount"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301435139">
	<b:glossaryEntry>so small as to be meaningless; insignificant; "the effect was negligible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301435269">
	<b:glossaryEntry xml:space='preserve'><![CDATA[insignificantly small; a matter of form only; "the fee was nominal"; "a token gesture of resistance"; (`tokenish'' is informal as in "a tokenish gesture")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301435498">
	<b:glossaryEntry>having only essential or minimal features; "a stripped new car"; "a stripped-down budget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301435658">
	<b:glossaryEntry>of a period of maximal use or demand or activity; "at peak hours the streets traffic is unbelievable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301435828">
	<b:glossaryEntry>advanced into the most active period; "went to Europe in high season"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301435948">
	<b:glossaryEntry>of a period of less than maximal use or demand or activity; "off-peak telepone rates"; "off-peak fares"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301436124">
	<b:glossaryEntry>not in the most active period; "off-season hotel rates are lower"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301436246">
	<b:glossaryEntry>having a meaning or purpose; "a meaningful explanation"; "a meaningful discussion"; "a meaningful pause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301436533">
	<b:glossaryEntry>capable of being understood or interpreted; "a comprehensible experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301436684"
	 b:glossaryEntry="having a covert or special meaning"/>
<rdf:Description rdf:about="&a;301436804"
	 b:glossaryEntry='having substance and prompting thought; "a meaty discussion"'/>
<rdf:Description rdf:about="&a;301436930">
	<b:glossaryEntry>rich in significance or implication; "a meaning look"; "pregnant with meaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301437090">
	<b:glossaryEntry>having meaning through having an aim; "led a happy purposeful life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301437214">
	<b:glossaryEntry>having no meaning or direction or purpose; "a meaningless endeavor"; "a meaningless life"; "a verbose but meaningless explanation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301437546">
	<b:glossaryEntry>devoid of significance or point; "empty promises"; "a hollow victory"; "vacuous comments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301437706">
	<b:glossaryEntry>signifying nothing; "insignificant sounds"; "his response...is picayune and unmeaning"- R.B. Pearsall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301437879">
	<b:glossaryEntry>lacking the thinking capacity characteristic of a conscious being; "the shrieking of the mindless wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301438037">
	<b:glossaryEntry>having no intelligible meaning; "nonsense syllables"; "a nonsensical jumble of words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301438194">
	<b:glossaryEntry>lacking import; "a pointless remark"; "a life essentially purposeless"; "senseless violence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301438368"
	 b:glossaryEntry='possible to be measured; "measurable depths"'/>
<rdf:Description rdf:about="&a;301438500"
	 b:glossaryEntry='impossible to measure; "unmeasurable reaches of outer space"'/>
<rdf:Description rdf:about="&a;301438685"
	 b:glossaryEntry='very great; limitless; "abysmal misery"; "abysmal stupidity"'/>
<rdf:Description rdf:about="&a;301438799">
	<b:glossaryEntry>without limits in extent or size or quantity; "immeasurable vastness of our solar system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301438985">
	<b:glossaryEntry>determined by measurement; "the measured distance was less than a mile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301439129"
	 b:glossaryEntry="(of water depth) measured by a line and plumb"/>
<rdf:Description rdf:about="&a;301439238"
	 b:glossaryEntry="not measured"/>
<rdf:Description rdf:about="&a;301439307">
	<b:glossaryEntry xml:space='preserve'><![CDATA[like or containing meat; "enough of vegetarianism; let''s have a meaty meal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301439434"
	 b:glossaryEntry='lacking meat; "meatless days"'/>
<rdf:Description rdf:about="&a;301439518">
	<b:glossaryEntry>using (or as if using) mechanisms or tools or devices; "a mechanical process"; "his smile was very mechanical"; "a mechanical toy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301439795">
	<b:glossaryEntry xml:space='preserve'><![CDATA[like the unthinking functioning of a machine; "an automatic `thank you''"; "machinelike efficiency"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301439991">
	<b:glossaryEntry>resembling the action of a machine; "from blank to blank a threadless way I pushed mechanic feet"- Emily Dickenson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301440160">
	<b:glossaryEntry>explained in terms of physical forces; "a mechanistic universe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301440281"
	 b:glossaryEntry='equipped with machinery; "a mechanized factory"'/>
<rdf:Description rdf:about="&a;301440385"
	 b:glossaryEntry='operated by a mechanism; "windup toys"'/>
<rdf:Description rdf:about="&a;301440479"
	 b:glossaryEntry="not mechanical"/>
<rdf:Description rdf:about="&a;301440589"
	 b:glossaryEntry="not mechanistic"/>
<rdf:Description rdf:about="&a;301440665">
	<b:glossaryEntry>not mechanized; "production of furniture remained largely unmechanized"- Gordon Russell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301440811">
	<b:glossaryEntry>containing or constituting or characterized by pleasing melody; "the melodious song of a meadowlark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301441077"
	 b:glossaryEntry="having a melody (as distinguished from recitative)"/>
<rdf:Description rdf:about="&a;301441191"
	 b:glossaryEntry="richly melodious"/>
<rdf:Description rdf:about="&a;301441272"
	 b:glossaryEntry="(music) smooth and flowing"/>
<rdf:Description rdf:about="&a;301441364"
	 b:glossaryEntry='pleasing to the ear; "the dulcet tones of the cello"'/>
<rdf:Description rdf:about="&a;301441515"
	 b:glossaryEntry="suitable for or suggestive of singing"/>
<rdf:Description rdf:about="&a;301441606"
	 b:glossaryEntry="lacking melody"/>
<rdf:Description rdf:about="&a;301441720">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sounded or spoken in a tone unvarying in pitch; "the owl''s faint monotonous hooting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301441884"
	 b:glossaryEntry="having a musical sound; especially a pleasing tune"/>
<rdf:Description rdf:about="&a;301442000"
	 b:glossaryEntry="not having a musical sound or pleasing tune"/>
<rdf:Description rdf:about="&a;301442124">
	<b:glossaryEntry>extracted from a source of supply as of minerals from the earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301442293">
	<b:glossaryEntry>of coal, as contrasted with coal obtained from a strip mine; "deep-mined coal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301442428">
	<b:glossaryEntry>well known and commonly used; "Shakespeare exploited many well-mined sources for his plays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301442576"
	 b:glossaryEntry="mined near the earth''s surface by stripping"/>
<rdf:Description rdf:about="&a;301442677"
	 b:glossaryEntry='not mined; "deposits of unmined uranium"'/>
<rdf:Description rdf:about="&a;301442771">
	<b:glossaryEntry>characteristic of or resembling or accompanied by music; "a musical speaking voice"; "a musical comedy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301443000">
	<b:glossaryEntry>sung or uttered rhythmically in a monotone; "a chanted psalm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301443115">
	<b:glossaryEntry>smooth and flowing in quality; entirely free of harshness; "the liquid song of a robin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301443255">
	<b:glossaryEntry>suitable for singing; "singable melody is the essence of music"- Winthrop Sargeant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301443392"
	 b:glossaryEntry='not musical in nature; "the unmusical cry of the bluejay"'/>
<rdf:Description rdf:about="&a;301443548">
	<b:glossaryEntry>talented in or devoted to music; "comes from a very musical family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301443687">
	<b:glossaryEntry>devoted to or appreciative of music; "the most philharmonic ear is at times deeply affected by a simple air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301443854">
	<b:glossaryEntry>lacking interest in or talent for music; "too unmusical to care for concerts"; "it is unfortunate that her children were all nonmusical"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301444059">
	<b:glossaryEntry>changed from a solid to a liquid state; "rivers filled to overflowing by melted snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301444308">
	<b:glossaryEntry>(of solid matter) reduced to a liquid form; "add the dissolved gelatin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301444435"
	 b:glossaryEntry="capable of being melted and fused"/>
<rdf:Description rdf:about="&a;301444522"
	 b:glossaryEntry='reduced to liquid form by heating; "a mass of molten rock"'/>
<rdf:Description rdf:about="&a;301444657"
	 b:glossaryEntry='no longer frozen solid; "the thawed ice was treacheous"'/>
<rdf:Description rdf:about="&a;301444765">
	<b:glossaryEntry>not melted; "streets unpassable because of piles of unmelted snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301444940"
	 b:glossaryEntry="not thawed"/>
<rdf:Description rdf:about="&a;301445003">
	<b:glossaryEntry>retaining a solid form; "undissolved sugar in the bottom of the cup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301445129">
	<b:glossaryEntry>showing or giving mercy; "sought merciful treatment for the captives"; "a merciful god"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301445379">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing merciful compassion; "sparing the child''s mother was a compassionate act"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301445520">
	<b:glossaryEntry>having or showing no mercy; "the merciless enemy"; "a merciless critic"; "gave him a merciless beating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301445872">
	<b:glossaryEntry>ruthless in competition; "cutthroat competition"; "bowelless readiness to take advantage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301446038"
	 b:glossaryEntry='unrelenting and deadly; "mortal enemy"'/>
<rdf:Description rdf:about="&a;301446132">
	<b:glossaryEntry>without mercy or pity; "an act of ruthless ferocity"; "a monster of remorseless cruelty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301446312">
	<b:glossaryEntry>resembling a tiger in fierceness and lack of mercy; "a tigerish fury"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301446436"
	 b:glossaryEntry="(zoology) undergoing metamorphosis"/>
<rdf:Description rdf:about="&a;301446539"
	 b:glossaryEntry="(zoology)undergoing slight or no metamorphosis"/>
<rdf:Description rdf:about="&a;301446656">
	<b:glossaryEntry>moderate in type or degree or effect or force; far from extreme; "a mild winter storm"; "a mild fever"; "fortunately the pain was mild"; "a mild rebuke"; "mild criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301446985">
	<b:glossaryEntry>soft and mild; not harsh or stern or severe; "a gentle reprimand"; "a vein of gentle irony"; "poked gentle fun at him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301447156"
	 b:glossaryEntry="behaving in or having a mild or gentle manner"/>
<rdf:Description rdf:about="&a;301447261">
	<b:glossaryEntry>not extreme; "a moderate penalty"; "temperate in his response to criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301447403">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an extreme degree; "intense heat"; "intense anxiety,"; "intense desire"; "intense emotion"; "the skunk''s intense acrid odor"; "intense pain"; "enemy fire was intense"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301448130">
	<b:glossaryEntry>made more severe or intense especially in law; "aggravated assault"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301448254">
	<b:glossaryEntry>very intense; "a bad headache"; "in a big rage"; "had a big (or bad) shock"; "a bad earthquake"; "a bad storm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301448420"
	 b:glossaryEntry='(informal) "real blood-and-guts self-criticism"'/>
<rdf:Description rdf:about="&a;301448528">
	<b:glossaryEntry>so intense as to be almost uncontrollable; "cold fury gripped him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301448645">
	<b:glossaryEntry>(intensely focused) "her concentrated passion held them at bay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301448767">
	<b:glossaryEntry>very intense; "politics is his consuming passion"; "overwhelming joy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301448907"
	 b:glossaryEntry='highly concentrated or intense; "a crash course"'/>
<rdf:Description rdf:about="&a;301449010"
	 b:glossaryEntry='extreme; "in deep trouble"; "deep happiness"'/>
<rdf:Description rdf:about="&a;301449105">
	<b:glossaryEntry>intense or sharp; "suffered exquisite pain"; "felt exquisite pleasure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301449238">
	<b:glossaryEntry>of the greatest possible degree or extent or intensity; "extreme cold"; "extreme caution"; "extreme pleasure"; "utmost contempt"; "to the utmost degree"; "in the uttermost distress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301449500">
	<b:glossaryEntry>marked by extreme intensity of emotions or convictions; fervid; "fierce loyalty"; "in a tearing rage"; "vehement dislike"; "violent passions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301449725">
	<b:glossaryEntry xml:space='preserve'><![CDATA[made more intense; "the intensified scrutiny of the candidate''s background"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301449858">
	<b:glossaryEntry>characterized by a high degree or intensity; often used as a combining form; "the questioning was intensive"; "intensive care"; "research-intensive"; "a labor-intensive industry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301450092">
	<b:glossaryEntry>of force; of the greatest possible intensity; "by main strength"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301450210">
	<b:glossaryEntry>very intense and demanding; stressful; "subjecting children to a pressure-cooker situation in the school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301450380">
	<b:glossaryEntry>of the greatest intensity; complete; "a profound silence"; "a state of profound shock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301450521"
	 b:glossaryEntry='very severe; "a raging thirst"; "a raging toothache"'/>
<rdf:Description rdf:about="&a;301450626">
	<b:glossaryEntry>so extremely intense as to evoke screams; "in screaming agony"; "a screaming rage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301450767">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intensely or extremely bad or unpleasant in degree or quality; "severe pain"; "a severe case of flu"; "a terrible cough"; "under wicked fire from the enemy''s guns"; "a wicked cough"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301451021"
	 b:glossaryEntry='not faint or feeble; "a strong odor of burning rubber"'/>
<rdf:Description rdf:about="&a;301451128">
	<b:glossaryEntry>very great or intense; "a terrific noise"; "a terrific thunderstorm storm"; "fought a terrific battle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301451285">
	<b:glossaryEntry>(of darkness) very intense; "thick night"; "thick darkness"; "a face in deep shadow"; "deep night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301451442">
	<b:glossaryEntry>continuing at full strength or intensity; "the winds are unabated"; "the popularity of his books among young people continued unabated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301451632">
	<b:glossaryEntry>(of colors or sounds) intensely vivid or loud; "a violent clash of colors"; "her dress was a violent red"; "a violent noise"; "wild colors"; "wild shouts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301451847">
	<b:glossaryEntry>of agriculture; intended to increase productivity of a fixed area by expending more capital and labor; "intensive agriculture"; "intensive conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301452053">
	<b:glossaryEntry>of agriculture; increasing productivity by using large areas with minimal outlay and labor; "producing wheat under extensive conditions"; "agriculture of the extensive type"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301452282">
	<b:glossaryEntry xml:space='preserve'><![CDATA[connected by participation or association or use; "we accomplished nothing, simply because of the large number of people involved"; "the problems involved"; "the involved muscles"; "I don''t want to get involved"; "everyone involved in the bribery case has been identified"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301452717">
	<b:glossaryEntry>taking part in an activity; "an active member of the club"; "he was politically active"; "the participating organizations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301452908">
	<b:glossaryEntry>having become involved involuntarily; "caught up in the excitement of the crowd"; "caught up in the scandal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301453075">
	<b:glossaryEntry>involved in or affected by or having a claim to or share in; "a memorandum to those concerned"; "an enterprise in which three men are concerned"; "factors concerned in the rise and fall of epidemics"; "the interested parties met to discuss the business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301453397">
	<b:glossaryEntry>culpably involved; "all those concerned in the bribery case have been identified"; "named three officials implicated in the plot"; "an innocent person implicated by circumstances in a crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301453656">
	<b:glossaryEntry>deeply involved especially in something complicated; "embroiled in the conflict"; "felt unwilling entangled in their affairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301453849">
	<b:glossaryEntry>involved in military hostilities; "the desperately engaged ships continued the fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301453988"
	 b:glossaryEntry='not involved; "being uninvolved he remained objective"'/>
<rdf:Description rdf:about="&a;301454117">
	<b:glossaryEntry>not occupied or engaged with; "readers unconcerned with style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301454237">
	<b:glossaryEntry>associated with or performed by armed services as contrasted with civilians; "military police"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301454458">
	<b:glossaryEntry>(used of military forces) designed for military operations abroad; "the French expeditionary force in Indochina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301454629"
	 b:glossaryEntry='or or relating to the armed forces; "martial law"'/>
<rdf:Description rdf:about="&a;301454735"
	 b:glossaryEntry="engaging in or ready for combat"/>
<rdf:Description rdf:about="&a;301454822">
	<b:glossaryEntry>member of armed forces whose duties do not include fighting as e.g. a chaplain or surgeon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301454970">
	<b:glossaryEntry>associated with or performed by civilians as contrasted with the military; "civilian clothing" "civilian life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301455171">
	<b:glossaryEntry>applying to ordinary citizens; "civil law"; "civil authorities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301455286"
	 b:glossaryEntry="used of civilians in time of war"/>
<rdf:Description rdf:about="&a;301455377">
	<b:glossaryEntry>characteristic of or associated with soldiers or the military; "military uniforms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301455568"
	 b:glossaryEntry="imbued with militarism"/>
<rdf:Description rdf:about="&a;301455649"
	 b:glossaryEntry='(of persons) befitting a warrior; "a military bearing"'/>
<rdf:Description rdf:about="&a;301455797"
	 b:glossaryEntry="suggesting war or military life"/>
<rdf:Description rdf:about="&a;301455892">
	<b:glossaryEntry>not associated with soldiers or the military; "unmilitary circles of government"; "fatigue duty involves nonmilitary labor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301456104"
	 b:glossaryEntry='not conforming to military standards; "unsoldierly posture"'/>
<rdf:Description rdf:about="&a;301456221">
	<b:glossaryEntry>made less severe or intense; "he gladly accepted the mitigated penalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301456402"
	 b:glossaryEntry="(of pain or sorrow) made easier to bear"/>
<rdf:Description rdf:about="&a;301456517"
	 b:glossaryEntry="decreased in severity; made less harsh"/>
<rdf:Description rdf:about="&a;301456610"
	 b:glossaryEntry='allayed; "his thirst quenched he was able to continue"'/>
<rdf:Description rdf:about="&a;301456740">
	<b:glossaryEntry>not diminished or moderated in intensity or severity; sometimes used as an intensifier; "unmitigated suffering"; "an unmitigated horror"; "an unmitigated lie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301457028">
	<b:glossaryEntry>without qualification; used informally as (often pejorative) intensifiers; "an arrant fool"; "a complete coward"; "a consummate fool"; "a double-dyed villain"; "gross negligence"; "a perfect idiot"; "pure folly"; "what a sodding mess"; "stark staring mad"; "a thoroughgoing villain"; "utter nonsense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301457549">
	<b:glossaryEntry>(used of persons) informal intensifiers; "what a bally (or blinking) nuisance"; "a bloody fool"; "a crashing bore"; "you flaming idiot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301457805"
	 b:glossaryEntry='(regional informal) incorrigible; "a bodacious gossip"'/>
<rdf:Description rdf:about="&a;301457915"
	 b:glossaryEntry='not lessened or diminished; "unrelieved suffering"'/>
<rdf:Description rdf:about="&a;301458037">
	<b:glossaryEntry>adjusted or attuned by adding a counterbalancing element; "criticism tempered with kindly sympathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301458245">
	<b:glossaryEntry>made less strong or severe; "a pale gleam of diluted sunlight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301458377">
	<b:glossaryEntry>having elements or qualities mixed in proper or suitable proportions; especially made less severe; "justice moderated with mercy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301458574">
	<b:glossaryEntry>(music) tuned in equal temperament; or so tuned as to allow modulation into other keys</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301458712">
	<b:glossaryEntry>not tempered; "individualism untempered by social responsibilities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301458854"
	 b:glossaryEntry='not made less extreme; "spoke with unmoderated harshness"'/>
<rdf:Description rdf:about="&a;301458969">
	<b:glossaryEntry>made hard or flexible or resilient especially by heat treatment; "a sword of tempered steel"; "tempered glass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301459221">
	<b:glossaryEntry>made less brittle by heating and then cooling; "used annealed paving blocks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301459352">
	<b:glossaryEntry>hardened by subjecting to intense heat; "baked bricks"; "burned bricks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301459492">
	<b:glossaryEntry>baked or hardened by exposure to sunlight; not burned; "sunbaked adobe bricks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301459625">
	<b:glossaryEntry>not brought to a proper consistency or hardness; "untempered mortar"; "untempered steel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301459801">
	<b:glossaryEntry>(of metal or glass) not annealed and consequently easily cracked or fractured</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301459945">
	<b:glossaryEntry>moving or capable of moving readily (especially from place to place); "a mobile missile system"; "the tongue is...the most mobile articulator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301460446"
	 b:glossaryEntry="moved or conveyed by or through air"/>
<rdf:Description rdf:about="&a;301460536"
	 b:glossaryEntry='able to walk about; "the patient is ambulatory"'/>
<rdf:Description rdf:about="&a;301460651"
	 b:glossaryEntry='inclined to move or be moved about; "a floating crap game"'/>
<rdf:Description rdf:about="&a;301460764">
	<b:glossaryEntry>designed for swift movement or action; "a flying police squad is trained for quick action anywhere in the city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301460928">
	<b:glossaryEntry>capable of maneuvering or changing position; "a highly maneuverable ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301461075"
	 b:glossaryEntry='using vehicles; "motorized warfare"'/>
<rdf:Description rdf:about="&a;301461179"
	 b:glossaryEntry="(of spores or microorganisms) capable of movement"/>
<rdf:Description rdf:about="&a;301461281"
	 b:glossaryEntry="capable of being moved or conveyed from one place to another"/>
<rdf:Description rdf:about="&a;301461453">
	<b:glossaryEntry>strolling or walking around; "perambulating nursemaids with their charges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301461587">
	<b:glossaryEntry>capable of being raised; "the roadster had a raisable sunroof"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301461716"
	 b:glossaryEntry="adapted to wandering or roaming"/>
<rdf:Description rdf:about="&a;301461799">
	<b:glossaryEntry>capable of being rotated; "the theater had a rotatable stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301461916"
	 b:glossaryEntry="conveyed by sea"/>
<rdf:Description rdf:about="&a;301461986"
	 b:glossaryEntry="capable of being transplanted"/>
<rdf:Description rdf:about="&a;301462076">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(biology) able to move freely in all directions; "an owl''s versatile toe can move backward and forward"; "an insect''s versatile antennae can move up and down or laterally"; "a versatile anther of a flower moves freely in the wind"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301462362"
	 b:glossaryEntry='transported by water; "waterborne freight"'/>
<rdf:Description rdf:about="&a;301462461"
	 b:glossaryEntry="not capable of movement or of being moved"/>
<rdf:Description rdf:about="&a;301462629"
	 b:glossaryEntry='not able or intended to be moved; "the immovable hills"'/>
<rdf:Description rdf:about="&a;301462775"
	 b:glossaryEntry="(of spores or microorganisms) not capable of movement"/>
<rdf:Description rdf:about="&a;301462895"
	 b:glossaryEntry='not moving or operating freely; "a stiff hinge"'/>
<rdf:Description rdf:about="&a;301462994">
	<b:glossaryEntry>easily or conveniently transported; "a portable television set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301463148">
	<b:glossaryEntry>(of personal property as opposed to real estate) can be moved from place to place (especially carried by hand)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301463313">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of or involving food to be taken and eaten off the premises; "takeout pizza"; "the takeout counter" (`take-away'' is chiefly British)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301463511"
	 b:glossaryEntry="not portable; not easily moved or transported"/>
<rdf:Description rdf:about="&a;301463613">
	<b:glossaryEntry>that can be removed or taken away or dismissed; "a removable cord"; "removable partitions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301463795"
	 b:glossaryEntry='subject to dismissal; "appointed and removable by the mayor"'/>
<rdf:Description rdf:about="&a;301463913"
	 b:glossaryEntry="capable of being extracted"/>
<rdf:Description rdf:about="&a;301464011">
	<b:glossaryEntry>impossible to remove or take away or dismiss; "irremovable boulders"; irremovable obstacles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301464179">
	<b:glossaryEntry>appointed for life and not subject to dismissal except for a grave crime; "an irremovable officer"; "a tenured professor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301464354">
	<b:glossaryEntry>containing or made of or resembling or characteristic of a metal; "a metallic compound"; "metallic luster"; "the strange metallic note of the meadow lark, suggesting the clash of vibrant blades"- Ambrose Bierce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301464810"
	 b:glossaryEntry="containing aluminum or alum"/>
<rdf:Description rdf:about="&a;301464909"
	 b:glossaryEntry='containing antimony; "antimonial lead"'/>
<rdf:Description rdf:about="&a;301465004"
	 b:glossaryEntry='containing or yielding silver; "argentiferous ore"'/>
<rdf:Description rdf:about="&a;301465114"
	 b:glossaryEntry='containing gold; "auriferous quartz veins"'/>
<rdf:Description rdf:about="&a;301465228">
	<b:glossaryEntry>formed of two different metals or alloys; especially in sheets bonded together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301465373"
	 b:glossaryEntry="made from or consisting of bronze"/>
<rdf:Description rdf:about="&a;301465459">
	<b:glossaryEntry>made from or covered with gold; "gold coins"; "the gold dome of the Capitol"; "the golden calf"; "gilded icons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301465639"
	 b:glossaryEntry="resembling metal"/>
<rdf:Description rdf:about="&a;301465711">
	<b:glossaryEntry>made from or largely consisting of silver; "silver bracelets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301465825">
	<b:glossaryEntry>thin and metallic in sound; lacking resonance; "an unpleasant tinny voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301465951">
	<b:glossaryEntry>not containing or resembling or characteristic of a metal; "nonmetallic elements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301466119">
	<b:glossaryEntry>of or being a nonmetallic element that has some of the properties of metal; "arsenic is a metalloid element"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301466283">
	<b:glossaryEntry>characterized by metamorphosis or change in physical form or substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301466519">
	<b:glossaryEntry>(biology) characterized by incomplete metamorphosis; having the same number of body segments in successive stages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301466689">
	<b:glossaryEntry>(of an insect with aquatic young) undergoing incomplete metamorphosis in which the young does not resemble the adult</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301466919">
	<b:glossaryEntry>(of an insect) undergoing incomplete metamorphosis in which the nymph is essentially like the adult and there is no pupal stage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301467127"
	 b:glossaryEntry="(of an insect) undergoing complete metamorphosis"/>
<rdf:Description rdf:about="&a;301467252">
	<b:glossaryEntry>(biology) produced by metamorphosis; "most insects are metamorphic as witness the stages as a butterfly develops from a caterpillar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301467443">
	<b:glossaryEntry>(geology) changed in constitution or structure or composition by metamorphism; "metamorphic rocks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301467595"
	 b:glossaryEntry="not metamorphic"/>
<rdf:Description rdf:about="&a;301467689"
	 b:glossaryEntry="undergoing no (or only slight) metamorphosis"/>
<rdf:Description rdf:about="&a;301467790">
	<b:glossaryEntry>being within reasonable or average limits; not excessive or extreme; "moderate prices"; "a moderate income"; "a moderate fine"; "moderate demands"; "a moderate estimate"; "a moderate eater"; "moderate success"; "a kitchen of moderate size"; "the X-ray showed moderate enlargement of the heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301468318">
	<b:glossaryEntry>around the middle of a scale of evaluation of physical measures; "an orange of average size"; "intermediate capacity"; "a plane with intermediate range"; "medium bombers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301468566"
	 b:glossaryEntry='avoiding excess; "a conservative estimate"'/>
<rdf:Description rdf:about="&a;301468678">
	<b:glossaryEntry>not excessive or extreme; "a fairish income"; "reasonable prices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301468817">
	<b:glossaryEntry>neither too great nor too little; "a couple of indifferent hills to climb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301468949"
	 b:glossaryEntry="not excessive"/>
<rdf:Description rdf:about="&a;301469016"
	 b:glossaryEntry="not extreme, especially in political views"/>
<rdf:Description rdf:about="&a;301469123">
	<b:glossaryEntry>not large but sufficient in size or amount; "a modest salary"; "modest inflation"; "helped in my own small way"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301469295">
	<b:glossaryEntry>not within reasonable limits; "immoderate laughter"; "immoderate spending"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301469750">
	<b:glossaryEntry>being excessive or unreasonable; "the clothes she wears are a bit much"; "in retrospect the elaborate preparations seemed de trop"; "this is entirely too much!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301469994">
	<b:glossaryEntry>much greater than the normal; "abnormal profits"; "abnormal ambition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301470118">
	<b:glossaryEntry>(informal) extreme; used as an intensifier; "why is he in such an all-fired hurry?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301470257">
	<b:glossaryEntry>represented as greater than is true or reasonable; "an exaggerated opinion of oneself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301470425">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(in negative statements) either every little or very great but unspecified; "can''t stand any noise"; "could not endure chemotherapy for any length of time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301470633">
	<b:glossaryEntry>beyond normal limits; "excessive charges"; "a book of inordinate length"; "his dress stops just short of undue elegance"; "unreasonable demands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301470869">
	<b:glossaryEntry>greatly exceeding bounds of reason or moderation; "exorbitant rent"; "extortionate prices"; "spends an outrageous amount on entertainment"; "usorious interest rate"; "unconscionable spending"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301471181">
	<b:glossaryEntry>far more than usual or expected; "an extraordinary desire for approval"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301471312">
	<b:glossaryEntry>far beyond a norm in quantity or amount or degree; to an utmost degree; "an extreme example"; "extreme temperatures"; "extreme danger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301471500">
	<b:glossaryEntry>beyond a norm in views or actions; "an extreme conservative"; "an extreme liberal"; "extreme views on integration"; "extreme opinions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301471688">
	<b:glossaryEntry>(used of opinions and actions) far beyond the norm; "extremist political views"; "radical opinions on education"; "an ultra conservative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301471899"
	 b:glossaryEntry='beyond a norm in opinion or actions; "the far right"'/>
<rdf:Description rdf:about="&a;301472001"
	 b:glossaryEntry='(prefix) excessive; "over-abusive"; "overabusive"'/>
<rdf:Description rdf:about="&a;301472101"
	 b:glossaryEntry='complete or extreme; "stark poverty"; "a stark contrast"'/>
<rdf:Description rdf:about="&a;301472209">
	<b:glossaryEntry>belonging to the present or to recent times; since the Middle Ages; "modern art"; "modern furniture"; "modern history"; "totem poles are modern rather than prehistoric"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301472664">
	<b:glossaryEntry>characteristic of the present; "contemporary (or modern) trends in design"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301472797">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in accord with the most modern ideas or styles; "wears only the latest styles"; "the last thing in swimwear"; "always knows the newest dances"; "everything''s up-to-date in Kansas City"; "up-to-date technology"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301473088">
	<b:glossaryEntry>noticeably (sometimes outrageously) modern; "shiny tables in modernistic design"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301473226"
	 b:glossaryEntry='brought up to date; "modernized methods of lumbering"'/>
<rdf:Description rdf:about="&a;301473336">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used as a combining form) recent or new; "`neo'' is a combining form in words like `neocolonialism''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301473486">
	<b:glossaryEntry>near to or not long before the present; "recent times"; "of recent origin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301473613">
	<b:glossaryEntry>highest level of development at a particular time (especially the present); "state-of-the-art technology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301473781"
	 b:glossaryEntry='extremely modern; "Dadism and ultramodern art"'/>
<rdf:Description rdf:about="&a;301473885">
	<b:glossaryEntry>relating to a style of design popular in the Europe and the United States in the 1920s and 1930s (sometimes known as Art Deco)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301474065"
	 b:glossaryEntry="not modern; of or characteristic of an earlier time"/>
<rdf:Description rdf:about="&a;301474370">
	<b:glossaryEntry>belonging to a period before a war especially the American Civil War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301474495">
	<b:glossaryEntry>(used pejoratively) old-fashioned; "moss-grown ideas about family life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301474672">
	<b:glossaryEntry>relating to the time before automobiles (and other inventions) changed the way people lived in industrialized nations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301474851">
	<b:glossaryEntry>as if belonging to the Middle Ages; old-fashioned and unenlightened; "a medieval attitude toward dating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301475031">
	<b:glossaryEntry>belonging to or characteristic of times past; "old-fashioned wire-rimmed glasses"; "outmoded techniques"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301475206">
	<b:glossaryEntry>attractively old-fashioned; "houses with quaint thatched roofs"; "a vaulted roof supporting quaint chimney pots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301475382">
	<b:glossaryEntry>characteristic of former times especially in Europe; "an old-world cottage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301475513"
	 b:glossaryEntry="not brought up to date"/>
<rdf:Description rdf:about="&a;301475594">
	<b:glossaryEntry>typical of the moral standards or conduct of the age of Victoria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301475714"
	 b:glossaryEntry="not offensive to sexual mores in conduct or appearance"/>
<rdf:Description rdf:about="&a;301475929">
	<b:glossaryEntry>affectedly modest or shy especially in a playful or provocative way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301476068">
	<b:glossaryEntry>observing conventional sexual mores in speech or behavior or dress; "a modest neckline in her dress"; "though one of her shoulder straps had slipped down, she was perfectly decent by current standards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301476322"
	 b:glossaryEntry='(informal) decently clothed; "are you decent?"'/>
<rdf:Description rdf:about="&a;301476421">
	<b:glossaryEntry>extremely modest or shy; "cheerfully bearing reproaches but shamefaced at praise"- H.O.Taylor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301476571"
	 b:glossaryEntry="offending against sexual mores in conduct or appearance"/>
<rdf:Description rdf:about="&a;301476735">
	<b:glossaryEntry>offending against sexual mores in conduct or appearance; "a bathing suit considered indecent by local standards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301476902">
	<b:glossaryEntry>marked by simplicity; having a humble opinion of yourself; "a modest apartment"; "too modest to wear his medals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301477103">
	<b:glossaryEntry>not arrogant or presuming; "unassuming to a fault, skeptical about the value of his work"; "a shy retiring girl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301477283">
	<b:glossaryEntry>having or showing an exaggerated opinion of your importance, ability, etc; "brash immodest boasting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301477528">
	<b:glossaryEntry>having or suggesting a consciousness of high position; "recited the decree with an important air"; "took long important strides in the direction of his office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301477743">
	<b:glossaryEntry>presumptuously arrogant; "had a witty but overweening manner"; "no idea how overweening he would be"- S.V.Benet; "getting a little uppity and needed to be slapped down"- NY Times</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301477988">
	<b:glossaryEntry>changed in form or character; "their modified stand made the issue more acceptable"; "the performance of the modified aircraft was much improved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301478260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[changed in order to improve or made more fit for a particular purpose; "seeds precisely adapted to the area"; "instructions altered to suit the children''s different ages"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301478494">
	<b:glossaryEntry>(grammar) restricted in meaning; (as e.g. `man'' in `a tall man'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301478627"
	 b:glossaryEntry="not changed in form or character"/>
<rdf:Description rdf:about="&a;301478770"
	 b:glossaryEntry="not changed in form or character for a purpose"/>
<rdf:Description rdf:about="&a;301478872">
	<b:glossaryEntry>(grammar) not restricted or modified in meaning; "unrestricted verbs are usually stronger than those qualified by adverbs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301479053"
	 b:glossaryEntry="changed or adjusted to be suitable"/>
<rdf:Description rdf:about="&a;301479161"
	 b:glossaryEntry="toned down"/>
<rdf:Description rdf:about="&a;301479226">
	<b:glossaryEntry>not modulated; not toned down; "he lectured in an unmodulated voice edged with hysteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301479372">
	<b:glossaryEntry>(psychology) pertaining to large units of behavior; "such molar problems of personality as the ego functions" (R.R. Hunt)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301479548">
	<b:glossaryEntry>(psychology) relating to simple or elementary organization; "proceed by more and more detailed analysis to the molecular facts of perception" (G.A. Miller)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301479762"
	 b:glossaryEntry="(botany) having pistils and stamens in the same flower"/>
<rdf:Description rdf:about="&a;301479892"
	 b:glossaryEntry="of or relating to monoclinous plants"/>
<rdf:Description rdf:about="&a;301479989"
	 b:glossaryEntry="(botany) having pistils and stamens in separate flowers"/>
<rdf:Description rdf:about="&a;301480100">
	<b:glossaryEntry>having male and female reproductive organs in the same plant or animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301480239">
	<b:glossaryEntry>having male and female reproductive organs in separate plants or animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301480378"
	 b:glossaryEntry="(music) consisting of a single melodic line"/>
<rdf:Description rdf:about="&a;301480514"
	 b:glossaryEntry="having a single melodic line with accompaniment"/>
<rdf:Description rdf:about="&a;301480618"
	 b:glossaryEntry="having a single vocal part"/>
<rdf:Description rdf:about="&a;301480710">
	<b:glossaryEntry>(music) having two or more independent but harmonically related melodic parts sounding together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301480877">
	<b:glossaryEntry>(used of relationships and of individuals) having one mate; "monogamous marriage"; "monogamous for life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301481074"
	 b:glossaryEntry="having only one husband at a time"/>
<rdf:Description rdf:about="&a;301481164">
	<b:glossaryEntry>having one head or chief wife at a time (along with concubines)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301481296">
	<b:glossaryEntry>having more than one mate at a time; used of relationships and individuals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301481481">
	<b:glossaryEntry>of illegal marriage to a second person while legally married to a first</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301481607"
	 b:glossaryEntry="having more than one husband at a time"/>
<rdf:Description rdf:about="&a;301481703"
	 b:glossaryEntry="having more than one wife at a time"/>
<rdf:Description rdf:about="&a;301481795">
	<b:glossaryEntry>using or knowing only one language; "monolingual speakers"; "a monolingual dictionary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301481939">
	<b:glossaryEntry>using or knowing more than one language; "a multilingual translator"; "a multilingual nation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301482145"
	 b:glossaryEntry='using or knowing two languages; "bilingual education"'/>
<rdf:Description rdf:about="&a;301482254">
	<b:glossaryEntry>having a command of or composed in many languages; "a polyglot traveler"; "a polyglot Bible contains versions in different languages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301482442"
	 b:glossaryEntry='using or knowing three languages; "trilingual speakers"'/>
<rdf:Description rdf:about="&a;301482554"
	 b:glossaryEntry="(chemistry) having a valence of 1"/>
<rdf:Description rdf:about="&a;301482674">
	<b:glossaryEntry>(chemistry) having more than one valence, or having a valence of 3 or higher</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301482839">
	<b:glossaryEntry>(genetics) used of a chromosome that is not paired or united with its homologous chromosome during synapsis; "a univalent chromosome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301483064">
	<b:glossaryEntry>(genetics) used of homologous chromosomes associated in pairs in synapsis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301483237">
	<b:glossaryEntry>(genetics) used of the association of three or more homologous chromosomes during the first division of meiosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301483442">
	<b:glossaryEntry>(mathematics) of a sequence or function; consistently increasing and never decreasing or consistently decreasing and never increasing in value</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301483687"
	 b:glossaryEntry='consistently decreasing; "a decreasing monotonic function"'/>
<rdf:Description rdf:about="&a;301483812"
	 b:glossaryEntry='consistently increasing; "an increasing monotonic function"'/>
<rdf:Description rdf:about="&a;301483938"
	 b:glossaryEntry="(math or logic) not monotonic"/>
<rdf:Description rdf:about="&a;301484026"
	 b:glossaryEntry="(immunology) containing only one kind of antibody"/>
<rdf:Description rdf:about="&a;301484150">
	<b:glossaryEntry>(immunology) containing several antibodies each capable of counteracting a specific antigen; "a polyvalent vaccine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301484340">
	<b:glossaryEntry>concerned with principles of right and wrong or conforming to standards of behavior and character based on those principles; "moral sense"; "a moral scrutiny"; "a moral lesson"; "a moral quandary"; "moral convictions"; "a moral life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301484859"
	 b:glossaryEntry="abstaining from unlawful sexual intercourse"/>
<rdf:Description rdf:about="&a;301484955"
	 b:glossaryEntry='morally pure; "led a clean life"'/>
<rdf:Description rdf:about="&a;301485054"
	 b:glossaryEntry="narrowly and conventionally moral"/>
<rdf:Description rdf:about="&a;301485144"
	 b:glossaryEntry='morally justified; "righteous indignation"'/>
<rdf:Description rdf:about="&a;301485242"
	 b:glossaryEntry="free of corruption or immorality"/>
<rdf:Description rdf:about="&a;301485330">
	<b:glossaryEntry>behaving according to standards of what is right or just; "led a virtuous (or moral) life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301485475"
	 b:glossaryEntry="violating principles of right and wrong"/>
<rdf:Description rdf:about="&a;301485730">
	<b:glossaryEntry>unrestrained by convention or morality; "Congreve draws a debauched aristocratic society"; "deplorably dissipated and degraded"; "riotous living"; "fast women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301486036">
	<b:glossaryEntry>giving offense to moral sensibilities and injurious to reputation; "scandalous behavior"; "the wicked rascally shameful conduct of the bankrupt"- Thackeray; "the most shocking book of its time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301486322">
	<b:glossaryEntry>morally contaminated; "denounce the scrofulous wealth of the times"- J.D.Hart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301486456">
	<b:glossaryEntry>without moral standards or principles; "a completely amoral person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301486658">
	<b:glossaryEntry>neither moral nor immoral; neither good nor evil, right nor wrong</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301486777">
	<b:glossaryEntry>lying outside the bounds of morals or ethics; "imagination is of its nature nonmoral"; "infants are nonmoral"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301486941">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sanctioned by custom or morality especially sexual morality; "a wife''s licit love"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301487075">
	<b:glossaryEntry>contrary to accepted morality (especially sexual morality) or convention; "an illicit association with his secretary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301487282">
	<b:glossaryEntry>characterized by adultery; "an adulterous relationship"; "extramarital affairs"; "the extracurricular activities of a philandering husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301487511"
	 b:glossaryEntry='not morally right or permissible; "unlawful love"'/>
<rdf:Description rdf:about="&a;301487615">
	<b:glossaryEntry>based on or manifesting objectively defined standards of rightness or morality; "principled pragmatism and unprincipled expediency"; "a principled person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301487862"
	 b:glossaryEntry="having high principles"/>
<rdf:Description rdf:about="&a;301487946">
	<b:glossaryEntry>lacking principles or moral scruples; "freedom from coarse unprincipled calumny"- A.E.Stevenson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301488136"
	 b:glossaryEntry='morally unprincipled; "immoral behavior"'/>
<rdf:Description rdf:about="&a;301488230"
	 b:glossaryEntry='on horseback or provided with horses; "mounted police"'/>
<rdf:Description rdf:about="&a;301488356"
	 b:glossaryEntry='devoted to horses; "the horsy set"'/>
<rdf:Description rdf:about="&a;301488451"
	 b:glossaryEntry='not on horseback or provided with horses; "unmounted troops"'/>
<rdf:Description rdf:about="&a;301488621"
	 b:glossaryEntry="(used of cavalry) fighting as infantry"/>
<rdf:Description rdf:about="&a;301488716"
	 b:glossaryEntry="(of a horse) having no rider"/>
<rdf:Description rdf:about="&a;301488800"
	 b:glossaryEntry='thrown from a horse; "took mercy on his unhorsed opponent"'/>
<rdf:Description rdf:about="&a;301488913">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(quantifier used with count nouns; often preceded by `as'' or `too'' or `so'' or `that'') amounting to a large but indefinite number; "many temptations"; "the temptations are many"; "a good many"; "a great many"; "many directions"; "take as many apples as you like"; "too many clouds to see"; "never saw so many people"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301489423"
	 b:glossaryEntry='in great numbers; "daffodils galore"'/>
<rdf:Description rdf:about="&a;301489516">
	<b:glossaryEntry>each of a large indefinite number; "many a man"; "many another day will come"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301489680">
	<b:glossaryEntry>amounting to a large indefinite number; "numerous times"; "the family was numerous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301489818">
	<b:glossaryEntry>relatively many but unspecified in number; "they were here for some weeks"; "we did not meet again for some years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301489986"
	 b:glossaryEntry="innumerable but many"/>
<rdf:Description rdf:about="&a;301490069">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(quantifier used with count nouns; often preceded by `a'') a small number; "a few weeks ago"; "a few more wagons than usual"; "an invalid''s pleasures are few and far between"; "few roses were still blooming"; "few women have led troops in battle"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301490454">
	<b:glossaryEntry>more than one but indefinitely small in number; "a few roses"; "a couple of roses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301490608">
	<b:glossaryEntry>very few; "hardly a man is now alive who remembers that famous date and year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301490743">
	<b:glossaryEntry>(quantifier used with mass nouns) great in quantity or degree or extent; "not much rain"; "much affection"; "much grain is in storage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301491021">
	<b:glossaryEntry>very great in quantity; overabundant; "showed overmuch affection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301491141">
	<b:glossaryEntry>relatively much but unspecified in amount or extent; "we talked for some time"; "he was still some distance away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301491308">
	<b:glossaryEntry>of so extreme a degree or extent; "such weeping"; "so much weeping"; "such a help"; "such grief"; "never dreamed of such beauty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301491500"
	 b:glossaryEntry='of an incalculable amount; "untold suffering"'/>
<rdf:Description rdf:about="&a;301491598">
	<b:glossaryEntry>(quantifier used with mass nouns) small in quantity or degree; not much or almost none or (with "a) at least some; "little rain fell in May"; "gave it little thought"; "little hope remained"; "little time is left"; "we still have little money"; "a little hope remained"; "a little time isleft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301492001">
	<b:glossaryEntry xml:space='preserve'><![CDATA[almost no or (with "a) at least some; very little; "there''s slight chance that it will work"; "there''s a slight chance it will work"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301492186">
	<b:glossaryEntry>(archaic) slight or limited; especially in degree or intensity or scope; "a series of death struggles with small time in between"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301492370">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `much'' used with mass nouns) quantifier meaning greater in size or amount or extent or degree; "more land"; "more support"; "more rain fell"; "more than a gallon"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301492632">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `little'' usually used with mass nouns) quantifier meaning not as great in amount or degree; "of less importance"; "less time to spend with the family"; "a shower uses less water"; "less than three years old"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301492927">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(superlative of `much'' used with mass nouns; usually preceded by `the'') quantifier meaning the greatest in amount or extent or degree; used with mass nouns; usually follows `the''; "made the most money he could"; "what attracts the most attention?"; "made the most of a bad deal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301493259">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(superlative of `little'' used with mass nouns; usually preceded by `the'') quantifier meaning smallest in amount or extent or degree; "didn''t care the least bit"; "he has the least talent of anyone"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301493529">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually follows `the'') most meager; "didn''t have the slightest chance"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301493656">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `many'' used with count nouns) quantifier meaning greater in number; "a hall with more seats"; "we have no more bananas"; "more than one"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301493934">
	<b:glossaryEntry>much greater in number; "there were many more people than chairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301494058">
	<b:glossaryEntry>greater in number relative to something else; "more than one person stood up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301494191">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `few'' used with count nouns) quantifier meaning a smaller number of; "fewer birds came this year"; "the birds are fewer this year"; "fewer trains were late"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301494469">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(nonstandard in some uses but often idiomatic with measure phrases; `we had less apples'' is not acceptable) fewer; "less than three weeks"; "no less than 50 people attended"; "in 25 words or less"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301494716">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(superlative of `many'' used with count nouns; often preceded by `the'') quantifier meaning the greatest in number; "who has the most apples?"; "most people like eggs"; "most fishes have fins"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301494960">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(superlative of `few'' used with count nouns; usually preceded by `the'') quantifier meaning the smallest in number; "the fewest birds in recent memory"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301495166"
	 b:glossaryEntry='subject to death; "mortal beings"'/>
<rdf:Description rdf:about="&a;301495306"
	 b:glossaryEntry='of earthly origin (as mortals are); "earthborn existence"'/>
<rdf:Description rdf:about="&a;301495419"
	 b:glossaryEntry="not subject to death"/>
<rdf:Description rdf:about="&a;301495602"
	 b:glossaryEntry="of an imaginary flower that never fades"/>
<rdf:Description rdf:about="&a;301495710"
	 b:glossaryEntry='never dying; "his undying fame"'/>
<rdf:Description rdf:about="&a;301495807"
	 b:glossaryEntry="lasting for an indefinitely long period of time"/>
<rdf:Description rdf:about="&a;301495951"
	 b:glossaryEntry="characterized by divine or godlike nature"/>
<rdf:Description rdf:about="&a;301496045">
	<b:glossaryEntry>provided with a motive or given incentive for action; "a highly motivated child can learn almost anything"; "a group of politically motivated men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301496301"
	 b:glossaryEntry='moved to action; "a man actuated by unworthy desired"'/>
<rdf:Description rdf:about="&a;301496409">
	<b:glossaryEntry>urged or forced to action through moral pressure; "felt impelled to take a stand against the issue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301496572"
	 b:glossaryEntry="without motivation"/>
<rdf:Description rdf:about="&a;301496702">
	<b:glossaryEntry>having no justifying cause or reason; "a senseless, causeless murder"; "a causeless war that never had an aim"; "an apparently arbitrary and reasonless change"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301496930">
	<b:glossaryEntry>occurring without motivation or provocation; "motiveless malignity"; "unprovoked and dastardly attack"- F.D.Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301497126"
	 b:glossaryEntry='equipped with a motor or motors; "a motorized wheelchair"'/>
<rdf:Description rdf:about="&a;301497285"
	 b:glossaryEntry="having two motors"/>
<rdf:Description rdf:about="&a;301497358"
	 b:glossaryEntry="having three motors"/>
<rdf:Description rdf:about="&a;301497434"
	 b:glossaryEntry="having no motor"/>
<rdf:Description rdf:about="&a;301497519"
	 b:glossaryEntry='emotionally moved; "too moved to speak"'/>
<rdf:Description rdf:about="&a;301497685">
	<b:glossaryEntry xml:space='preserve'><![CDATA[emotionally affected; "very touched by the stranger''s kindness"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301497832">
	<b:glossaryEntry>deeply moved; "sat completely still, enraptured by the music"; "listened with rapt admiration"; "rapt in reverie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301498009">
	<b:glossaryEntry>emotionally unmoved; "always appeared completely unmoved and imperturbable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301498195"
	 b:glossaryEntry='not touched emotionally; "was left untouched by the music"'/>
<rdf:Description rdf:about="&a;301498328">
	<b:glossaryEntry>arousing or capable of arousing deep emotion; "she laid her case of destitution before him in a very moving letter"- N. Hawthorne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301498636">
	<b:glossaryEntry>arousing affect; "the homecoming of the released hostages was an affecting scene"; "poignant grief cannot endure forever"; "his gratitude was simple and touching"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301498876">
	<b:glossaryEntry>having a deeply disquieting or disturbing effect; "from two handsome and talented young men to two haunting horrors of disintegration"-Charles Lee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301499077">
	<b:glossaryEntry>causing gladness and pleasure; "Is there a sight more heartwarming than a family reunion?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301499226">
	<b:glossaryEntry>exciting strong but not unpleasant emotions; "a stirring speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301499361"
	 b:glossaryEntry="not arousing emotions"/>
<rdf:Description rdf:about="&a;301499491"
	 b:glossaryEntry="not arousing affect"/>
<rdf:Description rdf:about="&a;301499568">
	<b:glossaryEntry>in motion; "a constantly moving crowd"; "the moving parts of the machine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301500612">
	<b:glossaryEntry>being in physical motion; "active fish in the aquarium"; "a nurse is on the move all day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301500771">
	<b:glossaryEntry>traveling by foot; "she was afoot when I saw her this morning"; "a walking tour of the town"; "a walking and talking doll"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301500961"
	 b:glossaryEntry='thrown from side to side; "a tossing ship"'/>
<rdf:Description rdf:about="&a;301501068"
	 b:glossaryEntry='traveling on horseback; "a file of men ahorseback passed by"'/>
<rdf:Description rdf:about="&a;301501200"
	 b:glossaryEntry="moving toward one"/>
<rdf:Description rdf:about="&a;301501286">
	<b:glossaryEntry>containing within itself the means of propulsion or movement; "a self-propelled vehicle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301501466">
	<b:glossaryEntry>traveling by wheeled vehicle such as bicycle or automobile e.g.; "the riding public welcomed the new buses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301501635">
	<b:glossaryEntry>moving in surges and billows and rolls; "billowing smoke from burning houses"; "the rolling fog"; "the rolling sea"; "the tumbling water of the rapids"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301501863">
	<b:glossaryEntry>being moved or acted upon by moving air or vapor; "blown clouds of dust choked the riders"; "blown soil mounded on the window sill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301502046">
	<b:glossaryEntry>moving jerkily up and down; "a bouncing ball"; "a jolting ride"; "the jouncing guns of the battery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301502221">
	<b:glossaryEntry>running with a series of small leaps; "a hillside full of bounding goats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301502349"
	 b:glossaryEntry="moving in a circle"/>
<rdf:Description rdf:about="&a;301502422">
	<b:glossaryEntry>moving or flowing in a circuit and returning to the same point; "steam circulating through the pipes"; "the circulating thyroid hormones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301502617">
	<b:glossaryEntry>moving or progressing very slowly or laboriously especially by or as if by dragging the body along close to the ground; "a riverbank full of crawling crocodiles"; "a creeping tractor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301502866">
	<b:glossaryEntry>moving in curves or spirals; "the crisp white edge of a curling wave"; "curling smoke from the chimney"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301503023"
	 b:glossaryEntry="moving forward suddenly and swiftly"/>
<rdf:Description rdf:about="&a;301503112">
	<b:glossaryEntry>moving swiftly; "fast-flying planes"; "played the difficult passage with flying fingers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301503267">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(especially of limbs or tail) waving or swinging about vigorously; "trying to drive insects away with his flailing arms"; "the aligator''s thrashing tail"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301503487">
	<b:glossaryEntry>running away from (or as if from) danger; "the fleeing survivors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301503622">
	<b:glossaryEntry>moving or passing by very swiftly; "fleeting clouds passing before the face of the moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301503765">
	<b:glossaryEntry>hanging or moving freely in air; "floating thistledown"; "floating banners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301503895">
	<b:glossaryEntry>streaming or flapping or spreading wide as if in a current of air; "ran quickly, her flaring coat behind her"; "a fluttering scarf"; "flying banners"; "flags waving in the breeze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301504168">
	<b:glossaryEntry>moving smoothly and continuously; "crowds flowing through the canyons of the streets"; "fan streaming into the concert hall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301504358">
	<b:glossaryEntry>moving rapidly and lightly to and fro as of or with wings; "fluttering birds"; "the flittering wings of a fledgling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301504544">
	<b:glossaryEntry xml:space='preserve'><![CDATA[rising and falling alternately as in waves; "the heaving waves in the storm-tossed sea"; "the exhausted dog''s heaving chest"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301504722"
	 b:glossaryEntry='(archaic) rushing and whirling; "the hurling water"'/>
<rdf:Description rdf:about="&a;301504827">
	<b:glossaryEntry>moving or moved with great speed; "the hurtling express train"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301504944">
	<b:glossaryEntry>working for a short time in different places; "itinerant laborers"; "a road show"; "traveling salesman"; "touring company"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301505151">
	<b:glossaryEntry>characterized by making jumps or moving suddenly upward; "jumping animals in the circus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301505293">
	<b:glossaryEntry>characterized by motion; "modern dance has been called kinetic pantomime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301505420">
	<b:glossaryEntry>moving upward and forward in a quick motion or series of motions; or characterized by leaps; "a leaping gait"; "the springing panther"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301505620">
	<b:glossaryEntry>walking steadily and rhythmically and in step with others; "a line of marching soldiers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301505763"
	 b:glossaryEntry='moving about or around; "the milling crowd"'/>
<rdf:Description rdf:about="&a;301505872"
	 b:glossaryEntry="having transportation available"/>
<rdf:Description rdf:about="&a;301505956"
	 b:glossaryEntry='moving by or going past; "the passing cars"'/>
<rdf:Description rdf:about="&a;301506056">
	<b:glossaryEntry>ceaselessly in motion; "the restless sea"; "the restless wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301506173"
	 b:glossaryEntry="turning about an axis"/>
<rdf:Description rdf:about="&a;301506282">
	<b:glossaryEntry>moving quickly on foot; "heard running footsteps behind him"; "scampering children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301506438">
	<b:glossaryEntry>moving with extreme rapidity; "sidewalks jammed with rushing crowds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301506560">
	<b:glossaryEntry>continuously moving or changing from position or direction; "he drifted into the shifting crowd"; "their nervous shifting glances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301506745">
	<b:glossaryEntry>moving to great heights with little apparent effort; "a soaring eagle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301506869">
	<b:glossaryEntry>rotating rapidly about an axis; "a spinning top"; "the whirling dance of the Dervish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301507020">
	<b:glossaryEntry>having a twisting or snake-like or worm-like motion; "squirming boys"; "wiggly worms"; "writhing snakes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301507244">
	<b:glossaryEntry>moving to and fro suspended or as if suspended from above; "a swinging flower basket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301507394"
	 b:glossaryEntry='moving in a wide curve; "sweeping strokes"'/>
<rdf:Description rdf:about="&a;301507491">
	<b:glossaryEntry>walking with a heavy tread; "little boys playing in the dust heedless of the trampling feet everywhere about them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301507672">
	<b:glossaryEntry>moving very rapidly to and fro or up and down; "the vibrating piano strings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301507816">
	<b:glossaryEntry>unwinding from or as if from a reel; "recorded on the unreeling film inside her"; "a long unwinding silk cocoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301507996">
	<b:glossaryEntry xml:space='preserve'><![CDATA[moving or driven rapidly in a rotary or twisting motion; "a tornado''s whirling winds"; "swirling currents"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301508168"
	 b:glossaryEntry="not in motion"/>
<rdf:Description rdf:about="&a;301508428"
	 b:glossaryEntry='not in physical motion; "the inertia of an object at rest"'/>
<rdf:Description rdf:about="&a;301508581"
	 b:glossaryEntry="rendered motionless for lack of wind"/>
<rdf:Description rdf:about="&a;301508672">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fixed and unmoving; "with eyes set in a fixed glassy stare"; "his bearded face already has a set hollow look"- Connor Cruise O''Brien; "a face rigid with pain"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301508896">
	<b:glossaryEntry>absolutely still; "frozen with horror"; "they stood rooted in astonishment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301509053"
	 b:glossaryEntry="unable to move or resist motion"/>
<rdf:Description rdf:about="&a;301509136"
	 b:glossaryEntry='not moving and therefore easy to attack; "a sitting target"'/>
<rdf:Description rdf:about="&a;301509249">
	<b:glossaryEntry>standing still; "the car remained stationary with the engine running"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301509375"
	 b:glossaryEntry='brought to a halt; "a line of stopped cars"'/>
<rdf:Description rdf:about="&a;301509481">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of a series of photographs presented so as to create the illusion of motion; "Her ambition was to be in moving pictures or `the movies''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301509693">
	<b:glossaryEntry>made to appear to move as living creatures do; "an animated cartoon"; "animated puppets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301509836">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used of pictures; of a single or static photograph not presented so as to create the illusion of motion; or representing objects not capable of motion; "a still photograph"; "Cezanne''s still life of apples"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301510094">
	<b:glossaryEntry>(used of grass or vegetation) cut down with a hand implement or machine; "the smell of new-mown hay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301510251">
	<b:glossaryEntry>(used of grass or vegetation) "uncut grass"; "an unmown lawn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301510373">
	<b:glossaryEntry>characteristic of or befitting a seaman; indicating competent seamanship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301510513"
	 b:glossaryEntry="not seamanlike"/>
<rdf:Description rdf:about="&a;301510604">
	<b:glossaryEntry>inexperienced in seamanship; "of all landlubbers the most lubberly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301510741">
	<b:glossaryEntry>being or concerning or limited to a continent especially the continents of N America or Europe; "the continental United States"; "continental Europe"; "continental waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301511006"
	 b:glossaryEntry="involving the entire continent"/>
<rdf:Description rdf:about="&a;301511097">
	<b:glossaryEntry>spanning or crossing or on the farther side of a continent; "transcontinental railway"; "transcontinental travelers"; "a transcontinental city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301511303">
	<b:glossaryEntry>extending or taking place between or among continents; "intercontinental exploration"; "intercontinental flights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301511497">
	<b:glossaryEntry>spanning or extending throughout the entire world; "worldwide distribution"; "a worldwide epidemic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301511652">
	<b:glossaryEntry>limited to or in the interests of a particular nation; "national interests"; "isolationism is a strictly national policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301511864">
	<b:glossaryEntry>devotion to the interests or culture of a particular nation including promoting the interests of one country over those of others; "nationalist aspirations"; "minor nationalistic differences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301512129">
	<b:glossaryEntry>concerning or belonging to all or at least two or more nations; "international affairs"; "an international agreement"; "international waters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301512420">
	<b:glossaryEntry>involving the entire earth; not limited or provincial in scope; "global war"; "global monetary policy"; "neither national nor continental but planetary"; "a world crisis"; "of worldwide significance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301512708"
	 b:glossaryEntry="influenced by or advocating internationalism"/>
<rdf:Description rdf:about="&a;301512836">
	<b:glossaryEntry>involving or operating in several countries; "multinational corporations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301512969">
	<b:glossaryEntry>transcending established national boundaries or spheres of interest; "a supranational economy"; "supranational federations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301513152">
	<b:glossaryEntry>involving and relating to the mutual relations of states especially of the US; "Interstate Highway Commission"; "interstate highways"; "Interstate Commerce Commission"; "interstate commerce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301513399">
	<b:glossaryEntry>relating to or existing within the boundaries of a state; "intrastate as well as interstate commerce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301513557">
	<b:glossaryEntry>in accordance with or determined by nature or natural laws; "a natural death"; "natural phenomena"; "a natural gift for sport"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301513899">
	<b:glossaryEntry>being so through innate qualities; "a natural leader"; "a born musician"; "an innate talent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301514057">
	<b:glossaryEntry xml:space='preserve'><![CDATA[existing at birth; "man''s connatural sense of the good"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301514196">
	<b:glossaryEntry>not far removed from or suggestive of nature; "the earthy taste of warm milk fresh from the cow"; "earthy smells of new-mown grass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301514380">
	<b:glossaryEntry>being or resembling a force of nature; "elemental violence"; "primitive passions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301514529">
	<b:glossaryEntry>prompted by instinct; "an instinctive fear of snakes"; "instinctual behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301514678">
	<b:glossaryEntry>derived from or prompted by a natural tendency; "an intuitive perception"; "visceral revulsion"; "a glandular aversion to materialistic values"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301514900">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not in accordance with or determined by nature; contrary to nature; "an unnatural death"; "the child''s unnatural interest in death"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301515213">
	<b:glossaryEntry>suggestive of the supernatural; mysterious; "an eerie feeling of deja vu"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301515354">
	<b:glossaryEntry xml:space='preserve'><![CDATA[beyond what is natural; "his uncanny sense of direction"; (`unco'' is chiefly Scottish)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301515501">
	<b:glossaryEntry>effected by force or injury rather than natural causes; "a violent death"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301515628">
	<b:glossaryEntry>existing in or produced by nature; "a natural pearl"; "natural deposits of potassium salts"; "natural resources"; "natural fibers"; natural blonde hair"; "the natural color of raw silk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301515921"
	 b:glossaryEntry='not artificial; "fresh cut flowers"'/>
<rdf:Description rdf:about="&a;301516011">
	<b:glossaryEntry>not artificially colored or bleached; "unbleached blonde hair"; "her hair is uncolored"; "undyed cotton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301516193">
	<b:glossaryEntry>contrived by art rather than nature; "artificial flowers"; "artificial flavoring"; "an artificial economic boom"; "artificial fibers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301516644">
	<b:glossaryEntry>deliberately arranged for effect; "one of those artfully staged photographs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301516784">
	<b:glossaryEntry>(used of color) artificially produced; not natural; "a bleached blonde"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301516927">
	<b:glossaryEntry>without substance; "cardboard caricatures of historical figures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301517060">
	<b:glossaryEntry>artificial as if portrayed in a film; "a novel with flat celluloid characters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301517206">
	<b:glossaryEntry>using artistic forms and conventions to create effects; not natural or spontaneous; "a stylized mode of theater production"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301517414">
	<b:glossaryEntry>having the appearance of being real but lacking capacity to function; "a dummy corporation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301517557">
	<b:glossaryEntry>artificial and inferior; "ersatz coffee"; "coffee substitute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301517699">
	<b:glossaryEntry>not produced by natural forces; "brokers created a factitious demand for stocks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301517836">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not genuine or real; being an imitation of the genuine article; "it isn''t fake anything; it''s real synthetic fur"; "faux pearls"; "false teeth"; "decorated with imitation palm leaves"; "a purse of simulated aligator hide"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301518147">
	<b:glossaryEntry>(chemistry) not of natural origin; prepared or made artificially; "man-made fibers"; "synthetic leather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301518334">
	<b:glossaryEntry>closely resembling the genuine article; "near beer"; "a dress of near satin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301518461">
	<b:glossaryEntry>lacking substance or vitality as if produced by painting; "in public he wore a painted smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301518608">
	<b:glossaryEntry>existing in or in conformity with nature or the observable world; "natural laws"; "natural phenomena"; "our natural environment"; "natural cliffs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301518826">
	<b:glossaryEntry>according with material things or natural laws; "our physical environment"; "an opportunity for children to examine the physical world around them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301519028">
	<b:glossaryEntry>not existing in nature or subject to explanation according to natural laws; not physical or material; "supernatural forces and occurrences and beings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301519453">
	<b:glossaryEntry>like or being a phantom; "a ghostly face at the window"; "a phantasmal presence in the room"; "spectral emanations"; "spiritual tappings at a seance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301519719">
	<b:glossaryEntry>suggesting the operation of supernatural influences; "an eldritch screech"; "the three weird sisters"; "stumps...had uncanny shapes as of monstrous creatures"- John Galsworthy; "an unearthly light"; "he could hear the unearthly scream of some curlew piercing the din"- Henry Kingsley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301520087">
	<b:glossaryEntry>suggestive of an elf in strangeness and otherworldliness; "thunderbolts quivered with elfin flares of heat lightning"; "the fey quality was there, the ability to see the moon at midday"- John Mason Brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301520348">
	<b:glossaryEntry xml:space='preserve'><![CDATA[possessing or using or characteristic of or appropriate to supernatural powers; "charming incantations"; "magic signs that protect against adverse influence"; "a magical spell"; "''tis now the very witching time of night"- Shakespeare; "wizard wands"; "wizardly powers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301520738"
	 b:glossaryEntry="being or having the character of a miracle"/>
<rdf:Description rdf:about="&a;301520849"
	 b:glossaryEntry='without material form or substance; "metaphysical forces"'/>
<rdf:Description rdf:about="&a;301520965">
	<b:glossaryEntry>given to or produced by or used in the art of conjuring up the dead; "a necromantic sorcerer"; "necromantic delusions"; "necromantic powders and other weird objects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301521188">
	<b:glossaryEntry>existing outside of or not in accordance with nature; "find transcendental motives for sublunary action"-Aldous Huxley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301521411">
	<b:glossaryEntry>possessing or believed to possess magic power especially protective power; "a talismanic amulet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301521564">
	<b:glossaryEntry>existing or extending beyond the physical world; "whatever of transmundane...insight...we may carry"- William James</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301521738"
	 b:glossaryEntry="being or having the character of witchcraft"/>
<rdf:Description rdf:about="&a;301521837"
	 b:glossaryEntry='(music) of a key containing no sharps or flats; "B natural"'/>
<rdf:Description rdf:about="&a;301521968"
	 b:glossaryEntry='(music) raised in pitch by one chromatic semitone; "C sharp"'/>
<rdf:Description rdf:about="&a;301522098"
	 b:glossaryEntry='(music) lowered in pitch by one chromatic semitone; "B flat"'/>
<rdf:Description rdf:about="&a;301522227">
	<b:glossaryEntry xml:space='preserve'><![CDATA[furthest or highest in degree or order; utmost or extreme; "the ultimate achievement"; "the ultimate question"; "man''s ultimate destiny"; "the ultimate insult"; "one''s ultimate goal in life"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301522598">
	<b:glossaryEntry>representing a level of the highest possible achievement or attainment; "the crowning accomplishment of his career"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301522771">
	<b:glossaryEntry>expected to follow in the indefinite future from causes already operating; "hope of eventual (or ultimate) rescue"; "if this trend continues it is not reasonable to expect the eventual collapse of the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301523043">
	<b:glossaryEntry xml:space='preserve'><![CDATA[most distant or remote; "man''s farthest goal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301523143">
	<b:glossaryEntry>conclusive in a process or progression; "the final answer"; "a last resort"; "the net result"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301523301"
	 b:glossaryEntry='highest and most significant; "his highest achievement"'/>
<rdf:Description rdf:about="&a;301523410">
	<b:glossaryEntry>final or last in your life or progress; "the supreme sacrifice"; "the supreme judgment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301523551">
	<b:glossaryEntry>closest in degree or order (space or time) especially in a chain of causes and effects; "news of his proximate arrival"; "interest in proximate rather than ultimate goals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301523796">
	<b:glossaryEntry>immediately before or after as in a chain of cause and effect; "the immediate result"; "the immediate cause of the trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301523975"
	 b:glossaryEntry="absolutely essential"/>
<rdf:Description rdf:about="&a;301524177">
	<b:glossaryEntry>absolutely necessary; vitally necessary; "essential tools and materials"; "funds essential to the completion of the project"; "an indispensable worker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301524400">
	<b:glossaryEntry>necessary for relief or supply; "provided them with all things needful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301524557">
	<b:glossaryEntry>required by obligation or compulsion or convention; "he made all the obligatory apologies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301524704"
	 b:glossaryEntry="not necessary"/>
<rdf:Description rdf:about="&a;301524894">
	<b:glossaryEntry>more than is needed, desired, or required; "trying to lose excess weight"; "found some extra change lying on the dresser"; "yet another book on heraldry might be thought redundant"; "skills made redundant by technological advance"; "sleeping in the spare room"; "supernumerary ornamentation"; "it was supererogatory of her to gloat"; "delete superfluous (or unnecessary) words"; "extra ribs as well as other supernumerary internal parts"; "surplus cheese distributed to the needy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301525512">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unnecessary and unwarranted; "a strikers'' tent camp...was burned with needless loss of life"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301525687"
	 b:glossaryEntry="not absolutely necessary"/>
<rdf:Description rdf:about="&a;301525769">
	<b:glossaryEntry>kept in reserve especially for emergency use; "a reserve supply of food"; "a spare tire"; "spare parts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301525937"
	 b:glossaryEntry='remaining after all deductions; "net profit"'/>
<rdf:Description rdf:about="&a;301526074"
	 b:glossaryEntry='clear of charges or deductions; "a clear profit"'/>
<rdf:Description rdf:about="&a;301526174">
	<b:glossaryEntry>(of salary or wages) remaining after all deductions including taxes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301526297"
	 b:glossaryEntry='before any deductions; "gross income"'/>
<rdf:Description rdf:about="&a;301526404">
	<b:glossaryEntry>including everything; "the overall cost"; "the total amount owed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301526531"
	 b:glossaryEntry="affected with emotional disorder"/>
<rdf:Description rdf:about="&a;301526905">
	<b:glossaryEntry>suffering from abulia; showing abnormal inability to act or make decisions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301527042">
	<b:glossaryEntry>caused by or suggestive of psychological compulsion; "compulsive drinking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301527173"
	 b:glossaryEntry="suffering from or characterized by delusions"/>
<rdf:Description rdf:about="&a;301527274">
	<b:glossaryEntry>emotionally unstable and having difficulty coping with personal relationships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301527421"
	 b:glossaryEntry="suffering from hypochondria"/>
<rdf:Description rdf:about="&a;301527526">
	<b:glossaryEntry>characterized by or arising from psychoneurotic hysteria; "during hysterical conditions various functions of the human body are disordered"- Morris Fishbein; "hysterical amnesia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301527772"
	 b:glossaryEntry="suffering from megalomania"/>
<rdf:Description rdf:about="&a;301527873"
	 b:glossaryEntry="obsessed with a single subject or idea"/>
<rdf:Description rdf:about="&a;301527970"
	 b:glossaryEntry="(used of women) affected with excessive sexual desire"/>
<rdf:Description rdf:about="&a;301528099">
	<b:glossaryEntry>characterized by or constituting an obsession; "the obsessional character of his response"; "obsessive gambling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301528281">
	<b:glossaryEntry>characterized by obsessions and compulsions; "obsessive-compulsive neurosis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301528424">
	<b:glossaryEntry>caused by or evidencing a mentally disturbed condition; "a pathological liar"; "a pathological urge to succeed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301528594"
	 b:glossaryEntry="suffering from irrational fears"/>
<rdf:Description rdf:about="&a;301528678"
	 b:glossaryEntry="used of illness or symptoms resulting from neurosis"/>
<rdf:Description rdf:about="&a;301528789">
	<b:glossaryEntry>marked by withdrawal and inability to form close relationships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301528906">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not neurotic; "successful mothers--mothers with unneurotic children"; "he''s the most unneurotic person I know"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301529091">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) mentally and emotionally stable; "she''s really together"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301529213">
	<b:glossaryEntry>pleasant or pleasing or agreeable in nature or appearance; "what a nice fellow you are and we all thought you so nasty"- George Meredith; "nice manners"; "a nice dress"; "a nice face"; "a nice day"; "had a nice time at the party"; "the corn and tomatoes are nice today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301529605">
	<b:glossaryEntry>agreeable or pleasing; "we all had a good time"; "good manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301529719">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pleasant in manner or behavior; "I didn`t enjoy it and probably wasn''t a pleasant person to be around"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301529876">
	<b:glossaryEntry>offensive or even (of persons) malicious; "in a nasty mood"; "a nasty accident"; "a nasty shock"; "a nasty smell"; "a nasty trick to pull"; "Will he say nasty things at my funeral?"- Ezra Pound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301530237">
	<b:glossaryEntry>vile; despicable; "a dirty (or lousy) trick"; "a filthy traitor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301530370">
	<b:glossaryEntry>(British slang) very unpleasant or offensive ; "a grotty little play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301530492">
	<b:glossaryEntry>characterized by malice; "a hateful thing to do"; "in a mean mood"; "told spiteful stories about the fat lady"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301530674"
	 b:glossaryEntry="very unpleasant or annoying"/>
<rdf:Description rdf:about="&a;301530758"
	 b:glossaryEntry="(of birds) remaining in the nest for a time after hatching"/>
<rdf:Description rdf:about="&a;301530873"
	 b:glossaryEntry="(of birds) leaving the nest shortly after hatching"/>
<rdf:Description rdf:about="&a;301530980">
	<b:glossaryEntry>having or showing or indicative of high or elevated character; "a noble spirit"; "noble deeds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301531216">
	<b:glossaryEntry>investing with dignity or honor; "the dignifying effect of his presence"; "the ennobling influence of cultural surroundings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301531409">
	<b:glossaryEntry>of high moral or intellectual value; elevated in nature or style; "an exalted ideal"; "argue in terms of high-flown ideals"- Oliver Franks; "a noble and lofty concept"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301531715">
	<b:glossaryEntry>noble and generous in spirit; "a greathearted general"; "a magnanimous conqueror"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301531869">
	<b:glossaryEntry>completely lacking nobility in character or quality or purpose; "something cowardly and ignoble in his attitude"; "I think it a less evil that some criminals should escape than that the government should play an ignoble part"- Oliver Wendell Holmes, Jr.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301532320">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having or showing a meanspirited lack of honor or morality; "that liberal obedience without which your army would be a base rabble"- Edmund Burke; "taking a mean advantage"; "chok''d with ambition of the meaner sort"- Shakespeare; "something essentially vulgar and meanspirited in politics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301532683">
	<b:glossaryEntry>worthy only of being despised and rejected; "a contemptible lack of courage"; "A little, wretched, despicable creature, a worm, a mere nothing...that has risen up in contempt against the majesty of Heaven and earth"- Jonathan Edwards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301532988"
	 b:glossaryEntry="base and cowardly"/>
<rdf:Description rdf:about="&a;301533059">
	<b:glossaryEntry>morally unacceptable; "the dishonorable conduct of trusted men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301533197">
	<b:glossaryEntry>of the hereditary aristocracy or ruling class of ancient Rome or medieval Europe; of honorary nobility in the Byzantine empire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301533415">
	<b:glossaryEntry>of the common people of ancient Rome; "a plebeian magistrate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301533567">
	<b:glossaryEntry>the lowest class of citizens of ancient Rome who had no property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301533758">
	<b:glossaryEntry>of or belonging to or constituting the hereditary aristocracy especially as derived from feudal times; "of noble birth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301534127">
	<b:glossaryEntry>belonging to or characteristic of the nobility or aristocracy; "an aristocratic family"; "aristocratic Bostonians"; "aristocratic government"; "a blue family"; "blue blood"; "the blue-blooded aristocracy"; "of gentle blood"; "patrician landholders of the American South"; "aristocratic bearing"; "aristocratic features"; "patrician tastes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301534585">
	<b:glossaryEntry>of or befitting a lord; "heir to a lordly fortune"; "of august lineage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301534726">
	<b:glossaryEntry>belonging to the peerage; "the princess and her coroneted companions"; "the titled classes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301534893">
	<b:glossaryEntry xml:space='preserve'><![CDATA[belonging to or befitting a supreme ruler; "golden age of imperial splendor"; "purple tyrant"; "regal attire"; "treated with royal acclaim"; "the royal carriage of a stag''s head"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301535162">
	<b:glossaryEntry>having the rank of or resembling or befitting a king; "symbolizing kingly power"; "the murder of his kingly guest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301535340">
	<b:glossaryEntry>having the characteristics of or befitting or worthy of a monarch; "monarchical gestures"; "monarchal pomp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301535517">
	<b:glossaryEntry>having the rank of or befitting a prince; "a princely bearing"; "princely manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301535653">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having the rank of or resembling or befitting a queen; "queenly propriety"; "clad in her queenly raiment"; "Rosetti''s queenly portraits of women"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301535864">
	<b:glossaryEntry>being of the rank of a monarch; "of royal ancestry"; "princes of the blood royal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301535997">
	<b:glossaryEntry>of humble birth or origins; "a topsy-turvy society of lowborn rich and blue-blooded poor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301536230">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of low birth or station (`base'' is archaic in this sense); "baseborn wretches with dirty faces"; "of humble (or lowly) birth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301536434">
	<b:glossaryEntry>of or associated with the great masses of people; "the common people in those days suffered greatly"; "behavior that branded him as common"; "his square plebeian nose"; "a vulgar and objectionable person"; "the unwashed masses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301536745">
	<b:glossaryEntry>not of the nobility; "of ignoble (or ungentle) birth"; "untitled civilians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301536896">
	<b:glossaryEntry>conforming with or constituting a norm or standard or level or type or social norm; not abnormal; "serve wine at normal room temperature"; "normal diplomatic relations"; "normal working hours"; "normal word order"; "normal curiosity"; "the normal course of events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301537375">
	<b:glossaryEntry>(statistics) approximating the statistical norm or average or expected value; "the average income in New England is below that of the nation"; "of average height for his age"; "the mean annual rainfall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301537641">
	<b:glossaryEntry>(statistics) relating to or constituting the middle value of an ordered set of values (or the average of the middle two in an even-numbered set); "the median value of 17, 20, and 36 is 20"; "the median income for the year was $15,000"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301537941">
	<b:glossaryEntry>(statistics) relating to or constituting the most frequent value in a distribution; "the modal age at which American novelists reach their peak is 30"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301538156">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(biology) functioning or occurring in a natural way; lacking abnormalities or deficiencies; "a natural fear of nuclear war"; "natural immunity"; "a grandparent''s natural affection for a grandchild"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301538407"
	 b:glossaryEntry='not deviating from what is normal; "her regular bedtime"'/>
<rdf:Description rdf:about="&a;301538517">
	<b:glossaryEntry>conforming to a type; "the typical (or normal) American"; "typical teenage behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301538655">
	<b:glossaryEntry>not normal; not typical or usual or regular or conforming to a norm; "abnormal powers of concentration"; "abnormal amounts of rain"; "abnormal circumstances"; "an abnormal interest in food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301539115">
	<b:glossaryEntry>markedly different from an accepted norm; "aberrent behavior"; deviant ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301539257">
	<b:glossaryEntry>deviating from the general or common order or type; "advanced forms of life may be anomalous in the universe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301539422">
	<b:glossaryEntry>(physiology) conducting nerve impulses in a direction opposite to normal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301539551">
	<b:glossaryEntry>deviating from what is usual or common or to be expected; often somewhat odd or strange; "these days large families are atypical"; "highly irregular behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301539776"
	 b:glossaryEntry="having abnormally short finger or toes"/>
<rdf:Description rdf:about="&a;301539893">
	<b:glossaryEntry>markedly subnormal in structure or function or intelligence or behavior; "defective speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301540040"
	 b:glossaryEntry='characteristic of a freak; "a freakish extra toe"'/>
<rdf:Description rdf:about="&a;301540144"
	 b:glossaryEntry='(used of sexual behavior) "kinky sex"; "perverted practices"'/>
<rdf:Description rdf:about="&a;301540268">
	<b:glossaryEntry>(statistics) below normal or average; "after the floods the harvests were subnormal"; "subnormal intelligence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301540434">
	<b:glossaryEntry>(statistics) exceeding the normal or average; "years of supernormal employment during the war"; "a phase of supernormal excitability"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301540625">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(psychology) being approximately average or within certain limits in e.g. intelligence and development; "a perfectly normal child"; "of normal intelligence"; "the most normal person I''ve ever met"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301540874">
	<b:glossaryEntry>(psychology) departing from the normal in e.g. intelligence and development; "they were heartbroken when they learned their child was abnormal"; "an abnormal personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301541117">
	<b:glossaryEntry>(psychology) deviating widely from a norm of physical or mental ability; used especially of children below normal in intelligence; "special educational provisions for exceptional children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301541366"
	 b:glossaryEntry="having abnormally high blood pressure"/>
<rdf:Description rdf:about="&a;301541480"
	 b:glossaryEntry="having abnormally low blood pressure"/>
<rdf:Description rdf:about="&a;301541592"
	 b:glossaryEntry="having normal blood pressure"/>
<rdf:Description rdf:about="&a;301541697"
	 b:glossaryEntry="in accordance with scientific laws"/>
<rdf:Description rdf:about="&a;301541784">
	<b:glossaryEntry>not in accordance with scientific laws; "what seemed to be paranormal manifestations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301542034"
	 b:glossaryEntry="beyond normal physical explanation"/>
<rdf:Description rdf:about="&a;301542132"
	 b:glossaryEntry='outside the sphere of physical science; "psychic phenomena"'/>
<rdf:Description rdf:about="&a;301542257"
	 b:glossaryEntry="moving an object without apparent use of physical means"/>
<rdf:Description rdf:about="&a;301542372">
	<b:glossaryEntry>beyond the range of the normal or scientifically explainable; "supernormal intimations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301542531">
	<b:glossaryEntry>situated in or facing or moving toward or coming from the north; "artists like north light"; "the north portico"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301542911">
	<b:glossaryEntry>moving toward the north; "the northbound lane"; "we took the north train"; "the northward flow of traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301543086">
	<b:glossaryEntry>situated in the northern part of a centrally located area in some geographical region; "the north-central part of Russia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301543267">
	<b:glossaryEntry>coming from the north; used especially of wind; "the north wind doth blow"; "a northern snowstorm"; "the winds are northerly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301543459">
	<b:glossaryEntry>situated in or oriented toward the north; "the northern suburbs"; "going in a northerly direction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301543624"
	 b:glossaryEntry='situated farthest north; "Alaska is our northernmost state"'/>
<rdf:Description rdf:about="&a;301543754">
	<b:glossaryEntry>situated in or oriented toward the northeast; "the northeasterly part of the island"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301543925"
	 b:glossaryEntry='coming from the northeast; "northeasterly winds"'/>
<rdf:Description rdf:about="&a;301544045"
	 b:glossaryEntry="toward the northeast"/>
<rdf:Description rdf:about="&a;301544125"
	 b:glossaryEntry="situated in or oriented toward the northwest"/>
<rdf:Description rdf:about="&a;301544256"
	 b:glossaryEntry='coming from the northwest; "northwesterly winds"'/>
<rdf:Description rdf:about="&a;301544376"
	 b:glossaryEntry="toward the northwest"/>
<rdf:Description rdf:about="&a;301544456">
	<b:glossaryEntry>situated in or facing or moving toward or coming from the south; "the south entrance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301544827"
	 b:glossaryEntry='moving toward the south; "a southbound train"'/>
<rdf:Description rdf:about="&a;301544941">
	<b:glossaryEntry>situated in the southern part of a centrally located area in some geographical region; "south-central London"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301545110">
	<b:glossaryEntry>from the south; used especially of wind; "a hot south wind"; "southern breezes"; "the winds are southerly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301545283">
	<b:glossaryEntry>situated in or oriented toward the south; "a southern exposure"; "took a southerly course"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301545440">
	<b:glossaryEntry>situated farthest south; "Key West is the southernmost city in the United States"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301545592"
	 b:glossaryEntry="situated in or oriented toward the southeast"/>
<rdf:Description rdf:about="&a;301545723"
	 b:glossaryEntry='coming from the southeast; "southeasterly breezes"'/>
<rdf:Description rdf:about="&a;301545845"
	 b:glossaryEntry="toward the southeast"/>
<rdf:Description rdf:about="&a;301545925"
	 b:glossaryEntry="situated in or oriented toward the southwest"/>
<rdf:Description rdf:about="&a;301546056"
	 b:glossaryEntry='coming from the southwest; "the winds are southwesterly"'/>
<rdf:Description rdf:about="&a;301546184"
	 b:glossaryEntry="toward the southwest"/>
<rdf:Description rdf:about="&a;301546264">
	<b:glossaryEntry>situated in or coming from regions of the north; "the northern hemisphere"; "northern autumn colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301546491"
	 b:glossaryEntry="comprising or throughout far northern regions"/>
<rdf:Description rdf:about="&a;301546604">
	<b:glossaryEntry>being in or of a region of the United States generally including states of the upper Mississippi valley and Great Lakes region lying north of the Ohio River and the southern boundaries of Kansas and Missouri and between the western boundary of Pennsylvania and the eastern boundaries of Montana and Wyoming and Colorado</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301546983">
	<b:glossaryEntry>of northern regions; from the seven stars (or seven plowing oxen) of Ursa Major</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301547119">
	<b:glossaryEntry>situated in or coming from regions of the south; "the southern hemisphere"; "southern constellations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301547347">
	<b:glossaryEntry>of the south or coming from the south; "sailed the austral seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301547465">
	<b:glossaryEntry>located in the south or characteristic of southern people or places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301547589">
	<b:glossaryEntry>being in or of a region of the United States including the states of the lower Mississippi valley and east of the Rio Grande</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301547773">
	<b:glossaryEntry>in or characteristic of a region of the United States north of (approximately) the Mason-Dixon line; "Northern liberals"; "northern industry"; "northern cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301548078">
	<b:glossaryEntry>used to signify the Union forces in the Civil War (who wore blue uniforms); "a ragged blue line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301548225">
	<b:glossaryEntry>being of or having to do with the northern United States and those loyal to the Union during the Civil War; "Union soldiers"; "Federal forces"; "a Federal infantryman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301548454">
	<b:glossaryEntry>used by southerners for an inhabitant of a northern state in the United States (especially a Union soldier)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301548614">
	<b:glossaryEntry>in or characteristic of a region of the United States south of (approximately) the Mason-Dixon line; "Southern hospitality"; "southern cooking"; "southern plantations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301548926">
	<b:glossaryEntry>of or having to do with the southern Confederacy during the Civil War; "Confederate soldiers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301549077">
	<b:glossaryEntry>used to signify the Confederate forces in the Civil War (who wore gray uniforms); "a stalwart gray figure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301549241">
	<b:glossaryEntry>used by northerners of Confederate soldiers; "the rebel yell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301549354">
	<b:glossaryEntry>having a nose (either literal or metaphoric) especially of a specified kind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301549517"
	 b:glossaryEntry="having an aquiline nose"/>
<rdf:Description rdf:about="&a;301549597">
	<b:glossaryEntry>having a blunt nose; "a pug-nosed boy with freckles"; "a snub-nosed automatic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301549755"
	 b:glossaryEntry="having no nose"/>
<rdf:Description rdf:about="&a;301549824">
	<b:glossaryEntry>being perceived or observed; "an easily noticed effect on the rate of growth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301549973">
	<b:glossaryEntry>perceived with the mind; "he winced at the detected flicker of irony in her voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301550110"
	 b:glossaryEntry='not noticed; "hoped his departure had passed unnoticed"'/>
<rdf:Description rdf:about="&a;301550329">
	<b:glossaryEntry>not noticed inadvertently; "her aching muscles forgotten she danced all night"; "he was scolded for his forgotten chores"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301550520">
	<b:glossaryEntry xml:space='preserve'><![CDATA[disregarded; "his cries were unheeded"; "Shaw''s neglected one-act comedy, `A Village Wooing''"; "her ignored advice"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301550712">
	<b:glossaryEntry>not taken into account; "his retirement was not allowed to go unmarked"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301550861"
	 b:glossaryEntry='not observed; "managed to slip away unobserved"'/>
<rdf:Description rdf:about="&a;301550965"
	 b:glossaryEntry="not perceived or commented on"/>
<rdf:Description rdf:about="&a;301551065">
	<b:glossaryEntry>perceived or discerned; "the detected micrometeoritic material"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301551237">
	<b:glossaryEntry>detected by means of the senses; "a perceived difference in temperature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301551365">
	<b:glossaryEntry>detected by instinct or inference rather than by recognized perceptual cues; "the felt presence of an intruder"; "a sensed presence in the room raised goosebumps on her arms"; "a perceived threat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301551633">
	<b:glossaryEntry>detected or perceived by the sense of hearing; "a conversation heard through the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301551771">
	<b:glossaryEntry>not perceived or discerned; "they feared some undetected trace of poison"; "she looked around to be sure her faux pas was undetected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301551997">
	<b:glossaryEntry>not discovered; "with earth-based telescopes many stars remain undiscovered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301552132"
	 b:glossaryEntry="not noticed"/>
<rdf:Description rdf:about="&a;301552221">
	<b:glossaryEntry>having been learned or found or determined especially by investigation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301552366">
	<b:glossaryEntry>discovered or determined by scientific observation; "variation in the ascertained flux depends on a number of factors"; "the discovered behavior norms"; "discovered differences in achievement"; "no explanation for the observed phenomena"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301552685">
	<b:glossaryEntry>not yet having been ascertained or determined; "of undetermined species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301552834"
	 b:glossaryEntry='not explained; "accomplished by some unexplained process"'/>
<rdf:Description rdf:about="&a;301552949">
	<b:glossaryEntry>injurious to physical or mental health; "noxious chemical wastes"; "noxious ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301553203"
	 b:glossaryEntry="exceedingly harmful"/>
<rdf:Description rdf:about="&a;301553310">
	<b:glossaryEntry>harmful to the mind or morals; "corrupt judges and their corrupting influence"; "the vicious and degrading cult of violence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301553503"
	 b:glossaryEntry="causing blisters"/>
<rdf:Description rdf:about="&a;301553587"
	 b:glossaryEntry="not injurious to physical or mental health"/>
<rdf:Description rdf:about="&a;301553768"
	 b:glossaryEntry="having no adverse effect"/>
<rdf:Description rdf:about="&a;301553848"
	 b:glossaryEntry='not offensive; "an inoffensive level"'/>
<rdf:Description rdf:about="&a;301553961"
	 b:glossaryEntry='lacking significance or impact; "an insipid novel"'/>
<rdf:Description rdf:about="&a;301554065">
	<b:glossaryEntry>dutifully complying with the commands or instructions of those in authority; "an obedient soldier"; "obedient children"; "a little man obedient to his wife"; "the obedient colonies...are heavily taxed; the refractory remain unburdened"- Edmund Burke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301554549">
	<b:glossaryEntry>willing to carry out the orders or wishes of another without protest; "too acquiescent to challenge authority"; "a gentle and biddable soul"; "children compliant with the parental will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301554815">
	<b:glossaryEntry>quick to comply; "I have been to you a true and humble wife, at all times to your will conformable"-Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301554984">
	<b:glossaryEntry>willingly obedient out of a sense of duty and respect; "a dutiful child"; "a dutiful citizen"; "Patient Griselda was a chaste and duteous wife";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301555193">
	<b:glossaryEntry>not obeying or complying with commands of those in authority; "disobedient children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301555533">
	<b:glossaryEntry>resistant to guidance or discipline; "Mary Mary quite contrary"; "an obstinate child with a violent temper"; "a perverse mood"; "wayward behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301555767">
	<b:glossaryEntry>stubbornly resistant to authority or control; "a fractious animal that would not submit to the harness"; "a refractory child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301555961"
	 b:glossaryEntry="habitually disposed to disobedience and opposition"/>
<rdf:Description rdf:about="&a;301556111">
	<b:glossaryEntry>refusing to submit to authority; "the recusant electors...cooperated in electing a new Senate"- Mary W.Williams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301556277">
	<b:glossaryEntry>undesirably noticeable; "the obtrusive behavior of a spoiled child"; "equally obtrusive was the graffiti"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301556469"
	 b:glossaryEntry="noticeable in an unpleasant way"/>
<rdf:Description rdf:about="&a;301556558">
	<b:glossaryEntry>not obtrusive or undesirably noticeable; "a quiet, unobtrusive life of self-denial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301556732">
	<b:glossaryEntry>not blatant or overly aggressive in manner or appearance; "a retiring disposition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301556883">
	<b:glossaryEntry>undistorted by emotion or personal bias; based on observable phenomena; "an objective appraisal"; "objective evidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301557145">
	<b:glossaryEntry>scientifically detached; unemotional; "he spoke in the clipped clinical monotones typical of police testimony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301557310">
	<b:glossaryEntry>disinterested or dispassionate; "made a cool appraisal of all the issues in the dispute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301557449">
	<b:glossaryEntry>having no personal preference; "impersonal criticism"; "a neutral observer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301557591">
	<b:glossaryEntry>capable of being verified; "a verifiable account of the incident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301557713">
	<b:glossaryEntry>taking place within the mind and modified by individual bias; "a subjective judgment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301557909"
	 b:glossaryEntry="particular to a given individual"/>
<rdf:Description rdf:about="&a;301557996"
	 b:glossaryEntry="emanating from a person''s emotions and prejudices"/>
<rdf:Description rdf:about="&a;301558102"
	 b:glossaryEntry="(of e.g. evidence) not objective or easily verified"/>
<rdf:Description rdf:about="&a;301558226">
	<b:glossaryEntry>caused by law or conscience to follow a certain course; "felt obligated to repay the kindness"; "was obligated to pay off the student loan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301558568"
	 b:glossaryEntry="under a moral obligation to someone"/>
<rdf:Description rdf:about="&a;301558661">
	<b:glossaryEntry>being under moral or legal obligation; "felt bound by his promise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301558822"
	 b:glossaryEntry='required or ordered to; "felt called upon to do his duty"'/>
<rdf:Description rdf:about="&a;301558954"
	 b:glossaryEntry="under a moral obligation to do something"/>
<rdf:Description rdf:about="&a;301559067">
	<b:glossaryEntry>owing gratitude or recognition to another for help or favors etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301559189"
	 b:glossaryEntry="under a legal obligation to someone"/>
<rdf:Description rdf:about="&a;301559282">
	<b:glossaryEntry xml:space='preserve'><![CDATA[required or under orders; "I''m supposed to be there at ten"; "he was supposed to go to the store"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301559437"
	 b:glossaryEntry="not obligated"/>
<rdf:Description rdf:about="&a;301559544"
	 b:glossaryEntry="free of moral obligation"/>
<rdf:Description rdf:about="&a;301559628"
	 b:glossaryEntry='having debts paid up; "an unindebted man, at last"'/>
<rdf:Description rdf:about="&a;301559735">
	<b:glossaryEntry>(biology) restricted to a particular condition of life; "an obligate anaerobe can survive only in the absence of OXYGen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301559910">
	<b:glossaryEntry>(biology) able to exist under more than one set of conditions; "a facultative parasite can exist as a parasite or a saprophyte"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301560095"
	 b:glossaryEntry='easily perceived or understood; "obvious errors"'/>
<rdf:Description rdf:about="&a;301560359">
	<b:glossaryEntry>clearly apparent or obvious to the mind or senses; "the effects of the drought are apparent to anyone who sees the parched fields"; "evident hostility"; "manifest disapproval"; "patent advantages"; "made his meaning plain"; "it is plain that he is no reactionary"; "in plain view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301560732">
	<b:glossaryEntry>evident without proof or argument; "an axiomatic truth"; "we hold these truths to be self-evident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301560924">
	<b:glossaryEntry>capable of being demonstrated or proved; "obvious lies"; "a demonstrable lack of concern for the general welfare"; "practical truth provable to all men"- Walter Bagehot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301561162"
	 b:glossaryEntry='clearly manifest; evident; "frank enjoyment"'/>
<rdf:Description rdf:about="&a;301561258"
	 b:glossaryEntry="needing no explanation"/>
<rdf:Description rdf:about="&a;301561343">
	<b:glossaryEntry>easily understood or seen through (because of a lack of subtlety); "a transparent explanation"; "a transparent lie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301561516">
	<b:glossaryEntry>in plain view or directly in from of one; "the keys were right under his nose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301561743">
	<b:glossaryEntry>made more obvious or prominent; "the effect of...his irregular life could be seen writ large on his gaunt features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301561915">
	<b:glossaryEntry>not immediately apparent; "in mathematical science connections are exhibited which...are extremely unobvious"- A.N.Whitehead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301562149"
	 b:glossaryEntry='not readily apparent; "the answer was at first unapparent"'/>
<rdf:Description rdf:about="&a;301562264"
	 b:glossaryEntry='not provable; "it was both unproved and unprovable"'/>
<rdf:Description rdf:about="&a;301562372">
	<b:glossaryEntry>shut off to passage or view or hindered from action; "a partially obstructed passageway"; "an obstructed view"; "justice obstructed is not justice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301562738">
	<b:glossaryEntry>preventing entry or exit or a course of action; "a barricaded street"; "barred doors"; "the blockaded harbor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301562925">
	<b:glossaryEntry>completely obstructed or closed off; "the storm was responsible for many blocked roads and bridges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301563078">
	<b:glossaryEntry>stopped up; clogged up; "clogged pipes"; "clogged up freeways"; "streets choked with traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301563234">
	<b:glossaryEntry>at a complete standstill because of opposition of two unrelenting forces or factions; "the chess game ended with white stalemated"; "the two factions are deadlocked over fringe benefits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301563490">
	<b:glossaryEntry>made difficult or slow; "we blamed our impeded progress on lack of money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301563617"
	 b:glossaryEntry='closed off; "an occluded artery"'/>
<rdf:Description rdf:about="&a;301563704"
	 b:glossaryEntry='(of a nose) blocked; "a stopped (or stopped-up) nose"'/>
<rdf:Description rdf:about="&a;301563843"
	 b:glossaryEntry="affected with or obstructed by a clot of coagulated blood"/>
<rdf:Description rdf:about="&a;301563957">
	<b:glossaryEntry>free from impediment or obstruction or hindrance; "an unobstructed view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301564142">
	<b:glossaryEntry>affording free passage or view; "a clear view"; "a clear path to victory"; "a free lane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301564296">
	<b:glossaryEntry>not slowed or prevented; "a time of unimpeded growth"; "an unimpeded sweep of meadows and hills afforded a peaceful setting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301564476"
	 b:glossaryEntry='freed of obstructions; "an unclogged drain"'/>
<rdf:Description rdf:about="&a;301564575">
	<b:glossaryEntry>held or filled or in use; "she keeps her time well occupied"; "the wc is occupied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301564748">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of facilities such as telephones or lavatories) unavailable for use by anyone else or indicating unavailability; (`engaged'' is a British term for a busy telephone line); "her line is busy"; "receptionists'' telephones are always engaged"; "the lavatory is in use"; "kept getting a busy signal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301565114"
	 b:glossaryEntry='(of time) taken up; "well-filled hours"'/>
<rdf:Description rdf:about="&a;301565206">
	<b:glossaryEntry>not held or filled or in use; "an unoccupied telephone booth"; "unoccupied hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301565380"
	 b:glossaryEntry='not occupied or in use; "a free locker"'/>
<rdf:Description rdf:about="&a;301565470">
	<b:glossaryEntry>not taken up by scheduled activities; "a free hour between classes"; "spare time on my hands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301565622">
	<b:glossaryEntry>seized and controlled as by military invasion; "the occupied countries of Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301565758"
	 b:glossaryEntry='not seized and controlled; "unoccupied areas of France"'/>
<rdf:Description rdf:about="&a;301565888"
	 b:glossaryEntry="that has been withdrawn or retreated from"/>
<rdf:Description rdf:about="&a;301565988">
	<b:glossaryEntry>unpleasant or disgusting especially to the senses; "offensive odors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301566364">
	<b:glossaryEntry>offensive to the mind; "an abhorrent deed"; "the obscene massacre at Wounded Knee"; "morally repugnant customs"; "repulsive behavior"; "the most repulsive character in recent novels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301566649">
	<b:glossaryEntry xml:space='preserve'><![CDATA[gruesomely indicative of death or the dead; "a charnel smell came from the chest filled with dead men''s bones"; "ghastly shrieks"; "the sepulchral darkness of the catacombs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301566899">
	<b:glossaryEntry>highly offensive; arousing aversion or disgust; "a disgusting smell"; "distasteful language"; "a loathsome disease"; "the idea of eating meat is repellent to me"; "revolting food"; "a wicked stench"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301567263"
	 b:glossaryEntry='suggesting the horror of death and decay; "morbid details"'/>
<rdf:Description rdf:about="&a;301567385">
	<b:glossaryEntry>grossly offensive to decency or morality; causing horror; "subjected to outrageous cruelty"; "a hideous pattern of injustice"; "horrific conditions in the mining industry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301567643">
	<b:glossaryEntry>causing disapproval or protest; "a vulgar and objectionable person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301567795"
	 b:glossaryEntry='very offensive in smell or taste; "a rank cigar"'/>
<rdf:Description rdf:about="&a;301567894">
	<b:glossaryEntry>dirty and disgusting; "worry about the gossip and secretiveness and other scrimy sides"- Al Hine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301568043"
	 b:glossaryEntry="of the nature of vermin; very offensive or repulsive"/>
<rdf:Description rdf:about="&a;301568151">
	<b:glossaryEntry>giving no offense; "a quiet inoffensive man"; "a refreshing inoffensive stimulant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301568327">
	<b:glossaryEntry>not causing disapproval; "it was an innocuous remark"; "confined himself to innocuous generalities"; "unobjectionable behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301568528">
	<b:glossaryEntry>morally respectable or inoffensive; "a past that was scarcely savory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301568674">
	<b:glossaryEntry>morally offensive; "an unsavory reputation"; "an unsavory scandal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301568837"
	 b:glossaryEntry='morally offensive; "odoriferous legislation"'/>
<rdf:Description rdf:about="&a;301568939"
	 b:glossaryEntry='causing anger or annoyance; "offensive remarks"'/>
<rdf:Description rdf:about="&a;301569114"
	 b:glossaryEntry="expressing offensive reproach"/>
<rdf:Description rdf:about="&a;301569247"
	 b:glossaryEntry='not causing anger or annoyance; "inoffensive behavior"'/>
<rdf:Description rdf:about="&a;301569409"
	 b:glossaryEntry="incapable of offending or attacking"/>
<rdf:Description rdf:about="&a;301569516">
	<b:glossaryEntry>for the purpose of attack rather than defense; "offensive weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301569800">
	<b:glossaryEntry>designed to inflict death or personal injury rather than material destruction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301569937"
	 b:glossaryEntry='used in an attack; "assault weapons", "attack planes"'/>
<rdf:Description rdf:about="&a;301570059"
	 b:glossaryEntry="disposed to attack"/>
<rdf:Description rdf:about="&a;301570149">
	<b:glossaryEntry>designed for or consisting of a brief attack followed by a quick escape; "hit-and-run units"; "tip-and-run assaults"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301570337"
	 b:glossaryEntry='involving invasion or aggressive attack; "invasive war"'/>
<rdf:Description rdf:about="&a;301570470">
	<b:glossaryEntry>characterized by plundering or pillaging or marauding; "bands of marauding Indians"; "predatory warfare"; "a raiding party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301570671"
	 b:glossaryEntry="actively attacking"/>
<rdf:Description rdf:about="&a;301570755">
	<b:glossaryEntry>intended or appropriate for defending against or deterring aggression or attack; "defensive weapons"; "a defensive stance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301571041">
	<b:glossaryEntry>designed for defense from a surface position against air attack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301571163"
	 b:glossaryEntry="defensive against enemy submarines"/>
<rdf:Description rdf:about="&a;301571257"
	 b:glossaryEntry="designed for defense against armored vehicles"/>
<rdf:Description rdf:about="&a;301571357">
	<b:glossaryEntry>(games or sports) attempting to or designed to prevent an opponent from winning or scoring</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301571503"
	 b:glossaryEntry="(fencing) in a defensive stance"/>
<rdf:Description rdf:about="&a;301571589">
	<b:glossaryEntry>offending against or breaking a law or rule; "contracts offending against the statute were canceled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301571781">
	<b:glossaryEntry>transgressing a moral or divine law; "if it be a sin to covet honor, I am the most sinning soul alive"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301571950">
	<b:glossaryEntry>violating or tending to violate or offend against; "violative of the principles of liberty"; "considered such depravity offensive against all laws of humanity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301572177">
	<b:glossaryEntry>not offending; "an unoffending motorist should not have been stopped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301572304">
	<b:glossaryEntry>offering or expressing apology; "an apologetic note"; "an apologetic manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301572491"
	 b:glossaryEntry="feeling regret for a fault or offence"/>
<rdf:Description rdf:about="&a;301572583"
	 b:glossaryEntry="attempting to justify or defend in speech or writing"/>
<rdf:Description rdf:about="&a;301572736"
	 b:glossaryEntry="conscious of your own shortcomings"/>
<rdf:Description rdf:about="&a;301572833">
	<b:glossaryEntry>unwilling to make or express an apology; "an unapologetic believer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301572959">
	<b:glossaryEntry>having official authority or sanction; "official permission"; "an official representative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301573212">
	<b:glossaryEntry>sanctioned by established authority; "an authoritative communique"; "the authorized biography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301573379">
	<b:glossaryEntry>by virtue of an office or position; "the head of the department serves as an ex officio member of the board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301573544">
	<b:glossaryEntry>characteristic of or befitting a person in authority; "formal duties"; "an official banquet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301573689">
	<b:glossaryEntry>given formal standing or endorsement; made official or legitimate by the observance of proper procedures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301573850"
	 b:glossaryEntry="having some official authority or sanction"/>
<rdf:Description rdf:about="&a;301573951">
	<b:glossaryEntry>not having official authority or sanction; "a sort of unofficial mayor"; "an unofficial estimate"; "he participated in an unofficial capacity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301574240">
	<b:glossaryEntry>performed speedily and without formality; "a summary execution"; "summary justice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301574387">
	<b:glossaryEntry>not officially recognized or controlled; "an informal agreement"; "a loose organization of the local farmers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301574559">
	<b:glossaryEntry>without official authorization; "an unauthorized strike"; "wildcat work stoppage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301574709">
	<b:glossaryEntry>without explicit official permission; "unsanctioned use of company cars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301574840">
	<b:glossaryEntry>having been established or made firm or received the rite of confirmation; "confirmed reservations"; "received confirmed reports of casualties"; "a confirmed Catholic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301575081"
	 b:glossaryEntry='verified officially; "the election returns are now official"'/>
<rdf:Description rdf:about="&a;301575196">
	<b:glossaryEntry>not finally established or settled; "an unconfirmed letter of credit"; "unconfirmed rumors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301575363">
	<b:glossaryEntry>not officially established; "the early election returns are unofficial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301575491">
	<b:glossaryEntry>brought about or set up or accepted; especially long established; "the established social order"; "distrust of established authority"; "a team established as a member of a major league"; "enjoyed his prestige as an established writer"; "an established precedent"; "the established Church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301576017"
	 b:glossaryEntry='widely or permanently accepted; "an accepted precedent"'/>
<rdf:Description rdf:about="&a;301576127">
	<b:glossaryEntry>caused to exist; "he applauded the good will brought about in the neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301576266">
	<b:glossaryEntry>(used especially of ideas or principles) deeply rooted; firmly fixed or held; "deep-rooted prejudice"; "deep-seated differences of opinion"; "implanted convictions"; "ingrained habits of a lifetime"; "a deeply planted need"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301576595">
	<b:glossaryEntry>established firmly and securely; "the entrenched power of the nobility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301576723"
	 b:glossaryEntry="established as if settled into a groove or rut"/>
<rdf:Description rdf:about="&a;301576838">
	<b:glossaryEntry>made a norm or custom or habit; "his habitual practice was to eat an early supper"; "her habitual neatness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301577000">
	<b:glossaryEntry>in accordance with recognized or accepted standards or principles; "legitimate advertising practices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301577158">
	<b:glossaryEntry>(of a church) given official status as a national or state institution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301577283"
	 b:glossaryEntry='provided with a secure reputation; "a recognized authority"'/>
<rdf:Description rdf:about="&a;301577399">
	<b:glossaryEntry xml:space='preserve'><![CDATA[well established and ready to function; "things I can do now that I''m set up"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301577529"
	 b:glossaryEntry='not established; "a reputation as yet unestablished"'/>
<rdf:Description rdf:about="&a;301577659">
	<b:glossaryEntry>not having a secure reputation; "short stories by unrecognized writiers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301577790">
	<b:glossaryEntry>(psychology) established by conditioning or learning; "a conditioned response"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301577936">
	<b:glossaryEntry>not established by conditioning or learning; "an unconditioned reflex"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301578087">
	<b:glossaryEntry>designed for use in loading e.g. cargo; "a loading dock"; "a loading chute is used to drive cattle into a truck or other conveyance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301578276"
	 b:glossaryEntry="used in unloading or removing e.g. cargo"/>
<rdf:Description rdf:about="&a;301578372"
	 b:glossaryEntry='taking place or located at the site; "on-site inspection"'/>
<rdf:Description rdf:about="&a;301578501">
	<b:glossaryEntry>at the scene of action; "an on-the-spot reporter"; "on-the-spot inspections"; "an on-the scene newscast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301578684">
	<b:glossaryEntry>taking place or located away from the site; "an off-site waste treatment operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301578822">
	<b:glossaryEntry>situated or taking place in the area of a stage not visible to the audience; "offstage noises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301578971">
	<b:glossaryEntry>situated or taking place on the area of a stage visible to the audience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301579096">
	<b:glossaryEntry>not on the streets; "off-street parking"; "off-street unloading of vehicles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301579229">
	<b:glossaryEntry>at the sides of streets; "on-street parking is prohibited at rush hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301579356">
	<b:glossaryEntry>of long duration; not new; "old tradition"; "old house"; "old wine"; "old country"; "old friendships"; "old money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301579880">
	<b:glossaryEntry>belonging to or lasting from times very long ago; "age-old customs"; "Western civilization is ancient"; "the antique fear that days would dwindle away to complete darkness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301580126">
	<b:glossaryEntry>so extremely old as seeming to belong to an earlier period; "a ramshackle antediluvian tenement"; "antediluvian ideas"; "archaic laws"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301580342">
	<b:glossaryEntry>made in or typical of earlier times and valued for its age; "the an "beautiful antique French furniture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301580500"
	 b:glossaryEntry='a Scottish word; "auld lang syne"'/>
<rdf:Description rdf:about="&a;301580584"
	 b:glossaryEntry='no longer new; uninteresting; "cold (or stale) news"'/>
<rdf:Description rdf:about="&a;301580695">
	<b:glossaryEntry>passed on from one person to another; "not too proud to wear hand-me-down clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301580848"
	 b:glossaryEntry='ancient; "hoary jokes"'/>
<rdf:Description rdf:about="&a;301580930">
	<b:glossaryEntry>long past; beyond the limits of memory or tradition or recorded history; "time immemorial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301581081">
	<b:glossaryEntry>belonging to time long gone; "those long-ago dresses that swished along the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301581218"
	 b:glossaryEntry='of long duration; "a longtime friend"'/>
<rdf:Description rdf:about="&a;301581313">
	<b:glossaryEntry>mended usually clumsily by covering a hole with a patch; "patched jeans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301581439">
	<b:glossaryEntry>previously used or owned by another; "bought a secondhand (or used) car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301581575"
	 b:glossaryEntry='of a declining industry or technology; "sunset industries"'/>
<rdf:Description rdf:about="&a;301581686"
	 b:glossaryEntry='changed to a yellowish color by age; "yellowed parchment"'/>
<rdf:Description rdf:about="&a;301581807">
	<b:glossaryEntry>not of long duration; having just (or relatively recently) come into being or been made or acquired or discovered; "a new law"; "new cars"; "a new comet"; "a new friend"; "a new year"; "the New World"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301582417">
	<b:glossaryEntry>conspicuously new; "shiny brand-new shoes"; "a spick-and-span novelty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301582587">
	<b:glossaryEntry>(of a cycle) beginning or occurring again; "a fresh start"; "fresh ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301582712">
	<b:glossaryEntry>newest or most recent; "news hot off the press"; "red-hot information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301582842">
	<b:glossaryEntry>having just or recently arisen or come into existence; "new nations"; "with newborn fears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301583017">
	<b:glossaryEntry>newly discovered; "his newfound aggressiveness"; "Hudson pointed his ship down the coast of the newfound sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301583181">
	<b:glossaryEntry>pleasantly novel or different; "common sense of a most refreshing sort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301583317"
	 b:glossaryEntry="of or characteristic of a parvenu"/>
<rdf:Description rdf:about="&a;301583415">
	<b:glossaryEntry>being new in a time not long past; "recent graduates"; "a recent addition to the house"; "recent buds on the apple trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301583589">
	<b:glossaryEntry>markedly new or introducing radical change; "a revolutionary discovery"; "radical political views"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301583757"
	 b:glossaryEntry='newly come into prominence; "a rising young politician"'/>
<rdf:Description rdf:about="&a;301583865">
	<b:glossaryEntry>of an industry or technology; new and developing; "high-technology sunrise industries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301584008">
	<b:glossaryEntry>not yet proved or subjected to testing; "an untested drug"; "untested theory"; "an untried procedure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301584174">
	<b:glossaryEntry>not yet put into use; "we boughtt an unused car for a change"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301584288"
	 b:glossaryEntry='being used or worked for the first time; "virgin wool"'/>
<rdf:Description rdf:about="&a;301584395">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used especially of persons) having lived for a relatively long time or attained a specific age; especially not young; "an old man''s eagle mind"- William Butler Yeats; "his mother is very old"; "a ripe old age"; "how old are you?"; often used as a combining form to indicate an age as specified as in "a week-old infant"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301585161">
	<b:glossaryEntry xml:space='preserve'><![CDATA[advanced in years; (`aged'' is pronounced as two syllables); "aged members of the society"; "elderly residents could remember the construction of the first skyscraper"; "senior citizen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301585423">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having attained a specific age; (`aged'' is pronounced as one syllable); "aged ten"; "ten years of age"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301585591"
	 b:glossaryEntry="growing old"/>
<rdf:Description rdf:about="&a;301585675"
	 b:glossaryEntry='very old; "an ancient mariner"'/>
<rdf:Description rdf:about="&a;301585759"
	 b:glossaryEntry="of or like a feeble old woman"/>
<rdf:Description rdf:about="&a;301585840"
	 b:glossaryEntry="being at least 100 years old"/>
<rdf:Description rdf:about="&a;301585926">
	<b:glossaryEntry>(of fabrics and paper) grown dark in color over time; "the darkened margins of the paper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301586070">
	<b:glossaryEntry>mentally or physically infirm with age; "his mother was doddering and frail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301586228">
	<b:glossaryEntry xml:space='preserve'><![CDATA[honorably retired from assigned duties and retaining your title along with the additional title `emeritus'' as in "professor emeritus"; "retired from `assigned duties''" does not necessarily imply that one is inactive]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301586508">
	<b:glossaryEntry>showing characteristics of age, especially having gray or white hair; "whose beard with age is hoar"-Coleridge; "nodded his hoary head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301586787"
	 b:glossaryEntry="being roughly between 45 and 65 years old"/>
<rdf:Description rdf:about="&a;301586886">
	<b:glossaryEntry>being from 90 to 99 years old; "the nonagenarian inhabitants of the nursing home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301587026"
	 b:glossaryEntry="being from 80 to 89 years old"/>
<rdf:Description rdf:about="&a;301587114"
	 b:glossaryEntry="somewhat elderly"/>
<rdf:Description rdf:about="&a;301587183">
	<b:glossaryEntry>too old to be useful; "He left the house...for the support of twelve superannuated wool carders"- Anthony Trollope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301587378">
	<b:glossaryEntry>discharged as too old for use or work; especially with a pension; "a superannuated civil servant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301587545">
	<b:glossaryEntry>being from 60 to 69 years old; "the sexagenarian population is growing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301587675">
	<b:glossaryEntry>impressive by reason of age; "a venerable sage with white hair and beard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301587804">
	<b:glossaryEntry>(used of living things especially persons) in an early period of life or development or growth; "young people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301588301">
	<b:glossaryEntry>being of the age 13 through 19; "teenage mothers"; "the teen years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301588453">
	<b:glossaryEntry>being or befitting or characteristic of an infant; "baby rabbits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301588596">
	<b:glossaryEntry>befitting or characteristic of a young boy; "a boyish grin"; "schoolboyish pranks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301588756"
	 b:glossaryEntry='befitting a young child; "childlike charm"'/>
<rdf:Description rdf:about="&a;301588864"
	 b:glossaryEntry='very young; "at an early age"'/>
<rdf:Description rdf:about="&a;301588945">
	<b:glossaryEntry>susceptible to alteration by development and experience; "formative years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301589075">
	<b:glossaryEntry>befitting or characteristic of a young girl; "girlish charm"; "a dress too schoolgirlish for office wear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301589250">
	<b:glossaryEntry>including or intended for youthful persons; "a junior sports league"; "junior fashions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301589390"
	 b:glossaryEntry='very young; "a little child"; "small children"'/>
<rdf:Description rdf:about="&a;301589497"
	 b:glossaryEntry='recently borne; "a newborn infant"'/>
<rdf:Description rdf:about="&a;301589585"
	 b:glossaryEntry="characteristic of a puppy"/>
<rdf:Description rdf:about="&a;301589677">
	<b:glossaryEntry>susceptible to physical or emotional injury; "at a tender age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301589805"
	 b:glossaryEntry="somewhat young"/>
<rdf:Description rdf:about="&a;301589874"
	 b:glossaryEntry="suggestive of youth; vigorous and fresh"/>
<rdf:Description rdf:about="&a;301589977">
	<b:glossaryEntry>(of clothing) consisting of or fashioned in a single whole piece; "a one-piece garment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301590138">
	<b:glossaryEntry>(of clothing) made in or consisting of two parts or pieces; "a two-piece swimsuit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301590294">
	<b:glossaryEntry>(of clothing) made in or consisting of three parts or pieces; "the standard three-piece business suit; jacket and trousers and vest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301590502">
	<b:glossaryEntry>(computer sci) connected to a computer network or accessible by computer; "an on-line database"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301590669">
	<b:glossaryEntry>stored in, controlled by, or in direct communication with a central computer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301590822">
	<b:glossaryEntry>(computer sci) not connected to a computer network; "off-line resources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301590949">
	<b:glossaryEntry>(transportation) on a regular route of a railroad or bus or airline system; "on-line industries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591099">
	<b:glossaryEntry>(transportation) not on a regular route of a transportation system; "an off-line ticket office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591249">
	<b:glossaryEntry>in operation or operational; "left the oven on"; "the switch is in the on position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591399">
	<b:glossaryEntry>plugged in; "first check to see whether the appliance is connected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591522">
	<b:glossaryEntry>not in operation or operational; "the oven is off"; "the lights are off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591662">
	<b:glossaryEntry>not plugged in or connected to a power source; "the iron is disconnected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591794">
	<b:glossaryEntry>(of events) planned or scheduled; "the picnic is on, rain or shine"; "we have nothing on for Friday night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301591967"
	 b:glossaryEntry='taking place; "the parade is still happening"'/>
<rdf:Description rdf:about="&a;301592068">
	<b:glossaryEntry>(of events) no longer planned or scheduled; "the wedding is definitely off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301592205">
	<b:glossaryEntry>(sports) not offside; being within the prescribed area of play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301592320">
	<b:glossaryEntry>(sports) illegally beyond a prescribed line or area or ahead of the ball or puck; "the touchdown was nullified because the left tackle was offside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301592532">
	<b:glossaryEntry>affording unobstructed entrance and exit; not shut or closed; "an open door"; "they left the door open"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301592753"
	 b:glossaryEntry='slightly open; "the door was ajar"'/>
<rdf:Description rdf:about="&a;301592841"
	 b:glossaryEntry='open wide; "left the doors wide-open"'/>
<rdf:Description rdf:about="&a;301592934"
	 b:glossaryEntry='not open; "the door slammed shut"'/>
<rdf:Description rdf:about="&a;301593054">
	<b:glossaryEntry>affording free passage or access; "open drains"; "the road is open to traffic"; "open ranks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301593287"
	 b:glossaryEntry='made open or clear; "the newly opened road'/>
<rdf:Description rdf:about="&a;301593382">
	<b:glossaryEntry>(of a container) having the stopper removed; "whiskey spilled from the unstoppered bottle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301593531">
	<b:glossaryEntry>gaping open as if threatening to engulf someone or something; "the yawning mine shaft"; "a yawning abyss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301593690">
	<b:glossaryEntry>not open or affording passage or access; "the many closed streets made travel difficult"; "our neighbors peeped from behind closed curtains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301594009"
	 b:glossaryEntry='closed at one end; "a blind alley"'/>
<rdf:Description rdf:about="&a;301594095">
	<b:glossaryEntry>closed to traffic; "the repaving results in many blocked streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301594230">
	<b:glossaryEntry>having the curtains or draperies closed or pulled shut; "the drawn draperies kept direct sunlight from fading the rug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301594400">
	<b:glossaryEntry>(of a container) having a stopper in the opening; "the tightly stoppered bottles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301594537">
	<b:glossaryEntry>used of mouth or eyes; "keep your eyes open"; "his mouth slightly opened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301594742">
	<b:glossaryEntry>with the mouth wide open as in wonder or awe; "the gaping audience"; "we stood there agape with wonder"; "with mouth agape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301594929">
	<b:glossaryEntry>(used of eyes) open and fixed as if in fear or wonder; "staring eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301595060">
	<b:glossaryEntry>(used of eyes) fully open or extended; "listened in round-eyed wonder"; "stared with wide eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301595219">
	<b:glossaryEntry>with the mouth wide open indicating boredom or sleepiness; "a yawning congregation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301595356">
	<b:glossaryEntry>used especially of mouth or eyes; "he sat quietly with closed eyes"; "his eyes were shut against the sunlight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301595580">
	<b:glossaryEntry>closing the eyes intermittently and rapidly; he stood blinking in the bright sunlight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301595731"
	 b:glossaryEntry='pressed tightly together; "with lips compressed"'/>
<rdf:Description rdf:about="&a;301595844">
	<b:glossaryEntry>having eyes half closed in order to see better; "squinched eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301595976">
	<b:glossaryEntry>arranged with spaces between; often used as a combining form; "widely spaced eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301596165">
	<b:glossaryEntry>(of type or print) having a blank line between lines of type; "manuscripts must be double-spaced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301596322">
	<b:glossaryEntry>(printing) having thin strips of lead between the lines of type</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301596438">
	<b:glossaryEntry>(of type or print) not having a blank space between lines; "business letters are usually single-spaced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301596601"
	 b:glossaryEntry="arranged without spaces between"/>
<rdf:Description rdf:about="&a;301596705"
	 b:glossaryEntry="(printing) not having leads between the lines"/>
<rdf:Description rdf:about="&a;301596805">
	<b:glossaryEntry>closed in or surrounded or included within; "an enclosed porch"; "an enclosed yard"; "the enclosed check is to cover shipping and handling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301597305"
	 b:glossaryEntry="enclosed in a basin"/>
<rdf:Description rdf:about="&a;301597378"
	 b:glossaryEntry='surrounded by hostile forces; "the besieged town"'/>
<rdf:Description rdf:about="&a;301597482">
	<b:glossaryEntry>enclosed in or as if in a box; "boxed cigars"; "a confining boxed-in space"; "felt boxed in by the traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301597669"
	 b:glossaryEntry="(botany; of seeds or spores) enclosed in a capsule"/>
<rdf:Description rdf:about="&a;301597788"
	 b:glossaryEntry='blocked against entry; "a closed porch"'/>
<rdf:Description rdf:about="&a;301597895"
	 b:glossaryEntry="(of an insect pupa) enclosed in a rigid case"/>
<rdf:Description rdf:about="&a;301597995"
	 b:glossaryEntry="enclosed by a confining fence"/>
<rdf:Description rdf:about="&a;301598100">
	<b:glossaryEntry>enclosed firmly in a surrounding mass; "found pebbles embedded in the silt"; "stone containing many embedded fossils"; "peach and plum seeds embedded in a sweet edible pulp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301598328">
	<b:glossaryEntry>enclosed or sheltered in or as if in a bower; "a house embowered with wysteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301598463">
	<b:glossaryEntry>enclosed within a circle; "the encircled camp was complete cut off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301598586">
	<b:glossaryEntry>completely enclosed or swallowed up; "a house engulfed in flames"; "the fog-enveloped cliffs"; "a view swallowed by night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301598787">
	<b:glossaryEntry>enclosed or enveloped in something immaterial; "she sat enwrapped in sullen defiance"; "a sleeping town enwrapped in silence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301598968">
	<b:glossaryEntry>so enveloped in fog that it is not safe to move about; "a fogbound fleet"; "the fogbound city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599117">
	<b:glossaryEntry>enclosed in the same envelope or package; "the included check"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599234">
	<b:glossaryEntry>enveloped; "a castle involved in mist"; "the difficulties in which the question is involved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599381">
	<b:glossaryEntry>of self-imposed enclosure or confinement; "a self-enclosed Jewish cosmos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599514">
	<b:glossaryEntry>confined on all sides; "a camp surrounded by enemies"; "the encircled pioneers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599662">
	<b:glossaryEntry>not closed in our surrounded or included; "an unenclosed porch"; "unenclosed common land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599844">
	<b:glossaryEntry>having no protecting cover or enclosure; "an open boat"; "an open fire"; "open sports cars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301599986"
	 b:glossaryEntry='not fenced in; "unfenced pasture"'/>
<rdf:Description rdf:about="&a;301600074"
	 b:glossaryEntry="(music) used of string or hole or pipe of instruments"/>
<rdf:Description rdf:about="&a;301600181"
	 b:glossaryEntry="(music) used of string or hole or pipe of instruments"/>
<rdf:Description rdf:about="&a;301600297"
	 b:glossaryEntry="converted to leather by a tanning agent"/>
<rdf:Description rdf:about="&a;301600389">
	<b:glossaryEntry>not converted to leather by a tanning agent; "a whip made of untanned hide"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301600519">
	<b:glossaryEntry>in a condition for letting out liquid drawn out as by piercing or drawing a plug; "latex from tapped rubber trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301600704"
	 b:glossaryEntry='of a cask or barrel; "the cask was set abroach"'/>
<rdf:Description rdf:about="&a;301600816">
	<b:glossaryEntry>not subjected to tapping; "an untapped keg; "an untapped sugar maple"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301600940">
	<b:glossaryEntry>(mathematics) of a set; containing points whose neighborhood consists of other points of the same set, or being the complement of an open set; of an interval; containing neither of its end points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301601186">
	<b:glossaryEntry>(mathematics) of a curve or surface; having no end points or boundary curves; of a set; having members that can be produced by a specific operation on other members of the same set; of an interval; containing both its endpoints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301601466">
	<b:glossaryEntry>(military) of or intended for or involved in military operations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301601624">
	<b:glossaryEntry>(military) engaged in or ready for military or naval operations; "on active duty"; "the platoon is combat-ready"; "review the fighting forces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301601848">
	<b:glossaryEntry>(military) equipped and ready for service; "the fort was held by about 100 effective soldiers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301601998"
	 b:glossaryEntry="not involved in military operations"/>
<rdf:Description rdf:about="&a;301602112"
	 b:glossaryEntry="not engaged in military action"/>
<rdf:Description rdf:about="&a;301602210">
	<b:glossaryEntry>suitable or at a time that is suitable or advantageous especially for a particular purpose; "an opportune place to make camp"; "an opportune arrival"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301602469">
	<b:glossaryEntry>most suitable or right for a particular purpose; "a good time to plant tomatoes"; "the right time to act"; "the time is ripe for great sociological changes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301602691">
	<b:glossaryEntry xml:space='preserve'><![CDATA[done or happening at the appropriate or proper time; "a timely warning"; "with timely treatment the patient has a good chance of recovery"; "a seasonable time for discussion"; "the book''s publication was well timed"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301603004">
	<b:glossaryEntry>not opportune; "arrived at a most inopportune hour"; "an inopportune visit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301603191">
	<b:glossaryEntry>badly timed; "an ill-timed intervention"; "you think my intrusion unseasonable"; "an untimely remark"; "it was the wrong moment for a joke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301603438">
	<b:glossaryEntry>not conveniently timed; "an early departure is inconvenient for us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301603564">
	<b:glossaryEntry>capable of being placed opposite to something; "the thumb is opposable to the forefinger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301603721"
	 b:glossaryEntry="not opposable"/>
<rdf:Description rdf:about="&a;301603792">
	<b:glossaryEntry>being in opposition or having an opponent; "two bitterly opposed schools of thought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301603948">
	<b:glossaryEntry>on bad terms; "they were usually at odds over politics"; "conflicting opinions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301604098">
	<b:glossaryEntry>not having opposition or an opponent; "unopposed military forces"; "the candidate was unopposed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301604250">
	<b:glossaryEntry>(botany) of leaves etc; growing in pairs on either side of a stem; "opposite leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301604398">
	<b:glossaryEntry>(botany) of leaves and branches etc; first on one side and then on the other in two ranks along an axis; not paired; "stems with alternate leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301604600">
	<b:glossaryEntry>expecting the best in this best of all possible worlds; "in an optimistic mood"; "optimistic plans"; "took an optimistic view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301604909"
	 b:glossaryEntry="(stock market) expecting a rise in prices"/>
<rdf:Description rdf:about="&a;301605004"
	 b:glossaryEntry="pleasantly (even unrealistically) optimistic"/>
<rdf:Description rdf:about="&a;301605127">
	<b:glossaryEntry>reflecting optimism; "a rosy future"; "looked at the world through rose-colored glasses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301605281">
	<b:glossaryEntry>unrealistically or naively optimistic; "a starry-eyed reformer"; "starry-eyed idealism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301605426"
	 b:glossaryEntry="confidently optimistic and cheerful"/>
<rdf:Description rdf:about="&a;301605516"
	 b:glossaryEntry="expecting the worst in this worst of all possible worlds"/>
<rdf:Description rdf:about="&a;301605702"
	 b:glossaryEntry="(stock market) expecting prices to fall"/>
<rdf:Description rdf:about="&a;301605795">
	<b:glossaryEntry>made less hopeful or enthusiastic; "desperate demoralized people looking for work"; "felt discouraged by the magnitude of the problem"; "the disheartened instructor tried vainly to arouse their interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301606085">
	<b:glossaryEntry>(anatomy) of or involving the mouth or mouth region or the surface on which the mouth is located; "the oral cavity"; "the oral mucous membrane"; "the oral surface of a starfish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301606349">
	<b:glossaryEntry>toward the inside of the cheek; "the buccal aspect of the gum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301606475"
	 b:glossaryEntry='lying within the mouth; "a buccal gland"'/>
<rdf:Description rdf:about="&a;301606568">
	<b:glossaryEntry>(anatomy) opposite to or away from the mouth; "the aboral surface of a starfish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301606701">
	<b:glossaryEntry>(of radiate organisms) located on the surface or end on which the mouth is situated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301606838">
	<b:glossaryEntry>(of radiate animals) located on the surface or end opposite to that on which the mouth is situated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301606992">
	<b:glossaryEntry>devoid of violence or disruption; "an orderly crowd confronted the president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301607141">
	<b:glossaryEntry>(of groups) not violent or disorderly; "the right of peaceful assembly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301607281">
	<b:glossaryEntry>undisciplined and unruly; "disorderly youths"; "disorderly conduct"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301607495">
	<b:glossaryEntry>noisy and lacking in restraint or discipline; "a boisterous crowd"; "a social gathering that became rambunctious and out of hand"; "a robustious group of teenagers"; "beneath the rumbustious surface of his paintings is sympathy for the vulnerability of ordinary human beings"; "an unruly class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301607897"
	 b:glossaryEntry="disposed to loud disagreements and fighting"/>
<rdf:Description rdf:about="&a;301608006">
	<b:glossaryEntry>characteristic of a mob; disorderly or lawless; "mob rule"; "fanned mounting tension into mobbish terrorizing"; "moblike mentality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301608207">
	<b:glossaryEntry>disturbing the public peace; loud and rough; "a raucous party"; "rowdy teenagers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301608350">
	<b:glossaryEntry>characterized by disorderly action and disregard for rules; "a rough-and-tumble fight"; "rough-and-tumble politics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301608528">
	<b:glossaryEntry>having a systematic arrangement; especially having elements succeeding in order according to rule; "an ordered sequence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301608738"
	 b:glossaryEntry="in alphabetical order"/>
<rdf:Description rdf:about="&a;301608832"
	 b:glossaryEntry='in regular succession without gaps; "serial concerts"'/>
<rdf:Description rdf:about="&a;301608988"
	 b:glossaryEntry="not arranged in order"/>
<rdf:Description rdf:about="&a;301609078">
	<b:glossaryEntry>methodical and efficient in arrangement or function; "how well organized she is"; "his life was almost too organized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301609323">
	<b:glossaryEntry>characterized by method and orderliness; "a methodical scholar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301609443">
	<b:glossaryEntry>marked by system or regularity or discipline; "a quiet ordered house"; "an orderly universe"; "a well regulated life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301609636">
	<b:glossaryEntry>characterized by good organization and control; "a well-conducted meeting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301609771">
	<b:glossaryEntry>lacking order or methodical arrangement or function; "a disorganized enterprise"; "a thousand pages of muddy and disorganized prose"; "she was too disorganized to be an agreeable roommate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301610144">
	<b:glossaryEntry>thrown into a state of disarray or confusion; "troops fleeing in broken ranks"; "a confused mass of papers on the desk"; "the small disordered room"; "with everything so upset"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301610405"
	 b:glossaryEntry="lacking a visible order or organization"/>
<rdf:Description rdf:about="&a;301610515">
	<b:glossaryEntry>snarled or stalled in complete confusion; "situation normal--all fucked-up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301610654">
	<b:glossaryEntry>thrown together in a disorderly fashion; "a scrambled plan of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301610779">
	<b:glossaryEntry>not efficient or methodical; "the project failed through unmethodical planning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301610917">
	<b:glossaryEntry>thrown into a state of disorganization or incoherence; "price programs became unstuck because little grain was available"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301611101">
	<b:glossaryEntry>formed into a structured or coherent whole; "organized religion"; "organized crime"; "an organized tour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301611387"
	 b:glossaryEntry='planned in advance; "an arranged marriage"'/>
<rdf:Description rdf:about="&a;301611484">
	<b:glossaryEntry>organized so as to give configuration to; "a magnet is surrounded by a configured field"; "a vehicle designed for rough terrain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301611680">
	<b:glossaryEntry>organized and maintained as a legal corporation; "a special agency set up in corporate form"; "an incorporated town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301611867">
	<b:glossaryEntry>having taken on a definite arrangement; "cheerleaders were formed into letters"; "we saw troops formed into columns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301612036">
	<b:glossaryEntry>formed again or anew; "the re-formed scout troop has been very active"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301612162"
	 b:glossaryEntry='organized again; "a reorganized business"'/>
<rdf:Description rdf:about="&a;301612261">
	<b:glossaryEntry>not having or belonging to a structured whole; "unorganized territories lack a formal government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301612488">
	<b:glossaryEntry>lacking proper coordination; "uncoordinated scheduling often resulted in conflicting games"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301612639"
	 b:glossaryEntry='not formed or organized; "an as yet unformed government"'/>
<rdf:Description rdf:about="&a;301612750"
	 b:glossaryEntry="not organized and maintained as a legal coporation"/>
<rdf:Description rdf:about="&a;301612861">
	<b:glossaryEntry>having definite and highly organized structure; "a structured environment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301613010">
	<b:glossaryEntry>lacking definite structure or organization; "an unstructured situation with no one in authority"; "a neighborhood gang with a relatively unstructured system"; "children in an unstructured environment often feel insecure"; "unstructured inkblots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301613368">
	<b:glossaryEntry>(psychology) having no intrinsic or objective meaning; not organized in conventional patterns; "an ambiguous situation with no frame of reference"; "ambiguous inkblots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301613592">
	<b:glossaryEntry>without regulation or discipline; "an unregulated environment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301613712">
	<b:glossaryEntry>not exceptional in any way especially in quality or ability or size or degree; "ordinary everyday objects"; "ordinary decency"; "an ordinary day"; "an ordinary wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301614148">
	<b:glossaryEntry>of no exceptional quality or ability; "a novel of average merit"; "only a fair performance of the sonata"; "in fair health"; "the caliber of the students has gone from mediocre to above average"; "the performance was middling at best"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301614465">
	<b:glossaryEntry>obvious and dull; "trivial conversation"; "commonplace prose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301614602">
	<b:glossaryEntry>lacking distinct or individual characteristics; dull and uninteresting; "women dressed in nondescript clothes"; "a nondescript novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301614809">
	<b:glossaryEntry>to be expected; standard; "common decency"; "simple courtesy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301614932">
	<b:glossaryEntry>completely ordinary and unremarkable; "air travel has now become commonplace"; "commonplace everyday activities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301615102">
	<b:glossaryEntry xml:space='preserve'><![CDATA[found in the ordinary course of events; "a placid everyday scene"; "it was a routine day"; "there''s nothing quite like a real...train conductor to add color to a quotidian commute"- Anita Diamant]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301615410">
	<b:glossaryEntry>neither good nor bad; "an indifferent performance"; "a gifted painter but an indifferent actor"; "her work at the office is passable"; "a so-so golfer"; "feeling only so-so"; "prepared a tolerable dinner"; "a tolerable working knowledge of French"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301615749">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not special in any way; "run-of-the-mill boxing"; "your run-of-the-mine college graduate"; "a unexceptional an incident as can be found in a lawyer''s career"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301616002">
	<b:glossaryEntry>beyond what is ordinary or usual; highly unusual or exceptional or remarkable; "extraordinary authority"; "an extraordinary achievement"; "her extraordinary beauty"; "enjoyed extraordinary popularity"; "an extraordinary capacity for work"; "an extraordinary session of the legislature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301616671"
	 b:glossaryEntry="(Australian) remarkable or wonderful"/>
<rdf:Description rdf:about="&a;301616760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[far beyond what is usual in magnitude or degree; "a night of exceeding darkness"; "an exceptional memory"; "olympian efforts to save the city from bankruptcy"; "the young Mozart''s prodigious talents"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301617066">
	<b:glossaryEntry>extraordinarily good; used especially as intensifiers; "a fantastic trip to the Orient"; "the film was fantastic!"; "a howling success"; "a marvelous collection of rare books"; "had a rattling conversation about politics"; "a tremendous achievement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301617457">
	<b:glossaryEntry>exceedingly or unbelievably great; "the bomb did fantastic damage"; "Samson is supposed to have had fantastic strength"; "phenomenal feats of memory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301617675">
	<b:glossaryEntry>(informal) extreme in degree; "in a frightful hurry"; "spent a frightful amount of money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301617820">
	<b:glossaryEntry>remarkable or out of the ordinary in degree or magnitude or effect; "a great crisis"; "had a great stake in the outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301617992"
	 b:glossaryEntry='used informally as an intensifier; "that is one fine dog"'/>
<rdf:Description rdf:about="&a;301618102">
	<b:glossaryEntry>surpassing the ordinary or normal; "Beyond his preternatural affability there is some acid and some steel"- George Will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301618281">
	<b:glossaryEntry>suggestive of fireworks; "pyrotechnic keyboard virtuosity"; "a pyrotechnic wit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301618418">
	<b:glossaryEntry>marked by an uncommon quality; especially superlative or extreme of its kind; "what is so rare as a day in June"-J.R.Lowell; "a rare skill"; "an uncommon sense of humor"; "she was kind to an uncommon degree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301618687">
	<b:glossaryEntry>unusual or striking; "a remarkable sight"; "such poise is singular in one so young"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301618838">
	<b:glossaryEntry>(informal; slang) remarkable; "that was some party"; "she is some skier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301618961">
	<b:glossaryEntry>for a special service or occasion; "a special correspondent"; "a special adviser to the committee"; "had to get special permission for the event"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301619160"
	 b:glossaryEntry="performing or able to perform wonders or miracles"/>
<rdf:Description rdf:about="&a;301619269">
	<b:glossaryEntry>(chemistry) relating or belonging to the class of chemical compounds having a carbon basis; "hydrocarbons are organic compounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301619451">
	<b:glossaryEntry>(chemistry) relating or belonging to the class of compounds not having a carbon basis; "hydrochloric and sulfuric acids are called inorganic substances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301619659">
	<b:glossaryEntry>being or relating to or derived from or having properties characteristic of living organisms; "organic life"; "organic growth"; "organic remains found in rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301619908">
	<b:glossaryEntry>resembling a living organism in organization or development; "society as an integrated whole"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301620071">
	<b:glossaryEntry>involving or derived from living organisms; free from chemical treatments or additives; "organic gardening is more natural"; "nonsynthetic fertilizer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301620290"
	 b:glossaryEntry="lacking the properties characteristic of living organisms"/>
<rdf:Description rdf:about="&a;301620457">
	<b:glossaryEntry>lacking the system or structure characteristic of living bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301620591">
	<b:glossaryEntry>not arising from natural growth or characterized by vital processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301620715">
	<b:glossaryEntry>composed of matter other than plant or animal; "the inorganic mineral world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301620845">
	<b:glossaryEntry>emphasizing the organic or functional relation between parts and the whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301620974"
	 b:glossaryEntry="divided into separate and often disparate elements"/>
<rdf:Description rdf:about="&a;301621094">
	<b:glossaryEntry>disposed or placed in a particular kind of order; "the carefully arranged chessmen"; "haphazardly arranged interlobular septa"; "comfortable chairs arranged around the fireplace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301621373">
	<b:glossaryEntry>set down according to a plan:"a carefully laid table with places set for four people"; "stones laid in a pattern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301621543">
	<b:glossaryEntry>put in position in relation to other things; "end tables placed conveniently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301621673">
	<b:glossaryEntry>having the arrangement disturbed; not in order; "her disarranged hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301621873"
	 b:glossaryEntry='in disarray; "disarrayed bedclothes"'/>
<rdf:Description rdf:about="&a;301621966">
	<b:glossaryEntry>having the place or position changed; "the disturbed books and papers on her desk"; "disturbed grass showed where the horse had passed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301622157">
	<b:glossaryEntry>put in the wrong place or position; "She was penalized for a spelling mistake or a misplaced accent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301622313"
	 b:glossaryEntry='not in a proper arrangement; "not a hair was out of place"'/>
<rdf:Description rdf:about="&a;301622433">
	<b:glossaryEntry>adjusted or located in relation to surroundings or circumstances; sometimes used in combination; "the house had its large windows oriented toward the ocean view"; "helping freshmen become oriented to college life"; "the book is value-oriented throughout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301622881">
	<b:glossaryEntry>having achieved a comfortable relationship with your environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301623015">
	<b:glossaryEntry>headed or intending to head in a certain direction; "children bound for school"; "a flight destined for New York"; often used as a combining form; "school-bound children"; "college-bound high school students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301623286">
	<b:glossaryEntry>having a specified direction; "a positively directed vector"; (often used in combination; "goal-directed")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301623447">
	<b:glossaryEntry>having a heading or course in a certain direction; "westward headed wagons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301623575">
	<b:glossaryEntry>oriented toward home; "in a homeward direction"; "homeward-bound commuters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301623722">
	<b:glossaryEntry>(used in combination) mentally oriented toward something specified; "civic-minded"; "career-minded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301623874">
	<b:glossaryEntry>not having position or goal definitely set or ascertained; "engaged in unoriented study"; "unoriented until she looked at the map"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301624115">
	<b:glossaryEntry>socially disoriented; "anomic loners musing over their fate"; "we live in an age of rootless alienated people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301624304">
	<b:glossaryEntry>having lost your bearings; confused as to time or place or personal identity; "I frequently find myself disoriented when I come up out of the subway"; "the anesthetic left her completely disoriented"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301624579">
	<b:glossaryEntry xml:space='preserve'><![CDATA[positioning with respect to a reference system or determining your bearings physically or intellectually; "noticed the bee''s momentary orienting pause before heading back to the hive"; "an orienting program for new employees"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301624964"
	 b:glossaryEntry="causing to fall into line or into position"/>
<rdf:Description rdf:about="&a;301625075">
	<b:glossaryEntry>indicating or determining size and position in space; "the ultrasonic dimensioning measurement"; "an ultrasonic dimensioning arrangement of the heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301625284"
	 b:glossaryEntry="serving to make familiar"/>
<rdf:Description rdf:about="&a;301625368">
	<b:glossaryEntry>orienting or directing homeward or to a destination; "the homing instinct"; "a homing beacon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301625514">
	<b:glossaryEntry>causing loss of physical or intellectual bearings; "making so many turns to the right and then the left was completely disorienting"; "a sharp blow to the head can be disorienting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301625843">
	<b:glossaryEntry>causing confusion or disorientation; "a confusing jumble of road signs"; "being hospitalized can be confusing and distressing for a small child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301626043">
	<b:glossaryEntry>making one feel out of place or alienated; "the landscape was estranging"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301626173">
	<b:glossaryEntry>causing or capable of causing bewilderment or shock or insensibility; "laid the poor fellow senseless with one stunning blow"; "a stunning detonation with volumes of black smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301626406">
	<b:glossaryEntry>making physically stupid or dull or insensible; "a stupefying blow to the head"; "the stupefying effects of hemp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301626576">
	<b:glossaryEntry>being or productive of something fresh and unusual; or being as first made or thought of; "a truly original approach"; "with original music"; "an original mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301627007"
	 b:glossaryEntry='radically new or original; "an avant-garde theater piece"'/>
<rdf:Description rdf:about="&a;301627131">
	<b:glossaryEntry>done by hand without mechanical aids or devices; "a freehand drawing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301627275">
	<b:glossaryEntry>of a kind not seen before; "the computer produced a completely novel proof of a well-known theorem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301627440">
	<b:glossaryEntry>containing seeds of later development; "seminal ideas of one discipline can influence the growth of another"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301627627">
	<b:glossaryEntry>being or producing something like nothing done or experienced or created before; "stylistically innovative works"; "innovative members of the artistic community"; "a mind so innovational, so original"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301627899"
	 b:glossaryEntry="of a new (often outrageous) kind or fashion"/>
<rdf:Description rdf:about="&a;301628005"
	 b:glossaryEntry='not derivative or imitative; "a natural underivative poet"'/>
<rdf:Description rdf:about="&a;301628122">
	<b:glossaryEntry>not original; not being or productive of something fresh and unusual; "the manuscript contained unoriginal emendations"; "his life had been unoriginal, conforming completely to the given pattern"- Gwethalyn Graham</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301628572">
	<b:glossaryEntry xml:space='preserve'><![CDATA[repeated too often; overfamiliar through overuse; "bromidic sermons"; "his remarks were trite and commonplace"; "hackneyed phrases"; "a stock answer"; "repeating threadbare jokes"; "parroting some timeworn axiom"; "the trite metaphor `hard as nails''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301628974">
	<b:glossaryEntry>dull and tiresome but with pretensions of significance or originality; "bromidic sermons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301629157">
	<b:glossaryEntry>repeated regularly without thought or originality; "ready-made phrases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301629295">
	<b:glossaryEntry>lacking originality or spontaneity; no longer new; "moth-eaten theories about race"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301629449"
	 b:glossaryEntry='blindly imitative; "a slavish copy of the original"'/>
<rdf:Description rdf:about="&a;301629554">
	<b:glossaryEntry>adhering to what is commonly accepted; "an orthodox view of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301629805">
	<b:glossaryEntry>conforming to orthodox or recognized rules; "the drinking of cocktails was as canonical a rite as the mixing"- Sinclair Lewis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630009">
	<b:glossaryEntry>adhering to established customs or doctrines (especially in religion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630148">
	<b:glossaryEntry>conforming with accepted standards; "a conventional view of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630291">
	<b:glossaryEntry>pertaining to time-honored orthodox doctrines; "the simple security of traditional assumptions has vanished"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630457">
	<b:glossaryEntry>breaking with convention or tradition; "an unorthodox lifestyle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630686">
	<b:glossaryEntry>(of Catholics formerly) refusing to attend services of the Church of England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630831">
	<b:glossaryEntry>characterized by departure from accepted beliefs or standards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301630972">
	<b:glossaryEntry>characterized by attack on established beliefs or institutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301631093">
	<b:glossaryEntry>not conforming to established customs or doctrines especially in religion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301631242">
	<b:glossaryEntry>used of some Protestant churches especially Calvinist as distinct from Lutheran; also used of Reform Judaism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301631405">
	<b:glossaryEntry>located, suited for, or taking place in the open air; "outdoor clothes"; "badminton and other outdoor games"; "a beautiful outdoor setting for the wedding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301631695"
	 b:glossaryEntry='in the open air; "an alfresco lunch"; "an open-air theater"'/>
<rdf:Description rdf:about="&a;301631823">
	<b:glossaryEntry>characteristic of or suitable to outdoor life; "a rugged outdoorsy life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301631951">
	<b:glossaryEntry>located, suited for, or taking place within a building; "indoor activities for a rainy day"; "an indoor pool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301632143">
	<b:glossaryEntry>relating to or being on or near the outer side or limit; "an outside margin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301632399"
	 b:glossaryEntry='outside regular school hours; "a special after-school class"'/>
<rdf:Description rdf:about="&a;301632521">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) outside or outer; "the `ecto'' in `ectoderm'' is a prefix meaning `outside''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301632655">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) outside or beyond; "`extra'' is a prefix in `an extrauterine pregnancy''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301632787"
	 b:glossaryEntry="outside the regular duties of your job or profession"/>
<rdf:Description rdf:about="&a;301632901">
	<b:glossaryEntry>outside the regular academic curriculum; "sports and drama are popular extracurricular activities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301633061">
	<b:glossaryEntry>of the side of cloth or clothing intended to face outward; "the right side of the cloth showed the pattern"; "be sure your shirt is right side out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301633263">
	<b:glossaryEntry>relating to or being within or near the inner side or limit; "he reached into his inside jacket pocket"; "inside out"; "an inside pitch is between home plate and the batter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301633543">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) within; e.g. "`endo'' and `ento'' are prefixes in such words as `endometrium'' and `entoderm''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301633701">
	<b:glossaryEntry>used of the side of cloth or clothing intended to face inward; "socks worn wrong side out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301633843">
	<b:glossaryEntry>overlaid or spread or topped with or enclosed within something; sometimes used as a combining form; "women with covered faces"; "covered wagons"; "a covered balcony"; "snow-covered fields"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301634553">
	<b:glossaryEntry>(botany) of some seeds; having a fleshy and usually brightly colored cover</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301634691">
	<b:glossaryEntry>covered with an awning; "with awninged windows on the west side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301634810">
	<b:glossaryEntry>covered with barnacles; "the barnacled hull of a wrecked ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301634928"
	 b:glossaryEntry='covered with beads of liquid; "a face beaded with sweat"'/>
<rdf:Description rdf:about="&a;301635037">
	<b:glossaryEntry>smeared thickly; often useed in combination; "cheeks beplastered with cosmetics"; "paint-besmeared savage bodies"; "mud-daubed walls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301635249">
	<b:glossaryEntry>covered thickly with objects thrusting upward as with bristles; "roofs bristling with antennas"; "housetops bristlng with chimneys"; "a riverbank bristling with factories"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301635484">
	<b:glossaryEntry>covered with or as with a canopy; "a canopied bed"; "streets canopied by stately trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301635626">
	<b:glossaryEntry>covered with or as if with clothes or a wrap or cloak; "leaf-clothed trees"; "fog-cloaked meadows"; "a beam draped with cobwebs"; "cloud-wrapped peaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301635870"
	 b:glossaryEntry="having a hardened crust as a covering"/>
<rdf:Description rdf:about="&a;301635994">
	<b:glossaryEntry>covered patchily; often used in combination; "waves dabbled with moonlight"; "a blood-spattered room"; "gardens splashed with color"; "kitchen walls splattered with grease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301636266">
	<b:glossaryEntry>abundantly covered or supplied with; often used in combination; "drenched in moonlight"; "moon-drenched meadows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301636447">
	<b:glossaryEntry>splashed or covered patchily with moonlight; "the moon-splashed world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301636577"
	 b:glossaryEntry="overgrown with moss"/>
<rdf:Description rdf:about="&a;301636661"
	 b:glossaryEntry='covered with or as if with mud; "mud-beplastered arguments"'/>
<rdf:Description rdf:about="&a;301636782">
	<b:glossaryEntry>wrapped up especially for protection or secrecy; "children muffled almost to the eyebrows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301636926"
	 b:glossaryEntry="(of walls) covered with a coat of plaster"/>
<rdf:Description rdf:about="&a;301637032"
	 b:glossaryEntry="covered with growing plants"/>
<rdf:Description rdf:about="&a;301637115"
	 b:glossaryEntry='covered with a waterproof coating; "a sealed driveway"'/>
<rdf:Description rdf:about="&a;301637222">
	<b:glossaryEntry>completely covered; "bonnets smothered with flowers"; "smothered chicken is chicken cooked in a seasoned gravy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301637389">
	<b:glossaryEntry>covered with snow; "snow-clad hills"; "snow-covered roads"; "a long snowy winter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301637549">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used with `with'' or in combination) covered by or as if by something scattered over or on; "the forest floor strewn with boulders"; "the petal-strewn aisle"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301637759">
	<b:glossaryEntry>covered with sunlight; "sun-drenched beaches along the Riviera"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301637881"
	 b:glossaryEntry='covered thickly; "toast thickspread with jam"'/>
<rdf:Description rdf:about="&a;301637984">
	<b:glossaryEntry>covered or furnished with tiles; "baths with tiled walls"; "a tiled kitchen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301638112">
	<b:glossaryEntry>marked by the presence of snow; "a white Christmas"; "the white hills of a northern winter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301638263">
	<b:glossaryEntry>not supplied with a cover or covering; "an uncovered well"; "the stands are uncovered so take an umbrella"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301638479">
	<b:glossaryEntry>without the natural or usual covering; "a bald spot on the lawn"; "bare hills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301638636"
	 b:glossaryEntry='lacking drapery or draperies; "undraped windows"'/>
<rdf:Description rdf:about="&a;301638739"
	 b:glossaryEntry='having no roof; "an unroofed shed"'/>
<rdf:Description rdf:about="&a;301638828">
	<b:glossaryEntry>having a coating; covered with an outer layer or film; often used in combination; "coated paper has a smooth polished coating especially suitable for halftone printing"; "sugar-coated pills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301639125">
	<b:glossaryEntry>(photography; of film) coated on the side opposite the emulsion with a substance to absorb light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301639274">
	<b:glossaryEntry>(of foods) covered with a shiny coating by applying e.g. beaten egg or a sugar or gelatin mixture; "glazed doughnuts"; "a glazed ham"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301639460"
	 b:glossaryEntry='coated or covered with oil; "oily puddles in the streets"'/>
<rdf:Description rdf:about="&a;301639568"
	 b:glossaryEntry='not having a coating; "uncoated paper"'/>
<rdf:Description rdf:about="&a;301639661">
	<b:glossaryEntry>covered with a roof; having a roof as specified (often used in combination); "roofed picnic areas"; "a slate-roofed house"; "palmleaf-roofed huts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301639860">
	<b:glossaryEntry>not having a roof; "the hurricane left hundreds of house roofless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301639981">
	<b:glossaryEntry>having or covered with leaves; "leafy trees"; "leafy vegetables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301640259"
	 b:glossaryEntry="having two leaves"/>
<rdf:Description rdf:about="&a;301640332"
	 b:glossaryEntry='like a bower; leafy and shady; "a bowery lane"'/>
<rdf:Description rdf:about="&a;301640431"
	 b:glossaryEntry="bearing numerous leaves"/>
<rdf:Description rdf:about="&a;301640532">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(botany; often used as a combining form) having or resembling a leaf or having a specified kind or number of leaves; "`foliate'' is combined with the prefix `tri'' to form the word `trifoliate''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301640778">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(botany; often used as a combining form) having leaflets (compound leaves) or a specified kind or number of leaflets; "`foliolate'' is combined with the prefix `bi'' to form the word `bifoliolate''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301641030">
	<b:glossaryEntry xml:space='preserve'><![CDATA[overgrown with ivy; "Harvard''s ivied buildings"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301641143">
	<b:glossaryEntry>having leaves or leaves as specified; often used in combination; "a fully leafed tree"; "broad-leafed"; "four-leaved clover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301641329"
	 b:glossaryEntry="resembling a leaf"/>
<rdf:Description rdf:about="&a;301641401"
	 b:glossaryEntry="having a single leaf"/>
<rdf:Description rdf:about="&a;301641478"
	 b:glossaryEntry="having no leaves"/>
<rdf:Description rdf:about="&a;301641621"
	 b:glossaryEntry="(botany) having no leaves"/>
<rdf:Description rdf:about="&a;301641702"
	 b:glossaryEntry='denuded of leaves; "the bare branches of winter"'/>
<rdf:Description rdf:about="&a;301641801"
	 b:glossaryEntry="deprived of leaves"/>
<rdf:Description rdf:about="&a;301641888">
	<b:glossaryEntry>(botany) having a leafless flower stalk growing directly from the ground; "tulips are scapose flowers"; "a scapose stalk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301642063">
	<b:glossaryEntry>having a lip or lips; "a lipped bowl"; "a virgin purest lipped"- John Keats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301642227">
	<b:glossaryEntry>(botany) having two lips; "the corolla of a snapdragon is bilabiate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301642351"
	 b:glossaryEntry="having lips or parts that resemble lips"/>
<rdf:Description rdf:about="&a;301642454"
	 b:glossaryEntry="without a lip or lips"/>
<rdf:Description rdf:about="&a;301642540">
	<b:glossaryEntry>open and observable; not secret or hidden; "an overt lie"; "overt hostility"; "overt intelligence gathering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301642833"
	 b:glossaryEntry='with no effort to conceal; "a barefaced lie"'/>
<rdf:Description rdf:about="&a;301642940">
	<b:glossaryEntry>devoid of elaboration or diminution or concealment; bare and pure; "naked ambition"; "raw fury"; "you may kill someone someday with your raw power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301643145"
	 b:glossaryEntry='plain to see; "undisguised curiosity"'/>
<rdf:Description rdf:about="&a;301643240"
	 b:glossaryEntry='obvious to the eye; "a visible change of expression"'/>
<rdf:Description rdf:about="&a;301643356">
	<b:glossaryEntry>secret or hidden; not openly practiced or engaged in or shown or avowed; "covert actions by the CIA"; "covert funding for the rebels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301643794">
	<b:glossaryEntry>secret and sly or sordid; "backstairs gossip"; "his low backstairs cunning"- A.L.Guerard; "backstairs intimacies"; "furtive behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301644006">
	<b:glossaryEntry>(of intelligence operations) deliberately misleading; "black propaganda"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301644130">
	<b:glossaryEntry>conducted with or marked by hidden aims or methods; "clandestine intelligence operations"; "cloak-and-dagger activities behind enemy lines"; "hole-and-corner intrigue"; "secret missions"; "a secret agent"; "secret sales of arms"; "surreptitious mobilization of troops"; "an undercover investigation"; "underground resistance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301644651">
	<b:glossaryEntry>indulging only covertly; "a closet alcoholic"; "closet liberals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301644780"
	 b:glossaryEntry="acting together in secret toward a fraudulent or illegal end"/>
<rdf:Description rdf:about="&a;301644908">
	<b:glossaryEntry>having its true character concealed with the intent of misleading; "hidden agenda"; "masked threat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301645082">
	<b:glossaryEntry>communicated covertly; "their a secret signal was a wink"; "secret messages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301645211">
	<b:glossaryEntry>designed and carried out secretly or confidentially; "a sub-rosa report"; "has their under-the-table backing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301645393">
	<b:glossaryEntry>lying beneath what is revealed or avowed, especially being deliberately concealed; "subterranean motives for murder"; "looked too closely for an ulterior purpose in all knowledge"- Bertrand Russell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301645660"
	 b:glossaryEntry='kept secret; "the plan was kept carefully under wraps"'/>
<rdf:Description rdf:about="&a;301645775"
	 b:glossaryEntry="not made known"/>
<rdf:Description rdf:about="&a;301645860">
	<b:glossaryEntry>marked by the reception of pay; "paid work"; "a paid official"; "a paid announcement"; "a paid check"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301646174"
	 b:glossaryEntry='for which money has been paid; "a cashed check"'/>
<rdf:Description rdf:about="&a;301646274">
	<b:glossaryEntry>for which money is paid; "a paying job"; "remunerative work"; "salaried employment"; "stipendiary services"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301646491">
	<b:glossaryEntry>receiving or eligible for compensation; "salaried workers"; "a stipendiary magistrate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301646674"
	 b:glossaryEntry="used of soldiers hired by a foreign army"/>
<rdf:Description rdf:about="&a;301646788"
	 b:glossaryEntry='paid in advance; "paid-up insurance"; "paid-up members"'/>
<rdf:Description rdf:about="&a;301646897"
	 b:glossaryEntry="(British) postpaid"/>
<rdf:Description rdf:about="&a;301646971"
	 b:glossaryEntry="used especially of mail; paid in advance"/>
<rdf:Description rdf:about="&a;301647076">
	<b:glossaryEntry>with cost of reply prepaid by sender; "reply-paid postcard"; "reply-paid envelope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301647215">
	<b:glossaryEntry>(informal) leaving no balance; "my account with you is now all square"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301647341"
	 b:glossaryEntry='not paid; "unpaid wages"; "an unpaid bill"'/>
<rdf:Description rdf:about="&a;301647526">
	<b:glossaryEntry>(British) free of charge; "if they deposit these shares in the scheme they will get further buckshee shares on a one-for-one basis"- Economist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301647723"
	 b:glossaryEntry='costing nothing; "complimentary tickets"'/>
<rdf:Description rdf:about="&a;301647866">
	<b:glossaryEntry>owed as a debt; "outstanding bills"; "the amount still owed"; "undischarged debts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301648039">
	<b:glossaryEntry>complimentary; without payment of rent; "with the job came a rent-free apartment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301648176"
	 b:glossaryEntry='not paying a salary; "an uncompensated federal post"'/>
<rdf:Description rdf:about="&a;301648301">
	<b:glossaryEntry>causing physical or psychological pain; "worked with painful slowness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301648713">
	<b:glossaryEntry>causing a dull and steady pain; "my aching head"; "her old achy joints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301648844"
	 b:glossaryEntry='expressing pain or agony; "agonized screams"'/>
<rdf:Description rdf:about="&a;301648943"
	 b:glossaryEntry="extremely painful"/>
<rdf:Description rdf:about="&a;301649081">
	<b:glossaryEntry>causing a sharply painful or stinging sensation; used especially of cold; "bitter cold"; "a biting wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301649247">
	<b:glossaryEntry>producing or having a painfully hot sensation; "begged for water to soothe his burning throat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301649395"
	 b:glossaryEntry="painful from having the skin abraded"/>
<rdf:Description rdf:about="&a;301649493">
	<b:glossaryEntry>keenly distressing to the mind or feelings; "poignant anxiety"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301649610">
	<b:glossaryEntry>causing or experiencing a painful shivering feeling as from many tiny pricks; "a prickling blush of embarrassment"; "the tingling feeling in a foot that has gone to sleep"; "a stinging nettle"; "the stinging windblown sleet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301649912">
	<b:glossaryEntry>causing great physical or mental suffering; "a wrenching pain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301650040"
	 b:glossaryEntry="(of a rider) sore after riding a horse"/>
<rdf:Description rdf:about="&a;301650136"
	 b:glossaryEntry='hurting; "the tender spot on his jaw"'/>
<rdf:Description rdf:about="&a;301650245">
	<b:glossaryEntry>experiencing a burning or stinging pain; "with smarting eyes from the smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301650376"
	 b:glossaryEntry="psychologically painful"/>
<rdf:Description rdf:about="&a;301650455">
	<b:glossaryEntry>not causing physical or psychological pain; "painless dentistry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301650610"
	 b:glossaryEntry='not accompanied by pain sensations; "pain-free surgery"'/>
<rdf:Description rdf:about="&a;301650733"
	 b:glossaryEntry='coated with paint; "freshly painted lawn furniture"'/>
<rdf:Description rdf:about="&a;301650910">
	<b:glossaryEntry>having a surface coating or finish applied; "the finished bookcase costs much more than the unfinished ones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301651073"
	 b:glossaryEntry="having a coating of stain or varnish"/>
<rdf:Description rdf:about="&a;301651175"
	 b:glossaryEntry='coated with whitewash; "miles of whitewashed fences"'/>
<rdf:Description rdf:about="&a;301651285">
	<b:glossaryEntry>not having a coat of paint or badly in need of a fresh coat; "an unpainted house"; "unpainted furniture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301651517">
	<b:glossaryEntry>lacking a surface finish such as paint; "bare wood"; "unfinished furniture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301651656"
	 b:glossaryEntry="not having oil rubbed into the surface"/>
<rdf:Description rdf:about="&a;301651748"
	 b:glossaryEntry="not having a coating of stain or varnish"/>
<rdf:Description rdf:about="&a;301651858"
	 b:glossaryEntry='having makeup applied; "brazen painted faces"'/>
<rdf:Description rdf:about="&a;301651993"
	 b:glossaryEntry='marked by the use of makeup; "heavily made-up eyes"'/>
<rdf:Description rdf:about="&a;301652098">
	<b:glossaryEntry>marked by the use of various kinds of red makeup; "freshly rouged lips"; "rouged cheeks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301652239"
	 b:glossaryEntry='not having makeup on; "her sweet unpainted face"'/>
<rdf:Description rdf:about="&a;301652361"
	 b:glossaryEntry='not wearing rouge; "unrouged lips"'/>
<rdf:Description rdf:about="&a;301652450"
	 b:glossaryEntry='represented accurately or precisely"'/>
<rdf:Description rdf:about="&a;301652659"
	 b:glossaryEntry="represented graphically by sketch or design or lines"/>
<rdf:Description rdf:about="&a;301652789">
	<b:glossaryEntry>represented in words especially with sharpness and detail; "the vividly described wars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301652932"
	 b:glossaryEntry="shown or represented by diagrams"/>
<rdf:Description rdf:about="&a;301653040"
	 b:glossaryEntry="represented in a drawing"/>
<rdf:Description rdf:about="&a;301653116">
	<b:glossaryEntry>represented in a painting; "as idle as a painted ship upon a painted ocean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301653245"
	 b:glossaryEntry="not represented accurately or precisely"/>
<rdf:Description rdf:about="&a;301653379"
	 b:glossaryEntry="not pictured"/>
<rdf:Description rdf:about="&a;301653461"
	 b:glossaryEntry="not represented in a drawing"/>
<rdf:Description rdf:about="&a;301653543">
	<b:glossaryEntry>lending itself to being painted; "a highly paintable landscape"; "made of sturdy eminently paintable wood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301653705">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not paintable especially not suitable for artistic representation on canvas; "the inexpressible, unpaintable `tick'' in the unconscious"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301653898">
	<b:glossaryEntry>acceptable to the taste or mind; "palatable food"; "a palatable solution to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301654096">
	<b:glossaryEntry>not pleasant or acceptable to the taste or mind; "an unpalatable meal"; "unpalatable truths"; "unpalatable behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301654378"
	 b:glossaryEntry="not pleasing in odor or taste"/>
<rdf:Description rdf:about="&a;301654488">
	<b:glossaryEntry>capable of being perceived by the senses or the mind; especially capable of being handled or touched or felt; "a barely palpable dust"; "felt sudden anger in a palpable wave"; "the air was warm and close--palpable as cotton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301654814">
	<b:glossaryEntry>easily perceived by the senses or grasped by the mind; "a perceptible sense of expectation in the court"; "an obvious (or palpable) lie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301655018">
	<b:glossaryEntry>imperceptible to the senses or the mind; "an impalpable cloud"; "impalpable shadows"; "impalpable distinctions"; "as impalpable as a dream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301655250">
	<b:glossaryEntry>be difficult to detect or grasp by the mind; "his whole attitude had undergone a subtle change"; "a subtle difference"; "that elusive thing the soul"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301655462">
	<b:glossaryEntry>being everywhere equidistant and not intersecting; "parallel lines never converge"; "concentric circles are parallel"; "dancers in two parallel rows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301655774">
	<b:glossaryEntry>(especially of vectors) parallel but oppositely directed; "antiparallel vectors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301655913">
	<b:glossaryEntry>situated or running side by side; "collateral ridges of mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301656036"
	 b:glossaryEntry="of lines, planes, or surfaces; never meeting or crossing"/>
<rdf:Description rdf:about="&a;301656170">
	<b:glossaryEntry>slanting or inclined in direction or course or position--neither parallel nor perpendicular nor right-angular; "the oblique rays of the winter sun"; "acute and obtuse angles are oblique angles"; "the axis of an oblique cone is not perpendicular to its base"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301656625">
	<b:glossaryEntry>slanting diagonally across the grain of a fabric; "a bias fold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301656739">
	<b:glossaryEntry>slanted across a polygon on a diagonal line; "set off in a catty-corner direction across the vacant lot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301657011">
	<b:glossaryEntry>at an angle; especially connecting two nonadjacent corners of a plane figure or any two corners of a solid that are not in the same face; "a diagonal line across the page"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301657237"
	 b:glossaryEntry="(of e.g. lines or paths) not parallel; converging"/>
<rdf:Description rdf:about="&a;301657344">
	<b:glossaryEntry>intersecting at or forming right angles; "the axes are perpendicular to each other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301657559"
	 b:glossaryEntry="(geometry) forming a right angle"/>
<rdf:Description rdf:about="&a;301657644">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having a set of mutually perpendicular axes; meeting at right angles; "wind and sea may displace the ship''s center of gravity along three orthogonal axes"; "a rectangular Cartesian coordinate system"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301657914">
	<b:glossaryEntry>(geometry) having the axis perpendicular to the base; "a right angle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301658035"
	 b:glossaryEntry="admitting of being pardoned"/>
<rdf:Description rdf:about="&a;301658173"
	 b:glossaryEntry='easily excused or forgiven; "a venial error"'/>
<rdf:Description rdf:about="&a;301658295"
	 b:glossaryEntry="capable of being atoned for"/>
<rdf:Description rdf:about="&a;301658377"
	 b:glossaryEntry='(theology) warranting only temporal punishment; "venial sin"'/>
<rdf:Description rdf:about="&a;301658498"
	 b:glossaryEntry='not admitting of pardon; "unpardonable behavior"'/>
<rdf:Description rdf:about="&a;301658677">
	<b:glossaryEntry>(theology) involving loss of divine grace or spiritual death; "the seven deadly sins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301658827"
	 b:glossaryEntry="not excusable"/>
<rdf:Description rdf:about="&a;301658913"
	 b:glossaryEntry="incapable of being atoned for"/>
<rdf:Description rdf:about="&a;301658999"
	 b:glossaryEntry="capable of being overlooked"/>
<rdf:Description rdf:about="&a;301659100"
	 b:glossaryEntry="capable of being justified"/>
<rdf:Description rdf:about="&a;301659184"
	 b:glossaryEntry="without excuse or justification"/>
<rdf:Description rdf:about="&a;301659291"
	 b:glossaryEntry="incapable of being justified or explained"/>
<rdf:Description rdf:about="&a;301659453">
	<b:glossaryEntry>relating to or characteristic of or befitting a parent; "parental guidance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301659605">
	<b:glossaryEntry>relating to or characteristic of or befitting an offspring; "filial respect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301659752"
	 b:glossaryEntry='befitting a daughter; "daughterly affection"'/>
<rdf:Description rdf:about="&a;301659853"
	 b:glossaryEntry="showing favoritism"/>
<rdf:Description rdf:about="&a;301659970">
	<b:glossaryEntry>favoring one person or side over another; "a biased account of the trial"; "a decision that was partial to the defendant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301660176">
	<b:glossaryEntry>showing lack of favoritism; "the cold neutrality of an impartial judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301660400"
	 b:glossaryEntry="unaffected by self-interest"/>
<rdf:Description rdf:about="&a;301660487">
	<b:glossaryEntry>unaffected by strong emotion or prejudice; "a journalist should be a dispassionate reporter of fact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301660647">
	<b:glossaryEntry>characterized by a lack of partiality; "a properly indifferent jury"; "an unbiased account of her family problems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301660842">
	<b:glossaryEntry>marked by no especial liking or dislike or preference for one thing over another; "indifferent about which book you would give them"; "was indifferent to their acceptance or rejection of her invitation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301661102"
	 b:glossaryEntry="composed of distinct particles"/>
<rdf:Description rdf:about="&a;301661190"
	 b:glossaryEntry="not composed of distinct particles"/>
<rdf:Description rdf:about="&a;301661285">
	<b:glossaryEntry>able to be passed or traversed or crossed; "the road is passable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301661477">
	<b:glossaryEntry>able to be sailed on or through safely; "navigable waters"; "a navigable channel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301661614"
	 b:glossaryEntry='capable of being passed or negotiated; "a negotiable road"'/>
<rdf:Description rdf:about="&a;301661729"
	 b:glossaryEntry="capable of being surmounted"/>
<rdf:Description rdf:about="&a;301661827">
	<b:glossaryEntry>able to be traveled; "highway crews soon had the roads travelable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301661964"
	 b:glossaryEntry="impossible to pass"/>
<rdf:Description rdf:about="&a;301662106"
	 b:glossaryEntry="impossible to surmount or climb"/>
<rdf:Description rdf:about="&a;301662212"
	 b:glossaryEntry="impossible to sail through"/>
<rdf:Description rdf:about="&a;301662296"
	 b:glossaryEntry="impossible to traverse"/>
<rdf:Description rdf:about="&a;301662378"
	 b:glossaryEntry="having or expressing strong emotions"/>
<rdf:Description rdf:about="&a;301662669">
	<b:glossaryEntry>keenly excited (especially sexually) or indicating excitement; "his face all ablaze with excitement"- Bram Stoker; "he was aflame with desire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301662898">
	<b:glossaryEntry>characterized by intense emotion; "ardent love"; "an ardent lover"; "a burning enthusiasm"; "a fervent desire to change society"; "a fervent admirer"; "fiery oratory"; "an impassioned appeal"; "a torrid love affair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301663241">
	<b:glossaryEntry>easily moved to anger; "men of the choleric type take to kicking and smashing"- H.G.Wells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301663385"
	 b:glossaryEntry="as if possessed by demons"/>
<rdf:Description rdf:about="&a;301663469">
	<b:glossaryEntry>marked by excessive enthusiasm for and intense devotion to a cause or idea; "rabid isolationist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301663653"
	 b:glossaryEntry="vigorously passionate"/>
<rdf:Description rdf:about="&a;301663736">
	<b:glossaryEntry>in a state of extreme emotion; "wild with anger"; "wild with grief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301663854"
	 b:glossaryEntry='not passionate; "passionless observation of human nature"'/>
<rdf:Description rdf:about="&a;301664059"
	 b:glossaryEntry='free from physical desire; "platonic love"'/>
<rdf:Description rdf:about="&a;301664156">
	<b:glossaryEntry>free from emotional appeal; marked by reasonableness; "answered with an unimpassioned defense"; "the unimpassioned intellect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301664341">
	<b:glossaryEntry>earlier than the present time; no longer current; "time past"; "his youth is past"; "this past Thursday"; "the past year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301664927">
	<b:glossaryEntry xml:space='preserve'><![CDATA[gone by; or in the past; "two years ago"; "`agone'' is an archaic word for `ago''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301665065">
	<b:glossaryEntry>belonging to times long past especially of the historical period before the fall of the Western Roman Empire; "ancient history"; "ancient civilizations such as those of the Etruscans and Summarians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301665317">
	<b:glossaryEntry>well in the past; former; "bygone days"; "dreams of foregone times"; "sweet memories of gone summers"; "relics of a departed era"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301665537">
	<b:glossaryEntry>characteristic of the time of chivalry and knighthood in the Middle Ages; "chivalric rites"; "the knightly years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301665728"
	 b:glossaryEntry='occurring earlier in time; "on earlier occasions"'/>
<rdf:Description rdf:about="&a;301665831">
	<b:glossaryEntry>of the distant past; "the early inhabitants of Europe"; "former generations"; "in other times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301666003">
	<b:glossaryEntry>belonging to some prior time; "erstwhile friend"; "our former glory"; "the once capital of the state"; "her quondam lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301666246"
	 b:glossaryEntry='(combining form) former; "an ex-president"'/>
<rdf:Description rdf:about="&a;301666340">
	<b:glossaryEntry>(used especially of persons) of to the immediate past; "the former president"; "our late President is still very active"; "the previous occupant of the White House"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301666584">
	<b:glossaryEntry>belonging to the past; "historical (or historic) times"; "a historical character"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301666733">
	<b:glossaryEntry>immediately past; "last Thursday"; "the last chapter we read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301666848">
	<b:glossaryEntry>of the immediate past or just previous to the present time; "a late development"; "their late quarrel"; "his recent trip to Africa"; "in recent months"; "a recent issue of the journal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301667095"
	 b:glossaryEntry='of an earlier time; "his old classmates"'/>
<rdf:Description rdf:about="&a;301667185"
	 b:glossaryEntry='of time long past; "olden days"'/>
<rdf:Description rdf:about="&a;301667268"
	 b:glossaryEntry='recently past; "the other evening"'/>
<rdf:Description rdf:about="&a;301667357">
	<b:glossaryEntry>belonging to or existing in times before recorded history; "prehistoric settlements"; "prehistoric peoples"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301667538"
	 b:glossaryEntry='at a specific prior time; "the then president"'/>
<rdf:Description rdf:about="&a;301667638">
	<b:glossaryEntry>in or of the month preceding the present one; "your letter received on the 29th ult"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301667781">
	<b:glossaryEntry>temporal sense; intermediate between past and future; now existing or happening or in consideration; "the present leader"; "articles for present use"; "the present topic"; "the present system"; "present observations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301668162"
	 b:glossaryEntry='presently existing; "the existing system"'/>
<rdf:Description rdf:about="&a;301668258"
	 b:glossaryEntry='of the present time and place; "the immediate revisions"'/>
<rdf:Description rdf:about="&a;301668370"
	 b:glossaryEntry='in or of the present month; "your letter of the 10th inst"'/>
<rdf:Description rdf:about="&a;301668489">
	<b:glossaryEntry>belonging to the present or recent times; "the latter-day problems of our society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301668628">
	<b:glossaryEntry>yet to be or coming; "some future historian will evaluate him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301668941">
	<b:glossaryEntry>of the relatively near future; "the approaching election"; "this coming Thursday"; "the forthcoming holidays"; "the upcoming spring fashions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301669177">
	<b:glossaryEntry>yet to come; "coming generations"; "a future-day Gibbon of Macaulay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301669314">
	<b:glossaryEntry>expected in the near future; "look for an early end to the negotiations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301669438"
	 b:glossaryEntry='coming to maturity; "the rising generation"'/>
<rdf:Description rdf:about="&a;301669545">
	<b:glossaryEntry>in readiness; awaiting; "gave us a hint of the excitement that was in store for us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301669686">
	<b:glossaryEntry>anticipated for the near future; "the prospective students"; "his prospective bride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301669831">
	<b:glossaryEntry>in or of the next month after the present; "scheduled for the 6th prox"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301669963"
	 b:glossaryEntry='brought into existence; "he was a child born of adultery"'/>
<rdf:Description rdf:about="&a;301670179"
	 b:glossaryEntry="(used especially of human beings) born"/>
<rdf:Description rdf:about="&a;301670275"
	 b:glossaryEntry="produced from an egg"/>
<rdf:Description rdf:about="&a;301670349"
	 b:glossaryEntry="(used of an mammal) born"/>
<rdf:Description rdf:about="&a;301670427"
	 b:glossaryEntry="(used of a canine) born"/>
<rdf:Description rdf:about="&a;301670504"
	 b:glossaryEntry="(used of a horse or related animal) born"/>
<rdf:Description rdf:about="&a;301670597"
	 b:glossaryEntry="(used of cattle especially domestic cattle) born"/>
<rdf:Description rdf:about="&a;301670698"
	 b:glossaryEntry='not yet brought into existence; "unborn generations"'/>
<rdf:Description rdf:about="&a;301670821"
	 b:glossaryEntry="not yet hatched"/>
<rdf:Description rdf:about="&a;301670892"
	 b:glossaryEntry="having a parent or parents or cared for by parent surrogates"/>
<rdf:Description rdf:about="&a;301671025">
	<b:glossaryEntry>provided with parental care and nurture especially by a surrogate or surrogates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301671159">
	<b:glossaryEntry>having no parent or parents or not cared for by parent surrogates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301671348"
	 b:glossaryEntry="deprived of parents by death or desertion"/>
<rdf:Description rdf:about="&a;301671453"
	 b:glossaryEntry="having no living father"/>
<rdf:Description rdf:about="&a;301671533"
	 b:glossaryEntry="having no living or known mother"/>
<rdf:Description rdf:about="&a;301671622"
	 b:glossaryEntry="characteristic of a father"/>
<rdf:Description rdf:about="&a;301671775">
	<b:glossaryEntry>like or befitting a father or fatherhood; kind and protective</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301671904"
	 b:glossaryEntry="benevolent but sometimes intrusive"/>
<rdf:Description rdf:about="&a;301671998">
	<b:glossaryEntry>characteristic of a mother; "warm maternal affection for her guest"- Dorothy Sayers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301672226"
	 b:glossaryEntry="showing maternal instincts"/>
<rdf:Description rdf:about="&a;301672312"
	 b:glossaryEntry="suggestive of or acting like a mother"/>
<rdf:Description rdf:about="&a;301672406"
	 b:glossaryEntry="befitting a mother; warm and nurturing"/>
<rdf:Description rdf:about="&a;301672499"
	 b:glossaryEntry="of or befitting or characteristic of a wife"/>
<rdf:Description rdf:about="&a;301672616"
	 b:glossaryEntry="of or befitting or characteristic of a husband"/>
<rdf:Description rdf:about="&a;301672718">
	<b:glossaryEntry>enduring trying circumstances with even temper or characterized by such endurance; "a patient smile"; "was patient with the children"; "an exact and patient scientist"; "please be patient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301673086">
	<b:glossaryEntry>quietly and steadily persevering especially in detail or exactness; "a diligent (or patient) worker"; "with persevering (or patient) industry she revived the failing business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301673330">
	<b:glossaryEntry>patiently enduring continual wrongs or trouble; "an enduring disposition"; "a long-suffering and uncomplaining wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301673518">
	<b:glossaryEntry>showing patient and unruffled self-control and restraint under adversity; slow to retaliate or express resentment; "seemly and forbearing...yet strong enough to resist aggression"; "was longanimous in the face of suffering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301673812">
	<b:glossaryEntry>showing the capacity for endurance; "injustice can make us tolerant and forgiving"; "a man patient of distractions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301673995">
	<b:glossaryEntry>capable of accepting delay with equanimity; "was unhurried with the small children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301674134">
	<b:glossaryEntry>restless or short of temper under delay or opposition; "impatient with the slower students"; "impatient of criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301674379"
	 b:glossaryEntry="unable to bear irritation"/>
<rdf:Description rdf:about="&a;301674485">
	<b:glossaryEntry>impatient especially under restriction or delay; "the government has done nothing to ease restrictions and manufacturers are growing restive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301674680">
	<b:glossaryEntry>unwilling to endure; "she was short with the slower students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301674808"
	 b:glossaryEntry="characteristic of a patriarchy"/>
<rdf:Description rdf:about="&a;301674950">
	<b:glossaryEntry>(of societies) being ruled by or having descent traced through the male line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301675084"
	 b:glossaryEntry="centered upon the father"/>
<rdf:Description rdf:about="&a;301675167"
	 b:glossaryEntry="characteristic of a matriarchy"/>
<rdf:Description rdf:about="&a;301675309">
	<b:glossaryEntry>of societies or families; being female dominated or having descent traced through the female line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301675464"
	 b:glossaryEntry="centered upon the mother"/>
<rdf:Description rdf:about="&a;301675547">
	<b:glossaryEntry>having patronage or clients; "street full of flourishing well-patronized shops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301675683">
	<b:glossaryEntry>having little patronage or few clients; "a restaurant unpatronized by the elite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301675853"
	 b:glossaryEntry="of lawyers or barristers; lacking clients"/>
<rdf:Description rdf:about="&a;301675950">
	<b:glossaryEntry>enclosed in a package or protective covering; "packaged cereals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301676087">
	<b:glossaryEntry>prepared and wraped beforehand and ready for sale; "prepackaged foods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301676227"
	 b:glossaryEntry='not packaged or put into packets; "unpackaged nuts"'/>
<rdf:Description rdf:about="&a;301676353"
	 b:glossaryEntry='not carefully arranged in a package; "a box of loose nails"'/>
<rdf:Description rdf:about="&a;301676464"
	 b:glossaryEntry="covered with a firm surface"/>
<rdf:Description rdf:about="&a;301676669"
	 b:glossaryEntry="covered with paving material"/>
<rdf:Description rdf:about="&a;301676797"
	 b:glossaryEntry="surfaced with a bituminous material"/>
<rdf:Description rdf:about="&a;301676890"
	 b:glossaryEntry='paved with brick; "follow the yellow brick road"'/>
<rdf:Description rdf:about="&a;301676990"
	 b:glossaryEntry="paved with cobblestones"/>
<rdf:Description rdf:about="&a;301677086"
	 b:glossaryEntry="having been paved"/>
<rdf:Description rdf:about="&a;301677163"
	 b:glossaryEntry="(British) having been paved"/>
<rdf:Description rdf:about="&a;301677244"
	 b:glossaryEntry="(Australia) having been paved"/>
<rdf:Description rdf:about="&a;301677326"
	 b:glossaryEntry="not hard-surfaced"/>
<rdf:Description rdf:about="&a;301677433">
	<b:glossaryEntry>covered with caliche, a hard calcium-carbonate encrusted soil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301677555"
	 b:glossaryEntry='made of packed earth or gravel; "a dirt road"'/>
<rdf:Description rdf:about="&a;301677671"
	 b:glossaryEntry="inspired by love for your country"/>
<rdf:Description rdf:about="&a;301677804"
	 b:glossaryEntry="fanatically patriotic"/>
<rdf:Description rdf:about="&a;301677947"
	 b:glossaryEntry="showing lack of love for your country"/>
<rdf:Description rdf:about="&a;301678089">
	<b:glossaryEntry>considered contrary to the best interests of the United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301678209">
	<b:glossaryEntry>not disturbed by strife or turmoil or war; "a peaceful nation"; "peaceful times"; "a far from peaceful Christmas"; "peaceful sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301678665"
	 b:glossaryEntry='free from strife; "a world at peace"'/>
<rdf:Description rdf:about="&a;301678759">
	<b:glossaryEntry>characterized by absence of emotional agitation; "calm acceptance of the inevitable"; "remained serene in the midst of turbulence"; "a serene expression on her face"; "she became more tranquil"; "tranquil life in the country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301679055">
	<b:glossaryEntry>idyllically calm and peaceful; suggesting happy tranquillity; "a halcyon atmosphere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301679193">
	<b:glossaryEntry>conducive to peace; "irenic without being namby-pamby"; "an irenic attitude toward former antagonists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301679348">
	<b:glossaryEntry>promoting peace; "the result of this pacific policy was that no troops were called up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301679488"
	 b:glossaryEntry='not directly at war; "nonbelligerent nations"'/>
<rdf:Description rdf:about="&a;301679594">
	<b:glossaryEntry>disposed to peace or of a peaceful nature; "the pacific temper seeks to settle disputes on grounds of justice rather than by force"; "a quiet and peaceable person"; "in a peaceable and orderly manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301679860"
	 b:glossaryEntry="opposed to war"/>
<rdf:Description rdf:about="&a;301679945">
	<b:glossaryEntry>inclined or disposed to peace; "they met in a peaceable spirit"; "peace-loving citizens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301680104"
	 b:glossaryEntry='without disturbance; "the undisturbed tenor of their life"'/>
<rdf:Description rdf:about="&a;301680220"
	 b:glossaryEntry='not peaceful; "unpeaceful times"; "an unpeaceful marriage"'/>
<rdf:Description rdf:about="&a;301680461">
	<b:glossaryEntry>engaged in war; "belligerent (or warring) nations"; "a fighting war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301680632">
	<b:glossaryEntry>characterized by violent emotions or behavior; "a stormy argument"; "a stormy marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301680772"
	 b:glossaryEntry="inclined to make war"/>
<rdf:Description rdf:about="&a;301680858"
	 b:glossaryEntry="not disposed to peace"/>
<rdf:Description rdf:about="&a;301680937"
	 b:glossaryEntry="feeling or expressing remorse for misdeeds"/>
<rdf:Description rdf:about="&a;301681118"
	 b:glossaryEntry="feeling or expressing pain or sorrow for sins or offenses"/>
<rdf:Description rdf:about="&a;301681260">
	<b:glossaryEntry>showing or constituting penance; "penitential tears"; "wrote a penitential letter apologizing for her hasty words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301681432"
	 b:glossaryEntry="not penitent or remorseful"/>
<rdf:Description rdf:about="&a;301681598">
	<b:glossaryEntry>having the ability to perceive or understand; keen in discernment; "a perceptive eye"; "a perceptive observation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301681912">
	<b:glossaryEntry>having or demonstrating ability to recognize or draw fine distinctions; "an acute observer of politics and politicians"; "incisive comments"; "icy knifelike reasoning"; "as sharp and incisive as the stroke of a fang"; "penetrating insight"; "frequent penetrative observations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301682334">
	<b:glossaryEntry>quick to understand; "a kind and apprehensive friend"- Nathaniel Hawthorne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301682480"
	 b:glossaryEntry="able to relate new percepts to past experience"/>
<rdf:Description rdf:about="&a;301682585">
	<b:glossaryEntry>exhibiting insight or clear and deep perception; "an insightful parent"; "the chapter is insightful and suggestive of new perspectives"-R.C.Angell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301682788"
	 b:glossaryEntry="quick to notice; showing quick and keen perception"/>
<rdf:Description rdf:about="&a;301682906">
	<b:glossaryEntry>keenly perceptive or alert; "quick-sighted into the faults of the time"- Leonard Bacon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301683081"
	 b:glossaryEntry='able to make fine distinctions; "a subtle mind"'/>
<rdf:Description rdf:about="&a;301683181">
	<b:glossaryEntry>characterized by understanding based on comprehension and discernment and empathy; "an understanding friend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301683349"
	 b:glossaryEntry='lacking perception; "as unperceptive as a boulder"'/>
<rdf:Description rdf:about="&a;301683527">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unable or unwilling to perceive or understand; "blind to a lover''s faults"; "blind to the consequences of their actions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301683699">
	<b:glossaryEntry>not consciously observing; "looked through him with blank unseeing eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301683840">
	<b:glossaryEntry>capable of being perceived by the mind or senses; "a perceptable limp"; "easily perceptible sounds"; "perceptible changes in behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301684194">
	<b:glossaryEntry>capable of being detected; "after a noticeable pause the lecturer continued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301684340">
	<b:glossaryEntry>capable of being perceived clearly; "an essay with a meaning that was not always discernible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301684491">
	<b:glossaryEntry>barely perceptible; lacking clarity or brightness or loudness etc; "a faint outline"; "the wan sun cast faint shadows"; "the faint light of a distant candle"; "faint colors"; "a faint hissing sound"; "a faint aroma"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301684758"
	 b:glossaryEntry='(medicine) can be felt by palpation; "a palpable tumor"'/>
<rdf:Description rdf:about="&a;301684868">
	<b:glossaryEntry>capable of being perceived especially by sight or hearing; "perceivable through the mist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301685015">
	<b:glossaryEntry>easily perceived; easy to become aware of; "this situation produces recognizable stress symptoms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301685171">
	<b:glossaryEntry>readily perceived by the senses; "the sensible universe"; "a sensible odor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301685301">
	<b:glossaryEntry>impossible or difficult to perceive by the mind or senses; "an imperceptible drop in temperature"; ~an imperceptible nod"; "color is unperceivable to the touch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301685681"
	 b:glossaryEntry='not perceptible to the touch; "an impalpable pulse"'/>
<rdf:Description rdf:about="&a;301685789"
	 b:glossaryEntry="incapable of being perceived or known"/>
<rdf:Description rdf:about="&a;301685901">
	<b:glossaryEntry>barely able to be perceived; "the transition was almost indiscernible"; "an almost insensible change"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301686090"
	 b:glossaryEntry="below the threshold of conscious perception"/>
<rdf:Description rdf:about="&a;301686190"
	 b:glossaryEntry="not accessible to direct observation"/>
<rdf:Description rdf:about="&a;301686285">
	<b:glossaryEntry>being complete of its kind and without defect or blemish; "a perfect circle"; "a perfect reproduction"; "perfect happiness"; "perfect manners"; "a perfect specimen"; "a perfect day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301686880"
	 b:glossaryEntry='without difficulties or problems; "a clean test flight"'/>
<rdf:Description rdf:about="&a;301686987">
	<b:glossaryEntry>free from flaw or blemish or impurity; "a clear perfect diamond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301687103">
	<b:glossaryEntry>marked by errorless familiarity; "had her lines cold before rehearsals started"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301687233">
	<b:glossaryEntry>perfect and complete in every respect; having all necessary qualities; "a complete gentleman"; "consummate happiness"; "a consummate performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301687446"
	 b:glossaryEntry='understood perfectly; "had his algebra problems down"'/>
<rdf:Description rdf:about="&a;301687575"
	 b:glossaryEntry='free from error; "an errorless baseball game"'/>
<rdf:Description rdf:about="&a;301687676">
	<b:glossaryEntry>without fault or error; "faultless logic"; "speaks impeccable French"; "timing and technique were immaculate"; "an immaculate record"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301687891"
	 b:glossaryEntry='without a flaw; "a flawless gemstone"'/>
<rdf:Description rdf:about="&a;301687994">
	<b:glossaryEntry>conforming to an ultimate standard of perfection or excellence; embodying an ideal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301688128"
	 b:glossaryEntry="exalted to an ideal perfection or excellence"/>
<rdf:Description rdf:about="&a;301688228">
	<b:glossaryEntry>excellent and delightful in all respects; "an idyllic spot for a picnic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301688354"
	 b:glossaryEntry='as if new; "in mint condition"'/>
<rdf:Description rdf:about="&a;301688438"
	 b:glossaryEntry="capable of becoming or being made perfect"/>
<rdf:Description rdf:about="&a;301688537"
	 b:glossaryEntry='more than perfect; "he spoke with pluperfect precision"'/>
<rdf:Description rdf:about="&a;301688649">
	<b:glossaryEntry>(of language) not having its purity or excellence debased; "uncorrupted English"; "learn to speak pure English undefiled"- Van Wyck Brooks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301688857">
	<b:glossaryEntry>not perfect; defective or inadequate; "had only an imperfect understanding of his responsibilities"; "imperfect mortals"; "drainage here is imperfect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301689189"
	 b:glossaryEntry='having a blemish or flaw; "a flawed diamond"'/>
<rdf:Description rdf:about="&a;301689298"
	 b:glossaryEntry='imperfectly spoken or written; "broken English"'/>
<rdf:Description rdf:about="&a;301689398">
	<b:glossaryEntry>containing errors or alterations; "a corrupt text"; "spoke a corrupted version of the language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301689559">
	<b:glossaryEntry>having a defect; "I returned the appliance because it was defective"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301689692">
	<b:glossaryEntry>liable to perish; subject destruction or death or decay; "this minute and perishable planet"; perishable foods such as butter and fruit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301689939">
	<b:glossaryEntry>capable of being decomposed by e.g. bacteria; "a biodegradable detergent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301690072"
	 b:glossaryEntry="liable to decay or spoil or become putrid"/>
<rdf:Description rdf:about="&a;301690209"
	 b:glossaryEntry="not perishable"/>
<rdf:Description rdf:about="&a;301690318">
	<b:glossaryEntry>very long lasting; "less durable rocks were gradually worn away to form valleys"; "the perdurable granite of the ancient Appalachian spine of the continent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301690574"
	 b:glossaryEntry="not subject to decay"/>
<rdf:Description rdf:about="&a;301690654">
	<b:glossaryEntry>continuing or enduring without marked change in status or condition or place; "permanent secretary to the president"; "permanent address"; "literature of permanent value"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301691034"
	 b:glossaryEntry='unceasing; "an abiding belief"; "imperishable truths"'/>
<rdf:Description rdf:about="&a;301691167">
	<b:glossaryEntry xml:space='preserve'><![CDATA[continuing forever or indefinitely; "the ageless themes of love and revenge"; "eternal truths"; "life everlasting"; "hell''s perpetual fires"; "the unending bliss of heaven"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301691452"
	 b:glossaryEntry="used of decisions and contracts"/>
<rdf:Description rdf:about="&a;301691542">
	<b:glossaryEntry>not created for a particular occasion; "a standing committee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301691661">
	<b:glossaryEntry>not permanent; not lasting; "politics is an impermanent factor of life"- James Thurber; "impermanent palm cottages"; "a temperary arrangement"; "temporary housing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301692146">
	<b:glossaryEntry>serving temporarily especially as a substitute; "the acting president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301692272">
	<b:glossaryEntry xml:space='preserve'><![CDATA[enduring a very short time; "the ephemeral joys of childhood"; "a passing fancy"; "youth''s transient beauty"; "love is transitory but at is eternal"; "fugacious blossoms"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301692559">
	<b:glossaryEntry>limited in duration to a single episode; "an account concerned primarily with episodic events such as the succession of rulers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301692741"
	 b:glossaryEntry='tending to vanish like vapor; "evanescent beauty"'/>
<rdf:Description rdf:about="&a;301692847">
	<b:glossaryEntry>of an impermanent nature; "the symphony is no fly-by-night venture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301692973">
	<b:glossaryEntry>done or made using whatever is available; "crossed the river on improvised bridges"; "the survivors used jury-rigged fishing gear"; "the rock served as a makeshift hammer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301693227">
	<b:glossaryEntry>serving during an intermediate interval of time; "an interim agreement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301693352">
	<b:glossaryEntry>for the time being; "he is the president pro tem"; "designated him to act as consul protempore"- H.H.Fiske</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301693526">
	<b:glossaryEntry>not eternal; "temporal matters of but fleeting moment"- F.D.Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301693650">
	<b:glossaryEntry>possible to terminate or terminating after a designated time; "terminable employees"; "a terminable annuity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301693815">
	<b:glossaryEntry>staying temporarily; "a visiting foreigner"; "guest conductor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301693943">
	<b:glossaryEntry>adopted as a temporary basis for further work; "a working draft"; "a working hypothesis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301694088">
	<b:glossaryEntry>(biology) retained; not shed; "persistent leaves remain attached past maturity"; "the persistent gills of fishes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301694268">
	<b:glossaryEntry>(biology) shed at an early stage of development; "most amphibians have caducous gills"; "the caducous calyx of a poppy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301694449">
	<b:glossaryEntry>capable of reversing or being reversed; "reversible hypertension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301694607">
	<b:glossaryEntry>capable of being returned to the original condition; not necessarily permanent; "a correctable image"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301694766"
	 b:glossaryEntry='capable of being recharged; "a rechargeable battery"'/>
<rdf:Description rdf:about="&a;301694877">
	<b:glossaryEntry>impossible to reverse or be reversed; "irreversible momentum toward revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301695033">
	<b:glossaryEntry>not capable of being reversed or returned to the original condition; "permanent brain damage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301695182">
	<b:glossaryEntry>capable of being reversed or used with either side out; "a reversible jacket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301695346">
	<b:glossaryEntry>(of fabrics) having faces on both sides; "damask is a double-faced fabric"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301695479"
	 b:glossaryEntry="not reversible or capable of having either side out"/>
<rdf:Description rdf:about="&a;301695602"
	 b:glossaryEntry='capable of being revoked or annulled; "a revocable order"'/>
<rdf:Description rdf:about="&a;301695763">
	<b:glossaryEntry>capable of being rescinded or voided; "the judgment was rescindable"; "voidable contracts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301695923">
	<b:glossaryEntry>capable of being reversed; "a reversible decision is one that can be appealed or vacated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301696069">
	<b:glossaryEntry>impossible to retract or revoke; "firm and irrevocable is my doom"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301696256"
	 b:glossaryEntry='impossible to reverse or undo; "an irreversible decree"'/>
<rdf:Description rdf:about="&a;301696370"
	 b:glossaryEntry='determined irrevocably; "his fate is sealed"'/>
<rdf:Description rdf:about="&a;301696467">
	<b:glossaryEntry>that may be permitted especially as according to rule; "permissible behavior in school"; "a permissible tax deduction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301696697">
	<b:glossaryEntry>possible to allow; "a degree of freedom allowable among friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301696829"
	 b:glossaryEntry='capable of being tolerated; "sufferable difficulties"'/>
<rdf:Description rdf:about="&a;301696951"
	 b:glossaryEntry='not permitted; "impermissible behavior"'/>
<rdf:Description rdf:about="&a;301697122">
	<b:glossaryEntry>excluded from use or mention; "forbidden fruit"; "in our house dancing and playing cards were out"; "a taboo subject"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301697345">
	<b:glossaryEntry>unsuitable or forbidden as a topic of conversation; "unmentionable words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301697478">
	<b:glossaryEntry>forbidden to the touch; "in most museums such articles are untouchable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301697607"
	 b:glossaryEntry='deserving to be admitted; "admissible evidence"'/>
<rdf:Description rdf:about="&a;301697783"
	 b:glossaryEntry="deserving to be allowed to enter"/>
<rdf:Description rdf:about="&a;301697885"
	 b:glossaryEntry="deserving to be allowed or considered"/>
<rdf:Description rdf:about="&a;301697978">
	<b:glossaryEntry>that may be accepted or conceded; "a kind of speculation that was permissible in cosmology but inadmissible in medicine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301698156"
	 b:glossaryEntry='not deserving to be admitted; inadmissible evidence"'/>
<rdf:Description rdf:about="&a;301698303"
	 b:glossaryEntry="not allowable"/>
<rdf:Description rdf:about="&a;301698376">
	<b:glossaryEntry>granting or inclined or able to grant permission; not strict in discipline; "direct primary legislation is largely permissive rather than prescriptive"; "permissive parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301698642">
	<b:glossaryEntry>tolerant or lenient; "indulgent parents risk spoiling their children"; "procedures are lax and discipline is weak"; "too soft on the children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301698863"
	 b:glossaryEntry="not inclined to grant permission; severe in discipline"/>
<rdf:Description rdf:about="&a;301699030"
	 b:glossaryEntry="likened to a dictator in severity"/>
<rdf:Description rdf:about="&a;301699137"
	 b:glossaryEntry='not indulgent; "strict parents"'/>
<rdf:Description rdf:about="&a;301699236"
	 b:glossaryEntry="not preventive"/>
<rdf:Description rdf:about="&a;301699343"
	 b:glossaryEntry="leaving room for"/>
<rdf:Description rdf:about="&a;301699457"
	 b:glossaryEntry='admitting of bail; "a bailable offense"'/>
<rdf:Description rdf:about="&a;301699551"
	 b:glossaryEntry="tending to prevent or hinder"/>
<rdf:Description rdf:about="&a;301699813">
	<b:glossaryEntry>blocking entrance to and exit from seaports and harbors; "the blockading ships prevented delivery of munitions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301699981">
	<b:glossaryEntry>preventing movement; "the clogging crowds of revelers overflowing into the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301700155"
	 b:glossaryEntry='tending to deter; "the deterrent effects of high prices"'/>
<rdf:Description rdf:about="&a;301700267"
	 b:glossaryEntry="preventing realization or attainment of a desire"/>
<rdf:Description rdf:about="&a;301700399">
	<b:glossaryEntry>taken in advance to protect against possible danger or failure; "gave precautionary advice"; "I would take precautionary steps to keep him away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301700618"
	 b:glossaryEntry="made impossible"/>
<rdf:Description rdf:about="&a;301700705">
	<b:glossaryEntry>designed or having the power to deter or prevent an anticipated situation or occurrence; "a preemptive business offer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301700879">
	<b:glossaryEntry>tending to discourage (especially of prices); "the price was prohibitive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301701024">
	<b:glossaryEntry>full or difficulty or confusion or bewilderment; "perplexed language"; "perplexed state of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301701289">
	<b:glossaryEntry>filled with bewilderment; "at a loss to understand those remarks"; "puzzled that she left without saying goodbye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301701496">
	<b:glossaryEntry>perplexed by many conflicting situations or statements; filled with bewilderment; "obviously bemused by his questions"; "bewildered and confused"; "a cloudy and confounded philosopher"; "just a mixed-up kid"; "she felt lost on the first day of school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301701895">
	<b:glossaryEntry>totally perplexed and mixed up; "all this duncical nonsense has my brains metagrobolized"- Wall Street Journal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301702095">
	<b:glossaryEntry>perplexed (as if being expected to know something that you do not know); "he had a quizzical expression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301702269"
	 b:glossaryEntry='(informal) baffled; "this problem has me completely stuck"'/>
<rdf:Description rdf:about="&a;301702379"
	 b:glossaryEntry="experiencing no difficulty or confusion or bewilderment"/>
<rdf:Description rdf:about="&a;301702510"
	 b:glossaryEntry="not perplexed by conflicting situations or statements"/>
<rdf:Description rdf:about="&a;301702632">
	<b:glossaryEntry>concerning or affecting a particular person or his or her private life and personality; "a personal favor"; "for your personal use"; "personal papers"; "I have something personal to tell you"; "a personal God"; "he has his personal bank account and she has hers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301703147">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in each other''s presence; "a face-to-face encounter"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301703258">
	<b:glossaryEntry>concerning one person exclusively; "we all have individual cars"; "each room has a private bath"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301703424">
	<b:glossaryEntry>made for or directed or adjusted to a particular individual; "personalized luggage"; "personalized advice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301703606">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an appearance carried out personally in someone else''s physical presence; "he carried out the negotiations in person"; "a personal appearance is an appearance by a person in the flesh"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301703882">
	<b:glossaryEntry>indicating knowledge of personal details that only a close confidant could have; "an intimate biography"; "intimate details of their relationship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301704083">
	<b:glossaryEntry xml:space='preserve'><![CDATA[belonging completely to yourself; "a room of one''s own"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301704265">
	<b:glossaryEntry xml:space='preserve'><![CDATA[belonging to or on behalf of a specified person (especially yourself); preceded by a possessive; "for your personal use"; "do one''s own thing"; "she makes her own clothes"; "`ain'' is Scottish"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301704516">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pointedly referring to or concerning a person''s individual personality or intimate affairs especially offensively; "unnecessarily personalized remarks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301704726">
	<b:glossaryEntry>involving direct communication or contact between persons or parties; "a person-to-person interview"; "person-to-person telephone calls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301704925">
	<b:glossaryEntry>concerning things deeply private and personal; "private correspondence"; "private family matters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301705076">
	<b:glossaryEntry>not relating to or responsive to individual persons; "an impersonal corporation"; "an impersonal remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301705255"
	 b:glossaryEntry='lacking personality; "nonpersonal forces"'/>
<rdf:Description rdf:about="&a;301705354">
	<b:glossaryEntry>tending or intended or having the power to induce action or belief; "persuasive eloquence"; "a most persuasive speaker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301705602">
	<b:glossaryEntry>pleasingly persuasive or intended to persuade; "a coaxing and obsequious voice"; "her manner is quiet and ingratiatory and a little too agreeable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301705817">
	<b:glossaryEntry>tending to persuade by forcefulness of argument; "new and compelling evidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301705952">
	<b:glossaryEntry>artfully persuasive in speech; "a glib tongue"; "a smooth-tongued hypocrite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301706111">
	<b:glossaryEntry>deterring from action; "dissuasive advice"; "made a slight dissuasive gesture with her hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301706314">
	<b:glossaryEntry>serving to warn; "shook a monitory finger at him"; "an exemplary jail sentence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301706499"
	 b:glossaryEntry="expressing disapproval"/>
<rdf:Description rdf:about="&a;301706580">
	<b:glossaryEntry>admitting of penetration or passage into or through; "a penetrable wall"; "penetrable defenses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301706732">
	<b:glossaryEntry>not admitting of penetration or passage into or through; "an impenetrable fortress"; "impenetrable rain forests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301706921">
	<b:glossaryEntry>hard to pass through because of dense growth; "dense vegetation"; "thick woods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301707060">
	<b:glossaryEntry>allowing (especially liquids) to pass or diffuse through; "permeable membranes"; "rock that is permeable by water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301707320">
	<b:glossaryEntry>able to absorb fluids; "the partly porous walls of our digestive system"; "compacting the soil to make it less porous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301707491">
	<b:glossaryEntry>permitting liquids to penetrate; "a tarpaulin too leaky to be of much use"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301707617"
	 b:glossaryEntry="(of a membrane) selectively permeable"/>
<rdf:Description rdf:about="&a;301707714">
	<b:glossaryEntry>preventing especially liquids to pass or diffuse through; "impermeable stone"; an impermeable layer of scum"; "a coat impermeable to rain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301707982"
	 b:glossaryEntry='made of rubber and therefore water-repellent; "rubber boots"'/>
<rdf:Description rdf:about="&a;301708108"
	 b:glossaryEntry='hindering the penetration of water; "a water-repellent coat"'/>
<rdf:Description rdf:about="&a;301708248">
	<b:glossaryEntry>admitting of passage or entrance; "pervious soil"; "a metal pervious to heat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301708416">
	<b:glossaryEntry>open to arguments, ideas, or change; "receptive to reason and the logic of facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301708553">
	<b:glossaryEntry>not admitting of passage or capable of being affected; "a material impervious to water"; "steel impervious to bullets"; "someone impervious to argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301708902">
	<b:glossaryEntry>resistant to penetration by grease or oil or wax; "greaseproof wrapping paper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301709038"
	 b:glossaryEntry="resistant to damage by moths"/>
<rdf:Description rdf:about="&a;301709139">
	<b:glossaryEntry>(used in combination or as a suffix) able to withstand; "temptation-proof"; "childproof locks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301709288"
	 b:glossaryEntry='incapable of being affected; "resistant to persuasion"'/>
<rdf:Description rdf:about="&a;301709398"
	 b:glossaryEntry="(of hosiery) resistant to runs or (in Britain) ladders"/>
<rdf:Description rdf:about="&a;301709538">
	<b:glossaryEntry>impervious to, or not penetrable by, sound; "a soundproof room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301709658"
	 b:glossaryEntry="of flowers; having petals"/>
<rdf:Description rdf:about="&a;301709795">
	<b:glossaryEntry>having a corolla composed of partially or wholly fused petals forming a tubular or or funnel-shaped corolla</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301709961">
	<b:glossaryEntry>having a corolla composed of many separated or distinct petals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301710082"
	 b:glossaryEntry="of flowers; having no petals"/>
<rdf:Description rdf:about="&a;301710178"
	 b:glossaryEntry="capable of being punctured"/>
<rdf:Description rdf:about="&a;301710262"
	 b:glossaryEntry="being without punctures or incapable of being punctured"/>
<rdf:Description rdf:about="&a;301710394">
	<b:glossaryEntry>capable of sealing itself as after being pierced; "self-sealing tires"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301710523">
	<b:glossaryEntry>involving the body as distinguished from the mind or spirit; "physical exercise"; "physical suffering"; "was sloppy about everything but her physical appearance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301710829">
	<b:glossaryEntry>of the appetites and passions of the body; "animal instincts"; "carnal knowledge"; "fleshly desire"; "a sensual delight in eating"; "music is the only sensual pleasure without vice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301711095">
	<b:glossaryEntry>affecting or characteristic of the body as opposed to the mind or spirit; "bodily needs"; "a corporal defect"; "corporeal suffering"; "a somatic symptom or somatic illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301711353">
	<b:glossaryEntry>concerned with or affecting physical as distinct from intellectual or psychological well-being; "material needs"; "the moral and material welfare of all good citizens"- T.Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301711588">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intimately concerning a person''s body or physical being; "personal hygiene"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301711718">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of or consistent with an organism''s normal functioning; "physiological functions"; "physiological processes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301711900">
	<b:glossaryEntry>involving the mind or an intellectual process; "mental images of happy times"; "mental calculations"; "in a terrible mental state"; "mental suffering"; "free from mental defects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301712221">
	<b:glossaryEntry>associated with or requiring the use of the mind; "intellectual problems"; "the triumph of the rational over the animal side of man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301712423">
	<b:glossaryEntry>psychological rather than physical or tangible in effect; "a moral victory"; "moral support"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301712567">
	<b:glossaryEntry>affecting or influenced by the human mind; "psychic energy"; "psychic trauma"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301712710">
	<b:glossaryEntry>mental or emotional rather than physiological in origin; "a psychogenic disorder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301712849">
	<b:glossaryEntry>mental or emotional as opposed to physical in nature; "give psychological support"; "psychological warfare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301713016"
	 b:glossaryEntry="believing that there is only one god"/>
<rdf:Description rdf:about="&a;301713111"
	 b:glossaryEntry="worshipping or believing in more than one god"/>
<rdf:Description rdf:about="&a;301713215">
	<b:glossaryEntry>having or showing or expressing reverence for a deity; "pious readings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301713500"
	 b:glossaryEntry='relating to worship; "a devotional exercise"'/>
<rdf:Description rdf:about="&a;301713601">
	<b:glossaryEntry>showing great reverence for god; "a godly man"; "leading a godly life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301713747">
	<b:glossaryEntry>excessively or hypocritically pious; "a sickening sanctimonious smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301713965"
	 b:glossaryEntry="disposed to pray or appearing to pray"/>
<rdf:Description rdf:about="&a;301714058"
	 b:glossaryEntry="lacking piety or reverence for a god"/>
<rdf:Description rdf:about="&a;301714238"
	 b:glossaryEntry="not revering god"/>
<rdf:Description rdf:about="&a;301714321">
	<b:glossaryEntry>having or showing belief in and reverence for a deity; "a religious man"; "religious attitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301714561"
	 b:glossaryEntry="actively practicing a religion"/>
<rdf:Description rdf:about="&a;301714649">
	<b:glossaryEntry>resembling or suggesting or appropriate to a church; "churchlike silence"; "the pure fragrance of churchly incense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301714832">
	<b:glossaryEntry>devoutly religious; "a god-fearing and law-abiding people" H.L.Mencken</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301714977">
	<b:glossaryEntry>involving persons of different religious faiths; "an interfaith marriage"; "interfaith good will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301715131"
	 b:glossaryEntry="hostile or indifferent to religion"/>
<rdf:Description rdf:about="&a;301715331"
	 b:glossaryEntry="rejecting any belief in gods"/>
<rdf:Description rdf:about="&a;301715443">
	<b:glossaryEntry>not acknowledging the God of Christianity and Judaism and Islam</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301715581"
	 b:glossaryEntry="lacking piety and reverence for a god"/>
<rdf:Description rdf:about="&a;301715682"
	 b:glossaryEntry='no longer active or practicing; "a lapsed Catholic"'/>
<rdf:Description rdf:about="&a;301715803"
	 b:glossaryEntry="failing or refusing to observe religious customs"/>
<rdf:Description rdf:about="&a;301715910"
	 b:glossaryEntry="easily calmed or pacified"/>
<rdf:Description rdf:about="&a;301716026"
	 b:glossaryEntry="can be pacified or satisfied"/>
<rdf:Description rdf:about="&a;301716125"
	 b:glossaryEntry="can be alleviated"/>
<rdf:Description rdf:about="&a;301716198"
	 b:glossaryEntry='impossible to placate; "an implacable enemy"'/>
<rdf:Description rdf:about="&a;301716353">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not to be placated or appeased or moved by entreaty;"grim determination"; "grim necessity"; "Russia''s final hour, it seemed, approached with inexorable certainty"; "relentless persecution"; "the stern demands of parenthood]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301716703">
	<b:glossaryEntry>incapable of being mitigated; "stern and unmitigable accusations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301716826"
	 b:glossaryEntry="lacking patterns especially in color"/>
<rdf:Description rdf:about="&a;301716946"
	 b:glossaryEntry='entirely of a single color throughout; "a solid fabric"'/>
<rdf:Description rdf:about="&a;301717084"
	 b:glossaryEntry="having patterns especially colorful patterns"/>
<rdf:Description rdf:about="&a;301717562">
	<b:glossaryEntry>marked with bands or strips of contrasting color or texture; "a banded rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301717691"
	 b:glossaryEntry="marked with irregularly shaped spots or blots"/>
<rdf:Description rdf:about="&a;301717813">
	<b:glossaryEntry>having a gray or brown streak or a pattern or a patchy coloring; used especially of the patterned fur of cats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301718005"
	 b:glossaryEntry="(of wood) have a pattern from the grain of a tree burl"/>
<rdf:Description rdf:about="&a;301718112"
	 b:glossaryEntry="patterned with alternating squares of color"/>
<rdf:Description rdf:about="&a;301718233"
	 b:glossaryEntry="having spots or patches of color"/>
<rdf:Description rdf:about="&a;301718329"
	 b:glossaryEntry="having a pattern of dots"/>
<rdf:Description rdf:about="&a;301718448">
	<b:glossaryEntry>of e.g. fabric design; "my dress is richly figured"- Amy Lowell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301718565">
	<b:glossaryEntry>resembling or made of or suggestive of flowers; "an unusual floral design"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301718703">
	<b:glossaryEntry>edged or streaked with color; "white blossoms with purple-laced petals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301718826">
	<b:glossaryEntry>patterned with veins or streaks or color resembling marble; "marbleized pink skin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301718975"
	 b:glossaryEntry="of silk fabric; having a wavelike pattern"/>
<rdf:Description rdf:about="&a;301719078">
	<b:glossaryEntry>having spots or patches (small areas of contrasting color or texture); "a field patched with ice and snow"; "a black-and-white spotted cow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301719281"
	 b:glossaryEntry="having very thin stripes"/>
<rdf:Description rdf:about="&a;301719377">
	<b:glossaryEntry>patterned by having color applied with sweeping strokes; "brown iris...slashed with yellow"- Willa Cather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301719536"
	 b:glossaryEntry='decorated with designs of sprigs; "sprigged muslin"'/>
<rdf:Description rdf:about="&a;301719642">
	<b:glossaryEntry>marked with or as if with stripes or linear discolorations; "streaked hair"; "fat legs and dirty streaky faces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301719818"
	 b:glossaryEntry="marked or decorated with stripes"/>
<rdf:Description rdf:about="&a;301719913"
	 b:glossaryEntry="having a checkered or mottled appearance"/>
<rdf:Description rdf:about="&a;301720011"
	 b:glossaryEntry="having or showing markings that resemble veins"/>
<rdf:Description rdf:about="&a;301720130">
	<b:glossaryEntry>not elaborate or elaborated; simple; "plain food"; "stuck to the plain facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301720529"
	 b:glossaryEntry='severely simple; "a stark interior"'/>
<rdf:Description rdf:about="&a;301720635">
	<b:glossaryEntry>apart from anything else; without additions or modifications; "the bare facts"; "shocked by the mere idea"; "the simple passage of time was enough"; "the simple truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301720878">
	<b:glossaryEntry>pure and simple in design or style; "a chaste border of conventionalized flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301721012">
	<b:glossaryEntry>(of food) eaten without a spread or sauce or other garnish; "dry toast"; "dry meat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301721145">
	<b:glossaryEntry>having no adornment or coloration; "dry facts"; "rattled off the facts in a dry mechanical manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301721293">
	<b:glossaryEntry>lacking distinguishing characteristics or features; "the featureless landscape of the steppe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301721444">
	<b:glossaryEntry>unpretentious; "homely truths"; "letters to his son full of homely advice"; "simple (or homely) fare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301721607"
	 b:glossaryEntry="not elaborate; lacking rich or complex detail"/>
<rdf:Description rdf:about="&a;301721724">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of the clearest kind; usually used for emphasis; "it''s the literal truth"; "a matter of investment, pure and simple"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301721912">
	<b:glossaryEntry>not elaborate in style; unornamented; "her black dress--simple to austerity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301722041">
	<b:glossaryEntry>severely simple in line or design; "a neat tailored suit"; "tailored curtains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301722181">
	<b:glossaryEntry>not plain; decorative or ornamented; "fancy handwriting"; "fancy clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301722648">
	<b:glossaryEntry xml:space='preserve'><![CDATA[elaborately or excessively ornamented; "flamboyant handwriting"; "the senator''s florid speech"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301722826">
	<b:glossaryEntry>having elaborate symmetrical ornamentation; "the building...frantically baroque"-William Dean Howells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301723016">
	<b:glossaryEntry>overcrowded or cluttered with detail; "a busy painting"; "a fussy design"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301723148">
	<b:glossaryEntry>(of a building) having turrets and battlements in the style of a castle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301723329"
	 b:glossaryEntry="(informal) in fancy clothing"/>
<rdf:Description rdf:about="&a;301723410">
	<b:glossaryEntry>having the surface decorated with a network of fine cracks, as in crackleware; "a crackle glaze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301723560">
	<b:glossaryEntry>(of metals) decorated or inlaid with a wavy pattern of different (especially precious) metals; "a damascened sword"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301723744"
	 b:glossaryEntry='having a woven pattern; "damask table linens"'/>
<rdf:Description rdf:about="&a;301723842">
	<b:glossaryEntry>marked by complexity and richness of detail; "an elaborate lace pattern"; "intricate needlework"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301724018">
	<b:glossaryEntry>having repeated square indentations like those in a battlement; "a crenelated molding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301724223">
	<b:glossaryEntry>having a curiously intricate quality; "a fanciful pattern with intertwined vines and flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301724371">
	<b:glossaryEntry>having decorative or flavorful additions; sometimes used in combination; "a whole salmon garnished with lemon slices"; "parsley-garnished potatoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301724574"
	 b:glossaryEntry='made of or resembling lace; "a lacy gown"; "a lacy leaf"'/>
<rdf:Description rdf:about="&a;301724692"
	 b:glossaryEntry='gathered for protruding fullness; "puff sleeves"'/>
<rdf:Description rdf:about="&a;301724800">
	<b:glossaryEntry>highly seasoned or containing large amounts of choice ingredients such as butter or sugar or eggs; "kept gorging on rich foods"; "rich pastries"; "rich eggnogg"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301725011">
	<b:glossaryEntry>having excessive asymmetrical ornamentation; "an exquisite gilded rococo mirror"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301725144">
	<b:glossaryEntry>decorated with wormlike tracery or markings; "vermicular (or vermiculated) stonework"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301725315">
	<b:glossaryEntry>designed or carried out according to a plan; "the planned outlays for new equipment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301725615"
	 b:glossaryEntry="formed in the mind"/>
<rdf:Description rdf:about="&a;301725698">
	<b:glossaryEntry>showing effects of planning or manipulation; "a novel with a contrived ending"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301725832"
	 b:glossaryEntry='secretly and carefully planned; "deep-laid plans"'/>
<rdf:Description rdf:about="&a;301725937">
	<b:glossaryEntry>planned or created in an artistic or skilled manner; "a beautifully designed dress"; "some Italian designed sandals have cushioning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301726124"
	 b:glossaryEntry='planned beforehand; "a prearranged signal"'/>
<rdf:Description rdf:about="&a;301726224">
	<b:glossaryEntry>set in advance; "a preset plan of action"; "at a predetermined time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301726361">
	<b:glossaryEntry>planned for the future; "the first volume of a proposed series"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301726491">
	<b:glossaryEntry>without apparent forethought or prompting or planning; "an unplanned economy"; "accepts an unplanned order"; "an unplanned pregnancy"; "unplanned remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301726809">
	<b:glossaryEntry>occurring or appearing or singled out by chance; "their accidental meeting led to a renewal of their friendship"; "seek help from casual passers-by"; "a casual meeting"; "a chance occurrence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301727078"
	 b:glossaryEntry='often improvised or impromptu; "an ad hoc committee meeting"'/>
<rdf:Description rdf:about="&a;301727191">
	<b:glossaryEntry>without or seeming to be without plan or method; offhand; "a casual remark"; "information collected by casual methods and in their spare time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301727386"
	 b:glossaryEntry='not planned; "an unexpected pregnancy"'/>
<rdf:Description rdf:about="&a;301727481">
	<b:glossaryEntry>not prepared or planned in advance; "asked an unpremeditated question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301727612">
	<b:glossaryEntry>produced or marked by conscious design or premeditation; "a studied smile"; "a note of biting irony and studied insult"- V.L.Parrington</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301727832">
	<b:glossaryEntry>not by design or artifice; unforced and impromptu; "an air of unstudied spontaneous utterance is apt to be painstakingly achieved"; "simple unstudied charm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301728104">
	<b:glossaryEntry>informal or natural; especially caught off guard or unprepared; "a candid photograph"; "a candid interview"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301728264"
	 b:glossaryEntry="apparently reasonable and valid"/>
<rdf:Description rdf:about="&a;301728405"
	 b:glossaryEntry="capable of being supported by argument"/>
<rdf:Description rdf:about="&a;301728498">
	<b:glossaryEntry>having only superficial plausibility; "glib promises"; "a slick commercial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301728638">
	<b:glossaryEntry>having a quality that provokes disbelief; "gave the teacher an implausible excuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301728814"
	 b:glossaryEntry="having a probability to low to inspire belief"/>
<rdf:Description rdf:about="&a;301728957">
	<b:glossaryEntry>affording pleasure; being in harmony with your taste or likings; "a pleasant person to be around"; "we had a pleasant evening together"; "a pleasant scene"; "pleasant sensations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301729352">
	<b:glossaryEntry>(of weather) highly enjoyable; very pleasant; "a beautiful evening"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301729482">
	<b:glossaryEntry>extremely pleasant in a gentle way; "the most dulcet swimming on the most beautiful and remote beaches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301729638">
	<b:glossaryEntry>affording satisfaction or pleasure; "the company was enjoyable"; "found her praise gratifying"; "full of happiness and pleasurable excitement"; "good printing makes a book more pleasurable to read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301729918">
	<b:glossaryEntry>affording comfort or pleasure; "the grateful warmth of the fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301730037">
	<b:glossaryEntry xml:space='preserve'><![CDATA[suggestive of an idyll; charmingly simple and serene; "his idyllic life in Tahiti"; "the pastoral legends of America''s Golden Age"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301730232">
	<b:glossaryEntry>not pleasant; "an unpleasant personality"; "unpleasant repercussions"; "unpleasant odors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301730738">
	<b:glossaryEntry>harsh or corrosive in tone; "an acerbic tone piercing otherwise flowery prose"; "a barrage of acid comments"; "her acrid remarks make her many enemies"; "bitter words"; "blistering criticism"; "caustic jokes about political assassination, talk-show hosts and medical ethics"; "a sulfurous denunciation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301731208"
	 b:glossaryEntry='very unpleasant; "hellish (or beastly) weather"'/>
<rdf:Description rdf:about="&a;301731319">
	<b:glossaryEntry>harshly uninviting or formidable in manner or appearance; "a dour, self-sacrificing life"; "a forbidding scowl"; "a grim man loving duty more than humanity"; "undoubtedly the grimmest part of him was his iron claw"- J.M.Barrie</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301731616"
	 b:glossaryEntry="very unpleasant"/>
<rdf:Description rdf:about="&a;301731686">
	<b:glossaryEntry>causing to feel shame or chagrin or vexation; "the embarrassing moment when she found her petticoat down around her ankles"; "it was mortifying to know he had heard every word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301731934">
	<b:glossaryEntry>unpleasantly stern; "wild and harsh country full of hot sand and cactus"; "the nomad life is rough and hazardous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301732107">
	<b:glossaryEntry>disagreeable to the senses; "the harsh cry of a blue jay"; "harsh cognac"; "the harsh white light makes you screw up your eyes"; "harsh irritating smoke filled the hallway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301732331">
	<b:glossaryEntry>very unpleasant or even dangerous; "make it hot for him"; "in the hot seat"; "in hot water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301732472">
	<b:glossaryEntry>causing misery or pain or distress; "it was a sore trial to him"; "the painful process of growing up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301732647">
	<b:glossaryEntry>serving or tending to repel; "he became rebarbative and prickly and spiteful"; "I find his obsequiousness repellent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301732845">
	<b:glossaryEntry>harsh; "sharp criticism"; "a sharp-worded exchange"; "a tart remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301732987">
	<b:glossaryEntry>disagreeable; "I will not perform the ungrateful task of comparing cases of failure"- Abraham Lincoln</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301733145"
	 b:glossaryEntry='causing discomfort; "the unhappy truth"'/>
<rdf:Description rdf:about="&a;301733238">
	<b:glossaryEntry>used of circumstances; "an unlovely ride to work on a crowded train"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301733361"
	 b:glossaryEntry="experiencing or manifesting pleasure"/>
<rdf:Description rdf:about="&a;301733541"
	 b:glossaryEntry='pleasantly occupied; "We are not amused" -Queen Victoria'/>
<rdf:Description rdf:about="&a;301733675"
	 b:glossaryEntry='inspired with confidence; "felt bucked up by his success"'/>
<rdf:Description rdf:about="&a;301733804"
	 b:glossaryEntry="greatly pleased"/>
<rdf:Description rdf:about="&a;301733875"
	 b:glossaryEntry="having received what was desired"/>
<rdf:Description rdf:about="&a;301733963"
	 b:glossaryEntry="not pleased; experiencing or manifesting displeasure"/>
<rdf:Description rdf:about="&a;301734180">
	<b:glossaryEntry>aroused to impatience or anger; "made an irritated gesture"; "feeling nettled from the constant teasing"; "peeved about being left out"; "felt really pissed at her snootiness"; "riled no end by his lies"; "roiled by the delay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301734525">
	<b:glossaryEntry>greatly annoyed; out of patience; "had an exasperated look on his face"; "felt exasperated beyond endurance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301734691">
	<b:glossaryEntry>having a strong distaste from surfeit; "grew more and more disgusted"; "fed up with their complaints"; "sick of it all"; "sick to death of flattery"; "gossip that makes one sick"; "tired of the noise and smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301735006"
	 b:glossaryEntry="showing displeasure or anger"/>
<rdf:Description rdf:about="&a;301735089">
	<b:glossaryEntry>hurt or upset; "she looked offended"; "face had a pained and puzzled expression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301735233">
	<b:glossaryEntry>giving pleasure and satisfaction; "a pleasing piece of news"; "pleasing in manner and appearance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301735655">
	<b:glossaryEntry>inspiring admiration or approval; "among her many admirable qualities are generosity and graciousness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301735813">
	<b:glossaryEntry>highly pleasing; "pleasureful relaxation"; "an agreeable prospect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301735949">
	<b:glossaryEntry>pleasing or delighting; "endowed with charming manners"; "a charming little cottage"; "a charming personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301736114">
	<b:glossaryEntry>greatly pleasing or entertaining; "a delightful surprise"; "the comedy was delightful"; "a delicious joke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301736289">
	<b:glossaryEntry>capable of allaying suspicion or hostility and inspiring confidence; "a disarming smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301736433"
	 b:glossaryEntry='affording pleasure; "easy good looks"'/>
<rdf:Description rdf:about="&a;301736521"
	 b:glossaryEntry='extremely pleasing; "a fabulous vacation"'/>
<rdf:Description rdf:about="&a;301736623"
	 b:glossaryEntry='capable of pleasing; "good looks"'/>
<rdf:Description rdf:about="&a;301736707"
	 b:glossaryEntry='pleasing to the mind or feeling; "sweet revenge"'/>
<rdf:Description rdf:about="&a;301736820">
	<b:glossaryEntry>capable of winning favor; "with open arms and an ingratiating smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301736947">
	<b:glossaryEntry>pleasing to the senses; "the sweet song of the lark"; "the sweet face of a child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301737080"
	 b:glossaryEntry="causing displeasure or lacking pleasing qualities"/>
<rdf:Description rdf:about="&a;301737277">
	<b:glossaryEntry>causing an emotional disturbance; "his disconcerting habit of greeting friends ferociously and strangers charmingly"- Herb Caen; "an upsetting experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301737503">
	<b:glossaryEntry xml:space='preserve'><![CDATA[extremely annoying or displeasing; "his cavelier curtness of manner was exasperating"; "I''ve had an exasperating day"; "her infuriating indifference"; "the ceaseless tumult of the jukebox was maddening"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301737799"
	 b:glossaryEntry='causing annoyance or repugnance; "an off-putting remark"'/>
<rdf:Description rdf:about="&a;301737913">
	<b:glossaryEntry>agreeably diverting or amusing; "an entertaining puppet show"; "films should be entertaining"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301738083">
	<b:glossaryEntry>providing enjoyment; pleasantly entertaining; "an amusing speaker"; "a diverting story"; "a fun thing to do"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301738276"
	 b:glossaryEntry='not entertaining; "a quite unentertaining letter"'/>
<rdf:Description rdf:about="&a;301738404"
	 b:glossaryEntry='not amusing; "his jokes were labored and unamusing"'/>
<rdf:Description rdf:about="&a;301738511"
	 b:glossaryEntry="having a point"/>
<rdf:Description rdf:about="&a;301738939"
	 b:glossaryEntry="shaped like a spine or thorn"/>
<rdf:Description rdf:about="&a;301739045"
	 b:glossaryEntry="ending in a sharp point"/>
<rdf:Description rdf:about="&a;301739137"
	 b:glossaryEntry="(of an arrow) tapered toward both ends"/>
<rdf:Description rdf:about="&a;301739242"
	 b:glossaryEntry="tapering at each end"/>
<rdf:Description rdf:about="&a;301739349">
	<b:glossaryEntry>used of pens; having a writing point or nib especially of a certain kind; "a broad-nibbed pen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301739496">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having or rising to a peak; "the peaked ceiling"; "the island''s peaked hills"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301739626"
	 b:glossaryEntry="resembling a pyramid"/>
<rdf:Description rdf:about="&a;301739702"
	 b:glossaryEntry='having the point made sharp; "a sharpened pencil"'/>
<rdf:Description rdf:about="&a;301739807"
	 b:glossaryEntry="having a long sharp point"/>
<rdf:Description rdf:about="&a;301739885">
	<b:glossaryEntry>equipped with long sharp-pointed projections especially along the top of a wall or fence; "the fence was iron and spiked along the top"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301740073"
	 b:glossaryEntry='gradually narrowed toward a point; "a tall tapering spire"'/>
<rdf:Description rdf:about="&a;301740196">
	<b:glossaryEntry>not having a point especially a sharp point; "my pencils are all pointless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301740357">
	<b:glossaryEntry>having a broad or rounded end; "thick marks made by a blunt pencil"; "a blunt instrument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301740498">
	<b:glossaryEntry>having the foot stretched out in line with the leg and the toes forming a point; "keep the legs straight and the toes pointed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301740696">
	<b:glossaryEntry>straining upward on the tips of the toes; "in a tiptoe stance to see over the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301740833">
	<b:glossaryEntry>not pointed; having the foot and toes in normal position; "unpointed toes can cost a gymnast demerits in competition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301741006"
	 b:glossaryEntry="of an angle; less than 90 degrees"/>
<rdf:Description rdf:about="&a;301741091"
	 b:glossaryEntry="of an angle; between 90 and 180 degrees"/>
<rdf:Description rdf:about="&a;301741183">
	<b:glossaryEntry>perfected or made shiny and smooth; "his polished prose"; "in a freshly ironed dress and polished shoes"; "freshly polished silver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301741423">
	<b:glossaryEntry>made smooth and bright by or as if by rubbing; reflecting a sheen or glow; "bright silver candlesticks"; "a burnished brass knocker"; "she brushed her hair until it fell in lustrous auburn waves"; "rows of shining glasses"; "shiny black patents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301741762">
	<b:glossaryEntry>(of skills or the products of skills) brought to or having the greatest excellence; perfected; "a dazzling and finished piece of writing"; "a finished violinist"; "</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301741981">
	<b:glossaryEntry>not carefully reworked or perfected or made smooth by polishing; "dull unpolished shoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301742216"
	 b:glossaryEntry='untempered and unrefined; "raw talent"; "raw beauty"'/>
<rdf:Description rdf:about="&a;301742318"
	 b:glossaryEntry='not perfected; "a rough draft"; "a few rough sketches"'/>
<rdf:Description rdf:about="&a;301742424"
	 b:glossaryEntry="of metals e.g.; not made shiny and smooth by friction"/>
<rdf:Description rdf:about="&a;301742535">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by artful prudence, expedience, and shrewdness; "it is neither polite nor politic to get into other people''s quarrels"; "a politic decision"; "a politic manager"; "a politic old scoundrel"; "a shrewd and politic reply"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301742868">
	<b:glossaryEntry>appropriate to a purpose; practical; "in the circumstances it was expedient to express loyalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301743019">
	<b:glossaryEntry>skillful in statecraft or management; "an astute and sagacious statesman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301743148"
	 b:glossaryEntry='not politic; "an impolitic approach to a sensitive issue"'/>
<rdf:Description rdf:about="&a;301743333"
	 b:glossaryEntry="showing skill in handling difficult situations"/>
<rdf:Description rdf:about="&a;301743449"
	 b:glossaryEntry="not appropriate to the purpose"/>
<rdf:Description rdf:about="&a;301743546">
	<b:glossaryEntry>involving or characteristic of politics or parties or politicians; "calling a meeting is a political act in itself"- Daniel Goleman; "political pressure"; "a political machine"; "political office"; "political policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301743854">
	<b:glossaryEntry>dealing with the affairs or structure of government or politics or the state; "governmental policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301744012"
	 b:glossaryEntry="concerned with policy, not administration"/>
<rdf:Description rdf:about="&a;301744113"
	 b:glossaryEntry="not political"/>
<rdf:Description rdf:about="&a;301744203"
	 b:glossaryEntry="politically neutral"/>
<rdf:Description rdf:about="&a;301744293">
	<b:glossaryEntry>capable of being weighed or considered; "something ponderable from the outer world--something of which we can say that its weight is so and so"- James Jeans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301744524">
	<b:glossaryEntry>capable of being considered carefully; "the assessable qualities of art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301744653">
	<b:glossaryEntry>difficult or impossible to evaluate with precision; "such imponderable human factors as aesthetic sensibility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301744822">
	<b:glossaryEntry>regarded with great favor, approval, or affection especially by the general public; "a popular tourist attraction"; "a popular girl"; "cabbage patch dolls are no longer popular"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301745161"
	 b:glossaryEntry='selling in great numbers; "a best-selling novel"'/>
<rdf:Description rdf:about="&a;301745271"
	 b:glossaryEntry="patronized by"/>
<rdf:Description rdf:about="&a;301745360">
	<b:glossaryEntry>appealing to the general public; "a favorite tourist attraction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301745491">
	<b:glossaryEntry>(informal) very popular or successful; "one of the hot young talents"; "cabbage patch dolls were hot last season"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301745654">
	<b:glossaryEntry>visited by throngs of tourists; "of the three American Virgin islands St. Thomas is the most touristed"; "tourists descend in busloads...so the whole place is rather touristy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301745896">
	<b:glossaryEntry>regarded with disfavor or lacking general approval; "unpopular ideas"; "an unpopular war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301746077">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not visited by many travelers; "the tourist''s desire to visit less-traveled countries"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301746223">
	<b:glossaryEntry>on the left-hand side of a vessel or aircraft when facing forward; "the port side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301746392">
	<b:glossaryEntry>on the right-hand side of a vessel or aircraft when facing forward; "the starboard side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301746562"
	 b:glossaryEntry='in favor of (an action or proposal etc.); "a pro vote"'/>
<rdf:Description rdf:about="&a;301746684">
	<b:glossaryEntry>supporting a policy or attitude etc; "an affirmative argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301746815"
	 b:glossaryEntry="not in favor of (an action or proposal etc.)"/>
<rdf:Description rdf:about="&a;301746928">
	<b:glossaryEntry>in opposition to (a policy or attitude etc.); "an opposing vote"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301747057">
	<b:glossaryEntry>characterized by or displaying affirmation or acceptance or certainty etc.; "a positive attitude"; "the reviews were all positive"; "a positive benefit"; "a positive demand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301747447"
	 b:glossaryEntry='expecting the best; "an affirmative outlook"'/>
<rdf:Description rdf:about="&a;301747562">
	<b:glossaryEntry>emphasizing what is laudable or hopeful or to the good; "constructive criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301747701"
	 b:glossaryEntry='very positive; "an enthusiastic response"'/>
<rdf:Description rdf:about="&a;301747801">
	<b:glossaryEntry>characterized by or displaying negation or denial or opposition or resistance; having no positive features; "a negative outlook on life"; "a colorless negative personality"; "a negative evaluation"; "a negative reaction to an advertising campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301748247"
	 b:glossaryEntry="indicating opposition or resistance"/>
<rdf:Description rdf:about="&a;301748351">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) reverse of or absence of; "`nonhuman'' is a negative term containing `non'' as a prefix"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301748496">
	<b:glossaryEntry>marked by a disposition to oppose and contradict; "took perverse satisfaction in foiling her plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301748650"
	 b:glossaryEntry="of no distinctive quality or characteristics or type"/>
<rdf:Description rdf:about="&a;301748810">
	<b:glossaryEntry>made neutral in some respect; deprived of distinctive characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301748937"
	 b:glossaryEntry="not having or expressing opinions or views"/>
<rdf:Description rdf:about="&a;301749034">
	<b:glossaryEntry>on the positive side or higher end of a scale; "a plus value"; "temperature of plus 5 degrees"; "a grade of C plus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301749236"
	 b:glossaryEntry="(mathematics) either positive or zero"/>
<rdf:Description rdf:about="&a;301749331"
	 b:glossaryEntry='(mathematics) greater than zero; "positive numbers"'/>
<rdf:Description rdf:about="&a;301749437">
	<b:glossaryEntry>on the negative side or lower end of a scale; "minus 5 degrees"; "a grade of B minus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301749592"
	 b:glossaryEntry='(mathematics) less than zero; "a negative number"'/>
<rdf:Description rdf:about="&a;301749696">
	<b:glossaryEntry>(med) indicating existence or presence of a suspected condition or pathogen; "a positive pregnancy test"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301749868">
	<b:glossaryEntry>(med) not indicating the presence of microorganisms or disease or a specific condition; "the HIV test was negative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301750054"
	 b:glossaryEntry='having a positive electric charge; "protons are positive"'/>
<rdf:Description rdf:about="&a;301750220"
	 b:glossaryEntry='having a negative electric charge; "electrons are negative"'/>
<rdf:Description rdf:about="&a;301750388"
	 b:glossaryEntry="(physics) having no net electric charge; not electrified"/>
<rdf:Description rdf:about="&a;301750551">
	<b:glossaryEntry>capable of happening or existing; "a breakthrough may be possible next year"; "anything is possible"; "warned of possible consequences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301751011"
	 b:glossaryEntry="capable of existing or taking place or proving true"/>
<rdf:Description rdf:about="&a;301751158">
	<b:glossaryEntry>capable of being affirmed or asserted; "a quality affirmable of every member of the family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301751319"
	 b:glossaryEntry="capable of being alleged or asserted to be true"/>
<rdf:Description rdf:about="&a;301751423">
	<b:glossaryEntry>capable of being attained or accomplished; "choose an attainable goal"; "art is not something that is come-at-able by dint of study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301751648"
	 b:glossaryEntry="capable of being attempted"/>
<rdf:Description rdf:about="&a;301751732">
	<b:glossaryEntry>within the bounds of what may be conceived within the framework of nature; "a cure is still conceivable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301751894">
	<b:glossaryEntry>possible but not certain to occur; "they had to plan for contingent expenses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301752028">
	<b:glossaryEntry>capable of being done with means at hand and circumstances as they are</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301752187">
	<b:glossaryEntry>statistically possible though highly improbable; "have a mathematical chance of making the playoffs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301752346">
	<b:glossaryEntry>capable of being studied carefully and thoroughly and in detail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301752468">
	<b:glossaryEntry>not capable of occurring or being accomplished or dealt with; "an impossible dream"; "an impossible situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301752815"
	 b:glossaryEntry='certain to fail; "the situation is hopeless"'/>
<rdf:Description rdf:about="&a;301752914">
	<b:glossaryEntry>not capable of being carried out or put into practice; "refloating the sunken ship proved impracticable because of its fragility"; "a suggested reform that was unfeasible in the prevailing circumstances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301753216">
	<b:glossaryEntry>not worth considering as a possibility; "a picnic is out because of the weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301753349"
	 b:glossaryEntry="impossible to achieve"/>
<rdf:Description rdf:about="&a;301753470">
	<b:glossaryEntry>having a strong physiological or chemical effect; "a potent toxin"; "potent liquor"; "a potent cup of tea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301753746">
	<b:glossaryEntry>exerting or capable of exerting strong physiological or chemical effects; "an effectual vaccine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301753898"
	 b:glossaryEntry="having equal strength or efficacy"/>
<rdf:Description rdf:about="&a;301753988">
	<b:glossaryEntry>lacking power or ability; "Technology without morality is barbarous; morality without technology is impotent"- Freeman J.Dyson; "felt impotent rage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301754281">
	<b:glossaryEntry>lacking in power or forcefulness; "an ineffectual ruler"; "like an unable phoenix in hot ashes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301754457"
	 b:glossaryEntry="lacking physical strength or vigor"/>
<rdf:Description rdf:about="&a;301754542"
	 b:glossaryEntry="(of a male) able to copulate"/>
<rdf:Description rdf:about="&a;301754632"
	 b:glossaryEntry="(of a male) unable to copulate"/>
<rdf:Description rdf:about="&a;301754717">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having great power or force or potency or effect; "the most powerful government in western Europe"; "his powerful arms"; "a powerful bomb"; "the horse''s powerful kick"; "powerful drugs"; "a powerful argument"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301755232"
	 b:glossaryEntry="having unlimited power"/>
<rdf:Description rdf:about="&a;301755337">
	<b:glossaryEntry>serving or intended to coerce; "authority is directional instead of coercive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301755469"
	 b:glossaryEntry='driving or forcing; "compelling ambition"'/>
<rdf:Description rdf:about="&a;301755567">
	<b:glossaryEntry>having or showing great strength or force or intensity; "struck a mighty blow"; "the mighty logger Paul Bunyan"; "the pen is mightier than the sword"- Bulwer-Lytton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301755784">
	<b:glossaryEntry>having or suggesting great physical power or force; "the muscular and passionate Fifth Symphony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301755935">
	<b:glossaryEntry>having or wielding force or authority; "providing the ground soldier with increasingly potent weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301756099">
	<b:glossaryEntry>having or using or propelled by means of power or power of a specified kind; often used in combination; "powered flight"; "kerosine-powered jet engines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301756305"
	 b:glossaryEntry="(archaic) powerful"/>
<rdf:Description rdf:about="&a;301756378">
	<b:glossaryEntry>(combining form) acting or functioning as a regent or ruler; "prince-regent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301756511"
	 b:glossaryEntry="exercising power or authority"/>
<rdf:Description rdf:about="&a;301756614"
	 b:glossaryEntry="lacking power"/>
<rdf:Description rdf:about="&a;301756816">
	<b:glossaryEntry>lacking strength; "a weak, nerveless fool, devoid of energy and promptitude"- Nathaniel Hawthorne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301756978">
	<b:glossaryEntry>lacking in or deprived of strength or power; "lying ill and helpless"; "helpless with laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301757144">
	<b:glossaryEntry>rendered powerless especially by an excessive amount or profusion of something; "a desk flooded with applications"; "felt inundated with work"; "too much overcome to notice"; "a man engulfed by fear"; "swamped by work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301757488">
	<b:glossaryEntry>having or using or propelled by means of power or power of a specified kind; "powered flight"; (often used in combination; "kerosine-powered jet engines")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301757750">
	<b:glossaryEntry>(used of microscopes) capable of a high degree of magnification; "a high-powered microscope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301757901">
	<b:glossaryEntry>(of an automobile) having the engine modified to give extra power; "a hopped-up jalopy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758044">
	<b:glossaryEntry>(of e.g. an engine) having the power increased by fitting with a supercharger</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758180">
	<b:glossaryEntry>not having or using power; "an autogiro is supported in flight by unpowered rotating wings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758327">
	<b:glossaryEntry>(electricity) subjected to or capable of operating under relatively high voltage; "high-tension wire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758505">
	<b:glossaryEntry>operating on or powered by a high voltage; "a high-voltage generator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758633">
	<b:glossaryEntry>(electricity) subjected to or capable of operating under relative low voltage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758782">
	<b:glossaryEntry>having or exercising influence or power; "an influential newspaper"; "influential leadership for peace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301758997">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having authority or ascendancy or influence; "an important official"; "the captain''s authoritative manner"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301759175">
	<b:glossaryEntry>having the power to influence or convince; "a cogent analysis of the problem"; "potent arguments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301759345">
	<b:glossaryEntry>exerting influence by reason of high status or prestige; "a prestigious professor at a prestigious university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301759513"
	 b:glossaryEntry="not influential"/>
<rdf:Description rdf:about="&a;301759588">
	<b:glossaryEntry>of or having or occurring by means of a placenta; "all mammals except monotremes and marsupials are placental mammals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301759780">
	<b:glossaryEntry>through or by way of the placenta; "transplacental passage of nutrients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301759913">
	<b:glossaryEntry>having no placenta; "monotremes and marsupials are aplacental mammals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301760040"
	 b:glossaryEntry="set in the soil for growth"/>
<rdf:Description rdf:about="&a;301760228"
	 b:glossaryEntry='(of land or soil) used for growing crops; "cropped soil"'/>
<rdf:Description rdf:about="&a;301760338">
	<b:glossaryEntry>planted so as to give an effect of wild growth; "drifts of naturalized daffodils"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301760477">
	<b:glossaryEntry>of a potted plant; grown too large for its container resulting in matting or tangling of the roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301760642">
	<b:glossaryEntry>grown from cuttings planted directly in the ground; "a quickset hawthorn hedge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301760779"
	 b:glossaryEntry='sprinkled with seed; "a seeded lawn"'/>
<rdf:Description rdf:about="&a;301760875">
	<b:glossaryEntry>growing from seed dispersed by natural agency such as wind or birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301761025"
	 b:glossaryEntry="not planted"/>
<rdf:Description rdf:about="&a;301761146"
	 b:glossaryEntry='not used for growing crops; "uncropped soil"'/>
<rdf:Description rdf:about="&a;301761246">
	<b:glossaryEntry>(of a piece of ground) not have a crop sown on it; "farmland still unsown"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301761384">
	<b:glossaryEntry>produced without being planted or without human labor; "wild strawberries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301761533">
	<b:glossaryEntry>(of farmland) broken and turned over with a plow; "plowed fields"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301761680">
	<b:glossaryEntry>turned or stirred by plowing or harrowing or hoeing; "tilled land ready for seed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301761814"
	 b:glossaryEntry='(of farmland) not plowed; "unplowed fields"; "unbroken land"'/>
<rdf:Description rdf:about="&a;301761989">
	<b:glossaryEntry>left unplowed and unseeded during a growing season; "fallow farmland"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301762111"
	 b:glossaryEntry='not plowed or harrowed or hoed; "untilled land"'/>
<rdf:Description rdf:about="&a;301762213">
	<b:glossaryEntry>(of land or fields) prepared for raising crops by plowing or fertilizing; "cultivated land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301762361">
	<b:glossaryEntry>(of land or fields) not prepared for raising crops; "uncultivated land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301762509">
	<b:glossaryEntry>not suitable for cultivation or tilling; "thickets of indigenous trees...on uncultivable land"- C.B.Palmer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301762691"
	 b:glossaryEntry='of plants; planted or grown in a pot; "potted geraniums"'/>
<rdf:Description rdf:about="&a;301762800"
	 b:glossaryEntry="not planted in pots"/>
<rdf:Description rdf:about="&a;301762874">
	<b:glossaryEntry>concerned with actual use or practice; "he is a very practical person"; "the idea had no practical application"; "a practical knowledge of Japanese"; "woodworking is a practical art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301763364"
	 b:glossaryEntry="readily applicable or practical"/>
<rdf:Description rdf:about="&a;301763480"
	 b:glossaryEntry='put into practice or put to use; "applied physics"'/>
<rdf:Description rdf:about="&a;301763584">
	<b:glossaryEntry>designed for or adapted to a function or use; "functional education selects knowledge that is concrete and usable rather than abstract and theoretical"; "functional architecture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301763819">
	<b:glossaryEntry>concerned with practical matters; "a matter-of-fact (or pragmatic) approach to the problem"; "a matter-of-fact account of the trip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301764037">
	<b:glossaryEntry>usable for a specific purpose; "an operable plan"; "a practicable solution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301764181">
	<b:glossaryEntry>intended or able to serve a purpose without elaboration; "serviceable low-heeled shoes";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301764328"
	 b:glossaryEntry="dealing only with concrete facts"/>
<rdf:Description rdf:about="&a;301764420">
	<b:glossaryEntry>capable of being turned to use or account; "useful applications of calculus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301764549">
	<b:glossaryEntry>adequate for practical use; especially sufficient in strength or numbers to accomplish something; "the party has a working majority in the House"; "a working knowledge of Spanish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301764782">
	<b:glossaryEntry>not practical; not workable or not given to practical matters; "refloating the ship proved impractical because of the expense"; "he is intelligent but too impractical for commercial work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301765153">
	<b:glossaryEntry>remote from actual involvement; "armchair warriors in the Pentagon"; "an armchair anthropologist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301765308">
	<b:glossaryEntry>(informal) foolish; totally unsound; "an impractical solution"; "a crazy scheme"; "half-baked ideas"; "a screwball proposal without a prayer of working"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301765550">
	<b:glossaryEntry>not sensible about practical matters; unrealistic; "as quixotic as a restoration of medieval knighthood"; "a romantic disregard for money"; "a wild-eyed dream of a world state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301765804"
	 b:glossaryEntry="not related to or fitted for everyday needs or activities"/>
<rdf:Description rdf:about="&a;301765920">
	<b:glossaryEntry>sharply exact or accurate or delimited; "a precise mind"; "specified a precise amount"; "arrived at the precise moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301766327"
	 b:glossaryEntry='unerringly accurate; "a dead shot"; "took dead aim"'/>
<rdf:Description rdf:about="&a;301766429">
	<b:glossaryEntry>minutely precise especially in differences in meaning; "a fine distinction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301766555">
	<b:glossaryEntry>developed in excessively fine detail; "finespun distinctions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301766687">
	<b:glossaryEntry>marked by precise accordance with details; "was worryingly meticulous about trivial details"; "punctilious in his attention to rules of etiquette"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301766904">
	<b:glossaryEntry>extremely precise with great attention to details; "examined it with microscopic care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301767048">
	<b:glossaryEntry>done with delicacy and skill; "a nice bit of craft"; "a job requiring nice measurements with a micrometer"; "a nice shot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301767231">
	<b:glossaryEntry>being precisely to a prescribed or specified criterion; "his guess was on the nose"; "the prediction for snow was right on the button"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301767439"
	 b:glossaryEntry='meticulously precise; "pinpoint accuracy"'/>
<rdf:Description rdf:about="&a;301767538"
	 b:glossaryEntry='precisely as stated; "the very center of town"'/>
<rdf:Description rdf:about="&a;301767638">
	<b:glossaryEntry>not precise; "imprecise astronomical observations"; "the terms he used were imprecise and emotional"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301767884">
	<b:glossaryEntry>somewhat indefinite; "bearing a general resemblance to the original"; "a general description of the merchandise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301768050"
	 b:glossaryEntry='not precisely accurate; "an inexact quotation"'/>
<rdf:Description rdf:about="&a;301768163">
	<b:glossaryEntry>characterized by or characteristic of exceptionally early development or maturity (especially in mental aptitude); "a precocious child"; "a precocious achievement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301768437">
	<b:glossaryEntry xml:space='preserve'><![CDATA[farther along in physical or mental development; "the child''s skeletal age was classified as `advanced''"; "children in the advanced classes in elementary school read far above grade average"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301768682"
	 b:glossaryEntry="showing a natural aptitude for something"/>
<rdf:Description rdf:about="&a;301768786">
	<b:glossaryEntry>relatively slow in mental or emotional or physical development; "providing a secure and sometimes happy life for the retarded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301769057"
	 b:glossaryEntry="retarded in intellectual development"/>
<rdf:Description rdf:about="&a;301769163"
	 b:glossaryEntry="afflicted with cretinism"/>
<rdf:Description rdf:about="&a;301769243"
	 b:glossaryEntry="not as far along as normal in development"/>
<rdf:Description rdf:about="&a;301769338"
	 b:glossaryEntry="lacking mental capacity and devoid of subtlety"/>
<rdf:Description rdf:about="&a;301769480"
	 b:glossaryEntry="possible to foretell"/>
<rdf:Description rdf:about="&a;301769612">
	<b:glossaryEntry>being such as may reasonable be anticipated; "foreseeable costs were well within the budget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301769762">
	<b:glossaryEntry>invariably occurring or appearing; "the inevitable changes of the seasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301769893"
	 b:glossaryEntry="impossible to foretell"/>
<rdf:Description rdf:about="&a;301770065"
	 b:glossaryEntry='dependent on chance; "the aleatory element in life"'/>
<rdf:Description rdf:about="&a;301770171"
	 b:glossaryEntry='changeable; "a capricious summer breeze"; "freakish weather"'/>
<rdf:Description rdf:about="&a;301770299">
	<b:glossaryEntry>occurring or appearing at usually irregular intervals; "episodic in his affections"; "occasional headaches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301770474"
	 b:glossaryEntry='incapable of being anticipated; "unforeseeable consequences"'/>
<rdf:Description rdf:about="&a;301770594">
	<b:glossaryEntry>characterized by deliberate purpose and some degree of planning; "a premeditated crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301770830"
	 b:glossaryEntry='planned in advance; "with malice aforethought"'/>
<rdf:Description rdf:about="&a;301770959">
	<b:glossaryEntry>carefully thought out in advance; "a calculated insult"; "with measured irony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301771118">
	<b:glossaryEntry>carefully practiced or designed or premeditated; "a studied reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301771255"
	 b:glossaryEntry="not premeditated"/>
<rdf:Description rdf:about="&a;301771368">
	<b:glossaryEntry>without forethought; "letting him borrow her car was an impulsive act that she immediately regretted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301771525">
	<b:glossaryEntry>made ready or fit or suitable beforehand; "a prepared statement"; "be prepared for emergencies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301771855">
	<b:glossaryEntry>positioned so as to be ready for confrontation or danger; "he stood to attention with his shoulders braced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301772015"
	 b:glossaryEntry='prepared for battle; "an embattled city"'/>
<rdf:Description rdf:about="&a;301772111">
	<b:glossaryEntry>prepared with proper equipment; "equipped for service in the Arctic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301772250">
	<b:glossaryEntry>having already been put into a suitable condition; "a surface preconditioned to receive paint"; "customers preconditioned to buy a product"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301772450">
	<b:glossaryEntry>cooked partially or completely beforehand; "frozen precooked meals from the supermarket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301772594">
	<b:glossaryEntry>subjected to a special process or treatment; "prepared ergot"; "processed cheeses are easy to spread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301772751"
	 b:glossaryEntry='brought into readiness; "dinner is ready"'/>
<rdf:Description rdf:about="&a;301772844">
	<b:glossaryEntry>prepared or arranged for a meal; especially having food set out; "a table spread with food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301772988">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `on'' or `for'') in readiness; "he was up on his homework"; "had to be up for the game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301773146">
	<b:glossaryEntry>without preparation; not prepared for; "unprepared remarks"; "the shock was unprepared"; "our treaty makers approached their immensely difficult problems unprepared"- R.E.Danielson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301773437">
	<b:glossaryEntry>with little or no preparation or forethought; "his ad-lib comments showed poor judgment"; "an extemporaneous piano recital"; "an extemporary lecture"; "an extempore skit"; "offhand excuses"; "trying to sound offhanded and reassuring"; "an off-the-cuff toast"; "a few unrehearsed comments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301773872">
	<b:glossaryEntry>in response to an unforeseen need; "an impromptu speech"; "a spur-of-the-moment party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301774035">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of medicinal drugs) available only with a doctor''s written prescription; "a prescription drug"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301774192">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of medicinal drugs) able to be sold without a doctor''s prescription; "nonprescription drugs"; "an over-the-counter cold remedy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301774407">
	<b:glossaryEntry>spatial sense; being or existing in a specified place; "the murderer is present in this room"; "present at the wedding"; "present at the creation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301774715"
	 b:glossaryEntry="being present at meeting or event"/>
<rdf:Description rdf:about="&a;301774823"
	 b:glossaryEntry="being present always"/>
<rdf:Description rdf:about="&a;301774902">
	<b:glossaryEntry>existing in something specified; "depletion of the oxygen existing in the bloodstream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301775043">
	<b:glossaryEntry>being here now; "is everyone here?"; "present company excepted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301775160"
	 b:glossaryEntry="being present everywhere at once"/>
<rdf:Description rdf:about="&a;301775263"
	 b:glossaryEntry="not in a specified place physically or mentally"/>
<rdf:Description rdf:about="&a;301775453">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not present; having left; "he''s away right now"; "you must not allow a stranger into the house when your mother is away"; "everyone is gone now"; "the departed guests"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301775698"
	 b:glossaryEntry="completely lacking"/>
<rdf:Description rdf:about="&a;301775769">
	<b:glossaryEntry>not existing; "innovation has been sadly lacking"; "character development is missing from the book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301775962">
	<b:glossaryEntry>absent without permission; "truant schoolboys"; "the soldier was AWOL for almost a week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301776110">
	<b:glossaryEntry>intended to attract notice and impress others; "an ostentatious sable coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301776294"
	 b:glossaryEntry='inclined to flaunt; "conspicuous consumption"'/>
<rdf:Description rdf:about="&a;301776407">
	<b:glossaryEntry>marked by conspicuous display; "a cheap showy rhinestone bracelet"; "a splashy half-page ad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301776561">
	<b:glossaryEntry>not ostentatious; "his unostentatious office"; "unostentatious elegance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301776728"
	 b:glossaryEntry='not showy or obtrusive; "clothes in quiet good taste"'/>
<rdf:Description rdf:about="&a;301776846">
	<b:glossaryEntry>making claim to or creating an appearance of (often undeserved) importance or distinction; "a pretentious country house"; "a pretentious fraud"; "a pretentious scholarly edition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301777262"
	 b:glossaryEntry="showily imitative of art or artists"/>
<rdf:Description rdf:about="&a;301777348"
	 b:glossaryEntry="pretentiously artistic; cloyingly charming"/>
<rdf:Description rdf:about="&a;301777464">
	<b:glossaryEntry>puffed up with vanity; "a grandiloquent and boastful manner"; "overblown oratory"; "a pompous speech"; "pseudo-scientific gobbledygook and pontifical hooey"- Newsweek</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301777738"
	 b:glossaryEntry="affectedly genteel"/>
<rdf:Description rdf:about="&a;301777878">
	<b:glossaryEntry>(informal) pretentious; "high-flown talk of preserving the moral tone of the school"; "a high-flying dissertation on the means to attain social revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301778131"
	 b:glossaryEntry="(British informal) upstart"/>
<rdf:Description rdf:about="&a;301778213">
	<b:glossaryEntry>characteristic of someone who has risen economically or socially but lacks the social skills appropriate for this new position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301778433">
	<b:glossaryEntry>abounding in or given to pompous or aphoristic moralizing; "too often the significant episode deteriorates into sententious conversation"- Kathleen Barnes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301778645">
	<b:glossaryEntry>given to the overuse of long words; "sesquipecalian orators"; "this sesquipedalian way of saying one has no money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301778820">
	<b:glossaryEntry>lacking pretension or affectation; "an unpretentious country church"; "her quiet unpretentious demeanor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301779074">
	<b:glossaryEntry>without pretensions; "worked at an honest trade"; "good honest food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301779195">
	<b:glossaryEntry>free from pomp or affectation; "comfortable but modest cottages"; "a plain blue suit"; "a simple rectangular brick building"; "a simple man with simple tastes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301779424"
	 b:glossaryEntry="not pompous"/>
<rdf:Description rdf:about="&a;301779491">
	<b:glossaryEntry>having a price assigned or having a price as specified; often used in combination; "a high-priced line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301779845">
	<b:glossaryEntry>costing 10 dollars; slang for the price of unlawful drugs; "a dime bag"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301779967"
	 b:glossaryEntry="costing 5 cents (US) or 5 pence (Britain)"/>
<rdf:Description rdf:about="&a;301780064"
	 b:glossaryEntry="costing 4 cents (US) or 4 pence (Britain)"/>
<rdf:Description rdf:about="&a;301780161">
	<b:glossaryEntry>priced at 5 cents; "I can still remember when a nickel ice-cream cone cost only 10 cents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301780303">
	<b:glossaryEntry>costing 5 dollars; slang for the price of unlawful drugs; "a nickel bag"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301780428"
	 b:glossaryEntry="costing 9 cents (US) or 5 pence (Britain)"/>
<rdf:Description rdf:about="&a;301780525"
	 b:glossaryEntry='priced at 1 cent; "penny candy"'/>
<rdf:Description rdf:about="&a;301780608">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used in combination) priced as indicated; "`penny'' is a combining form in such expressions as `sixpenny cakes''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301780772"
	 b:glossaryEntry="costing 6 cents (US) or 6 pence (Britain)"/>
<rdf:Description rdf:about="&a;301780868"
	 b:glossaryEntry="costing 3 cents (US) or 3 pence (Britain)"/>
<rdf:Description rdf:about="&a;301780966"
	 b:glossaryEntry='costing 3 cents (US) or 2 pence (Britain); "twopenny candy"'/>
<rdf:Description rdf:about="&a;301781090"
	 b:glossaryEntry='not having a price set or shown; "unpriced merchandise"'/>
<rdf:Description rdf:about="&a;301781200">
	<b:glossaryEntry>of first rank or importance or value; direct and immediate rather than secondhand; "primary goals"; "a primary effect"; "primary sources"; "a primary interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301781575">
	<b:glossaryEntry>as an immediate result or consequence; "a direct result of the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301781700"
	 b:glossaryEntry='received directly from a source; "firsthand information"'/>
<rdf:Description rdf:about="&a;301781812">
	<b:glossaryEntry>of the regular members of a team; not substitutes; "first-string players"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301781944">
	<b:glossaryEntry>(of e.g. information) not secondhand or by way of something intermediary; "his work is based on only original, not secondary, sources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301782133">
	<b:glossaryEntry>first and most important; "his special interest is music"; "she gets special (or particular) satisfaction from her volunteer work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301782330">
	<b:glossaryEntry>of second rank or importance or value; not direct or immediate; "the stone will be hauled to a secondary crusher"; "a secondary source"; "a secondary issue"; "secondary streams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301782779"
	 b:glossaryEntry='allowing a choice; "an alternative plan"'/>
<rdf:Description rdf:about="&a;301782889">
	<b:glossaryEntry>functioning in a subsidiary or supporting capacity; "the main library and its auxiliary branches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301783086">
	<b:glossaryEntry>accompaniment to something else; "collateral target damage from a bombing run"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301783221">
	<b:glossaryEntry>not as a direct effect or consequence; "indirect benefits"; "an indirect advantage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301783359">
	<b:glossaryEntry>derived from what is primary or original; not firsthand; "a secondhand report"; "a secondhand account of a memory of something once read"; "most of our knowledge is secondhand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301783592">
	<b:glossaryEntry>being a replacement or substitute for a regular member of a team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301783732">
	<b:glossaryEntry>ready for emergency use; "a standby generator"; "a standby crew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301783850"
	 b:glossaryEntry="of a stream; flowing into a larger stream"/>
<rdf:Description rdf:about="&a;301783947">
	<b:glossaryEntry>capable of substituting in any of several positions on a team; "a utility infielder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301784104">
	<b:glossaryEntry>experienced at secondhand; "read about mountain climbing and felt vicarious excitement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301784247">
	<b:glossaryEntry>pertaining to or constituting a base or basis; "a basic fact"; "the basic ingredients"; "basic changes in public opinion occur because of changes in priorities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301784549">
	<b:glossaryEntry>serving as or forming a base; "the painter applied a base coat followed by two finishing coats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301784703">
	<b:glossaryEntry>of or being the essential or basic part; "an elementary need for love and nurturing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301784854">
	<b:glossaryEntry>being or involving basic facts or principles; "the fundamental laws of the universe"; "a fundamental incompatibility between them"; "these rudimentary truths"; "underlying principles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301785122"
	 b:glossaryEntry='fundamental; "the grassroots factor in making the decision"'/>
<rdf:Description rdf:about="&a;301785238">
	<b:glossaryEntry>arising from or going to the root; "a radical flaw in the plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301785362">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `to'') minor or casual or subordinate in significance or nature or occurring as a chance concomitant or consequence; "incidental expenses"; "the road will bring other incidental advantages"; "extra duties incidental to the job"; "labor problems incidental to a rapid expansion"; "confusion incident to a quick change"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301785841">
	<b:glossaryEntry>qualifying or explaining; placed or as if placed in parentheses; "parenthetical remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301786003">
	<b:glossaryEntry>not of central importance; "energy is far from a peripheral issue in the economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301786141">
	<b:glossaryEntry>depending on or incidental to what is original or primary; "a secondary infection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301786279">
	<b:glossaryEntry xml:space='preserve'><![CDATA[minor or subordinate; `by'' is often used in combination; "a side interest"; "a by (or bye) effect"; "only a by comment"; "by-election"; "bye-election"; "a by-product"; "by-play"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301786527">
	<b:glossaryEntry>of the first stage of education and schools; "elementary school"; "an elementary grammar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301786730">
	<b:glossaryEntry>of elementary education; "a basal reader"; "children in the beginning reading classes"; "the primary grades"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301786937">
	<b:glossaryEntry>of the stage of education and schools between elementary and secondary including middle grades centering on 5 through 7; "intermediate schools"; "the intermediate (or middle) grades"; "a middle school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301787245">
	<b:glossaryEntry>referring to an intermediate stage of education usually centering on grades 6 or 7 through 8 or 9</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301787403">
	<b:glossaryEntry>of the stage of education and schools preceding collegiate; "secondary school"; "high school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301787580">
	<b:glossaryEntry>confined to particular persons or groups or providing privacy; "a private place"; "private discussions"; "private lessons"; "a private club"; "a private secretary"; "private property"; "the former President is now a private citizen"; "public figures struggle to maintain a private life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301788190"
	 b:glossaryEntry="concealed from the public"/>
<rdf:Description rdf:about="&a;301788271">
	<b:glossaryEntry>befitting or characteristic of those who inclined to social exclusiveness and who rebuff the advances of people considered inferior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301788497">
	<b:glossaryEntry xml:space='preserve'><![CDATA[providing privacy or seclusion; "the cloistered academic world of books"; "sat close together in the sequestered pergola"; "sitting under the reclusive calm of a shade tree"; ''a secluded romantic spot"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301788792"
	 b:glossaryEntry='confined to specific persons; "a close secret"'/>
<rdf:Description rdf:about="&a;301788890"
	 b:glossaryEntry='not open to the public; "a closed-door meeting"'/>
<rdf:Description rdf:about="&a;301788995">
	<b:glossaryEntry>(of information) given in confidence or in secret; "closet information"; "this arrangement must be kept confidential"; "their secret communications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301789223">
	<b:glossaryEntry>entrusted with private information and the confidence of another; "a confidential secretary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301789374">
	<b:glossaryEntry>suggestive of the isolated life of an island; "an exceedingly insular man; so deeply private as to seem inaccessible to the scrutiny of a novelist"- Leonard Michaels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301789593">
	<b:glossaryEntry>not invested with or related to prominent position or status etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301789714">
	<b:glossaryEntry>withheld from public view or attention; "offstage political meetings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301789838"
	 b:glossaryEntry='directly between two individuals; "one-on-one instruction"'/>
<rdf:Description rdf:about="&a;301789953">
	<b:glossaryEntry>hidden from general view or use; "a privy place to rest and think"; "a secluded romantic spot"; "a secret garden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301790138">
	<b:glossaryEntry>involving two persons; intimately private; "a tete-a-tete supper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301790261">
	<b:glossaryEntry>not private; open to or concerning the people as a whole; "the public good"; "public libraries"; "public funds"; "public parks"; "a public scandal"; "public gardens"; "performers and members of royal families are public figures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301790704">
	<b:glossaryEntry>of great interest to the public; "a person in the public eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301790832">
	<b:glossaryEntry>owned or maintained for the public by the national government; "national parks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301790966">
	<b:glossaryEntry>open to or in view of all; "an open protest"; "an open letter to the editor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301791093"
	 b:glossaryEntry="having some of the features of public institution"/>
<rdf:Description rdf:about="&a;301791199"
	 b:glossaryEntry='in the service of the community or nation; "state security"'/>
<rdf:Description rdf:about="&a;301791310">
	<b:glossaryEntry>supported and operated by the government of a state; "a state university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301791453"
	 b:glossaryEntry="accessible to all"/>
<rdf:Description rdf:about="&a;301791543">
	<b:glossaryEntry>excluding much or all; especially all but a particular group or minority; "exclusive clubs"; "an exclusive restaurants and shops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301791800">
	<b:glossaryEntry xml:space='preserve'><![CDATA[exclusive of anyone or anything else; "she alone believed him"; "cannot live by bread alone"; "I''ll have this car and this car only"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301791994">
	<b:glossaryEntry>exclusive to a center; especially a center of influence; "inner regions of the organization"; "inner circles of government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301792169">
	<b:glossaryEntry>confined to an exclusive or group; "privy to inner knowledge"; "inside information"; privileged information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301792351">
	<b:glossaryEntry>characterized by very careful or fastidious selection; "the school was very selective in its admissions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301792511">
	<b:glossaryEntry>including much or everything; and especially including stated limits; "an inclusive art form"; "an inclusive fee"; "his concept of history is modern and inclusive"; "from Monday to Friday inclusive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301792783"
	 b:glossaryEntry='broad in scope; "a comprehensive survey of world affairs"'/>
<rdf:Description rdf:about="&a;301792900"
	 b:glossaryEntry='blessed with privileges; "the privileged few"'/>
<rdf:Description rdf:about="&a;301793056">
	<b:glossaryEntry>blessed with advantages; "she is more advantaged than her cousin"; "born into the favored classes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301793221">
	<b:glossaryEntry>lacking the rights and advantages of other members of society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301793416">
	<b:glossaryEntry>marked by deprivation especially of the necessities of life or healthful environmental influences; "a childhood that was unhappy and deprived, the family living off charity"; "boys from a deprived environment, wherein the family life revealed a pattern of neglect, moral degradation, and disregard for law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301793793">
	<b:glossaryEntry>belonging to the lowest and least privileged social stratum; "underclass mothers and children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301793947">
	<b:glossaryEntry>producing or capable of producing (especially abundantly); "productive farmland"; "his productive years"; "a productive collaboration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301794372"
	 b:glossaryEntry="(of plants) bearing or characterized by aments or catkins"/>
<rdf:Description rdf:about="&a;301794502"
	 b:glossaryEntry="(of farmland) capable of being farmed productively"/>
<rdf:Description rdf:about="&a;301794644">
	<b:glossaryEntry>(combining form) producing or yielding; "an interest-bearing note"; "fruit-bearing trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301794787">
	<b:glossaryEntry>intellectually productive; "a prolific writer"; "a fecund imagination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301794931"
	 b:glossaryEntry="(biology) reproducing by fission"/>
<rdf:Description rdf:about="&a;301795021">
	<b:glossaryEntry>productive of profit; "a profitable enterprise"; "a fruitful meeting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301795158"
	 b:glossaryEntry='containing oils; "oil-bearing shale"'/>
<rdf:Description rdf:about="&a;301795252"
	 b:glossaryEntry='very productive; "rich seams of coal"'/>
<rdf:Description rdf:about="&a;301795340">
	<b:glossaryEntry>not producing or capable of producing; "elimination of high-cost or unproductive industries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301795599">
	<b:glossaryEntry>unproductive of success; "a fruitless search"; "futile years after her artistic peak"; "a sleeveless errand"; "a vain attempt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301795821">
	<b:glossaryEntry>unproductive especially of the expected results; "a dry run"; "a mind dry of new ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301795958"
	 b:glossaryEntry='not directly productive; "nonproductive labor"'/>
<rdf:Description rdf:about="&a;301796064">
	<b:glossaryEntry>having the ability to produce or originate; "generative power"; "generative forces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301796235"
	 b:glossaryEntry="having the power to bring into being"/>
<rdf:Description rdf:about="&a;301796340">
	<b:glossaryEntry>tending to consume or use often wastefully; "water suitable for beneficial consumptive uses"; "duties consumptive of time and energy"; "consumptive fires"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301796570"
	 b:glossaryEntry="tending to exploit or make use of"/>
<rdf:Description rdf:about="&a;301796690">
	<b:glossaryEntry>capable of being reproduced; "astonishingly reproducible results can be obtained"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301796861"
	 b:glossaryEntry="capable of being duplicated"/>
<rdf:Description rdf:about="&a;301796960"
	 b:glossaryEntry="impossible to reproduce or duplicate"/>
<rdf:Description rdf:about="&a;301797110"
	 b:glossaryEntry='defying imitation; matchless; "an inimitable style"'/>
<rdf:Description rdf:about="&a;301797218">
	<b:glossaryEntry>unique; "dogs and mice and flies are as unrepeatable as men are"- Theodosius Dobzhansky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301797364">
	<b:glossaryEntry>engaged in a profession or engaging in as a profession or means of livelihood; "the professional man or woman possesses distinctive qualifications"; "began her professional career after the Olympics"; "professional theater"; "professional football"; "a professional cook"; "professional actors and athletes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301797766">
	<b:glossaryEntry>involving gainful employment in something often done as a hobby</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301797898"
	 b:glossaryEntry='professing to be qualified; "a professed philosopher"'/>
<rdf:Description rdf:about="&a;301798010">
	<b:glossaryEntry>not professional; not engaged in a profession or engaging in as a profession or for gain; "the nonprofessional wives of his male colleagues"; "nonprofessional actors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301798274">
	<b:glossaryEntry>engaged in as a pastime; "an amateur painter"; "gained valuable experience in amateur theatricals"; "recreational golfers"; "reading matter that is both recreational and mentally stimulating"; "unpaid extras in the documentary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301798579">
	<b:glossaryEntry>not of or from a profession; "a lay opinion as to the cause of the disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301798704">
	<b:glossaryEntry>characteristic of or befitting a profession or one engaged in a profession; "professional conduct"; "professional ethics"; "a thoroughly professional performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301798943">
	<b:glossaryEntry>having or showing great skill or knowledge or special training as expected of a professional; "an expert opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301799109">
	<b:glossaryEntry>not characteristic of or befitting a profession or one engaged in a profession; "described in unprofessional language so that high school students could understand it"; "was censured for unprofessional conduct"; "unprofessional repairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301799424">
	<b:glossaryEntry>lacking professional skill or expertise; "a very amateurish job"; "inexpert but conscientious efforts"; "an unskilled painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301799641">
	<b:glossaryEntry>yielding material gain or profit; "profitable speculation on the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301799920">
	<b:glossaryEntry>guaranteed to bring a profit; "without bankable stars the film script aroused no interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301800065"
	 b:glossaryEntry='(informal) lucrative; "a juicy contract"; "a nice fat job"'/>
<rdf:Description rdf:about="&a;301800181"
	 b:glossaryEntry="yielding a fair profit"/>
<rdf:Description rdf:about="&a;301800273">
	<b:glossaryEntry>financially rewarding; "it was no longer economic to keep the factory open"; "have to keep prices high enough to make it economic to continue the service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301800482"
	 b:glossaryEntry='producing a good profit; "a remunerative business"'/>
<rdf:Description rdf:about="&a;301800617">
	<b:glossaryEntry>producing little or no profit or gain; "deposits abandoned by mining companies as unprofitable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301800897"
	 b:glossaryEntry='not yielding a return; "dead capital"; "idle funds"'/>
<rdf:Description rdf:about="&a;301801006"
	 b:glossaryEntry='not profitable or prosperous; "a lean year"'/>
<rdf:Description rdf:about="&a;301801100">
	<b:glossaryEntry>producing at a rate that barely covers production costs; "marginal industries"; "marginal land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301801250">
	<b:glossaryEntry>not yielding profit or recompense; "an unremunerative occupation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301801376">
	<b:glossaryEntry>showing intellectual penetration or emotional depths; from the depths of your being; "the differences are profound"; "a profound insight"; "a profound book"; "a profound mind"; "profound contempt"; "profound regret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301801736">
	<b:glossaryEntry>marked by depth of thinking; "deep thoughts"; "a deep allegory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301801850">
	<b:glossaryEntry>showing profound and detailed knowledge and understanding as from long study; "an intimate knowledge of criminal law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301802022"
	 b:glossaryEntry='having intellectual depth; "a deeply thoughtful essay"'/>
<rdf:Description rdf:about="&a;301802133">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being or affecting or concerned with a surface; not deep or penetrating emotionally or intellectually; "superficial similarities"; "a superficial mind"; "his thinking was superficial and fuzzy"; "superficial knowledge"; "the superficial report didn''t give the true picture"; "only superficial differences"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301802658">
	<b:glossaryEntry>appearing as such but not necessarily so; "for all his apparent wealth he had no money to pay the rent"; "the committee investigated some apparent discrepancies"; "the ostensible truth of their theories"; "his seeming honesty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301802968">
	<b:glossaryEntry>showing frivolous or superficial interest; amateurish; "his dilettantish efforts at painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301803149">
	<b:glossaryEntry>arrived at without due care or effort; lacking depth; "too facile a solution for so complex a problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301803304">
	<b:glossaryEntry>marked by lack of intellectual depth; "glib generalizations"; "a glib response to a complex question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301803456">
	<b:glossaryEntry>appearing to be as specified; usually used as combining forms; "left their clothes dirty looking"; "a most disagreeable looking character"; "angry-looking"; "liquid-looking"; "severe-looking policemen on noble horses"; "fine-sounding phrases"; "taken in by high-sounding talk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301803797">
	<b:glossaryEntry>lacking depth of intellect or knowledge; concerned only with what is obvious; "shallow people"; "his arguments seemed shallow and tedious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301803989"
	 b:glossaryEntry="having a projecting lower jaw"/>
<rdf:Description rdf:about="&a;301804122"
	 b:glossaryEntry="having a protruding jaw giving the face a gaunt appearance"/>
<rdf:Description rdf:about="&a;301804240"
	 b:glossaryEntry="having receding jaws"/>
<rdf:Description rdf:about="&a;301804340"
	 b:glossaryEntry="having a receding chin"/>
<rdf:Description rdf:about="&a;301804417"
	 b:glossaryEntry='favoring or promoting progress; "progressive schools"'/>
<rdf:Description rdf:about="&a;301804618">
	<b:glossaryEntry>ahead of the times; "the advanced teaching methods"; "had advanced views on the subject"; "a forward-looking corporation"; "is British industry innovative enough?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301804877"
	 b:glossaryEntry="moving forward"/>
<rdf:Description rdf:about="&a;301804974">
	<b:glossaryEntry>increasing gradually by regular degrees or additions; "lecturers enjoy...steady incremental growth in salary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301805141"
	 b:glossaryEntry="opposing progress"/>
<rdf:Description rdf:about="&a;301805287"
	 b:glossaryEntry="characteristic of an atavist"/>
<rdf:Description rdf:about="&a;301805386"
	 b:glossaryEntry="going from better to worse"/>
<rdf:Description rdf:about="&a;301805536"
	 b:glossaryEntry="tending to return to an earlier state"/>
<rdf:Description rdf:about="&a;301805641">
	<b:glossaryEntry>(of taxes) adjusted so that the rate increases as the amount increases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301805805"
	 b:glossaryEntry="gradually decreasing in rate on sums below a certain amount"/>
<rdf:Description rdf:about="&a;301805921"
	 b:glossaryEntry="increasing as the amount taxed increases"/>
<rdf:Description rdf:about="&a;301806032">
	<b:glossaryEntry>(of taxes) adjusted so that the rate decreases as the amount increases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301806195"
	 b:glossaryEntry="not increasing as the amount taxed increases"/>
<rdf:Description rdf:about="&a;301806298"
	 b:glossaryEntry="decreasing as the amount taxed increases"/>
<rdf:Description rdf:about="&a;301806394">
	<b:glossaryEntry>capable of being uttered or pronounced; "a pronounceable group of letters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301806546">
	<b:glossaryEntry xml:space='preserve'><![CDATA[uttered with a trill; "she used rolling r''s as in Spanish"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301806677"
	 b:glossaryEntry="impossible or difficult to pronounce correctly"/>
<rdf:Description rdf:about="&a;301806785">
	<b:glossaryEntry>marked by suitability or rightness or appropriateness; "proper medical treatment"; "proper manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301807135">
	<b:glossaryEntry>according with custom or propriety; "her becoming modesty"; "comely behavior"; "it is not comme_il_faut for a gentleman to be constantly asking for money"; "a decent burial"; "seemly behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301807436">
	<b:glossaryEntry xml:space='preserve'><![CDATA[socially right or correct; "it isn''t right to leave the party without saying goodbye"; "correct behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301807603">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in accord with accepted standards of usage or procedure; "what''s the right word for this?"; "the right way to open oysters"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301807788">
	<b:glossaryEntry>in harmony with the spirit of particular persons or occasion; "We have come to dedicate a portion of that field...It is altogether fitting and proper that we should do this"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301808015">
	<b:glossaryEntry xml:space='preserve'><![CDATA[exaggeratedly proper; "my straitlaced Aunt Anna doesn''t approve of my miniskirts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301808261">
	<b:glossaryEntry>not suitable or right or appropriate; "slightly improper to dine alone with a married man"; "improper medication"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301808627">
	<b:glossaryEntry>not conforming with accepted standards of propriety or taste; undesirable; "incorrect behavior"; "she was seen in all the wrong places"; "He thought it was wrong for her to go out to work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301808895">
	<b:glossaryEntry>not in keeping with accepted standards of what is right or proper in polite society; "was buried with indecent haste"; "indecorous behavior"; "language unbecoming to a lady"; "unseemly to use profanity"; "moved to curb their untoward ribaldry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301809252">
	<b:glossaryEntry>improper or even offensive; "out-of-the-way remarks"; "did you notice anything out-of-the-way?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301809408">
	<b:glossaryEntry>not in accord with established usage or procedure; "the wrong medicine"; "the wrong way to shuck clams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301809563">
	<b:glossaryEntry>foretelling events as if by supernatural intervention; "prophetic writings"; "prophetic powers"; "words that proved prophetic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301809903"
	 b:glossaryEntry="indistinctly prophetic"/>
<rdf:Description rdf:about="&a;301810015"
	 b:glossaryEntry="prophetic of devastation or ultimate doom"/>
<rdf:Description rdf:about="&a;301810143"
	 b:glossaryEntry="foreseeing the future"/>
<rdf:Description rdf:about="&a;301810254">
	<b:glossaryEntry>obscurely prophetic; "Delphic pronouncements"; "an oracular message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301810387">
	<b:glossaryEntry xml:space='preserve'><![CDATA[resembling or characteristic of a prophet or prophecy; "the high priest''s divinatory pronouncement"; "mantic powers"; "a kind of sibylline book with ready and infallible answers to questions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301810685"
	 b:glossaryEntry="of ominous significance"/>
<rdf:Description rdf:about="&a;301810791"
	 b:glossaryEntry="warning of future misfortune"/>
<rdf:Description rdf:about="&a;301810890">
	<b:glossaryEntry>of or relating to prediction; having value for making predictions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301811043"
	 b:glossaryEntry="not prophetic; not foreseeing correctly"/>
<rdf:Description rdf:about="&a;301811176"
	 b:glossaryEntry="not offering prognostications"/>
<rdf:Description rdf:about="&a;301811270"
	 b:glossaryEntry="having no predictive value"/>
<rdf:Description rdf:about="&a;301811355">
	<b:glossaryEntry>concerned with or related to the future; "prospective earnings"; "a prospective mother"; "the statute is solely prospective in operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301811604">
	<b:glossaryEntry>expected to become or be; in prospect; "potential clients"; "expected income"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301811757">
	<b:glossaryEntry>effective in or looking toward the future; "he was preparing for future employment opportunities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301811907">
	<b:glossaryEntry>concerned with or related to the past; "retrospective self-justification"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301812094">
	<b:glossaryEntry>affecting things past; "retroactive tax increase"; "an ex-post-facto law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301812241">
	<b:glossaryEntry xml:space='preserve'><![CDATA[contemplative of things past; "a retrospective review of an artist''s work"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301812371">
	<b:glossaryEntry>kept safe or defended from danger or injury or loss; "the most protected spot I could find"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301812743"
	 b:glossaryEntry="secured with bastions or fortifications"/>
<rdf:Description rdf:about="&a;301812850">
	<b:glossaryEntry>protected with battlements or parapets with indentations or embrasures for shooting through</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301813000"
	 b:glossaryEntry="secure against burglary"/>
<rdf:Description rdf:about="&a;301813082"
	 b:glossaryEntry="(law) of a wife; under the protection of her husband"/>
<rdf:Description rdf:about="&a;301813187"
	 b:glossaryEntry="protected by a deep wide ditch usually filled with water"/>
<rdf:Description rdf:about="&a;301813296"
	 b:glossaryEntry='protected from danger or bad weather; "a sheltered harbor"'/>
<rdf:Description rdf:about="&a;301813410"
	 b:glossaryEntry="used especially of machinery; shielded to prevent injury"/>
<rdf:Description rdf:about="&a;301813521">
	<b:glossaryEntry>offering safety; well protected or concealed; "a snug harbor"; "a snug hideout"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301813651"
	 b:glossaryEntry="protected against or able to withstand storms"/>
<rdf:Description rdf:about="&a;301813753">
	<b:glossaryEntry>able to withstand exposure to weather without damage; "weatherproof electric wiring"; "a weatherproof coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301813919"
	 b:glossaryEntry="lacking protection or defense"/>
<rdf:Description rdf:about="&a;301814114">
	<b:glossaryEntry>with no protection or shield; "the exposed northeast frontier"; "open to the weather"; "an open wound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301814277">
	<b:glossaryEntry>having no protecting or concealing cover; "naked to mine enemies"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301814421"
	 b:glossaryEntry="used especially of machinery"/>
<rdf:Description rdf:about="&a;301814506">
	<b:glossaryEntry>intended or adapted to afford protection of some kind; "a protective covering"; "the use of protective masks and equipment"; "protective coatings"; "kept the drunken sailor in protective custody"; "animals with protective coloring"; "protective tariffs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301815086">
	<b:glossaryEntry>(nautical) used of e.g. coatings to protect against accumulation of barnacles etc on underwater surfaces; "antifouling paint"; "antifouling chemicals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301815294">
	<b:glossaryEntry>tending to ward off; "the swastika...a very ancient prophylactic symbol occurring among all peoples"- Victor Schultze</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301815496"
	 b:glossaryEntry='saving from harm or loss; "serves a conserving function"'/>
<rdf:Description rdf:about="&a;301815622">
	<b:glossaryEntry>capable of preventing conception or impregnation; "contraceptive devices and medications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301815802">
	<b:glossaryEntry>actively protective; "provided covering fire for the platoon that was moving up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301815949">
	<b:glossaryEntry>providing protective supervision; watching over or safeguarding; "daycare that is educational and not just custodial"; "a guardian angel"; "tutelary gods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301816191">
	<b:glossaryEntry>serving as or appropriate for defending or protecting; "defensive fortifications"; "defensive dikes to protect against floods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301816373">
	<b:glossaryEntry>avoiding or escaping from difficulty or danger especially enemy fire; "pilots are taught to take evasive action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301816539"
	 b:glossaryEntry='overly protective; "overprotective parents"'/>
<rdf:Description rdf:about="&a;301816643">
	<b:glossaryEntry>tending or having the power to preserve; "the timbers should be treated with a preservative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301816794">
	<b:glossaryEntry>shielding (or designed to shield) against harm or discomfort; "the protecting blanket of snow"; "a protecting alibi"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301816970">
	<b:glossaryEntry>(of tariff) protective of national interests by restricting imports</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301817095"
	 b:glossaryEntry="providing or ensuring safety"/>
<rdf:Description rdf:about="&a;301817184"
	 b:glossaryEntry="not affording protection"/>
<rdf:Description rdf:about="&a;301817285">
	<b:glossaryEntry>leaving vulnerable; "neglectful of her own financial security"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301817423">
	<b:glossaryEntry xml:space='preserve'><![CDATA[feeling self-respect or pleasure in something by which you measure''s your self-worth; or being a reason for pride; "proud parents"; "proud of his accomplishments"; "a proud moment"; "proud to serve his country"; "a proud name"; "proud princes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301818024">
	<b:glossaryEntry>having or showing feelings of unwarranted importance out of overbearing pride; "an arrogant official"; "arrogant claims"; "chesty as a peacock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301818248"
	 b:glossaryEntry='pleased and proud; "beaming parents"'/>
<rdf:Description rdf:about="&a;301818338">
	<b:glossaryEntry>feeling self-importance; "too big for his britches"; "had a swelled head"; "he was swelled with pride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301818515">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used colloquially of one who is overly conceited or arrogant; "a snotty little scion of a degenerate family"-Laurent Le Sage; "they''re snobs--stuck-up and uppity and persnickety"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301818843"
	 b:glossaryEntry='exhibiting self-importance; "big talk"'/>
<rdf:Description rdf:about="&a;301819023"
	 b:glossaryEntry="having or showing self-esteem"/>
<rdf:Description rdf:about="&a;301819144">
	<b:glossaryEntry>having or showing arrogant superiority to and disdain of those one views as unworthy; "some economists are disdainful of their colleagues in other social disciplines"; "haughty aristocrats"; "his lordly manners were offensive"; "walked with a prideful swagger"; "very sniffy about breaches of etiquette"; "his mother eyed my clothes with a supercilious air"; "shaggy supercilious camels"; "a more swaggering mood than usual"- W.L.Shirer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301819704">
	<b:glossaryEntry>characteristic of false pride; having an exaggerated sense of self-importance; "a conceited fool"; "an attitude of self-conceited arrogance"; "an egotistical disregard of others"; "so swollen by victory that he was unfit for normal duty"; "growing ever more swollen-headed and arbitrary"; "vain about her clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301820150">
	<b:glossaryEntry>having or worthy of pride; "redoubtable scholar of the Renaissance"; "born of a redoubtable family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301820344"
	 b:glossaryEntry='occasioning pride; "a gratifying (or proud) achievement"'/>
<rdf:Description rdf:about="&a;301820457"
	 b:glossaryEntry="proud of your house or its furnishings or upkeep"/>
<rdf:Description rdf:about="&a;301820563"
	 b:glossaryEntry="excessively proud"/>
<rdf:Description rdf:about="&a;301820636">
	<b:glossaryEntry>feeling pleasurable satisfaction over something by which you measures your self-worth; "proud of their child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301820813">
	<b:glossaryEntry>proud or arrogant because of your wealth (especially in the absence of other distinction)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301820960">
	<b:glossaryEntry>trying to maintain dignity and self respect despite shabbiness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301821083">
	<b:glossaryEntry>marked by meekness or modesty; not arrogant or prideful; "a humble apology"; "essentially humble...and self-effacing, he achieved the highest formal honors and distinctions"- B.K.Malinowski</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301821397">
	<b:glossaryEntry>subdued or brought low in condition or status; "brought low"; "a broken man"; "his broken spirit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301821586">
	<b:glossaryEntry>humble in spirit or manner; suggesting retiring mildness or even cowed submissiveness; "meek and self-effacing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301821764">
	<b:glossaryEntry>established beyond doubt; "a proven liar"; "a Soviet leader of proven shrewdness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301821979">
	<b:glossaryEntry>shown to be valid beyond a reasonable doubt; "the established facts in the case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301822117">
	<b:glossaryEntry>supported by evidence; "their evidenced friendliness to the US"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301822236"
	 b:glossaryEntry='tested and proved useful or correct; "a tested method"'/>
<rdf:Description rdf:about="&a;301822364"
	 b:glossaryEntry='proved to be true; "a verified claim"'/>
<rdf:Description rdf:about="&a;301822456"
	 b:glossaryEntry='not proved; "unproved allegations"; "unproved assumptions"'/>
<rdf:Description rdf:about="&a;301822616"
	 b:glossaryEntry="in the process of being tested or tried"/>
<rdf:Description rdf:about="&a;301822710"
	 b:glossaryEntry="lacking proof or substantiation"/>
<rdf:Description rdf:about="&a;301822798">
	<b:glossaryEntry xml:space='preserve'><![CDATA[providing carefully for the future; "wild squirrels are provident"; "a provident father plans for his children''s education"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301823103">
	<b:glossaryEntry>mindful of the future in spending money; "careful with money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301823228">
	<b:glossaryEntry>planning prudently for the future; "large goals that required farsighted policies"; "took a long view of the geopolitical issues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301823476"
	 b:glossaryEntry="having provided for the future"/>
<rdf:Description rdf:about="&a;301823563"
	 b:glossaryEntry='thoughtful of the future; "careful forethoughtful planning"'/>
<rdf:Description rdf:about="&a;301823683"
	 b:glossaryEntry="not provident; not providing for the future"/>
<rdf:Description rdf:about="&a;301823892"
	 b:glossaryEntry='marked by rash extravagance; "led a prodigal life"'/>
<rdf:Description rdf:about="&a;301823997">
	<b:glossaryEntry>lacking foresight or scope; "a short view of the problem"; "shortsighted policies"; "shortsighted critics derided the plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301824204"
	 b:glossaryEntry="careless of the future"/>
<rdf:Description rdf:about="&a;301824283"
	 b:glossaryEntry="lacking forethought"/>
<rdf:Description rdf:about="&a;301824365">
	<b:glossaryEntry>serving or tending to provoke, excite, or stimulate; "a provocative remark"; "a provocative smile"; "provocative Irish tunes which...compel the hearers to dance"- Anthony Trollope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301824710">
	<b:glossaryEntry>causing or tending to cause anger or resentment; "a provoking delay at the airport"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301824873"
	 b:glossaryEntry='disturbingly provocative; "an intriguing smile"'/>
<rdf:Description rdf:about="&a;301824992">
	<b:glossaryEntry>capable of producing violent emotion or arousing controversy; "the highly charged issue of abortion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301825146"
	 b:glossaryEntry="arousing to action or rebellion"/>
<rdf:Description rdf:about="&a;301825303">
	<b:glossaryEntry>rousing to activity or heightened action as by spurring or goading; "tossed a rousing political comment into the conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301825483"
	 b:glossaryEntry="not provocative"/>
<rdf:Description rdf:about="&a;301825644"
	 b:glossaryEntry="capable of allaying hostility"/>
<rdf:Description rdf:about="&a;301825729"
	 b:glossaryEntry="not inflammatory"/>
<rdf:Description rdf:about="&a;301825807">
	<b:glossaryEntry>careful and sensible; marked by sound judgment; "a prudent manager"; "prudent rulers"; "prudent hesitation"; "more prudent to hide than to fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301826150">
	<b:glossaryEntry>heedful of potential consequences; "circumspect actions"; "physicians are now more circumspect about recommending its use"; "a discreet investor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301826364">
	<b:glossaryEntry xml:space='preserve'><![CDATA[marked by the exercise of good judgment or common sense in practical matters; "judicious use of one''s money"; "a sensible manager"; "a wise decision"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301826587">
	<b:glossaryEntry>careful in regard to your own interests; "the prudent use and development of resources"; "wild squirrels are provident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301826762">
	<b:glossaryEntry>arising from or characterized by prudence especially in business matters; "he abstained partly for prudential reasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301826937">
	<b:glossaryEntry>not prudent or wise; "very imprudent of her mother to encourage her in such silly romantic ideas"; "would be imprudent for a noneconomist to talk about the details of economic policy"- A.M.Schlesinger</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301827337">
	<b:glossaryEntry>without preparation or forethought or knowledge; "a blind attempt"; "a blind purchase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301827475">
	<b:glossaryEntry>lacking or showing a lack of careful deliberation; unwise; "ill-advised efforts"; "ill-advised laws"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301827633">
	<b:glossaryEntry>not given careful consideration; "ill-considered actions often result in disaster"; "an ill-judged attempt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301827843">
	<b:glossaryEntry>lacking or showing lack of judgment or discretion; unwise; "an injudicious measure"; "the result of an injudicious decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301828025">
	<b:glossaryEntry>imprudently incurring risk; "do something rash that he will forever repent"- George Meredith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301828168">
	<b:glossaryEntry>affecting the mind or mood or other mental processes; "psychoactive drugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301828388">
	<b:glossaryEntry>capable of producing hallucinations; "LSD is a powerful hallucinogenic drug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301828525">
	<b:glossaryEntry>producing mood changes or distorted perception; "hallucinogenic drugs are mind-altering substances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301828684">
	<b:glossaryEntry>(informal) intensely affecting the mind especially in producing hallucinations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301828836">
	<b:glossaryEntry>producing distorted sensory perceptions and feelings or altered states of awareness or sometimes states resembling psychosis; "psychedelic drugs like psilocybin and mescaline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301829069"
	 b:glossaryEntry="not affecting the mind or mental processes"/>
<rdf:Description rdf:about="&a;301829173">
	<b:glossaryEntry>acting or arriving or performed exactly at the time appointed; "she expected guests to be punctual at meals"; "he is not a particularly punctual person"; "punctual payment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301829436">
	<b:glossaryEntry>according to schedule or without delay; "they were always on time"; "a prompt reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301829583">
	<b:glossaryEntry>before a time limit expires; "the timely filing of his income tax return"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301829709"
	 b:glossaryEntry="not punctual; after the appointed time"/>
<rdf:Description rdf:about="&a;301829894"
	 b:glossaryEntry='behind schedule; "was behindhand with the rent"'/>
<rdf:Description rdf:about="&a;301829998">
	<b:glossaryEntry xml:space='preserve'><![CDATA[after the expected or usual time; delayed; "a belated birthday card"; "I''m late for the plane"; "the train is late"; "tardy children are sent to the principal"; "always tardy in making dental appointments"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301830272">
	<b:glossaryEntry>overtaken by night or darkness; "benighted (or nighted) travelers hurrying toward home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301830425"
	 b:glossaryEntry="inclined to waste time and lag behind"/>
<rdf:Description rdf:about="&a;301830527">
	<b:glossaryEntry>just before a deadline; at the last minute; "last-minute arrangements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301830655">
	<b:glossaryEntry>sharp biting or acrid especially in taste or smell; "tasting the pungent wood sorrel"; "pungent curry"; "a pungent smell of burning sulfur"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301830920"
	 b:glossaryEntry='strong and sharp; "the acrid smell of buorning rubber"'/>
<rdf:Description rdf:about="&a;301831026">
	<b:glossaryEntry>tasting or smelling of onions or garlic; "snails in a garlicky sauce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301831163">
	<b:glossaryEntry>having a piquant burning taste of spices or peppers; "gingery Chinese food"; "hot peppers"; "hot curry"; "corn chips with peppery salsa"; "spicy tomato sauce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301831399">
	<b:glossaryEntry>lacking either stimulating or irritating characteristics; "a bland pudding"; "a bland diet for her irritated stomach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301831568">
	<b:glossaryEntry>subjected to a penalty (as pain or shame or restraint or loss) for an offense or fault or in order to coerce some behavior (as a confession or obedience)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301831884"
	 b:glossaryEntry="punished especially by reproof or reprimand"/>
<rdf:Description rdf:about="&a;301832031">
	<b:glossaryEntry>officially rebuked or found blameworthy; "the censured senator did not run for another term"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301832178">
	<b:glossaryEntry>punished for misbehavior; "the chastised child sat humbly in the corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301832332"
	 b:glossaryEntry="punished by the imposition of a penalty"/>
<rdf:Description rdf:about="&a;301832435">
	<b:glossaryEntry>smeared with tar and covered with feathers as a punishment; "the poor tarred-and-feathered wretch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301832603"
	 b:glossaryEntry='subjected to intense pain; "hundreds of tortured prisoners"'/>
<rdf:Description rdf:about="&a;301832717">
	<b:glossaryEntry>not punished; "would he forget the crime and let it go unpunished?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301832877"
	 b:glossaryEntry="not subjected to reproof or rebuke"/>
<rdf:Description rdf:about="&a;301833009">
	<b:glossaryEntry>not subjected to correction or discipline; "let her children grow up uncorrected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301833164">
	<b:glossaryEntry>inflicting punishment; "punitive justice"; "punitive damages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301833345">
	<b:glossaryEntry>concerned with or providing correction; "a correctional institution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301833472">
	<b:glossaryEntry>serving as or designed to impose punishment; "penal servitude"; "a penal colony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301833604">
	<b:glossaryEntry>used for punishment or reform of criminals or wrongdoers; "penitentiary institutions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301833748">
	<b:glossaryEntry>designed to accomplish rehabilitation; "from a penal to a rehabilitative philosophy"- J.B.Costello; "rehabilitative treatment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301833935">
	<b:glossaryEntry>bred for many generation from member of a recognized breed or strain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301834112">
	<b:glossaryEntry>of unmixed ancestry; "full-blooded Natigve American"; "blooded Jersies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301834252">
	<b:glossaryEntry>having a list of ancestors as proof of being a purebred animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301834425"
	 b:glossaryEntry="bred from a mixture of breeds or strains"/>
<rdf:Description rdf:about="&a;301834629"
	 b:glossaryEntry="resulting from a cross between species of different genera"/>
<rdf:Description rdf:about="&a;301834743"
	 b:glossaryEntry="produced by crossbreeding"/>
<rdf:Description rdf:about="&a;301834858"
	 b:glossaryEntry='of inferior or mixed breed; "a cur dog"; "an underbred dog"'/>
<rdf:Description rdf:about="&a;301835014"
	 b:glossaryEntry="(of animals) having only one purebred parent"/>
<rdf:Description rdf:about="&a;301835142">
	<b:glossaryEntry>used of persons or behaviors; having no faults; sinless; "I felt pure and sweet as a new baby"- Sylvia Plath; "pure as the driven snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301835400"
	 b:glossaryEntry="free from stain or blemish"/>
<rdf:Description rdf:about="&a;301835495">
	<b:glossaryEntry>free from moral blemish or impurity; unsullied; "in shining white armor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301835619">
	<b:glossaryEntry>used of persons or behaviors; not morally pure; "impure thoughts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301835791"
	 b:glossaryEntry="morally blemished; stained or impure"/>
<rdf:Description rdf:about="&a;301835892">
	<b:glossaryEntry xml:space='preserve'><![CDATA[free of extraneous elements of any kind; "pure air and water"; "pure gold"; "pure primary colors"; "the violin''s pure and lovely song"; "pure tones"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301836379">
	<b:glossaryEntry>used of cultures of microorganisms; not contaminated by or completely free of the presence of other organisms; "an axenic culture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301836562"
	 b:glossaryEntry='free from impurities; "clean water"; "fresh air"'/>
<rdf:Description rdf:about="&a;301836670">
	<b:glossaryEntry>(of sound or color) free from anything that dulls or dims; "efforts to obtain a clean bass in orchestral recordings"; "clear laughter like a waterfall"; "clear reds and blues"; "a light lilting voice like a silver bell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301836969">
	<b:glossaryEntry>(metallurgy) having a high or specified degree of purity; "gold 21 carats fine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301837104"
	 b:glossaryEntry='as found in nature in the elemental form; "native copper"'/>
<rdf:Description rdf:about="&a;301837214">
	<b:glossaryEntry>not mixed with extraneous elements; "plain water"; "sheer wine"; "not an unmixed blessing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301837386">
	<b:glossaryEntry>completely free from dirt or contamination; "pristine mountain snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301837509"
	 b:glossaryEntry="made pure"/>
<rdf:Description rdf:about="&a;301837595">
	<b:glossaryEntry>composed of only one thing or element or part; "a simple substance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301837715">
	<b:glossaryEntry>not mixed with impurities; "unadulterated maple syrup"; "the unadulterated truth"; "here is genius unadulterated"- Amy Loveman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301837901"
	 b:glossaryEntry="used of metals"/>
<rdf:Description rdf:about="&a;301837971">
	<b:glossaryEntry>free from admixture with noxious elements; clean; "unpolluted streams"; "a contaminated lake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301838138">
	<b:glossaryEntry>untouched or undefiled; "nor is there anything more virginal than the shimmer of young foliage"- L.P.Smith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301838299"
	 b:glossaryEntry="combined with extraneous elements"/>
<rdf:Description rdf:about="&a;301838565"
	 b:glossaryEntry="mixed with impurities"/>
<rdf:Description rdf:about="&a;301838667">
	<b:glossaryEntry>(used of metals) debased by mixture with an infereior element</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301838782"
	 b:glossaryEntry="(fine arts) deriving from more than one source or style"/>
<rdf:Description rdf:about="&a;301838895"
	 b:glossaryEntry="used of color"/>
<rdf:Description rdf:about="&a;301838964">
	<b:glossaryEntry>rendered unwholesome by contaminants and pollution; "had to boil the contaminated water"; "polluted lakes and streams"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301839152">
	<b:glossaryEntry>(of color) discolored by impurities; not bright and clear; "dirty" is often used in combination; "a dirty (or dingy) white"; "the muddied gray of the sea"; "muddy colors"; "dirty-green walls"; "dirty-blonde hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301839442"
	 b:glossaryEntry="not made pure"/>
<rdf:Description rdf:about="&a;301839512"
	 b:glossaryEntry='corrupted by contact or association; "contaminated evidence"'/>
<rdf:Description rdf:about="&a;301839631">
	<b:glossaryEntry>not corrupted by contact or association; "there is no culture uncontaminated by contact with the outside world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301839803"
	 b:glossaryEntry="serving as or indicating the existence of a purpose or goal"/>
<rdf:Description rdf:about="&a;301840027"
	 b:glossaryEntry="not distracted by anything unrelated to the goal"/>
<rdf:Description rdf:about="&a;301840144"
	 b:glossaryEntry='having a purpose; "purposive behavior"'/>
<rdf:Description rdf:about="&a;301840254">
	<b:glossaryEntry>purposefully formulated to elicit a desired response; "a leading question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301840382"
	 b:glossaryEntry="designed and constructed to serve a particular purpose"/>
<rdf:Description rdf:about="&a;301840511"
	 b:glossaryEntry="not evidencing any purpose of goal"/>
<rdf:Description rdf:about="&a;301840657"
	 b:glossaryEntry="aimlessly drifting"/>
<rdf:Description rdf:about="&a;301840806">
	<b:glossaryEntry>marked by lack of definite plan or regularity or purpose; jumping from one thing to another; "desultory thoughts"; "the desultory conversation characteristic of cocktail parties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301841040">
	<b:glossaryEntry>meeting the proper standards and requirements and training for an office or position or task; "many qualified applicants for the job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301841283"
	 b:glossaryEntry='more than adequately qualified; "a well-qualified officer"'/>
<rdf:Description rdf:about="&a;301841402">
	<b:glossaryEntry>not meeting the proper standards and requirements and training</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301841576"
	 b:glossaryEntry='medically unqualified; "a quack doctor"'/>
<rdf:Description rdf:about="&a;301841670">
	<b:glossaryEntry>shaped or conditioned or disciplined by training; often used as a combining form; "a trained mind"; "trained pigeons"; "well-trained servants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301841956">
	<b:glossaryEntry>trained mentally or physically by instruction or exercise; "the beautiful coordination of his disciplined muscles"; "a disciplined mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301842150">
	<b:glossaryEntry>trained in a skill by repetitious practice; "well-drilled in military procedures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301842285">
	<b:glossaryEntry>trained to the highest degree of physical excellence; "a fine racehorse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301842408">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of pets; trained to urinate and defecate outside or in a special place; "housebroken pets"; "`house-trained'' is chiefly British"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301842610"
	 b:glossaryEntry="(of children) trained to use the toilet"/>
<rdf:Description rdf:about="&a;301842740">
	<b:glossaryEntry>not disciplined or conditioned or made adept by training; "an untrained voice"; "untrained troops"; "young minds untrained in the habit of concentration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301842985">
	<b:glossaryEntry>(fine arts) of or created by one without formal training; simple or naive in style; "primitive art such as that by Grandma Moses is often colorful and striking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301843201"
	 b:glossaryEntry='not subjected to discipline; "undisciplined talent"'/>
<rdf:Description rdf:about="&a;301843312">
	<b:glossaryEntry>limited or restricted; not absolute; "gave only qualified approval"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301843525"
	 b:glossaryEntry="qualified by reservations"/>
<rdf:Description rdf:about="&a;301843608"
	 b:glossaryEntry="evasively worded in order to avoid an unqualified statement"/>
<rdf:Description rdf:about="&a;301843736"
	 b:glossaryEntry="mediocre"/>
<rdf:Description rdf:about="&a;301843809"
	 b:glossaryEntry='not limited or restricted; "an unqualified denial"'/>
<rdf:Description rdf:about="&a;301844025">
	<b:glossaryEntry>not modified or restricted by reservations; "a categorical denial"; "a flat refusal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301844202">
	<b:glossaryEntry>free of restrictions or qualifications; "a clean bill of health"; "a clear winner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301844344">
	<b:glossaryEntry>(informal; of a number or sum) without exaggeration or qualification; "a cool million bucks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301844500"
	 b:glossaryEntry="without reservation or exception"/>
<rdf:Description rdf:about="&a;301844614">
	<b:glossaryEntry>involving distinctions based on qualities; "qualitative change"; "qualitative data"; "qualitative analysis determines the chemical constituents of a substance or mixture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301844842">
	<b:glossaryEntry>expressible as a quantity or relating to or susceptible of measurement; "export wheat without quantitative limitations"; "quantitative analysis determines the amounts and proportions of the chemical constituents of a substance or mixture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301845265">
	<b:glossaryEntry>divided by tens or hundreds; "a decimal fraction"; "decimal coinage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301845387">
	<b:glossaryEntry>numbered or proceeding by tens; based on ten; "the decimal system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301845516"
	 b:glossaryEntry='based on twelve; "the duodecimal number system"'/>
<rdf:Description rdf:about="&a;301845620">
	<b:glossaryEntry>measured or expressed in numbers; "numerical value"; "the numerical superiority of the enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301845779"
	 b:glossaryEntry="capable of being quantified"/>
<rdf:Description rdf:about="&a;301845865">
	<b:glossaryEntry>(of numbers) written with three figures; "100 through 999 are three-figure numbers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301846007">
	<b:glossaryEntry>(usu. used in combination) having value of a specified kind; "triple-valued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301846136">
	<b:glossaryEntry>subject to question; "questionable motives"; "a questionable reputation"; "a fire of questionable origin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301846462"
	 b:glossaryEntry='doubtful or suspect; "these so-called experts are no help"'/>
<rdf:Description rdf:about="&a;301846600"
	 b:glossaryEntry="of questionable authenticity"/>
<rdf:Description rdf:about="&a;301846685">
	<b:glossaryEntry>open to doubt or debate; "If you ever get married, which seems to be extremely problematic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301846862">
	<b:glossaryEntry xml:space='preserve'><![CDATA[open to doubt or suspicion; "the candidate''s doubtful past"; "he has a dubious record indeed"; "what one found uncertain the other found dubious or downright false"; "it was more than dubitable whether the friend was as influential as she thought"- Karen Horney]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301847217">
	<b:glossaryEntry>open to question; "aliens of equivocal loyalty"; "his conscience reproached him with the equivocal character of the union into which he had forced his son"-Anna Jameson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301847441">
	<b:glossaryEntry>(informal) not as expected; "there was something fishy about the accident"; "up to some funny business"; "some definitely queer goings-on"; "a shady deal"; "her motives were suspect"; "suspicious behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301847745"
	 b:glossaryEntry="subject to being discredited"/>
<rdf:Description rdf:about="&a;301847830">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as claimed by and for yourself often without justification; "the self-styled `doctor'' has no degree of any kind"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301848000"
	 b:glossaryEntry='impossible to question; "unquestionable authority"'/>
<rdf:Description rdf:about="&a;301848273"
	 b:glossaryEntry="generally accepted"/>
<rdf:Description rdf:about="&a;301848350"
	 b:glossaryEntry="too obvious to be doubted"/>
<rdf:Description rdf:about="&a;301848451"
	 b:glossaryEntry='not open to doubt; "she wanted to go; that was for sure"'/>
<rdf:Description rdf:about="&a;301848562"
	 b:glossaryEntry='beyond question; "a mathematical certainty"'/>
<rdf:Description rdf:about="&a;301848664">
	<b:glossaryEntry>not open to challenge; "unchallengeable facts"; "a position of unchallengeable supremacy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301848815"
	 b:glossaryEntry='accepted without question; "undoubted evidence"'/>
<rdf:Description rdf:about="&a;301848961"
	 b:glossaryEntry='beyond doubt or reproach; "an unimpeachable source"'/>
<rdf:Description rdf:about="&a;301849072">
	<b:glossaryEntry>(of film) having no spoken dialogue and usually no soundtrack; "a silent movie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301849204">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of film) having spoken dialogue; "early talking pictures were known as `talkies''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301849351">
	<b:glossaryEntry>free of noise or uproar; or making little if any sound; "a quiet audience at the concert"; "the room was dark and quiet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301849667"
	 b:glossaryEntry="quiet and stealthy"/>
<rdf:Description rdf:about="&a;301849739"
	 b:glossaryEntry='quiet and relaxing; "dreamy music"'/>
<rdf:Description rdf:about="&a;301849826">
	<b:glossaryEntry xml:space='preserve'><![CDATA[making no sound; "th'' inaudible and noiseless foot of time"- Shakespeare]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301849954">
	<b:glossaryEntry>marked by absence of sound; "a silent house"; "soundless footsteps on the grass"; "the night was still"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301850130"
	 b:glossaryEntry='(poetic) still or calm; "in the stilly night"'/>
<rdf:Description rdf:about="&a;301850228">
	<b:glossaryEntry xml:space='preserve'><![CDATA[walking on the tips of ones''s toes so as to make no noise; "moving with tiptoe steps"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301850366">
	<b:glossaryEntry>full of or characterized by loud and nonmusical sounds; "a noisy cafeteria"; "a small noisy dog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301850928">
	<b:glossaryEntry>being or resembling the noise of things striking or bumping together repeatedly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301851061">
	<b:glossaryEntry>crying out loudly; "a bawling calf just separated from its mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301851181">
	<b:glossaryEntry>conspicuously and offensively loud; given to vehement outcry; "blatant radios"; "a clamorous uproar"; "strident demands"; "a vociferous mob"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301851434">
	<b:glossaryEntry>noisy like the sound of a bee; "the room was abuzz over the latest scandal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301851581">
	<b:glossaryEntry>having a loud resonant metallic sound; "the clangorous locomotive works"; "a clanging gong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301851740">
	<b:glossaryEntry>having a hard nonresonant metallic sound; "clanking chains"; "the clanking arms of the soldiers near him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301851900">
	<b:glossaryEntry>a rattling sound as of hard things striking together; "a clattering typewriter"; "the clattering sound of dishes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301852081">
	<b:glossaryEntry>making a loud sharp sound as of a rifle shot or a breaking branch or a whip; "lion tamers with their cracking whips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301852252">
	<b:glossaryEntry>having a series of short sharp noises; "longed for a big fire with snapping logs"; "folding a crackling newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301852433">
	<b:glossaryEntry>having a rasping or grating sound; "they were alerted by the creaking gate"; "creaky stairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301852599">
	<b:glossaryEntry>noisy with or as if with loud cries and shouts; "a crying mass of rioters"; "a howling wind"; "shouting fans"; "the yelling fiend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301852813">
	<b:glossaryEntry xml:space='preserve'><![CDATA[like a sustained `s''; "`hissing'' is the sound a snake makes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301852927"
	 b:glossaryEntry="uncontrollably noisy"/>
<rdf:Description rdf:about="&a;301853028"
	 b:glossaryEntry="having a tone of a reed instrument"/>
<rdf:Description rdf:about="&a;301853123">
	<b:glossaryEntry>loud and sustained; shrill and piercing; "hordes of screaming fans"; "a screaming jet plane"; "a screaming fury of sound"; "a screeching parrot"; "screeching brakes"; "a horde of shrieking fans"; "shrieking winds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301853426">
	<b:glossaryEntry>emitting or making sporadic spitting or popping sounds; "the sputtering engine"; "spluttering electric arcs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301853605"
	 b:glossaryEntry="of breathing having a heavy snoring sound"/>
<rdf:Description rdf:about="&a;301853703">
	<b:glossaryEntry xml:space='preserve'><![CDATA[resembling a sustained `sh'' or soft whistle; "swishing windshield wipers"; "a swishy skirt"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301853858"
	 b:glossaryEntry='sounding like thunder; "the thundering herd"'/>
<rdf:Description rdf:about="&a;301853959"
	 b:glossaryEntry="long and high-pitched like a whine or plaintive crying"/>
<rdf:Description rdf:about="&a;301854067"
	 b:glossaryEntry="like the sound of rapidly vibrating wings"/>
<rdf:Description rdf:about="&a;301854163">
	<b:glossaryEntry>characterized by an absence or near absence of agitation or activity; "a quiet life"; "a quiet throng of onlookers"; "quiet peace-loving people"; "the factions remained quiet for almost 10 years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301854536">
	<b:glossaryEntry>marked by a state of tranquil repose; "the quiescent melancholy of the town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301854668">
	<b:glossaryEntry>affording or marked by rest or repose; "the time spent was pleasant and relaxing"; "a restful night"; "a cool and reposeful glen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301854874"
	 b:glossaryEntry='quiet and tranquil; "a slumberous June morning"'/>
<rdf:Description rdf:about="&a;301854990"
	 b:glossaryEntry='free from turmoil or worries; "untroubled times"'/>
<rdf:Description rdf:about="&a;301855095">
	<b:glossaryEntry>characterized by unrest or disorder; "unquiet days of riots"; "following the assassination of Martin Luter King ours was an unquiet nation"; "spent an unquiet night tossing and turning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301855460">
	<b:glossaryEntry>characterized by unrest or disorder or insubordination; "effects of the struggle will be violent and disruptive"; "riotous times"; "these troubled areas"; "the tumultuous years of his administration"; "a turbulent and unruly childhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301855798">
	<b:glossaryEntry>unable to relax or be still; "a constant fretful stamping of hooves"; "itchy for excitement"; "a restless child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301855993">
	<b:glossaryEntry>characterized by short periods of noisy commotion; "a home life that has been extraordinarily squally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301856161">
	<b:glossaryEntry>marked by a lack of quiet; not conducive to rest; "spent a restless night"; "fell into an uneasy sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301856328">
	<b:glossaryEntry>lacking any definite plan or order or purpose; governed by or depending on chance; "a random choice"; "bombs fell at random"; "random movements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301856561">
	<b:glossaryEntry>dependent upon or characterized by chance; "a haphazard plan of action"; "his judgment is rather hit-or-miss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301856740">
	<b:glossaryEntry>(statistics) being or having a random variable; "a stochastic variable"; "stochastic processes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301856892"
	 b:glossaryEntry="not random"/>
<rdf:Description rdf:about="&a;301856994">
	<b:glossaryEntry>not haphazard; "a series of orderly actions at regular hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301857122">
	<b:glossaryEntry>having or showing or acting with a purpose or design; "purposive behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301857252">
	<b:glossaryEntry>consistent with or based on or using reason; "rational behavior"; "a process of rational inference"; "rational thought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301857552">
	<b:glossaryEntry>capable of thinking and expressing yourself in a clear and consistent manner; "a lucid thinker"; "she was more coherent than she had been just after the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301857788"
	 b:glossaryEntry="having mythical elements removed"/>
<rdf:Description rdf:about="&a;301857881"
	 b:glossaryEntry="endowed with the capacity to reason"/>
<rdf:Description rdf:about="&a;301858003"
	 b:glossaryEntry='marked by sound judgment; "sane nuclear policy"'/>
<rdf:Description rdf:about="&a;301858114">
	<b:glossaryEntry>not consistent with or using reason; "irrational fears"; "irrational animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301858410">
	<b:glossaryEntry>not based on reason on evidence; "blind hatred"; "unreasonable expectations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301858567">
	<b:glossaryEntry>unable to think or express your thoughts in a clear or orderly manner; "incoherent with grief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301858718">
	<b:glossaryEntry>not endowed with the capacity to reason; "a reasonless brute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301858836">
	<b:glossaryEntry>(archaic) showing or experiencing a state of disordered feeling or distorted judgment as through bitterness or melancholy; "all looks yellow to the jaundiced eye"-Alexander Pope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301859078">
	<b:glossaryEntry>not based on reason; "there is a great deal that is nonrational in modern culture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301859218">
	<b:glossaryEntry>showing ignorance or the laws of nature and faith in magic or chance; "finally realized that the horror he felt was superstitious in origin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301859418">
	<b:glossaryEntry>determined or actuated by emotion rather than reason; "it was an emotional judgment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301859558">
	<b:glossaryEntry>involving intelligence rather than emotions or instinct; "a cerebral approach to the problem"; "cerebral drama"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301859739">
	<b:glossaryEntry>of or characteristic of race or races or arising from differences among groups; "racial differences"; "racial discrimination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301859989"
	 b:glossaryEntry='consisting of or combining two races; "a biracial committee"'/>
<rdf:Description rdf:about="&a;301860104">
	<b:glossaryEntry>involving or existing between two or more races; "interracial neighborhoods"; "interracial politics"; "interracial marriage"; "interracial understanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301860315">
	<b:glossaryEntry>made up of or involving or acting on behalf of various races; "a multiracial society"; "multiracial government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301860484"
	 b:glossaryEntry='based on racial intolerance; "racist remarks"'/>
<rdf:Description rdf:about="&a;301860582">
	<b:glossaryEntry>not racial; having nothing to do with race or races; "his remarks were intended to be completely nonracial"; "a nonracial reason for the peremptory challenge of the juror"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301860809">
	<b:glossaryEntry>(chemistry and physics) participating readily in reactions; "sodium is a reactive metal"; "free radicals are very reactive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301861041"
	 b:glossaryEntry="(physics) of e.g. a molecule; made reactive or more reactive"/>
<rdf:Description rdf:about="&a;301861167"
	 b:glossaryEntry="capable of undergoing a chemical reaction with oxygen"/>
<rdf:Description rdf:about="&a;301861277">
	<b:glossaryEntry>highly or violently reactive; "sensitive and highly unstable compounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301861403"
	 b:glossaryEntry="(chemistry and physics) not reacting chemically"/>
<rdf:Description rdf:about="&a;301861579">
	<b:glossaryEntry>not participating in a chemical reaction; "desired amounts of inactive chlorine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301861714">
	<b:glossaryEntry>(chemistry) having only a limited ability to react chemically; not active; "inert matter"; "an indifferent chemical in a reaction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301861920">
	<b:glossaryEntry>inert especially toward oxygen; "a noble gas such as helium or neon"; "noble metals include gold and silver and platinum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301862093"
	 b:glossaryEntry="not taking part readily in chemical change"/>
<rdf:Description rdf:about="&a;301862188">
	<b:glossaryEntry>having been read; often used in combination; "a widely read newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301862309">
	<b:glossaryEntry>not having been read; "through sheer mischance the letter remained unread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301862436">
	<b:glossaryEntry>completely prepared or in condition for immediate action or use or progress; "get ready"; "she is ready to resign"; "the bridge is ready to collapse"; "I am ready to work"; "ready for action"; "ready for use"; "the soup will be ready in a minute"; "ready to learn to read"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301862922">
	<b:glossaryEntry>ready for immediate use; "soldiers with guns at the ready"; "students with pens and notebooks at the ready"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301863091">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'' or `for'') on the point of or strongly disposed; "she was fit to scream"; "primed for a fight"; "we are set to go at any time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301863316">
	<b:glossaryEntry>in a state of proper readiness or preparation or arrangement; "everything is in order for their arrival"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301863475">
	<b:glossaryEntry>quick in apprehending or reacting; "a prompt (or ready) response"; "a ready smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301863610">
	<b:glossaryEntry>fully prepared or eager; "the colonists were ripe for revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301863729">
	<b:glossaryEntry>being and remaining ready and available for use; "waiting cars and limousines lined the curb"; "found her mother waiting for them"; "an impressive array of food ready and waiting for the guests"; "military forces ready and waiting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301864037">
	<b:glossaryEntry>not prepared or in a state of readiness; slow to understand or respond; "she cursed her unready tongue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301864302">
	<b:glossaryEntry>unprepared and unable to react quickly; "the new product caught their competitors flat-footed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301864454">
	<b:glossaryEntry>not prepared or vigilant; "the blow caught him napping"; "caught in an off-guard moment"; "found him off his guard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301864723">
	<b:glossaryEntry>not put in a state of preparedness; "the machinery was unprepared for the extra load"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301864865"
	 b:glossaryEntry="not fully prepared"/>
<rdf:Description rdf:about="&a;301864936">
	<b:glossaryEntry>being or occurring in fact or actuality; having verified existence; not illusory; "real objects"; "real people; not ghosts"; "a film based on real life"; "a real illness"; "real humility"; "Life is real! Life is earnest!"- Longfellow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301865375">
	<b:glossaryEntry>taking place in reality; not pretended or imitated; "we saw the actual wedding on television"; "filmed the actual beating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301865550">
	<b:glossaryEntry>of the nature of fact; having actual existence; "rocks and trees...the actual world"; "actual heroism"; "the actual things that produced the emotion you experienced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301865778">
	<b:glossaryEntry>having once lived or existed or taken place in the real world as distinct from being legendary; "the historical Jesus"; "doubt that a historical Camelot every existed"; "actual historical events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301866030">
	<b:glossaryEntry>lacking in reality or substance or genuineness; not corresponding to acknowledged facts or criteria; "ghosts and other unreal entities"; "unreal propaganda serving as news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301866579">
	<b:glossaryEntry>conceived of or imagined or hoped for; "his dreamed symphony that would take the world of music by storm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301866741">
	<b:glossaryEntry>seen in the mind as a mental image; "the glory of his envisioned future"; "the snow-covered Alps pictured in her imagination"; "the visualized scene lacked the ugly details of real life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301867008">
	<b:glossaryEntry xml:space='preserve'><![CDATA[creating the illusion of seeing reality; "the visual deception of trompe-l''oeil art"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301867171">
	<b:glossaryEntry>celebrated in fable or legend; "the fabled Paul Bunyan and his blue ox"; "legendary exploits of Jesse James"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301867344">
	<b:glossaryEntry>formed or conceived by the imagination; "a fabricated excuse for his absence"; "a fancied wrong"; "a fictional character"; "used fictitious names"; "a made-up story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301867622">
	<b:glossaryEntry>based on or told of in traditional stories; lacking factual basis or historical validity; "mythical centaurs"; "the fabulous unicorn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301867858">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not based on fact; dubious; "the falsehood about some fanciful secret treaties"- F.D.Roosevelt; "a small child''s imaginary friends"; "her imagined fame"; "to create a notional world for oneself"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301868141">
	<b:glossaryEntry>existing in fancy only; "fantastic figures with bulbous heads the circumference of a bushel"- Nathaniel Hawthorne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301868324">
	<b:glossaryEntry>partaking of hallucination; "fleeing in terror from hallucinatory wolves"; "the bizarre hallucinatory dreams of fever"- Jean Stafford</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301868517"
	 b:glossaryEntry='marked by or producing illusion; "illusionary stage effects"'/>
<rdf:Description rdf:about="&a;301868648">
	<b:glossaryEntry>based on or having the nature of an illusion; "illusive hopes of of finding a better job"; "Secret activities offer presidents the alluring but often illusory promise that they can achieve foreign policy goals without the bothersome debate and open decision that are staples of democracy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301869002">
	<b:glossaryEntry>imagined as in a play; "the make-believe world of theater"; "play money"; "dangling their legs in the water to catch pretend fish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301869211">
	<b:glossaryEntry xml:space='preserve'><![CDATA[no less than what is stated; worthy of the name; "the real reason"; "real war"; "a real friend"; "a real woman"; "meat and potatoes--I call that a real meal"; "it''s time he had a real job"; "it''s no penny-ante job--he''s making real money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301869539">
	<b:glossaryEntry>having all the qualities typical of the thing specified; "wanted a proper dinner; not just a snack"; "he finally has a proper job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301869725">
	<b:glossaryEntry>rightly so called; "true courage"; "a spirit which true men have always admired"; "a true friend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301869876">
	<b:glossaryEntry>not actually such; being or seeming fanciful or imaginary; "this conversation is getting more and more unreal"; "the fantastically unreal world of government bureaucracy"; "the unreal world of advertising art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301870192">
	<b:glossaryEntry>causing one to believe what is not true or fail to believe what is true; "deceptive calm"; "a delusory pleasure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301870371">
	<b:glossaryEntry>resembling a dream; "night invested the lake with a dreamlike quality"; "as irrational and surreal as a dream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301870547">
	<b:glossaryEntry xml:space='preserve'><![CDATA[something apparently sensed but having no physical reality; "seemed to hear faint phantom bells"; "the amputee''s illusion of a phantom limb"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301870741">
	<b:glossaryEntry>(economics) being value measured in terms of purchasing power; "real prices"; "real income"; "real wages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301870897">
	<b:glossaryEntry>(economics) being value in terms of specification on currency or stock certificates rather than purchasing power; "nominal or face value"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301871088">
	<b:glossaryEntry>aware or expressing awareness of things as they really are; "a realistic description"; "a realistic view of the possibilities"; "a realistic appraisal of our chances"; "the actors tried to create a realistic portrayal of the Africans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301871576">
	<b:glossaryEntry>sensible and practical; "has a straightforward down-to-earth approach to a problem"; "her earthy common sense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301871755">
	<b:glossaryEntry>guided by practical experience and observation rather than theory; "a hardheaded appraisal of our position"; "a hard-nosed labor leader"; "completely practical in his approach to business"; "not ideology but pragmatic politics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301872076">
	<b:glossaryEntry>evoking lifelike images within the mind; "pictorial poetry and prose"; "graphic accounts of battle"; "a lifelike portrait"; "a vivid description"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301872306"
	 b:glossaryEntry='true to life; lifelike; "the living image of her mother"'/>
<rdf:Description rdf:about="&a;301872415">
	<b:glossaryEntry>founded on practical matters; "a recent graduate experiencing the real world for the first time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301872562">
	<b:glossaryEntry>representing things or actions or conditions as they actually are; "the novel about ghetto life was true to life"; "true-to-life duck decoys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301872783">
	<b:glossaryEntry>coinciding with reality; "perceptual error...has a surprising resemblance to veridical perception"- F.A.Olafson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301872957">
	<b:glossaryEntry>being actually such in almost every respect; "a practical failure"; "the once elegant temple lay in virtual ruin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301873142">
	<b:glossaryEntry>not realistic; "unrealistic expectations"; "prices at unrealistic high levels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301873440">
	<b:glossaryEntry>produced by a wildly fanciful imagination; "his Utopia is not a chimerical commonwealth but a practical improvement on what already exists"- Douglas Bush</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301873650">
	<b:glossaryEntry>inappropriate to reality or facts; "delusive faith in a wonder drug"; "delusive expectations"; "false hopes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301873821">
	<b:glossaryEntry>extravagantly fanciful and unrealistic; foolish; "a fantastic idea of his own importance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301873966">
	<b:glossaryEntry>characterized by surreal distortion and a sense of impending danger; "the kafkaesque terror of the endless interrogations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301874145">
	<b:glossaryEntry>characterized by fantastic imagery and incongruous juxtapositions; "a great concourse of phantasmagoric shadows"- J.C.Powys; "the incongruous imagery in surreal art and literature"; "</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301874433">
	<b:glossaryEntry>absurd and inappropriate; "the unreasonable nimbus of romance with which she had encircled that man"- Thomas Hardy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301874606">
	<b:glossaryEntry>showing reason or sound judgment; "a sensible choice"; "a sensible person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301874910">
	<b:glossaryEntry>exhibiting native good judgment; "arrive home at a reasonable hour"; "commonsense scholarship on the foibles of a genius"; "unlearned and commonsensical countryfolk were capable of solving problems that beset the more sophisticated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301875234">
	<b:glossaryEntry>exercising or showing good judgment; "healthy scepticism"; "a healthy fear of rattlesnakes"; "the healthy attitude of French laws"; "healthy relations between labor and management"; "an intelligent solution"; "a sound approach to the problem";"sound advice"; "no reasonable explanation for his decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301875627">
	<b:glossaryEntry>based on known statements or events or conditions; "rain was a logical expectation, given the time of year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301875788">
	<b:glossaryEntry>based on sound reasoning or evidence; "a reasonable argument"; "well-founded suspicions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301875945"
	 b:glossaryEntry="not reasonable; not showing good judgment"/>
<rdf:Description rdf:about="&a;301876171"
	 b:glossaryEntry="(of theories etc) incapable of being defended or justified"/>
<rdf:Description rdf:about="&a;301876300">
	<b:glossaryEntry>not marked by the use of reason; "mindless violence"; "reasonless hostility"; "a senseless act"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301876475">
	<b:glossaryEntry>lacking justification or authorization; "unreasonable searches and seizures"; "desire for undue private profit"; "unwarranted limitations of personal freedom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301876713">
	<b:glossaryEntry>concerning each of two or more persons or things; especially given or done in return; "reciprocal aid"; "reciprocal trade"; "reciprocal respect"; "reciprocal privileges at other clubs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301877135">
	<b:glossaryEntry>of or relating to or having the nature of retribution; "retributive justice demands an eye for an eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301877334">
	<b:glossaryEntry>of or relating to or suggestive of complementation; "interchangeable electric outlets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301877498">
	<b:glossaryEntry>(grammar) indicating a reciprocal or complementary relation; "correlative conjunctions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301877643"
	 b:glossaryEntry="capable of acting on or influencing each other"/>
<rdf:Description rdf:about="&a;301877763"
	 b:glossaryEntry='inversely related; "1/2 is the inverse of 2"'/>
<rdf:Description rdf:about="&a;301877861">
	<b:glossaryEntry>experienced or expressed by each toward the other; "mutual trust"; "a mutual defense treaty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301878006"
	 b:glossaryEntry="moving alternately backward and forward"/>
<rdf:Description rdf:about="&a;301878121"
	 b:glossaryEntry="given or done or owed to each other"/>
<rdf:Description rdf:about="&a;301878216"
	 b:glossaryEntry='returned in kind; "requited love"'/>
<rdf:Description rdf:about="&a;301878304"
	 b:glossaryEntry='of or relating to retaliation; "a retaliatory attack"'/>
<rdf:Description rdf:about="&a;301878429"
	 b:glossaryEntry="not reciprocal"/>
<rdf:Description rdf:about="&a;301878539"
	 b:glossaryEntry="not moving alternately forward and backward"/>
<rdf:Description rdf:about="&a;301878645"
	 b:glossaryEntry='not returned in kind; "unrequited (unanswered) love"'/>
<rdf:Description rdf:about="&a;301878784">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') no longer opposed; "after a time she became reconciled even to diplomatic receptions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301878963">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') having come to accept; "resigned to his fate"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301879085">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') not reconciled; "he remained unreconciled to the situation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301879222">
	<b:glossaryEntry>used of persons and their behavior; cultivated and genteel; "she was delicate and refined and unused to hardship"; "refined people with refined taste"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301879678">
	<b:glossaryEntry>marked by refinement in taste and manners; "cultivated speech"; "cultured Bostonians"; "cultured tastes"; "a genteel old lady"; "polite society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301879921"
	 b:glossaryEntry="used facetiously"/>
<rdf:Description rdf:about="&a;301879989"
	 b:glossaryEntry="affectedly dainty or refined"/>
<rdf:Description rdf:about="&a;301880110"
	 b:glossaryEntry='having a sophisticated charm; "a debonair gentleman"'/>
<rdf:Description rdf:about="&a;301880250">
	<b:glossaryEntry>developed with extreme delicacy and subtlety; "the satire touches with finespun ridicule every kind of human pretense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301880434"
	 b:glossaryEntry='befitting a man of good breeding; "gentlemanly behavior"'/>
<rdf:Description rdf:about="&a;301880564"
	 b:glossaryEntry='befitting a woman of good breeding; "ladylike manners"'/>
<rdf:Description rdf:about="&a;301880673"
	 b:glossaryEntry="excessively delicate or refined"/>
<rdf:Description rdf:about="&a;301880774"
	 b:glossaryEntry="of good upbringing"/>
<rdf:Description rdf:about="&a;301880864">
	<b:glossaryEntry>used of persons and their behavior; not refined; uncouth; "how can a refined girl be drawn to such an unrefined man?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301881325">
	<b:glossaryEntry>(of behavior) rustic and uncouth; "the agrestic behavior of a country boy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301881454"
	 b:glossaryEntry="(of persons) lacking art or knowledge"/>
<rdf:Description rdf:about="&a;301881573">
	<b:glossaryEntry>ill-mannered and coarse and contemptible in behavior or appearance; "was boorish and insensitive"; "the loutish manners of a bully"; "her stupid oafish husband"; "aristocratic contempt for the swinish multitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301881881">
	<b:glossaryEntry>lacking refinement or cultivation or taste; "he had coarse manners but a first-rate mind"; "behavior that branded him as common"; "an untutored and uncouth human being"; "an uncouth soldier--a real tough guy"; "appealing to the vulgar taste for violence"; "the vulgar display of the newly rich"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301882256">
	<b:glossaryEntry>(of persons) so unrefined as to be lacking in discrimination and sensibility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301882384"
	 b:glossaryEntry="(of persons) lacking in refinement or grace"/>
<rdf:Description rdf:about="&a;301882535"
	 b:glossaryEntry='unrefined in character; "low comedy"'/>
<rdf:Description rdf:about="&a;301882621"
	 b:glossaryEntry='rough and crude; "a robust tale"'/>
<rdf:Description rdf:about="&a;301882706">
	<b:glossaryEntry>(of persons or behavior) lacking refinement or finesse; "she was a diamond in the rough"; "rough manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301882863"
	 b:glossaryEntry="rude or uncouth in speech"/>
<rdf:Description rdf:about="&a;301882947"
	 b:glossaryEntry="not befitting a gentleman"/>
<rdf:Description rdf:about="&a;301883050">
	<b:glossaryEntry>lacking the behavior or manner or style considered proper for a lady</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301883175">
	<b:glossaryEntry>prepared or converted from a natural state by subjecting to a special process; "processed ores"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301883488"
	 b:glossaryEntry="free from unwanted solid matter"/>
<rdf:Description rdf:about="&a;301883575"
	 b:glossaryEntry="stored, processed, or analyzed by computer"/>
<rdf:Description rdf:about="&a;301883676">
	<b:glossaryEntry>(used of rubber, e.g.) treated by a chemical or physical process to improve its properties (hardness and strength and odor and elasticity)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301883879">
	<b:glossaryEntry>(of grains especially rice) having the husk or outer layers removed; "polished rice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301884027">
	<b:glossaryEntry>treated, coated, or impregnated with rubber; "rubberized cloth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301884160"
	 b:glossaryEntry="having been subjected to partial processing"/>
<rdf:Description rdf:about="&a;301884264">
	<b:glossaryEntry>not altered from an original or natural state; "unprocessed commodities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301884502">
	<b:glossaryEntry>(used especially of commodities) in the natural unprocessed condition; "natural produce"; "raw wool"; "raw sugar"; "bales of rude cotton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301884712">
	<b:glossaryEntry>not processed by putting through a strainer; "unstrained home-style orange juice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301884850"
	 b:glossaryEntry="not vulcanized"/>
<rdf:Description rdf:about="&a;301884923">
	<b:glossaryEntry>freed from impurities by processing; "refined sugar"; "refined oil"; "to gild refined gold"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301885093"
	 b:glossaryEntry='not refined or processed; "unrefined ore"; "crude oil"'/>
<rdf:Description rdf:about="&a;301885225">
	<b:glossaryEntry>subjected to a physical (or chemical) treatment or action or agent; "the sludge of treated sewage can be used as fertilizer"; "treated timbers resist rot"; "treated fabrics resist wrinkling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301885595">
	<b:glossaryEntry>(of sewage) treated with aeration and bacteria to aid decomposition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301885718">
	<b:glossaryEntry>(of a liquid) treated by having air passed or bubbled through it for purification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301885853">
	<b:glossaryEntry>treated by heating to a high temperature but below the melting or fusing point; "burnt sienna"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301886008"
	 b:glossaryEntry="treated or impregnated with a foreign substance"/>
<rdf:Description rdf:about="&a;301886107">
	<b:glossaryEntry>(of wood) darkened or colored by exposure to ammonia fumes; "fumed oak"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301886230">
	<b:glossaryEntry>treated so as to become resistant; "rust-proofed automobiles"; "shrink-proofed fabrics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301886371">
	<b:glossaryEntry>not subjected to chemical or physical treatment; "an untreated fabric"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301886533"
	 b:glossaryEntry='not processed or refined; "raw sewage"'/>
<rdf:Description rdf:about="&a;301886621">
	<b:glossaryEntry>treated with oil; "oiled country roads"; "an oiled walnut table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301886737">
	<b:glossaryEntry>in need of oil treatment; "dusty unoiled roads"; "a dull unoiled table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301886862">
	<b:glossaryEntry>given medical care or treatment; "a treated cold is usually gone in 14 days; if left untreated it lasts two weeks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301887084">
	<b:glossaryEntry>covered or wrapped with a bandage; "the bandaged wound on the back of his head"; "an injury bound in fresh gauze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301887260">
	<b:glossaryEntry>treated with some kind of application; "a mustache dosed with bear grease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301887386"
	 b:glossaryEntry="treated with medications and protective covering"/>
<rdf:Description rdf:about="&a;301887488">
	<b:glossaryEntry>not given medical care or treatment; "an untreated disease"; "the untreated wounded lay on makeshift cots"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301887650">
	<b:glossaryEntry>capable of being recovered or regained; "recoverable truth of a past event"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301887819">
	<b:glossaryEntry>recoverable upon payment or fulfilling a condition; "redeemable goods in a pawnshop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301887959">
	<b:glossaryEntry>capable of being regained especially with effort; "he believed the information was retrievable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301888112"
	 b:glossaryEntry="incapable of being recovered or regained"/>
<rdf:Description rdf:about="&a;301888282">
	<b:glossaryEntry>no longer known; irretrievable; "a forgotten art"; "a lost art"; "lost civilizations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301888430">
	<b:glossaryEntry>impossible to recover or recoup or overcome; "an irretrievable loss"; "irretrievable errors in judgment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301888610"
	 b:glossaryEntry='incapable of being recovered or regained; "his lost honor"'/>
<rdf:Description rdf:about="&a;301888719">
	<b:glossaryEntry>reformed spiritually or morally; "a regenerate sinner"; "regenerate by redemption from error or decay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301888932">
	<b:glossaryEntry>spiritually reborn or converted; "a born-again Christian"; "a converted sinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301889089">
	<b:glossaryEntry>caused to abandon an evil manner of living and follow a good one; "a reformed drunkard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301889231">
	<b:glossaryEntry>not regenerate or reformed; "unregenerate human nature"; "unregenerate conservatism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301889480"
	 b:glossaryEntry="stubbornly persistent in wrongdoing"/>
<rdf:Description rdf:about="&a;301889605"
	 b:glossaryEntry="impervious to moral persuasion"/>
<rdf:Description rdf:about="&a;301889692"
	 b:glossaryEntry="not converted"/>
<rdf:Description rdf:about="&a;301889777">
	<b:glossaryEntry xml:space='preserve'><![CDATA[listed or recorded officially; "record is made of `registered mail'' at each point on its route to assure safe delivery"; "registered bonds"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301890027">
	<b:glossaryEntry>holding appropriate documentation and officially on record as qualified to perform a specified function or practice a specified skill; "a registered pharmacist"; "a registered hospital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301890280"
	 b:glossaryEntry='officially entered in a roll or list; "an enrolled student"'/>
<rdf:Description rdf:about="&a;301890403">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of securities) having the owner''s name entered in a register; "recorded holders of a stock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301890550"
	 b:glossaryEntry='not registered; "an unregistered citizen"'/>
<rdf:Description rdf:about="&a;301890668">
	<b:glossaryEntry>not having your name entered on a voting list; "an unlisted voter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301890789">
	<b:glossaryEntry>(of animals) officially recorded with or certified by a recognized breed association; especially in a stud book; "a registered Percheron"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301890983">
	<b:glossaryEntry>(of animals) not recorded with or certified by an official breed association; "unregistered dairy cattle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301891147">
	<b:glossaryEntry>made a matter of official record; "a properly recorded deed to the property"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301891296">
	<b:glossaryEntry>entered in a record; "he claims to have graduated from Harvard but his name is not on the books"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301891451"
	 b:glossaryEntry='not made a matter of official record; "an unrecorded deed"'/>
<rdf:Description rdf:about="&a;301891584">
	<b:glossaryEntry>not filed or recorded in the place prescribed by law; "an unregistered trademark"; "an unregistered mortgage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301891762">
	<b:glossaryEntry>in accordance with fixed order or procedure or principle; "his regular calls on his customers"; "regular meals"; "regular duties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301892215">
	<b:glossaryEntry>occurring or done each day; "a daily record"; "day-by-day labors of thousands of men and women"- H.S.Truman; "her day-after-day behavior"; "an everyday occurrence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301892470"
	 b:glossaryEntry="of members of a team; not substitutes"/>
<rdf:Description rdf:about="&a;301892566"
	 b:glossaryEntry="according to custom or rule or natural law"/>
<rdf:Description rdf:about="&a;301892687">
	<b:glossaryEntry>conforming to set usage, procedure, or discipline; "in prescribed order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301892827"
	 b:glossaryEntry="made regular"/>
<rdf:Description rdf:about="&a;301892897">
	<b:glossaryEntry>occurring at fixed times or predictable intervals; "made her routine trip to the store"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301893038">
	<b:glossaryEntry>regularly and widely used or sold; "a standard size"; "a stock item"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301893169"
	 b:glossaryEntry='regularly spaced in time; "closely timed intervals"'/>
<rdf:Description rdf:about="&a;301893272"
	 b:glossaryEntry='evenly spaced; "at regular (or uniform) intervals"'/>
<rdf:Description rdf:about="&a;301893376">
	<b:glossaryEntry>(grammar) used of verbs having standard (or regular) inflection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301893490"
	 b:glossaryEntry='ordered well; "well-ordered work habits"'/>
<rdf:Description rdf:about="&a;301893589">
	<b:glossaryEntry>contrary to rule or accepted order or general practice; "irregular hiring practices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301893999"
	 b:glossaryEntry='not having a steady rhythm; "an arrhythmic heartbeat"'/>
<rdf:Description rdf:about="&a;301894138">
	<b:glossaryEntry>irregular in shape or outline; "asymmetrical features"; "a dress with an crooked hemline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301894296">
	<b:glossaryEntry>employed in a specified capacity from time to time; "casual employment"; "a casual correspondence with a former teacher"; "an occasional worker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301894506"
	 b:glossaryEntry='taken or to be taken at random; "grab samples"'/>
<rdf:Description rdf:about="&a;301894606">
	<b:glossaryEntry>not conforming to legality, moral law, or social convention; "an irregular marriage"; "improper banking practices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301894803"
	 b:glossaryEntry="set up or distributed in a deliberately random way"/>
<rdf:Description rdf:about="&a;301894910">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) of verbs not having standard (or regular) inflection; "`go'' is a strong verb"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301895050"
	 b:glossaryEntry="used of merchandise"/>
<rdf:Description rdf:about="&a;301895127">
	<b:glossaryEntry>controlled or governed according to rule or principle or law; "well regulated industries"; "houses with regulated temperature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301895327"
	 b:glossaryEntry="regulated by a thermostat"/>
<rdf:Description rdf:about="&a;301895411">
	<b:glossaryEntry>not regulated; not subject to rule or discipline; "unregulated off-shore fishing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301895550">
	<b:glossaryEntry>possible to remedy; "remediable problems"; "a remediable setback"; "not a crime but only a remediable blunder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301895717">
	<b:glossaryEntry>impossible to remedy or correct or redress; "an irremediable error"; "irremediable defects of character"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301895880">
	<b:glossaryEntry>that can be renewed or extended; "a renewable lease"; "renewable subscriptions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301896015"
	 b:glossaryEntry='that can not be renewed; "books on that shelf are renewable'/>
<rdf:Description rdf:about="&a;301896147"
	 b:glossaryEntry="that is able or fit be rented"/>
<rdf:Description rdf:about="&a;301896231">
	<b:glossaryEntry>not able or fit to be rented; "the house was unrentable in that condition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301896362">
	<b:glossaryEntry>capable of being repaired or rectified; "reparable damage to the car"; "rectifiable wrongs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301896541"
	 b:glossaryEntry="capable of being maintained"/>
<rdf:Description rdf:about="&a;301896627">
	<b:glossaryEntry>impossible to repair, rectify, or amend; "irreparable harm"; "an irreparable mistake"; "irreparable damages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301896793">
	<b:glossaryEntry>able or fit to be repeated or quoted; "what he said was not repeatable in polite company"; "he comes up with so many quotable phrases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301897013">
	<b:glossaryEntry>not able or fit to be repeated or quoted; "what he said was funny but unquotable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301897184">
	<b:glossaryEntry>fit for publication because free of material that is morally or legally objectionable; "printable language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301897347">
	<b:glossaryEntry>unfit for print because morally or legally objectionable or offensive to good taste; "an unprintable epithet"; "unprintable pictures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301897538"
	 b:glossaryEntry='asked for; "the requested aid is forthcoming"'/>
<rdf:Description rdf:about="&a;301897639"
	 b:glossaryEntry='not requested; "the merchandise was unrequested"'/>
<rdf:Description rdf:about="&a;301897763"
	 b:glossaryEntry='not asked for; "unasked advice"'/>
<rdf:Description rdf:about="&a;301897848">
	<b:glossaryEntry>having corresponding sounds especially terminal sounds; "rhymed verse"; "rhyming words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301898069">
	<b:glossaryEntry>having the same consonant at the beginning of each stressed syllable; "alliterative verse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301898218">
	<b:glossaryEntry>having the same vowel sound occurring with different consonants in successive words or stressed syllables</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301898378"
	 b:glossaryEntry="rhymed on the terminal syllables of the verses"/>
<rdf:Description rdf:about="&a;301898481">
	<b:glossaryEntry>not having rhyme; "writing unrhymed blank verse is like playing tennis without a net"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301898654">
	<b:glossaryEntry>always the same; showing a single form or character in all occurrences; "a street of uniform tall white buildings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301898852"
	 b:glossaryEntry='having uniform application; "a single legal code for all"'/>
<rdf:Description rdf:about="&a;301898965">
	<b:glossaryEntry>occurring in or having many forms or shapes or appearances; "the multiform universe of nature and man"- John Dewey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301899153">
	<b:glossaryEntry>having or occurring in several distinct forms; "man is both polymorpphic and polytypic"; "a polymorphous god"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301899335"
	 b:glossaryEntry="happening or recurring at regular intervals"/>
<rdf:Description rdf:about="&a;301899518"
	 b:glossaryEntry="marked by repeated cycles"/>
<rdf:Description rdf:about="&a;301899596"
	 b:glossaryEntry="stopping and starting at regular intervals"/>
<rdf:Description rdf:about="&a;301899697"
	 b:glossaryEntry="having periodic vibrations"/>
<rdf:Description rdf:about="&a;301899795">
	<b:glossaryEntry>produced or transmitted or modulated in short bursts or pulses; "pulsed electromagnetic waves"; "pulsed light"; "pulsed ultrasonic energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301899986"
	 b:glossaryEntry="not recurring at regular intervals"/>
<rdf:Description rdf:about="&a;301900126"
	 b:glossaryEntry="not having repeated cycles"/>
<rdf:Description rdf:about="&a;301900208"
	 b:glossaryEntry="not having periodic vibrations"/>
<rdf:Description rdf:about="&a;301900299">
	<b:glossaryEntry>(used of the military) belonging to or engaged in by legitimate army forces; "the regular army"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301900466"
	 b:glossaryEntry='permanent; "a standing army"'/>
<rdf:Description rdf:about="&a;301900549">
	<b:glossaryEntry>used of the military; not belonging to or engaged in by regular army forces; "irregular troops"; "irregular warfare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301900739"
	 b:glossaryEntry="connected by kinship, common origin, or marriage"/>
<rdf:Description rdf:about="&a;301900985"
	 b:glossaryEntry="related by marriage"/>
<rdf:Description rdf:about="&a;301901058">
	<b:glossaryEntry xml:space='preserve'><![CDATA[related on the father''s side; "a paternal aunt"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301901182"
	 b:glossaryEntry="related by blood"/>
<rdf:Description rdf:about="&a;301901318">
	<b:glossaryEntry>related by common characteristics or ancestry; "allied species"; "allied studies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301901452">
	<b:glossaryEntry xml:space='preserve'><![CDATA[related on the mother''s side; "my maternal grandmother"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301901582"
	 b:glossaryEntry='related by blood or marriage; "kindred clans"'/>
<rdf:Description rdf:about="&a;301901681"
	 b:glossaryEntry="not connected by kinship"/>
<rdf:Description rdf:about="&a;301901779"
	 b:glossaryEntry="not connected by birth or family"/>
<rdf:Description rdf:about="&a;301901882">
	<b:glossaryEntry>being connected or associated; "painting and the related arts"; "school-related activities"; "related to micelle formation is the...ability of detergent actives to congregate at oil-water interfaces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301902400">
	<b:glossaryEntry>following as a consequence; "an excessive growth of bureaucracy, with related problems"; "snags incidental to the changeover in management"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301902656">
	<b:glossaryEntry>being joined in close association; "affiliated clubs"; "all art schools whether independent or attached to universities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301902856">
	<b:glossaryEntry>associated with or accompanying; "Christmas and associated festivities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301902996">
	<b:glossaryEntry>closely or inseparably connected or associated with; "his career is bound up with the fortunes of the enterprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301903164">
	<b:glossaryEntry>(linguistics) having the same ancestral language; "cognate languages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301903287"
	 b:glossaryEntry='related in nature; "connate qualities"'/>
<rdf:Description rdf:about="&a;301903389">
	<b:glossaryEntry>in relation (or in regard) to; especially as in the phrases; "as far as x is concerned"; "where x is concerned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301903556">
	<b:glossaryEntry>referring or directing attention to; "as to what we have discussed..."; "in relation to your inquiry..."; "income vis-a-vis expenditures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301903869"
	 b:glossaryEntry="mutually related"/>
<rdf:Description rdf:about="&a;301903968">
	<b:glossaryEntry>accompanying; "all rights carry with them corresponding responsibilities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301904101">
	<b:glossaryEntry>being associated as a companion or associate; "fellow traveler"; "brother workers"; "sister ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301904279">
	<b:glossaryEntry>regarding or indicated by; "facilities planned and programmed in terms of their interrelationships instead of evolving haphazardly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301904468">
	<b:glossaryEntry>related by having something in common with or coinciding with; "having overlapping duties"; "found unexpected overlapping areas of interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301904666">
	<b:glossaryEntry>closely related or associated; "a city in which communism and democracy had to live side by side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301904822"
	 b:glossaryEntry="not connected or associated"/>
<rdf:Description rdf:about="&a;301904959"
	 b:glossaryEntry="having had the relation broken"/>
<rdf:Description rdf:about="&a;301905061"
	 b:glossaryEntry="mistakenly related"/>
<rdf:Description rdf:about="&a;301905136"
	 b:glossaryEntry="not varying together"/>
<rdf:Description rdf:about="&a;301905215">
	<b:glossaryEntry>having a bearing on or connection with the subject at issue; "the scientist corresponds with colleagues in order to learn about matters relevant to her own research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301905507">
	<b:glossaryEntry>capable of being applied; having relevance; "gave applicable examples to support her argument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301905657">
	<b:glossaryEntry>now in consideration or under discussion; "regarding the matter in hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301905858">
	<b:glossaryEntry>having close kinship and appropriateness; "he asks questions that are germane and central to the issue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301906028">
	<b:glossaryEntry>having precise or logical relevance to the matter at hand; "a list of articles pertinent to the duscussion"; "remarks that were to the point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301906243">
	<b:glossaryEntry>having no bearing on or connection with the subject at issue; "an irrelevant comment"; "irrelevant allegations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301906465">
	<b:glossaryEntry>of superficial relevance if any; "a digressive allusion to the day of the week"; "a tangential remark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301906636">
	<b:glossaryEntry>not pertinent to the matter under consideration; "an issue extraneous to the debate"; "the price was immaterial"; "mentioned several impertinent facts before finally coming to the point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301906906">
	<b:glossaryEntry>not capable of being applied; "rules inapplicable to day students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301907044">
	<b:glossaryEntry>bearing in mind; attentive to; "ever mindful of her health"; "mindful of his responsibilities"; "mindful of these criticisms, I shall attempt to justify my action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301907323">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cautiously attentive; "careful of her feelings"; "heedful of his father''s advice"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301907468">
	<b:glossaryEntry>serving to bring to mind; "cannot forbear to close on this redolent literary note"- Wilder Hobson; "a campaign redolent of machine politics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301907738">
	<b:glossaryEntry>not mindful or attentive; "while thus unmindful of his steps he stumbled"- G.B.Shaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301907936"
	 b:glossaryEntry="suffering from a partial loss of memory"/>
<rdf:Description rdf:about="&a;301908040"
	 b:glossaryEntry="capable of being replaced"/>
<rdf:Description rdf:about="&a;301908159">
	<b:glossaryEntry>capable of replacing or changing places with something else; "interchangeable parts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301908345"
	 b:glossaryEntry='impossible to replace; "irreplaceable antiques"'/>
<rdf:Description rdf:about="&a;301908486">
	<b:glossaryEntry>used especially of art; "representational art"; "representational images"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301908730"
	 b:glossaryEntry="depicted in a recognizable manner"/>
<rdf:Description rdf:about="&a;301908833"
	 b:glossaryEntry="of visual imagery of almost photographic accuracy"/>
<rdf:Description rdf:about="&a;301908936">
	<b:glossaryEntry>consisting of or forming human or animal figures; "a figural design"; "the figurative art of the humanistic tradition"- Herbert Read</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301909135">
	<b:glossaryEntry>characterized by or of the nature of or using mimesis; "a mimetic dance"; "the mimetic presentation of images"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301909299">
	<b:glossaryEntry>representing what is real; not abstract or ideal; "realistic portraiture"; "a realistic novel"; "in naturalistic colors"; "the school of naturalistic writers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301909528">
	<b:glossaryEntry>emphasizing or expressing things as perceived without distortion of personal feelings or interpretation; "objective art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301909704"
	 b:glossaryEntry="art"/>
<rdf:Description rdf:about="&a;301909899">
	<b:glossaryEntry>not representing or imitating external reality or the objects of nature; "a large abstract painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301910102"
	 b:glossaryEntry="(fine arts) represented in simplified or symbolic form"/>
<rdf:Description rdf:about="&a;301910236">
	<b:glossaryEntry>(fine arts) characterized by simple geometric forms in design and decoration; "a buffalo hide painted with red and black geometric designs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301910445">
	<b:glossaryEntry>(fine arts) adhering to fixed types or methods; highly restrained and formal; "the more hieratic sculptures leave the viewer curiously unmoved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301910643">
	<b:glossaryEntry>characteristic of the earliest phase of geometric art especially in Greece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301910778"
	 b:glossaryEntry="characterized by stylized but recognizable subject matter"/>
<rdf:Description rdf:about="&a;301910894">
	<b:glossaryEntry>standing for something else; "the bald eagle is representative of the United States"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301911075">
	<b:glossaryEntry>used in or characteristic of or containing allegory; "allegorical stories"; "an allegorical painting of Victory leading an army"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301911273">
	<b:glossaryEntry>serving as a visible symbol for something abstract; "a crown is emblematic of royalty"; "the spinning wheel was as symbolic of colonical Massachusetts as the codfish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301911535"
	 b:glossaryEntry="not standing for something else"/>
<rdf:Description rdf:about="&a;301911643">
	<b:glossaryEntry>having a good reputation; "a reputable business"; "a reputable scientist"; "a reputable wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301911900">
	<b:glossaryEntry>having an illustrious reputation; respected; "our esteemed leader"; "a prestigious author"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301912069">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deserving of esteem and respect; "all respectable companies give guarantees"; "ruined the family''s good name"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301912267"
	 b:glossaryEntry='receiving deferential regard; "a respected family"'/>
<rdf:Description rdf:about="&a;301912391">
	<b:glossaryEntry>lacking respectability in character or behavior or appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301912691">
	<b:glossaryEntry>tending to bring discredit or disrepute; blameworthy; "his marks were not at all discreditable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301912846">
	<b:glossaryEntry>being unjustly brought into disrepute; "a discredited politician"; "her damaged reputation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301913005">
	<b:glossaryEntry>having an exceedingly bad reputation; "a notorious gangster"; "the tenderloin district was notorious for vice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301913194">
	<b:glossaryEntry>of questionable taste or morality; "a louche nightclub"; "a louche painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301913331">
	<b:glossaryEntry>morally degraded; "a seedy district"; "the seamy side of life"; "sleazy characters hanging around casinos"; "sleazy storefronts with...dirt on the walls"- Seattle Weekly; "the sordid details of his orgies stank under his very nostrils"- James Joyce; "the squalid atmosphere of intrigue and betrayal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301913718"
	 b:glossaryEntry="not worthy of respect"/>
<rdf:Description rdf:about="&a;301913799"
	 b:glossaryEntry="accorded no respect"/>
<rdf:Description rdf:about="&a;301913876">
	<b:glossaryEntry>ready or willing to receive favorably; "receptive to the proposals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301914053">
	<b:glossaryEntry>accepting willingly; "acceptive of every new idea"; "an acceptant type of mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301914200">
	<b:glossaryEntry>characterized by or allowing admission; "an Elizabethan tragedy admissive of comic scenes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301914346">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(`hospitable'' is usually followed by `to'') having an open mind; "hospitable to new ideas"; "open to suggestions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301914528"
	 b:glossaryEntry="not receptive"/>
<rdf:Description rdf:about="&a;301914617">
	<b:glossaryEntry>not having an open mind; "a closed mind unreceptive to new ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301914751">
	<b:glossaryEntry>capable of being reconciled; "her way of thinking is reconcilable with mine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301914922"
	 b:glossaryEntry="capable of being made harmonious or consistent"/>
<rdf:Description rdf:about="&a;301915027">
	<b:glossaryEntry>capable of being settled or resolved; "all disputed points are potentially resolvable"; "a resolvable quarrel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301915194"
	 b:glossaryEntry='impossible to reconcile; "irreconcilable differences"'/>
<rdf:Description rdf:about="&a;301915361"
	 b:glossaryEntry='impossible to bring into friendly accord; "hostile factions"'/>
<rdf:Description rdf:about="&a;301915475">
	<b:glossaryEntry>not capable of being made consistent or harmonious; "inconsistent accounts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301915609">
	<b:glossaryEntry>marked by self-restraint and reticence; "was habitually reserved in speech, withholding her opinion"-Victoria Sackville-West</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301915914">
	<b:glossaryEntry>remote in manner; "stood apart with aloof dignity"; "a distant smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301916045">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing modest reserve; "she was diffident when offering a comment on the professor''s lecture"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301916195"
	 b:glossaryEntry='tending to reserve or introspection; "a quiet indrawn man"'/>
<rdf:Description rdf:about="&a;301916319"
	 b:glossaryEntry='not cautious or reticent; "unreserved behavior"'/>
<rdf:Description rdf:about="&a;301916477"
	 b:glossaryEntry="set aside for the use of a particular person or party"/>
<rdf:Description rdf:about="&a;301916639"
	 b:glossaryEntry="reserved in advance"/>
<rdf:Description rdf:about="&a;301916736">
	<b:glossaryEntry>subject to being reserved or booked; "all seats bookable in advance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301916859"
	 b:glossaryEntry="reserved for an eleite group"/>
<rdf:Description rdf:about="&a;301916953"
	 b:glossaryEntry="not reserved"/>
<rdf:Description rdf:about="&a;301917058"
	 b:glossaryEntry="not accepting reservations"/>
<rdf:Description rdf:about="&a;301917163"
	 b:glossaryEntry="not reserved in advance"/>
<rdf:Description rdf:about="&a;301917241">
	<b:glossaryEntry>capable of being resisted or withstood or frustrated; "a resistible attack"; "such resistible temptations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301917404">
	<b:glossaryEntry>impossible to resist; overpowering; "irresistible (or resistless) impulses"; "what happens when an irresistible force meets an immovable object?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301917639">
	<b:glossaryEntry>so strong as to be irresistible; "an overpowering need for solitude"; "the temptation to despair may become overwhelming"; "an overwhelming majority"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301917862">
	<b:glossaryEntry>firm in purpose or belief; characterized by firmness and determination; "stood resolute against the enemy"; "faced with a resolute opposition"; "a resolute and unshakeable faith"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301918347">
	<b:glossaryEntry>fixed in your purpose; "bent on going to the theater"; "dead set against intervening"; "out_to win every event"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301918563">
	<b:glossaryEntry>characterized by great determination; "a struggle against a determined enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301918697">
	<b:glossaryEntry>desperately determined; "do-or-die revolutionaries"; "a do-or-die conflict"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301918843">
	<b:glossaryEntry>marked by firm determination or resolution; not shakable; "firm convictions"; "a firm mouth"; "steadfast resolve"; "a man of unbendable perseverence"; "unwavering loyalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301919139">
	<b:glossaryEntry>characterized by firm and unwavering conviction; "a foursquare refusal to yield"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301919276"
	 b:glossaryEntry='recklessly determined; "hell-bent on winning"'/>
<rdf:Description rdf:about="&a;301919377">
	<b:glossaryEntry>determined; "she was firmly resolved to be a doctor"; "single-minded in his determination to stop smoking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301919554">
	<b:glossaryEntry>resolute in the face of pain or danger or adversity; "spartan courage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301919678">
	<b:glossaryEntry>dependable; "the stalwart citizens at Lexington"; "a stalwart supporter of the UN"; "stout hearts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301919839">
	<b:glossaryEntry>unshaken in purpose; "wholly undismayed by the commercial failure of the three movies he had made"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301920017">
	<b:glossaryEntry>not deterred; "pursued his own path...undeterred by lack of popular appreciation and understanding"- Osbert Sitwell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301920205">
	<b:glossaryEntry>uncertain how to act or proceed; "the committee was timid and mediocre and irresolute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301920456">
	<b:glossaryEntry>lacking in resolution; "the accident left others discouraged about going there"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301920593">
	<b:glossaryEntry>lacking firmness of will or character or purpose; "infirm of purpose; give me the daggers" - Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301920750">
	<b:glossaryEntry>disposed to psychological variability; "his rather unstable religious convictions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301920887"
	 b:glossaryEntry="uncertain in purpose or action"/>
<rdf:Description rdf:about="&a;301920998">
	<b:glossaryEntry>lacking will power or resolution; "the role of the dissenter is not for the weak-kneed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301921142"
	 b:glossaryEntry='worthy of respect; "a respectable woman"'/>
<rdf:Description rdf:about="&a;301921348">
	<b:glossaryEntry>socially or conventionally correct; refined or virtuous; "from a decent family"; "a nice girl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301921502"
	 b:glossaryEntry='more than adequate in quality; "fair work"'/>
<rdf:Description rdf:about="&a;301921595"
	 b:glossaryEntry='fit to be seen; "presentable clothes"'/>
<rdf:Description rdf:about="&a;301921690"
	 b:glossaryEntry='meriting respect or esteem; "the worthy gentleman"'/>
<rdf:Description rdf:about="&a;301921793"
	 b:glossaryEntry="unworthy of respect"/>
<rdf:Description rdf:about="&a;301921872">
	<b:glossaryEntry>full of or exhibiting respect; "respectful behavior"; "a respectful glance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301922094"
	 b:glossaryEntry="showing deference"/>
<rdf:Description rdf:about="&a;301922192">
	<b:glossaryEntry>conferring or showing honor or respect; "honorific social status commonly attaches to membership in a recognized profession"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301922372">
	<b:glossaryEntry>exhibiting lack of respect; rude and discourteous; "remarks disrespectful of the law"; "disrespectful in the presence of his parents"; "disrespectful toward his teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301922817">
	<b:glossaryEntry xml:space='preserve'><![CDATA[making light of; "afire with annihilating invective"; "a devastating portrait of human folly"; "to compliments inflated I''ve a withering reply"- W.S.Gilbert]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301923058"
	 b:glossaryEntry="expressing extreme contempt"/>
<rdf:Description rdf:about="&a;301923180"
	 b:glossaryEntry="arrogantly insolent"/>
<rdf:Description rdf:about="&a;301923258">
	<b:glossaryEntry xml:space='preserve'><![CDATA[abusing vocally; expressing contempt or ridicule; "derisive laughter"; "a jeering crowd"; "her mocking smile"; "taunting shouts of `coward'' and `sissy''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301923507">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking due respect or dutifulness; "impious toward one''s parents"; "an undutiful son"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301923659">
	<b:glossaryEntry>marked by casual disrespect; "a flip answer to serious question"; "the student was kept in for impudent behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301923860"
	 b:glossaryEntry="not showing courteous respect"/>
<rdf:Description rdf:about="&a;301923949">
	<b:glossaryEntry xml:space='preserve'><![CDATA[worthy of or requiring responsibility or trust; or held accountable; "a responsible adult"; "responsible journalism"; "a responsible position"; "the captain is responsible for the ship''s safety"; "the cabinet is responsible to the parliament"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301924393">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being obliged to answer to an authority for your actions; "governments must be accountable to someone beside themselves"; "fully accountable for what they did"; "the court held the parents answerable for their minor child''s acts of vandalism"; "he was answerable to no one"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301924743">
	<b:glossaryEntry>held legally responsible; "men between the ages of 18 and 35 were liable for military service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301924890">
	<b:glossaryEntry>characterized by good judgment or sound thinking; "judicious journalism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301925018">
	<b:glossaryEntry>taking responsibility for one`s conduct and obligations; "trustworthy public servants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301925162">
	<b:glossaryEntry>showing lack of care for consequences; "behaved like an irresponsible idiot"; "hasty and irresponsible action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301925494">
	<b:glossaryEntry>cheerfully irresponsible; "carefree with his money"; "freewheeling urban youths"; "had a harum-scarum youth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301925733">
	<b:glossaryEntry>characterized by inability or unwillingness to work toward a goal or assume responsibility; "a do-nothing government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301925910"
	 b:glossaryEntry="not fit to assume responsibility"/>
<rdf:Description rdf:about="&a;301925997">
	<b:glossaryEntry>absent-mindedly irresponsible; "he said I was too flighty to be a good supervisor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301926171">
	<b:glossaryEntry>lacking a sense of restraint or responsibility; "idle talk"; "a loose tongue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301926307"
	 b:glossaryEntry="irresponsible in the use of firearms"/>
<rdf:Description rdf:about="&a;301926403"
	 b:glossaryEntry="free from control or responsibility"/>
<rdf:Description rdf:about="&a;301926498"
	 b:glossaryEntry="lacking a sense of responsibility"/>
<rdf:Description rdf:about="&a;301926588">
	<b:glossaryEntry>readily reacting to people or events; showing emotion; "children are often the quickest and most responsive members of the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301926831"
	 b:glossaryEntry='replying; "an answering glance"; "an answering smile"'/>
<rdf:Description rdf:about="&a;301926953"
	 b:glossaryEntry="not responsive"/>
<rdf:Description rdf:about="&a;301927062">
	<b:glossaryEntry>brought back to original condition; "a restored painting"; "felt a restored faith in human beings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301927323">
	<b:glossaryEntry>(colloquial) taken care of or made comfortable; "went back to work after she got her scraped arm fixed up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301927484">
	<b:glossaryEntry>made over usually with changes; "the rebuilt pier spoiled our view"; "our remodeled house seems like new"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301927655">
	<b:glossaryEntry>repaired and improved; "some renovated apartment buildings in the rundown neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301927798">
	<b:glossaryEntry>mended or put in working order; "a reconditioned sewing machine"; "a repaired vacuum cleaner"; "the broken lock is now fixed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301928002">
	<b:glossaryEntry>(of persons) restored to health or useful life; "rehabilitated prisoners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301928135"
	 b:glossaryEntry='not restored; "the paintings were unrestored"'/>
<rdf:Description rdf:about="&a;301928255"
	 b:glossaryEntry="not repaired"/>
<rdf:Description rdf:about="&a;301928342"
	 b:glossaryEntry="under restraint"/>
<rdf:Description rdf:about="&a;301928594">
	<b:glossaryEntry>held back; "we watched the daring feats of the acrobats with bated breath"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301928720"
	 b:glossaryEntry="held back from some action especially by force"/>
<rdf:Description rdf:about="&a;301928829"
	 b:glossaryEntry='strictly confined or guarded; "kept under close custody"'/>
<rdf:Description rdf:about="&a;301928937">
	<b:glossaryEntry>deprived of liberty; especially placed under arrest or restraint</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301929056">
	<b:glossaryEntry>controlled; "striking with contained ferocity at my head"- R.L.Stevenson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301929184">
	<b:glossaryEntry>restrained in style or quality; "a little masterpiece of low-keyed eloquence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301929337">
	<b:glossaryEntry>not given to high spirits or effusiveness; "an unexpansive man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301929458"
	 b:glossaryEntry='not subject to restraint; "unrestrained laughter"'/>
<rdf:Description rdf:about="&a;301929728">
	<b:glossaryEntry>unrestrained in especially feelings; "extravagant praise"; "exuberant compliments"; "overweening ambition"; "overweening greed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301929951">
	<b:glossaryEntry>free of restraints or rules; "freewheeling foolishness"; "the versatility of his poetic freewheeling style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301930117">
	<b:glossaryEntry>not restrained or controlled; "unbridled rage"; "an unchecked temper"; "ungoverned rage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301930297">
	<b:glossaryEntry>not under constraint in action or expression; "this unbuttoned and disrespectful age"- Curtis Bok; "unlaced behavior in the neighborhood pub"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301930505">
	<b:glossaryEntry>not slowed or blocked or interfered with; "an outlet for healthy and unhampered action"; "a priest unhampered by scruple"; "the new stock market was unhampered by tradition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301930748">
	<b:glossaryEntry>subject to restriction or subjected to restriction; "of restricted importance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301930991"
	 b:glossaryEntry="subject to limits or subjected to limits"/>
<rdf:Description rdf:about="&a;301931101"
	 b:glossaryEntry='not open to the general public; "a closed meeting"'/>
<rdf:Description rdf:about="&a;301931204"
	 b:glossaryEntry='barred to a designated group; "that area is off-limits"'/>
<rdf:Description rdf:about="&a;301931335"
	 b:glossaryEntry="not subject to or subjected to restriction"/>
<rdf:Description rdf:about="&a;301931526">
	<b:glossaryEntry>usable or operative or practiced in all kinds of weather; "a good all-weather road"; "all-weather flying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301931689">
	<b:glossaryEntry>(especially of funds) not earmarked; available for use as needed; "discretionary funds"; "discretionary income"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301931860"
	 b:glossaryEntry='accessible to all; "open season"; "an open economy"'/>
<rdf:Description rdf:about="&a;301931962">
	<b:glossaryEntry>without fixed limits or restrictions; "an open-ended discussion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301932083">
	<b:glossaryEntry>serving to restrict; "teenagers eager to escape restrictive home environments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301932327"
	 b:glossaryEntry="restricting the scope or freedom of action"/>
<rdf:Description rdf:about="&a;301932480">
	<b:glossaryEntry>restrictive of action; "a repressive regime"; "an overly strict and inhibiting discipline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301932666">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) strictly limiting the reference of a modified word or phrase; "the restrictive clause in `Each made a list of the books that had influenced him'' limits the books on the list to only those particular ones defined by the clause"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301932957"
	 b:glossaryEntry="restricting according to rules or principles"/>
<rdf:Description rdf:about="&a;301933084">
	<b:glossaryEntry>regulating or controlling expenditure or personal behavior; "sumptuary laws discouraging construction of large houses on small plots"; "sumptuary laws forbidding gambling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301933311">
	<b:glossaryEntry>tending to suppress; "the government used suppressive measures to control the protest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301933455"
	 b:glossaryEntry="not tending to restrict"/>
<rdf:Description rdf:about="&a;301933574"
	 b:glossaryEntry="tending to set free"/>
<rdf:Description rdf:about="&a;301933690">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) not limiting the reference of a modified word or phrase; "the nonrestrictive clause in `I always buy his books, which have influenced me greatly,'' refers to his books generally and adds an additional fact about them"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301933977">
	<b:glossaryEntry>selling or related to selling direct to the consumer; "retail trade"; "retail business"; "retail price"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301934133">
	<b:glossaryEntry>selling or related to selling goods in large quantities for resale to the consumer; "wholesale prices"; "a wholesale produce market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301934339"
	 b:glossaryEntry='large in quantity or volume; "a bulk buy"; "bulk mailing"'/>
<rdf:Description rdf:about="&a;301934450">
	<b:glossaryEntry>tending to retain; "a retentive memory"; "soils retentive of moisture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301934648">
	<b:glossaryEntry>tending to acquire and retain ideas or information; "an acquisitive mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301934794">
	<b:glossaryEntry>designed for (usually temporary) retention; "a holding pen"; "a retaining wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301934939">
	<b:glossaryEntry>(of memory) having greater than average range; "a long memory especially for insults"; "a tenacious memory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301935109"
	 b:glossaryEntry="not retentive"/>
<rdf:Description rdf:about="&a;301935228">
	<b:glossaryEntry>(of memory) deficient in retentiveness or range; "a short memory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301935345">
	<b:glossaryEntry>resembling or forming a network; "the reticulate veins of a leaf"; "a reticulated highway system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301935651">
	<b:glossaryEntry>(botany) having a latticelike structure pierced with holes or windows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301935803"
	 b:glossaryEntry="marked with crossing lines"/>
<rdf:Description rdf:about="&a;301935901"
	 b:glossaryEntry="having a pattern of fretwork or latticework"/>
<rdf:Description rdf:about="&a;301936036"
	 b:glossaryEntry="reciprocally connected"/>
<rdf:Description rdf:about="&a;301936134"
	 b:glossaryEntry="having open interstices or resembling a web"/>
<rdf:Description rdf:about="&a;301936274"
	 b:glossaryEntry='resembling a network; "a meshed road system"'/>
<rdf:Description rdf:about="&a;301936371"
	 b:glossaryEntry="having a network of veins or ribs"/>
<rdf:Description rdf:about="&a;301936462"
	 b:glossaryEntry="not resembling or forming a network"/>
<rdf:Description rdf:about="&a;301936557">
	<b:glossaryEntry>capable of retraction; capable of being drawn back; "cats have retractile claws"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301936712"
	 b:glossaryEntry='capable of being retracted; "retractable landing gear"'/>
<rdf:Description rdf:about="&a;301936824"
	 b:glossaryEntry="not capable of being retracted"/>
<rdf:Description rdf:about="&a;301936931">
	<b:glossaryEntry>capable of physically reflecting light or sound; "a reflective surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301937095">
	<b:glossaryEntry>capable of reflecting light like a mirror; "mirrorlike surface of the lake"; "a specular metal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301937258">
	<b:glossaryEntry>causing reflection or having a device that reflects; "a reflecting microscope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301937393"
	 b:glossaryEntry="not capable of physical reflection"/>
<rdf:Description rdf:about="&a;301937521"
	 b:glossaryEntry='having or producing no echo; "the echoless darkness"'/>
<rdf:Description rdf:about="&a;301937628">
	<b:glossaryEntry>(especially of incident sound or light) bent or sent back; "reflected light"; "reflected heat"; "reflected glory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301937833"
	 b:glossaryEntry="like or characteristic of an echo"/>
<rdf:Description rdf:about="&a;301937930"
	 b:glossaryEntry="like or characteristic of a mirrored image"/>
<rdf:Description rdf:about="&a;301938027">
	<b:glossaryEntry>(especially of incident sound or light) not turned back by physical reflection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301938181"
	 b:glossaryEntry='retained without reflection; "the absorbed light intensity"'/>
<rdf:Description rdf:about="&a;301938295">
	<b:glossaryEntry>having a tendency to reverberate or be repeatedly reflected; "a reverberant room"; "the reverberant booms of cannon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301938641">
	<b:glossaryEntry>clear and sharp and ringing; "the bright sound of the trumpet section"; "the brilliant sound of the trumpets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301938815"
	 b:glossaryEntry="like the light sharp ringing sound of glasses being tapped"/>
<rdf:Description rdf:about="&a;301938928">
	<b:glossaryEntry>(of sounds) repeating by reflection; "a hotel with echoing halls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301939062">
	<b:glossaryEntry>as if echoing in a hollow space; "the hollow sound of footsteps in the empty ballroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301939201">
	<b:glossaryEntry>having a series of high-pitched ringing sounds like many small bells; "jingling sleigh bells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301939358"
	 b:glossaryEntry='highly reverberant; "a live concert hall"'/>
<rdf:Description rdf:about="&a;301939453"
	 b:glossaryEntry='inducing resonance; "resonant frequency"'/>
<rdf:Description rdf:about="&a;301939548">
	<b:glossaryEntry>characterized by reverberation; "a resonant voice"; "hear the rolling thunder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301939749">
	<b:glossaryEntry>like the short high ringing sound of a small bell; "sounding brass and a tinkling cymbal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301939902"
	 b:glossaryEntry="not reverberant; lacking a tendency to reverberate"/>
<rdf:Description rdf:about="&a;301940080">
	<b:glossaryEntry>not having or producing echoes; sound-absorbent; "an anechoic chamber"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301940205">
	<b:glossaryEntry>lacking acoustic resonance; "dead sounds characteristic of some compact discs"; "the dead wall surfaces of a recording studio"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301940382">
	<b:glossaryEntry>not clear and resonant; sounding as if striking with or against something relatively soft; "the dull thud"; "thudding bullets"; "thumping feet on the carpeted stairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301940621">
	<b:glossaryEntry>feeling or showing profound respect or veneration; "maintained a reverent silence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301940830"
	 b:glossaryEntry="showing adoration"/>
<rdf:Description rdf:about="&a;301940914">
	<b:glossaryEntry>inspired by a feeling of fearful wonderment or reverence; "awed by the silence"; "awful worshippers with bowed heads"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301941090"
	 b:glossaryEntry="feeling or manifesting veneration"/>
<rdf:Description rdf:about="&a;301941207">
	<b:glossaryEntry>showing lack of due respect or veneration; "irreverent scholars mocking sacred things"; "noisy irreverent tourists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301941433">
	<b:glossaryEntry xml:space='preserve'><![CDATA[grossly irreverent toward what is held to be sacred; "blasphemous rites of a witches'' Sabbath"; "profane utterances against the Church"; "it is sacrilegious to enter with shoes on"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301941696"
	 b:glossaryEntry="neither feeling nor showing respect"/>
<rdf:Description rdf:about="&a;301941810">
	<b:glossaryEntry>restored to consciousness or life or vigor; "felt revived hope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301942017">
	<b:glossaryEntry xml:space='preserve'><![CDATA[brought back; "the Victorian era redux"; "`Rabbit Redux'' by John Updike"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301942145"
	 b:glossaryEntry='restored to a new condition; "felt renewed strength"'/>
<rdf:Description rdf:about="&a;301942251">
	<b:glossaryEntry>rising again as to new life and vigor; "resurgent nationalism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301942369"
	 b:glossaryEntry="restored to life or consciousness"/>
<rdf:Description rdf:about="&a;301942461">
	<b:glossaryEntry>restored to new life and vigor; "a revitalized economy"; "a revitalized inner-city neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301942615"
	 b:glossaryEntry="not revived"/>
<rdf:Description rdf:about="&a;301942694"
	 b:glossaryEntry='aroused or activated; "an awakened interest in ballet"'/>
<rdf:Description rdf:about="&a;301942821"
	 b:glossaryEntry='aroused to action; "the aroused opposition"'/>
<rdf:Description rdf:about="&a;301942918"
	 b:glossaryEntry='not aroused or activated; "unawakened emotions"'/>
<rdf:Description rdf:about="&a;301943022">
	<b:glossaryEntry>having or showing a feeling of mixed reverence and respect and wonder and dread; "stood in awed silence before the shrine"; "in grim despair and awestruck wonder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301943291"
	 b:glossaryEntry="overcome by a feeling of awe"/>
<rdf:Description rdf:about="&a;301943374"
	 b:glossaryEntry="not awed"/>
<rdf:Description rdf:about="&a;301943453"
	 b:glossaryEntry="devoid of any feeling of awe or reverence"/>
<rdf:Description rdf:about="&a;301943557">
	<b:glossaryEntry>advocating or engaged in revolution; "revolutionary pamphlets"; "a revolutionary junta"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301943704">
	<b:glossaryEntry>marked by opposition or antipathy to revolution; "ostracized for his counterrevolutionary tendencies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301943872">
	<b:glossaryEntry>providing personal satisfaction; "a rewarding career as a paramedic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301944086"
	 b:glossaryEntry="giving pleasure or satisfaction"/>
<rdf:Description rdf:about="&a;301944212"
	 b:glossaryEntry='rewarded or rewardable by a bounty; "a bountied animal pelt"'/>
<rdf:Description rdf:about="&a;301944327"
	 b:glossaryEntry='providing profit; "a profitable conversation"'/>
<rdf:Description rdf:about="&a;301944429"
	 b:glossaryEntry="appropriate for receiving a reward"/>
<rdf:Description rdf:about="&a;301944520"
	 b:glossaryEntry='offering or productive of reward; "rewardful pursuits"'/>
<rdf:Description rdf:about="&a;301944630"
	 b:glossaryEntry="not rewarding; not providing personal satisfaction"/>
<rdf:Description rdf:about="&a;301944774">
	<b:glossaryEntry>not likely to be rewarded; "grading papers is a thankless task"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301944924">
	<b:glossaryEntry>without profit or reward; "let us have no part in profitless quarrels"- D.D.Eisenhower; "How weary, flat, stale, and unprofitable / Seem to me all the uses of this world"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301945179">
	<b:glossaryEntry>concerned with effect or style of writing and speaking; "a rhetorical question is one asked solely to produce an effect (especially to make an assertion) rather than to elicit a reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301945636">
	<b:glossaryEntry>(of a metric foot) characterized by two short syllables followed by a long one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301945783">
	<b:glossaryEntry>ostentatiously lofty in style; "a man given to large talk"; "tumid political prose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301945971">
	<b:glossaryEntry>marked by elaborate rhetoric and elaborated with decorative details; "a flowery speech"; "ornate rhetoric taught out of the rule of Plato"-John Milton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301946184">
	<b:glossaryEntry>excessively elaborate or showily expressed; "a writer of empurpled literature"; "many purple passages"; "speech embellished with classical quotations"; "an over-embellished story of the fish that got away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301946487"
	 b:glossaryEntry="used of legal argumentation"/>
<rdf:Description rdf:about="&a;301946569">
	<b:glossaryEntry>lofty in style; "he engages in so much tall talk, one never really realizes what he is saying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301946745">
	<b:glossaryEntry>characteristic of an orator or oratory; "oratorical prose"; "harangued his men in an oratorical way"- Robert Graves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301946917"
	 b:glossaryEntry='characteristic of or befitting poetry; "poetic diction"'/>
<rdf:Description rdf:about="&a;301947036">
	<b:glossaryEntry>of or relating to style (especially in the use of language); "stylistic devices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301947172"
	 b:glossaryEntry="not rhetorical"/>
<rdf:Description rdf:about="&a;301947389">
	<b:glossaryEntry>lacking stylistic embellishment; "a literal description"; "wrote good but plain prose"; "a plain unadorned account of the coronation"; "a forthright unembellished style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301947636">
	<b:glossaryEntry>not fanciful or imaginative; "local guides describe the history of various places in matter-of-fact tones"; "a prosaic and unimaginative essay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301947850">
	<b:glossaryEntry>using simple and direct language; "a plainspoken country doctor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301947972">
	<b:glossaryEntry>recurring with measured regularity; "the rhythmic chiming of church bells"- John Galsworthy; "rhythmical prose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301948349">
	<b:glossaryEntry>expanding and contracting rhythmically as to the beating of the heart; "felt the pulsating artery"; "oh my beating heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301948546">
	<b:glossaryEntry>marked by a rhythmical cadence; "the cadenced crunch of marching feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301948680"
	 b:glossaryEntry="suitable for dancing"/>
<rdf:Description rdf:about="&a;301948756"
	 b:glossaryEntry="resembling jazz (especially in its rhythm)"/>
<rdf:Description rdf:about="&a;301948850">
	<b:glossaryEntry>characterized by a buoyant rhythm; "an easy lilting stride"; "the flute broke into a light lilting air"; "a swinging pace"; "a graceful swingy walk"; "a tripping singing measure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301949113"
	 b:glossaryEntry="(prosody) the rhythmic arrangement of syllables"/>
<rdf:Description rdf:about="&a;301949235"
	 b:glossaryEntry="recurring at regular intervals"/>
<rdf:Description rdf:about="&a;301949320">
	<b:glossaryEntry>uttered in a monotonous cadence or rhythm as in chanting; "their chantlike intoned prayers"; "a singsong manner of speaking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301949521"
	 b:glossaryEntry="stressing a normally weak beat"/>
<rdf:Description rdf:about="&a;301949608">
	<b:glossaryEntry>pounding or beating strongly or violently; "a throbbing pain"; "the throbbing engine of the boat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301949761"
	 b:glossaryEntry="not rhythmic; irregular in beat or accent"/>
<rdf:Description rdf:about="&a;301949928"
	 b:glossaryEntry="without regard for rhythm"/>
<rdf:Description rdf:about="&a;301950025"
	 b:glossaryEntry="deliberately not rhythmic"/>
<rdf:Description rdf:about="&a;301950108"
	 b:glossaryEntry="furnished or strengthened with ribs"/>
<rdf:Description rdf:about="&a;301950232"
	 b:glossaryEntry="(anatomy) having ribs"/>
<rdf:Description rdf:about="&a;301950307"
	 b:glossaryEntry="resembling a rib"/>
<rdf:Description rdf:about="&a;301950377"
	 b:glossaryEntry="having no ribs or no visible ribs"/>
<rdf:Description rdf:about="&a;301950464">
	<b:glossaryEntry>possessing material wealth; "her father is extremely rich"; "many fond hopes are pinned on rich uncles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301950708">
	<b:glossaryEntry>having an abundant supply of money or possessions of value; "an affluent banker"; "a speculator flush with cash"; "not merely rich but loaded"; "moneyed aristocrats"; "wealthy corporations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301950989">
	<b:glossaryEntry>in fortunate circumstances financially; moderately rich; "they were comfortable or even wealthy by some standards"; "easy living"; "a prosperous family"; "his family is well-situated financially"; "well-to-do members of the community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301951368">
	<b:glossaryEntry>having little money or few possessions; "deplored the gap between rich and poor countries"; "the proverbial poor artist living in a garret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301951684">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking funds; "`skint'' is a British slang term"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301951827"
	 b:glossaryEntry="poor enough to need help from others"/>
<rdf:Description rdf:about="&a;301951986"
	 b:glossaryEntry="not having enough money to pay for necessities"/>
<rdf:Description rdf:about="&a;301952167"
	 b:glossaryEntry='having no money; "virtually moneyless rural regions"'/>
<rdf:Description rdf:about="&a;301952275"
	 b:glossaryEntry='without income or means; "left his family unprovided for"'/>
<rdf:Description rdf:about="&a;301952396">
	<b:glossaryEntry>having an abundant supply of desirable qualities or substances (especially natural resources); "blessed with a land rich in minerals"; "rich in ideas"; "rich with cultural interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301952628">
	<b:glossaryEntry>badly supplied with desirable qualities or substances; "a poor land"; "the area was poor in timber and coal"; "food poor in nutritive value"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301952837"
	 b:glossaryEntry="lacking or deficient in natural resources"/>
<rdf:Description rdf:about="&a;301952937">
	<b:glossaryEntry>suggestive of or characterized by great expense; "a rich display"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301953089">
	<b:glossaryEntry>rich and superior in quality; "a princely sum"; "gilded dining rooms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301953265">
	<b:glossaryEntry>characterized by extravagance and profusion; "a lavish buffet"; "a lucullan feast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301953435">
	<b:glossaryEntry>characterized by or indicating lack of money; "the country had a poor economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301953600">
	<b:glossaryEntry>marked by poverty befitting a beggar; "a beggarly existence in the slums"; "a mean hut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301953749">
	<b:glossaryEntry>(of housing or residential areas) indicative of poverty; "a slummy part of town"; "slum conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301953911">
	<b:glossaryEntry>based on or arising from the possession of money or wealth; "moneyed interests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301954053"
	 b:glossaryEntry='not based on the possession of money; "a moneyless economy"'/>
<rdf:Description rdf:about="&a;301954168"
	 b:glossaryEntry="capable of meeting financial obligations"/>
<rdf:Description rdf:about="&a;301954262">
	<b:glossaryEntry>unable to meet or discharge financial obligations; "an insolvent person"; "an insolvent estate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301954431"
	 b:glossaryEntry='financially ruined; "a bankrupt company"'/>
<rdf:Description rdf:about="&a;301954526">
	<b:glossaryEntry>(metallurgy; chemistry) high in mineral content; "a rich vein of copper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301954667">
	<b:glossaryEntry>(of fuel) highly combustible; having a high proportion of fuel to air; "a rich gas mixture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301954816">
	<b:glossaryEntry>lacking in mineral content or combustible material; "lean ore"; "lean fuel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301954942">
	<b:glossaryEntry>having a rim or a rim of a specified kind; "do you wear rimmed or rimless glasses?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301955114">
	<b:glossaryEntry>having the framed made of horn or tortoise shell or plastic that simulates either; "horn-rimmed glasses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301955276">
	<b:glossaryEntry>rimmed with red; "your red-rimmed eyes reveal that you have been crying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301955405"
	 b:glossaryEntry='lacking a rim or frame; "rimless glasses"'/>
<rdf:Description rdf:about="&a;301955500">
	<b:glossaryEntry>having or involving the use of hands; "a handed, tree-living animal"; "a four-handed card game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301955666">
	<b:glossaryEntry>requiring two hands or designed for two people; "a two-handed sledgehammer"; "a two-handed crosscut saw"; "a machine designed for bimanual operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301955883"
	 b:glossaryEntry='without a hand or hands; "a handless war veteran"'/>
<rdf:Description rdf:about="&a;301955987">
	<b:glossaryEntry>having a usually specified type of handle; "pearl-handled revolver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301956109">
	<b:glossaryEntry>having no handle; "sleek cabinets with apparently handleless doors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301956233">
	<b:glossaryEntry>using or intended for the right hand; "a right-handed batter"; "right-handed scissors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301956468">
	<b:glossaryEntry>preferring to use right foot or hand or eye; ""dextral individuals exhibit dominance of the right hand and eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301956633"
	 b:glossaryEntry='intended for the right hand; "a right-hand glove"'/>
<rdf:Description rdf:about="&a;301956753">
	<b:glossaryEntry>using or intended for the right hand; "left-handed golfers need left-handed clubs"; "left-handed scissors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301957007">
	<b:glossaryEntry>intended for the right hand; "I rarely lose a left-hand glove"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301957138">
	<b:glossaryEntry>preferring to use left foot or hand or eye; "sinistral individuals exhibit dominance of the left hand and eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301957304"
	 b:glossaryEntry='equally skillful with each hand; "an ambidextrous surgeon"'/>
<rdf:Description rdf:about="&a;301957488">
	<b:glossaryEntry>lacking lateral dominance; being neither right-handed nor left-handed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301957614">
	<b:glossaryEntry>(baseball) able to bat either right-handed or left-handed; "a switch hitter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301957746"
	 b:glossaryEntry="of or belonging to the political or intellectual right"/>
<rdf:Description rdf:about="&a;301957960"
	 b:glossaryEntry="opposed to liberal reforms"/>
<rdf:Description rdf:about="&a;301958045"
	 b:glossaryEntry="extremely conservative"/>
<rdf:Description rdf:about="&a;301958151"
	 b:glossaryEntry="tending toward the political right"/>
<rdf:Description rdf:about="&a;301958240"
	 b:glossaryEntry="believing in or supporting tenets of the political right"/>
<rdf:Description rdf:about="&a;301958364"
	 b:glossaryEntry="of or belonging to the political or intellectual left"/>
<rdf:Description rdf:about="&a;301958594"
	 b:glossaryEntry="radical or extremely liberal"/>
<rdf:Description rdf:about="&a;301958677"
	 b:glossaryEntry="tending toward the political left"/>
<rdf:Description rdf:about="&a;301958764"
	 b:glossaryEntry="believing in or supporting tenets of the political left"/>
<rdf:Description rdf:about="&a;301958902">
	<b:glossaryEntry>having political or social views favoring reform and progress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301959017">
	<b:glossaryEntry>of or belonging to neither the right nor the left politically or intellectually</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301959185">
	<b:glossaryEntry>supporting or pursuing a course of action that is neither liberal nor conservative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301959343">
	<b:glossaryEntry>being or located on or directed toward the side of the body to the east when facing north; "my right hand"; "right center field"; "a right-hand turn"; on the right when facing downstream; "the right bank of the river"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301959702">
	<b:glossaryEntry>being the animal or vehicle on the right or being on the right side of an animal or vehicle; "the horse on the right is the far horse"; "the right side is the far side of the horse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301959934"
	 b:glossaryEntry='located on or directed toward the right; "a right-hand turn"'/>
<rdf:Description rdf:about="&a;301960054">
	<b:glossaryEntry>being or located on or directed toward the side of the body to the west when facing north; "my left hand"; "left center field"; on the left when facing downstream; "on the left bank"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301960377">
	<b:glossaryEntry>located on or directed toward the right; "a car with left-hand drive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301960505">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being on the left side; "the near or nigh horse is the one on the left"; "the animal''s left side is its near or nigh side"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301960691">
	<b:glossaryEntry>having a horn or horns or hornlike parts or horns of a particular kind; "horned viper"; "great horned owl"; "the unicorn--a mythical horned beast"; "long-horned cattle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301960984"
	 b:glossaryEntry="having antlers"/>
<rdf:Description rdf:about="&a;301961053"
	 b:glossaryEntry='having two horns or horn-shaped parts; "a bicornuate uterus"'/>
<rdf:Description rdf:about="&a;301961215">
	<b:glossaryEntry>shaped as having two horns; "the horned moon"; "the crescent moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301961336">
	<b:glossaryEntry>having horns or hornlike projections; "horny coral"; "horny (or horned) frog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301961465"
	 b:glossaryEntry='having no horns; "hornless cattle"'/>
<rdf:Description rdf:about="&a;301961554">
	<b:glossaryEntry>in conformance with justice or law or morality; "do the right thing and confess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301961794">
	<b:glossaryEntry>adhering to ethical and moral principles; "it seems ethical and right"; "followed the only honorable course of action"; "had the moral courage to stand alone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301962039">
	<b:glossaryEntry>contrary to conscience or morality or law; "it is wrong for the rich to take advantage of the poor"; "cheating is wrong"; "it is wrong to lie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301962413">
	<b:glossaryEntry>bringing or deserving severe rebuke or censure; "a criminal waste of talent"; "a deplorable act of violence"; "adultery is as reprehensible for a husband as for a wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301962679">
	<b:glossaryEntry>not adhering to ethical or moral principles; "base and unpatriotic motives"; "a base, degrading way of life"; "cheating is dishonorable"; "they considered colonialism immoral"; "unethical practices in handling public funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301963006">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) bad or erroneous or lack of; "the prefix `mis'' means bad in `misdeeds'', erroneous in `misunderstand'', and lacking in `mistrust''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301963193">
	<b:glossaryEntry>wrong in e.g. opinion or judgment; "well-meaning but misguided teachers"; "a mistaken belief"; "mistaken identity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301963374">
	<b:glossaryEntry>characterized by or proceeding from accepted standards of morality or justice; "the...prayer of a righteous man availeth much"- James 5:16</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301963712">
	<b:glossaryEntry>of moral excellence; "a genuinely good person"; "a just cause"; "an upright and respectable man"; "the life of the nation is secure only while the nation is honest, truthful, and virtuous"- Frederick Douglass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301963999"
	 b:glossaryEntry='free from moral defect; "a man of sound character"'/>
<rdf:Description rdf:about="&a;301964101"
	 b:glossaryEntry='not righteous; "an unrighteous man"; "an unrighteous law"'/>
<rdf:Description rdf:about="&a;301964360"
	 b:glossaryEntry='having committed unrighteous acts; "a sinful person"'/>
<rdf:Description rdf:about="&a;301964483">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not righteous; "`unjust'' is an archaic term for `unrighteous''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301964598"
	 b:glossaryEntry="physically strong"/>
<rdf:Description rdf:about="&a;301964884">
	<b:glossaryEntry xml:space='preserve'><![CDATA[muscular and heavily built; "a beefy wrestler"; "had a tall burly frame"; "clothing sizes for husky boys"; "a strapping boy of eighteen"; (`buirdly'' is a Scottish term; "a buirdly lad of twelve")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301965169">
	<b:glossaryEntry>having a bone structure that is massive in contrast with the surrounding flesh</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301965303">
	<b:glossaryEntry>marked by a large or well-developed chest; "he was big-chested, big-shouldered and heavy-armed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301965465"
	 b:glossaryEntry='having broad shoulders; "big-shouldered and heavy-armed"'/>
<rdf:Description rdf:about="&a;301965621"
	 b:glossaryEntry='extremely robust; "an iron constitution"'/>
<rdf:Description rdf:about="&a;301965724">
	<b:glossaryEntry>having rugged physical strength; inured to fatigue or hardships; "hardy explorers of northern Canada"; "proud of her tall stalwart son"; "stout seamen"; "sturdy young athletes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301965980">
	<b:glossaryEntry>having massive arms; "he was big-chested, big-shouldered and heavy-armed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301966111"
	 b:glossaryEntry="broad and solidly built"/>
<rdf:Description rdf:about="&a;301966193">
	<b:glossaryEntry>strong and active physically or mentally; "a vigorous old man who spent half of his day on horseback"- W.H.Hudson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301966361">
	<b:glossaryEntry xml:space='preserve'><![CDATA[physically weak; "an invalid''s frail body"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301966509">
	<b:glossaryEntry>lacking physical strength or vitality; "a feeble old woman"; "her body looked sapless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301966694"
	 b:glossaryEntry="having a circular shape"/>
<rdf:Description rdf:about="&a;301966960">
	<b:glossaryEntry>having the shape of a sphere or ball; "a spherical object"; "nearly orbicular in shape"; "little globular houses like mud-wasp nests"- Zane Grey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301967226"
	 b:glossaryEntry="(biology) being abruptly enlarged and globose at the tip"/>
<rdf:Description rdf:about="&a;301967337"
	 b:glossaryEntry='spherical; like a coccus; "a coccoid microorganism"'/>
<rdf:Description rdf:about="&a;301967442"
	 b:glossaryEntry="having a flat circular shape"/>
<rdf:Description rdf:about="&a;301967547"
	 b:glossaryEntry="resembling the moon in shape"/>
<rdf:Description rdf:about="&a;301967643"
	 b:glossaryEntry="resembling a nut in shape and size"/>
<rdf:Description rdf:about="&a;301967731"
	 b:glossaryEntry="having the shape of a ring"/>
<rdf:Description rdf:about="&a;301967812"
	 b:glossaryEntry="somewhat round in appearance or form"/>
<rdf:Description rdf:about="&a;301967903">
	<b:glossaryEntry>having four equal sides and four right angles or forming a right angle; "a square peg in a round hole"; "a square corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301968167"
	 b:glossaryEntry="having four sides and four angles"/>
<rdf:Description rdf:about="&a;301968255">
	<b:glossaryEntry>forming a right angle or containing one or more right angles; "a right-angled bend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301968397"
	 b:glossaryEntry="having been made square"/>
<rdf:Description rdf:about="&a;301968474"
	 b:glossaryEntry="somewhat square in appearance or form"/>
<rdf:Description rdf:about="&a;301968566">
	<b:glossaryEntry>curving and somewhat round in shape rather than jagged; "low rounded hills"; "rounded shoulders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301969166"
	 b:glossaryEntry="shaped like an almond"/>
<rdf:Description rdf:about="&a;301969290"
	 b:glossaryEntry="shaped like a ring"/>
<rdf:Description rdf:about="&a;301969431"
	 b:glossaryEntry="(optics) varying slightly from a perfectly spherical shape"/>
<rdf:Description rdf:about="&a;301969557"
	 b:glossaryEntry="having a shape resembling an ear"/>
<rdf:Description rdf:about="&a;301969657"
	 b:glossaryEntry="resembling the new moon in shape"/>
<rdf:Description rdf:about="&a;301969800">
	<b:glossaryEntry>having an outward curving front; "a bowfront dresser"; "a bowfront house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301969928"
	 b:glossaryEntry="resembling a circle"/>
<rdf:Description rdf:about="&a;301970013"
	 b:glossaryEntry="having the form of a cylinder or tube"/>
<rdf:Description rdf:about="&a;301970144"
	 b:glossaryEntry="having a hemispherical vault or dome"/>
<rdf:Description rdf:about="&a;301970242"
	 b:glossaryEntry="rounded like an egg"/>
<rdf:Description rdf:about="&a;301970385"
	 b:glossaryEntry="in the form of an ellipse"/>
<rdf:Description rdf:about="&a;301970508"
	 b:glossaryEntry="having the form of a parabola"/>
<rdf:Description rdf:about="&a;301970607"
	 b:glossaryEntry="having the shape of a paraboloid"/>
<rdf:Description rdf:about="&a;301970698"
	 b:glossaryEntry="having the form of a pine cone"/>
<rdf:Description rdf:about="&a;301970781"
	 b:glossaryEntry="resembling a rod"/>
<rdf:Description rdf:about="&a;301970864"
	 b:glossaryEntry="spherical in shape"/>
<rdf:Description rdf:about="&a;301970935"
	 b:glossaryEntry="(botany) especially of plant parts; cylindrical and tapering"/>
<rdf:Description rdf:about="&a;301971048"
	 b:glossaryEntry="having angles or an angular shape"/>
<rdf:Description rdf:about="&a;301971362"
	 b:glossaryEntry='forming or set at an angle; "angled parking"'/>
<rdf:Description rdf:about="&a;301971459"
	 b:glossaryEntry="shaped like a star"/>
<rdf:Description rdf:about="&a;301971546">
	<b:glossaryEntry>having two cusps or points; "bicuspid teeth"; "bicuspid leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301971678"
	 b:glossaryEntry="having cusps or points"/>
<rdf:Description rdf:about="&a;301971810"
	 b:glossaryEntry="having all angles equal"/>
<rdf:Description rdf:about="&a;301971891"
	 b:glossaryEntry="having or making equal angles"/>
<rdf:Description rdf:about="&a;301971975">
	<b:glossaryEntry>having four right angles; "a rectangular figure twice as long as it is wide""</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301972110"
	 b:glossaryEntry="having sharp corners"/>
<rdf:Description rdf:about="&a;301972191"
	 b:glossaryEntry='having three corners; "a three-cornered hat"'/>
<rdf:Description rdf:about="&a;301972296">
	<b:glossaryEntry>having three angles; forming or shaped like a triangle; "a triangular figure"; "a triangular pyrimid has a triangle for a base"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301972480">
	<b:glossaryEntry>having the equatorial diameter greater than the polar diameter; being flattened at the poles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301972660">
	<b:glossaryEntry>having the polar diameter greater than the equatorial diameter; "a prolate spheroid is generated by revolving an ellipse about its major axis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301972894">
	<b:glossaryEntry>living in or characteristic of farming or country life; "rural people"; "large rural households"; "unpaved rural roads"; "an economy that is basically rural"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301973319">
	<b:glossaryEntry>"an agrarian (or agricultural) society"; "farming communities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301973464">
	<b:glossaryEntry>characteristic of the fields or country; "agrestic simplicity"; "rustic stone walls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301973612">
	<b:glossaryEntry>used of idealized country life; "a country life of arcadian contentment"; "a pleasant bucolic scene"; "charming in its pastoral setting"; "rustic tranquility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301973855"
	 b:glossaryEntry='of fields or open country; "living in campestral seclusion"'/>
<rdf:Description rdf:about="&a;301973971">
	<b:glossaryEntry>characteristic of rural life; "countrified clothes"; "rustic awkwardness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301974125"
	 b:glossaryEntry='rough and uncouth; "a country boy"'/>
<rdf:Description rdf:about="&a;301974231">
	<b:glossaryEntry>typical of the country; "country-style sausage"; "country music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301974368">
	<b:glossaryEntry>characteristic of country life; "cracker-barrel philosophy"; "folksy humor"; "the air of homespun country boys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301974560"
	 b:glossaryEntry='found on a farm; "farm animals"; "a farm hand"'/>
<rdf:Description rdf:about="&a;301974660">
	<b:glossaryEntry>on the American frontier; "one of the last real frontier towns"; "hardships of frontier life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301974811"
	 b:glossaryEntry='(informal) rural and uncouth; "hick ideas"'/>
<rdf:Description rdf:about="&a;301974904">
	<b:glossaryEntry>marked by the wearing of heavy boots studded with hobnails; "hobnailed laborers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301975040">
	<b:glossaryEntry>located in or characteristic of a city or city life; "urban property owners"; "urban affairs"; "urban manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301975238">
	<b:glossaryEntry>being or having the customs or manners or dress of a city person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301975392">
	<b:glossaryEntry>made urban in nature; taking on urban characteristics; "the urbanized Eastern states"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301975533"
	 b:glossaryEntry='having accumulated rust; "rusted hinges"'/>
<rdf:Description rdf:about="&a;301975644">
	<b:glossaryEntry>covered with or consisting of rust; "a rusty machine"; "rusty deposits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301975767"
	 b:glossaryEntry="without rust"/>
<rdf:Description rdf:about="&a;301975888"
	 b:glossaryEntry="free of rust"/>
<rdf:Description rdf:about="&a;301975967"
	 b:glossaryEntry="treated against rusting"/>
<rdf:Description rdf:about="&a;301976060">
	<b:glossaryEntry>(of motor vehicles) having a coating of tar or rubber-based material applied to the underside to retard rusting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301976243">
	<b:glossaryEntry>belonging to or derived from or associated with a divine power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301976482">
	<b:glossaryEntry>Roman Catholic; proclaimed one of the blessed and thus worthy of veneration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301976623"
	 b:glossaryEntry='worthy of worship; "the Blessed Trinity"'/>
<rdf:Description rdf:about="&a;301976717">
	<b:glossaryEntry>made or declared or believed to be holy; devoted to a deity or some religious ceremony or use; "a consecrated chursh"; "the sacred mosque"; "sacred elephants"; "sacred bread and wine"; "sanctified wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301976999">
	<b:glossaryEntry xml:space='preserve'><![CDATA[worthy of religious veneration; "the sacred name of Jesus"; "Jerusalem''s hallowed soil"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301977150"
	 b:glossaryEntry="not hallowed or consecrated"/>
<rdf:Description rdf:about="&a;301977279"
	 b:glossaryEntry="not holy because unconsecrated or impure or defiled"/>
<rdf:Description rdf:about="&a;301977415">
	<b:glossaryEntry>concerned with religion or religious purposes; "sacred texts"; "sacred rites"; "sacred music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301977777">
	<b:glossaryEntry>devoted to or in the service or worship of a deity; "divine worship"; "divine liturgy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301977916"
	 b:glossaryEntry='too sacred to be uttered; "the ineffable name of the Deity"'/>
<rdf:Description rdf:about="&a;301978072"
	 b:glossaryEntry="imparting a divine influence on the mind and soul"/>
<rdf:Description rdf:about="&a;301978181"
	 b:glossaryEntry="must be kept sacred"/>
<rdf:Description rdf:about="&a;301978282">
	<b:glossaryEntry>evincing the presence of a deity; "a numinous wood"; "the most numinous moment in the Mass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301978427">
	<b:glossaryEntry>concerned with sacred matters or religion or the church; "religious texts"; "monks of a religious order"; "lords temporal and spiritual"; "spiritual leaders"; "spiritual songs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301978671"
	 b:glossaryEntry="worthy of adoration or reverence"/>
<rdf:Description rdf:about="&a;301978803"
	 b:glossaryEntry='of or relating to sacred rites; "sacral laws"'/>
<rdf:Description rdf:about="&a;301978901"
	 b:glossaryEntry="forbidden to profane use especially in South Pacific islands"/>
<rdf:Description rdf:about="&a;301979020">
	<b:glossaryEntry>not sacred or concerned with religion; "sacred and profane music"; "children being brought up in an entirely profane environment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301979311">
	<b:glossaryEntry>concerning those not members of the clergy; "set his collar in laic rather than clerical position"; "the lay ministry"; "the choir sings both sacred and secular music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301979545"
	 b:glossaryEntry="profaning or tending to desecrate"/>
<rdf:Description rdf:about="&a;301979636"
	 b:glossaryEntry="made secular"/>
<rdf:Description rdf:about="&a;301979706">
	<b:glossaryEntry>concerned with secular rather than sacred matters; "lords temporal and spiritual"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301979852">
	<b:glossaryEntry>deriving pleasure or sexual gratification from inflicting pain on another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301980016"
	 b:glossaryEntry="deriving pleasure from inflicting or enduring pain"/>
<rdf:Description rdf:about="&a;301980123">
	<b:glossaryEntry>deriving pleasure from inflicting pain on either another or yourself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301980253">
	<b:glossaryEntry>deriving pleasure or sexual gratification from being abused or dominated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301980419"
	 b:glossaryEntry="deriving pleasure from inflicting or enduring pain"/>
<rdf:Description rdf:about="&a;301980526">
	<b:glossaryEntry>deriving pleasure from inflicting pain on either oneself or another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301980655">
	<b:glossaryEntry>free from risk or danger; "a safe trip"; "you will be safe here"; "a safe place"; "a safe bet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301980980">
	<b:glossaryEntry>eliminating danger by compensating automatically for a failure or malfunction; "a fail-safe device in a nuclear weapon to deactivate it automatically in the event of accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301981211"
	 b:glossaryEntry='unlikely to harm or disturb anyone; "harmless old man"'/>
<rdf:Description rdf:about="&a;301981332">
	<b:glossaryEntry>freed from danger or blame or obligation; "I let him off the hook with a mild reprimand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301981482">
	<b:glossaryEntry>remote from any source of danger; "the children are out of danger here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301981625"
	 b:glossaryEntry="thought to be devoid of risk"/>
<rdf:Description rdf:about="&a;301981734">
	<b:glossaryEntry>free from danger or injury; "the children were found safe and sound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301981873">
	<b:glossaryEntry>involving or causing danger or risk; liable to hurt or harm; "a dangerous criminal"; "a dangerous bridge"; "unemployment reached dangerous proportions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301982305"
	 b:glossaryEntry='used of speed; "a breakneck pace"'/>
<rdf:Description rdf:about="&a;301982394">
	<b:glossaryEntry>of uncertain outcome; especially fraught with risk; "an extremely dicey future on a brave new world of liquid nitrogen, tar, and smog"- New Yorker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301982621">
	<b:glossaryEntry>(of persons) dangerously reckless or violent as from urgency or despair; "a desperate criminal"; "taken hostage of desperate men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301982806"
	 b:glossaryEntry="able or likely to do harm"/>
<rdf:Description rdf:about="&a;301982885">
	<b:glossaryEntry>involving risk or danger; "skydiving is a hazardous sport"; "extremely risky going out in the tide and fog"; "a venturesome journey in wintertime"; "a venturous enterprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301983147"
	 b:glossaryEntry="intended to entrap"/>
<rdf:Description rdf:about="&a;301983221">
	<b:glossaryEntry>caught in a difficult or dangerous situation; "there I was back on the hook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301983358">
	<b:glossaryEntry>fraught with danger; "dangerous waters"; "a parlous journey on stormy seas"; "a perilous voyage across the Atlantic in a small boat"; "the precarious life of an undersea diver"; "dangerous surgery followed by a touch-and-go recovery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301983684">
	<b:glossaryEntry>dangerous to yourself or your interests; "suicidal impulses"; "a suicidal corporate takeover strategy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301983860">
	<b:glossaryEntry>dangerously unstable and unpredictable; "treacherous winding roads"; "an unreliable trestle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301984023">
	<b:glossaryEntry>(baseball) having reached a base without being put out; "the runner was called safe when the baseman dropped the ball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301984195">
	<b:glossaryEntry>(baseball) not allowed to continue to bat or run; "he was tagged out at second on a close play"; "he fanned out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301984388"
	 b:glossaryEntry='out; "two down in the last of the ninth"'/>
<rdf:Description rdf:about="&a;301984482"
	 b:glossaryEntry="possible to sell"/>
<rdf:Description rdf:about="&a;301984599"
	 b:glossaryEntry='in demand by especially employers; "marketable skills"'/>
<rdf:Description rdf:about="&a;301984725"
	 b:glossaryEntry='fit to be offered for sale; "marketable produce"'/>
<rdf:Description rdf:about="&a;301984878"
	 b:glossaryEntry="impossible to sell"/>
<rdf:Description rdf:about="&a;301985001"
	 b:glossaryEntry="not capable of being sold"/>
<rdf:Description rdf:about="&a;301985085"
	 b:glossaryEntry="not fit for sale"/>
<rdf:Description rdf:about="&a;301985190">
	<b:glossaryEntry>closely similar or comparable in kind or quality or quantity or degree; " "curtains the same color as the walls"; "two girls of the same age"; "mother and son have the same blue eyes"; "animals of the same species"; "the same rules as before"; "two boxes having the same dimensions"; "the same day next year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301985765">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having the same sound (especially vowel sound) occurring in successive stressed syllables; "note the assonant words and syllables in `tilting at windmills''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301985976">
	<b:glossaryEntry>conforming in every respect; "boxes with corresponding dimensions"; "the like period of the preceding year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301986163"
	 b:glossaryEntry='identically copied from an original; "a duplicate key"'/>
<rdf:Description rdf:about="&a;301986273">
	<b:glossaryEntry>exactly alike; incapable of being perceived as different; "rows of identical houses"; "cars identical except for their license plates"; "they wore indistinguishable hats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301986519"
	 b:glossaryEntry='of the same kind or quality; "two animals of one species"'/>
<rdf:Description rdf:about="&a;301986629">
	<b:glossaryEntry>presenting or taking the same point of view; used especially of the first three gospels of the New Testament; "the synoptic Gospels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301986829">
	<b:glossaryEntry>unlike in nature or quality or form or degree; "took different approaches to the problem"; "came to a different conclusion"; "different parts of the country"; "on different sides of the issue"; "this meeting was different from the earlier one"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301987470">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) indicating difference or variation; "`allo'' is a prefix in the words `allomorph'' and `allophone''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301987627">
	<b:glossaryEntry>sharply contrasted in character or purpose; "practices entirely antithetical to her professed beliefs"; "hope is antithetic to despair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301987834">
	<b:glossaryEntry>of many different kinds purposefully arranged but lacking any uniformity; "assorted sizes"; "his disguises are many and various"; "various experiments have failed to disprove the theory"; "cited various reasons for his behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301988127">
	<b:glossaryEntry>very opposed in nature or character or purpose; "acts contrary to our code of ethics"; "the facts point to a contrary conclusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301988311">
	<b:glossaryEntry>strikingly different; tending to contrast; "contrasting (or contrastive) colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301988463">
	<b:glossaryEntry>characterized by opposite extremes; completely opposed; "in diametric contradiction to his claims"; "diametrical (or opposite) points of view"; "opposite meanings"; "extreme and indefensible polar positions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301988759">
	<b:glossaryEntry>diverging from another or from a standard; "a divergent opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301988894">
	<b:glossaryEntry>fundamentally different or distinct in quality or kind; "such disparate attractions as grand opera and game fishing"; "disparate ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301989085">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `from'') not alike; different in nature or quality; "plants of several distinct types"; "the word `nationalism'' is used in at least two distinct senses"; "gold is distinct from iron"; "a tree related to but quite distinct from the European beech"; "management had interests quite distinct from those of their employees"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301989495">
	<b:glossaryEntry>distinctly dissimilar or unlike; "diverse parts of the country"; "celebrities as diverse as Bob Hope and Bob Dylan"; "animals as various as the jaguar and the cavy and the sloth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301989737">
	<b:glossaryEntry>many and different; "tourist offices of divers nationalities"; "a person of diverse talents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301989895">
	<b:glossaryEntry xml:space='preserve'><![CDATA[altogether different in nature or quality or significance; "the medicine''s effect was opposite to that intended"; "it is said that opposite characters make a union happiest"- Charles Reade]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301990138"
	 b:glossaryEntry='distinct and individual; "three several times"'/>
<rdf:Description rdf:about="&a;301990241"
	 b:glossaryEntry='differing from a norm or standard; "a variant spelling"'/>
<rdf:Description rdf:about="&a;301990350">
	<b:glossaryEntry>same in identity; "the same man I saw yesterday"; "never wore the same dress twice"; "this road is the same one we were on yesterday"; "on the same side of the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301990622">
	<b:glossaryEntry>being the one previously mentioned or spoken of; "works of all the aforementioned authors"; "said party has denied the charges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301990838">
	<b:glossaryEntry>being the exact same one; not any other:; "this is the identical room we stayed in before"; "the themes of his stories are one and the same"; "saw the selfsame quotation in two newspapers"; "on this very spot"; "the very thing he said yesterday"; "the very man I want to see"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301991215"
	 b:glossaryEntry='combining form; oneself or itself; "self-control"'/>
<rdf:Description rdf:about="&a;301991315">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not the same one or ones already mentioned or implied; "today isn''t any other day"- the White Queen; "the construction of highways and other public works"; "he asked for other employment"; "any other person would tell the truth"; "his other books are still in storage"; "then we looked at the other house"; "hearing was good in his other ear"; "the other sex"; "she lived on the other side of the street from me"; "went in the other direction"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301992026">
	<b:glossaryEntry xml:space='preserve'><![CDATA[distinctly separate from the first; "that''s another (or different) issue altogether"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301992179">
	<b:glossaryEntry>any of various alternatives; some other; "put it off to another (or some other) day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301992333">
	<b:glossaryEntry>distinct or separate; "each interviewed different members of the community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301992464">
	<b:glossaryEntry xml:space='preserve'><![CDATA[other than what is under consideration or implied; "ask somebody else"; "I don''t know what else to do"; "where else can we look?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301992644">
	<b:glossaryEntry>other than the former one(s); different; "they now have a new leaders"; "my new car is four years old but has only 15,000 miles on it"; "ready to take a new direction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301992864">
	<b:glossaryEntry>the other one of a complementary pair; "the opposite sex"; "the two chess kings are set up on squares of opposite colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301993040">
	<b:glossaryEntry>being directly across from each other; facing; "And I on the opposite shore will be, ready to ride and spread the alarm"- Longfellow; "we lived on opposite sides of the street"; "at opposite poles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301993292">
	<b:glossaryEntry>moving or facing away from each other; "looking in opposite directions"; "they went in opposite directions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301993454">
	<b:glossaryEntry>being distinct from that or those first considered; "all parts of the house other than the windows were in good condition"; "apparently took no clothes other than those he was wearing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301993695">
	<b:glossaryEntry>being the remaining one or ones of several; "tried to sell the remaining books"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301993830">
	<b:glossaryEntry>marked by correspondence or resemblance; "similar food at similar prices"; "problems similar to mine"; "they wore similar coats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301994192">
	<b:glossaryEntry>similar or related in quality or character; "a feeling akin to terror"; "kindred souls"; "the amateur is closely related to the collector"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301994404">
	<b:glossaryEntry>similar or correspondent in some respects though otherwise dissimilar; "brains and computers are often considered analogous; "surimi is marketed as analogous to crabmeat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301994646">
	<b:glossaryEntry>so similar as to be easily confused; "potentially confusable senses of words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301994780">
	<b:glossaryEntry>similar in nature; "and mix with our connatural dust"- John Milton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301994903">
	<b:glossaryEntry>similar especially in position or purpose; "a number of corresponding diagonal points"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301995049">
	<b:glossaryEntry>having some resemblance; "a quasi success"; "a quasi contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301995166">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) having some of the characteristics of; "`semi'' is a prefix meaning similar in the word `semiofficial''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301995328"
	 b:glossaryEntry="very similar"/>
<rdf:Description rdf:about="&a;301995401">
	<b:glossaryEntry>not similar; "a group of very dissimilar people"; "a pump not dissimilar to those once found on every farm"; "their understanding of the world is not so dissimilar from our own"; "took different (or dissimilar) approaches to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301995713">
	<b:glossaryEntry>mentally healthy; free from mental disorder; "appears to be completely sane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301995912"
	 b:glossaryEntry="of sound mind, memory, and understanding"/>
<rdf:Description rdf:about="&a;301996034"
	 b:glossaryEntry="behaving responsibly"/>
<rdf:Description rdf:about="&a;301996170"
	 b:glossaryEntry='having a clear mind; "a lucid moment in his madness"'/>
<rdf:Description rdf:about="&a;301996274">
	<b:glossaryEntry>afflicted with or characteristic of mental derangement; "was declared insane"; "insane laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301996819">
	<b:glossaryEntry>in a murderous frenzy as if possessed by a demon; "the soldier was completely amuck"; "berserk with grief"; "a berserk worker smashing windows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301997070"
	 b:glossaryEntry="informal or slang terms for mentally irregular"/>
<rdf:Description rdf:about="&a;301997327"
	 b:glossaryEntry='affected with madness or insanity; "a man who had gone mad"'/>
<rdf:Description rdf:about="&a;301997523"
	 b:glossaryEntry="fit to be certified as insane (and treated accordingly)"/>
<rdf:Description rdf:about="&a;301997648"
	 b:glossaryEntry='insanely irresponsible; "an idiotic idea"'/>
<rdf:Description rdf:about="&a;301997758"
	 b:glossaryEntry="driven insane"/>
<rdf:Description rdf:about="&a;301997849"
	 b:glossaryEntry="slightly insane"/>
<rdf:Description rdf:about="&a;301997927">
	<b:glossaryEntry>suffering from a form of schizophrenia characterized by foolish mannerisms and senseless laughter along with delusions and regressive behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301998143">
	<b:glossaryEntry>(informal) some insane and believed to be affected by the phases of the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301998286"
	 b:glossaryEntry='wildly disordered; "a maniacal frenzy"'/>
<rdf:Description rdf:about="&a;301998392">
	<b:glossaryEntry>suffering from a disorder characterized by alternating mania and depression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301998530"
	 b:glossaryEntry="resembling the mania of manic-depressive illness"/>
<rdf:Description rdf:about="&a;301998634"
	 b:glossaryEntry='suffering from severe mental illness; "of unsound mind"'/>
<rdf:Description rdf:about="&a;301998769"
	 b:glossaryEntry="not of sound mind, memory, or understanding"/>
<rdf:Description rdf:about="&a;301998900"
	 b:glossaryEntry="suffering from paranoia"/>
<rdf:Description rdf:about="&a;301998978"
	 b:glossaryEntry="suffering from an undiagnosed mental disorder"/>
<rdf:Description rdf:about="&a;301999122"
	 b:glossaryEntry="(medicine) suffering from psychosis"/>
<rdf:Description rdf:about="&a;301999213"
	 b:glossaryEntry='talking or behaving irrationally; "a raving lunatic"'/>
<rdf:Description rdf:about="&a;301999338">
	<b:glossaryEntry>suffering from some form of schizophrenia; "schizophrenic patients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;301999465"
	 b:glossaryEntry="(informal) not behaving normally"/>
<rdf:Description rdf:about="&a;301999564"
	 b:glossaryEntry="supplied (especially fed) to satisfaction"/>
<rdf:Description rdf:about="&a;301999724"
	 b:glossaryEntry='dulled by surfeit; "the amoral, jaded, bored upper classes"'/>
<rdf:Description rdf:about="&a;301999835"
	 b:glossaryEntry="fed beyond capacity or desire"/>
<rdf:Description rdf:about="&a;301999937">
	<b:glossaryEntry>possible to satisfy or sate; "a satiable thirst"; "a satiable appetite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302000077">
	<b:glossaryEntry>impossible to satiate or satisfy; "an insatiable appetite"; "an insatiable hunger for knowledge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302000309"
	 b:glossaryEntry='impossible to quench; "unquenchable thirst"'/>
<rdf:Description rdf:about="&a;302000424"
	 b:glossaryEntry="not having been satisfied"/>
<rdf:Description rdf:about="&a;302000530"
	 b:glossaryEntry="impossible to satisfy"/>
<rdf:Description rdf:about="&a;302000611"
	 b:glossaryEntry="expressing or expressive of ridicule that wounds"/>
<rdf:Description rdf:about="&a;302000859">
	<b:glossaryEntry>capable of wounding; "a barbed compliment"; "a biting aphorism"; "pungent satire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302001022">
	<b:glossaryEntry>harshly ironic or sinister; "black humor"; "a grim joke"; "grim laughter"; "fun ranging from slapstick clowning ... to savage mordant wit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302001229">
	<b:glossaryEntry>disdainfully or ironically humorous; scornful and mocking; "his rebellion is the bitter, sardonic laughter of all great satirists"- Frank Schoenberner; "a wry pleasure to be...reminded of all that one is missing"- Irwin Edman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302001515">
	<b:glossaryEntry>exposing human folly to ridicule; "a persistent campaign of mockery by the satirical fortnightly magazine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302001687">
	<b:glossaryEntry>bitter or scornful; "the face was saturnine and swarthy, and the sensual lips...twisted with disdain"- Oscar Wilde</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302001857"
	 b:glossaryEntry="not sarcastic"/>
<rdf:Description rdf:about="&a;302001946">
	<b:glossaryEntry>giving satisfaction; "satisfactory living conditions"; "his grades were satisfactory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302002252">
	<b:glossaryEntry>about average; acceptable; "more than adequate as a secretary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302002399">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) being satisfactory or in satisfactory condition; "an all-right movie"; "the passengers were shaken up but are all right"; "is everything all right?"; "everything''s fine"; "things are okay"; "dinner and the movies had been fine"; "nother minute I''d have been fine"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302002773"
	 b:glossaryEntry="nonstandard usage"/>
<rdf:Description rdf:about="&a;302002844"
	 b:glossaryEntry="providing freedom from worry"/>
<rdf:Description rdf:about="&a;302002953">
	<b:glossaryEntry xml:space='preserve'><![CDATA[completely satisfactory; "his smile said that everything was copacetic"; "You had to be a good judge of what a man was like, and the English was copacetic"- John O''Hara]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302003214">
	<b:glossaryEntry>allowing you to pass (e.g., an examination or inspection) satisfactorily; "a passing grade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302003362">
	<b:glossaryEntry>in or into a satisfactory condition; "things are right again now"; "put things right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302003499">
	<b:glossaryEntry>not giving satisfaction; "shops should take back unsatisfactory goods"; "her performance proved to be unsatisfactory"; "life is becoming increasingly unsatifactory"; "our discussion was very unsatisfactory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302003874">
	<b:glossaryEntry>not up to expectations; "a disappointing performance from one who had seemed so promising"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302004057"
	 b:glossaryEntry='below acceptable in performance; "received failing grades"'/>
<rdf:Description rdf:about="&a;302004169">
	<b:glossaryEntry>below a satisfactory level; "an off year for tennis"; "his performance was off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302004298">
	<b:glossaryEntry>not adequate to give satisfaction: "the coach told his players that defeat was unacceptable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302004449">
	<b:glossaryEntry>capable of being scaled; possible to scale; "the scalable slope of a mountain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302004618"
	 b:glossaryEntry="possible to ascend"/>
<rdf:Description rdf:about="&a;302004706"
	 b:glossaryEntry="possible to climb"/>
<rdf:Description rdf:about="&a;302004779"
	 b:glossaryEntry="not possible to scale"/>
<rdf:Description rdf:about="&a;302004875"
	 b:glossaryEntry="impossible to climb"/>
<rdf:Description rdf:about="&a;302004952">
	<b:glossaryEntry>characteristic of scholars or scholarship; "scholarly pursuits"; "a scholarly treatise"; "a scholarly attitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302005227">
	<b:glossaryEntry>marked by a narrow focus on or display of learning especially its trivial aspects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302005384">
	<b:glossaryEntry>characterized by diligent study and fondness for reading; "a bookish farmer who always had a book in his pocket"; "a quiet studious child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302005587">
	<b:glossaryEntry>having or showing profound knowledge; "a learned jurist"; "an erudite professor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302005731"
	 b:glossaryEntry="not scholarly"/>
<rdf:Description rdf:about="&a;302005856"
	 b:glossaryEntry="not well learned"/>
<rdf:Description rdf:about="&a;302005928"
	 b:glossaryEntry="not studious"/>
<rdf:Description rdf:about="&a;302005997">
	<b:glossaryEntry>conforming with the principles or methods used in science; "a scientific approach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302006172">
	<b:glossaryEntry>based in scientific and industrial progress; "a technological civilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302006307">
	<b:glossaryEntry>not consistent with the methods or principles of science; "an unscientific lack of objectivity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302006497">
	<b:glossaryEntry>based on theories and methods erroneously regarded as scientific</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302006624">
	<b:glossaryEntry>having scruples; arising from a sense of right and wrong; principled; "less scrupulous producers sent bundles that were deceptive in appearance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302006861">
	<b:glossaryEntry>extremely scrupulous and conscientious; "religious in observing the rules of health"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302007001">
	<b:glossaryEntry>without scruples or principles; "unscrupulous politicos who would be happy to sell...their country in order to gain power"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302007200">
	<b:glossaryEntry>guided by or in accordance with conscience or sense of right and wrong; "a conscientious decision to speak out about injustice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302007405">
	<b:glossaryEntry>arising from the sense of right and wrong; "a moral obligation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302007520"
	 b:glossaryEntry="not conscientious; not guided by a sense of right and wrong"/>
<rdf:Description rdf:about="&a;302007659">
	<b:glossaryEntry>lacking a conscience; "a conscienceless villain"; "brash, unprincipled, and conscienceless"; "an unconscionable liar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302007854">
	<b:glossaryEntry>closed or secured with or as if with a seal; "my lips are sealed"; "the package is still sealed"; "the premises are sealed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302008120"
	 b:glossaryEntry="sealed with a cork"/>
<rdf:Description rdf:about="&a;302008191">
	<b:glossaryEntry>closed or secured tightly so as to prevent ingress or egress; "a sealed off pipe"; "the sealed off airport was surrounded by a cordon of police"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302008395"
	 b:glossaryEntry="marked with the impression of a seal"/>
<rdf:Description rdf:about="&a;302008485"
	 b:glossaryEntry='not yet opened or unsealed; "unopened Christmas presents"'/>
<rdf:Description rdf:about="&a;302008597">
	<b:glossaryEntry>not closed or secured with or as if with a seal; "unsealed goods"; "the letter arrived unsealed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302008784">
	<b:glossaryEntry>not sealed or having been unsealed; "the letter was already open"; "the opened package lay on the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302008948"
	 b:glossaryEntry='established irrevocably; "his fate is sealed"'/>
<rdf:Description rdf:about="&a;302009056"
	 b:glossaryEntry='not established or confirmed; "his doom is as yet unsealed"'/>
<rdf:Description rdf:about="&a;302009182">
	<b:glossaryEntry>enclosed securely in a covering of paper or the like; "gaily wrapped gifts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302009347">
	<b:glossaryEntry>(informal) wrapped and tied; "presents done up in white paper and red ribbon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302009478">
	<b:glossaryEntry>wrapped up or enclosed within a covering; "the little packet enwrapped in a faded yellow envelope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302009632">
	<b:glossaryEntry>not yet wrapped or having the wrapping removed; "she faced a mountainous pile of presents still unwrapped"; "the floor around the tree was littered with gifts already unwrapped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302009865"
	 b:glossaryEntry="fitted for a voyage"/>
<rdf:Description rdf:about="&a;302010030">
	<b:glossaryEntry>having the seams between planks packed with waterproof material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302010147"
	 b:glossaryEntry="furnished with all equipment needed for voyaging"/>
<rdf:Description rdf:about="&a;302010266"
	 b:glossaryEntry="having no leaks"/>
<rdf:Description rdf:about="&a;302010350"
	 b:glossaryEntry="unfit for a voyage"/>
<rdf:Description rdf:about="&a;302010498"
	 b:glossaryEntry="(of ships and boats) permitting leakage"/>
<rdf:Description rdf:about="&a;302010599"
	 b:glossaryEntry="not furnished with equipment needed for voyaging"/>
<rdf:Description rdf:about="&a;302010704"
	 b:glossaryEntry="of aircraft; fit to fly"/>
<rdf:Description rdf:about="&a;302010801"
	 b:glossaryEntry="not fit to fly"/>
<rdf:Description rdf:about="&a;302010891">
	<b:glossaryEntry>concealed or hidden on any grounds for any motive; "a concealed weapon"; "a concealed compartment in his briefcase"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302011296">
	<b:glossaryEntry>covered from view; "her face buried (or hidden) in her hands"; "a secret buried deep within herself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302011458">
	<b:glossaryEntry>lying in ambush; "bushwhacking guerrillas attacking from ambush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302011581">
	<b:glossaryEntry>secret; "keep it dark"; "the dark mysteries of Africa and the fabled wonders of the East"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302011721">
	<b:glossaryEntry>marked by quiet and caution and secrecy; taking pains to avoid being observed; "a furtive manner"; "a lurking prowler"; "a sneak attack"; "stealthy footsteps"; "a surreptitious glance at his watch"; "someone skulking in the shadows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302012075">
	<b:glossaryEntry>difficult to find; "hidden valleys"; "a hidden cave"; "an obscure retreat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302012212">
	<b:glossaryEntry>designed to elude detection; "a hidden room or place of concealment such as a priest hole"; "a secret passage"; "the secret compartment in the desk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302012422"
	 b:glossaryEntry="with your identity concealed"/>
<rdf:Description rdf:about="&a;302012509">
	<b:glossaryEntry>waiting in concealment; in ambush; "an army lying in wait in the forest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302012641">
	<b:glossaryEntry>concealed and unsuspected; "lurking dangers"; "search for lurking ambiguities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302012773">
	<b:glossaryEntry>undisclosed for the time being; "sealed orders"; "a sealed move in chess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302012899">
	<b:glossaryEntry>not open or public; kept private or not revealed; "a secret formula"; "secret ingredients"; "secret talks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302013058"
	 b:glossaryEntry='not openly expressed; "a sneaking suspicion"'/>
<rdf:Description rdf:about="&a;302013171">
	<b:glossaryEntry>not concealed or hidden; "her unconcealed hostility poisoned the atmosphere"; "watched with unconcealed curiosity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302013433">
	<b:glossaryEntry>without any attempt at concealment; completely obvious; "open disregard of the law"; "open family strife"; "open hostility"; "a blatant appeal to vanity"; "a blazing indiscretion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302013697">
	<b:glossaryEntry xml:space='preserve'><![CDATA[no longer concealed; uncovered as by opening a curtain; `discovered'' is archaic and primarily a theater term; "the scene disclosed was of a moonlit forest"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302013932">
	<b:glossaryEntry>easily visible; "she turned her back on her rival in full view of everyone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302014066"
	 b:glossaryEntry='not secret; "open plans"; "an open ballot"'/>
<rdf:Description rdf:about="&a;302014159">
	<b:glossaryEntry>covering or hiding; "the concealing darkness"; "concealing curtains prevented discovery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302014340">
	<b:glossaryEntry>concealing by enclosing or wrapping as if in something that is not solid; "the enveloping darkness"; "hills concealed by shrouding mists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302014552">
	<b:glossaryEntry>hiding from view; "speeding down the other lane beyond the masking truck"- T.H.White"; "a masking piece is a flat or curtain that hides part of the stage from the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302014778">
	<b:glossaryEntry>showing or making known; "her dress was scanty and revealing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302014931">
	<b:glossaryEntry>revealing unintentionally; "a betraying blush spread over her face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302015054">
	<b:glossaryEntry>allowing to be seen; making visible; "the screen fell with a disclosing crash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302015189">
	<b:glossaryEntry>belonging to or characteristic of a sect; "a sectarian mind"; "the negations of sectarian ideology"- Sidney Hook; "sectarian squabbles in psychology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302015430">
	<b:glossaryEntry>adhering or confined to a particular sect or denomination or party; "denominational prejudice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302015596"
	 b:glossaryEntry="rigidly adhering to a particular sect or its doctrines"/>
<rdf:Description rdf:about="&a;302015710">
	<b:glossaryEntry>not restricted to one sect or school or party; "religious training in a nonsectarian atmosphere"; "nonsectarian colleges"; "a wide and unsectarian interest in religion"- Bertrand Russell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302016041">
	<b:glossaryEntry>concerned with promoting unity among churches or religions; "ecumenical thinking"; "ecumenical activities"; "the ecumenical movement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302016268">
	<b:glossaryEntry>occurring between or among or common to different churches or denominations; "interchurch aid"; "interdenominational cooperation between Methodists and Presbyterians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302016514">
	<b:glossaryEntry>not restricted to a particular religious denomination; "a nondenominational church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302016661">
	<b:glossaryEntry>not bound to devoted to the promotion of a particular denomination; "undenominational religious instruction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302016832">
	<b:glossaryEntry>free from fear or doubt; easy in mind; "secure himself, he went out of his way to help others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302017003">
	<b:glossaryEntry>lacking self-confidence or assurance; "an insecure person lacking mental</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302017166"
	 b:glossaryEntry="anxious or nervous to an excessive degree"/>
<rdf:Description rdf:about="&a;302017265"
	 b:glossaryEntry="lacking boldness or confidence"/>
<rdf:Description rdf:about="&a;302017351">
	<b:glossaryEntry>free from danger or risk; "secure from harm"; "his fortune was secure"; "made a secure place for himself in his field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302017756">
	<b:glossaryEntry>characterized by certainty or security; "a tiny but assured income"; "we can never have completely assured lives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302017923"
	 b:glossaryEntry="secured by written agreement"/>
<rdf:Description rdf:about="&a;302018039">
	<b:glossaryEntry>having quality or payment or delivery guaranteed; "certified milk"; "certified check"; "certified mail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302018198">
	<b:glossaryEntry xml:space='preserve'><![CDATA[securely established; "an established reputation"; "holds a firm position as the country''s leading poet"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302018367">
	<b:glossaryEntry>guaranteed not to fail; "a fail-safe recipe for cheese souffle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302018486"
	 b:glossaryEntry="secure in formally authorized hands"/>
<rdf:Description rdf:about="&a;302018586">
	<b:glossaryEntry>assured by (usually) spoken agreement; "the promised toy"; "the promised land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302018719"
	 b:glossaryEntry='in safekeeping; "your secret is safe with me"'/>
<rdf:Description rdf:about="&a;302018815">
	<b:glossaryEntry>safe for the storage of valuables; "kept the deed in his safe-deposit box at the bank"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302018977">
	<b:glossaryEntry>physically secure or dependable; "a sure footing"; "was on sure ground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302019099">
	<b:glossaryEntry>lacking in security or safety; "his fortune was increasingly insecure"; "an insecure future"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302019381">
	<b:glossaryEntry>beset with attackers or controversy or conflict; "embattled troops"; "an embattled governor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302019529"
	 b:glossaryEntry='not secure; beset with difficulties; "a shaky marriage"'/>
<rdf:Description rdf:about="&a;302019649">
	<b:glossaryEntry>not safe from danger or mishap; "faced an uncertain future"; "an unsure existence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302019796"
	 b:glossaryEntry='without financial security; "an unsecured note"'/>
<rdf:Description rdf:about="&a;302019914">
	<b:glossaryEntry>not likely to fail or give way; "the lock was secure"; "a secure foundation"; "a secure hold on her wrist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302020145"
	 b:glossaryEntry='securely in position; not shaky; "held the ladder steady"'/>
<rdf:Description rdf:about="&a;302020255">
	<b:glossaryEntry>securely or solidly fixed in place; rigid; "the bolts are tight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302020371">
	<b:glossaryEntry>made tight or tighter; "the tightened ropes"; "a tightened bolt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302020491">
	<b:glossaryEntry>not firm or firmly fixed; likely to fail or give way; "the hinge is insecure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302020695">
	<b:glossaryEntry>not fixed firmly or tightly; "the bolts became loose over time"; "a loose chair leg"; "loose bricks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302020847"
	 b:glossaryEntry='dangerously insecure; "a precarious footing on the ladder"'/>
<rdf:Description rdf:about="&a;302020962">
	<b:glossaryEntry>not firm or secure; "balancing three boxes in an uncertain pile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302021082">
	<b:glossaryEntry>firmly closed or secured; "found the gate fastened"; "a fastened seatbelt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302021265">
	<b:glossaryEntry>firmly fastened or secured against opening; "windows and doors were all fast"; "a locked closet"; "left the house properly secured"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302021494">
	<b:glossaryEntry>fastened by pegs; "the pegged-down branches of the plant will take root"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302021624"
	 b:glossaryEntry='fastened with a pin or staple; "the stapled papers"'/>
<rdf:Description rdf:about="&a;302021738">
	<b:glossaryEntry>not closed or secured; "the car door was unfastened"; "unfastened seatbelts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302021907">
	<b:glossaryEntry>not firmly fastened or secured; "an unbarred door"; "went through the unlatched gate into the street"; "an unlocked room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302022129">
	<b:glossaryEntry>not fastened or tied or secured; "her blouse had come undone at the neck"; "his shoelaces were undone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302022284">
	<b:glossaryEntry>covered by insurance; "an insured risk"; "all members of the film cast and crew are insured"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302022430"
	 b:glossaryEntry='not covered by insurance; "an uninsured motorist"'/>
<rdf:Description rdf:about="&a;302022535"
	 b:glossaryEntry="tending to entice into a desired action or state"/>
<rdf:Description rdf:about="&a;302022747">
	<b:glossaryEntry>highly attractive and able to arouse hope or desire; "an alluring prospect"; "her alluring smile"; "the voice was low and beguiling"; "difficult to say no to an enticing advertisement"; "a tempting invitation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302023045"
	 b:glossaryEntry="seducing into corrupt practices"/>
<rdf:Description rdf:about="&a;302023133"
	 b:glossaryEntry='beguiling but harmful; "insidious pleasures"'/>
<rdf:Description rdf:about="&a;302023233">
	<b:glossaryEntry>arousing sexual desire without intending to satisfy it; "her lazy teasing smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302023367"
	 b:glossaryEntry="not seductive"/>
<rdf:Description rdf:about="&a;302023474"
	 b:glossaryEntry="not tempting"/>
<rdf:Description rdf:about="&a;302023556">
	<b:glossaryEntry>concerned chiefly or only with yourself; "Selfish men were...trying to make capital for themselves out of the sacred cause of civil rights"- Maria Weston Chapman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302023897"
	 b:glossaryEntry="that feels envy of another''s possessions"/>
<rdf:Description rdf:about="&a;302024015">
	<b:glossaryEntry>characteristic of those having an inflated idea of their own importance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302024185"
	 b:glossaryEntry="interested only in yourself"/>
<rdf:Description rdf:about="&a;302024286"
	 b:glossaryEntry="selfishly unwilling to share with others"/>
<rdf:Description rdf:about="&a;302024392"
	 b:glossaryEntry="not selfish"/>
<rdf:Description rdf:about="&a;302024585">
	<b:glossaryEntry>showing unselfish interest in the public welfare; "a public-spirited citizen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302024724"
	 b:glossaryEntry="willing to deprive yourself"/>
<rdf:Description rdf:about="&a;302024843"
	 b:glossaryEntry="showing lack of self-interest"/>
<rdf:Description rdf:about="&a;302024933">
	<b:glossaryEntry>unselfishly willing to share with others; "a warm and sharing friend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302025056">
	<b:glossaryEntry>older; higher in rank; longer in length of tenure or service; "senior officer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302025295">
	<b:glossaryEntry>used of the older of two persons of the same name especially used to distinguish a father from his son; "Bill Adams, Sr."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302025482">
	<b:glossaryEntry>(British) of the elder of two boys with the same family name; "Jones major"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302025613">
	<b:glossaryEntry>having precedence (especially because of longer service); "precedential treatment for senior members of the firm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302025785"
	 b:glossaryEntry='having a higher rank; "superior officer"'/>
<rdf:Description rdf:about="&a;302025910">
	<b:glossaryEntry>younger; lower in rank; shorter in length of tenure or service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302026115">
	<b:glossaryEntry>inferior in rank or status; "the junior faculty"; "a lowly corporal"; "petty officialdom"; "a subordinate functionary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302026384">
	<b:glossaryEntry>(British) of the younger of two boys with the same family name; "Jones minor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302026517">
	<b:glossaryEntry>used of the younger of two persons of the same name especially used to distinguish a son from his father; "John Junior"; "John Smith, Jr."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302026715"
	 b:glossaryEntry="causing intense interest, curiosity, or emotion"/>
<rdf:Description rdf:about="&a;302026892">
	<b:glossaryEntry>glaringly vivid and graphic; marked by sensationalism; "lurid details of the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302027041">
	<b:glossaryEntry>typical of tabloids; "sensational journalistic reportage of the scandal"; "yellow journalism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302027228">
	<b:glossaryEntry>resembling a scream in effect; "screaming headlines"; "screaming colors and designs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302027371">
	<b:glossaryEntry>not of such character as to arouse intense interest, curiosity, or emotional reaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302027534">
	<b:glossaryEntry>able to feel or perceive; "even amoeba are sensible creatures"; "the more sensible parts of the skin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302027756">
	<b:glossaryEntry>incapable of physical sensation; "insensible to pain"; "insensible earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302028030">
	<b:glossaryEntry>characterized by insensibility; "the young girls are in a state of possession--blind and deaf and anesthetic"; "an anesthetic state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302028239"
	 b:glossaryEntry="rendered insensible by means of anesthesia"/>
<rdf:Description rdf:about="&a;302028356"
	 b:glossaryEntry='lacking sensation; "my foot is asleep"; "numb with cold"'/>
<rdf:Description rdf:about="&a;302028486"
	 b:glossaryEntry="under the influence of a sedative drug"/>
<rdf:Description rdf:about="&a;302028578">
	<b:glossaryEntry xml:space='preserve'><![CDATA[responsive to physical stimuli; "a mimosa''s leaves are sensitive to touch"; "a sensitive voltmeter"; "sensitive skin"; "sensitive to light"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302029007">
	<b:glossaryEntry>of an instrument or device; capable of registering minute differences or changes precisely; "almost undetectable with even the most delicate instruments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302029215"
	 b:glossaryEntry="sensitive to sexual stimulation"/>
<rdf:Description rdf:about="&a;302029302"
	 b:glossaryEntry="(physiology) capable of responding to stimuli"/>
<rdf:Description rdf:about="&a;302029415">
	<b:glossaryEntry>readily affected by various agents; "a highly sensitive explosive is easily exploded by a shock"; "a sensitive colloid is readily coagulated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302029619"
	 b:glossaryEntry="(pathology) abnormally sensitive to a stimulus"/>
<rdf:Description rdf:about="&a;302029721">
	<b:glossaryEntry>sensitive to visible light; "photographic film is light-sensitive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302029866"
	 b:glossaryEntry="sensitive to radiation"/>
<rdf:Description rdf:about="&a;302029949">
	<b:glossaryEntry>caused by or in response to pain; "a nociceptive spinal reflex"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302030070">
	<b:glossaryEntry>tending to react to a stimulus; "the skin of the geriatric is less reactive than that of younger persons"- Louis Tuft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302030242">
	<b:glossaryEntry>not responsive to physical stimuli; "insensitive to radiation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302030488">
	<b:glossaryEntry>devoid of physical sensation; numb; "his gums were dead from the novocain"; "she felt no discomfort as the dentist drilled her deadened tooth"; "a public desensitized by continuous television coverage of atrocities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302030765">
	<b:glossaryEntry>made less sensitive; "desensitized to the allergen"; "desensitized photographic film is less sensitive to light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302030936"
	 b:glossaryEntry="not tending to react to stimulation"/>
<rdf:Description rdf:about="&a;302031043">
	<b:glossaryEntry>having acute mental or emotional sensibility; "sensitive to the local community and its needs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302031301">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'' or `of'') aware of; "is alive to the moods of others"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302031426"
	 b:glossaryEntry="quick to take offense"/>
<rdf:Description rdf:about="&a;302031523"
	 b:glossaryEntry="unduly sensitive or thin-skinned"/>
<rdf:Description rdf:about="&a;302031615">
	<b:glossaryEntry>susceptible to the feelings or attitudes of others; "keeping government in America responsive to the will of the people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302031792">
	<b:glossaryEntry>deficient in human sensibility; not mentally or morally sensitive; "insensitive to the needs of the patients"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302032175">
	<b:glossaryEntry>emotionally hardened; "a callous indifference to suffering"; "cold-blooded and indurate to public opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302032362">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'') not showing human feeling or sensitivity; unresponsive; "passersby were dead to our plea for help"; "numb to the cries for mercy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302032574">
	<b:glossaryEntry>rendered emotionally insensitive; "a desensitized public indifferent to the violence in films"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302032727">
	<b:glossaryEntry>blunted in responsiveness or sensibility; "a dull gaze"; "so exhausted she was dull to what went on about her"- Willa Cather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302032902">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'' or `by'') unaware of or indifferent to; "insensible to the suffering around him"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302033075"
	 b:glossaryEntry="lacking sensitivity or the capacity for deep feeling"/>
<rdf:Description rdf:about="&a;302033182"
	 b:glossaryEntry='not responsive; "a government unresponsive to their demands"'/>
<rdf:Description rdf:about="&a;302033301">
	<b:glossaryEntry>making susceptible or sensitive to either physical or emotional stimuli</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302033448">
	<b:glossaryEntry>making less susceptible or sensitive to either physical or emotional stimuli</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302033620">
	<b:glossaryEntry>causing numbness or insensitivity; "the numbing effect of grief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302033738">
	<b:glossaryEntry>involving or derived from the senses; "sensory experience"; "sensory channels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302033882"
	 b:glossaryEntry="seemingly outside normal sensory channels"/>
<rdf:Description rdf:about="&a;302034067"
	 b:glossaryEntry="perceiving things beyond the natural range of the senses"/>
<rdf:Description rdf:about="&a;302034181">
	<b:glossaryEntry>obtaining knowledge of distant events allegedly without use of normal sensory mechanisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302034327"
	 b:glossaryEntry="communicating without apparent physical signals"/>
<rdf:Description rdf:about="&a;302034431"
	 b:glossaryEntry="caused or enabled to go or be conveyed or transmitted"/>
<rdf:Description rdf:about="&a;302034589">
	<b:glossaryEntry>sent or carried from one place to another; "during battle, messages conveyed by carrier pigeon got through more often than those sent by plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302034787">
	<b:glossaryEntry>sent off or away; "the dispatched messenger was has hardly out of sight before she wished call him back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302034948">
	<b:glossaryEntry>sent electronically as by wire or radio; "the transmitted signals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302035072">
	<b:glossaryEntry>not dispatched or transmitted; "the letter remained unwritten and unsent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302035198">
	<b:glossaryEntry>independent; not united or joint; "a problem consisting of two separate issues"; "they went their separate ways"; "formed a separate church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302035663">
	<b:glossaryEntry>taken out of or separated from; "possibility is...achievability, abstracted from achievement"- A.N.Whitehead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302035838">
	<b:glossaryEntry>having characteristics not shared by others; "scientists felt they were a group apart"- Vannever Bush</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302035994">
	<b:glossaryEntry>widely separated especially in space; "as wide asunder as pole from pole"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302036124">
	<b:glossaryEntry>being or feeling set or kept apart from others; "she felt detached from the group"; "could not remain the isolated figure he had been"- Sherwood Anderson; "thought of herself as alone and separated from the others"; "had a set-apart feeling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302036455">
	<b:glossaryEntry>constituting a separate entity or part; "a government with three discrete divisions"; "on two distinct occasions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302036634"
	 b:glossaryEntry="(mathematics) having no elements in common"/>
<rdf:Description rdf:about="&a;302036731">
	<b:glossaryEntry>marked by separation of or from usually contiguous elements; "little isolated worlds, as abruptly disjunct and unexpected as a palm-shaded well in the Sahara"- Scientific Monthly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302036975"
	 b:glossaryEntry="capable of being isolated or disjoined"/>
<rdf:Description rdf:about="&a;302037068">
	<b:glossaryEntry>united or combined; "a joint session of Congress"; "joint owners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302037401">
	<b:glossaryEntry>joined in some kind of relationship (as a colleague or ally or companion etc.);"a cabal of associated lawyers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302037568">
	<b:glossaryEntry>characteristic of a clan especially in being unified; "clannish loyalty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302037695">
	<b:glossaryEntry>involving the joint activity of two or more; "the attack was met by the combined strength of two divisions"; "concerted action"; "the conjunct influence of fire and strong dring"; "the conjunctive focus of political opposition"; "a cooperative effort"; "a united effort"; "joint military activities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302038109">
	<b:glossaryEntry>consisting of two or more associated entities; "the interplay of these conjoined yet opposed factors"; "social order and prosperity, the conjoint aims of government"- J.K.Fairbank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302038355">
	<b:glossaryEntry>done by or characteristic of individuals acting together; "a joint identity"; "the collective mind"; "the corporate good"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302038545"
	 b:glossaryEntry="signing jointly with others"/>
<rdf:Description rdf:about="&a;302038630"
	 b:glossaryEntry="sharing equally with another or others"/>
<rdf:Description rdf:about="&a;302038722">
	<b:glossaryEntry>free from filth and pathogens; "sanitary conditions for preparing food"; "a sanitary washroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302038901">
	<b:glossaryEntry>tending to promote or preserve health; "hygienic habits like using disposable tissues"; "hygienic surroundings with plenty of fresh air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302039105">
	<b:glossaryEntry>not sanitary or healthful; "unsanitary open sewers"; "grim and unsanitary conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302039292">
	<b:glossaryEntry>so unclean as to be a likely cause of disease; "pathetic dogs kept in small unhygienic cages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302039442">
	<b:glossaryEntry>containing or resulting from disease-causing organisms; "a septic sore throat"; "a septic environment"; "septic sewage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302039776"
	 b:glossaryEntry='infected and filled with pus; "an abscessed tooth"'/>
<rdf:Description rdf:about="&a;302039882">
	<b:glossaryEntry>contaminated with infecting organisms; "dirty wounds"; "obliged to go into infected rooms"- Jane Austen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302040063"
	 b:glossaryEntry="tending to contaminate"/>
<rdf:Description rdf:about="&a;302040145">
	<b:glossaryEntry>having undergone infection; "festering sores"; "an infected wound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302040306">
	<b:glossaryEntry>caused by infection or capable of causing infection; viruses and other infective agents"; "a carrier remains infective without himself showing signs of the disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302040539"
	 b:glossaryEntry="causing or promoting bacterial putrefaction"/>
<rdf:Description rdf:about="&a;302040656">
	<b:glossaryEntry>characteristic of septicemia; "a septicemic temperature curve"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302040775">
	<b:glossaryEntry>thoroughly clean and free of or destructive to disease-causing organisms; "doctors in antiseptic green coats"; "the antiseptic effect of alcohol"; "it is said that marjoram has antiseptic qualities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302041174">
	<b:glossaryEntry>free of or using methods to keep free of pathological microorganisms; "a sterile operating area"; "aseptic surgical instruments"; "aseptic surgical techniques"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302041397">
	<b:glossaryEntry>preventing infection by inhibiting the growth or action of microorganisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302041557"
	 b:glossaryEntry="acting like an antiseptic"/>
<rdf:Description rdf:about="&a;302041650"
	 b:glossaryEntry="not containing pus"/>
<rdf:Description rdf:about="&a;302041726">
	<b:glossaryEntry>free from sepsis or infection; "a clean (or uninfected) wound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302041853">
	<b:glossaryEntry>free from germs or pathogenic organisms; sterile; "a germfree environment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302042036">
	<b:glossaryEntry>(of experimental animals) raised under sterile conditions; "axenic conditions"; "germfree animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302042187">
	<b:glossaryEntry>made free from live bacteria or other microorganisms; "sterilized instruments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302042335">
	<b:glossaryEntry>full of germs or pathological microorganisms; "the water in New York harbor is oily and dirty and germy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302042527"
	 b:glossaryEntry="not sterilized"/>
<rdf:Description rdf:about="&a;302042600">
	<b:glossaryEntry>making impure or corrupt by adding extraneous materials; "the adulterating effect of extraneous materials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302042796">
	<b:glossaryEntry>not belonging to that in which it is contained; introduced from an outside source; "water free of extraneous matter"; "foreign particles in milk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302043008">
	<b:glossaryEntry>freeing from noxious matter; "filtration is a purifying agent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302043180">
	<b:glossaryEntry>cleansing the body by washing; especially ritual washing of e.g. hands; "ablutionary rituals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302043343">
	<b:glossaryEntry>freeing from error or corruption; "the antiseptic effect of sturdy criticism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302043476"
	 b:glossaryEntry="having cleansing power"/>
<rdf:Description rdf:about="&a;302043566">
	<b:glossaryEntry xml:space='preserve'><![CDATA[concerned with work or important matters rather than play or trivialities; "a serious student of history"; "a serious attempt to learn to ski"; "gave me a serious look"; "a serious young man"; "are you serious or joking?"; "Don''t be so serious!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302043991">
	<b:glossaryEntry>characterized by firm belief in the validity of your opinions; "both sides were deeply in earnest, even passionate"; "an entirely sincere and cruel tyrant"; "a solemn vow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302044251">
	<b:glossaryEntry>dignified and somber in manner or character; "a grave God-fearing man"; "a quiet sedate nature"; "sober as a judge"; "the judge was solemn as he pronounced sentence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302044494"
	 b:glossaryEntry="excessively serious"/>
<rdf:Description rdf:about="&a;302044571">
	<b:glossaryEntry>not to be taken lightly; "statistics demonstrate that poverty and unemployment are very real problems"; "to the man sleeping regularly in doorways homelessness is real"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302044790">
	<b:glossaryEntry>acting with or showing thought and good sense; "a sensible young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302044927">
	<b:glossaryEntry>tending to make sober or more serious; "the news had a sobering effect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302045053">
	<b:glossaryEntry>not serious in content or attitude or behavior; "a frivolous novel"; "a frivolous remark"; "a frivolous young woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302045369">
	<b:glossaryEntry>lacking seriousness; given to frivolity; "a dizzy blonde"; "light-headed teenagers"; "silly giggles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302045596"
	 b:glossaryEntry='irresponsibly frivolous; "flighty young girls"'/>
<rdf:Description rdf:about="&a;302045706"
	 b:glossaryEntry="showing inappropriate levity"/>
<rdf:Description rdf:about="&a;302045804">
	<b:glossaryEntry>silly or trivial; "idle pleasure"; "light banter"; "light idle chatter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302045934">
	<b:glossaryEntry>intended primarily as entertainment; not serious or profound; "light verse"; "a light comedy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302046079">
	<b:glossaryEntry>concerned with trivialities; "a trivial young woman"; "a trivial mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302046203">
	<b:glossaryEntry>full of fun and high spirits; "playful children just let loose from school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302046476">
	<b:glossaryEntry>given to merry frolicking; "frolicsome students celebrated their graduation with parties and practical jokes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302046687"
	 b:glossaryEntry='playful in an appealingly bold way; "a roguish grin"'/>
<rdf:Description rdf:about="&a;302046815">
	<b:glossaryEntry>usually goodnaturedly mischievous; "perpetrated a practical joke with elfin delight"; "elvish tricks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302046986">
	<b:glossaryEntry>naughtily or annoyingly playful; "teasing and worrying with impish laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302047172"
	 b:glossaryEntry="playful like a lively kitten"/>
<rdf:Description rdf:about="&a;302047265">
	<b:glossaryEntry>playfully vexing (especially by ridicule); "his face wore a somewhat quizzical almost impertinent air"- Lawrence Durrell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302047461">
	<b:glossaryEntry>occupied in play or playful activities; "heard the laughter of playing children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302047595"
	 b:glossaryEntry="completely lacking in playfulness"/>
<rdf:Description rdf:about="&a;302047720"
	 b:glossaryEntry="chosen in preference to another"/>
<rdf:Description rdf:about="&a;302047878">
	<b:glossaryEntry>preferred above all others; "the chosen few"; "her chosen abode"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302047995"
	 b:glossaryEntry='selected or named for a duty; "designated hitter"'/>
<rdf:Description rdf:about="&a;302048101">
	<b:glossaryEntry>selected as the best; "an elect circle of artists"; "elite colleges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302048229"
	 b:glossaryEntry='carefully selected; "a hand-picked jury"'/>
<rdf:Description rdf:about="&a;302048327"
	 b:glossaryEntry="not selected"/>
<rdf:Description rdf:about="&a;302048414"
	 b:glossaryEntry='taken haphazardly; "a random choice"'/>
<rdf:Description rdf:about="&a;302048503">
	<b:glossaryEntry>ready for service or able to give long service; "serviceable equipment"; "heavy serviceable fabrics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302048787"
	 b:glossaryEntry='serviceable for a long time; "durable denim jeans"'/>
<rdf:Description rdf:about="&a;302048906"
	 b:glossaryEntry="capable of being made ready for service"/>
<rdf:Description rdf:about="&a;302049012"
	 b:glossaryEntry="made ready for service"/>
<rdf:Description rdf:about="&a;302049113">
	<b:glossaryEntry>fit or ready for use or service; "the toaster was still functional even after being dropped"; "the lawnmower is a bit rusty but still usable"; "an operational aircraft"; "the dishwasher is now in wording order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302049446">
	<b:glossaryEntry>not ready for service; "unserviceable equipment may be replaced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302049678">
	<b:glossaryEntry>not in working order; "had to push the broken-down car"; "a broken-down tractor fit only for children to play on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302049849">
	<b:glossaryEntry>inoperative as a result of heat or friction; "a burned-out picture tube"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302049990"
	 b:glossaryEntry="not able to perform its normal function"/>
<rdf:Description rdf:about="&a;302050097"
	 b:glossaryEntry="unserviceable because necessary repairs have not been made"/>
<rdf:Description rdf:about="&a;302050212"
	 b:glossaryEntry="available for service"/>
<rdf:Description rdf:about="&a;302050329">
	<b:glossaryEntry>(of a ship) in active service; "warships will remain in service when not refitting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302050469">
	<b:glossaryEntry>in good or usable condition; "put the old car back in condition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302050592"
	 b:glossaryEntry="not available for service"/>
<rdf:Description rdf:about="&a;302050717"
	 b:glossaryEntry="not in good condition"/>
<rdf:Description rdf:about="&a;302050801">
	<b:glossaryEntry>(of a ship) withdrawn from active service; "the ship was placed out of service after the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302050965"
	 b:glossaryEntry='living in a particular place; "resident aliens"'/>
<rdf:Description rdf:about="&a;302051067">
	<b:glossaryEntry>not living in a particular place or owned by permanent residents; "nonresident students who commute to classes"; "nonresident real estate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302051299"
	 b:glossaryEntry="(Maine colloquial) temporary summer resident in inland Maine"/>
<rdf:Description rdf:about="&a;302051411">
	<b:glossaryEntry>(Maine colloquial) temporary summer resident of coastal Maine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302051530">
	<b:glossaryEntry xml:space='preserve'><![CDATA[established in a desired position or place; not moving about; "nomads...absorbed among the settled people"; "settled areas"; "I don''t feel entirely settled here"; "the advent of settled civilization"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302051891">
	<b:glossaryEntry xml:space='preserve'><![CDATA[settled comfortably; "I don''t yet feel at home here"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302052000"
	 b:glossaryEntry='having a base of operations; "a company based in Atlanta"'/>
<rdf:Description rdf:about="&a;302052112"
	 b:glossaryEntry='peopled with settlers; "the built-up areas"'/>
<rdf:Description rdf:about="&a;302052210">
	<b:glossaryEntry>situated in a particular spot or position; "valuable centrally located urban land"; "strategically placed artillery"; "a house set on a hilltop"; "nicely situated on a quiet riverbank"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302052474"
	 b:glossaryEntry='not nomadic or wandering; "nonnomadic people"'/>
<rdf:Description rdf:about="&a;302052576"
	 b:glossaryEntry="settled in a new location"/>
<rdf:Description rdf:about="&a;302052669"
	 b:glossaryEntry='not settled or established; "an unsettled lifestyle"'/>
<rdf:Description rdf:about="&a;302052939">
	<b:glossaryEntry>continually changing especially as from one abode or occupation to another; "a drifting double-dealer"; "the floating population"; "vagrant hippies of the sixties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302053199">
	<b:glossaryEntry>having no fixed course; "an erratic comet"; "his life followed a wandering course"; "a planetary vagabond"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302053383"
	 b:glossaryEntry='without nationality or citizenship; "stateless persons"'/>
<rdf:Description rdf:about="&a;302053505">
	<b:glossaryEntry>habitually moving from place to place especially in search of seasonal work; "appalled by the social conditions of migrant life"; "migratory workers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302053720">
	<b:glossaryEntry>(of groups of people) tending to travel and change settlements frequently; "a restless mobile society"; "the nomadic habits of the Bedouins"; "believed the profession of a peregrine typist would have a happy future"; "wandering tribes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302054051">
	<b:glossaryEntry>traveling especially on foot; "peripatetic country preachers"; "a poor wayfaring stranger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302054211">
	<b:glossaryEntry>traveling from place to place to work; "itinerant labor"; "an itinerant judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302054345">
	<b:glossaryEntry>wandering aimlessly without ties to a place or community; "led a vagabond life"; "a rootless wanderer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302054513"
	 b:glossaryEntry="lacking a particular location"/>
<rdf:Description rdf:about="&a;302054598"
	 b:glossaryEntry='used of animals that move seasonally; "migratory birds'/>
<rdf:Description rdf:about="&a;302054708"
	 b:glossaryEntry="used of animals that do not migrate"/>
<rdf:Description rdf:about="&a;302054813">
	<b:glossaryEntry>established or decided beyond dispute or doubt; "with details of the wedding settled she could now sleep at night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302055071">
	<b:glossaryEntry>settled securely and unconditionally; "that smoking causes health problems is an accomplished fact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302055254">
	<b:glossaryEntry>fixed or established especially by order or command; "at the time appointed (or the appointed time")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302055444">
	<b:glossaryEntry>determined or decided upon as by an authority; "date and place are already determined"; "the dictated terms of surrender"; "the time set for the launching"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302055673">
	<b:glossaryEntry>not subject to revision or change; "a firm contract"; "a firm offer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302055792">
	<b:glossaryEntry>previously arranged or agreed on; "following preconcerted plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;302055915">
