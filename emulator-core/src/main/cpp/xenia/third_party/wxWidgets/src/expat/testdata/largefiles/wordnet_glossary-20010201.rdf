<rdf:Description rdf:about="&a;108245202">
	<b:glossaryEntry>genus of tropical American herbs sometimes included in genus Eupatorium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108245371">
	<b:glossaryEntry>low spreading tropical American shrub with long slender leaves used to make a mildly stimulating drink resembling tea; sometimes placed in genus Eupatorium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108245644">
	<b:glossaryEntry>shrubs of western hemisphere often having honey-scented flowers followed by silky thistlelike heads of tiny fruits; often used for erosion control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108245940">
	<b:glossaryEntry>a shrub of salt marshes of eastern and south central North America and West Indies; fruit is surrounded with white plumelike hairy tufts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108246235">
	<b:glossaryEntry>California shrub with slender leafy shoots that are important browse for mule deer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108246411">
	<b:glossaryEntry>widely spreading evergreen shrub of southwestern United States with flower heads in a leafy panicle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108246656">
	<b:glossaryEntry>genus of coarse western American herbs with large roots containing an aromatic balsam</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108246859">
	<b:glossaryEntry>a plant of the genus Balsamorhiza having white-downy leaves in a basal rosettend yellow flowers and long balsam-scented taproots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108247063"
	 b:glossaryEntry="daisy"/>
<rdf:Description rdf:about="&a;108247174">
	<b:glossaryEntry>any of numerous composite plants having flower heads with well-developed ray flowers usually arranged in a single whorl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108247382">
	<b:glossaryEntry>low-growing Eurasian plant with yellow central disc flowers and pinkish-white outer ray flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108247570"
	 b:glossaryEntry="bur marigolds"/>
<rdf:Description rdf:about="&a;108247689">
	<b:glossaryEntry>any of several plants of the genus Bidens having yellow flowers and prickly fruits that cling to fur and clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108248032"
	 b:glossaryEntry="common bur marigold of the eastern United States"/>
<rdf:Description rdf:about="&a;108248161"
	 b:glossaryEntry="the seed of bur marigolds"/>
<rdf:Description rdf:about="&a;108248282"
	 b:glossaryEntry="North American bur marigold with large flowers"/>
<rdf:Description rdf:about="&a;108248433"
	 b:glossaryEntry="of temperate Eurasia"/>
<rdf:Description rdf:about="&a;108248585">
	<b:glossaryEntry>bur marigold of eastern and northern United States and Canada common in wet pastures and meadows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108248764"
	 b:glossaryEntry="a variety of knapweed"/>
<rdf:Description rdf:about="&a;108248848"
	 b:glossaryEntry="a variety of knapweed"/>
<rdf:Description rdf:about="&a;108248931">
	<b:glossaryEntry>genus of tall leafy perennial herbs of eastern America and eastern Asia having flowers that resemble asters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108249148">
	<b:glossaryEntry>any of various autumn-flowering perennials having white or pink to purple flowers that resemble asters; wild in moist soils from New Jersey to Florida and Texas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108249389">
	<b:glossaryEntry>mostly Australian herbs having basal or alternate leaves and loosely corymbose flower heads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108249594">
	<b:glossaryEntry>western Australian annual much cultivated for its flower heads with white or bluish to violet or variegated rays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108249814">
	<b:glossaryEntry>genus of herbs of southwestern America having usually creamy florets followed by one-seeded fruits in a prominent bristly sheath</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108250036"
	 b:glossaryEntry="oxeye"/>
<rdf:Description rdf:about="&a;108250157">
	<b:glossaryEntry>Eurasian perennial herbs having daisylike flowers with yellow rays and dark centers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108250329">
	<b:glossaryEntry>hairy Eurasian perennial having deep yellow daisies on lax willowy stems; found in the wild in open woodland and on rocky slopes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108250545">
	<b:glossaryEntry>genus of tall smooth herbs of forested mountains of Europe and Asia minor; in some classifications includes many plants usually placed in genus Emilia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108250803">
	<b:glossaryEntry>any of various plants of the genus Cacalia having leaves resembling those of plantain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108250969"
	 b:glossaryEntry="marigold"/>
<rdf:Description rdf:about="&a;108251077">
	<b:glossaryEntry>any of numerous chiefly annual herbs of the genus Calendula widely cultivated for their yellow or orange flowers; often used for medicinal and culinary purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108251330"
	 b:glossaryEntry="the common European annual marigold"/>
<rdf:Description rdf:about="&a;108251494"
	 b:glossaryEntry="1 species: erect Asiatic herb with large flowers"/>
<rdf:Description rdf:about="&a;108251660">
	<b:glossaryEntry>valued for their beautiful flowers in a wide range of clear bright colors; grown primarily for cutting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108251864">
	<b:glossaryEntry>any of numerous plants of the family_Compositae and especially of the genera Carduus and Cirsium and Onopordum having prickly-edged leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108252237"
	 b:glossaryEntry="genus of annual or perennial Old World prickly thistles"/>
<rdf:Description rdf:about="&a;108252419">
	<b:glossaryEntry>European biennial introduced in North America having flower heads in crowded clusters at ends of spiny-winged branches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108252635">
	<b:glossaryEntry>Eurasian perennial naturalized in eastern North America having very spiny white cottony foliage and nodding musky crimson flower heads; valuable source of nectar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108252909"
	 b:glossaryEntry="genus of Mediterranean thistles"/>
<rdf:Description rdf:about="&a;108253048"
	 b:glossaryEntry="a thistle of the genus Carlina"/>
<rdf:Description rdf:about="&a;108253195">
	<b:glossaryEntry>stemless perennial having large flowers with white or purple-brown florets nestled in a rosette of long spiny leaves hairy beneath; of alpine regions of southern and eastern Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108253464"
	 b:glossaryEntry="Eurasian thistle growing in sand dunes and dry chalky soils"/>
<rdf:Description rdf:about="&a;108253611"
	 b:glossaryEntry="safflower"/>
<rdf:Description rdf:about="&a;108253732">
	<b:glossaryEntry>thistlelike Eurasian plant widely grown for its red or orange flower heads and seeds that yield a valuable oil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108253995"
	 b:glossaryEntry="seed of the safflower"/>
<rdf:Description rdf:about="&a;108254115">
	<b:glossaryEntry>oil from safflower seeds used as food as well as in medicines and paints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108254266"
	 b:glossaryEntry="genus of Mediterranean herbs: cupid''s dart"/>
<rdf:Description rdf:about="&a;108254409">
	<b:glossaryEntry>any of several plants of the genus Catananche having long-stalked heads of blue or yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108254600">
	<b:glossaryEntry>south European plant having dark-eyed flowers with flat blue rays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108254760"
	 b:glossaryEntry="knapweed; star thistle"/>
<rdf:Description rdf:about="&a;108254932"
	 b:glossaryEntry="any plant of the genus Centaurea"/>
<rdf:Description rdf:about="&a;108255110">
	<b:glossaryEntry>annual of southwestern United States cultivated for its purple-rayed flower heads and its basket-like bracts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108255301"
	 b:glossaryEntry="a plant having leaves and stems covered with dust-like down"/>
<rdf:Description rdf:about="&a;108255464">
	<b:glossaryEntry>an annual Eurasian plant cultivated in North America having showy heads of blue or purple or pink or white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108255706">
	<b:glossaryEntry>Mediterannean annual or biennial herb having pinkish to purple flowers surrounded by spine-tipped scales; naturalized in America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108255926">
	<b:glossaryEntry>any of various plants of the genus Centaurea having purple thistlelike flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108256131">
	<b:glossaryEntry>perennial of mountains of Iran and Iraq; cultivated for its fragrant rose-pink flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108256318">
	<b:glossaryEntry>a weedy perennial with tough wiry stems and purple flowers; native to Europe but widely naturalized</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108256526"
	 b:glossaryEntry="tall European perennial having purple flower heads"/>
<rdf:Description rdf:about="&a;108256677">
	<b:glossaryEntry>European weed having a winged stem and hairy leaves; adventive in the eastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108256879">
	<b:glossaryEntry>small genus of plants sometimes included in genus Anthemis: chamomile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108257064">
	<b:glossaryEntry>Eurasian plant apple-scented foliage and white-rayed flowers and feathery leaves used medicinally; in some classification systems placed in genus Anthemis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108257364"
	 b:glossaryEntry="genus of flowering herbs of western United States"/>
<rdf:Description rdf:about="&a;108257514">
	<b:glossaryEntry>any of several United States plants having long stalks of funnel-shaped white or yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108257686">
	<b:glossaryEntry>in some classifications many plants usually assigned to the genus Chrysanthemum have been divided among other genera: e.g. Argyranthemum; Dendranthema; Leucanthemum; Tanacetum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108258003">
	<b:glossaryEntry>any of numerous perennial Old World herbs having showy brightly colored flower heads of the genera Chrysanthemum; Argyranthemum; Dendranthema; Tanacetum; widely cultivated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108258344">
	<b:glossaryEntry>European herb with bright yellow flowers; a common weed in grain fields</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108258535">
	<b:glossaryEntry>shrubby annual of the Mediterranean region with yellowish-white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108258710">
	<b:glossaryEntry>grown for its succulent edible leaves used in Oriental cooking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108258932"
	 b:glossaryEntry="the flower of a chrysanthemum plant"/>
<rdf:Description rdf:about="&a;108259046"
	 b:glossaryEntry="golden aster"/>
<rdf:Description rdf:about="&a;108259172">
	<b:glossaryEntry>any of several shrubby herbs or subshrubs of the genus Chrysopsis having bright golden-yellow flower heads that resemble asters; throughout much of United States and into Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108259481"
	 b:glossaryEntry="perennial golden aster of southeastern United States"/>
<rdf:Description rdf:about="&a;108259622"
	 b:glossaryEntry="a variety of golden aster"/>
<rdf:Description rdf:about="&a;108259719"
	 b:glossaryEntry="a variety of golden aster"/>
<rdf:Description rdf:about="&a;108259814"
	 b:glossaryEntry="genus of low branching shrubs of western North America"/>
<rdf:Description rdf:about="&a;108260007">
	<b:glossaryEntry>any of various much-branched yellow-flowered shrubs of the genus Chrysothamnus; western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108260202">
	<b:glossaryEntry>pleasantly aromatic shrub having erect slender flexible hairy branches and dense clusters of small yellow flowers covering vast areas of western alkali plains and affording a retreat for jackrabbits; source of a yellow dye used by Navajo Indians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108260565"
	 b:glossaryEntry="chicory"/>
<rdf:Description rdf:about="&a;108260703">
	<b:glossaryEntry>perennial Old World herb having rayed flower heads with blue florets cultivated for its root and its heads of crisp edible leaves used in salads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108261004">
	<b:glossaryEntry>widely cultivated herb with leaves valued as salad green; either curly serrated leaves or broad flat ones that are usually blanched</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108261275">
	<b:glossaryEntry>the dried root of the chicory plant: used as a coffee substitute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108261427"
	 b:glossaryEntry="plume thistles"/>
<rdf:Description rdf:about="&a;108261549">
	<b:glossaryEntry>any of numerous biennial to perennial herbs with handsome purple or yellow or occasionally white flower heads</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108261826">
	<b:glossaryEntry>European thistle naturalized in United States and Canada where it is a pernicious weed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108262010"
	 b:glossaryEntry="stout North American thistle with purplish-pink flower heads"/>
<rdf:Description rdf:about="&a;108262149"
	 b:glossaryEntry="thistle of western North America having white woolly leaves"/>
<rdf:Description rdf:about="&a;108262307">
	<b:glossaryEntry>woolly thistle of western and central Europe and Balkan Peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108262463">
	<b:glossaryEntry>perennial stoloniferous thistle of northern Europe with lanceolate basal leaves and usually solitary heads of reddish-purple flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108262705"
	 b:glossaryEntry="of central and southwestern Europe"/>
<rdf:Description rdf:about="&a;108262818">
	<b:glossaryEntry>European thistle with rather large heads and prickly leaves; extensively naturalized as a weed in the United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108263063"
	 b:glossaryEntry="1 species: blessed thistle"/>
<rdf:Description rdf:about="&a;108263195">
	<b:glossaryEntry>annual of Mediterranean to Portugal having hairy stems and minutely spiny-toothed leaves and large heads of yellow flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108263433"
	 b:glossaryEntry="mistflower"/>
<rdf:Description rdf:about="&a;108263559">
	<b:glossaryEntry>rhizomatous plant of central and southeastern United States and West Indies having large showy heads of clear blue flowers; sometimes placed in genus Eupatorium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108263857"
	 b:glossaryEntry="common American weed or wildflower"/>
<rdf:Description rdf:about="&a;108263997">
	<b:glossaryEntry>common North American weed with linear leaves and small discoid heads of yellowish flowers; widely naturalized throughout temperate regions; sometimes placed in genus Erigeron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108264320"
	 b:glossaryEntry="genus of American plants widely cultivated for their flowers"/>
<rdf:Description rdf:about="&a;108264499">
	<b:glossaryEntry>any of numerous plants of the genus Coreopsis having a profusion of showy usually yellow daisylike flowers over long periods; North and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108264799">
	<b:glossaryEntry>used in some classification systems for some plants of genus Coreopsis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108264954">
	<b:glossaryEntry>large treelike shrub having feathery leaves and clusters of large yellow flower heads; coastal southern California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108265151">
	<b:glossaryEntry>stout herb with flowers one to a stalk; ornamental developed from a Mexican wildflower</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108265315">
	<b:glossaryEntry>North American annual widely cultivated for its yellow flowers with purple-red to brownish centers; in some classifications placed in a subgenus Calliopsis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108265549">
	<b:glossaryEntry>genus of tropical American plants cultivated for their colorful flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108265717">
	<b:glossaryEntry>any of various mostly Mexican herbs of the genus Cosmos having radiate heads of variously colored flowers and pinnate leaves; popular fall-blooming annuals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108265944">
	<b:glossaryEntry>cosmopolitan herbs especially southern hemisphere; many used as ground covers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108266127">
	<b:glossaryEntry>South African herb with golden-yellow globose flower heads; naturalized in moist areas along coast of California; cultivated as an ornamental</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108266370"
	 b:glossaryEntry="herbs of Australia and New Zealand"/>
<rdf:Description rdf:about="&a;108266516">
	<b:glossaryEntry>any of various plants of the genus Craspedia grown for their downy foliage and globose heads of golden flowers; Australia and New Zealand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108266732"
	 b:glossaryEntry="hawk''s beard; cosmopolitan in northern hemisphere"/>
<rdf:Description rdf:about="&a;108266887">
	<b:glossaryEntry>any of various plants of the genus Crepis having loose heads of yellow flowers on top of a long branched leafy stem; northern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108267117"
	 b:glossaryEntry="artichoke; cardoon"/>
<rdf:Description rdf:about="&a;108267260">
	<b:glossaryEntry>Mediterranean thistlelike plant widely cultivated for its large edible flower head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108267490">
	<b:glossaryEntry>southern European plant having spiny leaves and purple flowers cultivated for its edible leafstalks and roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108267712">
	<b:glossaryEntry>genus of perennial tuberous-rooted plants of Mexico and Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108267880">
	<b:glossaryEntry>any of several plants of or developed from the species Dahlia pinnata having tuberous roots and showy rayed variously colored flower heads; native to the mountains of Mexico and Central America and Colombia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108268175"
	 b:glossaryEntry="1 species: German ivy"/>
<rdf:Description rdf:about="&a;108268306">
	<b:glossaryEntry>South African succulent evergreen twining climber with yellow flowers grown primarily as a houseplant for its ivylike foliage; sometimes placed in genus Senecio</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108268584"
	 b:glossaryEntry="comprises plants often included in the genus Chrysanthemum"/>
<rdf:Description rdf:about="&a;108268741"
	 b:glossaryEntry="of China"/>
<rdf:Description rdf:about="&a;108268907"
	 b:glossaryEntry="South African herbs or subshrubs with usually yellow flowers"/>
<rdf:Description rdf:about="&a;108269087">
	<b:glossaryEntry>any of several South African plants grown for the profusion of usually yellow daisylike flowers and mounds of aromatic foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108269327">
	<b:glossaryEntry>genus of Eurasian perennial tuberous or rhizomatous herbs: leopard''s bane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108269512">
