	 b:glossaryEntry="American ceratopsian dinosaurs"/>
<rdf:Description rdf:about="&a;101224703"
	 b:glossaryEntry="small horned dinosaurs"/>
<rdf:Description rdf:about="&a;101224810"
	 b:glossaryEntry="small horned dinosaur"/>
<rdf:Description rdf:about="&a;101224891"
	 b:glossaryEntry="genus of herbivorous horned dinosaurs"/>
<rdf:Description rdf:about="&a;101225030">
	<b:glossaryEntry>huge ceratopsian dinosaur having three horns and the neck heavily armored with a very solid frill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101225204"
	 b:glossaryEntry="genus of horned dinosaurs"/>
<rdf:Description rdf:about="&a;101225333">
	<b:glossaryEntry>an unusual ceratopsian dinosaur having many large spikes around the edge of its bony frill and a long nose horn; late Cretaceous</b:glossaryEntry>
</rdf:Description>
