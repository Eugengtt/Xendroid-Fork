	 b:glossaryEntry='on the stage; "it was time for her to go onstage"'/>
<rdf:Description rdf:about="&a;400255068"
	 b:glossaryEntry='beyond the regular time; "she often has to work overtime"'/>
<rdf:Description rdf:about="&a;400255162"
