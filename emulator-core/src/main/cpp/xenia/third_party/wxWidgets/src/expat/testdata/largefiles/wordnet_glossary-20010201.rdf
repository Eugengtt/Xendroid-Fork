<rdf:Description rdf:about="&a;101956981"
	 b:glossaryEntry="coextensive with the order Pholidota"/>
<rdf:Description rdf:about="&a;101957126"
	 b:glossaryEntry="type genus of the Manidae"/>
<rdf:Description rdf:about="&a;101957255">
	<b:glossaryEntry>toothless mammal of southern Africa and Asia having a body covered with horny scales and a long snout for feeding on ants and termites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101957491"
	 b:glossaryEntry="the part between the fetlock and the hoof"/>
<rdf:Description rdf:about="&a;101957638">
	<b:glossaryEntry>margin between the skin of the pastern and the horn of the hoof</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101957774"
	 b:glossaryEntry="projection behind and above a horse''s hoof"/>
<rdf:Description rdf:about="&a;101957889"
	 b:glossaryEntry="the joint between the cannon bone and the pastern"/>
<rdf:Description rdf:about="&a;101958027">
	<b:glossaryEntry>the highest part of the back at the base of the neck of various animals especially draft animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101958253">
	<b:glossaryEntry>lower part of the leg extending from the hock to the fetlock in hoofed mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101958449">
	<b:glossaryEntry>greatly developed metatarsal or metacarpal bone in the shank or cannon part of the leg in hoofed mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101958630">
	<b:glossaryEntry>tarsal joint of the hind leg of hoofed mammals; corresponds to the human ankle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101958797">
	<b:glossaryEntry>each side of the backbone between the hipbone and the ribs in humans as well as quadrupeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101958984">
	<b:glossaryEntry>the part of a quadruped that corresponds to the human buttocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101959166"
	 b:glossaryEntry="the loin and leg of a quadruped"/>
<rdf:Description rdf:about="&a;101959269">
	<b:glossaryEntry>lower part of a horse''s thigh between the hock and the stifle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101959421">
	<b:glossaryEntry>joint between the femur and tibia in a quadruped; corresponds to the human knee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101959579"
	 b:glossaryEntry="the side between ribs and hipbone"/>
<rdf:Description rdf:about="&a;101959683"
	 b:glossaryEntry="the leg of an animal"/>
<rdf:Description rdf:about="&a;101959817"
	 b:glossaryEntry="a posterior leg or homologous structure in other animals"/>
<rdf:Description rdf:about="&a;101959947"
	 b:glossaryEntry="the back limb of a quadruped"/>
<rdf:Description rdf:about="&a;101960106">
	<b:glossaryEntry>the front limb (or homologous structure in other animals such as a flipper or wing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101960281"
	 b:glossaryEntry="the front limb of a quadruped"/>
<rdf:Description rdf:about="&a;101960402">
	<b:glossaryEntry>the flat broad limb of aquatic animals specialized for swimming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101960557">
	<b:glossaryEntry>one of a pair of fleshy appendages of a polychete annelid that functions in locomotion and breathing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101960714">
	<b:glossaryEntry>an organ specialized for sucking nourishment or for adhering to objects by suction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101960867"
	 b:glossaryEntry="a sucker on the feet of certain flies"/>
<rdf:Description rdf:about="&a;101960957">
	<b:glossaryEntry>a sharp organ of offense or defense (as of a wasp or stingray or scorpion) often connected with a poison gland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101961139">
	<b:glossaryEntry>sense organs of fish and amphibians; believed to detect pressure changes in the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101961342">
	<b:glossaryEntry>organ of locomotion and balance in fishes and some other aquatic animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101961574">
	<b:glossaryEntry>unpaired median fin on the backs of fishes and some other aquatic vertebrates that help to maintain balance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101961738">
	<b:glossaryEntry>either of a pair of fins situated just behind the head in fishes that help control the direction of movement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101961905">
	<b:glossaryEntry>either of a pair of fins attached to the pelvic girdle in fishes that help control the direction of movement; correspond to hind limbs of a land vertebrate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101962131"
	 b:glossaryEntry="the tail of fishes and some other aquatic vertebrates"/>
<rdf:Description rdf:about="&a;101962307">
	<b:glossaryEntry>tail fin with unequal lobes in which the vertebral column turns upward into the larger lobe as in sharks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101962492">
	<b:glossaryEntry>symmetrical tail fin extending beyond the end of the vertebral column as in most bony fishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101962663"
	 b:glossaryEntry="a bone of a fish"/>
<rdf:Description rdf:about="&a;101962753">
	<b:glossaryEntry>an air-filled sac near the spinal column in many fishes that helps maintain buoyancy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101962910">
	<b:glossaryEntry>any of the membranous air-filled extensions of the lungs of birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101963048"
	 b:glossaryEntry="any of the thin-walled extensions of the tracheae of insects"/>
<rdf:Description rdf:about="&a;101963181">
	<b:glossaryEntry>oil-secreting gland situated at the base of the tail in most birds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101963342">
	<b:glossaryEntry>silk-producing gland of insects (especially of a silkworm) or spiders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101963532">
	<b:glossaryEntry>the joint of a mammal or bird that corresponds to the human elbow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101963668"
	 b:glossaryEntry="a small horny callus on the inner surface of a horse''s leg"/>
<rdf:Description rdf:about="&a;101963781"
	 b:glossaryEntry="the hollow shaft of a feather"/>
<rdf:Description rdf:about="&a;101963899">
	<b:glossaryEntry>one of the horny ribs that stiffen and support the wing of an insect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101964028"
	 b:glossaryEntry="any of the larger wing or tail feathers of a bird"/>
<rdf:Description rdf:about="&a;101964208">
	<b:glossaryEntry>one of the main flight feathers projecting along the outer edge of a bird''s wing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101964376"
	 b:glossaryEntry="a feather covering the shoulder of a bird"/>
<rdf:Description rdf:about="&a;101964472"
	 b:glossaryEntry="a larval frog or toad"/>
<rdf:Description rdf:about="&a;101964588">
	<b:glossaryEntry>an animal order including lemurs and tarsiers and monkeys and apes and human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101964914">
	<b:glossaryEntry>any placental mammal of the order Primates; has good eyesight and flexible hands and feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101965238"
	 b:glossaryEntry="an ape or monkey"/>
<rdf:Description rdf:about="&a;101965307"
	 b:glossaryEntry="any of various primates with short tails or no tail at all"/>
<rdf:Description rdf:about="&a;101965433"
	 b:glossaryEntry="monkeys; apes; hominids"/>
<rdf:Description rdf:about="&a;101965691">
	<b:glossaryEntry>any member of the suborder Anthropoidea including monkeys and apes and hominids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101965827"
	 b:glossaryEntry="any tailless ape of the families Pongidae and Hylobatidae"/>
<rdf:Description rdf:about="&a;101966000"
	 b:glossaryEntry="anthropoid apes and human beings"/>
<rdf:Description rdf:about="&a;101966228"
	 b:glossaryEntry="a primate of the superfamily Hominoidea"/>
<rdf:Description rdf:about="&a;101966395"
	 b:glossaryEntry="modern man and extinct immediate ancestors of man"/>
<rdf:Description rdf:about="&a;101966690"
	 b:glossaryEntry="a primate of the family Hominidae"/>
<rdf:Description rdf:about="&a;101966922"
	 b:glossaryEntry="type genus of the family_Hominidae"/>
<rdf:Description rdf:about="&a;101967203"
	 b:glossaryEntry="any living or extinct member of the family Hominidae"/>
<rdf:Description rdf:about="&a;101967613">
	<b:glossaryEntry>extinct species of primitive hominid with upright stature but small brain; formerly Pithecanthropus erectus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101967834"
	 b:glossaryEntry="former genus of primitive apelike men now Homo erectus"/>
<rdf:Description rdf:about="&a;101967974">
	<b:glossaryEntry>fossil remains found in Java; formerly called Pithecanthropus erectus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101968111">
	<b:glossaryEntry>fossils found near Peking China; lost during World War II; formerly Sinanthropus pekinensis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101968259"
	 b:glossaryEntry="genus to which Peking man was formerly assigned"/>
<rdf:Description rdf:about="&a;101968386">
	<b:glossaryEntry>extinct primitive hominid of late Pleistocene; Java; formerly Javanthropus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101968558">
	<b:glossaryEntry>former genus of primitive man; now Homo soloensis: comprises Solo man</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101968707">
	<b:glossaryEntry>early man of late Pleistocene; skull resembles that of Neanderthal man but with smaller cranial capacity; found in Java</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101968881">
	<b:glossaryEntry>extinct species of upright east African hominid having some advanced humanlike characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101969053">
	<b:glossaryEntry>the only surviving hominid; species to which modern man belongs; bipedal primate having language and ability to make and use complex tools; brain 1400 cc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101969338">
	<b:glossaryEntry>extinct robust human of Middle Paleolithic in Europe and western Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101969534"
	 b:glossaryEntry="extinct human of Upper Paleolithic in Europe"/>
<rdf:Description rdf:about="&a;101969654">
	<b:glossaryEntry>possible early Homo sapiens represented by a cranium found in the Transvaal; formerly considered a separate species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101969845"
	 b:glossaryEntry="subspecies of Homo sapiens; includes all modern races"/>
<rdf:Description rdf:about="&a;101969997"
	 b:glossaryEntry="extinct genus of African hominid"/>
<rdf:Description rdf:about="&a;101970250"
	 b:glossaryEntry="former name for the genus Australopithecus"/>
<rdf:Description rdf:about="&a;101970395">
	<b:glossaryEntry>any of several extinct humanlike small-brained bipedal primates of the genus Australopithecus; from 1 to 4 million years ago</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101970710"
	 b:glossaryEntry="fossils found in Ethiopia; from 3.5 to 4 million years ago"/>
<rdf:Description rdf:about="&a;101970878">
	<b:glossaryEntry>incomplete skeleton of female found in eastern Ethiopia in 1974</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101971011">
	<b:glossaryEntry>gracile hominid of southern Africa; from about 3 million years ago; formerly Plesianthropus_transvaalensis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101971209">
	<b:glossaryEntry>large-toothed hominid of eastern Africa; from 1 to 2 million years ago; formerly Zinjanthropus boisei</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101971399"
	 b:glossaryEntry="genus to which Australopithecus boisei was formerly assigned"/>
<rdf:Description rdf:about="&a;101971541">
	<b:glossaryEntry>large-toothed hominid of southern Africa; from 1.5 to 2 million years ago; formerly Paranthropus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101971728"
	 b:glossaryEntry="former classification for Australopithecus robustus"/>
<rdf:Description rdf:about="&a;101971859"
	 b:glossaryEntry="extinct primates; lower Pliocene"/>
<rdf:Description rdf:about="&a;101971994"
	 b:glossaryEntry="fossil primates found in India"/>
<rdf:Description rdf:about="&a;101972102"
	 b:glossaryEntry="genus of Old World hominoids; Miocene and Pliocene"/>
<rdf:Description rdf:about="&a;101972289">
	<b:glossaryEntry>considered a possible ancestor to both anthropoid apes and humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101972451"
	 b:glossaryEntry="fossil hominoids from north central Hungary; late Miocene"/>
<rdf:Description rdf:about="&a;101972625"
	 b:glossaryEntry="a genus of Hominidae"/>
<rdf:Description rdf:about="&a;101972748"
	 b:glossaryEntry="a genus of Hominidae"/>
<rdf:Description rdf:about="&a;101972871">
	<b:glossaryEntry>genus of extinct primitive African Miocene primates; sometimes considered a subgenus of Dryopithecus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101973071"
	 b:glossaryEntry="an anthropoid ape of the genus Proconsul"/>
<rdf:Description rdf:about="&a;101973186">
	<b:glossaryEntry>extinct primate having powerful chewing muscles along with large molars and small incisors; fossils found in Kenya</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101973401"
	 b:glossaryEntry="a genus of Hominoidea"/>
<rdf:Description rdf:about="&a;101973528">
	<b:glossaryEntry>extinct primate of about 38 million years ago; fossils found in Egypt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101973678"
	 b:glossaryEntry="an extinct genus of Hominoidea"/>
<rdf:Description rdf:about="&a;101973830">
	<b:glossaryEntry>tiny (150 to 300 grams) extinct primate of 46 to 50 million years ago; fossils found in Algeria; considered by some authorities the leading candidate for the first anthropoid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101974092">
	<b:glossaryEntry>usually considered as comprising orangutans; gorillas; chimpanzees; and sometimes gibbons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101974349"
	 b:glossaryEntry="any of the large anthropoid apes of the family Pongidae"/>
<rdf:Description rdf:about="&a;101974542"
	 b:glossaryEntry="type genus of the family Pongidae: orangutans"/>
<rdf:Description rdf:about="&a;101974691">
	<b:glossaryEntry>large long-armed ape of Borneo and Sumatra having arboreal habits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101974869"
	 b:glossaryEntry="gorillas"/>
<rdf:Description rdf:about="&a;101975051">
	<b:glossaryEntry>largest anthropoid ape; terrestrial and vegetarian; of forests of central west Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101975299"
	 b:glossaryEntry="a kind of gorilla"/>
<rdf:Description rdf:about="&a;101975431"
	 b:glossaryEntry="a kind of gorilla"/>
<rdf:Description rdf:about="&a;101975562"
	 b:glossaryEntry="of Kivu highlands"/>
<rdf:Description rdf:about="&a;101975688"
	 b:glossaryEntry="an adult male gorilla with gray hairs across the back"/>
<rdf:Description rdf:about="&a;101975817">
	<b:glossaryEntry>chimpanzees; more closely related to Australopithecus than to other pongids</b:glossaryEntry>
</rdf:Description>
