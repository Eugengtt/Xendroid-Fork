	 b:glossaryEntry='cut in half or cut in two; "bisect a line"'/>
<rdf:Description rdf:about="&a;201068118"
	 b:glossaryEntry='cut in three; "trisect a line"'/>
<rdf:Description rdf:about="&a;201068221">
	<b:glossaryEntry>mark with a scar; "The skin disease scarred his face permanently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201068448"
	 b:glossaryEntry='mark wit pockmarks; "Her face was pockmarked by the disease"'/>
<rdf:Description rdf:about="&a;201068582">
	<b:glossaryEntry>scar (the body) in certain cultures; "Some African tribes scarify their faces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201068733">
	<b:glossaryEntry>form a scar, after an injury; "the skin will cicatrice and it will heal soon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201068877">
