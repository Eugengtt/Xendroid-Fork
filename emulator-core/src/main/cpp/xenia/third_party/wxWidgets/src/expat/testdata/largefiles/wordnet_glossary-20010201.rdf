</rdf:Description>
<rdf:Description rdf:about="&a;101229964">
	<b:glossaryEntry>large quadrupedal herbivorous dinosaurs with very long neck and tail; late Jurassic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101230170">
