	<b:glossaryEntry>feel or handle with the fingers; "finger the binding of the book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200823640">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pass one''s hands over the sexual organs of (slang); "He felt the girl in the movie theater"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200823811">
