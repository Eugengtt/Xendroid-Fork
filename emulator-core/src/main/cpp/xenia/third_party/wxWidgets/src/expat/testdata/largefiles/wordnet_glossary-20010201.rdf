	 b:glossaryEntry="make brutal and depraved; give animal-like qualities to"/>
<rdf:Description rdf:about="&a;200284959">
	<b:glossaryEntry>make American in character; "The year in the US has completely Americanized him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200285116">
	<b:glossaryEntry>become French in appearance or character; "This restaurant has Frenchified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200285266"
	 b:glossaryEntry='make English in appearance; "anglicize a French word"'/>
<rdf:Description rdf:about="&a;200285398">
