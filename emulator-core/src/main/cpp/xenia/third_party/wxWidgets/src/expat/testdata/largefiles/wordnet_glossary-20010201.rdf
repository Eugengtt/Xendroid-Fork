</rdf:Description>
<rdf:Description rdf:about="&a;201059717"
	 b:glossaryEntry="absorb as if with a sponge, of liquids"/>
<rdf:Description rdf:about="&a;201059830"
	 b:glossaryEntry="become imbued; of liquids, light, or gases, in chemistry"/>
<rdf:Description rdf:about="&a;201059968"
	 b:glossaryEntry="take into solution, as of gas, light, or heat"/>
<rdf:Description rdf:about="&a;201060090"
	 b:glossaryEntry="accumulate of the surface; of liquids or gases, in chemistry"/>
<rdf:Description rdf:about="&a;201060214">
	<b:glossaryEntry>take up a liquid or a gas either by adsorption or by absorption; in chemistry</b:glossaryEntry>
