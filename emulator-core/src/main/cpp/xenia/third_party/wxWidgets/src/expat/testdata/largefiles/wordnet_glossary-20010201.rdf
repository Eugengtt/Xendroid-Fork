	 b:glossaryEntry="a genus of Pteroclididae"/>
<rdf:Description rdf:about="&a;101333817"
	 b:glossaryEntry="Eurasiatic sandgrouse with a black patch on the belly"/>
<rdf:Description rdf:about="&a;101333978">
	<b:glossaryEntry>an order of birds including parrots and amazons and cockatoos and lorikeets and lories and macaws and parakeets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101334230">
