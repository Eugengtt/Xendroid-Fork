	<b:glossaryEntry>water fern of Europe and Asia and the eastern United States distinguished by four clover-like leaflets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109254563"
	 b:glossaryEntry="pillworts"/>
