	 b:glossaryEntry="make more keen, as of the senses"/>
<rdf:Description rdf:about="&a;200272698"
	 b:glossaryEntry='sharpen with a strap; "strap a razor"'/>
<rdf:Description rdf:about="&a;200272798"
	 b:glossaryEntry='give a point to; "The candles are tapered"'/>
<rdf:Description rdf:about="&a;200272975"
	 b:glossaryEntry="make sharp or acute; taper; make (something) come to a point"/>
