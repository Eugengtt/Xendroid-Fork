</rdf:Description>
<rdf:Description rdf:about="&a;101868204"
	 b:glossaryEntry="small bushy-tailed South American burrowing rodents"/>
<rdf:Description rdf:about="&a;101868433"
	 b:glossaryEntry="type genus of the Chinchillidae"/>
