<rdf:Description rdf:about="&a;400281525">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a cajoling manner; "`Come here,'' she said coaxingly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400281631">
	<b:glossaryEntry>in a coherent manner; "she could not talk coherently after the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400281778">
	<b:glossaryEntry>in an incoherent manner; "he talked incoherently when he drank too much"</b:glossaryEntry>
