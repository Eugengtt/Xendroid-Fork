	 b:glossaryEntry="a plant of the family Caryophyllaceae"/>
<rdf:Description rdf:about="&a;108116057"
	 b:glossaryEntry="a caryophylloid dicot genus including corn cockles"/>
<rdf:Description rdf:about="&a;108116221">
	<b:glossaryEntry>European annual having large trumpet-shaped reddish-purple flowers and poisonous seed; a common weed in grainfields and beside roadways; naturalized in America</b:glossaryEntry>
