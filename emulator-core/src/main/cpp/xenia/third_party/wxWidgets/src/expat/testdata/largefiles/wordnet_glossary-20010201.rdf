	 b:glossaryEntry="annual to perennial herbs of the Mediterranean region"/>
<rdf:Description rdf:about="&a;108194365">
	<b:glossaryEntry>erect European annual often grown as a salad crop to be harvested when young and tender</b:glossaryEntry>
</rdf:Description>
