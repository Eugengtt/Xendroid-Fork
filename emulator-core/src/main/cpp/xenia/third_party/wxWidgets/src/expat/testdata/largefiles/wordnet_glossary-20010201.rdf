	 b:glossaryEntry="a numbered list"/>
<rdf:Description rdf:about="&a;104872458"
	 b:glossaryEntry="a list of commodities that are not subject to tariffs"/>
<rdf:Description rdf:about="&a;104872567">
	<b:glossaryEntry>an alphabetical listing of names and topics along with page numbers where they are discussed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104872767">
	<b:glossaryEntry>an index of all main words in a book along with their immediate contexts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104872897">
	<b:glossaryEntry>a list of words or phrases that explain symbols or abbreviations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104873029">
	<b:glossaryEntry>a word that is used as a pattern to decode an encrypted message</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104873147"
	 b:glossaryEntry="a significant word used in indexing or cataloging"/>
<rdf:Description rdf:about="&a;104873270"
	 b:glossaryEntry="a detailed list of all the items in stock"/>
<rdf:Description rdf:about="&a;104873399">
	<b:glossaryEntry>a list of names and addresses to which advertising material is mailed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104873527">
	<b:glossaryEntry>a list of dishes available at a restaurant; "the menu was in French"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104873746">
	<b:glossaryEntry>(computer science) a list of options available to a computer user</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104873896">
