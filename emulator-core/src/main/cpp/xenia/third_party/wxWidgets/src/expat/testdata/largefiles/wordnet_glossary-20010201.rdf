	 b:glossaryEntry="common European butcherbird"/>
<rdf:Description rdf:about="&a;101121626"
	 b:glossaryEntry="butcherbird of northern North American"/>
<rdf:Description rdf:about="&a;101121744"
	 b:glossaryEntry="of western North America; gray with white underparts"/>
<rdf:Description rdf:about="&a;101121898">
	<b:glossaryEntry>common shrike of southeastern United States having black eye-bands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101122069">
	<b:glossaryEntry>of central North America; winters in Texas and the south Mississippi valley</b:glossaryEntry>
