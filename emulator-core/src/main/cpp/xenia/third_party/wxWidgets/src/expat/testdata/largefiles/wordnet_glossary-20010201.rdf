</rdf:Description>
<rdf:Description rdf:about="&a;108916304">
	<b:glossaryEntry>European herb naturalized in the eastern United States and California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108916498">
	<b:glossaryEntry>of Europe (except the Mediterranean area) and the northern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108916686">
	<b:glossaryEntry>pondweed with floating leaves; of northern United States and Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108916881"
	 b:glossaryEntry="a monocotyledonous genus of the family Potamogetonaceae"/>
<rdf:Description rdf:about="&a;108917052">
	<b:glossaryEntry>very similar to Potamogeton; of western Africa, Asia, and Europe</b:glossaryEntry>
</rdf:Description>
