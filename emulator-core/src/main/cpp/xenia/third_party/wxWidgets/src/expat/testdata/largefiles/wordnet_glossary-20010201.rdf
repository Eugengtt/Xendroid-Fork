	 b:glossaryEntry="gavials"/>
<rdf:Description rdf:about="&a;101220236"
	 b:glossaryEntry="type genus of the Gavialidae"/>
<rdf:Description rdf:about="&a;101220374">
	<b:glossaryEntry>large fish-eating Indian crocodilian with a long slender snout</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101220530">
	<b:glossaryEntry>any of numerous extinct terrestrial reptiles of the Mesozoic era</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101220775">
	<b:glossaryEntry>extinct terrestrial reptiles having birdlike pelvises: armored dinosaurs (thyreophorans); bone-headed and horned dinosaurs (marginocephalians); duck-billed dinosaurs (euronithopods)</b:glossaryEntry>
