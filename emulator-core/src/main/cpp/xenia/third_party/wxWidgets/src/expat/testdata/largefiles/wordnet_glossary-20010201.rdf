<rdf:Description rdf:about="&a;110586209"
	 b:glossaryEntry="the fur of an otter"/>
<rdf:Description rdf:about="&a;110586280"
	 b:glossaryEntry="the fur of the North American racoon"/>
<rdf:Description rdf:about="&a;110586370"
	 b:glossaryEntry="the expensive dark brown fur of the marten"/>
