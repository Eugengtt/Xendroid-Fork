<rdf:Description rdf:about="&a;201106091">
	<b:glossaryEntry>make useless by the force of water; "The hail storms had washed out the bridges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201106237">
	<b:glossaryEntry>become engaged or intermeshed with one another; "They were locked in embrace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201106388"
	 b:glossaryEntry="enclose by a fortification"/>
<rdf:Description rdf:about="&a;201106486">
	<b:glossaryEntry>cause to lean or incline; "He leaned his rifle against the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201106612">
	<b:glossaryEntry>hold in a locking position: "He locked his hands around her neck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201106771">
	<b:glossaryEntry>hold or catch as if in a trap; "The gaps between the teeth trap food particles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201106912">
	<b:glossaryEntry>bring together in a common cause or emotion; "The death of their child had drawn them together"</b:glossaryEntry>
