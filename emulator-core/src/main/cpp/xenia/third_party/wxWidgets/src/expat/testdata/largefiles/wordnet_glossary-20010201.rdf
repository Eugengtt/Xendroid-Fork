	 b:glossaryEntry="palm having palmate or fan-shaped leaves"/>
<rdf:Description rdf:about="&a;108883649"
	 b:glossaryEntry="any of several low-growing palms with fan-shaped leaves"/>
<rdf:Description rdf:about="&a;108883777"
	 b:glossaryEntry="Central and South American feather palms"/>
<rdf:Description rdf:about="&a;108883929">
	<b:glossaryEntry>tropical American palm having edible nuts and yielding a useful fiber</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108884103">
	<b:glossaryEntry>tropical American feather palm having a swollen spiny trunk and edible nuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108884305"
	 b:glossaryEntry="a monocotyledonous genus of palm trees"/>
<rdf:Description rdf:about="&a;108884439">
	<b:glossaryEntry>any of several tall tropical palms native to southeastern Asia having egg-shaped nuts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108884613">
	<b:glossaryEntry>southeastern Asian palm bearing betel nuts (scarlet or orange single-seeded fruit with a fibrous husk)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108884807"
	 b:glossaryEntry="a genus of tropical Asian and Malaysian palm trees"/>
<rdf:Description rdf:about="&a;108884963">
