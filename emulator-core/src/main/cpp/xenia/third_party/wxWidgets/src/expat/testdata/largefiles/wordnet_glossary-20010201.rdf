</rdf:Description>
<rdf:Description rdf:about="&a;101873027"
	 b:glossaryEntry="an extinct ungulate"/>
<rdf:Description rdf:about="&a;101873121"
	 b:glossaryEntry="a variety of dinocerate"/>
