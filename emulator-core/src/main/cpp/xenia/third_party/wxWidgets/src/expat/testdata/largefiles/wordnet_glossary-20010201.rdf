	 b:glossaryEntry="large alligator of southeastern United States"/>
<rdf:Description rdf:about="&a;101219519"
	 b:glossaryEntry="small of the Yangtze valley of China having unwebbed digits"/>
<rdf:Description rdf:about="&a;101219663"
	 b:glossaryEntry="caimans"/>
<rdf:Description rdf:about="&a;101219767">
