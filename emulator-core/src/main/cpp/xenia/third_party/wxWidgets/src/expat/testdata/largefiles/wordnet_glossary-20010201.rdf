</rdf:Description>
<rdf:Description rdf:about="&a;106829547">
	<b:glossaryEntry>a major French river; flows into the Mediterranean near Marseilles; "the Rhone valley is famous for its vineyards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106829765"
	 b:glossaryEntry="an estuary between Argentina and Uruguay"/>
<rdf:Description rdf:about="&a;106829930">
	<b:glossaryEntry>a North American river; boundary between the United States and Mexico; flows into Gulf of Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106830121"
	 b:glossaryEntry="a tributary of the Rhine"/>
<rdf:Description rdf:about="&a;106830228"
	 b:glossaryEntry="a North American river; flows into the Gulf of Mexico"/>
<rdf:Description rdf:about="&a;106830368"
	 b:glossaryEntry="a tributary of the Snake River"/>
<rdf:Description rdf:about="&a;106830485">
	<b:glossaryEntry>a river in eastern France; rises in Lorraine and flows south to become the chief tributary of the Rhone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106830673">
	<b:glossaryEntry>a river in South Carolina that flows southeast to the Atlantic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106830826">
	<b:glossaryEntry>a French river that flows through the heart of Paris and then northward into the English Channel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106831007"
	 b:glossaryEntry="a tributary of the Columbia River"/>
<rdf:Description rdf:about="&a;106831144"
	 b:glossaryEntry="a tributary of the Mississippi River"/>
<rdf:Description rdf:about="&a;106831277"
	 b:glossaryEntry="a North American river; flows into the Bay of Fundy"/>
<rdf:Description rdf:about="&a;106831440">
	<b:glossaryEntry>a North American river; flows into the Gulf of Saint Lawrence and the North Atlantic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106831642"
	 b:glossaryEntry="a tributary of the Platte River"/>
<rdf:Description rdf:about="&a;106831772"
	 b:glossaryEntry="a river in Suriname that flows northward to the Atlantic"/>
<rdf:Description rdf:about="&a;106831924"
	 b:glossaryEntry="flows into Chesapeake Bay"/>
<rdf:Description rdf:about="&a;106832046"
	 b:glossaryEntry="a European river; flows into the North Atlantic"/>
<rdf:Description rdf:about="&a;106832197">
	<b:glossaryEntry>a river formed by the confluence of two other rivers near Knoxville; it follows a U-shaped course to become a tributary of the Ohio River in western Kentucky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106832466">
	<b:glossaryEntry>the longest river in England; flows eastward through London to the North Sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106832610">
	<b:glossaryEntry>a river of central Italy; flows through Rome to the Tyrrhenian Sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106832737"
	 b:glossaryEntry="an Asian river; a tributary of the Euphrates River"/>
<rdf:Description rdf:about="&a;106832912"
	 b:glossaryEntry="a tributary of the Mobile River"/>
<rdf:Description rdf:about="&a;106833036"
	 b:glossaryEntry="a river in northern England that flows east to the North Sea"/>
<rdf:Description rdf:about="&a;106833179"
	 b:glossaryEntry="a European river; flows into the Baltic Sea"/>
<rdf:Description rdf:about="&a;106833311">
	<b:glossaryEntry>a Russian river; the longest river in Europe; flows into the Caspian Sea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106833468"
	 b:glossaryEntry="a tributary of the Ohio River"/>
<rdf:Description rdf:about="&a;106833584"
	 b:glossaryEntry="a tributary of the Mississippi River"/>
<rdf:Description rdf:about="&a;106833705"
	 b:glossaryEntry="a tributary of the Mississippi River"/>
<rdf:Description rdf:about="&a;106833834">
	<b:glossaryEntry>river in eastern Asia; rises in North Korea and flows southwest to Korea Bay (forming part of the border between North Korea and China)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106834052">
	<b:glossaryEntry>the longest river of Asia; flows eastward from Tibet into the East China Sea near Shanghai</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106834263"
	 b:glossaryEntry="a tributary of the Missouri River"/>
<rdf:Description rdf:about="&a;106834393"
	 b:glossaryEntry="a Russian river; flows northward into the Arctic Ocean"/>
<rdf:Description rdf:about="&a;106834562"
	 b:glossaryEntry="a North American river; flows into the Bering Sea"/>
<rdf:Description rdf:about="&a;106834715"
	 b:glossaryEntry="an African river; flows into the Indian Ocean"/>
<rdf:Description rdf:about="&a;106834925">
	<b:glossaryEntry>(Greek mythology) a river in Hades across which the souls of the dead were carried by Charon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106835106">
	<b:glossaryEntry>(Greek mythology) a river in Hades that was said to be a tributary of the Acheron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106835276">
	<b:glossaryEntry>(Greek mythology) a river in Hades; the souls of the dead had to drink from it, which made them forget all they had done and suffered when they were alive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106835515">
	<b:glossaryEntry>(Greek mythology) a river in Hades across which Charon carried dead souls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106835671"
	 b:glossaryEntry="North and South America"/>
<rdf:Description rdf:about="&a;106835820"
	 b:glossaryEntry="a large continuous extent of land"/>
<rdf:Description rdf:about="&a;106835944">
	<b:glossaryEntry>one of the large landmasses of the earth; "there are seven continents"; "pioneers had to cross the continent on foot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106836334">
	<b:glossaryEntry>a large and distinctive landmass (as India or Greenland) that is a distinct part of some continent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106836510">
	<b:glossaryEntry>a continent (the third largest) in the western hemisphere connected to South America by the Isthmus of Panama</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106836944">
	<b:glossaryEntry>a vast prairie region extending from Alberta and Saskatchewan and Manitoba in Canada south through the west central United States into Texas; formerly inhabited by Native Americans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106837221">
	<b:glossaryEntry>a continent in the western hemisphere connected to North America by the Isthmus of Panama</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106837693">
	<b:glossaryEntry>the largest continent with 60% of the earth''s population; it is joined to Europe on the west to form Eurasia; it is the site of some of the world''s earliest civilizations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106838825">
	<b:glossaryEntry>the 2nd smallest continent (actually a vast peninsula of Eurasia); the British use `Europe'' to refer to all of the continent except the British Isles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106840014"
	 b:glossaryEntry="the land mass formed by the continents of Europe and Asia"/>
<rdf:Description rdf:about="&a;106840277">
	<b:glossaryEntry>the smallest continent; between the South Pacific and the Indian Ocean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106840536">
	<b:glossaryEntry>the second largest continent; located south of Europe and bordered to the west by the South Atlantic and to the east by the India Ocean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106841750">
	<b:glossaryEntry>an extremely cold continent at the south pole almost entirely below the Antarctic Circle; covered by an ice cap up to 13,000 feet deep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106841982">
	<b:glossaryEntry>(plate tectonic theory) a hypothetical continent including all the landmass of the earth prior to the Triassic period when it split into Laurasia and Gondwanaland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106842207">
	<b:glossaryEntry>a hypothetical continent that (according to plate tectonic theory) broke up later into North America and Europe and Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106842401">
	<b:glossaryEntry>a hypothetical continent that (according to plate tectonic theory) broke up later into India and Australia and Africa and South America and Antarctica</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106842629">
	<b:glossaryEntry>a part of Niagara Falls in western New York (north of Buffalo)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106842790">
	<b:glossaryEntry>the highest waterfall; has more than one leap; flow varies seasonally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106842944"
	 b:glossaryEntry="a famous waterfall in Venezuela"/>
<rdf:Description rdf:about="&a;106843094"
	 b:glossaryEntry="a part of Niagara Falls in Ontario"/>
<rdf:Description rdf:about="&a;106843245"
	 b:glossaryEntry="a large waterfall on the Argentine-Brazil border"/>
<rdf:Description rdf:about="&a;106843442">
	<b:glossaryEntry>waterfall in Canada is the Horseshoe Falls; in the United States it is the American Falls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106843696"
	 b:glossaryEntry="a major waterfall in northeastern Brazil"/>
<rdf:Description rdf:about="&a;106843835"
	 b:glossaryEntry="a great waterfall on the Brazil-Paraguay border"/>
<rdf:Description rdf:about="&a;106844021"
	 b:glossaryEntry="a major waterfall in southern Africa; has more than one leap"/>
<rdf:Description rdf:about="&a;106844168"
	 b:glossaryEntry="a waterfall in the Snake River in southern Idaho"/>
<rdf:Description rdf:about="&a;106844318"
	 b:glossaryEntry="a waterfall in the Parana river in Brazil"/>
<rdf:Description rdf:about="&a;106844473">
	<b:glossaryEntry>a waterfall in the Zambezi River on the Zimbabwe-Zambia border; diminishes seasonally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106844687">
	<b:glossaryEntry>a series of waterfalls in Yosemite National Park in California; is reduced to a trickle for part of each year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106844887">
	<b:glossaryEntry>a twisted and tangled mass that is highly interwoven; "they carved their way through the tangle of vines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106845081">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a matted tangle of hair or fiber; "the dog''s woolly shag"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106845189">
	<b:glossaryEntry>a compact mass of hair that forms in the stomach of animals as a result of licking fur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106845342"
	 b:glossaryEntry="fecal droppings from a dog"/>
<rdf:Description rdf:about="&a;106845454"
	 b:glossaryEntry="a piece of dried dung"/>
<rdf:Description rdf:about="&a;106845552">
	<b:glossaryEntry>a structure in which animals lay eggs or give birth to their young</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106845741"
	 b:glossaryEntry="a natural habitation for bees; as in a hollow tree"/>
<rdf:Description rdf:about="&a;106845852"
	 b:glossaryEntry="nest where birds lay their eggs and hatch their young"/>
<rdf:Description rdf:about="&a;106845981"
	 b:glossaryEntry="the lofty nest of a bird of prey (such as a hawk or eagle)"/>
<rdf:Description rdf:about="&a;106846113"
	 b:glossaryEntry="where mice bear and raise their young"/>
<rdf:Description rdf:about="&a;106846222"
	 b:glossaryEntry="habitation for wasps or hornets"/>
<rdf:Description rdf:about="&a;106846327">
	<b:glossaryEntry>anything indispensable; "food and shelter are necessities of life"; "the essentials of the good life"; "allow farmers to buy their requirements under favorable conditions"; "a place where the requisites of water fuel and fodder can be obtained"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106846731">
	<b:glossaryEntry>anything that is necessary but lacking; "he had sufficient means to meet his simple needs"; "I tried to supply his wants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106846910">
	<b:glossaryEntry>something desired as a necessity; "the desiderata for a vacation are time and money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106847052">
	<b:glossaryEntry>anything that is not essential; "they discarded all their inessentials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106847232">
	<b:glossaryEntry>something added to another thing but not an essential part of it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106847350">
	<b:glossaryEntry>something that is likely to vary; something that is subject to variation; "the weather is one variable to be considered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106847525">
	<b:glossaryEntry>some early entity whose type or style anticipates a later one; "there were many anticipations of Darwinian theory"; "the hour glass was an anticipation of the clock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106847749"
	 b:glossaryEntry="masses of ice floating in the open sea"/>
<rdf:Description rdf:about="&a;106847843"
	 b:glossaryEntry="a large expanse of floating ice"/>
<rdf:Description rdf:about="&a;106847940"
	 b:glossaryEntry="ice that is attached to land but projects out to sea"/>
<rdf:Description rdf:about="&a;106848060">
	<b:glossaryEntry>an intricate network suggesting something that was formed by weaving or interweaving; "the trees cast a delicate web of shadows over the lawn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106848252"
	 b:glossaryEntry="a curve in a stream"/>
<rdf:Description rdf:about="&a;106848362"
	 b:glossaryEntry="a U-shaped curve in a stream"/>
<rdf:Description rdf:about="&a;106848442"
	 b:glossaryEntry="the land inside an oxbow bend in a river"/>
<rdf:Description rdf:about="&a;106848534">
	<b:glossaryEntry>a crescent-shaped lake (often temporary) that is formed when a meander of a river is cut off from the main channel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106848705"
	 b:glossaryEntry="a creature of the imagination"/>
<rdf:Description rdf:about="&a;106849105">
	<b:glossaryEntry>a creature that has not been observed but is hypothesized to exist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106849257">
	<b:glossaryEntry>a form of life assumed to exist outside the Earth or its atmosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106849420"
	 b:glossaryEntry="an imaginary being of myth or fable"/>
<rdf:Description rdf:about="&a;106850470"
	 b:glossaryEntry="unverifiable but popularly accepted as possibly factual"/>
<rdf:Description rdf:about="&a;106850662"
	 b:glossaryEntry="large hairy humanoid creature said to live in the Himalayas"/>
<rdf:Description rdf:about="&a;106850793">
	<b:glossaryEntry>large hairy humanoid creature said to live in wilderness areas of US and Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106850938">
	<b:glossaryEntry>large aquatic animal supposed to resemble a serpent or plesiosaur of Loch Ness in Scotland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106851101"
	 b:glossaryEntry="huge creature of the sea resembling a snake or dragon"/>
<rdf:Description rdf:about="&a;106851212"
	 b:glossaryEntry="an imaginary monster used to frighten children"/>
<rdf:Description rdf:about="&a;106851354">
	<b:glossaryEntry>the personification of death; "Death walked the streets of the plague-bound city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106851505"
	 b:glossaryEntry="Death personified as an old man or a skeleton with a scythe"/>
<rdf:Description rdf:about="&a;106851622"
	 b:glossaryEntry="half woman and half fish, lives in the sea"/>
<rdf:Description rdf:about="&a;106851718"
	 b:glossaryEntry="half man and half fish, lives in the sea"/>
<rdf:Description rdf:about="&a;106851811"
	 b:glossaryEntry="imaginary people who live on the planet Mars"/>
<rdf:Description rdf:about="&a;106851909">
	<b:glossaryEntry>an imaginary figure of superhuman size and strength; appears in folklore and fair tales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106852156">
	<b:glossaryEntry>(Greek mythology) a giant with 100 eyes; was guardian of the heifer Io and was slain by Hermes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106852302">
	<b:glossaryEntry>(Greek mythology) one of a race of giants having a single eye in the middle of their forehead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106852460"
	 b:glossaryEntry="a female giant"/>
<rdf:Description rdf:about="&a;106852529"
	 b:glossaryEntry="(folklore) a giant who likes to eat human beings"/>
<rdf:Description rdf:about="&a;106852646"
	 b:glossaryEntry="a female ogre"/>
<rdf:Description rdf:about="&a;106852712"
	 b:glossaryEntry="a personification of winter"/>
<rdf:Description rdf:about="&a;106852796">
	<b:glossaryEntry>(New Testament) a personification of wealth and avarice as an evil spirit; "ye cannot serve God and Mammon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106852956">
	<b:glossaryEntry>(Greek mythology) a sea nymph transformed into a sea monster who lived on one side of a narrow strait; drowned and devoured sailors who tried to escape Charybdis (a whirlpool) on the other side of the strait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106853216">
	<b:glossaryEntry>an imaginary creature usually having various human and animal parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106853373"
	 b:glossaryEntry="a monster renowned in folklore and myth"/>
<rdf:Description rdf:about="&a;106853963">
	<b:glossaryEntry>(classical mythology) a serpent with a head at each end of its body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854088">
	<b:glossaryEntry>(classical mythology) a serpent (or lizard or dragon) able to kill with its breath or glance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854235">
	<b:glossaryEntry>(classical mythology) a mythical being that is half man and half horse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854359">
	<b:glossaryEntry>(Greek mythology) 3-headed dog guarding the entrance to Hades; son of Typhon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854490">
	<b:glossaryEntry>(Greek mythology) the ferryman who brought the souls of the dead across the the river Styx or the river Acheron to Hades</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854663">
	<b:glossaryEntry>(Greek mythology) fire-breathing she-monster with a lion''s head and a goat''s body and a serpent''s tail; daughter of Typhon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854850">
	<b:glossaryEntry>(Greek mythology) a sorceress who detained Odysseus on her island and turned his men into swine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106854997">
	<b:glossaryEntry>monster hatched by a reptile from a cock''s egg; able to kill with a glance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106855128">
	<b:glossaryEntry>a creature of Teutonic mythology; usually represented as breathing fire and having a reptilian body and sometimes wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106855330">
	<b:glossaryEntry>any of three winged sister monsters having live snakes for hair; a glance turns the beholder to stone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106855538">
	<b:glossaryEntry>(Greek mythology) three sisters who were the givers of beauty and charm; a favorite subject for sculptors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106855696"
	 b:glossaryEntry="winged monster with an eagle-like head and body of a lion"/>
<rdf:Description rdf:about="&a;106855817">
	<b:glossaryEntry>(Greek mythology) vicious winged monster; often depicted as a bird with the head of a woman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106855960">
	<b:glossaryEntry>(Greek mythology) monster with nine heads; when struck off each head was replaced by two new ones; "Hydra was slain by Hercules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106856140"
	 b:glossaryEntry="monstrous sea creature symbolizing evil in the Old Testament"/>
<rdf:Description rdf:about="&a;106856256">
	<b:glossaryEntry>(Greek mythology) son of Zeus and Dana who slew the Gorgon Medusa (with the help of Athena and Hermes) and rescued Andromeda from a sea monster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106856453">
	<b:glossaryEntry>(Greek mythology) a woman transformed into a Gorgon by Athena; she was slain by Perseus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106856593"
	 b:glossaryEntry="(Greek mythology) one of the three Gorgons"/>
<rdf:Description rdf:about="&a;106856688"
	 b:glossaryEntry="(Greek mythology) one of the three Gorgons"/>
<rdf:Description rdf:about="&a;106856784">
	<b:glossaryEntry>a mythical monster having the head of man (with horns) and the body of a lion and the tail of a scorpion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106856980">
	<b:glossaryEntry>(Greek legend) the greedy king of Phrygia who Dionysus gave the power to turn everything he touched into gold</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106857141">
	<b:glossaryEntry>(Greek legend) a king in ancient Greece who offended Zeus and whose punishment was to roll a huge boulder to the top of a steep hill; each time the boulder neared the top it rolled back down and Sisyphus was forced to start again</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106857425">
	<b:glossaryEntry>(Greek mythology) a mythical monster with the head of a bull and the body of a man; destroyed by Theseus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106857584"
	 b:glossaryEntry="(classical mythology) the god of sleep and dreams"/>
<rdf:Description rdf:about="&a;106857688">
	<b:glossaryEntry>(Greek mythology) a beautiful young man who fell in love with his own reflection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106857824">
	<b:glossaryEntry>(Greek mythology) an enormous lion strangled by Hercules as the first of his 12 labors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106857968">
	<b:glossaryEntry>(Greek mythology) a mythical hero of Corinth who performed miracles on the winged horse Pegasus (especially killing the monster Chimera)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106858162">
	<b:glossaryEntry>(Greek mythology) immortal winged horse that sprang from the blood of the slain Medusa; was tamed by Bellerophon with the help of a bridle given him by Athena; as the flying horse of the Muses it is a symbol of high-flying imagination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106858465">
	<b:glossaryEntry>a legendary Arabian bird said to periodically burn itself to death and emerge from the ashes as a new phoenix; according to most versions only one phoenix lived at a time and it renewed itself every 500 years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106858727"
	 b:glossaryEntry="(Greek mythology) dragon killed by Apollo at Delphi"/>
<rdf:Description rdf:about="&a;106858831"
	 b:glossaryEntry="mythical bird of prey having enormous size and strength"/>
<rdf:Description rdf:about="&a;106858936"
	 b:glossaryEntry="reptilian creature supposed to live in fire"/>
<rdf:Description rdf:about="&a;106859036">
	<b:glossaryEntry>(Greek mythology) a riddling winged monster with a woman''s head and breast on a lion''s body; daughter of Typhon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106859200">
	<b:glossaryEntry>(Scandinavian folklore) a supernatural creature (either a dwarf or a giant) that is supposed to live in caves or in the mountains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106859381">
	<b:glossaryEntry>(Greek mythology) son of Gaea and Tartarus who created the whirlwinds; had a terrifying voice and 100 dragon heads that spurted fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106859568">
	<b:glossaryEntry>(Greek mythology) one of the whirlwinds; son of Typhoeus and Echidna; father of Cerberus and the Chimera and the Sphinx</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106859740"
	 b:glossaryEntry="a monster able to change appearance from human to wolf"/>
<rdf:Description rdf:about="&a;106859873">
	<b:glossaryEntry>a being (usually female) imagined to have special powers derived from the devil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106860041">
	<b:glossaryEntry>a fire-breathing dragon used in medieval heraldry; had the head of a dragon and the tail of a snake and a body with wings and two legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106860237">
	<b:glossaryEntry>a causal agent creating and controlling things in the universe; "nature has seen to it that men are stronger than women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106860410">
	<b:glossaryEntry xml:space='preserve'><![CDATA[supernatural forces and events and beings collectively; "She doesn''t believe in the supernatural"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106860613">
	<b:glossaryEntry>an incorporeal being with powers to affect the course of human events</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106860910">
	<b:glossaryEntry>a self-caused agent that is the cause of all things; "God is the first cause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106861075">
	<b:glossaryEntry>a spiritual agency that is assumed to assist the medium during a seance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106861200">
	<b:glossaryEntry>the ultimate agency that predetermines the course of events (often personified as a woman); "we are helpless in the face of Destiny"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106861412"
	 b:glossaryEntry="a leader in religious or sacred affairs"/>
<rdf:Description rdf:about="&a;106861622">
	<b:glossaryEntry>any supernatural being worshipped as controlling some part of the world or some aspect of life or who is the personification of a force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106862378"
	 b:glossaryEntry="a person who is part mortal and part god"/>
<rdf:Description rdf:about="&a;106862499"
	 b:glossaryEntry="a group of 3 goddesses of destiny"/>
<rdf:Description rdf:about="&a;106862596">
	<b:glossaryEntry>(classical mythology) the hideous snake-haired monsters (usually three in number) who pursued unpunished criminals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106862785"
	 b:glossaryEntry="a deity believed to live in or to control the sea"/>
<rdf:Description rdf:about="&a;106862888"
	 b:glossaryEntry="a god associated with the sun"/>
<rdf:Description rdf:about="&a;106862971"
	 b:glossaryEntry="a deity worshipped by the Celts"/>
<rdf:Description rdf:about="&a;106863493"
	 b:glossaryEntry="(Welsh) the farmer god; ancient god of agriculture"/>
<rdf:Description rdf:about="&a;106863598">
	<b:glossaryEntry>(Irish) mother of the ancient Irish gods; sometimes identified with Danu</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106863720">
	<b:glossaryEntry>(Irish) god of love and beauty; patron deity of young men and women</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106863868"
	 b:glossaryEntry="(Welsh) lord of Annwfn (the other world; land of fairies)"/>
<rdf:Description rdf:about="&a;106863977"
	 b:glossaryEntry="(Welsh) goddess famous for her beauty; mother of Dylan"/>
<rdf:Description rdf:about="&a;106864098"
	 b:glossaryEntry="(Irish) goddess; mother of Angus_Og"/>
<rdf:Description rdf:about="&a;106864185">
	<b:glossaryEntry>(Irish) goddess of fire and fertility and agriculture and household arts and wisdom; later associated with Saint Bridget</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106864358">
	<b:glossaryEntry>(Irish) chief god of the Tuatha De Danann; father of Angus Og and Brigit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106864482">
	<b:glossaryEntry>(Irish) mother of the Tuatha De Danann; identified with the Welsh Don</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106864609">
	<b:glossaryEntry>(Welsh) goddess; mother of Gwydion and Arianrod(Arianrhod); corresponds to Irish Danu</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106864744"
	 b:glossaryEntry="(Welsh) god of the waves; son of Arianrhod"/>
<rdf:Description rdf:about="&a;106864838"
	 b:glossaryEntry="(possibly Roman) goddess of horses and mules and asses"/>
<rdf:Description rdf:about="&a;106864944">
	<b:glossaryEntry>(Irish) one of a group of sea demons sometimes associated with the hostile power of nature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106865097"
	 b:glossaryEntry="(Irish) sky god; a magician; giver of arts and civilization"/>
<rdf:Description rdf:about="&a;106865210"
	 b:glossaryEntry="(Welsh) underworld god"/>
<rdf:Description rdf:about="&a;106865283">
	<b:glossaryEntry>(Irish) the sea personified; father of Manannan; corresponds to Welsh Llyr</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106865413">
	<b:glossaryEntry>(Welsh) son of Gwydion and Arionhrod; supported by magic of Gwydion; cursed by Arianhrod</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106865564"
	 b:glossaryEntry="(Welsh) a warrior god"/>
<rdf:Description rdf:about="&a;106865636"
	 b:glossaryEntry="(Welsh) corresponds to Iris Ler; father of Manawydan"/>
<rdf:Description rdf:about="&a;106865739"
	 b:glossaryEntry="(Irish) ancient Irish god (probably a god of the sun)"/>
<rdf:Description rdf:about="&a;106865842"
	 b:glossaryEntry="(Irish) god of the sea; son of Ler"/>
<rdf:Description rdf:about="&a;106865931"
	 b:glossaryEntry="(Welsh) sea god; son of LLyr"/>
<rdf:Description rdf:about="&a;106866028"
	 b:glossaryEntry="(Irish) war goddess"/>
<rdf:Description rdf:about="&a;106866112">
	<b:glossaryEntry>(Irish) race of gods or demigods; ruled Ireland in the Golden Age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106866271"
	 b:glossaryEntry="a deity worshipped by the ancient Egyptians"/>
<rdf:Description rdf:about="&a;106866681">
	<b:glossaryEntry>a primeval personification of air and breath; worshipped especially at Thebes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106866816">
	<b:glossaryEntry>sun god; supreme god of the universe in whom Amen and Ra were combined; principal deity during Theban supremacy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106866991"
	 b:glossaryEntry="jackal-headed god of tombs; conducted dead to judgment"/>
<rdf:Description rdf:about="&a;106867098">
	<b:glossaryEntry>cat- or lion-headed goddess; represents life-giving power of the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106867217"
	 b:glossaryEntry="god of the earth; father of Osiris and Isis"/>
<rdf:Description rdf:about="&a;106867316"
	 b:glossaryEntry="falcon-headed solar god"/>
<rdf:Description rdf:about="&a;106867391">
	<b:glossaryEntry>goddess of fertility; daughter of Geb; sister and wife of Osiris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106867506"
	 b:glossaryEntry="god of the morning sun; creator"/>
<rdf:Description rdf:about="&a;106867591"
	 b:glossaryEntry="a god of procreation"/>
<rdf:Description rdf:about="&a;106867661">
	<b:glossaryEntry>goddess associated with ritual of the dead; sister of Geb and Nut; wife of Set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106867794"
	 b:glossaryEntry="goddess of the sky"/>
<rdf:Description rdf:about="&a;106867862">
	<b:glossaryEntry>god of the underworld and judge of the dead; husband and sister of Isis; father or brother of Horus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106868014">
	<b:glossaryEntry>a major god; shaper of the world; father of gods and men; worshipped especially at Memphis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106868155"
	 b:glossaryEntry="ancient hawk-headed sun god; a universal creator"/>
<rdf:Description rdf:about="&a;106868257">
	<b:glossaryEntry>a lion-headed goddess; typifies life-destroying power of the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106868386">
	<b:glossaryEntry>evil beast-headed god with high square ears and a long snout; brother and murder of Osiris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106868533">
	<b:glossaryEntry>ibis-headed moon deity; god of wisdom and learning and the arts; scribe of the gods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106868668"
	 b:glossaryEntry="a deity worshipped by the ancient Semites"/>
<rdf:Description rdf:about="&a;106869741"
	 b:glossaryEntry="(Babylonian) god of storms and wind"/>
<rdf:Description rdf:about="&a;106869827">
	<b:glossaryEntry>(Babylonian) a demigod or first man: "seed of mankind"; sometimes identified with Adam</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106869965">
	<b:glossaryEntry>(Babylonian) father of the gods; identified with Assyrian Ashur; in Sumerian the name signifies "the totality of the upper world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106870147"
	 b:glossaryEntry="(Babylonian) consort of Anu"/>
<rdf:Description rdf:about="&a;106870226">
	<b:glossaryEntry>(Babylonian) the sky god; one of the supreme triad including Bel and Ea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106870347">
	<b:glossaryEntry>(Babylonian) any of a group of powerful earth spirits or genii; servitors of the gods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106870495"
	 b:glossaryEntry="(Akkadian) father of the gods and consort of Tiamat"/>
<rdf:Description rdf:about="&a;106870597">
	<b:glossaryEntry>(Akkadian) mother and earth goddess in Gilgamish epic; identified with Sumerian Ki and Ninkhursag (Mama; Nintu)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106870760">
	<b:glossaryEntry>(Assyrian) chief god of the Assyrians; god of military prowess and empire; identified with Babylonian Anshar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106870928">
	<b:glossaryEntry>an ancient Semitic fertility goddess; identified with Phoenician Astarte and Babylonian Ishtar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871078">
	<b:glossaryEntry>(Phoenician) a fertility goddess; counterpart of Ashtoreth and Ishtar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871201">
	<b:glossaryEntry>(Babylonian and Assyrian) goddess of love and fertility ad war; counterpart of Ashtoreth and Astarte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871364">
	<b:glossaryEntry>any of numerous local fertility and nature deities worshipped by ancient Semitic peoples; the Hebrews considered Baal a false god</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871544">
	<b:glossaryEntry>(Babylonian) god of the earth; one of the supreme triad including Anu and Ea; earlier identified with En-lil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871702">
	<b:glossaryEntry>(Phoenician and Philistine) god of agriculture and the earth; national god of Philistines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871843">
	<b:glossaryEntry>(Mesopotamia) god of agriculture and earth; counterpart of Phoenician Dagon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106871970">
	<b:glossaryEntry>(Babylonian) earth goddess; consort of Ea and mother of Marduk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106872100">
	<b:glossaryEntry>Sumerian and Babylonian god of pastures and vegetation; consort of Inanna</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106872235">
	<b:glossaryEntry>(Akkadian) god of wisdom; son of Apsu and father of Marduk; counterpart of the Sumerian Enki; (Babylonian) god of waters and one of the supreme triad including Anu and Bel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106872455">
	<b:glossaryEntry>(Sumerian) water god and god of wisdom; counterpart of the Akkadian Ea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106872576"
	 b:glossaryEntry="(Sumerian) god of the air and king of the Sumerian gods"/>
<rdf:Description rdf:about="&a;106872692">
	<b:glossaryEntry>(Sumerian and Akkadian) goddess of death and consort of Nergal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106872838">
	<b:glossaryEntry>(Babylonian) god of fire; often invoked in incantations against sorcery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106872961"
	 b:glossaryEntry="(Babylonian) goddess of healing and consort of Ninurta"/>
<rdf:Description rdf:about="&a;106873066"
	 b:glossaryEntry="any of a group of heavenly spirits under the god Anu"/>
<rdf:Description rdf:about="&a;106873170"
	 b:glossaryEntry="(Sumerian) consort of Dumuzi (Tammuz)"/>
<rdf:Description rdf:about="&a;106873260">
	<b:glossaryEntry>(Sumerian) goddess personifying earth; counterpart of Akkadian Aruru</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106873377">
	<b:glossaryEntry>(Babylonian) consort of Anshar; in Sumerian the name signifies "the totality of the lower world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106873526"
	 b:glossaryEntry="a female demon who attacks children"/>
<rdf:Description rdf:about="&a;106873614"
	 b:glossaryEntry="a name under which Ninkhursag was worshipped"/>
<rdf:Description rdf:about="&a;106873709">
	<b:glossaryEntry>(Babylonian) the chief Babylonian god; his consort was Sarpanitu</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106873868">
	<b:glossaryEntry>god of the Ammonites and Phoenicians to whom parents sacrificed their children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106874008">
	<b:glossaryEntry>(Babylonian) god of wisdom and agriculture and patron of scribes and schools</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106874142">
	<b:glossaryEntry>(Sumerian) goddess personifying the primeval sea; mother of the gods and of heaven and earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106874286">
	<b:glossaryEntry>(Sumerian and Akkadian) a demon personifying death; messenger of the underworld goddess Ereshkigal bringing death to mankind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106874473"
	 b:glossaryEntry="(Sumerian) god of the moon; counterpart of the Akkadian Sin"/>
<rdf:Description rdf:about="&a;106874584">
	<b:glossaryEntry>(Akkadian) god ruling with his consort Ereshkigal the world of the dead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106874708"
	 b:glossaryEntry="(Babylonian) a goddess of the watery deep and daughter of Ea"/>
<rdf:Description rdf:about="&a;106874819"
	 b:glossaryEntry="(Akkadian) a goddess; wife of the moon god Sin"/>
<rdf:Description rdf:about="&a;106874918"
	 b:glossaryEntry="(Babylonian) in older pantheon: god of war and agriculture"/>
<rdf:Description rdf:about="&a;106875031"
	 b:glossaryEntry="(Babylonian) an underworld deity; patron of medicine"/>
<rdf:Description rdf:about="&a;106875141">
	<b:glossaryEntry>(Sumerian) the great mother goddess; worshipped also as Aruru and Mama and Nintu</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106875303"
	 b:glossaryEntry="a name under which Ninkhursag was worshipped"/>
<rdf:Description rdf:about="&a;106875408">
	<b:glossaryEntry>(Sumerian and Babylonian) a solar deity; first-born of Bel and consort was Gula; god of war and the chase and agriculture; sometimes identified with Biblical Nimrod</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106875634">
	<b:glossaryEntry>(Assyrian) god of fire and light; corresponds to Babylonian Girru</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106875751">
	<b:glossaryEntry>(Assyrian) god of storms and wind; corresponds to Babylonian Adad</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106875869"
	 b:glossaryEntry="(Babylonian) consort of Marduk"/>
<rdf:Description rdf:about="&a;106875977">
	<b:glossaryEntry>(Assyrian and Babylonian) the chief sun god; drives away winter and storms and brightens the earth with greenery; drives away evil and brings of justice and compassion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106876198"
	 b:glossaryEntry="(Akkadian) god of the moon; counterpart of Sumerian Nanna"/>
<rdf:Description rdf:about="&a;106876305"
	 b:glossaryEntry="(Babylonian) consort of Nabu"/>
<rdf:Description rdf:about="&a;106876399"
	 b:glossaryEntry="(Akkadian) mother of the gods and consort of Apsu"/>
<rdf:Description rdf:about="&a;106876501">
	<b:glossaryEntry>favorite of the gods and grandfather of Gigamish; survived the great flood and became immortal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106876653"
	 b:glossaryEntry="(Sumerian) sun god; counterpart of Akkadian Shamash"/>
<rdf:Description rdf:about="&a;106876761"
	 b:glossaryEntry="(Sumerian) evil storm god represented as a black bird"/>
<rdf:Description rdf:about="&a;106876872"
	 b:glossaryEntry="(Sumerian) legendary friend of Gilgamish"/>
<rdf:Description rdf:about="&a;106876965">
	<b:glossaryEntry>(Sumerian) legendary king of Sumeria and hero of Sumerian and Babylonian epics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106877099"
	 b:glossaryEntry="a deity worshipped by the Hindus"/>
<rdf:Description rdf:about="&a;106878089">
	<b:glossaryEntry>a Hindu goddess who releases from sin or disease; mother of the Adityas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106878212"
	 b:glossaryEntry="one of 7 to 12 sons of Aditi; gods of celestial light"/>
<rdf:Description rdf:about="&a;106878318"
	 b:glossaryEntry="god of fire; one of the 3 chief deities of the Vedas"/>
<rdf:Description rdf:about="&a;106878421">
	<b:glossaryEntry>earlier a god; later a demon; counterpart of Zoroastrian Ahura</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106878535"
	 b:glossaryEntry="(Zoroastrianism) title for benevolent deities"/>
<rdf:Description rdf:about="&a;106878632">
	<b:glossaryEntry>twin brothers; gods of the dawn; physicians of heaven and benefactors of mankind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106878765"
	 b:glossaryEntry="god of wealth and love"/>
<rdf:Description rdf:about="&a;106878839">
	<b:glossaryEntry>the Creator; one of the three major deities in the later Hindu pantheon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106878982"
	 b:glossaryEntry="personification of the power of ritual devotion"/>
<rdf:Description rdf:about="&a;106879086"
	 b:glossaryEntry="earth goddess; one of the two wives of Vishnu"/>
<rdf:Description rdf:about="&a;106879188">
	<b:glossaryEntry>mother goddess; supreme power in the universe; wife or embodiment of the female energy of Siva having both beneficent and malevolent forms or aspects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106879388"
	 b:glossaryEntry='malevolent aspect of Devi: "the fierce"'/>
<rdf:Description rdf:about="&a;106879480">
	<b:glossaryEntry>basic principles of the cosmos; also: an ancient sage in Hindu mythology worshipped as a god by some lower castes;</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106879648">
	<b:glossaryEntry>goddess of war; a malevolent aspect of Devi; "the inaccessible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106879763"
	 b:glossaryEntry="god of the sky"/>
<rdf:Description rdf:about="&a;106879843"
	 b:glossaryEntry="god of wisdom or prophesy; remover of obstacles"/>
<rdf:Description rdf:about="&a;106879973">
	<b:glossaryEntry>supernatural half-man and half-bird vehicle or bearer of Vishnu</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106880089"
	 b:glossaryEntry='a benevolent aspect of Devi; "the brilliant"'/>
<rdf:Description rdf:about="&a;106880185"
	 b:glossaryEntry="the monkey god; helper of Rama"/>
<rdf:Description rdf:about="&a;106880269"
	 b:glossaryEntry="chief god of the Rig-Veda; god of rain and thunder"/>
<rdf:Description rdf:about="&a;106880371"
	 b:glossaryEntry="unknown god; an epithet of Prajapati and Brahma"/>
<rdf:Description rdf:about="&a;106880467"
	 b:glossaryEntry='wife of Siva and malevolent form of Devi; "the black"'/>
<rdf:Description rdf:about="&a;106880571"
	 b:glossaryEntry="god of love and erotic desire; opposite of Mara"/>
<rdf:Description rdf:about="&a;106880669"
	 b:glossaryEntry="god of death; opposite of Kama"/>
<rdf:Description rdf:about="&a;106880750"
	 b:glossaryEntry="god of bravery"/>
<rdf:Description rdf:about="&a;106880833"
	 b:glossaryEntry="goddess of fortune"/>
<rdf:Description rdf:about="&a;106880905"
	 b:glossaryEntry="any of a group of storm gods; offspring of Rudra"/>
<rdf:Description rdf:about="&a;106881005"
	 b:glossaryEntry="god of justice"/>
<rdf:Description rdf:about="&a;106881071"
	 b:glossaryEntry="god of rain; sometimes identified with Indra"/>
<rdf:Description rdf:about="&a;106881170">
	<b:glossaryEntry>wife of Siva and a benevolent aspect of Devi: goddess of plenty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106881310"
	 b:glossaryEntry="god personifying a creative force; equivalent to Brahma"/>
<rdf:Description rdf:about="&a;106881421"
	 b:glossaryEntry="celestial shepherd god; conductor of souls of the dead"/>
<rdf:Description rdf:about="&a;106881528"
	 b:glossaryEntry="a demon who swallows the sun causing eclipses"/>
<rdf:Description rdf:about="&a;106881624"
	 b:glossaryEntry="one of three artisans of the gods"/>
<rdf:Description rdf:about="&a;106881720">
	<b:glossaryEntry>father of the storm gods Marut; controller of nature; sometimes identified with Siva</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106881856"
	 b:glossaryEntry="goddess of learning and arts"/>
<rdf:Description rdf:about="&a;106881940"
	 b:glossaryEntry="an important god; the sun in its life-giving aspect"/>
<rdf:Description rdf:about="&a;106882045">
	<b:glossaryEntry>the female or generative principle; wife of Siva and a benevolent form of Devi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106882184">
	<b:glossaryEntry>the Destroyer; one of the three major divinities in the later Hindu pantheon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106882356"
	 b:glossaryEntry='epithet of Siva: "the terrible"'/>
<rdf:Description rdf:about="&a;106882441"
	 b:glossaryEntry="god of war"/>
<rdf:Description rdf:about="&a;106882504">
	<b:glossaryEntry>personification of a sacred intoxicating drink used in Vedic ritual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106882622">
	<b:glossaryEntry>an important god; sun god or the sun worshipped as a god of light and warmth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106882750"
	 b:glossaryEntry="a benevolent aspect of Devi; `splendor''"/>
<rdf:Description rdf:about="&a;106882839"
	 b:glossaryEntry="goddess of dawn; daughter of Sky and sister of Night"/>
<rdf:Description rdf:about="&a;106882943"
	 b:glossaryEntry="Indras''s thunderbolt"/>
<rdf:Description rdf:about="&a;106883015">
	<b:glossaryEntry>supreme cosmic deity; god of natural and moral law; ancient sky god</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106883135"
	 b:glossaryEntry="wind god"/>
<rdf:Description rdf:about="&a;106883194">
	<b:glossaryEntry>the Sustainer; a Hindu divinity worshipped as the preserver of worlds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106883335"
	 b:glossaryEntry="god of the Underworld"/>
<rdf:Description rdf:about="&a;106883407">
	<b:glossaryEntry>the manifestation of a Hindu deity (especially Vishnu) in human or superhuman or animal form; "the Buddha is considered an avatar of the god Vishnu"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106883680"
	 b:glossaryEntry="an avatar of Vishnu"/>
<rdf:Description rdf:about="&a;106883793"
	 b:glossaryEntry="the 10th and last incarnation of Vishnu"/>
<rdf:Description rdf:about="&a;106883884">
	<b:glossaryEntry>8th and most important avatar of Vishnu; incarnated as a handsome young man playing a flute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106884029">
	<b:glossaryEntry>avatar of Vishnu; any of three incarnations: Ramachandra or Parashurama or Balarama</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106884217"
	 b:glossaryEntry="a hero in Hindu mythology; an incarnation of Vishnu"/>
<rdf:Description rdf:about="&a;106884326"
	 b:glossaryEntry="wife of Ramachandra"/>
<rdf:Description rdf:about="&a;106884396"
	 b:glossaryEntry="elder brother of Krishna; an incarnation of Vishnu"/>
<rdf:Description rdf:about="&a;106884501"
	 b:glossaryEntry="an incarnation of Vishnu who rid the earth of Kshatriyas"/>
<rdf:Description rdf:about="&a;106884615"
	 b:glossaryEntry="a deity worshiped by the ancient Persians"/>
<rdf:Description rdf:about="&a;106884770"
	 b:glossaryEntry="ancient Persian god of light and truth; sun god"/>
<rdf:Description rdf:about="&a;106884880">
	<b:glossaryEntry>chief deity of Zoroastrianism; source of light and embodiment of good</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106885025"
	 b:glossaryEntry="the spirit of evil in Zoroastrianism; arch rival of Ormazd"/>
<rdf:Description rdf:about="&a;106885137"
	 b:glossaryEntry="founder of Buddhism; c 563-483 b.c.; worshipped as a god"/>
<rdf:Description rdf:about="&a;106885299"
	 b:glossaryEntry="Buddhist worthy of nirvana who postpones it to help others"/>
<rdf:Description rdf:about="&a;106885465">
	<b:glossaryEntry>the Bodhisattva who is to appear as a Buddha 5000 years after the death of Gautama</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106885602">
	<b:glossaryEntry>a male Bodhisattva; widely associated with various gods and people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106885747"
	 b:glossaryEntry="a Buddhist who has attained nirvana"/>
<rdf:Description rdf:about="&a;106885851"
	 b:glossaryEntry="one who has achieved a state of perfect enlightenment"/>
<rdf:Description rdf:about="&a;106885957"
	 b:glossaryEntry="a deity worshipped by the ancient Chinese"/>
<rdf:Description rdf:about="&a;106886184"
	 b:glossaryEntry="one of the 8 immortals of Taoism"/>
<rdf:Description rdf:about="&a;106886288"
	 b:glossaryEntry="Chinese god of literature"/>
<rdf:Description rdf:about="&a;106886379"
	 b:glossaryEntry="The Three Pure Ones: 3 chief gods of Taoism"/>
<rdf:Description rdf:about="&a;106886540"
	 b:glossaryEntry="a member of the Taoist Trinity"/>
<rdf:Description rdf:about="&a;106886661"
	 b:glossaryEntry="a member of the Taoist Trinity"/>
<rdf:Description rdf:about="&a;106886780"
	 b:glossaryEntry="a member of the Taoist Trinity; identified with Lao-Tse"/>
<rdf:Description rdf:about="&a;106886927"
	 b:glossaryEntry="Chinese philosopher who founded Taoism; 6th-century b.c."/>
<rdf:Description rdf:about="&a;106887055">
	<b:glossaryEntry>4th-century Chinese philosopher on whose teachings Lao-Tzu based Taoism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106887183">
	<b:glossaryEntry>(Buddhism) a female Bodhisattva; often called Goddess of Mercy and considered an aspect of the Bodhisattva Avalokitesvara; identified with Japanese Kwannon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106887404"
	 b:glossaryEntry="a deity worshipped by the Japanese"/>
<rdf:Description rdf:about="&a;106887643">
	<b:glossaryEntry>central deity of Shinto; goddess personifying the sun and ancestress of the rulers of Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106887810"
	 b:glossaryEntry="a Shinto god of war"/>
<rdf:Description rdf:about="&a;106887884"
	 b:glossaryEntry="one of the 7 gods of happiness"/>
<rdf:Description rdf:about="&a;106887966">
	<b:glossaryEntry>the god who fathered the islands and gods of Japan with his sister Izanami</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106888094">
	<b:glossaryEntry>sister and consort of Izanami; mother of the islands and gods of Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106888218">
	<b:glossaryEntry>one the Shinto deities (including mythological beings; spirits of distinguished men; forces of nature)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106888371"
	 b:glossaryEntry="Japanese counterpart of Chinese Kuan_Yin;"/>
<rdf:Description rdf:about="&a;106888467"
	 b:glossaryEntry="grandson of Amaterasu and first ruler of Japan"/>
<rdf:Description rdf:about="&a;106888584"
	 b:glossaryEntry="a female deity"/>
<rdf:Description rdf:about="&a;106888670"
	 b:glossaryEntry="a god of fertility and vegetation"/>
<rdf:Description rdf:about="&a;106888759"
	 b:glossaryEntry="a goddess of fertility and vegetation"/>
<rdf:Description rdf:about="&a;106888874"
	 b:glossaryEntry="the earth conceived of as the female principle of fertility"/>
<rdf:Description rdf:about="&a;106888992">
	<b:glossaryEntry>the supernatural being conceived as the perfect and omnipotent and omniscient originator and ruler of the universe; the object of worship in monotheistic religions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106889275"
	 b:glossaryEntry="the Christian god"/>
<rdf:Description rdf:about="&a;106889444">
	<b:glossaryEntry>(in Gnosticism) a divine power or nature emanating from the Supreme Being and playing various roles in the operation of the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106889633">
	<b:glossaryEntry>the union of the Father and Son and Holy Ghost in one Godhead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106889800">
	<b:glossaryEntry>God when considered as the first person in the Trinity; "hear our prayers, Heavenly Father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106889957">
	<b:glossaryEntry>the divine word of God; the second person in the Trinity (incarnate in Jesus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106890135">
	<b:glossaryEntry>the awaited King of the Jews; the promised and expected deliverer of the Jewish people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106890275">
	<b:glossaryEntry>Jesus Christ; considered by Christians to be the promised deliverer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106890396"
	 b:glossaryEntry="any expected deliverer"/>
<rdf:Description rdf:about="&a;106890481">
	<b:glossaryEntry>the third person in the Trinity; Jesus promised the Apostles that he would send the Holy Spirit after his Crucifixion and Resurrection; it came on Pentecost</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106890708">
	<b:glossaryEntry>any of the three persons of the Godhead constituting the Trinity especially the person of Christ in which divine and human natures are united</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106890979">
	<b:glossaryEntry>a name for the Old Testament God as transliterated from the Hebrew YHVH</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106891165"
	 b:glossaryEntry="Muslim name for God"/>
<rdf:Description rdf:about="&a;106891236">
	<b:glossaryEntry>a subordinate deity, in some philosophies the creator of the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106891360">
	<b:glossaryEntry>ancient Italian deity in human shape, with horns, pointed ears and a goat''s tail; equivalent to Greek satyr</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106891518"
	 b:glossaryEntry="spiritual being attendant upon God"/>
<rdf:Description rdf:about="&a;106891713">
	<b:glossaryEntry>an angel ranked above the highest rank in the Celestial Hierarchy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106891834">
	<b:glossaryEntry>an angel of the second order whose gift is knowledge; usually portrayed as a winged child</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106891976">
	<b:glossaryEntry>an angel of the first order; usually portrayed as the winged head of a child</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106892105">
	<b:glossaryEntry>an angel believed to have special affection for a particular individual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106892291"
	 b:glossaryEntry="the guardian spirit of a place"/>
<rdf:Description rdf:about="&a;106892379"
	 b:glossaryEntry='a messenger from God; "angel of death"'/>
<rdf:Description rdf:about="&a;106892480"
	 b:glossaryEntry="small, human in form, playful, having magical powers"/>
<rdf:Description rdf:about="&a;106892700"
	 b:glossaryEntry="a fairy that inhabits water"/>
<rdf:Description rdf:about="&a;106892818"
	 b:glossaryEntry="any of various water spirits"/>
<rdf:Description rdf:about="&a;106892899"
	 b:glossaryEntry="(folklore) fairies that are somewhat mischievous"/>
<rdf:Description rdf:about="&a;106893062"
	 b:glossaryEntry="a mischievous elf in Irish folklore"/>
<rdf:Description rdf:about="&a;106893154">
	<b:glossaryEntry>a legendary creature resembling a tiny old man; lives in the depths of the earth and guards buried treasure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106893321"
	 b:glossaryEntry="a mischievous sprite"/>
<rdf:Description rdf:about="&a;106893392"
	 b:glossaryEntry="a spirit tending to cause harm"/>
<rdf:Description rdf:about="&a;106893606"
	 b:glossaryEntry="a fairy that tends to cause harm"/>
<rdf:Description rdf:about="&a;106893694"
	 b:glossaryEntry="an evil spirit"/>
<rdf:Description rdf:about="&a;106893775">
	<b:glossaryEntry>one of the evil spirits of traditional Jewish and Christian belief</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106893981"
	 b:glossaryEntry="(Greek) an evil spirit"/>
<rdf:Description rdf:about="&a;106894090"
	 b:glossaryEntry="(Greek) a benevolent spirit"/>
<rdf:Description rdf:about="&a;106894214">
	<b:glossaryEntry>a male demon believed to lie on sleeping persons and to have sexual intercourse with sleeping women</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106894367">
	<b:glossaryEntry>a female demon believed to have sexual intercourse with sleeping men</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106894500">
	<b:glossaryEntry>(Jewish folklore) a demon that enters the body of a living person and controls that body''s behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106894661">
	<b:glossaryEntry>(Judeo-Christian religion) chief spirit of evil and adversary of God; tempter of mankind; master of Hell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106894905"
	 b:glossaryEntry="an evil spirit or ghost"/>
<rdf:Description rdf:about="&a;106894980">
	<b:glossaryEntry>(folklore) a small grotesque supernatural creature that makes trouble for human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106895137">
	<b:glossaryEntry>(folklore) a corpse that rises at night to drink the blood of the living</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106895271">
	<b:glossaryEntry>(Irish folklore) a female spirit who wails to warn of impending death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106895394">
	<b:glossaryEntry>a spirit believed by Muslims to inhabit the earth and influence mankind by appearing in the form of humans or animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106895598">
	<b:glossaryEntry>(in Muslim belief) one of the dark-eyed virgins of perfect beauty believed to live with the blessed in Paradise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106895761">
	<b:glossaryEntry>a spirit (usually in animal form) that acts as an assistant to a witch or wizard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106895914">
	<b:glossaryEntry>any incorporeal supernatural being that can become visible (or audible) to human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106896270"
	 b:glossaryEntry="the visible disembodied soul of a dead person"/>
<rdf:Description rdf:about="&a;106896385">
	<b:glossaryEntry>a ghost that announces its presence with rapping and the creation of disorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106896520"
	 b:glossaryEntry="a wicked fairy who was the half sister of King Arthur"/>
<rdf:Description rdf:about="&a;106896633">
	<b:glossaryEntry>(Persian folklore) a supernatural being descended from fallen angels and excluded from paradise until penance is done</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106896801">
	<b:glossaryEntry>an unusual appearing ghostly figure; "we were unprepared for the apparition that confronted us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106896983"
	 b:glossaryEntry="an invisible spiritual being felt to be nearby"/>
<rdf:Description rdf:about="&a;106897084">
	<b:glossaryEntry>(classical mythology) a handsome youth loved by Aphrodite, the goddess of love</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106897215"
	 b:glossaryEntry="a deity of classical mythology"/>
<rdf:Description rdf:about="&a;106897438">
	<b:glossaryEntry>one of a class of woodland deities; attendant on Bacchus; identified with Roman fauns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106897606">
	<b:glossaryEntry>the chief satyr in the service of Bacchus; father of Dionysus; usually depicted as drunk and jolly and riding a donkey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106897778">
	<b:glossaryEntry>any of the minor woodland deities who were companions of Dionysus (similar to the satyrs)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106897921">
	<b:glossaryEntry>(classical mythology) a minor nature goddess usually depicted as a beautiful maiden; "the ancient Greeks believed that nymphs inhabited forests and bodies of water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106898281">
	<b:glossaryEntry>group of 3 to 7 nymphs who guarded the golden apples that Gaea gave as a wedding gift to Hera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106898444">
	<b:glossaryEntry>(Greek mythology) 7 daughters of Atlas and half-sisters of the Pleiades; they nurtured the infant Dionysus and Zeus placed them among the stars as a reward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106898652">
	<b:glossaryEntry>(Greek mythology) 7 daughters of Atlas and half-sisters of the Hyades; placed among the stars to save them from the pursuit of Orion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106898858"
	 b:glossaryEntry="(Greek mythology) one of the 7 Pleiades"/>
<rdf:Description rdf:about="&a;106898981"
	 b:glossaryEntry="(Greek mythology) any nymph of the water"/>
<rdf:Description rdf:about="&a;106899133">
	<b:glossaryEntry>(Greek mythology) a nymph who was transformed into a laurel tree to escape the amorous Apollo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106899279">
	<b:glossaryEntry>(Greek mythology) a nymph of lakes and springs and rivers and fountains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106899402">
	<b:glossaryEntry>(Greek mythology) any of the 50 sea nymphs who were daughters of the sea god Nereus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106899568"
	 b:glossaryEntry="one of the 50 Nereids; mother of Achilles by Peleus"/>
<rdf:Description rdf:about="&a;106899672">
	<b:glossaryEntry>(Greek mythology) a daughter of the Titans Oceanus and Tethys</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106899799"
	 b:glossaryEntry="a deity or nymph of the woods"/>
<rdf:Description rdf:about="&a;106899929"
	 b:glossaryEntry="Greek mythology"/>
<rdf:Description rdf:about="&a;106900005"
	 b:glossaryEntry="the nymph or spirit of a particular tree"/>
<rdf:Description rdf:about="&a;106900101"
	 b:glossaryEntry="a deity worshipped by the ancient Greeks"/>
<rdf:Description rdf:about="&a;106901225"
	 b:glossaryEntry="a deity worshipped by the ancient Romans"/>
<rdf:Description rdf:about="&a;106901863"
	 b:glossaryEntry="a classical Greek god after the overthrow of the Titans"/>
<rdf:Description rdf:about="&a;106901987"
	 b:glossaryEntry="god of the winds in ancient mythology"/>
<rdf:Description rdf:about="&a;106902077">
	<b:glossaryEntry>personification of the sky or upper air breathed by the Olympians; son of Erebus and Night or of Chaos and Darkness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106902245">
	<b:glossaryEntry>sun god; god of prophesy and poetry and music and healing; son of Zeus and Leto; twin brother of Artemis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106902447"
	 b:glossaryEntry="epithet for Apollo; from the dragon Python which he killed"/>
<rdf:Description rdf:about="&a;106902559">
	<b:glossaryEntry>goddess of love and beauty and daughter of Zeus in ancient mythology; identified with Roman Venus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106902723"
	 b:glossaryEntry="goddess of love; counterpart of Greek Aphrodite"/>
<rdf:Description rdf:about="&a;106902831">
	<b:glossaryEntry>(Greek mythology) god of war; son of Zeus and Hera; identified with Roman Mars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106902960"
	 b:glossaryEntry="(Greek mythology) goddess of discord; sister of Ares"/>
<rdf:Description rdf:about="&a;106903063">
	<b:glossaryEntry>(Roman mythology) god of war and agriculture; father of Romulus and Remus; counterpart of Greek Ares</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106903214">
	<b:glossaryEntry>(Roman mythology) founder of Rome; suckled with his twin brother Remus by a wolf after their parents (Rhea Silvia and Mars) abandoned them; Romulus killed Remus in an argument over the building of Rome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106903469"
	 b:glossaryEntry="(Roman mythology) the twin brother of Romulus"/>
<rdf:Description rdf:about="&a;106903566">
	<b:glossaryEntry>(Greek mythology) the virgin goddess of the hunt and the moon; daughter of Leto and twin sister of Apollo; identified with Roman Diana</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106903764">
	<b:glossaryEntry>(Greek mythology) the god who personified the north wind; "Boreas was pictured as bearded and powerful and winged and draped against the cold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106903959">
	<b:glossaryEntry>(Roman mythology) virgin goddess of the hunt and the moon; counterpart of Greek Artemis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106904098"
	 b:glossaryEntry="goddess of criminal rashness and its punishment"/>
<rdf:Description rdf:about="&a;106904195">
	<b:glossaryEntry>(Greek mythology) goddess of wisdom and useful arts and prudent warfare; guardian of Athens; identified with Roman Minerva</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106904404">
	<b:glossaryEntry>(Roman mythology) goddess of wisdom; counterpart of Greek Athena</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106904522">
	<b:glossaryEntry>(Greek mythology) the most ancient of gods; the personification of the infinity of space preceding creation of the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106904697">
	<b:glossaryEntry>(Greek mythology) the supreme god until Zeus dethroned him; son of Uranus and Gaea in ancient Greek mythology; identified with Roman Saturn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106904889">
	<b:glossaryEntry>(Roman mythology) a princess of Tyre who was the founder and queen of Carthage; Virgil tells of he suicide when she was abandoned by Aeneas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106905079">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(Roman mythology) god of agriculture and vegetation; counterpart of Greek Cronus; "Saturday is Saturn''s Day"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106905240">
	<b:glossaryEntry>(Greek mythology) goddess of fertility and protector of marriage in ancient mythology; counterpart of Roman Ceres</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106905407">
	<b:glossaryEntry>(Roman mythology) goddess of agriculture; counterpart of Greek Demeter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106905529">
	<b:glossaryEntry>(Greek mythology) god of wine and fertility and drama; the Greek name of Bacchus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106905664"
	 b:glossaryEntry="(Greek mythology) wife of Nereus and mother of the Nereids"/>
<rdf:Description rdf:about="&a;106905774"
	 b:glossaryEntry="the god of medicine and healing"/>
<rdf:Description rdf:about="&a;106905863">
	<b:glossaryEntry>(in ancient Greece and Rome) god of wine; equivalent of Dionysus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106905981">
	<b:glossaryEntry>(Greek mythology) god of darkness who dwelt in the underworld; son of Chaos; brother of Nox; father of Aether and Day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106906151"
	 b:glossaryEntry="goddess of night; daughter of Erebus"/>
<rdf:Description rdf:about="&a;106906245">
	<b:glossaryEntry>(Greek mythology) god of love; son of Aphrodite; identified with Roman Cupid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106906372"
	 b:glossaryEntry="(Roman mythology) god of love; counterpart of Greek Eros"/>
<rdf:Description rdf:about="&a;106906487">
	<b:glossaryEntry>(Greek mythology) an Athenian inventor who built the Labyrinth of Minos; to escape the Labyrinth he fashioned wings for himself and his sone Icarus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106906689">
	<b:glossaryEntry>(Greek mythology) according to a Greek legend: when Pythias was sentenced to be executed Damon took his place to allow Pythias to get his affairs in order; when Pythias returned in time to save Damon the king was so impressed that he let them both live</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106907005">
	<b:glossaryEntry>(Greek mythology) goddess of the earth and mother of Cronus and the Titans in ancient mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106907163">
	<b:glossaryEntry>(Greek mythology) ancient god of the sun; drove his chariot across the sky each day; identified with Roman Sol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106907326">
	<b:glossaryEntry>(Greek mythology) son of Daedalus; while escaping from Crete with his father (using the wings Daedalus had made) he flew too close to the sun and the wax melted and he fell into the Aegean and drowned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106907579">
	<b:glossaryEntry>(Greek mythology) ancient Roman god; personification of the sun; counterpart of Greek Helios</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106907721">
	<b:glossaryEntry>(Greek mythology) the lame god of fire and metal-working in ancient mythology; identified with Roman Vulcan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106907898">
	<b:glossaryEntry>(Roman mythology) god of fire and metal working; counterpart of Greek Hephaestus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106908031">
	<b:glossaryEntry>(Greek mythology) messenger and herald of the gods; god of commerce and cunning and and invention and theft; identified with Roman Mercury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106908222">
	<b:glossaryEntry>(Roman mythology) messenger of Jupiter and god of commerce; counterpart of Greek Hermes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106908363">
	<b:glossaryEntry>queen of the Olympian gods in ancient Greek mythology; sister and wife of Zeus remembered for her jealously of the many mortal women Zeus fell in love with; identified with Roman Juno</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106908604">
	<b:glossaryEntry>(Greek mythology) a maiden seduced by Zeus; when Hera was about to discover them together Zeus turned her into a white heifer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106908778">
	<b:glossaryEntry>(Roman mythology) the Roman god of doorways and passages; is depicted with two faces on opposite sides of his head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106908944">
	<b:glossaryEntry>(Roman mythology) queen of the Olympian gods who protected marriage; wife and sister of Jupiter; counterpart of Greek Hera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106909117">
	<b:glossaryEntry>(Greek mythology) the goddess of the hearth and its fire in ancient mythology; identified with Roman Vesta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106909276">
	<b:glossaryEntry>(Roman mythology) goddess of the hearth and its fire whose flame was tended by vestal virgins; counterpart of Greek Hestia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106909450"
	 b:glossaryEntry="god of marriage in ancient Greek mythology"/>
<rdf:Description rdf:about="&a;106909544"
	 b:glossaryEntry="father of Helios and Selene and Eos in ancient mythology"/>
<rdf:Description rdf:about="&a;106909655">
	<b:glossaryEntry>son of Zeus and Europa; king of ancient Crete; ordered Daedalus to build the labyrinth; after death Minos became a judge in the underworld</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106909845">
	<b:glossaryEntry>beautiful daughter of Minos and Pasiphae; she fell in love with Theseus and gave him the thread with which he found his way out of the Minotaur''s labyrinth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106910054">
	<b:glossaryEntry>the 3 goddesses of fate or destiny; identified with the Roman Parcae and similar to the Norse Norns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106910272">
	<b:glossaryEntry>the 3 goddesses of fate or destiny; identified with the Greek Moirai and similar to the Norse Norns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106910462">
	<b:glossaryEntry>the Fate who spins the thread of life; identified with Roman Nona</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106910599">
	<b:glossaryEntry>the Fate who spins the thread of life; counterpart of Greek Clotho</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106910716">
	<b:glossaryEntry>the Fate who determines the length of the thread of life; identified with Roman Decuma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106910876">
	<b:glossaryEntry>the Fate who determines the length of the thread of life; counterpart of Greek Lachesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106911035">
	<b:glossaryEntry>the Fate who cuts the thread of life; identified with Roman Morta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106911173">
	<b:glossaryEntry>the Fate who cuts the thread of life; counterpart of Greek Atropos</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106911310"
	 b:glossaryEntry="god of blame and mockery"/>
<rdf:Description rdf:about="&a;106911394">
	<b:glossaryEntry>in ancient mythology any of 9 daughters of Zeus and Mnemosyne; protector of an art or science</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106911700"
	 b:glossaryEntry="(Greek mythology) the Muse of epic poetry"/>
<rdf:Description rdf:about="&a;106911796"
	 b:glossaryEntry="(Greek mythology) the Muse of history"/>
<rdf:Description rdf:about="&a;106911884"
	 b:glossaryEntry="(Greek mythology) the Muse of lyric and love poetry"/>
<rdf:Description rdf:about="&a;106911987"
	 b:glossaryEntry="(Greek mythology) the Muse of music (or the flute)"/>
<rdf:Description rdf:about="&a;106912091"
	 b:glossaryEntry="(Greek mythology) the Muse of tragedy"/>
<rdf:Description rdf:about="&a;106912184">
	<b:glossaryEntry>(Greek mythology) the Muse of singing and mime and sacred dance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106912304"
	 b:glossaryEntry="(Greek mythology) the Muse of the dance and of choral song"/>
<rdf:Description rdf:about="&a;106912420"
	 b:glossaryEntry="(Greek mythology) the Muse of comedy and pastoral poetry"/>
<rdf:Description rdf:about="&a;106912529"
	 b:glossaryEntry="(Greek mythology) the Muse of astronomy"/>
<rdf:Description rdf:about="&a;106912621"
	 b:glossaryEntry="the goddess of divine retribution and vengeance"/>
<rdf:Description rdf:about="&a;106912722">
	<b:glossaryEntry>a sea god son of Pontus and Gaea; lived in the depths of the sea with his wife Doris and their daughters the Nereids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106912891"
	 b:glossaryEntry="winged goddess of victory; identified with Roman Victoria"/>
<rdf:Description rdf:about="&a;106912999"
	 b:glossaryEntry="goddess of victory; counterpart of Greek Nike"/>
<rdf:Description rdf:about="&a;106913099">
	<b:glossaryEntry>god of the heavens; son and husband of Gaea and father of the Titans in ancient mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106913251">
	<b:glossaryEntry>god of fields and woods and shepherds and flocks; represented as a man with goat''s legs and horns and ears; identified with Roman Sylvanus or Faunus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106913464">
	<b:glossaryEntry>ancient rural deity; later considered a counterpart of Greek Pan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106913581"
	 b:glossaryEntry="daughter of Helios and mother of Ariadne"/>
<rdf:Description rdf:about="&a;106913676"
	 b:glossaryEntry="ancient personification of the sea; father of Nereus"/>
<rdf:Description rdf:about="&a;106913790">
	<b:glossaryEntry>(Greek mythology) the god of the sea and earthquakes in ancient mythology; brother of Zeus and Hades and Hera; identified with Roman Neptune</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106913985">
	<b:glossaryEntry>(Greek mythology) a prophetic god who served Poseidon; was capable of changing his shape at will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106914135">
	<b:glossaryEntry>(Roman mythology) god of the sea; counterpart of Greek Poseidon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106914252">
	<b:glossaryEntry>daughter of Zeus and Demeter; made queen of the underworld by Pluto in ancient mythology; identified with Roman Proserpina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106914456">
	<b:glossaryEntry>(Greek mythology) a mythical giant who was a thief and murderer; he would capture people and tie them to an iron bed, stretching them or hacking off their legs to make them fit; was killed by Theseus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106914712"
	 b:glossaryEntry="goddess of the underworld; counterpart of Greek Persephone"/>
<rdf:Description rdf:about="&a;106914840">
	<b:glossaryEntry>son of Helios; killed when trying to drive his father''s chariot and came too close to earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106914986">
	<b:glossaryEntry>(classical mythology) the god of the underworld in ancient mythology; brother of Zeus and husband of Persephone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106915176"
	 b:glossaryEntry="god of the underworld; counterpart of Greek Pluto"/>
<rdf:Description rdf:about="&a;106915283">
	<b:glossaryEntry>the priestess of Apollo at Delphi who transmitted the oracles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106915397">
	<b:glossaryEntry>god of male procreative power and guardian of gardens and vineyards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106915518"
	 b:glossaryEntry="a judge of the dead in the underworld"/>
<rdf:Description rdf:about="&a;106915614">
	<b:glossaryEntry>goddess of the moon in ancient mythology; identified with Roman Luna</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106915735"
	 b:glossaryEntry="the goddess of the moon; counterpart of Greek Selene"/>
<rdf:Description rdf:about="&a;106915838">
	<b:glossaryEntry>the winged goddess of the dawn in ancient mythology; daughter of Hyperion; identified with Roman Aurora</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106915991"
	 b:glossaryEntry="(Greek mythology) the wife of Orpheus"/>
<rdf:Description rdf:about="&a;106916083">
	<b:glossaryEntry>(Greek mythology) a giant Boeotian hunter who pursued the Pleiades and was eventually slain by Artemis; was then placed in the sky as a constellation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106916284">
	<b:glossaryEntry>(Greek mythology) a great musician; when his wife Eurydice died he went to Hades to get her back but failed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106916445"
	 b:glossaryEntry="goddess of the dawn; counterpart of Greek Eos"/>
<rdf:Description rdf:about="&a;106916543">
	<b:glossaryEntry>goddess of the earth; protector of marriage and fertility; identified with Greek Gaea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106916681">
	<b:glossaryEntry>(Greek mythology) any of the primordial giant gods who ruled the Earth until overthrown by Zeus; the Titans were offspring of Uranus (Heaven) and Gaea (Earth)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106917053">
	<b:glossaryEntry>any of the primordial giant goddesses who were offspring of Uranus (heaven) and Gaea (earth) in ancient mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106917329"
	 b:glossaryEntry="a sea god; son of Poseidon"/>
<rdf:Description rdf:about="&a;106917408"
	 b:glossaryEntry="the goddess of fortune; identified with Roman Fortuna"/>
<rdf:Description rdf:about="&a;106917513">
	<b:glossaryEntry>the goddess of fortune and good luck; counterpart of Greek Tyche</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106917631"
	 b:glossaryEntry="(classical mythology) the Greek god of the west wind"/>
<rdf:Description rdf:about="&a;106917736">
	<b:glossaryEntry>the supreme god of ancient mythology; son of Rhea and Cronus whom he dethroned and husband and sister of Hera; brother of Poseidon and Hades; father of many gods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106917948">
	<b:glossaryEntry>(Roman mythology) supreme god of Romans; counterpart of Greek Zeus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106918165"
	 b:glossaryEntry="an epithet for Jupiter"/>
<rdf:Description rdf:about="&a;106918288"
	 b:glossaryEntry="an epithet for Jupiter"/>
<rdf:Description rdf:about="&a;106918383"
	 b:glossaryEntry="an epithet for Jupiter"/>
<rdf:Description rdf:about="&a;106918480"
	 b:glossaryEntry="an epithet for Jupiter"/>
<rdf:Description rdf:about="&a;106918592"
	 b:glossaryEntry="an epithet for Jupiter"/>
<rdf:Description rdf:about="&a;106918701">
	<b:glossaryEntry>god of the stream that flowed around the earth in ancient mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106918822"
	 b:glossaryEntry="one of the Titans"/>
<rdf:Description rdf:about="&a;106918891"
	 b:glossaryEntry="one of the Titans"/>
<rdf:Description rdf:about="&a;106918960">
	<b:glossaryEntry>(Greek mythology) the Titan who was father of Atlas and Epimetheus and Prometheus in ancient mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106919116">
	<b:glossaryEntry>(Roman mythology) one of the virgin priestesses consecrated to the Roman goddess Vesta and to maintaining the sacred fire in her temple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106919311">
	<b:glossaryEntry>a Titan in ancient mythology who was forced by Zeus to bear the sky on his shoulders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106919447">
	<b:glossaryEntry>(Greek mythology) brother of Prometheus and father of Pyrrha; despite Prometheus''s warning against gifts from Zeus he accepted Pandora as his wife</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106919650">
	<b:glossaryEntry>(Greek mythology) the Titan who stole fire from Olympus and gave it to mankind; Zeus punished him by chaining him to a rock where an eagle gnawed at his liver until Hercules rescued him; father of Deucalion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106919913">
	<b:glossaryEntry>the Titaness who was mother of Helios and Selene and Eos in ancient mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106920049">
	<b:glossaryEntry>fertility goddess in ancient mythology; wife of Cronus and mother of Zeus; identified with Roman Ops and Cybele of ancient Asia Minor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106920251">
	<b:glossaryEntry>goddess of abundance and fertility; wife of Saturn; counterpart of Greek Rhea and Cybele of ancient Asia Minor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106920411">
	<b:glossaryEntry>Roman god of woods and fields and flocks; Pan is the Greek counterpart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106920547"
	 b:glossaryEntry="Asiatic epithet for Rhea or Cybele"/>
<rdf:Description rdf:about="&a;106920636"
	 b:glossaryEntry="the Titaness who was goddess of justice in ancient mythology"/>
<rdf:Description rdf:about="&a;106920749">
	<b:glossaryEntry>the Titaness who was goddess of memory in ancient mythology; mother of the Muses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106920885">
	<b:glossaryEntry>a Titaness who became identified with Artemis as goddess of the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106921006">
	<b:glossaryEntry>a Titaness and sea goddess in ancient mythology; wife of Oceanus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106921123">
	<b:glossaryEntry>(Greek mythology) a beautiful princess loved by Cupid who visited her at night and told her she must not try to see him; became the personification of the soul</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106921335">
	<b:glossaryEntry>wife or mistress of Zeus and mother of Apollo and Artemis in ancient mythology; called Latona in Roman mythology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106921507">
	<b:glossaryEntry>in Classical mythology a hero noted for his strength; performed 12 immense labors to gain immortality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106921695">
	<b:glossaryEntry>in Greek mythology: the first woman; created by Hephaestus on orders from Zeus who presented her to Epimetheus along with a box filled with evils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106921894"
	 b:glossaryEntry="a deity worshipped by the ancient Norsemen"/>
<rdf:Description rdf:about="&a;106922462"
	 b:glossaryEntry="the chief race of Norse gods living at Asgard"/>
<rdf:Description rdf:about="&a;106922559">
	<b:glossaryEntry>race of ancient Norse gods sometimes in conflict with the Aesir</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106922674">
	<b:glossaryEntry>god of light and peace and noted for his beauty and sweet nature; son of Odin and Frigg and husband of Nanna; killed by Hoth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106922859"
	 b:glossaryEntry="god of poetry and music; son of Odin"/>
<rdf:Description rdf:about="&a;106922955">
	<b:glossaryEntry>Norse goddess of old age who defeated Thor in a wrestling match</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106923069"
	 b:glossaryEntry="god of justice; son of Balder and Nanna"/>
<rdf:Description rdf:about="&a;106923162">
	<b:glossaryEntry>god of earth''s fertility and peace and prosperity; son of Njorth and brother of Freya; originally of the Vanir; later with the Aesir</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106923353">
	<b:glossaryEntry>goddess of love and fecundity; daughter of Njorth and sister of Frey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106923482"
	 b:glossaryEntry="goddess of the heavens and married love; wife of Odin"/>
<rdf:Description rdf:about="&a;106923596"
	 b:glossaryEntry="god of dawn and light; guardian of Asgard"/>
<rdf:Description rdf:about="&a;106923714"
	 b:glossaryEntry="goddess of the dead and queen of the underworld"/>
<rdf:Description rdf:about="&a;106923818">
	<b:glossaryEntry>one of the Aesir having a strong and beautiful body but a dull mind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106923938">
	<b:glossaryEntry>a blind god; misled by Loki he kills Balder by throwing a bough of mistletoe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106924088">
	<b:glossaryEntry>goddess of spring and wife of Bragi; guarded the apples that kept the gods eternally young</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106924238">
	<b:glossaryEntry>(Norse mythology) one of a race of giants often in conflict with the Aesir</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106924373">
	<b:glossaryEntry>trickster; god of discord and mischief; contrived death of Balder and was overcome by Thor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106924514"
	 b:glossaryEntry="(Norse mythology) giant who guarded the well of wisdom"/>
<rdf:Description rdf:about="&a;106924620"
	 b:glossaryEntry="wife of Balder"/>
<rdf:Description rdf:about="&a;106924686">
	<b:glossaryEntry>chief of the Vanir; god of the sea and winds and prosperity; father of Frey and Freya; sometimes subsumes Teutonic Nerthus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106924869">
	<b:glossaryEntry>any of the three Fates or goddesses of destiny; identified with Anglo-Saxon Wyrd; similar to Greek Moirae and Roman Parcae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106925096"
	 b:glossaryEntry="goddess of fate: Past"/>
<rdf:Description rdf:about="&a;106925174"
	 b:glossaryEntry="goddess of fate: Present"/>
<rdf:Description rdf:about="&a;106925265"
	 b:glossaryEntry="goddess of fate: Future"/>
<rdf:Description rdf:about="&a;106925340">
	<b:glossaryEntry>ruler of the Aesir; supreme god of war and poetry and knowledge and wisdom (for which he gave an eye) and husband of Frigg; identified with the Teutonic Wotan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106925549"
	 b:glossaryEntry="wife of Thor and guardian of the home"/>
<rdf:Description rdf:about="&a;106925636">
	<b:glossaryEntry>wife of Loki; held a cup over him during his punishment to spare him the pain of drops of poison</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106925784">
	<b:glossaryEntry>(Norse mythology) god of thunder and rain and farming; wielded the hammer Moljnir; identified with Teutonic Donar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106925948">
	<b:glossaryEntry>god of war and strife and son of Odin; identified with Anglo-Saxon Tiu</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106926075">
	<b:glossaryEntry>one of the Aesir known for his beauty and skill with bow and skis; son of Sif and stepson of Thor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106926229"
	 b:glossaryEntry="one of the Aesir and avenger of Balder; son of Odin"/>
<rdf:Description rdf:about="&a;106926331">
	<b:glossaryEntry>one of the Aesir; son of Odin; avenges his parent by slaying Fenrir at Ragnarok</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106926481">
	<b:glossaryEntry>(Norse mythology) a wonderful smith; identified with Anglo-Saxon Wayland and Teutonic Wieland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106926627">
	<b:glossaryEntry>(Norse mythology) the primeval giant slain by Odin and his brothers and from whose body they created the world: the sea from his blood; the earth from his flesh; the mountains from his bones; the sky from his skull</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106926892">
	<b:glossaryEntry>(European mythology) a supernatural smith and king of the elves; identified with Norse Volund</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106927069"
	 b:glossaryEntry="a deity worshipped by the ancient Teutons"/>
<rdf:Description rdf:about="&a;106927225"
	 b:glossaryEntry="the Teutonic god of thunder; counterpart of Norse Thor"/>
<rdf:Description rdf:about="&a;106927331">
	<b:glossaryEntry>the Teutonic goddess of fertility; later identified with Norse Njord</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106927462">
	<b:glossaryEntry>supreme Teutonic god; counterpart of Norse Odin and Anglo-Saxon Woden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106927583"
	 b:glossaryEntry="a deity worshipped by the Anglo-Saxons"/>
<rdf:Description rdf:about="&a;106927757"
	 b:glossaryEntry="god of war and sky; counterpart of Norse Tyr"/>
<rdf:Description rdf:about="&a;106927851"
	 b:glossaryEntry="chief god; counterpart of Norse Odin and Teutonic Wotan"/>
<rdf:Description rdf:about="&a;106927966"
	 b:glossaryEntry="the three Anglo-Saxon Fates or goddesses of destiny"/>
<rdf:Description rdf:about="&a;106928107"
	 b:glossaryEntry="Fate personified; one of the Three Weird Sisters"/>
<rdf:Description rdf:about="&a;106928214">
	<b:glossaryEntry>(Old Testament) in Judeo-Christian mythology; the first man and progenitor of the human race</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106928357">
	<b:glossaryEntry>(Old Testament) Adam''s wife in Judeo-Christian mythology: the first woman and mother of the human race; God created Eve from Adam''s rib and placed Adam and Even in the Garden of Eden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106928589">
	<b:glossaryEntry>Cain and Abel were the first children of Adam and Eve born after the Fall of Man; Cain killed Abel out of jealousy and was exiled by God</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106928776">
	<b:glossaryEntry>Cain and Abel were the first children of Adam and Eve born after the Fall of Man; Abel was killed by Cain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106928932">
	<b:glossaryEntry>an imaginary person represented in a work of fiction (play or film or story); "she is the main character in the novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106929817">
	<b:glossaryEntry>a mythical Greek hero; a warrior who fought against Troy in Homer''s Iliad</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106929941">
	<b:glossaryEntry>in the Arabian Nights a boy who acquires a magic lamp from which he can summon a genie</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106930081">
	<b:glossaryEntry>(classical mythology) one of the heroes who sailed with Jason on the Argo in search of the Golden Fleece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106930240">
	<b:glossaryEntry>an imaginary elephant that appears in a series of French books for children</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106930367">
	<b:glossaryEntry>a woman who guided Dante through Paradise in The Divine Comedy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106930484">
	<b:glossaryEntry>(fairy tale) a monstrous villain who marries seven women; he kills the first six for disobedience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106930637">
	<b:glossaryEntry>(Norse mythology) a Valkyrie who loved the hero Siegfried; when he deceived her she had him killed and then committed suicide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106930841">
	<b:glossaryEntry>(Norse mythology) one of the maidens of Odin who chose heroes to be slain in battle and conducted them to Valhalla</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106931028">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a legendary giant lumberjack of the north woods of US and Canada; had a blue ox named Babe; "the lakes of Minnesota began when Paul Bunyan and Babe''s footprints filled with water"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106931292">
	<b:glossaryEntry>hero of American folk tales; portrayed as an enormously strong black man who worked on the railroads and died from exhaustion after winning a contest with a steam drill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106931517">
	<b:glossaryEntry>a young girl who is saved from her stepmother and stepsisters by her fairy godmother and a handsome prince</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106931680">
	<b:glossaryEntry>(Greek mythology) the husband of Medea and leader of the Argonauts who sailed in quest of the Golden Fleece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106931839">
	<b:glossaryEntry>(Greek mythology) a princess of Colchis who aided Jason in taking the Golden Fleece from her father</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106931990">
	<b:glossaryEntry>a mythical Greek hero (Roman name Ulysses); his return to Ithaca after the siege of Troy was described in Homer''s Odyssey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106932176">
	<b:glossaryEntry>(Greek mythology) the wife of Odysseus and a symbol of devotion and fidelity; for 10 years while Odysseus fought the Trojan War she resisted numerous suitors until Odysseus returned and killed them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106932428">
	<b:glossaryEntry>(Greek mythology) a hero noted for his many great deeds: killed Procrustes and the Minotaur and defeated the Amazons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106932598">
	<b:glossaryEntry>(Greek mythology) a wicked king and son of Zeus; condemned in Hades to stand in water that receded when he tried to drink and beneath fruit that receded when he reached for it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106932828"
	 b:glossaryEntry="deity of the ancient Phrygians of west central Asia Minor"/>
<rdf:Description rdf:about="&a;106932964">
	<b:glossaryEntry>great nature goddess of ancient Phrygia in Asia Minor; counterpart of Greek Rhea and Roman Ops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106933168">
	<b:glossaryEntry>a citizen of Liliput (the imaginary country in Gulliver''s Travels)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106933291">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a mythical Greek hero of Homer''s Iliad; a foremost Greek warrior at the siege of Troy; when he was a baby his mother tried to make him immortal by bathing him in a magical river but the heel by which she held him remained vulnerable--his "Achilles'' heel"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106933600">
	<b:glossaryEntry>a mythical Greek warrior who was a leader on the Trojan side of the Trojan War; hero of Virgil''s Aeneid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106933756">
	<b:glossaryEntry>(classical mythology) the king who lead the Greeks against Troy in the Trojan War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106933893">
	<b:glossaryEntry>(classical mythology) a prophetess in Troy during the Trojan War whose predictions were true but were never believed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106934065">
	<b:glossaryEntry>(Greek mythology) the daughter of King Oedipus who disobeyed her father and was condemned to death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106934218">
	<b:glossaryEntry>(Greek mythology) the daughter of Agamemnon and Clytemnestra; persuaded her brother (Orestes) to avenge Agamemnon''s death by helping her to kill Clytemnestra and her lover</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106934443">
	<b:glossaryEntry>(Greek mythology) the priest of Apollo who warned the Trojans to beware of Greeks bearing gifts when they wanted to accept the Trojan Horse; a god who favored the Greeks (Poseidon or Athena) sent snakes who coiled around Laocoon and his two twin sons killing them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106934760">
	<b:glossaryEntry>(Greek mythology) a member of the warriors who followed Achilles on the expedition against Troy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106934910">
	<b:glossaryEntry>(Greek mythology) a tragic king who unknowingly killed his father and married his mother; the subject of the drama Oedipus Rex by Sophocles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106935118">
	<b:glossaryEntry>(Greek mythology) the blind prophet of Thebes who revealed to Oedipus that Oedipus had murdered his father and married his mother</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106935302"
	 b:glossaryEntry="a king of the Myrmidons and father of Achilles"/>
<rdf:Description rdf:about="&a;106935401">
	<b:glossaryEntry>the hero of a romance by Cervantes; chivalrous but impractical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106935521"
	 b:glossaryEntry="the hero of a Spanish epic poem from the 12th century"/>
<rdf:Description rdf:about="&a;106935627">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a villainous Jew in Charles Dickens'' novel "Oliver Twist"; Fagin was a fence who trained boys as pickpockets]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106935787"
	 b:glossaryEntry="a dissolute character in Shakespeare''s plays"/>
<rdf:Description rdf:about="&a;106935906">
	<b:glossaryEntry>an alchemist of German legend who sol his soul to the devil in exchange for knowledge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106936053">
	<b:glossaryEntry>a fictional Englishman who travels to the imaginary land of Lilliput (in Jonathan Swift''s Gulliver''s Travels)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106936217">
	<b:glossaryEntry>(Greek mythology) a mythical Trojan who has killed by Achilles during the Trojan War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106936354">
	<b:glossaryEntry>(Greek mythology) the beautiful daughter of Zeus and Leda who was abducted by Paris; the Greek army sailed to Troy to get her back which resulted in the Trojan War</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106936585">
	<b:glossaryEntry>(Greek mythology) a queen of Sparta who was raped by Zeus who had taken the form of a swan; Helen of Troy was conceived in the rape of Leda</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106936775">
	<b:glossaryEntry>a 6-inch tall inhabitant of Lilliput in Swift''s Gulliver''s Travels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106936899"
	 b:glossaryEntry="the imaginary author of a collection of nursery rhymes"/>
<rdf:Description rdf:about="&a;106937012"
	 b:glossaryEntry='an incurable optimist in "Candide" (a satire by Voltaire)'/>
<rdf:Description rdf:about="&a;106937124">
	<b:glossaryEntry>a character in the commedia dell''arte; portrayed as a foolish old man</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106937249"
	 b:glossaryEntry="a buffoon in modern pantomimes; the butt of jokes"/>
<rdf:Description rdf:about="&a;106937354">
	<b:glossaryEntry>a male character in French pantomime; usually dressed in white with a whitened face</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106937491"
	 b:glossaryEntry="a mischievous boy in a novel by Mark Twain"/>
<rdf:Description rdf:about="&a;106937596">
	<b:glossaryEntry>a man raised by apes who was the hero of a series of novels by Edgar Rice Burroughs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106937753"
	 b:glossaryEntry="the boy hero of a novel by Mark Twain"/>
<rdf:Description rdf:about="&a;106937847">
	<b:glossaryEntry>a servile black character in a novel by Harriet Beecher Stowe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106937964"
	 b:glossaryEntry="a personification of the US government"/>
<rdf:Description rdf:about="&a;106938058"
	 b:glossaryEntry="a fictitious detective in stories by A. Conan Doyle"/>
<rdf:Description rdf:about="&a;106938180">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a person considered as a unique individual; "one''s own self"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106938309">
	<b:glossaryEntry>(informal) a reference to yourself or myself etc.; "take care of number one" means to put your own interests first</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106938480"
	 b:glossaryEntry="a fully developed person from maturity onward"/>
<rdf:Description rdf:about="&a;106939020"
	 b:glossaryEntry="a person who enjoys taking risks"/>
<rdf:Description rdf:about="&a;106939289"
	 b:glossaryEntry="someone who has a special interest in exceptional cases"/>
<rdf:Description rdf:about="&a;106939400"
	 b:glossaryEntry="a person who is unusual"/>
<rdf:Description rdf:about="&a;106939710">
	<b:glossaryEntry>a person who seems to be displaced in time; who belongs to another age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106939838">
	<b:glossaryEntry>a habitual liar (after a New Testament character who was struck dead for lying)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106939971"
	 b:glossaryEntry="a Parisian gangster"/>
<rdf:Description rdf:about="&a;106940043">
	<b:glossaryEntry>a person who requests or seeks something such as assistance or employment or admission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106940339"
	 b:glossaryEntry="a person who is appointed to a job or position"/>
<rdf:Description rdf:about="&a;106940455">
	<b:glossaryEntry>someone who is considered for something (for an office or prize or honor etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106940600">
	<b:glossaryEntry>someone engaged in a dangerous but potentially rewarding adventure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106940721"
	 b:glossaryEntry="a person who is present"/>
<rdf:Description rdf:about="&a;106940836"
	 b:glossaryEntry="an agent who conducts an auction"/>
<rdf:Description rdf:about="&a;106940925"
	 b:glossaryEntry="a person who does harm to others"/>
<rdf:Description rdf:about="&a;106941176"
	 b:glossaryEntry="a psychologist who subscribes to behaviorism"/>
<rdf:Description rdf:about="&a;106941293"
	 b:glossaryEntry="a person who helps people or institutions"/>
<rdf:Description rdf:about="&a;106941598"
	 b:glossaryEntry="a woman benefactor"/>
<rdf:Description rdf:about="&a;106941675">
	<b:glossaryEntry>a person who invests capital in a business (especially a large business)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106941930"
	 b:glossaryEntry="a person who captures and holds people or animals"/>
<rdf:Description rdf:about="&a;106942068"
	 b:glossaryEntry="one of a group of founders"/>
<rdf:Description rdf:about="&a;106942150"
	 b:glossaryEntry="a person who holds no title"/>
<rdf:Description rdf:about="&a;106942405"
	 b:glossaryEntry="a person who communicates with others"/>
<rdf:Description rdf:about="&a;106943041">
	<b:glossaryEntry>someone appointed by a court to assume responsibility for the interests of a minor or incompetent person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106943203">
	<b:glossaryEntry>a member of a constituency; a citizen who is represented in a government by officials for whom he or she votes; "needs continued support by constituents to be re-elected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106943450"
	 b:glossaryEntry="a composer who specializes in counterpoint"/>
<rdf:Description rdf:about="&a;106943570">
	<b:glossaryEntry>an investor who deliberately decides to go against the prevailing wisdom of other investors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106943718"
	 b:glossaryEntry="a person who uses goods or services"/>
<rdf:Description rdf:about="&a;106943970"
	 b:glossaryEntry="an Italian farmer"/>
<rdf:Description rdf:about="&a;106944043"
	 b:glossaryEntry="a person who participates in competitions"/>
<rdf:Description rdf:about="&a;106944339">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a an eccentric or undignified rustic; "I''ll be a gone coon when the battle starts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106944472"
	 b:glossaryEntry="one of two people or more who sign the same document"/>
<rdf:Description rdf:about="&a;106944593"
	 b:glossaryEntry="a person who shows fear or timidity"/>
<rdf:Description rdf:about="&a;106944789"
	 b:glossaryEntry="a person who grows or makes or invents things"/>
<rdf:Description rdf:about="&a;106945104"
	 b:glossaryEntry="a person who cares for persons or property"/>
<rdf:Description rdf:about="&a;106945440"
	 b:glossaryEntry="a person who disputes; who is good at or enjoys controversy"/>
<rdf:Description rdf:about="&a;106945718">
	<b:glossaryEntry>a person who uses scientific knowledge to solve practical problems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106946108"
	 b:glossaryEntry="a specialist in wine making"/>
<rdf:Description rdf:about="&a;106946221">
	<b:glossaryEntry>a person who holds a commissioned rank in the US Navy or Coast Guard; below lieutenant junior grade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106946373"
	 b:glossaryEntry="a person who tries to please or amuse"/>
<rdf:Description rdf:about="&a;106946576"
	 b:glossaryEntry="an orator who delivers eulogies or panegyrics"/>
<rdf:Description rdf:about="&a;106946689">
	<b:glossaryEntry>a worker who excavates for foundations of buildings or for quarrying</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106946813"
	 b:glossaryEntry="a former gambler"/>
<rdf:Description rdf:about="&a;106946886"
	 b:glossaryEntry="a former mayor"/>
<rdf:Description rdf:about="&a;106946955"
	 b:glossaryEntry="a research worker who conducts experiments"/>
<rdf:Description rdf:about="&a;106947056"
	 b:glossaryEntry="a person who performs skillfully"/>
<rdf:Description rdf:about="&a;106947753"
	 b:glossaryEntry="a former president"/>
<rdf:Description rdf:about="&a;106947830">
	<b:glossaryEntry>an expert whose views are taken as definitive; "he is an authority on corporate law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106948078">
	<b:glossaryEntry>(synecdoche) a part of a person is used to refer to a person; "he looked out at a roomful of faces"; "when he returned to work he met many new faces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106948278"
	 b:glossaryEntry="a person who belongs to the sex that can have babies"/>
<rdf:Description rdf:about="&a;106948508"
	 b:glossaryEntry="a garmentmaker who performs the finishing steps"/>
<rdf:Description rdf:about="&a;106948621"
	 b:glossaryEntry="a person who is good to other people"/>
<rdf:Description rdf:about="&a;106948859"
	 b:glossaryEntry="a person who pursues independent thought or action"/>
<rdf:Description rdf:about="&a;106949059"
	 b:glossaryEntry="a person who lives in a particular place"/>
<rdf:Description rdf:about="&a;106949518"
	 b:glossaryEntry="a person who was born in a particular place"/>
<rdf:Description rdf:about="&a;106949722"
	 b:glossaryEntry="a person who lacks knowledge of evil"/>
<rdf:Description rdf:about="&a;106949872"
	 b:glossaryEntry="a person who uses the mind creatively"/>
<rdf:Description rdf:about="&a;106950430"
	 b:glossaryEntry="a youthful person"/>
<rdf:Description rdf:about="&a;106950629"
	 b:glossaryEntry="a person who loves or is loved"/>
<rdf:Description rdf:about="&a;106950891"
	 b:glossaryEntry="a person who rules or guides or inspires others"/>
<rdf:Description rdf:about="&a;106951621"
	 b:glossaryEntry="a person who belongs to the sex that cannot have babies"/>
<rdf:Description rdf:about="&a;106951922"
	 b:glossaryEntry="a negotiator who acts as a link between parties"/>
<rdf:Description rdf:about="&a;106952194"
	 b:glossaryEntry="a person who receives, invests or pays out money"/>
<rdf:Description rdf:about="&a;106952425"
	 b:glossaryEntry="a therapist who practices naprapathy"/>
<rdf:Description rdf:about="&a;106952517">
	<b:glossaryEntry>a person who owes allegiance to that nation; "a monarch has a duty to his subjects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106952738"
	 b:glossaryEntry="a philosopher who subscribes to nativism"/>
<rdf:Description rdf:about="&a;106952833"
	 b:glossaryEntry="a person who does not manifest devotion to a deity"/>
<rdf:Description rdf:about="&a;106953093"
	 b:glossaryEntry="a person who does nothing"/>
<rdf:Description rdf:about="&a;106953318"
	 b:glossaryEntry="a person who is of equal standing with another in a group"/>
<rdf:Description rdf:about="&a;106953561"
	 b:glossaryEntry="a person who becomes aware of through the senses"/>
<rdf:Description rdf:about="&a;106953813"
	 b:glossaryEntry="a person who goes before or announces the coming of another"/>
<rdf:Description rdf:about="&a;106953959"
	 b:glossaryEntry="a person who belongs to early stage of civilization"/>
<rdf:Description rdf:about="&a;106954283"
	 b:glossaryEntry="the winner of a lottery"/>
<rdf:Description rdf:about="&a;106954382"
	 b:glossaryEntry="a person who gets something"/>
<rdf:Description rdf:about="&a;106954710"
	 b:glossaryEntry="a person who manifests devotion to a deity"/>
<rdf:Description rdf:about="&a;106955207"
	 b:glossaryEntry="a person who enjoys sensuality"/>
<rdf:Description rdf:about="&a;106955402">
	<b:glossaryEntry>someone who sells tickets (e.g., theater seats or travel accommodations)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106955549"
	 b:glossaryEntry="a person who changes location"/>
<rdf:Description rdf:about="&a;106956167"
	 b:glossaryEntry="a person who suffers misfortune"/>
<rdf:Description rdf:about="&a;106956583"
	 b:glossaryEntry="a person who for some reason is not wanted or welcome"/>
<rdf:Description rdf:about="&a;106956899"
	 b:glossaryEntry="a person who is not pleasant or agreeable"/>
<rdf:Description rdf:about="&a;106957548"
	 b:glossaryEntry="a person who lacks technical training"/>
<rdf:Description rdf:about="&a;106957738"
	 b:glossaryEntry='a person who works at a specific job; "he is a good worker"'/>
<rdf:Description rdf:about="&a;106958552"
	 b:glossaryEntry="a person who transgresses moral or civil law"/>
<rdf:Description rdf:about="&a;106958987"
	 b:glossaryEntry="a native or inhabitant of Africa"/>
<rdf:Description rdf:about="&a;106959973"
	 b:glossaryEntry="an African who is Black"/>
<rdf:Description rdf:about="&a;106960074">
	<b:glossaryEntry>a white native of Cape Province who is a descendant of Dutch settlers and who speaks Afrikaans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106960244">
	<b:glossaryEntry>a member of the prehistoric people who spoke Proto-Indo_European</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106960376">
	<b:glossaryEntry>(according to Nazi doctrine) a non-Jewish Caucasian person of Nordic descent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106960504"
	 b:glossaryEntry="(formal) any non-European non-White person"/>
<rdf:Description rdf:about="&a;106960662">
	<b:glossaryEntry>a person with dark skin who comes from Africa (or whose ancestors came from Africa)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106961006"
	 b:glossaryEntry="a Black woman or girl"/>
<rdf:Description rdf:about="&a;106961081"
	 b:glossaryEntry="a dark-skinned race"/>
<rdf:Description rdf:about="&a;106961204"
	 b:glossaryEntry="an American whose ancestors were born in Africa"/>
<rdf:Description rdf:about="&a;106961330"
	 b:glossaryEntry="a man who is Black"/>
<rdf:Description rdf:about="&a;106961422"
	 b:glossaryEntry="a woman who is Black"/>
<rdf:Description rdf:about="&a;106961518"
	 b:glossaryEntry="a US term for Blacks that is now considered offensive"/>
<rdf:Description rdf:about="&a;106961642"
	 b:glossaryEntry="offensive term for Black people"/>
<rdf:Description rdf:about="&a;106961743"
	 b:glossaryEntry='offensive term for Black man; "get out of my way boy"'/>
<rdf:Description rdf:about="&a;106961846"
	 b:glossaryEntry="ethnic slur; offensive name for Black person"/>
<rdf:Description rdf:about="&a;106961994">
	<b:glossaryEntry>contemptuous name for a Black man who is abjectly servile and deferential to Whites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106962139"
	 b:glossaryEntry="an offspring of a Black and a White parent"/>
<rdf:Description rdf:about="&a;106962235">
	<b:glossaryEntry>an offspring of a Mulatto and a White parent; a person who is one-quarter Black</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106962369">
	<b:glossaryEntry>an offspring of a Quadroon and a White parent; a person who is one-eighth Black</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106962503"
	 b:glossaryEntry="a member of the Caucasoid race"/>
<rdf:Description rdf:about="&a;106962829"
	 b:glossaryEntry="a light-skinned race"/>
<rdf:Description rdf:about="&a;106962959">
	<b:glossaryEntry>a member of a Caucasian people living in the Caucasus but not speaking an Indo-European language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106963131">
	<b:glossaryEntry>a derogatory term for a white person (said to have been used by North American Indians)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106963273">
	<b:glossaryEntry>a member of a group of Semitic-speaking peoples of the Near East and N Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106963475"
	 b:glossaryEntry="an inhabitant of ancient Babylon"/>
<rdf:Description rdf:about="&a;106963582"
	 b:glossaryEntry="an inhabitant of ancient Assyria"/>
<rdf:Description rdf:about="&a;106963669">
	<b:glossaryEntry>a member of an ancient people who ruled Babylonia between 1600 and 1200 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106963807">
	<b:glossaryEntry>a member of an ancient people living E of Babylonia as early as 4000 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106963932">
	<b:glossaryEntry>a member of an ancient Semitic people who dominated trade in the first millennium B.C.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106964076"
	 b:glossaryEntry="a man who is White"/>
<rdf:Description rdf:about="&a;106964186"
	 b:glossaryEntry="a woman who is White"/>
<rdf:Description rdf:about="&a;106964282"
	 b:glossaryEntry="an offensive term for White people who are impoverished"/>
<rdf:Description rdf:about="&a;106964427"
	 b:glossaryEntry="offensive name for White person"/>
<rdf:Description rdf:about="&a;106964519"
	 b:glossaryEntry="a White Protestant of Anglo-Saxon ancestry"/>
<rdf:Description rdf:about="&a;106964661"
	 b:glossaryEntry="a native or inhabitant of Asia"/>
<rdf:Description rdf:about="&a;106965455"
	 b:glossaryEntry="an offensive name for an unskilled Asian laborer"/>
<rdf:Description rdf:about="&a;106965564"
	 b:glossaryEntry="a member of an Oriental race"/>
<rdf:Description rdf:about="&a;106965774"
	 b:glossaryEntry="an Asian race"/>
<rdf:Description rdf:about="&a;106965898"
	 b:glossaryEntry="offensive term for an Oriental man"/>
<rdf:Description rdf:about="&a;106966007"
	 b:glossaryEntry="offensive term for an Oriental woman"/>
<rdf:Description rdf:about="&a;106966120">
	<b:glossaryEntry>a disparaging term for an Asian person (especially for North Vietnamese soldiers in the Vietnam War)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106966283">
	<b:glossaryEntry>a member of the people inhabiting an area of northern Mongolia and eastern Siberia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106966427"
	 b:glossaryEntry="a member of the nomadic peoples of Mongolia"/>
<rdf:Description rdf:about="&a;106966571">
	<b:glossaryEntry>a member of the Turkic-speaking people living from the Volga to the Ural Mountains (the name has been attributed to many other groups)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106966757">
	<b:glossaryEntry>a member of the Finno-Ugric-speaking people living in eastern European Russia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106966896">
	<b:glossaryEntry>a member of the Mongolian people of central Asia who invaded Russia in the 13th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106967059">
	<b:glossaryEntry>any member of the peoples living in North or South America before the Europeans arrived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106967275">
	<b:glossaryEntry>a member of the race of people living in North America when Europeans arrived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106967875"
	 b:glossaryEntry="a North American Indian warrior"/>
<rdf:Description rdf:about="&a;106967958"
	 b:glossaryEntry="a member of the Algonquian people of Maine and S Quebec"/>
<rdf:Description rdf:about="&a;106968066">
	<b:glossaryEntry>a member of the North American Indian people of the Pit river valley in N California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106968205">
	<b:glossaryEntry>a member of a North American Indian people living in Baja California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106968328">
	<b:glossaryEntry>a member of the Muskhogean people formerly living in Alabama; a member of the Creek Confederacy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106968496">
	<b:glossaryEntry>a member of a North American Indian people in the Ottawa river valley of Ontario and Quebec</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106968654">
	<b:glossaryEntry>a member of any of the North American Indian groups speaking an Algonquian language and originally living in the subarctic regions of E Canada; many Algonquian tribes migrated south into the woodlands from the Mississippi River to the Atlantic coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106969458">
	<b:glossaryEntry>a member of an Indian people formerly living along the Gulf coast of Louisiana and Texas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106969612">
	<b:glossaryEntry>a member of any of the North American Indian groups speaking an Athapaskan language and living in the subarctic regions of western Canada and central Alaska</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106969954"
	 b:glossaryEntry="usually included in the Mongoloid race"/>
<rdf:Description rdf:about="&a;106970087">
	<b:glossaryEntry>a member of an American Indian people of Yucatan and Belize and Guatemala who once had a culture characterized by outstanding architecture and pottery and astronomy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106970419"
	 b:glossaryEntry="a member of any of various Indian peoples of central Mexico"/>
<rdf:Description rdf:about="&a;106970569">
	<b:glossaryEntry>a member of the Nahuatl people who established an empire in Mexico that was overthrown by Cortes in 1519</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106970725">
	<b:glossaryEntry>a member of one of the tribes of American Indians who lived a nomadic life following the buffalo in the Great Plains of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106971097">
	<b:glossaryEntry>any member of Athapaskan tribes that migrated to the SW desert (from Arizona to Texas and south into Mexico); fought a losing battle from 1861 to 1886 with the US and were resettled in Oklahoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106971343">
	<b:glossaryEntry>a member of a North American Plains people (now living in Oklahoma and Wyoming)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106971505">
	<b:glossaryEntry>a member of the Caddo people who formerly lived in the Dakotas west of the Missouri river</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106971658">
	<b:glossaryEntry>a member of the North American Indian people of the Pit river valley in N California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106971797">
	<b:glossaryEntry>a member of the Siouan people of the lower Pascagoula river valley in Mississippi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106971931">
	<b:glossaryEntry>a member of a warlike group of Algonquians living in the NW plains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106972071">
	<b:glossaryEntry>a group of Plains Indians formerly living in what is now North and South Dakota and Nebraska and Kansas and Arkansas and Louisiana and Oklahoma and Texas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106972366">
	<b:glossaryEntry>a member of the Mayan people living in south central Guatemala</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106972485">
	<b:glossaryEntry>a member of the Siouan people formerly living in the Carolinas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106972601">
	<b:glossaryEntry>a member of an Iroquoian people formerly living around Cayuga Lake in New York state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106972738">
	<b:glossaryEntry>a member of an Iroquoian people formerly living in the Appalachian Mountains but now chiefly in Oklahoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106972897">
	<b:glossaryEntry>a member of a North American Indian people living on the western plains (now living in Oklahoma and Montana)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106973078">
	<b:glossaryEntry>a member of the Muskhogean people formerly living in N Mississippi</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106973200"
	 b:glossaryEntry="a member of the Salishan people living in NW Washington"/>
<rdf:Description rdf:about="&a;106973310">
	<b:glossaryEntry>a member of an extinct North American Indian people formerly living in California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106973447">
	<b:glossaryEntry>a member of an important North American Indian people who controlled the mouth of the Columbia river; they were organized into settlements rather than tribes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106973658">
	<b:glossaryEntry>a member of the Athapaskan people living in western Canada between Great Slave Lake and Hudson Bay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106973812"
	 b:glossaryEntry="a member of the Muskhogean people formerly living in Alabama"/>
<rdf:Description rdf:about="&a;106973926">
	<b:glossaryEntry>a member of a North American Indian people living in central Baja California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106974056">
	<b:glossaryEntry>a member of a North American Indian people living around the mouth of the Colorado river</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106974207">
	<b:glossaryEntry>a member of the Shoshonean people who formerly lived between Wyoming and the Mexican border but are now chiefly in Oklahoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106974385">
	<b:glossaryEntry>a member of an Algonquian people formerly living in Maryland between Chesapeake Bay and the Potomac river; allies of the Nanticoke people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106974574">
	<b:glossaryEntry>a member of a North American Indian people living in coastal California between Monterey and San Francisco Bay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106974740"
	 b:glossaryEntry="a member of an Algonquian people living in central Canada"/>
<rdf:Description rdf:about="&a;106974848">
	<b:glossaryEntry>any member of the Creek Confederacy of Muskhogean peoples (especially the Muskogee) formerly living in Georgia and Alabama but now chiefly in Oklahoma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106975050"
	 b:glossaryEntry="a member of the Siouan people formerly living in E Montana"/>
<rdf:Description rdf:about="&a;106975159">
	<b:glossaryEntry>a member of the Siouan people of the N Mississippi valley; commonly called the Sioux</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106975296">
	<b:glossaryEntry>a member of an Algonquian people formerly living in New Jersey and New York and parts of Delaware and Pennsylvania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106975465">
	<b:glossaryEntry>any member of a Siouan people speaking one of the Dhegiha languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106975676"
	 b:glossaryEntry="a member of a North American Indian people of S California"/>
<rdf:Description rdf:about="&a;106975789">
	<b:glossaryEntry>a member of a North American Indian people living on the California coast near Monterey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106975930"
	 b:glossaryEntry="a member of the Caddo people of NE Texas"/>
<rdf:Description rdf:about="&a;106976023">
	<b:glossaryEntry>a member of an Algonquian people formerly living W of Lake Michigan along the Fox River</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106976160">
	<b:glossaryEntry>a member of a seafaring group of North American Indians who lived on the Pacific coast of British Columbia and SW Alaska</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106976332">
	<b:glossaryEntry>a member of a North American Indian people of the Colorado river valley near the mouth of the Gila river; allied to the Maricopa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106976518">
	<b:glossaryEntry>a member of a North American Indian people of Cataract Canyon (a tributary of the Grand Canyon) in Arizona</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106976680">
	<b:glossaryEntry>a member of the Sioux people formerly inhabiting an area along the Missouri river in W North Dakota</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106976847">
	<b:glossaryEntry>a member of the Muskhogean people formerly living in Georgia; a member of the Creek Confederacy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106977016"
	 b:glossaryEntry="a member of the Shoshonean people of NE Arizona"/>
<rdf:Description rdf:about="&a;106977114">
	<b:glossaryEntry>a member of a North American Indian people speaking one of the Hokan language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106977646">
	<b:glossaryEntry>a member of the Siouan people formerly living in the western Dakotas; the were prominent in resisting the white encroachment into the N Great Plains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106977867">
	<b:glossaryEntry>a member of the Athapaskan people of the Trinity River valley in California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106977993">
	<b:glossaryEntry>a member of the Algonquian people formerly of Illinois and regions to the west</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106978126">
	<b:glossaryEntry>a member of the Siouan people formerly living in Iowa and Minnesota and Missouri</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106978265">
	<b:glossaryEntry>any member of the warlike North American Indian peoples formerly living in New York state; the League of Iroquois (or Five Nations) were allies of the British during the American Revolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106978635">
	<b:glossaryEntry>a member of the North American Indian people of the Wilamette basin in Oregon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106978802">
	<b:glossaryEntry>a member of a North American Indian people of SE California and NW Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106978927">
