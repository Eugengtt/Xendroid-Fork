	 b:glossaryEntry="lettuce with long dark-green spoon-shaped leaves"/>
<rdf:Description rdf:about="&a;108294398">
	<b:glossaryEntry>distinguished by leaves arranged in a dense rosette that develop into a compact ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108294624">
