</rdf:Description>
<rdf:Description rdf:about="&a;109147111"
	 b:glossaryEntry="used chiefly in liqueurs"/>
<rdf:Description rdf:about="&a;109147211"
	 b:glossaryEntry="genus of Old World herbs: dead nettles; henbits"/>
<rdf:Description rdf:about="&a;109147402">
