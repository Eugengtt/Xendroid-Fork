	 b:glossaryEntry="unarmed feather palms of central and northern South America"/>
<rdf:Description rdf:about="&a;108885385">
	<b:glossaryEntry>Brazilian palm yielding fibers used in making ropes, mats, and brushes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108885621">
	<b:glossaryEntry>nut having a hard hazel-brown shell used like vegetable ivory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108885760"
	 b:glossaryEntry="palmyra"/>
<rdf:Description rdf:about="&a;108885877">
	<b:glossaryEntry>tall fan palm of Africa and India and Malaysia yielding a hard wood and sweet sap that is a source of palm wine and sugar; leaves used for thatching and weaving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108886215">
	<b:glossaryEntry>coarse leaf fiber from palmyra palms used in making brushes and brooms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108886358">
	<b:glossaryEntry>distinctive often spiny-stemmed palms found as climbers in tropical and subtropical forest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108886546">
	<b:glossaryEntry>any tropical Asian palm of the genus Calamus; light tough stems are a source of rattan canes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108886747">
	<b:glossaryEntry>climbing palm of Sri Lanka and southern India remarkable for the great length of the stems which are used for Malacca canes</b:glossaryEntry>
</rdf:Description>
