<rdf:Description rdf:about="&a;100550869"
	 b:glossaryEntry="a short sleep (usually not in bed)"/>
<rdf:Description rdf:about="&a;100551029"
	 b:glossaryEntry="a nap in the early afternoon (especially in hot countries)"/>
<rdf:Description rdf:about="&a;100551140"
	 b:glossaryEntry="a light fitful sleep"/>
<rdf:Description rdf:about="&a;100551220">
	<b:glossaryEntry>a bodily process occurring due to the effect of some foregoing stimulus or agent; "a bad reaction to the medicine"; "his responses have slowed with age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100551654">
	<b:glossaryEntry>any reaction that occurs automatically without conscious thought or reflection (especially the undirected behavior seen in psychomotor epilepsy)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100551855">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a reaction to a crisis or setback or frustration; "he is still on the rebound from his wife''s death"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100552009"
	 b:glossaryEntry="an excessive reaction"/>
<rdf:Description rdf:about="&a;100552089">
	<b:glossaryEntry>a bodily defense reaction that recognizes an invading substance (an antigen: such as a virus or fungus or bacteria or transplanted organ) and produces antibodies specific against that antigen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100552474">
	<b:glossaryEntry>renewed rapid production of an antibody on the second (or subsequent) encounter with the same antigen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100552663">
	<b:glossaryEntry>an immune response (chiefly against bacterial invasion) that is mediated by B cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100552816">
	<b:glossaryEntry>an immune response (chiefly against viral or fungal invasions or transplanted tissue) that involves T cells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100552999">
	<b:glossaryEntry>an immune response in which an antigen-antibody combination inactivates a complement (so it is unavailable to participate in a second antigen-antibody combination)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100553228">
	<b:glossaryEntry>an involuntary orienting response; positive or negative reaction to a stimulus source</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100553493"
	 b:glossaryEntry="an affinity for work"/>
<rdf:Description rdf:about="&a;100553571"
	 b:glossaryEntry="an orienting response to gravity"/>
<rdf:Description rdf:about="&a;100553660"
	 b:glossaryEntry="an orienting response to the sun"/>
<rdf:Description rdf:about="&a;100553751">
	<b:glossaryEntry>an effect of climate on biological processes (as the effect on joint pains etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100553891"
	 b:glossaryEntry="an affinity for neural tissues"/>
<rdf:Description rdf:about="&a;100553980"
	 b:glossaryEntry="an orienting response to light"/>
<rdf:Description rdf:about="&a;100554069"
	 b:glossaryEntry="an orienting response to food"/>
<rdf:Description rdf:about="&a;100554158">
	<b:glossaryEntry>a locomotor response toward or away from an external stimulus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100554289">
	<b:glossaryEntry>movement by a cell or organism in reaction to a chemical stimulus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100554447"
	 b:glossaryEntry="movement away from a chemical stimulus"/>
<rdf:Description rdf:about="&a;100554551"
	 b:glossaryEntry="movement toward a chemical stimulus"/>
<rdf:Description rdf:about="&a;100554652">
	<b:glossaryEntry>a movement that is a response to a stimulus but is not oriented with respect to the source of stimulation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100554811"
	 b:glossaryEntry="a delayed reaction indicating surprise"/>
<rdf:Description rdf:about="&a;100554907"
	 b:glossaryEntry="an automatic reaction"/>
<rdf:Description rdf:about="&a;100555258">
	<b:glossaryEntry>an acquired response that is under the control of (conditional on the occurrence of) a stimulus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100555567"
	 b:glossaryEntry="a reaction that has been acquired by learning"/>
<rdf:Description rdf:about="&a;100555712">
	<b:glossaryEntry>a conditioned response that anticipates the occurrence of an aversive stimulus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100555891">
	<b:glossaryEntry>a quick reflex inspiration suddenly checked by closure of the glottis producing an audible sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100556063"
	 b:glossaryEntry='a sudden involuntary movement: "he awoke with a start"'/>
<rdf:Description rdf:about="&a;100556240">
	<b:glossaryEntry>a complicated involuntary reaction to a sudden unexpected stimulus (especially a loud noise); involves flexion of most skeletal muscles and a variety of visceral reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100556493">
	<b:glossaryEntry>a normal reflex of young infants; a sudden loud noise causes the child to stretch out the arms and flex the legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100556680"
	 b:glossaryEntry="a reflex response to sudden pain"/>
<rdf:Description rdf:about="&a;100556773">
	<b:glossaryEntry>a bodily process of passing from one place or stage to another; "the passage of air from the lungs"; "the passing of flatus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100556961">
	<b:glossaryEntry>flexion of the toes when the sole of the foot is stroked firmly on the outer side from the heel to the front in persons over the age of 2 years; under 2 years the results should be extension of the toes (Babinski reflex)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100557242">
	<b:glossaryEntry>a reflex extension of the leg resulting from a sharp tap on the patellar tendon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100557414">
	<b:glossaryEntry>reflex behavior in newborn mammals; includes finding and grasping the nipple in the mouth and sucking on it and swallowing the milk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100557607"
	 b:glossaryEntry="reflex shaking caused by cold or fear or excitement"/>
<rdf:Description rdf:about="&a;100557729">
	<b:glossaryEntry>the process of shedding tears (usually accompanied by sobs or other inarticulate sounds); "I hate to hear a child crying"; "she was in tears"</b:glossaryEntry>
