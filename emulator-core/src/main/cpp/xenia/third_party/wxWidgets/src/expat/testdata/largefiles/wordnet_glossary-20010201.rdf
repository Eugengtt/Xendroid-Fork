	 b:glossaryEntry="genus of Australian shrubs or subshrubs: coral bush"/>
<rdf:Description rdf:about="&a;108872561">
	<b:glossaryEntry>Australian shrub having simple obovate leaves and brilliant scarlet flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108872746">
	<b:glossaryEntry>genus of tropical and subtropical herbs or shrubs: hoary peas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108872919">
