<rdf:Description rdf:about="&a;200280512">
	<b:glossaryEntry>decrease the pressure of; "depressurize the cabin in the air plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200280698">
	<b:glossaryEntry>assign to categories; "Children learn early on to categorize"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200280835"
