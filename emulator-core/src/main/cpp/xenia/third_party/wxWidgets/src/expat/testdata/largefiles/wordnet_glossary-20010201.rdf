<rdf:Description rdf:about="&a;201177168">
	<b:glossaryEntry>carry out, as a performance; "They turned in top jobs for the second straight game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201177316">
	<b:glossaryEntry>play a role or part; "Gielgud played Hamlet"; "She wants to act Lady Macbeth, but she is too young for the role"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201177668">
