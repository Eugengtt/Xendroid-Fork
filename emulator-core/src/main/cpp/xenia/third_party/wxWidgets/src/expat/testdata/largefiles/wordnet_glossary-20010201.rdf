<?xml version='1.0' encoding='ISO-8859-1'?>
<!DOCTYPE rdf:RDF [
	 <!ENTITY rdf 'http://www.w3.org/1999/02/22-rdf-syntax-ns#'>
	 <!ENTITY a 'http://www.cogsci.princeton.edu/~wn/concept#'>
	 <!ENTITY b 'http://www.cogsci.princeton.edu/~wn/schema/'>
]>
<rdf:RDF xmlns:rdf="&rdf;"
	 xmlns:a="&a;"
	 xmlns:b="&b;">
<rdf:Description rdf:about="&a;100001740"
	 b:glossaryEntry="anything having existence (living or nonliving)"/>
<rdf:Description rdf:about="&a;100002086"
	 b:glossaryEntry="any living entity"/>
<rdf:Description rdf:about="&a;100002880">
	<b:glossaryEntry>living things collectively; "the oceans are teeming with life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100003011"
	 b:glossaryEntry="a discrete unit of living matter"/>
<rdf:Description rdf:about="&a;100003095">
	<b:glossaryEntry>the basic structural and functional unit of all organisms; cells may exist as independent units of life (as in monads) or may form colonies or tissues as in higher plants and animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100003731"
	 b:glossaryEntry="any entity that causes events to happen"/>
<rdf:Description rdf:about="&a;100004123"
	 b:glossaryEntry='a human being; "there was too much for one person to do"'/>
<rdf:Description rdf:about="&a;100008019"
	 b:glossaryEntry="a living organism characterized by voluntary movement"/>
<rdf:Description rdf:about="&a;100008864"
	 b:glossaryEntry="a living organism lacking the power of locomotion"/>
<rdf:Description rdf:about="&a;100009457">
	<b:glossaryEntry>a physical (tangible and visible) entity; "it was full of rackets, balls and other objects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100010123"
	 b:glossaryEntry="an object occurring naturally; not made by man"/>
<rdf:Description rdf:about="&a;100010572">
	<b:glossaryEntry>that which has mass and occupies space; "an atom is the smallest indivisible unit of matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100011575">
	<b:glossaryEntry>any substance that can be metabolized by an organism to give energy and build tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100011937"
	 b:glossaryEntry="a man-made object"/>
<rdf:Description rdf:about="&a;100012704"
	 b:glossaryEntry='one of a class of artifacts; "an article of clothing"'/>
<rdf:Description rdf:about="&a;100012865"
	 b:glossaryEntry="a feature of the mental life of a living organism"/>
<rdf:Description rdf:about="&a;100013018">
	<b:glossaryEntry>a general concept formed by extracting common features from specific examples</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100013243">
	<b:glossaryEntry>the psychological result of perception and learning and reasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100013700">
	<b:glossaryEntry>the psychological feature that arouses an organism to action; the reason for the action; "we did not understand his motivation"; "he acted with the best of motives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100014045">
	<b:glossaryEntry>the psychological feature of experiencing affective and emotional states; "he had a feeling of euphoria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100014887"
	 b:glossaryEntry="a point or extent in space"/>
<rdf:Description rdf:about="&a;100015185">
	<b:glossaryEntry>the spatial arrangement of something as distinct from its substance; "geometry is the mathematical science of shape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100015594">
	<b:glossaryEntry>the continuum of experience in which events pass from the future through the present to the past</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100015975">
	<b:glossaryEntry>the unlimited 3-dimensional expanse in which everything is located; "they tested his ability to locate objects in space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100016185">
	<b:glossaryEntry>the way something is with respect to its main attributes; "the current state of knowledge"; "his state of health"; "in a weak financial state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100017297"
	 b:glossaryEntry="something that happens at a given place and time"/>
<rdf:Description rdf:about="&a;100017487"
	 b:glossaryEntry="something that people do or cause to happen"/>
<rdf:Description rdf:about="&a;100017954"
	 b:glossaryEntry="any number of entities (members) considered as a unit"/>
<rdf:Description rdf:about="&a;100018376"
	 b:glossaryEntry="anything owned or possessed"/>
<rdf:Description rdf:about="&a;100018604"
	 b:glossaryEntry="an abstraction belonging to or characteristic of an entity"/>
<rdf:Description rdf:about="&a;100018916">
	<b:glossaryEntry>an abstraction belonging to or characteristic of two entities or parts together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100019464"
	 b:glossaryEntry="a relation between living organisms; esp between people"/>
<rdf:Description rdf:about="&a;100019671"
	 b:glossaryEntry="something that is communicated between people or groups"/>
<rdf:Description rdf:about="&a;100020056"
	 b:glossaryEntry="how much there is of something that you can measure"/>
<rdf:Description rdf:about="&a;100020461">
	<b:glossaryEntry>any state or process known through the senses rather than by intuition or reasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100020709"
	 b:glossaryEntry='an action; "how could you do such a thing?"'/>
<rdf:Description rdf:about="&a;100020804"
	 b:glossaryEntry="a kind act"/>
<rdf:Description rdf:about="&a;100020977"
	 b:glossaryEntry="the act of accomplishing something"/>
<rdf:Description rdf:about="&a;100021392"
	 b:glossaryEntry='a notable achievement: "the book was her finest effort"'/>
<rdf:Description rdf:about="&a;100021866"
	 b:glossaryEntry="an outstanding achievement"/>
<rdf:Description rdf:about="&a;100021950"
	 b:glossaryEntry="an achievement demonstrating great skill or mastery"/>
<rdf:Description rdf:about="&a;100022060">
	<b:glossaryEntry>used in the phrase "to your credit" to indicate an achievement deserving praise; "she already had several performances to her credit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100022246">
	<b:glossaryEntry>something done (usually as opposed to something said); "there were stories of murders and other unnatural actions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100022737">
	<b:glossaryEntry>a mode of action; "if you persist in that course you will surely fail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100022878"
	 b:glossaryEntry="a mutual or reciprocal action; interacting"/>
<rdf:Description rdf:about="&a;100023032"
	 b:glossaryEntry="reciprocal action and reaction"/>
<rdf:Description rdf:about="&a;100023118">
	<b:glossaryEntry>close interaction: "they kept in daily contact"; "they claimed that they had been in contact with extraterrestrial beings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100023330">
	<b:glossaryEntry>contact that occurs when two people look directly at each other; "a teacher should make eye contact with the students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100023506">
	<b:glossaryEntry>contact established between applicants and prospective employees; "the agency provided placement services"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100023668">
	<b:glossaryEntry>mutual interaction; the activity of interchanging or reciprocating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100023860"
	 b:glossaryEntry="mutual exchange of commercial or other privileges"/>
<rdf:Description rdf:about="&a;100023967"
	 b:glossaryEntry="social or verbal interchange (usually followed by `with'')"/>
<rdf:Description rdf:about="&a;100024107">
	<b:glossaryEntry>(usually plural) mutual dealings or connections among persons or groups: "international relations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100024260"
	 b:glossaryEntry="taking part in a game or sport or other recreation"/>
<rdf:Description rdf:about="&a;100024436">
	<b:glossaryEntry>the act using a sword (or other weapon) vigorously and skillfully</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100024570"
	 b:glossaryEntry="the playing of a game of tenpins or duckpins etc"/>
<rdf:Description rdf:about="&a;100024710"
	 b:glossaryEntry="brave and heroic deeds"/>
<rdf:Description rdf:about="&a;100024789"
	 b:glossaryEntry="a masterly or brilliant feat"/>
<rdf:Description rdf:about="&a;100024877">
	<b:glossaryEntry>any recognized accomplishment; "they admired his performance under stress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100025045">
	<b:glossaryEntry>better than expected performance (better than might have been predicted from intelligence tests)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100025221">
	<b:glossaryEntry>poorer than expected performance (poorer than might have been predicted from intelligence tests)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100025398">
	<b:glossaryEntry>the sum of recognized accomplishments; "the lawyer has a good record"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100025520"
	 b:glossaryEntry="an irreversible accomplishment"/>
<rdf:Description rdf:about="&a;100025630">
	<b:glossaryEntry>advancing toward a goal; "persuading him was easy going" or "the proposal faces tough sledding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100025788"
	 b:glossaryEntry="accomplishment of an objective"/>
<rdf:Description rdf:about="&a;100025919">
	<b:glossaryEntry>the act of arriving at a certain place; "they awaited her arrival"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100026147">
	<b:glossaryEntry>arrival at a new stage; "his attainment of puberty was delayed by malnutrition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100026283"
	 b:glossaryEntry='esp. of something momentous; "the advent of the computer"'/>
<rdf:Description rdf:about="&a;100026402"
	 b:glossaryEntry='the act of entering; "she made a grand entrance"'/>
<rdf:Description rdf:about="&a;100026689">
	<b:glossaryEntry>the act of entering some territory or domain (often in large numbers); "the incursion of television into the American livingroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100026874"
	 b:glossaryEntry="entrance by force or without permission or welcome"/>
<rdf:Description rdf:about="&a;100026980">
	<b:glossaryEntry>a sudden violent entrance; a bursting in; "the recent irruption of bad manners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100027115">
	<b:glossaryEntry>the act of entering; "she made a graceful entree into the ballroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100027235"
	 b:glossaryEntry="the act of enrolling"/>
<rdf:Description rdf:about="&a;100027339">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of appearing in public view; "the rookie made a brief appearance in the first period"; "it was Bernhardt''s last appearance in America"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100027592"
	 b:glossaryEntry="the act of emerging"/>
<rdf:Description rdf:about="&a;100027678"
	 b:glossaryEntry="the act of appearing again"/>
<rdf:Description rdf:about="&a;100027781">
	<b:glossaryEntry>(astronomy) the reappearance of a celestial body after an eclipse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100027910">
	<b:glossaryEntry>a coming to or returning home; "on the eve of his return to Australia we gave him a goodbye party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100028092"
	 b:glossaryEntry="the act of returning to the country of origin"/>
<rdf:Description rdf:about="&a;100028196">
	<b:glossaryEntry>the act of forcing a way into or through something; "the penetration of upper management by women"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100028352"
	 b:glossaryEntry="a act of securing an arriving vessel with ropes or anchors"/>
<rdf:Description rdf:about="&a;100028503"
	 b:glossaryEntry="the act of coming to land after a voyage"/>
<rdf:Description rdf:about="&a;100028670">
	<b:glossaryEntry>the act of coming down to the earth (or other surface); "the plane made a smoothe landing"; "his landing on his feet was catlike"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100028871">
	<b:glossaryEntry>an unscheduled airplane landing that is made under circumstances (engine failure or adverse weather) not under the pilot''s control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100029100"
	 b:glossaryEntry="act of departing"/>
<rdf:Description rdf:about="&a;100029365"
	 b:glossaryEntry="departing hastily"/>
<rdf:Description rdf:about="&a;100029442">
	<b:glossaryEntry>the act of departing politely; "he disliked long farewells"; "he took his leave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100029628"
	 b:glossaryEntry="the act of saying farewell"/>
<rdf:Description rdf:about="&a;100029712"
	 b:glossaryEntry="the act of leaving secretly or without explanation"/>
<rdf:Description rdf:about="&a;100029873"
	 b:glossaryEntry="suddenly disappearing from sight"/>
<rdf:Description rdf:about="&a;100029961"
	 b:glossaryEntry="the act of withdrawing"/>
<rdf:Description rdf:about="&a;100030184">
	<b:glossaryEntry>withdrawing into the background; making yourself inconspicuous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100030321">
	<b:glossaryEntry>withdrawal for prayer and study and meditation; "a religous retreat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100030456">
	<b:glossaryEntry>the act of evacuating; leaving a place in an orderly fashion; esp. for protection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100030612"
	 b:glossaryEntry="breaking camp"/>
<rdf:Description rdf:about="&a;100030682">
	<b:glossaryEntry>withdrawing support or help despite allegiance or responsibility; "his abandonment of his wife and children left them penniless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100030946"
	 b:glossaryEntry="the act of running away secretly (as to avoid arrest)"/>
<rdf:Description rdf:about="&a;100031070"
	 b:glossaryEntry="unauthorized military absence"/>
<rdf:Description rdf:about="&a;100031190">
	<b:glossaryEntry>ideological defection from the party line (especially from orthodox communism)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100031327"
	 b:glossaryEntry="migration into a place"/>
<rdf:Description rdf:about="&a;100031422"
	 b:glossaryEntry="migration out of a place"/>
<rdf:Description rdf:about="&a;100031519"
	 b:glossaryEntry="(military) withdrawal to a more favorable position"/>
<rdf:Description rdf:about="&a;100031641"
	 b:glossaryEntry="(military) withdrawal of a military presence"/>
<rdf:Description rdf:about="&a;100031741"
	 b:glossaryEntry="to break off a military action with an enemy"/>
<rdf:Description rdf:about="&a;100031866"
	 b:glossaryEntry="a act of becoming more distant"/>
<rdf:Description rdf:about="&a;100031963"
	 b:glossaryEntry="the departure of a vessel from a port"/>
<rdf:Description rdf:about="&a;100032054">
	<b:glossaryEntry>the act of passengers and crew getting off of a ship or aircraft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100032245"
	 b:glossaryEntry="debarkation from a boat or ship"/>
<rdf:Description rdf:about="&a;100032335">
	<b:glossaryEntry>the act of passengers and crew getting aboard a ship or aircraft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100032499"
	 b:glossaryEntry="the act of going out"/>
<rdf:Description rdf:about="&a;100032570">
	<b:glossaryEntry>the act of running away with a lover (usually to get married)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100032687">
	<b:glossaryEntry>the act of escaping physically; "he made his escape from the mental hospital"; "the canary escaped from its cage"; "his flight was an indication of his guilt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100032997">
	<b:glossaryEntry>leaving (without permission) the place you are expected to be</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100033153">
	<b:glossaryEntry>the act of physically escaping from something (an opponent or a pursuer or an unpleasant situation) by some adroit maneuver</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100033384"
	 b:glossaryEntry="the act of avoiding capture (especially by cunning)"/>
<rdf:Description rdf:about="&a;100033506"
	 b:glossaryEntry="an action aimed at evading an enemy"/>
<rdf:Description rdf:about="&a;100033679">
	<b:glossaryEntry>(in boxing) the act of one boxer holding onto the other to avoid being hit and to rest momentarily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100033830"
	 b:glossaryEntry="a quick evasive movement"/>
<rdf:Description rdf:about="&a;100033906"
	 b:glossaryEntry='an escape from jail; "the breakout was carefully planned"'/>
<rdf:Description rdf:about="&a;100034082">
	<b:glossaryEntry>a rapid escape (as by criminals); "the thieves made a clean getaway"; "after the expose he had to take it on the lam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100034259">
	<b:glossaryEntry>a journey by a large group to escape from a hostile environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100034393">
	<b:glossaryEntry>abolitionists secret aid to escaping slaves; pre-Civil War in US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100034546"
	 b:glossaryEntry="something achieved (or escaped) by a narrow margin"/>
<rdf:Description rdf:about="&a;100034703"
	 b:glossaryEntry="the act of coming (or going) out; becoming apparent"/>
<rdf:Description rdf:about="&a;100034867"
	 b:glossaryEntry="emerging to the surface and becoming apparent"/>
<rdf:Description rdf:about="&a;100034968"
	 b:glossaryEntry="the act of sending off something"/>
<rdf:Description rdf:about="&a;100035095">
	<b:glossaryEntry>the act of shipping again (especially by transferring to another ship)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100035222">
	<b:glossaryEntry>the act of becoming or making complete: "her work is still far from completion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100035376"
	 b:glossaryEntry="the act of bringing to completion or fruition"/>
<rdf:Description rdf:about="&a;100035534">
	<b:glossaryEntry xml:space='preserve'><![CDATA[something that is realized; "the victory was the realization of a whole year''s work"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100035701"
	 b:glossaryEntry="the moment of most intense pleasure in sexual intercourse"/>
<rdf:Description rdf:about="&a;100035863"
	 b:glossaryEntry="an orgasm accompanied by the ejaculation of semen"/>
<rdf:Description rdf:about="&a;100035970"
	 b:glossaryEntry="the act of consummating something (a desire or promise etc)"/>
<rdf:Description rdf:about="&a;100036136"
	 b:glossaryEntry="the fulfillment of your capacities"/>
<rdf:Description rdf:about="&a;100036271">
	<b:glossaryEntry>the act of achieving an aim; "the attainment of independence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100036443">
	<b:glossaryEntry>the best performance ever attained in a sport; "he broke the Olympic record"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100036590"
	 b:glossaryEntry="the best record in the whole world"/>
<rdf:Description rdf:about="&a;100036683">
	<b:glossaryEntry>an attainment that is successful; "his success in the marathon was unexpected"; "his new play was a great success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100037013">
	<b:glossaryEntry>succeeding with great difficulty; "just winning the shore exhausted him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100037139">
	<b:glossaryEntry>a conspicuous success; "that song was his first hit and marked the beginning of his career"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100037304">
	<b:glossaryEntry xml:space='preserve'><![CDATA[something that exactly succeeds in achieving its goal; "the new advertising campaign was a bell ringer"; "scored a bull''s_eye"; "hit the mark"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100037524"
	 b:glossaryEntry="the act of raising someone to the nobility"/>
<rdf:Description rdf:about="&a;100037624">
	<b:glossaryEntry>success in mastering something difficult; "the conquest of space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100037744"
	 b:glossaryEntry="a brilliant and notable success"/>
<rdf:Description rdf:about="&a;100037826">
	<b:glossaryEntry>success in satisfying a test or requirement; "his future depended on his passing that test"; "he got a pass in introductory chemistry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100038052">
	<b:glossaryEntry>educational recognition that a course of studies has been successfully completed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100038219">
	<b:glossaryEntry>a unit of academic credit; one hour a week for an academic semester</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100038346"
	 b:glossaryEntry="an act that does not achieve its intended goal"/>
<rdf:Description rdf:about="&a;100038527">
	<b:glossaryEntry>an unexpected omission; "he resented my failure to return his call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100038702"
	 b:glossaryEntry="an act that fails"/>
<rdf:Description rdf:about="&a;100038917">
	<b:glossaryEntry>failure to reach a minimum required performance; "his failing the course led to his disqualification"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100039090"
	 b:glossaryEntry='complete failure; "all my efforts led to naught"'/>
<rdf:Description rdf:about="&a;100039191">
	<b:glossaryEntry>an unexcused absence from class; "he was punished for taking too many cuts in his math class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100039334"
	 b:glossaryEntry='loss due to not showing up; "he lost the game by default"'/>
<rdf:Description rdf:about="&a;100039445">
	<b:glossaryEntry>an informal word for any attempt or effort; "he gave it his best shot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100039566"
	 b:glossaryEntry="an attempt to score in a game"/>
<rdf:Description rdf:about="&a;100039700">
	<b:glossaryEntry>the act of losing; "everyone expected him to win so his loss was a shock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100039842">
	<b:glossaryEntry>the act of surrendering (under agreed conditions); "they were protected until the capitulation of the fort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100040027"
	 b:glossaryEntry="an act of hindering someone''s plans or efforts"/>
<rdf:Description rdf:about="&a;100040167">
	<b:glossaryEntry>an improbable and unexpected victory; "the biggest upset since David beat Goliath"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100040312"
	 b:glossaryEntry="a failure to maintain a higher state"/>
<rdf:Description rdf:about="&a;100040483"
	 b:glossaryEntry="the act of disappointing someone"/>
<rdf:Description rdf:about="&a;100040608"
	 b:glossaryEntry="a failure to perform some promised act or obligation"/>
<rdf:Description rdf:about="&a;100040749"
	 b:glossaryEntry="a failure to face some difficulty squarely"/>
<rdf:Description rdf:about="&a;100040844"
	 b:glossaryEntry="a breach of a legal duty"/>
<rdf:Description rdf:about="&a;100041059">
	<b:glossaryEntry>a breach of contract committed prior to the time of required performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100041219"
	 b:glossaryEntry="a breach of due care"/>
<rdf:Description rdf:about="&a;100041300"
	 b:glossaryEntry="a failure of the seller''s guarantee of good title"/>
<rdf:Description rdf:about="&a;100041430"
	 b:glossaryEntry="failure to keep a promise (of marriage)"/>
<rdf:Description rdf:about="&a;100041533">
	<b:glossaryEntry>violation (either through fraud or negligence) by a trustee of a duty that equity requires of him</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100041692"
	 b:glossaryEntry="larceny after trust rather than after unlawful taking"/>
<rdf:Description rdf:about="&a;100041830">
	<b:glossaryEntry>a breach that occurs when an item is deficient according to the terms of a warranty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100041978"
	 b:glossaryEntry="the act deviating from a vertical position"/>
<rdf:Description rdf:about="&a;100042074">
	<b:glossaryEntry>a breach serious enough to destroy the value of the contract and to give a basis for an action for breach of contract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100042253">
	<b:glossaryEntry>a breach that does not destroy the value of the contract but can give rise to a claim for damages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100042411">
	<b:glossaryEntry>a wrong action attributable to bad judgment or ignorance or inattention; "the fault was all mine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100042794">
	<b:glossaryEntry>a mistake that occurs when the server in tennis fails to keep both feet behind the baseline</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100042960">
	<b:glossaryEntry>(baseball) a failure of a defensive player to make an out when normal play would have sufficed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100043135">
	<b:glossaryEntry>an act that brings discredit to the person who does it; "he made a huge blot on his copybook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100043311">
	<b:glossaryEntry>a mistake that results from taking one thing to be another; "he changed his name in order to avoid confusion with the notorious outlaw"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100043525"
	 b:glossaryEntry="a mistake in calculating"/>
<rdf:Description rdf:about="&a;100043659"
	 b:glossaryEntry="a miscalculation that recoils on its maker"/>
<rdf:Description rdf:about="&a;100043768"
	 b:glossaryEntry="the mistake of misrepresenting the facts"/>
<rdf:Description rdf:about="&a;100043865"
	 b:glossaryEntry="an inadvertent mistake"/>
<rdf:Description rdf:about="&a;100043956"
	 b:glossaryEntry="a mistake resulting from inattention"/>
<rdf:Description rdf:about="&a;100044056"
	 b:glossaryEntry="a mistake resulting from neglect"/>
<rdf:Description rdf:about="&a;100044168"
	 b:glossaryEntry="an embarrassing mistake"/>
<rdf:Description rdf:about="&a;100044471">
	<b:glossaryEntry>an acronym often used by soldiers in World War II: Situation Normal All Fucked Up</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100044604">
	<b:glossaryEntry>a blunder that makes you look ridiculous; used in the phrase "make a spectacle of" yourself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100044751"
	 b:glossaryEntry="(British) something badly botched or muddled"/>
<rdf:Description rdf:about="&a;100044878">
	<b:glossaryEntry>a serious and ludicrous blunder; "he made a bad bull of the assignment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100045000"
	 b:glossaryEntry="dropping the ball (in baseball or football)"/>
<rdf:Description rdf:about="&a;100045103"
	 b:glossaryEntry="a blunder (especially an actor''s forgetting the lines)"/>
<rdf:Description rdf:about="&a;100045209"
	 b:glossaryEntry="a socially awkward or tactless act"/>
<rdf:Description rdf:about="&a;100045336">
	<b:glossaryEntry>(British) a conspicuous mistake whose effects seem to reverberate; "he dropped a clanger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100045479">
	<b:glossaryEntry>an unintentional but embarrassing blunder; "he recited the whole poem without a single trip"; "confusion caused his unfortunate misstep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100045686">
	<b:glossaryEntry>a sudden drop from an upright position; "he had a nasty spill on the ice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100045827">
	<b:glossaryEntry>the act of contracting or assuming or acquiring possession of something; "the acquisition of wealth"; "the acquisition of one company by another"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100046246">
	<b:glossaryEntry>the act of acquiring something; "I envied his talent for acquiring new friends"; "did you hear about his getting a car?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100046576"
	 b:glossaryEntry="the act of obtaining"/>
<rdf:Description rdf:about="&a;100046665">
	<b:glossaryEntry>becomeing infected; "catching cold is sometimes unavoidable"; "the contracting of a serious illness can be financially catastrophic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100046866">
	<b:glossaryEntry>acquiring or coming into something (usually undesirable): "incurring debts is easier than paying them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100047024"
	 b:glossaryEntry="the act of making money (and accumulating wealth)"/>
<rdf:Description rdf:about="&a;100047131">
	<b:glossaryEntry>something added to what you have already; "the librarian shelved the new accessions"; "he was a new addition to the staff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100047320">
	<b:glossaryEntry>acquisition of government money for benefits to a specific locale: "keeps his hold on his constituents through unashamed pork-barreling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100047517">
	<b:glossaryEntry>the acquisition of something for payment; "they closed the purchase with a handshake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100047693"
	 b:glossaryEntry="purchasing back something previously sold"/>
<rdf:Description rdf:about="&a;100047814"
	 b:glossaryEntry="buying or selling securities or commodities"/>
<rdf:Description rdf:about="&a;100048001">
	<b:glossaryEntry>trading in bonds (usually by a broker on the floor of an exchange)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100048150">
	<b:glossaryEntry>a trading technique involving large blocks of stock with trades triggered by computer programs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100048306">
	<b:glossaryEntry>sale of securities or commodity futures not owned by the seller (who hopes to buy them back later at a lower price)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100048494">
	<b:glossaryEntry>the purchase of securities or commodities by a short seller to close out a short sale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100048640">
	<b:glossaryEntry>buying or selling corporate stock by a corporate officer or other insider</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100048775">
	<b:glossaryEntry>a put or call option for which the seller or buyer has no underlying security position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100048920">
	<b:glossaryEntry>a put or call option backed by the shares underlying the option</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100049044">
	<b:glossaryEntry>the option to buy a given stock (or stock index or commodity future) at a given price before a given date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100049251">
	<b:glossaryEntry>the option to sell a given stock (or stock index or commodity future) at a given price before a given date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100049457">
	<b:glossaryEntry>the option to but or sell a given stock (or stock index or commodity future) at a given price before a given date; consists of an equal number of put and call options</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100049678">
	<b:glossaryEntry>an option granted to corporate executives if the company achieves certain financial goals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100049855">
	<b:glossaryEntry>the act of buying; "buying equipment for the trip took several hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100050044">
	<b:glossaryEntry>searching for or buying goods or services: "went shopping for a reliable plumber"; "does her shopping at the mall rather than down town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100050253">
	<b:glossaryEntry>shopping at a market: "does the weekly marketing at the supermarket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100050377"
	 b:glossaryEntry="buying goods to be shipped through the mail"/>
<rdf:Description rdf:about="&a;100050501">
	<b:glossaryEntry>purchasing insurance policies for cash from terminally ill policy holders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100050643">
	<b:glossaryEntry>the act of taking something that is offered; "her acceptance of the gift encouraged him"; "he anticipated their acceptance of his offer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100050836"
	 b:glossaryEntry="acquisition of property by descent or by will"/>
<rdf:Description rdf:about="&a;100050952">
	<b:glossaryEntry>the act of taking possession of or power over something; "the Nazi assumption of power in 1934"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100051119"
	 b:glossaryEntry="any acquisition from past generations"/>
<rdf:Description rdf:about="&a;100051225">
	<b:glossaryEntry>the act of getting possession of something; "he was responsible for the procurement of materials and supplies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100051417"
	 b:glossaryEntry="a deliberate act of acquisition"/>
<rdf:Description rdf:about="&a;100051562">
	<b:glossaryEntry>the appropriation (of ideas or words etc) from another source; "the borrowing of ancient motifs was very apparent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100051761">
	<b:glossaryEntry>wrongful borrowing; "his explanation was a misappropriation of sociological theory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100051907"
	 b:glossaryEntry="the taking possession of something by legal process"/>
<rdf:Description rdf:about="&a;100052102"
	 b:glossaryEntry="seizing and holding (an office or powers) by force"/>
<rdf:Description rdf:about="&a;100052209"
	 b:glossaryEntry="seizure by the government"/>
<rdf:Description rdf:about="&a;100052324">
	<b:glossaryEntry>the seizure and holding of property as security for payment of a debt or satisfaction of a claim</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100052487"
	 b:glossaryEntry="depriving an owner of property by taking it for public use"/>
<rdf:Description rdf:about="&a;100052605">
	<b:glossaryEntry>placing private property in the custody of an officer of the law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100052764"
	 b:glossaryEntry="the act of coercing someone into government service"/>
<rdf:Description rdf:about="&a;100052883">
	<b:glossaryEntry>the act of occupying or taking possession of a building; "occupation of a building without a certificate of occupancy is illegal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100053119"
	 b:glossaryEntry="the act of taking occupancy before someone else does"/>
<rdf:Description rdf:about="&a;100053230">
	<b:glossaryEntry>seizing property that belongs to someone else and holding it until profits pay the demand for which it was seized</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100053417"
	 b:glossaryEntry="the act of providing a subsidy"/>
<rdf:Description rdf:about="&a;100053585">
	<b:glossaryEntry>a grant made by a law court; "he criticized the awarding of compensation by the court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100053734">
	<b:glossaryEntry>a grant of federal money to state and local governments to support social welfare programs; "block grants reduce federal responsibility for social welfare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100053947"
	 b:glossaryEntry="a grant from a central government to a local government"/>
<rdf:Description rdf:about="&a;100054061"
	 b:glossaryEntry="the act of forcibly dispossessing an owner of property"/>
<rdf:Description rdf:about="&a;100054269">
	<b:glossaryEntry>the act of apprehending (especially apprehending a criminal); "the policeman on the beat got credit for the collar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100054499"
	 b:glossaryEntry="the act of conquering"/>
<rdf:Description rdf:about="&a;100054633"
	 b:glossaryEntry="the act of making slaves of your captives"/>
<rdf:Description rdf:about="&a;100054744">
	<b:glossaryEntry>getting something back again; "upon the restitution of the book to its rightful owner the child was given a tongue lashing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100054978">
	<b:glossaryEntry>(British) finding a way to take money back from people that they were given in another way; "the Treasury will find some clawback for the extra benefits members received"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100055203"
	 b:glossaryEntry="seizure of the collateral securing a loan that is in default"/>
<rdf:Description rdf:about="&a;100055322">
	<b:glossaryEntry>the legal proceedings initiated by a creditor to repossess the collateral for loan that is in default</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100055481"
	 b:glossaryEntry="the act of receiving"/>
<rdf:Description rdf:about="&a;100055579"
	 b:glossaryEntry="the act or means of getting rid of something"/>
<rdf:Description rdf:about="&a;100055818">
	<b:glossaryEntry>(law) the act of disposing of property by virtue of the power of appointment; "she allocated part of the trust to her church by appointment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100056016">
	<b:glossaryEntry>the act of carefully weeding out unwanted things or people; "the department got a good comb-out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100056167">
	<b:glossaryEntry>disposing of property by voluntary transfer without receiving value in return</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100056297">
	<b:glossaryEntry>the voluntary surrender of property (or a right to property) without attempting to reclaim it or give it away</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100056518">
	<b:glossaryEntry>getting rid something that is regarded as useless or undesirable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100056665"
	 b:glossaryEntry="to throw out a useless card or to fail to follow suit"/>
<rdf:Description rdf:about="&a;100056791">
	<b:glossaryEntry>throwing cargo overboard to lighten the load when in distress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100056907"
	 b:glossaryEntry="the disposal of explosive mines"/>
<rdf:Description rdf:about="&a;100057016"
	 b:glossaryEntry="the activity of detecting and disposing of marine mines"/>
<rdf:Description rdf:about="&a;100057130"
	 b:glossaryEntry="the disposal of sewage"/>
<rdf:Description rdf:about="&a;100057214">
	<b:glossaryEntry>a sale of property at a price agreed on by the seller and buyer without an intervening agency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100057368"
	 b:glossaryEntry="the public sale of something to the highest bidder"/>
<rdf:Description rdf:about="&a;100057496">
	<b:glossaryEntry>the act of making of transporting alcoholic liquor for sale illegally; "the Prohibition amendment made bootlegging profitable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100057680">
	<b:glossaryEntry>the act of selling illegally or without permission; "the bootlegging of video tapes is common in the Orient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100057846"
	 b:glossaryEntry="the sale of capital stock"/>
<rdf:Description rdf:about="&a;100057967"
	 b:glossaryEntry="too much capitalization (more than the business warrants)"/>
<rdf:Description rdf:about="&a;100058089">
	<b:glossaryEntry>the feat of mustering strength for a renewed effort; "he singled to start a rally in the 9th inning"; "he feared the rallying of their troops for a counterattack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100058314">
	<b:glossaryEntry>the act of regaining or saving something lost (or in danger of becoming lost)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100058512">
	<b:glossaryEntry xml:space='preserve'><![CDATA[recovery or preservation from loss or danger; "work is the deliverance of mankind" or "a surgeon''s job is the saving of lives"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100058851">
	<b:glossaryEntry>saving the lives of drowning persons; "he took a course in lifesaving"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100058978">
	<b:glossaryEntry>(Christianity) the act of delivering from sin or saving from evil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100059166">
	<b:glossaryEntry>formal redemption as pronounced by a priest in the sacrament of penance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100059344">
	<b:glossaryEntry>a spiritual enlightenment causing a person to lead a new life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100059510">
	<b:glossaryEntry>conversion resulting from the zeal of crusading advocacy of the gospel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100059682">
	<b:glossaryEntry>changing a person''s beliefs by argument or reasoning or entreaty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100059803"
	 b:glossaryEntry="the act of atoning for sin or wrongdoing"/>
<rdf:Description rdf:about="&a;100059926">
	<b:glossaryEntry>compensation (given or received) for an injury or insult; "an act for which there is no reparation"; "how can I make amends?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100060117"
	 b:glossaryEntry="the act of liberating someone or something"/>
<rdf:Description rdf:about="&a;100060316"
	 b:glossaryEntry="the use of force to liberate prisoners"/>
<rdf:Description rdf:about="&a;100060414"
	 b:glossaryEntry="rescuing from error and returning to a rightful course"/>
<rdf:Description rdf:about="&a;100060540">
	<b:glossaryEntry>the act of rescuing a ship or its crew or its cargo from a shipwreck or a fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100060672">
	<b:glossaryEntry xml:space='preserve'><![CDATA[saving someone or something from harm of from an unpleasant situation; "the salvation of his party was the president''s major concern"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100060861">
	<b:glossaryEntry>a military rescue mission to search for survivors and to rescue them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100061001"
	 b:glossaryEntry="the act of freeing from captivity or punishment"/>
<rdf:Description rdf:about="&a;100061101"
	 b:glossaryEntry="the act of taking something back"/>
<rdf:Description rdf:about="&a;100061200">
	<b:glossaryEntry>a legal seizure by the government of profits beyond a fixed amount</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100061322">
	<b:glossaryEntry>the act of implementing (providing a practical means for accomplishing something)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100061587"
	 b:glossaryEntry="the act of appealing for help"/>
<rdf:Description rdf:about="&a;100061673">
	<b:glossaryEntry>the act of providing or using the instruments needed for some implementation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100061811">
	<b:glossaryEntry>the act of doing something successfully; using knowledge as distinguished from merely possessing it; "experience generally improves performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100062125">
	<b:glossaryEntry>the performance of a legal contract as specified by its terms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100062253">
	<b:glossaryEntry>technical aspects of doing something; "mechanisms of communication"; "the mechanics of prose style"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100062420">
	<b:glossaryEntry>the performance of duties by a waiter or servant; "that restaurant has excellent service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100062581">
	<b:glossaryEntry>the practice of serving yourself (as in a grocery or cafeteria)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100062703"
	 b:glossaryEntry="a performance of a drama"/>
<rdf:Description rdf:about="&a;100062816">
	<b:glossaryEntry>an extra or repeated performance; usually given in response to audience demand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100062947"
	 b:glossaryEntry="a performance given without planning or preparation"/>
<rdf:Description rdf:about="&a;100063094"
	 b:glossaryEntry="throwing and catching several objects simultaneously"/>
<rdf:Description rdf:about="&a;100063210"
	 b:glossaryEntry="an illusory feat; considered magical by naive observers"/>
<rdf:Description rdf:about="&a;100063430"
	 b:glossaryEntry="act of performing music"/>
<rdf:Description rdf:about="&a;100063574">
	<b:glossaryEntry>the act of interpreting something as expressed in an artistic performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100063750"
	 b:glossaryEntry="a new or different interpretation"/>
<rdf:Description rdf:about="&a;100063846"
	 b:glossaryEntry="the act of playing a musical instrument"/>
<rdf:Description rdf:about="&a;100063957">
	<b:glossaryEntry xml:space='preserve'><![CDATA[managing the bow in playing a stringed instrument; "the violinist''s bowing was excellent"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100064099"
	 b:glossaryEntry="an impromptu jazz concert"/>
<rdf:Description rdf:about="&a;100064182">
	<b:glossaryEntry>a highly technical implementation; usually involving electronic hardware; "automation replaces human workers by machines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100064422">
	<b:glossaryEntry>the act of motorizing (equiping with motors or with motor vehicles)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100064563"
	 b:glossaryEntry="the act of propelling"/>
<rdf:Description rdf:about="&a;100064905"
	 b:glossaryEntry="the act of propelling with force"/>
<rdf:Description rdf:about="&a;100065020">
	<b:glossaryEntry>the act of moving a newly-built vessel into the water for the first time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100065148"
	 b:glossaryEntry="the launching of a rocket or missile under its own power"/>
<rdf:Description rdf:about="&a;100065319">
	<b:glossaryEntry>the launching of a missile or spacecraft to a specified destination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100065448"
	 b:glossaryEntry="the launching of a spacecraft to the moon"/>
<rdf:Description rdf:about="&a;100065545">
	<b:glossaryEntry>the act of applying force to propel something; "after reaching the desired velocity the drive is cut off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100065763">
	<b:glossaryEntry>(informal) the application of maximum thrust; "he slammed the throttle to the firewall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100065905">
	<b:glossaryEntry>the act of applying force suddenly; "the impulse knocked him over"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100066047"
	 b:glossaryEntry="the act of rolling something (as the ball in bowling)"/>
<rdf:Description rdf:about="&a;100066170">
	<b:glossaryEntry>the act of throwing (propelling something through the air with a rapid movement of the arm and wrist); "the catcher made a good throw to second base"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100066551"
	 b:glossaryEntry="act or instance of throwing a ball in to put it into play"/>
<rdf:Description rdf:about="&a;100066663">
	<b:glossaryEntry>the action or manner of throwing something; "his pitch fell short and his hat landed on the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100066813">
	<b:glossaryEntry>(sports) the act of throwing the ball to another member of your team; "the pass was fumbled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100066988"
	 b:glossaryEntry='a quick throw; "he gave the ball a shy to the first baseman"'/>
<rdf:Description rdf:about="&a;100067098"
	 b:glossaryEntry="throwing with a wide motion (as if with a sling)"/>
<rdf:Description rdf:about="&a;100067201"
	 b:glossaryEntry="the act of flinging"/>
<rdf:Description rdf:about="&a;100067272">
	<b:glossaryEntry>throwing something heavy (with great effort); "he gave it a mighty heave"; "he was not good at heaving passes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100067444"
	 b:glossaryEntry="a violent throw"/>
<rdf:Description rdf:about="&a;100067517"
	 b:glossaryEntry="the throwing of a baseball by a pitcher to a batter"/>
<rdf:Description rdf:about="&a;100067884"
	 b:glossaryEntry="an illegal pitching motion while runners are on base"/>
<rdf:Description rdf:about="&a;100067987">
	<b:glossaryEntry>a pitch that is not in the strike zone; "he threw nine straight balls before the manager yanked him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100068138"
	 b:glossaryEntry="a baseball deliberately thrown at the batter''s head"/>
<rdf:Description rdf:about="&a;100068253">
	<b:glossaryEntry>a baseball thrown with little velocity when the batter is expecting a fastball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100068444">
	<b:glossaryEntry>a baseball thrown with spin so that its path curves as it approach the batter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100068611"
	 b:glossaryEntry="a pitch thrown deliberately close to the batter"/>
<rdf:Description rdf:about="&a;100068711">
	<b:glossaryEntry>a baseball thrown with maximum velocity; "he swung late on the fastball"; "He showed the batters nothing but smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100068934"
	 b:glossaryEntry="a baseball pitch thrown with little speed or spin"/>
<rdf:Description rdf:about="&a;100069052">
	<b:glossaryEntry>a pitch with reverse spin that curves toward the side of the plate from which it was thrown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100069199">
	<b:glossaryEntry>a pitch that curves downward rapidly as it approaches the plate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100069315">
	<b:glossaryEntry>a fastball that curves slightly away from the side from which it was thrown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100069443">
	<b:glossaryEntry>a pitch that is in the strike zone and that the batter does not hit; "this pitcher throws more strikes than balls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100069610"
	 b:glossaryEntry="a pitch thrown sidearm instead of overhead"/>
<rdf:Description rdf:about="&a;100069731"
	 b:glossaryEntry="a pitch that the catcher cannot stop"/>
<rdf:Description rdf:about="&a;100069824">
	<b:glossaryEntry>throwing the basketball toward the hoop; "his shot hit the rim and bounced out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100070182"
	 b:glossaryEntry="a shot that bounces off of the backboard"/>
<rdf:Description rdf:about="&a;100070278">
	<b:glossaryEntry>a shot in which the basketball is propelled downward into the basket</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100070427"
	 b:glossaryEntry="a forceful dunk"/>
<rdf:Description rdf:about="&a;100070498">
	<b:glossaryEntry>a shot that rolls off the tips of the fingers into the basket</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100070617">
	<b:glossaryEntry>an unhindered shot from the foul line; given to penalize the other team for committing a foul</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100070864">
	<b:glossaryEntry>a foul shot that must be made in order to earn the right to a second foul shot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100071000">
	<b:glossaryEntry>a shot made over the head with the hand that is farther from the basket</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100071134"
	 b:glossaryEntry="a player releases the basketball at the high point of a jump"/>
<rdf:Description rdf:about="&a;100071259"
	 b:glossaryEntry="a shot made from a position under or beside the basket"/>
<rdf:Description rdf:about="&a;100071366"
	 b:glossaryEntry="a one-handed shot made while whirling on the pivot foot"/>
<rdf:Description rdf:about="&a;100071478"
	 b:glossaryEntry="a two-handed shot from a stationary position"/>
<rdf:Description rdf:about="&a;100071577"
	 b:glossaryEntry="a shot made with an underhand scooping motion"/>
<rdf:Description rdf:about="&a;100071679">
	<b:glossaryEntry>a shot made by tapping the rebounding ball back into the basket</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100071795">
	<b:glossaryEntry>the act of applying force in order to move something away; "he gave the door a hard push"; "the pushing is good exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100072067">
	<b:glossaryEntry>pushing down; "depression of the space bar on the typewriter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100072203">
	<b:glossaryEntry>depression of a button on a computer mouse: "a click on the right button for example"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100072354"
	 b:glossaryEntry="a slight push"/>
<rdf:Description rdf:about="&a;100072419">
	<b:glossaryEntry>the act of pressing; "he gave the button a press"; "he used pressure to stop the bleeding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100072619">
	<b:glossaryEntry>the act of shoving (giving a push to someone or something); "he gave the door a shove"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100072793">
	<b:glossaryEntry>the act of shoving hastily; "she complained about bundling the children off to school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100072934"
	 b:glossaryEntry="the act of jostling (forcing your way by pushing)"/>
<rdf:Description rdf:about="&a;100073065"
	 b:glossaryEntry="jostling with the elbows"/>
<rdf:Description rdf:about="&a;100073144">
	<b:glossaryEntry>the act of pulling; applying force to move something toward or with you; "the pull up the hill had him breathing harder"; "his strenuous pulling strained his back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100073458">
	<b:glossaryEntry>the act of dragging (pulling with force); "the drag up the hill exhausted him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100073587">
	<b:glossaryEntry>the act of drawing or hauling something; "the haul up the hill went very slowly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100073753">
	<b:glossaryEntry>the act of hauling something (as a vehicle) by means of a hitch or rope; "the truck gave him a tow to the garage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100073925"
	 b:glossaryEntry="a sudden abrupt pull"/>
<rdf:Description rdf:about="&a;100074002"
	 b:glossaryEntry="the act of moving a load by drawing or pulling"/>
<rdf:Description rdf:about="&a;100074120"
	 b:glossaryEntry="the act of pulling and releasing a taut cord"/>
<rdf:Description rdf:about="&a;100074216">
	<b:glossaryEntry>the act of raising something; "he responded with a lift of his eyebrow"; "fireman learn several different raises for getting ladders up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100074431"
	 b:glossaryEntry="the act of expelling or projecting or ejecting"/>
<rdf:Description rdf:about="&a;100074661">
	<b:glossaryEntry>reflex changes in the eyes that enable an object to be focused on the retina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100074804">
	<b:glossaryEntry>extension upward of the toes when the sole of the foot is stroked firmly on the outer side from the heel to the front; normal in infants under the age of 2 years but a sign of brain or spinal cord injury in older persons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100075113">
	<b:glossaryEntry>a reflex that expels wind noisily from the stomach through the mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100075292">
	<b:glossaryEntry>the forceful expulsion of something from inside; "the belching of smoke from factory chimneys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100075441"
	 b:glossaryEntry="a reflex that closes and opens the eyes rapidly"/>
<rdf:Description rdf:about="&a;100075552"
	 b:glossaryEntry="the act of expelling (food or phlegm) by coughing"/>
<rdf:Description rdf:about="&a;100075659"
	 b:glossaryEntry="the act of spitting (forcefully expelling saliva)"/>
<rdf:Description rdf:about="&a;100075786">
	<b:glossaryEntry>the act of ejecting the contents of the stomach through the mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100075964"
	 b:glossaryEntry="the act of exhaling air suddenly with a noise"/>
<rdf:Description rdf:about="&a;100076072">
	<b:glossaryEntry>the act of jumping; propelling yourself off the ground; "he advanced in a series of jumps"; "the jumping was unexpected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100076325">
	<b:glossaryEntry>a headlong jump (or fall); "he took a header into the shrubbery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100076442">
	<b:glossaryEntry>the act of hopping (jumping upward or forward (especially on one foot))</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100076563"
	 b:glossaryEntry="a light springing movement upwards or forwards"/>
<rdf:Description rdf:about="&a;100076714"
	 b:glossaryEntry="the act of vaulting"/>
<rdf:Description rdf:about="&a;100076794">
	<b:glossaryEntry>jumping in one spot (as in excitement); "the wailing and jumping up and down exhausted him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100076951">
	<b:glossaryEntry>the act of propelling something (as a ball or shell etc.) in a high arc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100077072">
	<b:glossaryEntry>(football) putting the ball in play by passing it (between the legs) to a back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100077232">
	<b:glossaryEntry>causing something to go; "the cost of sending their children to college"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100077376">
	<b:glossaryEntry>the act of sending a message; causing a message to be transmitted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100077583">
	<b:glossaryEntry>the act of sending on to an ultimate destination; "the forwarding of mail to a new address is done automatically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100077753">
	<b:glossaryEntry>the transmission of a letter; "the postmark indicates the time of mailing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100077891"
	 b:glossaryEntry="propelling something on wheels"/>
<rdf:Description rdf:about="&a;100077986">
	<b:glossaryEntry>the act of firing a projectile; "his shooting was slow but accurate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100078261">
	<b:glossaryEntry>the act of shooting at targets; "they hold a shoot every weekend during the summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100078414"
	 b:glossaryEntry="a return shot; a retaliatory shot"/>
<rdf:Description rdf:about="&a;100078505"
	 b:glossaryEntry="the act of discharging a gun"/>
<rdf:Description rdf:about="&a;100078629">
	<b:glossaryEntry>the discharge of a gun as signal or as a salute in military ceremonies; "a twenty gun salute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100078772"
	 b:glossaryEntry="preparation for the delivery of shellfire on a target"/>
<rdf:Description rdf:about="&a;100078903">
	<b:glossaryEntry>the act of shooting a gun; "the gunfire endangered innocent bystanders"; "they retreated in the face of withering enemy fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100079092"
	 b:glossaryEntry="a shot aimed at a person''s head"/>
<rdf:Description rdf:about="&a;100079178">
	<b:glossaryEntry>the sport of shooting at clay pigeons that are hurled upward in such a way as to simulate the flight of a bird</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100079372"
	 b:glossaryEntry="shooting artillery shells"/>
<rdf:Description rdf:about="&a;100079453">
	<b:glossaryEntry>a fight involving shooting small arms with the intent to kill or frighten</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100079602"
	 b:glossaryEntry="a shot taken at an easy or casual target (as by a pothunter)"/>
<rdf:Description rdf:about="&a;100079716">
	<b:glossaryEntry>the act of putting two things together with no space between them; "at his touch the room filled with lights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100080122">
	<b:glossaryEntry>the act of touching physically; "her fingers came in contact with the light switch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100080362"
	 b:glossaryEntry='the act of rubbing or wiping; "he gave the hood a quick rub"'/>
<rdf:Description rdf:about="&a;100080515"
	 b:glossaryEntry="the act of scuffing (scraping or dragging the feet)"/>
<rdf:Description rdf:about="&a;100080629"
	 b:glossaryEntry="a light touch or stroke"/>
<rdf:Description rdf:about="&a;100080714">
	<b:glossaryEntry>a act of hitting one thing with another; "repeated hitting raised a large bruise"; "after three misses she finally got a hit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100081036"
	 b:glossaryEntry="the act of colliding with something"/>
<rdf:Description rdf:about="&a;100081161">
	<b:glossaryEntry>a sharp collision produced by striking or dashing against something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100081298"
	 b:glossaryEntry="(in baseball) the batter''s attempt to get on base"/>
<rdf:Description rdf:about="&a;100081420"
	 b:glossaryEntry="(in baseball) handling the ball while playing in the field"/>
<rdf:Description rdf:about="&a;100081552"
	 b:glossaryEntry="playing the position of catcher on a baseball team"/>
<rdf:Description rdf:about="&a;100081676"
	 b:glossaryEntry="playing golf"/>
<rdf:Description rdf:about="&a;100081742"
	 b:glossaryEntry="playing the position of pitcher on a baseball team"/>
<rdf:Description rdf:about="&a;100081866">
	<b:glossaryEntry>(baseball) an advance to first base by a batter who receives four balls; "he worked the picher for a base on balls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100082055"
	 b:glossaryEntry='the supreme effort one can make: "they did their best"'/>
<rdf:Description rdf:about="&a;100082178">
	<b:glossaryEntry>the weakest effort or poorest achievement one is capable of: "it was the worst he had ever done on a test"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100082354">
	<b:glossaryEntry>(in baseball) a ball struck with the bat so that it stays between the foul lines on the playing field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100082548">
	<b:glossaryEntry>(in baseball) a ball struck with the bat so that it does not stay between the foul lines on the playing field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100082757">
	<b:glossaryEntry>a glancing contact with the ball off the edge of the cricket bat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100082892">
	<b:glossaryEntry>the act of hitting a baseball lightly without swinging the bat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100083024">
	<b:glossaryEntry>the act of hitting a baseball so that it flies high in the air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100083202"
	 b:glossaryEntry="a long and hard-hit fly ball"/>
<rdf:Description rdf:about="&a;100083282"
	 b:glossaryEntry="a short high fly ball"/>
<rdf:Description rdf:about="&a;100083357"
	 b:glossaryEntry="the act of hitting a baseball along the ground"/>
<rdf:Description rdf:about="&a;100083527"
	 b:glossaryEntry="a grounder that bounces high in the air"/>
<rdf:Description rdf:about="&a;100083627"
	 b:glossaryEntry="a grounder that rolls along the infield"/>
<rdf:Description rdf:about="&a;100083719">
	<b:glossaryEntry>a failure to get on base safely in baseball; "you only get 3 outs per inning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100083901"
	 b:glossaryEntry="an out resulting from a fielding play (not a strikeout)"/>
<rdf:Description rdf:about="&a;100084027"
	 b:glossaryEntry="an out resulting from the batter getting three strikes"/>
<rdf:Description rdf:about="&a;100084137"
	 b:glossaryEntry="(in baseball) an out that advances the base runners"/>
<rdf:Description rdf:about="&a;100084262"
	 b:glossaryEntry="a sacrifice made by hitting a long fly ball"/>
<rdf:Description rdf:about="&a;100084365">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a successful stroke in an athletic contest (especially in baseball); "he came all the way around on Williams'' hit"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100084547">
	<b:glossaryEntry>the successful act of striking a baseball in such a way that the batter reaches base safely</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100084802"
	 b:glossaryEntry="(soccer) the act of hitting the ball with your head"/>
<rdf:Description rdf:about="&a;100084906">
	<b:glossaryEntry>the act of hitting a baseball so that it flies straight out from the batter; "the batter hit a liner to the shortstop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100085108"
	 b:glossaryEntry="a single resulting from a line drive"/>
<rdf:Description rdf:about="&a;100085222"
	 b:glossaryEntry="a double resulting from a line drive"/>
<rdf:Description rdf:about="&a;100085336"
	 b:glossaryEntry="a triple resulting from a line drive"/>
<rdf:Description rdf:about="&a;100085450"
	 b:glossaryEntry="the act of hitting a baseball so that it drops suddenly"/>
<rdf:Description rdf:about="&a;100085586"
	 b:glossaryEntry="a base hit on which the batter scores a run"/>
<rdf:Description rdf:about="&a;100085710"
	 b:glossaryEntry="a home run with no runners on base"/>
<rdf:Description rdf:about="&a;100085814"
	 b:glossaryEntry="a base hit on which the batter stops safely at first base"/>
<rdf:Description rdf:about="&a;100085942">
	<b:glossaryEntry>a base hit on which the batter stops safely at second base; " he hit a double to deep centerfield"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100086151"
	 b:glossaryEntry="a base hit at which the batter stops safely at third base"/>
<rdf:Description rdf:about="&a;100086311"
	 b:glossaryEntry='a sharp slanting blow; "he gave me a clip on the ear"'/>
<rdf:Description rdf:about="&a;100086415"
	 b:glossaryEntry='the act of hitting vigorously; "he gave the table a whack"'/>
<rdf:Description rdf:about="&a;100086554"
	 b:glossaryEntry="a hard blow with a flat object"/>
<rdf:Description rdf:about="&a;100086637"
	 b:glossaryEntry="the act of smacking something"/>
<rdf:Description rdf:about="&a;100086754"
	 b:glossaryEntry="a blow that knocks the opponent off his feet"/>
<rdf:Description rdf:about="&a;100086854"
	 b:glossaryEntry="a blow that renders the opponent unconscious"/>
<rdf:Description rdf:about="&a;100086976">
	<b:glossaryEntry>a knockout declared by the referee who judges one boxer unable to continue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100087121"
	 b:glossaryEntry="a sharp blow"/>
<rdf:Description rdf:about="&a;100087184"
	 b:glossaryEntry="a slap with the flat of the hand"/>
<rdf:Description rdf:about="&a;100087268"
	 b:glossaryEntry="a quick blow with a whip"/>
<rdf:Description rdf:about="&a;100087361"
	 b:glossaryEntry="(boxing) a blow with the fist"/>
<rdf:Description rdf:about="&a;100087553">
	<b:glossaryEntry>a blow with the hand (usually on the ear); "I gave him a good box on the ear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100087680">
	<b:glossaryEntry>the act of touching someone suddenly with your finger or elbow; "she gave me a sharp dig in the ribs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100087837"
	 b:glossaryEntry="a return punch"/>
<rdf:Description rdf:about="&a;100087928">
	<b:glossaryEntry>a hard punch that renders the opponent unable to continue boxing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100088090">
	<b:glossaryEntry>a short swinging punch delivered from the side with the elbow bent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100088225"
	 b:glossaryEntry="a quick short straight punch"/>
<rdf:Description rdf:about="&a;100088303"
	 b:glossaryEntry="a short chopping blow to the back of the neck"/>
<rdf:Description rdf:about="&a;100088407"
	 b:glossaryEntry="a hook delivered with an exaggerated swing"/>
<rdf:Description rdf:about="&a;100088506">
	<b:glossaryEntry>the act of delivering a blow with the foot; "he gave the ball a powerful kick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100088742">
	<b:glossaryEntry>a kick from the center of the field to start a football game or to resume it after a score</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100088904">
	<b:glossaryEntry>(Association football) a kick by the defending side after the attacking side sends the ball over the goal-line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100089070"
	 b:glossaryEntry="(Rugby football) an attempt to kick a goal"/>
<rdf:Description rdf:about="&a;100089168">
	<b:glossaryEntry>kicking in which the football is dropped from the hands and kicked before it touches the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100089324">
	<b:glossaryEntry>a kick (in soccer or football) in which the ball is placed on the ground before kicking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100089520">
	<b:glossaryEntry>(in soccer) a place kick that is allowed for a foul or infringement by the other team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100089679">
	<b:glossaryEntry>a free kick from the corner awarded to the other side when a player has sent the ball behind his own goal line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100089847">
	<b:glossaryEntry>kicking (as for a field goal) in which the football is dropped and kicked as it touches the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100090000">
	<b:glossaryEntry>a light glancing touch; "there was a brief kiss of their hands in passing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100090133"
	 b:glossaryEntry="a caress with the lips"/>
<rdf:Description rdf:about="&a;100090262">
	<b:glossaryEntry>the act of contacting something with your hand; "peonies can be blighted by the laying on of a finger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100090420"
	 b:glossaryEntry="an enthusiastic kiss"/>
<rdf:Description rdf:about="&a;100090519"
	 b:glossaryEntry="a loud kiss"/>
<rdf:Description rdf:about="&a;100090584">
	<b:glossaryEntry>an open-mouthed kiss in which your tongue is inserted into the other''s mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100090742">
	<b:glossaryEntry>the act of catching an object with the hands; "Mays made the catch with his back to the plate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100091019">
	<b:glossaryEntry>a catch of a punt on the fly by a defensive player who has signalled that he will not run and so should not be tackled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100091213">
	<b:glossaryEntry>the act of catching a football by a player on the opposing team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100091354">
	<b:glossaryEntry>the act of catching a pass in football; "the tight end made a great reception on the 20 yard line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100091527">
	<b:glossaryEntry>the act of securing possession of rebounding basketball after a missed shot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100091675"
	 b:glossaryEntry="(baseball) a running catch made near the ground"/>
<rdf:Description rdf:about="&a;100091785">
	<b:glossaryEntry>the act of interlocking or meshing; "an interlocking of arms by the police held the crowd in check"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100091972">
	<b:glossaryEntry>the action of touching with the hands or the skillful use of the hands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100092130">
	<b:glossaryEntry>actively exploring with the hands; "he was feeling for the light switch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100092310"
	 b:glossaryEntry="feeling something with the fingers"/>
<rdf:Description rdf:about="&a;100092400">
	<b:glossaryEntry>an examination and dissection of a dead body to determine cause of death or the changes produced by disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100092615">
	<b:glossaryEntry>the act of inspecting or verifying; "they made a check of their equipment"; "the pilot ran through the check-out procedure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100092823">
	<b:glossaryEntry>a thorough physical examination; includes a variety of tests depending on the age and sex and health of the person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100093090"
	 b:glossaryEntry="examining resemblances or differences"/>
<rdf:Description rdf:about="&a;100093268"
	 b:glossaryEntry="a second (or subsequent) examination"/>
<rdf:Description rdf:about="&a;100093385"
	 b:glossaryEntry="a careful and thorough inspection"/>
<rdf:Description rdf:about="&a;100093475">
	<b:glossaryEntry>a swift cursory examination or inspection; "I gave him the once-over"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100093612">
	<b:glossaryEntry>a method of examination in which the examiner feels the size or shape or firmness or location of something (of body parts when the examiner is a health professional)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100093873"
	 b:glossaryEntry="the act of tickling"/>
<rdf:Description rdf:about="&a;100093956"
	 b:glossaryEntry="a light touch with the hands"/>
<rdf:Description rdf:about="&a;100094066">
	<b:glossaryEntry>a gentle affectionate stroking (or something resembling it); "he showered her with caresses"; "soft music was a fond caress"; "the caresses of the breeze played over his face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100094294"
	 b:glossaryEntry="touching a player in a game"/>
<rdf:Description rdf:about="&a;100094409"
	 b:glossaryEntry="the act of bringing two things into contact"/>
<rdf:Description rdf:about="&a;100094688">
	<b:glossaryEntry>the act of joining by causing your path to intersect your target''s path</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100094818">
	<b:glossaryEntry>the act of bringing near or bringing together especially the cut edges of tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100094984"
	 b:glossaryEntry="the act of linking together as in a series or chain"/>
<rdf:Description rdf:about="&a;100095095"
	 b:glossaryEntry="the act of converging (coming closer)"/>
<rdf:Description rdf:about="&a;100095235">
	<b:glossaryEntry>the act of joining together as one; "the merging of the two groups occurred quickly"; "there was no meeting of minds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100095452"
	 b:glossaryEntry="a coming together of people"/>
<rdf:Description rdf:about="&a;100095548"
	 b:glossaryEntry="a casual meeting with a person of thing"/>
<rdf:Description rdf:about="&a;100095657">
	<b:glossaryEntry>the act of joining things in such a way that motion is possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100095779"
	 b:glossaryEntry="a act of adjoining things"/>
<rdf:Description rdf:about="&a;100095872"
	 b:glossaryEntry="the act of fastening things together"/>
<rdf:Description rdf:about="&a;100096085"
	 b:glossaryEntry="the act of making something less tight"/>
<rdf:Description rdf:about="&a;100096215">
	<b:glossaryEntry>the act of making something tighter; "the tightening of economic controls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100096382"
	 b:glossaryEntry="tying with a ligature (as in surgery)"/>
<rdf:Description rdf:about="&a;100096492">
	<b:glossaryEntry>a sterilization procedure with women; both Fallopian tubes are tied in two places and the tubes removed in between the ligations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100096699"
	 b:glossaryEntry="fastening firmly together"/>
<rdf:Description rdf:about="&a;100096790"
	 b:glossaryEntry="fastening by dowels"/>
<rdf:Description rdf:about="&a;100096864"
	 b:glossaryEntry="fastening electrical equipment to earth"/>
<rdf:Description rdf:about="&a;100096970"
	 b:glossaryEntry="the act of linking things together"/>
<rdf:Description rdf:about="&a;100097058"
	 b:glossaryEntry="the act of tying things together"/>
<rdf:Description rdf:about="&a;100097160">
	<b:glossaryEntry>loosening the ties that fasten something; "the tying of bow ties is an art; the untying is easy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100097334">
	<b:glossaryEntry>fastening two pieces of metal together by softening with heat and applying pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100097489"
	 b:glossaryEntry="creating a butt joint by welding"/>
<rdf:Description rdf:about="&a;100097598">
	<b:glossaryEntry>butt welding by creating an electric arc between the two pieces which melts and joins them; used for joining segments of metal pipe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100097810"
	 b:glossaryEntry="touching with the tongue"/>
<rdf:Description rdf:about="&a;100097891"
	 b:glossaryEntry="the act of brushing against while passing"/>
<rdf:Description rdf:about="&a;100098007"
	 b:glossaryEntry="the act of discovering something"/>
<rdf:Description rdf:about="&a;100098205"
	 b:glossaryEntry="the act of detecting something; catching sight of something"/>
<rdf:Description rdf:about="&a;100098360"
	 b:glossaryEntry="discovering your own individuality"/>
<rdf:Description rdf:about="&a;100098455"
	 b:glossaryEntry="making an important discovery"/>
<rdf:Description rdf:about="&a;100098543"
	 b:glossaryEntry="the act of determining the properties of something"/>
<rdf:Description rdf:about="&a;100098771"
	 b:glossaryEntry="the act of discovering again"/>
<rdf:Description rdf:about="&a;100098857"
	 b:glossaryEntry="the act of designating or identifying something"/>
<rdf:Description rdf:about="&a;100098997"
	 b:glossaryEntry="a system or procedure for identifying persons"/>
<rdf:Description rdf:about="&a;100099105">
	<b:glossaryEntry>the procedure of taking inked impressions of a person''s fingerprints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100099234"
	 b:glossaryEntry="identifying the nature or cause of some phenomenon"/>
<rdf:Description rdf:about="&a;100099389"
	 b:glossaryEntry="determining a person''s blood type by serological methods"/>
<rdf:Description rdf:about="&a;100099504"
	 b:glossaryEntry="identification a disease from its symptoms"/>
<rdf:Description rdf:about="&a;100099666"
	 b:glossaryEntry="a prediction of the course of a disease"/>
<rdf:Description rdf:about="&a;100099792"
	 b:glossaryEntry="finding a solution to a problem"/>
<rdf:Description rdf:about="&a;100099890"
	 b:glossaryEntry="the act of finding or testing the truth of something"/>
<rdf:Description rdf:about="&a;100100102"
	 b:glossaryEntry="validating the authenticity of something or someone"/>
<rdf:Description rdf:about="&a;100100230">
	<b:glossaryEntry>documentary validation; "his documentation of the results was excellent"; "the strongest support for this this view is the work of Jones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100100437">
	<b:glossaryEntry>establishing something (e.g. gold or silver) as the legal tender of a country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100100606">
	<b:glossaryEntry>the act of proving that an instrument purporting to be a will was signed and executed in accord with legal requirements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100100779">
	<b:glossaryEntry>ending something (e.g. gold or silver) as no longer the legal tender of a country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100100956"
	 b:glossaryEntry="the act of determining that something is false"/>
<rdf:Description rdf:about="&a;100101111">
	<b:glossaryEntry>a determination of the location of something; "he got a good fix on the target"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100101310">
	<b:glossaryEntry>determining the location of something by measuring the time it takes for an echo to return from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100101483"
	 b:glossaryEntry="determining again"/>
<rdf:Description rdf:about="&a;100101562"
	 b:glossaryEntry="the act of causing something to happen"/>
<rdf:Description rdf:about="&a;100101756"
	 b:glossaryEntry="an act that sets in motion some course of events"/>
<rdf:Description rdf:about="&a;100101901">
	<b:glossaryEntry>deliberate and intentional triggering (of trouble or discord)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100102045">
	<b:glossaryEntry>using force to cause something: "though pressed into rugby under compulsion I began to enjoy the game"; "they didn`t have to use coercion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100102269"
	 b:glossaryEntry="causing something without any direct or apparent effort"/>
<rdf:Description rdf:about="&a;100102506">
	<b:glossaryEntry>stimulating influence among diverse elements; "the cross-pollination of the arts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100102651">
	<b:glossaryEntry>the act of subjecting someone to an influencing experience; "she denounced the exposure of children to pornography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100102821">
	<b:glossaryEntry>influencing strongly: "they resented the impingement of American values on European culture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100102995">
	<b:glossaryEntry xml:space='preserve'><![CDATA[exerting shrewd or devious influence especially for one''s own advantage; "his manipulation of his friends was scandalous"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100103181"
	 b:glossaryEntry="the act of inducing hypnosis"/>
<rdf:Description rdf:about="&a;100103290">
	<b:glossaryEntry>act of bringing about a desired result: "inducement of sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100103419"
	 b:glossaryEntry="inducement by argument or reasoning or entreaty"/>
<rdf:Description rdf:about="&a;100103541">
	<b:glossaryEntry>the act of influencing by exciting hope or desire; "his enticements were shameless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100103784"
	 b:glossaryEntry="the act of urging by means of teasing or flattery"/>
<rdf:Description rdf:about="&a;100103904">
	<b:glossaryEntry>the act of enticing or alluring; "she was an invitation to trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100104028"
	 b:glossaryEntry="the act of enticing others into sinful ways"/>
<rdf:Description rdf:about="&a;100104146"
	 b:glossaryEntry="enticing someone astray from right behavior"/>
<rdf:Description rdf:about="&a;100104245"
	 b:glossaryEntry="an act of winning the love of someone"/>
<rdf:Description rdf:about="&a;100104367">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a seduction culminating in sexual intercourse; "calling his seduction of the girl a `score'' was a typical example of male slang"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100104565">
	<b:glossaryEntry>the act of enticing a person to do something wrong (as an offer of sex in return for money)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100104728"
	 b:glossaryEntry="deterrence by argument or reasoning or entreaty"/>
<rdf:Description rdf:about="&a;100104850">
	<b:glossaryEntry>the act of choosing or selecting; "your choice of colors was unfortunate"; "you can take your pick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100105129">
	<b:glossaryEntry>the choice of actors to play particular roles in a play or movie</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100105247"
	 b:glossaryEntry="the selection of a suitable sample for study"/>
<rdf:Description rdf:about="&a;100105382">
	<b:glossaryEntry>the selection of a random sample; each element of the population has an equal chance of been selected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100105545">
	<b:glossaryEntry>the population is divided into subpopulations (strata) and random samples are taken of each stratum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100105760">
	<b:glossaryEntry>the act of making up your mind about something; "the burden of decision was his"; "he drew his conclusions quickly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100106049">
	<b:glossaryEntry>the act of making a choice; "followed my father of my own choice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100106179">
	<b:glossaryEntry>a reversal in attitude or principle or point of view: "an about-face on foreign policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100106381">
	<b:glossaryEntry>the act of putting a person into a non-elective position; "the appointment had to be approvied by the whole committee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100106665"
	 b:glossaryEntry="the act of nominating (especially a candidate for election)"/>
<rdf:Description rdf:about="&a;100106794">
	<b:glossaryEntry>the act of distributing something to designated places or persons; "the first task is the assignment of an address to each datum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100107010">
	<b:glossaryEntry>(computer science) the assignment of particular areas of a magnetic disk to particular data or instructions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100107174">
	<b:glossaryEntry>(sports) the decision made by an umpire or referee; "he was ejected for protesting the call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100107317">
	<b:glossaryEntry>the act of appointing summarily (with or without the appointee''s consent)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100107460"
	 b:glossaryEntry="the appointment of a delegate"/>
<rdf:Description rdf:about="&a;100107544"
	 b:glossaryEntry="the act of ordaining"/>
<rdf:Description rdf:about="&a;100107670">
	<b:glossaryEntry>laying hands on a person''s head to invoke spiritual blessing in Christian ordination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100107819">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of deciding to do something; "he didn''t make a move to help"; "his first move was to hire a lawyer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100108013">
	<b:glossaryEntry>(games) a player''s turn to move a piece or take some other permitted action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100108157"
	 b:glossaryEntry="the act of moving a chess piece"/>
<rdf:Description rdf:about="&a;100108354"
	 b:glossaryEntry="interchanging the positions of the king and a rook"/>
<rdf:Description rdf:about="&a;100108468"
	 b:glossaryEntry="the removal of an opponent''s piece from the chess board"/>
<rdf:Description rdf:about="&a;100108577"
	 b:glossaryEntry="(chess) a direct attack on an opponent''s king"/>
<rdf:Description rdf:about="&a;100108692">
	<b:glossaryEntry>a check on the opponent''s king that is delivered by moving a piece out of the line of attack by a queen or rook or bishop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100108876">
	<b:glossaryEntry>a move constituting an inescapable and indefensible attack on the opponent''s king</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100109013">
	<b:glossaryEntry>a chess move early in the game in which the player sacrifices minor pieces in order to obtain an advantageous position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100109184"
	 b:glossaryEntry="a diplomatic move"/>
<rdf:Description rdf:about="&a;100109256"
	 b:glossaryEntry="a move made to gain a tactical end"/>
<rdf:Description rdf:about="&a;100109535">
	<b:glossaryEntry>the act of maneuvering a vehicle into a location where it can be left temporarily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100109670">
	<b:glossaryEntry>the act of changing your residence or place of business; "they say that three moves equal one fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100109838">
	<b:glossaryEntry>a secret move (to avoid paying debts); "they did a moonlight flit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100109955">
	<b:glossaryEntry>a flight maneuver; aircraft tips laterally about its longitudinal axis (especially in turning)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100110118">
	<b:glossaryEntry>a bank so steep that the plane''s lateral axis approaches the vertical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100110247">
	<b:glossaryEntry>a flight maneuver; aircraft flies a complete circle in the vertical plane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100110371">
	<b:glossaryEntry>a flight maneuver; aircraft rotates about its longitudinal axis without changing direction or losing altitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100110567"
	 b:glossaryEntry="a roll in which the plane follows a spiral course"/>
<rdf:Description rdf:about="&a;100110674"
	 b:glossaryEntry="a fast roll"/>
<rdf:Description rdf:about="&a;100110741"
	 b:glossaryEntry="a flight maneuver; aircraft slides sideways in the air"/>
<rdf:Description rdf:about="&a;100110857"
	 b:glossaryEntry="an evasive maneuver by an aircraft"/>
<rdf:Description rdf:about="&a;100111045">
	<b:glossaryEntry>(football) the act of warding off a tackler by holding the arm fully extended with the hand against the opponent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100111216">
	<b:glossaryEntry>any clever (deceptive) maneuver; "he would stoop to any device to win a point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100111383">
	<b:glossaryEntry>a cunning or deceitful action or device; "he played a trick on me"; "he pulled a fast one and got away with it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100111557"
	 b:glossaryEntry="any distracting maneuver (as a mock attack)"/>
<rdf:Description rdf:about="&a;100111652"
	 b:glossaryEntry="a maneuver in a game or conversation"/>
<rdf:Description rdf:about="&a;100111760"
	 b:glossaryEntry="a deceptive maneuver (especially to avoid capture)"/>
<rdf:Description rdf:about="&a;100111872">
	<b:glossaryEntry>how a result is obtained or an end is achieved; "a means of communcation"; "an example is the best agency of instruction"; "the true way to success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100112303">
	<b:glossaryEntry>interchangeable with `means'' in the expression `by dint of''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100112413">
	<b:glossaryEntry>a means or way of escaping; "hard work was his escape from worry"; "they installed a second hatch as an escape"; "their escape route"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100112599">
	<b:glossaryEntry>the means whereby something is accomplished; "my greed was the instrument of my destruction" or "science has given us new tools to fight disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100112808"
	 b:glossaryEntry='a way or means to achieve something; "the road to fame"'/>
<rdf:Description rdf:about="&a;100112932">
	<b:glossaryEntry>an auspicious way or means to achieve something: "the royal road to success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100113065">
	<b:glossaryEntry>any means of advancement; "the job was just a stepping stone on his way to fame and riches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100113217">
	<b:glossaryEntry>any maneuver made as part of progress toward a goal; "the police took steps to reduce crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100113406"
	 b:glossaryEntry="an action taken to offset another action"/>
<rdf:Description rdf:about="&a;100113525">
	<b:glossaryEntry>a takeover bid so attractive that the directors of the target company must approve it or risk shareholder protest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100113693">
	<b:glossaryEntry>a measure used by an acquirer to gain control of a takeover target; acquirer tries to persuade other shareholders that the management of the target should be replaced</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100113917">
	<b:glossaryEntry>a buyout using borrowed money; the target company''s assets are usually security for the loan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100114090">
	<b:glossaryEntry>a leveraged buyout in which the target company''s assets are sold to repay the loan that financed the takeover</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100114262">
	<b:glossaryEntry>a measure undertaken by a corporation to discourage unwanted takeover attempts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100114532">
	<b:glossaryEntry>giving top executives lucrative benefits that must be paid by the acquirer if they are discharged after a takeover</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100114709">
	<b:glossaryEntry>paying the raider to give up a takeover attempt (as by an extravagant buyback of the stock they hold in your corporation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100114886">
	<b:glossaryEntry>the target company defends itself by threatening to take over its acquirer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100115023">
	<b:glossaryEntry>the target company defends itself by making its stock less attractive to an acquirer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100115183">
	<b:glossaryEntry>a poison pill with potentially catastrophic implications for the company it is intended to protect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100115340">
	<b:glossaryEntry>the target company defends itself by acquiring a company so onerously regulated that it makes the target less attractive (gives it a safe harbor)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100115543">
	<b:glossaryEntry>the target company defends itself by selling off its crown jewels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100115676"
	 b:glossaryEntry="a procedure followed in making a medical diagnosis"/>
<rdf:Description rdf:about="&a;100115902">
	<b:glossaryEntry>a means to an end; not necessarily a principled or ethical one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100116092">
	<b:glossaryEntry>a procedure adopted to meet an emergency (especially a medical emergency)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100116303"
	 b:glossaryEntry="something contrived to meet an urgent need or emergency"/>
<rdf:Description rdf:about="&a;100116424">
	<b:glossaryEntry>anything that serves as an expedient; "he uses drugs as a psychological crutch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100116556"
	 b:glossaryEntry="an unplanned expedient"/>
<rdf:Description rdf:about="&a;100116660"
	 b:glossaryEntry="French for `worst going''"/>
<rdf:Description rdf:about="&a;100116754">
	<b:glossaryEntry>desperate actions taken as a means to an end; "he had to resort to desperate measures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100116904"
	 b:glossaryEntry="any very successful means of achieving a result"/>
<rdf:Description rdf:about="&a;100117009">
	<b:glossaryEntry>a means of preserving from harm or unpleasantness; "tourism was their economic salvation"; "they turned to individualism as their salvation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100117205"
	 b:glossaryEntry='a means of enforcement; "the treaty had no teeth in it"'/>
<rdf:Description rdf:about="&a;100117312">
	<b:glossaryEntry>a means or agency by which something is expressed or communicated; "the voice of the law"; "the Times is not the voice of New York"; "conservatism has many voices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100117527">
	<b:glossaryEntry>a means of flight or ascent; "necessity lends wings to inspiration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100117646">
	<b:glossaryEntry>making a chance decision by using lots (straws or pebbles etc.) that are thrown or drawn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100117820">
	<b:glossaryEntry>the act of accepting with approval; favorable reception; "its adoption by society"; "the proposal found wide acceptance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100118026">
	<b:glossaryEntry>a close affectionate and protective acceptance; "his willing embrace of new ideas"; "in the bosom of the family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100118200">
	<b:glossaryEntry>the act of selecting someone; "many candidates ran for election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100118337">
	<b:glossaryEntry>the selection of a new member (usually by a vote of the existing membership)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100118483"
	 b:glossaryEntry='election again; "he did not run for reelection"'/>
<rdf:Description rdf:about="&a;100118587">
	<b:glossaryEntry>a vote by the electorate determining public opinion on a question of national importance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100118732">
	<b:glossaryEntry>a legislative act is referred for final approval to a popular vote by the electorate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100118873"
	 b:glossaryEntry="a vote to select the winner of a political office"/>
<rdf:Description rdf:about="&a;100119067">
	<b:glossaryEntry>the opinion of a group as determined by voting; "they put the question to a vote"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100119253">
	<b:glossaryEntry>a national or state election; candidates are chosen in all constituencies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100119389">
	<b:glossaryEntry>a preliminary election where delegates or nominees are chosen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100119541">
	<b:glossaryEntry>a primary where voters directly select the candidates who will run for office</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100119715">
	<b:glossaryEntry>a primary in which only registered members of a particular political party can vote; "closed primaries strengthen party unity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100119902">
	<b:glossaryEntry>a primary in which any registered voter can vote (but must vote for candidates of only one party)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100120058"
	 b:glossaryEntry="a special election between regular elections"/>
<rdf:Description rdf:about="&a;100120175">
	<b:glossaryEntry>a final election to resolve an earlier election that did not produce a winner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100120305">
	<b:glossaryEntry>a choice that is made by voting; "there were only 17 votes in favor of the motion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100120576">
	<b:glossaryEntry>a vote in which each person''s choice is secret by the totaled votes are public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100120714">
	<b:glossaryEntry>a ballot cast by a voter who votes for candidates from more than one party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100120865">
	<b:glossaryEntry>a ballot cast by a voter who votes for all the candidates of one party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100121015">
	<b:glossaryEntry>voting in more than one place by the same person at the same election (illegal in U.S.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100121164">
	<b:glossaryEntry>the deciding vote cast by the presiding officer to resolve a tie</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100121287"
	 b:glossaryEntry="the act of making equal or uniform"/>
<rdf:Description rdf:about="&a;100121442">
	<b:glossaryEntry>getting two things to correspond; "the reconciliation of his checkbook and the bank statement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100121609"
	 b:glossaryEntry="the act of regarding as equal"/>
<rdf:Description rdf:about="&a;100121704">
	<b:glossaryEntry>the act of digging up something (especially a corpse) that has been buried</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100121863"
	 b:glossaryEntry="the act of delivering a child"/>
<rdf:Description rdf:about="&a;100122025"
	 b:glossaryEntry="assisting women at childbirth"/>
<rdf:Description rdf:about="&a;100122110">
	<b:glossaryEntry>the delivery of a fetus by surgical incision through the abdominal wall and uterus (from the belief that Julius Caesar was born that way)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100122416">
	<b:glossaryEntry>the act of scoring in a game or sport; "the winning score came with less than a minute left to play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100122802"
	 b:glossaryEntry="the score in a bowling match"/>
<rdf:Description rdf:about="&a;100122890">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in target shooting: a score made by hitting the center of the target; "in repeated sets of five shots his numbers of bull''s-eyes varied"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100123083">
	<b:glossaryEntry>a successful attempt at scoring; "the winning goal came with less than a minute left to play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100123227">
	<b:glossaryEntry>a score in tenpins: knocking down all ten with the first ball; "he finished with three strikes in the tenth frame"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100123407">
	<b:glossaryEntry>a score in tenpins; knocking down all ten after rolling two balls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100123524">
	<b:glossaryEntry>any frame in which a bowler fails to make a strike or spare; "the break in the eighth frame cost him the match"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100123700"
	 b:glossaryEntry="the score in a football game"/>
<rdf:Description rdf:about="&a;100123789">
	<b:glossaryEntry>(American football) a play in which the opposing team has kicked the football into your end zone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100123941">
	<b:glossaryEntry>a score in American football; a player is tackled behind his own goal line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100124068">
	<b:glossaryEntry>a score in American football; being in possession of the ball across the opponents'' goal line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100124217">
	<b:glossaryEntry>a score in American football; a score made by kicking the ball between the opponents'' goal posts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100124370">
	<b:glossaryEntry>a score in American football made on a try for points after a touchdown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100124527"
	 b:glossaryEntry="the score of a baseball game"/>
<rdf:Description rdf:about="&a;100124616">
	<b:glossaryEntry>a score in baseball made by a runner touching all four bases safely; "the Yankees scored 3 runs in the bottom of the 9th" or "their first tally came in the 3rd inning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100124895">
	<b:glossaryEntry>a run that was not scored as the result of an error by the other team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100125039">
	<b:glossaryEntry>a run that was scored as a result of an error by the other team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100125179">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a run that is the result of the batter''s performance; "he had more than 100 rbi last season"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100125337"
	 b:glossaryEntry="the score in a basketball game"/>
<rdf:Description rdf:about="&a;100125430">
	<b:glossaryEntry>a score in basketball made by throwing the ball through the hoop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100125560"
	 b:glossaryEntry="a difficult or unusual feat; usually done to gain attention"/>
<rdf:Description rdf:about="&a;100125689">
	<b:glossaryEntry>the act of changing something; "the change of government had no impact on the economy"; "his change on abortion cost him the election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100126290"
	 b:glossaryEntry="the act of reducing complexity"/>
<rdf:Description rdf:about="&a;100126393">
	<b:glossaryEntry>an act of economizing; reduction in cost; "it was a small economy to walk to work every day" or "there was a saving of 50 cents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100126620">
	<b:glossaryEntry>the reduction of expenditures in order to become financial stable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100126771">
	<b:glossaryEntry>reduction in cost of production due to a large number of items produced</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100126907">
	<b:glossaryEntry>(physiology) the automatic adjustment in focal length of the lens of the eye</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100127097">
	<b:glossaryEntry>(physiology) the responsive adjustment of a sense organ (as the eye) to varying conditions (as of light)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100127258">
	<b:glossaryEntry>the action of taking up as by tightening or absorption or reeling in</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100127380"
	 b:glossaryEntry="the act of adjusting again (to changed circumstances)"/>
<rdf:Description rdf:about="&a;100127492">
	<b:glossaryEntry>accommodation to domestic life; "her explorer husband resisted all her attempts at domestication"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100127649">
	<b:glossaryEntry>the act of changing to a decimal system; "the decimalization of British currency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100127808">
	<b:glossaryEntry>the act of changing from imperial units of measurement to metric units: meters, grams, seconds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100127976">
	<b:glossaryEntry>a general accommodation to unchanging environmental conditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100128096">
	<b:glossaryEntry>an activity that varies from a norm or standard; "any variation in his routine was immediately reported"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100128267">
	<b:glossaryEntry>act of changing in practice or custom: "the law took many turnings over the years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100128403">
	<b:glossaryEntry>the act of diversifying (introducing variety); "my broker recommended a greater diversification of my investments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100128579"
	 b:glossaryEntry='in constant change: "his opinions are in flux"'/>
<rdf:Description rdf:about="&a;100128676">
	<b:glossaryEntry>the act of changing one thing or position for another; "his switch on abortion cost him the election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100128868"
	 b:glossaryEntry="a sudden unexpected switch"/>
<rdf:Description rdf:about="&a;100128951">
	<b:glossaryEntry>the act of putting one one thing or person in the place of another: "he sent Smith in for Jones but the substitution came too late to help</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100129213">
	<b:glossaryEntry>the act of furnishing an equivalent person or thing in the place of another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100129412"
	 b:glossaryEntry="replacing a pitcher in baseball"/>
<rdf:Description rdf:about="&a;100129505">
	<b:glossaryEntry>act of replacing one person or thing by another especially one held to be superior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100129660">
	<b:glossaryEntry>act of taking the place of another especially using underhanded tactics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100129804"
	 b:glossaryEntry="the substitution of one method of payment for another"/>
<rdf:Description rdf:about="&a;100129915">
	<b:glossaryEntry>the act of substituting other food for the mother''s milk in the diet of a child or young mammal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100130078"
	 b:glossaryEntry="act of raising in rank or position"/>
<rdf:Description rdf:about="&a;100130222">
	<b:glossaryEntry>the act of preferring; "the preferment went to the younger candidate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100130362"
	 b:glossaryEntry="act of lowering in rank or position"/>
<rdf:Description rdf:about="&a;100130470">
	<b:glossaryEntry>the act of changing something into something different in essential characteristics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100131083">
	<b:glossaryEntry>the act of making something different (as e.g. the size of a garment)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100131327">
	<b:glossaryEntry>the act of distracting; drawing someone''s attention away from something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100131456">
	<b:glossaryEntry>the act of charging a liquid with a gas making it effervescent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100131573">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of modification or changing the strength of some idea; "his new position involves a qualification of his party''s platform"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100131763"
	 b:glossaryEntry="the act of passing from one stage to the next"/>
<rdf:Description rdf:about="&a;100131893"
	 b:glossaryEntry="becoming inflexible or out of date"/>
<rdf:Description rdf:about="&a;100131987"
	 b:glossaryEntry="altering something secretly or improperly"/>
<rdf:Description rdf:about="&a;100132095">
	<b:glossaryEntry>the act of transfering something from one form to another; "the transfer of the music from record to tape suppressed much of the background noise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100132311">
	<b:glossaryEntry>the action of opposing something that you disapprove or disagree with; "he encountered a general feeling of resistance from many citizens"; "despite opposition from the newspapers he went ahead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100132629">
	<b:glossaryEntry>a management action resisting employee''s demands; employees are barred from entering the workplace until they agree to terms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100132807">
	<b:glossaryEntry xml:space='preserve'><![CDATA[doing something in opposition to another way of doing it that you don''t like; "his style of painting was a reaction against cubism"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100133011">
	<b:glossaryEntry>an adverse reaction to some political or social occurrence; "there was a backlash of intolerance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100133181">
	<b:glossaryEntry>backlash by white racists against black civil rights advances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100133315">
	<b:glossaryEntry>the act of rejecting something; "his proposals were met with rejection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100133568"
	 b:glossaryEntry="a curt or disdainful rejection"/>
<rdf:Description rdf:about="&a;100133654"
	 b:glossaryEntry="deliberately avoiding"/>
<rdf:Description rdf:about="&a;100133803">
	<b:glossaryEntry>the act of turning away; "averting her gaze means that she must be angry with me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100133939">
	<b:glossaryEntry>an avoidance of danger or difficulty; "that was a narrow escape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100134056"
	 b:glossaryEntry="the act of giving something up"/>
<rdf:Description rdf:about="&a;100134222">
	<b:glossaryEntry>abandoning without shelter or protection (as by leaving as infant out in the open)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100134359"
	 b:glossaryEntry="the act of abandoning a party or cause"/>
<rdf:Description rdf:about="&a;100134469"
	 b:glossaryEntry="a sudden abandonment (as from a political party)"/>
<rdf:Description rdf:about="&a;100134568"
	 b:glossaryEntry="the act of renouncing"/>
<rdf:Description rdf:about="&a;100134709">
	<b:glossaryEntry>the act of refusing an offer; "the turndown was polite but very firm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100134849"
	 b:glossaryEntry="the act of forsaking"/>
<rdf:Description rdf:about="&a;100134937">
	<b:glossaryEntry>renunciation of your own interests in favor of the interests of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100135125">
	<b:glossaryEntry>the act of losing or surrendering something as a penalty for a mistake or fault or failure to perform etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100135310">
	<b:glossaryEntry>a group''s refusal to have commercial dealings with some organization in protest against its policies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100135464"
	 b:glossaryEntry="the act of banishing someone"/>
<rdf:Description rdf:about="&a;100135654"
	 b:glossaryEntry="the act of expelling a lawyer from the practice of law"/>
<rdf:Description rdf:about="&a;100135765"
	 b:glossaryEntry="the act of expelling someone"/>
<rdf:Description rdf:about="&a;100135937"
	 b:glossaryEntry="the act of excluding someone from society by general consent"/>
<rdf:Description rdf:about="&a;100136053"
	 b:glossaryEntry="the act of excluding someone by a negative vote or veto"/>
<rdf:Description rdf:about="&a;100136174"
	 b:glossaryEntry="the act of expelling a person from their native land"/>
<rdf:Description rdf:about="&a;100136307">
	<b:glossaryEntry>the act of banishing a member of the Church from the communion of believers and the privileges of the Church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100136477">
	<b:glossaryEntry>mild banishment; consignment to an inferior position; "he has been relegated to a post in Siberia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100136632"
	 b:glossaryEntry="the act of ejecting someone or forcing them out"/>
<rdf:Description rdf:about="&a;100136760"
	 b:glossaryEntry="the act of deposing someone"/>
<rdf:Description rdf:about="&a;100136859"
	 b:glossaryEntry="a temporary debarment (from a privilege or position etc)"/>
<rdf:Description rdf:about="&a;100136992"
	 b:glossaryEntry="act of removing from office or employment"/>
<rdf:Description rdf:about="&a;100137092"
	 b:glossaryEntry="a vote that blocks a decision"/>
<rdf:Description rdf:about="&a;100137190"
	 b:glossaryEntry="indirect veto of legislation by refusing to sign it"/>
<rdf:Description rdf:about="&a;100137299">
	<b:glossaryEntry>the act of ending something; "the termination of the agreement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100137802">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of finishing; "the speaker''s finish was greeted with applause"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100137955">
	<b:glossaryEntry>(music) the act or manner of terminating a musical phrase or tone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100138106"
	 b:glossaryEntry="a concluding action"/>
<rdf:Description rdf:about="&a;100138296"
	 b:glossaryEntry="the act of finalizing"/>
<rdf:Description rdf:about="&a;100138391">
	<b:glossaryEntry>carrying something to full completion; "I appreciated his follow-through on his promise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100138540"
	 b:glossaryEntry="the successful completion of a program of study"/>
<rdf:Description rdf:about="&a;100138644"
	 b:glossaryEntry="withdrawal from your position or occupation"/>
<rdf:Description rdf:about="&a;100138780">
	<b:glossaryEntry>the act of retiring into inactivity; "he emerged from his hibernation to make his first appearance in several years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100138954"
	 b:glossaryEntry="a final appearance or performance before retirement"/>
<rdf:Description rdf:about="&a;100139061"
	 b:glossaryEntry="the act of relinquishing"/>
<rdf:Description rdf:about="&a;100139216"
	 b:glossaryEntry="the act of ceding"/>
<rdf:Description rdf:about="&a;100139314">
	<b:glossaryEntry>act of relinquishing property or authority etc: "the handover of occupied territory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100139453"
	 b:glossaryEntry="the delivery of a principal into lawful custody"/>
<rdf:Description rdf:about="&a;100139574">
	<b:glossaryEntry>the surrender of an accused or convicted person by one state or country to another (usually under the provisions of a statute or treaty)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100139768"
	 b:glossaryEntry="a formal written statement of relinquishment"/>
<rdf:Description rdf:about="&a;100139905">
	<b:glossaryEntry>an act exempting someone; "he was granted immunity from prosecution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100140078">
	<b:glossaryEntry>an exemption granted after influence (e.g., money) is brought to bear; "collusion resulted in tax fixes for gamblers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100140245"
	 b:glossaryEntry="the termination of a relationship"/>
<rdf:Description rdf:about="&a;100140364">
	<b:glossaryEntry>the termination of a ruler or institution (especially by force)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100140501"
	 b:glossaryEntry="the act of overthrowing a legally constituted government"/>
<rdf:Description rdf:about="&a;100140614"
	 b:glossaryEntry="the termination of a meeting"/>
<rdf:Description rdf:about="&a;100140714"
	 b:glossaryEntry="the act of terminating someone''s employment"/>
<rdf:Description rdf:about="&a;100140964"
	 b:glossaryEntry="an abrupt and unceremonious dismissal"/>
<rdf:Description rdf:about="&a;100141053"
	 b:glossaryEntry="dismissal from office"/>
<rdf:Description rdf:about="&a;100141128"
	 b:glossaryEntry="termination by an act of destruction"/>
<rdf:Description rdf:about="&a;100141434"
	 b:glossaryEntry="an act that has disastrous consequences"/>
<rdf:Description rdf:about="&a;100141528">
	<b:glossaryEntry>the destruction of an enemy plane or ship or tank or missile; "the pilot reported two kills during the mission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100141690"
	 b:glossaryEntry="destruction achieved by wrecking something"/>
<rdf:Description rdf:about="&a;100141831"
	 b:glossaryEntry="complete destruction of a building"/>
<rdf:Description rdf:about="&a;100141958"
	 b:glossaryEntry="destruction by annihilating something"/>
<rdf:Description rdf:about="&a;100142123">
	<b:glossaryEntry>destroying or killing a great proportion of the population (literally every tenth person)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100142269"
	 b:glossaryEntry="annihilation by reducing something to atoms"/>
<rdf:Description rdf:about="&a;100142384"
	 b:glossaryEntry="annihilation by pulverizing something"/>
<rdf:Description rdf:about="&a;100142497"
	 b:glossaryEntry="annihilation by vaporizing something"/>
<rdf:Description rdf:about="&a;100142607"
	 b:glossaryEntry="the act of terminating a life"/>
<rdf:Description rdf:about="&a;100143076"
	 b:glossaryEntry="the blow that kills (usually mercifully)"/>
<rdf:Description rdf:about="&a;100143188"
	 b:glossaryEntry='the act of killing; "he had two deaths on his conscience"'/>
<rdf:Description rdf:about="&a;100143297">
	<b:glossaryEntry>the act of killing someone painlessly (especially someone suffering from an incurable illness)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100143464"
	 b:glossaryEntry="unlawful killing of a human being without malice"/>
<rdf:Description rdf:about="&a;100143589"
	 b:glossaryEntry="unlawful premeditated killing of a human being"/>
<rdf:Description rdf:about="&a;100143925">
	<b:glossaryEntry>the shedding of blood resulting in murder; "he avenged the blood of his kinsmen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100144076"
	 b:glossaryEntry="unpremeditated killing of a human being in self defense"/>
<rdf:Description rdf:about="&a;100144191"
	 b:glossaryEntry="murder of your own parents"/>
<rdf:Description rdf:about="&a;100144309"
	 b:glossaryEntry="murder of your mother"/>
<rdf:Description rdf:about="&a;100144386"
	 b:glossaryEntry="murder of your father"/>
<rdf:Description rdf:about="&a;100144463"
	 b:glossaryEntry="the murder or execution of someone"/>
<rdf:Description rdf:about="&a;100144563"
	 b:glossaryEntry="the act of felling something (as a tree)"/>
<rdf:Description rdf:about="&a;100144654"
	 b:glossaryEntry="killing as a sacrificial act"/>
<rdf:Description rdf:about="&a;100144739"
	 b:glossaryEntry="killing yourself"/>
<rdf:Description rdf:about="&a;100144920">
	<b:glossaryEntry>suicide of a terminally ill person that involves an assistant who serves to make dying as painless and dignified as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100145107"
	 b:glossaryEntry="an act of deliberate self destruction"/>
<rdf:Description rdf:about="&a;100145201"
	 b:glossaryEntry="(Japan) ritual suicide by self-disembowlment on a sword"/>
<rdf:Description rdf:about="&a;100145322">
	<b:glossaryEntry>the act of a Hindu widow willingly cremating herself on the funeral pyre of her dead husband</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100145467"
	 b:glossaryEntry="the murder of a competitor"/>
<rdf:Description rdf:about="&a;100145565"
	 b:glossaryEntry="the killing of animals (as for food)"/>
<rdf:Description rdf:about="&a;100145676"
	 b:glossaryEntry="the savage and excessive killing of people"/>
<rdf:Description rdf:about="&a;100145813"
	 b:glossaryEntry="indiscriminate slaughter"/>
<rdf:Description rdf:about="&a;100145929"
	 b:glossaryEntry="putting to death by mob action without due process of law"/>
<rdf:Description rdf:about="&a;100146041"
	 b:glossaryEntry="killing by the administration of poison"/>
<rdf:Description rdf:about="&a;100146154"
	 b:glossaryEntry="the deliberate act of poisoning someone with gas"/>
<rdf:Description rdf:about="&a;100146256"
	 b:glossaryEntry="the act of killing a king"/>
<rdf:Description rdf:about="&a;100146336"
	 b:glossaryEntry="killing by gunfire"/>
<rdf:Description rdf:about="&a;100146445"
	 b:glossaryEntry="shooting someone from a car as it is driven past the victim"/>
<rdf:Description rdf:about="&a;100146568"
	 b:glossaryEntry="shooting game birds that are flying (on the wing)"/>
<rdf:Description rdf:about="&a;100146677"
	 b:glossaryEntry="killing by depriving of oxygen"/>
<rdf:Description rdf:about="&a;100146798">
	<b:glossaryEntry>the act of suffocating by constricting the windpipe; "no evidence that the choking was done by the accused"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100147001">
	<b:glossaryEntry>(pathology) sudden constriction of a hollow organ (as a blood vessel)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100147158">
	<b:glossaryEntry>a spasm of the bronchi that makes exhalation difficult and noisy; associated with asthma and bronchitis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100147358">
	<b:glossaryEntry>a spasm of the cardiac sphincter (between the esophagus and the stomach); if the cardiac sphincter does not relax during swallowing the passage of food into the stomach is obstructed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100147598">
	<b:glossaryEntry>(pathology) constriction of a body part so as to cut off the flow of blood or other fluid: "strangulation of the intestine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100147781">
	<b:glossaryEntry>the act of killing (an animal or person) in order to propitiate a deity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100147961">
	<b:glossaryEntry>a great sacrifice; an ancient Greek or Roman sacrifice of 100 oxen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100148082"
	 b:glossaryEntry="to kill as a sacrifice by fire"/>
<rdf:Description rdf:about="&a;100148169"
	 b:glossaryEntry="killing by electric shock"/>
<rdf:Description rdf:about="&a;100148254"
	 b:glossaryEntry="killing by cutting off the head"/>
<rdf:Description rdf:about="&a;100148356"
	 b:glossaryEntry="the act of abolishing"/>
<rdf:Description rdf:about="&a;100148447"
	 b:glossaryEntry="terminating a business operation"/>
<rdf:Description rdf:about="&a;100148568">
	<b:glossaryEntry>sale of an insurance policy by a terminally ill policy holder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100148717"
	 b:glossaryEntry="the termination of drug taking"/>
<rdf:Description rdf:about="&a;100148822"
	 b:glossaryEntry="termination of operations"/>
<rdf:Description rdf:about="&a;100148988"
	 b:glossaryEntry="act of shutting down operation of a plant"/>
<rdf:Description rdf:about="&a;100149089">
	<b:glossaryEntry>act of closing down a bank because of a fiscal emergency or failure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100149215"
	 b:glossaryEntry="the act of laying off an employee or a work force"/>
<rdf:Description rdf:about="&a;100149317">
	<b:glossaryEntry>the act of extinguishing; causing to stop burning; "the extinction of the lights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100149483"
	 b:glossaryEntry="gradually ceasing to be visible"/>
<rdf:Description rdf:about="&a;100149581"
	 b:glossaryEntry="termination of pregnancy"/>
<rdf:Description rdf:about="&a;100149696"
	 b:glossaryEntry="a natural loss of the products of conception"/>
<rdf:Description rdf:about="&a;100149906"
	 b:glossaryEntry="repeated spontaneous abortion (often for no known reason)"/>
<rdf:Description rdf:about="&a;100150027">
	<b:glossaryEntry>the appearance of symptoms that signal the impending loss of the products of conception</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100150178">
	<b:glossaryEntry>termination of pregnancy without expulsion of all of the products of conception</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100150342"
	 b:glossaryEntry="a deliberate termination of pregnancy"/>
<rdf:Description rdf:about="&a;100150496"
	 b:glossaryEntry="the act of destroying a fetus"/>
<rdf:Description rdf:about="&a;100150593">
	<b:glossaryEntry>a legally induced abortion for medical reasons (as when the mother''s life is threatened)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100150748">
	<b:glossaryEntry>the act of nullifying; making null and void; counteracting the effect or force of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100150989"
	 b:glossaryEntry="an official or legal cancellation"/>
<rdf:Description rdf:about="&a;100151154"
	 b:glossaryEntry="the act of cancelling; calling off some arrangement"/>
<rdf:Description rdf:about="&a;100151318"
	 b:glossaryEntry="the act of cancelling a debt as uncollectible"/>
<rdf:Description rdf:about="&a;100151419"
	 b:glossaryEntry="cancellation of civil rights"/>
<rdf:Description rdf:about="&a;100151517">
	<b:glossaryEntry>cancellation of a contract and the return of the parties to the positions they would have had if the contract had not been made</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100151726">
	<b:glossaryEntry>nullification by the destruction of the legal force; rendering null; "the vitiation of the contract"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100151882">
	<b:glossaryEntry>action intended to nullify the effects of some previous action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100152038"
	 b:glossaryEntry="the act of deactivating or making ineffective (as a bomb)"/>
<rdf:Description rdf:about="&a;100152183"
	 b:glossaryEntry="breaking up a military unit (by transfers or discharges)"/>
<rdf:Description rdf:about="&a;100152313">
	<b:glossaryEntry>a discharge from the US Army for a grave offense (as sabotage or espionage or cowardice or murder)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100152480">
	<b:glossaryEntry>a discharge from the US Army based on unfitness or character traits deemed undesirable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100152626">
	<b:glossaryEntry>action intended to keep a country politically neutral or exclude it from a possible war; "the neutralization of Belgium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100152824">
	<b:glossaryEntry>a change from one state to the opposite state; "there was a reversal of autonomic function"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100152988">
	<b:glossaryEntry>an act that makes a previous act of no effect (as if not done)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100153104"
	 b:glossaryEntry="returning to a former state"/>
<rdf:Description rdf:about="&a;100153241">
	<b:glossaryEntry>the act of starting something; "he was responsible for the beginning of negotiations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100153747"
	 b:glossaryEntry="starting something for the first time"/>
<rdf:Description rdf:about="&a;100153919">
	<b:glossaryEntry>the act of installing something (as equipment); "the telephone installation took only a few minutes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100154105">
	<b:glossaryEntry>(theology) God''s act of bringing the universe into existence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100154220">
	<b:glossaryEntry>a turn to be in a game at the beginning; "he missed his starting turn because of an injury"; "he got his start because the regular quarterback was in the hospital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100154446">
	<b:glossaryEntry>the act of starting a new operation or practice; "he opposed the inauguration of fluoridation"; "the startup of the new factory was delayed by strikes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100154666">
	<b:glossaryEntry>the act of setting in operation; "repeated shutdowns and startups are expensive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100154800">
	<b:glossaryEntry>the act of forming something; "the constitution of a PTA group"; "he still remembers the establishment of the hospital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100155072"
	 b:glossaryEntry="act of forming labor unions"/>
<rdf:Description rdf:about="&a;100155173">
	<b:glossaryEntry>the act of arousing; "the purpose of art is the arousal of emotions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100155413">
	<b:glossaryEntry>a signal to get up in the morning; in the military it is a bugle call at sunrise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100155548">
	<b:glossaryEntry>the act of beginning something new; "they looked forward to the debut of their new product line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100155780">
	<b:glossaryEntry>the introduction of something new; "it signalled the ushering in of a new era"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100155916">
	<b:glossaryEntry>the ceremonial induction into a position; "the new president obviously enjoyed his inauguration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100156102">
	<b:glossaryEntry>the first of a series of actions; "he memorized all the important chess openings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100156314"
	 b:glossaryEntry="any preliminary activity"/>
<rdf:Description rdf:about="&a;100156399">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the initial stage in accomplishing something; "we didn''t get to first base with that approach"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100156550"
	 b:glossaryEntry="the act of attaining a new office or right"/>
<rdf:Description rdf:about="&a;100156664"
	 b:glossaryEntry="a decisive manner of beginning a musical tone or phrase"/>
<rdf:Description rdf:about="&a;100156789"
	 b:glossaryEntry="the act of taking occupancy"/>
<rdf:Description rdf:about="&a;100156897"
	 b:glossaryEntry="making active and effective (as a bomb)"/>
<rdf:Description rdf:about="&a;100157011"
	 b:glossaryEntry="beginning again"/>
<rdf:Description rdf:about="&a;100157100">
	<b:glossaryEntry>the act of preparing something (as food) by the application of heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100157413"
	 b:glossaryEntry="cooking (bread) by dry heat in an oven"/>
<rdf:Description rdf:about="&a;100157529"
	 b:glossaryEntry="baking shelled eggs"/>
<rdf:Description rdf:about="&a;100157603"
	 b:glossaryEntry="cooking to a brown crispiness over a fire or on a grill"/>
<rdf:Description rdf:about="&a;100157724">
	<b:glossaryEntry>cooking by direct exposure to radiant heat (as over a fire or under a grill)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100157874"
	 b:glossaryEntry="cooking in fat or oil in a pan or griddle"/>
<rdf:Description rdf:about="&a;100157979"
	 b:glossaryEntry="cooking slowly in fat in a closed pot with little moisture"/>
<rdf:Description rdf:about="&a;100158092"
	 b:glossaryEntry="cooking in simmering water"/>
<rdf:Description rdf:about="&a;100158173">
	<b:glossaryEntry>cooking (meat) by dry heat in an oven (usually with fat added)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100158327">
	<b:glossaryEntry>roasting a large piece of meat on a revolving spit out of doors over an open fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100158465"
	 b:glossaryEntry="cooking in a boiling liquid"/>
<rdf:Description rdf:about="&a;100158586"
	 b:glossaryEntry="moistening a roast as it is cooking"/>
<rdf:Description rdf:about="&a;100158694"
	 b:glossaryEntry="the act of making meat tender by pounding or marinating it"/>
<rdf:Description rdf:about="&a;100158831"
	 b:glossaryEntry="the act of adding a seasoning to food"/>
<rdf:Description rdf:about="&a;100158979"
	 b:glossaryEntry="the act of adding salt to food"/>
<rdf:Description rdf:about="&a;100159063"
	 b:glossaryEntry="the act of adding a sweetener to food"/>
<rdf:Description rdf:about="&a;100159157">
	<b:glossaryEntry>the act of improving something: "Their improvements increased the value of the property"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100159609">
	<b:glossaryEntry>gradual improvement or growth or development: "advancement of knowledge"; "great progress in the arts"; "their research and development gave them an advantagte"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100159874">
	<b:glossaryEntry>the advancement of some enterprise; "his experience in marketing resulted in the forwarding of his career"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100160063">
	<b:glossaryEntry>significant progress (especially in the phrase "make strides" or "make rapid strides")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100160202">
	<b:glossaryEntry>act of improving by expanding or enlarging or refining; "he congratulated them on their development of a plan to meet the emergency"; "they funded research and development"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100160486"
	 b:glossaryEntry='the action of making broader; "the broadening of travel"'/>
<rdf:Description rdf:about="&a;100160599"
	 b:glossaryEntry="developing in intricate and painstaking detail"/>
<rdf:Description rdf:about="&a;100160717">
	<b:glossaryEntry>the act of making something clean; "he gave his shoes a good cleaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100161044"
	 b:glossaryEntry="the activity of getting rid of vermin"/>
<rdf:Description rdf:about="&a;100161142">
	<b:glossaryEntry>the activity of cleaning a house thoroughly at the end of winter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100161268">
	<b:glossaryEntry>the act of cleaning a surface by rubbing it with a brush and soap and water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100161436"
	 b:glossaryEntry="cleaning with a mop"/>
<rdf:Description rdf:about="&a;100161520">
	<b:glossaryEntry>the act of cleaning (fabrics) with a solvent other than water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100161640"
	 b:glossaryEntry="the act of cleaning with a broom"/>
<rdf:Description rdf:about="&a;100161727">
	<b:glossaryEntry>an act of removing by cleansing; ridding of sediment or other other undesired elements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100161941">
	<b:glossaryEntry>the act of clearing yourself (or another) from some stigma or charge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100162101">
	<b:glossaryEntry>the act of purging of sin or guilt; "purification through repentance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100162229"
	 b:glossaryEntry="cleaning by getting rid of impurities"/>
<rdf:Description rdf:about="&a;100162325"
	 b:glossaryEntry="(psychoanalysis) purging of emotional tensions"/>
<rdf:Description rdf:about="&a;100162452">
	<b:glossaryEntry>purging the body by the use of a cathartic to stimulate evacuation of the bowels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100162600">
	<b:glossaryEntry>irrigation of the colon for cleansing purposes by injecting large amounts of fluid high into the colon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100162792">
	<b:glossaryEntry>the procedure of making some object free of live bacteria of other microorganisms (usually by heat or chemical means)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100163002">
	<b:glossaryEntry>partial sterilization of foods at a temperature that destroys harmful microorganisms without major changes in the chemistry of the food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100163198"
	 b:glossaryEntry="making something sanitary (free of germs) as by sterilizing"/>
<rdf:Description rdf:about="&a;100163357"
	 b:glossaryEntry="the act of removing hair with a razor"/>
<rdf:Description rdf:about="&a;100163474">
	<b:glossaryEntry>shaving the crown of the head by priests or members of a monastic order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100163599"
	 b:glossaryEntry="the act of washing yourself (or another person)"/>
<rdf:Description rdf:about="&a;100163792"
	 b:glossaryEntry="the act of washing dishes"/>
<rdf:Description rdf:about="&a;100163875"
	 b:glossaryEntry="the work of washing or cleansing"/>
<rdf:Description rdf:about="&a;100164113"
	 b:glossaryEntry="the washing of dishes etc after a meal"/>
<rdf:Description rdf:about="&a;100164208"
	 b:glossaryEntry="the activity of washing windows"/>
<rdf:Description rdf:about="&a;100164300"
	 b:glossaryEntry="washing lightly without soap"/>
<rdf:Description rdf:about="&a;100164380"
	 b:glossaryEntry="the act of giving a light tint to the hair"/>
<rdf:Description rdf:about="&a;100164474">
	<b:glossaryEntry>the removal of soap with clean water in the final stage of washing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100164621"
	 b:glossaryEntry="washing something by allowing it to soak"/>
<rdf:Description rdf:about="&a;100164722">
	<b:glossaryEntry>the act of brushing your hair; "he gave his hair a quick brush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100164848">
	<b:glossaryEntry>the act of drawing a comb through hair; "his hair needed a comb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100164991"
	 b:glossaryEntry="the act of removing tangles from you hair with a comb"/>
<rdf:Description rdf:about="&a;100165109"
	 b:glossaryEntry="the act of washing your hair with shampoo"/>
<rdf:Description rdf:about="&a;100165204">
	<b:glossaryEntry>care for the hair: the activity of washing or cutting or curling or arranging the hair</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100165415">
	<b:glossaryEntry>washing yourself in a shower; you stand upright under water sprayed from a nozzle; "he took a shower after the game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100165598">
	<b:glossaryEntry>you soak your body in a bathtub; "he has a good bath every morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100165752">
	<b:glossaryEntry>a bath in which you add something to foam and scent the bath water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100165876"
	 b:glossaryEntry="a bath in warm mud (as for treating rheumatism)"/>
<rdf:Description rdf:about="&a;100165978">
	<b:glossaryEntry>you wash your body with a sponge or washcloth instead of in a bathtub</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100166105">
	<b:glossaryEntry>you sweat in a steam room before getting a rubdown and cold shower</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100166270"
	 b:glossaryEntry="the act of rubbing down"/>
<rdf:Description rdf:about="&a;100166347"
	 b:glossaryEntry="the act of offering an improvement to replace a mistake"/>
<rdf:Description rdf:about="&a;100166578"
	 b:glossaryEntry="act of correcting an error or a fault or an evil"/>
<rdf:Description rdf:about="&a;100166721">
	<b:glossaryEntry>anything that remedies or heals or soothes; "he needed a salve for his conscience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100166855"
	 b:glossaryEntry="the act of correcting for your wrongdoing"/>
<rdf:Description rdf:about="&a;100166954"
	 b:glossaryEntry="the act of compensating for loss or injury"/>
<rdf:Description rdf:about="&a;100167086"
	 b:glossaryEntry="the act of making something perfect"/>
<rdf:Description rdf:about="&a;100167178">
	<b:glossaryEntry>a change for the better as a result of correcting abuses; "justice was for sale before the reform of the law courts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100167365">
	<b:glossaryEntry>a redistribution of agricultural land (especially by government action)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100167494"
	 b:glossaryEntry="the act of relieving ills and changing for the better"/>
<rdf:Description rdf:about="&a;100167633"
	 b:glossaryEntry="the act of improving yourself"/>
<rdf:Description rdf:about="&a;100167762">
	<b:glossaryEntry xml:space='preserve'><![CDATA[self-improvement in behavior or morals by abandoning some vice; "the family rejoiced in the drunkard''s reform"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100167925"
	 b:glossaryEntry="the act of making something more beautiful"/>
<rdf:Description rdf:about="&a;100168046">
	<b:glossaryEntry>the act of glamorizing; making something or someone more beautiful (often in a superficial way)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100168201">
	<b:glossaryEntry>the act of decorating something (in the hope of making it more attractive)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100168476">
	<b:glossaryEntry>the action of decorating yourself with something colorful and interesting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100168605"
	 b:glossaryEntry="the act of adding extraneous decorations to something"/>
<rdf:Description rdf:about="&a;100168734"
	 b:glossaryEntry="the decoration of shop windows"/>
<rdf:Description rdf:about="&a;100168826">
	<b:glossaryEntry>the act of adding decoration; "the children had to be in bed before it was time for the trimming of the tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100168990"
	 b:glossaryEntry="adorning with mosaic"/>
<rdf:Description rdf:about="&a;100169069"
	 b:glossaryEntry="decorating with a design"/>
<rdf:Description rdf:about="&a;100169150">
	<b:glossaryEntry>the practice of making a design on the skin by pricking and staining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100169271"
	 b:glossaryEntry="the act of making a visible mark on a surface"/>
<rdf:Description rdf:about="&a;100169424"
	 b:glossaryEntry="the act of marking or outlining with lines"/>
<rdf:Description rdf:about="&a;100169522"
	 b:glossaryEntry="the act of coloring with areas of different shades"/>
<rdf:Description rdf:about="&a;100169627"
	 b:glossaryEntry="the act of marking with stripes"/>
<rdf:Description rdf:about="&a;100169713"
	 b:glossaryEntry="the act of removing solid particles from a liquid"/>
<rdf:Description rdf:about="&a;100169833"
	 b:glossaryEntry="act of making fuller or more meaningful or rewarding"/>
<rdf:Description rdf:about="&a;100169960"
	 b:glossaryEntry="the act of making more humane"/>
<rdf:Description rdf:about="&a;100170063">
	<b:glossaryEntry>making modern in appearance of behavior; "the modernizing of Nigeria will be a long process"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100170245"
	 b:glossaryEntry="the act of renovating"/>
<rdf:Description rdf:about="&a;100170357">
	<b:glossaryEntry>a renovation that improves the outward appearance (as of a building)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100170496"
	 b:glossaryEntry="an improvement that makes something more agreeable"/>
<rdf:Description rdf:about="&a;100170617"
	 b:glossaryEntry="an upward movement or trend as in business activity"/>
<rdf:Description rdf:about="&a;100170721"
	 b:glossaryEntry="changing something with the result that it becomes worse"/>
<rdf:Description rdf:about="&a;100170851">
	<b:glossaryEntry>a worsening of business or economic activity; "the market took a downturn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100171010"
	 b:glossaryEntry="a swift and dangerous downturn"/>
<rdf:Description rdf:about="&a;100171095"
	 b:glossaryEntry="the act of supplying fresh air and getting rid of foul air"/>
<rdf:Description rdf:about="&a;100171220"
	 b:glossaryEntry="the act of putting something in working order again"/>
<rdf:Description rdf:about="&a;100171488"
	 b:glossaryEntry="the act of mending a hole in a garment with crossing threads"/>
<rdf:Description rdf:about="&a;100171602">
	<b:glossaryEntry>the act of mending a hole in a garment by sewing a patch over it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100171721">
	<b:glossaryEntry>activity involved in maintaining something in good working order; "he wrote the manual on car care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100171984"
	 b:glossaryEntry="keeping a camera in good working order"/>
<rdf:Description rdf:about="&a;100172080"
	 b:glossaryEntry="keeping a car in good working order"/>
<rdf:Description rdf:about="&a;100172188"
	 b:glossaryEntry="replacing dirty oil with clean"/>
<rdf:Description rdf:about="&a;100172275">
	<b:glossaryEntry>periodic maintenance on a car or machine; "it was time for an overhaul on the tractor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100172482"
	 b:glossaryEntry="an overhaul between the regular times for overhauling"/>
<rdf:Description rdf:about="&a;100172598"
	 b:glossaryEntry="hurried repair"/>
<rdf:Description rdf:about="&a;100172698">
	<b:glossaryEntry>the act of restoring something or someone to a satisfactory state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100172893">
	<b:glossaryEntry>the conversion of waste land into land suitable for use of habitation or cultivation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100173090"
	 b:glossaryEntry="the activity of constructing something again"/>
<rdf:Description rdf:about="&a;100173231"
	 b:glossaryEntry="assembling again"/>
<rdf:Description rdf:about="&a;100173345"
	 b:glossaryEntry="building again"/>
<rdf:Description rdf:about="&a;100173416"
	 b:glossaryEntry="the act of restoring something to its original state"/>
<rdf:Description rdf:about="&a;100173526">
	<b:glossaryEntry>introducing water into a pump to improve the seal and start the water flowing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100173662"
	 b:glossaryEntry="maintenance at a regularly scheduled time"/>
<rdf:Description rdf:about="&a;100173771"
	 b:glossaryEntry="the job of a professional coach"/>
<rdf:Description rdf:about="&a;100173872">
	<b:glossaryEntry>a job for performers or performing groups that lasts for a limited period of time; "the play had bookings throughout the summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100174085"
	 b:glossaryEntry='a booking for musicians; "they played a gig in New Jersey"'/>
<rdf:Description rdf:about="&a;100174193"
	 b:glossaryEntry="changing to a lower state (a less respected state)"/>
<rdf:Description rdf:about="&a;100174476">
	<b:glossaryEntry>the act of degrading people with respect to their best qualities; "science has been blamed for the dehumanization of modern life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100174683">
	<b:glossaryEntry>an act that makes people cruel or lacking normal human qualities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100174855"
	 b:glossaryEntry="an act that makes people primitive and uncivilized"/>
<rdf:Description rdf:about="&a;100174981"
	 b:glossaryEntry="an act that debases or corrupts"/>
<rdf:Description rdf:about="&a;100175090">
	<b:glossaryEntry xml:space='preserve'><![CDATA[destroying someone''s honesty or loyalty or moral integrity: "corruption of a minor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100175230"
	 b:glossaryEntry="destroying the moral basis for a doctrine or policy"/>
<rdf:Description rdf:about="&a;100175342">
	<b:glossaryEntry>the act of making something futile and useless (as by routine)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100175490"
	 b:glossaryEntry="the act of making something attractive to the general public"/>
<rdf:Description rdf:about="&a;100175673"
	 b:glossaryEntry="depriving one of self-esteem"/>
<rdf:Description rdf:about="&a;100175800"
	 b:glossaryEntry="decline to a lower status or level"/>
<rdf:Description rdf:about="&a;100175889"
	 b:glossaryEntry="an act that change the light that something reflects"/>
<rdf:Description rdf:about="&a;100176075"
	 b:glossaryEntry="changing to a lighter color"/>
<rdf:Description rdf:about="&a;100176189">
	<b:glossaryEntry>the act of whitening something by bleaching it (exposing it to sunlight or using a chemical bleaching agent)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100176350"
	 b:glossaryEntry="changing to a darker color"/>
<rdf:Description rdf:about="&a;100176445"
	 b:glossaryEntry="the act of discoloring something"/>
<rdf:Description rdf:about="&a;100176554"
	 b:glossaryEntry="the act of of process of changing the color of something"/>
<rdf:Description rdf:about="&a;100176731"
	 b:glossaryEntry="the act of adding a tinge of color"/>
<rdf:Description rdf:about="&a;100176819"
	 b:glossaryEntry="the act of dyeing or tinting one''s hair"/>
<rdf:Description rdf:about="&a;100176936"
	 b:glossaryEntry="the use of dye to change the color of something permanently"/>
<rdf:Description rdf:about="&a;100177066">
	<b:glossaryEntry>(histology) the use of a dye to color specimens for microscopic study</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100177208">
	<b:glossaryEntry>a staining technique used to classify bacteria; those that retain the gentian violet are gram-positive and those that do not retain it are gram-negative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100177453">
	<b:glossaryEntry>(histology) the preservation and hardening of a tissue sample to retain as nearly as possible the same relations they had in the living body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100177657"
	 b:glossaryEntry="the act of soiling something"/>
<rdf:Description rdf:about="&a;100177796"
	 b:glossaryEntry="the act of spotting or staining something"/>
<rdf:Description rdf:about="&a;100177916">
	<b:glossaryEntry>the act of contaminating or polluting; including (either intentionally or accidentally) unwanted substances or factors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100178142"
	 b:glossaryEntry="the act of contaminating with dust particles"/>
<rdf:Description rdf:about="&a;100178251"
	 b:glossaryEntry="the removal of contaminants"/>
<rdf:Description rdf:about="&a;100178358"
	 b:glossaryEntry="the act of making something wet"/>
<rdf:Description rdf:about="&a;100178533"
	 b:glossaryEntry="the act of submerging something"/>
<rdf:Description rdf:about="&a;100178640"
	 b:glossaryEntry="the act of making something completely wet"/>
<rdf:Description rdf:about="&a;100178766"
	 b:glossaryEntry="making something slightly wet"/>
<rdf:Description rdf:about="&a;100178882"
	 b:glossaryEntry="the act of scattering water about haphazardly"/>
<rdf:Description rdf:about="&a;100178992">
	<b:glossaryEntry>wetting with water; "the lawn needs a great deal of watering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100179126"
	 b:glossaryEntry="watering with a sprinkler"/>
<rdf:Description rdf:about="&a;100179219">
	<b:glossaryEntry>the act of making an organism barren or infertile (unable to reproduce)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100179384"
	 b:glossaryEntry="neutering a male animal by removing the testicles"/>
<rdf:Description rdf:about="&a;100179505"
	 b:glossaryEntry="the sterilization of an animal"/>
<rdf:Description rdf:about="&a;100179647"
	 b:glossaryEntry="neutering a female by removing the ovaries"/>
<rdf:Description rdf:about="&a;100179743">
	<b:glossaryEntry>biting and grinding food in your mouth so it becomes soft enough to swallow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100179948"
	 b:glossaryEntry="the act of chewing noisily"/>
<rdf:Description rdf:about="&a;100180029"
	 b:glossaryEntry="ineffectual chewing (as if without teeth)"/>
<rdf:Description rdf:about="&a;100180135">
	<b:glossaryEntry>causing the leaves of trees and other plants to fall off (as by the use of chemicals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100180278">
	<b:glossaryEntry>the act of changing your location from one place to another; "police controlled the motion of the crowd"; "the movement of people from the farms to the cities"; "his move put him directly in my path"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100180908">
	<b:glossaryEntry>the act of changing the location of something; "the movement of cargo onto the vessel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100181121">
	<b:glossaryEntry>(physiology) moving of a body part away from the central axis of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100181250">
	<b:glossaryEntry>(physiology) moving of a body part toward the central axis of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100181376">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of drawing spatially closer to something; "the hunter''s approach scattered the geese"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100181619">
	<b:glossaryEntry>the act of approaching or entering; "he gained access to the builidng"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100181760">
	<b:glossaryEntry>a secret or underhand means of access (to a place or a position); "he got his job through the back door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100181920">
	<b:glossaryEntry xml:space='preserve'><![CDATA[approaching a particular destination; a coming closer; a narrowing of a gap; "the ship''s rapid rate of closing gave them little time to avoid a collision"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100182138"
	 b:glossaryEntry="the approach to a landing field by an airplane"/>
<rdf:Description rdf:about="&a;100182284"
	 b:glossaryEntry="an approach that fails and gives way to another attempt"/>
<rdf:Description rdf:about="&a;100182418"
	 b:glossaryEntry="the act of moving forward toward a goal"/>
<rdf:Description rdf:about="&a;100182673"
	 b:glossaryEntry='an effort to advance; "the army made a push toward the sea"'/>
<rdf:Description rdf:about="&a;100182783">
	<b:glossaryEntry>the general progression of your working or professional life; "the general had had a distinguished career"; "he had a long career in the law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100182992">
	<b:glossaryEntry>a steady advance; "the march of science"; "the march of time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100183105">
	<b:glossaryEntry>easy unobstructed progress: "after we solved that problem the rest was plain sailing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100183279"
	 b:glossaryEntry="self-propelled movement"/>
<rdf:Description rdf:about="&a;100183548"
	 b:glossaryEntry="swinging by the arms from branch to branch"/>
<rdf:Description rdf:about="&a;100183648">
	<b:glossaryEntry>the act of traveling by foot; "walking is a healthy form of exercise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100183941"
	 b:glossaryEntry='walking about; "the hospital encouraged early ambulation"'/>
<rdf:Description rdf:about="&a;100184055">
	<b:glossaryEntry>travel by foot; "he followed on foot"; "the swiftest of foot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100184167"
	 b:glossaryEntry='the act of walking somewhere; "he took a walk after lunch"'/>
<rdf:Description rdf:about="&a;100184402"
	 b:glossaryEntry="a regular walk taken as a form of exercise"/>
<rdf:Description rdf:about="&a;100184505"
	 b:glossaryEntry="walking by a person who is asleep"/>
<rdf:Description rdf:about="&a;100184645"
	 b:glossaryEntry="uttering speech while asleep"/>
<rdf:Description rdf:about="&a;100184779">
	<b:glossaryEntry>the act of changing location by raising the foot and setting it down; "he walked with unsteady steps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100185003"
	 b:glossaryEntry="a step in walking or running"/>
<rdf:Description rdf:about="&a;100185118">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a light or nimble tread; "he heard the trip of women''s feet overhead"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100185238"
	 b:glossaryEntry="a step to one side (as in boxing or dancing)"/>
<rdf:Description rdf:about="&a;100185337"
	 b:glossaryEntry="a person''s manner of walking"/>
<rdf:Description rdf:about="&a;100185578">
	<b:glossaryEntry>the uneven manner of walking that results from an injured leg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100185707"
	 b:glossaryEntry="a horse''s manner of moving"/>
<rdf:Description rdf:about="&a;100185892">
	<b:glossaryEntry>a slow gait of a horse in which two feet are always on the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100186008">
	<b:glossaryEntry>a rapid gait of a horse in which each foot strikes the ground separately</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100186145"
	 b:glossaryEntry="an easy gait of a horse; midway between a walk and a trot"/>
<rdf:Description rdf:about="&a;100186257">
	<b:glossaryEntry>a gait faster than a walk; diagonally opposite legs strike the ground together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100186422"
	 b:glossaryEntry="the rider rises from the saddle every second stride"/>
<rdf:Description rdf:about="&a;100186549"
	 b:glossaryEntry="the rider sits still in the saddle"/>
<rdf:Description rdf:about="&a;100186660">
	<b:glossaryEntry>maneuvers of a horse in response to body signals by the rider</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100186831">
	<b:glossaryEntry>a light leap by a horse in which both hind legs leave the ground before the forelegs come down</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100186989"
	 b:glossaryEntry="a cadenced trot executed by the horse in one spot"/>
<rdf:Description rdf:about="&a;100187091"
	 b:glossaryEntry="an smooth 3-beat gait; between a trot and a gallop"/>
<rdf:Description rdf:about="&a;100187201">
	<b:glossaryEntry>a fast gait of a horse; a two-beat stride during which all four legs are off the ground simultaneously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100187356"
	 b:glossaryEntry="the act of taking a step in walking"/>
<rdf:Description rdf:about="&a;100187446"
	 b:glossaryEntry="a leisurely walk (usually in some public place)"/>
<rdf:Description rdf:about="&a;100187619"
	 b:glossaryEntry="a long walk usually for exercise or pleasure"/>
<rdf:Description rdf:about="&a;100187740"
	 b:glossaryEntry="a long difficult walk"/>
<rdf:Description rdf:about="&a;100187814"
	 b:glossaryEntry="a gait in which steps and hops alternate"/>
<rdf:Description rdf:about="&a;100187905"
	 b:glossaryEntry="a stiff or threatening gait"/>
<rdf:Description rdf:about="&a;100187997"
	 b:glossaryEntry="a proud stiff pompous gait"/>
<rdf:Description rdf:about="&a;100188094"
	 b:glossaryEntry="an unsteady uneven gait"/>
<rdf:Description rdf:about="&a;100188189"
	 b:glossaryEntry="the act of moving forward suddenly"/>
<rdf:Description rdf:about="&a;100188283"
	 b:glossaryEntry="walking with slow regular strides"/>
<rdf:Description rdf:about="&a;100188369"
	 b:glossaryEntry="the act of walking with exaggerated jerky motions"/>
<rdf:Description rdf:about="&a;100188472"
	 b:glossaryEntry="walking with a waddling gait"/>
<rdf:Description rdf:about="&a;100188553">
	<b:glossaryEntry>the act of marching; walking with regular steps (especially in a procession of some kind); "it was a long march"; "we heard the sound of marching"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100188834"
	 b:glossaryEntry="a manner of marching with legs straight and swinging high"/>
<rdf:Description rdf:about="&a;100188948"
	 b:glossaryEntry="a march of all the guests at the opening of a formal dance"/>
<rdf:Description rdf:about="&a;100189081"
	 b:glossaryEntry="marching at quick time"/>
<rdf:Description rdf:about="&a;100189161"
	 b:glossaryEntry="a long training march for troops"/>
<rdf:Description rdf:about="&a;100189250"
	 b:glossaryEntry="the act of walking with a sow heavy gait"/>
<rdf:Description rdf:about="&a;100189345"
	 b:glossaryEntry="the act of prowling (walking about in a stealthy manner)"/>
<rdf:Description rdf:about="&a;100189453">
	<b:glossaryEntry>taking a short walk out and back; "we took a turn in the park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100189566">
	<b:glossaryEntry>walking with a slow dragging motion without lifting your feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100189715">
	<b:glossaryEntry>any kind of physical activity outside a spacecraft by one of the crew</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100189841">
	<b:glossaryEntry>an exploratory walk by an astronaut on the surface of the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100189958">
	<b:glossaryEntry>a kind of dance step in which the dancer seems to be sliding on the spot; "Michael Jackson perfected the moonwalk in the 1980s"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100190140"
	 b:glossaryEntry="walking with your feet in water"/>
<rdf:Description rdf:about="&a;100190224">
	<b:glossaryEntry>(Australia) nomadic excursions into the bush made by an Aborigine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100190345"
	 b:glossaryEntry="a public stroll by a celebrity to meet people informally"/>
<rdf:Description rdf:about="&a;100190457"
	 b:glossaryEntry="a walking trip or tour"/>
<rdf:Description rdf:about="&a;100190535">
	<b:glossaryEntry>the act of running; traveling on foot at a fast pace; "he broke into a run"; "his daily run keeps him fit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100190719"
	 b:glossaryEntry="a slow pace of running"/>
<rdf:Description rdf:about="&a;100190823"
	 b:glossaryEntry="a steady trot like that of a dog"/>
<rdf:Description rdf:about="&a;100190909"
	 b:glossaryEntry="a quick run"/>
<rdf:Description rdf:about="&a;100190998">
	<b:glossaryEntry>(basketball) a rapid dash to get a shot as soon as possible after taking possession of the ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100191168"
	 b:glossaryEntry='a sudden dash; "he made a break for the open door"'/>
<rdf:Description rdf:about="&a;100191288">
	<b:glossaryEntry>a slow creeping mode of locomotion (on hands and knees or dragging the body); "a crawl was all that the injured man could manage"; "the traffic moved at a creep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100191531">
	<b:glossaryEntry>movement once around a course; "he drove an extra lap just for insurance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100191691">
	<b:glossaryEntry>(auto racing) the first lap of a car race that prepares the cars for a fast start</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100191846">
	<b:glossaryEntry>the act of going from one place to another; "he enjoyed selling but he hated the travel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100192282">
	<b:glossaryEntry xml:space='preserve'><![CDATA[traveling around something (by ship or plane); "Magellan''s circumnavigation of the earth proved that it is a globe"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100192460"
	 b:glossaryEntry="travel (especially by foot)"/>
<rdf:Description rdf:about="&a;100192583"
	 b:glossaryEntry="travel across"/>
<rdf:Description rdf:about="&a;100192663"
	 b:glossaryEntry="travelling about without any clear destination"/>
<rdf:Description rdf:about="&a;100192806"
	 b:glossaryEntry="aimless wandering from place to place"/>
<rdf:Description rdf:about="&a;100192898"
	 b:glossaryEntry="traveling across"/>
<rdf:Description rdf:about="&a;100193005">
	<b:glossaryEntry>the act of crossing a stream or river by wading or in a car or on a horse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100193175"
	 b:glossaryEntry="fording at a shallow place"/>
<rdf:Description rdf:about="&a;100193263"
	 b:glossaryEntry="fording at a deep place in the stream"/>
<rdf:Description rdf:about="&a;100193359"
	 b:glossaryEntry="taking a zigzag path on skis"/>
<rdf:Description rdf:about="&a;100193473">
	<b:glossaryEntry>the business of providing services to tourists; "Tourism is a major business in Bermuda"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100193637">
	<b:glossaryEntry>the act of controlling and steering the movement of a vehicle or animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100193791"
	 b:glossaryEntry="riding a horse as a means of transportation"/>
<rdf:Description rdf:about="&a;100193978"
	 b:glossaryEntry="capturing cattle or horses with a lasso"/>
<rdf:Description rdf:about="&a;100194106"
	 b:glossaryEntry="breaking a bronco to saddle"/>
<rdf:Description rdf:about="&a;100194213"
	 b:glossaryEntry="riding for long hours over long distances"/>
<rdf:Description rdf:about="&a;100194317"
	 b:glossaryEntry="riding with a pack"/>
<rdf:Description rdf:about="&a;100194393"
	 b:glossaryEntry="riding along a roughly blazed path"/>
<rdf:Description rdf:about="&a;100194486"
	 b:glossaryEntry="capturing a calf with a lasso and binding its feet"/>
<rdf:Description rdf:about="&a;100194613"
	 b:glossaryEntry="capturing a steer with a lasso"/>
<rdf:Description rdf:about="&a;100194721"
	 b:glossaryEntry="travel on a motorcycle"/>
<rdf:Description rdf:about="&a;100194802">
	<b:glossaryEntry xml:space='preserve'><![CDATA[travel via aircraft; "air travel involves too much waiting in airports"; "if you''ve time to spare go by air"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100195002">
	<b:glossaryEntry>a scheduled trip by plane between designated airports; "I took the noon flight to Chicago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100195217"
	 b:glossaryEntry="a flight that begins and ends in the same country"/>
<rdf:Description rdf:about="&a;100195346"
	 b:glossaryEntry="a flight that takes off in one country and lands in another"/>
<rdf:Description rdf:about="&a;100195490">
	<b:glossaryEntry>a flight made without intermediate landings between source and destination; "how many nonstops are there to Dallas?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100195677">
	<b:glossaryEntry>a night flight from which the passengers emerge with eyes red from lack of sleep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100195810">
	<b:glossaryEntry>an instance of traveling by air; "flying was still an exciting adventure for him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100196097"
	 b:glossaryEntry="the performance of stunts while in flight in an aircraft"/>
<rdf:Description rdf:about="&a;100196267"
	 b:glossaryEntry="flying in a balloon"/>
<rdf:Description rdf:about="&a;100196343">
	<b:glossaryEntry>a low-altitude flight (usually of military aircraft) over spectators on the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100196489"
	 b:glossaryEntry="the activity of flying a glider"/>
<rdf:Description rdf:about="&a;100196652"
	 b:glossaryEntry="gliding in a hang glider"/>
<rdf:Description rdf:about="&a;100196735"
	 b:glossaryEntry="descent with a parachute"/>
<rdf:Description rdf:about="&a;100196842">
	<b:glossaryEntry>performing acrobatics in free fall before pulling the ripcord of a parachute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100196975"
	 b:glossaryEntry="gliding in a parasail"/>
<rdf:Description rdf:about="&a;100197054">
	<b:glossaryEntry>a flight or run by an aircraft over a target; "the plane turned to make a second pass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100197191"
	 b:glossaryEntry="a flight in which the aircraft pilot is unaccompanied"/>
<rdf:Description rdf:about="&a;100197295">
	<b:glossaryEntry>an operational flight by a single aircraft (as in a military operation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100197419">
	<b:glossaryEntry>a landing (as the wheels touch the landing field); especially of airplanes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100197549"
	 b:glossaryEntry="landing an aircraft"/>
<rdf:Description rdf:about="&a;100197704">
	<b:glossaryEntry>an emergency landing under circumstances where a normal landing is impossible (usually damaging the aircraft)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100197873">
	<b:glossaryEntry>a landing in which all three wheels of the aircraft touch the ground at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100198024"
	 b:glossaryEntry="an aircraft landing made entirely by means of instruments"/>
<rdf:Description rdf:about="&a;100198146">
	<b:glossaryEntry>a landing of a spacecraft in the sea at the end of a space flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100198268"
	 b:glossaryEntry="a departure; especially of airplanes"/>
<rdf:Description rdf:about="&a;100198358"
	 b:glossaryEntry="rapid descent of an aircraft in a steep spiral spin"/>
<rdf:Description rdf:about="&a;100198471"
	 b:glossaryEntry="flight at very low altitudes"/>
<rdf:Description rdf:about="&a;100198579"
	 b:glossaryEntry="the act of traveling from one place to another"/>
<rdf:Description rdf:about="&a;100198945">
	<b:glossaryEntry>a section or portion of a journey or course; "then we embarked on the second stage of our Carribean cruise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100199147">
	<b:glossaryEntry>(nautical) the distance traveled by a sailing vessel on a single tack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100199284">
	<b:glossaryEntry>(British) a section along the route of a bus for which the fare is the same</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100199416">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a journey over a long distance; "it''s a long haul from New York to Los Angeles"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100199551"
	 b:glossaryEntry="a long wandering and eventful journey"/>
<rdf:Description rdf:about="&a;100199642">
	<b:glossaryEntry>a journey for some purpose (usually including the return); "he took a trip to the shopping center"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100199917"
	 b:glossaryEntry="a trip to some place and back again"/>
<rdf:Description rdf:about="&a;100200009"
	 b:glossaryEntry='a regular trip; "the ship made its run in record time"'/>
<rdf:Description rdf:about="&a;100200113"
	 b:glossaryEntry='a short trip; "take a run into town"'/>
<rdf:Description rdf:about="&a;100200199">
	<b:glossaryEntry>a journey usually by ship; "the outward passage took 10 days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100200342">
	<b:glossaryEntry>a journey in a vehicle driven by someone else; "he took the family for a drive in his new car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100200531"
	 b:glossaryEntry='a ride in a car; "he gave me a lift home"'/>
<rdf:Description rdf:about="&a;100200623">
	<b:glossaryEntry>a ride in a car taken solely for pleasure; "they took their girlfriends for joyrides in stolen cars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100200777"
	 b:glossaryEntry="a journey organized for a particular purpose"/>
<rdf:Description rdf:about="&a;100200932"
	 b:glossaryEntry="an expedition undertaken to gain information"/>
<rdf:Description rdf:about="&a;100201036"
	 b:glossaryEntry="an overland journey by hunters (especially in Africa)"/>
<rdf:Description rdf:about="&a;100201174"
	 b:glossaryEntry="to travel for the purpose of discovery"/>
<rdf:Description rdf:about="&a;100201294"
	 b:glossaryEntry="wandering from the main path of a journey"/>
<rdf:Description rdf:about="&a;100201404"
	 b:glossaryEntry="any long and difficult trip"/>
<rdf:Description rdf:about="&a;100201482">
	<b:glossaryEntry>(South African) a journey by ox wagon (especially an organized migration by a group of settlers)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100201629"
	 b:glossaryEntry="an extended journey"/>
<rdf:Description rdf:about="&a;100201763"
	 b:glossaryEntry="an extended sightseeing tour undertaken for pleasure"/>
<rdf:Description rdf:about="&a;100201872">
	<b:glossaryEntry>travelling about; "they took the show on the road" or "they lost all their games on the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100202033"
	 b:glossaryEntry="a journey to a sacred place"/>
<rdf:Description rdf:about="&a;100202155">
	<b:glossaryEntry>a pilgrimage to Mecca; every Muslim must make this journey at least once</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100202291">
	<b:glossaryEntry>a journey taken for pleasure; "many summer excursions to the shore"; "it was merely a pleasure trip"; "after cautious sashays into the field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100202570"
	 b:glossaryEntry="taking an excursion for pleasure"/>
<rdf:Description rdf:about="&a;100202658">
	<b:glossaryEntry>an short excursion (a walk or ride) in the open air; "after lunch he took the air"; "he took the dogs for an airing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100202833"
	 b:glossaryEntry="a journey to some distant place"/>
<rdf:Description rdf:about="&a;100202953"
	 b:glossaryEntry='a journey or passage; "they are on the way"'/>
<rdf:Description rdf:about="&a;100203046"
	 b:glossaryEntry="an act of traveling by water"/>
<rdf:Description rdf:about="&a;100203158"
	 b:glossaryEntry="an ocean trip taken for pleasure"/>
<rdf:Description rdf:about="&a;100203250">
	<b:glossaryEntry>a voyage across a body of water (usually across the Atlantic Ocean)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100203372"
	 b:glossaryEntry="passage through a lock"/>
<rdf:Description rdf:about="&a;100203448"
	 b:glossaryEntry="a voyage outside the Earth''s atmosphere"/>
<rdf:Description rdf:about="&a;100203574"
	 b:glossaryEntry="travel by water"/>
<rdf:Description rdf:about="&a;100203714"
	 b:glossaryEntry="riding in a sailboat"/>
<rdf:Description rdf:about="&a;100203842"
	 b:glossaryEntry="sailing close to the wind"/>
<rdf:Description rdf:about="&a;100203918">
	<b:glossaryEntry>the act of beating to windward; sailing as close as possible to the direction from which the wind is blowing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100204077"
	 b:glossaryEntry="sailing a zigzag course"/>
<rdf:Description rdf:about="&a;100204151"
	 b:glossaryEntry="the work of a sailor"/>
<rdf:Description rdf:about="&a;100204287"
	 b:glossaryEntry="navigation in costal waters"/>
<rdf:Description rdf:about="&a;100204369"
	 b:glossaryEntry="water travel for pleasure"/>
<rdf:Description rdf:about="&a;100204459"
	 b:glossaryEntry="the travel of a commuter"/>
<rdf:Description rdf:about="&a;100204553">
	<b:glossaryEntry>the act of transporting something from one location to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100204841"
	 b:glossaryEntry="transfer from one conveyance to another for shipment"/>
<rdf:Description rdf:about="&a;100204953">
	<b:glossaryEntry>shifting from one form of transportation to another; "the plane was late and he missed his connection in Atlanta"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100205135">
	<b:glossaryEntry>the act of delivering or distributing something (as goods or mail); "his reluctant delivery of bad news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100205359"
	 b:glossaryEntry="the act of driving a herd of animals overland"/>
<rdf:Description rdf:about="&a;100205456">
	<b:glossaryEntry>the act of delivering a writ or summons upon someone; "he accepted service of the subpoena"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100205632"
	 b:glossaryEntry="the delivery of goods for sale or disposal"/>
<rdf:Description rdf:about="&a;100205732"
	 b:glossaryEntry="the act of passing something to another person"/>
<rdf:Description rdf:about="&a;100205865"
	 b:glossaryEntry="the act of relaying something"/>
<rdf:Description rdf:about="&a;100205946"
	 b:glossaryEntry="the act of carrying something"/>
<rdf:Description rdf:about="&a;100206099"
	 b:glossaryEntry="the act of taking aboard passengers or freight"/>
<rdf:Description rdf:about="&a;100206217">
	<b:glossaryEntry>carrying something in a pack on the back; "the backpacking of oxygen is essential for astronauts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100206382"
	 b:glossaryEntry="the act of carrying a person over your shoulder"/>
<rdf:Description rdf:about="&a;100206491"
	 b:glossaryEntry="carrying boats and supplies overland"/>
<rdf:Description rdf:about="&a;100206581"
	 b:glossaryEntry="the transportation of burdens by porters"/>
<rdf:Description rdf:about="&a;100206677"
	 b:glossaryEntry="the act of pursuing"/>
<rdf:Description rdf:about="&a;100206842">
	<b:glossaryEntry>the pursuit (of a person or animal) by following tracks or marks they left behind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100206989"
	 b:glossaryEntry="the act of following someone secretly"/>
<rdf:Description rdf:about="&a;100207092"
	 b:glossaryEntry="the act of following prey stealthily"/>
<rdf:Description rdf:about="&a;100207191"
	 b:glossaryEntry="the fruitless pursuit of something unattainable"/>
<rdf:Description rdf:about="&a;100207301"
	 b:glossaryEntry="the act of putting one thing into another"/>
<rdf:Description rdf:about="&a;100207536"
	 b:glossaryEntry="the insertion of a cannula into a body cavity"/>
<rdf:Description rdf:about="&a;100207683">
	<b:glossaryEntry>the introduction of a liquid (by pouring or injection) drop by drop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100207854"
	 b:glossaryEntry="the act of enclosing something inside something else"/>
<rdf:Description rdf:about="&a;100208049"
	 b:glossaryEntry="the enclosure of something in a box"/>
<rdf:Description rdf:about="&a;100208165"
	 b:glossaryEntry="the act of binding something into a bundle"/>
<rdf:Description rdf:about="&a;100208262"
	 b:glossaryEntry="the act of enclosing something in a case"/>
<rdf:Description rdf:about="&a;100208372"
	 b:glossaryEntry="the forceful insertion of a substance under pressure"/>
<rdf:Description rdf:about="&a;100208480"
	 b:glossaryEntry="an injection into the skin"/>
<rdf:Description rdf:about="&a;100208574"
	 b:glossaryEntry="an injection into a muscle"/>
<rdf:Description rdf:about="&a;100208670"
	 b:glossaryEntry="an injection into a vein"/>
<rdf:Description rdf:about="&a;100208780"
	 b:glossaryEntry="(informal) an intravenous injection of a narcotic drug"/>
<rdf:Description rdf:about="&a;100208884"
	 b:glossaryEntry="an injection under the skin"/>
<rdf:Description rdf:about="&a;100208980">
	<b:glossaryEntry>the passive introduction of a substance (a fluid or drug or electrolyte) into a vein or between tissues (as by gravitational force)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100209166">
	<b:glossaryEntry>the introduction of blood or blood plasma into a vein or artery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100209307">
	<b:glossaryEntry>pumping a liquid into an organ or tissue (especially by way of blood vessels)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100209440"
	 b:glossaryEntry="the act of changing location in an upward direction"/>
<rdf:Description rdf:about="&a;100209629"
	 b:glossaryEntry="the act of lifting something with great effort"/>
<rdf:Description rdf:about="&a;100209737"
	 b:glossaryEntry="the act of climbing something"/>
<rdf:Description rdf:about="&a;100209898"
	 b:glossaryEntry="ascent by or as if by a ladder"/>
<rdf:Description rdf:about="&a;100210000"
	 b:glossaryEntry='an awkward climb; "reaching the crest was a real clamber"'/>
<rdf:Description rdf:about="&a;100210111"
	 b:glossaryEntry="an act of scaling the walls of a fortification"/>
<rdf:Description rdf:about="&a;100210212"
	 b:glossaryEntry="the activity of climbing a mountain"/>
<rdf:Description rdf:about="&a;100210328"
	 b:glossaryEntry="an act of scaling rock masses on mountain sides"/>
<rdf:Description rdf:about="&a;100210435"
	 b:glossaryEntry="the act of rising upward into the air"/>
<rdf:Description rdf:about="&a;100210530"
	 b:glossaryEntry="the act of changing your location in a downward direction"/>
<rdf:Description rdf:about="&a;100210749"
	 b:glossaryEntry="a steep nose-down descent by an aircraft"/>
<rdf:Description rdf:about="&a;100210870"
	 b:glossaryEntry="a swift descent through the air"/>
<rdf:Description rdf:about="&a;100210953"
	 b:glossaryEntry="a dive accelerated by both gravity and engine power"/>
<rdf:Description rdf:about="&a;100211061"
	 b:glossaryEntry="a rapid descent by a submarine"/>
<rdf:Description rdf:about="&a;100211148">
	<b:glossaryEntry>the act of dropping something; "they expected the drop would be successful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100211274">
	<b:glossaryEntry>the act of throwing yourself down; "he landed on the bed with a great flop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100211411"
	 b:glossaryEntry="the act of causing something to move to a lower level"/>
<rdf:Description rdf:about="&a;100211534"
	 b:glossaryEntry="changing location by moving back and forth"/>
<rdf:Description rdf:about="&a;100211639">
	<b:glossaryEntry>the act of returning to a prior location; "they set out on their return to the base camp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100211817"
	 b:glossaryEntry="the act of entering again"/>
<rdf:Description rdf:about="&a;100211896">
	<b:glossaryEntry>the act of sending an accused person back into custody to await trial (or the continuation of the trial)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100212053"
	 b:glossaryEntry="the act of sliding or gliding"/>
<rdf:Description rdf:about="&a;100212160"
	 b:glossaryEntry="an unexpected slide"/>
<rdf:Description rdf:about="&a;100212248"
	 b:glossaryEntry="the act of flowing or streaming; continuous progression"/>
<rdf:Description rdf:about="&a;100212399"
	 b:glossaryEntry="the act of allowing a fluid to escape"/>
<rdf:Description rdf:about="&a;100212509"
	 b:glossaryEntry="a large flow"/>
<rdf:Description rdf:about="&a;100212615"
	 b:glossaryEntry="flow under pressure"/>
<rdf:Description rdf:about="&a;100212689"
	 b:glossaryEntry='a very slow movement; "the traffic advanced at a crawl"'/>
<rdf:Description rdf:about="&a;100212796"
	 b:glossaryEntry="changing location rapidly"/>
<rdf:Description rdf:about="&a;100212943"
	 b:glossaryEntry="the act of accelerating; increasing the speed"/>
<rdf:Description rdf:about="&a;100213070"
	 b:glossaryEntry="the act of moving along swiftly (as before a gale)"/>
<rdf:Description rdf:about="&a;100213182"
	 b:glossaryEntry="the act of uniform movement"/>
<rdf:Description rdf:about="&a;100213282"
	 b:glossaryEntry="the act of uprooting and moving a plant to a new location"/>
<rdf:Description rdf:about="&a;100213412"
	 b:glossaryEntry="the act of moving from one place to another"/>
<rdf:Description rdf:about="&a;100213518">
	<b:glossaryEntry>a change of position that does not entail a change of location; "the reflex movements of his eyebrows revealed his surprise";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100214309">
	<b:glossaryEntry>the act of agitating something; causing it to move around (usually vigorously)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100214515">
	<b:glossaryEntry>a motion of the body by a player as if to make an object already propelled go in the desired direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100214676"
	 b:glossaryEntry="a circular movement of a limb or eye"/>
<rdf:Description rdf:about="&a;100214772">
	<b:glossaryEntry>the act of disturbing something or someone; setting something in motion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100215081">
	<b:glossaryEntry>motion of hands or body to emphasize or help to express a thought or feeling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100215247">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of turning your head left and right to signify denial or disbelief or bemusement; "I could tell from their headshakes that they didn''t believe me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100215471">
	<b:glossaryEntry>a sharp hand gesture (resembling a blow); "he warned me with a jab with his finger"; "he made a thrusting motion with his fist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100215695"
	 b:glossaryEntry="ritual hand movement in Hindu religious dancing"/>
<rdf:Description rdf:about="&a;100215794">
	<b:glossaryEntry>the act of inclining; bending forward; "an inclination of his head indicated his agreement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100216009"
	 b:glossaryEntry="the act of turning inside out"/>
<rdf:Description rdf:about="&a;100216116"
	 b:glossaryEntry="turning upside down"/>
<rdf:Description rdf:about="&a;100216220"
	 b:glossaryEntry="an abrupt spasmodic movement"/>
<rdf:Description rdf:about="&a;100216316">
	<b:glossaryEntry>a short abrupt inclination (as of the head); "he gave me a short bob of acknowledgement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100216454"
	 b:glossaryEntry="the act of nodding the head"/>
<rdf:Description rdf:about="&a;100216542">
	<b:glossaryEntry>an inclination of the top half of the body forward and downward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100216657">
	<b:glossaryEntry>a rhythmic thrusting movement of the legs as in swimming or calisthenics; "the kick must be synchronized with the arm movements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100216864"
	 b:glossaryEntry="supporting yourself on your knees"/>
<rdf:Description rdf:about="&a;100216960">
	<b:glossaryEntry>abrupt up-and-down motion (as caused by a ship or other conveyance); "the pitching and tossing was quite exciting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100217163">
	<b:glossaryEntry>the act of opening something; "the ray of light revealed his cautious opening of the door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100217325"
	 b:glossaryEntry="changing an arrangement"/>
<rdf:Description rdf:about="&a;100217444">
	<b:glossaryEntry>the act of rearranging things to give a misleading impression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100217569"
	 b:glossaryEntry="a rearrangement in a different order"/>
<rdf:Description rdf:about="&a;100217734"
	 b:glossaryEntry="act of changing the lineal order of objects in a group"/>
<rdf:Description rdf:about="&a;100217846"
	 b:glossaryEntry="act of reversing the order or place of"/>
<rdf:Description rdf:about="&a;100217955">
	<b:glossaryEntry>going by something that is moving in order to get in front of it; "she drove but well but her reckless passing of every car on the road frightened me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100218172"
	 b:glossaryEntry="the act of mixing cards haphazardly"/>
<rdf:Description rdf:about="&a;100218335"
	 b:glossaryEntry='shuffling (cards) again; "the gambler demanded a reshuffle"'/>
<rdf:Description rdf:about="&a;100218464">
	<b:glossaryEntry>shuffling by splitting the pack and interweaving the two halves at their corners</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100218597"
	 b:glossaryEntry="a series of small (usually idle) twists or turns"/>
<rdf:Description rdf:about="&a;100218699"
	 b:glossaryEntry="the act of prostrating yourself"/>
<rdf:Description rdf:about="&a;100218788"
	 b:glossaryEntry="the act of physically reaching or thrusting out"/>
<rdf:Description rdf:about="&a;100218926"
	 b:glossaryEntry="alternating back-and-forth movement"/>
<rdf:Description rdf:about="&a;100219021"
	 b:glossaryEntry="the act of assuming or maintaining a reclining position"/>
<rdf:Description rdf:about="&a;100219132"
	 b:glossaryEntry="the act of bending backward"/>
<rdf:Description rdf:about="&a;100219234">
	<b:glossaryEntry>the act of rotating as if on an axis; "the rotation of the top kept time with the music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100219521"
	 b:glossaryEntry="flying downward in a helical path with a large radius"/>
<rdf:Description rdf:about="&a;100219627">
	<b:glossaryEntry>the act of rotating rapidly; "he gave the crank a spin"; "it broke off after much twisting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100219840">
	<b:glossaryEntry>a rapid spin of the body (especially on the toes as in ballet)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100219958"
	 b:glossaryEntry="rotating a log rapidly in the water (as a competitive sport)"/>
<rdf:Description rdf:about="&a;100220085"
	 b:glossaryEntry="the act of closing something"/>
<rdf:Description rdf:about="&a;100220196">
	<b:glossaryEntry>the act of assuming or maintaining a seated position; "he read the mystery at one sitting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100220340">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of assuming a certain position (as for a photograph or portrait); "he wanted his portrait painted but couldn''t spare time for the sitting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100220549"
	 b:glossaryEntry="the act of assuming or maintaining a squatting position"/>
<rdf:Description rdf:about="&a;100220668"
	 b:glossaryEntry='a movement in an arc; "a sweep of his arm"'/>
<rdf:Description rdf:about="&a;100220762">
	<b:glossaryEntry>turning or twisting around (in place); "with a quick twist of his head he surveyed the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100220931">
	<b:glossaryEntry>the act of winding or twisting; "he put the key in the old clock and gave it a good wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100221089">
	<b:glossaryEntry>the act of turning or winding or folding around a central axis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100221212"
	 b:glossaryEntry="turning an oar parallel to the water between pulls"/>
<rdf:Description rdf:about="&a;100221348"
	 b:glossaryEntry="the act of rotating in a circle or spiral"/>
<rdf:Description rdf:about="&a;100221455">
	<b:glossaryEntry>rotation of the hands and forearms so that the palms face downward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100221595">
	<b:glossaryEntry>rotation of the hands and forearms so that the palms face upward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100221734"
	 b:glossaryEntry="the act of vibrating"/>
<rdf:Description rdf:about="&a;100221849">
	<b:glossaryEntry>a movement like that of an ocean wave; "a wave of settlers"; "troops advancing in waves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100221988">
	<b:glossaryEntry>the act of changing the direction in which something is oriented</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100222172">
	<b:glossaryEntry>turning away or in the opposite direction: "he made an abrupt turn away from her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100222304"
	 b:glossaryEntry="turning in the opposite direction"/>
<rdf:Description rdf:about="&a;100222475">
	<b:glossaryEntry>act of pivoting 180 degrees, especially in a military formation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100222608"
	 b:glossaryEntry="complete reversal of direction of travel"/>
<rdf:Description rdf:about="&a;100222701">
	<b:glossaryEntry>the act of causing something to move up and down (or back and forth) with quick movements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100222862"
	 b:glossaryEntry="a slight irregular shaking motion"/>
<rdf:Description rdf:about="&a;100222957"
	 b:glossaryEntry="agitating a liquid with a stirring implement"/>
<rdf:Description rdf:about="&a;100223056"
	 b:glossaryEntry="causing to move repeatedly from side to side"/>
<rdf:Description rdf:about="&a;100223167">
	<b:glossaryEntry>the act of moving something by repeated tugs or pushes; "vigorous worrying finally loosened the saw"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100223322"
	 b:glossaryEntry="pitching dangerously to one side"/>
<rdf:Description rdf:about="&a;100223428"
	 b:glossaryEntry="walking with a rolling gait"/>
<rdf:Description rdf:about="&a;100223506">
	<b:glossaryEntry>the act of upsetting something; "he was badly bruised by the upset of his sled at a high speed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100223675"
	 b:glossaryEntry="the act of moving back and forth"/>
<rdf:Description rdf:about="&a;100223779"
	 b:glossaryEntry="an involuntary vibration (as if from illness or fear)"/>
<rdf:Description rdf:about="&a;100223895">
	<b:glossaryEntry>the act of reaching out; "the outreach toward truth of the human spirit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100224022"
	 b:glossaryEntry="the act of assuming or maintaining an erect upright position"/>
<rdf:Description rdf:about="&a;100224137"
	 b:glossaryEntry="the act of sitting or standing astride"/>
<rdf:Description rdf:about="&a;100224275"
	 b:glossaryEntry="a single complete movement"/>
<rdf:Description rdf:about="&a;100224408"
	 b:glossaryEntry="the act of wiggling"/>
<rdf:Description rdf:about="&a;100224499"
	 b:glossaryEntry="a change in the direction that you are moving"/>
<rdf:Description rdf:about="&a;100224643">
	<b:glossaryEntry>the act of changing or reversing the direction of the course; "he took a turn to the right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100224903">
	<b:glossaryEntry>a turning aside (of your course or attention or concern): "a diversion from the main highway"; "a digression into irrelevant details"; "a deflection from his goal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100225190">
	<b:glossaryEntry>any diversion intended to distract attention from the main issue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100225312"
	 b:glossaryEntry='a turn to the right; "take a right at the corner"'/>
<rdf:Description rdf:about="&a;100225413"
	 b:glossaryEntry='a turn to the left; "take a left at the corner"'/>
<rdf:Description rdf:about="&a;100225511"
	 b:glossaryEntry="(nautical) the act of changing tack"/>
<rdf:Description rdf:about="&a;100225607"
	 b:glossaryEntry="the act of changing the amount or size of something"/>
<rdf:Description rdf:about="&a;100225760"
	 b:glossaryEntry="the act of decreasing or reducing something"/>
<rdf:Description rdf:about="&a;100226363">
	<b:glossaryEntry>the act of reducing the amount or number; "the mayor proposed extensive cuts in the city budget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100226599"
	 b:glossaryEntry="the act of reducing the budget"/>
<rdf:Description rdf:about="&a;100226686"
	 b:glossaryEntry="a act of reducing a salary"/>
<rdf:Description rdf:about="&a;100226766"
	 b:glossaryEntry="the act of cutting costs"/>
<rdf:Description rdf:about="&a;100226849">
	<b:glossaryEntry>cutting the price of merchandise to one lower than the usual or advertised price</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100227001"
	 b:glossaryEntry="the act of reducing spending"/>
<rdf:Description rdf:about="&a;100227088">
	<b:glossaryEntry>the action of lessening in severity or intensity: "the object being control or moderation of economic depressions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100227277"
	 b:glossaryEntry="the act of causing to become less"/>
<rdf:Description rdf:about="&a;100227383">
	<b:glossaryEntry>the act of gradually lowering the size or amount; "the doctor prescribed the tapering of the dose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100227536"
	 b:glossaryEntry="a reduction in quantity or rate"/>
<rdf:Description rdf:about="&a;100227639"
	 b:glossaryEntry="the act of reducing service"/>
<rdf:Description rdf:about="&a;100227728"
	 b:glossaryEntry="the reduction of something value"/>
<rdf:Description rdf:about="&a;100227818"
	 b:glossaryEntry="the act of reducing the vitality of something"/>
<rdf:Description rdf:about="&a;100227941">
	<b:glossaryEntry>to act in such a way as to cause an offense to seem less serious</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100228089"
	 b:glossaryEntry="the relaxation or relief of muscle spasms"/>
<rdf:Description rdf:about="&a;100228188">
	<b:glossaryEntry>the act of reducing something unpleasant as pain; "he asked the nurse for relief from the constant pain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100228440"
	 b:glossaryEntry="a reduction in intensity (of a crisis or a war)"/>
<rdf:Description rdf:about="&a;100228547">
	<b:glossaryEntry>the easing of tensions or strained relations (especially between nations)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100228674">
	<b:glossaryEntry>easing the severity of a pain or a disease without removing the cause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100228800"
	 b:glossaryEntry="the act of making less strict"/>
<rdf:Description rdf:about="&a;100228920"
	 b:glossaryEntry="the act of minimizing something"/>
<rdf:Description rdf:about="&a;100229061"
	 b:glossaryEntry="the act of decreasing something markedly"/>
<rdf:Description rdf:about="&a;100229211"
	 b:glossaryEntry="the act of consuming something"/>
<rdf:Description rdf:about="&a;100229342"
	 b:glossaryEntry="the amount of fuel used up (as in a nuclear reactor)"/>
<rdf:Description rdf:about="&a;100229447"
	 b:glossaryEntry="the act of exhausting something entirely"/>
<rdf:Description rdf:about="&a;100229544"
	 b:glossaryEntry="applying pressure"/>
<rdf:Description rdf:about="&a;100229705"
	 b:glossaryEntry='the act of squeezing; "he gave her cheek a playful squeeze"'/>
<rdf:Description rdf:about="&a;100229872"
	 b:glossaryEntry="a squeeze with the fingers"/>
<rdf:Description rdf:about="&a;100229958"
	 b:glossaryEntry="relieving pressure"/>
<rdf:Description rdf:about="&a;100230070"
	 b:glossaryEntry="the act of increasing the density of something"/>
<rdf:Description rdf:about="&a;100230206"
	 b:glossaryEntry="the act of thickening"/>
<rdf:Description rdf:about="&a;100230299"
	 b:glossaryEntry="the act of crushing"/>
<rdf:Description rdf:about="&a;100230410"
	 b:glossaryEntry="the act of grinding"/>
<rdf:Description rdf:about="&a;100230520"
	 b:glossaryEntry="squeezing out by applying pressure"/>
<rdf:Description rdf:about="&a;100230622"
	 b:glossaryEntry='act of decreasing in length: "the dress needs shortening"'/>
<rdf:Description rdf:about="&a;100230790"
	 b:glossaryEntry="shortening something by omitting parts of it"/>
<rdf:Description rdf:about="&a;100230893">
	<b:glossaryEntry>the act of shortening something by cutting off the ends; "the barber gave him a good cut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100231128"
	 b:glossaryEntry="the act of severing"/>
<rdf:Description rdf:about="&a;100231214"
	 b:glossaryEntry="the act of clipping or snipping"/>
<rdf:Description rdf:about="&a;100231314"
	 b:glossaryEntry="the act of cutting the hair"/>
<rdf:Description rdf:about="&a;100231395"
	 b:glossaryEntry="cutting down to the desired size or shape"/>
<rdf:Description rdf:about="&a;100231527"
	 b:glossaryEntry="the act of trimming a plant"/>
<rdf:Description rdf:about="&a;100231608"
	 b:glossaryEntry="removing by cutting off or clipping"/>
<rdf:Description rdf:about="&a;100231716"
	 b:glossaryEntry="act of shearing sheep"/>
<rdf:Description rdf:about="&a;100231797"
	 b:glossaryEntry="the act of becoming less"/>
<rdf:Description rdf:about="&a;100231895"
	 b:glossaryEntry="act of making on a greatly reduced scale"/>
<rdf:Description rdf:about="&a;100232015">
	<b:glossaryEntry>the act of subtracting (removing a part from the whole); "he complained about the subtraction of money from their paychecks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100232245"
	 b:glossaryEntry="the act of deducting (taxes) from an employee''s salary"/>
<rdf:Description rdf:about="&a;100232357"
	 b:glossaryEntry='the act of abating; "laws enforcing noise abatement"'/>
<rdf:Description rdf:about="&a;100232465">
	<b:glossaryEntry>the act of rubbing together; wearing something down by friction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100232584"
	 b:glossaryEntry="the act of letting the air out of something"/>
<rdf:Description rdf:about="&a;100232701"
	 b:glossaryEntry="the act of reducing the selling price of merchandise"/>
<rdf:Description rdf:about="&a;100232838"
	 b:glossaryEntry="reducing prices back to some earlier level"/>
<rdf:Description rdf:about="&a;100232935"
	 b:glossaryEntry="the act of reducing the strength of something"/>
<rdf:Description rdf:about="&a;100233090"
	 b:glossaryEntry="causing to become limp or drooping"/>
<rdf:Description rdf:about="&a;100233185">
	<b:glossaryEntry>weakening (reducing the concentration) by the addition of water or a thinner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100233363">
	<b:glossaryEntry>the act of diluting something; "the cutting of whiskey with water"; "the thinning of paint with turpentine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100233535">
	<b:glossaryEntry>the act of increasing something; "he gave me an increase in salary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100233991">
	<b:glossaryEntry>the act of adding one thing to another; "the addition of flowers created a pleasing effect"; "the addition of a leap day every four years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100234220">
	<b:glossaryEntry>increase in price or value: "the news caused a general advance on the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100234364">
	<b:glossaryEntry>an increase in price or value over time; "an appreciation of 30% in the value of real estate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100234534">
	<b:glossaryEntry>a decrease in price or value over time; "depreciation of the dollar against the yen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100234695">
	<b:glossaryEntry>a sudden or abrupt strong increase: "stimulated a surge of speculation"; "an upsurge of emotion"; "an upsurge in violent crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100234884">
	<b:glossaryEntry>the addition of a fluoride to the water supply (to prevent dental decay)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100235032"
	 b:glossaryEntry="the act of augmenting"/>
<rdf:Description rdf:about="&a;100235112">
	<b:glossaryEntry>(electricity) the act of increasing voltage or power or current</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100235235"
	 b:glossaryEntry="the act of increasing in size or volume or quantity or scope"/>
<rdf:Description rdf:about="&a;100235473">
	<b:glossaryEntry>the act of expanding an aperture; "the dilation of the pupil of the eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100235631"
	 b:glossaryEntry="dilation of blood vessels (especially the arteries)"/>
<rdf:Description rdf:about="&a;100235741"
	 b:glossaryEntry="the act of expanding by pressure from within"/>
<rdf:Description rdf:about="&a;100235855"
	 b:glossaryEntry="act of expanding by lengthening or widening"/>
<rdf:Description rdf:about="&a;100235973">
	<b:glossaryEntry>an increase to counteract a perceived discrepancy; "higher wages caused an escalation of prices" or "there was a gradual escalation of hostilities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100236177"
	 b:glossaryEntry="the act of maximizing something"/>
<rdf:Description rdf:about="&a;100236300"
	 b:glossaryEntry="a act of filling something with air"/>
<rdf:Description rdf:about="&a;100236409"
	 b:glossaryEntry="the act of expanding something in apparent size"/>
<rdf:Description rdf:about="&a;100236516">
	<b:glossaryEntry>the act of making something more noticeable than usual; "the dance involved a deliberate exaggeration of his awkwardness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100236696">
	<b:glossaryEntry>act of expanding in scope; making more widely available: "extension of the program to all in need"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100236886">
	<b:glossaryEntry>act of extending over a wider scope or expanse of space or time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100237068"
	 b:glossaryEntry="the act of dispersing something"/>
<rdf:Description rdf:about="&a;100237202">
	<b:glossaryEntry>the dispersion of fungicides or insecticides or fertilizer on growing crops (often from a low-flying aircraft)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100237382"
	 b:glossaryEntry="the act of scattering"/>
<rdf:Description rdf:about="&a;100237481"
	 b:glossaryEntry="an abnormal and usually permanent contraction of a muscle"/>
<rdf:Description rdf:about="&a;100237596"
	 b:glossaryEntry="act of stretching or straightening out a flexed limb"/>
<rdf:Description rdf:about="&a;100237740"
	 b:glossaryEntry="greater than normal extension"/>
<rdf:Description rdf:about="&a;100237830">
	<b:glossaryEntry>(physiology) a shortening or tensing of a part or organ (especially of a muscle or muscle fiber)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100238038">
	<b:glossaryEntry>a rhythmic tightening in labor of the upper uterine musculature that contracts the size of the uterus and pushes the fetus toward the birth canal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100238268">
	<b:glossaryEntry>extension to or beyond the ordinary limit; "running at full stretch"; "by no stretch of the imagination"; "beyond any stretch of his understanding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100238469"
	 b:glossaryEntry="adding information or detail"/>
<rdf:Description rdf:about="&a;100238624">
	<b:glossaryEntry>addition of extra material or illustration or clarifying detail: "a few remarks added in amplification and defense"; "an elaboration of the idea followed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100238852"
	 b:glossaryEntry="the act of adding notes"/>
<rdf:Description rdf:about="&a;100238945"
	 b:glossaryEntry="the act of supplementing"/>
<rdf:Description rdf:about="&a;100239058"
	 b:glossaryEntry="the act of accumulating"/>
<rdf:Description rdf:about="&a;100239181"
	 b:glossaryEntry="the act of building up an accumulation"/>
<rdf:Description rdf:about="&a;100239291"
	 b:glossaryEntry="the act of depositing"/>
<rdf:Description rdf:about="&a;100239397"
	 b:glossaryEntry="depositing in a warehouse"/>
<rdf:Description rdf:about="&a;100239542">
	<b:glossaryEntry>accumulating and storing a reserve supply: "the stockpiling of war materials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100239677"
	 b:glossaryEntry="the act of including"/>
<rdf:Description rdf:about="&a;100239807"
	 b:glossaryEntry="including by incorporation"/>
<rdf:Description rdf:about="&a;100239911"
	 b:glossaryEntry="incorporation by annexation"/>
<rdf:Description rdf:about="&a;100240011"
	 b:glossaryEntry="the act of comprising something"/>
<rdf:Description rdf:about="&a;100240115"
	 b:glossaryEntry="the act of containing something"/>
<rdf:Description rdf:about="&a;100240204">
	<b:glossaryEntry>the act of increasing the wealth or prestige or power or scope of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100240387">
	<b:glossaryEntry>an act undertaken to increase your own power and influence or to draw attention to your own importance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100240588"
	 b:glossaryEntry="the act of increasing the strength of something"/>
<rdf:Description rdf:about="&a;100240731"
	 b:glossaryEntry="action that makes something more intense"/>
<rdf:Description rdf:about="&a;100240869">
	<b:glossaryEntry>action that makes a problem or a disease (or its symptoms) worse; "the aggravation of her condition resulted from lack of care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100241069">
	<b:glossaryEntry>strengthening the concentration (as of a solute in a mixture) by removing extraneous material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100241258">
	<b:glossaryEntry>the concentration of a colloidal solution whose colloid will not pass through a semipermeable membrane; solution is placed in a bag of the membrane and the solvent is evaporated off</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100241499"
	 b:glossaryEntry="the act of bringing into focus"/>
<rdf:Description rdf:about="&a;100241632"
	 b:glossaryEntry="focusing again"/>
<rdf:Description rdf:about="&a;100241703"
	 b:glossaryEntry="the act of changing the unity or wholeness of something"/>
<rdf:Description rdf:about="&a;100242022">
	<b:glossaryEntry>the act of breaking something; "the breakage was unavoidable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100242229"
	 b:glossaryEntry="the act of making a sudden noisy break"/>
<rdf:Description rdf:about="&a;100242321"
	 b:glossaryEntry="the act of breaking something into small pieces"/>
<rdf:Description rdf:about="&a;100242436"
	 b:glossaryEntry="the act of cracking something"/>
<rdf:Description rdf:about="&a;100242539"
	 b:glossaryEntry="the act of chipping something"/>
<rdf:Description rdf:about="&a;100242644">
	<b:glossaryEntry>the act of exploding or bursting something; "the explosion of the firecrackers awoke the children"; "the burst of an atom bomb creates enormous radiation aloft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100242904"
	 b:glossaryEntry="the act of detonating an explosion"/>
<rdf:Description rdf:about="&a;100243013"
	 b:glossaryEntry="the act of exploding a percussion cap"/>
<rdf:Description rdf:about="&a;100243107">
	<b:glossaryEntry>the act of exploding with noise and violence; "his fulminations frightened the horses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100243251">
	<b:glossaryEntry>the act of burning something; "the burning of leaves was prohibited by a town ordinance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100243460">
	<b:glossaryEntry>malicious burning to destroy property; "the British term for arson is fire-raising"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100243625"
	 b:glossaryEntry="the act of starting a fire"/>
<rdf:Description rdf:about="&a;100243737">
	<b:glossaryEntry>the act of burning something completely; reducing it to ashes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100243875"
	 b:glossaryEntry="the incineration of a dead body"/>
<rdf:Description rdf:about="&a;100243962"
	 b:glossaryEntry="the act of combining things"/>
<rdf:Description rdf:about="&a;100244199"
	 b:glossaryEntry="the act of attaching something"/>
<rdf:Description rdf:about="&a;100244304"
	 b:glossaryEntry="the act of grafting something onto something else"/>
<rdf:Description rdf:about="&a;100244416">
	<b:glossaryEntry>the act of mixing; "paste made by a mixture of flour and water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100244573"
	 b:glossaryEntry="the act of fusing (or melting) together"/>
<rdf:Description rdf:about="&a;100244665"
	 b:glossaryEntry="the act of blending components together thoroughly"/>
<rdf:Description rdf:about="&a;100244814"
	 b:glossaryEntry="a flowing together (as of rivers)"/>
<rdf:Description rdf:about="&a;100244924"
	 b:glossaryEntry="the act of homogenizing"/>
<rdf:Description rdf:about="&a;100245025">
	<b:glossaryEntry>the act of combining one thing at intervals among other things; "the interspersion of illustrations in the text"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100245212">
	<b:glossaryEntry>making or becoming a single unit; "the union of opposing factions"; "he looked forward to the unification of his family for the holidays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100245479"
	 b:glossaryEntry="the union of diverse things into one body or form or group"/>
<rdf:Description rdf:about="&a;100245609"
	 b:glossaryEntry="the act of coming together again"/>
<rdf:Description rdf:about="&a;100245729">
	<b:glossaryEntry>having the function of uniting a group of similar things; "the Democratic Party is an umbrella for many liberal groups"; "under the umbrella of capitalism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100245939"
	 b:glossaryEntry="an annual school or university reunion for graduates"/>
<rdf:Description rdf:about="&a;100246048">
	<b:glossaryEntry>becoming open or being made open; "the opening of his arms was the sign I was waiting for"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100246210"
	 b:glossaryEntry="the act of dividing or disconnecting"/>
<rdf:Description rdf:about="&a;100246501">
	<b:glossaryEntry>an act of delaying or interrupting the continuity; "it was presented without commercial breaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100246736">
	<b:glossaryEntry>a forcible tearing or separation of one body part from another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100246853"
	 b:glossaryEntry="the act of removing from association"/>
<rdf:Description rdf:about="&a;100246948">
	<b:glossaryEntry>formal withdrawal or separation from an alliance or federation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100247097">
	<b:glossaryEntry>the act of breaking away or withdrawing from: "there was a breakaway by the discontented members"; "a breaking away from family and neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100247314"
	 b:glossaryEntry="the termination or destruction of union"/>
<rdf:Description rdf:about="&a;100247408"
	 b:glossaryEntry="the act of breaking a connection"/>
<rdf:Description rdf:about="&a;100247514"
	 b:glossaryEntry="the act or process of dividing or splitting"/>
<rdf:Description rdf:about="&a;100247828"
	 b:glossaryEntry="dividing into two equal parts"/>
<rdf:Description rdf:about="&a;100247913"
	 b:glossaryEntry="dividing into four equal parts"/>
<rdf:Description rdf:about="&a;100248000">
	<b:glossaryEntry>division of a group into opposing factions; "another schism like that and they will wind up in bankruptcy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100248167">
	<b:glossaryEntry>the act of cutting something into parts; "his cuts were skillful"; "his cutting of the cake made a terrible mess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100248412"
	 b:glossaryEntry="cutting so as to separate into pieces"/>
<rdf:Description rdf:about="&a;100248506"
	 b:glossaryEntry="the act of dividing by cutting or splitting"/>
<rdf:Description rdf:about="&a;100248604"
	 b:glossaryEntry="the act of cutting into slices"/>
<rdf:Description rdf:about="&a;100248688">
	<b:glossaryEntry>the act of penetrating or opening open with a sharp edge; "his cut in the lining revealed the hidden jewels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100248910"
	 b:glossaryEntry="a small cut"/>
<rdf:Description rdf:about="&a;100248988"
	 b:glossaryEntry="a strong sweeping cut made with a sharp instrument"/>
<rdf:Description rdf:about="&a;100249108"
	 b:glossaryEntry="separating something into fine particles"/>
<rdf:Description rdf:about="&a;100249236"
	 b:glossaryEntry="the act of branching out or dividing into branches"/>
<rdf:Description rdf:about="&a;100249446"
	 b:glossaryEntry="splitting into two branches"/>
<rdf:Description rdf:about="&a;100249531"
	 b:glossaryEntry="splitting into three branches"/>
<rdf:Description rdf:about="&a;100249619"
	 b:glossaryEntry="branching at a wide angle"/>
<rdf:Description rdf:about="&a;100249703"
	 b:glossaryEntry="act or process of forming fibrils"/>
<rdf:Description rdf:about="&a;100249795"
	 b:glossaryEntry="the act of dividing into two sharply different categories"/>
<rdf:Description rdf:about="&a;100249932">
	<b:glossaryEntry>the act of dividing into quanta or expressing in terms of quantum theory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100250078"
	 b:glossaryEntry="separation into portions"/>
<rdf:Description rdf:about="&a;100250162">
	<b:glossaryEntry>the use of certain marks to clarify meaning of written material by grouping words grammatically into sentences and clauses and phrases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100250391"
	 b:glossaryEntry="connecting syllables and words by hyphens"/>
<rdf:Description rdf:about="&a;100250509"
	 b:glossaryEntry="forming or dividing words into syllables"/>
<rdf:Description rdf:about="&a;100250627"
	 b:glossaryEntry="division of a word especially at the end of a line on a page"/>
<rdf:Description rdf:about="&a;100250780"
	 b:glossaryEntry="the act of releasing from an attachment or connection"/>
<rdf:Description rdf:about="&a;100250906">
	<b:glossaryEntry>the act of tearing; "he took the manuscript in both hands and gave it a mighty tear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100251077"
	 b:glossaryEntry="the act of lacerating"/>
<rdf:Description rdf:about="&a;100251155">
	<b:glossaryEntry>the act of rending or ripping or splitting something; "he gave the envelope a vigorous rip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100251311">
	<b:glossaryEntry>the act of removing; "he had surgery for the removal of a malignancy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100251679">
	<b:glossaryEntry>act of getting or draining something such as electricity or a liquid from a source: "the drawing of water from the well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100251903"
	 b:glossaryEntry="drawing off water from its main channel as for irrigation"/>
<rdf:Description rdf:about="&a;100252017">
	<b:glossaryEntry>drawing of fluid or inflammation away from a diseased part of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100252144"
	 b:glossaryEntry="the act of extracting something"/>
<rdf:Description rdf:about="&a;100252246">
	<b:glossaryEntry>the separation of grain or seeds from the husks and straw; "they used to do the threshing by hand but now there are machines to do it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100252436"
	 b:glossaryEntry="surgical removal of a body part or tissue"/>
<rdf:Description rdf:about="&a;100253111"
	 b:glossaryEntry="forced removal from a position of advantage"/>
<rdf:Description rdf:about="&a;100253227"
	 b:glossaryEntry="the act of removing or getting rid of something"/>
<rdf:Description rdf:about="&a;100253361">
	<b:glossaryEntry>the act of removing an unknown mathematical quantity by combining equations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100253494"
	 b:glossaryEntry="the act of cutting something off"/>
<rdf:Description rdf:about="&a;100253615"
	 b:glossaryEntry="surgical removal of the foreskin of males"/>
<rdf:Description rdf:about="&a;100253715"
	 b:glossaryEntry="the act of removing the contents of something"/>
<rdf:Description rdf:about="&a;100253857"
	 b:glossaryEntry="emptying accomplished by draining"/>
<rdf:Description rdf:about="&a;100253953"
	 b:glossaryEntry="the act of taking out money or other capital"/>
<rdf:Description rdf:about="&a;100254090"
	 b:glossaryEntry="the withdrawal of money from your account at a bank"/>
<rdf:Description rdf:about="&a;100254221">
	<b:glossaryEntry>the concerted action of depositors who try to withdraw their money from a bank because the think it will fail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100254385"
	 b:glossaryEntry="the withdrawal of capital from a country or corporation"/>
<rdf:Description rdf:about="&a;100254500"
	 b:glossaryEntry="the act of deleting something written or printed"/>
<rdf:Description rdf:about="&a;100254657"
	 b:glossaryEntry="the deletion of all passages considered to be indecent"/>
<rdf:Description rdf:about="&a;100254803">
	<b:glossaryEntry>deleting parts of publications or correspondence or theatrical performances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100254947"
	 b:glossaryEntry="deletion by an act of expunging or erasing"/>
<rdf:Description rdf:about="&a;100255068">
	<b:glossaryEntry>separation by the creation of a boundary that divides or keeps apart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100255302">
	<b:glossaryEntry>the division or partitioning of a cavity into parts by a septum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100255421">
	<b:glossaryEntry>the act of transforming; "a photograph is a translation of a scene onto a two-dimensional surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100255684">
	<b:glossaryEntry>complete change in character or condition: "the permutations...taking place in the physical world"- Henry Miller</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100255854">
	<b:glossaryEntry>the act of transforming; "it would require a drastic revision of his opinion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100256035"
	 b:glossaryEntry="the act of transforming so as to exalt or glorify"/>
<rdf:Description rdf:about="&a;100256146">
	<b:glossaryEntry>changing into a different form or appearance especially a fantastic or grotesque one: "transmogrification into a porcupine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100256334">
	<b:glossaryEntry>the act of changing from one use or function or purpose to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100256511">
	<b:glossaryEntry>the conversion of bare or cultivated land into forest (originally for the purpose of hunting)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100256664">
	<b:glossaryEntry>the restoration (replanting) of a forest that had been reduced by fire or cutting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100256824"
	 b:glossaryEntry="the restoration of someone to a useful place in society"/>
<rdf:Description rdf:about="&a;100256994">
	<b:glossaryEntry>providing penal custody or probation or parole for convicted offenders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100257138">
	<b:glossaryEntry>providing help for disabled persons; the removal or reduction of disabilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100257337">
	<b:glossaryEntry>providing training in a specific trade with the aim of gaining employment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100257482">
	<b:glossaryEntry>the act of restoring someone to a previous position; "we insisted on the reinstatement of the colonel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100257644"
	 b:glossaryEntry="the act of restoring to a more youthful condition"/>
<rdf:Description rdf:about="&a;100257770"
	 b:glossaryEntry="act of refreshing or renewing strength or liveliness"/>
<rdf:Description rdf:about="&a;100257880">
	<b:glossaryEntry>a complete change of physical form or substance especially as by magic or witchcraft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100258024">
	<b:glossaryEntry>a striking change in appearance or character or circumstances: "the metamorphosis of the old house into something new and exciting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100258215"
	 b:glossaryEntry="a act of filling something"/>
<rdf:Description rdf:about="&a;100258331"
	 b:glossaryEntry="the act of saturating something"/>
<rdf:Description rdf:about="&a;100258419">
	<b:glossaryEntry>the act of making something harder (firmer or tighter or more compact)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100258563"
	 b:glossaryEntry="hardening something by heat treatment"/>
<rdf:Description rdf:about="&a;100258668"
	 b:glossaryEntry="the act of damaging something or someone"/>
<rdf:Description rdf:about="&a;100258856"
	 b:glossaryEntry="damage that results in a reduction of strength or quality"/>
<rdf:Description rdf:about="&a;100258970"
	 b:glossaryEntry="damaging the appearance or surface of something"/>
<rdf:Description rdf:about="&a;100259090"
	 b:glossaryEntry="the act of inflicting a wound"/>
<rdf:Description rdf:about="&a;100259182"
	 b:glossaryEntry="damage inflicted by burning"/>
<rdf:Description rdf:about="&a;100259278"
	 b:glossaryEntry="the act of burning with steam or hot water"/>
<rdf:Description rdf:about="&a;100259372">
	<b:glossaryEntry>the act of changing something to bring it up to date (usually by adding something); "criminal records need regular updating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100259551"
	 b:glossaryEntry="an act that changes the shape of something"/>
<rdf:Description rdf:about="&a;100259853">
	<b:glossaryEntry>the act of twisting or deforming the shape of something (e.g., oneself)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100259995"
	 b:glossaryEntry="the act of making angulate (having corners)"/>
<rdf:Description rdf:about="&a;100260095"
	 b:glossaryEntry="the act of bending something"/>
<rdf:Description rdf:about="&a;100260261"
	 b:glossaryEntry="the act of bending low with the limbs close to the body"/>
<rdf:Description rdf:about="&a;100260369"
	 b:glossaryEntry="the act of lengthening something"/>
<rdf:Description rdf:about="&a;100260458"
	 b:glossaryEntry="the act of bending yourself up together"/>
<rdf:Description rdf:about="&a;100260549"
	 b:glossaryEntry="the act of enfolding something"/>
<rdf:Description rdf:about="&a;100260648">
	<b:glossaryEntry>the folding in of an outer layer so as to form a pocket in the surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100260807"
	 b:glossaryEntry='the act of folding; "he gave the napkins a double fold"'/>
<rdf:Description rdf:about="&a;100260941"
	 b:glossaryEntry="folding in parallel folds"/>
<rdf:Description rdf:about="&a;100261033"
	 b:glossaryEntry="the act of indenting"/>
<rdf:Description rdf:about="&a;100261111"
	 b:glossaryEntry="the act of projecting out from something"/>
<rdf:Description rdf:about="&a;100261237"
	 b:glossaryEntry="the act of making something wider"/>
<rdf:Description rdf:about="&a;100261356"
	 b:glossaryEntry="the act of making something narrower"/>
<rdf:Description rdf:about="&a;100261466">
	<b:glossaryEntry>any specific activity or pursuit; "they avoided all recreational activity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100262819"
	 b:glossaryEntry='domestic activities or life: "making a hobby of domesticity"'/>
<rdf:Description rdf:about="&a;100262937">
	<b:glossaryEntry>a planned activity involving many people performing various actions: "the biggest police operation in French history"; "running a restaurant is quite an operation"; "consolidate the companies various operations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100263204">
	<b:glossaryEntry>a customary way of operation or behavior; "it is their practice to give annual raises"; "they changed their dietary pattern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100263789">
	<b:glossaryEntry>translating an idea into action; "a hard theory to put into practice"; "they put their plans into practice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100263951">
	<b:glossaryEntry>use of biological principles in explaining human especially social behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100264082">
	<b:glossaryEntry>the practice of cooperating: "economic cooperation"; "they agreed on a policy of cooperation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100264233">
	<b:glossaryEntry>the practice (usually by a labor union) of requiring an employer to hire more workers than are required</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100264397">
	<b:glossaryEntry>the practice of scrupulous adherence to prescribed or external forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100264521">
	<b:glossaryEntry>the practice of keeping one jump ahead of a friend or competitor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100264645"
	 b:glossaryEntry="the practice of investing things with symbolic meaning"/>
<rdf:Description rdf:about="&a;100264755"
	 b:glossaryEntry="practices typical of contemporary life or thought"/>
<rdf:Description rdf:about="&a;100264860"
	 b:glossaryEntry="the practice of eating the flesh of your own kind"/>
<rdf:Description rdf:about="&a;100264967">
	<b:glossaryEntry>the practice of advancing your career at the expense of your personal integrity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100265102"
	 b:glossaryEntry="accepted practice"/>
<rdf:Description rdf:about="&a;100265306"
	 b:glossaryEntry="a custom that is peculiar to the US or its citizens"/>
<rdf:Description rdf:about="&a;100265415"
	 b:glossaryEntry="a custom that is peculiar to England or its citizens"/>
<rdf:Description rdf:about="&a;100265536"
	 b:glossaryEntry="a custom or usage that has acquired the force of law"/>
<rdf:Description rdf:about="&a;100265645">
	<b:glossaryEntry>a custom among some peoples whereby the husband of a pregnant wife is put to bed at the time of bearing the child</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100265812"
	 b:glossaryEntry="a custom that is peculiar to Germany or its citizens"/>
<rdf:Description rdf:about="&a;100265920">
	<b:glossaryEntry>a pattern of behavior acquired through frequent repetition; "she had a habit twirling the ends of her hair"; "long use had hardened him to it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100266181"
	 b:glossaryEntry="stereotyped behavior"/>
<rdf:Description rdf:about="&a;100266254"
	 b:glossaryEntry="habitual mode of behavior"/>
<rdf:Description rdf:about="&a;100266352">
	<b:glossaryEntry>the usual activities in your day; "the doctor made his rounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100266480"
	 b:glossaryEntry="characteristic or habitual practice"/>
<rdf:Description rdf:about="&a;100266587"
	 b:glossaryEntry="the practice of slaveholding"/>
<rdf:Description rdf:about="&a;100266669">
	<b:glossaryEntry>the practice of making a debtor work for his creditor until the debt is discharged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100266805">
	<b:glossaryEntry>a course of conduct; "the path of virtue"; "we went our separate ways"; "our paths in life led us apart"; "genius usually follows a revolutionary path"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100267117"
	 b:glossaryEntry="a way of life given to easy indulgence of the appetites"/>
<rdf:Description rdf:about="&a;100267230"
	 b:glossaryEntry="a life of ease and pleasure"/>
<rdf:Description rdf:about="&a;100267317">
	<b:glossaryEntry>the way of proper and honest behavior; "he taught his children to keep strictly to the straight and narrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100267490">
	<b:glossaryEntry>a vain and frivolous way of life especially in large cities (after a fair held in the town of Vanity in Pilgrim''s Progress)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100267671"
	 b:glossaryEntry="a course leading to warfare or battle"/>
<rdf:Description rdf:about="&a;100267762">
	<b:glossaryEntry>the easiest way; "In marrying him she simply took the path of least resistance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100267939"
	 b:glossaryEntry="law based on customary behavior"/>
<rdf:Description rdf:about="&a;100268030">
	<b:glossaryEntry>the practice of punishing people by hanging without due process of law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100268156">
	<b:glossaryEntry>the act of clasping another person in the arms (as in greeting or affection)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100268334"
	 b:glossaryEntry="a close and affectionate (and often prolonged) embrace"/>
<rdf:Description rdf:about="&a;100268460"
	 b:glossaryEntry="a tight embrace"/>
<rdf:Description rdf:about="&a;100268534">
	<b:glossaryEntry>the practice of treating (someone or something) badly; "he should be punished for his mistreatment of his mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100268796"
	 b:glossaryEntry="cruel or inhumane treatment"/>
<rdf:Description rdf:about="&a;100268990"
	 b:glossaryEntry="the physical or emotional or sexual mistreatment of children"/>
<rdf:Description rdf:about="&a;100269108">
	<b:glossaryEntry>failure of caretakers to provide adequate emotional and physical care for a child</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100269249">
	<b:glossaryEntry>the act of persecuting (especially on the basis of race or religion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100269429">
	<b:glossaryEntry>the act of piercing with a sharpened stake as a form of punishment or torture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100269563"
	 b:glossaryEntry="the act of subjugating by cruelty"/>
<rdf:Description rdf:about="&a;100269667"
	 b:glossaryEntry="organized persecution of an ethnic group (especially Jews)"/>
<rdf:Description rdf:about="&a;100269778"
	 b:glossaryEntry="the act of torturing someone"/>
<rdf:Description rdf:about="&a;100269890"
	 b:glossaryEntry="the infliction of extremely painful punishment or suffering"/>
<rdf:Description rdf:about="&a;100270022"
	 b:glossaryEntry="a cruel act; a deliberate infliction of pain and suffering"/>
<rdf:Description rdf:about="&a;100270190"
	 b:glossaryEntry="a act of atrocious cruelty"/>
<rdf:Description rdf:about="&a;100270320"
	 b:glossaryEntry="a brutal barbarous savage act"/>
<rdf:Description rdf:about="&a;100270440"
	 b:glossaryEntry="a wantonly cruel act"/>
<rdf:Description rdf:about="&a;100270514"
	 b:glossaryEntry="tormenting by continued persistent attacks and criticism"/>
<rdf:Description rdf:about="&a;100270731"
	 b:glossaryEntry="harassment especially of a tethered animal"/>
<rdf:Description rdf:about="&a;100270827"
	 b:glossaryEntry="the act of harassing someone"/>
<rdf:Description rdf:about="&a;100270946"
	 b:glossaryEntry="the act of annoying someone"/>
<rdf:Description rdf:about="&a;100271094"
	 b:glossaryEntry="actions that cause great irritation (or even anger)"/>
<rdf:Description rdf:about="&a;100271222"
	 b:glossaryEntry="unwelcome sexual behavior by a supervisor toward an employee"/>
<rdf:Description rdf:about="&a;100271346">
	<b:glossaryEntry>the act of teasing; provoking someone with persistent annoyances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100271472"
	 b:glossaryEntry="searching out and harassing dissenters"/>
<rdf:Description rdf:about="&a;100271585">
	<b:glossaryEntry>unscrupulously accusing people of disloyalty (as by saying they were Communists)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100271723"
	 b:glossaryEntry="lack of care and attention"/>
<rdf:Description rdf:about="&a;100271815"
	 b:glossaryEntry="an act that exploits or victimizes someone"/>
<rdf:Description rdf:about="&a;100271974">
	<b:glossaryEntry>exploitation by a stronger country of weaker one; the use of the weaker country''s resources to strengthen and enrich the stronger country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100272187">
	<b:glossaryEntry>control by a powerful country of its former colonies (or other less developed countries) by economic pressures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100272358"
	 b:glossaryEntry="an activity that diverts or amuses or stimulates"/>
<rdf:Description rdf:about="&a;100272781">
	<b:glossaryEntry>play by children that is guided more by imagination than by fixed rules; "Freud believed in the utility of play to a small child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100273030">
	<b:glossaryEntry>play in which children take the roles of father or mother or children and pretend to interact like adults; "the children were playing house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100273222">
	<b:glossaryEntry xml:space='preserve'><![CDATA[children take the roles of doctor or patient or nurse and pretend they are at the doctor''s office; "the children explored each other''s bodies by playing the game of doctor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100273447">
	<b:glossaryEntry>play in which children take the roles of firemen and pretend to put out a fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100273579">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a subject or pursuit that occupies one''s time and thoughts (usually pleasantly): "sailing is her favorite pastime"; "his main pastime is gambling"; "he counts reading among his interests"; "they criticized the boy for his limited interests"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100273902"
	 b:glossaryEntry="an auxiliary activity"/>
<rdf:Description rdf:about="&a;100274048">
	<b:glossaryEntry>an inclination to retreat from unpleasant realities through diversion or fantasy; "he escaped into romantic novels"; "his alcohol problem was a form of escapism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100274273">
	<b:glossaryEntry>an activity that you like or at which you are superior; "chemistry is not my cup of tea"; "his bag now is learning to play golf"; "marriage was scarcely his dish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100274505">
	<b:glossaryEntry>an active diversion requiring physical exertion and competition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100274956"
	 b:glossaryEntry="the occupation of athletes who compete for pay"/>
<rdf:Description rdf:about="&a;100275180">
	<b:glossaryEntry>a sport that necessarily involves body contact between opposing players</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100275347"
	 b:glossaryEntry="a sport that is played outdoors"/>
<rdf:Description rdf:about="&a;100275488">
	<b:glossaryEntry>a sport that involves exercises intended to display strength and balance and agility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100275647"
	 b:glossaryEntry="the gymnastic moves of an acrobat"/>
<rdf:Description rdf:about="&a;100275767">
	<b:glossaryEntry>an acrobatic feat in which the trunk is bent backward from a standing position until the hands touch the floor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100275932">
	<b:glossaryEntry>a feat in which an acrobat arches the back from a prone position and bends the knees until the toes touch the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100276104"
	 b:glossaryEntry="backbends combined with handstands"/>
<rdf:Description rdf:about="&a;100276193">
	<b:glossaryEntry>acrobatic revolutions with the body turned sideways and the arms and legs outstretched like the spokes of a wheel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100276362">
	<b:glossaryEntry>the act of supporting yourself by your hands alone in an upside down position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100276514">
	<b:glossaryEntry>raising the feet backward with the hands on the ground; a first movement in doing a handstand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100276680">
	<b:glossaryEntry>an acrobatic feat in which a person goes from a standing position to a handstand and back again</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100276832">
	<b:glossaryEntry>an acrobatic feat in which a person balances on the head (usually with the help of the hands)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100276981"
	 b:glossaryEntry="an acrobatic feat of rolling or turning end over end"/>
<rdf:Description rdf:about="&a;100277104">
	<b:glossaryEntry>extending the legs at right angles to the trunks (one in front and the other in back)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100277241"
	 b:glossaryEntry="a stunt performed by an acrobat"/>
<rdf:Description rdf:about="&a;100277532">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an increase in the number of outstanding shares of a corporation without changing the shareholders'' equity; "they announced a two-for-one split of the common stock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100277773">
	<b:glossaryEntry>a decrease in the number of outstanding shares of a corporation without changing the shareholders'' equity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100277973">
	<b:glossaryEntry>an acrobatic feat in which the feet roll over the head (either forward or backward) and return</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100278165"
	 b:glossaryEntry="a backward somersault"/>
<rdf:Description rdf:about="&a;100278242">
	<b:glossaryEntry>participating in athletic sports performed on a running track or on the field associated with it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100278455">
	<b:glossaryEntry>the act of participating in an athletic competition involving running on a track</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100278616">
	<b:glossaryEntry>the act of participating in an athletic competition in which you must jump</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100278798">
	<b:glossaryEntry>the act of participating in an athletic contest in which you try to jump as far as possible with a running jump from a fixed mark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100279015">
	<b:glossaryEntry>the act of participating in an athletic contest in which you try to jump as high as possible over a (horizontal) high bar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100279192"
	 b:glossaryEntry="a sport in which participants must travel on skis"/>
<rdf:Description rdf:about="&a;100279349">
	<b:glossaryEntry>the sport of skiing across the countryside (rather than downhill)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100279481">
	<b:glossaryEntry>the act of performing a jump of skis from a high ramp overhanging a snow covered slope</b:glossaryEntry>
</rdf:Description>
