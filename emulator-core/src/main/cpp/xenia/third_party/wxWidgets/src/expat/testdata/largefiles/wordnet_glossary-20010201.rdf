</rdf:Description>
<rdf:Description rdf:about="&a;108723548">
	<b:glossaryEntry>any of numerous varieties of Narcissus plants having showy often yellow flowers with a trumpet-shaped central crown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108723764">
