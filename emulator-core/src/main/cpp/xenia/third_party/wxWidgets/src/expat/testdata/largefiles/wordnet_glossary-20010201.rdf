	 b:glossaryEntry="an ornamental ginger native to Pacific islands"/>
<rdf:Description rdf:about="&a;108660730">
	<b:glossaryEntry>cultivated for its shining oblong leaves and arching clusters of white flowers with shell-pink shading and crinkled yellow lip with variegated magenta stripes</b:glossaryEntry>
</rdf:Description>
