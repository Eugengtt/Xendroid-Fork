<rdf:Description rdf:about="&a;100279937"
	 b:glossaryEntry="the act of swimming"/>
<rdf:Description rdf:about="&a;100280090">
	<b:glossaryEntry>the act of swimming; "the Englishman said he had a good bathe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100280204"
	 b:glossaryEntry="immersing the body in water or sunshine"/>
<rdf:Description rdf:about="&a;100280333"
	 b:glossaryEntry="bathing in the sea or ocean"/>
<rdf:Description rdf:about="&a;100280418"
	 b:glossaryEntry="immersing the body in sunlight"/>
<rdf:Description rdf:about="&a;100280506"
	 b:glossaryEntry="a brief swim in water"/>
<rdf:Description rdf:about="&a;100280586"
	 b:glossaryEntry="a headlong plunge into water"/>
<rdf:Description rdf:about="&a;100280782">
	<b:glossaryEntry>a dive in which the abdomen bears the main force of impact with the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100280957">
	<b:glossaryEntry>a dive in which the diver somersaults before entering the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100281071">
	<b:glossaryEntry>a dive in which the diver throws the feet forward to complete a full backward somersault and enters the water feet first and facing away from the diving board</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100281296">
	<b:glossaryEntry>a dive in which the diver throws the feet forward and up to complete a half backward somersault and enters the water facing the diving board</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100281494">
	<b:glossaryEntry>a dive in which the diver bends to touch the ankles before straightening out</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100281626">
	<b:glossaryEntry>a dive in which the diver arches the back with arms outstretched before entering the water</b:glossaryEntry>
</rdf:Description>
