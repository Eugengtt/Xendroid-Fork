<rdf:Description rdf:about="&a;400279640">
	<b:glossaryEntry>with little expenditure of money; "I bought this car very cheaply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400279776"
	 b:glossaryEntry='in a brash cheeky manner; "brashly, she asked for a rebate"'/>
<rdf:Description rdf:about="&a;400279946"
	 b:glossaryEntry='in a gallant manner; "he gallantly offered to take her home"'/>
<rdf:Description rdf:about="&a;400280113">
	<b:glossaryEntry>in a churlish manner; "the store owner treated his customers churlishly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400280270"
	 b:glossaryEntry="in a circular manner"/>
<rdf:Description rdf:about="&a;400280347">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a clannish manner; "these four friends always act clannishly, and don''t let us participate in their activities"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400280549">
	<b:glossaryEntry>in conformity with the rules or laws and without fraud or cheating; "they played fairly"</b:glossaryEntry>
</rdf:Description>
