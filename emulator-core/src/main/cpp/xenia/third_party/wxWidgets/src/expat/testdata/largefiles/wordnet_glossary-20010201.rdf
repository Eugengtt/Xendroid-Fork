</rdf:Description>
<rdf:Description rdf:about="&a;110295227">
	<b:glossaryEntry>inflammation of the cornea causing watery painful eyes and blurred vision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110295356"
	 b:glossaryEntry="inflammation of the cornea and the iris of the eye"/>
<rdf:Description rdf:about="&a;110295465"
	 b:glossaryEntry="inflammation of the cornea and sclera of the eye"/>
<rdf:Description rdf:about="&a;110295575">
	<b:glossaryEntry>inflammation of the inner ear; can cause vertigo and vomiting</b:glossaryEntry>
</rdf:Description>
