	<b:glossaryEntry>hybrid between mandarin orange and lemon having very acid fruit with orange peel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109011228">
	<b:glossaryEntry>a small evergreen tree that originated in Asia but is widely cultivated for its fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109011449">
	<b:glossaryEntry>lemon tree having fruit with a somewhat insipid sweetish pulp</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109011616"
	 b:glossaryEntry="any of various related trees bearing limes"/>
<rdf:Description rdf:about="&a;109011781"
	 b:glossaryEntry="a cross between Citrus sinensis and Poncirus_trifoliata"/>
<rdf:Description rdf:about="&a;109011952"
	 b:glossaryEntry="more aromatic and acidic than oranges"/>
<rdf:Description rdf:about="&a;109012120"
	 b:glossaryEntry="a dicotyledonous genus of the family Rutaceae"/>
