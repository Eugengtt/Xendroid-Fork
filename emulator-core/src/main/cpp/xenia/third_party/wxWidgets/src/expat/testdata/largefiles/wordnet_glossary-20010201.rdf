	 b:glossaryEntry="a genus of Loriinae"/>
<rdf:Description rdf:about="&a;101338376"
	 b:glossaryEntry="a kind of lorikeet"/>
<rdf:Description rdf:about="&a;101338503"
	 b:glossaryEntry="any of numerous small slender long-tailed parrots"/>
<rdf:Description rdf:about="&a;101338718"
	 b:glossaryEntry="a genus of Psittacidae"/>
