	 b:glossaryEntry='place into a river; "plant fish"'/>
<rdf:Description rdf:about="&a;201587826"
	 b:glossaryEntry='stock again; "He restocked his land with pheasants"'/>
<rdf:Description rdf:about="&a;201587942">
