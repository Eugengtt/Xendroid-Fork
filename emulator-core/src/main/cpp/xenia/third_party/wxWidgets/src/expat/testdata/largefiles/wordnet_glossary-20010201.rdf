	 b:glossaryEntry="genus of Australian desert lizard"/>
<rdf:Description rdf:about="&a;101209775"
	 b:glossaryEntry="any lizard of the genus Moloch"/>
<rdf:Description rdf:about="&a;101209895"
	 b:glossaryEntry="desert lizard that feeds on ants"/>
<rdf:Description rdf:about="&a;101210040"
	 b:glossaryEntry="alligator lizards"/>
<rdf:Description rdf:about="&a;101210225">
	<b:glossaryEntry>any of a small family of lizards widely distributed in warm areas; all are harmless and useful as destroyers of e.g. slugs and insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101210492"
	 b:glossaryEntry="alligator lizards"/>
<rdf:Description rdf:about="&a;101210625">
	<b:glossaryEntry>slim short-limbed lizard having a distinctive fold on each side that permits expansion; of western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101210819"
	 b:glossaryEntry="type genus of the Anguidae: blindworms"/>
<rdf:Description rdf:about="&a;101210963">
	<b:glossaryEntry>small burrowing legless European lizard with tiny eyes; popularly believed to be blind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101211153"
	 b:glossaryEntry="glass lizards"/>
<rdf:Description rdf:about="&a;101211280">
	<b:glossaryEntry>snakelike lizard of Europe Asia and North America with vestigial hind limbs and the ability to regenerate its long fragile tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101211513"
	 b:glossaryEntry="monotypic family of Mexican lizards"/>
<rdf:Description rdf:about="&a;101211667">
	<b:glossaryEntry>type and sole genus of Xenosauridae: slender-bodied Mexican lizards having the upper surface covered with tiny granules and tubercles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101211895"
	 b:glossaryEntry="legless lizards"/>
<rdf:Description rdf:about="&a;101212027">
