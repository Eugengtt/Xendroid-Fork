<rdf:Description rdf:about="&a;200753225"
	 b:glossaryEntry="steal a base, in baseball"/>
<rdf:Description rdf:about="&a;200753313">
	<b:glossaryEntry>recover something or somebody that appeared to be lost; "We got back the money after we threatened to sue the company"; "He got back his son from the kidnappers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200753559"
	 b:glossaryEntry='gain points; "The home team scored many times"'/>
<rdf:Description rdf:about="&a;200753872">
	<b:glossaryEntry>get a certain score; "She scored high on the SAT"; "He scored a 200"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200754029">
	<b:glossaryEntry>achieve a certain score or rating on a test; "She tested high on the LSAT and was admitted to all the good law schools"</b:glossaryEntry>
