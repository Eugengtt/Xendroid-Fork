	 b:glossaryEntry="a substance that oxidizes another substance"/>
<rdf:Description rdf:about="&a;110598803">
	<b:glossaryEntry>a substance capable of bringing about the reduction of another substance as it itself is oxidized</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110598961"
	 b:glossaryEntry="an adsorbent clay that will remove coloring from oils"/>
<rdf:Description rdf:about="&a;110599093">
