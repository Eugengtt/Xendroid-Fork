<rdf:Description rdf:about="&a;201529865"
	 b:glossaryEntry='deposit; "cast a vote"; "cast a ballot"'/>
<rdf:Description rdf:about="&a;201529966">
	<b:glossaryEntry>give the names of; "Name the states west of the Mississippi!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201530096">
