</rdf:Description>
<rdf:Description rdf:about="&a;108606435"
	 b:glossaryEntry="forsythia"/>
<rdf:Description rdf:about="&a;108606544">
	<b:glossaryEntry>any of various early blooming oleaceous shrubs of the genus Forsythia; native to eastern Asia and southern Europe but widely cultivated for their branches of bright yellow bell-shaped flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108606810"
	 b:glossaryEntry="ash"/>
<rdf:Description rdf:about="&a;108606923">
	<b:glossaryEntry>any of various deciduous pinnate-leaved ornamental or timber trees of the genus Fraxinus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108607363">
	<b:glossaryEntry>strong elastic wood of any of various ash trees; used for furniture and tool handles and sporting goods such as baseball bats</b:glossaryEntry>
