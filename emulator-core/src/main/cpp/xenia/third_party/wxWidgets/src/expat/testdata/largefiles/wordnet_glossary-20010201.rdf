	 b:glossaryEntry="drop from an airplane and descend with a parachute"/>
<rdf:Description rdf:about="&a;201340005">
	<b:glossaryEntry>move upward; "The fog lifted"; "The smoke arose from the forest fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201340367"
	 b:glossaryEntry='travel up, "We ascended the mountain"'/>
<rdf:Description rdf:about="&a;201340520"
