</rdf:Description>
<rdf:Description rdf:about="&a;101872124">
	<b:glossaryEntry>in former classifications a major division of Mammalia comprising mammals with nails or claws; distinguished from hoofed mammals and cetaceans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101872343"
	 b:glossaryEntry="a mammal having nails or claws"/>
<rdf:Description rdf:about="&a;101872452">
