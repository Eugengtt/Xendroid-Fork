</rdf:Description>
<rdf:Description rdf:about="&a;108750272">
	<b:glossaryEntry>perennial plant having umbel-like clusters of 1-4 showy white bell-shaped flowers atop erect unbranched stems; edible bulbs useful in times of scarcity; eastern Montana and western North Dakota south to northern Arizona and northwestern New Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108750599">
	<b:glossaryEntry>genus of scapose herbs of North and South America having large edible bulbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108750871">
	<b:glossaryEntry>any of several plants of the genus Camassia; North and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108751101">
	<b:glossaryEntry>plant having a large edible bulb and linear basal leaves and racemes of light to deep violet-blue star-shaped flowers on tall green scapes; western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108751359"
	 b:glossaryEntry="west of Cascade Mountains"/>
<rdf:Description rdf:about="&a;108751490"
	 b:glossaryEntry="eastern camas; eastern and central North America"/>
<rdf:Description rdf:about="&a;108751655">
