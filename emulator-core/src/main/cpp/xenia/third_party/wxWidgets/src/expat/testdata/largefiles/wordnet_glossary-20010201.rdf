	 b:glossaryEntry="mottled curly-grained wood of Pterocarpus indicus"/>
<rdf:Description rdf:about="&a;108866133"
	 b:glossaryEntry="tree of India and Burma yielding a wood resembling mahogany"/>
<rdf:Description rdf:about="&a;108866315">
