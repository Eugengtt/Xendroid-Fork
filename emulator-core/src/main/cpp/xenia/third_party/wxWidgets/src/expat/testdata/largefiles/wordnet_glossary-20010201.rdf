	 b:glossaryEntry="small pointed ridge on the exoskeleton of an arthropod"/>
<rdf:Description rdf:about="&a;101664008">
	<b:glossaryEntry>sharp curved horny process on the toe of a bird or some mammals or reptiles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101664180"
	 b:glossaryEntry="claw of a bear; often used in jewelry"/>
<rdf:Description rdf:about="&a;101664273"
	 b:glossaryEntry="a sharp hooked claw esp. on a bird of prey"/>
<rdf:Description rdf:about="&a;101664386">
	<b:glossaryEntry>a structure like a pincer on the limb of a crustacean or other arthropods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101664555">
	<b:glossaryEntry>a vertebrate animal having four feet or legs or leglike appendages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101664694">
	<b:glossaryEntry>an animal esp. a mammal having four limbs specialized for walking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101664986"
	 b:glossaryEntry="an animal with two feet"/>
<rdf:Description rdf:about="&a;101665080">
	<b:glossaryEntry>the underpart of the body of certain vertebrates such as snakes or fish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101665222">
	<b:glossaryEntry>the posterior part of the body of a vertebrate especially when elongated and extending beyond the trunk or main part of the body</b:glossaryEntry>
</rdf:Description>
