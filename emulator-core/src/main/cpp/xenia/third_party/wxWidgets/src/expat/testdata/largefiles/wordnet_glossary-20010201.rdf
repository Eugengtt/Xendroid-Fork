</rdf:Description>
<rdf:Description rdf:about="&a;400452237"
	 b:glossaryEntry='in a sloppy manner; "this work was done rather sloppily"'/>
<rdf:Description rdf:about="&a;400452348">
	<b:glossaryEntry>with a slouching gait or posture; "he stood slouchingly at the garden gate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400452481"
	 b:glossaryEntry='in a slouchy manner; "slouchily dressed"'/>
<rdf:Description rdf:about="&a;400452577"
	 b:glossaryEntry='with a loud crash; "the car went smash through the fence"'/>
<rdf:Description rdf:about="&a;400452681">
	<b:glossaryEntry>with smiles; in a smiling manner; "the girl reminded her smilingly of their childhood spent together"</b:glossaryEntry>
</rdf:Description>
