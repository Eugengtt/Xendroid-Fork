<rdf:Description rdf:about="&a;400450165"
	 b:glossaryEntry='in a skimpy manner; "a skimpily dressed woman"'/>
<rdf:Description rdf:about="&a;400450266"
	 b:glossaryEntry='in a skittish manner; "the horse pranced around skittishly"'/>
<rdf:Description rdf:about="&a;400450382">
