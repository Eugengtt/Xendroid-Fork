</rdf:Description>
<rdf:Description rdf:about="&a;400448001"
	 b:glossaryEntry='on the side; "the plow lay sidelong on the ground"'/>
<rdf:Description rdf:about="&a;400448088"
	 b:glossaryEntry='toward one side; "turn the figure sideward"'/>
<rdf:Description rdf:about="&a;400448180">
	<b:glossaryEntry>toward one side; "the car slipped sideways into the ditch"; "leaning sideways"; "a figure moving sidewise in the shadows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400448359">
	<b:glossaryEntry>from the side; obliquely; "a picture lit sideways"; "scenes viewed sidewise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400448493">
	<b:glossaryEntry>with one side forward or to the front; "turned sideways to show the profile"; "crabs seeming to walk sidewise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400448661"
	 b:glossaryEntry='in a signal manner; "signally inappropriate methods"'/>
<rdf:Description rdf:about="&a;400448796">
	<b:glossaryEntry>as a signal; "a term that is used signally rather than symbolically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400448901">
