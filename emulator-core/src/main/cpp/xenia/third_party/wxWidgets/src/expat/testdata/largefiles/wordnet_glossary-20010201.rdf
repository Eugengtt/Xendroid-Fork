	 b:glossaryEntry="African shrike"/>
<rdf:Description rdf:about="&a;101122507"
	 b:glossaryEntry="a genus of Malaconotinae"/>
<rdf:Description rdf:about="&a;101122651"
	 b:glossaryEntry="a kind of bush shrike"/>
<rdf:Description rdf:about="&a;101122790"
	 b:glossaryEntry="bowerbirds"/>
<rdf:Description rdf:about="&a;101122967">
	<b:glossaryEntry>any of various birds of the Australian region whose males build ornamented structures resembling bowers in order to attract females</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101123219"
	 b:glossaryEntry="type genus of the Ptilonorhynchidae"/>
<rdf:Description rdf:about="&a;101123378">
	<b:glossaryEntry>of southeast Australia; male is glossy violet blue; female is light gray-green</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101123578"
	 b:glossaryEntry="a genus of Ptilonorhynchidae"/>
<rdf:Description rdf:about="&a;101123720"
	 b:glossaryEntry="large bowerbird of northern Australia"/>
<rdf:Description rdf:about="&a;101123860"
	 b:glossaryEntry="water ouzels"/>
<rdf:Description rdf:about="&a;101124004">
