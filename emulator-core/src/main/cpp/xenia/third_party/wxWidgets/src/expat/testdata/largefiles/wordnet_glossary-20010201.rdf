	 b:glossaryEntry="fine ravellings of cotton or linen fibers"/>
<rdf:Description rdf:about="&a;110719097">
	<b:glossaryEntry>an enzyme secreted in the digestive tract that catalyzes the breakdown of fats</b:glossaryEntry>
</rdf:Description>
