</rdf:Description>
<rdf:Description rdf:about="&a;100576494"
	 b:glossaryEntry="(British military slang) drill on a barracks square"/>
<rdf:Description rdf:about="&a;100576606">
	<b:glossaryEntry>a practice session in preparation for a public performance of a play or speech or concert</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100576793">
