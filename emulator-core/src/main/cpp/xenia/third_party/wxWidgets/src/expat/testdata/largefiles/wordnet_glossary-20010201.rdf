</rdf:Description>
<rdf:Description rdf:about="&a;201058868"
	 b:glossaryEntry='produce a mottled effect; "The sunlight stippled the trees"'/>
<rdf:Description rdf:about="&a;201059010">
	<b:glossaryEntry>spot, splash, or soil; "The baby spattered the bib with food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201059148"
	 b:glossaryEntry="become permanently attached, as of mollusks or oysters"/>
