	 b:glossaryEntry="any culture medium that uses agar as the gelling agent"/>
<rdf:Description rdf:about="&a;110691397"
	 b:glossaryEntry="a culture medium containing whole blood as the nutrient"/>
<rdf:Description rdf:about="&a;110691509"
	 b:glossaryEntry="a gum used especially as a thickener or emulsifier"/>
<rdf:Description rdf:about="&a;110691626">
	<b:glossaryEntry>exudation from trees of the prunus genus; resembles gum arabic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110691750"
	 b:glossaryEntry="gum-like substance from the sapodilla"/>
<rdf:Description rdf:about="&a;110691872"
	 b:glossaryEntry="a gum prepared for chewing; sweetened and flavored"/>
<rdf:Description rdf:about="&a;110691999">
