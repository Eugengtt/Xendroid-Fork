</rdf:Description>
<rdf:Description rdf:about="&a;200285583">
	<b:glossaryEntry>make a country technologically advanced; "Many countries in Asia are now highly developed"; "Viet Nam is modernizing rapidly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200285796">
	<b:glossaryEntry>put under state control or ownership; "Mitterand nationalized the banks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200285973">
	<b:glossaryEntry>put under private control or ownership; "The steel industry was denationalized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200286159">
