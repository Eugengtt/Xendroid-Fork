	 b:glossaryEntry="a recurrent rhythmical series"/>
<rdf:Description rdf:about="&a;103900289"
	 b:glossaryEntry="a jaunty rhythm in music"/>
<rdf:Description rdf:about="&a;103900372"
	 b:glossaryEntry="a property appreciated via the sense of taste"/>
