</rdf:Description>
<rdf:Description rdf:about="&a;101224041"
	 b:glossaryEntry="horned dinosaurs"/>
<rdf:Description rdf:about="&a;101224269">
	<b:glossaryEntry>any of several four-footed herbivorous horned dinosaurs with enormous beaked skulls; of the late Cretaceous in North America and Mongolia</b:glossaryEntry>
</rdf:Description>
