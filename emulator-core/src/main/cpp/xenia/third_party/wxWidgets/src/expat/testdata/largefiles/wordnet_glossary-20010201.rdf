	 b:glossaryEntry="reduce to beggary"/>
<rdf:Description rdf:about="&a;201584161">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reduce to bankruptcy; "My daughter''s fancy wedding is going to break me!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201584323">
	<b:glossaryEntry>become bankrupt or insolvent; fail financially and close; "The toy company went bankrupt after the competition hired cheap Mexican labor"; "A number of banks failed that year"</b:glossaryEntry>
