</rdf:Description>
<rdf:Description rdf:about="&a;108114042"
	 b:glossaryEntry="thick creeping evergreen herb of western Europe"/>
<rdf:Description rdf:about="&a;108114165">
	<b:glossaryEntry>a group of families of mostly flowers having basal or free-central placentation and trinucleate pollen (binucleate pollen is commoner in flowering plants); contains 14 families including: Caryophyllaceae (carnations and pinks); Aizoaceae; Amaranthaceae; Batidaceae; Chenopodiaceae; Cactaceae (order Opuntiales); Nyctaginaceae; Phytolaccaceae; corresponds approximately to order Caryophyllales; sometimes classified as a superorder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108114777"
	 b:glossaryEntry="corresponds approximately to the older group Centrospermae"/>
<rdf:Description rdf:about="&a;108115128">
	<b:glossaryEntry>used in former classification systems; approximately synonymous with order Caryophyllales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108115299">
	<b:glossaryEntry>large family of herbs or subshrubs (usually with stems swollen at the nodes)</b:glossaryEntry>
</rdf:Description>
