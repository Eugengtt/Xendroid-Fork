<rdf:Description rdf:about="&a;200923629">
	<b:glossaryEntry xml:space='preserve'><![CDATA[twist or pull violently or suddenly, esp. so as to remove (something) from that to which it is attached; "wrench a window off its hinges"; "wrench oneself free from somebody''s grip"; also metaphorically: "a deep sigh was wrenched from his chest"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200923962">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take away with force; "She wrested the will from her brother''s hands"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200924127">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take or grasp suddenly; "She grabbed the child''s hand and ran out of the room"]]></b:glossaryEntry>
</rdf:Description>
