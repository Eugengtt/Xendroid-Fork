</rdf:Description>
<rdf:Description rdf:about="&a;101230406"
	 b:glossaryEntry="huge quadrupedal herbivorous dinosaur; late Jurassic"/>
<rdf:Description rdf:about="&a;101230559"
	 b:glossaryEntry="5-story-tall dinosaur"/>
<rdf:Description rdf:about="&a;101230667"
	 b:glossaryEntry="a reptile genus of the suborder Sauropoda"/>
<rdf:Description rdf:about="&a;101230809">
