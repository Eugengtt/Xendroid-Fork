	 b:glossaryEntry="be in contact with"/>
<rdf:Description rdf:about="&a;200820743">
	<b:glossaryEntry>make physical contact with, come in contact with; "Touch the stone for good luck"; "She never touched her husband"; "The two buildings almost touch"</b:glossaryEntry>
</rdf:Description>
