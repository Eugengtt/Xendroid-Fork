<rdf:Description rdf:about="&a;400257040"
	 b:glossaryEntry='in an approving manner; "she nodded approvingly"'/>
<rdf:Description rdf:about="&a;400257180"
	 b:glossaryEntry='showing disapproval; "he shook his head disapprovingly"'/>
