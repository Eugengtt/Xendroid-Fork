</rdf:Description>
<rdf:Description rdf:about="&a;102072955"
	 b:glossaryEntry="small family of marine fishes having covered gills"/>
<rdf:Description rdf:about="&a;102073132"
	 b:glossaryEntry="important marine food fishes"/>
<rdf:Description rdf:about="&a;102073247">
	<b:glossaryEntry>tropical freshwater fishes of Africa and S and Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102073481"
	 b:glossaryEntry="former name of the Characidae"/>
<rdf:Description rdf:about="&a;102073591"
	 b:glossaryEntry="any freshwater fish of the family Characinidae"/>
<rdf:Description rdf:about="&a;102073792"
	 b:glossaryEntry="tetras"/>
<rdf:Description rdf:about="&a;102073914"
	 b:glossaryEntry="brightly colored tropical freshwater fishes"/>
<rdf:Description rdf:about="&a;102074028"
	 b:glossaryEntry="a genus of Characidae"/>
<rdf:Description rdf:about="&a;102074169">
	<b:glossaryEntry>small bright red and blue aquarium fish from streams in Brazil and Columbia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102074349"
	 b:glossaryEntry="piranhas"/>
<rdf:Description rdf:about="&a;102074473">
	<b:glossaryEntry>small voraciously carnivorous freshwater fishes of South America that attack and destroy living animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102074667">
	<b:glossaryEntry>any of various elongated tactile or prehensile flexible organs that occur on the head or near the mouth in many animals used for feeling or grasping or locomotion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102074920">
	<b:glossaryEntry>one of a pair of mobile appendages on the head of e.g. insects and crustaceans; typically sensitive to touch and taste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102075101">
	<b:glossaryEntry>bristlelike process near the tip of the antenna of certain flies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102075218"
	 b:glossaryEntry="slender tactile process on the jaws of a fish"/>
<rdf:Description rdf:about="&a;102075325">
	<b:glossaryEntry>one of the paired abdominal appendages of certain aquatic crustaceans that function primarily for carrying the eggs in females and are usually adapted for swimming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102075611"
	 b:glossaryEntry="cichlids"/>
<rdf:Description rdf:about="&a;102075751">
	<b:glossaryEntry>freshwater fishes of tropical America and Africa and Asia similar to American sunfishes; some are food fishes; many small ones are popular in aquariums</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102076008"
	 b:glossaryEntry="a genus of Cichlidae"/>
<rdf:Description rdf:about="&a;102076117">
	<b:glossaryEntry>important food fish of the Nile and other rivers of Africa and Asia Minor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102076261"
	 b:glossaryEntry="snappers"/>
<rdf:Description rdf:about="&a;102076422">
	<b:glossaryEntry>any of several large sharp-toothed marine food and sport fishes of the family Lutjanidae of mainly tropical coastal waters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102076744"
	 b:glossaryEntry="type genus of the Lutjanidae: snappers"/>
<rdf:Description rdf:about="&a;102076930">
	<b:glossaryEntry>esteemed food fish with pinkish red head and body; common in American Atlantic coastal waters and Gulf of Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102077160"
	 b:glossaryEntry="found in shallow waters off the coast of Florida"/>
<rdf:Description rdf:about="&a;102077324"
	 b:glossaryEntry='similar to and often marketed as "red snapper"'/>
<rdf:Description rdf:about="&a;102077462"
	 b:glossaryEntry="food fish of warm Caribbean and Atlantic waters"/>
<rdf:Description rdf:about="&a;102077605"
	 b:glossaryEntry="snappers"/>
<rdf:Description rdf:about="&a;102077721">
	<b:glossaryEntry>superior food fish of the tropical Atlantic and Caribbean with broad yellow stripe along the sides and on the tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102077952"
	 b:glossaryEntry="grunts"/>
<rdf:Description rdf:about="&a;102078130">
	<b:glossaryEntry>medium-sized tropical marine food fishes that utter a grunting sound when caught</b:glossaryEntry>
</rdf:Description>
