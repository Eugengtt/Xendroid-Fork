<rdf:Description rdf:about="&a;201340778"
	 b:glossaryEntry="become a queen, of a chess pawn"/>
<rdf:Description rdf:about="&a;201340872"
	 b:glossaryEntry="perform a chandelle, as of a plane"/>
<rdf:Description rdf:about="&a;201340981"
	 b:glossaryEntry="rise as vapor"/>
<rdf:Description rdf:about="&a;201341057"
	 b:glossaryEntry='come up, of celestial bodies; "The sun also rises"'/>
<rdf:Description rdf:about="&a;201341197">
	<b:glossaryEntry>disappear beyond the horizon; of celestial bodies such as the sun and the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201341375">
	<b:glossaryEntry>move downward but not necessarily all the way; "The temperature is going down"; "The barometer is falling"; "Real estate prices are coming down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201342017"
	 b:glossaryEntry="fall headlong"/>
<rdf:Description rdf:about="&a;201342107"
	 b:glossaryEntry='descend into some soft substance; "He sank into bed"'/>
<rdf:Description rdf:about="&a;201342245">
	<b:glossaryEntry>pass into a specified state or condition: "He sank into Nirvana"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201342394">
	<b:glossaryEntry>descend in free fall under the influence of gravity; "The branch fell from the tree"; "The unfortunate hiker fell into a crevasse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201342612">
	<b:glossaryEntry>fall or come down violently; "The branch crashed down on my car"; "The plane crashed in the sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201342795"
	 b:glossaryEntry="fall suddenly and abruptly"/>
<rdf:Description rdf:about="&a;201342891"
	 b:glossaryEntry='fall loosely; "He flopped into a chair"'/>
<rdf:Description rdf:about="&a;201343000">
	<b:glossaryEntry>curl over and fall apart in surf or foam, of waves; "The surf broke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201343131"
	 b:glossaryEntry="move something or somebody to a lower position"/>
<rdf:Description rdf:about="&a;201343401">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lower (one''s body) as by kneeling; "Get down on your knees!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201343551">
	<b:glossaryEntry>lower and bring partially inboard, as of a mast on a sailboat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201343674">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move upwards; "lift one''s eyes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201343793">
	<b:glossaryEntry>lower (prices or markets); "The glut of oil depressed gas prices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201343923">
	<b:glossaryEntry>raise from a lower to a higher position; "Raise your hands"; "Lift a load"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201344489"
	 b:glossaryEntry="elevate onto skids"/>
<rdf:Description rdf:about="&a;201344569">
	<b:glossaryEntry>raise on or as if on a pinnacle: "He did not want to be pinnacled"</b:glossaryEntry>
</rdf:Description>
