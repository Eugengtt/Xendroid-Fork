</rdf:Description>
<rdf:Description rdf:about="&a;101673572"
	 b:glossaryEntry="fireflies"/>
<rdf:Description rdf:about="&a;101673696">
	<b:glossaryEntry>nocturnal beetle common in warm regions having luminescent abdominal organs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101673878"
	 b:glossaryEntry="the luminous larva or wingless grub-like female of a firefly"/>
<rdf:Description rdf:about="&a;101673993"
	 b:glossaryEntry="long-horned beetles"/>
<rdf:Description rdf:about="&a;101674150"
	 b:glossaryEntry="long-bodied beetle having very long antennae"/>
<rdf:Description rdf:about="&a;101674327"
	 b:glossaryEntry="sawyer beetles"/>
<rdf:Description rdf:about="&a;101674474">
