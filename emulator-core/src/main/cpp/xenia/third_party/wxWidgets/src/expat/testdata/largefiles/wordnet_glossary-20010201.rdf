</rdf:Description>
<rdf:Description rdf:about="&a;400213115">
	<b:glossaryEntry>showing thoughtfulness; "he had thoughtfully brought with him some food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400213264">
	<b:glossaryEntry>showing thoughtlessness; "he treated his parents thoughtlessly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400213405">
	<b:glossaryEntry>in a thoughtful manner; "he stared thoughtfully out the window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400213545">
	<b:glossaryEntry>in a thoughtless manner; "he stared thoughtlessly at the picture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400213734">
	<b:glossaryEntry>in an auspicious manner; "he started his new job auspiciously on his birthday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400213940">
	<b:glossaryEntry>in an inauspicious manner; "he started his new job inauspiciously on Friday the 13th"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400214157"
	 b:glossaryEntry='in a relentless manner; "he worked relentlessly"'/>
<rdf:Description rdf:about="&a;400214298">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a rueful manner; "`I made a big mistake,'' he said ruefully"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400214479"
	 b:glossaryEntry='with the front foremost; "the cars collided head-on"'/>
<rdf:Description rdf:about="&a;400214567">
	<b:glossaryEntry>in direct opposition; directly; "we must meet the problem head-on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400214669"
	 b:glossaryEntry='in an inexorable manner; "time marches on inexorably"'/>
<rdf:Description rdf:about="&a;400214779">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a polite manner; "the policeman answered politely, `Now look here, lady...''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400215040"
	 b:glossaryEntry='in an impolite manner; "he treated her impolitely"'/>
<rdf:Description rdf:about="&a;400215267">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an admirable manner; "the children''s responses were admirably normal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400215491">
	<b:glossaryEntry>in an enjoyable manner; "we spent a pleasantly lazy afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400215706">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a cheerful manner; "`I''ll do the dishes,'' he said pleasantly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400215884">
	<b:glossaryEntry>in an unpleasant manner; "he had been unpleasantly surprised"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400216022">
	<b:glossaryEntry>in an inverted manner; "the box was lying on the floor upside down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400216129"
	 b:glossaryEntry='in a breathless manner; "she spoke gaspingly"'/>
<rdf:Description rdf:about="&a;400216245">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a hearty manner; "`Yes,'' the children chorused heartily"; "We welcomed her warmly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400216442">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an affable manner; "`Come and visit me,'' he said amiably"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400216613">
	<b:glossaryEntry>with laughter; while laughing; "he told the story laughingly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400216731"
	 b:glossaryEntry='in an ambiguous manner; "this letter is worded ambiguously"'/>
<rdf:Description rdf:about="&a;400216898">
	<b:glossaryEntry>in an unambiguous manner; "she stated her intentions unequivocally,"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400217098">
	<b:glossaryEntry>in a ceremonial manner; "he was ceremonially sworn in as President"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400217253">
	<b:glossaryEntry>in an unceremonious manner; "he was dismissed unceremoniously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400217395">
	<b:glossaryEntry>in a ceremonious manner; "my mother advised her children ceremoniouslly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400217560"
	 b:glossaryEntry='in a rakish manner; "she wore her hat rakishly at an angle"'/>
<rdf:Description rdf:about="&a;400217717"
	 b:glossaryEntry='in a carefree manner; "she was rollickingly happy"'/>
<rdf:Description rdf:about="&a;400217841">
	<b:glossaryEntry>in a narrow manner; not allowing for exceptions; "he interprets the law narrowly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400217995">
	<b:glossaryEntry>without regard to specific details or exceptions; "he interprets the law broadly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400218207"
	 b:glossaryEntry='in a wide fashion; "he smiled broadly"'/>
<rdf:Description rdf:about="&a;400218299"
	 b:glossaryEntry='doing twirls; "they had a most twirlingly magnificent time"'/>
<rdf:Description rdf:about="&a;400218397">
	<b:glossaryEntry>in or to or toward the rear; "he followed behind"; "seen from behind, the house is more imposing than it is from the front"; "the final runners were far behind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400218592">
	<b:glossaryEntry>remaining in a place or condition that has been left or departed from; "when he died he left much unfinished work behind"; "left a large family behind"; "the children left their books behind"; "he took off with a squeal of tires and left the other cars far behind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400218891">
	<b:glossaryEntry>in debt; "he fell behind with his mortgage payments"; "a month behind in the rent"; "a company that has been run behindhand for years"; "in arrears with their utility bills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400219125">
	<b:glossaryEntry>in or into an inferior position; "fell behind in his studies"; "their business was lagging behind in the competition for customers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400219291">
	<b:glossaryEntry>of timepieces; "the clock is almost an hour slow"; "my watch is running behind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400219412">
	<b:glossaryEntry xml:space='preserve'><![CDATA[by right; "baseball rightfully is the nation''s pastime"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400219550">
	<b:glossaryEntry xml:space='preserve'><![CDATA[by reason of one''s own ability or ownership etc.; "she''s a rich woman in her own right rather than by inheritance"; "an excellent novel in its own right"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400219807">
	<b:glossaryEntry>in a faithful manner; "it always came on, faithfully, like the radio"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400220047"
	 b:glossaryEntry="in an unfaithful undependable unreliable manner"/>
<rdf:Description rdf:about="&a;400220271"
	 b:glossaryEntry='in a violent manner; "they attacked violently"'/>
<rdf:Description rdf:about="&a;400220391">
	<b:glossaryEntry>without violence; "the government was overthrown nonviolently, but the dictator was killed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400220559">
	<b:glossaryEntry>(of the elements) in a wild and stormy manner; "winds were blowing furiously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400220692">
	<b:glossaryEntry>in an impassioned or very angry manner; "she screamed furiously at her tormentors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400220830">
	<b:glossaryEntry>in a manner marked by extreme or violent energy; "the boys fought furiously"; "she went peddling furiously up the narrow street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400221014"
	 b:glossaryEntry='alternately upward and downward; "he eyed him up and down"'/>
<rdf:Description rdf:about="&a;400221112">
	<b:glossaryEntry>in a secure manner; in a manner free from danger; "she held the child securely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400221255">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a wry manner; "`I see,'' he commented wryly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400221353">
	<b:glossaryEntry>continuing forever without end; "there are infinitely many possibilities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400221531">
	<b:glossaryEntry>with a finite limit; "there are finitely many solutions to this problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400221676"
	 b:glossaryEntry='without bounds; "he is infinitely wealthy"'/>
<rdf:Description rdf:about="&a;400221822">
	<b:glossaryEntry>in a rigorous manner; "he had been trained rigorously by the monks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400221975"
	 b:glossaryEntry='in a plastic manner; "he used the clay plastically"'/>
<rdf:Description rdf:about="&a;400222084"
	 b:glossaryEntry='in a boastful manner; "he talked big all evening"'/>
<rdf:Description rdf:about="&a;400222217"
	 b:glossaryEntry='in a major way; "the play failed big at the box office"'/>
<rdf:Description rdf:about="&a;400222304"
	 b:glossaryEntry='on a grand scale; "think big"'/>
<rdf:Description rdf:about="&a;400222383"
	 b:glossaryEntry='on a small scale; "think small"'/>
<rdf:Description rdf:about="&a;400222466"
	 b:glossaryEntry='extremely well; "his performance went over big"'/>
<rdf:Description rdf:about="&a;400222545"
	 b:glossaryEntry='in a wary manner; "the sailor watched the sky warily"'/>
<rdf:Description rdf:about="&a;400222669"
	 b:glossaryEntry="without heed or caution"/>
<rdf:Description rdf:about="&a;400222765"
	 b:glossaryEntry='in bodily form; "he was translated bodily to heaven"'/>
<rdf:Description rdf:about="&a;400222870"
	 b:glossaryEntry='throughout a period of time; "stay over the weekend"'/>
<rdf:Description rdf:about="&a;400222962">
	<b:glossaryEntry>at or to a point across intervening space etc.; "come over and see us some time"; "over there"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400223089"
	 b:glossaryEntry='throughout an area; "he is known the world over"'/>
<rdf:Description rdf:about="&a;400223170">
	<b:glossaryEntry>by means of an editorial; "the paper commented editorially on the scandal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400223340">
	<b:glossaryEntry>in actual fact; "properly speaking, they are not husband and wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400223488">
	<b:glossaryEntry>in an abnormal manner; "they were behaving abnormally"; "his blood pressure was abnormally low"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400223640"
	 b:glossaryEntry='with anger; "he angrily denied the accusation"'/>
<rdf:Description rdf:about="&a;400223740"
	 b:glossaryEntry='in an exultant manner; "it was exultingly easy"'/>
<rdf:Description rdf:about="&a;400223875">
	<b:glossaryEntry>in a sedulous manner; "this illusion has been sedulously fostered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400223998">
	<b:glossaryEntry>in a tenuous manner; "his works tenuously survive in the minds of a few scholars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400224135">
	<b:glossaryEntry>in a perennial manner; repeatedly; "We want to know what is perennually new about the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400224285">
	<b:glossaryEntry>everlastingly; for all time; "rays...streaming perpetually from the sun"- Stuart Chase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400224429">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an anachronistic manner; "let''s look at this phenomenon anachronistically"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400224570">
	<b:glossaryEntry>with ineptitude; in an incompetent manner; "he performed his functions ineptly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400224734">
	<b:glossaryEntry>in an infelicitous manner; "this function is ineptly left to a small voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400224863">
	<b:glossaryEntry>in a very pleasurable manner; "they were walking along the beach slowly and deliciously"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400225041"
	 b:glossaryEntry='in your mind; "he suffered mentally"'/>
<rdf:Description rdf:about="&a;400225132"
	 b:glossaryEntry='in a round manner; "she was roundly slim"'/>
<rdf:Description rdf:about="&a;400225227"
	 b:glossaryEntry='in a shy or timid or bashful manner; "he smiled shyly"'/>
<rdf:Description rdf:about="&a;400225391"
	 b:glossaryEntry='with fondness; with love; "she spoke to her children fondly"'/>
<rdf:Description rdf:about="&a;400225533"
	 b:glossaryEntry="in bed"/>
<rdf:Description rdf:about="&a;400225572">
	<b:glossaryEntry>with much noise or loud and unpleasant sound; "he blew his nose noisily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400225716">
	<b:glossaryEntry>with little or no sound; "the class was listening quietly and intently"; "she was crying quietly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400225885"
	 b:glossaryEntry='at the moment of birth; "the child died aborning"'/>
<rdf:Description rdf:about="&a;400225982">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with little or no activity or especially agitation; "her hands rested quietly in her lap"; "the rock star was quietly led out the back door"; (`quiet'' is a nonstandard variant for `quietly'' as in "sit here as quiet as you can")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400226289"
	 b:glossaryEntry="with agitation or turbulence"/>
<rdf:Description rdf:about="&a;400226391"
	 b:glossaryEntry="without qualification or limitation"/>
<rdf:Description rdf:about="&a;400226486"
	 b:glossaryEntry='in outward appearance; "outwardly, she appeared composed"'/>
<rdf:Description rdf:about="&a;400226617"
	 b:glossaryEntry='with respect to private feelings; "inwardly, she was raging"'/>
<rdf:Description rdf:about="&a;400226759">
	<b:glossaryEntry>with respect to the outside; "outwardly, the figure is smooth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400226872"
	 b:glossaryEntry='showing approval; "he reviewed the play favorably"'/>
<rdf:Description rdf:about="&a;400227009">
	<b:glossaryEntry>showing disapproval; in a disparaging way; "he reviewed the play unfavorably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400227177"
	 b:glossaryEntry='in a cheerful manner; "he cheerfully agreed to do it"'/>
<rdf:Description rdf:about="&a;400227305">
	<b:glossaryEntry>in an unhappy manner; "he cheerlessly set out to do the task"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400227424"
	 b:glossaryEntry='in an adroit manner; "he bounced it cleanly off the wall"'/>
<rdf:Description rdf:about="&a;400227566"
	 b:glossaryEntry='with strength and soundness; "a solidly built house"'/>
<rdf:Description rdf:about="&a;400227672"
	 b:glossaryEntry='in a square position; "the building stood foursquare"'/>
<rdf:Description rdf:about="&a;400227764">
	<b:glossaryEntry>as an undiversified whole; "the unions voted solidly for Roosevelt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400227885"
	 b:glossaryEntry='in a dry laconic manner; "I know that," he said dryly'/>
<rdf:Description rdf:about="&a;400228022"
	 b:glossaryEntry='in accommodation; "obligingly, he lowered his voice"'/>
<rdf:Description rdf:about="&a;400228167">
	<b:glossaryEntry>out of your own free will; "he voluntarily submitted to the fingerprinting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400228318">
	<b:glossaryEntry>against your will; "he was involuntarily held against his will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400228459"
	 b:glossaryEntry='without making errors; "he unerringly fixed things for us"'/>
<rdf:Description rdf:about="&a;400228574">
	<b:glossaryEntry>with respect to geography; "they are geographically closer to the center of town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400228716"
	 b:glossaryEntry='with gloom; "such a change is gloomily foreseen by many"'/>
<rdf:Description rdf:about="&a;400228827"
	 b:glossaryEntry='under cruel circumstances; "a cruelly bitter winter"'/>
<rdf:Description rdf:about="&a;400228933"
	 b:glossaryEntry='in a cruel manner; "he treated his students cruelly"'/>
<rdf:Description rdf:about="&a;400229039">
	<b:glossaryEntry>in a vague way; "he looked vaguely familiar"; "he explained it somewhat mistily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400229183">
	<b:glossaryEntry>in a pompous manner; "he pompously described his achievements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400229301"
	 b:glossaryEntry='away from home; "they went out last night"'/>
<rdf:Description rdf:about="&a;400229375">
	<b:glossaryEntry xml:space='preserve'><![CDATA[from a particular thing or place or position; "ran away from the lion"; " wanted to get away from there"; "sent the children away to boarding school"; "the teacher waved the children away from the dead animal"; "went off to school"; "they drove off"; (`forth'' is obsolete as in "go forth and preach")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400229722">
	<b:glossaryEntry xml:space='preserve'><![CDATA[from one''s possession; "he gave out money to the poor"; "gave away the tickets"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400229840">
	<b:glossaryEntry>in reserve; not for immediate use; "started setting aside money to buy a car"; "put something by for her old age"; "has a nestegg tucked away for a rainy day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400230044">
	<b:glossaryEntry>on or to one side; "step aside"; "stood aside to let him pass"; "threw the book aside"; "put her sewing aside when he entered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400230204">
	<b:glossaryEntry xml:space='preserve'><![CDATA[out of the way (especially away from one''s thoughts); "brush the objections aside"; "pushed all doubts away"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400230353">
	<b:glossaryEntry>placed or kept separate and distinct as for a purpose; "had a feeling of being set apart"; "quality sets it apart"; "a day set aside for relaxing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400230541">
	<b:glossaryEntry>away from another or others; "they grew apart over the years"; "kept apart from the group out of shyness"; "decided to live apart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400230705">
	<b:glossaryEntry>out of existence; "the music faded away"; "tried to explain away the affair of the letter"- H.E.Scudder; "idled the hours away"; "her fingernails were worn away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400230899">
	<b:glossaryEntry>indicating continuing action; continuously or steadily; "he worked away at the project for more than a year"; "the child kept hammering away as if his life depended on it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400231103">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a different direction; "turn aside"; "turn away one''s face"; "glanced away"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400231222">
	<b:glossaryEntry>in or into a proper place (especially for storage or safekeeping); "put the toys away; "her jewels are locked away in a safe"; "filed the letter away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400231405">
	<b:glossaryEntry>at a distance in space or time; "the boat was 5 miles off (or away)"; "the party is still 2 weeks off (or away)"; "away back in the l8th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400231589">
	<b:glossaryEntry>so as to be removed or gotten rid of; "cleared the mess away"; "the rotted wood had to be cut away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400231721"
	 b:glossaryEntry='freely or at will; "fire away!'/>
<rdf:Description rdf:about="&a;400231784"
	 b:glossaryEntry="in a series; one after another"/>
<rdf:Description rdf:about="&a;400231851"
	 b:glossaryEntry='with obstinate determination; "he pursued her doggedly"'/>
<rdf:Description rdf:about="&a;400231993"
	 b:glossaryEntry='in an efficient manner; "he functions efficiently"'/>
<rdf:Description rdf:about="&a;400232171">
	<b:glossaryEntry>in an inefficient manner; "he dealt inefficiently with the crisis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400232315"
	 b:glossaryEntry='in a discordant manner; "the piece ended discordantly"'/>
<rdf:Description rdf:about="&a;400232445"
	 b:glossaryEntry='without liveliness; "she nodded her head dully"'/>
<rdf:Description rdf:about="&a;400232544">
	<b:glossaryEntry>without luster or shine; "the light shone dully through the haze"; "unpolished buttons glinted dully"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400232697">
	<b:glossaryEntry>without losing equilibrium; "she took all his criticism in stride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400232844"
	 b:glossaryEntry='without tonality; "he composes atonally"'/>
