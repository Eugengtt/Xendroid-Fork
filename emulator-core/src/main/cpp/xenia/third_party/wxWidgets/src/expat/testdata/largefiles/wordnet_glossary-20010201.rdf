<rdf:Description rdf:about="&a;201328654"
	 b:glossaryEntry="transport by freight"/>
<rdf:Description rdf:about="&a;201328739">
	<b:glossaryEntry>cause to go somewhere; "The explosion sent the car flying in the air"; "She sent her children to camp"; "He directed all his energies into his dissertation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201329160">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to send or let go; "The crowd was turned away at the gate of the governor''s mansion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201329314">
	<b:glossaryEntry>send on a course or in a direction different from the planned or intended one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201329515">
	<b:glossaryEntry>divert in a specified direction: "divert the low voltage to the engine cylinders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201329683"
	 b:glossaryEntry="send via a specific route"/>
<rdf:Description rdf:about="&a;201329795">
	<b:glossaryEntry>send or direct for treatment, information, or a decision: "refer a patient to a specialist"; "refer a bill to a committee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201330016"
	 b:glossaryEntry="send back to a committee, of a bill"/>
<rdf:Description rdf:about="&a;201330117"
	 b:glossaryEntry="channel into a new direction"/>
<rdf:Description rdf:about="&a;201330244"
	 b:glossaryEntry="direct energy or urges into useful activities"/>
<rdf:Description rdf:about="&a;201330374"
	 b:glossaryEntry="direct one''s libidinous urges into another direction"/>
<rdf:Description rdf:about="&a;201330495">
	<b:glossaryEntry>move something or somebody around; usually over long distances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201330882"
	 b:glossaryEntry="transport something by truck"/>
