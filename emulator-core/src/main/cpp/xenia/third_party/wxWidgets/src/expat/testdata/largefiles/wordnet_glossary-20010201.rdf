<rdf:Description rdf:about="&a;102078892"
	 b:glossaryEntry="found off the West Indies and Florida"/>
<rdf:Description rdf:about="&a;102079026"
	 b:glossaryEntry="of warm Atlantic waters"/>
<rdf:Description rdf:about="&a;102079146"
	 b:glossaryEntry="found from Florida to Brazil and Gulf of Mexico"/>
<rdf:Description rdf:about="&a;102079308"
	 b:glossaryEntry="a genus of Haemulidae"/>
<rdf:Description rdf:about="&a;102079445">
	<b:glossaryEntry>black and gold grunt found from Bermuda to Caribbean to Brazil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102079606">
	<b:glossaryEntry>dusky gray food fish found from Louisiana and Florida southward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102079765"
	 b:glossaryEntry="a genus of Haemulidae"/>
<rdf:Description rdf:about="&a;102079904"
	 b:glossaryEntry="found from Long Island southward"/>
<rdf:Description rdf:about="&a;102080047"
	 b:glossaryEntry="porgies; scups"/>
<rdf:Description rdf:about="&a;102080305">
	<b:glossaryEntry>spiny-finned food fishes of warm waters having well-developed teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102080512">
	<b:glossaryEntry>any of numerous marine percoid fishes especially (but not exclusively) of the family Sparidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102080797">
	<b:glossaryEntry>important deep-bodied food and sport fish of warm and tropical coastal waters; found worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102081015"
	 b:glossaryEntry="a genus of Sparidae"/>
<rdf:Description rdf:about="&a;102081140">
	<b:glossaryEntry>food fish of the Mediterranean and Atlantic coasts of Europe and America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102081303"
	 b:glossaryEntry="sea breams"/>
<rdf:Description rdf:about="&a;102081423"
	 b:glossaryEntry="food fish of European coastal waters"/>
<rdf:Description rdf:about="&a;102081567"
	 b:glossaryEntry="a genus of Sparidae"/>
<rdf:Description rdf:about="&a;102081721"
	 b:glossaryEntry="sea bream of warm Atlantic waters"/>
<rdf:Description rdf:about="&a;102081865">
	<b:glossaryEntry>large (up to 20 lbs) food fish of the eastern coast of the United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102082054"
	 b:glossaryEntry="a genus of Sparidae"/>
<rdf:Description rdf:about="&a;102082181">
	<b:glossaryEntry>similar to sea bream; small spiny-finned fish found in bays along the southeastern coast of the United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102082417"
	 b:glossaryEntry="a genus of Sparidae"/>
<rdf:Description rdf:about="&a;102082544"
	 b:glossaryEntry="from Florida and Bahamas to Brazil"/>
<rdf:Description rdf:about="&a;102082676"
	 b:glossaryEntry="australian snapper"/>
<rdf:Description rdf:about="&a;102082829"
	 b:glossaryEntry="Australian food fish having a pinkish body with blue spots"/>
<rdf:Description rdf:about="&a;102083001">
	<b:glossaryEntry>important dark-colored edible food and game fish of Australia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102083163"
	 b:glossaryEntry="scups"/>
