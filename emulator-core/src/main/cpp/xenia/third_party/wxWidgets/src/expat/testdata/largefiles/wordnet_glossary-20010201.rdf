	 b:glossaryEntry="a brittle aromatic resin used in varnishes"/>
<rdf:Description rdf:about="&a;110686467"
	 b:glossaryEntry="partly mineralized copal dug from the ground"/>
<rdf:Description rdf:about="&a;110686592"
	 b:glossaryEntry="copal found usually as a fossil"/>
<rdf:Description rdf:about="&a;110686693">
	<b:glossaryEntry>resin of the kauri trees of N Zealand; found usually as a fossil; also collected for making varnishes and linoleum</b:glossaryEntry>
</rdf:Description>
