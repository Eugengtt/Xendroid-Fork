	 b:glossaryEntry="a pyridine ring with three phosphorus groups"/>
<rdf:Description rdf:about="&a;110818752"
	 b:glossaryEntry="a coenzyme of several enzymes"/>
<rdf:Description rdf:about="&a;110818857">
