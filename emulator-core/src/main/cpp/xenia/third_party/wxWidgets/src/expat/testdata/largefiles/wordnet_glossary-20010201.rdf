	 b:glossaryEntry="inflammation of the gall bladder"/>
<rdf:Description rdf:about="&a;110291698"
	 b:glossaryEntry="inflammation of the vocal cords"/>
<rdf:Description rdf:about="&a;110291785"
	 b:glossaryEntry="inflammation of the spermatic cord"/>
<rdf:Description rdf:about="&a;110291875"
	 b:glossaryEntry="inflammation of the colon"/>
