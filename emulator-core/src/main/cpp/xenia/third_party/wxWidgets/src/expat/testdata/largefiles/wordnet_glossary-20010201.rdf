	 b:glossaryEntry="a light shade of red"/>
<rdf:Description rdf:about="&a;103885791"
	 b:glossaryEntry="a pink or reddish-pink color"/>
<rdf:Description rdf:about="&a;103885875"
	 b:glossaryEntry="a dusty pink color"/>
<rdf:Description rdf:about="&a;103885962"
	 b:glossaryEntry="a greyish-pink color"/>
