</rdf:Description>
<rdf:Description rdf:about="&a;200268771"
	 b:glossaryEntry='go back to a previous state; "We reverted to the old rules"'/>
<rdf:Description rdf:about="&a;200268967"
	 b:glossaryEntry='make according to requirements; "customize a car"'/>
<rdf:Description rdf:about="&a;200269114"
	 b:glossaryEntry='make personal or more personal; "personalized service"'/>
<rdf:Description rdf:about="&a;200269295">
