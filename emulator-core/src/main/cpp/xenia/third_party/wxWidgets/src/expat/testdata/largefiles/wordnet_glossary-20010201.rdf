</rdf:Description>
<rdf:Description rdf:about="&a;110720487"
	 b:glossaryEntry="a substance that is liquid at room temperature and pressure"/>
<rdf:Description rdf:about="&a;110720815"
	 b:glossaryEntry="nitrogen in a liquid state"/>
<rdf:Description rdf:about="&a;110720921"
	 b:glossaryEntry="air in a liquid state"/>
<rdf:Description rdf:about="&a;110721017"
	 b:glossaryEntry="a solution containing bleaching agents; used for laundry"/>
