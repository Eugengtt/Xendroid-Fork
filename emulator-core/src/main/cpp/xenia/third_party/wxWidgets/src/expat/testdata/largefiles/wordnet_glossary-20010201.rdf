	<b:glossaryEntry>in gymnastics: raise oneself while hanging from one''s hands until one''s chin is level with the support bar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201344879"
	 b:glossaryEntry='cause to puff up with a leaven; of dough; "unleavened bread"'/>
<rdf:Description rdf:about="&a;201345037"
	 b:glossaryEntry="increase the height of"/>
<rdf:Description rdf:about="&a;201345133"
