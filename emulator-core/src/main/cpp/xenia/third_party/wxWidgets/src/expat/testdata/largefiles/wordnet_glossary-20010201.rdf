</rdf:Description>
<rdf:Description rdf:about="&a;201332693"
	 b:glossaryEntry="ride in a conveyance with no particular goal"/>
<rdf:Description rdf:about="&a;201332831"
	 b:glossaryEntry="travel by getting free rides from motorists"/>
<rdf:Description rdf:about="&a;201332965"
	 b:glossaryEntry="give a passenger or a hitchhiker a lift"/>
<rdf:Description rdf:about="&a;201333069"
	 b:glossaryEntry="ride a snowmobile"/>
<rdf:Description rdf:about="&a;201333162"
	 b:glossaryEntry="ride on someone''s shoulders or back"/>
<rdf:Description rdf:about="&a;201333288">
	<b:glossaryEntry>sit and travel on the back of animal, usually while controlling its motions; "She never sat a horse!" "Did you ever ride a camel?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201333584">
	<b:glossaryEntry>driving animals such as horses and cattle while riding along with them; "Joe was riding herd during the day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201333759"
	 b:glossaryEntry="ride better or faster than"/>
<rdf:Description rdf:about="&a;201333850"
	 b:glossaryEntry="get off (a horse)"/>
<rdf:Description rdf:about="&a;201333972"
	 b:glossaryEntry="ride on horseback"/>
<rdf:Description rdf:about="&a;201334115"
	 b:glossaryEntry='ride at a canter; "The men cantered away"'/>
<rdf:Description rdf:about="&a;201334220">
	<b:glossaryEntry>ride at a cantering pace; "He cantered the horse across the meadow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201334351"
	 b:glossaryEntry="go at a canter, of horses"/>
<rdf:Description rdf:about="&a;201334440"
	 b:glossaryEntry="walk at a pace"/>
<rdf:Description rdf:about="&a;201334516"
	 b:glossaryEntry='ride at a galloping pace; "He was galloping down the road"'/>
<rdf:Description rdf:about="&a;201334638">
	<b:glossaryEntry>cause to move at full gallop; "Did you gallop the horse just now?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201334777"
	 b:glossaryEntry="go at a rack, as of horses"/>
<rdf:Description rdf:about="&a;201334879">
	<b:glossaryEntry>go at galloping speed, as of horses; "The horse was galloping along"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201335011"
	 b:glossaryEntry="go at a rack, of horses"/>
<rdf:Description rdf:about="&a;201335096"
	 b:glossaryEntry="ride at a trot"/>
<rdf:Description rdf:about="&a;201335172">
	<b:glossaryEntry>travel through water; "We had to swim for 20 minutes to reach the shore"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201335430">
	<b:glossaryEntry>show the fins above the water while swimming (of fish); "The sharks were finning near the surface"</b:glossaryEntry>
</rdf:Description>
