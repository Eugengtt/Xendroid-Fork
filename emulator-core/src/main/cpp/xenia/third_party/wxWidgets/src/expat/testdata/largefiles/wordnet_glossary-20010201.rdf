<rdf:Description rdf:about="&a;200164129"
	 b:glossaryEntry='make smaller; "reduce an image"'/>
<rdf:Description rdf:about="&a;200164255"
	 b:glossaryEntry='make large; "blow up an image"'/>
<rdf:Description rdf:about="&a;200164388"
	 b:glossaryEntry='draw together; "The fabric shrank"'/>
<rdf:Description rdf:about="&a;200164533">
	<b:glossaryEntry>become longer by being stretched and pulled; "The fabric stretches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200164725">
	<b:glossaryEntry>reduce in size; reduce physically; "Hot water will shrink the sweater"; "Can you shrink this image?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200165014"
	 b:glossaryEntry="reduce (a sail) by taking in a reef"/>
<rdf:Description rdf:about="&a;200165111"
	 b:glossaryEntry="design or construct on a smaller scale"/>
<rdf:Description rdf:about="&a;200165232">
	<b:glossaryEntry>wither, esp. with a loss of moisture; "The fruit dried and shriveled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200165451">
	<b:glossaryEntry>suffer from a disease that kills shoots; "The plants near the garage are dying back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200165612">
	<b:glossaryEntry>dry up and shrivel due to complete loss of moisture; "a mummified body was found"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200165767"
	 b:glossaryEntry='make less complex; "reduce a problem to a single question"'/>
<rdf:Description rdf:about="&a;200165926"
	 b:glossaryEntry='unite into one; "The companies consolidated"'/>
<rdf:Description rdf:about="&a;200166039">
	<b:glossaryEntry>bring together into a single whole or system; "The town and county schools are being consolidated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200166214">
	<b:glossaryEntry>unite closely or intimately; "Her gratitude welded her to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200166362"
	 b:glossaryEntry='join or combine; "We merged our resources"'/>
<rdf:Description rdf:about="&a;200166527">
	<b:glossaryEntry xml:space='preserve'><![CDATA[shorten, as of words; "Abbreviate `New York'' and write `NY''."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200166656">
	<b:glossaryEntry>reduce in scope while retaining essential elements; "The manuscript must be shortened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200166932">
	<b:glossaryEntry>shorten lines in a drawing so as to create an illusion of depth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200167064"
	 b:glossaryEntry="put in a short or concise form; reduce in volume"/>
<rdf:Description rdf:about="&a;200167181">
	<b:glossaryEntry>make more concise; "condense the contents of a book into a summary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200167380">
	<b:glossaryEntry>make smaller or shorter; "the novel was telescoped into a short play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200167516"
	 b:glossaryEntry='become less in amount or intensity; "The storm abated"'/>
<rdf:Description rdf:about="&a;200167689"
	 b:glossaryEntry="make less active or intense"/>
<rdf:Description rdf:about="&a;200167804">
	<b:glossaryEntry>cause to grow or develop: "He grows vegetables in his backyard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200167983"
	 b:glossaryEntry="grow as twins, of crystals"/>
<rdf:Description rdf:about="&a;200168071"
	 b:glossaryEntry='increase twofold; "The population doubled within 50 years"'/>
<rdf:Description rdf:about="&a;200168275"
	 b:glossaryEntry='double again: "The noise doubled and redoubled"'/>
<rdf:Description rdf:about="&a;200168388">
	<b:glossaryEntry>arrange or combine in pairs; "The consonants are geminated in these words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200168528"
	 b:glossaryEntry='increase threefold; "Triple your income!"'/>
<rdf:Description rdf:about="&a;200168658"
	 b:glossaryEntry="become abundant; increase rapidly"/>
<rdf:Description rdf:about="&a;200168758"
	 b:glossaryEntry='increase fourfold; "His stock earning quadrupled"'/>
<rdf:Description rdf:about="&a;200168890">
	<b:glossaryEntry>combine or increase by multiplication; "He managed to multiply his profits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200169130"
	 b:glossaryEntry='make multiple copies of; "multiply a letter"'/>
<rdf:Description rdf:about="&a;200169240">
	<b:glossaryEntry>grow or reproduce rapidly; "Health food shops proliferate in this region"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200169382"
	 b:glossaryEntry='grow old or older; "She aged gracefully"'/>
<rdf:Description rdf:about="&a;200169547">
	<b:glossaryEntry>begin to seem older; get older; "The death of his wife caused him to age fast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200169694"
	 b:glossaryEntry='make progress; "He progressed well in school"'/>
<rdf:Description rdf:about="&a;200169914"
	 b:glossaryEntry="progress by large jumps instead of small increments"/>
<rdf:Description rdf:about="&a;200170039"
	 b:glossaryEntry="get worse; fall back to a previous or worse condition"/>
<rdf:Description rdf:about="&a;200170235"
	 b:glossaryEntry="become mentally inflexible"/>
<rdf:Description rdf:about="&a;200170328"
	 b:glossaryEntry='make older; "The death of his child aged him tremendously"'/>
<rdf:Description rdf:about="&a;200170483"
	 b:glossaryEntry='grow ripe; "The plums ripen in July"'/>
<rdf:Description rdf:about="&a;200170582"
	 b:glossaryEntry='cause to ripen; "The sun ripens the fruit"'/>
<rdf:Description rdf:about="&a;200170705">
	<b:glossaryEntry>develop and reach maturity; undergo maturation; "He matured fast"; "The child grew fast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200170955">
	<b:glossaryEntry>become attached by or as if by the process of growth; "The tree trunks had grown together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200171107">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accept and make use of one''s personality, abilities, and situation; "My son went to Berkeley to find himself"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200171286">
	<b:glossaryEntry>make younger or more youthful; "The contact with his grandchildren rejuvenated him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200171455"
	 b:glossaryEntry='undergo an evolution; "Modern man evolved a long time ago"'/>
<rdf:Description rdf:about="&a;200171595"
	 b:glossaryEntry='come up with; "We evolved an interesting idea"'/>
<rdf:Description rdf:about="&a;200171716"
	 b:glossaryEntry='work out in detail; "elaborate a plan"'/>
<rdf:Description rdf:about="&a;200171832">
	<b:glossaryEntry>cause to develop or evolve, esp. from a latent or potential state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200171969"
	 b:glossaryEntry='come from; "The present name derives from an older form"'/>
<rdf:Description rdf:about="&a;200172114">
	<b:glossaryEntry>grow, progress, unfold, or evolve gradually through a process of evolution, natural growth, or differentiation; "A flower developed on the branch"; "The country developed into a mighty superpower"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200172633">
	<b:glossaryEntry xml:space='preserve'><![CDATA[form steadily; "Resistance to the manager''s plan built up quickly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200172812">
	<b:glossaryEntry>increase or strengthen gradually; "This investment is building interest"; "We worked up courage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200173000"
	 b:glossaryEntry='give an antique appearance to; "antique furniture"'/>
<rdf:Description rdf:about="&a;200173127"
	 b:glossaryEntry="make obsolete or old-fashioned"/>
<rdf:Description rdf:about="&a;200173224">
	<b:glossaryEntry>cause to grow and differentiate in ways conforming to its natural development; "The perfect climate here develops the grain"; "He developed a new kind of apple"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200173577">
	<b:glossaryEntry>develop under favorable conditions, such as germs and bacteria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200173705"
	 b:glossaryEntry='grow (more) mellow; "With age, he mellowed"'/>
<rdf:Description rdf:about="&a;200173827"
	 b:glossaryEntry='soften, make mellow; "Age mellowed him"'/>
<rdf:Description rdf:about="&a;200173956">
	<b:glossaryEntry>become soft or softer; "The bread will soften if you pour some liquid on it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200174150"
	 b:glossaryEntry="form a crust or a hard layer"/>
<rdf:Description rdf:about="&a;200174261"
	 b:glossaryEntry="become encrusted with crystals due to evaporation"/>
<rdf:Description rdf:about="&a;200174378"
	 b:glossaryEntry='make soft or softer; "This liquid will soften your laundry"'/>
<rdf:Description rdf:about="&a;200174607"
	 b:glossaryEntry="harden steel by adding carbon"/>
<rdf:Description rdf:about="&a;200174705"
	 b:glossaryEntry='form a callus or calluses; "His foot callused"'/>
<rdf:Description rdf:about="&a;200174815">
	<b:glossaryEntry>cause a callus to form on; "The long march had callused his feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200174944"
	 b:glossaryEntry="make less rigid or softer"/>
<rdf:Description rdf:about="&a;200175034"
	 b:glossaryEntry='become inflated; "The sails ballooned"'/>
<rdf:Description rdf:about="&a;200175182"
	 b:glossaryEntry="become inflated again"/>
<rdf:Description rdf:about="&a;200175268"
	 b:glossaryEntry="cause to bulge or swell outwards"/>
<rdf:Description rdf:about="&a;200175388">
	<b:glossaryEntry>expand abnormally; "The bellies of the starving children are swelling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200175614">
	<b:glossaryEntry>become larger in size or volume or quantity; "his business expanded rapidly"; "The bag will expand when pressure is lowered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200175838"
	 b:glossaryEntry="swell out or bulge out"/>
<rdf:Description rdf:about="&a;200175935"
	 b:glossaryEntry='cause to become swollen; "The water swells the wood"'/>
<rdf:Description rdf:about="&a;200176104"
	 b:glossaryEntry="take in water at the bilge; of vessels"/>
<rdf:Description rdf:about="&a;200176221">
	<b:glossaryEntry>have an opening that allows light or substances to enter or go out; "The container leaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200176390">
	<b:glossaryEntry>of the male voice in puberty; "his voice is breaking--he should no longer sing in the choir"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200176545"
	 b:glossaryEntry="cause to leak; as of vessels"/>
<rdf:Description rdf:about="&a;200176662">
	<b:glossaryEntry>render inoperable or ineffective; "You broke the alarm clock when you took it apart!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200176836">
	<b:glossaryEntry>inflict damage upon; "The snow damaged the roof"; "She damaged the car when she hit the tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200177253">
	<b:glossaryEntry xml:space='preserve'><![CDATA[damage as if by shaking or jarring; "Don''t disturb the patient''s wounds by moving him too rapidly!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200177425">
	<b:glossaryEntry>cause pain or suffering in; "afflict with the plague"; "That debasement of the verbal currency that afflicts terms used in advertisement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200177661">
	<b:glossaryEntry>overwhelm or overpower; "He was devastated by his grief when his son died"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200177802">
	<b:glossaryEntry>cause damage or affect negatively; "Our business was hurt by the new competition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200177962">
	<b:glossaryEntry>restore by replacing a part or putting together what is torn or broken; "She repaired her TV set"; "Repair my shoes please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200178413"
	 b:glossaryEntry='plug with a substance; "fill a cavity"'/>
<rdf:Description rdf:about="&a;200178513"
	 b:glossaryEntry='repair by adding pieces; "She pieced the china cup"'/>
<rdf:Description rdf:about="&a;200178635"
	 b:glossaryEntry='repair or mend; "cobble shoes"'/>
<rdf:Description rdf:about="&a;200178729"
	 b:glossaryEntry='repair the joints of bricks; "point a chimney"'/>
<rdf:Description rdf:about="&a;200178848">
	<b:glossaryEntry>make repairs or adjustments to; "You should overhaul your car engine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200179013"
	 b:glossaryEntry='solve problems; "He is known to be good at trouble-shooting"'/>
<rdf:Description rdf:about="&a;200179152"
	 b:glossaryEntry='mend or supply with a patch; "patch a hole"'/>
<rdf:Description rdf:about="&a;200179295"
	 b:glossaryEntry='make worse or less effective; "His vision was impaired"'/>
<rdf:Description rdf:about="&a;200179422"
	 b:glossaryEntry="add a flaw or blemish to; make imperfect or defective"/>
<rdf:Description rdf:about="&a;200179555"
	 b:glossaryEntry='swell or protrude outwards; "His eyes bulged with surprise"'/>
<rdf:Description rdf:about="&a;200179714"
	 b:glossaryEntry="make concave; shape like a dish"/>
<rdf:Description rdf:about="&a;200179807"
	 b:glossaryEntry='stick out or up; "The parcel bulked in the sack"'/>
<rdf:Description rdf:about="&a;200179925">
	<b:glossaryEntry>to swell or cause to enlarge, "Her faced puffed up from the drugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200180108"
	 b:glossaryEntry='increase the volume of; "amplify sound"'/>
<rdf:Description rdf:about="&a;200180220"
	 b:glossaryEntry='fill with gas or air; "inflate a balloons"'/>
<rdf:Description rdf:about="&a;200180399"
	 b:glossaryEntry="inflate again, as of a balloon"/>
<rdf:Description rdf:about="&a;200180494"
	 b:glossaryEntry='exaggerate or make bigger; "The charges were inflated"'/>
<rdf:Description rdf:about="&a;200180668"
	 b:glossaryEntry='make larger or distend; "The estimates were puffed up"'/>
<rdf:Description rdf:about="&a;200180795">
	<b:glossaryEntry>become deflated or flaccid, as by losing air; "The balloons deflated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200180947"
	 b:glossaryEntry="turn acidic, as of solutions and substances"/>
<rdf:Description rdf:about="&a;200181099"
	 b:glossaryEntry="turn basic and less acidic, of solutions and substances"/>
<rdf:Description rdf:about="&a;200181274">
	<b:glossaryEntry>make reforms in; change for the better; "reform a political system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200181429"
	 b:glossaryEntry="break up the molecules (of oil or gas)"/>
<rdf:Description rdf:about="&a;200181531"
	 b:glossaryEntry="produce by cracking, of oil or gas"/>
<rdf:Description rdf:about="&a;200181629"
	 b:glossaryEntry="undergo polymerization, of a chemical compound"/>
<rdf:Description rdf:about="&a;200181761"
	 b:glossaryEntry="polymerize together, of two substances"/>
<rdf:Description rdf:about="&a;200181884"
	 b:glossaryEntry="cause to polymerize, as of a chemical compound"/>
<rdf:Description rdf:about="&a;200182024"
	 b:glossaryEntry="convert into ions; in physics or chemistry"/>
<rdf:Description rdf:about="&a;200182146"
	 b:glossaryEntry='become bony; "The tissue ossified"'/>
<rdf:Description rdf:about="&a;200182244">
	<b:glossaryEntry>change by catalysis or cause to catalyze; of chemical compounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200182381">
	<b:glossaryEntry>become smaller or lose substance; "Her savings dwindled down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200182537"
	 b:glossaryEntry='make lower or quieter;"turn down the volume of a radio"'/>
<rdf:Description rdf:about="&a;200182674"
	 b:glossaryEntry='improve in health; "He got well fast"'/>
<rdf:Description rdf:about="&a;200182841"
	 b:glossaryEntry='deteriorate in health; "he relapsed"'/>
<rdf:Description rdf:about="&a;200182972"
	 b:glossaryEntry="go into remission, as of one''s state of health"/>
<rdf:Description rdf:about="&a;200183081">
	<b:glossaryEntry>cause to be paralyzed and immobile; "The poison paralyzed him"; "Fear paralyzed her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200183284"
	 b:glossaryEntry="affect with palsy"/>
<rdf:Description rdf:about="&a;200183364">
	<b:glossaryEntry>make powerless and unable to function; "The bureaucracy paralyzes the entire operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200183525"
	 b:glossaryEntry='make senseless or dizzy by or as if by a blow; "stun fish"'/>
<rdf:Description rdf:about="&a;200183690">
	<b:glossaryEntry>cause to be immobile; "The sudden storm immobilized the traffic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200183882">
	<b:glossaryEntry>prohibit the conversion or use of (assets); "Blocked funds"; "Freeze the assets of this hostile government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200184110">
	<b:glossaryEntry>make available, as of assets; or free for sale or publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200184300"
	 b:glossaryEntry="convert (assets) into fixed capital"/>
<rdf:Description rdf:about="&a;200184403"
	 b:glossaryEntry='cause to move around; "circulate a rumor"'/>
<rdf:Description rdf:about="&a;200184548"
	 b:glossaryEntry='make ready for action or use; "marshal resources"'/>
<rdf:Description rdf:about="&a;200184690"
	 b:glossaryEntry="make sour or bitter"/>
<rdf:Description rdf:about="&a;200184775"
	 b:glossaryEntry='heal or recover; "My broken leg is mending"'/>
<rdf:Description rdf:about="&a;200184895">
	<b:glossaryEntry>be unstable; have ups and downs; "The stock market fluctuates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200185024">
	<b:glossaryEntry>make stable or put into an equilibrium; "The drug stabilized her blood pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200185197"
	 b:glossaryEntry="make steady with a ballast"/>
<rdf:Description rdf:about="&a;200185296"
	 b:glossaryEntry="steady with a guy"/>
<rdf:Description rdf:about="&a;200185374"
	 b:glossaryEntry='make unstable; "Terrorism destabilized the government"'/>
<rdf:Description rdf:about="&a;200185541"
	 b:glossaryEntry='become stable or more stable; "The economy stabilized"'/>
<rdf:Description rdf:about="&a;200185742"
	 b:glossaryEntry='become unstable; "The economy destabilized rapidly"'/>
<rdf:Description rdf:about="&a;200185888">
	<b:glossaryEntry>make sensitive or aware; "He was not sensitized to her emotional needs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200186100"
	 b:glossaryEntry='make insensitive; "His military training desensitized him"'/>
<rdf:Description rdf:about="&a;200186277">
	<b:glossaryEntry>cause to accept or become hardened to; habituate; "He was inured to the cold"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200186463"
	 b:glossaryEntry="make insensitive or callous"/>
<rdf:Description rdf:about="&a;200186555"
	 b:glossaryEntry="prepare mentally or emotionally for something unpleasant"/>
<rdf:Description rdf:about="&a;200186743">
	<b:glossaryEntry>make used (to something); "She became habituated to the background music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200186948">
	<b:glossaryEntry>accustom gradually to some action or attitude; "The child is taught to obey her parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200187123">
	<b:glossaryEntry>make familiar or acquainted with; "Familiarize yourself with the facilities here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200187287"
	 b:glossaryEntry='become destroyed by water or air; "The metal corroded"'/>
<rdf:Description rdf:about="&a;200187431"
	 b:glossaryEntry='cause to rust; "The acid corroded the metal"'/>
<rdf:Description rdf:about="&a;200187553"
	 b:glossaryEntry="wear away or erode"/>
<rdf:Description rdf:about="&a;200187644">
	<b:glossaryEntry>remove soil or rock, as of wind or water; "Rain eroded the terraces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200187811">
	<b:glossaryEntry>form by erosion: "The river washed a ravine into the mountainside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200187939">
	<b:glossaryEntry>change under the action or influence of the weather; "A weathered old hut"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200188086"
	 b:glossaryEntry='become ground down or deteriorate; "Her confidence eroded"'/>
<rdf:Description rdf:about="&a;200188245"
	 b:glossaryEntry="wear away through erosion or vaporization"/>
<rdf:Description rdf:about="&a;200188350">
	<b:glossaryEntry>make regular or more regular; "regularize the heart beat with a pace maker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200188537"
	 b:glossaryEntry='put (things or places) in order; "Tidy up your room!"'/>
<rdf:Description rdf:about="&a;200188762"
	 b:glossaryEntry='put in order or neaten: "make the bed"; "make up a room"'/>
<rdf:Description rdf:about="&a;200188908">
