	<b:glossaryEntry>a red-purple to deep purple dye obtained from snails or made synthetically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110753777">
	<b:glossaryEntry>a dye that is applied by reducing the dye to a base-soluble form, applying the dye, then regenerating the insoluble dye by oxidation in the material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110753991"
	 b:glossaryEntry="a substances that colors metals"/>
<rdf:Description rdf:about="&a;110754095">
	<b:glossaryEntry>a metal tincture used in heraldry to give a silvery appearance</b:glossaryEntry>
</rdf:Description>
