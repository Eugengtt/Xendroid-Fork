	 b:glossaryEntry="a populous province of south central China"/>
<rdf:Description rdf:about="&a;106419550"
	 b:glossaryEntry="a province of southern China"/>
<rdf:Description rdf:about="&a;106419650">
	<b:glossaryEntry>the capital city of the Chinese province of Gansu on the Yellow River</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106419812">
	<b:glossaryEntry>the largest city of China; located in the east on the Pacific; one of the largest ports in the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106419986">
	<b:glossaryEntry>a city on the Canton River Delta in S China; a major deep-water port</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106420180"
	 b:glossaryEntry="a city in northeastern China"/>
<rdf:Description rdf:about="&a;106420312">
	<b:glossaryEntry>a major industrial center in northeastern China on the Grand Canal near the Yellow Sea; 3rd largest city in China</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106420523">
	<b:glossaryEntry>a city in eastern China on the Yangtze River; a former capital of China; the scene of a Japanese massacre in the 1930s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106420724">
	<b:glossaryEntry>a city in south-central China on the Yangtze River; a commercial center for western China</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106420888">
	<b:glossaryEntry>a city of central China; capital of ancient Chinese empire 221-206 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106421061">
	<b:glossaryEntry>a city in east central China; the capital of ancient China during several dynasties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106421226">
	<b:glossaryEntry>a city of eastern China on Hangzhou Bay (an inlet of the East China Sea); regarded by Marco Polo as the finest city in the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106421439">
	<b:glossaryEntry>a government on the island of Taiwan established in 1949 by Chiang Kaishek after the conquest of mainland China by communists led by Mao Zedong</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106421788"
	 b:glossaryEntry="the capital of Nationalist China; located in northern Taiwan"/>
<rdf:Description rdf:about="&a;106421951"
	 b:glossaryEntry="a city in Taiwan"/>
<rdf:Description rdf:about="&a;106422041">
	<b:glossaryEntry>a British Crown Colony on the coast of S China; leased by China to Britain in 1842 and returned in 1997; one of the world''s leading commercial centers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106422247">
	<b:glossaryEntry>a Portuguese province on the south coast of China and two islands in the South China Sea; reverts to China in 1999</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106422421">
	<b:glossaryEntry>a region of southeastern Asia that includes Burma and Cambodia and Laos and Malaysia and Thailand and Vietnam</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106422738">
	<b:glossaryEntry>the French colonies of Cambodia and Laos and Vietnam were formerly organized as French Indochina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106422916">
	<b:glossaryEntry>a republic in northwestern South America; the major legal crop is coffee but cocaine is also a major export</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106423230">
	<b:glossaryEntry>capital and largest city of Colombia; located in central Colombia on a high fertile plain</b:glossaryEntry>
</rdf:Description>
