	 b:glossaryEntry="type genus of the Mugilidae: mullets"/>
<rdf:Description rdf:about="&a;102091509"
	 b:glossaryEntry="most important commercial mullet in eastern United States"/>
<rdf:Description rdf:about="&a;102091663"
	 b:glossaryEntry="silvery mullet of Atlantic and Pacific coasts"/>
<rdf:Description rdf:about="&a;102091801">
	<b:glossaryEntry>similar to the striped mullet and takes its place in the Caribbean region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102091957"
	 b:glossaryEntry="small spiny-finned fishes of both salt and fresh water"/>
