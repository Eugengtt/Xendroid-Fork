<rdf:Description rdf:about="&a;101977792"
	 b:glossaryEntry="used in some classifications for the siamangs"/>
<rdf:Description rdf:about="&a;101977936">
	<b:glossaryEntry>large black gibbon of Sumatra having the 2nd and 3rd toes partially united by a web</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101978143">
	<b:glossaryEntry>Old World monkeys: guenon; baboon; colobus monkey; langur; macaque; mandrill; mangabey; patas; proboscis monkey</b:glossaryEntry>
</rdf:Description>
