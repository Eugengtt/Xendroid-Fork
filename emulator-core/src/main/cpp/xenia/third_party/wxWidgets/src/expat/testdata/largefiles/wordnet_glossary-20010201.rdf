	 b:glossaryEntry="an item inserted in a written record"/>
<rdf:Description rdf:about="&a;104881841">
	<b:glossaryEntry>an entry in the court record to the effect that the plaintiff or prosecutor will not proceed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104882005">
	<b:glossaryEntry>a reproduction of a written record (e.g. of a legal or school record)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104882138">
	<b:glossaryEntry>the daily written record of events (as arrests) in a police station</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104882302"
	 b:glossaryEntry="a record of things worth remembering"/>
<rdf:Description rdf:about="&a;104882396"
	 b:glossaryEntry='a brief written record; "he made a note of the appointment"'/>
<rdf:Description rdf:about="&a;104882560"
	 b:glossaryEntry="a brief (and hurriedly handwritten) note"/>
<rdf:Description rdf:about="&a;104882660"
	 b:glossaryEntry="a written proposal or reminder"/>
<rdf:Description rdf:about="&a;104882784">
	<b:glossaryEntry>a short note; "the secretary keeps the minutes of the meeting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104882899"
	 b:glossaryEntry="a memorandum summarizing the items of an agreement"/>
<rdf:Description rdf:about="&a;104883008">
	<b:glossaryEntry>(slang) a remarkable or astounding message; "that story was a corker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104883131">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a message that helps you remember something; "he ignored his wife''s reminders"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104883282">
	<b:glossaryEntry>an official written record of names or events or transactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104883463">
	<b:glossaryEntry>official record of the pedigree of purebred animals especially horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104883587">
	<b:glossaryEntry>a register of rents; includes the names of tenants and the amount of rent they pay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104883725"
	 b:glossaryEntry="(sports) a record of win versus losses"/>
<rdf:Description rdf:about="&a;104883825"
	 b:glossaryEntry="a register of persons who are socially prominent"/>
<rdf:Description rdf:about="&a;104883929"
	 b:glossaryEntry="the part of a check that is retained as a record"/>
<rdf:Description rdf:about="&a;104884055">
	<b:glossaryEntry>a record of scores (as in golf); "you have to turn in your card to get a handicap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104884200"
	 b:glossaryEntry="a written account of what transpired at a meeting"/>
<rdf:Description rdf:about="&a;104884387"
	 b:glossaryEntry="a book in which minutes have been written"/>
<rdf:Description rdf:about="&a;104884505">
	<b:glossaryEntry>a published account of the speeches and debates and votes of the U.S. Congress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104884650">
	<b:glossaryEntry>the official published verbatim report of the proceedings of a parliamentary body; originally of the British Parliament; "the Canadian Hansard is published in both English and French"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104884887">
	<b:glossaryEntry>a collection of papers containing detailed information about a particular person or subject (usually a person''s record)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104885060">
	<b:glossaryEntry>a set of related records (either written or electronic) kept together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104885246">
	<b:glossaryEntry>(computer science) a file maintained in computer-readable form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104885530">
	<b:glossaryEntry>(computer science) a computer file dedicated to storing and updating computer backups</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104885673">
	<b:glossaryEntry>(computer science) a computer file containing machine-readable information that must be read by an application; characters use all 8 bits of each byte</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104885881">
	<b:glossaryEntry>(computer science) a computer file that is used as the authority in a given job and that is relatively permanent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104886063">
	<b:glossaryEntry>(computer science) a computer file stored on a magnetic disk and identified by a unique label</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104886212">
	<b:glossaryEntry>(computer science) a computer file containing relatively transient data about a particular data processing task</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104886400">
	<b:glossaryEntry>(computer science) a computer file that contains data that serve as input to a device or program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104886566">
	<b:glossaryEntry>(computer science) a computer file that contains data that are the output of a device or program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104886720">
	<b:glossaryEntry>(computer science) a file that you can read but cannot change</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104886842">
	<b:glossaryEntry>(computer science) a computer file that contains text (and possibly formatting instructions) using 7-bit ASCII characters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104887048">
	<b:glossaryEntry>a text file that contains only ASCII characters without special formatting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104887202">
	<b:glossaryEntry>a file of mug shots (pictures of criminals that are kept on file by the police)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104887366">
	<b:glossaryEntry>a formal document giving notice of your intention to resign; "he submitted his resignation as of next month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104887532"
	 b:glossaryEntry="a formal expression by a meeting; agreed to by a vote"/>
<rdf:Description rdf:about="&a;104887702">
	<b:glossaryEntry>the document recording the proclamation of the 2nd American Continental Congress (4 july 1776) asserting the independence of the colonies from Great Britain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104887932">
	<b:glossaryEntry>(U.S.) a resolution passed by both houses of Congress which becomes legally binding when signed by the chief executive (or passed over the executive''s veto)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104888151">
	<b:glossaryEntry>a verbal or written request for assistance or employment or admission to a school; "December 31 is the deadline for applications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104888410"
	 b:glossaryEntry="an application for a job"/>
<rdf:Description rdf:about="&a;104888496"
	 b:glossaryEntry="an application for a line of credit"/>
<rdf:Description rdf:about="&a;104888596"
	 b:glossaryEntry="an application to borrow money"/>
<rdf:Description rdf:about="&a;104888707"
	 b:glossaryEntry="an application for a mortgage loan"/>
<rdf:Description rdf:about="&a;104888808"
	 b:glossaryEntry="an application for sole rights to an invention"/>
<rdf:Description rdf:about="&a;104888919">
	<b:glossaryEntry>a formal message requesting something submitted to an authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104889101">
	<b:glossaryEntry>a written statement of facts submitted in conjunction with a petition to a an authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104889243"
	 b:glossaryEntry="request for a sum of money (as in church)"/>
<rdf:Description rdf:about="&a;104889397">
	<b:glossaryEntry>(British) solicitation of money usually for a benevolent purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104889518">
	<b:glossaryEntry>a record or narrative description of past events: "a history of France"; "he gave an inaccurate account of the plot to kill the president"; "the story of exposure to lead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104889863"
	 b:glossaryEntry="a record of events in the order of their occurrence"/>
<rdf:Description rdf:about="&a;104889971"
	 b:glossaryEntry="a history of a word"/>
<rdf:Description rdf:about="&a;104890064"
	 b:glossaryEntry="a popular but erroneous etymology"/>
<rdf:Description rdf:about="&a;104890158">
	<b:glossaryEntry>detailed record of the background of a person or group under study or treatment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104890314"
	 b:glossaryEntry="the case history of a medical patient"/>
<rdf:Description rdf:about="&a;104890442">
	<b:glossaryEntry>writing having historical value (as opposed to fiction or myth etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104890615"
	 b:glossaryEntry="a chronological account of events in successive years"/>
<rdf:Description rdf:about="&a;104890744">
	<b:glossaryEntry>an account of the series of events making up a person''s life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104890949"
	 b:glossaryEntry="a biography of yourself"/>
<rdf:Description rdf:about="&a;104891050"
	 b:glossaryEntry="a biography that idealizes or idolizes the person"/>
<rdf:Description rdf:about="&a;104891157"
	 b:glossaryEntry="biographical sketch"/>
<rdf:Description rdf:about="&a;104891230"
	 b:glossaryEntry="an account of the author''s personal experiences"/>
<rdf:Description rdf:about="&a;104891330"
	 b:glossaryEntry="a document showing credits and debits"/>
<rdf:Description rdf:about="&a;104891517">
	<b:glossaryEntry>a periodic statement prepared by a bank for each client; "I wish my bank statement arrived earlier in the month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104891690">
	<b:glossaryEntry>a statement of money owed for goods or services; "he paid his bill and left"; "send me an account of what I owe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104891999"
	 b:glossaryEntry="a bill for money owed for electricity used"/>
<rdf:Description rdf:about="&a;104892101"
	 b:glossaryEntry="statement of charges for staying in a hotel"/>
<rdf:Description rdf:about="&a;104892201"
	 b:glossaryEntry="statement of charges for medical services"/>
<rdf:Description rdf:about="&a;104892317"
	 b:glossaryEntry="statement of charges for telephone service"/>
<rdf:Description rdf:about="&a;104892433"
	 b:glossaryEntry="a bill for an amount due"/>
<rdf:Description rdf:about="&a;104892521"
	 b:glossaryEntry="money owed for taxes"/>
<rdf:Description rdf:about="&a;104892596">
	<b:glossaryEntry>the bill in a restaurant; "he asked the waiter for the check"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104892722">
	<b:glossaryEntry>a negotiable certificate that can be detached and redeemed as needed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104892853">
	<b:glossaryEntry>a commercial document showing that the holder is entitled to ride on public transportation or enter a public entertainment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104893172">
	<b:glossaryEntry>a ticket good for several trips or to attend a season of entertainments; sold at a reduced rate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104893348"
	 b:glossaryEntry="a ticket good for a trip on an airplane"/>
<rdf:Description rdf:about="&a;104893464">
	<b:glossaryEntry>a complementary (free) ticket; "the start got passes for his family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104893583"
	 b:glossaryEntry="a ticket that allows a passenger to change conveyances"/>
<rdf:Description rdf:about="&a;104893692"
	 b:glossaryEntry="a ticket good for a ride on a railroad train"/>
<rdf:Description rdf:about="&a;104893813"
	 b:glossaryEntry="a ticket good for admission to a theater"/>
<rdf:Description rdf:about="&a;104893931"
	 b:glossaryEntry="a ticket good for a ride on a bus"/>
<rdf:Description rdf:about="&a;104894021"
	 b:glossaryEntry="a ticket to a place and back (usually over the same route)"/>
<rdf:Description rdf:about="&a;104894177">
	<b:glossaryEntry>a return ticket (at reduced fare) for traveling both ways in the same day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104894307">
	<b:glossaryEntry>an acknowledgment (usually tangible) that payment has been made</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104894478"
	 b:glossaryEntry="a torn part of a ticket returned to the holder as a receipt"/>
<rdf:Description rdf:about="&a;104894620">
	<b:glossaryEntry>a ticket stub entitling the holder to admission to a future event if the scheduled event was cancelled due to rain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104894791"
	 b:glossaryEntry="a receipt from the carrier for the goods being shipped"/>
<rdf:Description rdf:about="&a;104894916">
	<b:glossaryEntry>a binding agreement between two or more persons especially one enforceable by law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104895594">
	<b:glossaryEntry>a contract that heavily restricts one party while leaving the other free (as some standard form printed contracts); implies inequality in bargaining power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104895835">
	<b:glossaryEntry>a contract whose performance by one party depends on the occurrence of an uncertain contingent event (but if it is contingent on the outcome of a wager it is not enforceable)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104896073">
	<b:glossaryEntry>a contract involving mutual promises (each part is both promisor and promisee)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104896216"
	 b:glossaryEntry="a contract to hire or lease transportation"/>
<rdf:Description rdf:about="&a;104896312">
	<b:glossaryEntry>a contract whose performance depends on a fact or event that affects legal relations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104896463">
	<b:glossaryEntry>a contract in which the contractor is paid his total cost plus a stated percentage of profit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104896620">
	<b:glossaryEntry>a contract whose performance by one party is contingent on the outcome of a bet; unenforceable by statute in most jurisdictions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104896811">
	<b:glossaryEntry>a contract granting use or occupation of property during a specified time for a specified payment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104896960"
	 b:glossaryEntry="a prenuptial agreement or contract"/>
<rdf:Description rdf:about="&a;104897080">
	<b:glossaryEntry>a contract in which you promise to deliver your entire output to the other party who promises to accept it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104897248">
	<b:glossaryEntry>written contract or certificate of insurance; "you should have read the small print on your policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104897449"
	 b:glossaryEntry="a contract stating the terms of a purchase"/>
<rdf:Description rdf:about="&a;104897576">
	<b:glossaryEntry>a contract created by law for reasons of justice without any expression of assent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104897718">
	<b:glossaryEntry>a contract in which you agree to purchase all your requirements of a particular sort from one party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104897885">
	<b:glossaryEntry>a contract that is signed and has the (wax) seal of the signer attached</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104898061"
	 b:glossaryEntry="a contract for maintenance services"/>
<rdf:Description rdf:about="&a;104898159">
	<b:glossaryEntry>a contract in which in the event of a breach by one of the parties can be considered as several independent agreements expressed in a single instrument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104898375">
	<b:glossaryEntry>a contract assigning to another party some obligations of a prior contract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104898507">
	<b:glossaryEntry>a secret agreement between two or more people to perform an unlawful act</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104898668">
	<b:glossaryEntry>a conspiracy not to talk about some situation or event; "there was a conspiracy of silence about police brutality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104898850">
	<b:glossaryEntry>(Bible) an agreement between God and his people in which God makes certain promises and requires certain behavior from them in return</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104899038">
	<b:glossaryEntry>a one-sided agreement whereby you promise to do (or refrain from doing) something in return for a performance (not a promise)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104899229"
	 b:glossaryEntry="a certificate or voucher acknowledging a debt"/>
<rdf:Description rdf:about="&a;104899330">
	<b:glossaryEntry>an insurance policy covering loss of movable property (e.g. jewelry) regardless of its location</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104899497">
	<b:glossaryEntry>a contract between two or more persons who agree to pool talent and money and share profits or losses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104899656"
	 b:glossaryEntry="a contract between crew and captain of a ship"/>
<rdf:Description rdf:about="&a;104899789">
	<b:glossaryEntry>a contract granting the right to operate a subsidiary business: "he got the beer concession at the ball park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104899981">
	<b:glossaryEntry>an authorization to sell a company''s goods or services in a particular place</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104900113">
	<b:glossaryEntry>contract between labor and management government wages and benefits and working conditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104900323">
	<b:glossaryEntry>a now-illegal labor contract whereby the employee agrees not to join a trade union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104900471"
	 b:glossaryEntry="contract between employer and employee"/>
<rdf:Description rdf:about="&a;104900598"
	 b:glossaryEntry="a contract governing the marketing of an item of merchandise"/>
<rdf:Description rdf:about="&a;104900727">
	<b:glossaryEntry>contract giving someone the legal right to use a patent or trademark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104900861"
	 b:glossaryEntry="contract governing the merger of two or more companies"/>
<rdf:Description rdf:about="&a;104901002">
	<b:glossaryEntry>an agreement (or contract) in which property is transferred from the seller (vendor) to the buyer (vendee) for a fixed price in money (paid or agreed to be paid by the buyer); "the salesman faxed the sales agreement to his home office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104901342">
	<b:glossaryEntry>a sale in which the buyer receives title to the property only upon the performance of some condition (usually the full payment of the purchase price)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104901554">
	<b:glossaryEntry>a sale of a tract of land as a whole without a warranty as to the acreage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104901708">
	<b:glossaryEntry>a sale of property by the sheriff under authority of a court''s judgment in order satisfy and unpaid obligation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104901909">
	<b:glossaryEntry>a document appraising the value of something (as for insurance or taxation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104902082"
	 b:glossaryEntry="an appraisal that is too high"/>
<rdf:Description rdf:about="&a;104902219">
	<b:glossaryEntry>a commercial document used to request someone to supply something in return for payment; "IBM received an order for a hundred computers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104902532">
	<b:glossaryEntry>an order that is received without payment; requires billing at a later date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104902700"
	 b:glossaryEntry="an unpaid credit order"/>
<rdf:Description rdf:about="&a;104902781"
	 b:glossaryEntry="(British) an order for goods to be exported or imported"/>
<rdf:Description rdf:about="&a;104902889">
	<b:glossaryEntry>an order to a broker to sell or buy stocks or commodities at the prevailing market price</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104903036">
	<b:glossaryEntry>an order to a broker to sell (buy) when the price of a security falls (rises) to a designated level</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104903210"
	 b:glossaryEntry="a depositor''s order to a bank to refuse payment on a check"/>
<rdf:Description rdf:about="&a;104903327"
	 b:glossaryEntry="a purchase negotiated by mail"/>
<rdf:Description rdf:about="&a;104903413">
	<b:glossaryEntry>a legal instrument authorizing someone to act as the grantor''s agent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104903581">
	<b:glossaryEntry>a power of attorney document to transfer ownership of a registered security from the owner to another party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104903746">
	<b:glossaryEntry>a power of attorney document given by shareholders of a corporation authorizing a specific vote on their behalf at a corporate meeting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104903932">
	<b:glossaryEntry>the letters used to identify listed companies on the securities exchanges where they are traded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104904086">
	<b:glossaryEntry>legal document naming someone to administer an estate when no executor has been named</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104904243"
	 b:glossaryEntry="a legal document giving information required for employment"/>
<rdf:Description rdf:about="&a;104904391">
	<b:glossaryEntry>a legal document codifying the result of deliberations of a committee or society or legislative body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104904589">
	<b:glossaryEntry>one of a set of rules governing a particular activity or a legal document setting forth such a rule; "there is a law against kidnapping"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104904974">
	<b:glossaryEntry>a statute prescribing the time period during which legal action can be taken</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104905119">
	<b:glossaryEntry>law determining the fundamental political principles of a government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104905296">
	<b:glossaryEntry>the constitution written at the Constitutional Convention in Philadelphia in 1787 and subsequently ratified by the original thirteen states</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104905639"
	 b:glossaryEntry="a law affecting the public at large"/>
<rdf:Description rdf:about="&a;104905731">
	<b:glossaryEntry>the legal code of ancient Rome; codified under Justinian; the basis for many modern systems of civil law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104905933">
	<b:glossaryEntry>the code of laws of the Salian Franks and other German tribes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104906050">
	<b:glossaryEntry>(civil law) a law established by following earlier judicial decisions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104906199"
	 b:glossaryEntry="a law enacted by a legislative body"/>
<rdf:Description rdf:about="&a;104906379">
	<b:glossaryEntry>legislation intended to promote free competition in the market place by outlawing monopolies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104906555">
	<b:glossaryEntry>legislation that gives appropriate officials the authority to implement or enforce the law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104906712">
	<b:glossaryEntry>a law passed by US Congress to prevent employees from being injured or contracting diseases in the course of their employment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104906950">
	<b:glossaryEntry>a legal phrase in the US Constitution that allows the Senate to constrain the President''s powers of appointment and treaty-making</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104907163">
	<b:glossaryEntry>a record of the whole body of legislation in a given jurisdiction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104907306">
	<b:glossaryEntry>a statute in draft before it becomes law; "they held a public hearing on the bill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104907558">
	<b:glossaryEntry>a legislative act proposing to authorize the expenditure of public funds for a specified purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104907738">
	<b:glossaryEntry>a legislative act finding a person guilty of treason or felony without a trial</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104907880">
	<b:glossaryEntry>a statute that would require merchants to reclaim used bottles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104908000"
	 b:glossaryEntry="a statute that would regulate farm production and prices"/>
<rdf:Description rdf:about="&a;104908112"
	 b:glossaryEntry="a statute that would regulate foreign trade"/>
<rdf:Description rdf:about="&a;104908212"
	 b:glossaryEntry="a rule made by a local authority to regulate its own affairs"/>
<rdf:Description rdf:about="&a;104908334"
	 b:glossaryEntry="a statute regulating work on Sundays"/>
<rdf:Description rdf:about="&a;104908425">
	<b:glossaryEntry>a state law regulating the sale of securities in an attempt to control the sale of securities in fraudulent enterprises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104908603"
	 b:glossaryEntry="a law conferring privileges on owners of homesteads"/>
<rdf:Description rdf:about="&a;104908714"
	 b:glossaryEntry="a law providing support for the poor"/>
<rdf:Description rdf:about="&a;104908805">
	<b:glossaryEntry>a former English law requiring mobs to disperse after a magistrate reads the law to them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104908967"
	 b:glossaryEntry='a vigorous reprimand; "I read him the riot act"'/>
<rdf:Description rdf:about="&a;104909069"
	 b:glossaryEntry="the body of law dealing with crimes and their punishment"/>
<rdf:Description rdf:about="&a;104909203">
	<b:glossaryEntry>a writ issued by a court of law requiring a person to do something or to refrain from doing something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104909380">
	<b:glossaryEntry>a legally binding command or decision entered on the court record (as if issued by a court or judge); "a friend in New Mexico said that the order caused no trouble out there"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104909767">
	<b:glossaryEntry>an order that after a specific time certain activities (as being outside on the streets) are prohibited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104909923">
	<b:glossaryEntry>a decree issued on a first petition for divorce; becomes absolute at some later date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104910065">
	<b:glossaryEntry>an order to an offending party to rid itself of property; it has the purpose of depriving the defendant of the gains of wrongful behavior; "the court found divestiture to be necessary in preventing a monopoly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104910332"
	 b:glossaryEntry="a decree issued by a sovereign ruler"/>
<rdf:Description rdf:about="&a;104910466"
	 b:glossaryEntry="an edict of the Russian tsar"/>
<rdf:Description rdf:about="&a;104910546">
	<b:glossaryEntry>a judicial decree regulating the rights and responsibilities of a married couple living apart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104910724">
	<b:glossaryEntry>an imperial decree that becomes part of the fundamental law of the land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104910860"
	 b:glossaryEntry="an edict that has been publicly posted"/>
<rdf:Description rdf:about="&a;104910954">
	<b:glossaryEntry>a law forbidding the sale of alcoholic beverages; "in 1920 the 18th amendment to the Constitution established prohibition in the US"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104911144"
	 b:glossaryEntry="a decree that prohibits something"/>
<rdf:Description rdf:about="&a;104911307">
	<b:glossaryEntry>a judicial order forbidding some action until an event occurs or the order is lifted; "the Supreme Court has the power to stay and injunction pending an appeal to the whole Court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104911555">
	<b:glossaryEntry>an order whereby a judgment is precluded from being executed for a specific period of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104911709"
	 b:glossaryEntry="an order that bans something"/>
<rdf:Description rdf:about="&a;104911797">
	<b:glossaryEntry>(law) a judicial remedy issued in order to prohibit a party from doing or continuing to do a certain activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104911988">
	<b:glossaryEntry>a document stating the facts and points of law of a client''s case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104912137">
	<b:glossaryEntry>a brief presented by someone interested in influencing the outcome of a lawsuit but who is not a party to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104912311">
	<b:glossaryEntry>a legal document declaring a person''s wishes regarding the disposal of their property when they die</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104912546">
	<b:glossaryEntry>a judicial certificate saying that a will is genuine and conferring on the executors the power to administer the estate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104912734">
	<b:glossaryEntry>a supplement to a will; a testamentary instrument intended to alter an already executed will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104912899">
	<b:glossaryEntry>a document written by someone still legally capable requesting that they should be allowed to die if subsequently severely disabled or suffering terminal illness; "after he discovered he had AIDS he drew up a living will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104913178">
	<b:glossaryEntry>a legal document signed and sealed and delivered to effect a transfer of property and to show the legal right to possess it; "he signed the deed"; "he kept the title to his car in the glove compartment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104913532">
	<b:glossaryEntry>the instrument by which a claim or right or interest or property is transferred from one person to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104913695"
	 b:glossaryEntry="a deed transferring personal property"/>
<rdf:Description rdf:about="&a;104913791"
	 b:glossaryEntry="a deed made and executed by only one party"/>
<rdf:Description rdf:about="&a;104913889"
	 b:glossaryEntry="deed embodying a mortgage"/>
<rdf:Description rdf:about="&a;104913974"
	 b:glossaryEntry="a legal document proving a person''s right to property"/>
<rdf:Description rdf:about="&a;104914102">
	<b:glossaryEntry>a written instrument legally conveying property to a trustee often used to secure an obligation such as a mortgage or promissory note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104914308"
	 b:glossaryEntry="document effecting a property transfer"/>
<rdf:Description rdf:about="&a;104914421"
	 b:glossaryEntry="document transferring title or right or claim to another"/>
<rdf:Description rdf:about="&a;104914550"
	 b:glossaryEntry="deeds and other documentary evidence of title to land"/>
<rdf:Description rdf:about="&a;104914659"
	 b:glossaryEntry="an authorization allowing police to perform specified acts"/>
<rdf:Description rdf:about="&a;104914897"
	 b:glossaryEntry="a warrant to search"/>
<rdf:Description rdf:about="&a;104914977"
	 b:glossaryEntry="a warrant to apprehend an offender"/>
<rdf:Description rdf:about="&a;104915106">
	<b:glossaryEntry>(informal) a warrant to take someone into custody; "put out a pickup on that man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104915240"
	 b:glossaryEntry="a warrant to execute the death sentence"/>
<rdf:Description rdf:about="&a;104915339">
	<b:glossaryEntry>French history: the king could warrant imprisonment or death in a signed letter under his seal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104915505">
	<b:glossaryEntry>a warrant granting postponement (usually to postpone the execution of the death sentence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104915649"
	 b:glossaryEntry="a warrant substituting a lesser punishment for a greater one"/>
<rdf:Description rdf:about="&a;104915767">
	<b:glossaryEntry xml:space='preserve'><![CDATA[document giving the tax collector information about the taxpayer''s tax liability; "his gross income was enough that he had to file a tax return"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104916087">
	<b:glossaryEntry>a tax return that corrects the information in an earlier return</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104916211">
	<b:glossaryEntry>return required of a taxpayer whose tax withheld from income does not meet the tax liability for the year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104916415"
	 b:glossaryEntry="an incorrect income tax return"/>
<rdf:Description rdf:about="&a;104916504">
	<b:glossaryEntry>a return that provides information to the tax collector but does not compute the tax liability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104916663"
	 b:glossaryEntry="a return filed by a husband and wife"/>
<rdf:Description rdf:about="&a;104916758"
	 b:glossaryEntry="a legal document giving official permission to do something"/>
<rdf:Description rdf:about="&a;104917060">
	<b:glossaryEntry>a document authorizing the holder to construct a building of a particular kind on a particular lot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104917220"
	 b:glossaryEntry="a license authorizing the bearer to drive a motor vehicle"/>
<rdf:Description rdf:about="&a;104917340">
	<b:glossaryEntry>a license authorizing the bearer to fish during a specified period of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104917476">
	<b:glossaryEntry>a license authorizing the bearer to kill a certain type of animal during a specified period of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104917652">
	<b:glossaryEntry>a document authorizing the bearer to learn to drive an automobile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104917780">
	<b:glossaryEntry>a license to a private citizen to seize property of another nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104917959"
	 b:glossaryEntry="a license authorizing the holder to sell alcoholic beverages"/>
<rdf:Description rdf:about="&a;104918098"
	 b:glossaryEntry="a license to sell liquor for consumption on the premises"/>
<rdf:Description rdf:about="&a;104918211"
	 b:glossaryEntry="a license authorizing a man and a woman to marry"/>
<rdf:Description rdf:about="&a;104918340"
	 b:glossaryEntry="a license to pursue a particular occupation"/>
<rdf:Description rdf:about="&a;104918448"
	 b:glossaryEntry="an official document granting a right or privilege"/>
<rdf:Description rdf:about="&a;104918568">
	<b:glossaryEntry>the legal document stating the reasons for a judicial decision; "opinions are usually written by a single judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104918829">
	<b:glossaryEntry>an opinion that agrees with the court''s disposition of the case but is written to express a particular judge''s reasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104919014">
	<b:glossaryEntry>an opinion that disagrees with the court''s disposition of the case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104919145">
	<b:glossaryEntry>the opinion joined by a majority of the court (generally known simply as `the opinion'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104919295"
	 b:glossaryEntry="a warrant granting release from punishment for an offense"/>
<rdf:Description rdf:about="&a;104919415">
	<b:glossaryEntry>a legal document evidencing the discharge of a debt or obligation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104919548"
	 b:glossaryEntry="a legal document issued by a court or judicial officer"/>
<rdf:Description rdf:about="&a;104919975">
	<b:glossaryEntry>an ancient writ issued by a court of assize to the sheriff for the recovery of property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104920115">
	<b:glossaryEntry>a common law writ issued by a superior court to one of inferior jurisdiction demanding the record of a particular case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104920311"
	 b:glossaryEntry="a writ ordering a prisoner to be brought before a judge"/>
<rdf:Description rdf:about="&a;104920450">
	<b:glossaryEntry>a judicial writ ordering a sheriff to summon people for jury duty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104920575">
	<b:glossaryEntry>an extraordinary writ commanding an official to perform a ministerial act that the law recognizes as an absolute duty and not a matter for the official''s discretion; used only when all other judicial remedies fail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104920862">
	<b:glossaryEntry>a writ ordering a levy on the belongings of a debtor to satisfy the debt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104920993">
	<b:glossaryEntry>a judicial writ based on some record and requiring the party against whom it is brought to show cause why the record should not be enforced or annulled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104921203">
	<b:glossaryEntry>a writ ordering the release of goods that have been unlawfully detained</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104921336"
	 b:glossaryEntry="a writ ordering that a judgment be enforced"/>
<rdf:Description rdf:about="&a;104921443"
	 b:glossaryEntry="a writ ordering the holding of an election"/>
<rdf:Description rdf:about="&a;104921548">
	<b:glossaryEntry>a judicial writ from an appellate court ordering the court of record to produce the records of trial</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104921708">
	<b:glossaryEntry>a judicial writ from a higher court ordering a lower court not to exercise jurisdiction in a particular case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104921882"
	 b:glossaryEntry="a writ ordering that land be restored to its rightful owner"/>
<rdf:Description rdf:about="&a;104922001"
	 b:glossaryEntry="a document giving an official instruction or command"/>
<rdf:Description rdf:about="&a;104922159">
	<b:glossaryEntry>a writ issued by authority of law; usually compels the defendant''s attendance in a civil suit; failure to appear results in a default judgment against the defendant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104922423">
	<b:glossaryEntry>a writ issued by court authority to compel the attendance of a witness at a judicial proceeding; disobedience may be punishable as a contempt of court</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104922656">
	<b:glossaryEntry>a writ issued by a court at the request of one of the parties to a suit; it requires a witness to bring to court or to a deposition any relevant documents under the witness''s control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104922905">
	<b:glossaryEntry>a summons that commands the appearance of a party at a proceeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104923025">
	<b:glossaryEntry>a summons issued to an offender (especially to someone who violates a traffic regulation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104923203"
	 b:glossaryEntry="a ticket issued for driving above the speed limit"/>
<rdf:Description rdf:about="&a;104923314"
	 b:glossaryEntry="a ticket issued for parking in a restricted place"/>
<rdf:Description rdf:about="&a;104923424">
	<b:glossaryEntry>(law) an allegation in legal form stating something on behalf of a party to a legal proceeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104923807">
	<b:glossaryEntry>any defensive pleading that affirms facts rather than merely denying the facts alleged by the plaintiff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104923977">
	<b:glossaryEntry>a pleading that alleges facts so separate that it is difficult to determine which facts the person intends to rely on</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104924191">
	<b:glossaryEntry>the principle pleading by the defendant in response to plaintiff''s complaint; in criminal law it consists of the defendant''s plea of `guilty'' or `not guilty'' (or nolo contendere); in civil law it must contain denials of all allegations in the plaintiff''s complaint that the defendant hopes to controvert and it can contain affirmative defenses or counterclaims</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104924658">
	<b:glossaryEntry>(law) an answer by a defendant that fails to admit or deny the allegations set forth in the complaint</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104924820">
	<b:glossaryEntry>(criminal law) an answer of `no contest'' by a defendant who does not admit guilt but that subjects him to conviction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104925009">
	<b:glossaryEntry>(law) a defendant''s answer by a factual matter (as distinguished from a demurrer)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104925177">
	<b:glossaryEntry>a plea that delays the action without settling the cause of action; it can challenge the jurisdiction or claim disability of the defendant etc. (such defenses are usually raised in the defendant''s answer)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104925441">
	<b:glossaryEntry>(criminal law) a plea in which the defendant claims innocence due to mental incompetence at the time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104925620">
	<b:glossaryEntry>(criminal law) a pleading describing some wrong or offense; "he was arrested on a charge of larceny"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104925822">
	<b:glossaryEntry>(civil law) the first pleading of the plaintiff setting out the facts on which the claim for relief is based</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104925986">
	<b:glossaryEntry>any pleading that fails to conform in form or substance to minimum standards of accuracy or sufficiency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926154">
	<b:glossaryEntry>any pleading that attacks the legal sufficiency of the opponent''s pleadings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926284">
	<b:glossaryEntry>a pleading by the defendant in reply to a plaintiff''s surrejoinder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926416">
	<b:glossaryEntry>a pleading made by a plaintiff in reply to the defendant''s plea or answer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926547">
	<b:glossaryEntry>a pleading made by a defendant in response to the plaintiff''s replication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926676">
	<b:glossaryEntry>a pleading that alleges new facts in avoidance of the opposing allegations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926813">
	<b:glossaryEntry>a pleading by the plaintiff in reply to the defendant''s rebutter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104926949">
	<b:glossaryEntry>a pleading by the plaintiff in reply to the defendant''s rejoinder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104927073">
	<b:glossaryEntry>(criminal law) a negotiation in which the defendant agrees to enter a plea of guilty to a lesser charge and the prosecutor agrees to drop a more serious charge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104927294"
	 b:glossaryEntry="an act passed by a legislative body"/>
<rdf:Description rdf:about="&a;104927456">
	<b:glossaryEntry>a provision in a law that confers on appropriate officials the power to implement or enforce the law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104927633">
	<b:glossaryEntry>a legislative act that applies only to a particular person or particular district</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104927772">
	<b:glossaryEntry>(computer science) written programs or procedures or rules and associated documentation pertaining to the operation of a computer system and that are stored in read/write memory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104928310">
	<b:glossaryEntry>a first release of a software product that is usually tested only by the developers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104928454">
	<b:glossaryEntry>software that can be used to develop interactive computer programs without the technically demanding task of computer programming</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104928648">
	<b:glossaryEntry>pre-release software that has received an alpha test but still has more bugs than a regular release; "beta software is usually available only to particular users who will test it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104928887">
	<b:glossaryEntry>software that can run on different computers without modification</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104929018">
	<b:glossaryEntry>application software programs that share common conventions so they can be utilized together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104929176">
	<b:glossaryEntry>software used in art and architecture and engineering and manufacturing to assist in precision drawing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104929352"
	 b:glossaryEntry="software that is provided without charge"/>
<rdf:Description rdf:about="&a;104929447">
	<b:glossaryEntry>software that can be used by a group of people who are working on the same information but may be distributed in space</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104929621">
	<b:glossaryEntry>(computer science) software that controls the execution of computer programs and may provide various services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104929853"
	 b:glossaryEntry="an operating system that is on a disk"/>
<rdf:Description rdf:about="&a;104929982"
	 b:glossaryEntry="an operating system developed by Microsoft for IBM computers"/>
<rdf:Description rdf:about="&a;104930129">
	<b:glossaryEntry>a powerful operating system developed at the Bell Telephone Laboratories</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104930290">
	<b:glossaryEntry>(computer science) a sequence of instructions that a computer can interpret and execute; "the program required several hundred lines of code"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104931025">
	<b:glossaryEntry>a program that gives a computer instructions that provide the user with tools to accomplish a task; "he has tried several different word processing applications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104931399">
	<b:glossaryEntry>an application that is currently running and in the foreground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104931526">
	<b:glossaryEntry>a Java application; an application program that uses the client''s web browser to provide a user interface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104931684"
	 b:glossaryEntry="a program used to view HTML documents"/>
<rdf:Description rdf:about="&a;104931825"
	 b:glossaryEntry="a freeware browser"/>
<rdf:Description rdf:about="&a;104931896"
	 b:glossaryEntry="a commercial browser"/>
<rdf:Description rdf:about="&a;104931971">
	<b:glossaryEntry>(computer science) a program application that may consist of several steps but is a single logical unit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104932124">
	<b:glossaryEntry>an application that provides the user with tools needed to write and edit and format text and to send it to a printer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104932327">
	<b:glossaryEntry>a computer program that performs a series of instructions repeatedly until some specified condition is satisfied</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104932490">
	<b:glossaryEntry>a short set of commands to correct a bug in a computer program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104932604">
	<b:glossaryEntry>a program to translate assembly language into computer language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104932742">
	<b:glossaryEntry>a program that examines other computer programs for syntax errors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104932870">
	<b:glossaryEntry>(computer science) a program that decodes instructions written in a higher order language and produces a machine language program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104933146"
	 b:glossaryEntry="a compiler for programs written in C"/>
<rdf:Description rdf:about="&a;104933239"
	 b:glossaryEntry="a compiler for programs written in Fortran"/>
<rdf:Description rdf:about="&a;104933344"
	 b:glossaryEntry="a compiler for programs written in LISP"/>
<rdf:Description rdf:about="&a;104933443"
	 b:glossaryEntry="a compiler for programs written in Pascal"/>
<rdf:Description rdf:about="&a;104933546">
	<b:glossaryEntry>a program that helps in locating and correcting programming errors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104933667">
	<b:glossaryEntry>(computer science) a program that determines how a computer will communicate with a peripheral device</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104933837">
	<b:glossaryEntry>a program that recognizes and explains faults in the equipment or mistakes in a computer program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104933998">
	<b:glossaryEntry>(computer science) a program designed to perform such editorial functions as rearrangement or modification or deletion of data</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104934230"
	 b:glossaryEntry="a utility program that organizes the input to a computer"/>
<rdf:Description rdf:about="&a;104934365">
	<b:glossaryEntry>(computer science) a program that controls a display for the user (usually on a computer monitor) and that allows the user to interact with the system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104934624">
	<b:glossaryEntry>a user interface in which you type commands instead of choosing them from a menu or selecting an icon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104934800">
	<b:glossaryEntry>a user interface based on graphics (icons and pictures and menus) instead of text; uses a mouse as well as a keyboard as an input device</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104935051">
	<b:glossaryEntry>(computer science) a program that translates and executes source language statements one line at a time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104935235"
	 b:glossaryEntry="a program that is called to prepare each job to be run"/>
<rdf:Description rdf:about="&a;104935347"
	 b:glossaryEntry="a program in a program library"/>
<rdf:Description rdf:about="&a;104935458">
	<b:glossaryEntry>an editor program that creates one module from several by resolving cross-references among the modules</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104935621">
	<b:glossaryEntry>a program that observes and regulates and controls or verifies the operations of a data-processing system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104935809">
	<b:glossaryEntry>(computer science) an application that can be used to create and view and edit text files</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104935956">
	<b:glossaryEntry>a fully compiled or assembled program ready to be loaded into the computer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104936126">
	<b:glossaryEntry>a program written in a language from which statements are translated into machine language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104936295"
	 b:glossaryEntry="a utility program that organizes the output of a computer"/>
<rdf:Description rdf:about="&a;104936432">
	<b:glossaryEntry>a program that can be located in different parts of memory at different times</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104936575"
	 b:glossaryEntry="a program that can be loaded once and executed repeatedly"/>
<rdf:Description rdf:about="&a;104936695">
	<b:glossaryEntry>a program that can change its performance in response to its environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104936835"
	 b:glossaryEntry="a trace program that produces output for selected conditions"/>
<rdf:Description rdf:about="&a;104936958">
	<b:glossaryEntry>a screen-oriented interactive program enabling a user to lay out financial data on the screen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104937109"
	 b:glossaryEntry="a utility program that sorts data items"/>
<rdf:Description rdf:about="&a;104937225"
	 b:glossaryEntry="a program that controls the execution of other programs"/>
<rdf:Description rdf:about="&a;104937418"
	 b:glossaryEntry="a program to check natural language syntax"/>
<rdf:Description rdf:about="&a;104937521">
	<b:glossaryEntry>a program (as an operating system or compiler or utility program) that controls some aspect of the operation of a computer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104937741">
	<b:glossaryEntry>a utility program that exhibits the sequence and results of executing the instructions in another program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104937943">
	<b:glossaryEntry>a program that translates one programming language into another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104938103">
	<b:glossaryEntry>(computer science) a program designed for general support of the processes of a computer; "a computer system provides utility programs to perform the tasks needed by most users"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104938497">
	<b:glossaryEntry>a table or matrix of all contingencies and the actions to be taken for each</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104938633">
	<b:glossaryEntry>a diagram of the sequence of operations in a computer program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104938766"
	 b:glossaryEntry="a graphical representation of a program using formal logic"/>
<rdf:Description rdf:about="&a;104938902"
	 b:glossaryEntry="a set sequence of steps, part of larger computer program"/>
<rdf:Description rdf:about="&a;104939242">
	<b:glossaryEntry>an instruction that interrupts the program being executed; "Pascal perfroms calls by simply giving the name of the routine to be executed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104939467">
	<b:glossaryEntry>a call that passes control to a subroutine; after the subroutine is executed control returns to the next instruction in main program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104939659">
	<b:glossaryEntry>a set of control statements that have been placed in a library and can be retrieved by name</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104939835">
	<b:glossaryEntry>an alternative to the normal procedure; triggered if an unusual but anticipated situation arises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104939999">
	<b:glossaryEntry>a routine that writes from an internal store to some external medium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104940126">
	<b:glossaryEntry>a routine that writes from an external source to an internal store</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104940271"
	 b:glossaryEntry="a debugged routine that is maintained in a program library"/>
<rdf:Description rdf:about="&a;104940410"
	 b:glossaryEntry="a routine that controls an output device"/>
<rdf:Description rdf:about="&a;104940530"
	 b:glossaryEntry="a routine designed to yield a random number"/>
<rdf:Description rdf:about="&a;104940643"
	 b:glossaryEntry="a routine that can call itself"/>
<rdf:Description rdf:about="&a;104940737"
	 b:glossaryEntry="a routine that can be loaded once and executed repeatedly"/>
<rdf:Description rdf:about="&a;104940857"
	 b:glossaryEntry="a routine that coordinates the operation of subroutines"/>
<rdf:Description rdf:about="&a;104941017">
	<b:glossaryEntry>a routine that provides a chronological record of the execution of a computer program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104941183"
	 b:glossaryEntry="a routine that can be used as needed"/>
<rdf:Description rdf:about="&a;104941372">
	<b:glossaryEntry>(computer science) a line of code written as part of a computer program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104941647"
	 b:glossaryEntry="commands that a user types in in order to run an application"/>
<rdf:Description rdf:about="&a;104941766">
	<b:glossaryEntry>a single computer instruction that results in a series of instructions in machine language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104941908">
	<b:glossaryEntry>an instruction that is either not recognized by an operating system or is in violation of the procedural rules</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104942077">
	<b:glossaryEntry>an instruction that interrupts the program being executed and passes control to the supervisor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104942259">
	<b:glossaryEntry>any instruction that works first one way and then the other; it turns something on the first time it is used and then turns it off the next time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104942456">
	<b:glossaryEntry>software that has been copyrighted but is sold to users with permission to copy it and give it to others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104942616">
	<b:glossaryEntry>specialized programs that reside permanently in the computer''s main memory and control the processing of user''s programs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104942803">
	<b:glossaryEntry>program listings or technical manuals describing the operation and use of programs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104942970">
	<b:glossaryEntry>(computer science) a database that can be accessed by computers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104943225">
	<b:glossaryEntry>a software system that facilitates the creation and maintenance and use of an electronic database</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104943438">
	<b:glossaryEntry>a database management system designed to manage a relational database</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104943591">
	<b:glossaryEntry>a database management system designed to manage an object-oriented database</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104943791">
	<b:glossaryEntry>a database management system that allows chunks of text (objects) to be processed as a complex network of nodes that are linked together in an arbitrary way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104944010"
	 b:glossaryEntry="a printed work offered for distribution"/>
<rdf:Description rdf:about="&a;104944401"
	 b:glossaryEntry='something that is read; "the article was a very good read"'/>
<rdf:Description rdf:about="&a;104944510">
	<b:glossaryEntry>all the copies of a work printed at one time; "they ran off an initial printing of 2000 copies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104944727">
	<b:glossaryEntry>the form in which a text (especially a printed book) is published</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104944882"
	 b:glossaryEntry="an edition that is restricted to a specific number of copies"/>
<rdf:Description rdf:about="&a;104945004">
	<b:glossaryEntry>an edition containing various versions of a text or notes by various scholars or editors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104945166"
	 b:glossaryEntry="(printing) a trial impression made to check for errors"/>
<rdf:Description rdf:about="&a;104945320"
	 b:glossaryEntry="a proof taken before the type is broken up to print pages"/>
<rdf:Description rdf:about="&a;104945436"
	 b:glossaryEntry="a proof taken from a form before duplicate plates are made"/>
<rdf:Description rdf:about="&a;104945554"
	 b:glossaryEntry="a printed impression that is blurred or doubled"/>
<rdf:Description rdf:about="&a;104945654"
	 b:glossaryEntry="a publication containing a variety of works"/>
<rdf:Description rdf:about="&a;104945821"
	 b:glossaryEntry="a collection of selected literary passages"/>
<rdf:Description rdf:about="&a;104945955">
	<b:glossaryEntry>one or more phonograph records or tape recordings issued together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104946087">
	<b:glossaryEntry>a collection of Persian or Arabic poems (usually by one author)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104946210">
	<b:glossaryEntry>an anthology of short literary pieces and poems and ballads etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104946355"
	 b:glossaryEntry="collection of records especially about an institution"/>
<rdf:Description rdf:about="&a;104946463"
	 b:glossaryEntry="something that is compiled (as into a single book or file)"/>
<rdf:Description rdf:about="&a;104946588"
	 b:glossaryEntry="a publication that appears at fixed intervals"/>
<rdf:Description rdf:about="&a;104946816"
	 b:glossaryEntry="a periodical that summarizes the news"/>
<rdf:Description rdf:about="&a;104946906">
	<b:glossaryEntry>a periodical (magazine or newspaper) containing many pictures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104947023"
	 b:glossaryEntry="a periodical that appears at scheduled times"/>
<rdf:Description rdf:about="&a;104947242"
	 b:glossaryEntry="a periodical that is published every month"/>
<rdf:Description rdf:about="&a;104947338"
	 b:glossaryEntry="a periodical that is published every quarter"/>
<rdf:Description rdf:about="&a;104947438"
	 b:glossaryEntry="a periodical that is published every week"/>
<rdf:Description rdf:about="&a;104947532">
	<b:glossaryEntry>a periodical that is published by a special interest group; "the organ of the communist party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104947696">
	<b:glossaryEntry>a periodical published by a business firm for its employees and customers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104947827">
	<b:glossaryEntry>a periodic paperback publication; "it takes several years before a magazine starts to break even or make money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104948091"
	 b:glossaryEntry="a racing publication giving information on horses"/>
<rdf:Description rdf:about="&a;104948213"
	 b:glossaryEntry="an inexpensive magazine printed on poor quality paper"/>
<rdf:Description rdf:about="&a;104948333"
	 b:glossaryEntry="a magazine printed on good quality paper"/>
<rdf:Description rdf:about="&a;104948442"
	 b:glossaryEntry="a magazine devoted to comic strips"/>
<rdf:Description rdf:about="&a;104948541">
	<b:glossaryEntry xml:space='preserve'><![CDATA[one of a series published periodically; "she found an old issue of the magazine in her dentist''s waitingroom"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104948748">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an issue of a newspaper; "he read it in yesterday''s edition of the Times"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104948875">
	<b:glossaryEntry>a periodical dedicated to a particular subject; "he reads the medical journals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104949026"
	 b:glossaryEntry="reports of the work of a society or learned body etc"/>
<rdf:Description rdf:about="&a;104949131">
	<b:glossaryEntry>a periodical that publishes critical essays on current affairs or literature or art</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104949285"
	 b:glossaryEntry="a review devoted to literary criticism"/>
<rdf:Description rdf:about="&a;104949385">
	<b:glossaryEntry>written material intended to be read; "the teacher assigned new readings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104949512"
	 b:glossaryEntry="reading carefully with intent to remember"/>
<rdf:Description rdf:about="&a;104949643"
	 b:glossaryEntry="reading superficially or at random"/>
<rdf:Description rdf:about="&a;104949741"
	 b:glossaryEntry="reading or glancing through quickly"/>
<rdf:Description rdf:about="&a;104949838"
	 b:glossaryEntry="what a communication that is about something is about"/>
<rdf:Description rdf:about="&a;104950524"
	 b:glossaryEntry="(psychoanalysis) hidden meaning of a fantasy or dream"/>
<rdf:Description rdf:about="&a;104950638">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the subject matter of a conversation or discussion; "he didn''t want to discuss that subject"; "it was a very sensitive topic"; "his letters were always on the theme of love"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104950917"
	 b:glossaryEntry="a message that departs from the main subject"/>
<rdf:Description rdf:about="&a;104951064"
	 b:glossaryEntry="a message written in a secret code"/>
<rdf:Description rdf:about="&a;104951160"
	 b:glossaryEntry="a sentence (in the indicative mood) that makes a declaration"/>
<rdf:Description rdf:about="&a;104951310">
	<b:glossaryEntry>an ungrammatical sentence in which two or more independent clauses are conjoined without a conjunction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104951474"
	 b:glossaryEntry="a sentence that states the topic of its paragraph"/>
<rdf:Description rdf:about="&a;104951584"
	 b:glossaryEntry="the message that is intended or expressed"/>
<rdf:Description rdf:about="&a;104951935">
	<b:glossaryEntry>the meaning of a word that depends on the nonlinguistic concepts it is used to express</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104952102">
	<b:glossaryEntry>the meaning of a word that depends on its role in a sentence; varies with inflectional form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104952278"
	 b:glossaryEntry="the use of symbols to convey meaning"/>
<rdf:Description rdf:about="&a;104952374">
	<b:glossaryEntry>the meaning of a word or expression; "the dictionary gave several senses for the word" or "in the best sense charity is really a duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104952578"
	 b:glossaryEntry="the meaning of a word"/>
<rdf:Description rdf:about="&a;104952685">
	<b:glossaryEntry>what you must know in order to determine the reference of an expression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104952834"
	 b:glossaryEntry="something that refers; a term that refers to another term"/>
<rdf:Description rdf:about="&a;104952946">
	<b:glossaryEntry>the first term in a proposition; the term to which other terms relate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104953070">
	<b:glossaryEntry>a term in a proposition that is related to the referent of the proposition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104953198"
	 b:glossaryEntry="something referred to; the object of a reference"/>
<rdf:Description rdf:about="&a;104953355">
	<b:glossaryEntry>the referent of an anaphor; a phrase or clause that is referred to by an anaphoric pronoun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104953502"
	 b:glossaryEntry="a actual object referred to by a linguistic expression"/>
<rdf:Description rdf:about="&a;104953612">
	<b:glossaryEntry>something (whether existing or not) that is referred to by a linguistic expression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104953751"
	 b:glossaryEntry="the central meaning or theme of a speech or literary work"/>
<rdf:Description rdf:about="&a;104953894"
	 b:glossaryEntry="the basic meaning of something; the crucial part"/>
<rdf:Description rdf:about="&a;104954004">
	<b:glossaryEntry>an expression whose meaning cannot be determined from its context</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104954197">
	<b:glossaryEntry>an ambiguity (especially one in the text of a law or contract) that makes it possible to evade a difficulty or obligation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104954373">
	<b:glossaryEntry>an ambiguous grammatical construction; "they are flying planes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104954494"
	 b:glossaryEntry="the use of ambiguous words"/>
<rdf:Description rdf:about="&a;104954577">
	<b:glossaryEntry>an inoffensive expression that is substituted for one that is considered offensive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104954769"
	 b:glossaryEntry='a substitute for a taboo word; "I hit the blank blank car"'/>
<rdf:Description rdf:about="&a;104954879"
	 b:glossaryEntry="a euphemism for `damn''"/>
<rdf:Description rdf:about="&a;104954952">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a euphemism for `hell''; "Oh what the heck"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104955045"
	 b:glossaryEntry="an expression of disappointment or irritation"/>
<rdf:Description rdf:about="&a;104955143"
	 b:glossaryEntry="an ambiguity with one interpretation that is indelicate"/>
<rdf:Description rdf:about="&a;104955260"
	 b:glossaryEntry="the intended meaning of a communication"/>
<rdf:Description rdf:about="&a;104955371">
	<b:glossaryEntry>the significance of a story or event; "the moral of the story is to love thy neighbor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104955518"
	 b:glossaryEntry="a subtle difference in meaning"/>
<rdf:Description rdf:about="&a;104955642">
	<b:glossaryEntry>(usually plural) an ulterior implicit meaning or quality; "overtones of despair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104955777"
	 b:glossaryEntry="the decisive point"/>
<rdf:Description rdf:about="&a;104955853"
	 b:glossaryEntry="the most important point"/>
<rdf:Description rdf:about="&a;104955967">
	<b:glossaryEntry>a brief version of the essential meaning of something; "get to the point"; "he missed the point of the joke"; "life has lost its point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104956226">
	<b:glossaryEntry>a point or principle on which scattered or opposing groups can come together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104956363">
	<b:glossaryEntry>an especially persuasive point helping to support an argument or discussion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104956498"
	 b:glossaryEntry="a message that seems to convey no meaning"/>
<rdf:Description rdf:about="&a;104956845"
	 b:glossaryEntry="a message whose content is at variance with reason"/>
<rdf:Description rdf:about="&a;104956981"
	 b:glossaryEntry="nonsensical writing (usually verse)"/>
<rdf:Description rdf:about="&a;104957089"
	 b:glossaryEntry="trivial nonsense"/>
<rdf:Description rdf:about="&a;104957187">
	<b:glossaryEntry>stock phrases that have become nonsense through endless repetition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104957315"
	 b:glossaryEntry="meaningless syllables in the refrain of a part-song"/>
<rdf:Description rdf:about="&a;104957427"
	 b:glossaryEntry="unintelligible talking"/>
<rdf:Description rdf:about="&a;104957640"
	 b:glossaryEntry="nonsense that is simply incoherent and unintelligible"/>
<rdf:Description rdf:about="&a;104957785"
	 b:glossaryEntry="meaningless ceremonies and flattery"/>
<rdf:Description rdf:about="&a;104957885"
	 b:glossaryEntry='loud and confused and empty talk; "mere rhetoric"'/>
<rdf:Description rdf:about="&a;104958036"
	 b:glossaryEntry="a set of confused and meaningless statements"/>
<rdf:Description rdf:about="&a;104958149">
	<b:glossaryEntry xml:space='preserve'><![CDATA[senseless talk; "don''t give me that stuff"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104958284"
	 b:glossaryEntry="gibberish and nonsense"/>
<rdf:Description rdf:about="&a;104958364"
	 b:glossaryEntry="gibberish resembling the sounds of a baby"/>
<rdf:Description rdf:about="&a;104958469"
	 b:glossaryEntry="foolish gibberish"/>
<rdf:Description rdf:about="&a;104958555"
	 b:glossaryEntry="(colloquial British) incomprehensible talk"/>
<rdf:Description rdf:about="&a;104958656"
	 b:glossaryEntry="deliberately unintelligible gibberish"/>
<rdf:Description rdf:about="&a;104958751"
	 b:glossaryEntry="rapid and indistinct speech"/>
<rdf:Description rdf:about="&a;104958852"
	 b:glossaryEntry="pretentious or silly talk or writing"/>
<rdf:Description rdf:about="&a;104959044"
	 b:glossaryEntry="a ludicrously false statement"/>
<rdf:Description rdf:about="&a;104959234">
	<b:glossaryEntry>a false statement that is considered to indicate timidity or fear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104959357"
	 b:glossaryEntry="nonsensical talk or writing"/>
<rdf:Description rdf:about="&a;104959501"
	 b:glossaryEntry="worthless or oversimplified ideas"/>
<rdf:Description rdf:about="&a;104959593"
	 b:glossaryEntry="a worthless message"/>
<rdf:Description rdf:about="&a;104959737"
	 b:glossaryEntry="language that is unnecessarily difficult to understand"/>
<rdf:Description rdf:about="&a;104959849"
	 b:glossaryEntry="a collection of excerpts from a literary work"/>
<rdf:Description rdf:about="&a;104959960">
	<b:glossaryEntry>an excerpt cut from a newspaper or magazine; "he searched through piles of letters and clippings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104960176"
	 b:glossaryEntry="a passage or expression that is quoted"/>
<rdf:Description rdf:about="&a;104960332"
	 b:glossaryEntry="a quotation at the beginning of some piece of writing"/>
<rdf:Description rdf:about="&a;104960440"
	 b:glossaryEntry="the representation of another person''s words in a speech"/>
<rdf:Description rdf:about="&a;104960550"
	 b:glossaryEntry="an incorrect quotation"/>
<rdf:Description rdf:about="&a;104960631">
	<b:glossaryEntry>a form of entertainment that enacts a story by a sequence of images giving the illusion of continuous movement; "they went to a movie every Saturday night"; "the film was shot on location"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104961237">
	<b:glossaryEntry>a consecutive series of pictures that constitutes a unit of action in a film</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104961409">
	<b:glossaryEntry>a scene that is filmed but is not used in the final editing of the film</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104961534">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the principal (full-length) film in a program at a movie theater; "the feature tonight is `Casablanca''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104961724"
	 b:glossaryEntry="a film or illustrated lecture on traveling"/>
<rdf:Description rdf:about="&a;104961834"
	 b:glossaryEntry="a film made at home by an amateur photographer"/>
<rdf:Description rdf:about="&a;104961937"
	 b:glossaryEntry="an entertainment that is offered to the public"/>
<rdf:Description rdf:about="&a;104962076"
	 b:glossaryEntry="a rival attraction"/>
<rdf:Description rdf:about="&a;104962158"
	 b:glossaryEntry="a movie that is advertised to draw customers"/>
<rdf:Description rdf:about="&a;104962266">
	<b:glossaryEntry>a film about life in the western US during the period of exploration and development</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104962418"
	 b:glossaryEntry="a movie featuring shooting and violence"/>
<rdf:Description rdf:about="&a;104962516"
	 b:glossaryEntry="a brief film; often shown prior to showing the feature"/>
<rdf:Description rdf:about="&a;104962666">
	<b:glossaryEntry>a film made by photographing a series of cartoon drawings to give the illusion of movement when projected in rapid sequence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104962862"
	 b:glossaryEntry="a short film and commentary about current events"/>
<rdf:Description rdf:about="&a;104962965">
	<b:glossaryEntry>a film or TV program presenting the facts about a person or event</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104963134">
	<b:glossaryEntry>a movie that shows ordinary people in actual activities without being controlled by a director</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104963288">
	<b:glossaryEntry>a short pornographic film shown in a small coin-operated booth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104963405"
	 b:glossaryEntry="a movie without a soundtrack"/>
<rdf:Description rdf:about="&a;104963492">
	<b:glossaryEntry>a movie that apparently takes place at a slower than normal speed; achieved by taking the film at a faster rate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104963661">
	<b:glossaryEntry>in films: a gradual transition from one scene to the next; the next scene is gradually superimposed as the former scene fades out</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104963845">
	<b:glossaryEntry>in films: an immediate transition from one shot to the next; "the cut from the accident scene to the hospital seemed too abrupt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104964041"
	 b:glossaryEntry="in films: a transition from one scene to another"/>
<rdf:Description rdf:about="&a;104964140"
	 b:glossaryEntry="an immediate transition from one scene to another"/>
<rdf:Description rdf:about="&a;104964244"
	 b:glossaryEntry="a movie with synchronized speech and singing"/>
<rdf:Description rdf:about="&a;104964359">
	<b:glossaryEntry>a movie with images having three dimensional form or appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104964487">
	<b:glossaryEntry>a public exhibition or entertainment; "they wanted to see some of the shows on Broadway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104964806">
	<b:glossaryEntry>a radio or television show; "did you see his program last night?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104965111"
	 b:glossaryEntry="a situation comedy"/>
<rdf:Description rdf:about="&a;104965182">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a program devoted to news; "we watch the 7 o''clock news every night"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104965328">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a program that is broadcast again; "she like to watch `I love Lucy'' reruns"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104965455">
	<b:glossaryEntry>a program during which well-known people discuss a topic or answer questions telephoned in by the audience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104965635"
	 b:glossaryEntry="a program in which the audience participates by telephone"/>
<rdf:Description rdf:about="&a;104965747"
	 b:glossaryEntry="a program broadcast by television"/>
<rdf:Description rdf:about="&a;104965940">
	<b:glossaryEntry>a program exemplifying a contemplated series; intended to attract sponsors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104966095">
	<b:glossaryEntry>a television or radio program in which contestants compete for awards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104966249"
	 b:glossaryEntry="a game show in which contestants answer questions"/>
<rdf:Description rdf:about="&a;104966357"
	 b:glossaryEntry="a strip of motion picture film used in a telecast"/>
<rdf:Description rdf:about="&a;104966481"
	 b:glossaryEntry='a serialized set of programs; "a comedey series"'/>
<rdf:Description rdf:about="&a;104966646"
	 b:glossaryEntry="an episode that ends in suspense"/>
<rdf:Description rdf:about="&a;104966736"
	 b:glossaryEntry="a part of a broadcast serial"/>
<rdf:Description rdf:about="&a;104966882"
	 b:glossaryEntry="a program without a commercial sponsor"/>
<rdf:Description rdf:about="&a;104966985">
	<b:glossaryEntry>a serialized program usually dealing with sentimentalized family matters that is broadcast on radio or television (frequently sponsored by a company advertising soap products)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104967217"
	 b:glossaryEntry="a series of four related works (plays or operas or novels)"/>
<rdf:Description rdf:about="&a;104967331"
	 b:glossaryEntry="message that is transmitted by radio or television"/>
<rdf:Description rdf:about="&a;104967491"
	 b:glossaryEntry="a broadcast via radio"/>
<rdf:Description rdf:about="&a;104967574">
	<b:glossaryEntry>a broadcast that is carried simultaneously by radio and television (or by FM and AM radio)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104967720"
	 b:glossaryEntry="a television broadcast"/>
<rdf:Description rdf:about="&a;104967816"
	 b:glossaryEntry="a message transmitted by telegraph"/>
<rdf:Description rdf:about="&a;104967966"
	 b:glossaryEntry="a cheaper form of telegram sent for delivery the next day"/>
<rdf:Description rdf:about="&a;104968082">
	<b:glossaryEntry>the bags of letters and packages that are transported by the postal service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104968371"
	 b:glossaryEntry="letters and packages that are transported by aircraft"/>
<rdf:Description rdf:about="&a;104968478"
	 b:glossaryEntry="mail that is sent by air transport"/>
<rdf:Description rdf:about="&a;104968585"
	 b:glossaryEntry="mail that is sent by land or sea"/>
<rdf:Description rdf:about="&a;104968694">
	<b:glossaryEntry>mail that is delivered by a special carrier (for an additional charge)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104968827"
	 b:glossaryEntry="communication by the exchange of letters"/>
<rdf:Description rdf:about="&a;104968965">
	<b:glossaryEntry>a written message addressed to a person or organization; "wrote an indignant letter to the editor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104969436"
	 b:glossaryEntry="a note appended to a letter after the signature"/>
<rdf:Description rdf:about="&a;104969564"
	 b:glossaryEntry="a letter dealing with business"/>
<rdf:Description rdf:about="&a;104969656"
	 b:glossaryEntry="a hostile (usually anonymous) letter"/>
<rdf:Description rdf:about="&a;104969751">
	<b:glossaryEntry>a letter from the pope sent to all Roman Catholic bishops throughout the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104969906"
	 b:glossaryEntry="a letter dealing with personal affairs"/>
<rdf:Description rdf:about="&a;104970042">
	<b:glossaryEntry>a letter that is printed in multiple copies and mailed to a list of recipients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104970178">
	<b:glossaryEntry>a letter of protest; addressed to one person but intended for the general public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104970316"
	 b:glossaryEntry="a letter that is sent successively to several people"/>
<rdf:Description rdf:about="&a;104970427"
	 b:glossaryEntry="a letter from a pastor to the congregation"/>
<rdf:Description rdf:about="&a;104970524"
	 b:glossaryEntry="a letter signed by a number of people"/>
<rdf:Description rdf:about="&a;104970619"
	 b:glossaryEntry="a letter sent by air mail"/>
<rdf:Description rdf:about="&a;104970742"
	 b:glossaryEntry="especially a long, formal letter"/>
<rdf:Description rdf:about="&a;104970828"
	 b:glossaryEntry='a short personal letter; "drop me a line when you get there"'/>
<rdf:Description rdf:about="&a;104970961"
	 b:glossaryEntry="a personal letter to a loved one expressing affection"/>
<rdf:Description rdf:about="&a;104971086"
	 b:glossaryEntry="a letter that can neither be delivered nor returned"/>
<rdf:Description rdf:about="&a;104971195">
	<b:glossaryEntry>any letter expressing an intention to take (or forgo) some action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104971341">
	<b:glossaryEntry>a rectangular piece of stiff paper used to send messages (may have printed greetings or pictures); "they sent us a card from Miami"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104971613"
	 b:glossaryEntry="a card expressing a birthday greeting"/>
<rdf:Description rdf:about="&a;104971710"
	 b:glossaryEntry="a card expressing get-well wishes"/>
<rdf:Description rdf:about="&a;104971803"
	 b:glossaryEntry="a card sent to express personal greetings"/>
<rdf:Description rdf:about="&a;104971976"
	 b:glossaryEntry="a card expressing a Christmas greeting"/>
<rdf:Description rdf:about="&a;104972075"
	 b:glossaryEntry="a card expressing an Easter greeting"/>
<rdf:Description rdf:about="&a;104972169">
	<b:glossaryEntry>a card sent or given (as to a sweetheart) on Saint Valentine''s Day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104972291"
	 b:glossaryEntry="a card expressing sympathy"/>
<rdf:Description rdf:about="&a;104972377"
	 b:glossaryEntry="a card for sending messages by post without an envelope"/>
<rdf:Description rdf:about="&a;104972552"
	 b:glossaryEntry="a postcard that folds so the message is inside"/>
<rdf:Description rdf:about="&a;104972655"
	 b:glossaryEntry="a postcard with a picture on one side"/>
<rdf:Description rdf:about="&a;104972755">
	<b:glossaryEntry>a card indicating that the sender will perform certain devotional acts on behalf of another (Roman Catholic Church)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104972934"
	 b:glossaryEntry="a statement acknowledging something or someone"/>
<rdf:Description rdf:about="&a;104973257"
	 b:glossaryEntry="an acknowledgment or expression of goodwill at parting"/>
<rdf:Description rdf:about="&a;104973475"
	 b:glossaryEntry='a farewell remark; "they said their good-byes"'/>
<rdf:Description rdf:about="&a;104973723">
	<b:glossaryEntry>an organized expression of goodwill at the start of a trip or new venture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104973864">
	<b:glossaryEntry>(usually plural) an acknowledgment or expression of good will (especially on meeting)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104974233">
	<b:glossaryEntry>an expression of good will from one person to another; "much hand-shaking and well-wishing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104974383">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually plural) a polite expression of desire for someone''s welfare; "give him my kind regards"; "my best wishes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104974571">
	<b:glossaryEntry>the manner in which something is greeted; "she did not expect the cold reception she received from her superiors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104974751"
	 b:glossaryEntry="enthusiastic greeting"/>
<rdf:Description rdf:about="&a;104974823">
	<b:glossaryEntry>(Roman Catholic) a greeting signifying Christian love for those assisting at the Eucharist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104974979"
	 b:glossaryEntry='a greeting or reception; "the proposal got a warm welcome"'/>
<rdf:Description rdf:about="&a;104975139"
	 b:glossaryEntry="kindness in welcoming guests or strangers"/>
<rdf:Description rdf:about="&a;104975258"
	 b:glossaryEntry="a warm welcome; may be insincere"/>
<rdf:Description rdf:about="&a;104975346">
	<b:glossaryEntry>an acknowledgment that can be used to say hello or goodbye (aloha is Hawaiian; ciao is Italian)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104975500">
	<b:glossaryEntry>grasping and shaking a person''s hand (as to acknowledge an introduction or to agree on a contract)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104975688">
	<b:glossaryEntry>an act of greeting with friendly words and gestures like bowing or lifting the hat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104975823">
	<b:glossaryEntry>an expression of greeting; "every morning they exchanged polite hellos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104975983"
	 b:glossaryEntry="a conventional expression of greeting or farewell"/>
<rdf:Description rdf:about="&a;104976119"
	 b:glossaryEntry="a conventional expression of greeting or farewell"/>
<rdf:Description rdf:about="&a;104976259"
	 b:glossaryEntry="a conventional expression of farewell"/>
<rdf:Description rdf:about="&a;104976353"
	 b:glossaryEntry="a formal military gesture of respect"/>
<rdf:Description rdf:about="&a;104976462">
	<b:glossaryEntry>a written greeting that is left to indicate that you have visited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104976609">
	<b:glossaryEntry>an expression of regret at having caused trouble for someone; "he wrote a letter of apology to the hostess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104976770">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an expression of sympathy with another''s grief; "they sent their condolences"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104976920"
	 b:glossaryEntry="acknowledgement that someone has an occasion for celebration"/>
<rdf:Description rdf:about="&a;104977056"
	 b:glossaryEntry="the polite declining of an invitation"/>
<rdf:Description rdf:about="&a;104977171">
	<b:glossaryEntry>a message received and understood that reduces the recipient''s uncertainty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104977724"
	 b:glossaryEntry="information that is incorrect"/>
<rdf:Description rdf:about="&a;104977814">
	<b:glossaryEntry>information (data or ideas or observations) that can be reworked into a finished form; "the archives provided rich material for a definitive biography"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104978056">
	<b:glossaryEntry>old material that is slightly reworked and used again; "merely a dull rehash of his first novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104978205">
	<b:glossaryEntry>true confidential information; "after the trial he gave us the real details"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104978374">
	<b:glossaryEntry>slang terms for inside information; "is that the straight dope?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104978516">
	<b:glossaryEntry>a statement or assertion of verified information about something that is the case or has happened; "he supported his argument with an impressive array of facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104978781">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a compilation of the known facts regarding something or someone; "Al Smith used to say, `Let''s look at the record''"; "his name is in all the recordbooks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104979062">
	<b:glossaryEntry>the organization of information according to preset specifications (usually for computer processing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104979296">
	<b:glossaryEntry>(computer science) the format for the root directory and the file allocation tables and other basic configurations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104979478">
	<b:glossaryEntry>(computer science) the format of sectors on the surface of a hard disk drive so that the operating system can access them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104979683">
	<b:glossaryEntry>(British) informal term for information; "give me the gen on your new line of computers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104979821"
	 b:glossaryEntry="an organized body of related information"/>
<rdf:Description rdf:about="&a;104979970">
	<b:glossaryEntry>a database in which relations between information items are explicitly specified as accessible attributes; "in a relational database the data are organized as a number of differently sized tables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104980232">
	<b:glossaryEntry>a database in which the operations carried out on information items (data objects) are considered part of their definition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104980444">
	<b:glossaryEntry>a subset of data in a database that are used in a specific application</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104980573"
	 b:glossaryEntry="a database of information about words"/>
<rdf:Description rdf:about="&a;104980709">
	<b:glossaryEntry>a machine-readable version of a standard dictionary; organized alphabetically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104980890"
	 b:glossaryEntry="a machine-readable lexical database organized by meanings"/>
<rdf:Description rdf:about="&a;104981001"
	 b:glossaryEntry="a statement of fundamental facts or principles"/>
<rdf:Description rdf:about="&a;104981133">
	<b:glossaryEntry>a number or ratio (a value on a scale of measurement) derived from a series of observed facts; can reveal relative changes as a function of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104981457">
	<b:glossaryEntry>a statistical compilation that provides a context for economic or financial conditions; "this business index is computed relative to the base year of 1995"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104981673">
	<b:glossaryEntry>an indicator of stock market prices; based on the share values of 30 leading companies listed on the New York Stock Exchange</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104981884">
	<b:glossaryEntry>one of 11 indicators for different sections of the economy; used by the Department of Commerce to predict economic trends in the near future</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104982088">
	<b:glossaryEntry>an index that traces the relative changes in the price of an individual good (or a market basket of goods) over time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104982330"
	 b:glossaryEntry="an index of changes in retail prices"/>
<rdf:Description rdf:about="&a;104982431"
	 b:glossaryEntry="an index of changes in wholesale prices"/>
<rdf:Description rdf:about="&a;104982561">
	<b:glossaryEntry>an index of the cost of all goods and services to a typical consumer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104982725"
	 b:glossaryEntry="the aggregate of short sales on an open market"/>
<rdf:Description rdf:about="&a;104982831">
	<b:glossaryEntry>new information about specific and timely events; "they awaited news of the outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104983034"
	 b:glossaryEntry='new information of any kind; "it was news to me"'/>
<rdf:Description rdf:about="&a;104983133">
	<b:glossaryEntry>secret information about an enemy (or potential enemy); "we sent out planes to gather intelligence on their radar coverage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104983315"
	 b:glossaryEntry="good news"/>
<rdf:Description rdf:about="&a;104983380"
	 b:glossaryEntry="news that updates your information"/>
<rdf:Description rdf:about="&a;104983467">
	<b:glossaryEntry>an indication that makes something evident; "his trembling was evidence of his fear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104983714"
	 b:glossaryEntry="evidence that helps to solve a problem"/>
<rdf:Description rdf:about="&a;104983888">
	<b:glossaryEntry>a clue made by an impression of the ridges in the skin of a finger</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104984030"
	 b:glossaryEntry="the basic pattern of the human fingerprint"/>
<rdf:Description rdf:about="&a;104984123">
	<b:glossaryEntry>a mark of a foot or shoe on a surface; a clue that someone was present; "the police made casts of the footprints in the soft earth outside the window"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104984365">
	<b:glossaryEntry>a perceptible indication of something not immediately apparent (as a visible clue that something has happened); "he showed signs of strain"; "they welcomed the signs of spring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104984599">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a clue that something has been present; "there wasn''t a trace of evidence for the claim"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104984758">
	<b:glossaryEntry>anything (such as a document or a phonograph record or a photograph) providing permanent evidence of or information about past events; "the film provided a valuable record of stage techniques"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104985093">
	<b:glossaryEntry>(logic or mathematics) a formal series of statements showing that if one thing is true something else necessarily follows from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104985310"
	 b:glossaryEntry="proof of a mathematical theorem"/>
<rdf:Description rdf:about="&a;104985406">
	<b:glossaryEntry>a logical proof of a proposition by showing that its negation leads to a contradiction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104985559"
	 b:glossaryEntry="proof of a logical theorem"/>
<rdf:Description rdf:about="&a;104985679">
	<b:glossaryEntry>something that serves as evidence; "his effort was testimony to his devotion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104985844">
	<b:glossaryEntry>strong evidence for something; "his easy victory was a testament to his skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104985978">
	<b:glossaryEntry>a fact or assertion offered as evidence that something is true; "it was a strong argument that his hypothesis was true"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104986290"
	 b:glossaryEntry="an argument in favor of a proposal"/>
<rdf:Description rdf:about="&a;104986392"
	 b:glossaryEntry="an argument opposeed to a proposal"/>
<rdf:Description rdf:about="&a;104986494">
	<b:glossaryEntry>a statement of facts and reasons used to support an argument; "he stated his case clearly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104986635"
	 b:glossaryEntry="an argument that is conclusive"/>
<rdf:Description rdf:about="&a;104986754"
	 b:glossaryEntry="citing as evidence or proof"/>
<rdf:Description rdf:about="&a;104986836"
	 b:glossaryEntry="the evidence by which something is attested"/>
<rdf:Description rdf:about="&a;104986937"
	 b:glossaryEntry="information that confirms or verifies"/>
<rdf:Description rdf:about="&a;104987069">
	<b:glossaryEntry>information that makes more forcible or convincing; "his gestures provided eloquent reinforcement for his complaints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104987262"
	 b:glossaryEntry="confirmation that some fact or statement is true"/>
<rdf:Description rdf:about="&a;104987402"
	 b:glossaryEntry="direction or advice as to a decision or course of action"/>
<rdf:Description rdf:about="&a;104987620"
	 b:glossaryEntry="counseling on career opportunities"/>
<rdf:Description rdf:about="&a;104987718"
	 b:glossaryEntry="counseling on marital problems and disagreements"/>
<rdf:Description rdf:about="&a;104987832">
	<b:glossaryEntry>an indication of potential opportunity; "he got a tip on the stock market"; "a good lead for a job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104988037">
	<b:glossaryEntry>important information about the plans or condition of a corporation that has not been released to the public; use for personal profit is illegal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104988247">
	<b:glossaryEntry>guidance relative to setting standards or determining a course of action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104988375">
	<b:glossaryEntry>a systematic body of regulations defining the way of life of members of a religious order; "the rule of St. Dominic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104988542"
	 b:glossaryEntry="prescribed guide for conduct or action"/>
<rdf:Description rdf:about="&a;104988859"
	 b:glossaryEntry="an authoritative rule"/>
<rdf:Description rdf:about="&a;104988933"
	 b:glossaryEntry="a body of rules followed by an assembly"/>
<rdf:Description rdf:about="&a;104989177">
	<b:glossaryEntry>a procedure (in some parliaments) of demanding that a government official explain some act or policy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104989338">
	<b:glossaryEntry>a rule of law whereby any alleged matter of fact that is submitted for investigation at a judicial trial is established or disproved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104989659">
	<b:glossaryEntry>a rule of evidence requiring that to prove the content of a writing or recording or photograph the original is required</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104989843">
	<b:glossaryEntry>a rule of evidence whereby a person is barred from denying the truth of a fact that has already been settled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104990006">
	<b:glossaryEntry>a rule that provides that otherwise admissible evidence cannot be used in a criminal trial if it was the result of illegal police conduct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104990207">
	<b:glossaryEntry>a rule that once primary evidence is determined to have been illegally obtained any secondary evidence following from it may also not be used</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104990422">
	<b:glossaryEntry>a rule that declares not admissible as evidence any statement other than that by a witness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104990571">
	<b:glossaryEntry>a rule that oral evidence cannot be used to contradict the terms of a written contract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104990723">
	<b:glossaryEntry>a rule of evidence whereby the negligence of an alleged wrongdoer can be inferred from the fact that the accident happened</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104990909"
	 b:glossaryEntry="a rule of order permanently in force"/>
<rdf:Description rdf:about="&a;104991006"
	 b:glossaryEntry="rule of personal conduct"/>
<rdf:Description rdf:about="&a;104991169"
	 b:glossaryEntry="the principle that conduct should be moral"/>
<rdf:Description rdf:about="&a;104991291">
	<b:glossaryEntry>any important rule; "the golden rule of teaching is to be clear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104991413">
	<b:glossaryEntry>the moral principle that behavior should be determined by duty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104991544">
	<b:glossaryEntry>a principle stating the action required to attain a desired goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104991678">
	<b:glossaryEntry>a line of argument rationalizing the course of action of a government; "they debated the policy or impolicy of the proposed legislation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104991993">
	<b:glossaryEntry>a government policy for maintaining economic growth and tax revenues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104992195">
	<b:glossaryEntry>a government policy for dealing with the budget (especially with taxation and borrowing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104992343"
	 b:glossaryEntry="the economic policy of F. D. Roosevelt"/>
<rdf:Description rdf:about="&a;104992436">
	<b:glossaryEntry>the economic policy of controlling or limiting or curbing prices or wages etc.; "they wanted to repeal all the legislation that imposed economic controls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104992698">
	<b:glossaryEntry>restriction on maximum prices that is established and maintained by the government (as during periods of war or inflation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104992880">
	<b:glossaryEntry>an upper limit on what is allowed: "they established a cap for prices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104993010"
	 b:glossaryEntry='a lower limit: "the government established a wage floor"'/>
<rdf:Description rdf:about="&a;104993125">
	<b:glossaryEntry>the policy of imposing duties or quotas on imports in order to protect home industries from overseas competition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104993315"
	 b:glossaryEntry="a policy of for dealing with social issues"/>
<rdf:Description rdf:about="&a;104993435"
	 b:glossaryEntry="a policy of socioeconomic reform"/>
<rdf:Description rdf:about="&a;104993545">
	<b:glossaryEntry>a policy designed to redress past discrimination against women and minority groups through measures to improve their economic and educational opportunities; "affirmative action has been extremely controversial and was challenged in 1978 in the Bakke decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104993869"
	 b:glossaryEntry="any regulation or policy that restricts international trade"/>
<rdf:Description rdf:about="&a;104994041">
	<b:glossaryEntry>a limitation on imports; "the quota for Japanese imports was negotiated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104994165"
	 b:glossaryEntry="a government order imposing a trade barrier"/>
<rdf:Description rdf:about="&a;104994295">
	<b:glossaryEntry>the policy of perpetuating native cultures (in opposition to acculturation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104994425">
	<b:glossaryEntry>the policy of a political group; "He won in a vote along party lines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104994551"
	 b:glossaryEntry="a policy governing international relations"/>
<rdf:Description rdf:about="&a;104994834">
	<b:glossaryEntry>the policy of pushing a dangerous situation to the brink of disaster (to the limits of safety)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104994987"
	 b:glossaryEntry="a policy of extending your rule over foreign countries"/>
<rdf:Description rdf:about="&a;104995117"
	 b:glossaryEntry="a policy of intervening in the affairs of other countries"/>
<rdf:Description rdf:about="&a;104995284">
	<b:glossaryEntry>a foreign policy of staying out of other countries'' disputes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104995460">
	<b:glossaryEntry>a policy of not initiating hostilities; "they signed a nonagression pact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104995593">
	<b:glossaryEntry>a policy of imperialism rationalized as inevitable (as if granted by God)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104995729">
	<b:glossaryEntry>a policy of nonparticipation in international economic and political relations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104995866">
	<b:glossaryEntry>an American foreign policy opposing interference in the Western hemisphere from outside powers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104996022">
	<b:glossaryEntry>President Truman''s policy of providing economic and military aid to any country threatened by communism or totalitarian ideology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104996212">
	<b:glossaryEntry>a policy of neutrality or nonalignment in international affairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104996332"
	 b:glossaryEntry="a government''s policy controlling foreign trade"/>
<rdf:Description rdf:about="&a;104996482">
	<b:glossaryEntry>the policy of granting equal trade opportunities to all countries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104996622">
	<b:glossaryEntry>a policy for establishing and developing a national homeland for Jews in Palestine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104996758">
	<b:glossaryEntry>a system of principles governing morality and acceptable conduct</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104996926">
	<b:glossaryEntry>a commercial principle that without a warranty the buyer takes upon himself the risk of quality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104997081"
	 b:glossaryEntry="an authoritative rule"/>
<rdf:Description rdf:about="&a;104997156"
	 b:glossaryEntry="an authoritative rule or law"/>
<rdf:Description rdf:about="&a;104997289">
	<b:glossaryEntry>regulation establishing the top speed permitted on a given road</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104997410">
	<b:glossaryEntry>the regulation of weights and measures of articles offered for sale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104997530">
	<b:glossaryEntry>a rule or especially body of rules or principles generally established as valid and fundamental in a field or art or philosophy: "the neoclassical canon"; "canons of polite society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104997763"
	 b:glossaryEntry="rules governing socially acceptable behavior"/>
<rdf:Description rdf:about="&a;104997899">
	<b:glossaryEntry>forms of ceremony and etiquette observed by diplomats and heads of state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104998026">
	<b:glossaryEntry>(computer science) rules determining the format and transmission of data</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104998269">
	<b:glossaryEntry>(computer science) protocol that allows users to copy files between their local system and any system they can reach on the network</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104998493">
	<b:glossaryEntry>a common way to make software available; users are allowed to log in as `guest'' without a password and copy whatever has been made available</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104998728">
	<b:glossaryEntry>a protocol (utilizing TCP) to transfer hypertext requests and information between servers and browsers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104998911">
	<b:glossaryEntry>a standard protocol for communication between electronic musical instruments and computers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104999091">
	<b:glossaryEntry>a protocol developed for the internet to get data from one network device to another; "TCP uses a retransmission strategy to insure that data will not be lost in transmission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104999367">
	<b:glossaryEntry>a set of protocols (including TCP) developed for the internet in the 1970s to get data from one network device to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104999610"
	 b:glossaryEntry="a fine point of etiquette or petty formality"/>
<rdf:Description rdf:about="&a;104999710"
	 b:glossaryEntry="a rule for ending debate in a deliberative body"/>
<rdf:Description rdf:about="&a;104999850"
	 b:glossaryEntry="closure imposed on the debate of specific sections of a bill"/>
<rdf:Description rdf:about="&a;104999993">
	<b:glossaryEntry>a question as to whether the current proceedings are allowed by parliamentary procedure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105000141"
	 b:glossaryEntry="a set of rules or principles or laws especially written ones"/>
<rdf:Description rdf:about="&a;105000339">
	<b:glossaryEntry>a code of laws adopted by a state or nation: "a code of laws"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105000529"
	 b:glossaryEntry="the legal code governing crimes and their punishment"/>
<rdf:Description rdf:about="&a;105000638">
	<b:glossaryEntry>set of standards established and enforced by local government for the structural safety of buildings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105000798">
	<b:glossaryEntry>set of standards established and enforced by government for health requirements as in plumbing etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105000970">
	<b:glossaryEntry>set of standards established and enforced by government for fire prevention and safety in case of fire as in fire escapes etc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105001151">
	<b:glossaryEntry>an ethical or moral code that applies more strictly to one group than to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105001311">
	<b:glossaryEntry>a code that permits greater sexual freedom for men than for women (associated with the subordination of women)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105001502"
	 b:glossaryEntry="a mathematical statement that two expressions are equal"/>
<rdf:Description rdf:about="&a;105001720"
	 b:glossaryEntry="a polynomial equation of the first degree"/>
<rdf:Description rdf:about="&a;105001823">
	<b:glossaryEntry>an equation in which the highest power of an unknown quantity is a square</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105001973"
	 b:glossaryEntry="and equation of the fourth degree"/>
<rdf:Description rdf:about="&a;105002087"
	 b:glossaryEntry="an equation containing differentials of a function"/>
<rdf:Description rdf:about="&a;105002259">
	<b:glossaryEntry>a differential equation involving a functions of more than one variable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105002406">
	<b:glossaryEntry>a differential equation that describes the passage of harmonic waves through a medium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105002551"
	 b:glossaryEntry="the fundamental equation of wave mechanics"/>
<rdf:Description rdf:about="&a;105002688"
	 b:glossaryEntry="a proposal for an appropriate course of action"/>
<rdf:Description rdf:about="&a;105002823"
	 b:glossaryEntry="something (as a course of action) that is recommended"/>
<rdf:Description rdf:about="&a;105002955">
	<b:glossaryEntry>a recommendation to consult the (professional) person referred to; "this patient is a referral from Dr. Bones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105003120"
	 b:glossaryEntry="cautionary advice"/>
<rdf:Description rdf:about="&a;105003239">
	<b:glossaryEntry>punishment intended as a warning to others; "they decided to make an example of him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105003422">
	<b:glossaryEntry>information known only to a special group; "the secret of Cajun cooking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105003611">
	<b:glossaryEntry>something that should remain hidden from others (especially information that is not to be passed on); "the combination to the safe was a secret"; "he tried to keep his drinking a secret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105003904">
	<b:glossaryEntry>a secret that is confided or entrusted to another; "everyone trusted him with their confidences"; "the priest could not reveal her confidences"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105004104"
	 b:glossaryEntry="secrets known only to an initiated minority"/>
<rdf:Description rdf:about="&a;105004203"
	 b:glossaryEntry="an esoteric or occult matter that is traditionally secret"/>
<rdf:Description rdf:about="&a;105004364">
	<b:glossaryEntry>something that is supposed to be secret but is generally known; "their love affair was an open secret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105004524">
	<b:glossaryEntry>a secret word or phrase known only to a restricted group; "he forgot the password"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105004703">
	<b:glossaryEntry>a secret (method or device or formula) that gives a manufacturer an advantage over the competition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105004860">
	<b:glossaryEntry>information that is spread for the purpose of promoting some cause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105004983">
	<b:glossaryEntry>a catalog listing the courses offered by a college or university</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105005140">
	<b:glossaryEntry>a document (or organization) from which information is obtained; "the reporter had two sources for the story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105005338"
	 b:glossaryEntry="publications from which information is obtained"/>
<rdf:Description rdf:about="&a;105005448"
	 b:glossaryEntry='an abundant source; "she was a well of information"'/>
<rdf:Description rdf:about="&a;105005578">
	<b:glossaryEntry>material suitable for a journalistic account; "catastrophes make good copy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105005723">
	<b:glossaryEntry>copy to fill space between more important articles in the layout of a magazine or newspaper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105005867">
	<b:glossaryEntry>a course of academic studies; "he was admitted to a new program at the university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105006100"
	 b:glossaryEntry="a program designed to teach literacy skills"/>
<rdf:Description rdf:about="&a;105006205"
	 b:glossaryEntry="a course of study leading to an academic degree"/>
<rdf:Description rdf:about="&a;105006313"
	 b:glossaryEntry="reproduction by applying ink to paper as for publication"/>
<rdf:Description rdf:about="&a;105006587"
	 b:glossaryEntry="art and technique of printing with movable type"/>
<rdf:Description rdf:about="&a;105006705"
	 b:glossaryEntry="the result of the printing process"/>
<rdf:Description rdf:about="&a;105006809"
	 b:glossaryEntry="printing from a plate with raised characters"/>
<rdf:Description rdf:about="&a;105006929"
	 b:glossaryEntry="printing from a plate with depressed characters"/>
<rdf:Description rdf:about="&a;105007058">
	<b:glossaryEntry>a method of printing colored reproductions from halftone plates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105007184">
	<b:glossaryEntry>printing from an intaglio plate prepared by photographic methods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105007325">
	<b:glossaryEntry>printing by transferring an image from a photogravure plate to a cylinder in a rotary press</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105007474">
	<b:glossaryEntry>the process of printing from a surface on which the printing areas are not raised but are ink-receptive (as opposed to ink repellent)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105007725">
	<b:glossaryEntry>a kind of color printing, used for the finest facsimile reproductions of works of art</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105007911">
	<b:glossaryEntry>a method of planographic printing from a metal or stone surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105008086">
	<b:glossaryEntry>a planographic printing process using plates made from a photographic image</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105008224"
	 b:glossaryEntry="single- or multi-color lithography"/>
<rdf:Description rdf:about="&a;105008322"
	 b:glossaryEntry="a method of offset printing using photomechanical plates"/>
<rdf:Description rdf:about="&a;105008461">
	<b:glossaryEntry>a plate makes an inked impression on a rubber-blanketed cylinder, which in turn transfers it to the paper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105008673"
	 b:glossaryEntry="offset printing by lithography"/>
<rdf:Description rdf:about="&a;105008768"
	 b:glossaryEntry="image is transferred from a relief type plate to a roller"/>
<rdf:Description rdf:about="&a;105008890"
	 b:glossaryEntry="an electrostatic printing process"/>
<rdf:Description rdf:about="&a;105008980">
	<b:glossaryEntry>a process of printing on paper coated with bichromated gelatin containing pigment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105009122">
	<b:glossaryEntry>information reported in a newspaper or news magazine; "the news of my death was greatly exaggerated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105009327">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a short account of the news; "the report of his speech"; "the story was on the 11 o''clock news"; "the account of his speech that was given on the evening news made the governor furious"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105009680"
	 b:glossaryEntry="report or open letter giving informal or confidential news"/>
<rdf:Description rdf:about="&a;105009825">
	<b:glossaryEntry>a newsletter written by an analyst of the stock market and sold to subscribers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105009963">
	<b:glossaryEntry>a brief report especially an official statement issued for immediate publication or broadcast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105010147">
	<b:glossaryEntry>a short news announcement concerning some on-going news story</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105010288"
	 b:glossaryEntry="a bulletin containing the latest information"/>
<rdf:Description rdf:about="&a;105010399"
	 b:glossaryEntry="an official report (usually sent in haste)"/>
<rdf:Description rdf:about="&a;105010539">
	<b:glossaryEntry>a news report that is reported first by one news organization; "he got a scoop on the bribery of city officials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105010715"
	 b:glossaryEntry="a broadcast of news"/>
<rdf:Description rdf:about="&a;105010825"
	 b:glossaryEntry="a radio broadcast of news"/>
<rdf:Description rdf:about="&a;105010907"
	 b:glossaryEntry="a television broadcast of news"/>
<rdf:Description rdf:about="&a;105010999">
	<b:glossaryEntry>the news as presented by reporters for newspapers or radio of television; "they accused the paper of biased coverage of race relations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105011213"
	 b:glossaryEntry="a message that makes a pledge"/>
<rdf:Description rdf:about="&a;105011384">
	<b:glossaryEntry>swearing to the truth of a statement; to lie under oath is to become subject to prosecution for perjury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105011573">
	<b:glossaryEntry>an oath taken by physicians to observe medical ethics deriving from Hippocrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105011715">
	<b:glossaryEntry>a solemn declaration that serves the same purpose as an oath (if an oath is objectionable to the person on religious or ethical grounds)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105011927">
	<b:glossaryEntry>affirmation of acceptance of some religion or faith; "a profession of Christianity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105012067">
	<b:glossaryEntry>the imparting of news or promises etc.; "he gave us the news and made a great show of the giving"; "giving his word of honor seemed to come too easily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105012271">
	<b:glossaryEntry>a written assurance that some product or service will be provided or will meet certain specifications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105012503"
	 b:glossaryEntry="a guarantee that an obligation will be met"/>
<rdf:Description rdf:about="&a;105012609">
	<b:glossaryEntry>a payment given as a guarantee that an obligation will be met</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105012724">
	<b:glossaryEntry>a written certificate that gives the holder the right to purchase shares of a stock for a specified price within a specified period of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105012923">
	<b:glossaryEntry>a pledge that something will happen or that something is true; "there is no guarantee that they are not lying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105013089">
	<b:glossaryEntry>a message expressing a favorable opinion; "words of approval seldom passed his lips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105013513"
	 b:glossaryEntry="official recognition or approval"/>
<rdf:Description rdf:about="&a;105013621"
	 b:glossaryEntry="formal and explicit approval"/>
<rdf:Description rdf:about="&a;105013809"
	 b:glossaryEntry='an endorsement; "they gave us the OK to go ahead"'/>
<rdf:Description rdf:about="&a;105013928">
	<b:glossaryEntry>an endorsement made in a passport that allows the bearer to enter the country issuing it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105014086">
	<b:glossaryEntry>the phrase used by the official censor of the Roman Catholic Church to say that a publication has been examined and contains nothing offensive to the Church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105014301">
	<b:glossaryEntry>approval; "give her recognition for trying"; "he was given credit for his work"; "it is to her credit that she tried"; "the credits were given at the end of the film"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105014588"
	 b:glossaryEntry="a recognition of meritorious service"/>
<rdf:Description rdf:about="&a;105014727">
	<b:glossaryEntry>enthusiastic recognition (especially one accompanied by loud applause)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105014889">
	<b:glossaryEntry>an act of honor or courteous recognition: "a musical salute to the composer on his birthday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105015047"
	 b:glossaryEntry="(law) tacit approval of someone''s wrongdoing"/>
<rdf:Description rdf:about="&a;105015182"
	 b:glossaryEntry='approval to do something; "he asked permission to leave"'/>
<rdf:Description rdf:about="&a;105015367"
	 b:glossaryEntry='permission to do something; "she was granted leave to speak"'/>
<rdf:Description rdf:about="&a;105015479">
	<b:glossaryEntry>a permit to enter or leave a military installation; "he had to show his pass in order to get out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105015642">
	<b:glossaryEntry>a document indicating permission to do something without restrictions; "the media representatives had special passes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105015881"
	 b:glossaryEntry="a pass that allows you to board a ship or plane"/>
<rdf:Description rdf:about="&a;105016004">
	<b:glossaryEntry>written permission from a teacher for a student to be out the classroom and in the halls of the school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105016162">
	<b:glossaryEntry>a permit formerly given to convicts allowing them to leave prison under specific restrictions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105016317">
	<b:glossaryEntry>any authorization to pass or go somewhere; "the pass to visit had a strict time limit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105016483">
	<b:glossaryEntry>a document or escort providing safe passage through a region especially in time of war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105016628"
	 b:glossaryEntry="permission to proceed because obstacles have been removed"/>
<rdf:Description rdf:about="&a;105016741"
	 b:glossaryEntry="the expression of approval and support"/>
<rdf:Description rdf:about="&a;105016983">
	<b:glossaryEntry>enthusiastic approval; "the book met with modest acclaim"; "he acknowledged the plaudits of the crowd"; "they gave him more eclat than he really deserved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105017234"
	 b:glossaryEntry="a demonstration of approval by clapping the hands together"/>
<rdf:Description rdf:about="&a;105017447">
	<b:glossaryEntry>a round of applause to signify approval; "give the little lady a great big hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105017578"
	 b:glossaryEntry="a clap of the hands to indicate approval"/>
<rdf:Description rdf:about="&a;105017673"
	 b:glossaryEntry='an outburst of applause; "there was a round of applause"'/>
<rdf:Description rdf:about="&a;105017781"
	 b:glossaryEntry="a cry or shout of approval"/>
<rdf:Description rdf:about="&a;105017913"
	 b:glossaryEntry="a Japanese cheer of enthusiasm or triumph"/>
<rdf:Description rdf:about="&a;105018007">
	<b:glossaryEntry>a cry of approval as from an audience at the end of great performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105018128"
	 b:glossaryEntry='a sudden outburst of cheers; "there was a salvo of approval"'/>
<rdf:Description rdf:about="&a;105018240">
	<b:glossaryEntry>an expression of approval and commendation; "he always appreciated praise for his work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105018478">
	<b:glossaryEntry>offering words of homage as an act of worship; "they sang a hymn of praise to God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105018631"
	 b:glossaryEntry="a shout or song of praise to God"/>
<rdf:Description rdf:about="&a;105018720">
	<b:glossaryEntry>an exaggerated expression (usually of praise); "the critics lavished superlatives on it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105018866"
	 b:glossaryEntry="a formal expression of praise"/>
<rdf:Description rdf:about="&a;105018986"
	 b:glossaryEntry="something that recommends (or expresses commendation)"/>
<rdf:Description rdf:about="&a;105019162">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a formal recommendation by a former employer to a potential future employer describing the person''s qualifications and dependability; "requests for character references are all to often answered evasively"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105019457"
	 b:glossaryEntry="exaggerated praise (as for promotional purposes)"/>
<rdf:Description rdf:about="&a;105019556"
	 b:glossaryEntry="a remark (or act) expressing praise and admiration"/>
<rdf:Description rdf:about="&a;105019717">
	<b:glossaryEntry>a compliment that I heard about you that I offer to trade for a compliment you have heard about me</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105019872"
	 b:glossaryEntry="excessive or insincere praise"/>
<rdf:Description rdf:about="&a;105019992"
	 b:glossaryEntry="flattery intended to persuade"/>
<rdf:Description rdf:about="&a;105020101"
	 b:glossaryEntry="flattery designed to gain favor"/>
<rdf:Description rdf:about="&a;105020221">
	<b:glossaryEntry>excessive but superficial compliments given with affected charm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105020360">
	<b:glossaryEntry>a tangible symbol signifying approval or distinction; "an award for bravery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105020724"
	 b:glossaryEntry="something given or done as an expression of esteem"/>
<rdf:Description rdf:about="&a;105020842">
	<b:glossaryEntry>an award conferred by a college or university signifying that the recipient has satisfactorily completed a course of study; "he earned his degree at Princeton summa cum laude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105021232">
	<b:glossaryEntry>a degree granted by a two-year college on successful completion of the undergraduates course of studies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105021464"
	 b:glossaryEntry="an associate degree in arts"/>
<rdf:Description rdf:about="&a;105021560"
	 b:glossaryEntry="an associate degree in applied science"/>
<rdf:Description rdf:about="&a;105021679"
	 b:glossaryEntry="an associate degree in nursing"/>
<rdf:Description rdf:about="&a;105021781">
	<b:glossaryEntry>an academic degree conferred on someone who has successfully completed undergraduate studies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105022169"
	 b:glossaryEntry="a bachelor''s degree in arts and sciences"/>
<rdf:Description rdf:about="&a;105022304"
	 b:glossaryEntry="a bachelor''s degree in library science"/>
<rdf:Description rdf:about="&a;105022431"
	 b:glossaryEntry="a bachelor''s degree in nursing"/>
<rdf:Description rdf:about="&a;105022541"
	 b:glossaryEntry="a bachelor''s degree in religion"/>
<rdf:Description rdf:about="&a;105022644"
	 b:glossaryEntry="a bachelor''s degree in literature"/>
<rdf:Description rdf:about="&a;105022754"
	 b:glossaryEntry="(a British degree) a bachelor''s degree in medicine"/>
<rdf:Description rdf:about="&a;105022876"
	 b:glossaryEntry="a bachelor''s degree in music"/>
<rdf:Description rdf:about="&a;105022975"
	 b:glossaryEntry="a bachelor''s degree in naval science"/>
<rdf:Description rdf:about="&a;105023089"
	 b:glossaryEntry="a bachelor''s degree in science"/>
<rdf:Description rdf:about="&a;105023195"
	 b:glossaryEntry="a bachelor''s degree in architecture"/>
<rdf:Description rdf:about="&a;105023321"
	 b:glossaryEntry="a bachelor''s degree in engineering"/>
<rdf:Description rdf:about="&a;105023436"
	 b:glossaryEntry="a bachelor''s degree in theology"/>
<rdf:Description rdf:about="&a;105023540"
	 b:glossaryEntry="(Great Britain) a university degree with honors"/>
<rdf:Description rdf:about="&a;105023676"
	 b:glossaryEntry="(Great Britain) an honours degree of the highest class"/>
<rdf:Description rdf:about="&a;105023829"
	 b:glossaryEntry="(Great Britain) a first-class honours degree in two subjects"/>
<rdf:Description rdf:about="&a;105023948">
	<b:glossaryEntry>an academic degree higher than a bachelor''s but lower than a doctor''s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105024331">
	<b:glossaryEntry>a degree granted for the successful completion of advanced study of architecture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105024488"
	 b:glossaryEntry="a master''s degree in arts and sciences"/>
<rdf:Description rdf:about="&a;105024615"
	 b:glossaryEntry="a master''s degree in library science"/>
<rdf:Description rdf:about="&a;105024738"
	 b:glossaryEntry="a master''s degree in teaching"/>
<rdf:Description rdf:about="&a;105024846"
	 b:glossaryEntry="a master''s degree in business"/>
<rdf:Description rdf:about="&a;105024946"
	 b:glossaryEntry="a master''s degree in religion"/>
<rdf:Description rdf:about="&a;105025047"
	 b:glossaryEntry="a master''s degree in education"/>
<rdf:Description rdf:about="&a;105025149"
	 b:glossaryEntry="a master''s degree in fine arts"/>
<rdf:Description rdf:about="&a;105025251"
	 b:glossaryEntry="a master''s degree in literature"/>
<rdf:Description rdf:about="&a;105025357"
	 b:glossaryEntry="a ,aster''s degree in library science"/>
<rdf:Description rdf:about="&a;105025471"
	 b:glossaryEntry="a master''s degree in questions of public concern"/>
<rdf:Description rdf:about="&a;105025590"
	 b:glossaryEntry="a master''s degree in science"/>
<rdf:Description rdf:about="&a;105025692"
	 b:glossaryEntry="a master''s degree in engineering"/>
<rdf:Description rdf:about="&a;105025803"
	 b:glossaryEntry="a master''s degree in theology"/>
<rdf:Description rdf:about="&a;105025903">
	<b:glossaryEntry>one of the highest academic degrees conferred by a university</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105026254"
	 b:glossaryEntry="a doctor''s degree in dental medicine"/>
<rdf:Description rdf:about="&a;105026368"
	 b:glossaryEntry="a doctor''s degree in dental surgery"/>
<rdf:Description rdf:about="&a;105026480"
	 b:glossaryEntry="a doctor''s degree in religion"/>
<rdf:Description rdf:about="&a;105026579"
	 b:glossaryEntry="a doctor''s degree in education"/>
<rdf:Description rdf:about="&a;105026687"
	 b:glossaryEntry="a doctor''s degree in medicine"/>
<rdf:Description rdf:about="&a;105026786"
	 b:glossaryEntry="a doctor''s degree in music"/>
<rdf:Description rdf:about="&a;105026888"
	 b:glossaryEntry="a doctor''s degree in musical arts"/>
<rdf:Description rdf:about="&a;105026998"
	 b:glossaryEntry="a doctor''s degree in optometry"/>
<rdf:Description rdf:about="&a;105027099"
	 b:glossaryEntry="doctor''s degree in osteopathy"/>
<rdf:Description rdf:about="&a;105027201"
	 b:glossaryEntry="a doctorate awarded for original contributions to knowledge"/>
<rdf:Description rdf:about="&a;105027363">
	<b:glossaryEntry>an American doctorate usually based on at least 3 years graduate study and a dissertation; the highest degree awarded by a graduate school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105027551"
	 b:glossaryEntry="a British doctorate"/>
<rdf:Description rdf:about="&a;105027622"
	 b:glossaryEntry="a doctor''s degree in preventive medicine"/>
<rdf:Description rdf:about="&a;105027738"
	 b:glossaryEntry="a doctor''s degree in theology"/>
<rdf:Description rdf:about="&a;105027838">
	<b:glossaryEntry>degree conferred on someone who successfully completes law school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105027996"
	 b:glossaryEntry="a three-year law degree"/>
<rdf:Description rdf:about="&a;105028088"
	 b:glossaryEntry="an advanced law degree"/>
<rdf:Description rdf:about="&a;105028177"
	 b:glossaryEntry="a degree conferred to honor the recipient"/>
<rdf:Description rdf:about="&a;105028388"
	 b:glossaryEntry="an honorary arts degree"/>
<rdf:Description rdf:about="&a;105028480"
	 b:glossaryEntry="an honorary degree in fine arts"/>
<rdf:Description rdf:about="&a;105028577"
	 b:glossaryEntry="an honorary degree in letters"/>
<rdf:Description rdf:about="&a;105028677"
	 b:glossaryEntry="an honorary degree in the humanities"/>
<rdf:Description rdf:about="&a;105028780"
	 b:glossaryEntry="an honorary law degree"/>
<rdf:Description rdf:about="&a;105028869"
	 b:glossaryEntry="an honorary degree in science"/>
<rdf:Description rdf:about="&a;105028973"
	 b:glossaryEntry="the award given to the champion"/>
<rdf:Description rdf:about="&a;105029066"
	 b:glossaryEntry="an indication of approved or superior status"/>
<rdf:Description rdf:about="&a;105029189">
	<b:glossaryEntry>an official award (as for bravery or service) usually given as formal public statement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105029345">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an official recognition of merit; "although he didn''t win the prize he did get special mention"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105029514">
	<b:glossaryEntry>an award earned by participation in a school sport; "he won letters in three sports"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105029668"
	 b:glossaryEntry="an award for winning a championship"/>
<rdf:Description rdf:about="&a;105030064">
	<b:glossaryEntry>the highest U.S. military decoration awarded for bravery and valor in action `above and beyond the call of duty''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105030268">
	<b:glossaryEntry>a US military decoration for meritorious service in wartime duty of great responsibility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105030430">
	<b:glossaryEntry>a US Army decoration for extraordinary heroism against an armed enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105030573">
	<b:glossaryEntry>a US Navy decoration for extraordinary heroism against an armed enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105030699">
	<b:glossaryEntry>a US Airforce decoration for heroism while participating in an aerial flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105030848">
	<b:glossaryEntry>a US Airforce decoration for meritorious achievement while participating in an aerial flight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105030996"
	 b:glossaryEntry="a US military decoration for gallantry in action"/>
<rdf:Description rdf:about="&a;105031122">
	<b:glossaryEntry>a US military decoration awarded for meritorious service (except in aerial flight)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105031282">
	<b:glossaryEntry>a US military decoration awarded to any member of the armed forces who is wounded in action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105031460"
	 b:glossaryEntry="a British military decoration for gallantry"/>
<rdf:Description rdf:about="&a;105031564">
	<b:glossaryEntry>a British military decoration for distinguished conduct in the field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105031706"
	 b:glossaryEntry="a British military decoration for special service in action"/>
<rdf:Description rdf:about="&a;105031839"
	 b:glossaryEntry="a French military decoration for gallantry"/>
<rdf:Description rdf:about="&a;105031943"
	 b:glossaryEntry="a French military decoration"/>
<rdf:Description rdf:about="&a;105032036"
	 b:glossaryEntry="an award for success in war or hunting"/>
<rdf:Description rdf:about="&a;105032127"
	 b:glossaryEntry="the expression of disapproval"/>
<rdf:Description rdf:about="&a;105032286">
	<b:glossaryEntry>an expression of strong disapproval; pronouncing as wrong or morally culpable; "his uncompromising condemnation of racism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105032520"
	 b:glossaryEntry="harsh criticism or disapproval"/>
<rdf:Description rdf:about="&a;105032638">
	<b:glossaryEntry>an ecclesiastical censure by the Roman Catholic Church withdrawing certain sacraments and Christian burial from a person or all persons in a particular district</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105032854">
	<b:glossaryEntry>disapproval expressed by pointing out faults or shortcomings; "the senator received severe criticism from his opponent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105033196"
	 b:glossaryEntry="blunt criticism"/>
<rdf:Description rdf:about="&a;105033266"
	 b:glossaryEntry="persistent petty and unjustified criticism"/>
<rdf:Description rdf:about="&a;105033377">
	<b:glossaryEntry>intense adverse criticism; "Clinton directed his fire at Jesse Helms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105033521">
	<b:glossaryEntry>verbal criticism; "he enlivened his editorials with barbed thrusts at politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105033656">
	<b:glossaryEntry>criticism aimed at an easy target and made without careful consideration; "reporters took potshots at the mayor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105033822">
	<b:glossaryEntry>a vigorous and unrestrained response; "her tirade provoked a counterblast from her husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105033972">
	<b:glossaryEntry>an expression of criticism and censure; "he had to take the rebuke with a smile on his face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105034327"
	 b:glossaryEntry='a moralistic rebuke; "your preaching is wasted on him"'/>
<rdf:Description rdf:about="&a;105034446">
	<b:glossaryEntry>a severely critical attack; "the reviewers gave his book a sound slating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105034573"
	 b:glossaryEntry="severe criticism"/>
<rdf:Description rdf:about="&a;105034645"
	 b:glossaryEntry="rebuking a person harshly"/>
<rdf:Description rdf:about="&a;105034767"
	 b:glossaryEntry="a strong reprimand"/>
<rdf:Description rdf:about="&a;105034840"
	 b:glossaryEntry="British slang for a scolding"/>
<rdf:Description rdf:about="&a;105034928"
	 b:glossaryEntry="a severe scolding"/>
<rdf:Description rdf:about="&a;105035082">
	<b:glossaryEntry>a severe rebuke; "he deserved the berating that the coach gave him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105035217"
	 b:glossaryEntry='a mild rebuke or criticism; "words of reproach"'/>
<rdf:Description rdf:about="&a;105035355"
	 b:glossaryEntry="the act of blaming yourself"/>
<rdf:Description rdf:about="&a;105035457">
	<b:glossaryEntry>a reproach for some lapse or misdeed; "he took the blame for it"; "it was a bum rap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105035599">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a lengthy rebuke; "a good lecture was my father''s idea of discipline"; "the teacher gave him a talking to"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105035817"
	 b:glossaryEntry="a private lecture to a husband by his wife"/>
<rdf:Description rdf:about="&a;105035921"
	 b:glossaryEntry="a rebuke for making a mistake"/>
<rdf:Description rdf:about="&a;105036035"
	 b:glossaryEntry="a firm rebuke"/>
<rdf:Description rdf:about="&a;105036131">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often used with `pay'') a formal expression of esteem; "he paid his respects to the mayor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105036276"
	 b:glossaryEntry="a courteous or respectful or considerate remark"/>
<rdf:Description rdf:about="&a;105036378"
	 b:glossaryEntry="an expression of lack of respect"/>
<rdf:Description rdf:about="&a;105036589">
	<b:glossaryEntry>a rude expression intended to offend or hurt; "when a student made a stupid mistake he spared them no abuse"; "they yelled insults at the visiting team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105036881">
	<b:glossaryEntry>a remark capable of wounding mentally; "the unkindest cut of all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105037006"
	 b:glossaryEntry="exposing someone to laughter"/>
<rdf:Description rdf:about="&a;105037154"
	 b:glossaryEntry="open disrespect for a person or thing"/>
<rdf:Description rdf:about="&a;105037290"
	 b:glossaryEntry="showing your contempt by derision"/>
<rdf:Description rdf:about="&a;105037413">
	<b:glossaryEntry>a facial expression of contempt or scorn; the upper lip curls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105037544"
	 b:glossaryEntry="a contemptuous or scornful remark"/>
<rdf:Description rdf:about="&a;105037640"
	 b:glossaryEntry="(informal) a crushing remark"/>
<rdf:Description rdf:about="&a;105037744">
	<b:glossaryEntry>derision of someone or something as foolish or absurd or inconsistent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105037886"
	 b:glossaryEntry="a communication that belittles somebody or something"/>
<rdf:Description rdf:about="&a;105038134"
	 b:glossaryEntry="a belittling comment"/>
<rdf:Description rdf:about="&a;105038225"
	 b:glossaryEntry="a disparaging remark"/>
<rdf:Description rdf:about="&a;105038308"
	 b:glossaryEntry="a petty disparagement"/>
<rdf:Description rdf:about="&a;105038404"
	 b:glossaryEntry="disparagement of something that is unattainable"/>
<rdf:Description rdf:about="&a;105038509">
	<b:glossaryEntry>a communication that indicates lack of respect by patronizing the recipient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105038666"
	 b:glossaryEntry="a malicious attack"/>
<rdf:Description rdf:about="&a;105038897"
	 b:glossaryEntry="an attack intended to ruin someone''s reputation"/>
<rdf:Description rdf:about="&a;105039030"
	 b:glossaryEntry="slanderous remarks or charges"/>
<rdf:Description rdf:about="&a;105039109"
	 b:glossaryEntry="slanderous defamation"/>
<rdf:Description rdf:about="&a;105039210">
	<b:glossaryEntry>a tort consisting of false and malicious publication printed for the purpose of defaming a living person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105039384"
	 b:glossaryEntry="words falsely spoken that damage the reputation of another"/>
<rdf:Description rdf:about="&a;105039532"
	 b:glossaryEntry="verbal abuse; a crude substitute for argument"/>
<rdf:Description rdf:about="&a;105039644">
	<b:glossaryEntry>a defamatory or abusive word or phrase; "sticks and stones may break my bones but names can never hurt me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105039829">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an epithet that can be used to smear someone''s reputation; "he used the smear word `communist'' for everyone who disagreed with him"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105040017"
	 b:glossaryEntry="foul-mouthed or obscene abuse"/>
<rdf:Description rdf:about="&a;105040118"
	 b:glossaryEntry="the expression of bitter deep-seated ill will; rancor"/>
<rdf:Description rdf:about="&a;105040252"
	 b:glossaryEntry="an impudent statement"/>
<rdf:Description rdf:about="&a;105040370">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an impudent or insolent rejoinder; "don''t give me any of your sass"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105040541">
	<b:glossaryEntry>a message that is stated or declared; a communication (oral or written) setting forth particulars or facts etc; "according to his statement he was in London on that day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105041342">
	<b:glossaryEntry>a nonverbal message; "a Cadillac makes a statement about who you are"; "his tantrums are a statement of his need for attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105041525">
	<b:glossaryEntry>a statement that is added to or revises or improves a proposal or document (a bill or constitution etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105041775">
	<b:glossaryEntry>a statement regarded as an object; "to say the same thing in other terms" or "how can you say such a thing?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105041935">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a true statement; "he told the truth"; "he thought of answering with the truth but he knew they wouldn''t believe it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105042192"
	 b:glossaryEntry='an unquestionable truth; "his word was gospel"'/>
<rdf:Description rdf:about="&a;105042306"
	 b:glossaryEntry='(in logic) a self-contradiction; "I always lie"'/>
<rdf:Description rdf:about="&a;105042407"
	 b:glossaryEntry="a statement that represents something in words"/>
<rdf:Description rdf:about="&a;105042568">
	<b:glossaryEntry>a detailed description of design criteria for a piece of work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105042732">
	<b:glossaryEntry>the art of assembling logical elements into a computing device; the specification of the relation between parts of a computer system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105042932">
	<b:glossaryEntry>specification of design principles (including data formats and procedures) for creating a network configuration of data processors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105043129"
	 b:glossaryEntry="emphatic or explicit statement"/>
<rdf:Description rdf:about="&a;105043361">
	<b:glossaryEntry>a formal public statement; "the government made an announcement about changes in the drug war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105043559">
	<b:glossaryEntry>a public declaration of intentions (as issued by a political party or government)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105043713"
	 b:glossaryEntry="an authoritative declaration"/>
<rdf:Description rdf:about="&a;105043837">
	<b:glossaryEntry>a statement of fundamental rights and privileges (especially the first ten amendments to the US Constitution)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105044064">
	<b:glossaryEntry>an amendment to the Constitution of the United States guaranteeing the right of free expression; includes freedom of assembly and freedom of the press and freedom of religion and freedom of speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105044341">
	<b:glossaryEntry>an amendment to the Constitution of the United States that imposes restrictions on the government''s prosecution of persons accused of crimes; mandates due process of law and prohibits self-incrimination and double jeopardy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105044644">
	<b:glossaryEntry>an amendment to the Constitution of the United States adopted in 1868; extends the guarantees of the Bill of Rights to the states as well as to the federal government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105044896">
	<b:glossaryEntry>an amendment to the Constitution of the United States adopted in 1920; prohibited the manufacture and sale of alcoholic beverages; repealed in 1932</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105045129">
	<b:glossaryEntry>an amendment to the Constitution of the United State adopted in 1920; guarantees that no state can deny the right to vote on the basis of sex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105045355">
	<b:glossaryEntry>a declaration that is made as if no supporting evidence were necessary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105045651">
	<b:glossaryEntry>an assertion of a right (as to money or property); "his claim asked for damages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105045783">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an assertion that something is true or factual; "his claim that he was innocent"; "evidence contradicted the government''s claims"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105045982">
	<b:glossaryEntry>an assertion that someone is guilty of a fault or offence; "the newspaper published charges that Jones was guilty of drunken driving"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105046181"
	 b:glossaryEntry="statements affirming or denying certain matters of fact"/>
<rdf:Description rdf:about="&a;105046324"
	 b:glossaryEntry="a point asserted as part of an argument"/>
<rdf:Description rdf:about="&a;105046420"
	 b:glossaryEntry="an unsupported assertion"/>
<rdf:Description rdf:about="&a;105046501"
	 b:glossaryEntry="a group of symbols that make a mathematical statement"/>
<rdf:Description rdf:about="&a;105046657">
	<b:glossaryEntry>a conventionalized statement expressing some fundamental principle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105046777"
	 b:glossaryEntry="a statement of a mathematical relation"/>
<rdf:Description rdf:about="&a;105046939">
	<b:glossaryEntry>a statement asserting the existence or the truth of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105047103">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an assertion offering firsthand authentication of a fact; "according to his own testimony he can''t do it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105047264">
	<b:glossaryEntry>an open avowal (true or false) of some belief or opinion; "a profession of disagreement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105047422"
	 b:glossaryEntry="a strong declaration of protest"/>
<rdf:Description rdf:about="&a;105047512">
	<b:glossaryEntry>a declaration of something self-evident; something that can be assumed as the basis for argument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105047680">
	<b:glossaryEntry>declaration of an intention or a determination to inflict harm on another; "his threat to kill me was quite explicit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105047886"
	 b:glossaryEntry="a threat of divine punishment or vengeance"/>
<rdf:Description rdf:about="&a;105047986">
	<b:glossaryEntry>a threat or the act of threatening; "he spoke with desperate menace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105048107">
	<b:glossaryEntry>(law) all the means by which any alleged matter of fact whose truth is investigated at judicial trial is established or disproved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105048417">
	<b:glossaryEntry>an object or statement produced before a court of law and referred to while giving evidence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105048562"
	 b:glossaryEntry="a solemn statement made under oath"/>
<rdf:Description rdf:about="&a;105048706"
	 b:glossaryEntry="testimony by word or deed to your religious faith"/>
<rdf:Description rdf:about="&a;105048809">
	<b:glossaryEntry>the body of evidence that constitute the offence; the objective proof that a crime has been committed (sometimes mistakenly thought to refer to the body of a homicide victim)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105049044">
	<b:glossaryEntry>evidence (usually the testimony of a witness) directly related to the fact in dispute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105049209">
	<b:glossaryEntry>evidence providing only a basis for inference about the fact in dispute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105049388">
	<b:glossaryEntry>evidence based on what someone has told the witness and not of direct knowledge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105049531"
	 b:glossaryEntry="evidence for the prosecution in criminal proceedings"/>
<rdf:Description rdf:about="&a;105049646"
	 b:glossaryEntry="unsworn statement in a legal transaction"/>
<rdf:Description rdf:about="&a;105049744"
	 b:glossaryEntry="written declaration made under oath"/>
<rdf:Description rdf:about="&a;105049880">
	<b:glossaryEntry>(bridge) the number of tricks a bridge player is willing to contract to make</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105050089">
	<b:glossaryEntry>(bridge) the highest bid becomes the contract setting the number of tricks that the bidder must make</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105050263"
	 b:glossaryEntry="(bridge) a bid that asks your partner to bid another suit"/>
<rdf:Description rdf:about="&a;105050374">
	<b:glossaryEntry>(bridge) a bid that is higher than your opponent''s bid (especially when your partner has not bid at all and your bid exceeds the value of your hand)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105050587">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a brief statement; "he didn''t say a word about it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105050688">
	<b:glossaryEntry>a statement that explains; "he launched into a detailed explanation"; "he demanded that I give an account for my failure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105051021">
	<b:glossaryEntry>a convincing explanation that reveals basic causes; "he was unable to give a clear accounting for his actions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105051188"
	 b:glossaryEntry="a statement of the desirability of something"/>
<rdf:Description rdf:about="&a;105051294">
	<b:glossaryEntry>a statement of facts and reasons made in appealing or protesting; "certain representations were made concerning police brutality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105051484">
	<b:glossaryEntry>an explanation of the cause of some phenomenon; "the reason a steady state was never reached was that the back pressure built up too slowly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105051677"
	 b:glossaryEntry="a statement in explanation of some action or belief"/>
<rdf:Description rdf:about="&a;105051824">
	<b:glossaryEntry>a justification for something existing or happening; "he had no cause to complain"; "they had good reason to rejoice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105052012">
	<b:glossaryEntry>the justification for some act or belief; "he offered a persuasive defense of the theory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105052233">
	<b:glossaryEntry>a formal written defense of something you believe in strongly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105052359">
	<b:glossaryEntry>(law) a defense by an accused person purporting to show that he or she could not have committed the crime in question</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105052528">
	<b:glossaryEntry>a defense of some offensive behavior or some failure to keep a promise etc.; "he kept finding excuses to stay"; "every day he had a new alibi for not getting a job"; "his transparent self-justification was unacceptable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105052829"
	 b:glossaryEntry="an interpretation of the meaning of something"/>
<rdf:Description rdf:about="&a;105052974">
	<b:glossaryEntry>the exposition (often superficially) of a particular philosophy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105053116">
	<b:glossaryEntry>the exposition (often superficially) of a particular moral code</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105053236"
	 b:glossaryEntry="an explanation of the meaning of something"/>
<rdf:Description rdf:about="&a;105053336">
	<b:glossaryEntry>a statement that solves a problem or explains how to solve the problem; "they were trying to find a peaceful solution"; "the answers were in the back of the book"; "he computed the result to four decimal places"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105053651">
	<b:glossaryEntry>the final resolution of the main complication of a literary or dramatic work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105053784"
	 b:glossaryEntry="an explanation or definition of an obscure word in a text"/>
<rdf:Description rdf:about="&a;105053902">
	<b:glossaryEntry>(historical linguistics) an explanation of the historical origins of a word or phrase</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105054071">
	<b:glossaryEntry>a concise explanation of the meaning of a word or phrase or symbol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105054320">
	<b:glossaryEntry>a definition in which the term is used by embedding it in a larger expression containing its explanation; for example, "legal duty" might be defined contextually: "X has a legal duty to do Y means that X is required to do Y by a contract relationship that would be upheld in a court of law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105054678">
	<b:glossaryEntry>a definition that reports the standard uses of a word or phrase or symbol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105054819">
	<b:glossaryEntry>a definition that gives an exact equivalent of the term defined</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105054948">
	<b:glossaryEntry>a definition that points out or exhibits instances of the term defined</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105055085">
	<b:glossaryEntry>(mathematics) a definition of a function from which values of the function can be calculated in a finite number of steps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105055272"
	 b:glossaryEntry="a new definition"/>
<rdf:Description rdf:about="&a;105055347">
	<b:glossaryEntry>a definition that is stipulated by someone and that is not a standard usage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105055491">
	<b:glossaryEntry>a statement (either spoken or written) that is made in reply to a question or request or criticism or accusation; "I waited several days for his answer"; "he wrote replies to several of his critics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105055797">
	<b:glossaryEntry>a reply by a Pope to an inquiry concerning a point of law or morality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105055921"
	 b:glossaryEntry="response to an inquiry or experiment"/>
<rdf:Description rdf:about="&a;105056012">
	<b:glossaryEntry>a statement about something that is happening or going to happen; "the announcement appeared in the local newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105056313">
	<b:glossaryEntry>(in Christian religions) the announcement to the Virgin Mary by the angel Gabriel of the incarnation of Christ</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105056482"
	 b:glossaryEntry="a public announcement (in church) of a proposed marriage"/>
<rdf:Description rdf:about="&a;105056590">
	<b:glossaryEntry>an announcement distributed to members of the press in order to supplement or replace an oral presentation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105056776">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an announcement containing information about a future event; "you didn''t give me enough notice"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105056942">
	<b:glossaryEntry>(law) a formal notice filed with a court or officer to suspend a proceeding until filer is given a hearing: "a caveat filed against the probate of a will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105057149">
	<b:glossaryEntry>a notice of someone''s death; usually includes a short biography</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105057286">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an announcement of the events that will occur as part of a theatrical or sporting event; "you can''t tell the players without a program"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105057523"
	 b:glossaryEntry="a list of particulars (as a playbill or bill of fare)"/>
<rdf:Description rdf:about="&a;105057663">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a theatrical program; "he couldn''t find her name on the playbill"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105057801">
	<b:glossaryEntry>a program for a race meeting; lists the races and the names of the horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105057929"
	 b:glossaryEntry="a statement about the future"/>
<rdf:Description rdf:about="&a;105058114"
	 b:glossaryEntry="a prediction uttered under divine inspiration"/>
<rdf:Description rdf:about="&a;105058245">
	<b:glossaryEntry>a prophecy (usually obscure or allegorical) revealed by a priest or priestess; believed to be infallible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105058402"
	 b:glossaryEntry="predicting what the weather will be"/>
<rdf:Description rdf:about="&a;105058536">
	<b:glossaryEntry>a prediction about how something (as the weather) will develop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105058665">
	<b:glossaryEntry>a prediction of someone''s future based on the relative positions of the planets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105058800">
	<b:glossaryEntry>(logic) a statement that affirms or denies something and is either true or false</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105059065">
	<b:glossaryEntry>two propositions are contradictories if both cannot be true (or both cannot be false) at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105059227">
	<b:glossaryEntry>two propositions are contraries if both cannot be true but both can be false</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105059358"
	 b:glossaryEntry="(logic) a proposition obtained by conversion"/>
<rdf:Description rdf:about="&a;105059457">
	<b:glossaryEntry>a subsidiary proposition that is assumed to be true in order to prove another proposition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105059598">
	<b:glossaryEntry>one of the substantive phrases in a logical proposition; "the major term of a syllogism must occur twice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105059863"
	 b:glossaryEntry="a proposition deducible from basic postulates"/>
<rdf:Description rdf:about="&a;105059980">
	<b:glossaryEntry>the proposition that must follow from the major and minor premises of a syllogism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105060175">
	<b:glossaryEntry>in logic: a proposition that is accepted as true in order to provide a basis for logical reasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105060347">
	<b:glossaryEntry>in logic: a proposition that is not susceptible of proof or disproof; its truth is assumed to be self-evident</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105060508">
	<b:glossaryEntry>a statement that is assumed to be true and from which a conclusion can be drawn; "on the assumption that he has been injured we can infer that he will not to play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105060820">
	<b:glossaryEntry>the premise of a syllogism that contains the major term (which is the predicate of the conclusion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105061051">
	<b:glossaryEntry>the premise of a syllogism that contains the minor term (which is the subject of the conclusion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105061280">
	<b:glossaryEntry>the term in a syllogism that is the predicate of the conclusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105061438">
	<b:glossaryEntry>the term in a syllogism that is the subject of the conclusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105061594">
	<b:glossaryEntry>the term in a syllogism that is common to both premises and excluded from the conclusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105061778">
	<b:glossaryEntry>an argument that appears good at first view but is really fallacious</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105061964"
	 b:glossaryEntry="an argument that assumes that which is to be proved"/>
<rdf:Description rdf:about="&a;105062076">
	<b:glossaryEntry>an unproved statement put forward as a premise in an argument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105062190">
	<b:glossaryEntry>an assumption on which rests the validity or effect of something else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105062380">
	<b:glossaryEntry>(math) a condition specified for the solution to a set of differential equations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105062525">
	<b:glossaryEntry>a stipulated condition; "he accepted subject to one provision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105062653"
	 b:glossaryEntry="a false statement"/>
<rdf:Description rdf:about="&a;105062872">
	<b:glossaryEntry>a statement that evades the question by cleverness or trickery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105063005"
	 b:glossaryEntry="a statement that deviates from or perverts the truth"/>
<rdf:Description rdf:about="&a;105063177">
	<b:glossaryEntry>a trivial lie; "he told a fib about eating his spinach"; "how can I stop my child from telling stories?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105063391">
	<b:glossaryEntry>an interesting but highly implausible story; often told as an excuse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105063568">
	<b:glossaryEntry>a false boast that can harm others; especially a false claim to be married to someone (formerly actionable at law)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105063740"
	 b:glossaryEntry="a gross untruth"/>
<rdf:Description rdf:about="&a;105063809"
	 b:glossaryEntry="a deliberately false or improbable account"/>
<rdf:Description rdf:about="&a;105063945"
	 b:glossaryEntry="a deliberately misleading fabrication"/>
<rdf:Description rdf:about="&a;105064035"
	 b:glossaryEntry="a misleading falsehood"/>
<rdf:Description rdf:about="&a;105064304"
	 b:glossaryEntry="a partially true statement intended to deceive or mislead"/>
<rdf:Description rdf:about="&a;105064418">
	<b:glossaryEntry>a showy misrepresentation intended to conceal something unpleasant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105064555"
	 b:glossaryEntry="making to seem more important than it really is"/>
<rdf:Description rdf:about="&a;105064711">
	<b:glossaryEntry>a statement that is restrained in ironic contrast to what might have been said</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105064886">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an understatement that expresses an affirmative thought negatively; "printing wasn''t a bad idea"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105065035"
	 b:glossaryEntry="a long and elaborate misrepresentation"/>
<rdf:Description rdf:about="&a;105065128"
	 b:glossaryEntry="pretending with intention to deceive"/>
<rdf:Description rdf:about="&a;105065298">
	<b:glossaryEntry>pretense that your position is stronger than it really is; "his bluff succeeded in getting him accepted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105065454">
	<b:glossaryEntry>something serving to conceal plans; a fictitious reason that is concocted in order to conceal the real reason</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105065634">
	<b:glossaryEntry>an expression of agreement that is not supported by real conviction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105065771">
	<b:glossaryEntry xml:space='preserve'><![CDATA[something intended to misrepresent the true nature of an activity; "he wasn''t sick--it was just a subterfuge"; "the holding company was just a blind"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105065985">
	<b:glossaryEntry>verbal misrepresentation intended to take advantage of you in some way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105066196"
	 b:glossaryEntry="a fraudulent or duplicitous representation"/>
<rdf:Description rdf:about="&a;105066308">
	<b:glossaryEntry>a statement that is not literally false but that cleverly avoids an unpleasant truth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105066533"
	 b:glossaryEntry="an indirect way of expressing something"/>
<rdf:Description rdf:about="&a;105066655">
	<b:glossaryEntry>any language that pretends to communicate but actually does not</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105066776"
	 b:glossaryEntry="an intentionally noncommittal or ambiguous statement"/>
<rdf:Description rdf:about="&a;105066890">
	<b:glossaryEntry>an evasion of the point of an argument by raising irrelevant distinctions or objections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105067031">
	<b:glossaryEntry>an equivocal qualification; a word used to avoid making an outright assertion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105067166">
	<b:glossaryEntry>a statement that limits or restricts some claim; "he recommended her without any reservations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105067352"
	 b:glossaryEntry="a statement made with careful qualifications"/>
<rdf:Description rdf:about="&a;105067461">
	<b:glossaryEntry>a written explanation or criticism or illustration that is added to a book or other textual material; "he wrote an extended comment on the proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105067694">
	<b:glossaryEntry>a comment (usually added to a text); "his notes were appended at the end of the article"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105067911"
	 b:glossaryEntry="a note placed below the text on a printed page"/>
<rdf:Description rdf:about="&a;105068012">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a short note acknowledging a source of information or quoting a passage; "the student''s essay failed to list several important citations"; "the article includes mention of similar clinical cases"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105068341"
	 b:glossaryEntry="a note acknowledging the source of a published photograph"/>
<rdf:Description rdf:about="&a;105068457">
	<b:glossaryEntry>a reference at one place in a work to information at another place in the same work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105068616">
	<b:glossaryEntry>a statement that expresses a personal opinion or belief; "from time to time she contributed a personal comment on his account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105068949">
	<b:glossaryEntry>an opening remark intended to secure an advantage for the speaker</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105069074">
	<b:glossaryEntry>an opinion voiced by a judge on a point of law not directly bearing on the case in question and therefore not binding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105069260"
	 b:glossaryEntry="an incidental remark"/>
<rdf:Description rdf:about="&a;105069358">
	<b:glossaryEntry>a remark that calls attention to something or someone; "she made frequent mention of her promotion"; "there was no mention of it"; "the speaker made several references to his wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105069640"
	 b:glossaryEntry="passing reference or indirect mention"/>
<rdf:Description rdf:about="&a;105069732">
	<b:glossaryEntry>the practice of casually mentioning important people in order to impress your listener</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105069878"
	 b:glossaryEntry="a remark expressing careful consideration"/>
<rdf:Description rdf:about="&a;105070038">
	<b:glossaryEntry>C. Northcote Parkinson''s cynical observation that the number of subordinates in an organization will increase linearly regardless of the amount of work to be done</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105070262">
	<b:glossaryEntry>C. Northcote Parkinson''s cynical observation that work will expand so as to fill the time available for its completion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105070442"
	 b:glossaryEntry="witty remark"/>
<rdf:Description rdf:about="&a;105070533">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an aggressive remark directed at a person like a missile and intended to have a telling effect; "his parting shot was `drop dead''"; "she threw shafts of sarcasm"; "she takes a dig at me every chance she gets"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105070834">
	<b:glossaryEntry>a statement that is formulated as a question but that is not supposed to be answered; "he liked to make his points with rhetorical questions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105071041"
	 b:glossaryEntry="a statement that contains a mistake"/>
<rdf:Description rdf:about="&a;105071189"
	 b:glossaryEntry="a revised statement"/>
<rdf:Description rdf:about="&a;105071302">
	<b:glossaryEntry>the restatement of a message (as a religious one) in rational terms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105071453"
	 b:glossaryEntry="the restatement of a message as a myth"/>
<rdf:Description rdf:about="&a;105071571">
	<b:glossaryEntry>part of a statement that is not correct; "the book was full of errors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105071739"
	 b:glossaryEntry="a printer''s error; to be corrected"/>
<rdf:Description rdf:about="&a;105071831">
	<b:glossaryEntry>a mistake in printed matter resulting from mechanical failures of some kind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105072026">
	<b:glossaryEntry>the unintentional misuse of a word by confusion with one that sounds similar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105072171"
	 b:glossaryEntry="an accidental and usually trivial mistake in speaking"/>
<rdf:Description rdf:about="&a;105072307"
	 b:glossaryEntry="transposition of initial consonants in a pair of words"/>
<rdf:Description rdf:about="&a;105072418">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the statement (oral or written) of an exchange of promises; "they had an agreement that they would not interfere in each other''s business"; "there was an understanding between management and the workers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105072928">
	<b:glossaryEntry>(usually plural) a statement of what is required as part of an agreement; "the contract set out the conditons of the lease"; "the terms of the treaty were generous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105073174">
	<b:glossaryEntry>an agreement between parties (usually arrived at after discussion) fixing obligations of each; "he made a bargain with the devil"; "he rose to prominence through a series of shady deals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105073421"
	 b:glossaryEntry="an informal agreement to work together"/>
<rdf:Description rdf:about="&a;105073523"
	 b:glossaryEntry="a personal agreement based on honor and not legally binding"/>
<rdf:Description rdf:about="&a;105073650"
	 b:glossaryEntry="a legal document summarizing the agreement between parties"/>
<rdf:Description rdf:about="&a;105073898">
	<b:glossaryEntry>a signed written agreement between two or more parties (nations) to perform some action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105074062"
	 b:glossaryEntry="a friendly understanding between political powers"/>
<rdf:Description rdf:about="&a;105074184">
	<b:glossaryEntry>an agreement that is not in writing and is not signed by the parties but is a real existing contract that lacks only the formal requirement of a memorandum to render it enforceable in litigation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105074438">
	<b:glossaryEntry>a contract binding one party into the service of another for a specified term</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105074571">
	<b:glossaryEntry>formal agreement between the issuer of bonds and the bondholders as to terms of the debt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105074715">
	<b:glossaryEntry>a legal agreement specifying a payment or action and the penalty for failure to comply</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105074858"
	 b:glossaryEntry="a written agreement between two states or sovereigns"/>
<rdf:Description rdf:about="&a;105075069">
	<b:glossaryEntry>a formal agreement establishing an association or alliance between nations or other groups to achieve a particular aim</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105075242"
	 b:glossaryEntry='a treaty to cease hostilities; "peace came on November 11th"'/>
<rdf:Description rdf:about="&a;105075369"
	 b:glossaryEntry="(diplomacy) an international agreement"/>
<rdf:Description rdf:about="&a;105075482"
	 b:glossaryEntry="an agreement concerning the treatment of war prisoners"/>
<rdf:Description rdf:about="&a;105075600">
	<b:glossaryEntry>the first treaty between the US and USSR resulting from the Strategic Arms Limitation Talks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105075744">
	<b:glossaryEntry>the second treaty between the US and USSR resulting from the Strategic Arms Limitation Talks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105075890">
	<b:glossaryEntry>a message whose ingenuity or verbal skill or incongruity has the power to evoke laughter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105076231"
	 b:glossaryEntry="a witty comment or writing"/>
<rdf:Description rdf:about="&a;105076316"
	 b:glossaryEntry="a clever remark"/>
<rdf:Description rdf:about="&a;105076385">
	<b:glossaryEntry>witty language used to convey insults or scorn; "he used sarcasm to upset his opponent"; "irony is wasted on the stupid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105076629"
	 b:glossaryEntry="adroitness and cleverness in reply"/>
<rdf:Description rdf:about="&a;105076736"
	 b:glossaryEntry="light teasing repartee"/>
<rdf:Description rdf:about="&a;105076885"
	 b:glossaryEntry="frivolous banter"/>
<rdf:Description rdf:about="&a;105076956"
	 b:glossaryEntry="light teasing"/>
<rdf:Description rdf:about="&a;105077026"
	 b:glossaryEntry="a humorous anecdote or remark"/>
<rdf:Description rdf:about="&a;105077312"
	 b:glossaryEntry="the point of a joke or humorous story"/>
<rdf:Description rdf:about="&a;105077460"
	 b:glossaryEntry="a joke that seems extremely funny"/>
<rdf:Description rdf:about="&a;105077613"
	 b:glossaryEntry="an indelicate joke"/>
<rdf:Description rdf:about="&a;105077727"
	 b:glossaryEntry="a joke at the expense of some ethnic group"/>
<rdf:Description rdf:about="&a;105077827">
	<b:glossaryEntry>an account of an amusing incident (usually with a punch line)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105077959"
	 b:glossaryEntry="a one-line joke"/>
<rdf:Description rdf:about="&a;105078030">
	<b:glossaryEntry>a long rambling joke whose humor derives from its pointlessness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105078156"
	 b:glossaryEntry="a joke in bad taste"/>
<rdf:Description rdf:about="&a;105078231">
	<b:glossaryEntry>a joke whose effect is achieved by visual means rather than by speech (as in a movie)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105078386">
	<b:glossaryEntry>a representation of a person that is exaggerated for comic effect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105078554">
	<b:glossaryEntry>a composition that imitates somebody''s style in a humorous way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105078762">
	<b:glossaryEntry>a humorous or satirical drawing published in a newspaper or magazine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105078930">
	<b:glossaryEntry xml:space='preserve'><![CDATA[verbal wit (often at another''s expense but not to be taken seriously); "he became a figure of fun"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105079165"
	 b:glossaryEntry="fun characterized by humor"/>
<rdf:Description rdf:about="&a;105079259"
	 b:glossaryEntry="waggish behavior"/>
<rdf:Description rdf:about="&a;105079343"
	 b:glossaryEntry="a comic incident or series of incidents"/>
<rdf:Description rdf:about="&a;105079469"
	 b:glossaryEntry='a humorous play on words; "I do it for the pun of it"'/>
<rdf:Description rdf:about="&a;105079593"
	 b:glossaryEntry="ribald humor"/>
<rdf:Description rdf:about="&a;105079660">
	<b:glossaryEntry>a message expressing a belief about something; "his opinions appeared frequently on the editorial page"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105079860"
	 b:glossaryEntry="a message expressing an opinion based on incomplete evidence"/>
<rdf:Description rdf:about="&a;105080036">
	<b:glossaryEntry>an opinion that is held in opposition to another in an argument or dispute; "there are two sides to every question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105080213">
	<b:glossaryEntry>an imprecise or incomplete account; "newspapers gave only an approximation of the actual events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105080369">
	<b:glossaryEntry>a statement indicating the likely cost of some job; "he got an estimate from the car repair shop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105080521">
	<b:glossaryEntry>the subject matter at issue; "the question of disease merits serious discussion"; "under the head of minor Roman poets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105080756">
	<b:glossaryEntry>a question raised for consideration or solution; "our homework consisted of ten problems to solve"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105081088">
	<b:glossaryEntry>a disputed factual contention that is generally left for a jury to decide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105081241">
	<b:glossaryEntry>a disputed legal contention that is generally left for a judge to decide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105081391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a particularly baffling problem; "That''s a real puzzler"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105081510">
	<b:glossaryEntry>a problem requiring investigation; "Perry Mason solved the case of the missing heir"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105081645"
	 b:glossaryEntry="a problem that students are assigned to do outside of class"/>
<rdf:Description rdf:about="&a;105081767"
	 b:glossaryEntry="a difficult problem"/>
<rdf:Description rdf:about="&a;105081875"
	 b:glossaryEntry="a particularly difficult or baffling question or problem"/>
<rdf:Description rdf:about="&a;105082003"
	 b:glossaryEntry="any very difficult problem; insoluble in its own terms"/>
<rdf:Description rdf:about="&a;105082116">
	<b:glossaryEntry>a puzzle in which words corresponding to numbered clues are to be found and written in to squares in the puzzle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105082302">
	<b:glossaryEntry>a puzzle where you fill a square grid with words reading the same down as across</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105082451">
	<b:glossaryEntry>a problem that severely tests the ability of an inexperienced person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105082579">
	<b:glossaryEntry>a puzzle where you decode a message consisting of pictures representing syllables and words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105082722">
	<b:glossaryEntry>a message describing how something is to be done; "he gave directions faster than she could follow them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105083076"
	 b:glossaryEntry="incorrect directions or instructions"/>
<rdf:Description rdf:about="&a;105083171">
	<b:glossaryEntry>written directions for finding some location; written on letters or packages that are to be delivered to that location</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105083450">
	<b:glossaryEntry>the address of the sender of a letter or parcel indicating where it should be returned if it cannot be delivered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105083623">
	<b:glossaryEntry>detailed stylistic instructions for typesetting something that is to be printed; manual markup is usually written on the copy (e.g. underlining words that are to be set in italics)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105083856">
	<b:glossaryEntry>a set of symbols and rules for their use when doing a markup of a document</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105084028">
	<b:glossaryEntry>(computer science) a standardized language for the descriptive markup of documents; a set of rules for using whatever markup vocabulary is adopted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105084264">
	<b:glossaryEntry>a set of tags and rules (conforming to SGML) for using them in developing hypertext documents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105084436"
	 b:glossaryEntry="directions for achieving a therapeutic effect"/>
<rdf:Description rdf:about="&a;105084540"
	 b:glossaryEntry="directions for making something"/>
<rdf:Description rdf:about="&a;105084634">
	<b:glossaryEntry>directions that define the way a game or sport is to be conducted; "he knew the rules of chess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105084798"
	 b:glossaryEntry="an instruction written as part of the script of a play"/>
<rdf:Description rdf:about="&a;105084933">
	<b:glossaryEntry>the body of teachings of a religious group that are generally accepted by that group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105085207"
	 b:glossaryEntry="a formal creed summarizing Christian beliefs"/>
<rdf:Description rdf:about="&a;105085310">
	<b:glossaryEntry>a religious doctrine that is proclaimed as true without proof</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105085440">
	<b:glossaryEntry>the Roman Catholic doctrine that the Virgin Mary was conceived without any stain of original sin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105085604">
	<b:glossaryEntry>the Christian doctrine of the union of God and man in the person of Jesus Christ</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105085742">
	<b:glossaryEntry>the Christian doctrine that the body of Christ is actually present in the Eucharist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105085885">
	<b:glossaryEntry>any communication that encodes a message; "signals from the boat sudddenly stopped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105086526">
	<b:glossaryEntry>a signal to begin (as in a race); "the starting_signal was a green light"; "the runners awaited the start"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105086702">
	<b:glossaryEntry>a signal announcing the approach of a storm especially one of marked violence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105086856"
	 b:glossaryEntry="(British) a canvas cone hoisted to warn of high winds"/>
<rdf:Description rdf:about="&a;105086966">
	<b:glossaryEntry>a signal transmitted along a narrow path; guides pilots in darkness or bad weather</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105087112">
	<b:glossaryEntry>a file of memoranda or notices that remind of things to be done</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105087244">
	<b:glossaryEntry>(Brit) system of signalling by hand signs used by bookmakers at racetracks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105087373">
	<b:glossaryEntry>a signal (especially electronic or by radio) indicating the precisely correct time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105087513">
	<b:glossaryEntry>a public display of a (usually written) message; "he posted signs in all the shop windows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105087726">
	<b:glossaryEntry>a sign posted in a public place as an advertisement; "a poster advertised the coming attractions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105087945"
	 b:glossaryEntry="a poster advertising a show or play"/>
<rdf:Description rdf:about="&a;105088087">
	<b:glossaryEntry>the advertisement of a star''s name at the top of a theatrical poster</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105088232">
	<b:glossaryEntry>a card with words or numbers of pictures that are flashed to a class by the teacher</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105088372"
	 b:glossaryEntry="a sign visible from the street"/>
<rdf:Description rdf:about="&a;105088478">
	<b:glossaryEntry>a sign in front of a house or business carrying the conventional form by which its location is described</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105088636"
	 b:glossaryEntry="a post bearing a sign that shows the way"/>
<rdf:Description rdf:about="&a;105088761"
	 b:glossaryEntry="a guidepost resembling a hand with a pointing index finger"/>
<rdf:Description rdf:about="&a;105088890">
	<b:glossaryEntry>a symbol of disgrace or infamy; "And the Lord set a mark upon Cain"--Genesis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105089096">
	<b:glossaryEntry>a mark against a person for misconduct or failure; usually given in school or armed forces; "ten demerits and he loses his privileges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105089284"
	 b:glossaryEntry="a corner of a page turned down to mark your place"/>
<rdf:Description rdf:about="&a;105089406"
	 b:glossaryEntry="a mark of bastardy; lines from top right to bottom left"/>
<rdf:Description rdf:about="&a;105089536"
	 b:glossaryEntry="identification mark on the ear of a domestic animal"/>
<rdf:Description rdf:about="&a;105089641"
	 b:glossaryEntry="identification mark on skin, made by burning"/>
<rdf:Description rdf:about="&a;105089737"
	 b:glossaryEntry="the mark of Satan"/>
<rdf:Description rdf:about="&a;105089826">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an individual instance of a type of symbol; "the word`error'' contains three tokens of `r''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105090011">
	<b:glossaryEntry xml:space='preserve'><![CDATA[all of the tokens of the same symbol; "the word `element'' contains five different types of character"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105090163"
	 b:glossaryEntry="a token that postal fees have been paid"/>
<rdf:Description rdf:about="&a;105090280">
	<b:glossaryEntry>a stamp given by a retailer to a buyer; redeemable for articles on a premium list</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105090421"
	 b:glossaryEntry="communication between animals (of the same species)"/>
<rdf:Description rdf:about="&a;105090557">
	<b:glossaryEntry>the characteristic sound produced by a bird; "a bird will not learn its song unless it hears it at an early age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105090749">
	<b:glossaryEntry>a signal that serves to indicate or suggest something; "a sign of foul play"; "indications of strain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105091123">
	<b:glossaryEntry>(medicine) any indication or symptom that makes it inadvisable to employ a particular procedure or treatment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105091294">
	<b:glossaryEntry>anything that accompanies X and is regarded as an indication of X''s existence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105091425"
	 b:glossaryEntry="a conspicuous indication"/>
<rdf:Description rdf:about="&a;105091509"
	 b:glossaryEntry="indication by demonstration"/>
<rdf:Description rdf:about="&a;105091595"
	 b:glossaryEntry="a manifest indication"/>
<rdf:Description rdf:about="&a;105091676">
	<b:glossaryEntry>a visible indication made on a surface; "some previous reader had covered the pages with dozens of marks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105091922"
	 b:glossaryEntry="a mark made by a writing implement (as in cursive writing)"/>
<rdf:Description rdf:about="&a;105092087"
	 b:glossaryEntry="a stroke normally made in a downward direction"/>
<rdf:Description rdf:about="&a;105092190"
	 b:glossaryEntry="a stroke normally made in an upward direction"/>
<rdf:Description rdf:about="&a;105092290">
	<b:glossaryEntry>a visible impression on a surface made by the hoof of an animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105092420">
	<b:glossaryEntry>a mark that is long relative to its width; "He drew a line on the chart"; "The substance produced characteristic lines on the spectroscope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105092826"
	 b:glossaryEntry="a short twisting line"/>
<rdf:Description rdf:about="&a;105092913">
	<b:glossaryEntry>an isolated component of a spectrum formed by radiation at a uniform frequency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105093070"
	 b:glossaryEntry="a line on a graph indicating a statistical trend"/>
<rdf:Description rdf:about="&a;105093175"
	 b:glossaryEntry="a line drawn underneath (especially under written matter)"/>
<rdf:Description rdf:about="&a;105093301"
	 b:glossaryEntry="a line drawn on a map connecting points of equal height"/>
<rdf:Description rdf:about="&a;105093443"
	 b:glossaryEntry="a line following the lowest points of a valley"/>
<rdf:Description rdf:about="&a;105093543">
	<b:glossaryEntry>a light line that is used in lettering to help align the letters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105093663"
	 b:glossaryEntry="a very thin line"/>
<rdf:Description rdf:about="&a;105093734">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a vague indication; "he caught only a glimpse of the professor''s meaning"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105093861"
	 b:glossaryEntry="an indication of the approach of something or someone"/>
<rdf:Description rdf:about="&a;105094004"
	 b:glossaryEntry="a slight indication"/>
<rdf:Description rdf:about="&a;105094081">
	<b:glossaryEntry>an indication of some hidden activity; "with all that smoke there must be a fire somewhere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105094224"
	 b:glossaryEntry="an automatic signal (usually a sound) warning of danger"/>
<rdf:Description rdf:about="&a;105094473">
	<b:glossaryEntry>an internationally recognized signal sent out by a ship or plane indicating that help is needed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105094666"
	 b:glossaryEntry="an internationally recognized distress signal in radio code"/>
<rdf:Description rdf:about="&a;105094775">
	<b:glossaryEntry>an internationally recognized distress signal via radiotelephone (from the French m''aider)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105094918"
	 b:glossaryEntry="the sound of an alarm (usually a bell)"/>
<rdf:Description rdf:about="&a;105095022"
	 b:glossaryEntry="a warning signal that is a loud wailing sound"/>
<rdf:Description rdf:about="&a;105095119"
	 b:glossaryEntry="a signal (usually a siren) that danger is over"/>
<rdf:Description rdf:about="&a;105095221"
	 b:glossaryEntry="a signal broadcast by the sound of a bugle"/>
<rdf:Description rdf:about="&a;105095392"
	 b:glossaryEntry="(military) signal to turn the lights out"/>
<rdf:Description rdf:about="&a;105095496">
	<b:glossaryEntry>a signal (usually a bell) announcing the start of curfew restrictions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105095618"
	 b:glossaryEntry="(military) signal to wake up"/>
<rdf:Description rdf:about="&a;105095718">
	<b:glossaryEntry>(military) a bugle call signaling the lowering of the flag at sunset</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105095840">
	<b:glossaryEntry>(military) a signal to begin a withdrawal from a dangerous position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105095961">
	<b:glossaryEntry>(military) the beating of a drum as a signal for lowering the flag at sundown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105096111"
	 b:glossaryEntry="disclosing information or giving evidence about another"/>
<rdf:Description rdf:about="&a;105096239">
	<b:glossaryEntry>a drumbeat of bugle call that signals the military to return to their quarters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105096388"
	 b:glossaryEntry="a signal transmitted by telegraphy"/>
<rdf:Description rdf:about="&a;105096549">
	<b:glossaryEntry>the shorter of the two telegraphic signals used in Morse code</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105096685"
	 b:glossaryEntry="the longer of the two telegraphic signals used in Morse code"/>
<rdf:Description rdf:about="&a;105096821">
	<b:glossaryEntry>the act of signalling (e.g., summoning) by whistling or blowing a whistle; "the whistle signalled the end of the game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105097005">
	<b:glossaryEntry>a silent signal of warning or recognition; "she started to speak but he gave her the high sign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105097156">
	<b:glossaryEntry>an arbitrary sign (written or printed) that has acquired a conventional significance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105097671">
	<b:glossaryEntry>a symbol used to represent a number; "he learned to write the numerals before he went to school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105097884"
	 b:glossaryEntry="one of the symbols 1,2,3,4,5,6,7,8,9,0"/>
<rdf:Description rdf:about="&a;105098001"
	 b:glossaryEntry="a symbol in the old Roman notation; I,V,X,L,C,D,M"/>
<rdf:Description rdf:about="&a;105098128"
	 b:glossaryEntry="a system of symbols and symbolic representations"/>
<rdf:Description rdf:about="&a;105098232">
	<b:glossaryEntry>two crossed bones (or a representation of two crossed bones) used as a symbol danger or death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105098382">
	<b:glossaryEntry>a human skull (or a representation of a human skull) used as a symbol of death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105098519"
	 b:glossaryEntry="the Hindu phallic symbol of Siva"/>
<rdf:Description rdf:about="&a;105098604">
	<b:glossaryEntry>a technical system of symbols used to represent special things</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105098813"
	 b:glossaryEntry="a notation used by mathematicians"/>
<rdf:Description rdf:about="&a;105099149"
	 b:glossaryEntry="any notation for the representation of numbers"/>
<rdf:Description rdf:about="&a;105099347">
	<b:glossaryEntry>a numeration system in which a real number is represented by an ordered set of characters where the value of a character depends on its position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105099664"
	 b:glossaryEntry="any notation that uses 2 characters (usually 0 and 1)"/>
<rdf:Description rdf:about="&a;105099779">
	<b:glossaryEntry>a positional system of numeration that uses binary digits and a radix of 2</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105099995">
	<b:glossaryEntry>a positional system of numeration that uses octal digits and a radix of 8</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105100160">
	<b:glossaryEntry>any notation that uses 10 different characters (usually the digits 0 to 9)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105100297"
	 b:glossaryEntry="the Arabic (or decimal) system of numeration"/>
<rdf:Description rdf:about="&a;105100396">
	<b:glossaryEntry>a positional system of numeration that uses decimal digits and a radix of 10</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105100603"
	 b:glossaryEntry="any notation that uses 16 different characters"/>
<rdf:Description rdf:about="&a;105100739">
	<b:glossaryEntry>a positional system of numeration that uses hexadecimal digits and a radix of 16</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105100940">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a character indicating a relation between quantities; "don''t forget the minus sign"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105101128">
	<b:glossaryEntry>a sign indicating that the quantities on either side are equal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105101248"
	 b:glossaryEntry="a sign indicating the operation of addition"/>
<rdf:Description rdf:about="&a;105101347"
	 b:glossaryEntry="a sign indicating the operation of subtraction"/>
<rdf:Description rdf:about="&a;105101450"
	 b:glossaryEntry="the dot at the left of a decimal fraction"/>
<rdf:Description rdf:about="&a;105101570">
	<b:glossaryEntry>a mathematical notation indicating the number of times a quantity is multiplied by itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105101766">
	<b:glossaryEntry>a sign placed in front of an expression to denote that a root is to be extracted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105101915"
	 b:glossaryEntry="the exponent required to produce a given number"/>
<rdf:Description rdf:about="&a;105102060"
	 b:glossaryEntry="the number of which a given number is the logarithm"/>
<rdf:Description rdf:about="&a;105102181"
	 b:glossaryEntry="a logarithm to the base 10"/>
<rdf:Description rdf:about="&a;105102270"
	 b:glossaryEntry="a logarithm to the base e"/>
<rdf:Description rdf:about="&a;105102381">
	<b:glossaryEntry>the positive fractional part of the representation of a logarithm; in the expression log 643 = 2.808 the mantissa is .808</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105102576">
	<b:glossaryEntry>the integer part (positive or negative) of the representation of a logarithm; in the expression log 643 = 2.808 the characteristic is 2</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105102772">
	<b:glossaryEntry>a radix numeration system in which the location of the decimal point is fixed by convention</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105102966">
	<b:glossaryEntry>a radix numeration system in which the location of the decimal point is indicated by an exponent of the radix; the floating-point representation of 0.0012 is 0.l2-2 where -2 is the exponent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105103264">
	<b:glossaryEntry>a notation for forming mathematical expressions using parentheses and governed by rules of operator precedence; operators are dispersed among the operands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105103479">
	<b:glossaryEntry>a notation for forming mathematical expressions that does not use parentheses to delimit components</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105103686">
	<b:glossaryEntry>a parenthesis-free notation for forming mathematical expressions in which each operator precedes its operands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105103898">
	<b:glossaryEntry>a parenthesis-free notation for forming mathematical expressions in which each operator follows its operands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105104113"
	 b:glossaryEntry="a notation used by musicians"/>
<rdf:Description rdf:about="&a;105104658">
	<b:glossaryEntry>a sheet containing the words and melody for a song (and some indication of harmony) written in simple form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105104821">
	<b:glossaryEntry>a written form of a musical composition; parts for different instruments appear on separate staves on large pages; "he studied the score of the sonata"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105105059">
	<b:glossaryEntry>a part of the score that must be performed without change or omission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105105195">
	<b:glossaryEntry>a musical composition in printed or written form; "she turned the pages of the music as he played"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105105395"
	 b:glossaryEntry="a musical notation indicating the fingering to be used"/>
<rdf:Description rdf:about="&a;105105505"
	 b:glossaryEntry="a notation used by choreographers"/>
<rdf:Description rdf:about="&a;105105597">
	<b:glossaryEntry>a notation used by chemists to express technical facts in chemistry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105105747">
	<b:glossaryEntry>a representation of a substance using symbols for its constituent elements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105105949"
	 b:glossaryEntry="a chemical formula based on analysis and molecular weight"/>
<rdf:Description rdf:about="&a;105106088">
	<b:glossaryEntry>an expanded molecular formula showing the arrangement of atoms within the molecule</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105106235">
	<b:glossaryEntry>a chemical formula showing the ratio of elements in a compound rather than the total number of atoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105106399"
	 b:glossaryEntry="a written or printed symbol"/>
<rdf:Description rdf:about="&a;105106558">
	<b:glossaryEntry>a written or printed symbol (as for punctuation); "his answer was just a punctuation mark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105106879"
	 b:glossaryEntry="a mark to indicate a direction or relation"/>
<rdf:Description rdf:about="&a;105107021">
	<b:glossaryEntry>a mark shaped like an arrowhead; used to mark convicts'' clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105107143">
	<b:glossaryEntry>a mark consisting of characters written on a book; used to indicate shelf location</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105107307">
	<b:glossaryEntry>a mark used by an author or editor to indicate where something is to be inserted into a text</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105107451">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a mark indicating that something has been noted or completed etc.; "as he called the role he put a check mark by each student''s name"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105107649">
	<b:glossaryEntry>a written symbol that is used to represent speech; "the Greek alphabet has 24 characters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105108182"
	 b:glossaryEntry="a variant form of a grapheme as `m'' or `M''"/>
<rdf:Description rdf:about="&a;105108280">
	<b:glossaryEntry>a character or symbol set or printed or written above and immediately to one side of another character</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105108469">
	<b:glossaryEntry>a character or symbol set or printed or written beneath or slightly below and to the side of another character</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105108664">
	<b:glossaryEntry>any member of the standard code for representing characters by binary numbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105108840">
	<b:glossaryEntry>ASCII characters to indicate carriage return or tab or backspace; typed by depressing a key and the control key at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105109076">
	<b:glossaryEntry>a control character that indicates moving a space to the left</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105109203"
	 b:glossaryEntry="a mark added to a letter to indicate a special pronunciation"/>
<rdf:Description rdf:about="&a;105109482"
	 b:glossaryEntry="a mark used to indicate the word above it should be repeated"/>
<rdf:Description rdf:about="&a;105109607">
	<b:glossaryEntry>a mark ($) written before a number to indicate that it stands for the number of dollars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105109766">
	<b:glossaryEntry>a symbol of commercialism or greed; "he worships the almighty dollar" or "the dollar sign means little to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105109957"
	 b:glossaryEntry="a line that forms the length of an arrow pointer"/>
<rdf:Description rdf:about="&a;105110076">
	<b:glossaryEntry>any written symbol standing for a sound or syllable or morpheme or word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105110203">
	<b:glossaryEntry>a V-shaped mark at one end of an arrow pointer; "the point of the arrow was due north"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105110367">
	<b:glossaryEntry>a diacritical mark used to indicate stress or (in some languages) placed above a vowel to indicate a special pronunciation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105110610"
	 b:glossaryEntry="a mark indicating the stress on a syllable"/>
<rdf:Description rdf:about="&a;105110710"
	 b:glossaryEntry="a mark ('') placed above a vowel to indicate pronunciation"/>
<rdf:Description rdf:about="&a;105110841"
	 b:glossaryEntry="a mark (`) placed above a vowel to indicate pronunciation"/>
<rdf:Description rdf:about="&a;105110965">
	<b:glossaryEntry>a diacritical mark (u-curved) placed over a vowel to indicate a short sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105111092">
	<b:glossaryEntry>a diacritical mark (,) placed below the letter c to indicate that it is pronounced as an s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105111236">
	<b:glossaryEntry>a diacritical mark (^) placed above a vowel in some languages to indicate a special phonetic quality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105111393">
	<b:glossaryEntry>a diacritical mark (an inverted circumflex) placed above certain letters (such as c) to indicate pronunciation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105111563">
	<b:glossaryEntry>a diacritical mark (-) placed above a vowel to indicate a long sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105111684">
	<b:glossaryEntry>a diacritical mark (~) placed over the letter n in Spanish to indicate a palatal nasal sound or over a vowel in Portuguese to indicate nasalization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105111883">
	<b:glossaryEntry>a diacritical mark (two dots) placed over a vowel in German to indicate a change in sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105112048">
	<b:glossaryEntry>a graphic symbol consisting of 2 or more letters combined (usually your initials); printed on stationery or embroidered on clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105112234">
	<b:glossaryEntry>printers once kept type for capitals and small letters in separate cases; capitals were kept in the upper half of the type case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105112484">
	<b:glossaryEntry>the characters that were once kept in bottom half of a compositor''s type case</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105112671">
	<b:glossaryEntry>a character having the form of an upper-case letter but the same height as lower-case letters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105112836"
	 b:glossaryEntry='printed characters; "small type is hard to read"'/>
<rdf:Description rdf:about="&a;105112971"
	 b:glossaryEntry="a complete set of type suitable for printing text"/>
<rdf:Description rdf:about="&a;105113097"
	 b:glossaryEntry="a specific size and style of type within a type family"/>
<rdf:Description rdf:about="&a;105113391">
	<b:glossaryEntry>a typeface is which each character is given the same width (as by a typewriter)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105113609"
	 b:glossaryEntry="any font whose different characters have different widths"/>
<rdf:Description rdf:about="&a;105113802">
	<b:glossaryEntry>(computer science) any font that is contained in a cartridge that can be plugged into a computer printer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105113984"
	 b:glossaryEntry="a heavy typeface in use from 15th to 18th centuries"/>
<rdf:Description rdf:about="&a;105114103">
	<b:glossaryEntry>a typeface (based on an 18th century design by Giambattista Bodoni) distinguished by regular shape and hairline serifs and heavy downstrokes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105114351">
	<b:glossaryEntry>a typeface (based on an 18th century design) distinguished by irregularity and slanted ascender serifs and little contrast between light and heavy strokes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105114596"
	 b:glossaryEntry="a typeface with thick heavy lines"/>
<rdf:Description rdf:about="&a;105114684"
	 b:glossaryEntry="a typeface with letters slanting upward to the right"/>
<rdf:Description rdf:about="&a;105114789"
	 b:glossaryEntry="a typeface used in ancient Roman inscriptions"/>
<rdf:Description rdf:about="&a;105114929">
	<b:glossaryEntry>(computer science) the font that is displayed on a computer screen; "when the screen font resembles a printed font a document may look approximately the same on the screen as it will when printed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105115197"
	 b:glossaryEntry="a typeface in which characters have no serifs"/>
<rdf:Description rdf:about="&a;105115311"
	 b:glossaryEntry="a short line at the end of the main strokes of a character"/>
<rdf:Description rdf:about="&a;105115430"
	 b:glossaryEntry="%"/>
<rdf:Description rdf:about="&a;105115508"
	 b:glossaryEntry="a star-shaped character * used in printing"/>
<rdf:Description rdf:about="&a;105115612">
	<b:glossaryEntry>a character used in printing to indicate a cross reference or footnote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105115745">
	<b:glossaryEntry>a character used in printing to indicate a cross reference or footnote</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105115901">
	<b:glossaryEntry>the conventional characters of the alphabet used to represent speech; "his grandmother taught him his letters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105117158">
	<b:glossaryEntry>two successive letters (especially two letters used to represent a single sound: `sh'' in `shoe'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105117308"
	 b:glossaryEntry="the letter H"/>
<rdf:Description rdf:about="&a;105117372"
	 b:glossaryEntry="the letter L"/>
<rdf:Description rdf:about="&a;105117434">
	<b:glossaryEntry>the letter Z; "the British call Z zed but Americans call it zee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105117554">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the first letter of a word (especially a person''s name); "he refused to put the initials FRS after his name"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105117716"
	 b:glossaryEntry="the 1st letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105117823"
	 b:glossaryEntry="the 2nd letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105117929"
	 b:glossaryEntry="the 3rd letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118036"
	 b:glossaryEntry="the 4th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118143"
	 b:glossaryEntry="the 5th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118252"
	 b:glossaryEntry="the 6th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118358"
	 b:glossaryEntry="the 7th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118463"
	 b:glossaryEntry="the 8th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118570"
	 b:glossaryEntry="the 9th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118676"
	 b:glossaryEntry="the 10th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118784"
	 b:glossaryEntry="the 11th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118893"
	 b:glossaryEntry="the 12th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105118998"
	 b:glossaryEntry="the 13th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119103"
	 b:glossaryEntry="the 14th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119208"
	 b:glossaryEntry="the 15th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119318"
	 b:glossaryEntry="the 16th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119423"
	 b:glossaryEntry="the 17th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119529"
	 b:glossaryEntry="the 18th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119637"
	 b:glossaryEntry="the 19th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119743"
	 b:glossaryEntry="the 20th letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119853"
	 b:glossaryEntry="the 21st letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105119959"
	 b:glossaryEntry="the 22nd letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105120065"
	 b:glossaryEntry="the 23rd letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105120171"
	 b:glossaryEntry="the last (24th) letter of the Greek alphabet"/>
<rdf:Description rdf:about="&a;105120286"
	 b:glossaryEntry="the 1st letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105120394"
	 b:glossaryEntry="the 2nd letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105120501"
	 b:glossaryEntry="the 3rd letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105120609"
	 b:glossaryEntry="the 4th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105120718"
	 b:glossaryEntry="the 5th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105120823"
	 b:glossaryEntry="the 6th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105120929"
	 b:glossaryEntry="the 7th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121037"
	 b:glossaryEntry="the 8th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121144"
	 b:glossaryEntry="the 9th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121251"
	 b:glossaryEntry="the 10th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121359"
	 b:glossaryEntry="the 11th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121467"
	 b:glossaryEntry="the 12th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121577"
	 b:glossaryEntry="the 13th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121684"
	 b:glossaryEntry="the 14th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121791"
	 b:glossaryEntry="the 15th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105121901"
	 b:glossaryEntry="the 16th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122009"
	 b:glossaryEntry="the 17th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122115"
	 b:glossaryEntry="the 18th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122224"
	 b:glossaryEntry="the 19th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122332"
	 b:glossaryEntry="the 20th letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122440"
	 b:glossaryEntry="the 21st letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122547"
	 b:glossaryEntry="the 22nd letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122655"
	 b:glossaryEntry="the 23rd letter of the Hebrew alphabet"/>
<rdf:Description rdf:about="&a;105122762">
	<b:glossaryEntry>a blank character used to separate successive words in writing or printing; "he said the space is the most important character in the alphabet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105122965">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a letter that has two or more pronunciations; "`c'' is a polyphone because it is pronounced like `k'' in `car'' but like `s'' in `cell''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105123174"
	 b:glossaryEntry="a plain hand-drawn letter"/>
<rdf:Description rdf:about="&a;105123274"
	 b:glossaryEntry="the letter A in red; Puritans required adulterers to wear it"/>
<rdf:Description rdf:about="&a;105123395">
	<b:glossaryEntry>a written character used in phonetic transcription of represent a particular speech sound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105123584">
	<b:glossaryEntry>a character that is used to indicates a mathematical relation or operation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105123724">
	<b:glossaryEntry>any character from an ancient Germanic alphabet used in Scandinavia from the 3rd century to the Middle Ages; "each rune had its own magical significance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105123961"
	 b:glossaryEntry="a Germanic character of runic origin"/>
<rdf:Description rdf:about="&a;105124049"
	 b:glossaryEntry="a graphic character used in picture writing"/>
<rdf:Description rdf:about="&a;105124149"
	 b:glossaryEntry="a graphic character used in ideography"/>
<rdf:Description rdf:about="&a;105124291"
	 b:glossaryEntry="a single symbol that represents an entire word or phrase"/>
<rdf:Description rdf:about="&a;105124414"
	 b:glossaryEntry="a character conveying the lexical meaning of a logogram"/>
<rdf:Description rdf:about="&a;105124542">
	<b:glossaryEntry>the marks used to clarify meaning by indicating separation of words into sentences and clauses and phrases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125032">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a punctuation mark (&) used to represent conjunction (and)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125146">
	<b:glossaryEntry xml:space='preserve'><![CDATA[either of two punctuation marks (< or >) used to enclose textual material]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125289">
	<b:glossaryEntry>the mark ('') used to indicate the omission of one or more letters from a printed word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125431">
	<b:glossaryEntry>either of two punctuation marks ({ or }) used to enclose textual material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125556">
	<b:glossaryEntry>either of two punctuation marks ([ or ]) used to enclose textual material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125700">
	<b:glossaryEntry>a punctuation mark (:) used after a word introducing a series or an example or an explanation (or after the salutation of a business letter)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105125892">
	<b:glossaryEntry>a punctuation mark (,) used to indicate the separation of elements within the grammatical structure of a sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105126057"
	 b:glossaryEntry="a punctuation mark (!) used after an exclamation"/>
<rdf:Description rdf:about="&a;105126188">
	<b:glossaryEntry>a punctuation mark (-) used between parts of a compound word or between the syllables of a word when the word is divided at the end of a line of text</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105126397">
	<b:glossaryEntry>either of two punctuation marks ( or ) used to enclose textual material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105126526">
	<b:glossaryEntry>a punctuation mark (.) placed at the end of a declarative sentence to indicate a full stop or after abbreviations; "in England they call a period a stop"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105126790">
	<b:glossaryEntry>(usually plural) one of a series of points indicating that something has been omitted or that the sentence is incomplete</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105126973">
	<b:glossaryEntry>a punctuation mark (?) placed at the end of a sentence to indicate a question</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105127132">
	<b:glossaryEntry>a punctuation mark used to attribute the enclosed text to someone else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105127342"
	 b:glossaryEntry="a single quotation mark"/>
<rdf:Description rdf:about="&a;105127424"
	 b:glossaryEntry="a pair of quotation marks"/>
<rdf:Description rdf:about="&a;105127509">
	<b:glossaryEntry>the use of quotation marks to indicate that it is not the authors preferred terminology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105127654">
	<b:glossaryEntry>a punctuation mark (;) used to connect independent clauses; indicates a closer relation than does a period</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105127816">
	<b:glossaryEntry>a punctuation mark (/) used to separate related items of information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105127989">
	<b:glossaryEntry>a punctuation mark used in text to indicate the omission of a word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105128112"
	 b:glossaryEntry="the name by which a corporation is identified"/>
<rdf:Description rdf:about="&a;105128216">
	<b:glossaryEntry>(computer science) strings of letters used to name organizations and computers and addresses on the internet; "domain names are organized hierarchically with the more generic parts to the right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105128468"
	 b:glossaryEntry="a name given to a product or service"/>
<rdf:Description rdf:about="&a;105128586">
	<b:glossaryEntry>a formally registered symbol identifying the manufacturer or distributor of a product</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105128745">
	<b:glossaryEntry>a mark on an article of trade to indicate its origin and authenticity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105128899">
	<b:glossaryEntry>a symbol that is the result of printing; "he put his stamp on the envelope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105129075">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a stamp affixed to a document (as to attest to its authenticity or to seal it); "the warrant bore the sheriff''s seal"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105129243"
	 b:glossaryEntry="an impression produced by pressure or printing"/>
<rdf:Description rdf:about="&a;105129356">
	<b:glossaryEntry>(Judaism) a small leather case containing religious texts; worn by Jewish men during morning prayer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105129512"
	 b:glossaryEntry="a symbol of cowardice"/>
<rdf:Description rdf:about="&a;105129593">
	<b:glossaryEntry>a series of notes differing in pitch according to a specific scheme (usually within an octave)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105129846">
	<b:glossaryEntry>a short lively tune played on brass instruments; "he entered to a flourish of trumpets"; "her arrival was greeted with a rousing fanfare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105130048">
	<b:glossaryEntry>a rapid series of ascending or descending notes on the musical scale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105130190">
	<b:glossaryEntry>rapid sliding up or down the musical scale; "the violinist was indulgent with his swoops and slides"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105130350"
	 b:glossaryEntry="the entire scale of musical notes"/>
<rdf:Description rdf:about="&a;105130435"
	 b:glossaryEntry="(music) the first note of a diatonic scale"/>
<rdf:Description rdf:about="&a;105130539"
	 b:glossaryEntry="(music) the second note of a diatonic scale"/>
<rdf:Description rdf:about="&a;105130639">
	<b:glossaryEntry>(music) the third note of a diatonic scale; midway between the tonic and the dominant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105130778"
	 b:glossaryEntry="(music) the fourth note of the diatonic scale"/>
<rdf:Description rdf:about="&a;105130881"
	 b:glossaryEntry="(music) the fifth note of the diatonic scale"/>
<rdf:Description rdf:about="&a;105130980">
	<b:glossaryEntry>(music) the sixth note of a major or minor scale (or the third below the tonic)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105131116"
	 b:glossaryEntry="(music) the seventh note of the diatonic scale"/>
<rdf:Description rdf:about="&a;105131232"
	 b:glossaryEntry="a sustained bass note"/>
<rdf:Description rdf:about="&a;105131319"
	 b:glossaryEntry="the difference in pitch between two notes"/>
<rdf:Description rdf:about="&a;105131596"
	 b:glossaryEntry="a musical interval of two semitones"/>
<rdf:Description rdf:about="&a;105131715">
	<b:glossaryEntry>the musical interval between adjacent keys on a keyboard instrument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105131849"
	 b:glossaryEntry="half of a semitone"/>
<rdf:Description rdf:about="&a;105131925"
	 b:glossaryEntry="a musical interval of eight tones"/>
<rdf:Description rdf:about="&a;105132028">
	<b:glossaryEntry>the musical interval between one note and another three notes away from it; "a simple harmony written in major thirds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132198">
	<b:glossaryEntry>the musical interval between one note and another four notes away from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132324">
	<b:glossaryEntry>the musical interval between one note and another five notes away from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132449">
	<b:glossaryEntry>the musical interval between one note and another six notes away from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132573">
	<b:glossaryEntry>the musical interval between one note and another seven notes away from it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132701">
	<b:glossaryEntry>a note that alternates rapidly with another note a semitone above it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132829">
	<b:glossaryEntry>a scale with eight notes in an octave; all but two are separated by whole tones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105132987">
	<b:glossaryEntry>any of a system of modes used in Gregorian chants up until 1600; derived historically from the Greek mode</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105133205">
	<b:glossaryEntry>any of the descending diatonic scales in the music of classical Greece</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105133332">
	<b:glossaryEntry>a diatonic scale with notes separated by whole tones except for the 3rd and 4th and 7th and 8th</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105133508">
	<b:glossaryEntry>a diatonic scale with notes separated by whole tones except for the 2nd and 3rd and 5th and 6th</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105133684"
	 b:glossaryEntry="a 12-note scale including all the semitones of the octave"/>
<rdf:Description rdf:about="&a;105133803"
	 b:glossaryEntry="a musical scale with fewer than seven notes"/>
<rdf:Description rdf:about="&a;105133923"
	 b:glossaryEntry="a gapped scale with five notes"/>
<rdf:Description rdf:about="&a;105134016">
	<b:glossaryEntry>any of various fixed orders of the various diatonic notes within an octave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105134228">
	<b:glossaryEntry>(music) the system of five horizontal lines on which the musical notes are written</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105134408"
	 b:glossaryEntry="any of the 5 horizontal marks comprising a staff"/>
<rdf:Description rdf:about="&a;105134551">
	<b:glossaryEntry>one of the areas between or below or above the lines of a musical staff; "the spaces are the notes F-A-C-E"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105134748">
	<b:glossaryEntry>a short line; a notation for extending the range above or below the staff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105134911">
	<b:glossaryEntry>a musical notation written on a staff indicating the pitch of the notes following it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105135154">
	<b:glossaryEntry>a clef that puts the G above middle C on the second line of a staff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105135288">
	<b:glossaryEntry>a clef that puts the F below middle C on the fourth line of a staff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105135420"
	 b:glossaryEntry="a clef that puts middle C on the third line of a staff"/>
<rdf:Description rdf:about="&a;105135543">
	<b:glossaryEntry>a movable clef that puts middle C on one of the lines of a staff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105135660"
	 b:glossaryEntry="a clef that puts middle C on the bottom line of the staff"/>
<rdf:Description rdf:about="&a;105135776">
	<b:glossaryEntry>a clef that puts middle C on the fourth line of the staff; used for writing music for bassoons or cellos or tenor horns</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105135952">
	<b:glossaryEntry>the sharps or flats that follow the clef and indicate the key</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105136085">
	<b:glossaryEntry>any of 24 major or minor diatonic scales that provide the tonal framework for a piece of music</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105136258"
	 b:glossaryEntry="the absence of a key; alternative to the diatonic system"/>
<rdf:Description rdf:about="&a;105136400">
	<b:glossaryEntry>a musical notation indicating the number of beats to a measure and kind of note that takes a beat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105136601">
	<b:glossaryEntry>notation for a repeating pattern of musical beats; written followed by a vertical bar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105136746"
	 b:glossaryEntry="a vertical line marking the boundary between musical bars"/>
<rdf:Description rdf:about="&a;105136894">
	<b:glossaryEntry>notation marking the end of principal parts of a musical composition; two adjacent bar lines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105137043">
	<b:glossaryEntry>a musical time signature indicating two or four half notes to a measure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105137171">
	<b:glossaryEntry>a musical notation indicating a silence of a specified duration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105137303">
	<b:glossaryEntry>a notation representing the pitch and duration of a musical sound; "the singer held the note too long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105137875">
	<b:glossaryEntry>(music) a curved line spanning notes that are to be played legato</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138009">
	<b:glossaryEntry>(music) a slur over two notes of the same pitch; indicates that the note is to be sustained for their combined time value</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138180">
	<b:glossaryEntry>a notation indicating one half step higher than the note named</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138294">
	<b:glossaryEntry>a notation indicating one half step lower than the note named</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138406"
	 b:glossaryEntry="a notation cancelling a previous sharp or flat"/>
<rdf:Description rdf:about="&a;105138515">
	<b:glossaryEntry>a notation that makes a note sharp or flat or natural although that is not part of the key signature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138672">
	<b:glossaryEntry>a system of naming the notes of a musical scale by syllables instead of letters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138841">
	<b:glossaryEntry>a system of solmization using the solfa syllables: do-re-mi-fa-sol-la-ti</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105138998"
	 b:glossaryEntry="one of the names for notes of a musical scale in solmization"/>
<rdf:Description rdf:about="&a;105139264">
	<b:glossaryEntry>the syllable naming the first (tonic) note of any major scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105139400">
	<b:glossaryEntry>the syllable naming the second (supertonic) note of any major scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105139537">
	<b:glossaryEntry>the syllable naming the third (mediant) note of any major scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105139664">
	<b:glossaryEntry>the syllable naming the fourth (subdominant) note of the diatonic scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105139799">
	<b:glossaryEntry>the syllable naming the fifth (dominant) note of any musical scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105139941">
	<b:glossaryEntry>the syllable naming the sixth (submediant) note of a major or minor scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105140084">
	<b:glossaryEntry>the syllable naming the the seventh (subtonic) note of any musical scale in solmization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105140230">
	<b:glossaryEntry>(music) a notation written at the beginning or end of a passage that is to be repeated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105140368">
	<b:glossaryEntry>(music) a notation written above a note and indicating that it is to be played with a strong initial attack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105140531">
	<b:glossaryEntry>a chord whose notes are played in rapid succession rather than simultaneously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105140663"
	 b:glossaryEntry="an accented chord"/>
<rdf:Description rdf:about="&a;105140736">
	<b:glossaryEntry>the note designated by the first ledger line below the treble staff; 261.63 Hertz</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105140872">
	<b:glossaryEntry>a combination of three or more notes that blend harmoniously when sounded together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105141078">
	<b:glossaryEntry>a 3-note major or minor chord; a note and its third and fifth tones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105141212"
	 b:glossaryEntry="a triad with a seventh added"/>
<rdf:Description rdf:about="&a;105141300">
	<b:glossaryEntry>a nonharmonic note inserted for transition between harmonic notes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105141439"
	 b:glossaryEntry="a musical note having the longest time value"/>
<rdf:Description rdf:about="&a;105141552"
	 b:glossaryEntry="a rest equal in duration to a whole note"/>
<rdf:Description rdf:about="&a;105141649"
	 b:glossaryEntry="a musical note having the time value of half a whole note"/>
<rdf:Description rdf:about="&a;105141770">
	<b:glossaryEntry>a musical note having the time value of a quarter of a whole note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105141905">
	<b:glossaryEntry>a musical note having the time value of an eighth of a whole note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105142037">
	<b:glossaryEntry>a musical note having the time value of a sixteenth of a whole note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105142178">
	<b:glossaryEntry>a musical note having the time value of a thirty-second of a whole note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105142331">
	<b:glossaryEntry>a musical note having the time value of a sixty-fourth of a whole note</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105142486"
	 b:glossaryEntry="an embellishing note usually written in smaller size"/>
<rdf:Description rdf:about="&a;105142625"
	 b:glossaryEntry="the musical quality of the voice while singing"/>
<rdf:Description rdf:about="&a;105142857"
	 b:glossaryEntry="the lowest adult male singing voice"/>
<rdf:Description rdf:about="&a;105142982"
	 b:glossaryEntry="a very deep bass voice"/>
<rdf:Description rdf:about="&a;105143065"
	 b:glossaryEntry="the second lowest adult male singing voice"/>
<rdf:Description rdf:about="&a;105143179"
	 b:glossaryEntry="the adult male singing voice above baritone"/>
<rdf:Description rdf:about="&a;105143288"
	 b:glossaryEntry="the highest adult male singing voice"/>
<rdf:Description rdf:about="&a;105143390"
	 b:glossaryEntry="the lowest female singing voice"/>
<rdf:Description rdf:about="&a;105143484"
	 b:glossaryEntry="the female singing voice between contralto and soprano"/>
<rdf:Description rdf:about="&a;105143606"
	 b:glossaryEntry="the highest female voice; the voice of a boy before puberty"/>
<rdf:Description rdf:about="&a;105143719"
	 b:glossaryEntry="communication that relies on vision"/>
<rdf:Description rdf:about="&a;105143966"
	 b:glossaryEntry="a signal that involves visual communication"/>
<rdf:Description rdf:about="&a;105144322"
	 b:glossaryEntry="a fire lighted at night as a signal"/>
<rdf:Description rdf:about="&a;105144414">
	<b:glossaryEntry>a visual warning signal; "they saw the light of the beacon"; "there was a light at every corner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105144580">
	<b:glossaryEntry>a visual signal to control the flow of traffic at intersections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105144786"
	 b:glossaryEntry="the signal to proceed"/>
<rdf:Description rdf:about="&a;105144876"
	 b:glossaryEntry="the signal to stop"/>
<rdf:Description rdf:about="&a;105144950"
	 b:glossaryEntry="a cautionary sign of danger"/>
<rdf:Description rdf:about="&a;105145049"
	 b:glossaryEntry="the signal to proceed with caution"/>
<rdf:Description rdf:about="&a;105145142"
	 b:glossaryEntry="a burst of light used to communicate or illuminate"/>
<rdf:Description rdf:about="&a;105145306"
	 b:glossaryEntry="a rectangular piece of fabric used as a signalling device"/>
<rdf:Description rdf:about="&a;105145464"
	 b:glossaryEntry="a flag longer than it is wide (and often tapering)"/>
<rdf:Description rdf:about="&a;105145568">
	<b:glossaryEntry>one of an international code of flag signals used between ships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105145728">
	<b:glossaryEntry>a blue flag with a white square in the center indicates that the vessel is ready to sail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105145873"
	 b:glossaryEntry="language expressed by visible hand gestures"/>
<rdf:Description rdf:about="&a;105146041"
	 b:glossaryEntry="an alphabet of manual signs"/>
<rdf:Description rdf:about="&a;105146129"
	 b:glossaryEntry="the sign language used in the US"/>
<rdf:Description rdf:about="&a;105146255"
	 b:glossaryEntry="a gesture that is part of a sign language"/>
<rdf:Description rdf:about="&a;105146366">
	<b:glossaryEntry>the use of movements (especially of the hands) to communicate familiar or prearranged signals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105146736"
	 b:glossaryEntry="communication via the movements or attitudes of the body"/>
<rdf:Description rdf:about="&a;105146852"
	 b:glossaryEntry="a beckoning gesture"/>
<rdf:Description rdf:about="&a;105146922"
	 b:glossaryEntry="a gesture executed with the facial muscles"/>
<rdf:Description rdf:about="&a;105147207"
	 b:glossaryEntry="an expression of open-mouthed astonishment"/>
<rdf:Description rdf:about="&a;105147318"
	 b:glossaryEntry="a gaping grimace"/>
<rdf:Description rdf:about="&a;105147387">
	<b:glossaryEntry>a contorted facial expression; "she made a grimace at the prospect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105147533"
	 b:glossaryEntry="a disdainful pouting grimace"/>
<rdf:Description rdf:about="&a;105147630"
	 b:glossaryEntry="a facial expression of dislike or displeasure"/>
<rdf:Description rdf:about="&a;105147735">
	<b:glossaryEntry>a facial expression characterized by turning up the corners of the mouth; usually shows pleasure or amusement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105147942">
	<b:glossaryEntry>a facial expression characteristic of a person laughing; "his face wrinkled in a silent laugh of derision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105148100"
	 b:glossaryEntry="a smile expressing smugness or scorn instead of pleasure"/>
<rdf:Description rdf:about="&a;105148208"
	 b:glossaryEntry="an angry vicious expression"/>
<rdf:Description rdf:about="&a;105148287">
	<b:glossaryEntry>a serious facial expression giving no evidence of interest or amusement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105148418"
	 b:glossaryEntry="closing one eye quickly as a signal"/>
<rdf:Description rdf:about="&a;105148504"
	 b:glossaryEntry="the facial expression of sudden pain"/>
<rdf:Description rdf:about="&a;105148592">
	<b:glossaryEntry>a visual presentation showing how something works; "the lecture was accompanied by dramatic demonstrations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105148820">
	<b:glossaryEntry>something done in order to communicate a particular impression; "made a display of strength"; "a show of impatience"; "a good show of looking interested"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105149034">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expression without words; "tears are an expression of grief"; "the pulse is a reflection of the heart''s condition"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105149300"
	 b:glossaryEntry="showing by example"/>
<rdf:Description rdf:about="&a;105149395"
	 b:glossaryEntry="a visible symbol of an abstract idea"/>
<rdf:Description rdf:about="&a;105149718">
	<b:glossaryEntry>the symbol of the Democratic Party; introduced in cartoons by Thomas Nast in 1874</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105149852"
	 b:glossaryEntry="an emblem of peace"/>
<rdf:Description rdf:about="&a;105149921"
	 b:glossaryEntry='an emblem representing power; "the Roman eagle"'/>
<rdf:Description rdf:about="&a;105150020">
	<b:glossaryEntry>the symbol of the Republican Party; introduced in cartoons by Thomas Nast in 1874</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105150156"
	 b:glossaryEntry="an emblem flown as a symbol of nationality"/>
<rdf:Description rdf:about="&a;105150310"
	 b:glossaryEntry="the national flag of the US of A"/>
<rdf:Description rdf:about="&a;105150441"
	 b:glossaryEntry="the first flag of the Confederate States of American"/>
<rdf:Description rdf:about="&a;105150573"
	 b:glossaryEntry="the emblem on the flag of the Soviet Union"/>
<rdf:Description rdf:about="&a;105150679"
	 b:glossaryEntry="an emblem symbolizing Judaism; hexagram"/>
<rdf:Description rdf:about="&a;105150806">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an emblem (a small piece of plastic or cloth or metal) that signifies your status (rank or membership or affiliation etc.); "they checked everyone''s badge before letting them in"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105151180">
	<b:glossaryEntry>a badge award to Boy Scouts in recognition of special projects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105151300"
	 b:glossaryEntry="a badge worn to show official position"/>
<rdf:Description rdf:about="&a;105151501"
	 b:glossaryEntry="figure of a lamb; emblematic of Christ"/>
<rdf:Description rdf:about="&a;105151610"
	 b:glossaryEntry="the emblem of Canada"/>
<rdf:Description rdf:about="&a;105151687">
	<b:glossaryEntry>an emblem (an eagle with wings and legs spread) on the obverse of the Great Seal of the US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105151836">
	<b:glossaryEntry>the official emblem of the Nazi Party and the German Third Reich</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105151955">
	<b:glossaryEntry>the cloak as a symbol of authority; "place the mantle of authority on younger shoulders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105152096">
	<b:glossaryEntry>the crown as a symbol of a monarchy; "the colonies revolted against the crown"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105152226">
	<b:glossaryEntry>an insignia used by the medical profession; modeled after the staff of Hermes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105152358"
	 b:glossaryEntry="an insignia worn on a military uniform"/>
<rdf:Description rdf:about="&a;105152459">
	<b:glossaryEntry>(British) something worn on the shoulder of a military uniform as an emblem of a division etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105152614"
	 b:glossaryEntry="an insignia worn to indicate years of service"/>
<rdf:Description rdf:about="&a;105152743">
	<b:glossaryEntry>evidence of identity; something that identifies a person or thing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105152941"
	 b:glossaryEntry="any identifying characteristic"/>
<rdf:Description rdf:about="&a;105153029">
	<b:glossaryEntry>a card that identifies the bearer as an alien with permanent resident status in the United States; "he was surprised to discover that green cards are no longer green"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105153252"
	 b:glossaryEntry="a card or badge used to identify the bearer"/>
<rdf:Description rdf:about="&a;105153369"
	 b:glossaryEntry="the projection of an image from a film onto a screen"/>
<rdf:Description rdf:about="&a;105153478"
	 b:glossaryEntry='exhibiting openly in public view; "a display of courage"'/>
<rdf:Description rdf:about="&a;105153714">
	<b:glossaryEntry>(psychiatry) the display of previously inhibited emotions (often in actions rather than words); considered to be healthy and therapeutic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105153907">
	<b:glossaryEntry>an impressive display; "it was a bewildering array of books"; "his tools were in an orderly array on the basement wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105154078"
	 b:glossaryEntry="the display of motion picture"/>
<rdf:Description rdf:about="&a;105154201">
	<b:glossaryEntry>a screening for a select audience in advance of release for the general public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105154351">
	<b:glossaryEntry>an advertisement consisting of short scenes from a motion picture that will appear in the near future</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105154515"
	 b:glossaryEntry="a preview to test audience reactions"/>
<rdf:Description rdf:about="&a;105154611">
	<b:glossaryEntry>anything that is seen; "he was a familiar sight on the television" or "they went to Paris to see the sights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105154789">
	<b:glossaryEntry>something or someone seen (especially a notable or unusual sight); "the tragic spectacle of cripples trying to escape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105154963"
	 b:glossaryEntry="a showy outward display"/>
<rdf:Description rdf:about="&a;105155126"
	 b:glossaryEntry="a swaggering show of courage"/>
<rdf:Description rdf:about="&a;105155218">
	<b:glossaryEntry>extravagant and conspicuous behavior intended to attract attention to yourself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105155356"
	 b:glossaryEntry="an ostentatious display (of effort or extravagance etc.)"/>
<rdf:Description rdf:about="&a;105155466"
	 b:glossaryEntry="a ostentatious and inappropriate display of learning"/>
<rdf:Description rdf:about="&a;105155573"
	 b:glossaryEntry="the act of waving"/>
<rdf:Description rdf:about="&a;105155656"
	 b:glossaryEntry="a display of ornamental language"/>
<rdf:Description rdf:about="&a;105155743"
	 b:glossaryEntry='a showy gesture; "she entered with a great flourish"'/>
<rdf:Description rdf:about="&a;105155850">
	<b:glossaryEntry>the act of displaying something ostentatiously; "his behavior was an outrageous flaunt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105156002">
	<b:glossaryEntry>the act of making something publicly available; presenting news or other information by broadcasting or printing it; "he prepared his presentation carefully in advance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105156265"
	 b:glossaryEntry="putting on display for the first time"/>
<rdf:Description rdf:about="&a;105156358">
	<b:glossaryEntry>a dramatic or musical entertainment; "the play ran for 100 performances" or "the frequent performances of the symphony testify to its popularity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105156818">
	<b:glossaryEntry>a short theatrical performance that is part of a longer program; "he did his act three times every evening"; "she had a catchy little routine"; "it was one of the best numbers he ever did"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105157088"
	 b:glossaryEntry="a performance to raise money for a charitable cause"/>
<rdf:Description rdf:about="&a;105157211"
	 b:glossaryEntry="a concert given for the benefit of some charitable cause"/>
<rdf:Description rdf:about="&a;105157329">
	<b:glossaryEntry>a performance of music by players or singers not involving theatrical staging</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105157478"
	 b:glossaryEntry="a performance of rock music"/>
<rdf:Description rdf:about="&a;105157564">
	<b:glossaryEntry>performance by or technique of a pianist; "a program of pianism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105157682"
	 b:glossaryEntry="performance of a play by a group of readers"/>
<rdf:Description rdf:about="&a;105157784"
	 b:glossaryEntry="the first public performance of a play or movie"/>
<rdf:Description rdf:about="&a;105157886"
	 b:glossaryEntry="performance of music or dance especially by soloists"/>
<rdf:Description rdf:about="&a;105157992">
	<b:glossaryEntry>a performance of a musical composition or a dramatic role etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105158122"
	 b:glossaryEntry="theatrical performance combining singing and dancing"/>
<rdf:Description rdf:about="&a;105158235"
	 b:glossaryEntry="a performance of play"/>
<rdf:Description rdf:about="&a;105158370">
	<b:glossaryEntry>a theatrical performance held during the daytime (especially in the afternoon)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105158502">
	<b:glossaryEntry>a lavishly produced performance; "they put on a Christmas spectacular"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105158630">
	<b:glossaryEntry>the first public performance (as of a dramatic or musical work) anywhere in the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105158776">
	<b:glossaryEntry>a language that is deliberately created for a specific purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105159408"
	 b:glossaryEntry="an artificial language related to Ido"/>
<rdf:Description rdf:about="&a;105159498">
	<b:glossaryEntry>an artificial language intended for international use as an auxiliary language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105159628">
	<b:glossaryEntry>a simplified form of English proposed for use as an auxiliary language for international communication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105159790"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105159873"
	 b:glossaryEntry="an artificial language based on Esperanto and Ido"/>
<rdf:Description rdf:about="&a;105159980">
	<b:glossaryEntry>an artificial language based as far as possible on words common to all the European languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105160129">
	<b:glossaryEntry>an artificial language proposed as an auxiliary European language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105160248">
	<b:glossaryEntry>an artificial language proposed for use as an auxiliary international language; based on Volapuk but with a vocabulary selected on the basis of the maximum internationality of the roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105160493">
	<b:glossaryEntry>an artificial language proposed for use as an auxiliary international language; based on words common to English and the Romance language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105160688">
	<b:glossaryEntry>an artificial language that is a revision and simplification of Esperanto</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105160811"
	 b:glossaryEntry="an artificial language based on Latin"/>
<rdf:Description rdf:about="&a;105160904">
	<b:glossaryEntry>an artificial language based on words common to the Romance languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105161044"
	 b:glossaryEntry="Latino without inflectional morphology"/>
<rdf:Description rdf:about="&a;105161149"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105161230"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105161317"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105161393"
	 b:glossaryEntry="an artificial language based on Esperanto"/>
<rdf:Description rdf:about="&a;105161494"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105161569"
	 b:glossaryEntry="an artificial language based on Latin"/>
<rdf:Description rdf:about="&a;105161662"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105161741"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105161815">
	<b:glossaryEntry>an artificial international language using characters (as mathematical symbols) instead of words to express ideas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105161985">
	<b:glossaryEntry>an artificial language for international use that rejects rejects all existing words and is based instead on an abstract analysis of ideas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105162172"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105162248"
	 b:glossaryEntry="an artificial language"/>
<rdf:Description rdf:about="&a;105162325">
	<b:glossaryEntry>one of the first artificial language constructed for use as an auxiliary international language; based largely on English but with some German and French and Latin roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105162548">
	<b:glossaryEntry>(computer science) a language designed for programming computers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105162971">
	<b:glossaryEntry>an algorithmic language having statements that resemble algebraic expressions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105163149"
	 b:glossaryEntry="an artificial language designed to express algorithms"/>
<rdf:Description rdf:about="&a;105163287"
	 b:glossaryEntry="a language whose statements resemble terminology of the user"/>
<rdf:Description rdf:about="&a;105163487">
	<b:glossaryEntry>a low-level programing language; close approximation to machine language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105163623">
	<b:glossaryEntry>a source language consisting of procedural operators that invoke functions to be executed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105163810">
	<b:glossaryEntry>a programming language designed for use on a specific class of computers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105164022">
	<b:glossaryEntry>a problem-oriented language requiring little knowledge of the computer language into which it will be translated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105164200">
	<b:glossaryEntry>a problem-oriented language used to describe job requirements to an operating system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105164351"
	 b:glossaryEntry="a language that can be used to describe languages"/>
<rdf:Description rdf:about="&a;105164477">
	<b:glossaryEntry>a programming language whose expressions are assembled in more than one dimension</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105164702">
	<b:glossaryEntry>a computer language into which something written in another computer language is to be translated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105164879">
	<b:glossaryEntry>(computer science) a programming language that enables the programmer to associate a set of procedures with each type of data structure; "C++ is an object-oriented programming language that is an extension of C"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105165229">
	<b:glossaryEntry>a simple platform-independent object-oriented programming language used for writing applets that are downloaded from the World Wide Web by a client and run on the client''s machine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105165459">
	<b:glossaryEntry>a programming language whose expressions are represented by strings of characters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105165629"
	 b:glossaryEntry="a language that cannot be used as its own metalanguage"/>
<rdf:Description rdf:about="&a;105165767"
	 b:glossaryEntry="a language used to describe the syntax of another language"/>
<rdf:Description rdf:about="&a;105165887">
	<b:glossaryEntry>a programming language that (like natural language) can be used as its own metalanguage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105166060">
	<b:glossaryEntry>ALGOrithmic Language; a programming language used to express computer programs as algorithms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105166205">
	<b:glossaryEntry>a flexible procedure-oriented programing language that manipulates symbols in the form of lists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105166378"
	 b:glossaryEntry="a program written in LISP"/>
<rdf:Description rdf:about="&a;105166462">
	<b:glossaryEntry>a computer language designed in Europe to support natural language processing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105166631">
	<b:glossaryEntry>FORmula TRANslation; high-level programing language for mathematical and scientific purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105166777"
	 b:glossaryEntry="a program written in FORTRAN"/>
<rdf:Description rdf:about="&a;105166867"
	 b:glossaryEntry="COmmon Business Oriented Language"/>
<rdf:Description rdf:about="&a;105166952">
	<b:glossaryEntry>a general-purpose programing language closely associated with the UNIX operating system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105167087"
	 b:glossaryEntry="a program written in C"/>
<rdf:Description rdf:about="&a;105167165">
	<b:glossaryEntry>a popular programming language that is relatively easy to learn (Beginner''s All-purpose Symbolic Instruction Code); no longer in general use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105167357">
	<b:glossaryEntry>a programing language designed to teach programming through a top-down modular approach</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105167497">
	<b:glossaryEntry>a human written or spoken language used by a community; opposed to e.g. a computer language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105168056"
	 b:glossaryEntry="a language used for international communication"/>
<rdf:Description rdf:about="&a;105168195">
	<b:glossaryEntry>one''s native language; the language learned by children and passed from one generation to the next</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105168390">
	<b:glossaryEntry>a language in which different tones distinguish different meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105168588"
	 b:glossaryEntry="a tone language that uses pitch changes"/>
<rdf:Description rdf:about="&a;105168690"
	 b:glossaryEntry="a tone language that uses different voice registers"/>
<rdf:Description rdf:about="&a;105168805">
	<b:glossaryEntry>a mother tongue that originates from contact between two languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105168924">
	<b:glossaryEntry>an artificial language used for trade between speakers of different languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105169072">
	<b:glossaryEntry>a pidgin incorporating Chinook and French and English words; formerly used as a lingua franca in NW North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105169262"
	 b:glossaryEntry="a trade language widely used in Chad"/>
<rdf:Description rdf:about="&a;105169350"
	 b:glossaryEntry="a common language used by speakers of different languages"/>
<rdf:Description rdf:about="&a;105169475"
	 b:glossaryEntry="any of the languages spoken by Amerindians"/>
<rdf:Description rdf:about="&a;105169989">
	<b:glossaryEntry>family of North American Indian languages spoken from Labrador to Carolina and W to the Great Plains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105170540">
	<b:glossaryEntry>a language spoken by the Atakapa people of the Gulf coast of Louisiana and Texas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105170708">
	<b:glossaryEntry>a group of Amerindian languages (the name coined by an American anthropologist, Edward Sapir)</b:glossaryEntry>
</rdf:Description>
