<rdf:Description rdf:about="&a;201607793"
	 b:glossaryEntry='supply with a gate: "The house was gated"'/>
<rdf:Description rdf:about="&a;201607896"
	 b:glossaryEntry="buy on impulse without proper reflection"/>
<rdf:Description rdf:about="&a;201608005"
	 b:glossaryEntry="provide with an index, as of a book"/>
<rdf:Description rdf:about="&a;201608103"
	 b:glossaryEntry="provide with a joint, as of two pieces of wood"/>
<rdf:Description rdf:about="&a;201608225"
	 b:glossaryEntry="provide with electrical circuits, as of a house or a car"/>
<rdf:Description rdf:about="&a;201608361"
	 b:glossaryEntry="provide with new wiring"/>
<rdf:Description rdf:about="&a;201608448">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give, sell, or transfer to another; "She disposed of her parents'' possessions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201608599"
	 b:glossaryEntry="pay a kickback; make an illegal payment"/>
<rdf:Description rdf:about="&a;201608713">
	<b:glossaryEntry>get in addition, as an increase; "The candidate picked up thousands of votes after his visit to the nursing home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201608899">
	<b:glossaryEntry>achieve a point or goal, as in a sport; "Nicklaus had a 70"; "The Brazilian team got 4 goals"; "She made 29 points that day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201609124">
	<b:glossaryEntry>supply in large amounts or quantities: "We poured money into the education of our children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201609277">
	<b:glossaryEntry>dispose of by selling; "The chairman of the company told the salesmen to move the computers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201609431">
	<b:glossaryEntry>refrain from taking; "Please leave the hand-outs on the tables"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201609554"
	 b:glossaryEntry='supply in great quantities; "Pump money into a project"'/>
<rdf:Description rdf:about="&a;201609671">
	<b:glossaryEntry>put into the care or protection of someone; "He left the decision to his deputy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201609825"
	 b:glossaryEntry='provide with fuel; "Oil fires the furnace"'/>
<rdf:Description rdf:about="&a;201609936"
	 b:glossaryEntry='show appreciation to; "He remembered her in his will"'/>
<rdf:Description rdf:about="&a;201610064">
	<b:glossaryEntry>supply with an excess of; "flood the market with tennis shoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201610218"
	 b:glossaryEntry="add as an extra or as a gratuity"/>
<rdf:Description rdf:about="&a;201610316"
	 b:glossaryEntry='return in kind; "return a compliment"; "return her love"'/>
<rdf:Description rdf:about="&a;201610436"
	 b:glossaryEntry='avoid the spending or waste of; "This move will save money"'/>
<rdf:Description rdf:about="&a;201610558"
	 b:glossaryEntry="provide with a toggle or toggles"/>
<rdf:Description rdf:about="&a;201610654">
	<b:glossaryEntry>provide with a patch; also used metaphorically: "The field was patched with snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201610798"
	 b:glossaryEntry='provide with water: "We watered the buffalo"'/>
<rdf:Description rdf:about="&a;201610905">
	<b:glossaryEntry>afford access to; "the door opens to the patio"; "The French doors give onto a terrace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201611052"
	 b:glossaryEntry='obtain illegally or unscrupulously; "Grab power"'/>
<rdf:Description rdf:about="&a;201611162"
	 b:glossaryEntry='present; "deliver a speech"; "deliver a blow"'/>
<rdf:Description rdf:about="&a;201611298">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deliver, as of a blow; "He landed several blows on his opponent''s head"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201611431">
	<b:glossaryEntry>to be given by assignment or distribution; "The most difficult task fell on the youngest member of the team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201611601">
	<b:glossaryEntry>to be given by right or inheritance; "The estate fell to the oldest daughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201611740"
	 b:glossaryEntry='demand payment of, as of a loan; "Call a loan"'/>
<rdf:Description rdf:about="&a;201611876"
	 b:glossaryEntry='have on the surface or on the skin; "carry scars"'/>
<rdf:Description rdf:about="&a;201611988">
	<b:glossaryEntry>acquire as a result of some effort or action; "You cannot get water out of a stone"; "Where did she get these news?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201612201">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deliver in exchange or recompense: "I''ll give you three books for four CDs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201612338"
	 b:glossaryEntry='provide with leverage; "We need to leverage this company"'/>
<rdf:Description rdf:about="&a;201612469">
	<b:glossaryEntry>supplement with leverage; "leverage the money that is already available"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201612615">
	<b:glossaryEntry>leave voluntarily; of a job, post or position; "She vacated the position when she got pregnant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201612822">
	<b:glossaryEntry>perform an action; "think before you act"; "We must move quickly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201614213">
	<b:glossaryEntry>act in a specified way; "This factor played only a minor part in his decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201614361">
	<b:glossaryEntry>take action with respect to (someone or something): "How are we going to deal with this problem?" "The teacher knew how to deal with these lazy students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201614576"
	 b:glossaryEntry='not act; "He thought of a reply but let it go"'/>
<rdf:Description rdf:about="&a;201614689">
	<b:glossaryEntry>shun the company of others; "The new student keeps to herself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201614806">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to conceal something in the hopes it won''t be discovered by others; "The president tried to sweep the embarassing incident under the rug"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201615020"
	 b:glossaryEntry='act as a partner; "Astaire partnered Rogers"'/>
<rdf:Description rdf:about="&a;201615129">
	<b:glossaryEntry>make a great effort at a mental or physical task; "exert oneself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201615275">
	<b:glossaryEntry xml:space='preserve'><![CDATA[exert (oneself) excessively; "don''t overexert yourself when exercising!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201615415">
	<b:glossaryEntry xml:space='preserve'><![CDATA[act in a way that attracts attention; "This teacher always egotrips and the students don''t like him"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201615580">
	<b:glossaryEntry>act, feel, or give in return; "We always invite the neighbors and they never reciprocate!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201615757">
	<b:glossaryEntry>follow a procedure or take a course; "We should go farther in this matter"; "She went through a lot of trouble"; "go about the world in a certain manner"; "Messages must go through diplomatic channels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201616131">
	<b:glossaryEntry xml:space='preserve'><![CDATA[work one''s way through a problem or task; "Start from the bottom and work towards the top"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201616283">
	<b:glossaryEntry>proceed somewhere despite the risk of possible dangers; "We ventured into the world of high-tech and bought a supercomputer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201616489">
	<b:glossaryEntry>proceed with great force; "The new teacher tends to steamroller"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201616630">
	<b:glossaryEntry xml:space='preserve'><![CDATA[insist on having one''s opinions and rights recognized; "Women should assert themselves more!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201616801"
	 b:glossaryEntry='nearly do something; "She came close to quitting her job"'/>
<rdf:Description rdf:about="&a;201616926">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be inactive or indifferent while something is happening; "Don''t just sit by while your rights are violated!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201617109">
	<b:glossaryEntry>go through very fast; "We whipped through the last papers that we had to read before the weekend"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201617276"
	 b:glossaryEntry='push or force; "He bulled through his demands"'/>
<rdf:Description rdf:about="&a;201617399">
	<b:glossaryEntry>display excessive cordiality (towards); "he is always backslapping his colleagues at staff meetings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201617573">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perform to the end; "We''ve got to play this out"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201617687"
	 b:glossaryEntry='perform a function; "Who will perform the wedding?"'/>
<rdf:Description rdf:about="&a;201617829">
	<b:glossaryEntry>take upon oneself; act presumptuously, without permission; "How dare you call my lawyer?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201618013">
	<b:glossaryEntry>carry out or participate in an activity; be involved in; "She pursued many activities"; "They engaged in a discussion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201618260"
	 b:glossaryEntry='engage at close quarters; "close with the enemy"'/>
<rdf:Description rdf:about="&a;201618371">
	<b:glossaryEntry>engage in political activities; "This colleague is always politicking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201618507">
	<b:glossaryEntry>as of wars, battles, or campaigns; "Napoleon and Hitler waged war against all of Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201618684"
	 b:glossaryEntry='mount or put up; "put up a good fight"; "offer resistance"'/>
<rdf:Description rdf:about="&a;201618824"
	 b:glossaryEntry='carry further or advance; "Can you act on this matter soon?"'/>
<rdf:Description rdf:about="&a;201618990">
	<b:glossaryEntry xml:space='preserve'><![CDATA[regulate one''s behavior in accordance with certain information, ideas, or advice; "The Founding Fathers acted on certain moral principles"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201619192"
	 b:glossaryEntry='trace; "We are running down a few tips"'/>
<rdf:Description rdf:about="&a;201619317">
	<b:glossaryEntry>act together or towards others or with others; "He should interact more with his colleagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201619807">
	<b:glossaryEntry>behave in a certain way towards others; "He deals fairly with his employees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201619945">
	<b:glossaryEntry>join for a common purpose or in a common action; "These forces combined with others"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201620136"
	 b:glossaryEntry="form or constitute a cumulative effect"/>
<rdf:Description rdf:about="&a;201620247">
	<b:glossaryEntry>be inactive, as if asleep; "His work lay dormant for many years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201620370">
	<b:glossaryEntry>have a personal or business relationship with someone; "have a postdoc"; "have an assistant"; "have a lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201620540">
	<b:glossaryEntry>act against or in opposition to; "She reacts negatively to everything I say"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201620750"
	 b:glossaryEntry='resist; "buck the trend"'/>
<rdf:Description rdf:about="&a;201620849">
	<b:glossaryEntry>have an unexpected and undesired effect; "Your comments may backfire and cause you a lot of trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201621026">
	<b:glossaryEntry>give up, such as power, as of monarchs and emperors, or duties and obligations; "The King abdicated when he married a divorcee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201621230">
	<b:glossaryEntry>begin work or acting in a certain capacity, office or job; "Take up a position"; "start a new job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201621401">
	<b:glossaryEntry xml:space='preserve'><![CDATA[go into retirement; stop performing one''s work or withdraw from one''s position; "He retired at age 68"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201621604"
	 b:glossaryEntry='withdraw from active participation: "He retired from chess"'/>
<rdf:Description rdf:about="&a;201621738">
	<b:glossaryEntry>make (someone) retire; "The director was retired after the scandal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201621904">
	<b:glossaryEntry>retire and pension (someone) because of age or physical inability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201622039">
	<b:glossaryEntry>let go from employment with an attractive pension; "The director was pensioned off when he got senile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201622228">
	<b:glossaryEntry>retire gracefully; "He bowed out when he realized he could no longer handle the demands of the chairmanship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201622412">
	<b:glossaryEntry>remove oneself from an obligation; "He bowed out when he heard how much work was involved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201622623"
	 b:glossaryEntry='take on duties or office; "accede to the throne"'/>
<rdf:Description rdf:about="&a;201622769">
	<b:glossaryEntry>take on titles, offices, duties, responsibilities; "When will the new President assume office?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201622977">
	<b:glossaryEntry xml:space='preserve'><![CDATA[assume anew; "resume a title"; "resume an office"; "resume one''s duties"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201623113">
	<b:glossaryEntry>conduct a ceremony, such as a wedding; "Who officiated at your wedding?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201623278">
	<b:glossaryEntry>resign or retire from a position; "The Secretary fo the Navy will leave office next month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201623545">
	<b:glossaryEntry>leave school or some other program prematurely; "Many students drop out because they are not prepared for our challenging program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201623741"
	 b:glossaryEntry="leave home, school, a position, etc."/>
<rdf:Description rdf:about="&a;201623893">
	<b:glossaryEntry>assume an office, duty, or title; "When will the new President take office?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201624108">
	<b:glossaryEntry>put into an office or a position; "the new president was installed immediately after the election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201624297">
	<b:glossaryEntry>place ceremoniously or formally in an office or position; "We were inducted into the honor society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201624484">
	<b:glossaryEntry xml:space='preserve'><![CDATA[invite someone to one''s house; "Can I invite you for dinner on Sunday night?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201624648"
	 b:glossaryEntry='have as a guest; "I invited them to a restaurant"'/>
<rdf:Description rdf:about="&a;201624789">
	<b:glossaryEntry>lose office or power; "The government fell overnight"; "The Qing Dynasty fell with Sun Yat-sen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201624972"
	 b:glossaryEntry="deprive of status or authority"/>
<rdf:Description rdf:about="&a;201625128">
	<b:glossaryEntry>assign to a post; put into a post; "The newspaper posted him in Timbuktu"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201625271">
	<b:glossaryEntry>assign the roles of (a movie or a play) to actors; "Who cast this beautiful movie?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201625416"
	 b:glossaryEntry='of clerical posts; "he was ordained in the Church"'/>
<rdf:Description rdf:about="&a;201625559">
	<b:glossaryEntry>be ordained; enter the Christian ministry; "She took orders last month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201625681"
	 b:glossaryEntry="provide with power and authority"/>
<rdf:Description rdf:about="&a;201625903"
	 b:glossaryEntry="furnish with power or authority; of kings or emperors"/>
<rdf:Description rdf:about="&a;201626038"
	 b:glossaryEntry="invest with knighthood; make of knight of"/>
<rdf:Description rdf:about="&a;201626149">
	<b:glossaryEntry>train for a social environment; "The children must be properly socialized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201626290">
	<b:glossaryEntry>prepare for a future role or function; "He is grooming his son to become his successor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201626476">
	<b:glossaryEntry>give an education to; "We must educate our youngsters better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201626656">
	<b:glossaryEntry>educate in or as if in a school; "The children are schooled at great cost to their parents in private institutions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201626835">
	<b:glossaryEntry>train to be discriminative; as of taste or judgment; "Cultivate your musical taste"; "Train your tastebuds"; "She is well schooled in poetry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201627108"
	 b:glossaryEntry="make less natural or innocent"/>
<rdf:Description rdf:about="&a;201627207">
	<b:glossaryEntry>be social or interact with others; "He never socializes with his colleagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201627430">
	<b:glossaryEntry>establish communication with someone; "did you finally connect with your long-lost cousin?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201627640">
	<b:glossaryEntry>establish a rapport or relationship; "The President of this university really connects with the faculty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201627827"
	 b:glossaryEntry="be a social swinger; socialize a lot"/>
<rdf:Description rdf:about="&a;201627939"
	 b:glossaryEntry="be on friendly terms with someone"/>
<rdf:Description rdf:about="&a;201628048"
	 b:glossaryEntry='rub elbows with; "He hobnobs with the best of society"'/>
<rdf:Description rdf:about="&a;201628177">
	<b:glossaryEntry>accept young people into society, usually with some rite; "African men are initiated when they reach puberty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201628369">
	<b:glossaryEntry>admit again or anew; "After paying a penalty, the player was readmitted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201628514">
	<b:glossaryEntry>invest with regal power; enthrone; "The prince was crowned in Westminster Abbey"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201628668">
	<b:glossaryEntry>put a monarch on the throne; "The Queen was enthroned more than 50 years ago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201628838">
	<b:glossaryEntry>remove a monarch from the throne; "If the King does not abdicate, he will have to be dethroned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201629017">
	<b:glossaryEntry>remove from political office; "The Republicans are trying to unseat the liberal Democrat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201629170">
	<b:glossaryEntry>give an assignment to (a person) to a post, or assign a task to (a person)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201629608">
	<b:glossaryEntry>pass on or delegate to another; "The representative devolved his duties to his aides while he was in the hospital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201629787">
	<b:glossaryEntry>assign a task to; "I tasked him with looking after the children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201629913">
	<b:glossaryEntry>place somebody in a particular situation or location: "he was placed on probation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201630058"
	 b:glossaryEntry="assign to a regiment, of soldiers"/>
<rdf:Description rdf:about="&a;201630157">
	<b:glossaryEntry>transfer somebody to a different position or location of work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201630321"
	 b:glossaryEntry="exchange prisoners, employees, etc."/>
<rdf:Description rdf:about="&a;201630440">
	<b:glossaryEntry>exchange people temporarily to fulfill certain jobs and functions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201630590">
	<b:glossaryEntry>exchange on a regular basis; "We rotate the lead soprano every night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201630741"
	 b:glossaryEntry="appoint someone to (a position or a job)"/>
<rdf:Description rdf:about="&a;201630843">
	<b:glossaryEntry>assume, as of positions or roles; "She took the job as director of development"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201630991"
	 b:glossaryEntry="appoint as a substitute"/>
<rdf:Description rdf:about="&a;201631100"
	 b:glossaryEntry="act as a substitute for"/>
<rdf:Description rdf:about="&a;201631241">
	<b:glossaryEntry>to take an action to protect against future problems; "Count the cash in the drawer twice just to cover yourself."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201631436">
	<b:glossaryEntry xml:space='preserve'><![CDATA[help out by taking someone''s place an temporarily assuming his responsibilities; "She is covering for our secretary who is ill this week"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201631636"
	 b:glossaryEntry="transfer power to someone"/>
<rdf:Description rdf:about="&a;201631736"
	 b:glossaryEntry="assign under a mandate; of nations"/>
<rdf:Description rdf:about="&a;201631835"
	 b:glossaryEntry="commence officially"/>
<rdf:Description rdf:about="&a;201631977">
	<b:glossaryEntry>open to public use, as of a highway, park, or building; "The Beauty Queen spends her time dedicating parks and bursing homes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201632168"
	 b:glossaryEntry="as of a committee for a temporary task"/>
<rdf:Description rdf:about="&a;201632356">
	<b:glossaryEntry xml:space='preserve'><![CDATA[set up a committee or legislative body with one''s own supporters so as to influence the outcome; "pack a jury"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201632536">
	<b:glossaryEntry>charge with a function; charge to be; "She was named Head of the Committee"; "She was made president of the club"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201632747">
	<b:glossaryEntry>name again or anew; "He was renamed Minister of the Interior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201632872">
	<b:glossaryEntry>enter on a list or slate for an election; "He was slated for borough president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201633014"
	 b:glossaryEntry="place onto a board or committee"/>
<rdf:Description rdf:about="&a;201633117"
	 b:glossaryEntry="appoint summarily or commandeer"/>
<rdf:Description rdf:about="&a;201633212">
	<b:glossaryEntry>give life-time employment to; as of university posts; "She was tenured after she published her book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201633376">
	<b:glossaryEntry>give a promotion to; "raise in rank"; assign to a higher position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201633704">
	<b:glossaryEntry>promote from a lower position or rank; "This pplayer was brought up to the major league"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201633858">
	<b:glossaryEntry>promote on the spot; "Supreme Bishop Digby had been spot-promoted to Archangel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201634008">
	<b:glossaryEntry>give a title to someone; make someone a member of the nobility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201634190"
	 b:glossaryEntry="make a lord of someone"/>
<rdf:Description rdf:about="&a;201634274">
	<b:glossaryEntry>assign great social importance to; "The film director war celebrated all over Hollywood"; "The tenor was lionized in Vienna"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201634475"
	 b:glossaryEntry='raise (someone) to knighthood; "The Beatles were knighted"'/>
<rdf:Description rdf:about="&a;201634597">
	<b:glossaryEntry>assign to a lower position; reduce in rank; "She was demoted because she always speaks up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201634858">
	<b:glossaryEntry>bring to humbler or weaker state or condition; "He reduced the population to slavery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201635007"
	 b:glossaryEntry="promote over another"/>
<rdf:Description rdf:about="&a;201635134"
	 b:glossaryEntry="give preference to one creditor over another; in law"/>
<rdf:Description rdf:about="&a;201635250">
	<b:glossaryEntry>examine in order to test suitability; "screen these samples"; "screen the job applicants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201635455"
	 b:glossaryEntry='elect in a voting process; "They voted in Clinton"'/>
<rdf:Description rdf:about="&a;201635578">
	<b:glossaryEntry>select by a vote for an office or membership; "We elected him chairman of the board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201635761">
	<b:glossaryEntry>choose or elect as a fellow member or colleague; "The church members co-opted individuals from similar backgrounds to replenish the congregation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201635970"
	 b:glossaryEntry="elect again"/>
<rdf:Description rdf:about="&a;201636055">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as to represent; of legal counsel; "I''m retaining a lawyer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201636187">
	<b:glossaryEntry>put forward; nominate for appointment to an office; "The President nominated her as head of the Civil Rights Commission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201636409"
	 b:glossaryEntry="remove from office"/>
<rdf:Description rdf:about="&a;201636568"
	 b:glossaryEntry="act quickly and decisively; not let slip an opportunity"/>
<rdf:Description rdf:about="&a;201636706"
	 b:glossaryEntry='cause the downfall of; of rulers; "The Czar was overthrown"'/>
<rdf:Description rdf:about="&a;201636882"
	 b:glossaryEntry="overthrow by a revolution, of governments"/>
<rdf:Description rdf:about="&a;201636994">
	<b:glossaryEntry>terminate the employment of; "The boss fired his secretary today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201637343"
	 b:glossaryEntry='force out: "The new boss cleaned out the lazy workers"'/>
<rdf:Description rdf:about="&a;201637484"
	 b:glossaryEntry="dismiss, usually for economic reasons"/>
<rdf:Description rdf:about="&a;201637597">
	<b:glossaryEntry>terminate an association with; "drop him from the Republican ticket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201637735">
	<b:glossaryEntry>force out; "Some emplyees were squeezed out by the recent budget cuts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201637882"
	 b:glossaryEntry="remove from a position or an office"/>
<rdf:Description rdf:about="&a;201638107">
	<b:glossaryEntry>cause to withdraw; "We pulled this firm off the project because they overcharged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201638262">
	<b:glossaryEntry>force from a place or position; "The committee winkled out the unqualified candidates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201638424"
	 b:glossaryEntry="force to retire, remove from active duty, as of firemen"/>
<rdf:Description rdf:about="&a;201638544">
	<b:glossaryEntry>cause to leave; "The teacher took the children out of the classroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201638760">
	<b:glossaryEntry>take a player out of a game in order to exchange for another player</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201638892"
	 b:glossaryEntry="force to leave (an office)"/>
<rdf:Description rdf:about="&a;201639012"
	 b:glossaryEntry="take the place of"/>
<rdf:Description rdf:about="&a;201639176"
	 b:glossaryEntry='be the successor of; "Carter followed Ford"'/>
<rdf:Description rdf:about="&a;201639350">
	<b:glossaryEntry>exert oneself; "She tugged for years to make a decent living"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201639540">
	<b:glossaryEntry>make a strenuous or labored effort; "She struggled for years to survive without welfare"; "He fought for breath"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201639762">
	<b:glossaryEntry>behave awkwardly; have difficulties; "She is floundering in college"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201639896"
	 b:glossaryEntry="be the predecessor of"/>
<rdf:Description rdf:about="&a;201640004"
	 b:glossaryEntry='cause to work; "he is working his servants hard"'/>
<rdf:Description rdf:about="&a;201640262">
	<b:glossaryEntry>drive or work too hard; "The teacher is overworking his students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201640394">
	<b:glossaryEntry>work by a rack and pinion or worm so as to extend or contract; "rack a camera"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201640534"
	 b:glossaryEntry="work as a carpenter"/>
<rdf:Description rdf:about="&a;201640620"
	 b:glossaryEntry='make use of; "implement a procedure"'/>
<rdf:Description rdf:about="&a;201640759"
	 b:glossaryEntry="apply incorrectly or badly"/>
<rdf:Description rdf:about="&a;201640852"
	 b:glossaryEntry="work excessively hard"/>
<rdf:Description rdf:about="&a;201640975"
	 b:glossaryEntry="press into servitude"/>
<rdf:Description rdf:about="&a;201641059">
	<b:glossaryEntry>engage or hire for work; "They hired two new secretaries in the department"; "How many people has she employed?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201641377">
	<b:glossaryEntry>engage by written agreement; "They signed two new pitchers for the next season"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201641581">
	<b:glossaryEntry>allow to remain in a place or position; "We cannot continue several servants any longer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201641788"
	 b:glossaryEntry="assign a job to someone outside one''s own business"/>
<rdf:Description rdf:about="&a;201641924">
	<b:glossaryEntry>be employed; "Is your husband working again?" "My wife never worked"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201642324"
	 b:glossaryEntry="work as a cooper"/>
<rdf:Description rdf:about="&a;201642404"
	 b:glossaryEntry="work as a clerk, as in the legal business"/>
<rdf:Description rdf:about="&a;201642516"
	 b:glossaryEntry="take time off from work; stop working temporarily"/>
<rdf:Description rdf:about="&a;201642655"
	 b:glossaryEntry="be relieved of one''s duties temporarily"/>
<rdf:Description rdf:about="&a;201642741"
	 b:glossaryEntry="free someone temporarily form his or her obligations"/>
<rdf:Description rdf:about="&a;201642878"
	 b:glossaryEntry='work as a page; "He is paging in Congress this summer"'/>
<rdf:Description rdf:about="&a;201642994">
	<b:glossaryEntry>stop work in order to press demands; "The auto workers are striking for higher wages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201643154"
	 b:glossaryEntry="take the place of work of someone on strike"/>
<rdf:Description rdf:about="&a;201643276"
	 b:glossaryEntry="employ scabs or strike breakers in (an industry)"/>
<rdf:Description rdf:about="&a;201643385">
	<b:glossaryEntry xml:space='preserve'><![CDATA[wait on tables; serve as a waiter; in restaurants "I''m waiting on tables at Maxim''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201643531"
	 b:glossaryEntry="exert oneself by doing mental or physical work"/>
<rdf:Description rdf:about="&a;201643863"
	 b:glossaryEntry="act as an assistant in a subordinate or supportive function"/>
<rdf:Description rdf:about="&a;201644030"
	 b:glossaryEntry="work hard on something"/>
<rdf:Description rdf:about="&a;201644138">
	<b:glossaryEntry>to exert effort in order to do, make, or perform something: she worked at it until she had it down cold.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201644335"
	 b:glossaryEntry='to work at or to absurd length: "belabor the obvious"'/>
<rdf:Description rdf:about="&a;201644464">
	<b:glossaryEntry>work lightly; "The old lady is pottering around in the garden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201644607">
	<b:glossaryEntry>work doggedly or persistently; "She keeps plugging away at her dissertation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201644776">
	<b:glossaryEntry>keep busy with; "She busies herself with her butterfly collection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201644957">
	<b:glossaryEntry>work with in a non-serious manner; "She dabbles in astronomy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201645167">
	<b:glossaryEntry>work together on a common enterprise of project; "The soprano and the pianist did not get together very well"; "We joined forces with another research group"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201645461"
	 b:glossaryEntry="conduct financial operations, often in an unethical manner"/>
<rdf:Description rdf:about="&a;201645586"
	 b:glossaryEntry="act together, as of organisms"/>
<rdf:Description rdf:about="&a;201645678">
	<b:glossaryEntry>cooperate or pretend to cooperate; "He decided to play long with with the burglars for the moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201645863"
	 b:glossaryEntry="give one''s silent approval to"/>
<rdf:Description rdf:about="&a;201645978"
	 b:glossaryEntry="spent time in idleness"/>
<rdf:Description rdf:about="&a;201646170"
	 b:glossaryEntry="be idle in a listless or dreamy way"/>
<rdf:Description rdf:about="&a;201646291">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be out of the game; in sports; "Miller was riding the bench in Saturday''s game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201646459">
	<b:glossaryEntry>have dreamlike musings or fantasies while awake; "She looked out the window, daydreaming"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201646621">
	<b:glossaryEntry>engage in recreational activities rather than work; occupy oneself in a diversion; "On weekends I play"; "The students all recreate alike"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201646814">
	<b:glossaryEntry>be at play; be engaged in playful activity; typical of children; "The kids were playing outside all day"; "I used to play with trucks as a little girl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201647063"
	 b:glossaryEntry="play in or as if in water, as of small children"/>
<rdf:Description rdf:about="&a;201647223"
	 b:glossaryEntry='work hard; "She was digging away at her math homework"'/>
<rdf:Description rdf:about="&a;201647410"
	 b:glossaryEntry="be a farmer; work as a farmer"/>
<rdf:Description rdf:about="&a;201647501"
	 b:glossaryEntry="work a second job"/>
<rdf:Description rdf:about="&a;201647593"
	 b:glossaryEntry="work occasionally"/>
<rdf:Description rdf:about="&a;201647671"
	 b:glossaryEntry="take charge of a certain job; occupy a certain work place"/>
<rdf:Description rdf:about="&a;201647789"
	 b:glossaryEntry="work very hard, like a slave"/>
<rdf:Description rdf:about="&a;201647928"
	 b:glossaryEntry="work on a free-lance basis"/>
<rdf:Description rdf:about="&a;201648022"
	 b:glossaryEntry="grant freedom to; free from confinement"/>
<rdf:Description rdf:about="&a;201648260"
	 b:glossaryEntry="set animals loose to graze"/>
<rdf:Description rdf:about="&a;201648347"
	 b:glossaryEntry="free from obligations or duties"/>
<rdf:Description rdf:about="&a;201648568">
	<b:glossaryEntry>discharge from a group; "The coach cut two players from the team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201648694">
	<b:glossaryEntry>free from payment of customs duties, as of a shipment; "Clear the ship and let it dock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201648845"
	 b:glossaryEntry="discharge with dishonor, as in the army"/>
<rdf:Description rdf:about="&a;201648949"
	 b:glossaryEntry="keep under control"/>
<rdf:Description rdf:about="&a;201649126">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make it possible through lack of action for something to happen; "This permits the water to rush in"; "This sealed door won''t allow the water come into the basement"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201649395">
	<b:glossaryEntry>allow to go without comment or censure: "the insult passed as if unnoticed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201649532"
	 b:glossaryEntry='allow the other team to score: "give up a run", in baseball'/>
<rdf:Description rdf:about="&a;201649646"
	 b:glossaryEntry="control and refrain from showing; of emotions"/>
<rdf:Description rdf:about="&a;201649787">
	<b:glossaryEntry>check or slow down the action or effect of; "She choked her anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201649916">
	<b:glossaryEntry>put down by force or intimidation; "The government quashes any attempt of an uprising"; "China keeps down her dissidents very efficiently"; "The rich landowners subjugated the peasants working the land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201650267">
	<b:glossaryEntry>become more restrictive or repressive; impose strict controls on; "They are clamping down on under-age drinking now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201650459">
	<b:glossaryEntry>get serious about enforcing a rule; "We have to clamp down and get tough on the dissidents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201650638"
	 b:glossaryEntry='come down on; "The government oppresses political activists"'/>
<rdf:Description rdf:about="&a;201650798"
	 b:glossaryEntry="do volunteer work"/>
<rdf:Description rdf:about="&a;201650890">
	<b:glossaryEntry>agree freely; "She volunteered to drive the old lady home"; "I offered to help with the dishes but the hostess would not hear of it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201651097"
	 b:glossaryEntry="advise professionally; work as a consultant"/>
<rdf:Description rdf:about="&a;201651229"
	 b:glossaryEntry="open ceremoniously or dedicate formally"/>
<rdf:Description rdf:about="&a;201651336">
	<b:glossaryEntry>begin or set in action, of meetings, speeches, recitals, etc.; "He opened the meeting with a long speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201651565">
	<b:glossaryEntry>finish or terminate; of meetings, speeches, etc. "The meeting was closed with a charge by the chairman of the board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201651770">
	<b:glossaryEntry>start to operate or function or cause to start operating or functioning; "open a business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201651958">
	<b:glossaryEntry>cease to operate or cause to cease operating; "The owners decided to move and to close the factory"; "My business closes every night at 8 P.M.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201652221">
	<b:glossaryEntry>bring back into its original existence or use; "restore law and order"; "reestablish peace in the region"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201652417"
	 b:glossaryEntry='set up or found; "She set up a literacy program"'/>
<rdf:Description rdf:about="&a;201652576">
	<b:glossaryEntry>do away with; "Slavery was abolished in the mid-19th century in America and in Russia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201652784">
	<b:glossaryEntry>discard or do away with; "cashier the literal sense of this word"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201652914">
	<b:glossaryEntry>invest with ministerial or priestly authority; "The minister was ordained only last month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201653086"
	 b:glossaryEntry='authorize as a rabbi; "Our rabbi was ordained in Spain"'/>
<rdf:Description rdf:about="&a;201653223">
	<b:glossaryEntry>order by virtue of superior authority; decree; "The King ordained the persecution and expulsion of the Jews"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201653447"
	 b:glossaryEntry='enact again; "Congress reenacted the law"'/>
<rdf:Description rdf:about="&a;201653561">
	<b:glossaryEntry>do something despite obstacles such as lack of time: "He finally got around to painting the windows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201653732">
	<b:glossaryEntry>break from a meeting or gathering; "We adjourned for lunch"; "The men retired to the library"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201653962">
	<b:glossaryEntry>adjourn by royal prerogative; without dissolving the legislative body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201654097">
	<b:glossaryEntry xml:space='preserve'><![CDATA[collect in one place; "We assembled in the church basement"; "Let''s gather in the dining room"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201654378"
	 b:glossaryEntry="meet to select a candidate or promote a policy"/>
<rdf:Description rdf:about="&a;201654488"
	 b:glossaryEntry="of meetings"/>
<rdf:Description rdf:about="&a;201654572">
	<b:glossaryEntry>call a meeting; invite or command to meet; "The Wannsee Conference was called to discuss the "Final Solution"; "The new dean calls meetings every week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201654821"
	 b:glossaryEntry="attach oneself to a group"/>
<rdf:Description rdf:about="&a;201654934">
	<b:glossaryEntry>become an ally or associate, as by a treaty or marriage; "He allied himself with the Communists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201655110">
	<b:glossaryEntry>make a bad alliance; ally inappropriately; "The two countries are misallied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201655251">
	<b:glossaryEntry>part; cease or break association with; "She disassociated herself from the organization when she found out the identity of the president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201655504">
	<b:glossaryEntry>establish or impress firmly in the mind; "We imprint our ideas onto our children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201655657">
	<b:glossaryEntry>have force or influence; bring about an effect or change; "Politeness militated against this opinion being expressed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201655848">
	<b:glossaryEntry>discontinue an association or relation; go different ways; "The business partners broke over a tax question"; "The couple separated after 25 years of marriage"; "My friend and I split up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201656236"
	 b:glossaryEntry='end a relationship; "China broke with Russia"'/>
<rdf:Description rdf:about="&a;201656373">
	<b:glossaryEntry>work in an administrative capacity; supervise; "administer a program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201656551"
	 b:glossaryEntry="cause to be organized"/>
<rdf:Description rdf:about="&a;201656726">
	<b:glossaryEntry xml:space='preserve'><![CDATA[organize anew; "We must reorganize the company if we don''t want to go under"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201656899"
	 b:glossaryEntry="organize anew, as after a setback"/>
<rdf:Description rdf:about="&a;201657018">
	<b:glossaryEntry xml:space='preserve'><![CDATA[revise or reorganize, esp. for the purpose of updating and improving; "We must retool the town''s economy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201657212">
	<b:glossaryEntry>bring under collective control; of farms and industrial enterprises</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201657364"
	 b:glossaryEntry="maintain one''s position and be in control of a situation"/>
<rdf:Description rdf:about="&a;201657492"
	 b:glossaryEntry="bring under Soviet control, of a country"/>
<rdf:Description rdf:about="&a;201657599"
	 b:glossaryEntry="form or join a union"/>
<rdf:Description rdf:about="&a;201657696"
	 b:glossaryEntry="form a confederation with; of nations"/>
<rdf:Description rdf:about="&a;201657802"
	 b:glossaryEntry="untie formally; of interest groups or countries"/>
<rdf:Description rdf:about="&a;201657925">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to take one''s place in a military formation or line; "Troops fall in!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201658042">
	<b:glossaryEntry>become part of; become a member of a group or organization; "He joined the Communist Party as a young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201658377"
	 b:glossaryEntry='join in an affiliation; "The two colleges affiliated"'/>
<rdf:Description rdf:about="&a;201658505"
	 b:glossaryEntry="join again"/>
<rdf:Description rdf:about="&a;201658587"
	 b:glossaryEntry="join a group in order to spy on the members"/>
<rdf:Description rdf:about="&a;201658698"
	 b:glossaryEntry="recruit for a union"/>
<rdf:Description rdf:about="&a;201658801"
	 b:glossaryEntry="remove the organization from"/>
<rdf:Description rdf:about="&a;201658906">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be in charge of, act on, or dispose of; "I can deal with this crew of workers"; "This blender can''t handle nuts"; "She managed her parents'' affairs after they got too old"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201659412">
	<b:glossaryEntry>deal with (a problem or a subject); "I still have not come to grips with the death of my parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201659595"
	 b:glossaryEntry='deal with or settle; "He disposed of these cases quickly"'/>
<rdf:Description rdf:about="&a;201659720">
	<b:glossaryEntry xml:space='preserve'><![CDATA[behave carelessly or indifferently; "Play about with a young girl''s affection"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201659890">
	<b:glossaryEntry>be in charge of or deal with; "She takes care of all the necessary arrangements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201660070">
	<b:glossaryEntry>bring into common action, movement, or condition; "coordinate the painters, masons, and plumbers"; "coordinate his actions with that of his colleagues"; "coordinate our efforts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201660339"
	 b:glossaryEntry='be co-ordinated; "These activities co-ordinate well"'/>
<rdf:Description rdf:about="&a;201660459">
	<b:glossaryEntry>deal with simultaneously: "She had to juggle her job and her children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201660593">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deal with in a routine way: "I''ll handle that one"; "process a loan"; "process the applicants"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201660752">
	<b:glossaryEntry>process fast and efficiently; "I will try to expedite the matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201660883"
	 b:glossaryEntry='manage badly or incompetently; "The funds were mismanaged"'/>
<rdf:Description rdf:about="&a;201661033"
	 b:glossaryEntry='keep watch on; "tend a fire"'/>
<rdf:Description rdf:about="&a;201661141"
	 b:glossaryEntry="stir up or tend; of a fire"/>
<rdf:Description rdf:about="&a;201661230">
	<b:glossaryEntry>begin to deal with; "approach a task"; "go about a difficult problem"; "appraoch a new project"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201661432"
	 b:glossaryEntry="be in charge of"/>
<rdf:Description rdf:about="&a;201661609">
	<b:glossaryEntry>be a guiding force, as with directions or advice; "The teacher steered the gifted students towards the more challenging courses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201661832">
	<b:glossaryEntry>act or preside as chair, as of an academic department in a university; "She chaired the department for many years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201662020"
	 b:glossaryEntry='be in charge of; "Who is heading this project?"'/>
<rdf:Description rdf:about="&a;201662208"
	 b:glossaryEntry="be the captain of a sports team"/>
<rdf:Description rdf:about="&a;201662312">
	<b:glossaryEntry>be the leader of; "She spearheded the effort to find a cure for the disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201662455"
	 b:glossaryEntry="assume control"/>
<rdf:Description rdf:about="&a;201662617">
	<b:glossaryEntry>take charge of; "My deputy attended my affairs while I was on vacation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201662752"
	 b:glossaryEntry="seize control of"/>
<rdf:Description rdf:about="&a;201662860">
	<b:glossaryEntry>exercise authoritative control or power over; "control the budget"; "Command the military forces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201663326">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take and maintain control over, often by violent means; "The dissatisfied students held the President''s office for almost a week"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201663517"
	 b:glossaryEntry="be master; reign or rule"/>
<rdf:Description rdf:about="&a;201663616">
	<b:glossaryEntry>direct or strongly influence the behavior of; "This principle controls his behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201663764">
	<b:glossaryEntry xml:space='preserve'><![CDATA[subject to rigid discipline, order, and systematization; "regiment one''s children"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201663920">
	<b:glossaryEntry>control fully and exclusively; "He monopolizes the laser printer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201664053"
	 b:glossaryEntry="control and direct with or as if by reins; as of a horse"/>
<rdf:Description rdf:about="&a;201664203"
	 b:glossaryEntry='gain control over; "corner the gold market"'/>
<rdf:Description rdf:about="&a;201664310"
	 b:glossaryEntry='watch and direct; "Who is overseeing this project?"'/>
<rdf:Description rdf:about="&a;201664487">
	<b:glossaryEntry>order, supervise, or finance the construction of; "The government is building new schools in this state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201664654"
	 b:glossaryEntry='act as president: "preside over companies and corporations"'/>
<rdf:Description rdf:about="&a;201664787"
	 b:glossaryEntry="direct or control; of machinery, projects, businesses, etc."/>
<rdf:Description rdf:about="&a;201664971"
	 b:glossaryEntry='run on a block system; "block trains"'/>
<rdf:Description rdf:about="&a;201665071">
	<b:glossaryEntry>run until the normal working temperature is reached; "We warmed up the car for a few minutes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201665229"
	 b:glossaryEntry='authorize payments of: "declare dividends"'/>
<rdf:Description rdf:about="&a;201665336"
	 b:glossaryEntry="authorize officially"/>
<rdf:Description rdf:about="&a;201665547"
	 b:glossaryEntry="cause to be longer approved or accepted"/>
<rdf:Description rdf:about="&a;201665691"
	 b:glossaryEntry="grant rights to; grant a patent for"/>
<rdf:Description rdf:about="&a;201665790">
	<b:glossaryEntry>direct the course of; manage or control; "You cannot conduct business like this"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201665991">
	<b:glossaryEntry>act in an official capacity in some ceremony or ritual; "officiate at a wedding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201666138">
	<b:glossaryEntry>work in a specific place, with a specific subject, or in a specific function; "He is a herpetologist; "She is our resident philosopher"; "She works as a waitress to put herself through law school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201666642">
	<b:glossaryEntry>devote oneself to a special area of work; "She specializes in honey bees"; "This plumber specialized in jacuzzis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201666823">
	<b:glossaryEntry>work as a veterinarian; "She vetted for the farms in the area for many years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201666961"
	 b:glossaryEntry="work as a minister"/>
<rdf:Description rdf:about="&a;201667045"
	 b:glossaryEntry="work as an intern"/>
<rdf:Description rdf:about="&a;201667126"
	 b:glossaryEntry="work as the skipper on a vessel"/>
<rdf:Description rdf:about="&a;201667222"
	 b:glossaryEntry="act as the coxswain, in a boat race"/>
<rdf:Description rdf:about="&a;201667318"
	 b:glossaryEntry="do useless, wasteful, or trivial work"/>
<rdf:Description rdf:about="&a;201667423">
	<b:glossaryEntry>give the right to; "The Freedom of Information Act entitles you to request your FBI file"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201667577"
	 b:glossaryEntry="grant a franchise to; in commerce"/>
<rdf:Description rdf:about="&a;201667685"
	 b:glossaryEntry="grant a charter to"/>
<rdf:Description rdf:about="&a;201667768">
	<b:glossaryEntry>guarantee as meeting a certain standard; "certified grade AAA meat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201667918"
	 b:glossaryEntry="form a corporation; in business"/>
<rdf:Description rdf:about="&a;201668018"
	 b:glossaryEntry="create, as of a social group or a company, for example"/>
<rdf:Description rdf:about="&a;201668277"
	 b:glossaryEntry="form sides, as for a game"/>
<rdf:Description rdf:about="&a;201668369">
	<b:glossaryEntry>form or arrange in order or formation, as of a body of soldiers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201668521"
	 b:glossaryEntry="form into a regiment, of military personnel"/>
<rdf:Description rdf:about="&a;201668630"
	 b:glossaryEntry="form a syndicate"/>
<rdf:Description rdf:about="&a;201668713"
	 b:glossaryEntry="form a brigade"/>
<rdf:Description rdf:about="&a;201668808">
	<b:glossaryEntry>prevent from entering; shut out; "The trees were shutting out all sunlight"; "This policy excludes people who have a criminal record from entering the country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201669149"
	 b:glossaryEntry="prevent employees from working during a strike"/>
<rdf:Description rdf:about="&a;201669261">
	<b:glossaryEntry>allow participation in or the right to be part of; permit to exercise the rights, functions, and responsibilities of; "admit someone to the profession"; "She was admitted to the New Jersey Bar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201669634"
	 b:glossaryEntry="be involved in something"/>
<rdf:Description rdf:about="&a;201669783"
	 b:glossaryEntry="be active in"/>
<rdf:Description rdf:about="&a;201669882">
	<b:glossaryEntry>prevent from doing something or being in a certain state; "We must prevent the cancer from spreading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201670207"
	 b:glossaryEntry='keep from departing; "Hold the taxi"; "Hold the horse"'/>
<rdf:Description rdf:about="&a;201670331">
	<b:glossaryEntry>prevent from coming close; "I tried to keep the child away from the pool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201670479"
	 b:glossaryEntry="keep the opposing team from winning, in baseball"/>
<rdf:Description rdf:about="&a;201670590">
	<b:glossaryEntry>be a hindrance or obstacle to; "She is impeding the progress of our project"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201670845">
	<b:glossaryEntry>come between so as to be hindrance or obstacle; "Your talking interferes with my work!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201671007">
	<b:glossaryEntry>slow down the progress of; hinder; "His late start set him back"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201671137">
	<b:glossaryEntry>hamper the action or progress of;"The chairman was hobbled by the all-powerful dean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201671309">
	<b:glossaryEntry>check the growth or development of; "You will stunt your growth by building all these muscles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201671474"
	 b:glossaryEntry='prevent commerce: "The U.S. embargoes Lybia"'/>
<rdf:Description rdf:about="&a;201671583">
	<b:glossaryEntry>keep from happening of arising; have the effect of preventing; "My sense of tact forbids an honest answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201671878">
	<b:glossaryEntry xml:space='preserve'><![CDATA[prevent the occurrence of; prevent from happening; "Let''s avoid a confrontation"; "head off a confrontation"; "avert a strike"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201672156"
	 b:glossaryEntry="bestow a privilege upon"/>
<rdf:Description rdf:about="&a;201672263"
	 b:glossaryEntry="grant a privilege to"/>
<rdf:Description rdf:about="&a;201672350">
	<b:glossaryEntry>be behind; support or vote for; "He plumped for the Labor Party"; "I backed Kennedy in 1960"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201672628"
	 b:glossaryEntry="get the opinions of people, for example"/>
<rdf:Description rdf:about="&a;201672774"
	 b:glossaryEntry="canvass by distributing letters"/>
<rdf:Description rdf:about="&a;201672888"
	 b:glossaryEntry="get the votes of"/>
<rdf:Description rdf:about="&a;201672974"
	 b:glossaryEntry="maintain the security of by carrying out a control"/>
<rdf:Description rdf:about="&a;201673105">
	<b:glossaryEntry>watch over so as to protect; "We must stand sentinel to protect ourselves"; "The jewels over which they kept guard were stolen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201673353">
	<b:glossaryEntry>follow with the eyes or the mind; "Keep an eye on the baby, please!"; "The world is watching Sarajevo"; "She followed the men with the binoculars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201673681">
	<b:glossaryEntry>to keep watch over: "there would be men guarding the horses."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201673867"
	 b:glossaryEntry="act as a baby-sitter"/>
<rdf:Description rdf:about="&a;201673967"
	 b:glossaryEntry="place in a grave or tomb"/>
<rdf:Description rdf:about="&a;201674092">
	<b:glossaryEntry>dig up for reburial or for medical investigation; of dead bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201674231"
	 b:glossaryEntry='show respect towards; "honor your parents!"'/>
<rdf:Description rdf:about="&a;201674421"
	 b:glossaryEntry="show a lack of respect for"/>
<rdf:Description rdf:about="&a;201674559"
	 b:glossaryEntry="work together in harmony"/>
<rdf:Description rdf:about="&a;201674645"
	 b:glossaryEntry="have a relationship to"/>
<rdf:Description rdf:about="&a;201674865"
	 b:glossaryEntry="bring into relation with"/>
<rdf:Description rdf:about="&a;201674979">
	<b:glossaryEntry>resume a relationship with someone after an interruption, as in a wife taking back her husband</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201675140"
	 b:glossaryEntry='have smooth relations; "My boss and I get along very well"'/>
<rdf:Description rdf:about="&a;201675321"
	 b:glossaryEntry="solicit votes from potential voters in an electoral campaign"/>
<rdf:Description rdf:about="&a;201675463">
	<b:glossaryEntry>detain in conversation by or as if by holding on to the outer garments of; as for political or economic favors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201675658"
	 b:glossaryEntry="provide housing for"/>
<rdf:Description rdf:about="&a;201675863"
	 b:glossaryEntry="put up in a new or different housing"/>
<rdf:Description rdf:about="&a;201675964"
	 b:glossaryEntry="provide with, or send to, a home"/>
<rdf:Description rdf:about="&a;201676058"
	 b:glossaryEntry='put up in a kennel; "kennel a dog"'/>
<rdf:Description rdf:about="&a;201676156"
	 b:glossaryEntry='shelter in a stable; "stable horses"'/>
<rdf:Description rdf:about="&a;201676256"
	 b:glossaryEntry="put into, or keep in, a stall"/>
<rdf:Description rdf:about="&a;201676348"
	 b:glossaryEntry="let for money; of housing"/>
<rdf:Description rdf:about="&a;201676459"
	 b:glossaryEntry="occupy as a tenant"/>
<rdf:Description rdf:about="&a;201676541">
	<b:glossaryEntry>hold under a lease or rental agreement; of goods and services</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201676697"
	 b:glossaryEntry="work under a subcontract; engage in a subcontract"/>
<rdf:Description rdf:about="&a;201676841"
	 b:glossaryEntry="let out under a subcontract"/>
<rdf:Description rdf:about="&a;201676962"
	 b:glossaryEntry="agree to a covenant"/>
<rdf:Description rdf:about="&a;201677101">
	<b:glossaryEntry xml:space='preserve'><![CDATA[express one''s preference for a candidate or for a measure or resolution; cast a vote; "He voted for the motion"; "None of the Democrats voted last night"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201677432">
	<b:glossaryEntry>bring into existence or make available by vote; "They voted aid for the underdeveloped countries in Asia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201677599">
	<b:glossaryEntry>express a choice or opinion; "I vote that we all go home"; "She voted for going to the Chinese restaurant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201677793">
	<b:glossaryEntry xml:space='preserve'><![CDATA[express one''s choice or preference by vote; "vote the Democratic ticket"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201677945">
	<b:glossaryEntry>defeat by a majority of votes: "The Democrats outvoted the Republicans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201678089"
	 b:glossaryEntry='vote by ballot; "The voters were balloting in this state"'/>
<rdf:Description rdf:about="&a;201678210"
	 b:glossaryEntry="vote in an election at a polling station"/>
<rdf:Description rdf:about="&a;201678320"
	 b:glossaryEntry="refrain from voting"/>
<rdf:Description rdf:about="&a;201678404">
	<b:glossaryEntry xml:space='preserve'><![CDATA[refrain from doing something; "She refrains from calling her therapist too often"; "He should avoid publishing his wife''s memoires"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201678705"
	 b:glossaryEntry='avoid; "The derelict soldier shirked his duties"'/>
<rdf:Description rdf:about="&a;201678884"
	 b:glossaryEntry='avoid; "shirk work" (British usage)'/>
<rdf:Description rdf:about="&a;201678987">
	<b:glossaryEntry>avoid responsibilities and duties, e.g., by pretending to be ill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201679125"
	 b:glossaryEntry="avoid responsibilities and work, be idle"/>
<rdf:Description rdf:about="&a;201679228"
	 b:glossaryEntry="refrain from harming"/>
<rdf:Description rdf:about="&a;201679352"
	 b:glossaryEntry="treat gently or carefully"/>
<rdf:Description rdf:about="&a;201679448">
	<b:glossaryEntry xml:space='preserve'><![CDATA[write one''s name in token of assent, responsibility, or obligation; "All parties signed the peace treaty"; "Have you signed your contract yet?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201679680"
	 b:glossaryEntry="establish the legal validity of; as of a will, etc."/>
<rdf:Description rdf:about="&a;201679796"
	 b:glossaryEntry="refuse to sponsor; refuse to do business with"/>
<rdf:Description rdf:about="&a;201679924">
	<b:glossaryEntry>avoid speaking to or dealing with; "Ever since I spoke up, my colleagues ostracize me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201680133">
	<b:glossaryEntry>stop associating with; "They dropped her after she had a child out of wedlock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201680310">
	<b:glossaryEntry>do one''s shopping at; do business with; be a customer or client of</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201680516"
	 b:glossaryEntry="obstruct deliberately by delaying; of legislation"/>
<rdf:Description rdf:about="&a;201680633"
	 b:glossaryEntry='make laws, bills, etc.: "They passed the amendment"'/>
<rdf:Description rdf:about="&a;201680766"
	 b:glossaryEntry="make liberal or more liberal, of laws and rules"/>
<rdf:Description rdf:about="&a;201680899"
	 b:glossaryEntry='relax or remove controls of; "decontrol marijuana"'/>
<rdf:Description rdf:about="&a;201681016"
	 b:glossaryEntry="divide unfairly and to one''s advantage; of voting districts"/>
<rdf:Description rdf:about="&a;201681144">
	<b:glossaryEntry>separate into parts or portions; "divide the cake into three equal parts"; "The British carved up the Ottoman Empire after World War I"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201681617">
	<b:glossaryEntry>divide into triangles or give a triangular form to; "triangulate the piece of cardboard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201681774">
	<b:glossaryEntry>divide into pieces, as by bending or cutting; "break the loaf of bread"; "break the crackers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201681930"
	 b:glossaryEntry="divide (bulk material) and process as units"/>
<rdf:Description rdf:about="&a;201682038"
	 b:glossaryEntry="divide into lots, as of land, for example"/>
<rdf:Description rdf:about="&a;201682140"
	 b:glossaryEntry='divide into parts; "The developers parceled the land"'/>
<rdf:Description rdf:about="&a;201682257"
	 b:glossaryEntry="divide into slivers or splinters"/>
<rdf:Description rdf:about="&a;201682372">
	<b:glossaryEntry>divide into paragraphs, as of text: "This story is well paragraphed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201682507"
	 b:glossaryEntry="divide into cantons, of a country"/>
<rdf:Description rdf:about="&a;201682604"
	 b:glossaryEntry="divide a territory into small, hostile states"/>
<rdf:Description rdf:about="&a;201682716"
	 b:glossaryEntry="act in concert or unite in a common purpose or belief"/>
<rdf:Description rdf:about="&a;201683038">
	<b:glossaryEntry>bring or come into friendly association; "The churches consociated to fight their dissolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201683254">
	<b:glossaryEntry>be or act in association with; "We must walk with our dispossessed brothers and sisters"; "Walk with God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201683422"
	 b:glossaryEntry='form a group or unite; "The groups banded together"'/>
<rdf:Description rdf:about="&a;201683558"
	 b:glossaryEntry='unify again, as of a country; "Will Korea reunify?"'/>
<rdf:Description rdf:about="&a;201683716"
	 b:glossaryEntry='register to vote; "register for an election"'/>
<rdf:Description rdf:about="&a;201683834"
	 b:glossaryEntry="enroll as a student"/>
<rdf:Description rdf:about="&a;201683922"
	 b:glossaryEntry="register formally; as a participant or member"/>
<rdf:Description rdf:about="&a;201684156"
	 b:glossaryEntry="record in writing; enter into a register"/>
<rdf:Description rdf:about="&a;201684360"
	 b:glossaryEntry="register as a candidate for several parties"/>
<rdf:Description rdf:about="&a;201684500"
	 b:glossaryEntry="include in a list"/>
<rdf:Description rdf:about="&a;201684667"
	 b:glossaryEntry="enter into a list of prospective jurors"/>
<rdf:Description rdf:about="&a;201684781"
	 b:glossaryEntry="list in an index"/>
<rdf:Description rdf:about="&a;201684886">
	<b:glossaryEntry>make an index that refers from one point to the next; "These references are cross-indexed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201685053">
	<b:glossaryEntry>put on a blacklist so as to banish or cause to be boycotted; "many books were blacklisted by the Nazis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201685223"
	 b:glossaryEntry="enter on a public list"/>
<rdf:Description rdf:about="&a;201685323"
	 b:glossaryEntry="vote against; refuse to endorse; refuse to assent"/>
<rdf:Description rdf:about="&a;201685493"
	 b:glossaryEntry='thwart the passage of; "kill a motion"'/>
<rdf:Description rdf:about="&a;201685625">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be guided by in voting; "vote one''s conscience"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201685716"
	 b:glossaryEntry="give or delegate power to"/>
<rdf:Description rdf:about="&a;201685814"
	 b:glossaryEntry="give qualities or abilities to"/>
<rdf:Description rdf:about="&a;201685967">
	<b:glossaryEntry>invest with a large or excessive amount of something; "She covered herself with glory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201686124"
	 b:glossaryEntry="administer confirmation to; a church rite"/>
<rdf:Description rdf:about="&a;201686230"
	 b:glossaryEntry="of boys in the Jewish faith"/>
<rdf:Description rdf:about="&a;201686326"
	 b:glossaryEntry="of girls in the Jewish faith"/>
<rdf:Description rdf:about="&a;201686423"
	 b:glossaryEntry="charge with a task"/>
<rdf:Description rdf:about="&a;201686509"
	 b:glossaryEntry="put into commission; equip for service; of ships"/>
<rdf:Description rdf:about="&a;201686625"
	 b:glossaryEntry="grant credentials to; as of educational institutions"/>
<rdf:Description rdf:about="&a;201686763"
	 b:glossaryEntry="provide or send with official credentials; as of envoys"/>
<rdf:Description rdf:about="&a;201686884">
	<b:glossaryEntry>assign a duty, responsibility or obligation to; "He was appointed deputy manager"; "She was charged with supervising the creation of a concordance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201687203">
	<b:glossaryEntry>invest with a new title, office, or rank; "Create one a peer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201687336">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as of a person to a position: "The Senate confirmed the President''s candidate for Secretary of Defense"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201687528"
	 b:glossaryEntry="divest of the frock; of church officials"/>
<rdf:Description rdf:about="&a;201687643"
	 b:glossaryEntry="deprive of voting rights"/>
<rdf:Description rdf:about="&a;201687772"
	 b:glossaryEntry="grant voting rights"/>
<rdf:Description rdf:about="&a;201687892">
	<b:glossaryEntry>grant freedom to; as from slavery or servitude; "Slaves were enfranchised in the mid-19th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201688073">
	<b:glossaryEntry>declare void and nul; make ineffective; "Cancel the election results"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201688305"
	 b:glossaryEntry="cancel (a debt)"/>
<rdf:Description rdf:about="&a;201688387">
	<b:glossaryEntry>postpone indefinitely or annul something that was scheduled; "Call off the engagement"; "cancel the dinner party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201688593">
	<b:glossaryEntry>stop or interrupt; "He broke the engagement"; "We had to break our plans for a trip to China"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201688749"
	 b:glossaryEntry='declare invalid; "The contract was annulled"; "avoid a plea"'/>
<rdf:Description rdf:about="&a;201688962"
	 b:glossaryEntry='invalidate by judicial action; "The will was broken"'/>
<rdf:Description rdf:about="&a;201689077"
	 b:glossaryEntry="revoke formally"/>
<rdf:Description rdf:about="&a;201689158"
	 b:glossaryEntry="declare or make legally valid"/>
<rdf:Description rdf:about="&a;201689327">
	<b:glossaryEntry>make formal or official; "We formalized the appointment and gave him a title"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201689497"
	 b:glossaryEntry="give authority or permission to"/>
<rdf:Description rdf:about="&a;201689594">
	<b:glossaryEntry>circulate or distribute; "issue a new uniform to the children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201689782"
	 b:glossaryEntry="distribute by a network, as of water or electricity"/>
<rdf:Description rdf:about="&a;201689901">
	<b:glossaryEntry>make available; "The publisher wants to distribute the book in Asia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201690073">
	<b:glossaryEntry>make unavailable; bar from sale or distribution; "The company recalled the product when it was found to be faulty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201690305"
	 b:glossaryEntry="take out of circulation when it is useless or defective"/>
<rdf:Description rdf:about="&a;201690425">
	<b:glossaryEntry>withdraw from circulation or form the market, as of bills, shares, and bonds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201690565">
	<b:glossaryEntry>remove from the bar; expel from the practice of law by official action; "The corrupt lawyer was disbarred"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201690743"
	 b:glossaryEntry="place an order for"/>
<rdf:Description rdf:about="&a;201690845"
	 b:glossaryEntry="declare illegal"/>
<rdf:Description rdf:about="&a;201691005"
	 b:glossaryEntry="give legal value to, of a coin"/>
<rdf:Description rdf:about="&a;201691101"
	 b:glossaryEntry='make legal; "Marijuana should be legalized"'/>
<rdf:Description rdf:about="&a;201691321"
	 b:glossaryEntry="allow without fear"/>
<rdf:Description rdf:about="&a;201691402">
	<b:glossaryEntry>open (a place) to members of all races and ethnic groups; "This school is completely desegregated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201691587">
	<b:glossaryEntry>separate by race or religion; "This neighborhood is segregated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201691743">
	<b:glossaryEntry>kill intentionally and with premeditation; "The mafia boss ordered his enemies murdered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201691988"
	 b:glossaryEntry="murder without leaving a trace on the body"/>
<rdf:Description rdf:about="&a;201692093"
	 b:glossaryEntry="take out of a game; of players"/>
<rdf:Description rdf:about="&a;201692186"
	 b:glossaryEntry="murder; of socially prominent persons"/>
<rdf:Description rdf:about="&a;201692292">
	<b:glossaryEntry>socially sanctioned killing as a means of punishment; "In some states, criminals are executed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201692556"
	 b:glossaryEntry="punish by putting in a pillory"/>
<rdf:Description rdf:about="&a;201692651"
	 b:glossaryEntry="expose to ridicule or public scorn"/>
<rdf:Description rdf:about="&a;201692759"
	 b:glossaryEntry='kill by nailing onto a cross; "Jesus Christ was crucified"'/>
<rdf:Description rdf:about="&a;201692882"
	 b:glossaryEntry="murder execution-style"/>
<rdf:Description rdf:about="&a;201692969"
	 b:glossaryEntry="kill without legal sanction; by a mob"/>
<rdf:Description rdf:about="&a;201693069"
	 b:glossaryEntry="kill by firing a missile"/>
<rdf:Description rdf:about="&a;201693198"
	 b:glossaryEntry="shoot a bird in flight"/>
<rdf:Description rdf:about="&a;201693284"
	 b:glossaryEntry="shoot one by one"/>
<rdf:Description rdf:about="&a;201693366"
	 b:glossaryEntry="kill by electrocution in the electric chair"/>
<rdf:Description rdf:about="&a;201693484"
	 b:glossaryEntry='burn at the stake; "Witches were burned in Salem"'/>
<rdf:Description rdf:about="&a;201693613"
	 b:glossaryEntry='kill by hanging; "The murdered was hanged on Friday"'/>
<rdf:Description rdf:about="&a;201693775"
	 b:glossaryEntry="hang with a halter"/>
<rdf:Description rdf:about="&a;201693857"
	 b:glossaryEntry="hang on a gibbet"/>
<rdf:Description rdf:about="&a;201693937">
	<b:glossaryEntry>go on a date with; "Tonight she is dating a former high school sweetheart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201694117">
	<b:glossaryEntry>date regularly; have a steady relationship with; "Did you know that she is seeing her psychiatrist?" "He is dating his former wife again!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201694386"
	 b:glossaryEntry="meet someone for sexual purposes"/>
<rdf:Description rdf:about="&a;201694483"
	 b:glossaryEntry='make a date; "Has he asked you out yet?"'/>
<rdf:Description rdf:about="&a;201694612"
	 b:glossaryEntry="have a reunion; unite again"/>
<rdf:Description rdf:about="&a;201694712"
	 b:glossaryEntry="go out on a date as a foursome; of two couples"/>
<rdf:Description rdf:about="&a;201694827"
	 b:glossaryEntry="get together socially or for a specific purpose"/>
<rdf:Description rdf:about="&a;201695031"
	 b:glossaryEntry="meet at a rendezvous"/>
<rdf:Description rdf:about="&a;201695119">
	<b:glossaryEntry>be loyal to one another, esp. in times of trouble; "The two families stuck together throughout the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201695318">
	<b:glossaryEntry>pay a brief visit; "The mayor likes to call on some of the prominent citizens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201695538"
	 b:glossaryEntry='render; "pay a visit"; "pay a call"'/>
<rdf:Description rdf:about="&a;201695650">
	<b:glossaryEntry>give one''s name or calling card to a servant when making a formal visit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201695786">
	<b:glossaryEntry>go to see for professional or business reasons; "You should see a lawyer"; "We had to see a psychiatrist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201695952">
	<b:glossaryEntry>go to see for a social visit; "I went to see my friend Mary the other day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201696087">
	<b:glossaryEntry xml:space='preserve'><![CDATA[visit informally and spontaneously; "We frequently drop by the neighbors'' house for a cup of coffee"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201696280"
	 b:glossaryEntry="take in marriage"/>
<rdf:Description rdf:about="&a;201696539"
	 b:glossaryEntry="marry an unsuitable partner"/>
<rdf:Description rdf:about="&a;201696632">
	<b:glossaryEntry>perform a marriage ceremony; "The minister married us on Saturday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201696773"
	 b:glossaryEntry="marry a woman, take a wife"/>
<rdf:Description rdf:about="&a;201696861"
	 b:glossaryEntry="take (someone) as a wife"/>
<rdf:Description rdf:about="&a;201696947"
	 b:glossaryEntry="marry within the same ethnic, social, or family group"/>
<rdf:Description rdf:about="&a;201697068">
	<b:glossaryEntry>marry, not for the first time; "After her divorce, she remarried her high school sweetheart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201697233"
	 b:glossaryEntry='form a pair or pairs; "The two old friends paired off"'/>
<rdf:Description rdf:about="&a;201697383">
	<b:glossaryEntry>get a divorce; formally terminate a marriage; "The couple divorced after only 6 months"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201697572">
	<b:glossaryEntry>have a celebration; "They were feting the patriarch of the family"; "After the exam, the students were celebrating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201697849">
	<b:glossaryEntry>celebrate publicly with boisterous rejoicing and hilarious and extravagant behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201697997">
	<b:glossaryEntry xml:space='preserve'><![CDATA[celebrate noisily; engage in uproarious festivities; "The members of the wedding party made merry all night"; "Let''s whoop it up--the boss is gone!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201698300">
	<b:glossaryEntry>have a party; "The students were partying all night before the exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201698431"
	 b:glossaryEntry="provide entertainment for"/>
<rdf:Description rdf:about="&a;201698559">
	<b:glossaryEntry>occupy in an agreeable, entertaining or pleasant fashion; "The play amused the ladies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201698727"
	 b:glossaryEntry='visit for entertainment; "take in the sights"'/>
<rdf:Description rdf:about="&a;201698837"
	 b:glossaryEntry="visit slums for entertainment or out of curiosity"/>
<rdf:Description rdf:about="&a;201698948">
	<b:glossaryEntry>visit a place, as for entertainment; "We went to see the Eiffel Tower in the morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201699138">
	<b:glossaryEntry>engage in boisterous, drunken merry-making; "They were out carousing last night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201699300">
	<b:glossaryEntry>have or give give a reception; "The lady is receiving Sunday morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201699442">
	<b:glossaryEntry>forbid the public distribution of; as of movies or newspapers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201699581"
	 b:glossaryEntry="make available or free for sale or publication"/>
<rdf:Description rdf:about="&a;201699725"
	 b:glossaryEntry="free on bail"/>
<rdf:Description rdf:about="&a;201699803"
	 b:glossaryEntry="lock up in jail"/>
<rdf:Description rdf:about="&a;201699971">
	<b:glossaryEntry>make a sudden surprise attack on; "The police raided the crack house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201700118"
	 b:glossaryEntry="deprive of freedom; take into confinement"/>
<rdf:Description rdf:about="&a;201700341">
	<b:glossaryEntry>confine as if in a prison; "His daughters are virtually imprisoned in their own house; he does not let them go out without a chaperone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201700542"
	 b:glossaryEntry='confine in a cage; "The animal was caged"'/>
<rdf:Description rdf:about="&a;201700655">
	<b:glossaryEntry>place in a confining or embarrassing position; "He was trapped in a difficult situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201700829"
	 b:glossaryEntry="cause to stay indoors"/>
<rdf:Description rdf:about="&a;201700939"
	 b:glossaryEntry="free from slavery or servitude"/>
<rdf:Description rdf:about="&a;201701047"
	 b:glossaryEntry="make a slave of; bring into servitude"/>
<rdf:Description rdf:about="&a;201701149"
	 b:glossaryEntry="make subservient; force to submit"/>
<rdf:Description rdf:about="&a;201701277">
	<b:glossaryEntry>grant freedom to; "The students liberated their slaves upon graduating from the university"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201701507"
	 b:glossaryEntry="give equal rights to; of women and minorities"/>
<rdf:Description rdf:about="&a;201701639">
	<b:glossaryEntry>take a court case to a higher court for review; "He was found guilty but appealed immediately"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201701823">
	<b:glossaryEntry>take proceedings to have (a case) reheard in a higher court; "The case was appealed immediately after the verdict"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201702037"
	 b:glossaryEntry='challenge (a decision); "She appealed the verdict"'/>
<rdf:Description rdf:about="&a;201702169"
	 b:glossaryEntry="call before a court to answer an indictment"/>
<rdf:Description rdf:about="&a;201702295">
	<b:glossaryEntry>record a charge in a police register; "The policeman booked her when she tried to solicit a man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201702479">
	<b:glossaryEntry xml:space='preserve'><![CDATA[arrange for and reserve in advance; "reserve a seat on a flight"; "We booked tickets to the show"; "please hold a table at Maxim''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201702725">
	<b:glossaryEntry>issue a ticket or a fine to; "I was fined for parking on the wrong side of the street"; "Move your car or else you will be ticketed!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201702947">
	<b:glossaryEntry>punish by a fine imposed arbitrarily by the discretion of the court</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201703096"
	 b:glossaryEntry="condemn in a military court"/>
<rdf:Description rdf:about="&a;201703194"
	 b:glossaryEntry="subject to trial by court-martial"/>
<rdf:Description rdf:about="&a;201703298"
	 b:glossaryEntry="expel from a country"/>
<rdf:Description rdf:about="&a;201703421"
	 b:glossaryEntry="impose a penalty on; inflict punishment on"/>
<rdf:Description rdf:about="&a;201703701"
	 b:glossaryEntry="punish with an arbitrary penalty"/>
<rdf:Description rdf:about="&a;201703815"
	 b:glossaryEntry='receive punishment; "You are going to get it!"'/>
<rdf:Description rdf:about="&a;201703907">
	<b:glossaryEntry>receive punishment; be scolded or reprimanded; "I really caught it the other day!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201704037"
	 b:glossaryEntry="punish unjustly"/>
<rdf:Description rdf:about="&a;201704127"
	 b:glossaryEntry="punish severely"/>
<rdf:Description rdf:about="&a;201704207">
	<b:glossaryEntry>bestow a reward upon; "The boy scout was rewarded for his courageous action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201704373">
	<b:glossaryEntry>examine or hear (evidence or a case) by judicial process; "The jury had heard all the evidence"; "The case will be tried in California"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201704594"
	 b:glossaryEntry="hear or try a court case anew"/>
<rdf:Description rdf:about="&a;201704695">
	<b:glossaryEntry>put on trial or sit as the judge at the trial of; "The football star was tried for the murder of his wife"; "The judge tried both father and son in separate trials"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201704959"
	 b:glossaryEntry="as from a country"/>
<rdf:Description rdf:about="&a;201705170"
	 b:glossaryEntry="bar temporarily; from school, office, etc."/>
<rdf:Description rdf:about="&a;201705329"
	 b:glossaryEntry="suspend temporarily from college or university, in England"/>
<rdf:Description rdf:about="&a;201705466"
	 b:glossaryEntry="admit back into the country"/>
<rdf:Description rdf:about="&a;201705579">
	<b:glossaryEntry>allow to enter; grant entry to; "We cannot admit non-members into our club"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201705817">
	<b:glossaryEntry>refuse entrance or membership; "They turned away hundreds of fans"; "Black people were often rejected by country clubs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201706041">
	<b:glossaryEntry>admit anew; "The refugee was readmitted into his home country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201706176"
	 b:glossaryEntry="hand over to the authorities of another country"/>
<rdf:Description rdf:about="&a;201706339">
	<b:glossaryEntry>send someone back to his homeland against his will, as of refugees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201706473">
	<b:glossaryEntry>expel, as if by official decree; "he was banished from his own country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201706651"
	 b:glossaryEntry="expel from a community or group"/>
<rdf:Description rdf:about="&a;201706794"
	 b:glossaryEntry="ban from a place of residence, as for punishment"/>
<rdf:Description rdf:about="&a;201706930">
	<b:glossaryEntry>send to the country; "He was rusticated for his bad bahavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201707058">
	<b:glossaryEntry>to cause to do through pressure or necessity, by physical, moral or intellectual means :"She forced him to take a job in the city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201707423">
	<b:glossaryEntry>to compel or force or urge relentlessly or exert coercive pressure on; "She is driven by her passion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201707595">
	<b:glossaryEntry>overcome or coerce as if by using a heavy club; "The teacher bludgeoned the students into learning the math formulas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201707778">
	<b:glossaryEntry>bring by overwhelming force or pressure; "The Senator steamrollered the bill to defeat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201707934"
	 b:glossaryEntry="squeeze someone for money, information, etc."/>
<rdf:Description rdf:about="&a;201708047"
	 b:glossaryEntry="compel by threatening"/>
<rdf:Description rdf:about="&a;201708144"
	 b:glossaryEntry="coerce by violence or with threats"/>
<rdf:Description rdf:about="&a;201708245">
	<b:glossaryEntry>force or compel somebody to do something; "We compel all students to fill out this form"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201708561">
	<b:glossaryEntry>compel someone to do something by insistent clamoring; "They clamored the mayor into building a new park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201708730">
	<b:glossaryEntry>compel or force into a particular state or activity; "His devotion to his sick wife condemned him to a lonely existence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201708915">
	<b:glossaryEntry>cause to undertake a certain action, usually used in the negative; "He could not bring himself to call his parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201709101">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take the trouble to do something; concern oneself; "He did not trouble to call his mother on her birthday"; "Don''t bother, please"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201709356">
	<b:glossaryEntry>to cause inconvenience or discomfort to: "Sorry to trouble you, but..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201709572">
	<b:glossaryEntry>compel through a sense of shame; "She shamed him into making amends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201709703">
	<b:glossaryEntry>to accuse or condemn openly or formally: "He denounced the government action."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201709883"
	 b:glossaryEntry="burn with a branding iron to indicate ownership; of animals"/>
<rdf:Description rdf:about="&a;201710005">
	<b:glossaryEntry>declare unavailable, as for security reasons; "Classify these documents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201710161"
	 b:glossaryEntry="declare as sacred and forbidden"/>
<rdf:Description rdf:about="&a;201710255">
	<b:glossaryEntry>lift the restriction on and make available again; "reclassify the documents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201710417"
	 b:glossaryEntry="place under restrictions; limit access to"/>
<rdf:Description rdf:about="&a;201710658">
	<b:glossaryEntry>train a plant to grow in a certain way by tying and pruning it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201710801"
	 b:glossaryEntry="train on a trellis, as of a vine"/>
<rdf:Description rdf:about="&a;201710898"
	 b:glossaryEntry="limit in quality or quantity"/>
<rdf:Description rdf:about="&a;201710997"
	 b:glossaryEntry="restrict something to a particular area"/>
<rdf:Description rdf:about="&a;201711131"
	 b:glossaryEntry="make free from restrictions"/>
<rdf:Description rdf:about="&a;201711244">
	<b:glossaryEntry>lessen the intensity of; temper; hold in restraint; hold or keep within limits; "moderate your alcohol intake" "hold your tongue"; "hold your temper"; "control your anger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201711721">
	<b:glossaryEntry>check oneself during an action; "She managed to catch herself before telling her boss what was on her mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201711891">
	<b:glossaryEntry>moderate or restrain; lessen the force of; "He bated his breath when talking about this affair"; "capable of bating his enthusiasm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201712092">
	<b:glossaryEntry>give free rein to; "The write indulged in metaphorical language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201712221"
	 b:glossaryEntry="control the temperature with a thermostat"/>
<rdf:Description rdf:about="&a;201712330"
	 b:glossaryEntry="impose regulations on"/>
<rdf:Description rdf:about="&a;201712509"
	 b:glossaryEntry="lift the regulations on"/>
<rdf:Description rdf:about="&a;201712618"
	 b:glossaryEntry="regulate housing in; of certain areas of towns"/>
<rdf:Description rdf:about="&a;201712737"
	 b:glossaryEntry="treat differently on the basis of sex or race"/>
<rdf:Description rdf:about="&a;201712972">
	<b:glossaryEntry>discriminate in selling or renting housing in certain areas of a neighborhood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201713114"
	 b:glossaryEntry="divide society into social strata"/>
<rdf:Description rdf:about="&a;201713221"
	 b:glossaryEntry="give an advantage to"/>
<rdf:Description rdf:about="&a;201713342">
	<b:glossaryEntry>put at a disadvantage; hinder, harm; "This rule clearly disadvantages me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201713552"
	 b:glossaryEntry="disadvantage by prejudice; in law"/>
<rdf:Description rdf:about="&a;201713660"
	 b:glossaryEntry="infringe on the rights of; in law"/>
<rdf:Description rdf:about="&a;201713759"
	 b:glossaryEntry="treat unjustly; do wrong to"/>
<rdf:Description rdf:about="&a;201713921">
	<b:glossaryEntry>interact in a certain way; "Do right by her"; "Treat him with caution, please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201714347">
	<b:glossaryEntry>treat carefully; "He nursed his injured back by lyng in bed several hours every afternoon"; "He nursed the flowers in his garden and fertilized them regularly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201714577"
	 b:glossaryEntry='handle roughly; "He was strong-armed by the policemen"'/>
<rdf:Description rdf:about="&a;201714699"
	 b:glossaryEntry="treat inconsiderately or harshly"/>
<rdf:Description rdf:about="&a;201714843"
	 b:glossaryEntry="treat snobbishly, put in one''s place"/>
<rdf:Description rdf:about="&a;201714944"
	 b:glossaryEntry="treat in a rough or boisterous manner"/>
<rdf:Description rdf:about="&a;201715050"
	 b:glossaryEntry="treat brutally"/>
<rdf:Description rdf:about="&a;201715151">
	<b:glossaryEntry>treat or consider adequately or fairly; "To do him justice, he is brilliant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201715324"
	 b:glossaryEntry="treat hurriedly or avoid dealing with properly"/>
<rdf:Description rdf:about="&a;201715506">
	<b:glossaryEntry>work hastily or carelessly; deal with inadequately and superficially</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201715663"
	 b:glossaryEntry="treat badly"/>
<rdf:Description rdf:about="&a;201715807">
	<b:glossaryEntry xml:space='preserve'><![CDATA[treat badly; abuse; "They won''t have me to kick around any more!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201715941"
	 b:glossaryEntry="treat harshly or unfairly"/>
<rdf:Description rdf:about="&a;201716031"
	 b:glossaryEntry='behave badly; "The children misbehaved all morning"'/>
<rdf:Description rdf:about="&a;201716197">
	<b:glossaryEntry>misbehave badly; "The children acted up when they were not bored"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201716326">
	<b:glossaryEntry xml:space='preserve'><![CDATA[act in an undignified or dishonorable way; "I won''t stoop to this"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201716484"
	 b:glossaryEntry="act stealthily"/>
<rdf:Description rdf:about="&a;201716569">
	<b:glossaryEntry>behave in a certain manner; "She carried herself well"; "he bore himself with dignity"; "They conducted themselves well during these difficult times"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201716925"
	 b:glossaryEntry='behave in a specified manner; "walk in sadness"'/>
<rdf:Description rdf:about="&a;201717034"
	 b:glossaryEntry="behave saucy or impudently towards"/>
<rdf:Description rdf:about="&a;201717131"
	 b:glossaryEntry="put oneself forward in an assertive and insistent manner"/>
<rdf:Description rdf:about="&a;201717259"
	 b:glossaryEntry="behave affectedly in order to impress others"/>
<rdf:Description rdf:about="&a;201717383"
	 b:glossaryEntry="assume certain affected attitudes"/>
<rdf:Description rdf:about="&a;201717501"
	 b:glossaryEntry='behave well or properly; "The children must learn to behave"'/>
<rdf:Description rdf:about="&a;201717707"
	 b:glossaryEntry="act foolishly, as by talking nonsense"/>
<rdf:Description rdf:about="&a;201717808"
	 b:glossaryEntry='make reparations or amends for; "right a wrong"'/>
<rdf:Description rdf:about="&a;201718031"
	 b:glossaryEntry="make excessive corrections for fear of making an error"/>
<rdf:Description rdf:about="&a;201718181">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make amends for; "expiate one''s sins"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201718312">
	<b:glossaryEntry>make up work that was missed due to absence at a later point; "I have to make up with exam"; "Can I catch up with the material or is it too late?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201718539">
	<b:glossaryEntry>verify or regulate by conducting a parallel experiment or comparing with another standard, of scientific experiments: "Are you controlling for the temperature?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201718791"
	 b:glossaryEntry="accuse formally of a crime"/>
<rdf:Description rdf:about="&a;201718881">
	<b:glossaryEntry>protest, as against a policy; also metaphorically: "His body protested against the harsh training"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201719143"
	 b:glossaryEntry="march in protest; take part in a demonstration"/>
<rdf:Description rdf:about="&a;201719292">
	<b:glossaryEntry>serve as pickets or post pickets; "picket a business to protest the lay-offs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201719441"
	 b:glossaryEntry="get a passing grade in an exams"/>
<rdf:Description rdf:about="&a;201719603">
	<b:glossaryEntry>fall short in what is expected; "She failed in her obligations as a good daughter-in-law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201719754">
	<b:glossaryEntry>pass easily and do very well; "She sailed through her exams"; "You will pass with flying colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201719999">
	<b:glossaryEntry>be successful; achieve a goal; "She succeeded in persuading us all"; "I managed to carry the box upstairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201720230">
	<b:glossaryEntry>carry on or manage; "We could do with a little more help around here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201720358"
	 b:glossaryEntry='go unchallenged; be approved; "The bill cleared the House"'/>
<rdf:Description rdf:about="&a;201720528">
	<b:glossaryEntry>fail to get a passing grade; "She studied hard but failed nevertheless"; "Did I fail the test?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201720755"
	 b:glossaryEntry='judge unacceptable; "The teacher failed six students"'/>
<rdf:Description rdf:about="&a;201720906">
	<b:glossaryEntry>accept or judge as acceptable; "The teacher passed the student although we was weak"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201721088">
	<b:glossaryEntry>attain success or reach a goal; "The enterprise succeeded"; "We succeeded in getting tickets to the show"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201721531"
	 b:glossaryEntry="succeed by sheer luck"/>
<rdf:Description rdf:about="&a;201721618">
	<b:glossaryEntry>succeed in obtaining a position; "He nailed down a spot at Harvard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201721765"
	 b:glossaryEntry="pass a test or a screening, for example"/>
<rdf:Description rdf:about="&a;201721882"
	 b:glossaryEntry="make without a miss; in sports or games"/>
<rdf:Description rdf:about="&a;201721982">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have a desired effect; do the trick; "This method doesn''t work"; "The breaks of my new car act quickly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201722161"
	 b:glossaryEntry="fail by aiming too high or trying too hard"/>
<rdf:Description rdf:about="&a;201722278"
	 b:glossaryEntry="be a success"/>
<rdf:Description rdf:about="&a;201722366">
	<b:glossaryEntry>to gain with effort: "she achieved her goal despite setbacks."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201722683">
	<b:glossaryEntry xml:space='preserve'><![CDATA[achieve or accomplish in the least degree, usually used in the negative: "This economic measure doesn''t even begin to deal with the problem of inflation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201722899"
	 b:glossaryEntry='attain; "The horse finally struck a pace"'/>
<rdf:Description rdf:about="&a;201723022"
	 b:glossaryEntry="reach the highest or most decisive point"/>
<rdf:Description rdf:about="&a;201723137">
	<b:glossaryEntry>bring about; accomplish; "This writer attempts more than his talents can compass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201723291"
	 b:glossaryEntry='achieve or reach on average; "He averaged a C"'/>
<rdf:Description rdf:about="&a;201723410"
	 b:glossaryEntry="achieve something by means of trickery or devious methods"/>
<rdf:Description rdf:about="&a;201723558"
	 b:glossaryEntry="make a mess of, destroy or ruin"/>
<rdf:Description rdf:about="&a;201723893">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be unsuccessful; "Where do today''s public schools fail?"; "The attempt tp rescue the hostages failed miserably"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201724256"
	 b:glossaryEntry='suffer defeat, failure, or ruin; "We must stand or fall"'/>
<rdf:Description rdf:about="&a;201724374"
	 b:glossaryEntry="suffer failure, as in some enterprise"/>
<rdf:Description rdf:about="&a;201724478">
	<b:glossaryEntry>fail to do something; leave something undone; "She failed to notice that her child was no longer in his crib"; "The secretary failed to call the customer and the company lost the account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201724773"
	 b:glossaryEntry="fail to catch, as of a ball"/>
<rdf:Description rdf:about="&a;201724862"
	 b:glossaryEntry='fail utterly; collapse; "The project foundered"'/>
<rdf:Description rdf:about="&a;201725008">
	<b:glossaryEntry>make an effort or attempt; "He tried to shake off his fears"; "The infant had essayed a few wobbly steps"; "The police attempted to stop the thief"; "He sought to improve himself"; "She always seeks to do good in the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201725485">
	<b:glossaryEntry>search blindly or uncertainly; "His mind groped to make the connection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201725619"
	 b:glossaryEntry="try very hard to do something"/>
<rdf:Description rdf:about="&a;201725730">
	<b:glossaryEntry>attempt by employing effort; "we endeavor to make our customers happy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201725941">
	<b:glossaryEntry>to strive with determination; "John is bucking for a promotion."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201726067">
	<b:glossaryEntry>put to the test, as for its quality, or give experimental use to; "This approach has been tried with good results"; "Test this recipe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201726341">
	<b:glossaryEntry>test something in the field; "The Army field tested the new tanks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201726475">
	<b:glossaryEntry xml:space='preserve'><![CDATA[try (informal); "let''s give it a whirl!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201726604">
	<b:glossaryEntry>to conduct a test or investigation, try out: "..willingness to experiment in this musical field.."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201726778">
	<b:glossaryEntry>test or examine for the presence of disease or infection; "screen the blood for the HIV virus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201726951">
	<b:glossaryEntry>make an examination or investigation; "check into the rumor"; "check the time of the class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201727159"
	 b:glossaryEntry="check a second time"/>
<rdf:Description rdf:about="&a;201727248">
	<b:glossaryEntry>test someone''s alcohol level in his blood by means of a breathalyzer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201727399"
	 b:glossaryEntry="introduce democratic reforms; of nations"/>
<rdf:Description rdf:about="&a;201727508"
	 b:glossaryEntry="become (more) democratic; of nations"/>
<rdf:Description rdf:about="&a;201727613"
	 b:glossaryEntry='do without; "We are dispensing with formalities"'/>
<rdf:Description rdf:about="&a;201727756">
	<b:glossaryEntry>grant a dispensation; grant an exemption; "I was dispensed from this terrible task"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201727931"
	 b:glossaryEntry='make amorous advances towards; "john is courting Mary"'/>
<rdf:Description rdf:about="&a;201728110">
	<b:glossaryEntry>engage in social activities leading to marriage; "We were courting for over ten years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201728267">
	<b:glossaryEntry xml:space='preserve'><![CDATA[seek someone''s favor; "China is wooing Russia"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201728388"
	 b:glossaryEntry="pursue someone sexually or romantically"/>
<rdf:Description rdf:about="&a;201728504">
	<b:glossaryEntry>attract attention by displaying some body part or posing; of animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201728637"
	 b:glossaryEntry="attract attention onto oneself"/>
<rdf:Description rdf:about="&a;201728734"
	 b:glossaryEntry="withdraw from an organization or communion"/>
<rdf:Description rdf:about="&a;201728889">
	<b:glossaryEntry>interrupt a continued activity; "She had broken with the traditional patterns"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201729051"
	 b:glossaryEntry="make politically neutral"/>
<rdf:Description rdf:about="&a;201729151">
	<b:glossaryEntry>influence or control shrewdly or deviously: "He manipulated public opinion in his favor."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201729316"
	 b:glossaryEntry="have and exert influence or effect"/>
<rdf:Description rdf:about="&a;201729632"
	 b:glossaryEntry='modify or bias; "His political ideas color his lectures"'/>
<rdf:Description rdf:about="&a;201729751">
	<b:glossaryEntry>influence decisively; "This action swung many votes over to his side"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201729920">
	<b:glossaryEntry>deliver to an enemy by treachery; "Judas sold Jesus"; "The spy betrayed his country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201730120">
	<b:glossaryEntry>be deceived, duped, or entrapped by; "He fell for her charms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201730255"
	 b:glossaryEntry="betray by double-dealing"/>
<rdf:Description rdf:about="&a;201730349"
	 b:glossaryEntry="assign to (a job or a home)"/>
<rdf:Description rdf:about="&a;201730457"
	 b:glossaryEntry="create social or emotional ties"/>
<rdf:Description rdf:about="&a;201730589">
	<b:glossaryEntry>move (people) forcibly from their homeland into a new and foreign environment; "The war uprooted many people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201730794"
	 b:glossaryEntry="poke one''s nose into"/>
<rdf:Description rdf:about="&a;201730921">
	<b:glossaryEntry>get involved, usually so as to hinder or halt an action; "Why did the U.S. not intervene earlier in WW II?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201731191">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intrude in other people''s affairs or business; interfere unwantedly; "Don''t meddle in my affairs!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201731370"
	 b:glossaryEntry="have dominance over"/>
<rdf:Description rdf:about="&a;201731508"
	 b:glossaryEntry="accept as a charge"/>
<rdf:Description rdf:about="&a;201731610"
	 b:glossaryEntry='bring up; "raise a family"; "bring up children"'/>
<rdf:Description rdf:about="&a;201731811"
	 b:glossaryEntry="feed, care for, and rear young birds for flight"/>
<rdf:Description rdf:about="&a;201731922"
	 b:glossaryEntry="bring up from infancy"/>
<rdf:Description rdf:about="&a;201732007"
	 b:glossaryEntry="become an adult"/>
<rdf:Description rdf:about="&a;201732105"
	 b:glossaryEntry="reach a certain age that marks a transition to maturity"/>
<rdf:Description rdf:about="&a;201732229"
	 b:glossaryEntry="bring up under fosterage; of children"/>
<rdf:Description rdf:about="&a;201732330">
	<b:glossaryEntry>to act as an attendant to; "May I serve you?"; "She attends the old lady in the wheelchair"; "Can you wait on our table, please?"; "Is a salesperson assisting you?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201732641"
	 b:glossaryEntry="serve as a valet"/>
<rdf:Description rdf:about="&a;201732720">
	<b:glossaryEntry>be used by; as of a utility: "The sewage plant served the neighboring communities"; "The garage served to shelter his horses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201732942">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be a delegate for; represent somebody''s interest, as of politicians and office holders representing their constituents, or of a tenant representing other tenants in a housing dispute; "I represent the silent majority"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201733234">
	<b:glossaryEntry>be representative or typical for; "This period is represented by Beethoven"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201733418">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be a spokesperson for: "He represents the Government''s position"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201733557">
	<b:glossaryEntry>be compliant; go along with; act in agreement with; "He complied with my instructions"; "You must comply or else!" "Follow these simple rules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201733879"
	 b:glossaryEntry="do what is expected"/>
<rdf:Description rdf:about="&a;201733968"
	 b:glossaryEntry="be obedient to"/>
<rdf:Description rdf:about="&a;201734124">
	<b:glossaryEntry xml:space='preserve'><![CDATA[receive and be expected to follow directions or commands; "I don''t take orders from you!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201734282">
	<b:glossaryEntry>refuse to go along with; refuse to follow; be disobedient; "He disobeyed his superviser and was fired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201734511">
	<b:glossaryEntry>destroy property or hinder normal operations; "The Resistance sabotaged railroad operations during the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201734760">
	<b:glossaryEntry>oppose and mitigate the effects of by contrary actions; "This will counteract the foolish actions of my colleagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201734987">
	<b:glossaryEntry>take a risk in the hope of a favorable outcome; "When you buy these stocks you are gambling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201735258"
	 b:glossaryEntry="act by relying on one''s luck"/>
<rdf:Description rdf:about="&a;201735366">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to be courageous enough to try or do something: "I don''t dare call him", "she dares to dress differently from the others."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201735558"
	 b:glossaryEntry='put at risk; "I will stake my good reputation for this"'/>
<rdf:Description rdf:about="&a;201735720">
	<b:glossaryEntry>expose to a chance of loss or damage; "We risked losing a lot of money in this venture"; "Why risk your life?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201735972">
	<b:glossaryEntry>take a risk; perform a daring act; "Who is going to bell the cat?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201736108"
	 b:glossaryEntry='bestow honor upon; "Today we honor our soldiers"'/>
<rdf:Description rdf:about="&a;201736333">
	<b:glossaryEntry>show approval or appreciation of; "My work is not recognized by anybody!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201736499"
	 b:glossaryEntry="lend dignity or honor to"/>
<rdf:Description rdf:about="&a;201736614"
	 b:glossaryEntry="bestow an honor upon"/>
<rdf:Description rdf:about="&a;201736746"
	 b:glossaryEntry="award a mark of honor, as a medal, to"/>
<rdf:Description rdf:about="&a;201736849"
	 b:glossaryEntry="bring dishonor upon"/>
<rdf:Description rdf:about="&a;201737017">
	<b:glossaryEntry>give help or assistance; be of service; "Everyone helped out during the earthquake"; "Can you help me carry this table?" "She never helps around the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201737453">
	<b:glossaryEntry>be of help, as in a particular situation of need; "Can you help out tonight?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201737596"
	 b:glossaryEntry="be helpful or useful"/>
<rdf:Description rdf:about="&a;201737682"
	 b:glossaryEntry="help in a difficult situation"/>
<rdf:Description rdf:about="&a;201737793">
	<b:glossaryEntry>speed up the progress of; facilitate; "This should expedite the process"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201737948">
	<b:glossaryEntry>be of use to, be useful to; "It will avail them to dispose of their booty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201738093"
	 b:glossaryEntry="assist or encourage, usually in some wrongdoing"/>
<rdf:Description rdf:about="&a;201738202">
	<b:glossaryEntry>attend to the wants and needs of others; "I have to minister to my mother all the time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201738355">
	<b:glossaryEntry>take charge of; "Could you see about lunch?"; "I must attend to this matter"; "She took care of this business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201738591"
	 b:glossaryEntry="tend to something or somebody"/>
<rdf:Description rdf:about="&a;201738726"
	 b:glossaryEntry="tend as a shepherd, as of sheep or goats"/>
<rdf:Description rdf:about="&a;201738832"
	 b:glossaryEntry="watch over like a shepherd, as a teacher of her pupils"/>
<rdf:Description rdf:about="&a;201738960"
	 b:glossaryEntry='provide care for; "The nurse was caring for the wounded"'/>
<rdf:Description rdf:about="&a;201739162"
	 b:glossaryEntry='care for like a mother; "She fusses over her husband"'/>
<rdf:Description rdf:about="&a;201739308"
	 b:glossaryEntry="serve as a nurse; care for sick or handicapped people"/>
<rdf:Description rdf:about="&a;201739424"
	 b:glossaryEntry="save from ruin or destruction"/>
<rdf:Description rdf:about="&a;201739567"
	 b:glossaryEntry="free from harm or evil"/>
<rdf:Description rdf:about="&a;201739723"
	 b:glossaryEntry="relieve temporarily"/>
<rdf:Description rdf:about="&a;201739816"
	 b:glossaryEntry="from sins, as in religious dogma"/>
<rdf:Description rdf:about="&a;201739919">
	<b:glossaryEntry>bring into safety; "We pulled through most of the victims of the bomb attack"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201740121"
	 b:glossaryEntry="help oneself, often through improvised means"/>
<rdf:Description rdf:about="&a;201740232">
	<b:glossaryEntry>help to re-adapt, as to a former state of health or good repute</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201740365"
	 b:glossaryEntry="return to its original condition"/>
<rdf:Description rdf:about="&a;201740522"
	 b:glossaryEntry="restore to the previous state or rank"/>
<rdf:Description rdf:about="&a;201740652">
	<b:glossaryEntry>punish in order to gain control or enforce obedience; "The teacher disciplined the pupils rather frequently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201740849">
	<b:glossaryEntry>train by instruction and practice; esp. to teach self-control; "Parents must discipline their children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201741056"
	 b:glossaryEntry="sell one''s body; exchange sex for money"/>
<rdf:Description rdf:about="&a;201741189"
	 b:glossaryEntry="work as a streetwalker"/>
<rdf:Description rdf:about="&a;201741279">
	<b:glossaryEntry xml:space='preserve'><![CDATA[promote the growth of; "Foster our children''s well-being and education"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201741432">
	<b:glossaryEntry>incite or stimulate; "The Academy was formed to spur research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201741564"
	 b:glossaryEntry="promote somebody by brevet, in the military"/>
<rdf:Description rdf:about="&a;201741671">
	<b:glossaryEntry>contribute to the progress or growth of; "I am promoting the use of computers in the classroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201742021">
	<b:glossaryEntry>contribute to the furtherance of; "This money will help the development of literacy in developing countries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201742199"
	 b:glossaryEntry='take further or advance; "carry a cause"'/>
<rdf:Description rdf:about="&a;201742302"
	 b:glossaryEntry='support or promote; "His admiration fed her vanity"'/>
<rdf:Description rdf:about="&a;201742423">
	<b:glossaryEntry>be conducive to; "The use of computers in the classroom lead to better writing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201742587"
	 b:glossaryEntry='be supportive of; "Will you support me during the meeting?"'/>
<rdf:Description rdf:about="&a;201742853"
	 b:glossaryEntry="maintain or support somebody who is weaker or less competent"/>
<rdf:Description rdf:about="&a;201742994">
	<b:glossaryEntry xml:space='preserve'><![CDATA[compensate for a weaker partner or member by one''s own performance; "I resent having to carry her all the time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201743186"
	 b:glossaryEntry="lend moral support to"/>
<rdf:Description rdf:about="&a;201743274">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give support or one''s blessing to; "I''ll second that motion"; "I can''t back this plan"; "endorse a new project"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201743494">
	<b:glossaryEntry>hinder or prevent the progress or accomplishment of; "His brother blocked him at every turn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201743807">
	<b:glossaryEntry>block or impede (a player from the opposing team) in ice hockey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201743941"
	 b:glossaryEntry="prevent from reaching a verdict, of a jury"/>
<rdf:Description rdf:about="&a;201744054">
	<b:glossaryEntry>slow down or impede by creating an obstruction; "His laziness has bottlenecked our efforts to reform the system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201744242"
	 b:glossaryEntry="stand in the way of"/>
<rdf:Description rdf:about="&a;201744324">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to hinder or prevent (the efforts, plans, or desires) of: "What ultimately frustrated every challenger was Ruth''s amazing September surge."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201744675"
	 b:glossaryEntry='destroy or break; "dashed ambitions and hopes"'/>
<rdf:Description rdf:about="&a;201744783">
	<b:glossaryEntry>hamper the progress of; impede; "short-circuit warm feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201744923">
	<b:glossaryEntry>cause to fail: "This behavior will ruin your chances of winning the election"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201745106">
	<b:glossaryEntry>cause the failure or ruin of; "His peccadilloes finally broke his marriage"; "This play will either make or break the playwright"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201745324"
	 b:glossaryEntry='ruin utterly; "You have shipwrecked my career"'/>
<rdf:Description rdf:about="&a;201745445">
	<b:glossaryEntry>stop from happening or developing; "Block his election"; "Halt the process"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201745642">
	<b:glossaryEntry>stop a judicial process: "The judge stayed the execution order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201745767">
	<b:glossaryEntry>ensure observance of laws and rules; "Apply the rules to everyone";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201745992"
	 b:glossaryEntry='compel or impose; "Social relations impose courtesy"'/>
<rdf:Description rdf:about="&a;201746118">
	<b:glossaryEntry>engage in: "make love, not war"; "make an effort"; "do research"; "do nothing"; "make revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201746300">
	<b:glossaryEntry>act so as to bring about; "effect a change"; "carry out a reform"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201746521">
	<b:glossaryEntry>bring into operation or effect; "The new members brought to bear new concerns to the U.N."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201746690"
	 b:glossaryEntry='extend beyond reasonable limits; "carry too far"'/>
<rdf:Description rdf:about="&a;201746847">
	<b:glossaryEntry>avail oneself to; "apply a principle"; "practice a religion"; "use care when going down the stairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201747044">
	<b:glossaryEntry>adhere to or practice; "These people still follow the laws of their ancient religion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201747193">
	<b:glossaryEntry>make effective from an earlier date: "The increase in tax was backdated to January"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201747342"
	 b:glossaryEntry='get (something) done; "I did my job"'/>
<rdf:Description rdf:about="&a;201747510"
	 b:glossaryEntry='emit or utter; "Give a gulp"; "give a yelp"'/>
<rdf:Description rdf:about="&a;201747623">
	<b:glossaryEntry xml:space='preserve'><![CDATA[do wrongly or improperly; "misdo one''s job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201747729"
	 b:glossaryEntry="perform as well as possible"/>
<rdf:Description rdf:about="&a;201747866">
	<b:glossaryEntry>execute a program or process, as on a computer or a machine; "Run the dishwasher"; "run a new program on the Mac"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201748048">
	<b:glossaryEntry xml:space='preserve'><![CDATA[complete or carry out; "discharge one''s duties"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201748185"
	 b:glossaryEntry='carry out the legalities of; "execute a will or a deed"'/>
<rdf:Description rdf:about="&a;201748323"
	 b:glossaryEntry='execute and deliver; "Give bond"'/>
<rdf:Description rdf:about="&a;201748417">
	<b:glossaryEntry>grant relief or an exemption from a rule or requirement to; "She exempted me from the exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201748679"
	 b:glossaryEntry='absolve from payment; "I forgive you your debt"'/>
<rdf:Description rdf:about="&a;201748799"
	 b:glossaryEntry="sit on the throne as a ruler"/>
<rdf:Description rdf:about="&a;201748891">
	<b:glossaryEntry xml:space='preserve'><![CDATA[save or relieve from an experience or action; "I''ll spare you from having to apologize formally"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201749058"
	 b:glossaryEntry="act in opposition to"/>
<rdf:Description rdf:about="&a;201749172"
	 b:glossaryEntry="oppose or check by a counteraction"/>
<rdf:Description rdf:about="&a;201749289">
	<b:glossaryEntry>oust politically; "Deng Xiao Ping was purged several times throughout his lifetime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201749453">
	<b:glossaryEntry>reinstall politically; "Deng Xiao Ping was rehabilitated several times throughout his lifetime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201749637"
	 b:glossaryEntry="act in advance of; deal with ahead of time"/>
<rdf:Description rdf:about="&a;201749779"
	 b:glossaryEntry="commit a sin; violate a law of God"/>
<rdf:Description rdf:about="&a;201749892"
	 b:glossaryEntry='yield to temptation or sin "Adam and Eve fell"'/>
<rdf:Description rdf:about="&a;201750018">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lose one''s chastity; "a fallen woman"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201750117"
	 b:glossaryEntry="commit a faux pas or fault"/>
<rdf:Description rdf:about="&a;201750236">
	<b:glossaryEntry>act in disregard of laws and rules; "offend all laws of humanity"; "violate the basic laws or human civilization"; "break a law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201750581">
	<b:glossaryEntry>go against, as of rules and laws; "He ran afould of the law"; "This behavior conflicts with our rules"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201750785"
	 b:glossaryEntry="break the law"/>
<rdf:Description rdf:about="&a;201750864"
	 b:glossaryEntry="assault sexually; force to have sex"/>
<rdf:Description rdf:about="&a;201751013"
	 b:glossaryEntry="violate the sacred character of a place, such as a graveyard"/>
<rdf:Description rdf:about="&a;201751170"
	 b:glossaryEntry="practice anal sex upon"/>
<rdf:Description rdf:about="&a;201751275">
	<b:glossaryEntry>carry out or practice; as of jobs and professions: "practice law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201751482"
	 b:glossaryEntry="practice shamanism"/>
<rdf:Description rdf:about="&a;201751567">
	<b:glossaryEntry>do something to an excessive degree: "He overdid it last night when he did 100 push-ups"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201751750"
	 b:glossaryEntry="defeat (oneself) by going too far"/>
<rdf:Description rdf:about="&a;201751849"
	 b:glossaryEntry="harass or assault sexually; make indecent advances to"/>
<rdf:Description rdf:about="&a;201751966"
	 b:glossaryEntry="accept as a challenge"/>
<rdf:Description rdf:about="&a;201752073">
	<b:glossaryEntry>impinge or infringe upon; "This impinges on my rights as an individual"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201752237">
	<b:glossaryEntry>make excessive use of; "You are taking advantage of my good will!"; "She is trespassing upon my privacy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201752442">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conduct oneself toward; treat or handle; "You can''t use people to achieve your own evil plans!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201752616">
	<b:glossaryEntry xml:space='preserve'><![CDATA[treat with excessive indulgence; "grandparents often pamper the children"; "Let''s not mollycoddle our students!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201752871">
	<b:glossaryEntry xml:space='preserve'><![CDATA[enter someone''s property in an unauthorized manner, usually with the intent to steal or commit a violent act; "Someone broke in while I was on vacation"; "They broke into my car and stole my radio!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201753159">
	<b:glossaryEntry xml:space='preserve'><![CDATA[enter unlawfully on someone''s property; "Don''t trespass on my land!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201753347"
	 b:glossaryEntry="commit a burglary; enter and rob a dwelling"/>
<rdf:Description rdf:about="&a;201753501"
	 b:glossaryEntry="establish a conditioned response"/>
<rdf:Description rdf:about="&a;201753616">
	<b:glossaryEntry>pay close attention to; give heed to; "Heed the advice of the old men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201753780"
	 b:glossaryEntry='deprive of by deceit; "He swindled me out of my inheritance"'/>
<rdf:Description rdf:about="&a;201753994"
	 b:glossaryEntry="cheat someone by not returning him enough money"/>
<rdf:Description rdf:about="&a;201754119"
	 b:glossaryEntry="cheat somebody out of what is due, especially money"/>
<rdf:Description rdf:about="&a;201754240"
	 b:glossaryEntry="profit privately from public office"/>
<rdf:Description rdf:about="&a;201754336"
	 b:glossaryEntry="play the shark; act with trickery"/>
<rdf:Description rdf:about="&a;201754432"
	 b:glossaryEntry="arrange the outcome of by means of deceit; of elections"/>
<rdf:Description rdf:about="&a;201754557">
	<b:glossaryEntry>deprive somebody of something by deceit; "The con-man beat me out of $50"; "This salesman ripped us off!"; "we were cheated by their clever-sounding scheme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201754984"
	 b:glossaryEntry="victimize, esp. in gambling or negotiations"/>
<rdf:Description rdf:about="&a;201755092"
	 b:glossaryEntry="cheat by avoiding payment of a gambling debt"/>
<rdf:Description rdf:about="&a;201755199"
	 b:glossaryEntry='make a victim of; "I was victimized by this con-man"'/>
<rdf:Description rdf:about="&a;201755366"
	 b:glossaryEntry="engage in deceitful behavior; practice trickery or fraud"/>
<rdf:Description rdf:about="&a;201755593"
	 b:glossaryEntry="act with artful deceit"/>
<rdf:Description rdf:about="&a;201755678"
	 b:glossaryEntry="use a crib, as in an exam"/>
<rdf:Description rdf:about="&a;201755765"
	 b:glossaryEntry="be false to; be dishonest with"/>
<rdf:Description rdf:about="&a;201756057"
	 b:glossaryEntry="act as a shill"/>
<rdf:Description rdf:about="&a;201756134">
	<b:glossaryEntry>pull a fast one, play a trick on somebody; "We tricked the teacher into thinking that class would be cancelled next week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201756356"
	 b:glossaryEntry="make a fool or dupe of"/>
<rdf:Description rdf:about="&a;201756463">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be sexually unfaithful to one''s partner in marriage; "She cheats on her husband"; "Might her husband be wandering?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201756732">
	<b:glossaryEntry>carry on a romantic relationship with two people at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201756862">
	<b:glossaryEntry>fake or falsify; "Fudge the figures"; "cook the books"; "falsify the data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201757112"
	 b:glossaryEntry="juggle an account, for example, so as to hide a deficit"/>
<rdf:Description rdf:about="&a;201757231"
	 b:glossaryEntry="play a joke on or subject to a hoax"/>
<rdf:Description rdf:about="&a;201757328"
	 b:glossaryEntry="lure or entrap with or as if with a decoy"/>
<rdf:Description rdf:about="&a;201757432"
	 b:glossaryEntry="lure, entice, or entrap with bait"/>
<rdf:Description rdf:about="&a;201757527">
	<b:glossaryEntry>take or catch as if in a snare or trap; "I was set up!"; "The innocnet man was framed by the police"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201757718"
	 b:glossaryEntry="influence by slyness"/>
<rdf:Description rdf:about="&a;201757831">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fool or dupe; "He was snookered by the con-man''s smooth talk"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201757957">
	<b:glossaryEntry>celebrate, as of holidays or rites; "Keep the commandments"; "celebrate Christmas"; "Observe Yom Kippur"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201758181">
	<b:glossaryEntry>conform one''s action or practice to; of appointments, promises, conditions, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201758335"
	 b:glossaryEntry='act as promised; "make good on promises"'/>
<rdf:Description rdf:about="&a;201758442"
	 b:glossaryEntry="observe or perform with dignity or gravity"/>
<rdf:Description rdf:about="&a;201758551"
	 b:glossaryEntry="corrupt morally"/>
<rdf:Description rdf:about="&a;201758831">
	<b:glossaryEntry xml:space='preserve'><![CDATA[teach immoral behavior to; "It was common practice to lead off the young ones, and teach ''em bad habits."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201759016"
	 b:glossaryEntry="corrupt by lewd intercourse"/>
<rdf:Description rdf:about="&a;201759106">
	<b:glossaryEntry xml:space='preserve'><![CDATA[spoil as if by poison; "poison someone''s mind"; "poison the atmosphere in the office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201759263">
	<b:glossaryEntry>change something so that its value declines; for example, art forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201759411"
	 b:glossaryEntry="exert pressure on someone through threats"/>
<rdf:Description rdf:about="&a;201759542"
	 b:glossaryEntry="incite to commit a crime"/>
<rdf:Description rdf:about="&a;201759630">
	<b:glossaryEntry>bring a criminal action against (in a trial): "The State of California prosecuted O.J. Simpson"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201759792"
	 b:glossaryEntry="be the defense counsel for someone in a trial"/>
<rdf:Description rdf:about="&a;201759921"
	 b:glossaryEntry="conduct a prosecution in a court of law"/>
<rdf:Description rdf:about="&a;201760027">
	<b:glossaryEntry>institute legal proceedings against; file a suit against; "He was warned that the district attorney would process him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201760253">
	<b:glossaryEntry>perform an act, usually with a negative connotation: "perpetrate a crime"; "pull a bank robbery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201760469"
	 b:glossaryEntry='carry out or commit; "make a mistake"; "commit a faux-pas"'/>
<rdf:Description rdf:about="&a;201760589"
	 b:glossaryEntry="commit once again, as of a crime"/>
<rdf:Description rdf:about="&a;201760687"
	 b:glossaryEntry="take part in a rebellion; renounce a former allegiance"/>
<rdf:Description rdf:about="&a;201760873"
	 b:glossaryEntry="break with established customs"/>
<rdf:Description rdf:about="&a;201760985"
	 b:glossaryEntry="refuse to comply"/>
<rdf:Description rdf:about="&a;201761094">
	<b:glossaryEntry>make revolution; "The people revolted when bread prices tripled again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201761236"
	 b:glossaryEntry="engage in a mutiny against an authority"/>
<rdf:Description rdf:about="&a;201761339"
	 b:glossaryEntry="as of an organization, a country or an army"/>
<rdf:Description rdf:about="&a;201761499">
	<b:glossaryEntry>desert one''s party or group of friends, for example, for one''s personal advantage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201761649">
	<b:glossaryEntry>take part in a riot; disturb the public peace by engaging in a riot; "Students were rioting everywhere in 1968"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201761822"
	 b:glossaryEntry="act violently, recklessly, or destructively"/>
<rdf:Description rdf:about="&a;201761948"
	 b:glossaryEntry="try to stir up public opinion"/>
<rdf:Description rdf:about="&a;201762103"
	 b:glossaryEntry="cause a disturbance"/>
<rdf:Description rdf:about="&a;201762186"
	 b:glossaryEntry="encourage or assent to illegally; in criminal behavior"/>
<rdf:Description rdf:about="&a;201762305">
	<b:glossaryEntry>cause to suffer; "Jews were persecuted in the former Soviet Union"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201762493">
	<b:glossaryEntry>harass by imposing humiliating or painful tasks, as in military institutions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201762631">
	<b:glossaryEntry xml:space='preserve'><![CDATA[succeed in a big way; get to the top; "After he published his book, he had arrived"; "I don''t know whether I can make it in science!"; "You will go far, my boy!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201762892"
	 b:glossaryEntry='win approval or support for; "Carry all before one"'/>
<rdf:Description rdf:about="&a;201763032"
	 b:glossaryEntry="influence by corruption"/>
<rdf:Description rdf:about="&a;201763119"
	 b:glossaryEntry="control by magic spells, as by practicing witchcraft"/>
<rdf:Description rdf:about="&a;201763262">
	<b:glossaryEntry>exercise authority over; as of nations; "Who is governing the country now?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201763496"
	 b:glossaryEntry="govern badly"/>
<rdf:Description rdf:about="&a;201763583"
	 b:glossaryEntry="rule as a dictator"/>
<rdf:Description rdf:about="&a;201763684"
	 b:glossaryEntry="rule a country as a tyrant"/>
<rdf:Description rdf:about="&a;201763790"
	 b:glossaryEntry='have sovereign power; "Henry VIII reigned for a long time"'/>
<rdf:Description rdf:about="&a;201763911">
	<b:glossaryEntry>come to terms or deal successfully with; "We got by on just a gallon of gas."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201764211">
	<b:glossaryEntry xml:space='preserve'><![CDATA[informal: be able to manage or manage successfully; "I can''t hack it anymore"; "she could not cut the long days in the office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201764405">
	<b:glossaryEntry xml:space='preserve'><![CDATA[manage one''s existence barely; "I guess I can squeeze by on this lousy salary"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201764618">
	<b:glossaryEntry>become friends with; "John and Eric soon became friends"; "Have you made friends yet in your new environment?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201764812"
	 b:glossaryEntry="become friends; act friendly towards"/>
<rdf:Description rdf:about="&a;201764936"
	 b:glossaryEntry="refer to another"/>
<rdf:Description rdf:about="&a;201765037">
	<b:glossaryEntry>keep company with; hang out with; "He associates with strange people"; "She affiliates with her colleagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201765296">
	<b:glossaryEntry>join in an affiliation; "They affiliated themselves with the organization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201765437">
	<b:glossaryEntry xml:space='preserve'><![CDATA[engage in a crusade for a certain cause or person; "She is crusading for women''s rights"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201765626">
	<b:glossaryEntry>have recourse to; "The government resorted to rationing meat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201765771"
	 b:glossaryEntry='develop a habit; "He took to visiting bars"'/>
<rdf:Description rdf:about="&a;201765858">
	<b:glossaryEntry>settle as a colony; of countries in the developing world; "Europeans colonized Africa in the 17th century"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201766048">
	<b:glossaryEntry xml:space='preserve'><![CDATA[grant independence to (a former colony); "West Africa was decolonized in the early 1960''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201766224">
	<b:glossaryEntry>have amorous affairs; of men: "He has been womanizing for years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201766366">
	<b:glossaryEntry xml:space='preserve'><![CDATA[turn one''s interest to; "He took up herpetology at the age of fifty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201766517"
	 b:glossaryEntry="do something that one considers to be below one''s dignity"/>
<rdf:Description rdf:about="&a;201766660"
	 b:glossaryEntry="behave in a patronizing and condescending manner"/>
<rdf:Description rdf:about="&a;201766784">
	<b:glossaryEntry>be careful, prudent, or watchful; "Take care when you cross the street!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201766923">
	<b:glossaryEntry>encroach on the rights of others, as in trading without a proper license</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201767062">
	<b:glossaryEntry>release a criminal from detention and place him on parole; "The prisoner was paroled after serving 10 years in prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201767244">
	<b:glossaryEntry>to conclude or bring to a conclusion with some effort; "John worked hard to make that deal go through."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201767448"
	 b:glossaryEntry='gather and spend time together; "They always club together"'/>
<rdf:Description rdf:about="&a;201767569"
	 b:glossaryEntry='unite with a common purpose; "The two men clubbed together"'/>
<rdf:Description rdf:about="&a;201767698"
	 b:glossaryEntry="act as a master of ceremonies"/>
<rdf:Description rdf:about="&a;201767808"
	 b:glossaryEntry="as as a guardian to someone"/>
<rdf:Description rdf:about="&a;201767898"
	 b:glossaryEntry="act as a fag for older boys, in British public schools"/>
<rdf:Description rdf:about="&a;201768013"
	 b:glossaryEntry="act frivolously"/>
<rdf:Description rdf:about="&a;201768101"
	 b:glossaryEntry="trick or deceive"/>
<rdf:Description rdf:about="&a;201768189">
	<b:glossaryEntry>be in the service of, be a servant of, as of people, institutions, or ideas: "She served the art of music"; "He served the church"; "Marie served her mistress faithfully until her death"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201768446"
	 b:glossaryEntry="as of students taking an exam, to prevent cheating"/>
<rdf:Description rdf:about="&a;201768582"
	 b:glossaryEntry='act like the master of; "He is lording it over the students"'/>
<rdf:Description rdf:about="&a;201768789"
	 b:glossaryEntry="promote to a queen, as of a pawn in chess"/>
<rdf:Description rdf:about="&a;201768893">
	<b:glossaryEntry>chance to be or do something, without intention or causation: "I happen to have just what you need!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201769083">
	<b:glossaryEntry>be the case by chance; "I chanced to meet my old friend in the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201769235">
	<b:glossaryEntry>act, usually en masse, hurriedly or on an impulse: "Companies will now stampede to release their latest software"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201769414">
	<b:glossaryEntry>cause a group or mass of people to act on an impulse or hurriedly and impulsively; "The tavern owners stampeded us into overeating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201769619"
	 b:glossaryEntry='satisfy or fulfill; "meet a need"'/>
<rdf:Description rdf:about="&a;201769742">
	<b:glossaryEntry>prevent or interrupt due to rain; "The storm had washed out the game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201769888">
	<b:glossaryEntry>operate in a certain place, area, or specialty; "She works the night clubs"; "The salesman works the Midwest"; "This artist works mostly in acrylics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201770125">
	<b:glossaryEntry>make a point of doing something; act purposefully and intentionally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201770274">
	<b:glossaryEntry xml:space='preserve'><![CDATA[apply oneself diligently; "Ply one''s trade"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201770378">
	<b:glossaryEntry>apply oneself to: "We will attend to this matter as soon as possible"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201770511"
	 b:glossaryEntry='apply oneself to; "Please apply yourself to your homework"'/>
<rdf:Description rdf:about="&a;201770650"
	 b:glossaryEntry='do over; "They would like to take it over again"'/>
<rdf:Description rdf:about="&a;201770792"
	 b:glossaryEntry="repeat an action"/>
<rdf:Description rdf:about="&a;201770871"
	 b:glossaryEntry="be inactive, refrain from acting on something"/>
<rdf:Description rdf:about="&a;201770968">
	<b:glossaryEntry>get to know; get acquainted with; "I met this really handsome guy at a bar last night!"; "we met in Singapore"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201771130"
	 b:glossaryEntry="attend a dance or a party without a female companion"/>
<rdf:Description rdf:about="&a;201771226">
	<b:glossaryEntry>almost do or experience something; "She came near to screaming with fear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201771348">
	<b:glossaryEntry>take unawares; "She surprised the couple"; "He surprised an interesting scene"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201771500">
	<b:glossaryEntry>become filled with pride, arrogance, or anger; "The mother was swelling with importance when she spoke of her son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201771687">
	<b:glossaryEntry>get involved or mixed-up with; "He was about to mingle in an unpleasant affair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201771820">
	<b:glossaryEntry>remove from customary environment or associations; "Her busy schedule removed her from her duties as a mother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201772005">
	<b:glossaryEntry>put, bring, or take in a secretive or furtive manner: "sneak a look"; "sneak a cigarette"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201772157">
	<b:glossaryEntry>behave in a certain way; "play safe," "play it safe"; "Play into the hands of"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201772313">
	<b:glossaryEntry>present oneself formally, as before a (judicial) authority; "He had to appear in court last month"; "She appeared on several charges of theft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201772501">
	<b:glossaryEntry xml:space='preserve'><![CDATA[recover one''s good manners after a lapse or stop behaving badly; "Please remember yourself, Charles!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201772676">
	<b:glossaryEntry>get people together; "assemble your colleagues"; "get together all those who are interested in the project"; "gather the close family members"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201772926">
	<b:glossaryEntry>form by assembling individuals or constituents; "Make a quorum"; "The branches made a roof"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201773113"
	 b:glossaryEntry='commit adultery; "he plays around a lot"'/>
<rdf:Description rdf:about="&a;201773236"
	 b:glossaryEntry='come into the company of; "She joined him for a drink"'/>
<rdf:Description rdf:about="&a;201773334">
	<b:glossaryEntry xml:space='preserve'><![CDATA[live one''s life in a specified environment; "she moves in certain circles only"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201773475">
	<b:glossaryEntry>remove oneself from a familiar environment, usually for pleasure or diversion; "We escaped to our summer house for a few days"; "The president of the company never manages to get away during the summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201773760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deal with; usually used with a form of negation; "I wouldn''t touch her with a ten-foot pole"; "The local Mafia won''t touch gambling"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201773963"
	 b:glossaryEntry='be unable; "I fail to understand your motives"'/>
<rdf:Description rdf:about="&a;201774071"
	 b:glossaryEntry='carry out: "take action"; "take steps"; "take vengeance"'/>
<rdf:Description rdf:about="&a;201774189"
	 b:glossaryEntry="register in a hotel booker"/>
<rdf:Description rdf:about="&a;201774277">
	<b:glossaryEntry>take precautions in order to avoid some unwanted consequence; "guard against becoming too friendly with the staff"; "guard against infection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201774482">
	<b:glossaryEntry>happen or take place; "Things have been breaking pretty well for us in the past few months" (informal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201774647">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accept and follow the leadership of command or guidance of; "Let''s follow our great helmsman!"; "She followed a guru for years"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201774846">
	<b:glossaryEntry>seek or achieve an end by using; "She uses her influential friends to get jobs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201774994">
	<b:glossaryEntry>develop a habit; apply oneself to a practice or occupation; "She took to drink"; "Men take to the military trades"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201775163"
	 b:glossaryEntry='have an existence, be extant; "Is there a God?"'/>
<rdf:Description rdf:about="&a;201775421">
	<b:glossaryEntry>exist beforehand or prior to a certain point in time; "Did this condition pre-exist?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201775572">
	<b:glossaryEntry>be around; be alive or active; "Does the old man still kick around?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201775744"
	 b:glossaryEntry="exist together"/>
<rdf:Description rdf:about="&a;201775867"
	 b:glossaryEntry="coexist peacefully, as of nations"/>
<rdf:Description rdf:about="&a;201775973">
	<b:glossaryEntry>have the quality of being; (copula, used with an adjective or a predicate noun); "John is rich"; "This is not a good answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201778213">
	<b:glossaryEntry>be the sole or primary factor in the existence, acquisition, supply, or disposal of something; "Passing grades account for half of the grades given in this exam"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201778443">
	<b:glossaryEntry>be contrary to ordinary procedure or limitations; "Opinions on bombing the Serbs cut across party lines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201778615">
	<b:glossaryEntry>occupy a large, elongated area; "The park stretched beneath the train line"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201778771"
	 b:glossaryEntry="be located near or adjacent to"/>
<rdf:Description rdf:about="&a;201778879"
	 b:glossaryEntry="live or be located as a neighbor"/>
<rdf:Description rdf:about="&a;201778989">
	<b:glossaryEntry>have a beginning, in a temporal, spatial, or evaluative sense: "The DMZ begins right over the hill"; "The second movement begins after the Allegro"; "Prices for these homes start at $250,000"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201779375">
	<b:glossaryEntry>enter a particular state; "Laziness set in"; "After a few moments, the effects of the drug kicked in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201779550"
	 b:glossaryEntry='appear or develop; "The age of computers had dawned"'/>
<rdf:Description rdf:about="&a;201779664">
	<b:glossaryEntry>have an end, in a temporal, spatial, or quantitative sense: "My property ends by the bushes"; "The symphony ends in a pianissimo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201780161">
	<b:glossaryEntry>come to a close; "The concert closed with a nocturne by Chopin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201780295">
	<b:glossaryEntry>prove to be in the result or end; "How will the game turn out?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201780472"
	 b:glossaryEntry="come out in the end"/>
<rdf:Description rdf:about="&a;201780558"
	 b:glossaryEntry='turn out well; "Everything worked out in the end"'/>
<rdf:Description rdf:about="&a;201780673"
	 b:glossaryEntry='be in some specified state or condition; "I stand corrected"'/>
<rdf:Description rdf:about="&a;201780912"
	 b:glossaryEntry="determine the essential quality of"/>
<rdf:Description rdf:about="&a;201781091">
	<b:glossaryEntry>give a new or different definition to; "She redefined his duties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201781222">
	<b:glossaryEntry xml:space='preserve'><![CDATA[happen or come to pass; "I lost my wallet; this was during the visit to my parents'' house"; "There were two hundred people at his funeral"; "There was a lot of noise in the kitchen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201781568"
	 b:glossaryEntry="occur as an interlude"/>
<rdf:Description rdf:about="&a;201781656">
	<b:glossaryEntry>touch or seem as if touching; "Light fell on her face"; "The light struck the golden necklace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201781829"
	 b:glossaryEntry='occur persistently; "Musical talent runs in the family"'/>
<rdf:Description rdf:about="&a;201781945">
	<b:glossaryEntry>be present at (meetings, church services, university), etc.; "She attends class regularly"; "I rarely attend services at my church"; "did you go to the metting?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201782232">
	<b:glossaryEntry>attend religious services; "They worship in the traditional manner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201782390"
	 b:glossaryEntry='present as an act of worship; "offer prayers to the gods"'/>
<rdf:Description rdf:about="&a;201782539">
	<b:glossaryEntry>fail to attend an event or activity: "I missed the concert"; "He missed school for a week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201782727"
	 b:glossaryEntry='intentionally fail to attend: "cut class"'/>
<rdf:Description rdf:about="&a;201782836"
	 b:glossaryEntry='have life, be alive; "Our great leader is no more"'/>
<rdf:Description rdf:about="&a;201782943"
	 b:glossaryEntry="lead a certain kind of life; live in a certain style"/>
<rdf:Description rdf:about="&a;201783237">
	<b:glossaryEntry>live in a lively, modern, and relaxed style; "The Woodstock generation attempted to swing freely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201783397">
	<b:glossaryEntry>live so as to annul some previous behavior; "You can never live this down!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201783548"
	 b:glossaryEntry="indulge in a carefree or voluptuous way of life"/>
<rdf:Description rdf:about="&a;201783659"
	 b:glossaryEntry="lead a passive existence without using one''s body or mind"/>
<rdf:Description rdf:about="&a;201783782"
	 b:glossaryEntry="live like a pig, in squalor"/>
<rdf:Description rdf:about="&a;201783887"
	 b:glossaryEntry="live in the bush as a fugitive or as a guerilla"/>
<rdf:Description rdf:about="&a;201784001"
	 b:glossaryEntry="live like a buccaneer"/>
<rdf:Description rdf:about="&a;201784089"
	 b:glossaryEntry="lead a bachelor''s existence"/>
<rdf:Description rdf:about="&a;201784189">
	<b:glossaryEntry>live from day to day, as with some hardship: "He eked out his years in great poverty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201784339">
	<b:glossaryEntry>be identical to; be someone or something, as in "The president of the company is John Smith"; "This is my house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201784502"
	 b:glossaryEntry="live in the country and lead a rustic life"/>
<rdf:Description rdf:about="&a;201784619">
	<b:glossaryEntry>stay alive; survive; "he could barely exist on such a low wage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201784886"
	 b:glossaryEntry='be alive; "Every creature that breathes"'/>
<rdf:Description rdf:about="&a;201784999"
	 b:glossaryEntry="to exist as an inner activating spirit, force, or principle"/>
<rdf:Description rdf:about="&a;201785123"
	 b:glossaryEntry="live irresponsibly or freely"/>
<rdf:Description rdf:about="&a;201785226">
	<b:glossaryEntry xml:space='preserve'><![CDATA[proceed or get along; "How is she doing in her new job?" "How are you making out in graduate school?" "He''s come a long way"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201785455">
	<b:glossaryEntry>pass, fare, or elapse; of a certain state of affairs or action; "How is it going?" "The day went well until I got your call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201785639">
	<b:glossaryEntry>be or continue to be in a certain condition; "The children went hungry that day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201785787">
	<b:glossaryEntry>continue to live, endure or last; "We went without water and food for 3 days"; "The legend of Elvis lives on"; "These superstitions survive in the backwaters of America"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201786150"
	 b:glossaryEntry='persist or continue; "The rains lasted four days"'/>
<rdf:Description rdf:about="&a;201786261">
	<b:glossaryEntry xml:space='preserve'><![CDATA[resist or withstand wear, criticism, etc.; "Her shoes won''t hold up"; This theory won''t hold up"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201786433"
	 b:glossaryEntry="survive from season to season, of plants"/>
<rdf:Description rdf:about="&a;201786540"
	 b:glossaryEntry="live out one''s life; live to the end"/>
<rdf:Description rdf:about="&a;201786642"
	 b:glossaryEntry='a trial of endurance; "ride out the storm"'/>
<rdf:Description rdf:about="&a;201786779"
	 b:glossaryEntry='surpass in staying power; "They outstayed their competitors"'/>
<rdf:Description rdf:about="&a;201786912"
	 b:glossaryEntry="be reasonable or logical or comprehensible"/>
<rdf:Description rdf:about="&a;201787039"
	 b:glossaryEntry='live longer than; "She outlived her husband by many years"'/>
<rdf:Description rdf:about="&a;201787206">
	<b:glossaryEntry>continue in existence after (an adversity, etc.); "He survived the cancer against all odds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201787446">
	<b:glossaryEntry>die, as in battle or in a hunt; "Many soldiers fell at Verdun"; "Several deer have fallen to the same gun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201787648"
	 b:glossaryEntry="be fatally overwhelmed"/>
<rdf:Description rdf:about="&a;201787769">
	<b:glossaryEntry>form or compose; "This money is my only income"; "The stone wall was the backdrop for the performance"; "These constitute my entire belonging"; "The children made up the chorus"; "This sum represents my entire income for a year"; "These few men comprise his entire army"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201788243"
	 b:glossaryEntry='constitute the essence of; "Clothes make the man"'/>
<rdf:Description rdf:about="&a;201788354">
	<b:glossaryEntry>form the substance of; "Greed and ambition composed his personality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201788486">
	<b:glossaryEntry>to compose or represent:"This wall forms the background of the stage setting"; "The branches made a roof"; "This makes a fine introduction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201788779"
	 b:glossaryEntry="form a chelate, in chemistry"/>
<rdf:Description rdf:about="&a;201788872">
	<b:glossaryEntry>act as a barrier between; stand between: "The mountain range divides the two countries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201789016">
	<b:glossaryEntry>be connected; "In my heart I can make the world hang together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201789163">
	<b:glossaryEntry>be or become joined or united or linked; "The two streets connect to become a highway"; "Our paths joined"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201789365"
	 b:glossaryEntry="be interconnected, afford passage, as of rooms"/>
<rdf:Description rdf:about="&a;201789530"
	 b:glossaryEntry="connect or reduce the distance between"/>
<rdf:Description rdf:about="&a;201789664"
	 b:glossaryEntry="suffice for a period between two points"/>
<rdf:Description rdf:about="&a;201789797"
	 b:glossaryEntry='come into existence; "What becomes has duration"'/>
<rdf:Description rdf:about="&a;201789981">
	<b:glossaryEntry>develop into a distinctive entity; "our plans began to take shape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201790203">
	<b:glossaryEntry>come into existence or develop: "A new religious movement originated in that country" "a love that sprang up from friendship," "the idea for the book grew out of a short story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201790544"
	 b:glossaryEntry="happen or occur as a result of something"/>
<rdf:Description rdf:about="&a;201790679">
	<b:glossaryEntry>come forth or begin from a state of latency; "The first winter storm broke over New York"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201790831">
	<b:glossaryEntry>to be the product or result; "Melons come from a vine"; "Understanding comes from experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201791013"
	 b:glossaryEntry="form into beads, as of water or sweat, for example"/>
<rdf:Description rdf:about="&a;201791133"
	 b:glossaryEntry="become reticulated"/>
<rdf:Description rdf:about="&a;201791219"
	 b:glossaryEntry='originate or come into being; "aquestion arose"'/>
<rdf:Description rdf:about="&a;201791348"
	 b:glossaryEntry="form into an aggregated flocculent mass, as of protoplasms"/>
<rdf:Description rdf:about="&a;201791474"
	 b:glossaryEntry='form into a nucleus; "Some cells had nucleated"'/>
<rdf:Description rdf:about="&a;201791587">
	<b:glossaryEntry>as of feelings and thoughts, or other ephemeral things; "Strong emotions welled up"; "Smoke swelled from it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201791776">
	<b:glossaryEntry>undergo a change or development: "The water turned into ice"; "Her former friend became her worst enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201792071"
	 b:glossaryEntry="turn into a carbonate"/>
<rdf:Description rdf:about="&a;201792159">
	<b:glossaryEntry>develop into; "This idea will never amount to anything"; "nothing came of his grandiose plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201792351"
	 b:glossaryEntry="amount in the aggregate to"/>
<rdf:Description rdf:about="&a;201792444"
	 b:glossaryEntry="come from"/>
<rdf:Description rdf:about="&a;201792531">
	<b:glossaryEntry>grow out of, have roots in, originate in; "The increase in the national debt stems from the last war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201792695">
	<b:glossaryEntry>require as useful, just, or proper; "It takes nerve to do what she did"; "success usually requires hard work"; "This job asks a lot of patience and skill"; "This position demands a lot of personal sacrifice"; "This dinner demands a spectacular dessert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201793190">
	<b:glossaryEntry>require a specified depth for floating; "This boat draws 70 inches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201793319">
	<b:glossaryEntry>require to lose, suffer, or sacrifice; "This mistake cost him his job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201793451"
	 b:glossaryEntry='need badly or desperately"'/>
<rdf:Description rdf:about="&a;201793556"
	 b:glossaryEntry="do away with"/>
<rdf:Description rdf:about="&a;201793672"
	 b:glossaryEntry="make impossible, esp. beforehand"/>
<rdf:Description rdf:about="&a;201793793">
	<b:glossaryEntry xml:space='preserve'><![CDATA[include or contain; have as a component; "A totally new idea is comprised in this paper"; "The record contains many old songs from the 1930''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201794033">
	<b:glossaryEntry xml:space='preserve'><![CDATA[include in scope; include as part of something broader; have as one''s sphere or territory; "This group encompasses a wide range of people from different backgrounds"; "this should cover everyone in the group"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201794357">
	<b:glossaryEntry>have as a feature; "This restaurant features the most famous chefs in France"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201794776"
	 b:glossaryEntry='have: "bear a resemblance"; "bear a signature"'/>
<rdf:Description rdf:about="&a;201794910">
	<b:glossaryEntry>have as a by-product: "The big cities gave off so many wonderful American qualities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201795068">
	<b:glossaryEntry>have or possess in combination; "she unites charm with a good business sense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201795218"
	 b:glossaryEntry="feature as the star; of artistic performances"/>
<rdf:Description rdf:about="&a;201795343"
	 b:glossaryEntry="feature as the co-star in a performance"/>
<rdf:Description rdf:about="&a;201795447">
	<b:glossaryEntry>wear or display in an ostentatious or proud manner; "she was sporting a new hat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201795608">
	<b:glossaryEntry>show an attribute, property, knowledge, or skill; "he exhibits a great talent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201795751">
	<b:glossaryEntry>have as an attribute, knowledge, or skill; "he possesses great knowledge about the Middle East"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201795937">
	<b:glossaryEntry>be without; "This soup lacks salt"; "There is something missing in my jewellery box!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201796135">
	<b:glossaryEntry>be without, lack; be deficient in; "want courtesy"; "want the strength to go on living"; "flood victims wanting food and shelter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201796341"
	 b:glossaryEntry='be absent; "The child had been missing for a week"'/>
<rdf:Description rdf:about="&a;201796443">
	<b:glossaryEntry>have as a part, be made up out of; "The list includes the names of many famous writers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201796740">
	<b:glossaryEntry xml:space='preserve'><![CDATA[contain as a part; "Dinner at Joe''s always involves at least six courses"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201796878"
	 b:glossaryEntry='be composed of; "What does this dish consist of?"'/>
<rdf:Description rdf:about="&a;201796995">
	<b:glossaryEntry>be composed of; "The land he conquered comprised several provinces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201797154"
	 b:glossaryEntry="be equivalent or parallel, in mathematics"/>
<rdf:Description rdf:about="&a;201797280">
	<b:glossaryEntry>lack or fail to include; "The cost for the trip excludes food and beverages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201797447"
	 b:glossaryEntry='be shown or be found to be; "She proved to be right;'/>
<rdf:Description rdf:about="&a;201797616">
	<b:glossaryEntry>prove to be in the result or end; "It turns out that he was right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201797749">
	<b:glossaryEntry>issue or terminate (in a specified way, state, etc.); end; "result in tragedy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201797979"
	 b:glossaryEntry="be the result of"/>
<rdf:Description rdf:about="&a;201798079"
	 b:glossaryEntry='contain or include; "This new system subsumes the old one"'/>
<rdf:Description rdf:about="&a;201798202">
	<b:glossaryEntry>impose, involve, or imply as a necessary accompaniment or result; "What does this move entail?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201798374">
	<b:glossaryEntry>be the reason or explanation for; "The recession accounts for the slow retail business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201798530">
	<b:glossaryEntry>have as a logical consequence; "The water shortage means that we have to stop taking long showers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201798707"
	 b:glossaryEntry="cause to be a concomitant"/>
<rdf:Description rdf:about="&a;201798819">
	<b:glossaryEntry>result in; "The water left a mark on the silk dress"; "Her blood left a stain on the napkin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201799008">
	<b:glossaryEntry>tend to or result in; "This remark lead to further arguments among the guests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201799148"
	 b:glossaryEntry='make possible; "The grant made our research possible"'/>
<rdf:Description rdf:about="&a;201799332">
	<b:glossaryEntry>make accessible; "This answer opens the door to new objections"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201799466">
	<b:glossaryEntry>have as a necessary feature or consequence; entail; "This decision involves many changes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201799646">
	<b:glossaryEntry>be necessarily associated with or result in or involve; "This crime carries a penalty of five years in prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201799837"
	 b:glossaryEntry="get involved in or with"/>
<rdf:Description rdf:about="&a;201799948"
	 b:glossaryEntry="suggest that someone is guilty"/>
<rdf:Description rdf:about="&a;201800067">
	<b:glossaryEntry>dwell (archaic); "You can stay with me while you are in town"; "stay a bit longer--the day is still young"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201800268">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stay too long; "overstay or outstay one''s welcome"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201800394">
	<b:glossaryEntry>cause to wait by being late; "She kept him waiting for two hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201800547">
	<b:glossaryEntry>be left; of persons, questions, problems, results, evidence, etc. "There remains the question of who pulled the trigger"; "Carter remains the only President in recent history under whose Presidency the U.S. did not fight a war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201800838">
	<b:glossaryEntry>stay in one place and anticipate or expect something; "I had to wait on line for an hour to get the tickets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201801052">
	<b:glossaryEntry>wait or pass the time aimlessly or futilely; be kept waiting; "She kicked her heels for hours at the gate of the Embassy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201801271"
	 b:glossaryEntry="be available or ready for a certain function or service"/>
<rdf:Description rdf:about="&a;201801421"
	 b:glossaryEntry='be loyal to; "She stood by her husband in times of trouble"'/>
<rdf:Description rdf:about="&a;201801598">
	<b:glossaryEntry>be about; "The high school students like to loiter in the Central Square"; "Who is this man that is hanging around the department?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201801944"
	 b:glossaryEntry="loiter about, with no apparent aim"/>
<rdf:Description rdf:about="&a;201802057"
	 b:glossaryEntry='be lazy or idle; "Her son is just bumming around all day"'/>
<rdf:Description rdf:about="&a;201802321"
	 b:glossaryEntry='hang around idly; "She did all the work while he lay around"'/>
<rdf:Description rdf:about="&a;201802469">
	<b:glossaryEntry>lie in wait, lie in ambush, behave in a sneaky and secretive manner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201802606"
	 b:glossaryEntry="delay"/>
<rdf:Description rdf:about="&a;201802691">
	<b:glossaryEntry>hesitate when confronted with a problem, or when in doubt or fear</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201802820">
	<b:glossaryEntry>pause or hold back in uncertainty or unwillingness: "Authorities hesitate to quote exact figures."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201803107"
	 b:glossaryEntry='move to and fro; "The shy student lingered in the corner"'/>
<rdf:Description rdf:about="&a;201803236">
	<b:glossaryEntry>interrupt temporarily an activity before continuing; "The speaker paused"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201803427">
	<b:glossaryEntry>hesitate on moral grounds; "The man scrupled to perjure himself"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201803556"
	 b:glossaryEntry="wait before acting"/>
<rdf:Description rdf:about="&a;201803711">
	<b:glossaryEntry>wait uncompromisingly for something desirable; "He held out for the dessert and did not touch the cheeses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201803891"
	 b:glossaryEntry="act later than planned or scheduled"/>
<rdf:Description rdf:about="&a;201804043">
	<b:glossaryEntry>postpone doing what one should be doing; "He did not want to write the letter and procrastinated for days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201804260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[hold back to a later time; "let''s postpone the exam"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201804607">
	<b:glossaryEntry>stop or postpone because of adverse conditions, such as bad weather; "call a football game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201804760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stop dealing with; "hold all calls to the President''s office while he is in a meeting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201804908"
	 b:glossaryEntry="grant a respite to"/>
<rdf:Description rdf:about="&a;201804999"
	 b:glossaryEntry="as of a prison sentence"/>
<rdf:Description rdf:about="&a;201805087">
	<b:glossaryEntry>put a convicted person on probation by suspending his sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201805214">
	<b:glossaryEntry>postpone the punishment of a convicted criminal, such as an execution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201805360">
	<b:glossaryEntry>be larger in number, quantity, or importance; "Money reigns supreme here"; "Hispanics predominate in this neighborhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201805644"
	 b:glossaryEntry="be excessive in quantity"/>
<rdf:Description rdf:about="&a;201805733">
	<b:glossaryEntry>be central or dominant: "This scene overarches the entire first act"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201805867"
	 b:glossaryEntry="be larger in number"/>
<rdf:Description rdf:about="&a;201805970">
	<b:glossaryEntry>add up in number or quantity; "The bills amounted to $2,000"; "The bill came to $2,000"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201806208">
	<b:glossaryEntry>amount to or come to an average, without loss or gain; "The number of hours I work per work averages out to 40"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201806398"
	 b:glossaryEntry="weigh more heavily"/>
<rdf:Description rdf:about="&a;201806524">
	<b:glossaryEntry>have weight; have import, carry weight; "It does not matter much"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201806713">
	<b:glossaryEntry>to be oppressive or burdensome; "weigh heavily on the mind", "Something pressed on his mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201806876"
	 b:glossaryEntry="be worthy of or have a certain rating"/>
<rdf:Description rdf:about="&a;201807001">
	<b:glossaryEntry>be worth or be capable of buying; "This sum will buy you a ride on the train"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201807157">
	<b:glossaryEntry>be in control; rule the roost; "Her husband complete dominates her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201807334"
	 b:glossaryEntry='overcome; "overbear criticism, protest, or arguments"'/>
<rdf:Description rdf:about="&a;201807461">
	<b:glossaryEntry>enter into and control, as of emotions or ideas; "What possessed you to buy this house?" "A terrible rage possessed her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201807646">
	<b:glossaryEntry>cease to exist after resistance or a struggle; "These stories die hard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201807836">
	<b:glossaryEntry>extend or continue for a certain period of time; "The film runs 5 hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201807979"
	 b:glossaryEntry='cause to continue or prevail; "perpetuate a myth"'/>
<rdf:Description rdf:about="&a;201808114"
	 b:glossaryEntry="cause to continue indefinitely"/>
<rdf:Description rdf:about="&a;201808210"
	 b:glossaryEntry='be valid, applicable, or true; "This theory still holds"'/>
<rdf:Description rdf:about="&a;201808347"
	 b:glossaryEntry="live (in a certain place)"/>
<rdf:Description rdf:about="&a;201808536"
	 b:glossaryEntry='occupy the whole of; "The liquid fills the container"'/>
<rdf:Description rdf:about="&a;201808714"
	 b:glossaryEntry="wet thoroughly"/>
<rdf:Description rdf:about="&a;201808799"
	 b:glossaryEntry='fill beyond capacity; "The water flooded the fields"'/>
<rdf:Description rdf:about="&a;201808934">
	<b:glossaryEntry>fill or occupy to the point of overflowing; "The students crowded the auditorium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201809086"
	 b:glossaryEntry='take up time or space; "take up the slack"'/>
<rdf:Description rdf:about="&a;201809193">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reside temporarily; "I''m staying at the Hilton"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201809305"
	 b:glossaryEntry="occupy (a dwelling) illegally"/>
<rdf:Description rdf:about="&a;201809405">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make one''s home or live in; "There are only 250,000 people in Island"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201809753">
	<b:glossaryEntry>room or live together; usually said of two people who are not married</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201809924"
	 b:glossaryEntry="house temporarily, as a guest"/>
<rdf:Description rdf:about="&a;201810092">
	<b:glossaryEntry>maintain or support; "He is keeping three women in the guest cottage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201810231">
	<b:glossaryEntry>be a lodger; stay temporarily; "Where are you lodging in Paris?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201810376">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stay overnight; "The boy''s friends were allowed to sleep over"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201810514"
	 b:glossaryEntry="interrupt a journey temporarily, e.g., overnight"/>
<rdf:Description rdf:about="&a;201810648"
	 b:glossaryEntry="provide housing for, of military personnel"/>
<rdf:Description rdf:about="&a;201810781">
	<b:glossaryEntry>originate (in); "The problems dwell in the social injustices in this country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201810991"
	 b:glossaryEntry="be inherent in something"/>
<rdf:Description rdf:about="&a;201811079"
	 b:glossaryEntry="be a part or attribute of"/>
<rdf:Description rdf:about="&a;201811181">
	<b:glossaryEntry>be awarded; be allotted; "The first prize goes to Mary"; "Her money went on clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201811315"
	 b:glossaryEntry="live in a tent"/>
<rdf:Description rdf:about="&a;201811429"
	 b:glossaryEntry="be present in; be inside of"/>
<rdf:Description rdf:about="&a;201811585"
	 b:glossaryEntry="live on or in a host, as of parasites"/>
<rdf:Description rdf:about="&a;201811686"
	 b:glossaryEntry="inhabit a nest, as of birds and some insects"/>
<rdf:Description rdf:about="&a;201811792">
	<b:glossaryEntry>occupy a certain position or area; be somewhere; "Where is my umbrella?" "The toolshed is in the back"; also for abstract situations and relations: "What is behind this behavior?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201812363"
	 b:glossaryEntry="stay clear of"/>
<rdf:Description rdf:about="&a;201812485"
	 b:glossaryEntry='be clear and obvious; "A shining example"'/>
<rdf:Description rdf:about="&a;201812589"
	 b:glossaryEntry="place in a chamber"/>
<rdf:Description rdf:about="&a;201812680"
	 b:glossaryEntry="secretly shelter (as of fugitives or criminals)"/>
<rdf:Description rdf:about="&a;201812809"
	 b:glossaryEntry="provide shelter for"/>
<rdf:Description rdf:about="&a;201813015"
	 b:glossaryEntry="live and take one''s meals (in a certain place)"/>
<rdf:Description rdf:about="&a;201813131"
	 b:glossaryEntry="provide with shelter"/>
<rdf:Description rdf:about="&a;201813216">
	<b:glossaryEntry xml:space='preserve'><![CDATA[occupy, usually uninvited; "My son''s friends crashed our house last weekend"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201813355">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be compatible, similar or consistent; coincide in their characteristics; "The two stories don''t agree in many details"; "The handwriting checks with the signature on the check"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201814037">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be verified or confirmed; pass inspection; "These stories don''t check!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201814183">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accord in appearance with; "You don''t look your age!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201814306">
	<b:glossaryEntry>match or correspond; "The drawing of the suspect answers to the description the victim gave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201814470"
	 b:glossaryEntry='be the same; "our views on this matter coincided"'/>
<rdf:Description rdf:about="&a;201814585"
	 b:glossaryEntry="align with; be or come into adjustment"/>
<rdf:Description rdf:about="&a;201814686"
	 b:glossaryEntry="to establish or bear reciprocal or mutual relations"/>
<rdf:Description rdf:about="&a;201814823"
	 b:glossaryEntry='be parallel to; "Their roles are paralleled by ours"'/>
<rdf:Description rdf:about="&a;201814941">
	<b:glossaryEntry>duplicate or match; "The polished surface twinned his face and chest in reverse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201815106"
	 b:glossaryEntry='be compatible with; "one idea squares with another"'/>
<rdf:Description rdf:about="&a;201815221"
	 b:glossaryEntry="cause to match, as of ideas or acts"/>
<rdf:Description rdf:about="&a;201815328">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be the right size or shape; fit correctly or as desired; "This skirt won''t go around your waist"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201815508"
	 b:glossaryEntry='fit as if by joints: "The boards fit neatly"'/>
<rdf:Description rdf:about="&a;201815615"
	 b:glossaryEntry="fit together tightly, as if by means of a dovetail"/>
<rdf:Description rdf:about="&a;201815749"
	 b:glossaryEntry="go_with, fall together"/>
<rdf:Description rdf:about="&a;201815891"
	 b:glossaryEntry="coincide partially"/>
<rdf:Description rdf:about="&a;201815982"
	 b:glossaryEntry="go or occur together, as of words"/>
<rdf:Description rdf:about="&a;201816128"
	 b:glossaryEntry='be due; "payments fall on the 1st of the month"'/>
<rdf:Description rdf:about="&a;201816255"
	 b:glossaryEntry="conform to a metrical pattern; of poetic verse"/>
<rdf:Description rdf:about="&a;201816363"
	 b:glossaryEntry="be at variance with; be out of line with"/>
<rdf:Description rdf:about="&a;201816538"
	 b:glossaryEntry='be subject to change: "Prices vary"'/>
<rdf:Description rdf:about="&a;201816635"
	 b:glossaryEntry="be similar, be in line with"/>
<rdf:Description rdf:about="&a;201816761"
	 b:glossaryEntry="be in contradiction with"/>
<rdf:Description rdf:about="&a;201816870">
	<b:glossaryEntry>support with evidence or authority : make more certain or confirm; "The stories and claims were born out by the evidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201817101">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be based on; of theories and claims, for example; "What''s this new evidence based on?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201817306"
	 b:glossaryEntry='Elliptical use of "depend on": "That depends"'/>
<rdf:Description rdf:about="&a;201817415"
	 b:glossaryEntry="be or form the base for"/>
<rdf:Description rdf:about="&a;201817504"
	 b:glossaryEntry="be inherent or innate in;"/>
<rdf:Description rdf:about="&a;201817610">
	<b:glossaryEntry>be identical or equivalent to: "One dollar equals 1,000 rubles these days!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201817797">
	<b:glossaryEntry>be tantamount or equivalent to; "Her action amounted to a rebellion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201817929">
	<b:glossaryEntry>amount to; "This salary increase makes no difference to my standard of living"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201818087">
	<b:glossaryEntry>appear like; be similar to "She resembles her mother very much"; "This paper resembles my own work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201818384"
	 b:glossaryEntry='bear a physical resemblance to; "She looks like her mother"'/>
<rdf:Description rdf:about="&a;201818534">
	<b:glossaryEntry>be lifelike; as of paintings: "If you look at it long enough, this portrait comes to life!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201818703"
	 b:glossaryEntry='be similar to a relative; "She takes after her father!"'/>
<rdf:Description rdf:about="&a;201818827"
	 b:glossaryEntry='be close or similar; "Her results approximate my own"'/>
<rdf:Description rdf:about="&a;201818988"
	 b:glossaryEntry='be different; "These two tests differ in only one respect"'/>
<rdf:Description rdf:about="&a;201819172">
	<b:glossaryEntry>place in opposition: can also be used in an abstract sense; "Oppose thy steadfast gazing eyes to mine"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201819394"
	 b:glossaryEntry="constitute a counterweight or counterbalance to"/>
<rdf:Description rdf:about="&a;201819549"
	 b:glossaryEntry="to show differences when compared; be different"/>
<rdf:Description rdf:about="&a;201819739"
	 b:glossaryEntry='be in conflict; "The two proposals conflict!"'/>
<rdf:Description rdf:about="&a;201819876"
	 b:glossaryEntry="come into fashion; become fashionable"/>
<rdf:Description rdf:about="&a;201819996"
	 b:glossaryEntry="go out of fashion; become unfashionable"/>
<rdf:Description rdf:about="&a;201820117">
	<b:glossaryEntry>be incompatible; be or come into conflict; "These colors clash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201820283"
	 b:glossaryEntry="of a condition or restriction"/>
<rdf:Description rdf:about="&a;201820473">
	<b:glossaryEntry>be appropriate or necessary; "IT behooves us to reflect on this matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201820618">
	<b:glossaryEntry>fail to agree with; be in violation of; as of rules or patterns; "He violated the agreement to stay away from his ex-wife"; "You are breaking the law!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201820863"
	 b:glossaryEntry="fail to observe; of rules"/>
<rdf:Description rdf:about="&a;201820991"
	 b:glossaryEntry='go beyond; "She exceeded out expectations"'/>
<rdf:Description rdf:about="&a;201821151"
	 b:glossaryEntry='go beyond; "Their loyalty exceeds their national bonds"'/>
<rdf:Description rdf:about="&a;201821274">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be sufficient; be adequate, either in quality or quantity; "A few words would answer"; "This car suits my purpose well"; "Will $100 do?"; "A "B" grade doesn''t suffice to get me into medical school"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201821648"
	 b:glossaryEntry="suffice or be adequate for a while or to a certain extent"/>
<rdf:Description rdf:about="&a;201821776">
	<b:glossaryEntry>contribute or conduce to; "The scandal served to increase his popularity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201821939">
	<b:glossaryEntry>promote; "Art serves commerce"; "Their interests are served"; "The lake serves recreation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201822108">
	<b:glossaryEntry>serve a purpose, role, or function; "The tree stump serves as a table"; "The female students served as a control group"; "This table would serve very well"; "His freedom served him well"; The table functions as a desk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201822460">
	<b:glossaryEntry>serve as a means of entrance; "This ticket will admit one adult to the show"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201822625"
	 b:glossaryEntry="serve as a prelude to"/>
<rdf:Description rdf:about="&a;201822711">
	<b:glossaryEntry>function as or act like; "This heap of stones will act a s a barrier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201822860"
	 b:glossaryEntry="fail to satisfy, as of expectations, for example"/>
<rdf:Description rdf:about="&a;201822979"
	 b:glossaryEntry="fulfil the requirements or expectations of"/>
<rdf:Description rdf:about="&a;201823180">
	<b:glossaryEntry>be equal to in quality or ability; "Nothing can rival cotton for durability"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201823352"
	 b:glossaryEntry="make up for, make good"/>
<rdf:Description rdf:about="&a;201823527"
	 b:glossaryEntry="compensate or make up for"/>
<rdf:Description rdf:about="&a;201823633"
	 b:glossaryEntry="bring into balance or equilibrium"/>
<rdf:Description rdf:about="&a;201823857">
	<b:glossaryEntry>throw out of balance or equilibrium; "The tax relief unbalanced the budget"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201824007"
	 b:glossaryEntry="take precedence or surpass others in rank"/>
<rdf:Description rdf:about="&a;201824128"
	 b:glossaryEntry='distinguish oneself; "She excelled in math"'/>
<rdf:Description rdf:about="&a;201824318">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be extremely bad in quality or in one''s performance; "This term paper stinks!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201824467"
	 b:glossaryEntry='be good at; "She shines at math"'/>
<rdf:Description rdf:about="&a;201824584"
	 b:glossaryEntry="be highly noticeable"/>
<rdf:Description rdf:about="&a;201824716">
	<b:glossaryEntry>be or be capable of being changed or made into; "He makes a great host"; "He will make a fine father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201824887">
	<b:glossaryEntry>imitate in behavior or appearance; "She is imitating the comedian very well!"; "Her little brother apes her behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201825126"
	 b:glossaryEntry='call to mind: "His words echoed John F. Kennedy"'/>
<rdf:Description rdf:about="&a;201825253"
	 b:glossaryEntry="do what someone else is doing"/>
<rdf:Description rdf:about="&a;201825351"
	 b:glossaryEntry="strive to equal or match"/>
<rdf:Description rdf:about="&a;201825455">
	<b:glossaryEntry xml:space='preserve'><![CDATA[provide for; "The grant doesn''t cover my salary"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201825574">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be about; have to do with; be relevant to; refer, pertain, or relate to; "What''s this novel all about?"; "There were lots of questions referring to her talk"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201825948">
	<b:glossaryEntry>center upon; "Her entire attention centered on her children"; "Our day revolved around our work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201826205">
	<b:glossaryEntry>be pertinent or relevant or applicable; "The same laws apply to you!" "This theory holds for all irrational numbers"; "The same rules go for everyone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201826476">
	<b:glossaryEntry>connect closely and often incriminatingly; "This new ruling affects your business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201826657">
	<b:glossaryEntry xml:space='preserve'><![CDATA[engage as a participant; "Don''t involve me in your family affairs!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201826833">
	<b:glossaryEntry xml:space='preserve'><![CDATA[force into some kind of situation, condition, or course of action; "They were swept up by the events"; "don''t drag me into this business"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201827088">
	<b:glossaryEntry>free from involvement or entanglement; "How can I disentangle myself from her personal affiars?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201827287"
	 b:glossaryEntry='entrap; "Our people should not be mired in the past"'/>
<rdf:Description rdf:about="&a;201827420"
	 b:glossaryEntry='be on the mind of; "What is worrying you?"'/>
<rdf:Description rdf:about="&a;201827564">
	<b:glossaryEntry>occupy urgently or obsessively; "This matter proccupies her completely--she cannot think of anything else"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201827745"
	 b:glossaryEntry='be of importance or consequence; "This matters to me!"'/>
<rdf:Description rdf:about="&a;201827903"
	 b:glossaryEntry="cause to be interested or curious"/>
<rdf:Description rdf:about="&a;201828040"
	 b:glossaryEntry="prove capable or fit; meet requirements"/>
<rdf:Description rdf:about="&a;201828165">
	<b:glossaryEntry>come first in a series; "The number "one" begins the sequence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201828272"
	 b:glossaryEntry="lengthen or extend in duration or space"/>
<rdf:Description rdf:about="&a;201828422">
	<b:glossaryEntry>keep or maintain in unaltered condition; cause to remain or last; "preserve the peace in the family"; "continue the family tradition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201828796"
	 b:glossaryEntry="stem the flow of"/>
<rdf:Description rdf:about="&a;201828906"
	 b:glossaryEntry='used in the imperative: "Cheese it!"'/>
<rdf:Description rdf:about="&a;201829006">
	<b:glossaryEntry>put an end to a state or an activity; "Quit teasing your little brother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201829329"
	 b:glossaryEntry='give up: "break cigarette smoking"'/>
<rdf:Description rdf:about="&a;201829444">
	<b:glossaryEntry>cause to give up a habit; "She finally broke herself of smoking cigarettes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201829600">
	<b:glossaryEntry>keep in a certain state, position, or activity; e.g., "keep clean"; "hold in place"; "She always held herself as a lady"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201830158">
	<b:glossaryEntry xml:space='preserve'><![CDATA[keep as a debtor in one''s account: "He carried the enumployed customer for several months"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201830311"
	 b:glossaryEntry="keep at a distance"/>
<rdf:Description rdf:about="&a;201830403">
	<b:glossaryEntry>maintain a household; take care of all household-related business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201830535">
	<b:glossaryEntry>remain in a certain state, position, or condition; "The weather held"; "They held on the road and kept marching"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201830717">
	<b:glossaryEntry>end weakly; "The music just petered out--there was no proper ending"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201830886">
	<b:glossaryEntry>come or be at an end; "the support from our sponsoring agency will discontinue after March 31"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201831139">
	<b:glossaryEntry>come to an end; "the road leaves off at the edge of the forest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201831269"
	 b:glossaryEntry='continue uninterrupted; "The disease will run on unchecked"'/>
<rdf:Description rdf:about="&a;201831413">
	<b:glossaryEntry>continue talking or writing in a desultory manner: "This novel rambles on and jogs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201831586"
	 b:glossaryEntry='continue undisturbed and without interference; "Let it ride"'/>
<rdf:Description rdf:about="&a;201831708"
	 b:glossaryEntry='lose validity; "My passports expired last month"'/>
<rdf:Description rdf:about="&a;201831830">
	<b:glossaryEntry>have end in a certain location; either spatial or metaphorical; "the bronchioles terminate in a capillary bed"; "Your rights stop where you infringe upon the rights of other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201832078">
	<b:glossaryEntry>continue a certain state, condition, or activity; "Keep on working!" "We continued to work into the night"; "Keep smiling"; "We went on working until well past midnight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201832499">
	<b:glossaryEntry>to cover a wide area; "Rivers traverse the valley floor", "The parking lot spans 3 acres"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201832678">
	<b:glossaryEntry>to extend as far as, "The sunlight reached the wall";"Can he reach?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201832891">
	<b:glossaryEntry xml:space='preserve'><![CDATA[stretch out over a distance, space, time, or scope; run or extend between two points or beyond a certain point; "Service runs all the way to Cranbury"; "His knowledge doesn''t go very far"; "My memory extends back to my fourth year of life"; "The facts extend beyond a consideration of her personal assets"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201833375">
	<b:glossaryEntry>lead. extend, or afford access; "This door goes to the basement"; "The road runs South"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201833529">
	<b:glossaryEntry>cause something to pass or lead somewhere; "Run the wire behind the cabinet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201833691">
	<b:glossaryEntry>extend or reach; "The water came up to my waist"; "The sleeves come to your knuckles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201833838"
	 b:glossaryEntry="extend like the radii of a circle"/>
<rdf:Description rdf:about="&a;201833942"
	 b:glossaryEntry='occur in soft rounded shapes; "The hills rolled past"'/>
<rdf:Description rdf:about="&a;201834058"
	 b:glossaryEntry="be ahead of others; be at the top; be the first"/>
<rdf:Description rdf:about="&a;201834207"
	 b:glossaryEntry="run around the rim of"/>
<rdf:Description rdf:about="&a;201834307">
	<b:glossaryEntry>go along the rim, like a beard around the chin; "Houses bearded the top of the heights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201834457">
	<b:glossaryEntry>span an interval of distance, space or time; "The war extended over five years"; "The period covered the turn of the century"; "My land extends over the hills on the horizon"; "This farm covers some 200 acres"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201834846">
	<b:glossaryEntry>extend over and cover a part of; "The roofs of the houses overlap in this crowded city"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201834998">
	<b:glossaryEntry>spread across or over; "A big oil spot spread across the water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201835138"
	 b:glossaryEntry='extend in ridges: "The land ridges towards the South"'/>
<rdf:Description rdf:about="&a;201835254">
	<b:glossaryEntry>scatter or intersperse like dots or studs; "Hills constellated with lights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201835411">
	<b:glossaryEntry>reach outward in space; "This rock sticks out"; "The awning extends several feet over the sidewalk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201835617"
	 b:glossaryEntry="run into or up to"/>
<rdf:Description rdf:about="&a;201835702">
	<b:glossaryEntry>range or extend over; occupy a certain area; "The plants straddle the entire state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201835877">
	<b:glossaryEntry>stretch over; "His residences spread-eagle the entire county"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201836008"
	 b:glossaryEntry="be located or situated somewhere; occupy a certain position"/>
<rdf:Description rdf:about="&a;201836406"
	 b:glossaryEntry='lie moored or anchored; "Ship rides at anchor"'/>
<rdf:Description rdf:about="&a;201836514"
	 b:glossaryEntry="lie partly over or alongside of something or of one another"/>
<rdf:Description rdf:about="&a;201836635">
	<b:glossaryEntry>concentrate on a particular place or spot; "The infection has localized in the left eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201836789"
	 b:glossaryEntry='lie obliquely; "A scar slanted across his face"'/>
<rdf:Description rdf:about="&a;201836899">
	<b:glossaryEntry>come before; "Most English adjectives precede the noun they modify"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201837041"
	 b:glossaryEntry='sit around, often unused; "The object sat in the corner"'/>
<rdf:Description rdf:about="&a;201837166"
	 b:glossaryEntry="lie underneath"/>
<rdf:Description rdf:about="&a;201837246"
	 b:glossaryEntry="lie at the top of"/>
<rdf:Description rdf:about="&a;201837332">
	<b:glossaryEntry>face in a certain direction, often with respect to another reference point; be opposite to; "The house looks north"; "My backyard look onto the pond"; "The building faces the park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201837625">
	<b:glossaryEntry>be opposite; "In this exercise, the gymnast should face the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201837761"
	 b:glossaryEntry="be opposite to; of angles and sides, in geometry"/>
<rdf:Description rdf:about="&a;201837884"
	 b:glossaryEntry='be in back of; "My garage backs their yard"'/>
<rdf:Description rdf:about="&a;201838007"
	 b:glossaryEntry="be located at the sides of something or somebody"/>
<rdf:Description rdf:about="&a;201838134"
	 b:glossaryEntry="be in the front of or on top of;"/>
<rdf:Description rdf:about="&a;201838273"
	 b:glossaryEntry='be on top of; "The scarf surmounted the gown"'/>
<rdf:Description rdf:about="&a;201838402">
	<b:glossaryEntry>form the topmost part of; "A wheater vane crowns the building"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201838527"
	 b:glossaryEntry='set on or as if on a pinnacle; "pinnacle a pediment"'/>
<rdf:Description rdf:about="&a;201838645">
	<b:glossaryEntry>determine or indicate the place, site, or limits of; "Our sense of sight enables us to locate objects in space"; "Can you locate China on the map?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201838902">
	<b:glossaryEntry>locate within a specific region of a chromosome in relation to known DNA or gene sequences; "map the genes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201839070">
	<b:glossaryEntry>identify the location or place of; "We localized the source of the infection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201839221"
	 b:glossaryEntry='look down on; "The villa dominates the town"'/>
<rdf:Description rdf:about="&a;201839380"
	 b:glossaryEntry="cast a shadow"/>
<rdf:Description rdf:about="&a;201839478"
	 b:glossaryEntry="appear very large"/>
<rdf:Description rdf:about="&a;201839580"
	 b:glossaryEntry='rise up; "The building rose before them"'/>
<rdf:Description rdf:about="&a;201839722">
	<b:glossaryEntry>come into view indistinctly, often threateningly; "Another air plane loomed into the sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201839881">
	<b:glossaryEntry>pose a threat to; present a danger to; "The pollution is endangering the crops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201840093"
	 b:glossaryEntry="be suspended over or hang over"/>
<rdf:Description rdf:about="&a;201840198"
	 b:glossaryEntry="be foolish or senile due to old age"/>
<rdf:Description rdf:about="&a;201840295">
	<b:glossaryEntry>represent, as of a character on stage; "Derek Jacobi was Hamlet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201840484">
	<b:glossaryEntry>be characteristic of; "What characterizes a Venetian painting?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201840661"
	 b:glossaryEntry="give individual character to"/>
<rdf:Description rdf:about="&a;201840766"
	 b:glossaryEntry='determine the nature of; "What defines a good wine?"'/>
<rdf:Description rdf:about="&a;201840890">
	<b:glossaryEntry>represent in bodily form; "He embodies all that is evil wrong with the system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201841083"
	 b:glossaryEntry="incarnate anew"/>
<rdf:Description rdf:about="&a;201841166"
	 b:glossaryEntry="invest with or as with a body"/>
<rdf:Description rdf:about="&a;201841277"
	 b:glossaryEntry="be typical of"/>
<rdf:Description rdf:about="&a;201841374"
	 b:glossaryEntry="take the place of"/>
<rdf:Description rdf:about="&a;201841491">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be homologous; "A person''s arms homologize with a quadruped''s forelimbs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201841631"
	 b:glossaryEntry="accord or comport with"/>
<rdf:Description rdf:about="&a;201841740">
	<b:glossaryEntry xml:space='preserve'><![CDATA[go together; "The colors don''t harmonize"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201841936">
	<b:glossaryEntry xml:space='preserve'><![CDATA[blend or harmonize; "This flavor will blend with those in your dish"; "This sofa won''t go with the chairs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201842129">
	<b:glossaryEntry>be sounded, played, or expressed; "How does this song go again?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201842235"
	 b:glossaryEntry='be contained in; "How many times does 18 go into 54?"'/>
<rdf:Description rdf:about="&a;201842330">
	<b:glossaryEntry>contain or hold; have within: "The jar carries wine"; "The canteen holds fresh water"; "This can contains water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201842620">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be capable of holding or containing; "This box won''t take all the items"; "The flask holds one gallon"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201842856">
	<b:glossaryEntry>be able to accommodate for sleeping; "This tent sleeps six people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201842985">
	<b:glossaryEntry>hold within; "This soil retains water"; "I retain this drug for a long time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201843133"
	 b:glossaryEntry='contain or cover; "This box houses the gears"'/>
<rdf:Description rdf:about="&a;201843249"
	 b:glossaryEntry='be able to seat; "The theater seats 2,000"'/>
<rdf:Description rdf:about="&a;201843353">
	<b:glossaryEntry>hold one''s ground; maintain a position; be steadfast or upright</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201843519"
	 b:glossaryEntry='be tall; have a height of; copula; "She stands 6 feet tall"'/>
<rdf:Description rdf:about="&a;201843641"
	 b:glossaryEntry='be priced at; "These shoes cost $100"'/>
<rdf:Description rdf:about="&a;201843771">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cost a certain amount; "My daughter''s wedding set me back $20,000"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201843927"
	 b:glossaryEntry='be agreeable or acceptable to; "This suits my needs"'/>
<rdf:Description rdf:about="&a;201844061"
	 b:glossaryEntry='be in effect; be or remain in force; "The law stands!"'/>
<rdf:Description rdf:about="&a;201844178"
	 b:glossaryEntry="give in, as to influence or pressure"/>
<rdf:Description rdf:about="&a;201844321"
	 b:glossaryEntry="yield to out of weakness"/>
<rdf:Description rdf:about="&a;201844410">
	<b:glossaryEntry>be in line with; form a line along; of trees along a river, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201844566"
	 b:glossaryEntry="form the edge or"/>
<rdf:Description rdf:about="&a;201844645"
	 b:glossaryEntry="verge on; come close to"/>
<rdf:Description rdf:about="&a;201844749"
	 b:glossaryEntry="trench on or upon something"/>
<rdf:Description rdf:about="&a;201844840">
	<b:glossaryEntry>come near or verge on, resemble, come nearer in quality, or character; "This borders on discrimination!"; "His playing approaches tht of Horowitz"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201845082"
	 b:glossaryEntry='form a line; "The buildings all line up neatly'/>
<rdf:Description rdf:about="&a;201845217"
	 b:glossaryEntry="have certain dimensions"/>
<rdf:Description rdf:about="&a;201845395"
	 b:glossaryEntry='determine the weight of; "The butcher weighed the chicken"'/>
<rdf:Description rdf:about="&a;201845550"
	 b:glossaryEntry="have a certain weight"/>
<rdf:Description rdf:about="&a;201845642"
	 b:glossaryEntry="be long; in time"/>
<rdf:Description rdf:about="&a;201845783">
	<b:glossaryEntry>last and be usable; "This dress wore well for almost ten years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201845936"
	 b:glossaryEntry='last longer than others: "This material outwears all others"'/>
<rdf:Description rdf:about="&a;201846061"
	 b:glossaryEntry="last unnecessarily long"/>
<rdf:Description rdf:about="&a;201846168"
	 b:glossaryEntry='be part of; "This problem inheres in the design"'/>
<rdf:Description rdf:about="&a;201846313">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be included in or classified as; "This falls under the rubric ''various''."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201846466">
	<b:glossaryEntry>exceed in importance; outweigh; "This prblem overshadows our lives right now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201846637"
	 b:glossaryEntry="be noncommittal"/>
<rdf:Description rdf:about="&a;201846718"
	 b:glossaryEntry="sit or stand astride of"/>
<rdf:Description rdf:about="&a;201846815">
	<b:glossaryEntry>take the side of; be on the side of; "Whose side are you on?" "Why are you taking sides with the accused?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201847019"
	 b:glossaryEntry="be undecided about something"/>
<rdf:Description rdf:about="&a;201847140"
	 b:glossaryEntry="be uncertain and vague"/>
<rdf:Description rdf:about="&a;201847232"
	 b:glossaryEntry="give off a shimmering reflection, as of silk"/>
<rdf:Description rdf:about="&a;201847341">
	<b:glossaryEntry>be noisy with activity; "This office is buzzing with activity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201847498">
	<b:glossaryEntry>resist or confront with resistance; "The politician defied public opinion"; "The new material withstands even the greatest wear and tear"; "The bridge held"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201847789">
	<b:glossaryEntry>remain inactive, as of a car in a garage, or not flowing, as of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201847921"
	 b:glossaryEntry='face or endure with courage; "She braved the elements"'/>
<rdf:Description rdf:about="&a;201848077"
	 b:glossaryEntry='brave the dangers of; "brave the natural elements"'/>
<rdf:Description rdf:about="&a;201848200">
	<b:glossaryEntry>be applicable to; as to an analysis; "This theory lends itself well to our new data"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201848380"
	 b:glossaryEntry='be beyond the resources of; "This beggars description!"'/>
<rdf:Description rdf:about="&a;201848500">
	<b:glossaryEntry>elude, esp. in a baffling way; "This behavior defies explanation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201848681"
	 b:glossaryEntry="be around"/>
<rdf:Description rdf:about="&a;201848879">
	<b:glossaryEntry>encircle with or as if with a wreath; "Her face was wreathed with blossoms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201849036"
	 b:glossaryEntry='encircle or bind; "Trees girded the green fields"'/>
<rdf:Description rdf:about="&a;201849171"
	 b:glossaryEntry="pass in a specific way; as of time"/>
<rdf:Description rdf:about="&a;201849509"
	 b:glossaryEntry='pass or spend; "lead a good life"'/>
<rdf:Description rdf:about="&a;201849604"
	 b:glossaryEntry='spend Sunday; "We sundayed in the country"'/>
<rdf:Description rdf:about="&a;201849727"
	 b:glossaryEntry='spend Christmas; "We were christmassing in New York"'/>
<rdf:Description rdf:about="&a;201849866">
	<b:glossaryEntry>devote (time, effort, etc.) to a task; "He put in three hours every day at the hospital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201850019"
	 b:glossaryEntry="spend the weekend"/>
<rdf:Description rdf:about="&a;201850101"
	 b:glossaryEntry="waste time; spend one''s time idly or inefficiently"/>
<rdf:Description rdf:about="&a;201850261"
	 b:glossaryEntry='spend time badly or unwisely: "He misspent his youth"'/>
<rdf:Description rdf:about="&a;201850380"
	 b:glossaryEntry="spend or take a vacation"/>
<rdf:Description rdf:about="&a;201850506"
	 b:glossaryEntry="spend a honeymoon"/>
<rdf:Description rdf:about="&a;201850598">
	<b:glossaryEntry>spend time in prison or in a labor camp; "He did six years for embezzlement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201850768">
	<b:glossaryEntry>spend or pass, as with boredom or in a pleasant manner; of time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201850913"
	 b:glossaryEntry="spend a certain length of time"/>
<rdf:Description rdf:about="&a;201851008"
	 b:glossaryEntry='spend the winter; "We wintered on the Riviera"'/>
<rdf:Description rdf:about="&a;201851126"
	 b:glossaryEntry='spend the summer; "We summered in Kashmir"'/>
<rdf:Description rdf:about="&a;201851240">
	<b:glossaryEntry>extend in a different direction; "The lines start to diverge here"; "Their interests diverged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201851436"
	 b:glossaryEntry='branch off; "The road divaricates here"'/>
<rdf:Description rdf:about="&a;201851543"
	 b:glossaryEntry='meet at breast level: "The runner breasted the tape"'/>
<rdf:Description rdf:about="&a;201851683">
	<b:glossaryEntry>be adjacent or come together; "The lines converge at this point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201851864"
	 b:glossaryEntry="form the boundary of; be contiguous to"/>
<rdf:Description rdf:about="&a;201852046"
	 b:glossaryEntry='serve as a shore to; "The river was shored by trees"'/>
<rdf:Description rdf:about="&a;201852161"
	 b:glossaryEntry="close in or confine"/>
<rdf:Description rdf:about="&a;201852319"
	 b:glossaryEntry="enclose or confine as if in a box"/>
<rdf:Description rdf:about="&a;201852433"
	 b:glossaryEntry="enclose in a frame, as of a picture"/>
<rdf:Description rdf:about="&a;201852531">
	<b:glossaryEntry>be contingent on; "The outcomes rides on the results of the electin"; "Your grade will depends on your homework"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201852789">
	<b:glossaryEntry>form a pattern; "These sentences pattern like the ones we studied before"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201852936"
	 b:glossaryEntry="be earlier in time; go back further"/>
<rdf:Description rdf:about="&a;201853077"
	 b:glossaryEntry='be later in time; "Tuesday always follows Monday."'/>
<rdf:Description rdf:about="&a;201853220"
	 b:glossaryEntry='cause to point; "Orient the house towards the West"'/>
<rdf:Description rdf:about="&a;201853353"
	 b:glossaryEntry="be oriented"/>
<rdf:Description rdf:about="&a;201853436"
	 b:glossaryEntry="jut out or project in space"/>
<rdf:Description rdf:about="&a;201853641"
	 b:glossaryEntry="project over"/>
<rdf:Description rdf:about="&a;201853727">
	<b:glossaryEntry>push upward; "The front of the trains that had collided head-on thrust up into the air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201853896"
	 b:glossaryEntry='thrust up like a spear; "The branch speared up into the air"'/>
<rdf:Description rdf:about="&a;201854038"
	 b:glossaryEntry="bulge out; form a bulge outward"/>
<rdf:Description rdf:about="&a;201854146"
	 b:glossaryEntry="project as a cantilever"/>
<rdf:Description rdf:about="&a;201854237"
	 b:glossaryEntry="be teeming, be abuzz"/>
<rdf:Description rdf:about="&a;201854371"
	 b:glossaryEntry="be abundant or plentiful; exist in large quantities"/>
<rdf:Description rdf:about="&a;201854512">
	<b:glossaryEntry>be in a state of movement or action; "The room abounded with screaming children"; "The garden bristled with toddlers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201854711"
	 b:glossaryEntry='be completely full; "His eyes brimmed with tears"'/>
<rdf:Description rdf:about="&a;201854822"
	 b:glossaryEntry="exist in large quantity"/>
<rdf:Description rdf:about="&a;201854947"
	 b:glossaryEntry='be crawling with; "The old cheese was crawling with maggots"'/>
<rdf:Description rdf:about="&a;201855070"
	 b:glossaryEntry='be associated with; "French fries come with the hamburger"'/>
<rdf:Description rdf:about="&a;201855273">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to accompany as a circumstance or follow as a result: "Menuhin''s playing was attended by a 15-minute standing ovation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201855455"
	 b:glossaryEntry="be a companion to somebody"/>
<rdf:Description rdf:about="&a;201855593"
	 b:glossaryEntry="have an affinity with; of signs of the zodiac"/>
<rdf:Description rdf:about="&a;201855700">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have with oneself; have on one''s person; "She always takes an umbrella"; "I always carry money"; "She packs a gun when she goes into the mountains"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201855924"
	 b:glossaryEntry="hang loosely, like an empty bag"/>
<rdf:Description rdf:about="&a;201856016">
	<b:glossaryEntry>hang freely; "the ornaments dangled from the tree"; "The light dropped from the ceiling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201856209"
	 b:glossaryEntry='hang loosely or laxly; "His tongue lolled"'/>
<rdf:Description rdf:about="&a;201856321">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make up for; "His skills offset his opponent''s superior strength"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201856487">
	<b:glossaryEntry>compensate for or counterbalance; "offset deposits and withdrawals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201856632"
	 b:glossaryEntry='be compatible or in accordance with; "adhere to the rules"'/>
<rdf:Description rdf:about="&a;201856772"
	 b:glossaryEntry="have something in common"/>
<rdf:Description rdf:about="&a;201856887"
	 b:glossaryEntry='share in common; "Our children share a love of music"'/>
<rdf:Description rdf:about="&a;201857045"
	 b:glossaryEntry="be different from one another"/>
<rdf:Description rdf:about="&a;201857180"
	 b:glossaryEntry="be wide open"/>
<rdf:Description rdf:about="&a;201857267"
	 b:glossaryEntry="split or divide into two"/>
<rdf:Description rdf:about="&a;201857366"
	 b:glossaryEntry="be in a huff"/>
<rdf:Description rdf:about="&a;201857455"
	 b:glossaryEntry="be able to, have the ability to"/>
<rdf:Description rdf:about="&a;201857545">
	<b:glossaryEntry>expresses permission; "You may leave now"; "Can I have another piece of cake?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201857688"
	 b:glossaryEntry="be obliged, required, or forced to"/>
<rdf:Description rdf:about="&a;201857799">
	<b:glossaryEntry>expresses an emotional, practical, or other reason for doing something: "You had better put on warm clothes"; "You should call your mother-in-law"; "The State ought to repair the bridges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201858069"
	 b:glossaryEntry='be likely or probable; "They have to be kidding"'/>
<rdf:Description rdf:about="&a;201858184"
	 b:glossaryEntry="be going to; indicates futurity"/>
<rdf:Description rdf:about="&a;201858275"
	 b:glossaryEntry="be logically necessary"/>
<rdf:Description rdf:about="&a;201858381">
	<b:glossaryEntry>expresses conditionality or possibility; "I would accept the offer if you upped the salary a bit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201858531">
	<b:glossaryEntry>get to or be allowed to do something; "May I go to the movies tonight?" "Can I have some ice cream?" "We got to play video games all day long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201858754"
	 b:glossaryEntry="be not allowed to"/>
<rdf:Description rdf:about="&a;201858855"
	 b:glossaryEntry='expresses possibility; "I could do it by myself"'/>
<rdf:Description rdf:about="&a;201858964"
	 b:glossaryEntry="exhibit an inclination or tendency"/>
<rdf:Description rdf:about="&a;201859103">
	<b:glossaryEntry>be willing or inclined to accept; "He did not take kindly to my critical remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201859256">
	<b:glossaryEntry>have a tendency or disposition to do or be something; be inclined; "She tends to be nervous before her lectures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201859471">
	<b:glossaryEntry>be a part or adjunct; "the uniform looks like it belonged to a museum collection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201859617">
	<b:glossaryEntry>come as a logical consequence; follow logically; "It follows that your assertion is false"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201859779">
	<b:glossaryEntry>come after in time, as a result; "A terrible tsunami followed the earthquake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201859969"
	 b:glossaryEntry='be next; "Mary plays best, with John and Sue following"'/>
<rdf:Description rdf:about="&a;201860122">
	<b:glossaryEntry>to bring something about at a later time than; "She followed dinner with a brandy"; He followed his lecture with a question and answer period"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201860328">
	<b:glossaryEntry>be affected by; be subjected to; as in "run a temperature," "run a risk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201860462">
	<b:glossaryEntry>make oneself subject to; bring upon oneself; become liable to; "People who smoke incur a great danger to their health"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201860661"
	 b:glossaryEntry='be proud of; "She prides herself on her son"'/>
<rdf:Description rdf:about="&a;201860768">
	<b:glossaryEntry>have a particular form; "the story or argument runs....", "as the saying goes..."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201860915">
	<b:glossaryEntry>make a possibility or provide opportunity for; "This leaves no room for improvement"; "The evidence allows only one conclusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201861165"
	 b:glossaryEntry='be mentioned; "These names came up in the discussion"'/>
<rdf:Description rdf:about="&a;201861291">
	<b:glossaryEntry>face in a certain direction; "The house looks out on a tennis court"; "The apartment looks across the Hudson"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201861517">
	<b:glossaryEntry>be or play a part of or in; "Elections figure prominently in every government program"; "How do the elections figure in the current pattern of internal politics?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201861760">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be received or accepted; "This speech didn''t play well with the American public"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201861884"
	 b:glossaryEntry='introduce; "This poses an interesting question"'/>
<rdf:Description rdf:about="&a;201862003"
	 b:glossaryEntry='be urgent; "This is a pressing problem"'/>
<rdf:Description rdf:about="&a;201862105"
	 b:glossaryEntry="be violent; as of fires and storms"/>
<rdf:Description rdf:about="&a;201862201"
	 b:glossaryEntry="behave violently, as if in a great rage"/>
<rdf:Description rdf:about="&a;201862317">
	<b:glossaryEntry>be incomprehensible to; escape understanding by; "What you are seeing in him eludes me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201862494"
	 b:glossaryEntry='have as a center; "The region centers on Charleston"'/>
<rdf:Description rdf:about="&a;201862613">
	<b:glossaryEntry xml:space='preserve'><![CDATA[act in one''s own or everybody''s best interest; "You will do well to arrive on time tomorrow!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201862782"
	 b:glossaryEntry='be expected to: "Parties should be fun"'/>
<rdf:Description rdf:about="&a;201862875">
	<b:glossaryEntry>be characteristic of: "This compositional style is exemplified by this fugue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201863048"
	 b:glossaryEntry='belong to an earlier time; "This story dates back 200 years"'/>
<rdf:Description rdf:about="&a;201863205"
	 b:glossaryEntry="surround with a cloister, as of a garden"/>
<rdf:Description rdf:about="&a;201863319">
	<b:glossaryEntry xml:space='preserve'><![CDATA[enhance the appearance of: "Mourning becomes Electra"; "This behavior doesn''t suit you!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201863478">
	<b:glossaryEntry>be in a relationship with: "How are these two observations related?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201863676"
	 b:glossaryEntry="be in a state of sexual excitement; of male mammals"/>
<rdf:Description rdf:about="&a;201863788"
	 b:glossaryEntry="be stagnant, as of water"/>
<rdf:Description rdf:about="&a;201863878"
	 b:glossaryEntry="be useful for a certain purpose"/>
<rdf:Description rdf:about="&a;201863980">
	<b:glossaryEntry>be close to the earth, or be disproportionately wide; "The building squatted low"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201864132"
	 b:glossaryEntry='not do something; "He refrained from hitting him back"'/>
<rdf:Description rdf:about="&a;201864344">
	<b:glossaryEntry xml:space='preserve'><![CDATA[always used with a negative: "I can''t help myself--I have to smoke"; "She could not help watching the sad spectacle"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201864545">
	<b:glossaryEntry>not act or do anything; "He just stood by when the police beat up the demonstrators"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201864703"
	 b:glossaryEntry='not participate in a sports game: "He sat out the game"'/>
<rdf:Description rdf:about="&a;201864824"
	 b:glossaryEntry="bring back luck; be a source of misfortune"/>
<rdf:Description rdf:about="&a;201864938"
	 b:glossaryEntry='be imminent or about to happen; "Changes are impending"'/>
<rdf:Description rdf:about="&a;201865057">
	<b:glossaryEntry>change or be different within limits; "Estimates for the losses in the earthquake range as high as $2 billion"; "Interest rates run from 5 to 10 percent"; "The instruments ranged from tuba to cymbals"; My students range from very bright to dull"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201865371">
	<b:glossaryEntry>continue in a place, position, or situation: "After graduation, she stayed on in Cambridge as a student adviser"; "Stay with me, please"; "despite student protests, he remained Dean for another year"; "She continued as deputy mayor for another year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201865738">
	<b:glossaryEntry>be sold at a certain price or in a certain way: "These books sell like hot cakes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201865961">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be translatable, or be translatable in a certain way; "poetry often does not translate"; "Tolstoy''s novels translate well into English"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201866189">
	<b:glossaryEntry>measure by or as if by a scale; "This bike scales only 25 pounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201866316">
	<b:glossaryEntry>sell at the retail level; "These gems retail at thousands of dollars each"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201866472">
	<b:glossaryEntry>be traded at a certain price or under certain conditions: "The stock traded around $20 a share"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201866638"
	 b:glossaryEntry="be the first or leading member of (a group)"/>
<rdf:Description rdf:about="&a;201866761">
	<b:glossaryEntry>be subject to or the object of; "The governor came in for a lot of criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201866915">
	<b:glossaryEntry>cause to be in a specified state; "The inflation left them penniless"; "He left money on the table for his wife to find"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201867106">
	<b:glossaryEntry>be comparable; "This car does not compare with our line of Mercedes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201867275">
	<b:glossaryEntry>be ranked or compare; "This violinist is as good as Juilliard-trained violinists go"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201867419">
	<b:glossaryEntry>come under, be classified or included; "fall into a category"; "This comes under a new heading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201867591">
	<b:glossaryEntry>have left or have as a remainder; "That left the four of us"; "19 - 8 leaves 11"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201867742">
	<b:glossaryEntry>be beset by; "The project ran into numerous financial difficulties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201867887">
	<b:glossaryEntry>be felt or perceived in a certain way; "The ground feels shaky"; "The sheets feel soft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201868081">
	<b:glossaryEntry>feel as if crawling with insects; "My skin crawled--I was terrified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201868212">
	<b:glossaryEntry>have or contain a certain wording or form; "The passage reads as follows"; "What does the law say?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201868387">
	<b:glossaryEntry>stay behind; "The smell stayed in the room"; "The hostility remained long after they made up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201868569">
	<b:glossaryEntry>remain present although waning or gradually dying; "Her perfume lingered on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201868717">
	<b:glossaryEntry>have a place in relation to something else: "The fate of Bosnia lies in the hands of the West"; "The responsibility rests with the Allies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201868923">
	<b:glossaryEntry>put into a group; "The academy counts several Nobel Prize winners among its members"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201869087">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be indebted to, in an abstract or intellectual sense; "This new theory owes much to Einstein''s Relativity Theory"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201869269"
	 b:glossaryEntry='be attracted to; "Boys gravitate towards girls at that age"'/>
<rdf:Description rdf:about="&a;201869403"
	 b:glossaryEntry='move toward; "The conversation gravitated towards politics"'/>
<rdf:Description rdf:about="&a;201869530"
	 b:glossaryEntry='be worth it; "It pays to go through the trouble"'/>
<rdf:Description rdf:about="&a;201869639">
	<b:glossaryEntry>in mathematics: approach a limit as the number of terms increases without limit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201869803"
	 b:glossaryEntry="have no limits; used of mathematical series"/>
<rdf:Description rdf:about="&a;201869947">
	<b:glossaryEntry>enter or assume a condition, relation, use, or position; "He came into contact with a terrorist group"; "The shoes came untied"; "I came to see his point of view"; "her face went red with anger"; "The knot came loose"; "Your wish will come true"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201870273">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have room for; hold without crowding; "This hotel can accommodate 250 guests"; "The theater admits 300 people"; "The auditorium can''t hold more than 500 people"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201870507">
	<b:glossaryEntry>maintain in safety form injury, harm, or danger; "May God keep you"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201870647"
	 b:glossaryEntry='be distinguished or eminent; "His talent shines"'/>
<rdf:Description rdf:about="&a;201870766"
	 b:glossaryEntry='extend in importance or range; "His accomplishments go far"'/>
<rdf:Description rdf:about="&a;201870899">
	<b:glossaryEntry>be recorded or remembered; "She will go down as the first feminist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201871021"
	 b:glossaryEntry="be iridescent"/>
<rdf:Description rdf:about="&a;201871100">
	<b:glossaryEntry>be and remain in a particular state or condition; "lie dormant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201871232">
	<b:glossaryEntry>occupy a place or location, also metaphorically; "We stand on common ground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201871379">
	<b:glossaryEntry>undergo being photographed in a certain way; "Children photograph well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201871508"
	 b:glossaryEntry='be installed; "These pieces go in here"'/>
<rdf:Description rdf:about="&a;201871592"
	 b:glossaryEntry='fail to spoil or rot; "These potatoes keep for a long time"'/>
<rdf:Description rdf:about="&a;201871726">
	<b:glossaryEntry>be menacing, burdensome, or oppressive; "This worry hangs on my mind"; "The cloud of suspicion hangs over her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201871916"
	 b:glossaryEntry='strew; "Cigar butts littered the ground"'/>
<rdf:Description rdf:about="&a;201872020"
	 b:glossaryEntry='be agreeable or acceptable; "This time suits me"'/>
<rdf:Description rdf:about="&a;201872156">
	<b:glossaryEntry>be the end of; be the last of concluding part of; "This sad scene ended the movie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201872318"
	 b:glossaryEntry='conform to some shape or size; "How does this shirt fit?"'/>
<rdf:Description rdf:about="&a;201872462"
	 b:glossaryEntry='be of use; "This will help to prevent accidents"'/>
<rdf:Description rdf:about="&a;201872617">
	<b:glossaryEntry>be in connection with something relevant; "This ties in closely with his earlier remarks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201872770">
	<b:glossaryEntry>be used or required for; "A lot of energy went into the organization of this banquet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201872902">
	<b:glossaryEntry>have certain characteristics of qualities for something; be open to: "This story would lend itself well to serialization on television"; be vulnerable to: "The current system lends itself to great abuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201873175"
	 b:glossaryEntry="have some of the qualities or attributes of something"/>
<rdf:Description rdf:about="&a;201873293">
	<b:glossaryEntry>delineate the form or outline of: "The tree was clearly defined by the light"; "The camera could define the smallest object"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201873493">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be relaxed; "Don''t be so worried all the time--just let go!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201873617">
	<b:glossaryEntry>come from; be connected by a relationship of blood, for example; "She was descended from an old Italian noble family"; "he comes from humble origins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201873873"
	 b:glossaryEntry='be classified with; "The whales belong among the mammals"'/>
<rdf:Description rdf:about="&a;201874002">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be suitable or acceptable; "This student somehow doesn''t belong"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201874154">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be in the right place or situation; "Where do these books belong?" "Let''s put health care where it belongs--under the control of the government"; "Where do these books go?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201874403">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be sufficient; "There''s not enough to go around"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201874518">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be excessively hot; "If the children stay out on the beach for another hour, they''ll be fried"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201874673">
	<b:glossaryEntry>wind or turn in volutions, esp. in an inward spiral, as of snail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201874815"
	 b:glossaryEntry='form a spiral; "The path spirals up the mountain"'/>
<rdf:Description rdf:about="&a;201874936"
	 b:glossaryEntry='extend in curves and turns; "The road winds around the lake"'/>
<rdf:Description rdf:about="&a;201875128">
	<b:glossaryEntry>form a snake-like pattern; "The river snakes through the valley"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201875255"
	 b:glossaryEntry="marry or cohabit with a person of another race"/>
<rdf:Description rdf:about="&a;201875370"
	 b:glossaryEntry="happen at the same time"/>
<rdf:Description rdf:about="&a;201875477">
	<b:glossaryEntry>experience as a reaction; "My proposal met with much opposition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201875649"
	 b:glossaryEntry="put in contrast"/>
<rdf:Description rdf:about="&a;201875730">
	<b:glossaryEntry>enhance by contrast; "In this picture, the figures are foiled against the background"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201875885"
	 b:glossaryEntry='be all mixed up or jumbled together; "His words jumbled"'/>
<rdf:Description rdf:about="&a;201876022">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have in one''s aspect; wear an expression of one''s attitude or personality; "He always wears a smile"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201876192"
	 b:glossaryEntry='be unsure or weak; "Their enthusiasm is faltering"'/>
<rdf:Description rdf:about="&a;201876322">
	<b:glossaryEntry>represent or express something abstract in tangible form; "This painting embodies the feelings of the Romantic period"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201876504">
	<b:glossaryEntry>give grounds for expectations; "The new results were promising"; "The results promised fame and glory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201876679">
	<b:glossaryEntry>be confronted with: "What do we have here?"; "Now we have a fine mess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201876793">
	<b:glossaryEntry>be sufficiently competent in a certain situation: "He can hold his own in graduate school"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201876937"
	 b:glossaryEntry='be exhibited; "Picasso hangs in this new wing of the museum"'/>
<rdf:Description rdf:about="&a;201877065">
	<b:glossaryEntry>have a range; be capable of projecting over a certain distance, as of a gun; "This gun ranges over two miles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201877237">
	<b:glossaryEntry>be conveyed over a certain distance; "Her voice carries very well in this big opera house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201877390">
	<b:glossaryEntry>be designed to hold or take; "This surface will not take the dye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201877526">
	<b:glossaryEntry>give access or entrance to; "The French doors admit onto the yard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201877637">
	<b:glossaryEntry>show grammatical agreement; "Subjects and verbs must always agree in English"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201877767"
	 b:glossaryEntry='be cleanable; "This stove cleans easily"'/>
<rdf:Description rdf:about="&a;201877896"
	 b:glossaryEntry='allow a draft; "This chimney draws very well"'/>
<rdf:Description rdf:about="&a;201877985">
	<b:glossaryEntry>have certain properties when driven; "This car rides smoothly"; "My new truck drives well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201878127">
	<b:glossaryEntry>have a specified degree of importance; "My ex-husband means nothing to me"; "Happiness means everything"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201878283">
	<b:glossaryEntry>be face to face with; "The child screamed when it confronted the man in the halloween costume"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201878451"
	 b:glossaryEntry='be capable of being washed; "Does this material wash?"'/>
<rdf:Description rdf:about="&a;201878575"
	 b:glossaryEntry='be in equilibrium; "He was balancing on one foot"'/>
<rdf:Description rdf:about="&a;201878697"
	 b:glossaryEntry='be a native of; "She hails from Kalamazoo"'/>
<rdf:Description rdf:about="&a;201878826">
	<b:glossaryEntry>begin a trip at a certain point, as of a plane, train, bus, etc.; "The flight originates in Calcutta"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201878994">
	<b:glossaryEntry>exist or occur in a certain point in a series; "Next came the student from France"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201879156"
	 b:glossaryEntry='be abundantly present; "The champagne flowed at the wedding"'/>
<rdf:Description rdf:about="&a;201879278">
	<b:glossaryEntry xml:space='preserve'><![CDATA[come forth; "A scream came from the woman''s mouth"; "His breath came hard"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201879418">
	<b:glossaryEntry>hang over, as of something threatening, dark, or menacing; "The terrible vision brooded over her all day long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201879619">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have the financial means to do something or buy something; "We can''t afford to send our children to college"; "Can you afford this car?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201879801">
	<b:glossaryEntry>have an opening or passage or outlet; "The bedrooms open into the hall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201879916">
	<b:glossaryEntry>be suitable for theatrical performance: "This scene acts well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201880057">
	<b:glossaryEntry>constitute an addition; "This paper will add to her reputation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201880199"
	 b:glossaryEntry='add up to; "four and four make eight"'/>
<rdf:Description rdf:about="&a;201880334">
	<b:glossaryEntry>afford possibility: "This problem admits of no solution"; "This short story allows of several different interpretations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201880525">
	<b:glossaryEntry>show a certain characteristic when tested; "He tested positive for HIV"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201880658">
	<b:glossaryEntry>appear to exist; "There seems no reason to go ahead with the project now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201880793"
	 b:glossaryEntry='be liable or accountable; "She must answer for her actions"'/>
<rdf:Description rdf:about="&a;201880916"
	 b:glossaryEntry='be present; "I hate that class and I never attend"'/>
<rdf:Description rdf:about="&a;201881056">
	<b:glossaryEntry>be superior: "Reading beats watching television"; "This sure beats work!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201881191">
	<b:glossaryEntry>have as a major characteristic; "The novel holds many surprises"; "The book holds in store much valuable advise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201881365">
	<b:glossaryEntry>vary or interrupt a uniformity or continuity; "The flat plain was broken by sharply mesas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201881519"
	 b:glossaryEntry='come to an end; "The heat wave finally broke yesterday"'/>
<rdf:Description rdf:about="&a;201881637">
	<b:glossaryEntry>have as a feature; "This new washer carries a two year guarantee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201881783"
	 b:glossaryEntry='be divisible by; "24 contains 6"'/>
<rdf:Description rdf:about="&a;201881880">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be scheduled so as to provide continuing service, as in transportation: "The local train does not connect with the Amtrak train"; "The planes don''t connect and you will have to wait for four hours"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201882150">
	<b:glossaryEntry>continue after an interruption; "The demonstration continued after a break for lunch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201882327">
	<b:glossaryEntry>carry forward; "We continued our research into the cause of the illness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201882504">
	<b:glossaryEntry>be responsible for the sale of; "All her publicity sold the products"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201882635">
	<b:glossaryEntry>be approved of or gain acceptance; "The new idea sold well in certain circles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201882775"
	 b:glossaryEntry='be fatal; "cigarettes kill"; "drunken driving kills"'/>
<rdf:Description rdf:about="&a;201882889"
	 b:glossaryEntry='be suitable for; "Wood makes good furniture"'/>
<rdf:Description rdf:about="&a;201883003">
	<b:glossaryEntry>undergo fabrication or creation; "This wool makes into a nice sweater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201883135">
	<b:glossaryEntry>be beautiful to look at; "Flowers adorned the tables everywhere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201883311"
	 b:glossaryEntry="form a blanket-like cover (over)"/>
<rdf:Description rdf:about="&a;201883408"
	 b:glossaryEntry="form a carpet-like cover (over)"/>
<rdf:Description rdf:about="&a;201883503">
	<b:glossaryEntry>form an impenetrable cover over; "the butter cream smothered the cake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201883638"
	 b:glossaryEntry='form a cover like a shroud; "Mist shrouded the castle"'/>
<rdf:Description rdf:about="&a;201883756">
	<b:glossaryEntry xml:space='preserve'><![CDATA[precipitate as rain; "It''s raining cats and dogs"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201883959"
	 b:glossaryEntry='fall from clouds; "rain, snow and sleet were falling"'/>
<rdf:Description rdf:about="&a;201884208"
	 b:glossaryEntry='come down like raindrops: "Bullets were spatting down on us"'/>
<rdf:Description rdf:about="&a;201884330"
	 b:glossaryEntry="become liquid"/>
<rdf:Description rdf:about="&a;201884408"
	 b:glossaryEntry="rain lightly"/>
<rdf:Description rdf:about="&a;201884494"
	 b:glossaryEntry="rain heavily"/>
<rdf:Description rdf:about="&a;201884584"
	 b:glossaryEntry="rain gently"/>
<rdf:Description rdf:about="&a;201884703">
	<b:glossaryEntry xml:space='preserve'><![CDATA[rain heavily; "Put on your rain coat--it''s pouring outside!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201884913">
	<b:glossaryEntry>come down as if in sheets; "The rain was sheeting down during the monsoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201885050"
	 b:glossaryEntry="pour as if from a sluice"/>
<rdf:Description rdf:about="&a;201885160">
	<b:glossaryEntry>become covered with a layer of ice; of a surface such as a window</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201885339">
	<b:glossaryEntry>be very cold, below the freezing point; "It is freezing in Kalamazoo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201885454"
	 b:glossaryEntry='fall as snow; "It was snowing all night"'/>
<rdf:Description rdf:about="&a;201885556"
	 b:glossaryEntry='precipitate as small ice particles; "It hailed for an hour"'/>
<rdf:Description rdf:about="&a;201885677"
	 b:glossaryEntry="precipitate as a mixture of rain and snow"/>
<rdf:Description rdf:about="&a;201885781"
	 b:glossaryEntry="be in flames or aflame"/>
<rdf:Description rdf:about="&a;201885866">
	<b:glossaryEntry>cause to start burning; subject to fire or great heat; "great heat will ignite paper"; "Light a cigarette"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201886178">
	<b:glossaryEntry>set fire to; cause to start burning; "The revolutionaries set fire to the American Embassy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201886402"
	 b:glossaryEntry="ignite anew, as of a fire"/>
<rdf:Description rdf:about="&a;201886493"
	 b:glossaryEntry='put out, as of a candle or a light; "douse the lights"'/>
<rdf:Description rdf:about="&a;201886620"
	 b:glossaryEntry='start to burn; "The gasoline erupted"'/>
<rdf:Description rdf:about="&a;201886790"
	 b:glossaryEntry='start burning; "the fire caught"'/>
<rdf:Description rdf:about="&a;201886885">
	<b:glossaryEntry>start to burn with a bright flame; "The coal in the BBQ grill finally lit up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201887028"
	 b:glossaryEntry="start burning"/>
<rdf:Description rdf:about="&a;201887142"
	 b:glossaryEntry="kindle anew, as of a fire"/>
<rdf:Description rdf:about="&a;201887233"
	 b:glossaryEntry="catch fire"/>
<rdf:Description rdf:about="&a;201887307"
	 b:glossaryEntry="put out or quench, as of fires or lights"/>
<rdf:Description rdf:about="&a;201887472"
	 b:glossaryEntry="obliterate or extinguish, of lights"/>
<rdf:Description rdf:about="&a;201887582">
	<b:glossaryEntry>cause an eclipse of; of celestial bodies; "The sun eclipsed the moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201887716"
	 b:glossaryEntry="cause to burn"/>
<rdf:Description rdf:about="&a;201887853"
	 b:glossaryEntry="burn brightly"/>
<rdf:Description rdf:about="&a;201887961"
	 b:glossaryEntry="shine with a sudden light"/>
<rdf:Description rdf:about="&a;201888075"
	 b:glossaryEntry='shine brighter than: "This star outshines the sun"'/>
<rdf:Description rdf:about="&a;201888191">
	<b:glossaryEntry>throw or flash the light of (a lamp, etc.): "Shine the light on that window, please"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201888346"
	 b:glossaryEntry="shine with a weak or fitful light"/>
<rdf:Description rdf:about="&a;201888444"
	 b:glossaryEntry='shine unsteadily; "The candle flickered"'/>
<rdf:Description rdf:about="&a;201888557">
	<b:glossaryEntry>emit light; be bright, as of the sun or a light; "The sun shone bright that day"; "the fire beamed on their faces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201888939"
	 b:glossaryEntry="emit a play of colors, like those of an opal"/>
<rdf:Description rdf:about="&a;201889049"
	 b:glossaryEntry="ignite quickly and suddenly"/>
<rdf:Description rdf:about="&a;201889160"
	 b:glossaryEntry='ignite; "The wood pile lit up quickly"'/>
<rdf:Description rdf:about="&a;201889264"
	 b:glossaryEntry="burn brightly and intensely"/>
<rdf:Description rdf:about="&a;201889372"
	 b:glossaryEntry="shine brightly and intensively"/>
<rdf:Description rdf:about="&a;201889465"
	 b:glossaryEntry="emit or reflect light in a flickering manner; of stars"/>
<rdf:Description rdf:about="&a;201889608"
	 b:glossaryEntry="shine with a harsh uncomfortably brilliant light"/>
<rdf:Description rdf:about="&a;201889719"
	 b:glossaryEntry="be sharply reflected"/>
<rdf:Description rdf:about="&a;201889802"
	 b:glossaryEntry="reflect light or colors like an opal"/>
<rdf:Description rdf:about="&a;201889904"
	 b:glossaryEntry='suck or take up or in; "a black star absorbs all matter"'/>
<rdf:Description rdf:about="&a;201890060">
	<b:glossaryEntry>attract by using an inexorable force, inducement, etc.: the current sucked him in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201890214"
	 b:glossaryEntry="be bright by reflecting or casting light"/>
<rdf:Description rdf:about="&a;201890381"
	 b:glossaryEntry='reflect brightly; "the wooden floor sparkled"'/>
<rdf:Description rdf:about="&a;201890503"
	 b:glossaryEntry="emit or produce sparks"/>
<rdf:Description rdf:about="&a;201890588"
	 b:glossaryEntry="reflect as if in a mirror"/>
<rdf:Description rdf:about="&a;201890685"
	 b:glossaryEntry="emit radiation"/>
<rdf:Description rdf:about="&a;201890772">
	<b:glossaryEntry>give off, send forth, or discharge; as of light, heat, or radiation, vapor, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201891088"
	 b:glossaryEntry="emit fumes"/>
<rdf:Description rdf:about="&a;201891168">
	<b:glossaryEntry>give off smoke, fumes, warm vapour, steam, etc.; "Marshes reeking in the sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201891307">
	<b:glossaryEntry>emit (as light, flame, or fumes) suddenly and forcefully; "The dragon shot fumes and flames out of its mouth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201891479"
	 b:glossaryEntry="emit as rays"/>
<rdf:Description rdf:about="&a;201891552"
	 b:glossaryEntry='emit steam; "The hot towels were steaming"'/>
<rdf:Description rdf:about="&a;201891665"
	 b:glossaryEntry="cast a shadow over"/>
<rdf:Description rdf:about="&a;201891783">
	<b:glossaryEntry>shine intensely, as if with heat; "The coals were glowing in the dark"; "The candles were burning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201891968"
	 b:glossaryEntry="burn unsteadily, feebly, or low; flicker"/>
<rdf:Description rdf:about="&a;201892072"
	 b:glossaryEntry='be blowing or storming; "The wind blew from the West"'/>
<rdf:Description rdf:about="&a;201892275"
	 b:glossaryEntry="blow toward the shore"/>
<rdf:Description rdf:about="&a;201892360"
	 b:glossaryEntry='blow gently; "A breeze wafted through the door"'/>
<rdf:Description rdf:about="&a;201892477"
	 b:glossaryEntry='blow hard; "It was storming all night"'/>
<rdf:Description rdf:about="&a;201892578"
	 b:glossaryEntry="blow in a squall"/>
<rdf:Description rdf:about="&a;201892658">
	<b:glossaryEntry>rain, hail, or snow hard and be very windy, often with thunder or lightning; "It was storming all last night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201892830">
	<b:glossaryEntry>blow hard; be gusty, as of wind; "blustering gales"; "the flames blustered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201892970"
	 b:glossaryEntry="be the case that thunder is being heard"/>
<rdf:Description rdf:about="&a;201893081"
	 b:glossaryEntry="make overcast or cloudy"/>
<rdf:Description rdf:about="&a;201893250"
	 b:glossaryEntry='become covered with clouds; "The sky clouded over"'/>
<rdf:Description rdf:about="&a;201893399"
	 b:glossaryEntry='become clear; "The sky cleared after the storm"'/>
<rdf:Description rdf:about="&a;201893550"
	 b:glossaryEntry="cause to suffer a blight"/>
<rdf:Description rdf:about="&a;201893655"
	 b:glossaryEntry="drench or submerge or be drenched or submerged"/>
<rdf:Description rdf:about="&a;201893781"
	 b:glossaryEntry='become empty of water; "The river runs dry in the summer"'/>
<rdf:Description rdf:about="&a;201893913"
	 b:glossaryEntry='get foggy; "The windshield fogged up"'/>
<rdf:Description rdf:about="&a;201894022"
	 b:glossaryEntry="burn to charcoal"/>
<rdf:Description rdf:about="&a;300001740">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') having the necessary means or skill or know-how or authority to do something; "able to swim"; "she was able to program her computer"; "we were at last able to buy a car"; "able to get a grant for the project"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300002062">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') not having the necessary means or skill or know-how; "unable to get to town without a car"; "unable to obtain funds"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300002287">
	<b:glossaryEntry>(biology) facing away from the axis of an organ or organism; "the abaxial surface of a leaf is the underside or side facing away from the stem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300002493">
	<b:glossaryEntry>(biology) nearest to or facing toward the axis of an organ or organism; "the upper side of a leaf is known as the adaxial surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300002687">
	<b:glossaryEntry>(physiology) especially of muscles; drawing away from the midline of the body or from an adjacent part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300002856">
	<b:glossaryEntry>(physiology) especially of muscles; bringing together or drawing toward the midline of the body or toward an adjacent part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300003057">
	<b:glossaryEntry>in the process of being born or beginning; "our own revolutionary war almost died aborning through lack of popular support"- William Randolph Hearst</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300003314">
	<b:glossaryEntry>having to do with birth; "a birthing center"; "birthing counselor"; "a lying-in hospital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300003469"
	 b:glossaryEntry='coming into existence; "a nascent republic"'/>
<rdf:Description rdf:about="&a;300003588"
	 b:glossaryEntry='giving birth; "a parturient heifer"'/>
<rdf:Description rdf:about="&a;300003694">
	<b:glossaryEntry>in or associated with the process of passing from life or ceasing to be; "a dying man"; "his dying wish"; "a dying fire"; "a dying civilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300003965"
	 b:glossaryEntry='drawing to an end; "his declining years"'/>
<rdf:Description rdf:about="&a;300004064">
	<b:glossaryEntry>on the point of death; breathing your last; "a moribund patient"; "the expiring man was carried home by his two friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300004253"
	 b:glossaryEntry="flickering and dying like a small flame"/>
<rdf:Description rdf:about="&a;300004364">
	<b:glossaryEntry>occurring at the time of death; "his last words"; "the last rites"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300004481">
	<b:glossaryEntry>(used of texts) shortened by condensing or rewriting; "an abridged version"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300004701"
	 b:glossaryEntry='retaining only the most important parts; "a condensed book"'/>
<rdf:Description rdf:about="&a;300004816"
	 b:glossaryEntry='with parts removed; "the drastically cut film"'/>
<rdf:Description rdf:about="&a;300004924"
	 b:glossaryEntry="abridged to half its original length"/>
<rdf:Description rdf:about="&a;300005018">
	<b:glossaryEntry>(British informal) summarized or abridged; "a potted version of a novel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300005143"
	 b:glossaryEntry='(used of texts) not shortened; "an unabridged novel"'/>
<rdf:Description rdf:about="&a;300005288"
	 b:glossaryEntry='complete; "the full-length play"'/>
<rdf:Description rdf:about="&a;300005386">
	<b:glossaryEntry>being the most comprehensive of its class; "an unabridged dictionary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300005515">
	<b:glossaryEntry>perfect or complete or pure; "absolute loyalty"; "absolute silence"; "absolute truth"; "absolute alcohol"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300005837"
	 b:glossaryEntry='total; "dead silence"; "utter seriousness"'/>
<rdf:Description rdf:about="&a;300005944"
	 b:glossaryEntry='exact; "the direct opposite"'/>
<rdf:Description rdf:about="&a;300006025"
	 b:glossaryEntry='being without doubt or reserve; "implicit trust"'/>
<rdf:Description rdf:about="&a;300006144">
	<b:glossaryEntry>not dependent on or conditioned by or relative to anything else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300006265">
	<b:glossaryEntry xml:space='preserve'><![CDATA[total and all-embracing; "God''s infinite wisdom"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300006368">
	<b:glossaryEntry>(intensifier) "she is a living doll"; "scared the living daylights out of them"; "beat the living hell out of him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300006535"
	 b:glossaryEntry='not mixed; "pure oxygen"'/>
<rdf:Description rdf:about="&a;300006632">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) standing apart from a normal syntactical relation with other sentence elements; "in `joking apart, we need to go now'' the words `joking apart'' are syntactically independent"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300006887">
	<b:glossaryEntry>used to give emphasis; "the very essence of artistic expression is invention"- Irving R. Kaufman; "the very back of the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300007066"
	 b:glossaryEntry='not absolute or complete; "a relative stranger"'/>
<rdf:Description rdf:about="&a;300007222">
	<b:glossaryEntry>having significance only in relation to something else; "a comparative newcomer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300007360">
	<b:glossaryEntry>(grammar) referring to or qualifying another sentence element; "relative pronoun"; "relative clause"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300007517"
	 b:glossaryEntry="having a relation or being related"/>
<rdf:Description rdf:about="&a;300007608">
	<b:glossaryEntry>having power or capacity or tendency to absorb or soak up (liquids); "as absorbent as a sponge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300007880"
	 b:glossaryEntry="inducing or promoting absorption"/>
<rdf:Description rdf:about="&a;300007988">
	<b:glossaryEntry>tending to or characterized by or causing assimilation (being absorbed into or incorporated); "an assimilative pattern"; "an assimilative process"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300008223"
	 b:glossaryEntry="absorbing moisture (as from the air)"/>
<rdf:Description rdf:about="&a;300008317">
	<b:glossaryEntry>like a sponge in being able to absorb liquids and yield it back when compressed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300008449">
	<b:glossaryEntry>able to take in large quantities of moisture; "thirsty towels"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300008565"
	 b:glossaryEntry="not capable of absorbing or soaking up (liquids)"/>
<rdf:Description rdf:about="&a;300008724">
	<b:glossaryEntry>incapable of absorbing or mixing with; "a water-repellent fabric"; "plastic highly resistant to steam and water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300008904">
	<b:glossaryEntry>having capacity or tendency to adsorb or cause to accumulate on a surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009087">
	<b:glossaryEntry>having the capacity to adsorb by chemical as contrasted with physical forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009239">
	<b:glossaryEntry>lacking a capacity to adsorb or cause to accumulate on a surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009378">
	<b:glossaryEntry>capable of being absorbed or taken in through the pores of a surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009521">
	<b:glossaryEntry>taken in through the pores of a surface; "the absorbed water expanded the sponge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009657">
	<b:glossaryEntry>capable of being adsorbed or accumulated on a surface of a solid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009808">
	<b:glossaryEntry>accumulated on a surface of a solid; "a film of adsorbed gas on the charcoal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300009940">
	<b:glossaryEntry>sparing in consumption of especially food and drink; "the pleasures of the table, never of much consequence to one naturally abstemious"- John Galsworthy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300010222">
	<b:glossaryEntry>self-restraining; not indulging an appetite especially for food or drink; "not totally abstinent but abstemious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300010404">
	<b:glossaryEntry xml:space='preserve'><![CDATA[practicing great self-denial; "Be systematically ascetic...do...something for no other reason than that you would rather not do it"- William James; "a desert nomad''s austere life"; "a spartan diet"; "a spartan existence"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300010710">
	<b:glossaryEntry>given to excess in consumption of especially food or drink; "over-fed women and their gluttonous husbands"; "a gluttonous debauch"; "a gluttonous appetite for food and praise and pleasure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300011117">
	<b:glossaryEntry>given to gross intemperance in eating or drinking; "a crapulous old reprobate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300011251">
	<b:glossaryEntry>suffering from excessive eating or drinking; "crapulent sleep"; "a crapulous stomach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300011404">
	<b:glossaryEntry>devouring or craving food in great quantities; "edacious vultures"; "a rapacious appetite"; "ravenous as wolves"; "voracious sharks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300011658">
	<b:glossaryEntry xml:space='preserve'><![CDATA[wanting to eat or drink more than one can reasonably consume; "don''t be greedy with the cookies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300011807">
	<b:glossaryEntry>resembling swine; coarsely gluttonous or greedy; "piggish table manners"; "the piggy fat-cheeked little boy and his porcine pot-bellied father"; "swinish slavering over food"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300012073"
	 b:glossaryEntry="excessively gluttonous"/>
<rdf:Description rdf:about="&a;300012165">
	<b:glossaryEntry>searching for and feeding on decaying matter; "scavenging hyenas and vultures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300012300">
	<b:glossaryEntry xml:space='preserve'><![CDATA[existing only in the mind; separated from embodiment; "abstract words like `truth'' and `justice''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300012560">
	<b:glossaryEntry>being or of the nature of a notion or concept; "a plan abstract and conceptional"; "to improve notional comprehension"; "a notional response to the question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300012800">
	<b:glossaryEntry>being or characterized by concepts or their formation; "conceptual discussions"; "the schizophrenic loses ability to abstract or do conceptual thinking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300013009">
	<b:glossaryEntry>constituting or existing only in the form of an idea or mental image or conception; "a poem or essay may be typical of its period in idea or ideal content"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300013216">
	<b:glossaryEntry>capable of being perceived by the senses; not abstract or imaginary; "concrete objects such as trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300013498"
	 b:glossaryEntry='characterized by fact; "the factual aspects of the case"'/>
<rdf:Description rdf:about="&a;300013608">
	<b:glossaryEntry>belonging to immediate experience of actual things or events; "concrete benefits"; "a concrete example"; "there is no objective evidence of anything of the kind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300013825">
	<b:glossaryEntry>possible to be treated as fact; "tangible evidence"; "his brief time as Prime Minister brought few real benefits to the poor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300014012"
	 b:glossaryEntry='present in great quantity; "an abundant supply of water"'/>
<rdf:Description rdf:about="&a;300014429">
	<b:glossaryEntry>existing in abundance; "abounding confidence"; "whiskey galore"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300014561">
	<b:glossaryEntry>affording an abundant supply; "had ample food for the party"; "copious provisions"; "food is plentiful"; "a plenteous grape harvest"; "a rich supply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300014803"
	 b:glossaryEntry='extraordinarily abundant; "a bumper crop"'/>
<rdf:Description rdf:about="&a;300014897">
	<b:glossaryEntry>large in number or quantity; "she took copious notes"; "extensive press coverage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300015044">
	<b:glossaryEntry>(economics) plentiful and therefore at low interest rates; easy to come by; "easy money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300015183">
	<b:glossaryEntry>produced or growing in extreme abundance; "their riotous blooming"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300015344"
	 b:glossaryEntry='abundantly covered of filled; "the top was thick with dust"'/>
<rdf:Description rdf:about="&a;300015455">
	<b:glossaryEntry>having or being more than normal or necessary:"long on brains"; "in long supply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300015586"
	 b:glossaryEntry="excessively abundant"/>
<rdf:Description rdf:about="&a;300015684">
	<b:glossaryEntry>existing in great number or quantity; "rhinoceroses were once plentiful here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300015817"
	 b:glossaryEntry='growing profusely; "rank jungle vegetation"'/>
<rdf:Description rdf:about="&a;300015911"
	 b:glossaryEntry="most excessively abundant"/>
<rdf:Description rdf:about="&a;300015996">
	<b:glossaryEntry xml:space='preserve'><![CDATA[abundantly filled with especially living things; "the Third World''s teeming millions"; "the teeming boulevard"; "harried by swarming rats"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300016199"
	 b:glossaryEntry='pouring in abundance; "torrential rains"'/>
<rdf:Description rdf:about="&a;300016296">
	<b:glossaryEntry>deficient in quantity or number compared with the demand; "fresh vegetables were scarce during the drought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300016528">
	<b:glossaryEntry>not widely distributed; "rare herbs"; "rare patches of gree in the desert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300016653">
	<b:glossaryEntry>(economics) affected by scarcity and expensive to borrow; "tight money"; "a tight market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300016794"
	 b:glossaryEntry='physically abused; "an abused wife'/>
<rdf:Description rdf:about="&a;300016993"
	 b:glossaryEntry="sexually abused"/>
<rdf:Description rdf:about="&a;300017083">
	<b:glossaryEntry>beaten repeatedly with heavy blows; "a battered child"; "the battered woman syndrome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300017232">
	<b:glossaryEntry>struck with especially the open hand; "hung his head like a cuffed and chastised child"; "wondered which was the worse punishment, her slapped face or her injured feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300017467">
	<b:glossaryEntry>not given sympathetic understanding; "a sorely misunderstood child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300017594"
	 b:glossaryEntry="not physically abused; treated properly"/>
<rdf:Description rdf:about="&a;300017688"
	 b:glossaryEntry="abused with language"/>
<rdf:Description rdf:about="&a;300017797">
	<b:glossaryEntry>treated with insolent and rude language especially openly and intentionally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300017939"
	 b:glossaryEntry="assailed with contemptuous language"/>
<rdf:Description rdf:about="&a;300018039"
	 b:glossaryEntry="not abused with language"/>
<rdf:Description rdf:about="&a;300018136"
	 b:glossaryEntry="not assailed with contemptuous language"/>
<rdf:Description rdf:about="&a;300018244">
	<b:glossaryEntry>worthy of acceptance or satisfactory; "acceptable levels of radiation"; "performances varied from acceptable to excellent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300018513"
	 b:glossaryEntry='acceptable to or at a bank; "bankable funds"'/>
<rdf:Description rdf:about="&a;300018612"
	 b:glossaryEntry='capable of being borne; "tolerable noise levels"'/>
<rdf:Description rdf:about="&a;300018716">
	<b:glossaryEntry xml:space='preserve'><![CDATA[completely acceptable; not open to exception or reproach; "two unexceptionable witnesses"; "a judge''s ethics should be unexceptionable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300018929">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not objectionable; "the ends are unobjectionable; it''s the means that one can''t accept"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300019078">
	<b:glossaryEntry>not acceptable; not welcome; "a word unacceptable in polite society"; "an unacceptable violation of personal freedom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300019326">
	<b:glossaryEntry xml:space='preserve'><![CDATA[liable to objection or debate; used of something one might take exception to; "a thoroughly unpleasant highly exceptionable piece of writing"; "found the politician''s views objectionable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300019589"
	 b:glossaryEntry='completely unacceptable; "this noise is intolerable"'/>
<rdf:Description rdf:about="&a;300019699">
	<b:glossaryEntry>generally or especially officially judged acceptable or satisfactory; "an approved method"; "work on the approved project went ahead on schedule"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300019899"
	 b:glossaryEntry='not approved; "the disapproved tax proposal"'/>
<rdf:Description rdf:about="&a;300020037">
	<b:glossaryEntry>officially and strongly disapproved; "the censured conflict of interest"; "her condemned behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300020202"
	 b:glossaryEntry='judged unacceptable; "rejected merchandise"'/>
<rdf:Description rdf:about="&a;300020300"
	 b:glossaryEntry='capable of being reached; "a town accessible by rail"'/>
<rdf:Description rdf:about="&a;300020518">
	<b:glossaryEntry>easily approached; "a site approachable from a branch of the Niger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300020656">
	<b:glossaryEntry>(informal) capable of being reached or attained; "a very getatable man"; "both oil and coal are there but not in getatable locations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300020860"
	 b:glossaryEntry='easy to reach; "found a handy spot for the can opener"'/>
<rdf:Description rdf:about="&a;300020998">
	<b:glossaryEntry>accessible at the present time; "waited for supper...glasses in hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300021124">
	<b:glossaryEntry>capable of being reached only with great difficulty or not at all</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300021389"
	 b:glossaryEntry="inaccessible and sparsely populated"/>
<rdf:Description rdf:about="&a;300021505">
	<b:glossaryEntry>remote from civilization; "the victim was lured to a deserted spot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300021627"
	 b:glossaryEntry='lacking pathways; "trackless wilderness"; "roadless areas"'/>
<rdf:Description rdf:about="&a;300021796">
	<b:glossaryEntry>separated from or unfrequented by others; remote or secluded; "a lonely crossroads"; "a solitary retreat"; "a trail leading to an unfrequented lake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300022026">
	<b:glossaryEntry>inaccessibly located or situated; "an unapproachable chalet high in the mountains"; "an unreachable canyon"; "the unreachable stars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300022263"
	 b:glossaryEntry="(informal) difficult to reach or attain"/>
<rdf:Description rdf:about="&a;300022378">
	<b:glossaryEntry>helpful in bringing about a harmonious adaptation; "the warden was always accommodating in allowing visitors in"; "made a special effort to be accommodating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300022683">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing a cheerful willingness to do favors for others; "to close one''s eyes like a complaisant husband whose wife has taken a lover"; "the obliging waiter was in no hurry for us to leave"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300022940">
	<b:glossaryEntry>not accommodating; "the unaccommodating bus driver pulled out while she was banging on the door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300023129">
	<b:glossaryEntry>intentionally unaccommodating; "the action was not offensive to him but proved somewhat disobliging"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300023303">
	<b:glossaryEntry>conforming exactly or almost exactly to fact or to a standard or performing with total accuracy; "an accurate reproduction"; "the accounting was accurate"; "accurate measurements"; "an accurate scale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300023738">
	<b:glossaryEntry>marked by fidelity to an original; "a close translation"; "a faithful copy of the portrait"; "a faithful rendering of the observed facts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300023938">
	<b:glossaryEntry>(informal) accurate and to the point; "a dead-on feel for characterization"; "She avoids big scenes...preferring to rely on small gestures and dead-on dialogue"- Peter S.Prescott</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300024173">
	<b:glossaryEntry>characterized by minimal distortion in sound reproduction; "a high-fidelity recording"; "a hi-fi system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300024345">
	<b:glossaryEntry>right; in keeping with the facts; "set the record straight"; "made sure the facts were straight in the report"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300024510">
	<b:glossaryEntry>accurately placed or thrown; "his aim was true"; "he was dead on target"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300024650"
	 b:glossaryEntry='precisely accurate; "a veracious account"'/>
<rdf:Description rdf:about="&a;300024747">
	<b:glossaryEntry>not accurate; "an inaccurate translation"; "the thermometer is inaccurate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300025022">
	<b:glossaryEntry>(of a baseball pitch) on the far side of home plate from the batter; "the pitch was away (or wide)"; "an outside pitch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300025202"
	 b:glossaryEntry='characterized by errors; "he submitted a faulty report"'/>
<rdf:Description rdf:about="&a;300025310"
	 b:glossaryEntry='not trustworthy; "an unfaithful reproduction"'/>
<rdf:Description rdf:about="&a;300025412">
	<b:glossaryEntry>not on target; "the kick was wide"; "the arrow was wide of the mark"; "a claim that was wide of the truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300025588">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `to'') in the habit of or adapted to; "accustomed to doing her own work"; "I''ve grown accustomed to her face"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300025790">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in the habit; "I am used to hitchhiking"; "you''ll get used to the idea"; "...was wont to complain that this is a cold world"- Henry David Thoreau]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300026005">
	<b:glossaryEntry>not habituated to; unfamiliar with; "unaccustomed to wearing suits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300026167">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `to'') unfamiliar; "new experiences"; "experiences new to him"; "errors of someone new to the job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300026345">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') infrequently exposed to; "feet unused to shoes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300026478">
	<b:glossaryEntry>(chemistry) relating to or containing an acid; having a pH of less than 7</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300026658"
	 b:glossaryEntry='(chemistry) containing acid; "an acid taste"'/>
<rdf:Description rdf:about="&a;300026753"
	 b:glossaryEntry="yielding an acid in aqueous solution"/>
<rdf:Description rdf:about="&a;300026848">
	<b:glossaryEntry>(chemistry) relating to or containing an alkali; having a pH greater than 7; "alkaline soils derived from chalk or limestone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300027110"
	 b:glossaryEntry="tending to become alkaline; slightly alkaline"/>
<rdf:Description rdf:about="&a;300027227">
	<b:glossaryEntry>(chemistry) of or denoting or of the nature of or containing a base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300027346"
	 b:glossaryEntry="yielding a base in aqueous solution"/>
<rdf:Description rdf:about="&a;300027440">
	<b:glossaryEntry>(chemistry) having characteristics of both an acid and a base and capable of reacting as either</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300027624">
	<b:glossaryEntry>thriving in a relatively acid environment; (especially of plants) requiring a pH well below 7</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300027793"
	 b:glossaryEntry="especially of some bacteria; growing well in an acid medium"/>
<rdf:Description rdf:about="&a;300027936">
	<b:glossaryEntry>thriving in a relatively alkaline environment; (especially of plants) requiring a pH above 7</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300028090">
	<b:glossaryEntry>recognized or made known or admitted; "the acknowledged leader of the community"; "a woman of acknowledged accomplishments"; "his acknowledged error"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300028460">
	<b:glossaryEntry>generally approved or compelling recognition; "several accepted techniques for treating the condition"; "his recognized superiority in this kind of work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300028681">
	<b:glossaryEntry>owned up to; "his admitted doubts"; "the conceded error"; "a confessed murderer"; "a self-confessed plagiarist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300028899">
	<b:glossaryEntry>accepted as real or true without proof; "an assumed increase in population"; "the assumed reason for his absence"; "assumptive beliefs"; "his loyalty was taken for granted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300029161"
	 b:glossaryEntry='openly affirmed; "an avowed Jeffersonian"'/>
<rdf:Description rdf:about="&a;300029258"
	 b:glossaryEntry='that must be declared; "declarable income"'/>
<rdf:Description rdf:about="&a;300029357">
	<b:glossaryEntry xml:space='preserve'><![CDATA[acknowledged as a supposition; "given the engine''s condition, it is a wonder that it started"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300029512">
	<b:glossaryEntry xml:space='preserve'><![CDATA[commonly put forth or accepted as true on inconclusive grounds; "the foundling''s putative father"; "the reputed (or purported) author of the book"; "the supposed date of birth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300029788"
	 b:glossaryEntry="not recognized or admitted"/>
<rdf:Description rdf:about="&a;300030001"
	 b:glossaryEntry="any connection is denied"/>
<rdf:Description rdf:about="&a;300030093"
	 b:glossaryEntry="having value that is not acknowledged"/>
<rdf:Description rdf:about="&a;300030210"
	 b:glossaryEntry='not openly made known; "a secret marriage"; "a secret bride"'/>
<rdf:Description rdf:about="&a;300030334"
	 b:glossaryEntry='not admitted; "unconfessed sins"'/>
<rdf:Description rdf:about="&a;300030424"
	 b:glossaryEntry='not recognized; "he was unrecognized in his disguise"'/>
<rdf:Description rdf:about="&a;300030536">
	<b:glossaryEntry>eager to acquire and possess things especially material possessions or ideas; "an acquisitive mind"; "an aquisitive society in which the craving for material things seems never satisfied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300030925">
	<b:glossaryEntry>marked by acquiring or amassing; "we live in an accumulative society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300031053">
	<b:glossaryEntry xml:space='preserve'><![CDATA[immoderately desirous of acquiring e.g. wealth; "they are avaricious and will do anything for money"; "casting covetous eyes on his neighbor''s fields"; "a grasping old miser"; "grasping commercialism"; "greedy for money and power"; "grew richer and greedier"; "prehensile employers stingy with raises for their employees"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300031484">
	<b:glossaryEntry>desirous of owning; "small children are so possessive they will not let others play with their toys"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300031641"
	 b:glossaryEntry="given to taking by force what is desired"/>
<rdf:Description rdf:about="&a;300031738">
	<b:glossaryEntry>living by or given to victimizing others for personal gain; "predatory capitalists"; "a predatory, insensate society in which innocence and decency can prove fatal"- Peter S. Prescott; "a predacious kind of animal--the early geological gangster"- W.E.Swinton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300032078">
	<b:glossaryEntry>excessively greedy and grasping; "a rapacious divorcee on the prowl"; "ravening creditors"; "paying taxes to voracious governments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300032288">
	<b:glossaryEntry>meanly avaricious and mercenary; "sordid avarice"; "sordid material interests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300032419">
	<b:glossaryEntry>not acquisitive; not interested in acquiring or owning anything</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300032560">
	<b:glossaryEntry>(botany) of leaves or flowers; developing or opening in succession from base to apex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300032700">
	<b:glossaryEntry>(botany) of leaves or flowers; developing or opening in succession from apex to base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300032840">
	<b:glossaryEntry>characterized by energetic activity; "an active toddler"; "active as a gazelle"; "an active man is a man of action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300033206">
	<b:glossaryEntry>on the move; "up and about"; "the whole town was astir over the incident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300033345">
	<b:glossaryEntry>vigorously active; "an acrobatic dance"; "an athletic child"; "athletic playing"; "gymnastic exercises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300033527">
	<b:glossaryEntry>moving quickly and lightly; "sleek and agile as a gymnast"; "as nimble as a deer"; "nimble fingers"; "quick of foot"; "the old dog was so spry it was halfway up the stairs before we could stop it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300033799"
	 b:glossaryEntry='moving quickly and excitedly; "on dancing feet"'/>
<rdf:Description rdf:about="&a;300033900">
	<b:glossaryEntry>(informal) marked by excited activity; "a hot week on the stock market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300034021"
	 b:glossaryEntry='more active than normal; "a hyperactive child"'/>
<rdf:Description rdf:about="&a;300034138"
	 b:glossaryEntry='characterized by energetic activity; "a lively baby"'/>
<rdf:Description rdf:about="&a;300034243"
	 b:glossaryEntry='(of a person) very busy and active; "is always on the go"'/>
<rdf:Description rdf:about="&a;300034359">
	<b:glossaryEntry>not active physically or mentally; "illness forced him to live an inactive life"; "dreamy and inactive by nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300034635">
	<b:glossaryEntry>not active but capable of becoming active; "her feelings of affection are dormant but easily awakened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300034791"
	 b:glossaryEntry="abnormally inactive"/>
<rdf:Description rdf:about="&a;300034881">
	<b:glossaryEntry>slow and apathetic; "she was fat and inert"; "a sluggish worker"; "a mind grown torpid in old age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300035051">
	<b:glossaryEntry>used of persons or actions; "forced by illness to lead a sedentary life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300035179">
	<b:glossaryEntry>engaged in full-time work; "active duty" (military); "though past retirement age he is still active in his profession"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300035404">
	<b:glossaryEntry>(military) set up and placed on active assignment; "a newly activated unit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300035535">
	<b:glossaryEntry xml:space='preserve'><![CDATA[performing or scheduled for duties; "I''m on from five to midnight"; "Naval personnel on duty in Alaska"; "her on-duty hours were 11p.m. to 7 a.m."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300035759">
	<b:glossaryEntry>actively engaged in a career or way of life; "a practicing physician"; "a practicing Catholic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300035910">
	<b:glossaryEntry>not engaged in full-time work; "inactive reserve" (military) ; "an inactive member of the department"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300036120">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not performing or scheduled for duties; "He''s off every Tuesday"; "he was off duty when it happened"; "an off-duty policeman"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300036326"
	 b:glossaryEntry="absent with permission from work or duty"/>
<rdf:Description rdf:about="&a;300036421"
	 b:glossaryEntry="no longer active in your work or profession"/>
<rdf:Description rdf:about="&a;300036518">
	<b:glossaryEntry>full of activity or engaged in continuous activity; "an active seaport"; "an active bond market"; "an active account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300036814"
	 b:glossaryEntry='very active; "doing a brisk business"'/>
<rdf:Description rdf:about="&a;300036903"
	 b:glossaryEntry='full of energetic and noisy activity; "a bustling city"'/>
<rdf:Description rdf:about="&a;300037013">
	<b:glossaryEntry>crowded with or characterized by much activity; "a very busy week"; "a busy life"; "a busy street"; "a busy seaport"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300037180"
	 b:glossaryEntry='in full operation; "a going concern"'/>
<rdf:Description rdf:about="&a;300037271">
	<b:glossaryEntry>at the highest level of activity; "for the first time in years the factory was in full swing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300037427"
	 b:glossaryEntry='ready for business; "the stores are open"'/>
<rdf:Description rdf:about="&a;300037519">
	<b:glossaryEntry>lacking activity; lying idle or unused; "an inactive mine"; "inactive accounts"; "inactive machinery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300037801">
	<b:glossaryEntry>shut down; "the airport is closed because of the weather"; "the many closed shops and factories made the town look deserted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300037979">
	<b:glossaryEntry>not giving performances; closed; "the theater is dark on Mondays"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300038095">
	<b:glossaryEntry>devoid of activity; "this is a dead town; nothing ever happens here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300038214">
	<b:glossaryEntry>(of business) not active or brisk; "business is dull (or slow)"; "a sluggish market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300038367">
	<b:glossaryEntry>not in active use; "the machinery sat idle during the strike"; "idle hands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300038502"
	 b:glossaryEntry='closed or immobilized by a strike; "a strikebound airline"'/>
<rdf:Description rdf:about="&a;300038618">
	<b:glossaryEntry>(pathology) tending to become more severe or wider in scope; "active tuberculosis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300038771"
	 b:glossaryEntry='advancing in severity; "progressive paralysis"'/>
<rdf:Description rdf:about="&a;300038875">
	<b:glossaryEntry>(pathology) not progressing or increasing; or progressing slowly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300039066">
	<b:glossaryEntry>having development checked or reversed; "arrested tuberculosis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300039199">
	<b:glossaryEntry>(pathology) of tumors e.g.; slow to heal or develop and usually painless; "an indolent ulcer"; "leprosy is an indolent infectious disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300039392"
	 b:glossaryEntry='not presently active; "latent infection"'/>
<rdf:Description rdf:about="&a;300039485"
	 b:glossaryEntry='causing no symptoms; "a quiescent tumor"'/>
<rdf:Description rdf:about="&a;300039581">
	<b:glossaryEntry>disposed to take action or effectuate change; "a director who takes an active interest in corporate operations"; "an active antagonism"; "he was active in drawing attention to their grievances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300039863"
	 b:glossaryEntry="advocating or engaged in activism"/>
<rdf:Description rdf:about="&a;300039964">
	<b:glossaryEntry>lacking in energy or will; "Much benevolence of the passive order may be traced to a disinclination to inflict pain upon oneself"- George Meredith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300040211">
	<b:glossaryEntry>offering no resistance; "resistless hostages"; "No other colony showed such supine, selfish helplessness in allowing her own border citizens to be mercilessly harried"- Theodore Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300040478"
	 b:glossaryEntry="producing activity or change"/>
<rdf:Description rdf:about="&a;300040577">
	<b:glossaryEntry>capable of lowering the surface tension of a liquid; used especially of detergents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300040720">
	<b:glossaryEntry>opposing or neutralizing or mitigating an effect by contrary action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300040973"
	 b:glossaryEntry="acting to neutralize acid (especially in the stomach)"/>
<rdf:Description rdf:about="&a;300041080">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) opposite or opposing or neutralizing; "`ant'' is a prefix in `antacid''"; "`anti'' is a prefix in `antihistamine''and `antifreeze''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300041273"
	 b:glossaryEntry="counteracting the effects of a poison"/>
<rdf:Description rdf:about="&a;300041366"
	 b:glossaryEntry="counteracting inflammation"/>
<rdf:Description rdf:about="&a;300041453"
	 b:glossaryEntry="acting against with equal force or influence"/>
<rdf:Description rdf:about="&a;300041558"
	 b:glossaryEntry="compensating for"/>
<rdf:Description rdf:about="&a;300041678">
	<b:glossaryEntry>acting in opposition to; "the opposing sector of the same muscle group"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300041804">
	<b:glossaryEntry>(of e.g. volcanos) being in a state of action or potential action; "active volcanos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300042013">
	<b:glossaryEntry>capable of erupting; "a live volcano"; "the volcano is very much alive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300042149">
	<b:glossaryEntry>erupting or tending to erupt; "a geyser is an intermittently eruptive hot spring"; "people fled from the erupting volcano"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300042340"
	 b:glossaryEntry='of e.g. volcanos; temporarily inactive; "a dormant volcano"'/>
<rdf:Description rdf:about="&a;300042518"
	 b:glossaryEntry="being quiet or still or inactive"/>
<rdf:Description rdf:about="&a;300042606"
	 b:glossaryEntry='of e.g. volcanos; permanently inactive; "an extinct volcano"'/>
<rdf:Description rdf:about="&a;300042785">
	<b:glossaryEntry>physically inactive; "Crater Lake is in the crater of a dead volcano of the Cascade Range"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300042926">
	<b:glossaryEntry>(grammar) expressing action rather than a state of being; used of verbs (e.g. `to run'') and participial adjectives (e.g. `running'' in `running water'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300043139">
	<b:glossaryEntry>(grammar) expressing existence or a state rather than an action; used of verbs (e.g. `be'' or `own'') and most participial adjectives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300043324"
	 b:glossaryEntry="(grammar) active voice"/>
<rdf:Description rdf:about="&a;300043399"
	 b:glossaryEntry="(grammar) passive voice"/>
<rdf:Description rdf:about="&a;300043476">
	<b:glossaryEntry>exerting influence or producing an effect; "an active ingredient"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300043612">
	<b:glossaryEntry>rendered active; e.g. rendered radioactive or luminescent or photosensitive or conductive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300043757"
	 b:glossaryEntry="not active or exerting influence"/>
<rdf:Description rdf:about="&a;300043862">
	<b:glossaryEntry>not active or activated; "the quiescent level of centimeter wave-length solar radiation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300044006">
	<b:glossaryEntry>(astronomy; of the sun) characterized by a high level activity in sunspots and flares and radio emissions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300044164">
	<b:glossaryEntry>(astronomy; of the sun) characterized by a low level of surface phenomena like sun spots e.g.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300044309">
	<b:glossaryEntry>presently existing in fact and not merely potential or possible; "the predicted temperature and the actual temperature were markedly different"; "actual and imagined conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300044622">
	<b:glossaryEntry>changed from potential to actual; "saw his worst fears actualized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300044745">
	<b:glossaryEntry>existing in fact; not theoretical; real; "a decline in the effective demand"; "confused increased equipment and expenditure with the quantity of effective work done"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300044966">
	<b:glossaryEntry>used to give emphasis to the relevance of the thing modified; "his very name struck terror"; "caught in the very act"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300045137">
	<b:glossaryEntry>existing in possibility; "a potential problem"; "possible uses of nuclear poser"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300045320">
	<b:glossaryEntry>potentially existing but not presently evident or realized; "a latent fingerprint"; "latent talent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300045472">
	<b:glossaryEntry>(medicine) having or experiencing a rapid onset and short but severe course; "acute appendicitis"; "the acute phase of the illness"; "acute patients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300045690">
	<b:glossaryEntry>less than acute; relating to a disease present in a person with no symptoms of it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300045826">
	<b:glossaryEntry>(medicine) being long-lasting and recurrent or characterized by long suffering; "chronic indigestion"; "a chronic shortage of funds"; "a chronic invalid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300046069">
	<b:glossaryEntry>of illness; marked by gradual deterioration of organs and cells along with loss of function; "degenerative diseases of old age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300046269"
	 b:glossaryEntry="of illness; developing slowly or of long duration"/>
<rdf:Description rdf:about="&a;300046374"
	 b:glossaryEntry="infectious; having the ability to cause disease"/>
<rdf:Description rdf:about="&a;300046512">
	<b:glossaryEntry>(of a microorganism) extremely infective; "a highly infective organism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300046646"
	 b:glossaryEntry="(of a disease) having a rapid course and violent effect"/>
<rdf:Description rdf:about="&a;300046754"
	 b:glossaryEntry="not virulent; unable to produce disease"/>
<rdf:Description rdf:about="&a;300046849">
	<b:glossaryEntry>having a capacity for adaptation; "the adaptive coloring of a chameleon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300047042"
	 b:glossaryEntry="tending to reconcile or accommodate; bringing into harmony"/>
<rdf:Description rdf:about="&a;300047174"
	 b:glossaryEntry="of or relating to adaptation"/>
<rdf:Description rdf:about="&a;300047261"
	 b:glossaryEntry="conducive to adjustment"/>
<rdf:Description rdf:about="&a;300047340"
	 b:glossaryEntry="showing faulty adaptation"/>
<rdf:Description rdf:about="&a;300047459">
	<b:glossaryEntry>(of a trait or condition) failing to serve an adjustive purpose; "dysfunctional behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300047623"
	 b:glossaryEntry="poorly adjusted"/>
<rdf:Description rdf:about="&a;300047697">
	<b:glossaryEntry>combined or joined to increase in size or quantity or scope; "takes on added significance"; "an added attraction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300048060">
	<b:glossaryEntry>something added that is nonessential but helpful; "accessorial services included sorting and packing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300048219">
	<b:glossaryEntry>existing or coming by way of addition; "an additional problem"; "further information"; "there will be further delays"; "took more time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300048434"
	 b:glossaryEntry='added to supplement; "adscititious remarks"'/>
<rdf:Description rdf:about="&a;300048536">
	<b:glossaryEntry>one more or an added; "another chance"; "another cup of coffee"; "an additional piece of pie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300048699">
	<b:glossaryEntry>more; "would you like anything else?"; "I have nothing else to say"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300048834">
	<b:glossaryEntry>further or added; "called for additional troops"; "need extra help"; "an extra pair of shoes"; "I have no other shoes"; "there are other possibilities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300049061">
	<b:glossaryEntry>added or having an addition to make the calender year correspond to the solar year; "Feb. 29 is an intercalary day"; "leap year is an intercalary year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300049270"
	 b:glossaryEntry='added as a consequence or supplement; "a side benefit"'/>
<rdf:Description rdf:about="&a;300049378">
	<b:glossaryEntry>added or imposed without integration; "the superimposed symbolism lacked validity"; "superimposed periodic variation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300049554">
	<b:glossaryEntry>added to complete or make up a deficiency; "produced supplementary volumes"; "additional reading"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300049739">
	<b:glossaryEntry>being or pertaining to something added to a product to increase its value or price; "software supplied by a value-added distributor"; "a value-added tax"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300049950"
	 b:glossaryEntry="taken away"/>
<rdf:Description rdf:about="&a;300050053">
	<b:glossaryEntry>removed or taken away by cutting or erosion or melting or evaporation; "my ablated appendix"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300050199">
	<b:glossaryEntry>taken off or taken away from a total; "take-home pay is what is left after subtraction of deducted taxes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300050359">
	<b:glossaryEntry>compulsively or physiologically dependent on something habit-forming; "she is addicted to chocolate"; "addicted to cocain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300050590">
	<b:glossaryEntry>addicted to alcohol; "alcoholic expatriates in Paris"- Carl Van Doren</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300050735"
	 b:glossaryEntry='having a habit of long standing; "a chronic smoker"'/>
<rdf:Description rdf:about="&a;300050879"
	 b:glossaryEntry="addicted to a drug"/>
<rdf:Description rdf:about="&a;300051003"
	 b:glossaryEntry="not addicted"/>
<rdf:Description rdf:about="&a;300051090">
	<b:glossaryEntry>free of drugs; "after a long dependency on heroin she has been clean for 4 years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300051223">
	<b:glossaryEntry>causing or characterized by addiction; "addictive drugs"; "addictive behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300051373">
	<b:glossaryEntry>not causing or characterized by addiction; "for years tobacco companies have contended that tobacco is nonaddictive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300051548"
	 b:glossaryEntry='characterized or produced by addition; "an additive process"'/>
<rdf:Description rdf:about="&a;300051717">
	<b:glossaryEntry>increasing by successive addition; "the benefits are cumulative"; "the eventual accumulative effect of these substances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300051909"
	 b:glossaryEntry="capable of being added or added to"/>
<rdf:Description rdf:about="&a;300052007"
	 b:glossaryEntry="of or relating to a summation or produced by summation"/>
<rdf:Description rdf:about="&a;300052131">
	<b:glossaryEntry>constituting or involving subtraction; "a subtractive correction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300052290">
	<b:glossaryEntry>tending to ablate; i.e. to be removed or vaporized at very high temperature; "ablative material on a rocket cone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300052458">
	<b:glossaryEntry>characterized by or causing diminution or curtailment; "their views of life were reductive and depreciabory"_ R.H.Rovere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300052634">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of mail; marked with a destination; "I throw away all mail addressed to `resident''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300052791">
	<b:glossaryEntry>addressed to yourself; "enclose a stamped self-addressed envelope with all submissions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300052939"
	 b:glossaryEntry='not addressed; "an unaddressed envelope"'/>
<rdf:Description rdf:about="&a;300053037">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `to'') meeting the requirements especially of a task; "she had adequate training"; "her training was adequate"; "she was adequate to the job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300053327">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having the requisite qualities for; "equal to the task"; "the work isn''t up to the standard I require"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300053525"
	 b:glossaryEntry='adequate for the purpose; "a competent performance"'/>
<rdf:Description rdf:about="&a;300053632">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `to'') not meeting the requirements especially of a task; "inadequate training"; "the staff was inadequate"; "she was inadequate to the job"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300053941">
	<b:glossaryEntry>inadequate in amount or degree; "a deficient education"; "deficient in common sense"; "lacking in stamina"; "tested and found wanting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300054157">
	<b:glossaryEntry>not meeting requirements; "unequal to the demands put upon him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300054306">
	<b:glossaryEntry xml:space='preserve'><![CDATA[inadequate in number of workers or assistants etc.; "they''re rather short-handed at the moment"; "overcrowded and understaffed hospitals"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300054547"
	 b:glossaryEntry="tending to adhere"/>
<rdf:Description rdf:about="&a;300054817"
	 b:glossaryEntry="sticking fast"/>
<rdf:Description rdf:about="&a;300054885"
	 b:glossaryEntry="united as if by glue"/>
<rdf:Description rdf:about="&a;300054979">
	<b:glossaryEntry>capable of holding together or cohering; as particles in a mass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300055097"
	 b:glossaryEntry='sticking together; "two coherent sheets"; "tenacious burrs"'/>
<rdf:Description rdf:about="&a;300055223"
	 b:glossaryEntry='causing cohesion; "a cohesive agent"'/>
<rdf:Description rdf:about="&a;300055314"
	 b:glossaryEntry="having the properties of glue"/>
<rdf:Description rdf:about="&a;300055466"
	 b:glossaryEntry="soft and sticky"/>
<rdf:Description rdf:about="&a;300055540"
	 b:glossaryEntry="treated with adhesive gum"/>
<rdf:Description rdf:about="&a;300055618"
	 b:glossaryEntry="having the characteristics of pitch or tar"/>
<rdf:Description rdf:about="&a;300055741">
	<b:glossaryEntry>seals without the application of moisture; "self-sealing envelopes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300055867"
	 b:glossaryEntry='gummed in advance; "stick-on labels"'/>
<rdf:Description rdf:about="&a;300055958"
	 b:glossaryEntry="not tending to adhere"/>
<rdf:Description rdf:about="&a;300056073"
	 b:glossaryEntry="not resembling glue in texture"/>
<rdf:Description rdf:about="&a;300056174"
	 b:glossaryEntry="not treated with adhesive gum"/>
<rdf:Description rdf:about="&a;300056258">
	<b:glossaryEntry>(law) applying to methods of enforcement and rules of procedure; "adjective law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300056407">
	<b:glossaryEntry>(law) applying to essential legal principles and rules of right; "substantive law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300056559">
	<b:glossaryEntry>suitable or eligible for adoption; "a shortage of adoptable babies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300056682"
	 b:glossaryEntry="difficult to place in an adoptive home"/>
<rdf:Description rdf:about="&a;300056778">
	<b:glossaryEntry>provided with something intended to increase its beauty or distinction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300057580"
	 b:glossaryEntry="covered with beads or jewels or sequins"/>
<rdf:Description rdf:about="&a;300057780"
	 b:glossaryEntry="ornamented in a vulgar or showy fashion"/>
<rdf:Description rdf:about="&a;300057874">
	<b:glossaryEntry>wearing, or having the face adorned with, eyeglasses or an eyeglass; "a bespectacled grandmother"; "the monocled gentleman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300058080"
	 b:glossaryEntry='adorned with braid; "his braided collar"'/>
<rdf:Description rdf:about="&a;300058174">
	<b:glossaryEntry>embellished with a raised pattern created by pressure or embroidery; "brocaded silk"; "an embossed satin"; "embossed leather"; "raised needlework"; "raised metalwork"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300058415"
	 b:glossaryEntry="ornamented with many buttons"/>
<rdf:Description rdf:about="&a;300058497"
	 b:glossaryEntry="set with carbuncles"/>
<rdf:Description rdf:about="&a;300058573">
	<b:glossaryEntry>(for metals) having areas separated by metal and filled with colored enamel and fired</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300058726">
	<b:glossaryEntry>covered with or as if with a glossy and usually brightly colored coating; "her enameled nails"; "the sun-enameled scene; "a blue enameled bowl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300058924"
	 b:glossaryEntry="glittering with gold or silver"/>
<rdf:Description rdf:about="&a;300059032"
	 b:glossaryEntry="(of a knight''s helmet) having a decorative plume"/>
<rdf:Description rdf:about="&a;300059143">
	<b:glossaryEntry>(of a bird or animal) having a usually ornamental tuft or process on the head; often used in combination; "golden crested"; "crested iris"; "crested oriole"; "tufted duck"; "tufted loosestrife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300059412"
	 b:glossaryEntry="(heraldry) bearing an heraldic device"/>
<rdf:Description rdf:about="&a;300059503">
	<b:glossaryEntry>(of a gable or spire) furnished with a crocket (an ornament in the form of curved or bent foliage); "a crocketed spire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300059678"
	 b:glossaryEntry="rich in decorative detail"/>
<rdf:Description rdf:about="&a;300059783"
	 b:glossaryEntry="adorned with embroidery"/>
<rdf:Description rdf:about="&a;300059864">
	<b:glossaryEntry>adorned or crowned with a circlet; sometimes used as combining forms; "a brow encircled with laurel"; "wreathed in an extraordinary luminescence"; "ringed round with daisies"; "smoke-wreathed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300060132">
	<b:glossaryEntry>with superficial adornments added; "all gussied up in sequins and feathers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300060301"
	 b:glossaryEntry="adorned with feathers or plumes"/>
<rdf:Description rdf:about="&a;300060407"
	 b:glossaryEntry="having decorative ruffles or frills"/>
<rdf:Description rdf:about="&a;300060515"
	 b:glossaryEntry="having a decorative edging of hanging cords or strips"/>
<rdf:Description rdf:about="&a;300060622"
	 b:glossaryEntry="having gilded edges as the pages of a book"/>
<rdf:Description rdf:about="&a;300060721">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `with'' or used in a combining form) having items suspended on or from a support; "walls hung with valuable paintings"; "a vine-hung trellis"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300060933"
	 b:glossaryEntry="(heraldry) adorned with tongues of flame"/>
<rdf:Description rdf:about="&a;300061028"
	 b:glossaryEntry="adorned by inlays"/>
<rdf:Description rdf:about="&a;300061098">
	<b:glossaryEntry>having a decorative pattern worked or woven in; "an inwrought design"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300061223"
	 b:glossaryEntry="trimmed or decorated with lace"/>
<rdf:Description rdf:about="&a;300061305">
	<b:glossaryEntry>decorated with small pieces of colored glass or stone fitted together; "a mosaic floor"; "a tessellated pavement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300061485">
	<b:glossaryEntry>decorated with applied ornamentation; often used in combination; "the trim brass-mounted carbine of the ranger"- F.V.W.Mason</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300061663"
	 b:glossaryEntry="used of walls; decorated with panels or wainscoting"/>
<rdf:Description rdf:about="&a;300061781">
	<b:glossaryEntry>dotted or adorned with or as with studs or nailheads; usually used in combination; "star-studded heavens"; "diamond-studded belt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300061964"
	 b:glossaryEntry="hung or decorated with tapestry"/>
<rdf:Description rdf:about="&a;300062052"
	 b:glossaryEntry="fringed or adorned with tassels"/>
<rdf:Description rdf:about="&a;300062150">
	<b:glossaryEntry>decorated in a particular way; "tricked-out cupboards looking like Georgian cabinets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300062293"
	 b:glossaryEntry='having or adorned with tufts; "a tufted bedspread"'/>
<rdf:Description rdf:about="&a;300062396">
	<b:glossaryEntry>not decorated with something to increase its beauty or distinction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300062604">
	<b:glossaryEntry>lacking embellishment or ornamentation; "a plain hair style"; "unembellished white walls"; "functional architecture featuring stark unornamented concrete"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300062841"
	 b:glossaryEntry='not adorned with tufts; "untufted ears"'/>
<rdf:Description rdf:about="&a;300062935">
	<b:glossaryEntry>releasing or activated by acetylcholine or a related compound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300063054">
	<b:glossaryEntry>inhibiting or blocking the action of acetylcholine at a receptor site; "anticholinergic drugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300063210">
	<b:glossaryEntry>quick or skillful or adept in action or thought; "an exceptionally adroit pianist"; "an adroit technician"; "his adroit replies to hecklers won him many followers"; "an adroit negotiator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300063594">
	<b:glossaryEntry xml:space='preserve'><![CDATA[free from clumsiness; precisely or deftly executed; "he landed a clean left on his opponent''s cheek"; "a clean throw"; "the neat exactness of the surgeon''s knife"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300063815">
	<b:glossaryEntry>showing inventiveness and skill; "a clever gadget"; "the cunning maneuvers leading to his success""; "an ingenious solution to the problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300064029">
	<b:glossaryEntry>being dexterous in the use of more than one set of muscle movements; "she was usually good with her hands and well coordinated"- Mary McCarthy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300064229">
	<b:glossaryEntry>skillful in physical movements; especially of the hands; "a deft waiter"; "deft fingers massaged her face"; "dexterous of hand and inventive of mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300064452"
	 b:glossaryEntry='skillful with the hands; "handy with an axe"'/>
<rdf:Description rdf:about="&a;300064548">
	<b:glossaryEntry>having nimble fingers literally or figuratively; especially for stealing or picking pockets; "a light-fingered burglar who can crack the combination of a bank vault"- Harry Hansen; "the light-fingered thoughtfulness...of the most civilized playwright of the era"- Time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300064895">
	<b:glossaryEntry>mentally nimble and resourceful; "quick-witted debater"; "saved an embarrassing situation with quick-witted tact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300065067">
	<b:glossaryEntry>not adroit; "a maladroit movement of his hand caused the car to swerve"; "a maladroit translation"; "maladroit propaganda"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300065335">
	<b:glossaryEntry>not skillful in physical movement especially with the hands; "a bumbling mechanic"; "a bungling performance"; "ham-handed governmental interference"; "could scarcely empty a scuttle of ashes, so handless was the poor creature"- Mary H. Vorse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300065725">
	<b:glossaryEntry>revealing lack of perceptiveness or judgment or finesse; "an inept remark"; "it was tactless to bring up those disagreeable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300065912">
	<b:glossaryEntry>not well coordinated; "his movements are clumsy and uncoordinated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300066038"
	 b:glossaryEntry="of persons without mechanical skills"/>
<rdf:Description rdf:about="&a;300066149"
	 b:glossaryEntry='moving ahead or toward the front; "advancing armies"'/>
<rdf:Description rdf:about="&a;300066275">
	<b:glossaryEntry>moving toward a position ahead; "forward motion"; "the onward course of events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300066417"
	 b:glossaryEntry="moving back or away"/>
<rdf:Description rdf:about="&a;300066529">
	<b:glossaryEntry>moving toward a position farther from the front; "the receding glaciers of the last ice age"; "retiring fogs revealed the rocky coastline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300066733"
	 b:glossaryEntry='forced withdrawal; "pursued the withdrawing redcoats"'/>
<rdf:Description rdf:about="&a;300066844">
	<b:glossaryEntry>giving an advantage; "a contract advantageous to our country"; "socially advantageous to entertain often"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300067152">
	<b:glossaryEntry>promoting or enhancing well-being; "an arms limitation agreement beneficial to all countries"; "the beneficial effects of a temperate climate"; "the experience was good for her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300067393"
	 b:glossaryEntry='involving advantage or good; "a plus (or positive) factor"'/>
<rdf:Description rdf:about="&a;300067513">
	<b:glossaryEntry>promoting benefit or gain; "a profitable meeting to resolve difficulties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300067643">
	<b:glossaryEntry>manifesting partiality; "a discriminatory tax"; "preferential tariff rates"; "preferential treatment"; "a preferential shop gives priority or advantage to union members in hiring or promoting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300067911"
	 b:glossaryEntry="constituting a disadvantage"/>
<rdf:Description rdf:about="&a;300068082">
	<b:glossaryEntry>involving disadvantage or harm; "minus (or negative) factors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300068206">
	<b:glossaryEntry>willing to undertake or seeking out new and daring enterprises; "adventurous pioneers"; "the risks and gains of an adventuresome economy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300068525">
	<b:glossaryEntry>disposed to venture or take risks; "audacious visions of the total conquest of space"; "an audacious interpretation of two Jacobean dramas"; "the most daring of contemporary fiction writers"; "a venturesome investor"; "a venturous spirit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300068854">
	<b:glossaryEntry>involving risk or willingness to take a risk; "a sporting chance"; "sporting blood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300068992"
	 b:glossaryEntry="flamboyantly adventurous"/>
<rdf:Description rdf:about="&a;300069089"
	 b:glossaryEntry="lacking in boldness"/>
<rdf:Description rdf:about="&a;300069240"
	 b:glossaryEntry="unwilling to take risks"/>
<rdf:Description rdf:about="&a;300069318"
	 b:glossaryEntry="of an undertaking"/>
<rdf:Description rdf:about="&a;300069386">
	<b:glossaryEntry>worthy of being recommended or suggested; prudent or wise; "such action is neither necessary nor advisable"; "extreme caution is advisable"; "it is advisable to telephone first"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300069709">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative and superlative of `well'') wiser or more advantageous and hence advisable; "it would be better to speak to him"; "the White House thought it best not to respond"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300069949"
	 b:glossaryEntry='proceeding from good sense or judgment; "a sensible choice"'/>
<rdf:Description rdf:about="&a;300070075">
	<b:glossaryEntry>mentioned as worthy of acceptance; "the recommended medicine"; "the suggested course of study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300070239">
	<b:glossaryEntry>wise or advantageous and hence advisable; "it would be well to start early"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300070368">
	<b:glossaryEntry>not prudent or wise; not recommended; "running on the ice is inadvisable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300070531">
	<b:glossaryEntry>having the benefit of careful prior consideration or counsel; "a well-advised delay in carrying out the plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300070745"
	 b:glossaryEntry='carefully considered; "a considered opinion"'/>
<rdf:Description rdf:about="&a;300070853">
	<b:glossaryEntry>without careful prior deliberation or counsel; "ill-advised efforts"; it would be ill-advised to accept the offer"; "took the unadvised measure of going public with the accusations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300071122"
	 b:glossaryEntry='depending on free oxygen or air; "aerobic fermentation"'/>
<rdf:Description rdf:about="&a;300071267">
	<b:glossaryEntry>living or active only in the presence of oxygen; "aerobiotic bacteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300071394">
	<b:glossaryEntry>taking place in the presence of oxygen; "oxidative glycolysis"; "oxidative rancidity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300071535">
	<b:glossaryEntry>living or active in the absence of free oxygen; "anaerobic bacteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300071674">
	<b:glossaryEntry>based on or using the principles of aerobics; enhancing respiratory and circulatory efficiency; "aerobic dance"; "running is very aerobic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300071866"
	 b:glossaryEntry='not aerobic; "isometric exercises are anaerobic"'/>
<rdf:Description rdf:about="&a;300071970">
	<b:glossaryEntry>concerning or characterized by an appreciation of beauty or good taste; "the aesthetic faculties"; "an aesthetic person"; "aesthetic feeling"; "the illustrations made the book an aesthetic success"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300072351">
	<b:glossaryEntry>satisfying aesthetic standards and sensibilities; "artistic workmanship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300072478"
	 b:glossaryEntry="aesthetically pleasing"/>
<rdf:Description rdf:about="&a;300072556">
	<b:glossaryEntry>serving an aesthetic purpose in beautifying the body; "cosmetic surgery"; "enhansive makeup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300072715"
	 b:glossaryEntry="(fine arts) having qualities unique to the art of painting"/>
<rdf:Description rdf:about="&a;300072829">
	<b:glossaryEntry>taking delight in beauty; "the sensuous joy from all things fair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300072949">
	<b:glossaryEntry>violating aesthetic canons or requirements; deficient in tastefulness or beauty; "inaesthetic and quite unintellectual"; "peered through those inaesthetic spectacles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300073241"
	 b:glossaryEntry="lacking aesthetic sensibility;"/>
<rdf:Description rdf:about="&a;300073342"
	 b:glossaryEntry='deficient in beauty; "ugly gray slums"'/>
<rdf:Description rdf:about="&a;300073431"
	 b:glossaryEntry='deficient in tastefulness; "coarse and tasteless luxury"'/>
<rdf:Description rdf:about="&a;300073543"
	 b:glossaryEntry="acted upon; influenced"/>
<rdf:Description rdf:about="&a;300073728"
	 b:glossaryEntry="deeply or markedly affected or influenced"/>
<rdf:Description rdf:about="&a;300073828">
	<b:glossaryEntry>(used in combination) affected by something overwhelming; "conscience-smitten"; "awe-struck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300073994">
	<b:glossaryEntry>infatuated with or enthralled by the theater especially the desire to act</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300074126">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be affected with an indisposition; "the child was taken ill"; "couldn''t tell when he would be taken drunk"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300074284"
	 b:glossaryEntry="affected by or overcome with wonder"/>
<rdf:Description rdf:about="&a;300074379">
	<b:glossaryEntry xml:space='preserve'><![CDATA[undergoing no change when acted upon; "entirely unaffected by each other''s writings"; "fibers remained apparently unaffected by the treatment"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300074668">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') not affected by a given influence; "immune to persuasion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300074805">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `to'') above being affected or influenced by; "he is superior to fear"; "an ignited firework proceeds superior to circumstances until its blazing vitality fades"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300075042"
	 b:glossaryEntry='not moved to serious regard; "trying to appear unimpressed"'/>
<rdf:Description rdf:about="&a;300075159">
	<b:glossaryEntry>not influenced or affected; "stewed in its petty provincialism untouched by the brisk debates that stirred the old world"- V.L.Parrington; "unswayed by personal considerations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300075417">
	<b:glossaryEntry>speaking or behaving in an artificial way to make an impression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300075691"
	 b:glossaryEntry='struggling for effect; "agonistic poses"'/>
<rdf:Description rdf:about="&a;300075798">
	<b:glossaryEntry>artificially formal; "that artificial humility that her husband hated"; "contrived coyness"; "a stilted letter of acknowledgment"; "when people try to correct their speech they develop a stilted pronunciation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300076086">
	<b:glossaryEntry>lacking spontaneity; not natural; "a constrained smile"; "forced heartiness"; "a strained smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300076260">
	<b:glossaryEntry>(used of style of speaking) overly embellished; "an elocutionary Oxonian delivery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300076401">
	<b:glossaryEntry>having unnatural mannerisms; "brief, mannered and unlifelike idiom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300076523">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a voice; affectedly mellow and rich; "the radio announcer''s plummy voice"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300076652">
	<b:glossaryEntry>free of artificiality; sincere and genuine; "an unaffected grace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300076892"
	 b:glossaryEntry='natural looking; "a natural pose"'/>
<rdf:Description rdf:about="&a;300076990">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without artificiality; natural; "the doctor''s quiet unmannered entry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300077116">
	<b:glossaryEntry>not self-conscious; "she grew up with him in unselfconscious friendship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300077250"
	 b:glossaryEntry='flowing naturally and continuously; "unstilted conversation"'/>
<rdf:Description rdf:about="&a;300077366">
	<b:glossaryEntry>affirming or giving assent; "an affirmative decision"; "affirmative votes"; "an affirmative nod"; "an affirmatory gesture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300077650"
	 b:glossaryEntry='expressing agreement or consent; "an assenting nod"'/>
<rdf:Description rdf:about="&a;300077784"
	 b:glossaryEntry="making for or being a concession"/>
<rdf:Description rdf:about="&a;300077888">
	<b:glossaryEntry>granting what has been desired or requested; "a favorable reply"; "a positive answer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300078040"
	 b:glossaryEntry="expressing or consisting of a negation or refusal or denial"/>
<rdf:Description rdf:about="&a;300078226"
	 b:glossaryEntry='tending to dismiss or reject; "a dismissive gesture"'/>
<rdf:Description rdf:about="&a;300078335"
	 b:glossaryEntry="disagreeing, especially with a majority"/>
<rdf:Description rdf:about="&a;300078460">
	<b:glossaryEntry>inclined to accept rather than reject; "she was seldom acceptive of my suggestions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300078617">
	<b:glossaryEntry>tolerating without protest; "always more accepting of coaching suggestion than her teammates"; "the atmosphere was judged to be more supporting and accepting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300078831">
	<b:glossaryEntry>rejecting or tending to reject; "rejective or overcritical attitudes of disappointed parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300078998">
	<b:glossaryEntry>rejecting emphatically; e.g. refusing to pay or disowning; "a veto is a repudiative act"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300079144"
	 b:glossaryEntry="borne on the water; floating"/>
<rdf:Description rdf:about="&a;300079318">
	<b:glossaryEntry>afloat on the surface of a body of water; "after the storm the boats were adrift"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300079469"
	 b:glossaryEntry="traveling by boat or ship"/>
<rdf:Description rdf:about="&a;300079560">
	<b:glossaryEntry>borne up by or suspended in a liquid; "the ship is still floating"; "floating logs"; "floating seaweed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300079718"
	 b:glossaryEntry='supported by water; "waterborne craft"'/>
<rdf:Description rdf:about="&a;300079813">
	<b:glossaryEntry>on a shore or reef; "a ship aground offshore"; "a boat aground on the beach waiting for the tide to lift it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300080050"
	 b:glossaryEntry="on a beach"/>
<rdf:Description rdf:about="&a;300080132"
	 b:glossaryEntry="aground as a consequence of a shipwreck"/>
<rdf:Description rdf:about="&a;300080229"
	 b:glossaryEntry="with the bottom lodged on a reef or shoal in shallow water"/>
<rdf:Description rdf:about="&a;300080342">
	<b:glossaryEntry>under water; e.g. at the bottom of a body of water; "sunken treasure"; "a sunken ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300080547"
	 b:glossaryEntry='dead by drowning; "poor drowned sailors"'/>
<rdf:Description rdf:about="&a;300080641"
	 b:glossaryEntry='sunk by being filled with water; "a swamped boat"'/>
<rdf:Description rdf:about="&a;300080744">
	<b:glossaryEntry>filled with fear or apprehension; "afraid even to turn his head"; "suddenly looked afraid"; "afraid for his life"; "afraid of snakes"; "afraid to ask questions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300081428"
	 b:glossaryEntry="suffering from acrophobia; abnormally afraid of high places"/>
<rdf:Description rdf:about="&a;300081544"
	 b:glossaryEntry="regional and archaic"/>
<rdf:Description rdf:about="&a;300081633"
	 b:glossaryEntry="struck with fear, dread, or consternation"/>
<rdf:Description rdf:about="&a;300081762">
	<b:glossaryEntry>suffering from agoraphobia; abnormally afraid of open or public places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300081890"
	 b:glossaryEntry="experiencing a sudden sense of danger"/>
<rdf:Description rdf:about="&a;300081981"
	 b:glossaryEntry="suffering from algophobia; abnormally afraid of pain"/>
<rdf:Description rdf:about="&a;300082090">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in fear or dread of possible evil or harm; "apprehensive for one''s life"; "apprehensive of danger"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300082247"
	 b:glossaryEntry="frightened into submission or compliance"/>
<rdf:Description rdf:about="&a;300082386">
	<b:glossaryEntry>suffering from claustrophobia; abnormally afraid of closed-in places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300082515">
	<b:glossaryEntry>experiencing or showing fear; "a fearful glance"; "fearful of criticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300082641">
	<b:glossaryEntry>made afraid; "the frightened child cowered in the corner"; "too shocked and scared to move"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300082798"
	 b:glossaryEntry="stricken with horror"/>
<rdf:Description rdf:about="&a;300082908">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reflecting the fear or terror of one who is hunted; "the hopeless hunted look on the prisoner''s face"; "a glitter of apprehension in her hunted eyes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300083110"
	 b:glossaryEntry="abnormally afraid of water"/>
<rdf:Description rdf:about="&a;300083207">
	<b:glossaryEntry>suffering from mysophobia; abnormally afraid of dirt or contamination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300083333">
	<b:glossaryEntry>thrown into a state of intense fear or desperation; "became panicky as the snow deepened"; "felt panicked before each exam"; "trying to keep back the panic-stricken crowd"; "the terrified horse bolted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300083656">
	<b:glossaryEntry>so frightened as to be unable to move; stunned or paralyzed with terror; "petrified with fear"; "she was petrified by the eerie sound"; "too numb with fear to move"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300083883"
	 b:glossaryEntry='(obscene) extremely frightened; "he was scared shitless"'/>
<rdf:Description rdf:about="&a;300083994"
	 b:glossaryEntry="struck or filled with terror"/>
<rdf:Description rdf:about="&a;300084100">
	<b:glossaryEntry>suffering from triskaidekaphobia (abnormal fear of the number 13)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300084229">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deprived of courage and strength; "the steeplejack, exhausted and unnerved, couldn''t hold on to his dangerous perch much longer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300084412"
	 b:glossaryEntry="having white lips from fear or terror"/>
<rdf:Description rdf:about="&a;300084508">
	<b:glossaryEntry>suffering from xenophobia; having abnormal fear or hatred of the strange or foreign</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300084648">
	<b:glossaryEntry>oblivious of dangers or perils or calmly resolute in facing them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300084889"
	 b:glossaryEntry="not recognizing or slow to recognize danger"/>
<rdf:Description rdf:about="&a;300084993"
	 b:glossaryEntry="not shrinking from danger"/>
<rdf:Description rdf:about="&a;300085119"
	 b:glossaryEntry="not affected by fright"/>
<rdf:Description rdf:about="&a;300085200">
	<b:glossaryEntry>having or showing determination and energetic pursuit of your ends; "an aggressive businessman"; "an aggressive basketball player"; "he was aggressive and imperious; positive in his convictions"; "aggressive drivers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300085707">
	<b:glossaryEntry>confidently aggressive; "too assertive as a salesman"; "his self-assertive and unflagging energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300085894">
	<b:glossaryEntry>having or showing a ready disposition to fight; "bellicose young officers"; "a combative impulse"; "a contentious nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300086109">
	<b:glossaryEntry>showing a fighting disposition without self-seeking; "highly competitive sales representative"; "militant in fighting for better wages for workers"; "his self-assertive and ubiquitous energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300086369">
	<b:glossaryEntry>aggressively and persistently persuasive; "a hard-hitting advertising campaign"; "a high-pressure salesman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300086551">
	<b:glossaryEntry>(business) used of attempts to buy or take control of a business; "hostile takeover"; "hostile tender offer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300086713">
	<b:glossaryEntry>boisterously and noisily aggressive; "kept up an obstreperous clamor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300086841">
	<b:glossaryEntry>living by preying on other animals especially by catching living prey; "a predatory bird"; "the rapacious wolf"; "raptorial birds"; "ravening wolves"; "a vulturine taste for offal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300087136">
	<b:glossaryEntry>ready and able to resort to force or violence; "pugnacious spirits...lamented that there was so little prospect of an exhilarating disturbance"- Herman Melville; "they were rough and determined fighting men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300087408"
	 b:glossaryEntry='full of fighting spirit; "a scrappy admiral"'/>
<rdf:Description rdf:about="&a;300087506">
	<b:glossaryEntry>defiantly aggressive; "as truculent as a small boy who thinks his big brother can lick anybody"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300087657"
	 b:glossaryEntry="not aggressive; not given to fighting or assertiveness"/>
<rdf:Description rdf:about="&a;300087840">
	<b:glossaryEntry>not forceful; "a low-pressure salesman"; "a low-pressure campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300087965"
	 b:glossaryEntry='troubled emotionally and usually deeply; "agitated parents"'/>
<rdf:Description rdf:about="&a;300088349">
	<b:glossaryEntry>of persons; excessively affected by emotion; "he would become emotional over nothing at all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300088517">
	<b:glossaryEntry>resembling or suggesting possession by a demon; "demoniac energy"; "a demoniacal fit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300088670">
	<b:glossaryEntry>deeply agitated especially from emotion; "distraught with grief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300088805">
	<b:glossaryEntry>disturbed psychologically as if by a physical jolt or shock; "retrieved his named from her jolted memory"; "the accident left her badly shaken"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300089010">
	<b:glossaryEntry>marked by intense agitation or emotion; "worked at a feverish pace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300089141">
	<b:glossaryEntry>excessively agitated; transported with rage or other violent emotion; "frantic with anger and frustration"; "frenetic screams followed the accident"; "a frenzied look in his eye"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300089407">
	<b:glossaryEntry>marked by excessive or uncontrollable emotion; "hysterical laughter"; "a mob of hysterical vigilantes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300089566">
	<b:glossaryEntry>of a mental state characterized by intense and distorted perceptions and hallucinations and feelings of euphoria or sometimes despair; "a psychedelic experience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300089785">
	<b:glossaryEntry>appearing extremely agitated; "crowded the wild-eyed animals into a truck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300089915"
	 b:glossaryEntry="not agitated or disturbed emotionally"/>
<rdf:Description rdf:about="&a;300090149">
	<b:glossaryEntry>marked by freedom from agitation or excitement; "the rioters gradually became calm and slowly dispersed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300090304">
	<b:glossaryEntry>physically disturbed or set in motion; "the agitated mixture foamed and bubbled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300090583">
	<b:glossaryEntry>covered with or resembling small bubbles as from being agitated by beating or heating; "the bubbling candy mixture"; "a cup of foaming cocoa"; "frothy milkshakes"; "frothy waves"; "spumy surf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300090885">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of a liquid) agitated vigorously; in a state of turbulence; "the river''s roiling current"; "turbulent rapids"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300091089">
	<b:glossaryEntry>moving with or producing or produced by vigorous agitation; "winds whipped the piled leaves into churning masses"; "a car stuck in the churned-up mud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300091307"
	 b:glossaryEntry='bumped or shaken jerkily; "the jolted passengers"'/>
<rdf:Description rdf:about="&a;300091409">
	<b:glossaryEntry>shaken into waves or undulations as by wind; "the rippled surface of the pond"; "with ruffled flags flying"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300091580">
	<b:glossaryEntry>in constant agitation; "a seething flag-waving crowd filled the streets"; "a seething mass of maggots"; "lovers and madmen have such seething brains"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300091797"
	 b:glossaryEntry="set into a usually circular motion in order to mix or blend"/>
<rdf:Description rdf:about="&a;300091910"
	 b:glossaryEntry="not physically disturbed or set in motion"/>
<rdf:Description rdf:about="&a;300092058"
	 b:glossaryEntry='(of a liquid) not turbulent; "nonturbulent flow"'/>
<rdf:Description rdf:about="&a;300092165">
	<b:glossaryEntry>not agitated by stirring; "the ingredients sat in the bowl unstirred while she buttered the pan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300092317">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to your own liking or feelings or nature; "Is the plan agreeable to you?"; "he''s an agreeable fellow"; "My idea of an agreeable person...is a person who agrees with me"- Disraeli; "an agreeable manner"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300092592">
	<b:glossaryEntry>not to your liking; "a most disagreeable journey"; "a disagreeable old man"; "in a disagreeable mood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300092842">
	<b:glossaryEntry>causing irritation or annoyance; "tapping an annoying rhythm on his glass with his fork"; "aircraft noise is particularly bothersome near the airport"; "found it galling to have to ask permission"; "an irritating delay"; "nettlesome paperwork"; "a pesky mosquito"; "swarms of pestering gnats"; "a plaguey newfangled safety catch"; "a teasing and persistent thought annoyed him"; "a vexatious child"; "it is vexing to have to admit you are wrong"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300093475">
	<b:glossaryEntry>sharply disagreeable; rigorous; "the harsh facts of court delays"; "an abrasive character"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300093628">
	<b:glossaryEntry>extremely irritating to the nerves; "nerve-racking noise"; "the stressful days before a war"; "a trying day at the office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300093848"
	 b:glossaryEntry='distasteful; "he found life unsweet"'/>
<rdf:Description rdf:about="&a;300093938">
	<b:glossaryEntry>operating from or designed to be fired from aircraft at targets on the ground; "air-to-surface missiles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300094137">
	<b:glossaryEntry>operating between or launched from or involving rockets or aircraft in flight; "air-to-air missiles"; "air-to-air communications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300094341">
	<b:glossaryEntry>operating from or designed to be launched from the ground against an airborne target; "surface-to-air missiles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300094531">
	<b:glossaryEntry>very attentive or observant; "an alert and responsive baby is a joy"; "caught by a couple of alert cops"; "alert enough to spot the opportunity when it came"; "constantly alert and vigilant, like a sentinel on duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300094960">
	<b:glossaryEntry>carefully observant or attentive; on the lookout for possible danger; "a policy of open-eyed awareness"; "the vigilant eye of the town watch"; "there was a watchful dignity in the room"; "a watchful parent with a toddler in tow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300095289"
	 b:glossaryEntry="(British informal) not to be deceived or hoodwinked"/>
<rdf:Description rdf:about="&a;300095390"
	 b:glossaryEntry='fully alert and watchful; "played heads-up ball"'/>
<rdf:Description rdf:about="&a;300095506">
	<b:glossaryEntry>without having the eyes closed or covered by the eyelids; "to an eye like mine, a lidless watcher of the public weal"- Alfred Tennyson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300095706">
	<b:glossaryEntry>watchful and prepared for action; "bird watchers on the alert for a rare species"; "cops were on the job and caught them red-handed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300095916">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(especially of ears) quickly lifted up or out in attention; `perched'' is obsolete; "a dog with perked ears"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300096098"
	 b:glossaryEntry="not alert or attentive"/>
<rdf:Description rdf:about="&a;300096210"
	 b:glossaryEntry="not paying attention"/>
<rdf:Description rdf:about="&a;300096328">
	<b:glossaryEntry>of or relating to or having the characteristics of an algorithm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300096467"
	 b:glossaryEntry="of or relating to a recursion"/>
<rdf:Description rdf:about="&a;300096552">
	<b:glossaryEntry>ofo or relating to a general formulation that serves to guide investigation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300096701">
	<b:glossaryEntry>relating to solving problems by experience rather than theory; "they adopted a trial-and-error procedure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300096868"
	 b:glossaryEntry="(law) transferable to another owner"/>
<rdf:Description rdf:about="&a;300096995"
	 b:glossaryEntry='that can be appropriated; "appropriable funds"'/>
<rdf:Description rdf:about="&a;300097100">
	<b:glossaryEntry>legally transferable to the ownership of another; "negotiable bonds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300097282">
	<b:glossaryEntry>incapable of being repudiated or transferred to another; "endowed by their Creator with certain unalienable rights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300097523">
	<b:glossaryEntry>not capable of being violated or infringed; "infrangible human rights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300097675"
	 b:glossaryEntry="incapable of being transferred"/>
<rdf:Description rdf:about="&a;300097799">
	<b:glossaryEntry>possessing life; "the happiest person alive"; "the nerve is alive"; "doctors are working hard to keep him alive"; "burned alive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300098090">
	<b:glossaryEntry>having life; "a live canary"; "hit a live nerve"; "famous living painters"; "living tissue"; "living plants and animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300098270">
	<b:glossaryEntry>capable of life or normal growth and development; "viable seeds"; "a viable fetus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300098405">
	<b:glossaryEntry>existing as a manifestation of life; "vital powers"; "eating to maintain vital energy"; "recognizing no mystic vital force"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300098580">
	<b:glossaryEntry>no longer having or seeming to have or expecting to have life; "the nerve is dead"; "a dead pallor"; "he was marked as a dead man by the assassin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300099137"
	 b:glossaryEntry='(euphemistic) "he is deceased"; "our dear departed friend"'/>
<rdf:Description rdf:about="&a;300099307">
	<b:glossaryEntry>murdered by surprise attack for political reasons; "the 20th century has een too many assassinated leaders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300099473">
	<b:glossaryEntry>destitute of blood or apparently so; "the bloodless carcass of my Hector sold"- John Dryden</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300099620">
	<b:glossaryEntry>having irreversible loss of brain function as indicated by a persistent flat electroencephalogram; "was declared brain dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300099801">
	<b:glossaryEntry>appearing dead; not breathing or having no perceptible pulse; "an inanimate body"; "pulseless and dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300099985"
	 b:glossaryEntry='lacking the warmth of life; "cold in his grave"'/>
<rdf:Description rdf:about="&a;300100083"
	 b:glossaryEntry='having the physical appearance of death; "a deathly pallor"'/>
<rdf:Description rdf:about="&a;300100208">
	<b:glossaryEntry>having ceased to exist or live; "the will of a defunct aunt"; "a defunct Indian tribe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300100348">
	<b:glossaryEntry>marked for certain death; "the black spot told the old sailor he was doomed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300100477">
	<b:glossaryEntry>put to death as punishment; "claimed the body of the executed traitor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300100602"
	 b:glossaryEntry='killed in battle; "to honor fallen soldiers"'/>
<rdf:Description rdf:about="&a;300100699"
	 b:glossaryEntry='having died recently; "her late husband"'/>
<rdf:Description rdf:about="&a;300100793"
	 b:glossaryEntry='deprived of life; no longer living; "a lifeless body"'/>
<rdf:Description rdf:about="&a;300100913">
	<b:glossaryEntry xml:space='preserve'><![CDATA[killed unlawfully; "the murdered woman"; "lay a wreath on murdered Lincoln''s bier"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300101050"
	 b:glossaryEntry="not capable of living or developing successfully"/>
<rdf:Description rdf:about="&a;300101154">
	<b:glossaryEntry xml:space='preserve'><![CDATA[killed; `slain'' is formal or literary as in "slain warriors"; "a picture of St. George and the slain dragon"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300101314"
	 b:glossaryEntry='dead at birth; "a stillborn baby"'/>
<rdf:Description rdf:about="&a;300101403"
	 b:glossaryEntry="as lifeless as a stone"/>
<rdf:Description rdf:about="&a;300101482">
	<b:glossaryEntry xml:space='preserve'><![CDATA[producing a secretion in which part of the secreting cell is released with the secretion; "mother''s milk is one apocrine secretion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300101668">
	<b:glossaryEntry>producing a clear aqueous secretion without releasing part of the secreting cell; important in regulating body temperature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300101844">
	<b:glossaryEntry>(of water) rising to the surface under internal hydrostatic pressure; "an artesian well"; "artesian pressure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300102018">
	<b:glossaryEntry>(of water) rising naturally in a well to a height appreciably above that of the surrounding water table but not flowing out of the well</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300102211">
	<b:glossaryEntry>showing characteristics of life; exerting force or containing energy; "live coals"; "tossd a live cigarette out the window"; "got a shock from a live wire"; "live ore is unmined ore"; "a live bomb"; "a live ball is one in play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300102579"
	 b:glossaryEntry='burning steadily without flames; "glowing coals"'/>
<rdf:Description rdf:about="&a;300102684"
	 b:glossaryEntry='(sports) of a ball; "the ball is still in play"'/>
<rdf:Description rdf:about="&a;300102788">
	<b:glossaryEntry>(used of minerals or stone) in its natural state and place; not mined or quarried; "carved into the living stone";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300102958"
	 b:glossaryEntry='full of life and interest; "made history a living subject"'/>
<rdf:Description rdf:about="&a;300103072"
	 b:glossaryEntry='burning slowly without flame; "smoldering embers"'/>
<rdf:Description rdf:about="&a;300103192">
	<b:glossaryEntry>not showing characteristics of life especially the capacity to sustain life; no longer exerting force or having energy or heat; "Mars is a dead planet"; "a dead battery"; "dead soil"; "dead coals"; "the fire is dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300103531"
	 b:glossaryEntry='incapable of sustaining life; "the dead and barren Moon"'/>
<rdf:Description rdf:about="&a;300103640">
	<b:glossaryEntry>of a fire; being out or having grown cold; "threw his extinct cigarette into the stream"; "faint smoke from the extinguished candle"; "the fire is out"; "the quenched flames"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300103903"
	 b:glossaryEntry='not having the capacity to support life; "a lifeless planet"'/>
<rdf:Description rdf:about="&a;300104018"
	 b:glossaryEntry='(sports) of a ball; "a ball that is out of play is dead"'/>
<rdf:Description rdf:about="&a;300104135">
	<b:glossaryEntry>arranged in order according to the alphabet; "an alphabetic arrangement"; "dictionaries list words in alphabetical order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300104364"
	 b:glossaryEntry="alphabetically arranged"/>
<rdf:Description rdf:about="&a;300104445">
	<b:glossaryEntry>having been put in alphabetical order; "the cards are all alphabetized, as you requested"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300104593">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not alphabetic; "an analphabetic arrangement of letters"; "Jesperson''s system of phonetic transcription is analphabetic"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300104772">
	<b:glossaryEntry>(of hatchlings) naked and blind and dependent on parents for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300104893">
	<b:glossaryEntry>(of hatchlings) covered with down and having eyes open; capable of leaving the nest within a few days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300105050"
	 b:glossaryEntry="showing unselfish concern for the welfare of others"/>
<rdf:Description rdf:about="&a;300105187"
	 b:glossaryEntry="of or relating to the self"/>
<rdf:Description rdf:about="&a;300105322"
	 b:glossaryEntry="limited to or caring only about yourself and your own needs"/>
<rdf:Description rdf:about="&a;300105482"
	 b:glossaryEntry="absorbed in your own interests or thoughts etc"/>
<rdf:Description rdf:about="&a;300105604">
	<b:glossaryEntry>having more than one possible meaning; "ambiguous words"; "frustrated by ambiguous instructions, the parents were unable to assemble the toy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300105963">
	<b:glossaryEntry>having two purposes; twofold; "our double-barreled desire to make things profitable as well as attractive"- Louis Kronenbergers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300106171">
	<b:glossaryEntry>capable of being interpreted in two usually contradictory ways; "double-edged praise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300106315">
	<b:glossaryEntry>resembling an oracle in obscurity of thought; "the oracular sayings of Victorian poets"; "so obscure that priests might have to clarify it"; "an enigmatic smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300106543"
	 b:glossaryEntry='ironically ambiguous; "a left-handed compliment"'/>
<rdf:Description rdf:about="&a;300106649">
	<b:glossaryEntry>having many values, meanings, or appeals; "subtle, multivalent allegory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300106794"
	 b:glossaryEntry="of words; having many meanings"/>
<rdf:Description rdf:about="&a;300106881">
	<b:glossaryEntry>especially in the negative "no uncertain," as in "spoke in no uncertain terms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300107015">
	<b:glossaryEntry>having or exhibiting a single clearly defined meaning; "As a horror, apartheid...is absolutely unambiguous"- Mario Vargas Llosa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300107254"
	 b:glossaryEntry="having only one meaning"/>
<rdf:Description rdf:about="&a;300107334"
	 b:glossaryEntry="having a strong desire for success or achievement"/>
<rdf:Description rdf:about="&a;300107565">
	<b:glossaryEntry>marked by aggressive ambition and energy and initiative; "an aggressive young exective"; "a pushful insurance agent"; "a pushing youth intent on getting on in the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300107834"
	 b:glossaryEntry="desiring or striving for recognition or advancement"/>
<rdf:Description rdf:about="&a;300107954"
	 b:glossaryEntry="strongly motivated to succeed"/>
<rdf:Description rdf:about="&a;300108062"
	 b:glossaryEntry="unfilled or frustrated in realizing an ambition"/>
<rdf:Description rdf:about="&a;300108176"
	 b:glossaryEntry="excessively ambitious"/>
<rdf:Description rdf:about="&a;300108257"
	 b:glossaryEntry="having little desire for success or achievement"/>
<rdf:Description rdf:about="&a;300108431">
	<b:glossaryEntry>lacking or characterized by lack of ambition or initiative; lazy; "a shiftless student"; "studied in a shiftless way"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300108604">
	<b:glossaryEntry>more than enough in size or scope or capacity; "had ample food for the party"; "an ample supply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300108860">
	<b:glossaryEntry>having the normally expected amount; "gives full measure"; "gives good measure"; "a good mile from here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300109022"
	 b:glossaryEntry='more than adequate; "a generous portion"'/>
<rdf:Description rdf:about="&a;300109117">
	<b:glossaryEntry>having ample fabric; "the current taste for wide trousers"; "a full skirt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300109260">
	<b:glossaryEntry>deficient in amount or quality or extent; "meager resources"; "meager fare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300109552">
	<b:glossaryEntry>lacking in amplitude or quantity; "a bare livelihood"; "a scanty harvest"; "a spare diet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300109712"
	 b:glossaryEntry='extremely scanty; "a meager income"; "an exiguous budget"'/>
<rdf:Description rdf:about="&a;300109824"
	 b:glossaryEntry='providing only bare essentials; "a hand-to-mouth existence"'/>
<rdf:Description rdf:about="&a;300109946">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a bare living gained by great labor; "the sharecropper''s hardscrabble life"; "a marginal existence"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300110118">
	<b:glossaryEntry>contemptibly small in amount; "a measly tip"; "the company donated a miserable $100 for flood relief"; "a paltry wage"; "almost depleted his miserable store of dried beans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300110364">
	<b:glossaryEntry>of the nature of or characteristic of or derived from an animal or animals; "the animal kingdom"; "animal instincts"; "animal fats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300110602">
	<b:glossaryEntry>resembling or having characteristics of an animal; "dull animallike eyes"; "an animallike obstinacy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300110759"
	 b:glossaryEntry='resembling a fish; "an extinct fishlike vertebrate"'/>
<rdf:Description rdf:about="&a;300110865">
	<b:glossaryEntry>of the nature of or characteristic of or derived from plants; "decaying vegetable matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300111046">
	<b:glossaryEntry>composed of vegetation or plants; "regions rich in vegetal products; "vegetational cover"; "the decaying vegetative layer covering a forest floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300111274">
	<b:glossaryEntry>of or containing or derived from minerals; "a mineral deposit"; "mineral water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300111479"
	 b:glossaryEntry='containing asphalt; "asphaltic residues"'/>
<rdf:Description rdf:about="&a;300111575">
	<b:glossaryEntry>containing or impregnated with minerals; "mineralized water"; "red stains that signify mineralized land"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300111737"
	 b:glossaryEntry='converted into a mineral; "petrified wood"'/>
<rdf:Description rdf:about="&a;300111849">
	<b:glossaryEntry>characterized by or promoting constructive metabolism; "some athletes take anabolic steroids to increase muscle size temporarily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300112051"
	 b:glossaryEntry="of or relating to anabolism"/>
<rdf:Description rdf:about="&a;300112170"
	 b:glossaryEntry="characterized by destructive metabolism"/>
<rdf:Description rdf:about="&a;300112295"
	 b:glossaryEntry="of or relating to catabolism"/>
<rdf:Description rdf:about="&a;300112416">
	<b:glossaryEntry>(geology) of valleys and rivers; progressing in a direction opposite to the dip in surrounding rock strata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300112578">
	<b:glossaryEntry>(geology) of valleys and rivers; running in the direction of the dip in surrounding rock strata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300112730"
	 b:glossaryEntry="(geology) sloping downward away from a common crest"/>
<rdf:Description rdf:about="&a;300112838">
	<b:glossaryEntry>(geology) sloping downward toward each other to create a trough</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300112957"
	 b:glossaryEntry="migrating from the sea to fresh water to spawn"/>
<rdf:Description rdf:about="&a;300113078"
	 b:glossaryEntry="migrating from fresh water to the sea to spawn"/>
<rdf:Description rdf:about="&a;300113200"
	 b:glossaryEntry="(used of fish) migratory between fresh and salt waters"/>
<rdf:Description rdf:about="&a;300113329">
	<b:glossaryEntry>(meteorology) of an air current or wind; rising especially up a slope; "an anabatic wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300113473">
	<b:glossaryEntry>(meteorology) of an air current or wind; moving downward or down a slope because of cooling especially at night</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300113640">
	<b:glossaryEntry>(psychoanalysis) a stage in psychosexual development when the child''s interest is concentrated on the anal region; fixation at this stage is said to result in orderliness, meanness, stubbornness, compulsiveness, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300113907">
	<b:glossaryEntry>(psychoanalysis) a stage in psychosexual development when the child''s interest is concentrated in the mouth; fixation at this stage is said to result in dependence, selfishness, and aggression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300114150">
	<b:glossaryEntry>(electronics) of a circuit or device having an output that is proportional to the input; "analogue device"; "linear amplifier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300114349">
	<b:glossaryEntry>(electronics) of a circuit or device that represents magnitudes in digits; "digital computer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300114496">
	<b:glossaryEntry>(logic) of a proposition; necessarily true independent of fact or experience, as "all spinsters are unmarried"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300114728">
	<b:glossaryEntry>(logic) of a proposition; having a truth value determined by observation or facts, as "all men are arrogant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300114960">
	<b:glossaryEntry>(linguistics) expressing a grammatical category by using two or more words rather than inflection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300115144">
	<b:glossaryEntry>relating to or being a language in which each word typically expresses a distinct idea and part of speech and syntactical relations are determined almost exclusively by word order and particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300115396">
	<b:glossaryEntry>(linguistics) systematic combining of root and modifying elements into single words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300115571">
	<b:glossaryEntry>forming derivative or compound words by putting together constituents each of which expresses a single definite meaning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300115781">
	<b:glossaryEntry>expressing grammatical relations by means of affixes or changes in vowels or consonants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300115939">
	<b:glossaryEntry>using or skilled in using analysis (i.e., separating a whole--intellectual or substantial--into its elemental parts or basic principles); "an analytic experiment"; "an analytic approach"; "a keenly analytic man"; "analytical reasoning"; "an analytical mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300116264">
	<b:glossaryEntry>involving or of the nature of synthesis (combining separate elements to form a coherent whole) as opposed to analysis; "limnology is essentially a synthetic science composed of elements...that extend well beyond the limits of biology"- P.S.Welch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300116579">
	<b:glossaryEntry>characterized by inflections indicating grammatical distinctions; "inflectional morphology is used to indicate number and case and tense and person etc."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300116791">
	<b:glossaryEntry xml:space='preserve'><![CDATA[characterized by inflections indicating a semantic relation between a word and its base; "the morphological relation between `sing'' and `singer'' and `song'' is derivational"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300117022">
	<b:glossaryEntry>(of ovaries of flowering plants) consisting of carpels that are free from one another as in buttercups or roses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300117190">
	<b:glossaryEntry>(of ovaries of flowering plants) consisting of united carpels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300117308">
	<b:glossaryEntry>feeling or showing anger; "angry at the weather"; "angry customers"; "an angry silence"; "sending angry letters to the papers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300117684">
	<b:glossaryEntry>incited, especially deliberately, to anger; "aggravated by passive resistance"; "the provoked animal attacked the child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300117872">
	<b:glossaryEntry>marked by extreme anger; "the enraged bull attached"; "furious about the accident"; "a furious scowl"; "infuriated onlookers charged the police who were beating the boy"; "could not control the maddened crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300118179">
	<b:glossaryEntry>marked by anger or resentment or hostility; "black looks"; "black words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300118303">
	<b:glossaryEntry>characterized by anger; "a choleric outburst"; "an irascible response"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300118440"
	 b:glossaryEntry="(informal) very angry"/>
<rdf:Description rdf:about="&a;300118531">
	<b:glossaryEntry>(informal) roused to anger; "stayed huffy a good while"- Mark Twain; "she gets mad when you wake her up so early"; "mad at his friend"; "sore over a remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300118752">
	<b:glossaryEntry xml:space='preserve'><![CDATA[angered at something unjust or wrong; "an indignant denial"; "incensed at the judges'' unfairness"; "a look of outraged disbelief"; "umbrageous at the loss of their territory"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300119017">
	<b:glossaryEntry>feeling or showing extreme anger; "irate protesters"; "ireful words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300119146">
	<b:glossaryEntry>(informal) furiously angry; "willful stupidity makes him absolutely livid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300119272">
	<b:glossaryEntry>showing scarcely suppressed anger; "her tone was...conversational although...her eyes were smoldering"- James Hensel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300119459">
	<b:glossaryEntry>vehemently incensed and condemnatory; "they trembled before the wrathful queen"; "but wroth as he was, a short struggle ended in reconciliation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300119677"
	 b:glossaryEntry="not angry"/>
<rdf:Description rdf:about="&a;300119743">
	<b:glossaryEntry>full of or marked by resentment or indignant ill will; "resentful at the way he was treated"; "a sullen resentful attitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300119958">
	<b:glossaryEntry>marked by strong resentment or cynicism; "an acrimonious dispute"; "bitter about the divorce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300120118">
	<b:glossaryEntry>showing deep-seated resentment; "preserve...from rancourous envy of the rich"- Aldous Huxley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300120279"
	 b:glossaryEntry='not resentful; "completely unresentful and forgiving"'/>
<rdf:Description rdf:about="&a;300120408">
	<b:glossaryEntry>having or showing no resentment or desire for revenge; "remarkably unbitter toward her captors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300120558">
	<b:glossaryEntry xml:space='preserve'><![CDATA[endowed with feeling and unstructured consciousness; "the living knew themselves just sentient puppets on God''s stage"- T.E.Lawrence]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300120791"
	 b:glossaryEntry='having physical sensation; "sensate creatures"'/>
<rdf:Description rdf:about="&a;300120891">
	<b:glossaryEntry>devoid of feeling and consciousness and animation; "insentient (or insensate) stone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300121080"
	 b:glossaryEntry='devoid of feeling or sensation; "unfeeling trees"'/>
<rdf:Description rdf:about="&a;300121185">
	<b:glossaryEntry>endowed with animal life as distinguished from plant life; "we are animate beings"; "living creatures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300121377">
	<b:glossaryEntry>having or characterized by life; "a vital being"; "the population of the vital teeming slums"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300121522">
	<b:glossaryEntry>not endowed with life; "the inorganic world is inanimate"; "inanimate objects"; "dead stones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300121726"
	 b:glossaryEntry="relating to the lack of consciousness of inanimate things"/>
<rdf:Description rdf:about="&a;300121842">
	<b:glossaryEntry>having life or vigor or spirit; "an animated and expressive face"; "animated conversation"; "became very animated when he heard the good news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300122101">
	<b:glossaryEntry>made lively or spirited; "a meal enlivened by the music"; "a spirited debate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300122245">
	<b:glossaryEntry>full of spirit; "a vital and charismatic leader"; "this whole vital world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300122395">
	<b:glossaryEntry>given fresh life or vigor or spirit; "stirred by revived hopes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300122525"
	 b:glossaryEntry="not animated or enlivened; dull"/>
<rdf:Description rdf:about="&a;300122649">
	<b:glossaryEntry>lacking animation or excitement or activity; "the party being dead we left early"; "it was a lifeless party until she arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300122837">
	<b:glossaryEntry>lacking vitality as from weariness or illness or unhappiness; "a wan smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300122962"
	 b:glossaryEntry="made sprightly or cheerful"/>
<rdf:Description rdf:about="&a;300123080">
	<b:glossaryEntry>made or become more cheerful or lively; "his attention made her feel all perked up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300123219">
	<b:glossaryEntry>not made lively or brightened; "a life unenlivened by romance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300123339">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(linguistics) belonging to the class of nouns that denote living beings; "the word `dog'' is animate"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300123493">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(linguistics) belonging to the class of nouns denoting nonliving things; "the word `car'' is inanimate"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300123651">
	<b:glossaryEntry>having no known name or identity or known source; "anonymous authors"; "anonymous donors"; "an anonymous gift"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300123835">
	<b:glossaryEntry>being or having an unknown or unnamed source; "a poem by an unknown author"; "corporations responsible to nameless owners"; "an unnamed donor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300124067"
	 b:glossaryEntry='bearing a name; "articles in magazines are usually onymous"'/>
<rdf:Description rdf:about="&a;300124216">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bearing the author''s name; "a named source"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300124311">
	<b:glossaryEntry>bearing or identified by an assumed (often pen) name; "the writings of Mark Twain are pseudonymous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300124469"
	 b:glossaryEntry='preceding death; "antemortem confession"'/>
<rdf:Description rdf:about="&a;300124566">
	<b:glossaryEntry>occurring or done after death; "postmortem changes"; "a postmortem examination to determine cause of death"; "postmortal wounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300124764"
	 b:glossaryEntry="preceding in time or order"/>
<rdf:Description rdf:about="&a;300124949">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) prior to or before in time; "`ante'' is a prefix in the word `antenatal''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300125081"
	 b:glossaryEntry="earlier in time"/>
<rdf:Description rdf:about="&a;300125162"
	 b:glossaryEntry="in anticipation"/>
<rdf:Description rdf:about="&a;300125249"
	 b:glossaryEntry="existing previously or before something"/>
<rdf:Description rdf:about="&a;300125346"
	 b:glossaryEntry='following in time or order; "subsequent developments"'/>
<rdf:Description rdf:about="&a;300125510">
	<b:glossaryEntry>following as an effect or result; "the period of tension and consequent need for military preparedness"; "the ensuant response to his appeal"; "the resultant savings were considerable"; "the health of the plants and the resulting flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300125852">
	<b:glossaryEntry>coming at a subsequent time or stage; "the future president entered college at the age of 16"; "awaiting future actions on the bill"; "later developments"; "without ulterior argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300126113">
	<b:glossaryEntry>(biology) bent or curved forward or upward; "a plant having antrorse hairs on the stem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300126255">
	<b:glossaryEntry>(biology) bent or curved backward or downward; "leaves with retrorse barbs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300126403">
	<b:glossaryEntry>bend down or curved downward; "the decurved bill of a curlew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300126519">
	<b:glossaryEntry>operating or living or growing in water; "boats are aquatic vehicles"; "water lilies are aquatic plants"; "fish are aquatic animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300126777">
	<b:glossaryEntry>native to or inhabiting the sea; "marine plants and animals such as seaweed and whales"; "saltwater fish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300126947">
	<b:glossaryEntry>(biology) partially aquatic; living or growing partly on land and partly in water; "a marginal subaquatic flora"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300127130">
	<b:glossaryEntry>(biology) growing or remaining under water; "viewing subaqueous fauna from a glass-bottomed boat"; "submerged leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300127354"
	 b:glossaryEntry="operating or living or growing on land"/>
<rdf:Description rdf:about="&a;300127478">
	<b:glossaryEntry>operating or living on land and in water; "amphibious vehicles"; "amphibious operations"; "amphibious troops"; "frogs are amphibious animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300127713">
	<b:glossaryEntry>(biology) having an aquatic early or larval form and a terrestrial adult form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300127862"
	 b:glossaryEntry="existing or coming before"/>
<rdf:Description rdf:about="&a;300128180">
	<b:glossaryEntry>appearing earlier in the same text; "flaws in the above interpretation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300128303"
	 b:glossaryEntry="mentioned or named earlier in the same text"/>
<rdf:Description rdf:about="&a;300128422"
	 b:glossaryEntry="especially of writing or speech; going before"/>
<rdf:Description rdf:about="&a;300128526"
	 b:glossaryEntry="serving as an introduction or preface"/>
<rdf:Description rdf:about="&a;300128648">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) coming before or being preliminary or preparatory; "`pre'' is a prefix in `prehistoric'' and `premedical'' and `prepaid''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300128825"
	 b:glossaryEntry="preceding in time, order, or significance"/>
<rdf:Description rdf:about="&a;300128922">
	<b:glossaryEntry>preceding and preparing for the study of medicine; "premedical courses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300129050"
	 b:glossaryEntry='preceding and preparing for something; "preparatory steps"'/>
<rdf:Description rdf:about="&a;300129180">
	<b:glossaryEntry>preceding an official trial; "pretrial publicity"; "pretrial hearings are usually for the purpose of clarifying facts and points of la"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300129370">
	<b:glossaryEntry>just preceding something else in time or order; "the previous owner"; "my old house was larger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300129529"
	 b:glossaryEntry="coming after or following"/>
<rdf:Description rdf:about="&a;300129812">
	<b:glossaryEntry>concerned with designed for use after skiing; "apres-ski wear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300129930"
	 b:glossaryEntry='one after the other; "back-to-back home runs"'/>
<rdf:Description rdf:about="&a;300130048">
	<b:glossaryEntry>following immediately and as a result of what went before; "ensuing events confirmed the prediction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300130202"
	 b:glossaryEntry='about to be mentioned or specified; "the following items'/>
<rdf:Description rdf:about="&a;300130334">
	<b:glossaryEntry>immediately following in time or order; "the following day"; "next in line"; "the next president"; "the next item on the list"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300130523">
	<b:glossaryEntry>being next in a line of succession; "he was in line for the presidency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300130648">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) coming after; "`post'' is a prefix in `postmillenial'' and `postgraduate''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300130780">
	<b:glossaryEntry xml:space='preserve'><![CDATA[after death or after an event; "a postmortem examination to determine the cause of death"; "the postmortem discussion of the President''s TV address"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300130985"
	 b:glossaryEntry="having or supported or justified by a precedent"/>
<rdf:Description rdf:about="&a;300131090">
	<b:glossaryEntry>having no precedent; novel; "an unprecedented expansion in population and industry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300131251">
	<b:glossaryEntry>having no previous example or precedent or parallel; "a time of unexampled prosperity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300131400">
	<b:glossaryEntry xml:space='preserve'><![CDATA[adapted for grasping especially by wrapping around an object; "a monkey''s prehensile tail"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300131547"
	 b:glossaryEntry="not prehensile"/>
<rdf:Description rdf:about="&a;300131621">
	<b:glossaryEntry>occurring or existing before birth; "the prenatal period"; "antenatal care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300131781">
	<b:glossaryEntry>occurring during the period around birth (5 months before and 1 month after); "perinatal mortality"; "perinatal care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300131972"
	 b:glossaryEntry='occurring immediately after birth; "postnatal development"'/>
<rdf:Description rdf:about="&a;300132104"
	 b:glossaryEntry='preceding a meal (especially dinner); "a preprandial drink"'/>
<rdf:Description rdf:about="&a;300132221">
	<b:glossaryEntry>following a meal (especially dinner); "his postprandial cigar"; "took a postprandial walk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300132370">
	<b:glossaryEntry>existing or belonging to a time before a war; "prewar levels of industrial production"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300132509">
	<b:glossaryEntry>belonging to the period after a war; "postwar resettlement"; "postwar inflation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300132643"
	 b:glossaryEntry="of amnesia; affecting time immediately preceding trauma"/>
<rdf:Description rdf:about="&a;300132773"
	 b:glossaryEntry="of amnesia; affecting time immediately following trauma"/>
<rdf:Description rdf:about="&a;300132904"
	 b:glossaryEntry="before noon"/>
<rdf:Description rdf:about="&a;300133028"
	 b:glossaryEntry="before noon"/>
<rdf:Description rdf:about="&a;300133104"
	 b:glossaryEntry='in the morning; "the morning hours"'/>
<rdf:Description rdf:about="&a;300133196"
	 b:glossaryEntry="after noon"/>
<rdf:Description rdf:about="&a;300133319"
	 b:glossaryEntry="after noon"/>
<rdf:Description rdf:about="&a;300133394"
	 b:glossaryEntry='in the afternoon; "the afternoon hours"'/>
<rdf:Description rdf:about="&a;300133492">
	<b:glossaryEntry>(zoology) of or near the head end or toward the front plane of the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300133726"
	 b:glossaryEntry="located anteriorly"/>
<rdf:Description rdf:about="&a;300133809"
	 b:glossaryEntry='belonging to the front part; "a frontal appendage"'/>
<rdf:Description rdf:about="&a;300133913">
	<b:glossaryEntry>of or adjacent to the forehead or frontal bone; "the frontal lobes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300134034">
	<b:glossaryEntry>anterior to a frontal structure; "a prefrontal bone"; "prefrontal lobes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300134163">
	<b:glossaryEntry>(zoology) at or near the hind end in quadrupeds or toward the spine in primates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300134388">
	<b:glossaryEntry>located at or near the back of an animal; "back (or hind) legs"; "the hinder part of a carcass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300134559">
	<b:glossaryEntry>(of quadrupeds) situated in or directed toward the part of the body from which the tail arises; "caudal fins"; "the caudal end of the body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300134751"
	 b:glossaryEntry="at or near or toward the posterior"/>
<rdf:Description rdf:about="&a;300134838">
	<b:glossaryEntry>belonging to or on or near the back or upper surface of an animal or organ or part; "the dorsal fin is the vertical fin on the back of a fish and certain marine mammals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300135060">
	<b:glossaryEntry>toward or on or near the belly (front of a primate or lower surface of a lower animal); "the ventral aspect of the human body"; "the liver is somewhat ventral in position"; "ventral (or pelvic) fins correspond to the hind limbs of a quadruped"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300135375"
	 b:glossaryEntry="extending from the back to the belly"/>
<rdf:Description rdf:about="&a;300135470">
	<b:glossaryEntry>capable of being appealed especially to a higher tribunal; "decisions...appealable to the head of the agency"- New Republic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300135650">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not subject to appeal; "the judge''s ruling was handed down in a preliminary hearing rather than a trial and was therefore unappealable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300135844"
	 b:glossaryEntry="having an appendage"/>
<rdf:Description rdf:about="&a;300135920"
	 b:glossaryEntry="not having an appendage"/>
<rdf:Description rdf:about="&a;300136002">
	<b:glossaryEntry>appealing to or stimulating the appetite especially in appearance or aroma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300136205"
	 b:glossaryEntry="pleasing to the sense of taste"/>
<rdf:Description rdf:about="&a;300136323"
	 b:glossaryEntry="not appetizing in appearance, aroma, or taste"/>
<rdf:Description rdf:about="&a;300136499"
	 b:glossaryEntry="not pleasing to the sense of taste"/>
<rdf:Description rdf:about="&a;300136599">
	<b:glossaryEntry>easy to meet or converse or do business with; "a friendly approachable person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300136754">
	<b:glossaryEntry>easy to get along with or talk to; friendly; "an accessible and genial man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300136886">
	<b:glossaryEntry>discouraging intimacies; reserved; "an unapproachable executive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300137029"
	 b:glossaryEntry='lacking cordiality; unfriendly; "a standoffish manner"'/>
<rdf:Description rdf:about="&a;300137150">
	<b:glossaryEntry>suitable for a particular person or place or condition etc; "a book not appropriate for children"; "a funeral conducted the appropriate solemnity"; "it seems that an apology is appropriate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300137541"
	 b:glossaryEntry='appropriate to; "behavior befitting a father"'/>
<rdf:Description rdf:about="&a;300137642">
	<b:glossaryEntry>reasonable in the circumstances; "gave my comments due consideration"; "exercising due care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300137784">
	<b:glossaryEntry>appropriate or even needed in the circumstances; "a change is in order"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300137926"
	 b:glossaryEntry='exactly suited to the occasion; "a pat reply"'/>
<rdf:Description rdf:about="&a;300138021">
	<b:glossaryEntry>appropriate for a condition or occasion; "everything in its proper place"; "the right man for the job"; "she is not suitable for the position"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300138235">
	<b:glossaryEntry>not suitable for a particular occasion etc; "noise seems inappropriate at a time of sadness"; "inappropriate shoes for a walk on the beach"; "put inappropriate pressure on them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300138562"
	 b:glossaryEntry='not befitting; "behavior unbefitting a father"'/>
<rdf:Description rdf:about="&a;300138666">
	<b:glossaryEntry>not appropriate for a purpose or occasion; "unsuitable attire for the office"; "said all the wrong things"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300138848"
	 b:glossaryEntry='owed and payable immediately or on demand; "payment is due"'/>
<rdf:Description rdf:about="&a;300139090">
	<b:glossaryEntry>subject to a demand for payment before due date; "callable bonds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300139210">
	<b:glossaryEntry>payment due by the recipient on delivery; "a collect call"; "the letter came collect"; "a COD parcel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300139371">
	<b:glossaryEntry>subject to or requiring payment especially as specified; "a collectible bill"; "a note payable on demand"; "a check payable to John Doe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300139589">
	<b:glossaryEntry>past due; not paid at the scheduled time; "an overdue installment"; "a delinquent account"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300139746">
	<b:glossaryEntry>owed as a debt; "must pay what is owing"; "sleep owing to you because of a long vigil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300139887"
	 b:glossaryEntry='awaiting payment; "accounts receivable"'/>
<rdf:Description rdf:about="&a;300139983">
	<b:glossaryEntry>subject to repayment; "business loans are usually repayable in regular installments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300140123"
	 b:glossaryEntry='not yet payable; "an undue loan"'/>
<rdf:Description rdf:about="&a;300140217">
	<b:glossaryEntry>suitable to or expected in the circumstances; "all due respect"; "due cause to honor them"; "a long due promotion"; "in due course"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300140416"
	 b:glossaryEntry='rightfully expected; "his looked-for advancement";'/>
<rdf:Description rdf:about="&a;300140540">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not appropriate or proper (or even legal) in the circumstances; "undue influence"; "I didn''t want to show undue excitement"; "accused of using undue force"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300140747"
	 b:glossaryEntry="of an appropriate or pertinent nature"/>
<rdf:Description rdf:about="&a;300140892">
	<b:glossaryEntry>being of striking appropriateness and pertinence; "the successful copywriter is a master of apposite and evocative verbal images"; "an apt reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300141124"
	 b:glossaryEntry="of an inappropriate or incorrectly applied nature"/>
<rdf:Description rdf:about="&a;300141284"
	 b:glossaryEntry="of an inappropriate or misapplied nature"/>
<rdf:Description rdf:about="&a;300141396">
	<b:glossaryEntry>involving deductive reasoning from a general principle to a necessary effect; not supported by fact; "an a priori judgment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300141610">
	<b:glossaryEntry>involving reasoning from facts or particulars to general principals or from effects to causes; "a posteriori demonstration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300141828"
	 b:glossaryEntry="having columns at one or both ends but not along the sides"/>
<rdf:Description rdf:about="&a;300141976">
	<b:glossaryEntry>marked by columniation having free columns in porticoes either at both ends or at both sides of a structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300142186">
	<b:glossaryEntry>marked by columniation having free columns in a portico only across the opening to the structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300142354"
	 b:glossaryEntry="having columns on all sides"/>
<rdf:Description rdf:about="&a;300142474"
	 b:glossaryEntry="having circular columniation"/>
<rdf:Description rdf:about="&a;300142559">
	<b:glossaryEntry>having columniation completely circling an area of the structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300142699">
	<b:glossaryEntry>appropriate for or subject to settlement by arbitration; "an arbitrable wage and health benefits policy"; "an arbitrable dispute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300142885"
	 b:glossaryEntry="not appropriate for or subject to arbitration"/>
<rdf:Description rdf:about="&a;300142990">
	<b:glossaryEntry>having or resembling columns; having columns of a specified kind (often used as a combining form); "a columned portico"; "trees with columned trunks"; "white-columned houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300143309"
	 b:glossaryEntry="having columns either at both ends or at both sides"/>
<rdf:Description rdf:about="&a;300143418"
	 b:glossaryEntry='characterized by columns; "columnar construction"'/>
<rdf:Description rdf:about="&a;300143522">
	<b:glossaryEntry>having the form of a column; "trees with columned trunks"; "columnar forms"; "a columnlike tree trunk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300143706"
	 b:glossaryEntry="having a series of columns arranged at regular intervals"/>
<rdf:Description rdf:about="&a;300143819"
	 b:glossaryEntry='having pillars; "the pillared portico"'/>
<rdf:Description rdf:about="&a;300143912"
	 b:glossaryEntry="not having columns"/>
<rdf:Description rdf:about="&a;300144037"
	 b:glossaryEntry="(architecture) lacking columns or pillars"/>
<rdf:Description rdf:about="&a;300144132"
	 b:glossaryEntry="lacking pillars"/>
<rdf:Description rdf:about="&a;300144204"
	 b:glossaryEntry='inhabiting or frequenting trees; "arboreal apes"'/>
<rdf:Description rdf:about="&a;300144333"
	 b:glossaryEntry="not inhabiting or frequenting trees"/>
<rdf:Description rdf:about="&a;300144426">
	<b:glossaryEntry>resembling or containing sand; or growing in sandy areas; "arenaceous limestone"; "arenaceous grasses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300144604"
	 b:glossaryEntry='resembling or containing clay; "argillaceous rocks"'/>
<rdf:Description rdf:about="&a;300144723">
	<b:glossaryEntry>(used of persons or the military) characterized by having or bearing arms; "armed robbery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300144919"
	 b:glossaryEntry="carrying weapons"/>
<rdf:Description rdf:about="&a;300145001">
	<b:glossaryEntry>armed with light equipment and weapons; "a light-armed brigade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300145122"
	 b:glossaryEntry="issued military arms"/>
<rdf:Description rdf:about="&a;300145200">
	<b:glossaryEntry>(used of persons or the military) not having or using arms; "went alone and unarmed"; "unarmed peasants were shot down"; "unarmed vehicles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300145465"
	 b:glossaryEntry='with bare hands; "fought barehanded"'/>
<rdf:Description rdf:about="&a;300145558"
	 b:glossaryEntry="not carrying concealed weapons"/>
<rdf:Description rdf:about="&a;300145640"
	 b:glossaryEntry="lacking weapons for self-defense"/>
<rdf:Description rdf:about="&a;300145744"
	 b:glossaryEntry="without a weapon"/>
<rdf:Description rdf:about="&a;300145817"
	 b:glossaryEntry="protected by armor (used of persons or things military)"/>
<rdf:Description rdf:about="&a;300146045"
	 b:glossaryEntry='covered with heavy steel; "armor-plated vehicles"'/>
<rdf:Description rdf:about="&a;300146211"
	 b:glossaryEntry="not penetrable by bullets"/>
<rdf:Description rdf:about="&a;300146294">
	<b:glossaryEntry>equipped with armor heavy enough to provide protection from light-arms fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300146450"
	 b:glossaryEntry="wearing protective mail"/>
<rdf:Description rdf:about="&a;300146538"
	 b:glossaryEntry='(German) equipped with armored vehicles; "a panzer division"'/>
<rdf:Description rdf:about="&a;300146651">
	<b:glossaryEntry>used of armor; having overlapping metal splates attached to a leather backing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300146781">
	<b:glossaryEntry>(used of persons or things military) without protective armor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300146911"
	 b:glossaryEntry="(botany) used of plants and animals"/>
<rdf:Description rdf:about="&a;300147052">
	<b:glossaryEntry>having or covered with protective barbs or quills or spines or thorns etc.; "a horse with a short bristly mane"; "bristly shrubs"; "burred fruits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300147347"
	 b:glossaryEntry="resembling a bristle"/>
<rdf:Description rdf:about="&a;300147425"
	 b:glossaryEntry="of animals"/>
<rdf:Description rdf:about="&a;300147498"
	 b:glossaryEntry="used of plants or animals; without barbs or stings"/>
<rdf:Description rdf:about="&a;300147620"
	 b:glossaryEntry="having no thorns"/>
<rdf:Description rdf:about="&a;300147692">
	<b:glossaryEntry>having arms or arms as specified; used especially in combination; "the many-armed goddess Shiva"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300147894"
	 b:glossaryEntry="resembling an arm"/>
<rdf:Description rdf:about="&a;300147965"
	 b:glossaryEntry="(zoology) having arms or armlike appendages"/>
<rdf:Description rdf:about="&a;300148064"
	 b:glossaryEntry='having one arm; "a one-armed veteran"'/>
<rdf:Description rdf:about="&a;300148157"
	 b:glossaryEntry='having no arms; "the armless Venus de Milo"'/>
<rdf:Description rdf:about="&a;300148254"
	 b:glossaryEntry="used of animals; provided with protective covering"/>
<rdf:Description rdf:about="&a;300148405"
	 b:glossaryEntry="(of animals) armored with bone"/>
<rdf:Description rdf:about="&a;300148494">
	<b:glossaryEntry>(zoology) having the body covered or partially covered with thin horny plates, as some fish and reptiles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300148668"
	 b:glossaryEntry="used of animals; without protective covering"/>
<rdf:Description rdf:about="&a;300148799"
	 b:glossaryEntry="destitute of scales"/>
<rdf:Description rdf:about="&a;300148874">
	<b:glossaryEntry>marked by skill in achieving a desired end especially with cunning or craft; "the artful dodger"; "an artful choice of metaphors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300149236">
	<b:glossaryEntry>skillful (or showing skill) in adapting means to ends; "cool prudence and sensitive selfishness along with quick perception of what is possible--these distinguish an adroit politician"; "came up with a clever story"; "an ingenious press agent"; "an ingenious scheme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300149576">
	<b:glossaryEntry>characterized by elaborate scheming and intrigue; devious; "Byzantine methods for holding on to his chairmanship"; "a fine hand for Byzantine deals and cozy arrangements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300149802">
	<b:glossaryEntry>marked by skill in deception; "cunning men often pass for wise"; "deep political machinations"; "a foxy scheme"; "a slick evasive answer"; "sly as a fox"; "tricky Dick"; "a wily old attorney"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300150132">
	<b:glossaryEntry>obviously contrived to charm; "an insufferably precious performance"; "a child with intolerably cute mannerisms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300150306">
	<b:glossaryEntry>concealing crafty designs for advancing your own interest; "a selfish and designing nation obsessed with the dark schemes of European intrigue"- W.Churchill; "a scheming wife"; "a scheming gold digger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300150574">
	<b:glossaryEntry>exhibiting great cunning usually with secrecy; "deep political machinations"; "a deep plot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300150716">
	<b:glossaryEntry>skillful at eluding capture; "a cabal of conspirators, each more elusive than the archterrorist"- David Kline</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300150889">
	<b:glossaryEntry>skillful in influencing or controlling others to your own advantage; "the early manipulative techniques of a three-year-old"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300151072">
	<b:glossaryEntry>(British) cunning and sly; "the pawky rich old lady who incessantly scores off her parasitical descendants"- Punch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300151238">
	<b:glossaryEntry>simple and natural; without cunning or deceit; "an artless manner"; "artless elegance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300151450">
	<b:glossaryEntry>effortless and unstudied; "an impression of careless elegance"; "danced with careless grace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300151597"
	 b:glossaryEntry='free from guile; "his answer was simple and honest"'/>
<rdf:Description rdf:about="&a;300151713"
	 b:glossaryEntry="lacking sophistication"/>
<rdf:Description rdf:about="&a;300151805">
	<b:glossaryEntry>expressing yourself easily or characterized by clear expressive language; "articulate speech"; "an articulate orator"; "articulate beings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300152126">
	<b:glossaryEntry>pronounced distinctly and clearly; "her words were well articulated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300152252">
	<b:glossaryEntry>expressing yourself readily, clearly, effectively; "able to dazzle with his facile tongue"; "silver speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300152474"
	 b:glossaryEntry="produced by the organs of speech"/>
<rdf:Description rdf:about="&a;300152563"
	 b:glossaryEntry='capable of speech; "the speaking animal"'/>
<rdf:Description rdf:about="&a;300152678">
	<b:glossaryEntry>speaking or spoken fittingly or pleasingly; "a well-spoken gentleman"; "a few well-spoken words on civic pride"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300152847">
	<b:glossaryEntry>without or deprived of the use of speech or words; "inarticulate beasts"; "remained stupidly inarticulate and saying something noncommital"; "inarticulate with rage"; "an inarticulate cry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300153343"
	 b:glossaryEntry="unable to speak because of a brain lesion"/>
<rdf:Description rdf:about="&a;300153438">
	<b:glossaryEntry>being voiceless through injury or illness and thus incapable of all but whispered speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300153592"
	 b:glossaryEntry="unable to speak because of hereditary deafness"/>
<rdf:Description rdf:about="&a;300153705"
	 b:glossaryEntry='lacking the power of human speech; "dumb animals"'/>
<rdf:Description rdf:about="&a;300153805">
	<b:glossaryEntry>making low inarticulate sound as e.g. of pain or sorrow; "the groaning wounded"; "moaning sounds in her sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300153980">
	<b:glossaryEntry>making short inarticulate guttural sounds as of effort expended; "ferries grunting on the river"; "grunting boxers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300154150">
	<b:glossaryEntry>unable to express yourself clearly or fluently; "felt tongue-tied with embarrassment"; "incoherent with grief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300154331">
	<b:glossaryEntry>expressed without speech; especially because words would be inappropriate or inadequate; "a mute appeal"; "a silent curse"; "best grief is tongueless"- Emily Dickinson; "the words stopped at her lips unsounded"; "unspoken grief"; "choking exasperation and wordless shame"- Thomas Wolfe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300154702">
	<b:glossaryEntry>unable to speak temporarily; "struck dumb"; "speechless with shock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300154833"
	 b:glossaryEntry="unable to speak freely and easily"/>
<rdf:Description rdf:about="&a;300154942"
	 b:glossaryEntry="uttered without the use of normal words or syllables"/>
<rdf:Description rdf:about="&a;300155054">
	<b:glossaryEntry>capable of or involving speech or speaking; "human beings--the speaking animals"; "a speaking part in the play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300155277">
	<b:glossaryEntry>speaking low and indistinctly; "a mumbling parson stood beside the dying man"; "muttering crowds of onlookers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300155454"
	 b:glossaryEntry='uttering speech; "talking heads"'/>
<rdf:Description rdf:about="&a;300155543">
	<b:glossaryEntry>having a manner of speaking as specified; often used in combination; "golden-tongued"; "sharp-tongued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300155699">
	<b:glossaryEntry>not capable of or especially not involving speech or spoken lines; "had a nonspeaking role in the play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300155888"
	 b:glossaryEntry="lacking power of speech"/>
<rdf:Description rdf:about="&a;300155975"
	 b:glossaryEntry="consisting of segments held together by joints"/>
<rdf:Description rdf:about="&a;300156110"
	 b:glossaryEntry="(zoology) having joints or jointed segments;"/>
<rdf:Description rdf:about="&a;300156209"
	 b:glossaryEntry="not consisting of segments that are held together by joints"/>
<rdf:Description rdf:about="&a;300156346"
	 b:glossaryEntry="(zoology) without joints or jointed segments"/>
<rdf:Description rdf:about="&a;300156446">
	<b:glossaryEntry>used of persons; feeling shame or guilt or embarrassment or remorse; "are you ashamed for having lied?"; "felt ashamed of my torn coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300156728"
	 b:glossaryEntry="suffering shame"/>
<rdf:Description rdf:about="&a;300156835">
	<b:glossaryEntry>made to feel uncomfortable because of shame or wounded pride; "too embarrassed to say hello to his drunken father on the street"; "humiliated that his wife had to go out to work"; "felt mortified by the comparison with her sister</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300157147">
	<b:glossaryEntry>showing a sense of guilt; "a guilty look"; "the hangdog and shamefaced air of the retreating enemy"- Eric Linklater</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300157347"
	 b:glossaryEntry="showing a sense of shame"/>
<rdf:Description rdf:about="&a;300157439"
	 b:glossaryEntry="used of persons or their behavior; feeling no shame"/>
<rdf:Description rdf:about="&a;300157618">
	<b:glossaryEntry>unrestrained by convention or propriety; "an audacious trick to pull"; "a barefaced hypocrite"; "the most bodacious display of tourism this side of Anaheim"- Los Angeles Times; "bold-faced lies"; "brazen arrogance"; "the modern world with its quick material successes and insolent belief in the boundless possibilities of progress"- Bertrand Russell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300158104">
	<b:glossaryEntry>feeling no shame; "a shameless imposter"; "an unblushing apologist for fascism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300158252">
	<b:glossaryEntry>not embarrassed; "a tinseled charm and unabashed sentimentality"- Jerome Stone; "an unembarrassed greeting as if nothing untoward had happened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300158467">
	<b:glossaryEntry>inclined to bold and confident assertion; aggressively self-assured; "an energetic assertive boy who was always ready to argue"; "pointing directly at a listener is an assertive act"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300158777">
	<b:glossaryEntry>overly self-confident or self-assertive; "a very cocky young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300158894">
	<b:glossaryEntry>forceful and definite in expression or action; "the document contained a particularly emphatic guarantee of religious liberty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300159086">
	<b:glossaryEntry>inclined to timidity or lack of self-confidence; "a shy unassertive person"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300159309">
	<b:glossaryEntry>not aggressively self-assured, though not necessarily lacking in confidence; "she was quiet and nonassertive as she took control"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300159497"
	 b:glossaryEntry="reluctant to draw attention to yourself"/>
<rdf:Description rdf:about="&a;300159607">
	<b:glossaryEntry>characterized by or causing or resulting from association; "associative learning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300159778">
	<b:glossaryEntry>capable of being associated; "words associable with politics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300159896"
	 b:glossaryEntry="not associative"/>
<rdf:Description rdf:about="&a;300159972"
	 b:glossaryEntry="associated in an exclusive sexual relationship"/>
<rdf:Description rdf:about="&a;300160157"
	 b:glossaryEntry='pledged to be married; "the engaged couple"'/>
<rdf:Description rdf:about="&a;300160299"
	 b:glossaryEntry='future; betrothed; "his intended bride"'/>
<rdf:Description rdf:about="&a;300160393"
	 b:glossaryEntry="emotionally involved"/>
<rdf:Description rdf:about="&a;300160487"
	 b:glossaryEntry="not associated in an exclusive sexual relationship"/>
<rdf:Description rdf:about="&a;300160626">
	<b:glossaryEntry>not promised in marriage; "continued seeing him but on an unengaged basis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300160781"
	 b:glossaryEntry='firmly attached; "the affixed labels"'/>
<rdf:Description rdf:about="&a;300160944"
	 b:glossaryEntry="affixed as an appendage"/>
<rdf:Description rdf:about="&a;300161023">
	<b:glossaryEntry>(botany) attached by its base (as certain anthers to their filaments or stalks)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300161158">
	<b:glossaryEntry>affixed or as if affixed with glue or paste; "he stayed glued to one spot"; "pieces of pasted paper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300161319"
	 b:glossaryEntry="assembled for use; especially by being attached to a support"/>
<rdf:Description rdf:about="&a;300161433"
	 b:glossaryEntry='not affixed; "the stamp came loose"'/>
<rdf:Description rdf:about="&a;300161532">
	<b:glossaryEntry>(biology) attached directly by the base; not having an intervening stalk; "sessile flowers"; "the shell of a sessile barnacle is attached directly to a substrate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300161760">
	<b:glossaryEntry>(biology) having or growing on or from a peduncle or stalk; "a pedunculate flower"; "a pedunculate barnacle is attached to the substrate by a fleshy foot or stalk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300161991">
	<b:glossaryEntry>(biology) permanently attached to a substrate; not free to move about; "an attached oyster"; "sessile marine animals and plants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300162184">
	<b:glossaryEntry>(zoology) having freedom to move about; "vagile aquatic animals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300162319"
	 b:glossaryEntry="(of animals) able to swim about; not attached"/>
<rdf:Description rdf:about="&a;300162437">
	<b:glossaryEntry>(architecture) used of buildings joined by common sidewalls; "a block of attached houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300162581">
	<b:glossaryEntry>(architecture) used of buildings; standing apart from others; "detached houses"; "a detached garage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300162772">
	<b:glossaryEntry>standing apart; not attached to or supported by anything; "a freestanding bell tower"; "a house with a separate garage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300162961"
	 b:glossaryEntry='attached on one side only; "a semidetached house"'/>
<rdf:Description rdf:about="&a;300163069"
	 b:glossaryEntry='caught or fixed; "stuck in the mud"'/>
<rdf:Description rdf:about="&a;300163156">
	<b:glossaryEntry>free; "a man with a mule got my car unstuck"; "the gears locked in second and would not come unstuck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300163311">
	<b:glossaryEntry>capable of being fastened or added to something else; "a handle attachable by two bolts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300163510"
	 b:glossaryEntry="capable of being fastened or secured with a rope or bond"/>
<rdf:Description rdf:about="&a;300163632">
	<b:glossaryEntry>attachable by a clip; "clip-on earrings"; "a clip-on bow tie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300163747"
	 b:glossaryEntry='fastened by tying on; "tie-on labels"'/>
<rdf:Description rdf:about="&a;300163837">
	<b:glossaryEntry>designed to be unfastened or disconnected without damage; "shirts with detachable collars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300164002"
	 b:glossaryEntry='capable of being removed; "lids should be removable"'/>
<rdf:Description rdf:about="&a;300164110">
	<b:glossaryEntry>marked by keen caution and watchful prudence; "they were wary in their movements"; "a wary glance at the black clouds"; "taught to be wary of strangers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300164367">
	<b:glossaryEntry>vigilant; "on guard against con artists"; "must remain on your guard in such a situation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300164569">
	<b:glossaryEntry>wary and distrustful; disposed to avoid persons or things; "shy of strangers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300164696">
	<b:glossaryEntry>not alert to danger or deception; "the shrieks of unwary animals taken by surprise"; "some thieves prey especially on unwary travelers"; "seduce the unwary reader into easy acquiescence"- O.J.Campbell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300165003">
	<b:glossaryEntry>easily tricked because of being too trusting; "gullible tourists taken in by the shell game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300165150">
	<b:glossaryEntry>displaying or feeling no wariness; "an unguarded remark"; "spilled the beans in an incautious moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300165320">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `to'') giving care or attention; "attentive to details"; "the nurse was attentive to her patient"; "an attentive suitor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300165658">
	<b:glossaryEntry>wholly absorbed as in thought; "deep in thought"; "that engrossed look or rapt delight"; "the book had her totally engrossed"; "enwrapped in dreams"; "so intent on this fantastic...narrative that she hardly stirred"- Walter de la Mare; "rapt with wonder"; "wrapped in thought"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300166039"
	 b:glossaryEntry="giving attention"/>
<rdf:Description rdf:about="&a;300166121">
	<b:glossaryEntry>attending to or alert for sound; "be wary of listening ears"; "government-maintained listening posts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300166278"
	 b:glossaryEntry="paying close attention especially to details"/>
<rdf:Description rdf:about="&a;300166378"
	 b:glossaryEntry="excessively solicitous"/>
<rdf:Description rdf:about="&a;300166461">
	<b:glossaryEntry>showing hovering attentiveness; "solicitous about about her health"; "made solicitous inquiries about our family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300166631"
	 b:glossaryEntry='showing a lack of attention; "inattentive students"'/>
<rdf:Description rdf:about="&a;300166902">
	<b:glossaryEntry>lost in thought; showing preoccupation; "an absent stare"; "an absentminded professer"; "the scatty glancing quality of a hyperactive but unfocused intelligence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300167153"
	 b:glossaryEntry="having the attention diverted especially because of anxiety"/>
<rdf:Description rdf:about="&a;300167280"
	 b:glossaryEntry='dreamy in mood or nature; "a woolgathering moment"'/>
<rdf:Description rdf:about="&a;300167407">
	<b:glossaryEntry>showing lack of attention or boredom; "the yawning congregation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300167548">
	<b:glossaryEntry>failing to keep in mind; "forgetful of her responsibilities"; "oblivious old age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300167697">
	<b:glossaryEntry>pleasing to the eye or mind especially through beauty or charm; "a remarkably attractive young man"; "an attractive personality"; "attractive clothes"; "a book with attractive illustrations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300168250">
	<b:glossaryEntry>capturing interest as if by a spell; "bewitching smile"; "Roosevelt was a captivating speaker"; "enchanting music"; "an enthralling book"; "antique papers of entrancing design"; "a fascinating woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300168574">
	<b:glossaryEntry>possessing an extraordinary ability to attract; "a charismatic leader"; "a magnetic personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300168739">
	<b:glossaryEntry>attractive especially by means of smallness or prettiness or quaintness; "a cute kid with pigtails"; "a cute little apartment"; "cunning kittens"; "a cunning baby"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300168963">
	<b:glossaryEntry>(British informal) pretty and neat; "what a dinky little hat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300169076">
	<b:glossaryEntry>attracting or delighting; "an engaging frankness"; "a piquant face with large appealing eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300169234">
	<b:glossaryEntry>very attractive; capturing interest; "a fetching new hairstyle"; "something inexpressibly taking in his manner"; "a winning personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300169444">
	<b:glossaryEntry>attracting and holding interest as if by a spell; "read the bedtime story in a hypnotic voice"; "she had a warm mesmeric charm"; "the sheer force of his presence was mesmerizing"; "a spellbinding description of life in ancient Rome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300169771"
	 b:glossaryEntry='overpoweringly attractive; "irresistible beauty"'/>
<rdf:Description rdf:about="&a;300169878"
	 b:glossaryEntry="(of persons) pleasant in appearance and personality"/>
<rdf:Description rdf:about="&a;300169986"
	 b:glossaryEntry="looking attractive in photographs"/>
<rdf:Description rdf:about="&a;300170076">
	<b:glossaryEntry>creating a favorable impression; "strong and vigorous and of prepossessing appearance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300170222"
	 b:glossaryEntry="charming in a childlike or naive way"/>
<rdf:Description rdf:about="&a;300170312">
	<b:glossaryEntry>lacking beauty or charm; "as unattractive as most mining regions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300170562">
	<b:glossaryEntry>lacking in physical beauty or proportion; "a homely child"; "several of the buildings were downright homely"; "a plain girl with a freckled face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300170768">
	<b:glossaryEntry>devoid of brightness or appeal; "a subfusc mining town"; "dark subfusc clothing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300170902"
	 b:glossaryEntry="creating an unfavorable or neutral first impression"/>
<rdf:Description rdf:about="&a;300171031">
	<b:glossaryEntry>(physics) having the properties of a magnet; the ability to draw or pull; "an attractive force"; "the knife hung on a magnetic board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300171253">
	<b:glossaryEntry>(physics) possessing the ability to repel; "a repulsive force"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300171392">
	<b:glossaryEntry>able to attract interest or draw favorable attention; "He added an appealing and memorable figure to popular American mythology"- Vincent Starrett; "an appealing sense of humor"; "the idea of having enough money to retire at fifty is very appealing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300171733"
	 b:glossaryEntry='likely to attract attention; "a catchy title for a movie"'/>
<rdf:Description rdf:about="&a;300171863">
	<b:glossaryEntry>having power to arouse interest; "an attractive opportunity"; "the job is attractive because of the pay"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300172024">
	<b:glossaryEntry>not able to attract favorable attention; "they have made the place as unappealing as possible"; "was forced to talk to his singularly unappealing hostess"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300172272">
	<b:glossaryEntry>tending to repel; "The trappings of upper-class life are off-putting and sterile"- Elizabeth Hess</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300172427">
	<b:glossaryEntry>lacking power to arouse interest; "being unemployed is a most unattractive prospect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300172570">
	<b:glossaryEntry>capable of being attributed; "the collapse of the movement was attributable to a lack of morale"; "an idea attributable to a Russian"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300172834">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') able to be assigned or credited to; "punctuation errors ascribable to careless proofreading"; "the cancellation of the concert was due to the rain"; "the oversight was not imputable to him"; "decide to which of these motives such extraordinary scenes are referable"- Charles Dickens]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300173245">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') given credit for; "an invention credited to Edison"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300173381">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') able to be traced to; "a failure traceable to lack of energy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300173525"
	 b:glossaryEntry="not attributable"/>
<rdf:Description rdf:about="&a;300173635">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) of adjectives; placed before the nouns they modify; "`red'' is an attributive adjective in `a red apple''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300173838">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) a word in the genitive case used as an attributive adjective; "an example of the attributive genitive is `John''s'' in `John''s mother''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300174048">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(grammar) of adjectives; relating to or occurring within the predicate of a sentence; "`red'' is a predicative adjective in `the apple is red''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300174260">
	<b:glossaryEntry>carrying developing offspring within the body or being about to produce new life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300174431">
	<b:glossaryEntry>in an advanced stage of pregnancy; "was big with child"; "was great with child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300174644"
	 b:glossaryEntry="(informal) pregnant out of wedlock"/>
<rdf:Description rdf:about="&a;300174738"
	 b:glossaryEntry="not pregnant"/>
<rdf:Description rdf:about="&a;300174808">
	<b:glossaryEntry>heard or perceptible by the ear; "he spoke in an audible whisper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300175028"
	 b:glossaryEntry='relating to audible sound; "a sonic wave"'/>
<rdf:Description rdf:about="&a;300175121">
	<b:glossaryEntry>making or having a sound as specified; used as a combining form; "harsh-sounding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300175257">
	<b:glossaryEntry>impossible to hear; imperceptible by the ear; "an inaudible conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300175561">
	<b:glossaryEntry xml:space='preserve'><![CDATA[uttered without voice; "could hardly hear her breathed plea, `Help me''"; "voiceless whispers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300175721"
	 b:glossaryEntry="having frequencies below those of audible sound"/>
<rdf:Description rdf:about="&a;300175825">
	<b:glossaryEntry>having a frequency below or above the range of human audibility; "a silent dog whistle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300175965">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not made to sound; "the silent `h'' at the beginning of `honor''"; "in French certain letters are often unsounded"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300176142"
	 b:glossaryEntry="having frequencies above those of audible sound"/>
<rdf:Description rdf:about="&a;300176259"
	 b:glossaryEntry="not necessarily inaudible but not heard"/>
<rdf:Description rdf:about="&a;300176352">
	<b:glossaryEntry>(of speed) having or caused by speed approximately equal to that of sound in air at sea level; "a sonic boom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300176543">
	<b:glossaryEntry>(of speed) less than that of sound in a designated medium; "aircraft flying at subsonic speeds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300176711">
	<b:glossaryEntry>(of speed) greater than that of sound in a given medium especially air; "the Concorde is a commercial supersonic aircraft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300176908">
	<b:glossaryEntry>attended by favorable circumstances; "an auspicious beginning for the campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300177134"
	 b:glossaryEntry='very favorable or advantageous; "a golden opportunity"'/>
<rdf:Description rdf:about="&a;300177268">
	<b:glossaryEntry>full or promise; "had a bright future in publishing"; "the scandal threatened an abrupt end to a promising political career"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300177457">
	<b:glossaryEntry>presaging good fortune; "she made a fortunate decision to go to medical school"; "rosy predictions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300177629"
	 b:glossaryEntry="not auspicious; boding ill"/>
<rdf:Description rdf:about="&a;300177764">
	<b:glossaryEntry>appearing to be unlikely to result favorably or be enjoyable; "faced an unpromising task"; "music for unpromising combinations of instruments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300177964"
	 b:glossaryEntry='presenting favorable circumstances; "propitious omens"'/>
<rdf:Description rdf:about="&a;300178165">
	<b:glossaryEntry>tending to favor or bring good luck; "miracles are auspicious accidents"; "encouraging omens"; "a favorable time to ask for a raise"; "lucky stars"; "a prosperous moment to make a decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300178471"
	 b:glossaryEntry='disposed to bestow favors; "thanks to the gracious gods"'/>
<rdf:Description rdf:about="&a;300178582"
	 b:glossaryEntry="not propitious"/>
<rdf:Description rdf:about="&a;300178727">
	<b:glossaryEntry>presaging ill-fortune; "ill omens"; "ill predictions"; "my words with inauspicious thunderings shook heaven"- P.B.Shelley;"a dead and ominous silence prevailed"; "a by-election at a time highly unpropitious for the Government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300179028"
	 b:glossaryEntry='extremely ominous; "world events of thunderous import"'/>
<rdf:Description rdf:about="&a;300179139"
	 b:glossaryEntry="endowed with authority"/>
<rdf:Description rdf:about="&a;300179362">
	<b:glossaryEntry>given official approval to act; "an accredited college"; "commissioned broker"; "licensed pharmacist"; "authorized representative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300179586">
	<b:glossaryEntry>established by authority; given authoritative approval; "a list of approved candidates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300179741"
	 b:glossaryEntry="accorded sacrosanct or authoritative standing"/>
<rdf:Description rdf:about="&a;300179854">
	<b:glossaryEntry>invested with legal power or official authority especially as symbolized by having a scepter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300180025"
	 b:glossaryEntry="not endowed with authority"/>
<rdf:Description rdf:about="&a;300180200">
	<b:glossaryEntry>designated or chosen by yourself; "a self-appointed guardian of public morals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300180339"
	 b:glossaryEntry="lacking official approval"/>
<rdf:Description rdf:about="&a;300180449">
	<b:glossaryEntry>sanctioned by or consistent with or operating under a constitution; "the constitutional right of free speech"; "constitutional government"; "constitutional guarantees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300180677">
	<b:glossaryEntry>not consistent with or according to a constitution; contrary to the U.S. Constitution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300180825">
	<b:glossaryEntry>of rocks, deposits, etc.; found where they and their constituents were formed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300180962">
	<b:glossaryEntry>of rocks, deposits, etc.; found in a place other than where they and their constituents were formed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300181121">
	<b:glossaryEntry>of parasites especially rust fungi; completing the entire life cycle on a single host; "autoecious rust fungi"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300181306">
	<b:glossaryEntry>used of parasitic animals that complete the life cycle on a single host; "homoecious tapeworms"; "a homoecious beetle that is parasitic in the nest of an ant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300181521">
	<b:glossaryEntry>of parasites; passing through different stages of the life cycle on different host species; "heteroecious fungi"; "heteroecious insects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300181716">
	<b:glossaryEntry>of parasitic animals such as tapeworms or some beetles; having the same host during the entire life cycle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300181878">
	<b:glossaryEntry>of parasitic animals; spending different stages of the life cycle on different host species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300182028"
	 b:glossaryEntry="originating within the body"/>
<rdf:Description rdf:about="&a;300182142"
	 b:glossaryEntry="originating from the self"/>
<rdf:Description rdf:about="&a;300182244"
	 b:glossaryEntry="originating outside the body"/>
<rdf:Description rdf:about="&a;300182347">
	<b:glossaryEntry>operating with minimal human intervention; independent of external control; "automatic transmission"; "a budget deficit that caused automatic spending cuts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300182667">
	<b:glossaryEntry>(of firearms) capable of automatic loading and firing continuously; "an autoloading rifle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300182849"
	 b:glossaryEntry='operated by automation; "an automated stoker"'/>
<rdf:Description rdf:about="&a;300182988">
	<b:glossaryEntry>designed to activate or move or regulate itself; "a self-activating sprinkler system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300183181"
	 b:glossaryEntry="locking automatically when closed"/>
<rdf:Description rdf:about="&a;300183273">
	<b:glossaryEntry>designed so that manual winding is unnecessary; "a self-winding watch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300183402"
	 b:glossaryEntry='requiring human effort; "a manual transmission"'/>
<rdf:Description rdf:about="&a;300183520"
	 b:glossaryEntry="operated by hand"/>
<rdf:Description rdf:about="&a;300183612">
	<b:glossaryEntry>obtainable or accessible and ready for use or service; "kept a fire extinguisher available"; "much information is available through computers"; "available in many colors"; "the list of available candidates is unusually long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300184144">
	<b:glossaryEntry>easily obtained; "most students now have computers accessible"; "accessible money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300184283"
	 b:glossaryEntry="capable of being acquired"/>
<rdf:Description rdf:about="&a;300184365">
	<b:glossaryEntry>(computer science) capable of being addressed; "addressable memory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300184490">
	<b:glossaryEntry>(economics) less in demand and therefore readily obtainable; "commodities are easy this quarter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300184637">
	<b:glossaryEntry>available when required or as promised; "federal funds were not forthcoming"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300184771">
	<b:glossaryEntry>capable of being obtained; "savings of up to 50 percent are obtainable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300184933">
	<b:glossaryEntry>available for use or sale; "they have plenty of stonewashed jeans in stock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300185066">
	<b:glossaryEntry>present and easily available; "the cash on hand is adequate for current needs"; "emergency police were on hand in case of trouble"; "a visible supply"; "visible resources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300185307">
	<b:glossaryEntry>available for immediate use; "extra personnel on tap"; "other sports and entertainment facilities are on tap"; "there are numerous projects on tap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300185510">
	<b:glossaryEntry>(of liquids) available by turning a tap; "ale on tap"; "hot and cold running water on tap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300185656"
	 b:glossaryEntry='not having been filled; "the job is still open"'/>
<rdf:Description rdf:about="&a;300185754">
	<b:glossaryEntry>available for purchase; "purchasable goods"; "many house in the area are for sale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300185905">
	<b:glossaryEntry>(of especially money) immediately available; "he seems to have ample ready money"; "a ready source of cash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300186067">
	<b:glossaryEntry>not available or accessible or at hand; "fresh milk was unavailable during the emergency"; "his secretary said he was unavailable for comment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300186321">
	<b:glossaryEntry>not capable of being obtained; "a rare work, today almost inaccessible"; "timber is virtually unobtainable in the islands"; "untouchable resources buried deep within the earth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300186600">
	<b:glossaryEntry>not available for sale or use; "too many items are out of stock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300186726">
	<b:glossaryEntry>not in a state of sleep; completely conscious; "lay awake thinking about his new job"; "still not fully awake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300187035">
	<b:glossaryEntry>out of bed; "are they astir yet?"; "up by seven each morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300187159">
	<b:glossaryEntry>(somewhat formal) having been waked up; "the awakened baby began to cry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300187286">
	<b:glossaryEntry>experiencing or accompanied by sleeplessness; "insomniac old people"; "insomniac nights"; "lay sleepless all night"; "twenty watchful, weary, tedious nights"- Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300187535">
	<b:glossaryEntry>fully awake; "the unsleeping city"; "so excited she was wide-awake all night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300187682">
	<b:glossaryEntry>marked by full consciousness or alertness; "worked every moment of my waking hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300187821">
	<b:glossaryEntry>in a state of sleep; "were all asleep when the phone rang"; "fell asleep at the wheel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300188143"
	 b:glossaryEntry="in a state of repose or especially sleep"/>
<rdf:Description rdf:about="&a;300188240">
	<b:glossaryEntry>(biology) in a condition of biological rest or suspended animation; "dormant buds"; "a hibernating bear"; "torpid frogs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300188440">
	<b:glossaryEntry>half asleep; "made drowsy by the long ride"; "it seemed a pity to disturb the drowsing (or dozing) professor"; "a tired dozy child"; "the nodding (or napping) grandmother in her rocking chair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300188744">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sleeping deeply; "lying fast asleep on the sofa"; "it would be cruel to wake him; he''s sound asleep"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300188923">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lying asleep; "don''t wake the sleeping children"; "gazed with affection at his slumbering form"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300189092">
	<b:glossaryEntry>ready to fall asleep; "beginning to feel sleepy"; "a sleepy-eyed child with drooping eyelids"; "sleepyheaded students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300189292">
	<b:glossaryEntry xml:space='preserve'><![CDATA[inclined to or marked by drowsiness; "slumberous (or slumbrous) eyes"; "`slumbery'' is archaic"; "the sound had a a somnolent effect"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300189516"
	 b:glossaryEntry="still asleep"/>
<rdf:Description rdf:about="&a;300189585">
	<b:glossaryEntry>tending to draw together or constrict soft organic tissue; "astringent cosmetic lotions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300189766">
	<b:glossaryEntry>tending to check bleeding by contracting the tissues or blood vessels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300189902"
	 b:glossaryEntry="not astringent"/>
<rdf:Description rdf:about="&a;300189994">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(sometimes followed by `of'') having or showing realization or perception; "was aware of his opponent''s hostility"; "became aware of her surroundings"; "aware that he had exceeded the speed limit"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300190370">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') showing acute awareness; mentally perceptive; "alert to the problems"; "alive to what is going on"; "awake to the dangers of her situation"; "was now awake to the reality of his predicament"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300190661">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing realization or recognition or something; followed by "of"; "few voters seem conscious (or aware) of the issue''s importance"; "conscious of having succeeded"; "the careful tread of one conscious of his alcoholic load"- Thomas Hardy]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300190958">
	<b:glossaryEntry>aware intuitively or intellectually of something sensed; "made sensible of his mistakes"; "I am sensible that the mention of such a circumstance may appear trifling"- Henry Hallam; "sensible that a good deal more is still to be done"- Edmund Burke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300191260">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `of'') not aware; "seemed unaware of the scrutiny"; "unaware of the danger they were in"; "unaware of the newborn hope"; "the most unaware person I''ve known"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300191615">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `to'' or `of'') lacking conscious awareness of; "oblivious of the mounting pressures for political reform"; "oblivious to the risks she ran"; "not unmindful of the heavy responsibility"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300191885">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `of'') not knowing or perceiving; "happily unconscious of the new calamity at home"- Charles Dickens]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300192058">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `of'') not knowing or expecting; not thinking likely; "an unsuspecting victim"; "unsuspecting (or unaware) of the fact that I would one day be their leader"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300192291">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `of'') having knowledge or understanding; "our youth are cognizant of the law"; "aware of his limitations"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300192496">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(often followed by `of'') lacking knowledge or awareness; "incognizant of the new political situation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300192665"
	 b:glossaryEntry='aware or knowing; "a witting tool of the Communists"'/>
<rdf:Description rdf:about="&a;300192779">
	<b:glossaryEntry>not aware or knowing; "an unwitting subject in an experiment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300192906"
	 b:glossaryEntry="causing alarm or fear"/>
<rdf:Description rdf:about="&a;300193234"
	 b:glossaryEntry='causing consternation; "appalling conditions"'/>
<rdf:Description rdf:about="&a;300193347">
	<b:glossaryEntry>provoking horror; "an atrocious automobile accident"; "a frightful crime of decapitation"; "an alarming, even horrifying, picture"; "war is beyond all words horrible"- Winston Churchill; "an ugly wound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300193648">
	<b:glossaryEntry>causing fear or dread or terror; "the awful war"; "an awful risk"; "dire news"; "a career or vengeance so direful that London was shocked"; "the dread presence of the headmaster"; "polio is no longer the dreaded disease it once was"; "a dreadful storm"; "a fearful howling"; "horrendous explosions shook the city"; "a terrible curse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300194152">
	<b:glossaryEntry>threatening or foreshadowing evil or tragic developments; "a baleful look"; "forbidding thunderclouds"; "his tone became menacing"; "ominous rumblings of discontent"; "sinister storm clouds"; "a sinister smile"; "his threatening behavior"; "ugly black clouds"; "the situation became ugly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300194583"
	 b:glossaryEntry="extremely alarming"/>
<rdf:Description rdf:about="&a;300194690">
	<b:glossaryEntry>so scary as to cause chills and shudders; "the most terrible and shuddery...tales of murder and revenge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300194887">
	<b:glossaryEntry>causing a sensation as of things crawling on your skin; "a creepy story"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300195012">
	<b:glossaryEntry>inspiring fear; "the formidable prospect of major surgery"; "a tougher and more redoubtable adversary than the heel-clicking, jackbooted fanatic"- G.H.Johnston; "something unnerving and prisonlike about high gray wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300195313">
	<b:glossaryEntry>shockingly repellent; inspiring horror; "ghastly wounds"; "the grim aftermath of the bombing"; "the grim task of burying the victims"; "a grisly murder"; "gruesome evidence of human sacrifice"; "macabre tales of war and plague in the Middle ages"; "macabre tortures conceived by madmen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300195690"
	 b:glossaryEntry='hazardous and frightening; "hairy moments in the mountains"'/>
<rdf:Description rdf:about="&a;300195801"
	 b:glossaryEntry="paralyzing with terror"/>
<rdf:Description rdf:about="&a;300195880">
	<b:glossaryEntry>shocking with surprise and consternation; "the stupefying impact of the tragedy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300196017"
	 b:glossaryEntry='causing extreme terror; "a terrifying wail"'/>
<rdf:Description rdf:about="&a;300196128"
	 b:glossaryEntry="not alarming; assuaging alarm"/>
<rdf:Description rdf:about="&a;300196250"
	 b:glossaryEntry="causing to become tranquil"/>
<rdf:Description rdf:about="&a;300196353">
	<b:glossaryEntry>(of flowering plants; especially grasses etc) pollinated by the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300196480">
	<b:glossaryEntry>(of flowering plants; especially orchids etc) pollinated by insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300196607">
	<b:glossaryEntry>restoring confidence and relieving anxiety; "a very reassuring remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300196824"
	 b:glossaryEntry="freeing from fear and anxiety"/>
<rdf:Description rdf:about="&a;300196942"
	 b:glossaryEntry="giving confidence"/>
<rdf:Description rdf:about="&a;300197014"
	 b:glossaryEntry="affording comfort or solace"/>
<rdf:Description rdf:about="&a;300197124"
	 b:glossaryEntry="not reassuring; tending to cause anxiety"/>
<rdf:Description rdf:about="&a;300197253">
	<b:glossaryEntry>related to or located at the back; "the back yard"; "the back entrance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300197450"
	 b:glossaryEntry="located farthest to the rear"/>
<rdf:Description rdf:about="&a;300197568">
	<b:glossaryEntry xml:space='preserve'><![CDATA[located in or toward the back or rear; the chair''s rear legs"; "the rear door of the plane"; "on the rearward side"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300197751">
	<b:glossaryEntry>relating to or located in the front; "the front lines"; "the front porch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300198023">
	<b:glossaryEntry>situated ahead or going before; "an advance party"; "at that time the most advanced outpost was still east of the Rockies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300198232">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(prefix) in front of or before in space; "`ante'' is a prefix in the word `anteroom''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300198367">
	<b:glossaryEntry>preceding all others in spatial position; "the foremost compartment of the ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300198514"
	 b:glossaryEntry='situated in the front; "the forward section of the aircraft"'/>
<rdf:Description rdf:about="&a;300198628">
	<b:glossaryEntry>meeting front to front; "a frontal attack"; "a head-on collision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300198756">
	<b:glossaryEntry>going or proceeding or going in advance; showing the way; "we rode in the leading car"; "the leading edge of technology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300198966">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing the way by conducting or leading; imposing direction on; "felt his mother''s directing arm around him"; "the directional role of science on industrial progress"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300199225"
	 b:glossaryEntry='exerting control or influence; "a guiding principle"'/>
<rdf:Description rdf:about="&a;300199331">
	<b:glossaryEntry>going or proceeding or coming after in the same direction; "the crowd of following cars made the occasion seem like a parade"; "tried to outrun the following footsteps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300199609">
	<b:glossaryEntry xml:space='preserve'><![CDATA[following in order to overtake or capture or as accompaniment to such pursuit; "the fox fled from the pursuing hounds"; "listened for the hounds'' pursuing bark"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300199824">
	<b:glossaryEntry>following surreptitiously; keeping under surveillance; "always on guard against shadowing submarines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300199991">
	<b:glossaryEntry>moving silently and deliberately; especially pursuing stealthily and persistently; "we watched the stalking tiger approach his prey"; "a stalking specter on the castle walls at midnight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300200232"
	 b:glossaryEntry="having a back or backing, usually of a specified type"/>
<rdf:Description rdf:about="&a;300200446"
	 b:glossaryEntry='having a hard back or cover; "hardback books"'/>
<rdf:Description rdf:about="&a;300200583"
	 b:glossaryEntry='having a high back; "a high-backed sofa"'/>
<rdf:Description rdf:about="&a;300200681"
	 b:glossaryEntry="having a low back"/>
<rdf:Description rdf:about="&a;300200755">
	<b:glossaryEntry>having a sharp narrow back; "a razor-backed horse"; "razorback hogs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300200894">
	<b:glossaryEntry>having a stiff back; "the guards stood stiff-backed and unsmiling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300201019"
	 b:glossaryEntry='having a straight back; "a straight-backed wooden chair"'/>
<rdf:Description rdf:about="&a;300201137"
	 b:glossaryEntry='lacking a back; "a stool is a backless and armless seat"'/>
<rdf:Description rdf:about="&a;300201266"
	 b:glossaryEntry='having a low-cut back; "a backless dress"'/>
<rdf:Description rdf:about="&a;300201361">
	<b:glossaryEntry>directed or facing toward the back or rear; "a backward view"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300201747"
	 b:glossaryEntry="used of hair"/>
<rdf:Description rdf:about="&a;300201827">
	<b:glossaryEntry>(linguistics) pronounced with the tip of the tongue turned back toward the hard palate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300201981"
	 b:glossaryEntry='turned about in order or relation; "transposed letters"'/>
<rdf:Description rdf:about="&a;300202115"
	 b:glossaryEntry="reversed (turned backward) in order or nature or effect"/>
<rdf:Description rdf:about="&a;300202234">
	<b:glossaryEntry>reckoned in a direction opposite to that regarded as positive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300202350">
	<b:glossaryEntry>directed or moving toward the rear; "a rearward glance"; "a rearward movement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300202493"
	 b:glossaryEntry="(of a hairline e.g.) moving slowly back"/>
<rdf:Description rdf:about="&a;300202590"
	 b:glossaryEntry="(grammar) referring back to itself"/>
<rdf:Description rdf:about="&a;300202696"
	 b:glossaryEntry="(heraldry) looking backward"/>
<rdf:Description rdf:about="&a;300202783"
	 b:glossaryEntry='drawn back and in; "a cat with retracted claws"'/>
<rdf:Description rdf:about="&a;300202886">
	<b:glossaryEntry>moving or directed or tending in a backward direction or contrary to a previous direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300203041"
	 b:glossaryEntry="bent or curved backward"/>
<rdf:Description rdf:about="&a;300203134"
	 b:glossaryEntry="tending to be turned back"/>
<rdf:Description rdf:about="&a;300203230">
	<b:glossaryEntry>at or near or directed toward the front; "the forward section of the aircraft"; "a forward plunge down the stairs"; "forward motion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300203488"
	 b:glossaryEntry="(heraldry) looking forward"/>
<rdf:Description rdf:about="&a;300203599">
	<b:glossaryEntry>with the head foremost; "a headfirst plunge down the stairs"; "a headlong dive into the pool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300203759">
	<b:glossaryEntry>of the transmission gear causing forward movement in a motor vehicle; "in a forward gear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300203938">
	<b:glossaryEntry>being the gear producing the lowest drive speed; "use first gear on steep hills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300204076"
	 b:glossaryEntry='having the second highest gear ratio; "second gear"'/>
<rdf:Description rdf:about="&a;300204180">
	<b:glossaryEntry>of the transmission gear causing backward movement in a motor vehicle; "in reverse gear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300204322">
	<b:glossaryEntry>(used of temperament or behavior) marked by a retiring nature; "a backward lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300204494">
	<b:glossaryEntry xml:space='preserve'><![CDATA[disposed to avoid notice; "they considered themselves a tough outfit and weren''t bashful about letting anybody know it"; (`blate'' is a Scottish term for bashful)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300204717">
	<b:glossaryEntry>used of temperament or behavior; lacking restraint or modesty; "a forward child badly in need of discipline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300204987">
	<b:glossaryEntry>offensively bold; "a brash newcomer disputed the age-old rules for admission to the club"; "a nervy thing to say"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300205169"
	 b:glossaryEntry="offensively self-assertive"/>
<rdf:Description rdf:about="&a;300205268">
	<b:glossaryEntry>taking undue liberties; "young women disliked the familiar tone he took with them"; "instructors should not be familir in their behavior toward students of the opposite sex"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300205511">
	<b:glossaryEntry xml:space='preserve'><![CDATA[improperly forward or bold; "don''t be fresh with me"; "impertinent of a child to lecture a grownup"; "an impudent boy given to insulting strangers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300205762">
	<b:glossaryEntry>excessively forward; "an assumptive person"; "on a subject like this it would be too assuming for me to decide"; "the duchess would not put up with presumptuous servants"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300206015">
	<b:glossaryEntry>having balconies or a balcony; "the balconied houses of New Orleans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300206139"
	 b:glossaryEntry="not having balconies"/>
<rdf:Description rdf:about="&a;300206217"
	 b:glossaryEntry='put in or stored in a barrel; "barreled beer"'/>
<rdf:Description rdf:about="&a;300206329"
	 b:glossaryEntry="not in a barrel"/>
<rdf:Description rdf:about="&a;300206415"
	 b:glossaryEntry="having or resembling a beak"/>
<rdf:Description rdf:about="&a;300206585">
	<b:glossaryEntry>resembling the beak of a bird; "a grizzled man with a beaklike nose"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300206708">
	<b:glossaryEntry>(combining form) having a beak or bill as specified; "a thick-billed bird"; "a long-billed cap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300206856">
	<b:glossaryEntry>having a beak resembling that of a duck; "a duck-billed dinosaur"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300206990"
	 b:glossaryEntry="resembling a hawk (in character or appearance)"/>
<rdf:Description rdf:about="&a;300207099"
	 b:glossaryEntry="having a beak or beaklike snout or proboscis"/>
<rdf:Description rdf:about="&a;300207198"
	 b:glossaryEntry="not having a beak or bill"/>
<rdf:Description rdf:about="&a;300207278"
	 b:glossaryEntry="(combining form) having a bed or beds as specified"/>
<rdf:Description rdf:about="&a;300207435"
	 b:glossaryEntry='having a double bed; "a double-bedded room"'/>
<rdf:Description rdf:about="&a;300207538"
	 b:glossaryEntry="having single beds"/>
<rdf:Description rdf:about="&a;300207616"
	 b:glossaryEntry="having twin beds"/>
<rdf:Description rdf:about="&a;300207690"
	 b:glossaryEntry='without a bed; "the cell was bedless"'/>
<rdf:Description rdf:about="&a;300207781"
	 b:glossaryEntry='having a benefice; "a beneficed clergyman"'/>
<rdf:Description rdf:about="&a;300207879"
	 b:glossaryEntry="not having a benefice"/>
<rdf:Description rdf:about="&a;300207958">
	<b:glossaryEntry>having or covered with boughs or boughs as specified; often used in combination; "heavy-boughed oaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300208113"
	 b:glossaryEntry="lack a bough or boughs"/>
<rdf:Description rdf:about="&a;300208191">
	<b:glossaryEntry>(geology) deposited or arranged in horizontal layers; "stratified rock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300208382">
	<b:glossaryEntry>(especially of metamorphic rock) having thin leaflike layers or strata</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300208517"
	 b:glossaryEntry='with one layer on top of another; "superimposed rocks"'/>
<rdf:Description rdf:about="&a;300208640"
	 b:glossaryEntry="resembling a sheet"/>
<rdf:Description rdf:about="&a;300208714">
	<b:glossaryEntry>(geology) not deposited in layers; "glacial till is unstratified"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300208838"
	 b:glossaryEntry='abounding in or covered with ferns; "the ferny undergrowth"'/>
<rdf:Description rdf:about="&a;300208994">
	<b:glossaryEntry>abounding with bracken; "the woods and braky glens"- William Browne</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300209113">
	<b:glossaryEntry>resembling ferns especially in leaf shape; "the ferny shadows of locust leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300209255"
	 b:glossaryEntry="devoid of ferns"/>
<rdf:Description rdf:about="&a;300209325"
	 b:glossaryEntry="abounding in grass"/>
<rdf:Description rdf:about="&a;300209450">
	<b:glossaryEntry>covered with grass; "wide grass-covered plains as far as the eye could see"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300209585"
	 b:glossaryEntry="resembling grass"/>
<rdf:Description rdf:about="&a;300209657"
	 b:glossaryEntry="covered with sedges (grasslike marsh plants)"/>
<rdf:Description rdf:about="&a;300209753"
	 b:glossaryEntry="lacking grass"/>
<rdf:Description rdf:about="&a;300209840">
	<b:glossaryEntry>showing ground without the usual covering of grass; "a carefully swept bare yard around the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300209989"
	 b:glossaryEntry="provided or reinforced with gussets"/>
<rdf:Description rdf:about="&a;300210079"
	 b:glossaryEntry="not having gussets"/>
<rdf:Description rdf:about="&a;300210154">
	<b:glossaryEntry>having no hair or fur; "a Mexican Hairless is about the size of a fox terrier and hairless except for a tufts on the head and tail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300210484">
	<b:glossaryEntry>lacking hair on all or most of the scalp; "a bald pate"; "a bald-headed gentleman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300210644"
	 b:glossaryEntry="getting bald"/>
<rdf:Description rdf:about="&a;300210710"
	 b:glossaryEntry='lacking hair on the face; "a smooth-faced boy of 14 years"'/>
<rdf:Description rdf:about="&a;300210839"
	 b:glossaryEntry="able to remove hair or render hairless"/>
<rdf:Description rdf:about="&a;300210934"
	 b:glossaryEntry="completely hairless"/>
<rdf:Description rdf:about="&a;300211008">
	<b:glossaryEntry>(biology) having no hair or similar growth; smooth; "glabrous stems"; "glabrous leaves"; "a glabrous scalp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300211170">
	<b:glossaryEntry>without hair; "tinea corporis is a fungal infection of the nonhairy parts of the skin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300211311">
	<b:glossaryEntry>having a bald spot either shaved or natural; "tonsured monks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300211427">
	<b:glossaryEntry>having or covered with hair; "Jacob was a hairy man"; "a hairy caterpillar"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300211870"
	 b:glossaryEntry="(biology) covered with fine whitish hairs or down"/>
<rdf:Description rdf:about="&a;300211983">
	<b:glossaryEntry>(botany; of certain seeds as of cotton) having a tuft or tufts of hair; "comate (or comose) seeds"; "a comal tuft"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300212167">
	<b:glossaryEntry>(biology) covered with fine soft hairs or down; "downy milkweed seeds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300212326"
	 b:glossaryEntry="(of plants) having tufts of soft woolly hairs"/>
<rdf:Description rdf:about="&a;300212426"
	 b:glossaryEntry="resembling fur"/>
<rdf:Description rdf:about="&a;300212494">
	<b:glossaryEntry>covered with a dense coat of fine silky hairs; "furred animals"; "a furry teddy bear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300212640">
	<b:glossaryEntry>covering with fine light hairs; "his head fuzzed like a dandelion gone to seed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300212780">
	<b:glossaryEntry>(often used in combination) having hair as specified; "a short-haired dog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300212907">
	<b:glossaryEntry>(of animals or plants) having stiff coarse hairs or bristles; "plants with hispid stems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300213048">
	<b:glossaryEntry>covered with dense cottony hairs or hairlike filaments; "the woolly aphid has a lanate coat resembling cotton"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300213220"
	 b:glossaryEntry='with long hair; "long-haired hippies"'/>
<rdf:Description rdf:about="&a;300213315">
	<b:glossaryEntry>(of plants such as dandelions and thistles) having pappi or tufts of featherlike hairs or delicate bristles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300213476"
	 b:glossaryEntry="(biology) covered with hairs especially fine soft ones"/>
<rdf:Description rdf:about="&a;300213592">
	<b:glossaryEntry>having a shock (or untidy mass) of hair; "shock-headed teenagers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300213716">
	<b:glossaryEntry>(biology) densely covered with short matted woolly hairs; "a tomentose leaf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300213860">
	<b:glossaryEntry>(especially of dogs) having stiff wiry hair; "a wire-haired terrier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300213986">
	<b:glossaryEntry>covered with dense often matted or curly hairs; "woolly lambs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300214109">
	<b:glossaryEntry>having awns i.e. bristle- or hair-like appendages on the flowering parts of some cereals and grasses; "awned wheatgrass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300214306"
	 b:glossaryEntry='having a growth of hair-like awns; "bearded wheatgrass"'/>
<rdf:Description rdf:about="&a;300214415"
	 b:glossaryEntry='lacking or having only very short awns; "awnless bromegrass"'/>
<rdf:Description rdf:about="&a;300214529"
	 b:glossaryEntry="(of a structural member) withstanding a weight or strain"/>
<rdf:Description rdf:about="&a;300214660"
	 b:glossaryEntry='capable of bearing a structural load; "a supporting wall"'/>
<rdf:Description rdf:about="&a;300214795">
	<b:glossaryEntry>(of a structural member) supporting no vertical weight other than its own; "they took out a nonbearing wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300214978">
	<b:glossaryEntry>serving simply to separate or partition; "a dividing partition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300215099">
	<b:glossaryEntry>delighting the senses or exciting intellectual or emotional admiration; "a beautiful child"; "beautiful country"; "a beautiful painting"; "a beautiful theory"; "a beautiful party"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300215694"
	 b:glossaryEntry="poetic"/>
<rdf:Description rdf:about="&a;300215756">
	<b:glossaryEntry xml:space='preserve'><![CDATA[very pleasing to the eye; "my bonny lass"; "there''s a bonny bay beyond"; "a comely face"; "young fair maidens"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300215943"
	 b:glossaryEntry='(informal British) good-looking; "a dishy blonde"'/>
<rdf:Description rdf:about="&a;300216044"
	 b:glossaryEntry='of extreme beauty; "her exquisite face"'/>
<rdf:Description rdf:about="&a;300216139"
	 b:glossaryEntry='visually appealing; "our fair city"'/>
<rdf:Description rdf:about="&a;300216235">
	<b:glossaryEntry>pleasing in appearance especially by reason of conformity to ideals of form and proportion; "a fine-looking woman"; "a good-looking man"; "better-looking than her sister"; "very pretty but not so extraordinarily handsome"- Thackeray; "our southern women are well-favored"- Lillian Hellman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300216656">
	<b:glossaryEntry>having great beauty and splendor; "a glorious spring morning"; "a glorious sunset"; "splendid costumes"; "a kind of splendiferous native simplicity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300216900"
	 b:glossaryEntry='dazzlingly beautiful; "a gorgeous Victorian gown"'/>
<rdf:Description rdf:about="&a;300217004"
	 b:glossaryEntry="appealing to the emotions as well as the eye"/>
<rdf:Description rdf:about="&a;300217101">
	<b:glossaryEntry>suggesting or suitable for a picture; pretty as a picture; "a picturesque village"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300217241">
	<b:glossaryEntry>pleasing by delicacy or grace; not imposing; "pretty girl"; "pretty song"; "pretty room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300217382"
	 b:glossaryEntry="ostentatiously or inappropriately pretty"/>
<rdf:Description rdf:about="&a;300217482">
	<b:glossaryEntry>used of persons only; having great physical beauty; "pulchritudinous movie stars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300217625"
	 b:glossaryEntry='stunningly beautiful; "a ravishing blonde"'/>
<rdf:Description rdf:about="&a;300217723">
	<b:glossaryEntry>used of locations; having beautiful natural scenery; "scenic drives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300217844">
	<b:glossaryEntry xml:space='preserve'><![CDATA[strikingly beautiful or attractive; "quite stunning with large dark eyes and a beautiful high-bosomed figure"; "stunning photographs of Canada''s wilderness areas"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300218061">
	<b:glossaryEntry>displeasing to the senses and morally revolting; "an ugly face"; "ugly furniture"; "war is ugly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300218406">
	<b:glossaryEntry>having the appearance spoiled; "a disfigured face"; "strip mining left a disfigured landscape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300218557">
	<b:glossaryEntry>distorted and unnatural in shape or size; abnormal and hideous; "tales of grotesque serpents eight fathoms long that churned the seas"; "twisted into monstrous shapes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300218804">
	<b:glossaryEntry>so extremely ugly as to be terrifying; "a hideous scar"; "a repulsive mask"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300218945"
	 b:glossaryEntry='usually used of a face; "an ill-favored countenance"'/>
<rdf:Description rdf:about="&a;300219070">
	<b:glossaryEntry>having a diseased appearance resembling scrofula; "our canoe...lay with her scrofulous sides on the shore"- Farley Mowat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300219247"
	 b:glossaryEntry="without beauty or charm"/>
<rdf:Description rdf:about="&a;300219341"
	 b:glossaryEntry='unpleasant to look at; "unsightly billboards"'/>
<rdf:Description rdf:about="&a;300219442"
	 b:glossaryEntry="having a belly; often used in combination"/>
<rdf:Description rdf:about="&a;300219555"
	 b:glossaryEntry="having a prominent belly"/>
<rdf:Description rdf:about="&a;300219653"
	 b:glossaryEntry="lacking a prominent belly"/>
<rdf:Description rdf:about="&a;300219749">
	<b:glossaryEntry>identified with a band especially around a leg; "kept watch for the return of their banded birds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300219899"
	 b:glossaryEntry='not identified with a band; "an unbanded bird"'/>
<rdf:Description rdf:about="&a;300220000"
	 b:glossaryEntry='having or provided with a belt; "a belted dress"'/>
<rdf:Description rdf:about="&a;300220119">
	<b:glossaryEntry>characterized by a band of especially white around the body; "banded cattle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300220248"
	 b:glossaryEntry='lacking a belt; "unbelted jackets are in this season"'/>
<rdf:Description rdf:about="&a;300220367">
	<b:glossaryEntry>doing or producing good; "the most beneficent regime in history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300220542">
	<b:glossaryEntry>exerting a favorable or beneficent influence; "a benefic star"; "a benefic force"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300220677"
	 b:glossaryEntry="harmful or evil in intent or effect"/>
<rdf:Description rdf:about="&a;300220859">
	<b:glossaryEntry>deadly or sinister; "the Florida eagles have a fierce baleful look"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300220990">
	<b:glossaryEntry>having or exerting a malignant influence; "malevolent stars"; "a malefic force"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300221152">
	<b:glossaryEntry>having or showing or arising from a desire to promote the welfare or happiness of others; "his benevolent smile"; "a benevolent nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300221441">
	<b:glossaryEntry>generously responsive; "good-hearted but inept efforts to help"; "take a kindly interest"; "a kindly gentleman"; "an openhearted gift to charity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300221675">
	<b:glossaryEntry>wishing or appearing to wish evil to others; arising from intense ill will or hatred; "a gossipy malevolent old woman"; "failure made him malevolent toward those who were successful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300222070"
	 b:glossaryEntry="having eyes that gleam with malice"/>
<rdf:Description rdf:about="&a;300222161"
	 b:glossaryEntry='marked by or arising from malice; "a catty remark"'/>
<rdf:Description rdf:about="&a;300222282">
	<b:glossaryEntry>marked by deep ill will; deliberately harmful; "a malevolent lie"; "poisonous hate...in his eyes"- Ernest Hemingway; "venomous criticism"; "vicious gossip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300222514"
	 b:glossaryEntry='full of malice or hate; "venomed remarks"'/>
<rdf:Description rdf:about="&a;300222609">
	<b:glossaryEntry>having the nature of or resulting from malice; "malicious gossip"; "took malicious pleasure in...watching me wince"- Rudyard Kipling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300222851">
	<b:glossaryEntry>showing malicious ill will and a desire to hurt; motivated by spite; "a despiteful fiend"; "a truly spiteful child"; "a vindictive man will look for occasions for resentment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300223106">
	<b:glossaryEntry>showing sly or knowing malice in a glance; "she had run in fear of...his evil leering eye"- Amy Lowell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300223262"
	 b:glossaryEntry='shrewish and malicious; "a vixenish old woman"'/>
<rdf:Description rdf:about="&a;300223363"
	 b:glossaryEntry="not malicious or spiteful"/>
<rdf:Description rdf:about="&a;300223446">
	<b:glossaryEntry>pleasant and beneficial in nature or influence; "a benign smile"; "the benign sky"; "the benign influence of pure air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300223736">
	<b:glossaryEntry>conducive to comfort; beneficial; "the genial sunshine"; "a kind climate"; "hot summer pavements are anything but kind to the feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300223927">
	<b:glossaryEntry>(pathology) not threatening to life or health; not malignant; "a benign tumor is usually harmless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300224095"
	 b:glossaryEntry='pleasant and agreeable; "a kindly climate"; "kindly breeze"'/>
<rdf:Description rdf:about="&a;300224207">
	<b:glossaryEntry>evil or harmful in nature or influence; "prompted by malign motives"; "believed in witches and malign spirits"; "gave him a malign look"; "a malign lesion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300224559"
	 b:glossaryEntry="tending to cause great harm"/>
<rdf:Description rdf:about="&a;300224659">
	<b:glossaryEntry>extremely malevolent or malicious; "the malignant tongues of gossipers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300224799">
	<b:glossaryEntry>(pathology) characterized by progressive and uncontrolled growth (especially of a tumor); "a malignant tumor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300224964">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(superlative of `good'') having the most positive qualities; "the best film of the year"; "the best solution"; "the best time for planting"; "wore his best suit"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300225481">
	<b:glossaryEntry>holding first place in a contest; "a champion show dog"; "a prizewinning wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300225629"
	 b:glossaryEntry='surpassing in quality; "top-grade ore"'/>
<rdf:Description rdf:about="&a;300225759">
	<b:glossaryEntry>ranking above all others; "was first in her class"; "the foremost figure among marine artists"; "the top graduate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300225945">
	<b:glossaryEntry>used of clothing; "my good clothes"; "her Sunday-go-to-meeting clothes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300226121"
	 b:glossaryEntry='most of; "spoke for the greatest part of an hour"'/>
<rdf:Description rdf:about="&a;300226225"
	 b:glossaryEntry="of greatest advantage or suitability"/>
<rdf:Description rdf:about="&a;300226342">
	<b:glossaryEntry>most desirable possible under a restriction expressed or implied; "an optimum return on capital"; "optimal concentration of a drug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300226537"
	 b:glossaryEntry='best of its kind on record; "in record time"'/>
<rdf:Description rdf:about="&a;300226637">
	<b:glossaryEntry>surpassing any previously established record; "a record-breaking high jump"; "record-breaking crowds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300226800"
	 b:glossaryEntry='next to the best; "his second-best bed"'/>
<rdf:Description rdf:about="&a;300226897">
	<b:glossaryEntry>(used especially of merchandise) very fine in quality; "made of superfine Flemish cloth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300227041"
	 b:glossaryEntry="not capable of being improved on"/>
<rdf:Description rdf:about="&a;300227157">
	<b:glossaryEntry>not to be exceeded; "unsurpassable skill"; "unsurpassable standards of workmanship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300227300">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(superlative of `bad'') most wanting in quality or value or condition; "the worst player on the team"; "the worst weather of the year"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300227629"
	 b:glossaryEntry='the lowest rank; "bottom member of the class"'/>
<rdf:Description rdf:about="&a;300227737"
	 b:glossaryEntry='lowest in rank or importance; "last prize"; "in last place"'/>
<rdf:Description rdf:about="&a;300227869"
	 b:glossaryEntry="superlatively evil and wicked"/>
<rdf:Description rdf:about="&a;300227968"
	 b:glossaryEntry="superlatively undesirable and unpleasant"/>
<rdf:Description rdf:about="&a;300228089"
	 b:glossaryEntry="superlatively unsuitable and unattractive"/>
<rdf:Description rdf:about="&a;300228212"
	 b:glossaryEntry="of an organism''s environment; least favorable for survival"/>
<rdf:Description rdf:about="&a;300228339">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `good'') superior to another (of the same class or set or kind) in excellence or quality or desirability or suitability; more highly skilled than another; "You''re a better man than I am, Gunga Din"; "a better coat"; "a better type of car"; "a suit with a better fit"; "a better chance of success"; "produced a better mousetrap"; "she''s better in math than in history"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300228828"
	 b:glossaryEntry='modified for the better; "his amended ways"'/>
<rdf:Description rdf:about="&a;300228925">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `fine'') greater in quality or excellence; "a finer wine"; "a finer musician"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300229069">
	<b:glossaryEntry>become or made better in quality; "was proud of his improved grades"; "an improved viewfinder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300229218">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `bad'') inferior to another in quality or condition or desirability; "this road is worse than the first one we took"; "the road is in worse shape than it was"; "she was accused of worse things than cheating and lying"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300229520">
	<b:glossaryEntry>made or become worse; impaired; "troubled by the worsened economic conditions"; "the worsened diplomatic relations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300229690">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(comparative of `good'') changed for the better in health or fitness; "her health is better now"; "I feel better"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300229873"
	 b:glossaryEntry="improved in health or physical condition"/>
<rdf:Description rdf:about="&a;300229978">
	<b:glossaryEntry>changed for the worse in health or fitness; "I feel worse today"; "her cold is worse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300230126"
	 b:glossaryEntry="changing for the better"/>
<rdf:Description rdf:about="&a;300230277"
	 b:glossaryEntry="tending to ameliorate"/>
<rdf:Description rdf:about="&a;300230404"
	 b:glossaryEntry='effecting amendment; "added amendatory phrases to the text"'/>
<rdf:Description rdf:about="&a;300230520">
	<b:glossaryEntry>tending or intended to correct or counteract or restore to a normal condition; "corrective measures"; "corrective lenses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300230698">
	<b:glossaryEntry>tending or intended to rectify or improve; "a remedial reading course"; "remedial education"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300230845"
	 b:glossaryEntry='changing for the worse; "worried by the worsening storm"'/>
<rdf:Description rdf:about="&a;300230957"
	 b:glossaryEntry="composed of two legislative bodies"/>
<rdf:Description rdf:about="&a;300231047"
	 b:glossaryEntry="composed of one legislative body"/>
<rdf:Description rdf:about="&a;300231136">
	<b:glossaryEntry>older and (at least formerly) larger than another though relative size is not the issue; "big sister"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300231306">
	<b:glossaryEntry>younger and (at least formerly) smaller than another though relative size is not the issue; "little brother"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300231480">
	<b:glossaryEntry>reactive or functioning or allowing movement in two usually opposite directions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300231673"
	 b:glossaryEntry='having two faces or fronts; "the Roman Janus is bifacial"'/>
<rdf:Description rdf:about="&a;300231794">
	<b:glossaryEntry>(telecommunication) allowing communication in opposite directions simultaneously; "duplex system"; "duplex telephony"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300231964">
	<b:glossaryEntry>operating or permitting operation in either of two opposite directions; "a two-way valve"; "two-way traffic"; "two-way streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300232145">
	<b:glossaryEntry>operating or moving or allowing movement in one direction only; "a unidirectonal flow"; "a unidirectional antenna"; "a unidirectional approach to a problem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300232416">
	<b:glossaryEntry>permitting movement or travel in one direction only; "one-way streets"; "a one-way ticket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300232560">
	<b:glossaryEntry>(telecommunication) allowing communication in only one direction at a time, or in telegraphy allowing only one message over a line at a time; "simplex system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300232772">
	<b:glossaryEntry>having but one principal or specialized surface; "a primitive unifacial flint tool"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300232911">
	<b:glossaryEntry>having a face or facing especially of a specified kind or number; often used in combination; "a neatly faced terrace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300233206"
	 b:glossaryEntry="having a youthful-looking face"/>
<rdf:Description rdf:about="&a;300233293">
	<b:glossaryEntry>having facial features as specified; usually used in combination; "a grim-featured man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300233435">
	<b:glossaryEntry>having two faces--one looking to the future and one to the past; "Janus the two-faced god"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300233595"
	 b:glossaryEntry="having a face longer than the usual"/>
<rdf:Description rdf:about="&a;300233687"
	 b:glossaryEntry="having a round face"/>
<rdf:Description rdf:about="&a;300233777">
	<b:glossaryEntry>having a pleasing face or one showing a sweet disposition; "a sweet-faced child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300233915">
	<b:glossaryEntry>(combining form) having a face or visage as specified; "gloomy-visaged funeral directors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300234058">
	<b:glossaryEntry>without a face or identity; "a faceless apparition"; "the faceless accusers of the police state"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300234227">
	<b:glossaryEntry>not known or lacking marked individuality; "brown anonymous houses"; "anonymous bureaucrats in the Civil Service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300234396"
	 b:glossaryEntry='having a bib; "a bibbed apron"'/>
<rdf:Description rdf:about="&a;300234479"
	 b:glossaryEntry="lacking a bib"/>
<rdf:Description rdf:about="&a;300234546"
	 b:glossaryEntry="having two sides or parts"/>
<rdf:Description rdf:about="&a;300234693">
	<b:glossaryEntry>involving two parties or elements; "a bipartite agreement"; "a two-way treaty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300234849">
	<b:glossaryEntry>involving both houses of a legislature; "a joint session of Congress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300234970"
	 b:glossaryEntry='involving only one part or side; "a unilateral decision"'/>
<rdf:Description rdf:about="&a;300235131"
	 b:glossaryEntry="determined by a single party"/>
<rdf:Description rdf:about="&a;300235215"
	 b:glossaryEntry="having many parts or sides"/>
<rdf:Description rdf:about="&a;300235457"
	 b:glossaryEntry="involving more than two parties"/>
<rdf:Description rdf:about="&a;300235547"
	 b:glossaryEntry="having four sides"/>
<rdf:Description rdf:about="&a;300235637"
	 b:glossaryEntry="involving four parties"/>
<rdf:Description rdf:about="&a;300235732">
	<b:glossaryEntry>(biology) having or consisting of four similar parts; tetramerous flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300235863"
	 b:glossaryEntry='involving a group or set of three; "a three-cornered race"'/>
<rdf:Description rdf:about="&a;300235982"
	 b:glossaryEntry='having three sides; "a trilateral figure"'/>
<rdf:Description rdf:about="&a;300236107">
	<b:glossaryEntry>involving three parties or elements; "the triangular mother-father-child relationship"; "a trilateral agreement"; "a tripartite treaty"; "a tripartite division"; "a three-way playoff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300236399">
	<b:glossaryEntry>(statistics) of a distribution; having or occurring with two modes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300236519"
	 b:glossaryEntry="(statistics) having a single mode"/>
<rdf:Description rdf:about="&a;300236607">
	<b:glossaryEntry>relating to or having or hearing with two ears; "binaural hearing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300236774"
	 b:glossaryEntry="having two ears"/>
<rdf:Description rdf:about="&a;300236845">
	<b:glossaryEntry>(electronics) designating sound transmission from two sources through two channels</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300237009">
	<b:glossaryEntry>relating to or having or hearing with only one ear; "monaural deafness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300237171"
	 b:glossaryEntry="having a single ear"/>
<rdf:Description rdf:about="&a;300237246">
	<b:glossaryEntry>(electronics) designating sound transmission or recording or reproduction over a single channel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300237422"
	 b:glossaryEntry="biology; having two nuclei"/>
<rdf:Description rdf:about="&a;300237531"
	 b:glossaryEntry="biology; having only one nucleus"/>
<rdf:Description rdf:about="&a;300237636"
	 b:glossaryEntry="having two feet"/>
<rdf:Description rdf:about="&a;300237744"
	 b:glossaryEntry="having four feet"/>
<rdf:Description rdf:about="&a;300237862">
	<b:glossaryEntry>of or belonging to a racial group having dark skin especially of sub-Saharan African origin; "a great people--a black people--...injected new meaning and dignity into the veins of civilization"- Martin Luther King Jr.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300238203">
	<b:glossaryEntry>pertaining to or characteristic of Americans of African ancestry; "Afro-American culture"; "many black people preferred to be called African-American or Afro-American"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300238449">
	<b:glossaryEntry>having skin rich in melanin pigments; "National Association for the Advancement of Colored People"; "the dark races"; "dark-skinned peoples"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300238676">
	<b:glossaryEntry>relating to or characteristic of or being a member of the traditional racial division of mankind having brown to black pigmentation and tightly curled hair</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300238883">
	<b:glossaryEntry>characteristic of people traditionally classified as the Negro race; "negroid features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300239024">
	<b:glossaryEntry>of or belonging to a racial group having light skin coloration; "voting patterns within the white population"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300239221"
	 b:glossaryEntry="of or relating to Caucasian people"/>
<rdf:Description rdf:about="&a;300239323"
	 b:glossaryEntry="having little skin pigmentation"/>
<rdf:Description rdf:about="&a;300239414">
	<b:glossaryEntry>being or having light colored skin and hair and usually blue or gray eyes; "blond Scandinavians"; "a house full of light-haired children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300239735"
	 b:glossaryEntry="of hair color; whitish"/>
<rdf:Description rdf:about="&a;300239844">
	<b:glossaryEntry>(used of hair or skin) pale or light-colored; "a fair complexion";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300239972">
	<b:glossaryEntry>of hair color; pale yellowish to yellowish brown; "flaxen locks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300240097"
	 b:glossaryEntry="resembling peoples of Scandinavia"/>
<rdf:Description rdf:about="&a;300240183"
	 b:glossaryEntry="having red hair and usually fair skin"/>
<rdf:Description rdf:about="&a;300240276">
	<b:glossaryEntry>marked by dark or relatively dark pigmentation of hair or skin or eyes; "a brunette beauty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300240575">
	<b:glossaryEntry>(archaic) burned brown by the sun; "of an adust complexion"- Sir Walter Scott</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300240704">
	<b:glossaryEntry>(of skin) having a tan color from exposure to the sun; "a young bronzed Apollo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300240868"
	 b:glossaryEntry='(used of hair or skin or eyes) "dark eyes"'/>
<rdf:Description rdf:about="&a;300240961"
	 b:glossaryEntry='having hair of a dark color; "a dark-haired beauty"'/>
<rdf:Description rdf:about="&a;300241100">
	<b:glossaryEntry xml:space='preserve'><![CDATA[naturally having skin of a dark color; "a dark-skinned beauty"; "gold earrings gleamed against her dusky cheeks"; "a smile on his swarthy face" (`swart'' is archaic)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300241349"
	 b:glossaryEntry="having dark hairs mixed with gray or white"/>
<rdf:Description rdf:about="&a;300241446"
	 b:glossaryEntry='of the color of nuts; "nutbrown hair"'/>
<rdf:Description rdf:about="&a;300241538"
	 b:glossaryEntry="marred by imperfections"/>
<rdf:Description rdf:about="&a;300241761"
	 b:glossaryEntry="(of complexion) blemished by imperfections of the skin"/>
<rdf:Description rdf:about="&a;300241898">
	<b:glossaryEntry>(of glass or quartzite) marred by small bubbles or small particles of foreign material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300242047"
	 b:glossaryEntry='marred by discolored spots or blotches; "blotchy skin"'/>
<rdf:Description rdf:about="&a;300242155">
	<b:glossaryEntry xml:space='preserve'><![CDATA[especially of reputation; "the senator''s seriously damaged reputation"; "a flyblown reputation"; "a tarnished reputation"; "inherited a spotted name"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300242434">
	<b:glossaryEntry>blemished by injury or rough wear; "the scarred piano bench"; "walls marred by graffiti"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300242585">
	<b:glossaryEntry>marked by or as if by smallpox or acne or other eruptive skin disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300242720">
	<b:glossaryEntry>free from physical or moral spots or stains; "an unblemished record"; "an unblemished complexion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300242965">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(of a record) having no marks of discredit or offense; "a clean voting recor"; "a clean driver''s license"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300243122">
	<b:glossaryEntry>of complexion; without such blemishes as e.g. acne; "the clear complexion of a healthy young woman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300243273">
	<b:glossaryEntry>of reputation; "his unsullied name"; "an untarnished reputation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300243444">
	<b:glossaryEntry>having or covered with or accompanied by blood; "a bloody nose"; "your scarf is all bloody"; "the effects will be violent and probably bloody"; "a bloody fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300243891">
	<b:glossaryEntry>emitting or as if emitting blood; "his bleeding wounds"; "bleeding heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300244022">
	<b:glossaryEntry>having blood of a certain type; used as a combining form; "blue-blooded aristocracy"; "red-blooded American"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300244184">
	<b:glossaryEntry>containing blood; "the blood-filled centers of arteries and veins"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300244309"
	 b:glossaryEntry='having been caused to bleed; "a bloodied nose"'/>
<rdf:Description rdf:about="&a;300244410"
	 b:glossaryEntry='covered with blood; "a bloodstained shirt"; "a gory dagger"'/>
<rdf:Description rdf:about="&a;300244535">
	<b:glossaryEntry>drawing blood from the body of another; "a plague of bloodsucking insects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300244668">
	<b:glossaryEntry>marked by eagerness to resort to violence and bloodshed; "bloody-minded tyrants"; "bloodthirsty yells"; "went after the collaborators with a sanguinary fury that drenched the land with blood"-G.W.Johnson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300244959">
	<b:glossaryEntry xml:space='preserve'><![CDATA[characterized by violence or bloodshed; "writes of crimson deeds and barbaric days"- Andrea Parke; "fann''d by Conquest''s crimson wing"- Thomas Gray; "convulsed with red rage"- Hudson Strode]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300245218">
	<b:glossaryEntry>capable of or conducive to bloodshed; "a cutthroat rogue"; "a homicidal rage"; "murderous thugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300245394"
	 b:glossaryEntry='accompanied by bloodshed; "this bitter and sanguinary war"'/>
<rdf:Description rdf:about="&a;300245557">
	<b:glossaryEntry>characterized by bloodshed and carnage for both sides; "internecine war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300245706">
	<b:glossaryEntry xml:space='preserve'><![CDATA[red with or characterized by blood; "waving our red weapons o''er our heads"- Shakespeare; "The Red Badge of Courage"; "the red rules of tooth and claw"- P.B.Sears]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300245918">
	<b:glossaryEntry>free from blood or bloodshed; "bloodless surgery"; "a bloodless coup"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300246079"
	 b:glossaryEntry='achieved without bloodshed; "an unbloody transfer of power"'/>
<rdf:Description rdf:about="&a;300246206">
	<b:glossaryEntry>not caused to bleed; "got out of the fracas with his nose unbloodied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300246332">
	<b:glossaryEntry>fearless and daring; "bold settlers on some foreign shore"; "a bold speech"; "a bold adventure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300246712">
	<b:glossaryEntry>invulnerable to fear or intimidation; "audacious explorers"; "fearless reporters and photographers"; "intrepid pioneers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300246942">
	<b:glossaryEntry>presumptuously daring; "a daredevil test pilot having the right stuff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300247090"
	 b:glossaryEntry="made bold or courageous"/>
<rdf:Description rdf:about="&a;300247170">
	<b:glossaryEntry>marked by unthinking boldness; with defiant disregard for danger or consequences; "foolhardy enough to try to seize the gun from the hijacker"; "became the fiercest and most reckless of partisans"-Macaulay; "a reckless driver"; "a rash attempt to climb the World Trade Center"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300247520">
	<b:glossaryEntry>having or displaying qualities appropriate for heroes; "the heroic attack on the beaches of Normandy"; "heroic explorers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300247705">
	<b:glossaryEntry>showing or requiring courage and contempt of danger; "the nervy feats of mountaineers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300247843">
	<b:glossaryEntry>revealing excessive self-confidence; reaching for the heights; "vaulting ambition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300247995">
	<b:glossaryEntry>having or showing undue valor or boldness; "a foolish overvaliant act"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300248123"
	 b:glossaryEntry="showing fear and lack of confidence"/>
<rdf:Description rdf:about="&a;300248426">
	<b:glossaryEntry>self-consciously timid; "I never laughed, being bashful; lowering my head, I looked at the wall"- Ezra Pound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300248588">
	<b:glossaryEntry>modestly or warily rejecting approaches or overtures; "like a wild young colt, very inquisitive but very coy and not to be easily cajoled"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300248776">
	<b:glossaryEntry>timid by nature or revealing timidity; "timorous little mouse"; "in a timorous tone"; "cast fearful glances at the large dog"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300248975"
	 b:glossaryEntry="made timid or fearful as by threats"/>
<rdf:Description rdf:about="&a;300249068"
	 b:glossaryEntry="timid and ineffectual"/>
<rdf:Description rdf:about="&a;300249150"
	 b:glossaryEntry="easily startled or frightened"/>
<rdf:Description rdf:about="&a;300249229"
	 b:glossaryEntry='confined by bonds; "bound and gagged hostages"'/>
<rdf:Description rdf:about="&a;300249471">
	<b:glossaryEntry>bound with chains; "enchained demons strained in anger to gnaw on his bones"; "prisoners in chains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300249651"
	 b:glossaryEntry="bound by chains fastened around the ankles"/>
<rdf:Description rdf:about="&a;300249789">
	<b:glossaryEntry>rolled up and secured; "furled sails bound securely to the spar"; "a furled flag"; "his rolled umbrella hanging on his arm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300249974"
	 b:glossaryEntry="bound fast especially having the arms restrained"/>
<rdf:Description rdf:about="&a;300250077"
	 b:glossaryEntry="confined or restricted with or as if with a rope or chain"/>
<rdf:Description rdf:about="&a;300250189">
	<b:glossaryEntry>bound or secured closely; "the guard was found trussed up with his arms and legs securely tied"; "a trussed chicken"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300250366"
	 b:glossaryEntry='tied or bound with wire; "wired bundles of newspapers"'/>
<rdf:Description rdf:about="&a;300250472"
	 b:glossaryEntry="not restrained or tied down by bonds"/>
<rdf:Description rdf:about="&a;300250616"
	 b:glossaryEntry="not bound by shackles and chains"/>
<rdf:Description rdf:about="&a;300250746"
	 b:glossaryEntry="not confined or restricted with a tether"/>
<rdf:Description rdf:about="&a;300250843"
	 b:glossaryEntry='closed with a lace; "snugly laced shoes"'/>
<rdf:Description rdf:about="&a;300250942">
	<b:glossaryEntry>with laces not tied; "teenagers slopping around in unlaced sneakers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300251073"
	 b:glossaryEntry='fastened with strings or cords; "a neatly tied bundle"'/>
<rdf:Description rdf:about="&a;300251207"
	 b:glossaryEntry='tied with a knot; "his carefully knotted necktie"'/>
<rdf:Description rdf:about="&a;300251310"
	 b:glossaryEntry="not tied"/>
<rdf:Description rdf:about="&a;300251384">
	<b:glossaryEntry>in a confused mass; "pushed back her tangled hair"; "the tangled ropes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300251653">
	<b:glossaryEntry xml:space='preserve'><![CDATA[especially of a ship''s lines etc; "with its sails afoul"; "a foul anchor"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300251798"
	 b:glossaryEntry='caught as if in a mesh; "enmeshed in financial difficulties"'/>
<rdf:Description rdf:about="&a;300251927">
	<b:glossaryEntry>twisted together in a tangled mass; "toiled through entangled growths of mesquite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300252065"
	 b:glossaryEntry="twined or twisted together"/>
<rdf:Description rdf:about="&a;300252149">
	<b:glossaryEntry>tangled in knots or snarls; "a mass of knotted string"; "snarled thread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300252294">
	<b:glossaryEntry>tangled in a dense mass; "tried to push through the matted undergowth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300252417">
	<b:glossaryEntry>having the roots matted or densely tangled; "shaggy untended lawns of old trees and rootbound scented flowers and shrubs"- William Faulkner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300252612">
	<b:glossaryEntry>(archaic) twisted together; as of filaments spun into a thread; "thrown silk is raw silk that has been twisted and doubled into yarn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300252819"
	 b:glossaryEntry="not tangled"/>
<rdf:Description rdf:about="&a;300252904"
	 b:glossaryEntry="straightened out"/>
<rdf:Description rdf:about="&a;300253002">
	<b:glossaryEntry>secured with a cover or binding; often used as a combining form; "bound volumes"; "leather-bound volumes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300253249">
	<b:glossaryEntry>having trim or fittings of brass; "a brassbound campaign chest"; "the heavy brassbound door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300253398"
	 b:glossaryEntry="enclosed in a case"/>
<rdf:Description rdf:about="&a;300253468">
	<b:glossaryEntry>(of books) having the back bound in one material and the sides in another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300253598"
	 b:glossaryEntry="(of books) having a flexible binding"/>
<rdf:Description rdf:about="&a;300253704"
	 b:glossaryEntry="(of books) having a sturdy and attractive binding"/>
<rdf:Description rdf:about="&a;300253810"
	 b:glossaryEntry='not secured within a cover; "an unbound book"'/>
<rdf:Description rdf:about="&a;300253945">
	<b:glossaryEntry>not bound or fastened or gathered together; "loose pages"; "loose papers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300254070">
	<b:glossaryEntry>being or having leaves that can be easily removed or rearranged; "loose-leaf paper"; "a looseleaf notebook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300254233">
	<b:glossaryEntry>having a border especially of a specified kind; sometimes used as a combining term; "black-bordered handkerchief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300254527">
	<b:glossaryEntry>enclosed in or set off by a border or box; "boxed sections of the report"; "boxed announcements in the newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300254692">
	<b:glossaryEntry>having a rough edge; used of handmade paper or paper resembling handmade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300254848">
	<b:glossaryEntry>having a specified kind of border or edge; "a black-edged card"; "dried sweat left salt-edged patches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300255002">
	<b:glossaryEntry>surrounded as with a border or fringe; sometimes used in combination; "a large suburban community...fringed by an industrial area"; "a grass-fringed stream"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300255212"
	 b:glossaryEntry='bordered by a line of things; "tree lined streets"'/>
<rdf:Description rdf:about="&a;300255314"
	 b:glossaryEntry="surrounded or enclosed by the sea"/>
<rdf:Description rdf:about="&a;300255401"
	 b:glossaryEntry="having no border"/>
<rdf:Description rdf:about="&a;300255474"
	 b:glossaryEntry="occupying the lowest socioeconomic position in a society"/>
<rdf:Description rdf:about="&a;300255744">
	<b:glossaryEntry>(British) not characteristic of the upper classes especially in language use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300255872"
	 b:glossaryEntry="belonging to or characteristic of the proletariat"/>
<rdf:Description rdf:about="&a;300255979">
	<b:glossaryEntry>of those who work for wages especially manual or industrial laborers; "party of the propertyless proletariat"- G.B.Shaw</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300256202"
	 b:glossaryEntry="occupying the upper part of the lower class"/>
<rdf:Description rdf:about="&a;300256309">
	<b:glossaryEntry>occupying a socioeconomic position intermediate between those of the lower classes and the wealthy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300256574"
	 b:glossaryEntry="belonging to the middle class"/>
<rdf:Description rdf:about="&a;300256659">
	<b:glossaryEntry>conforming to the standards and conventions of the middle class; "a bourgeois mentality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300256834">
	<b:glossaryEntry>occupying the lower part of the middle socioeconomic range in a society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300256970">
	<b:glossaryEntry>occupying the upper part of the middle socioeconomic range in a society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300257106"
	 b:glossaryEntry="occupying the highest socioeconomic position in a society"/>
<rdf:Description rdf:about="&a;300257329">
	<b:glossaryEntry>of high social status; "people of quality"; "a quality family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300257445"
	 b:glossaryEntry="owning land or securities as a principal source of revenue"/>
<rdf:Description rdf:about="&a;300257578">
	<b:glossaryEntry>(chiefly British) of or appropriate to the upper classes especially in language use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300257709">
	<b:glossaryEntry>of good or upper-class lineage; "a rich and wellborn husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300257825"
	 b:glossaryEntry="having a short broad head with a cephalic index of over 80"/>
<rdf:Description rdf:about="&a;300258010"
	 b:glossaryEntry="having a brachycephalic head"/>
<rdf:Description rdf:about="&a;300258126"
	 b:glossaryEntry="having a small round head"/>
<rdf:Description rdf:about="&a;300258211">
	<b:glossaryEntry>having a relatively long head with a cephalic index of under 75</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300258386"
	 b:glossaryEntry="having a dolichocephalic head"/>
<rdf:Description rdf:about="&a;300258473">
	<b:glossaryEntry>possessing or displaying courage; able to face and deal with danger or fear without flinching; "Familiarity with danger makes a brave man braver but less daring"- Herman Melville; "a frank courageous heart...triumphed over pain"- William Wordsworth"; "set a courageous example by leading them safely into and out of enemy-held territory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300259102">
	<b:glossaryEntry>showing extreme courage; especially of actions courageously undertaken in desperation as a last resort; "made a last desperate attempt to reach the climber"; "the desperate gallantry of our naval task forces marked the turning point in the Pacific war"- G.C.Marshall; "they took heroic measures to save his life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300259479">
	<b:glossaryEntry>unflinching in battle or action; "a gallant warrior"; "put up a gallant resistance to the attackers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300259633"
	 b:glossaryEntry="willing to face danger"/>
<rdf:Description rdf:about="&a;300259763"
	 b:glossaryEntry="extraordinarily courageous"/>
<rdf:Description rdf:about="&a;300259847">
	<b:glossaryEntry>used especially of persons; "a stalwart knight"; "a stouthearted fellow who had an active career in the army"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300260026"
	 b:glossaryEntry='resolutely courageous; "undaunted in the face of death"'/>
<rdf:Description rdf:about="&a;300260137">
	<b:glossaryEntry>having or showing valor; "a valiant attempt to prevent the hijack"; "a valiant soldier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300260289">
	<b:glossaryEntry>lacking courage; ignobly timid and faint-hearted; "cowardly dogs, ye will not aid me then"- P.B.Shelley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300260703"
	 b:glossaryEntry="despicably mean and cowardly"/>
<rdf:Description rdf:about="&a;300260785"
	 b:glossaryEntry="(informal) easily frightened"/>
<rdf:Description rdf:about="&a;300260941"
	 b:glossaryEntry="shrinking or flinching in fear"/>
<rdf:Description rdf:about="&a;300261043">
	<b:glossaryEntry>lacking even the rudiments of courage; abjectly fearful; "the craven fellow turned and ran"; "a craven proposal to raise the white flag"; "this recreant knight"- Spenser</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300261276">
	<b:glossaryEntry>treacherously cowardly; "the unprovoked and dastardly attack by Japan on...December 7th"- F.D. Roosevelt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300261449">
	<b:glossaryEntry xml:space='preserve'><![CDATA[lacking conviction or boldness or courage; "faint heart ne''er won fair lady"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300261600"
	 b:glossaryEntry="in a state of cowardly fright"/>
<rdf:Description rdf:about="&a;300261681"
	 b:glossaryEntry="characterized by complete cowardliness"/>
<rdf:Description rdf:about="&a;300261774">
	<b:glossaryEntry>lacking in courage and manly strength and resolution; contemptibly fearful</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300261934">
	<b:glossaryEntry>marked by courage and determination in the face of difficulties or danger; robust and uninhibited; "you have to admire her; it was a gutsy thing to do"; "the gutsy...intensity of her musical involvement"-Judith Crist; "a gutsy red wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300262240">
	<b:glossaryEntry>showing courage in the face of danger; "a plucky lampooner of the administration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300262374">
	<b:glossaryEntry>lacking courage or vitality; "he was a yellow gutless worm"; "a spineless craven fellow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300262528"
	 b:glossaryEntry="(of an infant) fed milk from the mother''s breast"/>
<rdf:Description rdf:about="&a;300262651"
	 b:glossaryEntry="(of an infant) breast-fed"/>
<rdf:Description rdf:about="&a;300262739"
	 b:glossaryEntry="(of an infant) given milk from a bottle"/>
<rdf:Description rdf:about="&a;300262835">
	<b:glossaryEntry>passing or able to pass air in and out of the lungs; something used in combination; "the boy was disappointed to find only skeletons instead of living breathing dinosaurs"; "the heavy-breathing person on the telephone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300263217">
	<b:glossaryEntry>having breath or breath as specified; usually used in combination; "sweet-breathed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300263355"
	 b:glossaryEntry="breathing out"/>
<rdf:Description rdf:about="&a;300263423"
	 b:glossaryEntry="breathing heavily"/>
<rdf:Description rdf:about="&a;300263512"
	 b:glossaryEntry="breathing in"/>
<rdf:Description rdf:about="&a;300263579">
	<b:glossaryEntry>breathing during sleep with harsh noises caused by vibration of the uvula or soft palate; "the snoring sleeper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300263744">
	<b:glossaryEntry>breathing noisily and forcefully through the nostrils; "snored with loud snorting noises"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300263888">
	<b:glossaryEntry>not breathing or able to breathe except with difficulty; "breathless at thought of what I had done"; "breathless from running"; "followed the match with breathless interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300264190"
	 b:glossaryEntry='tending to deprive of oxygen; "asphyxiating gasses"'/>
<rdf:Description rdf:about="&a;300264300">
	<b:glossaryEntry>causing difficulty in breathing especially through lack of fresh air and presence of heat; "the choking June dust"; "the smothering soft voices"; "smothering heat"; "the room was suffocating--hot and airless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300264603"
	 b:glossaryEntry="breathing laboriously or convulsively"/>
<rdf:Description rdf:about="&a;300264763">
	<b:glossaryEntry>consisting of or containing or of the nature of crystals; "granite is crystalline"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300264957">
	<b:glossaryEntry>having both internal structure and external form of a crystal; "quartz crystal is perfectly crystallized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300265121"
	 b:glossaryEntry="containing crystals that are visible only under a microscope"/>
<rdf:Description rdf:about="&a;300265244"
	 b:glossaryEntry='composed of aggregates of crystals; "polycrystalline metals"'/>
<rdf:Description rdf:about="&a;300265366"
	 b:glossaryEntry="not crystalline"/>
<rdf:Description rdf:about="&a;300265460">
	<b:glossaryEntry>without real or apparent crystalline form; "an amorphous mineral"; "amorphous structure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300265621">
	<b:glossaryEntry>owning or consisting of land or real estate; "the landed gentry"; "landed property"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300265757"
	 b:glossaryEntry='owning no land; "the landless peasantry"'/>
<rdf:Description rdf:about="&a;300265852">
	<b:glossaryEntry>characterized by or emitting light; "a room that is light when the shutters are open"; "the inside of the house was airy and light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300266341">
	<b:glossaryEntry>lighted with red light as if with flames; "streets ablaze with lighted Christmas trees"; "the inflamed clouds at sunset"; "reddened faces around the campfire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300266577">
	<b:glossaryEntry>(of living organisms) emitting light; "fireflies are bioluminescent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300266706">
	<b:glossaryEntry>having lots of light either natural or artificial; "the room was bright and airy"; "a stage bright with spotlights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300266874"
	 b:glossaryEntry="glowing from great heat"/>
<rdf:Description rdf:about="&a;300266954">
	<b:glossaryEntry>illuminated by means of floodlights; "the floodlit courtyard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300267085">
	<b:glossaryEntry>emitting light during exposure to radiation from an external source</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300267210">
	<b:glossaryEntry>provided with artificial light; "illuminated advertising"; "looked up at the lighted windows"; "a brightly lit room"; "a well-lighted stairwell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300267443">
	<b:glossaryEntry xml:space='preserve'><![CDATA[providing light; "the sun''s illuminating rays"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300267548">
	<b:glossaryEntry>emitting light as a result of being heated; "an incandescent bulb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300267683"
	 b:glossaryEntry='lighted by a lamp; "our lamplit mountain retreat"'/>
<rdf:Description rdf:about="&a;300267786">
	<b:glossaryEntry xml:space='preserve'><![CDATA[turning lights on; "it''s lighting-up time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300267889">
	<b:glossaryEntry>(of a light) imparting a deathlike luminosity; "livid lightning streaked the sky"; "a thousand flambeaux...turned all at once that deep gloom into a livid and preternatural day"- E.A.Poe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300268127"
	 b:glossaryEntry="emitting light not caused by heat"/>
<rdf:Description rdf:about="&a;300268218">
	<b:glossaryEntry>emitting light without appreciable heat as by slow oxidation of phosphorous; "the phosphorescent glow of decaying wood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300268398">
	<b:glossaryEntry>lighted by sunlight; "the sunlit slopes of the canyon"; "violet valleys and the sunstruck ridges"- Wallace Stegner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300268577">
	<b:glossaryEntry>of summer nights in northern latitudes where the sun barely sets; "white nights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300268709">
	<b:glossaryEntry>devoid or partially devoid of light or brightness; shadowed or black or somber-colored; "sitting in a dark corner"; "a dark day"; "dark shadows"; "the theater is dark on Mondays"; "dark as the inside of a black cat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300269263">
	<b:glossaryEntry>dark and dismal as of the rivers Acheron and Styx in Hades; "in the depths of an Acheronian forest"; "upon those roseate lips a Stygian hue"-Wordsworth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300269494">
	<b:glossaryEntry>lacking light; especially not reached by sunlight; "the aphotic depths of the sea where no photosynthesis occurs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300269661">
	<b:glossaryEntry>extremely dark; "a black moonless night"; "through the pitch-black woods"; "it was pitch-dark in the celler"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300269848"
	 b:glossaryEntry="dark and misty and gloomy"/>
<rdf:Description rdf:about="&a;300269930">
	<b:glossaryEntry>intensely dark and gloomy as with perpetual darkness; "the Cimmerian gloom...a darkness that could be felt"-Norman Douglas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270108">
	<b:glossaryEntry xml:space='preserve'><![CDATA[like twilight; dim; "the evening''s crepuscular charm"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270219">
	<b:glossaryEntry>become or made dark by lack of light; "a darkened house"; "the darkened theater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270354">
	<b:glossaryEntry>becoming dark or darker as from waning light or clouding over; "the darkening sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270492">
	<b:glossaryEntry>(poetic) occurring in the dark or night; "a darkling journey"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270608">
	<b:glossaryEntry>uncannily or threateningly dark or obscure; "a darkling glance"; "secret operatives and darkling conspiracies"-Archibald MacLeish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270792">
	<b:glossaryEntry>lacking in light; not bright or harsh; "a dim light beside the bed"; "subdued lights and soft music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300270952">
	<b:glossaryEntry>lighted by or as if by twilight; "The dusky night rides down the sky/And ushers in the morn"-Henry Fielding; "the twilight glow of the sky"; "a boat on a twilit river"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300271194">
	<b:glossaryEntry xml:space='preserve'><![CDATA[depressingly dark; "the gloomy forest"; "the glooming interior of an old inn"; "`gloomful'' is archaic"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300271371">
	<b:glossaryEntry>without illumination; "came up the lightless stairs"; "the unilluminated side of Mars"; "through dark unlighted (or unlit) streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300271594"
	 b:glossaryEntry='dark and gloomy; "a tenebrous cave"'/>
<rdf:Description rdf:about="&a;300271711">
	<b:glossaryEntry xml:space='preserve'><![CDATA[protected from heat and light with shade or shadow; "shaded avenues"; "o''er the shaded billows rushed the night"- Alexander Pope]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300271928">
	<b:glossaryEntry>so shaded as to be dark or gloomy; "a murky dungeon"; "murky rooms lit by smoke-blackened lamps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300272084">
	<b:glossaryEntry>filled with shade; "the shady side of the street"; "the surface of the pond is dark and shadowed"; "we sat on rocks in a shadowy cove"; "cool umbrageous woodlands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300272333">
	<b:glossaryEntry>not darkened or dimmed by shade; "an unshaded meadow"; "a bright and unshaded lane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300272489">
	<b:glossaryEntry>not darkened or obscured by shadow; "on the rough sea ice you may on an unshadowed day...fall over a chunk of ice that is kneehigh"- Vilhjalmur Stefansson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300272700">
	<b:glossaryEntry>(of pictures or drawings) drawn or painted with degrees or gradations of shadow; "the shaded areas of the face seemed to recede"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300272899"
	 b:glossaryEntry="shaded by means of fine parallel or crossed lines"/>
<rdf:Description rdf:about="&a;300273017">
	<b:glossaryEntry>(of pictures) not having shadow represented; "unshaded drawings resembling cartoons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300273174"
	 b:glossaryEntry='lacking variety in shading; "a flat unshaded painting"'/>
<rdf:Description rdf:about="&a;300273279"
	 b:glossaryEntry='lighted by moonlight; "the moonlit landscape"'/>
<rdf:Description rdf:about="&a;300273386">
	<b:glossaryEntry>without a moon or a visible moon; "the dark moonless night"; "a moonless planet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300273521"
	 b:glossaryEntry="capable of being connected by a bridge or as if by a bridge"/>
<rdf:Description rdf:about="&a;300273637">
	<b:glossaryEntry>not bridgeable; "a wide unbridgeable river"; "unbridgeable generation gap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300273770">
	<b:glossaryEntry>emitting or reflecting light readily or in large amounts; "the sun was bright and hot"; "a bright sunlit room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300274329">
	<b:glossaryEntry>bright with a steady but subdued shining; "from the plane we saw the city below agleam with lights"; "the gleaming brass on the altar"; "Nereids beneath the nitid moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300274569">
	<b:glossaryEntry>softly bright or radiant; "a house aglow with lights"; "glowing embers"; "lambent tongues of flame"; "the lucent moon"; "a sky luminous with stars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300274811">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having brief brilliant points or flashes of light; "bugle beads all aglitter"; "glinting eyes"; "glinting water"; "his glittering eyes were cold and malevolent"; "shop window full of glittering Christmas trees"; "glittery costume jewelry"; "scintillant mica"; "the scintillating stars"; "a dress with sparkly sequins"; "`glistering'' is an archaic term"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300275333">
	<b:glossaryEntry>small and round and shiny like a shiny bead or button; "bright beady eyes"; "black buttony eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300275515">
	<b:glossaryEntry>radiating or as if radiating light; "the beaming sun"; "the effulgent daffodils"; "a radiant sunrise"; "a refulgent sunset"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300275734">
	<b:glossaryEntry>shining intensely; "the blazing sun"; "blinding headlights"; "dazzling snow"; "fulgent patterns of sunlight"; "the glaring sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300275965"
	 b:glossaryEntry='off-and-on; "the blinking signal light"'/>
<rdf:Description rdf:about="&a;300276059"
	 b:glossaryEntry="(metaphor) shining brightly"/>
<rdf:Description rdf:about="&a;300276157">
	<b:glossaryEntry>full of light; shining intensely; "a brilliant star"; "brilliant chandeliers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300276290">
	<b:glossaryEntry>glowing or shining like fire; "from rank to rank she darts her ardent eyes"- Alexander Pope; "frightened by his ardent burning eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300276475">
	<b:glossaryEntry>emitting light in sudden short or intermittent bursts; "flashing lightning and roaring thunder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300276625">
	<b:glossaryEntry>shining softly and intermittently; "the glimmering mist of a spring rain splashed by sun and streaked by rainbow"- Claudia Cassidy; "glimmering candlelight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300276849">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reflecting light; "glistening bodies of swimmers"; "the horse''s glossy coat"; "lustrous auburn hair"; "saw the moon like a shiny dime on a deep blue velvet carpet"; "shining white enamel"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300277140">
	<b:glossaryEntry>having a play of lustrous rainbow-like colors; "an iridescent oil slick"; "nacreous (or pearlescent) clouds looking like mother-of-pearl"; "a milky opalescent (or opaline) luster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300277424">
	<b:glossaryEntry>shining with an unnatural red glow as of fire seen through smoke; "a lurid sunset"; "lurid flames"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300277574"
	 b:glossaryEntry='shining or glowing by night; "the noctilucent eyes of a cat"'/>
<rdf:Description rdf:about="&a;300277692">
	<b:glossaryEntry>glistening tremulously; "the shimmering surface of the lake"; "a dress of shimmery satin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300277852">
	<b:glossaryEntry>emitting or radiating light; "the shining sun"; "gazed up at the shining heavens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300277987"
	 b:glossaryEntry='reflecting an inner radiance; "with shining eyes"'/>
<rdf:Description rdf:about="&a;300278090">
	<b:glossaryEntry>having the white lustrous sheen of silver; "a land of silver (or silvern) rivers where the salmon leap"; "repeated scrubbings have given the wood a silvery sheen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300278325">
	<b:glossaryEntry>shining intermittently with a sparkling light; "twinkling stars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300278448">
	<b:glossaryEntry>emitting or reflecting very little light; "a dull glow"; "dull silver badly in need of a polish"; "a dull sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300278681">
	<b:glossaryEntry>not reflecting light; not glossy; "flat wall paint"; "a photograph with a matte finish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300278849">
	<b:glossaryEntry>lacking luster or shine; "staring with lackluster eyes"; "lusterless hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300279019">
	<b:glossaryEntry>made dim or less bright; "the dimmed houselights brought a hush of anticipation"; "dimmed headlights"; "we like dimmed lights when we have dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300279242"
	 b:glossaryEntry='used of headlights; "following with low-beam headlights"'/>
<rdf:Description rdf:about="&a;300279356">
	<b:glossaryEntry>not made dim or less bright; "undimmed headlights"; "surprisingly the curtain started to rise while the houselights were still undimmed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300279556">
	<b:glossaryEntry>being biased or having a belief or attitude formed beforehand; "a prejudiced judge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300279785">
	<b:glossaryEntry>showing or affected by prejudice or envy or distaste; "looked with a jaundiced eye on the growth of regimentation"; "takes a jaundiced view of societies and clubs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300280004">
	<b:glossaryEntry>(of statements or questions) charged with associative significance and often meant to mislead or influence; "a loaded question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300280184"
	 b:glossaryEntry="discriminatory especially on the basis of race or religion"/>
<rdf:Description rdf:about="&a;300280339"
	 b:glossaryEntry="discriminatory on the basis of sex"/>
<rdf:Description rdf:about="&a;300280426">
	<b:glossaryEntry>free from undue bias or preconceived opinions; "an unprejudiced appraisal of the pros and cons"; "the impartial eye of a scientist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300280664"
	 b:glossaryEntry="unprejudiced about race"/>
<rdf:Description rdf:about="&a;300280772"
	 b:glossaryEntry='receptive to new ideas; "an open mind"; "open to new ideas"'/>
<rdf:Description rdf:about="&a;300280882">
	<b:glossaryEntry>inclined to respect views and beliefs that differ from your own; "a judge who is broad-minded but even-handed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300281123">
	<b:glossaryEntry xml:space='preserve'><![CDATA[showing or characterized by broad-mindedness; "a broad political stance"; "generous and broad sympathies"; "a liberal newspaper"; "tolerant of his opponent''s opinions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300281363">
	<b:glossaryEntry xml:space='preserve'><![CDATA[free from provincial prejudices or attachments; "catholic in one''s tastes"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300281492">
	<b:glossaryEntry>unwilling to accept authority or dogma (especially in religion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300281660">
	<b:glossaryEntry>ready to entertain new ideas; "an open-minded curiosity"; "open-minded impartiality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300281802">
	<b:glossaryEntry>lacking tolerance or flexibility or breadth of view; "a brilliant but narrow-minded judge"; "narrow opinions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300282089"
	 b:glossaryEntry="not ready to receive to new ideas"/>
<rdf:Description rdf:about="&a;300282197">
	<b:glossaryEntry>characterized by arrogant assertion of unproved or unprovable principles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300282337"
	 b:glossaryEntry="narrow-minded about cherished opinions"/>
<rdf:Description rdf:about="&a;300282444"
	 b:glossaryEntry="obstinate in your opinions"/>
<rdf:Description rdf:about="&a;300282562">
	<b:glossaryEntry>contemptibly narrow in outlook; "a little mind consumed with trivia"; "petty little comments"; "disgusted with the pettiness of small minds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300282786">
	<b:glossaryEntry>adapted to social or economic change; "a reconstructed feminist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300282910">
	<b:glossaryEntry>adhering to an attitude or position widely held to be outmoded; "peasants are still unreconstructed small capitalists at heart"; "there are probably more unreconstructed Southerners than one would like to admit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300283201"
	 b:glossaryEntry="persisting in a reactionary stand"/>
<rdf:Description rdf:about="&a;300283316">
	<b:glossaryEntry>physically and forcibly separated into pieces or cracked or split; or legally or emotionally destroyed; "a broken mirror"; "a broken tooth"; "a broken leg"; "his neck is broken"; "children from broken homes"; "a broken marriage"; "a broken heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300283903">
	<b:glossaryEntry>forcibly broken through or opened up; "the enemy poured through the breached line of defense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300284051">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(used informally especially of bones) fractured; "my arm is busted"; "I got my head busted in the fight"; "can''t play with a busted baseball bat"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300284249"
	 b:glossaryEntry='having a small piece broken off; "a chipped tooth"'/>
<rdf:Description rdf:about="&a;300284353">
	<b:glossaryEntry>broken without being divided into parts but having fissures appear on the surface; "a cracked mirror"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300284508"
	 b:glossaryEntry='broken into small fragments; "crumbled cookies"'/>
<rdf:Description rdf:about="&a;300284623">
	<b:glossaryEntry>broken or pounded into small fragments; used of e.g. ore or stone; "paved with crushed bluestone"; "ground glass is used as an abrasive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300284822">
	<b:glossaryEntry>sundered by divorce or separation or desertion; "a dissolved marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300284948">
	<b:glossaryEntry>used of a break or crack or tear in bone or cartilage; "serious injuries such as broken bones and fractured skulls"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300285119">
	<b:glossaryEntry>broken into sharp pieces; "shattered glass"; "your eyeglasses are smashed"; "the police came in through the splintered door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300285322">
	<b:glossaryEntry>broken or burst apart longitudinally; "after the thunderstorm we found a tree with a split trunk"; "they tore big juicy chunks from the heart of the split watermelon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300285540">
	<b:glossaryEntry>not broken; whole and intact; in one piece; "fortunately the other lens is unbroken"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300285787"
	 b:glossaryEntry='not fractured; "X-rays showed the skull to be unfractured"'/>
<rdf:Description rdf:about="&a;300285903">
	<b:glossaryEntry>(especially of promises or contracts) having been violated or disregarded; "broken (or unkept) promises"; "broken contracts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300286089">
	<b:glossaryEntry>(especially of promises or contracts) not violated or disregarded; "unbroken promises"; "promises kept"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300286254">
	<b:glossaryEntry>not continuous in space, time, or sequence or varying abruptly; "broken lines of defense"; "a broken cable transmission"; "broken sleep"; "tear off the stub above the broken line"; "a broken note"; "broken sobs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300286608">
	<b:glossaryEntry>(football) varying in direction suddenly and frequently; "broken-field running"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300286746"
	 b:glossaryEntry='having gaps or spaces; "sign on the dotted line"'/>
<rdf:Description rdf:about="&a;300286856">
	<b:glossaryEntry>intermittently stopping and starting; "fitful (or interrupted) sleep"; "off-and-on static"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300287029">
	<b:glossaryEntry>fragmentary or halting from emotional strain; "uttered a few broken words of sorrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300287167">
	<b:glossaryEntry>marked by continuous or uninterrupted extension in space or time or sequence; "cars in an unbroken procession"; "the unbroken quiet of the afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300287425">
	<b:glossaryEntry>uninterrupted in space; having no gaps or breaks; "a solid line across the page"; "solid sheets of water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300287582">
	<b:glossaryEntry>having undisturbed continuity; "a convalescent needs uninterrupted sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300287715">
	<b:glossaryEntry>like or characteristic of or befitting a brother; "brotherly feelings"; "close fraternal ties"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300287891">
	<b:glossaryEntry>like or characteristic of or befitting a sister; "sisterly kindness"; "sororal concern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300288055">
	<b:glossaryEntry>(of twins) derived from two separate fertilized ova; "fraternal twins are biovular"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300288205">
	<b:glossaryEntry>(of twins) derived from a single egg or ovum; "identical twins are monovular"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300288350"
	 b:glossaryEntry='placed in a grave; "the hastily buried corpses"'/>
<rdf:Description rdf:about="&a;300288489">
	<b:glossaryEntry>underneath the ground; "most of his friends are now belowground"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300288611"
	 b:glossaryEntry="not buried"/>
<rdf:Description rdf:about="&a;300288676">
	<b:glossaryEntry>actively or fully engaged or occupied; "busy with her work"; "a busy man"; "too busy to eat lunch"; "the line is busy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300289007">
	<b:glossaryEntry>on the job; "had been at work for over an hour before her boss arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300289135">
	<b:glossaryEntry>doing arduous or unpleasant work; "drudging peasants"; "the bent backs of laboring slaves picking cotton"; "toiling coal miners in the black deeps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300289370">
	<b:glossaryEntry>having ones attention or mind or energy engaged; "she keeps herself fully occupied with volunteer activities"; "deeply engaged in conversation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300289578"
	 b:glossaryEntry="too busy"/>
<rdf:Description rdf:about="&a;300289641">
	<b:glossaryEntry xml:space='preserve'><![CDATA[kept occupied or engaged; "she''s tied up at the moment and can''t see you"; "the phone was tied up for almost an hour"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300289815">
	<b:glossaryEntry>busy or occupied with; "what have you been up to?"; "up to no good"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300289934">
	<b:glossaryEntry>not in action or at work; "an idle laborer"; "idle drifters"; "the idle rich"; "an idle mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300290240"
	 b:glossaryEntry="not engaged or employed or occupied"/>
<rdf:Description rdf:about="&a;300290335"
	 b:glossaryEntry="(informal) constitutionally lazy or idle"/>
<rdf:Description rdf:about="&a;300290443">
	<b:glossaryEntry>disinclined to work or exertion; "faineant kings under whose rule the country languished"; "an indolent hanger-on"; "too lazy to wash the dishes"; "shiftless idle youth"; "slothful employees"; "the unemployed are not necessarily work-shy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300290785">
	<b:glossaryEntry>shirking your assigned duties; "too many goldbricking employees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300290911">
	<b:glossaryEntry>idle or indolent especially in a dreamy way; "she was annoyingly lackadaisical and impractical"; "a...lackadaisical, spiritless young man-about-town"- P.G.Wodehouse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300291135">
	<b:glossaryEntry>free from duties or responsibilities; "he writes in his leisure hours"; "life as it ought to be for the leisure classes"- J.J.Chapman; "even the artist and the sculptor were not regarded...as leisured men"- Ida Craven</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300291420">
	<b:glossaryEntry>not busy or occupied; free; "the cancellation left her unengaged a good part of the afternoon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300291570">
	<b:glossaryEntry>having bones especially many or prominent bones; "a bony shad fillet"; "her bony wrist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300291788">
	<b:glossaryEntry>consisting of or made up of bone; "a bony substance"; "the bony framework of the body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300291928">
	<b:glossaryEntry>(combining form) having bones as specified; "his lanky long-boned body"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300292051"
	 b:glossaryEntry='resembling bone; "a bonelike tumor"'/>
<rdf:Description rdf:about="&a;300292141"
	 b:glossaryEntry="having strong bones"/>
<rdf:Description rdf:about="&a;300292219"
	 b:glossaryEntry='being without a bone or bones; "jellyfish are boneless"'/>
<rdf:Description rdf:about="&a;300292347">
	<b:glossaryEntry>having had the bones removed; "a boneless rib roast"; "a boned (or deboned) fish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300292490"
	 b:glossaryEntry="furnished or closed with buttons or something buttonlike"/>
<rdf:Description rdf:about="&a;300292648">
	<b:glossaryEntry>(of a heraldic cross) having a cluster of three buttons or knobs at the end of each arm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300292800">
	<b:glossaryEntry>of a shirt; having the ends of the collar fastened down by buttons; "Brooks Brothers button-down shirts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300292962">
	<b:glossaryEntry>not buttoned; "the wind picked up the hem of her unbuttoned coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300293115">
	<b:glossaryEntry>of a shirt; not buttoned at the neck; "dressed casually in shorts and an open-collared shirt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300293268"
	 b:glossaryEntry="favoring or practicing capitalism"/>
<rdf:Description rdf:about="&a;300293427">
	<b:glossaryEntry>(according to Marxist thought) being of the property-owning class and exploitive of the working class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300293584"
	 b:glossaryEntry="subscribing to capitalistic competition"/>
<rdf:Description rdf:about="&a;300293726"
	 b:glossaryEntry="with minimally restricted freedom in commerce"/>
<rdf:Description rdf:about="&a;300293852">
	<b:glossaryEntry>advocating or following the socialist principles; "socialistic government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300294050">
	<b:glossaryEntry>set up on the principle of collectivism or ownership and production by the workers involved usually under the supervision of a government; "collective farms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300294264">
	<b:glossaryEntry>subscribing to the socialistic doctrine of ownership by the people collectively</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300294454">
	<b:glossaryEntry>having an unpleasant sound; "as cacophonous as a henyard"- John McCarten</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300294777">
	<b:glossaryEntry>like the cackles or squawks a hen makes especially after laying an egg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300294910">
	<b:glossaryEntry>like the sounds of frogs and crows; "a guttural voice"; "acres of guttural frogs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300295066"
	 b:glossaryEntry='unpleasantly harsh or grating in sound; "a gravelly voice"'/>
<rdf:Description rdf:about="&a;300295224">
	<b:glossaryEntry xml:space='preserve'><![CDATA[deep and harsh sounding as if from shouting or illness or emotion; "gruff voices"; "the dog''s gruff barking"; "hoarse cries"; "makes all the instruments sound powerful but husky:- Virgil Thomson]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300295487">
	<b:glossaryEntry>like the discordant ringing of nonmusical metallic objects striking together; "cowboys with jangling spurs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300295658">
	<b:glossaryEntry>making or causing a harsh and irritating sound; "the jarring noise of the iron gate scraping on the sidewalk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300295821"
	 b:glossaryEntry='loud and sharp; "the piercing shriek of sirens"'/>
<rdf:Description rdf:about="&a;300295923"
	 b:glossaryEntry="unpleasantly loud and harsh"/>
<rdf:Description rdf:about="&a;300296015">
	<b:glossaryEntry>resembling a sound of violent tearing as of something ripped apart or lightning splitting a tree; "the tree split with a great ripping sound"; "heard a rending roar as the crowd surged forward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300296284">
	<b:glossaryEntry>having a pleasant sound; "a euphonious trill of silver laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300296453"
	 b:glossaryEntry='suggestive of gold; "a golden voice"'/>
<rdf:Description rdf:about="&a;300296542">
	<b:glossaryEntry>resembling or reminiscent of silver; "a soft silvern voice"; "singing in her silvery tones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300296697">
	<b:glossaryEntry>capable of being calculated or estimated; "a calculable risk"; "calculable odds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300296924">
	<b:glossaryEntry>determined by mathematical computation; "the calculated velocity of a bullet"; "a derived value"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300297087">
	<b:glossaryEntry>may be computed or estimated; "a calculable risk"; "computable odds"; "estimable assets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300297244"
	 b:glossaryEntry='that can be counted; "countable sins"; "numerable assets"'/>
<rdf:Description rdf:about="&a;300297396"
	 b:glossaryEntry='calculated approximately; "an estimated mass of 25 g"'/>
<rdf:Description rdf:about="&a;300297505"
	 b:glossaryEntry="not capable of being calculated"/>
<rdf:Description rdf:about="&a;300297667">
	<b:glossaryEntry>too numerous to be counted; "incalculable riches"; "countless hours"; "an infinite number of reasons"; "innumerable difficulties"; "the multitudinous seas"; "myriad stars"; "untold thousands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300298047">
	<b:glossaryEntry>beyond calculation or measure; "of incalculable value"; "an incomputable amount"; "jewels of inestimable value"; "immeasurable wealth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300298269"
	 b:glossaryEntry="unable to be determined"/>
<rdf:Description rdf:about="&a;300298353"
	 b:glossaryEntry='(of weather) free from storm or wind; "calm seas"'/>
<rdf:Description rdf:about="&a;300298525">
	<b:glossaryEntry>free from disturbance; "a ribbon of sand between the angry sea and the placid bay"; "the quiet waters of a lagoon"; "a lake of tranquil blue water reflecting a tranquil blue sky"; "a smooth channel crossing"; "scarcely a ripple on the still water"; "unruffled water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300298883"
	 b:glossaryEntry='not changeable; "a period of settled weather"'/>
<rdf:Description rdf:about="&a;300298982">
	<b:glossaryEntry>without or almost without wind; "he prefers windless days for playing golf"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300299112">
	<b:glossaryEntry>(especially of weather) affected or characterized by storms or commotion; "a stormy day"; "wide and stormy seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300299475">
	<b:glossaryEntry>(of the elements) as if showing violent anger; "angry clouds on the horizon"; "furious winds"; "the raging sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300299678">
	<b:glossaryEntry>characterized by great swelling waves or surges; "billowy storm clouds"; "the restless billowing sea"; "surging waves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300299875">
	<b:glossaryEntry>blowing in loud and abrupt bursts; "blustering (or blusterous) winds of Patagonia"; "a cold blustery day"; "a gusty storm with strong sudden rushes of wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300300123">
	<b:glossaryEntry>violently agitated and turbulent; "boisterous winds and waves"; "the fierce thunders roar me their music"- Ezra Pound; "rough weather"; "rough seas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300300345">
	<b:glossaryEntry>abounding in or exposed to the wind or breezes; "blowy weather"; "a windy bluff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300300494"
	 b:glossaryEntry='rough with small waves; "choppy seas"'/>
<rdf:Description rdf:about="&a;300300584">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unpleasantly stormy; "there''s dirty weather in the offing"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300300694">
	<b:glossaryEntry>characterized by brief periods of violent wind or rain; "a gray squally morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300300828"
	 b:glossaryEntry="accompanied with thunder"/>
<rdf:Description rdf:about="&a;300300907"
	 b:glossaryEntry='impregnated with camphor; "camphorated oil"'/>
<rdf:Description rdf:about="&a;300301008"
	 b:glossaryEntry="not containing camphor"/>
<rdf:Description rdf:about="&a;300301090">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `of'') having capacity or ability; "capable of winning"; "capable of hard work"; "capable of walking on two feet"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300301385">
	<b:glossaryEntry>having inherent physical or mental ability or capacity; "able to learn"; "human beings are able to walk on two feet"; "Superman is able to leap tall buildings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300301595">
	<b:glossaryEntry>not liable to error in judgment or action; "most surefooted of the statesmen who dealt with the depression"- Walter Lippman; "demonstrates a surefooted storytelling talent"- Michiko Kakutani</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300301854">
	<b:glossaryEntry>having inner resources; adroit or imaginative; "someone who is resourceful is capable of dealing with difficult situations"; "an able and resourceful politician"; "the most resourceful cook in town"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300302110">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `of'') lacking capacity or ability; "incapable of carrying a tune"; "he is incapable of understanding the matter"; "incapable of doing the work"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300302394">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') lacking necessary physical or mental ability; "dyslexics are unable to learn to read adequately;" "the sun was unable to melt enough snow"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300302615">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `of'') having the temperament or inclination for; "no one believed her capable of murder"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300302770">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(followed by `of'') not having the temperament or inclination for; "simply incapable of lying"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300302919"
	 b:glossaryEntry='having needed care and attention; "well-cared-for children"'/>
<rdf:Description rdf:about="&a;300303052"
	 b:glossaryEntry="having a caretaker or other watcher"/>
<rdf:Description rdf:about="&a;300303157"
	 b:glossaryEntry="lacking needed care and attention"/>
<rdf:Description rdf:about="&a;300303284">
	<b:glossaryEntry>lacking a caretaker; "a neglected child"; "many casualties were lying unattended"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300303434">
	<b:glossaryEntry>lacking care and attention; "untended garden was soon overgrown with weeds"; "untended children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300303585">
	<b:glossaryEntry xml:space='preserve'><![CDATA[exercising caution or showing care or attention; "they were careful when crossing the busy street"; "be careful to keep her shoes clean"; "did very careful research"; "careful art restorers"; "careful of the rights of others"; "careful about one''s behavior"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300304166">
	<b:glossaryEntry>cautious in attitude and careful in actions; prudent; "a cautious answer"; "very cautious about believing everything she was told"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300304351">
	<b:glossaryEntry>exercising or taking care great enough to bring assurance; "be certain to disconnect the iron when you are through"; "be sure to lock the doors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300304556">
	<b:glossaryEntry>rigorously attentive; strict and thorough; "close supervision"; "paid close attention"; "a close study"; "kept a close watch on expenditures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300304749">
	<b:glossaryEntry>characterized by extreme care and great effort; "conscientious application to the work at hand"; "painstaking research"; "scrupulous attention to details"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300304990">
	<b:glossaryEntry>developed or executed with care and in minute detail; "a detailed plan"; "the elaborate register of the inhabitants prevented tax evasion"- John Buchan; "the carefully elaborated theme"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300305255">
	<b:glossaryEntry>characterized by painstaking care and detailed examination; "a minute inspection of the grounds"; "a narrow scrutiny"; "an exact and minute report"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300305464"
	 b:glossaryEntry="excessively or unduly careful"/>
<rdf:Description rdf:about="&a;300305565">
	<b:glossaryEntry>providing specific details or circumstances; "a particular description of the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300305708">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `of'') solicitously caring or mindful; "protective of his reputation"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300305857">
	<b:glossaryEntry>marked by care and effort; "made a studious attempt to fix the television set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300305990">
	<b:glossaryEntry>painstakingly careful and accurate; "our accountant is thorough"; "thorough research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300306130">
	<b:glossaryEntry>marked by lack of attention or consideration or forethought or thoroughness; not careful; "careless about her clothes"; "forgotten by some careless person"; "a careless housekeeper"; "careless proofreading"; "it was a careless mistake"; "hurt by a careless remark"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300306683">
	<b:glossaryEntry xml:space='preserve'><![CDATA[hasty and without attention to detail; not thorough; "a casual (or cursory) inspection failed to reveal the house''s structural flaws"; "a passing glance"; "perfunctory courtesy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300306950">
	<b:glossaryEntry>marked by great carelessness; "a most haphazard system of record keeping"; "slapdash work"; "slipshod spelling"; "sloppy workmanship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300307170">
	<b:glossaryEntry>characterized by careless unconcerned; "the heedless generosity and the spasmodic extravagance of persons used to large fortunes"- Edith Wharton; "reckless squandering of public funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300307420">
	<b:glossaryEntry>without out proper caution; "an incautious step sent her headlong down the stairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300307559">
	<b:glossaryEntry>marked by insufficient care or attention; "a negligent housekeeper"; "negligent about personal cleanliness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300307722">
	<b:glossaryEntry>casually thoughtless or inconsiderate; "an offhand manner"; "she treated most men with offhand contempt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300307892">
	<b:glossaryEntry>(used of plants as well as animals) feeding on animals; "carnivorous plants are capable of trapping and digesting small animals especially insects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300308187"
	 b:glossaryEntry="(of animals) carnivorous"/>
<rdf:Description rdf:about="&a;300308303"
	 b:glossaryEntry="feeding on fishes"/>
<rdf:Description rdf:about="&a;300308378"
	 b:glossaryEntry="hunting and killing other animals for food"/>
<rdf:Description rdf:about="&a;300308477"
	 b:glossaryEntry="feeding only on plants"/>
<rdf:Description rdf:about="&a;300308683"
	 b:glossaryEntry='feeding on flowers; "some insects are anthophagous"'/>
<rdf:Description rdf:about="&a;300308808"
	 b:glossaryEntry="feeding on berries"/>
<rdf:Description rdf:about="&a;300308884"
	 b:glossaryEntry="feeding on fruit"/>
<rdf:Description rdf:about="&a;300308977"
	 b:glossaryEntry="feeding on grasses"/>
<rdf:Description rdf:about="&a;300309057"
	 b:glossaryEntry="(of animals) feeding on plants"/>
<rdf:Description rdf:about="&a;300309193"
	 b:glossaryEntry="feeding on both plants and animals"/>
<rdf:Description rdf:about="&a;300309338"
	 b:glossaryEntry="(of animals) both plant-eating and flesh-eating"/>
<rdf:Description rdf:about="&a;300309448"
	 b:glossaryEntry="(of animals and plants) feeding on insects"/>
<rdf:Description rdf:about="&a;300309622"
	 b:glossaryEntry="feeding on bees"/>
<rdf:Description rdf:about="&a;300309693"
	 b:glossaryEntry="feeding on ants but usually not living with them"/>
<rdf:Description rdf:about="&a;300309802">
	<b:glossaryEntry>obtaining nourishment as animals do by ingesting complex organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300309928"
	 b:glossaryEntry="obtaining nourishment as green plants do"/>
<rdf:Description rdf:about="&a;300310025"
	 b:glossaryEntry="(botany) bearing or consisting of carpels"/>
<rdf:Description rdf:about="&a;300310136"
	 b:glossaryEntry="(botany) having no carpels"/>
<rdf:Description rdf:about="&a;300310233">
	<b:glossaryEntry>covered with or as if with carpeting or with carpeting as specified; often used in combination; "the carpeted hallway"; "a flower-carpeted hillside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300310436"
	 b:glossaryEntry='not carpeted; "bare uncarpeted floors"'/>
<rdf:Description rdf:about="&a;300310531">
	<b:glossaryEntry>(of ships) built with flush (rather than overlapping) hull planks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300310673"
	 b:glossaryEntry="laid edge-to-edge (not overlapping)"/>
<rdf:Description rdf:about="&a;300310767"
	 b:glossaryEntry="(of ships) built with overlapping hull planks"/>
<rdf:Description rdf:about="&a;300310907"
	 b:glossaryEntry="laid overlapping (not flush)"/>
<rdf:Description rdf:about="&a;300311062">
	<b:glossaryEntry xml:space='preserve'><![CDATA[made for formed by carving (`carven'' is archaic or literary); "the carved fretwork"; "an intricately carved door"; "stood as if carven from stone"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300311342">
	<b:glossaryEntry>cut or impressed into a surface; "an incised design"; "engraved invitations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300311513">
	<b:glossaryEntry>cut into a desired shape; "graven images"; "sculptured representations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300311661"
	 b:glossaryEntry='inscribed on stone; "a lapidarian record"'/>
<rdf:Description rdf:about="&a;300311759"
	 b:glossaryEntry="used of meat; cut into pieces for serving"/>
<rdf:Description rdf:about="&a;300311853"
	 b:glossaryEntry="not carved"/>
<rdf:Description rdf:about="&a;300311918">
	<b:glossaryEntry>(verse) metrically complete; especially having the full number of syllables in the final metrical foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300312096">
	<b:glossaryEntry>(verse) metrically incomplete; especially lacking one or more syllables in the final metrical foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300312269">
	<b:glossaryEntry>(verse) having an extra syllable or syllables at the end of a metrically complete verse or in a metrical foot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300312458">
	<b:glossaryEntry>(botany) especially of leaves; growing on a stem especially on the upper part of a stem; "cauline leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300312617">
	<b:glossaryEntry>(botany) especially of leaves; located at the base of a plant or stem; especially arising directly from the root or rootstock or a root-like stem; "basal placentation"; "radical leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300312864">
	<b:glossaryEntry>suppressed or subject to censorship; "the censored press in some countries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300313012">
	<b:glossaryEntry>having material deleted; "at that time even Shakespeare was considered dangerous except in the expurgated versions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300313184"
	 b:glossaryEntry='not subject to censorship; "uncensored news reports"'/>
<rdf:Description rdf:about="&a;300313311">
	<b:glossaryEntry>not having material deleted; "volumes of the best plays, unexpurgated"- Havelock Ellis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300313456"
	 b:glossaryEntry="(zoology) having a tail or taillike appendage"/>
<rdf:Description rdf:about="&a;300313656"
	 b:glossaryEntry='having a short or shortened tail; "bobtail mare"'/>
<rdf:Description rdf:about="&a;300313770"
	 b:glossaryEntry="resembling a tail"/>
<rdf:Description rdf:about="&a;300313851"
	 b:glossaryEntry="having a tail"/>
<rdf:Description rdf:about="&a;300313917">
	<b:glossaryEntry>(of birds) having a deeply forked tail; "scissor-tailed birds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300314040">
	<b:glossaryEntry>(especially of butterflies and birds) having a forked tail like that of a swallow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300314182"
	 b:glossaryEntry="(zoology) lacking a tail or taillike appendage"/>
<rdf:Description rdf:about="&a;300314311"
	 b:glossaryEntry='not having a tail; "anurous toads and frogs"'/>
<rdf:Description rdf:about="&a;300314420"
	 b:glossaryEntry="(botany) producing a well-developed stem above ground"/>
<rdf:Description rdf:about="&a;300314550"
	 b:glossaryEntry="(botany) having no apparent stem above ground"/>
<rdf:Description rdf:about="&a;300314664">
	<b:glossaryEntry>producing an effect; "poverty as a causative factor in crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300315015"
	 b:glossaryEntry="causing abortion"/>
<rdf:Description rdf:about="&a;300315091"
	 b:glossaryEntry="causing motion or action or change"/>
<rdf:Description rdf:about="&a;300315200">
	<b:glossaryEntry>causing loss of appetite; "an anorectic (or anorexigenic) drug"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300315334">
	<b:glossaryEntry>caused to be realized; "it was borne in upon us how close we had been to disaster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300315479">
	<b:glossaryEntry>involving or constituting a cause; causing; "a causal relationship between scarcity and higher prices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300315634">
	<b:glossaryEntry>tending to bring about; being partly responsible for; "working conditions are not conducive to productivity"; "the seaport was a contributing factor in the growth of the city"; "a contributory factor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300315938"
	 b:glossaryEntry="causing nasal discharge"/>
<rdf:Description rdf:about="&a;300316015">
	<b:glossaryEntry>inducing or influencing; leading on; "inductive to the sin of Eve"- John Milton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300316161">
	<b:glossaryEntry>impelling to action; "it may well be that ethical language has primarily a motivative function"- Arthur Pap; "motive pleas"; "motivating arguments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300316393">
	<b:glossaryEntry>causing or able to cause motion; "a motive force"; "motive power"; "motor energy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300316538">
	<b:glossaryEntry>bringing on suddenly or abruptly; "the completion of the railroad was the precipitating cause in the extinction of water-borne commerce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300316737">
	<b:glossaryEntry>being the agent or cause; "determined who was the responsible party"; "termites were responsible for the damage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300316928"
	 b:glossaryEntry='causing sneezing; "pepper is a sternutatory substance"'/>
<rdf:Description rdf:about="&a;300317056"
	 b:glossaryEntry="not causative"/>
<rdf:Description rdf:about="&a;300317140">
	<b:glossaryEntry>showing careful forethought; "reserved and cautious; never making swift decisions"; "a cautious driver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300317424">
	<b:glossaryEntry>characterized by great cautious and wariness; "a cagey avoidance of a definite answer"; "chary of the risks involved"; "a chary investor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300317628">
	<b:glossaryEntry>using cautious slow strategy to wear down opposition; avoiding direct confrontation; "a fabian policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300317794">
	<b:glossaryEntry>with extreme care or delicacy; "they proceeded with gingerly footwork over the jagged stones"; "the issue was handled only in a gingerly way"- W.S.White</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300318001"
	 b:glossaryEntry='prudent; "guarded optimism"'/>
<rdf:Description rdf:about="&a;300318095">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unnecessarily cautious; "sometimes it doesn''t pay to be overcautious in business"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300318235">
	<b:glossaryEntry>lacking in caution; "an incautious remark"; "incautious talk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300318407">
	<b:glossaryEntry xml:space='preserve'><![CDATA[characterized by undue haste and lack of thought or deliberation; "a hotheaded decision"; "liable to such impulsive acts as hugging strangers"; "an impetuous display of spending and gambling"; "madcap escapades"; (`brainish'' is archaic)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300318757">
	<b:glossaryEntry>characterized by or divided into or containing cells or compartments (the smallest organizational or structural unit of an organism or organization); "the cellular construction of a beehive"; "any effective opposition to a totalitarian regime must be secretive and cellular"; "a cellular phone uses a network of shortrange transmitters located in overlapping cells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300319249"
	 b:glossaryEntry="(anatomy) having an open or latticed or porous structure"/>
<rdf:Description rdf:about="&a;300319389"
	 b:glossaryEntry="pitted with cell-like cavities (as a honeycomb)"/>
<rdf:Description rdf:about="&a;300319538"
	 b:glossaryEntry="resembling a cell"/>
<rdf:Description rdf:about="&a;300319611"
	 b:glossaryEntry='consisting of many cells; "multicellular organisms"'/>
<rdf:Description rdf:about="&a;300319722"
	 b:glossaryEntry="not made up of or divided into cells"/>
<rdf:Description rdf:about="&a;300319846">
	<b:glossaryEntry>lacking cells; "cell-free systems"; "a cell-free homogenate of the thyroid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300319977">
	<b:glossaryEntry>divided up or separated into compartments or isolated units; "a compartmented box"; "the protected and compartmented society of Beacon Hill"- John Mason Brown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300320213">
	<b:glossaryEntry>divided up into compartments or categories; "most sciences have become woefully compartmentalized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300320391">
	<b:glossaryEntry>not compartmented; not divided into compartments or isolated units</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300320519"
	 b:glossaryEntry="full of pores or vessels or holes"/>
<rdf:Description rdf:about="&a;300320636"
	 b:glossaryEntry='forming a continuous series of pores; "a porose hymenium"'/>
<rdf:Description rdf:about="&a;300320746">
	<b:glossaryEntry>not porous; especially not having vessels that appear as pores; "nonporous wood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300320882"
	 b:glossaryEntry="(of a cartridge) fired by striking the center of the base"/>
<rdf:Description rdf:about="&a;300321015"
	 b:glossaryEntry="(of a cartridge) fired by striking the center of the base"/>
<rdf:Description rdf:about="&a;300321131"
	 b:glossaryEntry="(of a cartridge) fired by striking the rim of the base"/>
<rdf:Description rdf:about="&a;300321239">
	<b:glossaryEntry>of a temperature scale that registers the freezing point of water as 0 degrees C and the boiling point as 100 degrees C under normal atmospheric pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300321463">
	<b:glossaryEntry>of a temperature scale that registers the freezing point of water as 32 degrees F and the boiling point as 212 degrees F at one atmosphere of pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300321681">
	<b:glossaryEntry>in or near a center or constituting a center; "a central position" "central heating and air conditioning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300322020"
	 b:glossaryEntry="located in the middle part of a ship or aircraft"/>
<rdf:Description rdf:about="&a;300322123"
	 b:glossaryEntry="having two centers"/>
<rdf:Description rdf:about="&a;300322197"
	 b:glossaryEntry='(optics) having two foci; "bifocal eyeglasses"'/>
<rdf:Description rdf:about="&a;300322297"
	 b:glossaryEntry="equally distant from the extremes"/>
<rdf:Description rdf:about="&a;300322417"
	 b:glossaryEntry="being or placed in the center"/>
<rdf:Description rdf:about="&a;300322501"
	 b:glossaryEntry="having or situated at or near a center"/>
<rdf:Description rdf:about="&a;300322605">
	<b:glossaryEntry>having or localized centrally at a focus; "focal point"; "focal infection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300322731"
	 b:glossaryEntry="relating to or situated in or extending toward the middle"/>
<rdf:Description rdf:about="&a;300322850"
	 b:glossaryEntry="being in the exact middle"/>
<rdf:Description rdf:about="&a;300322942">
	<b:glossaryEntry>constituting or like a nucleus; "annexation of the suburban fringe by the nuclear metropolis"; "the nuclear core of the congregation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300323129">
	<b:glossaryEntry xml:space='preserve'><![CDATA[on or near an edge or constituting an outer boundary; "russia''s peripheral provinces"; "peripheral vision"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300323364">
	<b:glossaryEntry>lying around or just outside the edges or outskirts; "circumferential highways around cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300323519">
	<b:glossaryEntry>at or constituting a border or edge; "the marginal strip of beach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300323671">
	<b:glossaryEntry xml:space='preserve'><![CDATA[being all around the edges; enclosing; "his encircling arms"; "the room''s skirting board needs painting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300323849"
	 b:glossaryEntry='located outside a military base; "off-base housing"'/>
<rdf:Description rdf:about="&a;300323955"
	 b:glossaryEntry='tending to move away from a center; "centrifugal force"'/>
<rdf:Description rdf:about="&a;300324104">
	<b:glossaryEntry>(botany) away from an axis, as in a flower cluster in which the oldest flowers are in the center, the youngest near the edge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300324293">
	<b:glossaryEntry>moving or directed away from center, especially when spinning or traveling in a curve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300324439"
	 b:glossaryEntry='tending to move toward a center; "centripetal force"'/>
<rdf:Description rdf:about="&a;300324585">
	<b:glossaryEntry>(botany) toward an axis, as in a sunflower; the oldest flowers are near the edge, the youngest in the center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300324757">
	<b:glossaryEntry>moving or directed toward the center or axis, especially when spinning or traveling in a curve</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300324911">
	<b:glossaryEntry>(physiology) of nerves and nerve impulses; conveying sensory information from the sense organs to the CNS; "afferent nerves"; "afferent impulses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300325147">
	<b:glossaryEntry>of a nerve fiber or impulse originating outside and passing toward the central nervous system; "sensory neurons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300325342">
	<b:glossaryEntry>of a nerve fiber or impulse originating outside and passing toward the cerebral cortex</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300325505">
	<b:glossaryEntry>(physiology) of nerves and nerve impulses; conveying information away from the CNS; "efferent nerves and impulses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300325728">
	<b:glossaryEntry>conveying information to the muscles from the CNS; "motor nerves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300325862">
	<b:glossaryEntry>of a nerve fiber passing outward from the cerebral cortex; "corticofugal discharges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300326038">
	<b:glossaryEntry>relating to a nerve fiber or impulse passing toward motor effectors; "neuromotor impulses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300326185"
	 b:glossaryEntry="tending to draw to a central point"/>
<rdf:Description rdf:about="&a;300326317"
	 b:glossaryEntry="tending to unify"/>
<rdf:Description rdf:about="&a;300326405"
	 b:glossaryEntry="tending to consolidate"/>
<rdf:Description rdf:about="&a;300326501"
	 b:glossaryEntry="tending away from a central point"/>
<rdf:Description rdf:about="&a;300326634">
	<b:glossaryEntry>tending away from centralization, as of authority; "the division of Europe into warring blocs produces ever-increasing centrifugal stress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300326830"
	 b:glossaryEntry="tending to disperse"/>
<rdf:Description rdf:about="&a;300326921">
	<b:glossaryEntry>established beyond doubt or question; definitely known; "what is certain is that every effect must have a cause"; "it is certain that they were on the bus"; "his fate is certain"; "the date for the invasion is certain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300327268"
	 b:glossaryEntry='known for certain; "it is definite that they have won"'/>
<rdf:Description rdf:about="&a;300327377">
	<b:glossaryEntry>impossible to doubt or dispute; "indisputable (or sure) proof"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300327505">
	<b:glossaryEntry>absolutely certain; "it is sure as shooting that they will come"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300327632">
	<b:glossaryEntry>not established beyond doubt; still undecided or unknown; "an uncertain future"; "a manuscript of uncertain origin"; "plans are still uncertain"; "changes of great if uncertain consquences"; "without further evidence his story must remain uncertain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300328009">
	<b:glossaryEntry>not decided or not known; "were indefinite about their plans"; "plans are indefinite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300328151"
	 b:glossaryEntry='very uncertain; "left everything up in the air"'/>
<rdf:Description rdf:about="&a;300328258">
	<b:glossaryEntry>having or feeling no doubt or uncertainty; confident and assured; "felt certain of success"; "was sure (or certain) she had seen it"; "was very sure in his beliefs"; "sure of her friends"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300328581">
	<b:glossaryEntry>persuaded of; very sure; "were convinced that it would be to their advantage to join"; "I am positive he is lying"; "was confident he would win"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300328813">
	<b:glossaryEntry>lacking or indicating lack of confidence or assurance; "uncertain of his convictions"; "unsure of himself and his future"; "moving with uncertain (or unsure) steps"; "an uncertain smile"; "touched the ornaments with uncertain fingers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300329232">
	<b:glossaryEntry>uncertain or unable to decide about what course to follow; "was ambivalent about having children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300329386">
	<b:glossaryEntry>fraught with uncertainty or doubt; "they were doubtful that the cord would hold"; "it was doubtful whether she would be admitted"; "dubious about agreeing to go"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300329612">
	<b:glossaryEntry>acting with uncertainty or hesitance or lack of confidence; "a groping effort to understand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300329769">
	<b:glossaryEntry>having a strong belief or conviction; "a convinced and fanatical pacifist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300329899"
	 b:glossaryEntry='lacking conviction; "I remain unconvinced"'/>
<rdf:Description rdf:about="&a;300330017">
	<b:glossaryEntry>not convinced; "they admitted the force of my argument but remained dubious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300330147">
	<b:glossaryEntry>having or marked by confidence or assurance; "a confident speaker"; "a confident reply"; "his manner is more confident these days"; "confident of fulfillment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300330451">
	<b:glossaryEntry>marked by assurance; exhibiting confidence; "she paints with an assured hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300330582">
	<b:glossaryEntry>marked by excessive confidence; "an arrogant and cocksure materialist"; "so bold and impudent as to speak to the queen"; "the less he knows the more positive he gets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300330837">
	<b:glossaryEntry>having confidence restored; freed from anxiety; "reassured by her praise he pressed on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300330980">
	<b:glossaryEntry>showing poise and confidence in your own worth; "hardly more than a boy but firm-knit and self-confident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300331161"
	 b:glossaryEntry="lacking or marked by a lack of confidence"/>
<rdf:Description rdf:about="&a;300331296">
	<b:glossaryEntry>lacking self-confidence; "stood in the doorway diffident and abashed"; "problems that call for bold not timid responses"; "a very unsure young man"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300331522">
	<b:glossaryEntry>certain to occur; destined or inevitable; "he was certain to fail"; "his fate is certain"; "In this life nothing is certain but death and taxes"- Benjamin Franklin; "he faced certain death"; "sudden but sure regret"; "he is sure to win"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300331909">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') governed by fate; "bound to happen"; "an old house destined to be demolished"; "he is destined to be famous"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300332110">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `to'') determined by tragic fate; "doomed to unhappiness"; "fated to be the scene of Kennedy''s assassination"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300332301">
	<b:glossaryEntry>established or prearranged unalterably; "his place in history was foreordained"; "a sense of predestinate inevitability about it"; "it seemed predestined since the beginning of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300332576"
	 b:glossaryEntry='certain to get or have; "he knew he was in for a licking"'/>
<rdf:Description rdf:about="&a;300332689">
	<b:glossaryEntry>not certain to occur; not inevitable; "everything is uncertain about the army"; "the issue is uncertain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300332903">
	<b:glossaryEntry>(informal) subject to accident or chance or change; "a chancy appeal at best"; "getting that job was definitely fluky"; "a fluky wind"; "an iffy proposition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300333137">
	<b:glossaryEntry>uncertain because of uncontrollable circumstances; "the results of confession were not contingent, they were certain"- George Eliot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300333325">
	<b:glossaryEntry>endorsed authoritatively as having met certain requirements; "a certified public accountant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300333509">
	<b:glossaryEntry>capable of being guaranteed or certified; "a certifiable fact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300333629"
	 b:glossaryEntry='officially documented; "a certified public accountant"'/>
<rdf:Description rdf:about="&a;300333770"
	 b:glossaryEntry="lacking requisite official documentation or endorsement"/>
<rdf:Description rdf:about="&a;300333883">
	<b:glossaryEntry>incapable of being avoided or prevented; "the inevitable result"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300334058">
	<b:glossaryEntry>controlled or decreed by fate; predetermined; "a fatal series of events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300334192">
	<b:glossaryEntry>impossible to avoid or evade:"inescapable conclusion"; "an ineluctable destiny"; "an unavoidable accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300334384">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unavoidably determined by prior circumstances; "the necessary consequences of one''s actions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300334532"
	 b:glossaryEntry="capable of being avoided"/>
<rdf:Description rdf:about="&a;300334623">
	<b:glossaryEntry>capable of being prevented; "conscious of preventable human suffering"- A.L.Guerard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300334764"
	 b:glossaryEntry='not preventable; "unpreventable hysteria"'/>
<rdf:Description rdf:about="&a;300334865">
	<b:glossaryEntry>such that alteration is possible; having a marked tendency to change; "changeable behavior"; "changeable moods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300335333"
	 b:glossaryEntry='capable of being regulated; "adjustable interest rates"'/>
<rdf:Description rdf:about="&a;300335445"
	 b:glossaryEntry="not static or stable"/>
<rdf:Description rdf:about="&a;300335519">
	<b:glossaryEntry>capable of having the meaning altered or twisted; "our words are distortable things--as in a crooked mirror held up to nature"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300335703">
	<b:glossaryEntry>liable to sudden unpredictable change; "erratic behavior"; "fickle weather"; "mercurial twists of temperament"; "a quicksilver character, cool and willful at one moment, utterly fragile the next"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300335990">
	<b:glossaryEntry>subject to change; variable; "a fluid situation fraught with uncertainty"; "everything was unstable following the coup</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300336171">
	<b:glossaryEntry>affording change (especially in social status); "Britain is not a truly fluid society"; "upwardly mobile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300336337"
	 b:glossaryEntry="continually shifting or rapidly changing"/>
<rdf:Description rdf:about="&a;300336455">
	<b:glossaryEntry>capable of changing quickly from one state or condition to another; "a highly mobile face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300336598">
	<b:glossaryEntry>allowing for future changes or revisions; "open-ended agreements"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300336720">
	<b:glossaryEntry>adept at changing from one thing to another especially changing costumes; "a quick-change artist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300336879">
	<b:glossaryEntry>(chemistry; physics) capable of assuming or producing either of two states; "a reversible chemical reaction"; "a reversible cell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300337065">
	<b:glossaryEntry>tending to vary often or widely; "volatile stocks"; "volatile emotions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300337191">
	<b:glossaryEntry>not changeable or subject to change; "a fixed and unchangeable part of the germ plasm"-Ashley Montagu; "the unchangeable seasons"; "one of the unchangeable facts of life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300337546"
	 b:glossaryEntry="remaining the same for indefinitely long times"/>
<rdf:Description rdf:about="&a;300337663">
	<b:glossaryEntry>of persons; not subject to change; "a confirmed bachelor"; "a confirmed invalid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300337799">
	<b:glossaryEntry>incapable of being changed or moved or undone; e.g. "frozen prices"; "living on fixed incomes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300337954"
	 b:glossaryEntry='showing little if any change; "a static population"'/>
<rdf:Description rdf:about="&a;300338080">
	<b:glossaryEntry>subject to alteration or change; "the death sentence was commutable to life imprisonment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300338262">
	<b:glossaryEntry>(law) of a sentence; capable of being changed to one less severe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300338382">
	<b:glossaryEntry>capable of being changed in substance as if by alchemy; "is lead really transmutable into gold?"; "ideas translatable into reality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300338617"
	 b:glossaryEntry="not subject to alteration or change"/>
<rdf:Description rdf:about="&a;300338747">
	<b:glossaryEntry>not capable of being changed into something else; "the alchemists were unable to accept the inconvertible nature of elemental metals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300338957">
	<b:glossaryEntry>(law) of a sentence; that cannot be changed; "an unalterable death sentence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300339091">
	<b:glossaryEntry>capable of being changed or altered in some characteristic; "alterable clothing"; "alterable conditions of employment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300339265">
	<b:glossaryEntry>not capable of being changed or altered; "unalterable resolve"; "an unalterable ground rule"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300339465">
	<b:glossaryEntry>unalterable in disposition or habits; "an incurable optimist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300339582">
	<b:glossaryEntry xml:space='preserve'><![CDATA[not to be altered or undone; "the judge''s decision is final"; "the arbiter will have the last say"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300339739">
	<b:glossaryEntry>capable of being modified in form or character or strength (especially by making less extreme); "the rhythm of physiological time is not modifiable except by interference with certain fundamental processes" - Alexis Carrel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300340018">
	<b:glossaryEntry>incapable of being modified in form or character or strength (especially by making less extreme); "these variations from custom are illogical, incomprehensible, and unmodifiable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300340255">
	<b:glossaryEntry>altered to accommodate to certain requirements or bring into a proper relation; "an adjusted insurance claim"; "the car runs more smoothly with the timing adjusted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300340546">
	<b:glossaryEntry>so adjusted as to be appropriate or brought into harmony; "an industry not attuned to the demands of the market"; "a remark keyed to the situation"; "charges finely tuned to the amount a student can afford"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300340822">
	<b:glossaryEntry>(music) brought to correct pitch; "his tuned violin"; "the attuned instruments"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300340963">
	<b:glossaryEntry>of an optical system (e.g. eye or opera glasses) adjusted to produce a clear image</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300341099">
	<b:glossaryEntry>adjusted to reflect value or proportion; "votes weighted according to the size of constituencies"; "a law weighted in favor of landlords";"a weighted average"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300341312">
	<b:glossaryEntry>not altered to fit certain requirements; "an unadjusted figure of 8.5 percent"; "the unadjusted clock is running fast";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300341507"
	 b:glossaryEntry='not well adjusted; "a maladjusted carburetor"'/>
<rdf:Description rdf:about="&a;300341610">
	<b:glossaryEntry>(psychology) adjusted to demands of daily living; showing emotional stability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300341760">
	<b:glossaryEntry>free from psychological disorder; "a well-adjusted personality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300341899">
	<b:glossaryEntry>(psychology) poorly adjusted to demands and stresses of daily living; "a maladjusted child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300342066">
	<b:glossaryEntry>not having adapted to new conditions; "several unadjusted refugees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300342202">
	<b:glossaryEntry>changed in form or character without becoming something else; "the altered policy promised success"; "following an altered course we soon found ourselves back in civilization"; "he looked...with couded eyes and with an altered manner of breathing"- Charles Dickens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300342592">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(especially of garments) having the fit or style adjusted; "for my wedding I had my mother''s wedding dress altered to fit me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300342772">
	<b:glossaryEntry xml:space='preserve'><![CDATA[made or become different in some respect; "he''s an altered (or changed) man since his election to Congress"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300342933">
	<b:glossaryEntry>improved or corrected by critical editing; "the emended text"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300343057"
	 b:glossaryEntry='improved or brought up to date; "a revised edition"'/>
<rdf:Description rdf:about="&a;300343162">
	<b:glossaryEntry>remaining in an original state; "persisting unaltered through time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300343387">
	<b:glossaryEntry xml:space='preserve'><![CDATA[unaffected by time; "few characters are so dateless as Hamlet"; "Helen''s timeless beauty"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300343542">
	<b:glossaryEntry>being in the original position; not having been moved; "the archeologists could date the vase because it was in situ"; "an in-situ investigator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300343750"
	 b:glossaryEntry="not changed by editing"/>
<rdf:Description rdf:about="&a;300343827"
	 b:glossaryEntry="not altered by reduction"/>
<rdf:Description rdf:about="&a;300343907">
	<b:glossaryEntry>not improved or brought up to date; "the book is still unrevised"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300344028"
	 b:glossaryEntry="of legislation"/>
<rdf:Description rdf:about="&a;300344114">
	<b:glossaryEntry>altered or revised by rephrasing or by adding or deleting material; "the amended bill passed easily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300344268"
	 b:glossaryEntry="(of legislation) not amended"/>
<rdf:Description rdf:about="&a;300344352">
	<b:glossaryEntry>made or become different in nature or form; "changed attitudes"; "changed styles of dress"; "a greatly changed country after the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300344611"
	 b:glossaryEntry='changed in nature or natural quality; "denatured alcohol"'/>
<rdf:Description rdf:about="&a;300344738"
	 b:glossaryEntry="changed for (replaced by) something different"/>
<rdf:Description rdf:about="&a;300344839">
	<b:glossaryEntry>given a completely different form or appearance; "shocked to see the transformed landscape"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300344988">
	<b:glossaryEntry>broken away from sameness or or identity or duplication; "her quickly varied answers indicated uncertainty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300345148">
	<b:glossaryEntry>not made or become different; "the causes that produced them have remained unchanged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300345325">
	<b:glossaryEntry>unchanged in character or nature; "the village stayed the same"; "his attitude is the same as ever"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300345478"
	 b:glossaryEntry="converted totally or partly into ions"/>
<rdf:Description rdf:about="&a;300345569"
	 b:glossaryEntry="not converted into ions"/>
<rdf:Description rdf:about="&a;300345660">
	<b:glossaryEntry>capable of or tending to change in form or quality or nature; "a mutable substance"; "the mutable ways of fortune"; "mutable weather patterns"; "a mutable foreign policy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300345897">
	<b:glossaryEntry>not subject or susceptible to change or variation in form or quality or nature; "the view of that time was that all species were immutable, created by God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300346121">
	<b:glossaryEntry xml:space='preserve'><![CDATA[typical or distinctive; "heard my friend''s characteristic laugh"; "red and gold are the characteristic colors of autumn"; "stripes characteristic of the zebra"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300346431">
	<b:glossaryEntry>characteristic or indicative of e.g. a disease; "a diagnostic sign of yellow fever"; "diagnostic information"; "a rash symptomatic of scarlet fever"; "symptomatic of insanity"; "a rise in crime symptomatic of social breakdown"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300346749">
	<b:glossaryEntry>of a feature that helps to distinguish a person or thing; "Jerusalem has a distinctive Middle East flavor"- Curtis Wilkie; "that is typical of you!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300346965">
	<b:glossaryEntry>serving to distinguish or identify a species or group; "the distinguishing mark of the species is its plumage"; "distinctive tribal tattoos"; "we were asked to describe any identifying marks or distinguishing features"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300347275">
	<b:glossaryEntry>characteristic of one only; distinctive or special; "the peculiar character of the Government of the U.S."- R.B.Taney</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300347450">
	<b:glossaryEntry>distinctive and not typical; "a book uncharacteristic of its author</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300347638"
	 b:glossaryEntry='not conforming to type; "showed atypical agility"'/>
<rdf:Description rdf:about="&a;300347742">
	<b:glossaryEntry>of a particle or body or system; having a net amount of positive or negative electric charge; "charged particles"; "a charged battery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300348002">
	<b:glossaryEntry>(electricity) charged or energized with electricity; "a hot wire"; "a live wire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300348139"
	 b:glossaryEntry="having a negative charge"/>
<rdf:Description rdf:about="&a;300348228"
	 b:glossaryEntry="having a positive charge"/>
<rdf:Description rdf:about="&a;300348317"
	 b:glossaryEntry="having a pair of equal and opposite charges"/>
<rdf:Description rdf:about="&a;300348412">
	<b:glossaryEntry>of a particle or body or system; having no charge; "an uncharged particle"; "an uncharged battery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300348584">
	<b:glossaryEntry>drained of electric charge; discharged; "a dead battery"; "left the lights on and came back to find the battery drained"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300348765">
	<b:glossaryEntry>full of love and generosity; "charitable to the poor"; "a charitable trust"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300348951">
	<b:glossaryEntry>generous in assistance to the poor; "a benevolent contributor"; "eleemosynary relief"; "philanthropic contributions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300349168">
	<b:glossaryEntry>lacking love and generosity; "all pious words and uncharitable deeds"- Charles Reade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300349347">
	<b:glossaryEntry>lacking in largess; "an ungenerous response to an appeal for funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300349471">
	<b:glossaryEntry>hired for the exclusive temporary use of a group of travelers; "a chartered plane"; "the chartered buses arrived on time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300349665"
	 b:glossaryEntry="not chartered"/>
<rdf:Description rdf:about="&a;300349736">
	<b:glossaryEntry>having an owner; often used in combination; "state-owned railways"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300349890">
	<b:glossaryEntry>owned by a relatively few shareholders; "a closely-held corporation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300350017">
	<b:glossaryEntry xml:space='preserve'><![CDATA[physically in an owner''s possession; "came to the auction cash in hand"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300350145"
	 b:glossaryEntry="having no owner"/>
<rdf:Description rdf:about="&a;300350226">
	<b:glossaryEntry>morally pure especially not having experienced sexual intercourse; "a holy woman innocent and chaste"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300350506"
	 b:glossaryEntry='abstaining from sexual intercourse; "celibate priests"'/>
<rdf:Description rdf:about="&a;300350627">
	<b:glossaryEntry>in a state of sexual virginity; "pure and vestal modesty"; "a spinster or virgin lady"; "men have decreed that their women must be pure and virginal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300350867"
	 b:glossaryEntry='not chaste; "unchaste conduct"'/>
<rdf:Description rdf:about="&a;300351078">
	<b:glossaryEntry>resembling the ancient orgiastic worship of Aphrodite on Cyprus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300351195">
	<b:glossaryEntry>casual and unrestrained in sexual behavior; "her easy virtue"; "he was told to avoid loose (or light) women"; "wanton behavior"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300351423"
	 b:glossaryEntry='having lost your chastity; "a fallen woman"'/>
<rdf:Description rdf:about="&a;300351519">
	<b:glossaryEntry>lacking moral discipline; especially sexually unrestrained; "coarse and licentious men"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300351663">
	<b:glossaryEntry>being full of or promoting cheer; having or showing good spirits; "her cheerful nature"; "a cheerful greeting"; "a cheerful room"; "as cheerful as anyone confined to a hospital bed could be"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300352106"
	 b:glossaryEntry='cheerful and bright; "a beaming smile"; "a glad May morning"'/>
<rdf:Description rdf:about="&a;300352227">
	<b:glossaryEntry>smiling with happiness or optimism; "Come to my arms, my beamish boy!"- Lewis Carroll; "a room of smiling faces"; "a round red twinkly Santa Claus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300352451">
	<b:glossaryEntry>carefree and happy and lighthearted; "was loved for her blithe spirit"; "a merry blithesome nature"; "her lighthearted nature"; "trilling songs with a lightsome heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300352711">
	<b:glossaryEntry>characterized by liveliness and light-heartedness; "buoyant spirits"; "his quick wit and chirpy humor"; "looking bright and well and chirpy"; "a perky little widow in her 70s"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300352957"
	 b:glossaryEntry='bringing cheer or gladness; "cheering news"'/>
<rdf:Description rdf:about="&a;300353055">
	<b:glossaryEntry>bright and pleasant; promoting a feeling of cheer; "a cheery hello"; "a gay sunny room"; "a sunny smile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300353226">
	<b:glossaryEntry>having a cheerful, lively, and self-confident air; "looking chipper, like a man...diverted by his own wit"- Frances G. Patton; "life that is gay, brisk, and debonair"- H.M.Reynolds; "walked with a jaunty step"; "a jaunty optimist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300353542">
	<b:glossaryEntry>lacking cheer; depressing; "something cheerless about the room"; "a moody and uncheerful person"; "an uncheerful place"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300353838">
	<b:glossaryEntry>causing dejection; "a blue day"; "the dark days of the war"; "a week of rainy depressing weather"; "a disconsolate winter landscape"; "the first dismal dispiriting days of November"; "a dark gloomy day"; "grim rainy weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300354187">
	<b:glossaryEntry>depressing in character or appearance; "drove through dingy streets"; "the dismal prison twilight"- Charles Dickens; "drab old buildings"; "a dreary mining town"; "gloomy tenements"; "sorry routine that follows on the heels of death"- B.A.Williams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300354536">
	<b:glossaryEntry>grave or even gloomy in character; "solemn and mournful music"; "a suit of somber black"; "a somber mood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300354703">
	<b:glossaryEntry>(botany) having a floral envelope or perianth consisting of a calyx and/or corolla</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300354843"
	 b:glossaryEntry="(botany) not having a floral envelope or perianth"/>
<rdf:Description rdf:about="&a;300354951"
	 b:glossaryEntry="having a granular structure like that of chondrites"/>
<rdf:Description rdf:about="&a;300355070"
	 b:glossaryEntry="not having a granular structure"/>
<rdf:Description rdf:about="&a;300355159">
	<b:glossaryEntry>(crystallography) having three unequal crystal axes with one oblique intersection; "monoclinic system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300355318">
	<b:glossaryEntry>(crystallography) having three unequal crystal axes intersecting at oblique angles; "triclinic system"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300355487">
	<b:glossaryEntry>(of light or other electromagnetic radiation) having only one wavelength; "monochromatic light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300355658">
	<b:glossaryEntry>(of light or other electromagnetic radiation) composed of more than one wavelength; "polychromatic light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300355823"
	 b:glossaryEntry="being or having or characterized by hue"/>
<rdf:Description rdf:about="&a;300357188"
	 b:glossaryEntry="a medium to dark brownish yellow color"/>
<rdf:Description rdf:about="&a;300357311"
	 b:glossaryEntry="of a moderate purple color"/>
<rdf:Description rdf:about="&a;300357392">
	<b:glossaryEntry>having the deep slightly brownish color of gold; "long aureate (or golden) hair"; "a gold carpet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300357575"
	 b:glossaryEntry="of the dull yellowish green of the meat of an avocado"/>
<rdf:Description rdf:about="&a;300357682">
	<b:glossaryEntry xml:space='preserve'><![CDATA[of a deep somewhat purplish blue color similar to that of a clear October sky; "October''s bright blue weather"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300357880"
	 b:glossaryEntry="of a light grayish-brown color"/>
<rdf:Description rdf:about="&a;300357962"
	 b:glossaryEntry="(Scot) bluish-black or gray-blue"/>
<rdf:Description rdf:about="&a;300358045">
	<b:glossaryEntry xml:space='preserve'><![CDATA[having a color similar to that of a clear unclouded sky; "October''s bright blue weather"- Helen Hunt Jackson; "a blue flame"; "blue haze of tobacco smoke"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300358294"
	 b:glossaryEntry='blush colored; "blushful mists"'/>
<rdf:Description rdf:about="&a;300358387"
	 b:glossaryEntry="of a dark to moderate grayish green color"/>
<rdf:Description rdf:about="&a;300358487"
	 b:glossaryEntry="of the color of bronze"/>
<rdf:Description rdf:about="&a;300358571"
	 b:glossaryEntry="of a color similar to that of wood or earth"/>
<rdf:Description rdf:about="&a;300358690"
	 b:glossaryEntry="of the color of buff leather"/>
<rdf:Description rdf:about="&a;300358769"
	 b:glossaryEntry="having the color of a canary; a light to moderate yellow"/>
<rdf:Description rdf:about="&a;300358894"
	 b:glossaryEntry="having the color of caramel; a moderate yellow-brown"/>
<rdf:Description rdf:about="&a;300359016"
	 b:glossaryEntry="having the color of a carnation"/>
<rdf:Description rdf:about="&a;300359103"
	 b:glossaryEntry="having the yellowish green color of Chartreuse liqueur"/>
<rdf:Description rdf:about="&a;300359214">
	<b:glossaryEntry>used of hair; of a golden brown to reddish brown color; "a chestnut horse"; "chestnut hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300359360"
	 b:glossaryEntry="having the color of copper"/>
<rdf:Description rdf:about="&a;300359457"
	 b:glossaryEntry="of a strong pink to yellowish-pink color"/>
<rdf:Description rdf:about="&a;300359549"
	 b:glossaryEntry='of the color of cream; "creamy translucent pebbles"'/>
<rdf:Description rdf:about="&a;300359653">
	<b:glossaryEntry>of a moderate yellow-green color that is greener and deeper than moss green and yellower and darker than pea green</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300359848">
	<b:glossaryEntry>of a dull grayish brown to brownish gray color; "the dun and dreary prairie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300359974">
	<b:glossaryEntry>earth colored; having a color of soil or earth; "a range of earthlike colors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300360107"
	 b:glossaryEntry="having a dusky brownish gray color"/>
<rdf:Description rdf:about="&a;300360195"
	 b:glossaryEntry="similar to the color of fresh grass"/>
<rdf:Description rdf:about="&a;300360320"
	 b:glossaryEntry="of a light brown or yellowish brown color"/>
<rdf:Description rdf:about="&a;300360413"
	 b:glossaryEntry="having the color of honey"/>
<rdf:Description rdf:about="&a;300360490">
	<b:glossaryEntry>similar to the color of jade; especially varying from bluish green to yellowish green</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;300360639"
	 b:glossaryEntry="of a yellowish brown color similar to olive drab"/>
<rdf:Description rdf:about="&a;300360739"
	 b:glossaryEntry="of a pale purple color"/>
<rdf:Description rdf:about="&a;300360824"
	 b:glossaryEntry="deep purplish red"/>
