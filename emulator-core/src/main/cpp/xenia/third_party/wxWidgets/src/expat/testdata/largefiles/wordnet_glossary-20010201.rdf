	 b:glossaryEntry="make more complicated or confused through entanglements"/>
<rdf:Description rdf:about="&a;200279748"
	 b:glossaryEntry="cause to be in a state of complete confusion"/>
<rdf:Description rdf:about="&a;200279863">
	<b:glossaryEntry xml:space='preserve'><![CDATA[increase the pressure, as of airplane cabins; "The captain will pressurize the cabin for the passengers'' comfort"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200280062">
	<b:glossaryEntry>maintain a certain pressure; "the airplane cabin is pressurized"; "pressurize a space suit"</b:glossaryEntry>
