	 b:glossaryEntry="a variety of bristle fern"/>
<rdf:Description rdf:about="&a;109249046"
	 b:glossaryEntry="large stout fern of extreme western Europe"/>
<rdf:Description rdf:about="&a;109249173"
	 b:glossaryEntry="large fern of New Zealand having kidney-shaped fronds"/>
<rdf:Description rdf:about="&a;109249308">
	<b:glossaryEntry>large family of ferns widely distributed in temperate and tropical areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109249535"
	 b:glossaryEntry="type genus of the Osmundaceae"/>
<rdf:Description rdf:about="&a;109249662">
	<b:glossaryEntry>any fern of the genus Osmunda: large ferns with creeping rhizomes; naked sporangia are on modified fronds that resemble flower clusters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109249940">
