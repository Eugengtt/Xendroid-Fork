<rdf:Description rdf:about="&a;108691321">
	<b:glossaryEntry>common Old World viola with creamy often violet-tinged flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108691471">
	<b:glossaryEntry>violet of eastern North America having pale violet to white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108691622">
	<b:glossaryEntry>short-stemmed violet of eastern North America having fragrant purple-veined white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108691830">
	<b:glossaryEntry>tall North American perennial with heart-shaped leaves and purple-streaked white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108692032"
	 b:glossaryEntry="Old World leafy-stemmed blue-flowered violet"/>
<rdf:Description rdf:about="&a;108692163"
	 b:glossaryEntry="European viola with an unusually long corolla spur"/>
<rdf:Description rdf:about="&a;108692304">
	<b:glossaryEntry>violet of Pacific coast of North America having white petals tinged with yellow and deep violet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108692491">
	<b:glossaryEntry>European violet typically having purple to white flowers; widely naturalized</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108692675">
	<b:glossaryEntry>common violet of the eastern United States with large pale blue or purple flowers resembling pansies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108692901">
	<b:glossaryEntry>violet of eastern North America having softly pubescent leaves and stems and clear yellow flowers with brown-purple veins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108693106">
	<b:glossaryEntry>violet of eastern North America having lilac-purple flowers with a long slender spur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108693273">
	<b:glossaryEntry>leafy-stemmed violet of eastern North America having large white or creamy flowers faintly marked with purple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108693488"
	 b:glossaryEntry="common European violet that grows in woods and hedgerows"/>
<rdf:Description rdf:about="&a;108693659">
	<b:glossaryEntry>large-flowered garden plant derived chiefly from the wild pansy of Europe and having velvety petals of various colors</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108693855">
	<b:glossaryEntry>a common and long cultivated European herb from which most common garden pansies are derived</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108694088">
	<b:glossaryEntry>an order of dicotyledonous plants including Moraceae and Urticaceae and Ulmaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108694356">
	<b:glossaryEntry>a family of plants of order Urticales including many nettles with stinging hairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108694681">
	<b:glossaryEntry>any of numerous plants having stinging hairs that cause skin irritation on contact (especially of the genus Urtica or family Urticaceae)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108694978"
	 b:glossaryEntry="a nettle yielding fiber resembling flax"/>
<rdf:Description rdf:about="&a;108695142">
	<b:glossaryEntry>perennial Eurasian nettle established in North America having broad coarsely toothed leaves with copious stinging hairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108695359">
	<b:glossaryEntry>annual European nettle with stinging foliage and small clusters of green flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108695537"
	 b:glossaryEntry="false nettle"/>
<rdf:Description rdf:about="&a;108695680">
	<b:glossaryEntry>any of several flowering weeds of the genus Boehmeria lacking stinging hairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108695863">
	<b:glossaryEntry>tall perennial herb of tropical Asia with dark green leaves; cultivated for flax-like fiber from its woody stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108696107"
	 b:glossaryEntry="1 species; a dwarf creeping mat-forming evergreen herb"/>
<rdf:Description rdf:about="&a;108696301">
	<b:glossaryEntry>prostrate or creeping Corsican herb with mosslike small round short-stemmed leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108696519"
	 b:glossaryEntry="mostly tropical stinging herbs or trees: nettle"/>
<rdf:Description rdf:about="&a;108696695">
	<b:glossaryEntry>American perennial herb found in rich woods and provided with stinging hairs; provides fibers used for textiles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108696905"
	 b:glossaryEntry="any of several tall Australian trees of the genus Laportea"/>
<rdf:Description rdf:about="&a;108697071"
	 b:glossaryEntry="small genus of stingless herbs"/>
<rdf:Description rdf:about="&a;108697215">
	<b:glossaryEntry>herb that grows in crevices having long narrow leaves and small pink apetalous flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108697438">
	<b:glossaryEntry>low-growing tropical perennials grown for their stingless foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108697645">
	<b:glossaryEntry>a plants of the genus Pilea having drooping green flower clusters and smooth translucent stems and leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108697866">
	<b:glossaryEntry>tropical American stingless nettle that discharges its pollen explosively</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108698040">
	<b:glossaryEntry>low stingless nettle of Central and South America having velvety brownish-green toothed leaves and clusters of small green flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108698294"
	 b:glossaryEntry="an Australian genus of woody plants of the family Urticaceae"/>
<rdf:Description rdf:about="&a;108698483">
	<b:glossaryEntry>Australian plant of genus Pipturus whose fiber is used in making cloth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108698668">
	<b:glossaryEntry>Hawaiian tree of genus Pipturus having a bark (tapa) from which tapa cloth is made</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108698832">
	<b:glossaryEntry>2 genera of erect or twining wind-pollinated herbs: genera Cannabis and Humulus; term not used in all classifications; in some the genus Cannabis is placed in the family Moraceae and the genus Humulus in the family Urticaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108699211">
	<b:glossaryEntry>hemp: genus of coarse annuals native to central Asia and widely naturalized in north temperate regions; in some classifications included in the family Moraceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108699469">
	<b:glossaryEntry>any plant of the genus Cannabis; a coarse bushy annual with palmate leaves and clusters of small green flowers; yields tough fibers and narcotic drugs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108699755">
	<b:glossaryEntry>a strong-smelling plant from whose dried leaves a number of euphoriant and hallucinogenic drugs are prepared</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108700045"
	 b:glossaryEntry="source of e.g. bhang and hashish as well as fiber"/>
<rdf:Description rdf:about="&a;108700208">
	<b:glossaryEntry>hops: hardy perennial vines of Europe, North America and central and eastern Asia producing a latex sap; in some classifications included in the family Urticaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108700478">
	<b:glossaryEntry>twining perennials having cordate leaves and flowers arranged in conelike spikes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108700688">
	<b:glossaryEntry>European twining plant whose flowers are used chiefly to flavor malt liquors; cultivated in America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108700898">
	<b:glossaryEntry>native American plant sometimes confused with the European hop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108701040">
	<b:glossaryEntry>ornamental vine native to eastern Asia; cultivated for its variegated foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108701196">
	<b:glossaryEntry>trees or shrubs having a milky juice; in some classifications includes genus Cannabis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108701486"
	 b:glossaryEntry="type genus of the Moraceae: mulberries"/>
<rdf:Description rdf:about="&a;108701628">
	<b:glossaryEntry>any of several trees of the genus Morus having edible fruit that resembles the blackberry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108701880">
	<b:glossaryEntry>Asiatic mulberry with white to pale red fruit; leaves used to feed silkworms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108702030"
	 b:glossaryEntry="European mulberry having dark foliage and fruit"/>
<rdf:Description rdf:about="&a;108702152"
	 b:glossaryEntry="North American mulberry having dark purple edible fruit"/>
<rdf:Description rdf:about="&a;108702280"
	 b:glossaryEntry="yellowwood trees or shrubs"/>
<rdf:Description rdf:about="&a;108702395">
	<b:glossaryEntry>small shrubby deciduous yellowwood tree of south central United States having spines, glossy dark green leaves and inedible orangelike fruit; its hard orange-colored wood used for bows by native Americans; frequently planted as boundary hedge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108702740">
	<b:glossaryEntry>evergreen Asiatic trees now grown through the tropics: breadfruit; jackfruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108702968">
	<b:glossaryEntry>native to Pacific Islands and having edible fruit with a texture like bread</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108703199">
	<b:glossaryEntry>East Indian tree cultivated for its immense edible fruit and seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108703403">
	<b:glossaryEntry>Philippine tree similar to the breadfruit tree bearing edible fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108703601">
	<b:glossaryEntry>large genus of tropical trees or shrubs or climbers including fig trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108703814">
	<b:glossaryEntry>any moraceous tree of the tropical genus Ficus; produces a closed pear-shaped receptacle that becomes fleshy and edible when mature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108704163"
	 b:glossaryEntry="Mediterranean tree widely cultivated for its edible fruit"/>
<rdf:Description rdf:about="&a;108704372">
	<b:glossaryEntry>wild variety of the common fig used to facilitate pollination of certain figs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108704530">
	<b:glossaryEntry>a strangler tree native to southern Florida and West Indies; begins as an epiphyte eventually developing many trunklike aerial roots and covering enormous areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108704831">
	<b:glossaryEntry>East Indian tree that puts out aerial shoots that grow down into the soil forming additional trunks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108705079">
	<b:glossaryEntry>fig tree of India noted for great size and longevity; lacks the prop roots of the banyan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108705290">
	<b:glossaryEntry>large tropical Asian tree frequently dwarfed as a houseplant; source of Assam rubber</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108705525">
	<b:glossaryEntry>shrub or small tree often grown as a houseplant having mistletoelike foliage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108705725">
	<b:glossaryEntry>Australian tree resembling the banyan often planted for ornament; introduced into South Africa for brushwood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108705962">
	<b:glossaryEntry>thick-branched wide-spreading tree of Africa and adjacent southwestern Asia often buttressed with branches rising from near the ground; produces cluster of edible but inferior figs on short leafless twigs; the Biblical sycamore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108706311"
	 b:glossaryEntry="paper mulberry"/>
<rdf:Description rdf:about="&a;108706443">
	<b:glossaryEntry>shrubby Asiatic tree having bark (tapa) that resembles cloth; grown as a shade tree in Europe and America; male flowers are pendulous catkins and female are urn-shaped followed by small orange-red aggregate berries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108706763"
	 b:glossaryEntry="in some classifications included in family Moraceae"/>
<rdf:Description rdf:about="&a;108706933">
	<b:glossaryEntry>large genus of tropical American trees that yield a bast fiber used for cordage and bark used in tanning; milky juice yields caoutchouc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108707178">
	<b:glossaryEntry>tropical American tree with large peltate leaves and hollow stems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108707377">
	<b:glossaryEntry>a dicot family of the order Urticales including: genera Ulmus; Celtis; Planera; Trema</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108707605">
	<b:glossaryEntry>type genus of family Ulmaceae; deciduous trees having simple serrate leaves; widely distributed in temperate regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108708110">
	<b:glossaryEntry>any of various trees of the genus Ulmus: important timber or shade trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108708551">
	<b:glossaryEntry>hard tough wood of an elm tree; used for e.g. implements and furniture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108708700">
	<b:glossaryEntry>North American elm having twigs and young branches with prominent corky projections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108708884">
	<b:glossaryEntry>large ornamental tree with graceful gradually spreading branches common in eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108709112">
	<b:glossaryEntry>European elm with lustrous smooth leaves used as an ornamental</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108709299">
	<b:glossaryEntry>elm of southern United States and Mexico having spreading pendulous corky branches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108709476"
	 b:glossaryEntry="Eurasian elm often planted as a shade tree"/>
<rdf:Description rdf:about="&a;108709619">
	<b:glossaryEntry>any of various hybrid ornamental European shade trees ranging from dwarf to tall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108709793"
	 b:glossaryEntry="erect vigorous hybrid ornamental"/>
<rdf:Description rdf:about="&a;108709933">
	<b:glossaryEntry>Eurasian elm closely resembling the American elm; thrives in a moist environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108710103">
	<b:glossaryEntry>small fast-growing tree native to Asia; widely grown as shelterbelts and hedges</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108710278">
	<b:glossaryEntry>broad spreading rough-leaved elm common throughout Europe and planted elsewhere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108710465">
	<b:glossaryEntry>fast-growing shrubby Asian tree naturalized in United States for shelter or ornament</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108710669">
	<b:glossaryEntry>North American elm having rough leaves that are red when opening; yields a hard wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108710855">
	<b:glossaryEntry>a variety of the English elm with erect branches and broader leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108711106"
	 b:glossaryEntry="autumn-flowering elm of southeastern United States"/>
<rdf:Description rdf:about="&a;108711262"
	 b:glossaryEntry="tall widely distributed elm of eastern North America"/>
<rdf:Description rdf:about="&a;108711405"
	 b:glossaryEntry="large genus of trees and shrubs with berrylike fruit"/>
<rdf:Description rdf:about="&a;108711620">
	<b:glossaryEntry>any of various trees of the genus Celtis having inconspicuous flowers and small berrylike fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108711859"
	 b:glossaryEntry="bright green deciduous shade tree of southern Europe"/>
<rdf:Description rdf:about="&a;108712040">
	<b:glossaryEntry>large deciduous shade tree of southern United States with small deep purple berries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108712229">
	<b:glossaryEntry>deciduous shade tree with small black berries; southern United States; yields soft yellowish wood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108712421">
	<b:glossaryEntry>one of four subclasses or superorders of Monocotyledones; comprises 17 families including: Liliaceae; Alliaceae; Amaryllidaceae; Iridaceae; Orchidaceae; Trilliaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108712755">
	<b:glossaryEntry>an order of monocotyeldonous plants including Amaryllidaceae and Liliaceae and Iridaceae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108713124">
	<b:glossaryEntry>large family of usually perennial geophytic herbs with rizomes or corms or bulbs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108713482"
	 b:glossaryEntry="any bulbous plant of the family Iridaceae"/>
<rdf:Description rdf:about="&a;108713731">
	<b:glossaryEntry>large genus of perennials that develop from bulbs or rhizomes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108713942">
	<b:glossaryEntry>plants with sword-shaped leaves and erect stalks bearing bright-colored flowers composed of three petals and three drooping sepals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108714375">
	<b:glossaryEntry>any of numerous wild or cultivated irises with hairlike structures on the falls (the drooping sepals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108714626">
	<b:glossaryEntry>any of numerous wild or cultivated irises having no hairs on the drooping sepals (the falls)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108714870"
	 b:glossaryEntry="any of various irises having a rootstock formed like a bulb"/>
<rdf:Description rdf:about="&a;108715006">
	<b:glossaryEntry>fragrant rootstock of various irises especially Florentine iris; used in perfumes and medicines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108715184">
	<b:glossaryEntry>low-growing summer-flowering iris of northeastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108715320"
	 b:glossaryEntry="bulbous Spanish iris with red-violet flowers"/>
<rdf:Description rdf:about="&a;108715438">
	<b:glossaryEntry>German iris having large white flowers with lavender-tinged falls and a fragrant rhizome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108715661">
	<b:glossaryEntry>iris with purple flowers and evil-smelling leaves; southern and western Europe and North Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108715899">
	<b:glossaryEntry>a large iris with purple or white flowers, native to central and southern Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108716054"
	 b:glossaryEntry="iris native to Japan having large showy flowers"/>
<rdf:Description rdf:about="&a;108716178">
	<b:glossaryEntry>iris of northern Italy having deep blue-purple flowers; similar to but smaller than Iris germanica</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108716348"
	 b:glossaryEntry="European iris having soft lilac-blue flowers"/>
<rdf:Description rdf:about="&a;108716468">
	<b:glossaryEntry>bulbous iris native to Asia Minor cultivated for its pale lilac-colored flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108716621">
	<b:glossaryEntry>common yellow-flowered iris of Europe and North Africa, naturalized in United States and often cultivated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108716837"
	 b:glossaryEntry="bulbous Spanish iris having blue flowers"/>
<rdf:Description rdf:about="&a;108716951">
	<b:glossaryEntry>low-growing spring-flowering American iris with bright blue-lilac flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108717108">
	<b:glossaryEntry>a common iris of the eastern United States having blue or blue-violet flowers; root formerly used medicinally</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108717291"
	 b:glossaryEntry="similar to blue flag; the eastern United States"/>
<rdf:Description rdf:about="&a;108717420">
	<b:glossaryEntry>bulbous iris native to the Pyrenees; widely cultivated for its large delicate flowers in various colors except yellow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108717614">
	<b:glossaryEntry>bulbous iris of western Mediterranean region having usually violet-purple flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108717784"
	 b:glossaryEntry="a monocotyledonous genus of the family Iridaceae"/>
<rdf:Description rdf:about="&a;108717946">
	<b:glossaryEntry>garden plant whose capsule discloses when ripe a mass of seeds resembling a blackberry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108718151"
	 b:glossaryEntry="a monocotyledonous genus of the family Iridaceae"/>
<rdf:Description rdf:about="&a;108718296">
	<b:glossaryEntry>any of numerous low-growing plants of the genus Crocus having slender grasslike leaves and white or yellow or purple flowers; native chiefly to the Mediterranean region but widely cultivated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108718576">
	<b:glossaryEntry>Old World crocus having purple or white flowers with aromatic pungent orange stigmas used in flavoring food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108718790"
	 b:glossaryEntry="cormous perennial herbs; native to South Africa"/>
<rdf:Description rdf:about="&a;108718935">
	<b:glossaryEntry>any of several plants of the genus Freesia valued for their one-sided clusters of usually fragrant yellow or white or pink tubular flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108719146"
	 b:glossaryEntry="gladiolas"/>
<rdf:Description rdf:about="&a;108719255">
	<b:glossaryEntry>any of numerous plants of the genus Gladiolus native chiefly to tropical and South Africa having sword-shaped leaves and one-sided spikes of brightly colored funnel-shaped flowers; widely cultivated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108719552"
	 b:glossaryEntry="a monocotyledonous genus of the family Iridaceae"/>
