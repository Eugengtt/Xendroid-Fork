	 b:glossaryEntry="raise the nap of (fabrics)"/>
<rdf:Description rdf:about="&a;201053698">
	<b:glossaryEntry>mark or stamp with or as if with pressure; "To make a batik, you impress a design with wax"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201053918"
	 b:glossaryEntry='make a spot or mark onto; "The wine spotted the tablecloth"'/>
<rdf:Description rdf:about="&a;201054203"
	 b:glossaryEntry="blotch or spot"/>
<rdf:Description rdf:about="&a;201054290"
	 b:glossaryEntry='remove while making clean; "Clean the spots off the rug"'/>
<rdf:Description rdf:about="&a;201054427">
	<b:glossaryEntry>make clean by removing dirt, filth, or unwanted substances from; "Clean the stove!"; "The dentist cleaned my teeth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201054932"
	 b:glossaryEntry="whiten or clean with pipe-clay, as of leather"/>
<rdf:Description rdf:about="&a;201055044"
	 b:glossaryEntry='make the house clean; "She housecleans every week"'/>
<rdf:Description rdf:about="&a;201055238">
	<b:glossaryEntry>thoroughly clean the entire house, often done only once a year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201055370"
	 b:glossaryEntry='clean refuse from; "Scavenge a street"'/>
<rdf:Description rdf:about="&a;201055474">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make soiled, filthy, or dirty; "don''t soil your clothes when you play outside!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201055846"
	 b:glossaryEntry="soil or stain with a splashed liquid"/>
<rdf:Description rdf:about="&a;201055946">
	<b:glossaryEntry>soil with mud, muck, or mire; "The child mucked up his shirt while playing ball in the garden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201056149"
	 b:glossaryEntry="soil with soot"/>
<rdf:Description rdf:about="&a;201056234"
	 b:glossaryEntry="clean with chemical agents"/>
