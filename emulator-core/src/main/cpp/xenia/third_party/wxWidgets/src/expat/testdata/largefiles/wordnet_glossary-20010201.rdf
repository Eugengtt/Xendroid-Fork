</rdf:Description>
<rdf:Description rdf:about="&a;108871579"
	 b:glossaryEntry="1 species: Spanish broom"/>
<rdf:Description rdf:about="&a;108871713">
	<b:glossaryEntry>tall thornless shrub having pale yellow flowers and flexible rushlike twigs used in basketry; of southwestern Europe and Mediterranean; naturalized in California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108871989"
	 b:glossaryEntry="genus of Polynesian or southeastern Asian shrubs or vines"/>
<rdf:Description rdf:about="&a;108872164">
	<b:glossaryEntry>vigorous Philippine evergreen twining liana; grown for spectacular festoons of green lobster-claw-like flowers</b:glossaryEntry>
</rdf:Description>
