	 b:glossaryEntry="one of the world''s most important commercial fishes"/>
<rdf:Description rdf:about="&a;102015651"
	 b:glossaryEntry="closely related to Atlantic cod"/>
<rdf:Description rdf:about="&a;102015775"
	 b:glossaryEntry="whitings"/>
