	 b:glossaryEntry='make weak; "Life in the camp drained him"'/>
<rdf:Description rdf:about="&a;200270269"
	 b:glossaryEntry="weaken mentally or morally"/>
<rdf:Description rdf:about="&a;200270369">
	<b:glossaryEntry>lose vigor, health, or flesh, as through grief; "After her husband died, she just pined away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200270556"
	 b:glossaryEntry='lessen in force or effect; "soften a shock"; "break a fall"'/>
<rdf:Description rdf:about="&a;200270746"
	 b:glossaryEntry="check; keep in check (a fire)"/>
<rdf:Description rdf:about="&a;200270847"
	 b:glossaryEntry="quieten or silence (a sound) or make (an image) less visible"/>
<rdf:Description rdf:about="&a;200271023"
	 b:glossaryEntry='silence (someone) by uttering "shush!"'/>
<rdf:Description rdf:about="&a;200271124"
	 b:glossaryEntry='smother or suppress; "Stifle your curiosity"'/>
<rdf:Description rdf:about="&a;200271267"
	 b:glossaryEntry='suppress, as of an emotion; "He choked down his rage"'/>
<rdf:Description rdf:about="&a;200271421"
	 b:glossaryEntry="reduce the amplitude (of oscillations or waves)"/>
<rdf:Description rdf:about="&a;200271540">
	<b:glossaryEntry>make less lively or vigorous; "Middle age dulled her appetite for travel"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200271701">
	<b:glossaryEntry>make milky or dull; "The chemical clouded the liquid to which it was added"</b:glossaryEntry>
</rdf:Description>
