<rdf:Description rdf:about="&a;110298987"
	 b:glossaryEntry="inflammation of the retina"/>
<rdf:Description rdf:about="&a;110299087">
	<b:glossaryEntry>an inflammation of the mucous membrane lining the nose (usually associated with nasal discharge)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110299265"
