	 b:glossaryEntry="the capital of Bermuda"/>
<rdf:Description rdf:about="&a;106409977"
	 b:glossaryEntry="a volcanic island in the Caribbean; in the West Indies"/>
<rdf:Description rdf:about="&a;106410126">
	<b:glossaryEntry>region in S South America between the Andes and the South Atlantic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106410305">
	<b:glossaryEntry>a republic in S South America; 2nd largest country in South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106410900">
	<b:glossaryEntry>capital and largest city of Argentina; located in eastern Argentina near Uruguay; Argentina''s chief port and industrial and cultural center</b:glossaryEntry>
</rdf:Description>
