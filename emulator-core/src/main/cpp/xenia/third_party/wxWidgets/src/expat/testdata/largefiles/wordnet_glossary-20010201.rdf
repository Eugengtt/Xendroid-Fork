</rdf:Description>
<rdf:Description rdf:about="&a;108873132"
	 b:glossaryEntry="East Indian shrub"/>
<rdf:Description rdf:about="&a;108873231">
	<b:glossaryEntry>perennial subshrub of eastern North America having downy leaves yellowish and rose flowers and; source of rotenone</b:glossaryEntry>
</rdf:Description>
