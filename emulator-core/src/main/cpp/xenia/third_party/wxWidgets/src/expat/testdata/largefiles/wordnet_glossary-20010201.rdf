<rdf:Description rdf:about="&a;101761160"
	 b:glossaryEntry="a variety of spittlebug"/>
<rdf:Description rdf:about="&a;101761240"
	 b:glossaryEntry="a genus of Cercopidae"/>
<rdf:Description rdf:about="&a;101761373"
	 b:glossaryEntry="North American insect that severely damages grasses"/>
<rdf:Description rdf:about="&a;101761529"
	 b:glossaryEntry="a genus of Cercopidae"/>
<rdf:Description rdf:about="&a;101761683"
	 b:glossaryEntry="North American insect that attacks pines"/>
<rdf:Description rdf:about="&a;101761804"
	 b:glossaryEntry="feeds on pines in northern United States"/>
<rdf:Description rdf:about="&a;101761955"
	 b:glossaryEntry="leafhoppers"/>
<rdf:Description rdf:about="&a;101762085">
	<b:glossaryEntry>family of small leafhoppers coextensive with the Cicadellidae and not distinguished from it in some classifications</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101762311"
	 b:glossaryEntry="a variety of leafhopper"/>
<rdf:Description rdf:about="&a;101762387"
	 b:glossaryEntry="small leaping insect that sucks the juices of plants"/>
<rdf:Description rdf:about="&a;101762552">
	<b:glossaryEntry>related to the leafhoppers and spittlebugs but rarely damages cultivated plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101762740"
	 b:glossaryEntry="plant hoppers: treehoppers"/>
<rdf:Description rdf:about="&a;101762883"
	 b:glossaryEntry="small leaping insect that sucks juices of branches and twigs"/>
<rdf:Description rdf:about="&a;101763019"
	 b:glossaryEntry="plant hoppers: lantern flies"/>
<rdf:Description rdf:about="&a;101763162">
	<b:glossaryEntry>large brightly marked tropical insect with a process like a snout that was formerly thought to emit light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101763357"
	 b:glossaryEntry="an order of insects: includes booklice and barklice"/>
<rdf:Description rdf:about="&a;101763594">
	<b:glossaryEntry>small soft-bodied insect with chewing mouthparts and either no wings or two pairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101763796">
	<b:glossaryEntry>a family of small soft-bodied insects that feed on decaying vegetation; related to booklice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101764036">
	<b:glossaryEntry>small winged insect living on the bark and leaves of trees and feeding on e.g. fungi and decaying plant matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101764236"
	 b:glossaryEntry="any of several insects living on the bark of plants"/>
<rdf:Description rdf:about="&a;101764356"
	 b:glossaryEntry="booklice"/>
<rdf:Description rdf:about="&a;101764458"
	 b:glossaryEntry="a genus of Psocidae"/>
<rdf:Description rdf:about="&a;101764591">
	<b:glossaryEntry>minute wingless psocopterous insects injurious to books and papers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101764802"
	 b:glossaryEntry="a genus of Psocidae"/>
<rdf:Description rdf:about="&a;101764929"
	 b:glossaryEntry="a variety of booklouse"/>
<rdf:Description rdf:about="&a;101765055"
	 b:glossaryEntry="mayflies"/>
<rdf:Description rdf:about="&a;101765234"
	 b:glossaryEntry="in some former classifications: name for the Ephemeroptera"/>
<rdf:Description rdf:about="&a;101765350"
	 b:glossaryEntry="short-lived insect"/>
<rdf:Description rdf:about="&a;101765496"
	 b:glossaryEntry="mayflies"/>
<rdf:Description rdf:about="&a;101765621">
	<b:glossaryEntry>slender insect with delicate membranous wings having an aquatic larval stage and terrestrial adult stage usually lasting less than two days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101765851"
	 b:glossaryEntry="stoneflies"/>
<rdf:Description rdf:about="&a;101765975">
	<b:glossaryEntry>primitive winged insect with a flattened body; used as bait by fishermen; aquatic gilled larvae are carnivorous and live beneath stones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101766210">
	<b:glossaryEntry>an order of insects including: lacewings; antlions; dobsonflies; alderflies; fishflies; mantispids; spongeflies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101766549">
	<b:glossaryEntry>insect having biting mouthparts and four large membranous wings with netlike veins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101766888"
	 b:glossaryEntry="antlions"/>
<rdf:Description rdf:about="&a;101767019"
	 b:glossaryEntry="type genus of the Myrmeleontidae: antlions"/>
<rdf:Description rdf:about="&a;101767192">
	<b:glossaryEntry>winged insect resembling a dragonfly; the larvae (doodlebugs) dig conical pits where they wait to catch e.g. ants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101767403"
	 b:glossaryEntry="the larva of an ant lion or of any of several other insects"/>
<rdf:Description rdf:about="&a;101767558">
	<b:glossaryEntry>any of two families of gauzy-winged insects (Chrysopidae and Hemerobiidae); larvae feed on insect pests such as aphids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101767782"
	 b:glossaryEntry="carnivorous larva of lacewing flies"/>
<rdf:Description rdf:about="&a;101767925"
	 b:glossaryEntry="green lacewings"/>
<rdf:Description rdf:about="&a;101768076">
	<b:glossaryEntry>pale green unpleasant-smelling lacewing fly having carnivorous larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101768267"
	 b:glossaryEntry="a variety of green lacewing"/>
<rdf:Description rdf:about="&a;101768368"
	 b:glossaryEntry="brown lacewings"/>
<rdf:Description rdf:about="&a;101768521"
	 b:glossaryEntry="small dark-colored lacewing fly"/>
<rdf:Description rdf:about="&a;101768662">
	<b:glossaryEntry>in some classifications considered a separate order: alderflies; dobsonflies; snake flies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101768908"
	 b:glossaryEntry="dobsons"/>
<rdf:Description rdf:about="&a;101769051"
	 b:glossaryEntry="type genus of the Corydalidae"/>
<rdf:Description rdf:about="&a;101769241">
	<b:glossaryEntry>large soft-bodied insect having long slender mandibles in the male; aquatic larvae often used as bait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101769460">
	<b:glossaryEntry>large brown aquatic larva of the dobsonfly; used as fishing bait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101769612"
	 b:glossaryEntry="similar to but smaller than the dobsonfly"/>
<rdf:Description rdf:about="&a;101769726"
	 b:glossaryEntry="an arthropod family including: alderflies"/>
<rdf:Description rdf:about="&a;101769878"
	 b:glossaryEntry="type genus of the Sialidae"/>
<rdf:Description rdf:about="&a;101770010"
	 b:glossaryEntry="dark-colored insect having predaceous aquatic larvae"/>
<rdf:Description rdf:about="&a;101770165">
	<b:glossaryEntry>familyof arthropods of the suborder Megaloptera, including snakeflies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101770352">
	<b:glossaryEntry>predatory insect of western North America having a long necklike prothorax</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101770500"
	 b:glossaryEntry="mantispids"/>
<rdf:Description rdf:about="&a;101770627">
	<b:glossaryEntry>insect that resembles a mantis; larvae are parasites in the nests of spiders and wasps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101770788">
	<b:glossaryEntry>an arthropod family of the order Neuroptera that includes spongeflies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101770970"
	 b:glossaryEntry="hairy-bodied insect whose larvae feed on freshwater sponges"/>
<rdf:Description rdf:about="&a;101771119"
	 b:glossaryEntry="dragonflies and damselflies"/>
<rdf:Description rdf:about="&a;101771292">
	<b:glossaryEntry>large primitive predatory aquatic insect having two pairs of membranous wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101771478"
	 b:glossaryEntry="dragonflies"/>
<rdf:Description rdf:about="&a;101771587">
	<b:glossaryEntry>slender-bodied non-stinging insect having iridescent wings that are outspread at rest; adults and nymphs feed on mosquitoes etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101771890"
	 b:glossaryEntry="damselflies"/>
<rdf:Description rdf:about="&a;101771997">
	<b:glossaryEntry>slender non-stinging insect similar to but smaller than the dragonfly but having wings folded when at rest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101772159"
	 b:glossaryEntry="an order of insects consisting of caddis flies"/>
<rdf:Description rdf:about="&a;101772340"
	 b:glossaryEntry="caddis fly"/>
<rdf:Description rdf:about="&a;101772484">
	<b:glossaryEntry>small moth-like insect having two pairs of hairy membranous wings and aquatic larvae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101772664">
	<b:glossaryEntry>insect larva that constructs a protective case around its body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101772799">
	<b:glossaryEntry>caddisfly larva; constructs a case of silk covered with sand or plant debris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101772963"
	 b:glossaryEntry="firebrats; silverfish; machilids"/>
<rdf:Description rdf:about="&a;101773145"
	 b:glossaryEntry="primitive wingless insects: bristletail"/>
<rdf:Description rdf:about="&a;101773334"
	 b:glossaryEntry="small wingless insect with a long bristlelike tail"/>
<rdf:Description rdf:about="&a;101773460"
	 b:glossaryEntry="firebrats"/>
<rdf:Description rdf:about="&a;101773607"
	 b:glossaryEntry="type genus of the Lepismatidae: silverfish"/>
<rdf:Description rdf:about="&a;101773757">
	<b:glossaryEntry>silver-gray wingless insect found in houses feeding on book bindings and starched clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101773944"
	 b:glossaryEntry="a genus of Lepismatidae"/>
<rdf:Description rdf:about="&a;101774079"
	 b:glossaryEntry="lives in warm moist areas e.g. around furnaces"/>
<rdf:Description rdf:about="&a;101774221"
	 b:glossaryEntry="jumping bristletails"/>
<rdf:Description rdf:about="&a;101774356">
	<b:glossaryEntry>wingless insect living in dark moist places as under dead tree trunks; they make erratic leaps when disturbed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101774561"
	 b:glossaryEntry="thrips"/>
<rdf:Description rdf:about="&a;101774704"
	 b:glossaryEntry="an insect of the order Thysanoptera"/>
<rdf:Description rdf:about="&a;101774874"
	 b:glossaryEntry="thrips"/>
<rdf:Description rdf:about="&a;101775031">
	<b:glossaryEntry>any of various small to minute sucking insects with narrow feathery wings if any; they feed on plant sap and many are destructive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101775286"
	 b:glossaryEntry="tobacco thrips"/>
<rdf:Description rdf:about="&a;101775420"
	 b:glossaryEntry="injurious to growing tobacco and peanuts"/>
<rdf:Description rdf:about="&a;101775562"
	 b:glossaryEntry="type genus of the Thripidae"/>
<rdf:Description rdf:about="&a;101775686"
	 b:glossaryEntry="injurious to onion plants and sometimes tobacco"/>
<rdf:Description rdf:about="&a;101775841"
	 b:glossaryEntry="earwigs and a few related forms"/>
<rdf:Description rdf:about="&a;101776005">
	<b:glossaryEntry>any of numerous insects of the order Dermaptera having elongate bodies and slender many-jointed antennae and a pair of large pincers at the rear of the abdomen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101776254"
	 b:glossaryEntry="typical earwigs"/>
<rdf:Description rdf:about="&a;101776388"
	 b:glossaryEntry="type genus of Forficulidae"/>
<rdf:Description rdf:about="&a;101776526"
	 b:glossaryEntry="sometimes destructive to cultivated bulbs"/>
<rdf:Description rdf:about="&a;101776679"
	 b:glossaryEntry="moths and butterflies"/>
<rdf:Description rdf:about="&a;101777139">
	<b:glossaryEntry>insect that in the adult state has four wings more or less covered with tiny scales</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101777374">
	<b:glossaryEntry>diurnal insect typically having a slender body with knobbed antennae and broad colorful wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101777613"
	 b:glossaryEntry="large beautifully colored butterflies"/>
<rdf:Description rdf:about="&a;101777919">
	<b:glossaryEntry>medium to large butterflies found worldwide typically having brightly colored wings and much-reduced nonfunctional forelegs carried folded on the breast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101778469"
	 b:glossaryEntry="type genus of the Nymphalidae: mourning cloak butterflies"/>
<rdf:Description rdf:about="&a;101778657">
	<b:glossaryEntry>of temperate regions; having dark purple wings with yellow borders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101778870"
	 b:glossaryEntry="brilliantly colored; larvae feed on nettles"/>
<rdf:Description rdf:about="&a;101779018"
	 b:glossaryEntry="painted beauty and red admiral"/>
<rdf:Description rdf:about="&a;101779175">
	<b:glossaryEntry>American butterfly having dark brown wings with white and golden orange spots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101779355"
	 b:glossaryEntry="any of several brightly colored butterflies"/>
<rdf:Description rdf:about="&a;101779452">
	<b:glossaryEntry>of temperate Europe and Asia; having black wings with red and white markings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101779624"
	 b:glossaryEntry="mainly dark northern butterflies with white wing bars"/>
<rdf:Description rdf:about="&a;101779846"
	 b:glossaryEntry="Eurasian butterfly with brown wings and white markings"/>
<rdf:Description rdf:about="&a;101779999">
	<b:glossaryEntry>North American butterfly with blue-black wings crossed by a broad white band</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101780191">
	<b:glossaryEntry>similar to the banded purple but with red spots on underwing surfaces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101780365"
	 b:glossaryEntry="showy American butterfly resembling the monarch but smaller"/>
<rdf:Description rdf:about="&a;101780519">
	<b:glossaryEntry>nymphalid butterfly having angular notches on the outer edges of the forewings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101780653"
	 b:glossaryEntry="comma butterflies"/>
<rdf:Description rdf:about="&a;101780782">
	<b:glossaryEntry>anglewing butterfly with a comma-shaped mark on the underside of each hind wing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101780968"
	 b:glossaryEntry="butterfly with brownish wings marked with black and silver"/>
<rdf:Description rdf:about="&a;101781101"
	 b:glossaryEntry="fritillaries"/>
<rdf:Description rdf:about="&a;101781221">
	<b:glossaryEntry>butterfly with silver spots on the underside of the hind wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101781359"
	 b:glossaryEntry="fritillaries"/>
<rdf:Description rdf:about="&a;101781462"
	 b:glossaryEntry="large Old World butterflies"/>
<rdf:Description rdf:about="&a;101781597"
	 b:glossaryEntry="large richly colored butterfly"/>
<rdf:Description rdf:about="&a;101781738">
	<b:glossaryEntry>large European butterfly the male of which has wings shaded with purple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101781885"
	 b:glossaryEntry="a genus of Nymphalidae"/>
<rdf:Description rdf:about="&a;101782015">
	<b:glossaryEntry>European butterfly having reddish-brown wings each marked with a purple eyespot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101782200">
	<b:glossaryEntry>small family of usually tropical butterflies: monarch butterflies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101782395">
	<b:glossaryEntry>large tropical butterfly with degenerate forelegs and an unpleasant taste</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101782577"
	 b:glossaryEntry="type genus of the Danaidae: monarch butterflies"/>
<rdf:Description rdf:about="&a;101782730">
	<b:glossaryEntry>large migratory American butterfly having deep orange wings with black and white markings; the larvae feed on milkweed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101782981"
	 b:glossaryEntry="cabbage butterflies; sulphur butterflies"/>
<rdf:Description rdf:about="&a;101783189">
	<b:glossaryEntry>any of numerous pale-colored butterflies having three pairs of well-developed legs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101783380"
	 b:glossaryEntry="white butterfly whose larvae (cabbageworms) feed on cabbage"/>
<rdf:Description rdf:about="&a;101783576"
	 b:glossaryEntry="type genus of the Pieridae"/>
<rdf:Description rdf:about="&a;101783746"
	 b:glossaryEntry="small widely distributed form"/>
<rdf:Description rdf:about="&a;101783867"
	 b:glossaryEntry="Old World form"/>
<rdf:Description rdf:about="&a;101783977"
	 b:glossaryEntry="common North American form"/>
<rdf:Description rdf:about="&a;101784095"
	 b:glossaryEntry="any of numerous yellow or orange butterflies"/>
<rdf:Description rdf:about="&a;101784241">
	<b:glossaryEntry>family of small usually brilliantly colored butterflies; males have short forelegs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101784476"
	 b:glossaryEntry="any of various butterflies of the family Lycaenidae"/>
<rdf:Description rdf:about="&a;101784676">
	<b:glossaryEntry>type genus of the Lycaenidae; small slender butterflies with upper surface of wings usually metallic blue or green or copper</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101784946">
	<b:glossaryEntry>any of numerous small chiefly blue butterflies of the family Lycaenidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101785087">
	<b:glossaryEntry>any of various small butterflies of the family Lycaenidae having copper colored wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101785262"
	 b:glossaryEntry="common copper butterfly of central and eastern North America"/>
<rdf:Description rdf:about="&a;101785425"
	 b:glossaryEntry="large and widely distributed genus of hairstreak butterflies"/>
<rdf:Description rdf:about="&a;101785612"
	 b:glossaryEntry="small butterflies having striped markings under the wings"/>
<rdf:Description rdf:about="&a;101785786"
	 b:glossaryEntry="larvae are pests of various economic plants"/>
<rdf:Description rdf:about="&a;101785910">
	<b:glossaryEntry>typically crepuscular or nocturnal insect having a stout body and feathery or hairlike antennae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101786290"
	 b:glossaryEntry="leaf rollers and codling moths"/>
<rdf:Description rdf:about="&a;101786513">
	<b:glossaryEntry>any of numerous small moths having lightly fringed wings; larvae are leafrollers or live in fruits and galls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101786785">
	<b:glossaryEntry>moth whose larvae form nests by rolling and tying leaves with spun silk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101786927"
	 b:glossaryEntry="type genus of the Tortricidae"/>
<rdf:Description rdf:about="&a;101787073"
	 b:glossaryEntry="tea tortrix"/>
<rdf:Description rdf:about="&a;101787171"
	 b:glossaryEntry="small Indian moth infesting e.g. tea and coffee plants"/>
<rdf:Description rdf:about="&a;101787331"
	 b:glossaryEntry="orange tortrix"/>
<rdf:Description rdf:about="&a;101787444"
	 b:glossaryEntry="California moth whose larvae live in esp. oranges"/>
<rdf:Description rdf:about="&a;101787606"
	 b:glossaryEntry="codling moths"/>
<rdf:Description rdf:about="&a;101787733"
	 b:glossaryEntry="small moth whose larvae live in apples and English walnuts"/>
<rdf:Description rdf:about="&a;101787892"
	 b:glossaryEntry="tussock moths"/>
<rdf:Description rdf:about="&a;101788081">
	<b:glossaryEntry>dull-colored moth whose larvae have tufts of hair on the body and feed on the leaves of many deciduous trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101788334"
	 b:glossaryEntry="larva of a tussock moth"/>
<rdf:Description rdf:about="&a;101788442">
	<b:glossaryEntry>type genus of the Lymantriidae; a pest (Lymantria means `destroyer'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101788622">
	<b:glossaryEntry>European moth introduced into North America; a serious pest of shade trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101788804"
	 b:glossaryEntry="a genus of Lymantriidae"/>
<rdf:Description rdf:about="&a;101788958">
	<b:glossaryEntry>small brown-and_white European moth introduced into eastern United States; pest of various shade and fruit trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101789187"
	 b:glossaryEntry="white furry-bodied European moth with a yellow tail tuft"/>
<rdf:Description rdf:about="&a;101789348"
	 b:glossaryEntry="measuring worms"/>
<rdf:Description rdf:about="&a;101789537">
	<b:glossaryEntry>slender-bodied broad-winged moth whose larvae are called measuring worms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101789737"
	 b:glossaryEntry="geometrid moths"/>
<rdf:Description rdf:about="&a;101789885"
	 b:glossaryEntry="moth whose larvae are spring cankerworms"/>
<rdf:Description rdf:about="&a;101790009"
	 b:glossaryEntry="geometrid moths"/>
<rdf:Description rdf:about="&a;101790155">
	<b:glossaryEntry>North American moth with gray-winged males and wingless females; larvae are fall cankerworms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101790332">
	<b:glossaryEntry>green caterpillar of a geometrid moth; pest of various fruit and shade trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101790520"
	 b:glossaryEntry="variably colored looper; larva of Paleacrita vernata"/>
<rdf:Description rdf:about="&a;101790655">
	<b:glossaryEntry>green or brown white-striped looper; larva of Alsophila_pometaria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101790801">
	<b:glossaryEntry>small hairless caterpillar having legs on only its front and rear segments; mostly larvae of moths of the family Geometridae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101791006"
	 b:glossaryEntry="bee moths; corn borers; flour moths"/>
<rdf:Description rdf:about="&a;101791322">
	<b:glossaryEntry>usually tropical slender-bodied long-legged moth whose larvae are crop pests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101791594"
	 b:glossaryEntry="type genus of the Pyralidae"/>
<rdf:Description rdf:about="&a;101791710"
	 b:glossaryEntry="a genus of Pyralidae"/>
<rdf:Description rdf:about="&a;101791840"
	 b:glossaryEntry="moth whose larvae live in and feed on bee honeycombs"/>
<rdf:Description rdf:about="&a;101791999"
	 b:glossaryEntry="moths whose larvae are corn borers"/>
<rdf:Description rdf:about="&a;101792143">
	<b:glossaryEntry>native to Europe; in America the larvae bore into the stem and crown of corn and other plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101792373"
	 b:glossaryEntry="moth whose larvae are flour moths"/>
<rdf:Description rdf:about="&a;101792516"
	 b:glossaryEntry="small moth whose larvae damage stored grain and flour"/>
<rdf:Description rdf:about="&a;101792681">
	<b:glossaryEntry>small moths whose larvae spin silken tunnels and feed on stored food products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101792868">
	<b:glossaryEntry>small moth whose larvae feed on tobacco and other dried plant products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101793049"
	 b:glossaryEntry="a genus of Pyralidae"/>
<rdf:Description rdf:about="&a;101793192">
	<b:glossaryEntry>moth whose larvae feed on and mat together with webbing various stored foods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101793373"
	 b:glossaryEntry="moth whose larvae attack dried fruits and cereal products"/>
<rdf:Description rdf:about="&a;101793527"
	 b:glossaryEntry="clothes moths; carpet moths; leaf miners"/>
<rdf:Description rdf:about="&a;101793723"
	 b:glossaryEntry="small dull-colored moth with chewing mouthparts"/>
<rdf:Description rdf:about="&a;101793894"
	 b:glossaryEntry="clothes moths"/>
<rdf:Description rdf:about="&a;101794075"
	 b:glossaryEntry="small yellowish moths whose larvae feed on wool or fur"/>
<rdf:Description rdf:about="&a;101794251">
	<b:glossaryEntry>any of several small yellowish or buff-colored moths whose larvae eat organic matter e.g. woolens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101794443"
	 b:glossaryEntry="type genus of the Tineidae: clothes moths"/>
<rdf:Description rdf:about="&a;101794588">
	<b:glossaryEntry>the larvae live in tubes of its food material fastened with silk that it spins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101794775"
	 b:glossaryEntry="webbing clothes moths"/>
<rdf:Description rdf:about="&a;101794904"
	 b:glossaryEntry="moth that forms a web in which it lives"/>
<rdf:Description rdf:about="&a;101795067"
	 b:glossaryEntry="carpet moths"/>
<rdf:Description rdf:about="&a;101795195"
	 b:glossaryEntry="larvae feed on carpets and other woolens"/>
<rdf:Description rdf:about="&a;101795353"
	 b:glossaryEntry="leaf miners"/>
<rdf:Description rdf:about="&a;101795483">
	<b:glossaryEntry>small dull or metallic-colored tineoid moths whose larvae mine in plant leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101795638"
	 b:glossaryEntry="important economic pests"/>
<rdf:Description rdf:about="&a;101795855">
	<b:glossaryEntry>small slender-winged moths whose larvae are agricultural pests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101796063"
	 b:glossaryEntry="type genus of the Gelechiidae: pink bollworms"/>
<rdf:Description rdf:about="&a;101796218">
	<b:glossaryEntry>small brown moth whose larvae bore into flowers and bolls of cotton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101796371"
	 b:glossaryEntry="moth whose larvae feed on grain"/>
<rdf:Description rdf:about="&a;101796477"
	 b:glossaryEntry="grain moths"/>
<rdf:Description rdf:about="&a;101796600"
	 b:glossaryEntry="small moth whose larvae feed on kernels of stored grains"/>
<rdf:Description rdf:about="&a;101796782"
	 b:glossaryEntry="potato moths"/>
<rdf:Description rdf:about="&a;101796910"
	 b:glossaryEntry="grayish-brown moth whose larva is the potato tuberworm"/>
<rdf:Description rdf:about="&a;101797080">
	<b:glossaryEntry>larva of potato moth; mines in leaves and stems of e.g. potatoes and tobacco</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101797264"
	 b:glossaryEntry="cutworms; armyworms"/>
<rdf:Description rdf:about="&a;101797567">
	<b:glossaryEntry>usually dull-colored medium-sized nocturnal moth; the usually smooth-bodied larvae are destructive agricultural pests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101797911">
	<b:glossaryEntry>North American moth whose larvae feed on young plant stems cutting them off at the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101798091"
	 b:glossaryEntry="type genus of the Noctuidae: moths whose larvae are cutworms"/>
<rdf:Description rdf:about="&a;101798238"
	 b:glossaryEntry="moths whose larvae are cutworms: underwings"/>
<rdf:Description rdf:about="&a;101798391"
	 b:glossaryEntry="moth having dull forewings and brightly colored hind wings"/>
<rdf:Description rdf:about="&a;101798542"
	 b:glossaryEntry="moth having dull forewings and red-marked hind wings"/>
<rdf:Description rdf:about="&a;101798671"
	 b:glossaryEntry="antler moths"/>
<rdf:Description rdf:about="&a;101798797">
	<b:glossaryEntry>European moth with white antler-like markings on the forewings; the larvae damage pastures and grasslands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101799001"
	 b:glossaryEntry="a genus of Noctuidae"/>
<rdf:Description rdf:about="&a;101799133"
	 b:glossaryEntry="medium-sized moth whose larvae are corn earworms"/>
<rdf:Description rdf:about="&a;101799277"
	 b:glossaryEntry="moths whose larvae are army cutworms"/>
<rdf:Description rdf:about="&a;101799452"
	 b:glossaryEntry="moth whose larvae destroy grains and forage plants"/>
<rdf:Description rdf:about="&a;101799607">
	<b:glossaryEntry>noctuid moth larvae that travel in large groups and destroy grains and alfalfa in the Plains states</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101799811"
	 b:glossaryEntry="moths whose larvae are armyworms"/>
<rdf:Description rdf:about="&a;101799978"
	 b:glossaryEntry="moth whose destructive larvae travel in multitudes"/>
<rdf:Description rdf:about="&a;101800126">
	<b:glossaryEntry>noctuid moth larvae that travel in multitudes destroying esp. grass and grain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101800313"
	 b:glossaryEntry="moths whose larvae are armyworms"/>
<rdf:Description rdf:about="&a;101800497"
	 b:glossaryEntry="moth whose larvae are beet armyworms"/>
<rdf:Description rdf:about="&a;101800616"
	 b:glossaryEntry="moth larva that eats foliage of beets and vegetables"/>
<rdf:Description rdf:about="&a;101800767"
	 b:glossaryEntry="moth whose larvae are fall armyworms"/>
<rdf:Description rdf:about="&a;101800890">
	<b:glossaryEntry>larva of a migratory American noctuid moth; destroys grasses and small grains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101801051"
	 b:glossaryEntry="hawkmoths"/>
<rdf:Description rdf:about="&a;101801213">
	<b:glossaryEntry>any of various moths with long narrow forewings capable of powerful flight and hovering over flowers to feed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101801505"
	 b:glossaryEntry="moths whose larvae are tobacco hornworms or tomato hornworms"/>
<rdf:Description rdf:about="&a;101801711"
	 b:glossaryEntry="moth whose larvae are tobacco hornworms"/>
<rdf:Description rdf:about="&a;101801829">
	<b:glossaryEntry>large green white-striped hawkmoth larva that feeds on tobacco and related plants; similar to tomato_hornworm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101802050"
	 b:glossaryEntry="moth whose larvae are tomato hornworms"/>
<rdf:Description rdf:about="&a;101802177">
	<b:glossaryEntry>large green white-striped hawkmoth larva that feeds on tomato and potato plants; similar to tobacco hornworm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101802387"
	 b:glossaryEntry="death''s-head moth"/>
<rdf:Description rdf:about="&a;101802518">
	<b:glossaryEntry>European hawkmoth with markings on the back resembling a human skull</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101802690"
	 b:glossaryEntry="Chinese silkworm moth"/>
<rdf:Description rdf:about="&a;101802845">
	<b:glossaryEntry>moderate-sized Asiatic moth whose larvae feed on mulberry leaves and produce silk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101803050"
	 b:glossaryEntry="type genus of the Bombycidae: Chinese silkworm moth"/>
<rdf:Description rdf:about="&a;101803226">
	<b:glossaryEntry>stocky creamy-white Asiatic moth found almost entirely under human care; the source of most of the silk of commerce</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101803443">
	<b:glossaryEntry>hairless white caterpillar of the Chinese silkworm moth; source of most commercial silk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101803623">
	<b:glossaryEntry>important and widely distributed family of moths including some of the largest insects known</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101804003">
	<b:glossaryEntry>large brightly colored and usually tropical moth; larvae spin silken cocoons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101804333"
	 b:glossaryEntry="type genus of the Saturniidae: emperor moth"/>
<rdf:Description rdf:about="&a;101804486">
	<b:glossaryEntry>large moth of temperate forests of Eurasia having heavily scaled transparent wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101804675"
	 b:glossaryEntry="imperial moths"/>
<rdf:Description rdf:about="&a;101804795">
	<b:glossaryEntry>large American moth having yellow wings with purplish or brownish markings; larvae feed on e.g. maple and pine trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101805010"
	 b:glossaryEntry="any silkworm moth of the family Saturniidae"/>
<rdf:Description rdf:about="&a;101805171">
	<b:glossaryEntry>larva of a saturniid moth; spins a large amount of strong silk in constructing its cocoon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101805404"
	 b:glossaryEntry="luna moths"/>
<rdf:Description rdf:about="&a;101805520">
	<b:glossaryEntry>large pale-green American moth with long-tailed hind wings and a yellow crescent-shaped mark on each fore wing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101805731"
	 b:glossaryEntry="American silkworm moth"/>
<rdf:Description rdf:about="&a;101805848">
	<b:glossaryEntry>North American silkworm moth; larvae feed on the leaves of forest trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101806012"
	 b:glossaryEntry="silkworm moths"/>
<rdf:Description rdf:about="&a;101806149">
	<b:glossaryEntry>large Asiatic moth introduced into the United States; larvae feed on the ailanthus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101806341"
	 b:glossaryEntry="large green silkworm of the cynthia moth"/>
<rdf:Description rdf:about="&a;101806481"
	 b:glossaryEntry="io moth"/>
<rdf:Description rdf:about="&a;101806600">
	<b:glossaryEntry>large yellow American moth having a large eyelike spot on each hind wing; the larvae have stinging spines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101806793"
	 b:glossaryEntry="large moths whose larvae produce silk of high quality"/>
<rdf:Description rdf:about="&a;101806996">
	<b:glossaryEntry>very large yellowish-brown American silkworm moth with large eyespots on hind wings; larvae feed on fruit and shade trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101807221"
	 b:glossaryEntry="a Chinese moth that produces a brownish silk"/>
<rdf:Description rdf:about="&a;101807361"
	 b:glossaryEntry="oriental moth that produces brownish silk"/>
<rdf:Description rdf:about="&a;101807531"
	 b:glossaryEntry="atlas moth"/>
<rdf:Description rdf:about="&a;101807649">
	<b:glossaryEntry>giant saturniid moth widespread in Asia; sometimes cultured for silk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101807809"
	 b:glossaryEntry="tiger moths"/>
<rdf:Description rdf:about="&a;101807971">
	<b:glossaryEntry>stout-bodied broad-winged moth with conspicuously striped or spotted wings; larvae are hairy caterpillars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101808200">
	<b:glossaryEntry>medium-sized moth with long richly colored and intricately patterned wings; larvae are called woolly bears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101808363"
	 b:glossaryEntry="cinnabar moths"/>
<rdf:Description rdf:about="&a;101808493">
	<b:glossaryEntry>large red-and-black European moth; larvae feed on leaves of ragwort; introduced into United States to control ragwort</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101808723"
	 b:glossaryEntry="tent caterpillars; eggars; lappet moths"/>
<rdf:Description rdf:about="&a;101808997">
	<b:glossaryEntry>medium-sized stout-bodied neutral-colored moths comb-like antennae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101809231"
	 b:glossaryEntry="type genus of the Lasiocampidae: eggars"/>
<rdf:Description rdf:about="&a;101809384">
	<b:glossaryEntry>moth having nonfunctional mouthparts as adults; larvae feed on tree foliage and spin egg-shaped cocoons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101809566"
	 b:glossaryEntry="tent caterpillars"/>
<rdf:Description rdf:about="&a;101809735"
	 b:glossaryEntry="moth whose larvae are tent caterpillars"/>
<rdf:Description rdf:about="&a;101809884">
	<b:glossaryEntry>the larvae of moths that build communal silken webs in orchard and shade trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101810062"
	 b:glossaryEntry="moth whose gregarious larvae spin carpets"/>
<rdf:Description rdf:about="&a;101810212">
	<b:glossaryEntry>larvae of a gregarious North American moth that spins a carpet rather than a tent; serious defoliator of deciduous trees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101810424"
	 b:glossaryEntry="medium-sized hairy moths; larvae are lappet caterpillars"/>
<rdf:Description rdf:about="&a;101810547"
	 b:glossaryEntry="larva of a lappet moth"/>
<rdf:Description rdf:about="&a;101810653">
	<b:glossaryEntry>several gregarious moth larvae that spin webs over foliage on which they feed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101810839"
	 b:glossaryEntry="fall webworms"/>
<rdf:Description rdf:about="&a;101810985"
	 b:glossaryEntry="a variety of moth that spins a web in which it lives"/>
<rdf:Description rdf:about="&a;101811132"
	 b:glossaryEntry="moth whose larvae are fall webworms"/>
<rdf:Description rdf:about="&a;101811249"
	 b:glossaryEntry="a variety of webworm"/>
<rdf:Description rdf:about="&a;101811366"
	 b:glossaryEntry="garden webworms"/>
<rdf:Description rdf:about="&a;101811512"
	 b:glossaryEntry="moth whose larvae are garden webworms"/>
<rdf:Description rdf:about="&a;101811634"
	 b:glossaryEntry="a variety of webworm"/>
<rdf:Description rdf:about="&a;101811756"
	 b:glossaryEntry="an insect or other arthropod between molts"/>
<rdf:Description rdf:about="&a;101811851">
	<b:glossaryEntry>a wormlike and often brightly colored and hairy or spiny larva of a butterfly or moth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101812355">
	<b:glossaryEntry>larva of the European corn borer moth; a serious pest of maize</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101812514"
	 b:glossaryEntry="any of various moth caterpillars that destroy cotton bolls"/>
<rdf:Description rdf:about="&a;101812663">
	<b:glossaryEntry>larvae of a gelechiid moth introduced from Asia; feeds on the seeds of cotton bolls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101812848">
	<b:glossaryEntry>larva of a noctuid moth; highly destructive to esp. corn and cotton and tomato crops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101813093"
	 b:glossaryEntry="toxic green larva of a cabbage butterfly"/>
<rdf:Description rdf:about="&a;101813225">
	<b:glossaryEntry>caterpillar of numerous moths characterized by a dense coat of woolly hairs; feed on plants and some are destructive pests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101813449"
	 b:glossaryEntry="larva of moth of the family Arctiidae"/>
<rdf:Description rdf:about="&a;101813568">
	<b:glossaryEntry>the immature free-living form of most invertebrates and amphibians and fish which at hatching from the egg is fundamentally unlike its parent and must metamorphose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101814089">
	<b:glossaryEntry>a larva of an insect with incomplete metamorphosis (as the dragonfly or mayfly)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101814220"
	 b:glossaryEntry="slender transparent larva of eels and certain fishes"/>
<rdf:Description rdf:about="&a;101814351">
	<b:glossaryEntry>botfly larva; typically develops inside the body of a horse or sheep or human</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101814478">
	<b:glossaryEntry>a soft thick wormlike larva of certain beetles and other insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101814629">
	<b:glossaryEntry>the larva of the housefly and blowfly commonly found in decaying organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101814761"
	 b:glossaryEntry="tough-skinned larva of certain crane flies"/>
<rdf:Description rdf:about="&a;101814863">
	<b:glossaryEntry>an insect in the inactive stage of development (when it is not feeding) intermediate between larva and adult</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101815040"
	 b:glossaryEntry="pupa of a moth or butterfly enclosed in a cocoon"/>
<rdf:Description rdf:about="&a;101815144">
	<b:glossaryEntry>silky envelope spun by the larvae of many insects to protect pupas and by spiders to protect eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101815294"
	 b:glossaryEntry="an adult insect produced after metamorphosis"/>
<rdf:Description rdf:about="&a;101815390">
	<b:glossaryEntry>the only fertile female in a colony of social insects such as bees and ants and termites; its function is to lay eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101815577"
	 b:glossaryEntry="small phylum of wormlike marine animals"/>
<rdf:Description rdf:about="&a;101815742">
	<b:glossaryEntry>hermaphrodite wormlike animal living in mud of the sea bottom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101815877"
	 b:glossaryEntry="marine or freshwater animals that form colonies of zooids"/>
<rdf:Description rdf:about="&a;101816091">
	<b:glossaryEntry>sessile aquatic animal forming mosslike colonies of small polyps each having a curved or circular ridge bearing tentacles; attach to stones or seaweed and reproduce by budding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101816386"
	 b:glossaryEntry="coextensive with or a subphylum of Bryozoa"/>
<rdf:Description rdf:about="&a;101816543">
	<b:glossaryEntry>sessile mosslike aquatic animal having the anus of the polyp outside the crown of tentacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101816709"
	 b:glossaryEntry="sometimes considered a subphylum of Bryozoa"/>
<rdf:Description rdf:about="&a;101816880">
	<b:glossaryEntry>any of various mosslike aquatic animals usually forming branching colonies; each polyp having a both mouth and anus within a closed ring of tentacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101817104">
	<b:glossaryEntry>tiny marine organisms each the size of a period found in great numbers on lobsters'' lips; identified tentatively in 1995 as a new phylum or as possible link between Entoprocta and Ectoprocta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101817411">
	<b:glossaryEntry>only known species of Cycliophora; lives symbiotically attached to a lobster''s lip by an adhesive disk and feeding by means of a hairy mouth ring; its complex life cycle includes asexual and sexual phases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101817696"
	 b:glossaryEntry="marine invertebrates that resemble mollusks"/>
<rdf:Description rdf:about="&a;101817856">
	<b:glossaryEntry>marine animal with bivalve shell having a pair of arms bearing tentacles for capturing food; found worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101818065"
	 b:glossaryEntry="peanut worms"/>
<rdf:Description rdf:about="&a;101818190">
	<b:glossaryEntry>small unsegmented marine worm that when disturbed retracts its anterior portion into the body giving the appearance of a peanut</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101818407"
	 b:glossaryEntry="a family of echinoderms"/>
<rdf:Description rdf:about="&a;101818549"
	 b:glossaryEntry="a genus of echinoderms"/>
<rdf:Description rdf:about="&a;101818761">
	<b:glossaryEntry>radially symmetrical marine invertebrates including e.g. starfish and sea urchins and sea cucumbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101819076">
	<b:glossaryEntry>marine invertebrates with tube feet and calcite-covered five-part radially symmetrical bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101819410">
	<b:glossaryEntry>one of the five areas on the under surface of an echinoderm on which the tube feet are located</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101819580"
	 b:glossaryEntry="sea stars"/>
<rdf:Description rdf:about="&a;101819703">
	<b:glossaryEntry>echinoderms characterized by five arms extending from a central disk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101819856"
	 b:glossaryEntry="brittle stars and basket stars"/>
<rdf:Description rdf:about="&a;101820021"
	 b:glossaryEntry="brittle stars"/>
<rdf:Description rdf:about="&a;101820149">
	<b:glossaryEntry>an animal resembling a starfish with fragile whiplike arms radiating from a small central disc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101820350"
	 b:glossaryEntry="basket stars"/>
<rdf:Description rdf:about="&a;101820534">
	<b:glossaryEntry>any starfish-like animal of the genera Euryale or Astrophyton or Gorgonocephalus having slender complexly branched interlacing arms radiating from a central disc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101820804"
	 b:glossaryEntry="basket stars"/>
<rdf:Description rdf:about="&a;101820905"
	 b:glossaryEntry="includes many of the basket stars"/>
<rdf:Description rdf:about="&a;101821054"
	 b:glossaryEntry="a variety of basket star"/>
<rdf:Description rdf:about="&a;101821165"
	 b:glossaryEntry="basket stars"/>
<rdf:Description rdf:about="&a;101821282"
	 b:glossaryEntry="sea urchins and sand dollars"/>
<rdf:Description rdf:about="&a;101821462">
	<b:glossaryEntry>shallow-water echinoderms having soft bodies enclosed in thin spiny globular shells</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101821675"
	 b:glossaryEntry="a sea urchin that can be eaten"/>
<rdf:Description rdf:about="&a;101821790"
	 b:glossaryEntry="flat sea urchins"/>
<rdf:Description rdf:about="&a;101821922"
	 b:glossaryEntry="flattened disklike sea urchins that live on sandy bottoms"/>
<rdf:Description rdf:about="&a;101822056"
	 b:glossaryEntry="heart-shaped sea urchins"/>
<rdf:Description rdf:about="&a;101822196"
	 b:glossaryEntry="sea urchin having a heart-shaped body in a rigid spiny shell"/>
<rdf:Description rdf:about="&a;101822334"
	 b:glossaryEntry="sea lilies"/>
<rdf:Description rdf:about="&a;101822494">
	<b:glossaryEntry>primitive echinoderms having five or more feathery arms radiating from a central disk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101822688"
	 b:glossaryEntry="sea lilies"/>
<rdf:Description rdf:about="&a;101822814">
	<b:glossaryEntry>crinoid with delicate radiating arms and a stalked body attached to a hard surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101822970"
	 b:glossaryEntry="feather stars; formerly called family Comatulidae"/>
<rdf:Description rdf:about="&a;101823136">
	<b:glossaryEntry>a genus of echinoderms of the family Antedonidae; formerly called genus Comatula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101823324">
	<b:glossaryEntry>free-swimming stalkless crinoid with ten feathery arms; found on muddy sea bottoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101823496"
	 b:glossaryEntry="class of echinoderms including the sea cucumbers"/>
<rdf:Description rdf:about="&a;101823683">
	<b:glossaryEntry>echinoderm having a flexible sausage-shaped body, tentacles surrounding the mouth and tube feet; free-living mud feeders: sea cucumbers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101823928"
	 b:glossaryEntry="a family of Holothuroidea"/>
<rdf:Description rdf:about="&a;101824072"
	 b:glossaryEntry="type genus of the Holothuridae"/>
<rdf:Description rdf:about="&a;101824216">
	<b:glossaryEntry>of warm coasts from Australia to Asia; used as food esp. by Chinese</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101824376">
	<b:glossaryEntry>any of various organs of locomotion or attachment in invertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101824550">
	<b:glossaryEntry>tentacular tubular process of most echinoderms (starfish and sea urchins and holothurians) having a sucker at the end and used for e.g. locomotion and respiration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101824787"
	 b:glossaryEntry="eggs of female fish"/>
<rdf:Description rdf:about="&a;101824875"
	 b:glossaryEntry="seminal fluid produced by male fish"/>
<rdf:Description rdf:about="&a;101824980">
	<b:glossaryEntry>a rudimentary splint-like metacarpal or metatarsal bone on either side of the cannon bone in the leg of a horse or related animal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101825167">
	<b:glossaryEntry>in former classifications considered a suborder of Rodentia coextensive with the order Lagomorpha: gnawing animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101825361">
	<b:glossaryEntry>rabbits; hares; pikas; formerly considered the suborder Duplicidentata of the order Rodentia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101825624">
	<b:glossaryEntry>relative large gnawing animals; distinguished from rodents by having two pairs of upper incisors specialized for gnawing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101825890"
	 b:glossaryEntry="hares and rabbits"/>
<rdf:Description rdf:about="&a;101826077"
	 b:glossaryEntry="rabbits and hares"/>
<rdf:Description rdf:about="&a;101826220">
	<b:glossaryEntry>any of various burrowing animals of the family Leporidae having long ears and short tails; some domesticated and raised for pets or food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101826570"
	 b:glossaryEntry="castrated male rabbit"/>
<rdf:Description rdf:about="&a;101826643"
	 b:glossaryEntry="(usually informal) especially a young rabbit"/>
<rdf:Description rdf:about="&a;101826754"
	 b:glossaryEntry="Old World rabbits"/>
<rdf:Description rdf:about="&a;101826887">
	<b:glossaryEntry>common grayish-brown burrowing animal native to S Europe and North Africa but introduced elsewhere; widely domesticated and developed in various colors and for various needs; young born naked and helpless</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101827234"
	 b:glossaryEntry="North American rabbits"/>
<rdf:Description rdf:about="&a;101827389">
	<b:glossaryEntry>common small rabbit of North America having grayish or brownish fur and a tail with a white underside; a host for Ixodes pacificus and Ixodes scapularis (Lyme disease ticks)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101827745">
	<b:glossaryEntry>widely distributed in United States except northwest and far west regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101827907"
	 b:glossaryEntry="of southeastern United States swamps and lowlands"/>
<rdf:Description rdf:about="&a;101828083"
	 b:glossaryEntry="of marshy coastal areas from North Carolina to Florida"/>
<rdf:Description rdf:about="&a;101828232"
	 b:glossaryEntry="type genus of the Leporidae: hares"/>
<rdf:Description rdf:about="&a;101828427">
	<b:glossaryEntry>swift timid long-eared mammal larger than a rabbit having a divided upper lip and long hind legs; young born furred and with open eyes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101828740"
	 b:glossaryEntry="a young hare especially one in its first year"/>
<rdf:Description rdf:about="&a;101828839">
	<b:glossaryEntry>large hare introduced in North America; does not turn white in winter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101829005"
	 b:glossaryEntry="large hare of western North America"/>
<rdf:Description rdf:about="&a;101829152">
	<b:glossaryEntry>largest hare of northern plains and western mountains of United States; brownish-gray in summer and pale gray in winter; tail nearly always all white</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101829412">
	<b:glossaryEntry>the common jackrabbit of grasslands and open areas of western United States; has large black-tipped ears and black streak on the tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101829633">
	<b:glossaryEntry>large hare of Arctic America almost completely white in winter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101829802"
	 b:glossaryEntry="large large-footed North American hare; white in winter"/>
<rdf:Description rdf:about="&a;101829969">
	<b:glossaryEntry>red breed of domestic rabbits; hybrid between Old_World_rabbit and hare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101830110"
	 b:glossaryEntry="domestic breed with long white silky hair"/>
<rdf:Description rdf:about="&a;101830220"
	 b:glossaryEntry="pikas and extinct forms"/>
<rdf:Description rdf:about="&a;101830379">
	<b:glossaryEntry>small short-eared burrowing mammal of rocky uplands of Asia and western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101830612"
	 b:glossaryEntry="type genus of the Ochotonidae"/>
<rdf:Description rdf:about="&a;101830770"
	 b:glossaryEntry="North American pika"/>
<rdf:Description rdf:about="&a;101830892"
	 b:glossaryEntry="similar to little chief hare and may be same species"/>
<rdf:Description rdf:about="&a;101831043">
	<b:glossaryEntry>small gnawing animals: porcupines; rats; mice; squirrels; marmots; beavers; gophers; voles; hamsters; guinea pigs; agoutis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101831351">
	<b:glossaryEntry>relatively small gnawing animals having a single pair of constantly growing incisor teeth specialized for gnawing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101832174">
	<b:glossaryEntry>any of numerous small rodents typically resembling diminutive rats having pointed snouts and small ears on elongated bodies with slender usually hairless tails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101832457"
	 b:glossaryEntry="true rats and mice and related rodents"/>
<rdf:Description rdf:about="&a;101832705">
	<b:glossaryEntry>essential equal to suborder Myomorpha with the Dipodidae excluded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101832886">
	<b:glossaryEntry>any of various long-tailed rodents similar to but larger than a mouse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101833113"
	 b:glossaryEntry="any of various rodents with cheek pouches"/>
<rdf:Description rdf:about="&a;101833283">
	<b:glossaryEntry>originally Old World rats now distributed worldwide; distinguished from the Cricetidae by typically lacking cheek pouches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101833646">
	<b:glossaryEntry>type genus of the Muridae: common house mice; upper incisors have a square-notched tip</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101833832">
	<b:glossaryEntry>brownish-gray Old World mouse now a common household pest worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101833991"
	 b:glossaryEntry="Old World harvest mice"/>
<rdf:Description rdf:about="&a;101834123">
	<b:glossaryEntry>small reddish-brown Eurasian mouse inhabiting e.g. cornfields</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101834282"
	 b:glossaryEntry="Old World field mice"/>
<rdf:Description rdf:about="&a;101834431">
	<b:glossaryEntry>any nocturnal Old World mouse of the genus Apodemus inhabiting woods and fields and gardens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101834630">
	<b:glossaryEntry>nocturnal yellowish-brown mouse inhabiting woods and fields and gardens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101834808"
	 b:glossaryEntry="common house rats; upper incisors have a beveled edge"/>
<rdf:Description rdf:about="&a;101834986"
	 b:glossaryEntry="common domestic rat; serious pest worldwide"/>
<rdf:Description rdf:about="&a;101835173"
	 b:glossaryEntry="brown rat that infests wharves"/>
<rdf:Description rdf:about="&a;101835259"
	 b:glossaryEntry="brown rat commonly found in sewers"/>
<rdf:Description rdf:about="&a;101835349">
	<b:glossaryEntry>common household pest originally from Asia that has spread worldwide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101835519"
	 b:glossaryEntry="bandicoot rats"/>
<rdf:Description rdf:about="&a;101835641"
	 b:glossaryEntry="burrowing scaly-tailed rat of India and Ceylon"/>
<rdf:Description rdf:about="&a;101835777"
	 b:glossaryEntry="jerboa rats"/>
<rdf:Description rdf:about="&a;101835900"
	 b:glossaryEntry="large Australian rat with hind legs adapted for leaping"/>
<rdf:Description rdf:about="&a;101836049"
	 b:glossaryEntry="jerboa rats"/>
<rdf:Description rdf:about="&a;101836168"
	 b:glossaryEntry="leaping rodent of Australian desert areas"/>
<rdf:Description rdf:about="&a;101836289"
	 b:glossaryEntry="water rats of Australia and New Guinea"/>
<rdf:Description rdf:about="&a;101836447"
	 b:glossaryEntry="water rats"/>
<rdf:Description rdf:about="&a;101836567"
	 b:glossaryEntry="any of various amphibious rats"/>
<rdf:Description rdf:about="&a;101836671"
	 b:glossaryEntry="amphibious rat of Australia and New Guinea"/>
<rdf:Description rdf:about="&a;101836789">
	<b:glossaryEntry>mostly small New World rodents including New World mice and lemmings and voles and hamsters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101837451"
	 b:glossaryEntry="a variety of rodent"/>
<rdf:Description rdf:about="&a;101837569"
	 b:glossaryEntry="New World harvest mice"/>
<rdf:Description rdf:about="&a;101837715">
	<b:glossaryEntry>any of several small grayish New World mice inhabiting e.g. grain fields</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101837891"
	 b:glossaryEntry="New World wood mice"/>
<rdf:Description rdf:about="&a;101838081"
	 b:glossaryEntry="any of various New World woodland mice"/>
<rdf:Description rdf:about="&a;101838266"
	 b:glossaryEntry="American woodland mouse with white feet and underparts"/>
<rdf:Description rdf:about="&a;101838441">
	<b:glossaryEntry>brownish New World mouse; most widely distributed member of the genus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101838611">
	<b:glossaryEntry>burrowing mouse of desert areas of southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101838772"
	 b:glossaryEntry="large dark mouse of southeastern United States"/>
<rdf:Description rdf:about="&a;101838920"
	 b:glossaryEntry="pygmy mice"/>
<rdf:Description rdf:about="&a;101839038">
	<b:glossaryEntry>very small dark grayish brown mouse resembling a house mouse; of Texas and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101839214"
	 b:glossaryEntry="grasshopper mice"/>
<rdf:Description rdf:about="&a;101839342"
	 b:glossaryEntry="insectivorous mouse of western North America"/>
<rdf:Description rdf:about="&a;101839469"
	 b:glossaryEntry="muskrats"/>
<rdf:Description rdf:about="&a;101839585">
	<b:glossaryEntry>beaver-like aquatic rodent of North America with dark glossy brown fur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101839759"
	 b:glossaryEntry="round-tailed muskrat"/>
<rdf:Description rdf:about="&a;101839889"
	 b:glossaryEntry="of Florida wetlands"/>
<rdf:Description rdf:about="&a;101840032"
	 b:glossaryEntry="American cotton rats"/>
<rdf:Description rdf:about="&a;101840162">
	<b:glossaryEntry>destructive long-haired burrowing rat of southern North America and Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101840341">
	<b:glossaryEntry>any of various small short-tailed rodents of the northern hemisphere having soft fur gray above and white below with well-furred tails and large ears; some are hosts for Ixodes pacificus and Ixodes scapularis (Lyme disease ticks)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101840708">
	<b:glossaryEntry>any of various small mouselike rodents of the family Cricetidae esp. of genus Microtus having a stout short-tailed body and inconspicuous ears and inhabiting fields or meadows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101841092"
	 b:glossaryEntry="packrats"/>
<rdf:Description rdf:about="&a;101841246">
	<b:glossaryEntry>any of several bushy-tailed rodents of the genus Neotoma of western North America; hoards food and other objects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101841510">
	<b:glossaryEntry>host to Lyme disease tick (Ixodes pacificus) in northern California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101841682">
	<b:glossaryEntry>large grayish-brown woodrat of the southeastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101841844"
	 b:glossaryEntry="rice rats"/>
<rdf:Description rdf:about="&a;101841963">
	<b:glossaryEntry>hardy agile rat of grassy marshes of Mexico and the southeastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101842136"
	 b:glossaryEntry="pine mice"/>
<rdf:Description rdf:about="&a;101842253">
	<b:glossaryEntry>short-tailed glossy-furred burrowing vole of the eastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101842431"
	 b:glossaryEntry="voles of the northern hemisphere"/>
<rdf:Description rdf:about="&a;101842611">
	<b:glossaryEntry>widely distributed in grasslands of northern United States and Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101842798"
	 b:glossaryEntry="of western North America"/>
<rdf:Description rdf:about="&a;101842939">
	<b:glossaryEntry>typical vole of the extended prairie region of central United States and southern Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101843128"
	 b:glossaryEntry="in some classifications considered synonymous with Microtus"/>
<rdf:Description rdf:about="&a;101843297"
	 b:glossaryEntry="common large Eurasian vole"/>
<rdf:Description rdf:about="&a;101843432"
	 b:glossaryEntry="a genus of Cricetidae"/>
<rdf:Description rdf:about="&a;101843573">
	<b:glossaryEntry>any of several voles of mountainous regions of Eurasia and America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101843736"
	 b:glossaryEntry="North American boles"/>
<rdf:Description rdf:about="&a;101843857">
	<b:glossaryEntry>any of several vole-like terrestrial or arboreal rodents of cold forested regions of Canada and western United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101844050"
	 b:glossaryEntry="type genus of the Cricetidae: Old World hamsters"/>
<rdf:Description rdf:about="&a;101844208">
	<b:glossaryEntry>short-tailed Old World burrowing rodent with large cheek pouches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101844381"
	 b:glossaryEntry="a variety of hamster common to Europe and Asia"/>
<rdf:Description rdf:about="&a;101844510"
	 b:glossaryEntry="golden hamsters"/>
<rdf:Description rdf:about="&a;101844643"
	 b:glossaryEntry="small light-colored hamster often kept as a pet"/>
<rdf:Description rdf:about="&a;101844810"
	 b:glossaryEntry="gerbils"/>
<rdf:Description rdf:about="&a;101844956"
	 b:glossaryEntry="type genus of the Gerbillinae: typical gerbils"/>
<rdf:Description rdf:about="&a;101845095">
	<b:glossaryEntry>small Old World burrowing desert rodent with long soft pale fur and hind legs adapted for leaping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101845329"
	 b:glossaryEntry="a genus of Cricetidae"/>
<rdf:Description rdf:about="&a;101845498"
	 b:glossaryEntry="North African gerbils"/>
<rdf:Description rdf:about="&a;101845589"
	 b:glossaryEntry="popular as a pet"/>
<rdf:Description rdf:about="&a;101845710"
	 b:glossaryEntry="southern European gerbil"/>
<rdf:Description rdf:about="&a;101845830">
	<b:glossaryEntry>any of various short-tailed furry-footed rodents of circumpolar distribution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101846087"
	 b:glossaryEntry="lemmings"/>
<rdf:Description rdf:about="&a;101846220">
	<b:glossaryEntry>notable for mass migrations even into the sea where many drown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101846380"
	 b:glossaryEntry="of northwestern Canada and Alaska"/>
<rdf:Description rdf:about="&a;101846515"
	 b:glossaryEntry="a genus of Cricetidae"/>
<rdf:Description rdf:about="&a;101846642"
	 b:glossaryEntry="Old World lemming"/>
<rdf:Description rdf:about="&a;101846758"
	 b:glossaryEntry="pied lemmings"/>
<rdf:Description rdf:about="&a;101846887">
	<b:glossaryEntry>North American lemming having a white winter coat and some claws much enlarged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101847061"
	 b:glossaryEntry="of northern Canada"/>
<rdf:Description rdf:about="&a;101847177"
	 b:glossaryEntry="bog lemmings"/>
<rdf:Description rdf:about="&a;101847284">
	<b:glossaryEntry>of low bogs and meadows of northeastern and central United States and southern Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101847457"
	 b:glossaryEntry="of wet alpine and subalpine meadows of Canada and Alaska"/>
<rdf:Description rdf:about="&a;101847602">
