	 b:glossaryEntry='burn slowly and without without a flame; "a smoldering fire"'/>
<rdf:Description rdf:about="&a;200263340"
	 b:glossaryEntry='make very hot; "searing heat"'/>
<rdf:Description rdf:about="&a;200263466">
	<b:glossaryEntry>burn or sear with a sizzling sound; "The fat sizzled in the pan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200263602"
	 b:glossaryEntry='burn up completely; reduce to ashes; "burn garbage"'/>
<rdf:Description rdf:about="&a;200263752"
	 b:glossaryEntry='burn superficially or lightly; "I singed my eyebrows"'/>
<rdf:Description rdf:about="&a;200263886"
	 b:glossaryEntry='destroy by fire; "They burned the house and his diaries"'/>
<rdf:Description rdf:about="&a;200264101">
