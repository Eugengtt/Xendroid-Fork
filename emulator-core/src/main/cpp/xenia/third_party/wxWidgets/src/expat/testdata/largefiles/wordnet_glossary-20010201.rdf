	 b:glossaryEntry="coloration of living tissues by pigment"/>
<rdf:Description rdf:about="&a;103889434"
	 b:glossaryEntry="abnormal pigmentation"/>
<rdf:Description rdf:about="&a;103889512">
	<b:glossaryEntry>abnormally dark skin caused by increased deposits of melatonin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103889632"
	 b:glossaryEntry="the coloring of a person''s face"/>
<rdf:Description rdf:about="&a;103889905"
	 b:glossaryEntry="the property of having a naturally light complexion"/>
<rdf:Description rdf:about="&a;103890034"
	 b:glossaryEntry="a healthy reddish complexion"/>
<rdf:Description rdf:about="&a;103890129">
