</rdf:Description>
<rdf:Description rdf:about="&a;101646942"
	 b:glossaryEntry="meerkats"/>
<rdf:Description rdf:about="&a;101647060">
	<b:glossaryEntry>South African mongoose-like viverrine having a face like a lemur and only four toes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101647262"
	 b:glossaryEntry="a meerkat with a thin and elongated tail"/>
<rdf:Description rdf:about="&a;101647392">
	<b:glossaryEntry>burrowing diurnal meerkat of southern Africa; often kept as a pet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101647536">
	<b:glossaryEntry>an old order dating to early Eocene: bats: suborder_Megachiroptera (fruit bats); suborder_Microchiroptera (insectivorous bats)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101647814">
