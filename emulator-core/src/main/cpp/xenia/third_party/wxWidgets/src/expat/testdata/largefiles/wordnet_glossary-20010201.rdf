</rdf:Description>
<rdf:Description rdf:about="&a;106519930">
	<b:glossaryEntry>the southernmost of the four main islands of Japan; contains coal fields</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106520131">
