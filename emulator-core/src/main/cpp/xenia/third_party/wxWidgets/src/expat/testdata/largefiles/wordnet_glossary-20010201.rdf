	 b:glossaryEntry="a mountain mahogany"/>
<rdf:Description rdf:about="&a;110834931">
	<b:glossaryEntry>wood used for fuel; "they collected and cut their own firewood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110835121"
	 b:glossaryEntry="firewood cut and stacked in cords; wood sold by the cord"/>
<rdf:Description rdf:about="&a;110835232"
	 b:glossaryEntry="large log at the back of a hearth fire"/>
<rdf:Description rdf:about="&a;110835348"
	 b:glossaryEntry="large log traditionally burned at Christmas"/>
<rdf:Description rdf:about="&a;110835446"
	 b:glossaryEntry="a piece of wood that has been burned or is burning"/>
<rdf:Description rdf:about="&a;110835560"
	 b:glossaryEntry="a joint of pine wood used for fuel"/>
<rdf:Description rdf:about="&a;110835650"
	 b:glossaryEntry="a substance used to ignite or kindle a fire"/>
<rdf:Description rdf:about="&a;110835821"
	 b:glossaryEntry="material for starting a fire"/>
<rdf:Description rdf:about="&a;110835940">
	<b:glossaryEntry>substance that smolders when ignited; used to light fuses (especially fireworks)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110836071">
	<b:glossaryEntry>a stout length of sawn timber; made in a wide variety of sizes and used for many purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110836330">
	<b:glossaryEntry>a cheap hard material made from wood chips that are pressed together and bound with synthetic resin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110836497"
	 b:glossaryEntry="a plank of softwood (fir or pine board)"/>
<rdf:Description rdf:about="&a;110836587">
	<b:glossaryEntry>a hard cross-grained round piece of wood in a board where a branch emerged; "the saw buckled when it hit a knot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110836769"
	 b:glossaryEntry="a hole in a board where a knot came out"/>
<rdf:Description rdf:about="&a;110836882">
	<b:glossaryEntry>a long thin board with one edge thicker than the other; used as siding by lapping one board over the board below</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110837083">
	<b:glossaryEntry>a mineral consisting of iron-manganese tungstate in crystalline form; the principal ore of tungsten; found in quartz veins associated with granitic rocks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110837338">
	<b:glossaryEntry>wood that has been ground to a pulp; used in making cellulose products (as rayon or paper)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110837484">
	<b:glossaryEntry>a sugar extracted from wood or straw; used in foods for diabetics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110837615">
	<b:glossaryEntry>a fusible bismuth-base alloy; melts at about 160 degrees Fahrenheit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110837756"
	 b:glossaryEntry="any tar obtained by the destructive distillation of wood"/>
<rdf:Description rdf:about="&a;110837885">
	<b:glossaryEntry>fiber sheared from animals (such as sheep) and twisted into yarn for weaving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110838156"
	 b:glossaryEntry="wool in its natural condition; not refined or processed"/>
<rdf:Description rdf:about="&a;110838266"
	 b:glossaryEntry="wool of the alpaca"/>
<rdf:Description rdf:about="&a;110838337"
	 b:glossaryEntry="the wool of the Kashmir goat"/>
<rdf:Description rdf:about="&a;110838420"
	 b:glossaryEntry="the wool of a sheep or similar animal"/>
<rdf:Description rdf:about="&a;110838510"
	 b:glossaryEntry="reclaimed wool fiber"/>
<rdf:Description rdf:about="&a;110838583"
	 b:glossaryEntry="the wool of the vicuna"/>
<rdf:Description rdf:about="&a;110838658"
	 b:glossaryEntry="wool not used before; wool not processed or woven before"/>
<rdf:Description rdf:about="&a;110838772"
	 b:glossaryEntry="a tough paper used for wrapping"/>
<rdf:Description rdf:about="&a;110838918">
	<b:glossaryEntry>paper material made into thin sheets that are sized to take ink; used for writing correspondence and manuscripts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110839270"
	 b:glossaryEntry="any oil used to oil wool before spinning"/>
<rdf:Description rdf:about="&a;110839365">
	<b:glossaryEntry>a brown-to-yellow mineral that is a phosphate of yttrium in crystalline form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110839553">
	<b:glossaryEntry>a colorless flammable volatile liquid hydrocarbon used as a solvent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110839681">
	<b:glossaryEntry>a commercial leavening agent containing yeast cells; used to raise the dough in making bread and for fermenting beer or whiskey</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110839921">
	<b:glossaryEntry>a stringy slimy substance consisting of yeast cells and bacteria; forms during fermentation and is added to cider or wine to produce vinegar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110840114">
	<b:glossaryEntry>an ore that is the chief source of zinc; consists largely of zinc sulfide in crystalline form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110840325">
	<b:glossaryEntry>oxide of zinc; a white powder used as a pigment or in cosmetics or glass or inks and in zinc ointment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110840541">
	<b:glossaryEntry>a colorless water-soluble powder; used as a mordant or to preserve wood or for the electrodeposition of zinc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110840755"
	 b:glossaryEntry="a white pigment used in hose paints; consists of zinc oxide"/>
<rdf:Description rdf:about="&a;110840890">
	<b:glossaryEntry>a steel gray metallic mineral (a sulphide of lead and antimony)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110841009"
	 b:glossaryEntry="a mica containing iron and lithium"/>
<rdf:Description rdf:about="&a;110841120">
	<b:glossaryEntry>a common mineral occurring in small crystals; chief source of zirconium; used as a refractory when opaque and as a gem when transparent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110841384">
	<b:glossaryEntry>a white crystalline oxide; used in refractories and in insulation and abrasives and enamels and glazes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110841579">
	<b:glossaryEntry>a complex of enzymes that cause glycolysis; originally found in yeast but also present in higher organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110841738"
	 b:glossaryEntry="something that is produced by emanation"/>
<rdf:Description rdf:about="&a;110841851">
	<b:glossaryEntry>(in spiritualism) the substance supposed to emanate from the body of the medium during a trance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110842002">
	<b:glossaryEntry>any substance possessing to a high degree the predominant properties of a plant or drug or other natural product from which it is extracted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110842195">
	<b:glossaryEntry>an atom or molecule or radical or ion that forms a complex around a central atom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110842328">
	<b:glossaryEntry>a colored glassy compound (opaque or partially opaque) that is fused to the surface of metal or glass or pottery for decoration or protection</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110842522">
	<b:glossaryEntry>any of a class of organic compounds that contain the divalent radical -CONHCO-</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110842652">
	<b:glossaryEntry>any substance involved in metabolism (either as a product of metabolism or as necessary for metabolism)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110842812">
	<b:glossaryEntry>any of a group of synthetic steroid hormones used to stimulate muscle and bone growth; sometimes used illicitly by athletes to increase their strength</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110843025">
	<b:glossaryEntry>a toxic alkaloid found in certain tropical South American trees that is a powerful relaxant for striated muscles; used by South American indians as an arrow poison; "curare acts by blocking cholinergic transmission at the myoneural junction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110843334">
	<b:glossaryEntry>a sterile liquid containing a purified protein derivative of the tuberculosis bacterium; used in the diagnosis of tuberculosis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110843517"
	 b:glossaryEntry="a chemical agent that causes blistering"/>
<rdf:Description rdf:about="&a;110843624">
	<b:glossaryEntry>an indefinite length of time; "a time period of 30 years"; "hastened the period of his recovery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110845909">
	<b:glossaryEntry>the time of the physical formation and development of the earth (especially prior to human history)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110846176"
	 b:glossaryEntry="the time of various biological processes"/>
<rdf:Description rdf:about="&a;110846350">
	<b:glossaryEntry>the time covered by the physical formation and development of the universe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110846536">
	<b:glossaryEntry>the official time in a local region (adjusted for location around the Earth); established by law or custom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110846872">
	<b:glossaryEntry>time during which clocks are set one hour ahead of local standard time; widely adopted during summer to provide extra daylight in the evenings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110847142"
	 b:glossaryEntry='an indefinite period of time; "they talked for hours"'/>
<rdf:Description rdf:about="&a;110847247">
	<b:glossaryEntry>a period of time when something (as a machine or factory) is not operating (especially as a result of malfunctions)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110847417"
	 b:glossaryEntry='a period of time assigned for work; "they work long hours"'/>
<rdf:Description rdf:about="&a;110847545"
	 b:glossaryEntry="a time period when you are required to work"/>
<rdf:Description rdf:about="&a;110847752">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a time period when you are not required to work; "he requested time off to attend his grandmother''s funeral"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110848005">
	<b:glossaryEntry>a period of time spent traveling; "workers were not paid for their travel time between home and factory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110848167">
	<b:glossaryEntry>any continuous stretch of time including the moment of speech; "that is enough for the present"; "he lives in the present with no thought of tomorrow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110848508">
	<b:glossaryEntry>the momentary present; "Now is a good time to do it"; "it worked up to right now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110848639">
	<b:glossaryEntry>at this time; "the disappointments of the here and now"; "she is studying at the moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110848812">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the present; "they are up to date"; "we haven''t heard from them to date"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110848935">
	<b:glossaryEntry>the circumstances and ideas of the present age; "behind the times"; "in times like these"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110849142"
	 b:glossaryEntry='the time that has elapsed; "forget the past"'/>
<rdf:Description rdf:about="&a;110849396"
	 b:glossaryEntry='past events to be put aside; "let bygones be bygones"'/>
<rdf:Description rdf:about="&a;110849502"
	 b:glossaryEntry='past times (especially in the phrase "in days of old")'/>
<rdf:Description rdf:about="&a;110849606">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the aggregate of past events: "a critical time in the school''s history"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110849807"
	 b:glossaryEntry="the time yet to come"/>
<rdf:Description rdf:about="&a;110850008"
	 b:glossaryEntry="the beat of musical rhythm"/>
<rdf:Description rdf:about="&a;110850147">
	<b:glossaryEntry>an indefinite period (usually marked by specific attributes or activities); "he waited a long time"; "the time of year for planting"; "he was a great actor is his time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110850510"
	 b:glossaryEntry='a historic period; "we live in a litigious age"'/>
<rdf:Description rdf:about="&a;110850643">
	<b:glossaryEntry>a period in British history during the reign of Queen Elizabeth I in the 16th century; an age marked by literary achievement and domestic prosperity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110850853">
	<b:glossaryEntry>a period in British history during the reign of Queen Victoria in the 19th century; her character and moral standards restored the prestige of the British monarchy but gave the era a prudish reputation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110851114">
	<b:glossaryEntry>some point or period in time; "it should arrive any day now"; "after that day she never trusted him again"; "those were the days"; "these days it is not unusual"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110851379">
	<b:glossaryEntry>a time when coldness (or some other quality associated with death) is intense; "the dead of winter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110851529"
	 b:glossaryEntry="a time of difficulty"/>
<rdf:Description rdf:about="&a;110851606">
	<b:glossaryEntry>a continuous nonspatial whole or extent or succession in which no part or portion is distinct of distinguishable from adjacent parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110851812">
	<b:glossaryEntry>the continuum of events occurring in succession leading from the past to the present and even into the future: "all of human history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110851999"
	 b:glossaryEntry="approximately the last 63 million years"/>
<rdf:Description rdf:about="&a;110852163"
	 b:glossaryEntry="last 2 million years"/>
<rdf:Description rdf:about="&a;110852330"
	 b:glossaryEntry="approximately the last 10,000 years"/>
<rdf:Description rdf:about="&a;110852471">
	<b:glossaryEntry>from 11 thousand to 2 millions years ago; extensive glaciation of N hemisphere; time of human evolution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110852687"
	 b:glossaryEntry="from 2 million to 63 million years ago"/>
<rdf:Description rdf:about="&a;110852912">
	<b:glossaryEntry>from 2 million to 13 million years ago; growth of mountains; cooling of climate; more and larger mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110853107">
	<b:glossaryEntry>from 13 million to 25 million years ago; appearance of grazing mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110853266">
	<b:glossaryEntry>from 25 million to 40 million years ago; appearance of sabertoothed cats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110853431">
	<b:glossaryEntry>from 40 million to 58 million years ago; presence of modern mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110853585">
	<b:glossaryEntry>from 58 million to 63 million years ago; appearance of birds and earliest mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110853759"
	 b:glossaryEntry="from 63 million to 230 million years ago"/>
<rdf:Description rdf:about="&a;110853944">
	<b:glossaryEntry>from 63 million to 135 million years ago; end of the age of reptiles; appearance of modern insects and flowering plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110854159">
	<b:glossaryEntry>from 135 million to 190 million years ago; dinosaurs; conifers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110854313">
	<b:glossaryEntry>from 190 million to 230 million years ago; dinosaurs, marine reptiles; volcanic activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110854493"
	 b:glossaryEntry="from 230 million to 600 million years ago"/>
<rdf:Description rdf:about="&a;110854720"
	 b:glossaryEntry="from 230 million to 280 million years ago; reptiles"/>
<rdf:Description rdf:about="&a;110854861"
	 b:glossaryEntry="from 280 million to 345 million years ago"/>
<rdf:Description rdf:about="&a;110855042">
	<b:glossaryEntry>from 280 million to 310 million years ago; warm climate; swampy land</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110855263">
	<b:glossaryEntry>from 310 million to 345 million years ago; increase of land areas; primitive ammonites; winged insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110855515">
	<b:glossaryEntry>from 345 million to 405 million years ago; dominance of fishes and appearance of amphibians and ammonites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110855728">
	<b:glossaryEntry>from 405 million to 425 million years ago; first air-breathing animals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110855890">
	<b:glossaryEntry>from 425 million to 500 million years ago; conodonts and ostracods and algae and seaweeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110856075">
	<b:glossaryEntry>from 500 million to 600 million years ago; marine invertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110856230"
	 b:glossaryEntry="the time before 600 million years ago"/>
<rdf:Description rdf:about="&a;110856384">
	<b:glossaryEntry>from 600 million to 1.5 billion years ago; bacteria and fungi; primitive multicellular organisms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110856576">
	<b:glossaryEntry>the time from 1.5 billion to 5 billion years ago; earth''s crust formed; unicellular organisms are earliest forms of life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110856821">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the time as given by a clock; "do you know what time it is?"; "the time is 10 o''clock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110857061">
	<b:glossaryEntry>the local time at the 0 meridian passing through Greenwich, England; it is the same everywhere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110857290"
	 b:glossaryEntry="Greenwich Mean Time updated with leap seconds"/>
<rdf:Description rdf:about="&a;110857468">
	<b:glossaryEntry>the universal time coordinated when an event is received on Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110857605">
	<b:glossaryEntry>the elapsed time it takes for light (or radio signals) to travel between the Earth and a celestial object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110857782">
	<b:glossaryEntry>the elapsed time it takes for a signal to travel from Earth to a spacecraft (or other body) and back to the starting point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110857979"
	 b:glossaryEntry="the time that elapses while some event is occurring"/>
<rdf:Description rdf:about="&a;110858125">
	<b:glossaryEntry>the universal time coordinated time when a transmission is sent from Earth to a spacecraft or other celestial body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110858309">
	<b:glossaryEntry>the universal time coordinated time on board the spacecraft; "SCET = TRM + OWLT"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110858464">
	<b:glossaryEntry>the clock time given by a clock carried on board a spacecraft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110858600">
	<b:glossaryEntry>time of the 60th meridian, used in Puerto Rico, the Virgin Islands, Bermuda, and the eastern edge of Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110858767">
	<b:glossaryEntry>time of the 75th meridian, fifth time zone west of Greenwich, used in the eastern U.S.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110858942"
	 b:glossaryEntry="time of the 90th meridian, used in the central U.S."/>
<rdf:Description rdf:about="&a;110859082">
	<b:glossaryEntry>time of the 105th meridian, used in the mountain states of the U.S.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110859240">
	<b:glossaryEntry>time of the 120th meridian, used in far western states of the U.S.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110859395"
	 b:glossaryEntry="time of the 135th meridian"/>
<rdf:Description rdf:about="&a;110859478">
	<b:glossaryEntry>time of the 150th meridian, used in Hawaii and most of Alaska</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110859604">
	<b:glossaryEntry>time of the 165th meridian, used in western Alaska and the Aleutian Islands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110859737"
	 b:glossaryEntry="the property of enduring or continuing in time"/>
<rdf:Description rdf:about="&a;110859852"
	 b:glossaryEntry="the period of time during which something continues"/>
<rdf:Description rdf:about="&a;110860098">
	<b:glossaryEntry>the time taken to traverse a measured course; "it was a world record clocking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110860231">
	<b:glossaryEntry>a period of dullness or boredom (especially in a work of literature or performing art)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110860372">
	<b:glossaryEntry>the complete duration of something; "the job was finished in the span of an hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110860522">
	<b:glossaryEntry>an unbroken period of time during which you do something; "there were stretches of boredom"; "he did a stretch in the federal penitentiary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110860723">
	<b:glossaryEntry>an arrangement of events used as a measure of duration; "on the geological time scale mankind has existed but for a brief moment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110860945"
	 b:glossaryEntry="(music) the relative duration of a musical note"/>
<rdf:Description rdf:about="&a;110861070">
	<b:glossaryEntry>(in simulation) the time scale used in data processing when the time-scale factor is greater than one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110861255">
	<b:glossaryEntry>(in simulation) the time scale used in data processing when the time-scale factor is less than one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110861415"
	 b:glossaryEntry='the present occasion; "for the nonce"'/>
<rdf:Description rdf:about="&a;110861517">
	<b:glossaryEntry>an innate mechanism in living organisms that controls the periodicity of many physiological functions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110861681"
	 b:glossaryEntry="a daily cycle of activity observed in many living organisms"/>
<rdf:Description rdf:about="&a;110861803">
	<b:glossaryEntry>the fourth coordinate that is required (along with three spatial dimensions) to specify a physical event</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110861977">
	<b:glossaryEntry>hours or days of work in a calendar week; "they worked a 40-hour week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110862128"
	 b:glossaryEntry="a period of seven consecutive days starting on Sunday"/>
<rdf:Description rdf:about="&a;110862286">
	<b:glossaryEntry>the recurring hours established by contract or usage for work; "it was a busy day on the stock exchange"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110862458">
	<b:glossaryEntry>the amount of time that a worker must work for an agreed daily wage; "they work an 8-hour day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110862658"
	 b:glossaryEntry="a day on which work is done"/>
<rdf:Description rdf:about="&a;110862782"
	 b:glossaryEntry="a day set aside for rest"/>
<rdf:Description rdf:about="&a;110862929"
	 b:glossaryEntry="work done in addition to regular working hours"/>
<rdf:Description rdf:about="&a;110863030"
	 b:glossaryEntry="time need to prepare a vessel or ship for a return trip"/>
<rdf:Description rdf:about="&a;110863160"
	 b:glossaryEntry="time when you are free to do things that you enjoy"/>
<rdf:Description rdf:about="&a;110863279">
	<b:glossaryEntry>a day when you are not required to work; "Thursday is his day off"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110863399">
	<b:glossaryEntry>time available for ease and relaxation; "his job left him little leisure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110863595"
	 b:glossaryEntry="leisure time away from work; devoted to rest or pleasure"/>
<rdf:Description rdf:about="&a;110863788"
	 b:glossaryEntry="British informal term"/>
<rdf:Description rdf:about="&a;110863859"
	 b:glossaryEntry="a day on which half is free from work or duty"/>
<rdf:Description rdf:about="&a;110863963"
	 b:glossaryEntry="time for play or diversion"/>
<rdf:Description rdf:about="&a;110864054"
	 b:glossaryEntry="a day devoted to an outdoor social gathering"/>
<rdf:Description rdf:about="&a;110864172"
	 b:glossaryEntry="a time of unusual pleasure and success"/>
<rdf:Description rdf:about="&a;110864266"
	 b:glossaryEntry="a holiday taken by a newly married couple"/>
<rdf:Description rdf:about="&a;110864363"
	 b:glossaryEntry="a vacation from work by an employee with pay granted"/>
<rdf:Description rdf:about="&a;110864475">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the period of time during which you are absent from work or duty; "a ten day''s leave to visit his mother"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110864777"
	 b:glossaryEntry="a temporary leave of absence from military duty"/>
<rdf:Description rdf:about="&a;110864879">
	<b:glossaryEntry>(military) a written leave of absence; "he had a pass for three days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110864999">
	<b:glossaryEntry>(military) granted in an emergency such as family sickness or death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110865132"
	 b:glossaryEntry="a leave usually taken every seventh year"/>
<rdf:Description rdf:about="&a;110865266"
	 b:glossaryEntry="a sabbatical leave lasting one year"/>
<rdf:Description rdf:about="&a;110865363"
	 b:glossaryEntry="leave granted to a sailor or naval officer"/>
<rdf:Description rdf:about="&a;110865473"
	 b:glossaryEntry="a leave of absence from work because of illness"/>
<rdf:Description rdf:about="&a;110865577"
	 b:glossaryEntry="final leave before discharge from military service"/>
<rdf:Description rdf:about="&a;110865688">
	<b:glossaryEntry>the period during which something is functional (as between birth and death); "the battery had a short life"; "he lived a long and happy life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110866015">
	<b:glossaryEntry>the period between birth and the present time; "I have known him all his life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110866163">
	<b:glossaryEntry>the period from the present until death; "he appointed himself emperor for life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110866312">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the time during which someone''s life continues; "the monarch''s last days"; "in his final years"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110866466"
	 b:glossaryEntry="a span of 1000 years"/>
<rdf:Description rdf:about="&a;110866562"
	 b:glossaryEntry="a span of 2000 years"/>
<rdf:Description rdf:about="&a;110866655">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a earlier period in someone''s life (especially one that they have reason to keep secret); "reporters dug into the candidate''s past"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110866856">
	<b:glossaryEntry>the length of time a packaged food or drug will last without deteriorating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110866987">
	<b:glossaryEntry>an expected time to live as calculated on the basis of statistical probabilities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110867147">
	<b:glossaryEntry>the time when something begins (especially life); "they divorced after the birth of the child" or "his election signaled the birth of a new age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110867398">
	<b:glossaryEntry>birth of a person; "he was taught from the cradle never to cry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110867514">
	<b:glossaryEntry>beginning to exist or to be apparent; "he placed the incipience of democratic faith at around 1850"; "it is designed to arrest monopolies in their incipiency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110867742">
	<b:glossaryEntry>the end of life; continuing until dead; "he bled to death"; "a struggle to the last"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110867885">
	<b:glossaryEntry>the time when something ends; "it was the death of all his plans"; "a dying of old hopes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110868098">
	<b:glossaryEntry>death of a person; "he went to his grave without forgiving me"; "from cradle to grave"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110868236"
	 b:glossaryEntry="life after death"/>
<rdf:Description rdf:about="&a;110868338"
	 b:glossaryEntry="perpetual life after death"/>
<rdf:Description rdf:about="&a;110868422">
	<b:glossaryEntry>the end or completion of something; "death put a period to his endeavors"; "a change soon put a period to my tranquility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110868596">
	<b:glossaryEntry>a period of time during which a person is normally in a particular life state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110869183">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a time of life characterized as a distinct phase; "Picasso''s blue period"; "it was the happy period of my life"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110869347">
	<b:glossaryEntry>a time in life (usually defined in years) at which some particular qualification or power arises; "she was now of school age"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110869613"
	 b:glossaryEntry="the early stage of growth or development"/>
<rdf:Description rdf:about="&a;110869754">
	<b:glossaryEntry>(psychoanalysis) the second sexual and social stage of a child''s development during which bowel control is learned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110869938">
	<b:glossaryEntry>(psychoanalysis) the third sexual and social stage in a child''s development; sexual interest focuses on the child''s own sex organs and those of others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110870164">
	<b:glossaryEntry>(psychoanalysis) the period from about age 5 or 6 until puberty during which sexual interests are supposed to be sublimated into other activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110870402">
	<b:glossaryEntry>(psychoanalysis) the first sexual and social stage of an infant''s development; the mouth is the focus of the libido and satisfaction comes from suckling and chewing and biting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110870647"
	 b:glossaryEntry="the time of person''s life when they are a child"/>
<rdf:Description rdf:about="&a;110870840"
	 b:glossaryEntry="the childhood of a girl"/>
<rdf:Description rdf:about="&a;110870942"
	 b:glossaryEntry="the childhood of a boy"/>
<rdf:Description rdf:about="&a;110871018"
	 b:glossaryEntry="the time of life when you are going to school"/>
<rdf:Description rdf:about="&a;110871133"
	 b:glossaryEntry="the time of life between childhood and maturity"/>
<rdf:Description rdf:about="&a;110871270"
	 b:glossaryEntry="the time of life between puberty and adulthood"/>
<rdf:Description rdf:about="&a;110871412"
	 b:glossaryEntry="the time of life when sex glands become functional"/>
<rdf:Description rdf:about="&a;110871548"
	 b:glossaryEntry="the time of life between the ages of 12 and 20"/>
<rdf:Description rdf:about="&a;110871665"
	 b:glossaryEntry="the time of life between 20 and 30"/>
<rdf:Description rdf:about="&a;110871788"
	 b:glossaryEntry="the decade from 1920 to 1929"/>
<rdf:Description rdf:about="&a;110871871"
	 b:glossaryEntry="the time of life between 30 and 40"/>
<rdf:Description rdf:about="&a;110872013"
	 b:glossaryEntry="the decade from 1930 to 1939"/>
<rdf:Description rdf:about="&a;110872096"
	 b:glossaryEntry="the time of life between 40 and 50"/>
<rdf:Description rdf:about="&a;110872217"
	 b:glossaryEntry="the decade from 1940 to 1949"/>
<rdf:Description rdf:about="&a;110872299"
	 b:glossaryEntry="the time of life between 50 and 60"/>
<rdf:Description rdf:about="&a;110872420"
	 b:glossaryEntry="the decade from 1950 to 1959"/>
<rdf:Description rdf:about="&a;110872502"
	 b:glossaryEntry="the time of life between 60 and 70"/>
<rdf:Description rdf:about="&a;110872623"
	 b:glossaryEntry="the decade from 1960 to 1969"/>
<rdf:Description rdf:about="&a;110872705"
	 b:glossaryEntry="the time of life between 70 and 80"/>
<rdf:Description rdf:about="&a;110872830"
	 b:glossaryEntry="the decade from 1970 to 1979"/>
<rdf:Description rdf:about="&a;110872914"
	 b:glossaryEntry="the time of life between 80 and 90"/>
<rdf:Description rdf:about="&a;110873037"
	 b:glossaryEntry="the decade from 1980 to 1989"/>
<rdf:Description rdf:about="&a;110873120"
	 b:glossaryEntry="the time of life between 90 and 100"/>
<rdf:Description rdf:about="&a;110873244"
	 b:glossaryEntry="the decade from 1990 to 1999"/>
<rdf:Description rdf:about="&a;110873327"
	 b:glossaryEntry="the decade from 1890 to 1899"/>
<rdf:Description rdf:about="&a;110873410"
	 b:glossaryEntry="the best time of youth"/>
<rdf:Description rdf:about="&a;110873520">
	<b:glossaryEntry>the age at which a person is considered competent to manage their own affairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110873719"
	 b:glossaryEntry="any age prior to the legal age"/>
<rdf:Description rdf:about="&a;110873849"
	 b:glossaryEntry="the time of maturity when power and vigor are greatest"/>
<rdf:Description rdf:about="&a;110873971">
	<b:glossaryEntry>the age at which is legal for a person to buy alcoholic beverages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110874114">
	<b:glossaryEntry>the age at which a person is old enough to vote in public elections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110874257">
	<b:glossaryEntry>the period of time in your life after your physical growth has stopped and you are fully developed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110874611"
	 b:glossaryEntry="the date on which a financial obligation must be repaid"/>
<rdf:Description rdf:about="&a;110874748"
	 b:glossaryEntry="the time of a man''s life prior to marriage"/>
<rdf:Description rdf:about="&a;110874849">
	<b:glossaryEntry>the time of life between youth and old age (e.g., between 40 and 60 years of age)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110875044"
	 b:glossaryEntry="the time of a woman''s life when she is a widow"/>
<rdf:Description rdf:about="&a;110875146">
	<b:glossaryEntry xml:space='preserve'><![CDATA[time of life; "he''s showing his years"; "age hasn''t slowed him down at all"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110875383">
	<b:glossaryEntry>mental infirmity as a consequence of old age; sometimes shown by foolish infatuations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110875551"
	 b:glossaryEntry="the last few hours before death"/>
<rdf:Description rdf:about="&a;110875637">
	<b:glossaryEntry>the time in a woman''s life in which the menstrual cycle ends</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110875803"
	 b:glossaryEntry="a period in a man''s life corresponding to menopause"/>
<rdf:Description rdf:about="&a;110875931"
	 b:glossaryEntry="a unit for measuring time periods"/>
<rdf:Description rdf:about="&a;110876395">
	<b:glossaryEntry>time for Earth to make a complete rotation on its axis; "two days later they left"; "they put on two performances every day"; "there are 30,000 passangers per day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110876859">
	<b:glossaryEntry>the dark part of the diurnal cycle considered a time unit; "three nights later he collapsed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110877003"
	 b:glossaryEntry='the day after today; "what are our tasks for tomorrow?"'/>
<rdf:Description rdf:about="&a;110877113">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the day that includes the present moment (as opposed to yesterday or tomorrow); "Today is beautiful"; "did you see today''s newspaper?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110877300">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the day immediately before today; "it was in yesterday''s newspapers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110877424"
	 b:glossaryEntry='the next day; "whenever he arrives she leaves on the morrow"'/>
<rdf:Description rdf:about="&a;110877537">
	<b:glossaryEntry>the day before; "he always arrives on the eve of her departure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110877650">
	<b:glossaryEntry>(astronomy) time based on the motion of the mean sun (an imaginary sun moving uniformly along the celestial equator)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110877840">
	<b:glossaryEntry>(astronomy) a measure of time defined by Earth''s orbital motion; terrestrial time is mean solar time corrected for the irregularities of the Earth''s motions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110878116"
	 b:glossaryEntry="a day reckoned from midnight to midnight"/>
<rdf:Description rdf:about="&a;110878282">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a day assigned to a particular purpose or observance; "Mother''s Day"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110879210">
	<b:glossaryEntry>in some states of the United States: a legal holiday commemorating the day the state was admitted to the Union</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110879380"
	 b:glossaryEntry="a day designated for planting trees"/>
<rdf:Description rdf:about="&a;110879471"
	 b:glossaryEntry="the day on which university degrees are conferred"/>
<rdf:Description rdf:about="&a;110879596"
	 b:glossaryEntry="British; anniversary of the discovery of the Gunpowder Plot"/>
<rdf:Description rdf:about="&a;110879743"
	 b:glossaryEntry="the day designated for inauguration of the U.S. President"/>
<rdf:Description rdf:about="&a;110879895"
	 b:glossaryEntry="the name of the day that is added during a leap year"/>
<rdf:Description rdf:about="&a;110880047"
	 b:glossaryEntry='the specified day of the month; "what is the date today?"'/>
<rdf:Description rdf:about="&a;110880228">
	<b:glossaryEntry>a particular day specified as the time something will happen; "the date of the election is set by law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110880399">
	<b:glossaryEntry>an alternative date set for some outdoor event in case it rains on the appointed date; "the rain date for the picnic will be the following Sunday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110880601">
	<b:glossaryEntry>the particular year (usually according to the Gregorian calendar) that an event occurred; "he tried to memorizes all the dates for his history class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110880855">
	<b:glossaryEntry>before Christ; used in reckoning dates before the supposed year Christ was born</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110880983">
	<b:glossaryEntry>anno Domini (in the year of Our Lord); used in reckoning dates after the supposed year Christ was born</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110881134">
	<b:glossaryEntry>a Christian holy day; (Britain) one of four specified days when certain payments are due</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110881424"
	 b:glossaryEntry="a day designated for fasting"/>
<rdf:Description rdf:about="&a;110881507"
	 b:glossaryEntry="a day designated for feasting"/>
<rdf:Description rdf:about="&a;110881622"
	 b:glossaryEntry="a festival having religious significance"/>
<rdf:Description rdf:about="&a;110881782">
	<b:glossaryEntry>a day or period of time set aside for feasting and celebration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110881917"
	 b:glossaryEntry="day of the allied landing in France, World War II"/>
<rdf:Description rdf:about="&a;110882032"
	 b:glossaryEntry="the day of a victory"/>
<rdf:Description rdf:about="&a;110882154"
	 b:glossaryEntry="the date of Allied victory in Europe, World War II"/>
<rdf:Description rdf:about="&a;110882271"
	 b:glossaryEntry="the date of Allied victory over Japan, World War II"/>
<rdf:Description rdf:about="&a;110882392"
	 b:glossaryEntry="any one of the seven days in a week"/>
<rdf:Description rdf:about="&a;110882544"
	 b:glossaryEntry="any day except Sunday (and sometimes except Saturday)"/>
<rdf:Description rdf:about="&a;110882795"
	 b:glossaryEntry="a weekday on which no feast is celebrated"/>
<rdf:Description rdf:about="&a;110882888"
	 b:glossaryEntry="the second day of the week; the first working day"/>
<rdf:Description rdf:about="&a;110883014"
	 b:glossaryEntry="the third day of the week; the second working day"/>
<rdf:Description rdf:about="&a;110883142"
	 b:glossaryEntry="the fourth day of the week; the third working day"/>
<rdf:Description rdf:about="&a;110883253"
	 b:glossaryEntry="the fifth day of the week; the fourth working day"/>
<rdf:Description rdf:about="&a;110883362"
	 b:glossaryEntry="the sixth day of the week; the fifth working day"/>
<rdf:Description rdf:about="&a;110883469"
	 b:glossaryEntry="the seventh and last day of the week; the Jewish Sabbath"/>
<rdf:Description rdf:about="&a;110883605">
	<b:glossaryEntry>a day of rest and worship: Sunday for most Christians; Saturday for the Jews and a few Christians; Friday for Muslims</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110883776">
	<b:glossaryEntry>first day of the week; observed as a day of rest and worship by most Christians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110883946">
	<b:glossaryEntry>the time after sunrise and before sunset while it is light outside; "the dawn turned night into day"; "it is easier to make the repairs in the daytime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110884278">
	<b:glossaryEntry>the time period between dawn and noon; "I spent the morning running errands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110884479"
	 b:glossaryEntry="the middle of the day"/>
<rdf:Description rdf:about="&a;110884626"
	 b:glossaryEntry="the time for eating a meal"/>
<rdf:Description rdf:about="&a;110884761"
	 b:glossaryEntry="the time for eating breakfast"/>
<rdf:Description rdf:about="&a;110884851"
	 b:glossaryEntry='the time for eating lunch; "he observed a regular lunchtime"'/>
<rdf:Description rdf:about="&a;110884967"
	 b:glossaryEntry="the time for the evening meal"/>
<rdf:Description rdf:about="&a;110885066">
	<b:glossaryEntry>the part of the day between noon and evening; "he spent a quiet afternoon in the park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110885227"
	 b:glossaryEntry="the middle part of the afternoon"/>
<rdf:Description rdf:about="&a;110885337">
	<b:glossaryEntry>the latter part of the day (the period of decreasing daylight from late afternoon until nightfall); "he enjoyed the evening light across the lake"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110885610">
	<b:glossaryEntry>(British) an evening when members of a club or college can bring their friends as guests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110885756">
	<b:glossaryEntry>the hours between 7 and 11 p.m. when the largest tv audience is available</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110885886">
	<b:glossaryEntry>the time after sunset and before sunrise while it is dark outside</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110886190">
	<b:glossaryEntry>the time between sunset and midnight; "he watched television every night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110886315"
	 b:glossaryEntry='the period spent sleeping; "I had a restless night"'/>
<rdf:Description rdf:about="&a;110886418"
	 b:glossaryEntry="a period of ignorance or backwardness or gloom"/>
<rdf:Description rdf:about="&a;110886516"
	 b:glossaryEntry="any night of the week except Saturday or Sunday"/>
<rdf:Description rdf:about="&a;110886619">
	<b:glossaryEntry>the period immediately before something; "on the eve of the French Revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110886747">
	<b:glossaryEntry>the early part of night (from dinner until bedtime) spent in a special way; "an evening at the opera"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110886921"
	 b:glossaryEntry="the latter part of night"/>
<rdf:Description rdf:about="&a;110887026">
	<b:glossaryEntry xml:space='preserve'><![CDATA[12 o''clock at night; the middle of the night; "young children should not be allowed to stay up until midnight"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110887210"
	 b:glossaryEntry="the hours just after midnight"/>
<rdf:Description rdf:about="&a;110887316"
	 b:glossaryEntry="the time you go to bed"/>
<rdf:Description rdf:about="&a;110887410"
	 b:glossaryEntry="a prescribed bedtime"/>
<rdf:Description rdf:about="&a;110887506">
	<b:glossaryEntry>the first light of day; "we got up before dawn"; "they talked until morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110887780"
	 b:glossaryEntry="an hour early in the morning"/>
<rdf:Description rdf:about="&a;110887892">
	<b:glossaryEntry>the time in the evening at which the sun begins to fall below the horizon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110888065">
	<b:glossaryEntry>the time of day immediately following sunset; "he loved the twilight"; "they finished before the fall of night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110888316">
	<b:glossaryEntry>a shortening of nightfall; "they worked from morning to night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110888430"
	 b:glossaryEntry='any period of seven consecutive days; "it rained for a week"'/>
<rdf:Description rdf:about="&a;110888681">
	<b:glossaryEntry>(informal) a time period of a week or more; "a week from Monday will be too soon!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110888826">
	<b:glossaryEntry>a period of fourteen consecutive days; "most major tennis tournaments last a fortnight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110888981"
	 b:glossaryEntry="usually Friday night through Sunday"/>
<rdf:Description rdf:about="&a;110889127">
	<b:glossaryEntry>(British) a week at British universities during which side-shows and processions of floats are organized to raise money for charities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110889329"
	 b:glossaryEntry="(British) a day on which university students hold a rag"/>
<rdf:Description rdf:about="&a;110889457"
	 b:glossaryEntry="day when the consequences of misdeeds are felt"/>
<rdf:Description rdf:about="&a;110889566">
	<b:glossaryEntry>(New Testament) day of the Last Judgment when God will decree the fates of all men according to the good and evil of their earthly lives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110889869">
	<b:glossaryEntry>a day when things go poorly; "I guess this is one of my off-days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110889988">
	<b:glossaryEntry>(computer science) the interval between the time data is requested by the system and the time the data is provided by the drive; "access time is the sum of seek time and rotational latency and command processing overhead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110890324">
	<b:glossaryEntry>the interval between two times; "the distance from birth to death"; "it all happened in the space of 10 minutes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110890499">
	<b:glossaryEntry>a remote point in time; "if that happens it will be at some distance in the future"; "at a distance of ten years he had forgotten many of the details"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110890704"
	 b:glossaryEntry="an insertion into a calendar"/>
<rdf:Description rdf:about="&a;110890822"
	 b:glossaryEntry="the day on which you receive pay for your work"/>
<rdf:Description rdf:about="&a;110890921">
	<b:glossaryEntry>the day appointed for an election; in the United States it is the 1st Tuesday after the 1st Monday in November</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110891104">
	<b:glossaryEntry>the year in the ecclesiastical calendar; especially feast days and special seasons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110891299"
	 b:glossaryEntry="a day for outdoor athletic competition"/>
<rdf:Description rdf:about="&a;110891393"
	 b:glossaryEntry="(military) a day for military exercises and display"/>
<rdf:Description rdf:about="&a;110891500">
	<b:glossaryEntry>a system of timekeeping that defines the beginning and length and divisions of the year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110891715"
	 b:glossaryEntry="the act or process of determining the time"/>
<rdf:Description rdf:about="&a;110891833">
	<b:glossaryEntry>the lunar calender in use in ancient Rome; replaced by the Julian calendar in 46 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110891977">
	<b:glossaryEntry>in the Roman calendar: the 15th of March or May or July or October or the 13th of any other month</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110892125"
	 b:glossaryEntry="a fixed day for holding a public market"/>
<rdf:Description rdf:about="&a;110892221">
	<b:glossaryEntry>the solar calendar now in general use, introduced by Pope Gregory XIII in 1582 AD to correct an error in the Julian calendar by suppressing 10 days, making Oct 5 be called Oct 15, and providing that only centenary years divisible by 400 should be leap years; it was adopted by Great Britain and the American colonies in 1752</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110892868">
	<b:glossaryEntry>the solar calendar introduced in Rome in 46 b.c. by Julius Caesar and slightly modified by Augustus, establishing the 12-month year of 365 days with each 4th year having 366 days and the months having 31 or 30 days except for February</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110893176">
	<b:glossaryEntry>the calendar adopted by The French First Republic in 1793 and abandoned in 1805; dates were calculated from Sept. 22, 1792</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110893595"
	 b:glossaryEntry="a month in the French Revolutionary calendar"/>
<rdf:Description rdf:about="&a;110893930">
	<b:glossaryEntry>first month of the Revolutionary calendar (Sept-Oct); the month of the grape harvest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894091">
	<b:glossaryEntry>second month of the Revolutionary calendar (Oct-Nov); the month of mist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894236">
	<b:glossaryEntry>third month of the Revolutionary calendar (Nov-Dec); the frosty month</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894379">
	<b:glossaryEntry>fourth month of the Revolutionary calendar (Dec-Jan); the snowy month</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894520">
	<b:glossaryEntry>fifth month of the Revolutionary calendar (Jan-Feb); the rainy month</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894662">
	<b:glossaryEntry>sixth month of the Revolutionary calendar (Feb-Mar); the windy month</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894803">
	<b:glossaryEntry>seventh month of the Revolutionary calendar (Mar-Apr); the month of buds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110894949">
	<b:glossaryEntry>eighth month of the Revolutionary calendar (Apr-May); the month of flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110895096">
	<b:glossaryEntry>ninth month of the Revolutionary calendar (May-June); the month of meadows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110895244">
	<b:glossaryEntry>tenth month of the Revolutionary calendar (June-July); the month of harvest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110895393">
	<b:glossaryEntry>eleventh month of the Revolutionary calendar (July-Aug); the month of heat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110895542">
	<b:glossaryEntry>twelfth month of the Revolutionary calendar (Aug-Sept); the month of fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110895691">
	<b:glossaryEntry>the calendar used by the Jews; dates from 3761 BC (the assumed date of the creation of the world); a lunar year of 354 days is adjusted to the solar year by periodic leap years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110896194"
	 b:glossaryEntry="a calendar based on lunar cycles"/>
<rdf:Description rdf:about="&a;110896323"
	 b:glossaryEntry="a calendar based on both lunar and solar cycles"/>
<rdf:Description rdf:about="&a;110896471"
	 b:glossaryEntry="a calendar based on solar cycles"/>
<rdf:Description rdf:about="&a;110896618">
	<b:glossaryEntry>the lunar calendar used by Moslems; dates from 622 AD (the year of the Hegira); the beginning of the Moslem year retrogresses through the solar year completing the cycle every 32 years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110897154">
	<b:glossaryEntry>the lunisolar calendar governing the religious life of Hindus; an extra month is inserted after every month in which there are two new moons (once every three years)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110897608">
	<b:glossaryEntry>a particular but unspecified point in time; "they hoped to get together at an early date"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110897748"
	 b:glossaryEntry="the point in time at which something must be completed"/>
<rdf:Description rdf:about="&a;110897875"
	 b:glossaryEntry="the time that the curfew signal is sounded"/>
<rdf:Description rdf:about="&a;110897970">
	<b:glossaryEntry>something located at a time when it could not have existed or occurred</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110898122"
	 b:glossaryEntry='a very short period of time; "at that point I had to leave"'/>
<rdf:Description rdf:about="&a;110898519">
	<b:glossaryEntry>the time at which a public conveyance is scheduled to arrive at a given destination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110898679">
	<b:glossaryEntry>the time at which a public conveyance is scheduled to depart from a given point of origin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110898867">
	<b:glossaryEntry>the latest time for vacating a hotel room; "the checkout here is 12 noon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110899011"
	 b:glossaryEntry="the week before Easter"/>
<rdf:Description rdf:about="&a;110899123">
	<b:glossaryEntry>(Roman Catholic) a period of remission from sin (usually granted every 25 years)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110899259">
	<b:glossaryEntry>a calendar of the Christian year indicating the dates of fasts and festivals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110899518"
	 b:glossaryEntry="eve of May Day"/>
<rdf:Description rdf:about="&a;110899594"
	 b:glossaryEntry="the last day of the year"/>
<rdf:Description rdf:about="&a;110899730"
	 b:glossaryEntry="the first day of the year"/>
<rdf:Description rdf:about="&a;110899860"
	 b:glossaryEntry="observed on the Monday closest to January 15"/>
<rdf:Description rdf:about="&a;110900027"
	 b:glossaryEntry="celebrated in southern United States"/>
<rdf:Description rdf:about="&a;110900182"
	 b:glossaryEntry="New Year''s Eve in Scotland"/>
<rdf:Description rdf:about="&a;110900263">
	<b:glossaryEntry>a solemn Jewish fast day celebrated on the 1st or 1st and 2nd of Tishri; noted for the blowing of the shofar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110900495">
	<b:glossaryEntry>the beginning of each month in the Jewish calendar; marked by a special liturgy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110900647">
	<b:glossaryEntry>Vietnamese New Year; observed for 3 days after the 1st full moon after January 20th</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110900799"
	 b:glossaryEntry="a day on which work is suspended by law or custom"/>
<rdf:Description rdf:about="&a;110900974"
	 b:glossaryEntry="a day specified for religious observance"/>
<rdf:Description rdf:about="&a;110901198"
	 b:glossaryEntry="Jewish holy days observed with particular solemnity"/>
<rdf:Description rdf:about="&a;110901360"
	 b:glossaryEntry="a religious holiday for Christians"/>
<rdf:Description rdf:about="&a;110901927"
	 b:glossaryEntry="a religious holiday for Jews"/>
<rdf:Description rdf:about="&a;110902179">
	<b:glossaryEntry>a day when Catholics must attend Mass and refrain from servile work, and Episcopalians must take Communion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110902462">
	<b:glossaryEntry>a religious holiday that falls on different dates in different years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110902643">
	<b:glossaryEntry>a solemn Jewish fast day; 10th of Tishri; its observance is one of the requirements of the Mosaic Law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110902820"
	 b:glossaryEntry="a Christian holy day"/>
<rdf:Description rdf:about="&a;110902936"
	 b:glossaryEntry="a quarter day in Scotland"/>
<rdf:Description rdf:about="&a;110903068"
	 b:glossaryEntry="a period of unusually warm weather in the autumn"/>
<rdf:Description rdf:about="&a;110903219"
	 b:glossaryEntry="a quarter day in England, Wales, and Ireland"/>
<rdf:Description rdf:about="&a;110903382">
	<b:glossaryEntry>honoring the archangel Michael; a quarter day in England, Wales, and Ireland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110903566"
	 b:glossaryEntry="the season of Michaelmas"/>
<rdf:Description rdf:about="&a;110903651"
	 b:glossaryEntry="a quarter day in Scotland"/>
<rdf:Description rdf:about="&a;110903775">
	<b:glossaryEntry>(US) if the ground hog emerges and sees his shadow there will be 6 more weeks of winter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110903954">
	<b:glossaryEntry>(US) the day on which President Abraham Lincoln is remembered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110904113"
	 b:glossaryEntry="a day for the exchange of tokens of affection"/>
<rdf:Description rdf:about="&a;110904314"
	 b:glossaryEntry="(US) the day on which George Washington is remembered"/>
<rdf:Description rdf:about="&a;110904468">
	<b:glossaryEntry>(US) the 3rd Monday in February; commemorates both United States Presidents Lincoln and Washington</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110904647">
	<b:glossaryEntry>Texans celebrate the anniversary of Texas'' declaration of independence from Mexico in 1836</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110904835">
	<b:glossaryEntry>a day observed by the Irish to commemorate the patron saint of Ireland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110905001">
	<b:glossaryEntry>a Christian celebration of the Resurrection of Christ; celebrated on the Sunday following the first full moon after the vernal equinox</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110905206">
	<b:glossaryEntry>the day (in March or April) on which the festival of Easter is celebrated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110905352"
	 b:glossaryEntry="April 1; celebrated by playing of practical jokes"/>
<rdf:Description rdf:about="&a;110905515">
	<b:glossaryEntry>a day celebrating political and economic unity among American countries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110905679">
	<b:glossaryEntry>the 3rd Monday in April; Massachusetts and Maine celebrate the battle of Lexington and Concord in 1775</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110905860">
	<b:glossaryEntry>observed in the United States to celebrate the coming of spring; observed in Russia in honor of labor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110906057"
	 b:glossaryEntry="second Sunday in May"/>
<rdf:Description rdf:about="&a;110906155"
	 b:glossaryEntry="the 3rd Saturday in May"/>
<rdf:Description rdf:about="&a;110906260">
	<b:glossaryEntry>U.S., last Monday in May; commemorates the members of the United States armed forces who were killed in war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110906462"
	 b:glossaryEntry="celebrated in southern United States"/>
<rdf:Description rdf:about="&a;110906616"
	 b:glossaryEntry="commemorating the adoption of the U.S. flag in 1777"/>
<rdf:Description rdf:about="&a;110906751"
	 b:glossaryEntry="US: third Sunday in June"/>
<rdf:Description rdf:about="&a;110906853"
	 b:glossaryEntry="a legal holiday in the United States"/>
<rdf:Description rdf:about="&a;110906997">
	<b:glossaryEntry>commemorates Saint Peter''s miraculous deliverance from prison; a quarter day in Scotland; a harvest festival in England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110907193"
	 b:glossaryEntry="the season of Lammas (Scotland)"/>
<rdf:Description rdf:about="&a;110907281"
	 b:glossaryEntry="first Monday in September in U.S. and Canada"/>
<rdf:Description rdf:about="&a;110907400"
	 b:glossaryEntry="celebrated in the United States"/>
<rdf:Description rdf:about="&a;110907527"
	 b:glossaryEntry="US: the 4th Friday in September"/>
<rdf:Description rdf:about="&a;110907643">
	<b:glossaryEntry>a legal holiday commemorating the discovery of America by Christopher Columbus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110907828"
	 b:glossaryEntry="a day for celebrating the founding of the United Nations"/>
<rdf:Description rdf:about="&a;110907981">
	<b:glossaryEntry>the evening before All Saints'' Day; often devoted to pranks played by young people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110908149"
	 b:glossaryEntry="an archaic name for Easter or Passover"/>
<rdf:Description rdf:about="&a;110908266"
	 b:glossaryEntry="the Easter season"/>
<rdf:Description rdf:about="&a;110908340"
	 b:glossaryEntry="Sunday before Easter"/>
<rdf:Description rdf:about="&a;110908418"
	 b:glossaryEntry="second Sunday before Easter"/>
<rdf:Description rdf:about="&a;110908506"
	 b:glossaryEntry="Friday before Easter"/>
<rdf:Description rdf:about="&a;110908603"
	 b:glossaryEntry="the Sunday following Easter"/>
<rdf:Description rdf:about="&a;110908687"
	 b:glossaryEntry="the Saturday before Easter; the last day of Lent"/>
<rdf:Description rdf:about="&a;110908795">
	<b:glossaryEntry>December 28, commemorating Herod''s slaughter of the children of Bethlehem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110908951"
	 b:glossaryEntry="the 3rd Sunday before Lent (or the 9th before Easter)"/>
<rdf:Description rdf:about="&a;110909085"
	 b:glossaryEntry="the Sunday before Ash Wednesday (the beginning of Lent)"/>
<rdf:Description rdf:about="&a;110909223"
	 b:glossaryEntry="the first Sunday in Lent"/>
<rdf:Description rdf:about="&a;110909328"
	 b:glossaryEntry="eighth Sunday after Easter"/>
<rdf:Description rdf:about="&a;110909415">
	<b:glossaryEntry>one of the three days before Ascension Day; observed by some Christians as days of supplication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110909569"
	 b:glossaryEntry="(Roman Catholic) a holy day of obligation"/>
<rdf:Description rdf:about="&a;110909705">
	<b:glossaryEntry>the 40th day after Easter; celebrates the Ascension of Christ into heaven</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110909874"
	 b:glossaryEntry="the Thursday before Easter; commemorates the Last Supper"/>
<rdf:Description rdf:about="&a;110910008"
	 b:glossaryEntry="Thursday after Trinity Sunday; first celebrated in 1246"/>
<rdf:Description rdf:about="&a;110910124"
	 b:glossaryEntry="first celebrated in the 3rd century"/>
<rdf:Description rdf:about="&a;110910256">
	<b:glossaryEntry>celebration of the Virgin Mary''s being taken up into heaven when her earthly life ended</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110910452">
	<b:glossaryEntry>twelve days after Christmas; celebrates the visit of the three wise men to the infant Jesus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110910685"
	 b:glossaryEntry="a Christian holy day"/>
<rdf:Description rdf:about="&a;110910806"
	 b:glossaryEntry="the season of Epiphany"/>
<rdf:Description rdf:about="&a;110910886"
	 b:glossaryEntry="eve of Twelfth_day; evening of January 5"/>
<rdf:Description rdf:about="&a;110911005">
	<b:glossaryEntry>a Christian feast day honoring all the saints; first observed in 835</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110911205"
	 b:glossaryEntry="first celebrated in 1854"/>
<rdf:Description rdf:about="&a;110911310"
	 b:glossaryEntry="the season of All Saints'' Day"/>
<rdf:Description rdf:about="&a;110911399"
	 b:glossaryEntry="a day of supplication for all the souls in purgatory"/>
<rdf:Description rdf:about="&a;110911544">
	<b:glossaryEntry>the 7th Wednesday before Easter; the first day of Lent; the day following Mardi Gras (`fat Tuesday''); a day of fasting and repentance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110911756"
	 b:glossaryEntry="a day set aside for fasting and prayer"/>
<rdf:Description rdf:about="&a;110911850">
	<b:glossaryEntry>a Jewish festival (traditionally 8 days) celebrating the exodus of the Israelites from Egypt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110912064">
	<b:glossaryEntry>a Christian holiday celebrating the birth of Christ; a quarter day in England, Wales, and Ireland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110912304"
	 b:glossaryEntry="the day before Christmas"/>
<rdf:Description rdf:about="&a;110912397"
	 b:glossaryEntry="period extending from Dec. 24 to Jan. 6"/>
<rdf:Description rdf:about="&a;110912606"
	 b:glossaryEntry="(British) first weekday after Christmas"/>
<rdf:Description rdf:about="&a;110912721">
	<b:glossaryEntry>a Jewish holy day commemorating their deliverance from massacre by Haman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110912864"
	 b:glossaryEntry="a Jewish harvest festival"/>
<rdf:Description rdf:about="&a;110913026">
	<b:glossaryEntry>Jewish holy day celebrated on the sixth of Sivan to celebrate Moses receiving the Ten Commandments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110913239">
	<b:glossaryEntry>a Jewish holy day celebrated on the 22nd or 23rd of Tishri to celebrate the completion of the annual cycle of readings of the Torah</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110913566">
	<b:glossaryEntry>a Jewish fast day commemorating the destruction of the temples in Jerusalem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110913793">
	<b:glossaryEntry>an eight-day Jewish holiday commemorating the rededication of the Temple of Jerusalem</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110914061">
	<b:glossaryEntry>Jewish holy day; the 33rd day after the 2nd day of Passover; the 18th day of Iyar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110914218"
	 b:glossaryEntry="authorized by law and limiting work or official business"/>
<rdf:Description rdf:about="&a;110914623">
	<b:glossaryEntry>any of several weekdays when banks are closed; a legal holiday in Britain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110914755"
	 b:glossaryEntry="British, anniversary of Queen Victoria''s birth"/>
<rdf:Description rdf:about="&a;110914905">
	<b:glossaryEntry>(Canada) a legal holiday commemorating receiving dominion status in 1867</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110915064"
	 b:glossaryEntry="a legal holiday in France"/>
<rdf:Description rdf:about="&a;110915177"
	 b:glossaryEntry="US: formerly Armistice Day; called Veterans Day since 1954"/>
<rdf:Description rdf:about="&a;110915344">
	<b:glossaryEntry>fourth Thursday in November in the United States; second Monday in October in Canada; commemorates a feast held in 1621 by the Pilgrims and Wampanoag Indians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110915598">
	<b:glossaryEntry>the period of time that it takes for a planet (as, e.g., Earth or Mars) to make a complete revolution around the sun; "a Martian year takes 687 of our days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110915915">
	<b:glossaryEntry>time of the earth''s revolution from perihelion to perihelion again; 365 days and 6 hr and 13 min and 53.1 sec</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110916087">
	<b:glossaryEntry>the end of a calendar year; "he had to unload the merchandise before the year-end"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110916224"
	 b:glossaryEntry="a year that is not a leap year"/>
<rdf:Description rdf:about="&a;110916323">
	<b:glossaryEntry>in the Gregorian calendar: any year divisible by 4 except centenary years not divisible by 400</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110916521">
	<b:glossaryEntry>the year (reckoned from January 1 to December 31) according to Gregorian calendar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110916693">
	<b:glossaryEntry>the time for the earth to make one revolution around the sun, measured between two vernal equinoxes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110916904"
	 b:glossaryEntry="a period of 12 lunar months"/>
<rdf:Description rdf:about="&a;110917007"
	 b:glossaryEntry="any accounting period of 12 months"/>
<rdf:Description rdf:about="&a;110917116">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the period of instruction in a school; "stay after school" or "he didn''t miss a single day of school"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110917283">
	<b:glossaryEntry>the period of time each year when the school is open and people are studying</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110917509">
	<b:glossaryEntry>a period of time containing 365 (or 366) days; "she is 4 years old"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110917791">
	<b:glossaryEntry>a period of time occupying a regular part of a calendar year that is used for some particular activity; "a school year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110917979"
	 b:glossaryEntry="half a year; a period of 6 months"/>
<rdf:Description rdf:about="&a;110918067"
	 b:glossaryEntry="a period of 2 months"/>
<rdf:Description rdf:about="&a;110918142">
	<b:glossaryEntry>one of the 4-year intervals between Olympic Games; used to reckon time in ancient Greece beginning in 776 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110918305"
	 b:glossaryEntry="a period of five years"/>
<rdf:Description rdf:about="&a;110918381"
	 b:glossaryEntry="a period of 10 years"/>
<rdf:Description rdf:about="&a;110918678"
	 b:glossaryEntry="100 years"/>
<rdf:Description rdf:about="&a;110918835"
	 b:glossaryEntry="the 15th century in Renaissance Italian art and literature"/>
<rdf:Description rdf:about="&a;110918971"
	 b:glossaryEntry="50 years"/>
<rdf:Description rdf:about="&a;110919057"
	 b:glossaryEntry="25 years"/>
<rdf:Description rdf:about="&a;110919146">
	<b:glossaryEntry>a time unit of 30 days; "he was given a month to pay the bill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110919408">
	<b:glossaryEntry>a fourth part of a year; three months; "unemployment fell during the last quarter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110919544">
	<b:glossaryEntry>a time when the moon presents a particular recurring appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110919743">
	<b:glossaryEntry>the time at which the moon appears as a narrow waxing crescent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110919903">
	<b:glossaryEntry>the time at which the moon is at first or last quarter when half its face is illuminated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110920102">
	<b:glossaryEntry>the first fourth of the moon''s period of revolution around the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110920230">
	<b:glossaryEntry>the last fourth of the moon''s period of revolution around the Earth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110920356"
	 b:glossaryEntry="the time when the moon is fully illuminated"/>
<rdf:Description rdf:about="&a;110920536"
	 b:glossaryEntry="the full moon nearest the September equinox"/>
<rdf:Description rdf:about="&a;110920638"
	 b:glossaryEntry="the period between successive new moons (29.531 days)"/>
<rdf:Description rdf:about="&a;110920802">
	<b:glossaryEntry>period between successive perigees; approximately 27.5546 days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110920928"
	 b:glossaryEntry="measured by the diurnal motion of stars"/>
<rdf:Description rdf:about="&a;110921099">
	<b:glossaryEntry>the time for one complete rotation of the earth relative to a particular star, about 4 minutes shorter than a mean solar day</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110921306">
	<b:glossaryEntry>the period of time taken by a particular planet (e.g. Mars) to make a complete rotation on its axis; "how long is a day on Jupiter?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110921506">
	<b:glossaryEntry>the period of time taken for the moon to make one full rotation on its axis (about 27.3 sidereal days)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110921664">
	<b:glossaryEntry>the time for the earth to make one complete revolution around the sun, relative to the fixed stars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110921840"
	 b:glossaryEntry="1/24 of a sidereal day"/>
<rdf:Description rdf:about="&a;110921940">
	<b:glossaryEntry>period between successive conjunctions with a star, 27.322 days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110922082"
	 b:glossaryEntry="one-twelfth of a solar or tropical year"/>
<rdf:Description rdf:about="&a;110922179">
	<b:glossaryEntry>one of the twelve divisions of the calendar year; "he paid the bill last month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110922436"
	 b:glossaryEntry="a month in the Gregorian calendar"/>
<rdf:Description rdf:about="&a;110922756">
	<b:glossaryEntry>the first month of the year; begins 10 days after the winter solstice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110923113"
	 b:glossaryEntry="the middle part of January"/>
<rdf:Description rdf:about="&a;110923216"
	 b:glossaryEntry="the month following January and preceding March"/>
<rdf:Description rdf:about="&a;110923514"
	 b:glossaryEntry="the middle part of February"/>
<rdf:Description rdf:about="&a;110923619"
	 b:glossaryEntry="the month following February and preceding April"/>
<rdf:Description rdf:about="&a;110923839"
	 b:glossaryEntry="the middle part of March"/>
<rdf:Description rdf:about="&a;110923938"
	 b:glossaryEntry="the month following March and preceding May"/>
<rdf:Description rdf:about="&a;110924153"
	 b:glossaryEntry="the middle part of April"/>
<rdf:Description rdf:about="&a;110924252"
	 b:glossaryEntry="the month following April and preceding June"/>
<rdf:Description rdf:about="&a;110924498"
	 b:glossaryEntry="the middle part of May"/>
<rdf:Description rdf:about="&a;110924593"
	 b:glossaryEntry="the month following May and preceding July"/>
<rdf:Description rdf:about="&a;110924876"
	 b:glossaryEntry="the middle part of June"/>
<rdf:Description rdf:about="&a;110924973"
	 b:glossaryEntry="the month following June and preceding August"/>
<rdf:Description rdf:about="&a;110925183"
	 b:glossaryEntry="the middle part of July"/>
<rdf:Description rdf:about="&a;110925280"
	 b:glossaryEntry="the month following July and preceding September"/>
<rdf:Description rdf:about="&a;110925463"
	 b:glossaryEntry="the middle part of August"/>
<rdf:Description rdf:about="&a;110925564"
	 b:glossaryEntry="the month following August and preceding October"/>
<rdf:Description rdf:about="&a;110925814"
	 b:glossaryEntry="the middle part of September"/>
<rdf:Description rdf:about="&a;110925921"
	 b:glossaryEntry="the month following September and preceding November"/>
<rdf:Description rdf:about="&a;110926128"
	 b:glossaryEntry="the middle part of October"/>
<rdf:Description rdf:about="&a;110926231"
	 b:glossaryEntry="the month following October and preceding December"/>
<rdf:Description rdf:about="&a;110926513"
	 b:glossaryEntry="the middle part of November"/>
<rdf:Description rdf:about="&a;110926618"
	 b:glossaryEntry="the last (12th) month of the year"/>
<rdf:Description rdf:about="&a;110926826"
	 b:glossaryEntry="the middle part of December"/>
<rdf:Description rdf:about="&a;110926931"
	 b:glossaryEntry="a month in the Jewish calendar"/>
<rdf:Description rdf:about="&a;110927263">
	<b:glossaryEntry>the first month of the civil year; the seventh month of the ecclesiastical year in the Jewish calendar (in September and October)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110927483">
	<b:glossaryEntry>the second month of the civil year; the eighth month of the ecclesiastical year in the Jewish calendar (in October and November)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110927684">
	<b:glossaryEntry>the third month of the civil year; the ninth month of the ecclesiastical year in the Jewish calendar (in November and December)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110927912">
	<b:glossaryEntry>the fourth month of the civil year; the tenth month of the ecclesiastical year (in December and January)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110928114">
	<b:glossaryEntry>the fifth month of the civil year: the eleventh month of the ecclesiastical year in the Jewish calendar (in January and February)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110928324">
	<b:glossaryEntry>the sixth month of the civil year; the twelfth month of the ecclesiastic year in the Jewish calendar (in February and March)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110928537"
	 b:glossaryEntry="included seven times in every 19 years"/>
<rdf:Description rdf:about="&a;110928660">
	<b:glossaryEntry>the seventh month of the civil year; the first month of the ecclesiastic year (in March and April)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110928838">
	<b:glossaryEntry>the eighth month of the civil year; the second month of the ecclesiastical year (in April and May)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110929033">
	<b:glossaryEntry>the ninth month of the civil year; the third month of the ecclesiastical year in the Jewish calendar (in May and June)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110929230">
	<b:glossaryEntry>the tenth month of the civil year; the fourth month of the ecclesiastic year (in June and July)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110929407">
	<b:glossaryEntry>the eleventh month of the civil year; the fifth month of the ecclesiastical year in the Jewish calendar (in July and August)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110929604">
	<b:glossaryEntry>the twelfth month of the civil year; the sixth month of the ecclesiastical year in the Jewish calendar (in August and September)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110929810"
	 b:glossaryEntry="any lunar month in the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930133"
	 b:glossaryEntry="the first month of the Islamic calendar"/>
<rdf:Description rdf:about="&a;110930246"
	 b:glossaryEntry="the second month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930356"
	 b:glossaryEntry="the third month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930466"
	 b:glossaryEntry="the fourth month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930578"
	 b:glossaryEntry="the fifth month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930690"
	 b:glossaryEntry="the sixth month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930803"
	 b:glossaryEntry="the seventh month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110930914"
	 b:glossaryEntry="the eighth month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110931026"
	 b:glossaryEntry="the ninth month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110931137"
	 b:glossaryEntry="the tenth month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110931248"
	 b:glossaryEntry="the eleventh month of the Moslem calendar"/>
<rdf:Description rdf:about="&a;110931367">
	<b:glossaryEntry>the twelfth month of the Moslem calendar; has one extra day in leap years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110931517"
	 b:glossaryEntry="any lunisolar month in the Hindu calendar"/>
<rdf:Description rdf:about="&a;110931841">
	<b:glossaryEntry>the first Hindu calendar month (corresponding to March or April in the Gregorian calendar)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110932002"
	 b:glossaryEntry="the second month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932113"
	 b:glossaryEntry="the third month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932220"
	 b:glossaryEntry="the fourth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932329"
	 b:glossaryEntry="the fifth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932437"
	 b:glossaryEntry="the sixth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932546"
	 b:glossaryEntry="the seventh month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932655"
	 b:glossaryEntry="the eighth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932765"
	 b:glossaryEntry="the ninth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932873"
	 b:glossaryEntry="the tenth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110932979"
	 b:glossaryEntry="the eleventh month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110933089"
	 b:glossaryEntry="the twelfth month of the Hindu calendar"/>
<rdf:Description rdf:about="&a;110933200"
	 b:glossaryEntry="a day commemorating a saint"/>
<rdf:Description rdf:about="&a;110933322"
	 b:glossaryEntry="the feast day of a saint whose name one bears"/>
<rdf:Description rdf:about="&a;110933422">
	<b:glossaryEntry>either of the two times of the year when the sun is at its greatest distance from the celestial equator</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110933616"
	 b:glossaryEntry="June 21, when the sun is at its northernmost point"/>
<rdf:Description rdf:about="&a;110933806"
	 b:glossaryEntry="a quarter day in England, Wales, and Ireland"/>
<rdf:Description rdf:about="&a;110933973"
	 b:glossaryEntry="the night before Midsummer_Day"/>
<rdf:Description rdf:about="&a;110934144"
	 b:glossaryEntry="any day on which school is in session"/>
<rdf:Description rdf:about="&a;110934238">
	<b:glossaryEntry>(British) an annual day in the schools when speeches are made and prizes are distributed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110934383"
	 b:glossaryEntry="a day set aside for doing household laundry"/>
<rdf:Description rdf:about="&a;110934494"
	 b:glossaryEntry="the day of a wedding"/>
<rdf:Description rdf:about="&a;110934591">
	<b:glossaryEntry>the night after the wedding when bride and groom sleep together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110934733"
	 b:glossaryEntry="December 22, when the sun is at its southernmost point"/>
<rdf:Description rdf:about="&a;110934886">
	<b:glossaryEntry>either of two times of the year when the sun crosses the plane of the earth''s equator and day and night are of equal length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110935099"
	 b:glossaryEntry="March 21"/>
<rdf:Description rdf:about="&a;110935238"
	 b:glossaryEntry="September 22"/>
<rdf:Description rdf:about="&a;110935385">
	<b:glossaryEntry>a time period within which something must be done or completed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110935522">
	<b:glossaryEntry>(in law) a time period after which suits cannot be brought; "statute of limitations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110935663">
	<b:glossaryEntry>a limited period of time; "a prison term"; "he left school before the end of term"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110935869">
	<b:glossaryEntry>the period of time a prisoner is imprisoned; "he served a prison term of 15 months"; "his sentence was 5 to 10 years"; "he is doing time in the county jail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110936119"
	 b:glossaryEntry="a term served in a maximum security prison"/>
<rdf:Description rdf:about="&a;110936217">
	<b:glossaryEntry>the time during which a school holds classes; "they had to shorten the school term"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110936457"
	 b:glossaryEntry="middle of an academic term or a political term in office"/>
<rdf:Description rdf:about="&a;110936586"
	 b:glossaryEntry="one of two divisions of an academic year"/>
<rdf:Description rdf:about="&a;110936700"
	 b:glossaryEntry="one of three divisions of an academic year"/>
<rdf:Description rdf:about="&a;110936817">
	<b:glossaryEntry>one of four periods into which the school year is divided; "the fall quarter ends at Christmas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110936985">
	<b:glossaryEntry>the period during which an embryo develops (about 266 days in humans)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110937186">
	<b:glossaryEntry>the end of gestation or point at which birth is imminent; "a healthy baby born at full term"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110937360"
	 b:glossaryEntry="the middle of the gestation period"/>
<rdf:Description rdf:about="&a;110937467"
	 b:glossaryEntry="a period of three months"/>
<rdf:Description rdf:about="&a;110937566">
	<b:glossaryEntry>(Latin: before midday) the time interval from midnight to midday</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110937709"
	 b:glossaryEntry="the time interval from midday to midnight"/>
<rdf:Description rdf:about="&a;110937829">
	<b:glossaryEntry>(nautical) each of the eight half-hour units of nautical time signaled by strokes of a ship''s bell; eight bells signals 4:00, 8:00, or 12:00 o''clock, either a.m. or p.m.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110938063">
	<b:glossaryEntry>a period of time equal to 1/24th of a day; "the job will take more than an hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110938343"
	 b:glossaryEntry="a half of an hour"/>
<rdf:Description rdf:about="&a;110938448"
	 b:glossaryEntry="a quarter of an hour"/>
<rdf:Description rdf:about="&a;110938559"
	 b:glossaryEntry='clock time; "the hour is getting late"'/>
<rdf:Description rdf:about="&a;110938914"
	 b:glossaryEntry='a special and memorable period; "it was their finest hour"'/>
<rdf:Description rdf:about="&a;110939023">
	<b:glossaryEntry>the time of day when a bar sells alcoholic drinks at a reduced price</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110939148">
	<b:glossaryEntry>the times at the beginning and end of the working day when many people are traveling to or from work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110939304"
	 b:glossaryEntry="the time set for the start of an action or operation"/>
<rdf:Description rdf:about="&a;110939412">
	<b:glossaryEntry>(Roman Catholic Church) one of seven specified times for prayer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110939662"
	 b:glossaryEntry="the first canonical hour; at daybreak"/>
<rdf:Description rdf:about="&a;110939769"
	 b:glossaryEntry="the second canonical hour; about 6 a.m."/>
<rdf:Description rdf:about="&a;110939860"
	 b:glossaryEntry="the third canonical hour; about 9 a.m."/>
<rdf:Description rdf:about="&a;110939959"
	 b:glossaryEntry="the fourth of the seven canonical hours; about noon"/>
<rdf:Description rdf:about="&a;110940061"
	 b:glossaryEntry="the fifth of the seven canonical hours; about 3 p.m."/>
<rdf:Description rdf:about="&a;110940165">
	<b:glossaryEntry>the sixth of the seven canonical hours of the divine office; early evening; now often made a public service on Sundays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110940348"
	 b:glossaryEntry="last of the seven canonical hours"/>
<rdf:Description rdf:about="&a;110940446"
	 b:glossaryEntry="a time unit used in industry for measuring work"/>
<rdf:Description rdf:about="&a;110940599">
	<b:glossaryEntry>a time usually late summer characterized by exaggerated news stories about frivolous matters for want of real news</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110940772">
	<b:glossaryEntry>(classical mythology) the first and best age of the world, a time of ideal happiness, prosperity, and innocence; by extension, any flourishing and outstanding period</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110940994">
	<b:glossaryEntry>(classical mythology) the second age of the world, characterized by opulence and irreligion; by extension, a period secondary in achievement to a golden age</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110941207">
	<b:glossaryEntry>(classical mythology) the third age of the world, marked by war and violence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110941340">
	<b:glossaryEntry>(archeology) a period between the Stone and Iron ages, characterized by the manufacture and use of bronze tools and weapons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110941539"
	 b:glossaryEntry="(classical mythology) the last and worst age of the world"/>
<rdf:Description rdf:about="&a;110941651">
	<b:glossaryEntry>(archeology) the period following the Bronze Age; characterized by rapid spread of iron tools and weapons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110941830">
	<b:glossaryEntry>(archeology) the earliest known period of human culture, characterized by the use of stone implements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110942082">
	<b:glossaryEntry>the earliest part of the Stone Age marked by the earliest signs of human culture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110942240">
	<b:glossaryEntry>second part of the Stone Age beginning about 750,000 years ago</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110942383">
	<b:glossaryEntry>middle part of the Stone Age beginning about 15,000 years ago</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110942524">
	<b:glossaryEntry>latest part of the Stone Age beginning about 10,000 BC in the middle east (but later elsewhere)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110942698">
	<b:glossaryEntry>time required for one complete cycle of the precession of the equinoxes, about 25,800 years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110942862">
	<b:glossaryEntry>(sports) the normal prescribed duration of a game; "the game was finished in regulation time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110943054"
	 b:glossaryEntry="playing time beyond regulation, to break a tie"/>
<rdf:Description rdf:about="&a;110943277"
	 b:glossaryEntry="baseball"/>
<rdf:Description rdf:about="&a;110943345"
	 b:glossaryEntry="e.g. basketball"/>
<rdf:Description rdf:about="&a;110943422"
	 b:glossaryEntry="e.g. tennis and soccer"/>
<rdf:Description rdf:about="&a;110943501">
	<b:glossaryEntry>overtime in which play is stopped as soon as one contestant scores; e.g. football and golf</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110943650">
	<b:glossaryEntry>a unit of time equal to 60 seconds or 1/60th of an hour; "he ran a 4 minute mile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110943828">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a unit of time equal to 15 minutes or a quarter of an hour; "it''s a quarter til 4"; "a quarter after 4 o''clock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110944012">
	<b:glossaryEntry>1/60 of a minute; the basic unit of time adopted under the System International d''Unites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110944219">
	<b:glossaryEntry>a second (as measured by an atomic clock) added to or subtracted from Greenwich Mean Time in order to compensate for slowing in the Earth''s rotation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110944425"
	 b:glossaryEntry="one thousandth of a second"/>
<rdf:Description rdf:about="&a;110944554">
	<b:glossaryEntry>one quintillionth of a second; one thousandth of a femtosecond</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110944692">
	<b:glossaryEntry>one quadrillionth of a second; one thousandth of a nanosecond</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110944849"
	 b:glossaryEntry="one trillionth of a second; one thousandth of a nanosecond"/>
<rdf:Description rdf:about="&a;110945002"
	 b:glossaryEntry="one billionth of a second; one thousandth of a microsecond"/>
<rdf:Description rdf:about="&a;110945155"
	 b:glossaryEntry="one millionth of a second; one thousandth of a millisecond"/>
<rdf:Description rdf:about="&a;110945309">
	<b:glossaryEntry>one of the natural periods into which the year is divided by the equinoxes and solstices or atmospheric conditions; "the regular sequence of the seasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110945693">
	<b:glossaryEntry>the season when the leaves fall from the trees; "in the fall of 1973"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110945917">
	<b:glossaryEntry>the season of growth; "the emerging buds were a sure sign of spring"; "he will hold office until the spring of next year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110946199">
	<b:glossaryEntry>the warmest season of the year; "they spent a lazy summer at the shore"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110946412">
	<b:glossaryEntry>the hot period between early July and early September; a period of inactivity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110946591"
	 b:glossaryEntry="the coldest season of the year"/>
<rdf:Description rdf:about="&a;110946782"
	 b:glossaryEntry="the middle of winter"/>
<rdf:Description rdf:about="&a;110946877"
	 b:glossaryEntry="the season during which a crop grows best"/>
<rdf:Description rdf:about="&a;110946979"
	 b:glossaryEntry="the time during which seeds should be planted"/>
<rdf:Description rdf:about="&a;110947079"
	 b:glossaryEntry="the time or season when sheep are sheared"/>
<rdf:Description rdf:about="&a;110947180"
	 b:glossaryEntry="one of the two seasons in tropical climates"/>
<rdf:Description rdf:about="&a;110947318">
	<b:glossaryEntry>season in S Asia when the SW monsoon blows, bringing heavy rains</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110947436"
	 b:glossaryEntry="one of the two seasons in tropical climates"/>
<rdf:Description rdf:about="&a;110947554">
	<b:glossaryEntry>a recurrent time marked by major holidays; "it was the Christmas season"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110947841">
	<b:glossaryEntry>a period of the year marked by special events or activities in some field; "he celebrated his 10th season with the ballet company" or "she always looked forward to the avocado season"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110948329">
	<b:glossaryEntry>a period prior to the beginning of the regular season which is devoted to training and preparation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110948501"
	 b:glossaryEntry="preseason training during the spring"/>
<rdf:Description rdf:about="&a;110948599"
	 b:glossaryEntry="the season when baseball is played"/>
<rdf:Description rdf:about="&a;110948713">
	<b:glossaryEntry>a season of baseball during which a player wins the triple crown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110948843"
	 b:glossaryEntry="the season when basketball is played"/>
<rdf:Description rdf:about="&a;110948943">
	<b:glossaryEntry>the time before the regular games begin when football or baseball teams play practice games</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110949098"
	 b:glossaryEntry="the season during which it is legal to catch fish"/>
<rdf:Description rdf:about="&a;110949208"
	 b:glossaryEntry="the season when football is played"/>
<rdf:Description rdf:about="&a;110949304"
	 b:glossaryEntry="the season when hockey is played"/>
<rdf:Description rdf:about="&a;110949396">
	<b:glossaryEntry>the season during which it is legal to kill a particular species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110949521"
	 b:glossaryEntry="the season for major social events"/>
<rdf:Description rdf:about="&a;110949615"
	 b:glossaryEntry="the season when new plays are produced"/>
<rdf:Description rdf:about="&a;110949717"
	 b:glossaryEntry="the season including the four Sundays preceding Christmas"/>
<rdf:Description rdf:about="&a;110949865"
	 b:glossaryEntry="the first of four Sundays of Advent"/>
<rdf:Description rdf:about="&a;110949979"
	 b:glossaryEntry="immediately preceding Lent"/>
<rdf:Description rdf:about="&a;110950100"
	 b:glossaryEntry="the last day before Lent"/>
<rdf:Description rdf:about="&a;110950231"
	 b:glossaryEntry="a period of 40 weekdays from Ash Wednesday to Holy Saturday"/>
<rdf:Description rdf:about="&a;110950411">
	<b:glossaryEntry>seventh Sunday after Easter; commemorates the descent of the Holy Spirit on the apostles; a quarter day in Scotland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110950614">
	<b:glossaryEntry>the day after Whitsunday; a legal holiday in England and Wales and Ireland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110950781"
	 b:glossaryEntry="the day after Whitmonday"/>
<rdf:Description rdf:about="&a;110950901">
	<b:glossaryEntry>Christian holiday; the week beginning on Whitsunday (especially the first 3 days)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110951137">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a prolonged period of time; "we''ve known each other for ages"; "I haven''t been there for years and years"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110951384">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a comparatively long time; "this won''t take long"; "they haven''t been gone long"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110951515">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) a time perceived as long; "I hadn''t seen him in a month of Sundays"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110951656">
	<b:glossaryEntry>a period of time sufficient for factors to work themselves out; "in the long run we will win" or "he performed well over the long haul"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110951858"
	 b:glossaryEntry="an immeasurably long period of time"/>
<rdf:Description rdf:about="&a;110951950"
	 b:glossaryEntry="the longest division of geological time; two or more eras"/>
<rdf:Description rdf:about="&a;110952083"
	 b:glossaryEntry="time without end"/>
<rdf:Description rdf:about="&a;110952193"
	 b:glossaryEntry="the first and last; signifies God''s eternity"/>
<rdf:Description rdf:about="&a;110952299">
	<b:glossaryEntry>(informal) a long time; "something that happens once in blue moon almost never happens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110952442"
	 b:glossaryEntry="a prolonged shortage"/>
<rdf:Description rdf:about="&a;110952516">
	<b:glossaryEntry>a particular point in time; "the moment he arrived the party began"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110952736">
	<b:glossaryEntry>a very brief moment; "they were strangers sharing a pinpoint of time together"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110952869"
	 b:glossaryEntry='a suitable moment; "it is time to go"'/>
<rdf:Description rdf:about="&a;110952993">
	<b:glossaryEntry>the latest possible moment; "it is high time you went to work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110953111">
	<b:glossaryEntry>the time of a particular event; "on the occasion of his 60th birthday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110953236"
	 b:glossaryEntry="the most appropriate time for achieving a desired effect"/>
<rdf:Description rdf:about="&a;110953359"
	 b:glossaryEntry='(Scottish) a short time; "bide a wee"'/>
<rdf:Description rdf:about="&a;110953446">
	<b:glossaryEntry>a period of indeterminate length (usually short) marked by some action or condition; "he was here for a little while"; "I need to rest for a piece"; "a spell of good weather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110953688">
	<b:glossaryEntry>an indefinitely short time; "wait just a moment"; "it only takes a minute"; "in just a bit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110953874">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a very short time; "if I had the chance I''d do it in a flash"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110954083"
	 b:glossaryEntry="something transitory; lasting a day"/>
<rdf:Description rdf:about="&a;110954173">
	<b:glossaryEntry>a unit of geological time during which a system of rocks formed; "ganoid fishes swarmed during the earlier geological periods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110954662">
	<b:glossaryEntry>a major division of geological time; an era is divided into two or more periods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110954919"
	 b:glossaryEntry="a unit of geological time"/>
<rdf:Description rdf:about="&a;110955141">
	<b:glossaryEntry>a period marked by distinctive character or reckoned from a fixed point or event</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110955351"
	 b:glossaryEntry="the time period beginning with the year of Christ''s birth"/>
<rdf:Description rdf:about="&a;110955481">
	<b:glossaryEntry>an era of existence or influence; "in the day of the dinosaurs"; "in the days of the Roman Empire"; "in the days of sailing ships"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110955661"
	 b:glossaryEntry="any year of the Christian era"/>
<rdf:Description rdf:about="&a;110955750">
	<b:glossaryEntry>the normal time between successive generations; "they had to wait a generation for that prejudice to fade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110955913"
	 b:glossaryEntry="the date on which an event occurred in some previous year"/>
<rdf:Description rdf:about="&a;110956211"
	 b:glossaryEntry="an anniversary of the day on which a person was born"/>
<rdf:Description rdf:about="&a;110956318"
	 b:glossaryEntry="a special anniversary"/>
<rdf:Description rdf:about="&a;110956411"
	 b:glossaryEntry="an anniversary celebrating the passage of 25 years"/>
<rdf:Description rdf:about="&a;110956522"
	 b:glossaryEntry="the anniversary of the day on which you were married"/>
<rdf:Description rdf:about="&a;110956676"
	 b:glossaryEntry="the 25th wedding anniversary"/>
<rdf:Description rdf:about="&a;110956777"
	 b:glossaryEntry="the 50th wedding anniversary"/>
<rdf:Description rdf:about="&a;110956878"
	 b:glossaryEntry="the 100th anniversary"/>
<rdf:Description rdf:about="&a;110956968"
	 b:glossaryEntry="the 200th anniversary"/>
<rdf:Description rdf:about="&a;110957062"
	 b:glossaryEntry="the 300th anniversary"/>
<rdf:Description rdf:about="&a;110957170"
	 b:glossaryEntry="the 400th anniversary"/>
<rdf:Description rdf:about="&a;110957272"
	 b:glossaryEntry="the 500th anniversary"/>
<rdf:Description rdf:about="&a;110957370"
	 b:glossaryEntry="the 1000th anniversary"/>
<rdf:Description rdf:about="&a;110957449"
	 b:glossaryEntry="the date on which a person was born"/>
<rdf:Description rdf:about="&a;110957551"
	 b:glossaryEntry="the distant past beyond memory"/>
<rdf:Description rdf:about="&a;110957662"
	 b:glossaryEntry="past times remembered with nostalgia"/>
<rdf:Description rdf:about="&a;110957801">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an indefinite time in the future; "he''ll get around to it in the sweet by-and-by"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110957938">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a distinct period in history or in a person''s life; "the industrial revolution opened a new chapter in British history"; "the divorce was an ugly chapter in their relationship"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110958168"
	 b:glossaryEntry="the historic period preceding the Middle Ages in Europe"/>
<rdf:Description rdf:about="&a;110958298"
	 b:glossaryEntry="an era of history having some distinctive feature"/>
<rdf:Description rdf:about="&a;110958608">
	<b:glossaryEntry>the time during human development before the appearance of the written word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110958816">
	<b:glossaryEntry>any period of time during which glaciers covered a large part of the earth''s surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110959006"
	 b:glossaryEntry="one of the periods into which the game of polo is divided"/>
<rdf:Description rdf:about="&a;110959117">
	<b:glossaryEntry>a period of play in baseball during which each team has a turn at bat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110959285">
	<b:glossaryEntry>the first half of an inning; while the visiting team is at bat; "a relief pitcher took over in the top of the fifth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110959508"
	 b:glossaryEntry="the second half of an inning; while the home team is at bat"/>
<rdf:Description rdf:about="&a;110959680">
	<b:glossaryEntry>a unit of play in tennis or squash; "they played two sets of tennis after dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110959811">
	<b:glossaryEntry>(in sports) a period of play during which one team is on the offensive</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110959983">
	<b:glossaryEntry>(in games or plays or other performances) the time during which play proceeds; "rain stopped play in the 4th inning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110960419"
	 b:glossaryEntry="the first period of play in a game"/>
<rdf:Description rdf:about="&a;110960512"
	 b:glossaryEntry="the second period of play in a game"/>
<rdf:Description rdf:about="&a;110960607"
	 b:glossaryEntry="the third period of play in a game"/>
<rdf:Description rdf:about="&a;110960700"
	 b:glossaryEntry="the last period of play in a game"/>
<rdf:Description rdf:about="&a;110960792">
	<b:glossaryEntry>in various games or performances: either of two periods of play separated by an interval</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110960967"
	 b:glossaryEntry="the first of two halves of play"/>
<rdf:Description rdf:about="&a;110961055"
	 b:glossaryEntry="the second of two halves of play"/>
<rdf:Description rdf:about="&a;110961157"
	 b:glossaryEntry="one of three periods of play in hockey games"/>
<rdf:Description rdf:about="&a;110961254">
	<b:glossaryEntry>one of four periods of play into which some games are divided; "both teams scored in the first quarter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110961411">
	<b:glossaryEntry>(cricket) the period during which a given number of balls (6 in England; 8 in Australia) are bowled at the batsman by one player from the other team from the same end of the pitch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110961659"
	 b:glossaryEntry="(cricket) an over in which no runs are scored"/>
<rdf:Description rdf:about="&a;110961771">
	<b:glossaryEntry>the period of history between classical antiquity and the Italian Renaissance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110961937">
	<b:glossaryEntry>the period of European history at the close of the Middle Ages and the rise of the modern world; a cultural rebirth from the 14th through the middle of the 17th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110962203">
	<b:glossaryEntry>the transformation from an agricultural to an industrial nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110962361">
	<b:glossaryEntry>the historic period (1793-94) during the French Revolution when thousands were executed; "the Reign of the Bourbons ended and the Reign of Terror began"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110962575">
	<b:glossaryEntry>any period of brutal suppression resembling the French Reign of Terror</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110962707">
	<b:glossaryEntry>the period during which a monarch is sovereign; "during the reign of Henry VIII"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110962839">
	<b:glossaryEntry>a period during which something or somebody is dominant or powerful; "he was helpless under the reign of his egotism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110963026"
	 b:glossaryEntry="the period from about 1890 to 1910"/>
<rdf:Description rdf:about="&a;110963126">
	<b:glossaryEntry>the historic period (1933-1940) in the U.S. during which President Franklin Roosevelt''s economic policies were implemented</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110963303">
	<b:glossaryEntry>the period after the United States Civil War when the southern states were reorganized and reintegrated into the Union; 1865-1877</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110963493"
	 b:glossaryEntry="the reign of Charles II in England; 1660-1685"/>
<rdf:Description rdf:about="&a;110963596">
	<b:glossaryEntry>the age beginning with the first space travel; from 1957 to the present</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110963723">
	<b:glossaryEntry>the present time or age; "the world of today"; "today we have computers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110963847"
	 b:glossaryEntry="the present or immediately coming night"/>
<rdf:Description rdf:about="&a;110963940">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the recent past; "yesterday''s solutions are not good enough"; "we shared many yesterdays"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110964085">
	<b:glossaryEntry>(New Testament) in Revelations it is foretold that those faithful to Jesus will reign with Jesus over the earth for a thousand years; the meaning of these words have been much debated; some denominations (e.g. Jehovah''s Witnesses) expect it to be a thousand years of justice and peace and happiness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110964440">
	<b:glossaryEntry>the near or foreseeable future; "there was a wedding in the offing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110964560">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the near future; "tomorrow''s world"; "everyone hopes for a better tomorrow"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110964690"
	 b:glossaryEntry="a time signature indicating four beats to the bar"/>
<rdf:Description rdf:about="&a;110964831"
	 b:glossaryEntry="the speed at which a composition is to be played"/>
<rdf:Description rdf:about="&a;110965012">
	<b:glossaryEntry>a gradually increasing tempo of music; "my ear will not accept such violent accelerandos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110965159"
	 b:glossaryEntry="a quicker tempo than andante but not as fast as allegro"/>
<rdf:Description rdf:about="&a;110965271"
	 b:glossaryEntry="a brisk and lively tempo"/>
<rdf:Description rdf:about="&a;110965367"
	 b:glossaryEntry="lively with spirit"/>
<rdf:Description rdf:about="&a;110965451"
	 b:glossaryEntry="a moderately slow tempo (a walking pace)"/>
<rdf:Description rdf:about="&a;110965545">
	<b:glossaryEntry>the time at which something begins; "They got an early start"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110965845">
	<b:glossaryEntry>an early period of development; "during the youth of the project"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110965975"
	 b:glossaryEntry="earliest limiting point"/>
<rdf:Description rdf:about="&a;110966076">
	<b:glossaryEntry>the tenure of a president; "things were quiet during the Eisenhower administration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110966253">
	<b:glossaryEntry>time between the beginning and the end of a temporal period: "the middle of the war"; "rain during the middle of April"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110966461">
	<b:glossaryEntry>the point in time at which something ends; "the end of the year"; "the ending of warranty period"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110966797">
	<b:glossaryEntry>the concluding time; "he awaited the grand finale"; "he stayed until the finish"; "he left before the conclusion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110967036">
	<b:glossaryEntry>an opening time period; "it was the dawn of the Roman Empire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110967148">
	<b:glossaryEntry>a later concluding time period; "it was the evening of the Roman Empire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110967274"
	 b:glossaryEntry="(`cease'' is a noun only in the phrase `without cease'') end"/>
<rdf:Description rdf:about="&a;110967384">
	<b:glossaryEntry>the time of the last part of something; "the fag end of this crisis-ridden century"; "the tail of the storm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110967564">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a coming to an end of a contract period; "the expiry of his driver''s license"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110967721"
	 b:glossaryEntry="final or latest limiting point"/>
<rdf:Description rdf:about="&a;110967839">
	<b:glossaryEntry>the starting point of a new state or experience; "on the threshold of manhood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110967973">
	<b:glossaryEntry>(computer science) the time it takes for a read/write head to move to a specific data track</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110968157">
	<b:glossaryEntry>(computer science) the time it takes for a read/write head to move to an adjacent data track</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110968320"
	 b:glossaryEntry="a definite length of time marked off by two instants"/>
<rdf:Description rdf:about="&a;110968821">
	<b:glossaryEntry>(electronics) the time required for the current or voltage in a circuit to rise or fall exponentially through approximately 63 per cent of its amplitude</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110969051">
	<b:glossaryEntry>a time assigned on a schedule or agenda; "the TV program has a new time slot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110969191">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a period of time considered as a resource under your control and sufficient to accomplish something; "take time to smell the roses"; "I didn''t have time to finish"; "it took more than half my time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110969439">
	<b:glossaryEntry>interval between the moon''s transit of a particular meridian and the next high tide at that meridian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110969604">
	<b:glossaryEntry>the time interval during which something or somebody is away; "he visited during my absence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110969750">
	<b:glossaryEntry>a time interval during which there is a temporary cessation of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110970069">
	<b:glossaryEntry>a break or intermission in the occurrence of something; "a lapse of three weeks between letters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110970217"
	 b:glossaryEntry="a suspension of radio or tv broadcasting"/>
<rdf:Description rdf:about="&a;110970312">
	<b:glossaryEntry>a pause or interruption (as in a conversation); "after an ominous caesura the preacher continued"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110970463">
	<b:glossaryEntry>time during which some action is awaited; "instant replay caused too long a delay"; "he ordered a hold in the action"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110970708">
	<b:glossaryEntry>a mutually agreed delay in the date set for the completion of a job or payment of a debt; "they applied for an extension of the loan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110970897"
	 b:glossaryEntry="an intermission between the first and second half of a game"/>
<rdf:Description rdf:about="&a;110971011"
	 b:glossaryEntry="an intervening period or episode"/>
<rdf:Description rdf:about="&a;110971117"
	 b:glossaryEntry="the interlude between two acts of a play"/>
<rdf:Description rdf:about="&a;110971213"
	 b:glossaryEntry="the time between one event, process, or period and another"/>
<rdf:Description rdf:about="&a;110971349">
	<b:glossaryEntry>the time that elapses before the presence of a disease is manifested by symptoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110971489">
	<b:glossaryEntry>the time that elapses between a stimulus and the response to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110971654"
	 b:glossaryEntry="a seemingly endless time interval (waiting)"/>
<rdf:Description rdf:about="&a;110971752"
	 b:glossaryEntry="the time between two reigns, governments, etc."/>
<rdf:Description rdf:about="&a;110971856">
	<b:glossaryEntry>a period of time spent sleeping; "he felt better after a little sleep"; "a brief nap"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110972017"
	 b:glossaryEntry="sleep before midnight"/>
<rdf:Description rdf:about="&a;110972097">
	<b:glossaryEntry>a pause for relaxation; "people actually accomplish more when they take time for short rests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110972292">
	<b:glossaryEntry>a brief suspension of play; "each team has two time-outs left"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110972428">
	<b:glossaryEntry>a pause during which things are calm or activities are diminished; "there was never a letup in the noise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110972592"
	 b:glossaryEntry="a short respite"/>
<rdf:Description rdf:about="&a;110972742">
	<b:glossaryEntry>the period of time during which a contract conveying property to a person is in effect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110972901">
	<b:glossaryEntry>the time required for something to fall to half its initial value (in particular, the time for half the atoms in a radioactive substance to disintegrate)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110973110">
	<b:glossaryEntry>the time constant of an exponential return of a system to equilibrium after a disturbance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110973261">
	<b:glossaryEntry>a legally authorized postponement before some obligation must be discharged</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110973393"
	 b:glossaryEntry="there are usually two high and two low tides each day"/>
<rdf:Description rdf:about="&a;110973517"
	 b:glossaryEntry="(physics) a rate of change of velocity"/>
<rdf:Description rdf:about="&a;110973632">
	<b:glossaryEntry>the acceleration toward the center that holds a satellite in elliptical orbit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110973780"
	 b:glossaryEntry="the rate of shrinkage in size or number"/>
<rdf:Description rdf:about="&a;110973900">
	<b:glossaryEntry>the ratio of live births in an area to the population of that area; expressed per 1000 population per year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110974104">
	<b:glossaryEntry>(computer science) the rate at which data is transferred (as by a modem)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110974244">
	<b:glossaryEntry>the ratio of crimes in an area to the population of that area; expressed per 1000 population per year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110974402">
	<b:glossaryEntry>the rate at which circuits or other devices operate when handling digital information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110974561">
	<b:glossaryEntry>the ratio of deaths in an area to the population of that area; expressed per 1000 per year</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110974766"
	 b:glossaryEntry="the quantity of radiation absorbed per unit time"/>
<rdf:Description rdf:about="&a;110974870">
	<b:glossaryEntry>the rate at which red blood cells settle out in a tube of blood under standardized conditions; a high rate usually indicates the presence of inflammation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110975138"
	 b:glossaryEntry="the amount of fluid that flows in a given time"/>
<rdf:Description rdf:about="&a;110975280">
	<b:glossaryEntry>the amount of blood pumped out by the ventricles in a given period of time; "a resting adult has a cardiac output of about three quarts a minute"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110975486">
	<b:glossaryEntry>the rate of flow of energy or particles across a given surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110975635">
	<b:glossaryEntry>the number of occurrences within a given time period (usually 1 second); "the frequency of modulation was 40 cycles per second"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110975932"
	 b:glossaryEntry="1,000,000,000 periods per second"/>
<rdf:Description rdf:about="&a;110976066"
	 b:glossaryEntry="the rate of increase in size per unit time"/>
<rdf:Description rdf:about="&a;110976183">
	<b:glossaryEntry>the unit of frequency; one Hertz has a periodic interval of one second</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110976378">
	<b:glossaryEntry>the rate of change of prices (as indicated by a price index) calculated on a monthly or annual basis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110976559"
	 b:glossaryEntry="(mechanics) the rate of change of velocity"/>
<rdf:Description rdf:about="&a;110976675"
	 b:glossaryEntry="one thousand periods per second"/>
<rdf:Description rdf:about="&a;110976846">
	<b:glossaryEntry>the ratio of the distance traveled (in kilometers) to the time spent traveling (in hours)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110977014"
	 b:glossaryEntry="one million periods per second"/>
<rdf:Description rdf:about="&a;110977165">
	<b:glossaryEntry>rate of metabolism; the amount of energy expended in a give period</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110977310">
	<b:glossaryEntry>the ratio of the distance traveled (in miles) to the time spent traveling (in hours)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110977461"
	 b:glossaryEntry="the rate of moving (especially walking or running)"/>
<rdf:Description rdf:about="&a;110977623"
	 b:glossaryEntry="the rate at which the heart beats"/>
<rdf:Description rdf:about="&a;110977721">
	<b:glossaryEntry>rate of revolution of a motor; "the engine was doing 6000 revs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110977865">
	<b:glossaryEntry>the rate at which radiant solar energy is received at the outer layer of the earth''s atmosphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110978021">
	<b:glossaryEntry>the time between occurrences of a repeating event; "some women do not control the spacing of their children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110978183"
	 b:glossaryEntry="distance travelled per unit time"/>
<rdf:Description rdf:about="&a;110978422"
	 b:glossaryEntry="the rate of some repeating event"/>
<rdf:Description rdf:about="&a;110978513"
	 b:glossaryEntry="a normal marching pace of 120 steps per minute"/>
<rdf:Description rdf:about="&a;110978616"
	 b:glossaryEntry="a fast marching pace (180 steps/min) or slow jog"/>
<rdf:Description rdf:about="&a;110978722">
	<b:glossaryEntry>the speed of an aircraft relative to the air in which it is flying</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110978843"
	 b:glossaryEntry="the minimum velocity needed to escape a gravitational field"/>
<rdf:Description rdf:about="&a;110978964"
	 b:glossaryEntry="the speed of an aircraft relative to the ground"/>
<rdf:Description rdf:about="&a;110979069">
	<b:glossaryEntry>excessive velocity; "the meteorites struck the earth with hypervelocity impacts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110979209">
	<b:glossaryEntry>the velocity of a projectile as it leaves the muzzle of a gun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110979332">
	<b:glossaryEntry>the speed at which light travels in a vacuum; 300,000 km per second; a universal constant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110979500">
	<b:glossaryEntry>(nautical) the minimum rate of motion needed for a vessel to be maneuvered</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110979632">
	<b:glossaryEntry>the constant maximum velocity reached by a body falling through the atmosphere under the attraction of gravity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110979806"
	 b:glossaryEntry="a speedometer reading for the momentary rate of travel"/>
<rdf:Description rdf:about="&a;110979927"
	 b:glossaryEntry="frequency per minute"/>
<rdf:Description rdf:about="&a;110980026"
	 b:glossaryEntry="the death rate during the first year of life"/>
<rdf:Description rdf:about="&a;110980176">
	<b:glossaryEntry>the rate at which words are produced (as in speaking or typing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110980308">
	<b:glossaryEntry>(music) the pace of music measured by the number of beats occurring in 60 seconds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110980504">
	<b:glossaryEntry>a magnitude or frequency relative to a time unit; "they traveled at a rate of 55 miles per hour"; "the rate of change was faster than expected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110981238">
	<b:glossaryEntry>the maximum data rate that can be attained over a given channel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110981364">
	<b:glossaryEntry>the rate of flow of neutrons; the number of neutrons passing through a unit area in unit time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110981516"
	 b:glossaryEntry="the rate of flow of radiant energy (electromagnetic waves)"/>
<rdf:Description rdf:about="&a;110981651"
	 b:glossaryEntry="the rate of flow of light energy"/>
<rdf:Description rdf:about="&a;110981743">
	<b:glossaryEntry>an interval during which a recurring sequence of events occurs; "the neverending cycle of the seasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110981933">
	<b:glossaryEntry>a recurring cycle (beginning at menarche and ending at menopause) in which the endometrial lining of the uterus prepares for pregnancy; if pregnancy does not occur the lining is shed at menstruation; "the average menstrual cycle is 28 days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110982292">
	<b:glossaryEntry>the phase of the menstrual cycle during which the lining of the uterus is shed (the first day of menstrual flow is considered day 1 of the menstrual cycle)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110982528">
	<b:glossaryEntry>the second half of the menstrual cycle after ovulation; the corpus luteum secretes progesterone which prepares the endometrium for the implantation of an embryo; if fertilization does not occur then menstrual flow begins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110982844">
	<b:glossaryEntry>the interval taken to complete one cycle of a regularly repeating phenomenon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110982991">
	<b:glossaryEntry>the time it takes to complete one full orbit around a celestial body; "the orbit period depends on the altitude of the satelite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110983178">
	<b:glossaryEntry>a particular point in the time of a cycle; measured from some arbitrary zero and expressed as an angle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110983365">
	<b:glossaryEntry>any distinct time period in a sequence of events; "we are in a transitional stage in which many former ideas must be revised or rejected"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110983778"
	 b:glossaryEntry="occurring in more than one stage"/>
<rdf:Description rdf:about="&a;110983867">
	<b:glossaryEntry>a final climactic stage; "their achievements stand as a culmination of centuries of development"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110984030"
	 b:glossaryEntry="any time of new development"/>
<rdf:Description rdf:about="&a;110984112"
	 b:glossaryEntry="the term during which some position is held"/>
<rdf:Description rdf:about="&a;110984256"
	 b:glossaryEntry="the time period during which you are at work"/>
<rdf:Description rdf:about="&a;110984524">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a time for working (after which you will be relieved by someone else); "it''s my go"; "a spell of work"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110984697"
	 b:glossaryEntry="a period of work or duty"/>
<rdf:Description rdf:about="&a;110984773">
	<b:glossaryEntry>a period of time (4 or 2 hours) during which some of a ship''s crew are on duty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110984939">
	<b:glossaryEntry>the period during which someone (especially a guard) is on duty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110985054"
	 b:glossaryEntry="either of two short watches: from 4-6 pm or 6-8 pm"/>
<rdf:Description rdf:about="&a;110985159"
	 b:glossaryEntry="the work shift during the day (as 8 a.m. to 4 p.m.)"/>
<rdf:Description rdf:about="&a;110985266"
	 b:glossaryEntry="the work shift during the evening (as 4 p.m. to midnight)"/>
<rdf:Description rdf:about="&a;110985397"
	 b:glossaryEntry="the work shift during the night (as midnight to 8 a.m.)"/>
<rdf:Description rdf:about="&a;110985528">
	<b:glossaryEntry>a working shift divided into two periods of time with several hours in between</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110985664"
	 b:glossaryEntry="a period of time during which there is no war"/>
<rdf:Description rdf:about="&a;110985765"
	 b:glossaryEntry="a period of time during which there is armed conflict"/>
<rdf:Description rdf:about="&a;110985872"
	 b:glossaryEntry="a watch during the night (as from midnight to 8 a.m.)"/>
<rdf:Description rdf:about="&a;110986027"
	 b:glossaryEntry="a period of time spent in military service"/>
<rdf:Description rdf:about="&a;110986189">
	<b:glossaryEntry>the early usually calm and harmonious period of a relationship; business or political</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110986330">
	<b:glossaryEntry>a 15-year cycle used as a chronological unit in ancient Rome and adopted in some medieval kingdoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110986484">
	<b:glossaryEntry>the time interval between the deposit of a check in a bank and its payment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110986610">
	<b:glossaryEntry>the period from 1920 to 1933 when the sale of alcoholic beverages was prohibited in the United States by a constitutional amendment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110986817">
	<b:glossaryEntry>the period between infection and the appearance of symptoms of the disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110986955">
	<b:glossaryEntry>a (future) time of financial need; "I am saving for a rainy day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110987075">
	<b:glossaryEntry>the period during which you are a novice (especially in a religious order)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110987217"
	 b:glossaryEntry="the period of greatest prosperity or productivity"/>
<rdf:Description rdf:about="&a;110987385">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the duration of a monarch''s or government''s power; "during the rule of Elizabeth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110987535">
	<b:glossaryEntry>(England) the Regency was the period from 1811-1820 when the Prince of Wales was regent during George III''s periods of insanity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110987716"
	 b:glossaryEntry="the length of time that a movie or tv show runs"/>
<rdf:Description rdf:about="&a;110987822">
	<b:glossaryEntry>that time during a woman''s menstrual cycle during which conception is least likely to occur (usually immediately before of after menstruation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110988041"
	 b:glossaryEntry="a feast day and the seven days following it"/>
<rdf:Description rdf:about="&a;110988137">
	<b:glossaryEntry>that time; that moment; "we will arrive before then"; "we were friends from then on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110988272">
	<b:glossaryEntry>(Judaism) a period of seven days of mourning after the death of close relative; "the family is sitting shiva"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110988451">
	<b:glossaryEntry>(astronomy) the precise date that is the point of reference for which information (as coordinates of a celestial body) is referred</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110988653">
	<b:glossaryEntry>a stage in the history of a culture having a definable place in space and time; "a novel from the Victorian period"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110988859">
	<b:glossaryEntry>the time it takes for a sample of blood to clot; used to diagnose some clotting disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110989008">
	<b:glossaryEntry>(computer science) the time it takes for a specific block of data on a data track to rotate around to the read/write head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110989223">
	<b:glossaryEntry>the time it takes to complete a prescribed procedure; "they increased output by decreasing processing time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110989410">
	<b:glossaryEntry>(computer science) the processing time required by a device prior to the execution of a command</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200001740">
	<b:glossaryEntry>draw air into, and expel out of, the lungs; "I can breathe better when the air is clean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200002143">
	<b:glossaryEntry>breathe with great difficulty, as when experiencing a strong emotion; "She choked with emotion when she spoke about her deceased husband"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200002343">
	<b:glossaryEntry>breathe excessively; "The mountain climber started to hyperventilate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200002484"
	 b:glossaryEntry="suck in air"/>
<rdf:Description rdf:about="&a;200002561">
	<b:glossaryEntry>expel gas from the stomach; "In China it is polite to burp at the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200002720"
	 b:glossaryEntry='emit with force of effort; "force out the air"'/>
<rdf:Description rdf:about="&a;200002841">
	<b:glossaryEntry>breathe spasmodically, and make a sound; "When you have to hiccup, drink a glass of cold water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200003011">
	<b:glossaryEntry>heave or utter a sigh; breathe deeply and heavily; "She sighed sadly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200003142"
	 b:glossaryEntry='expel air; "Exhale when you lift the weight"'/>
<rdf:Description rdf:about="&a;200003335"
	 b:glossaryEntry='keep from exhaling or expelling; "hold your breath"'/>
<rdf:Description rdf:about="&a;200003430">
	<b:glossaryEntry>give out, as of breath or an odor; "The chimney exhales a thick smoke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200003595">
	<b:glossaryEntry xml:space='preserve'><![CDATA[exhale spasmodically, as when an irritant entered one''s nose; "Pepper makes me sneeze"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200003763"
	 b:glossaryEntry='draw in air; "Inhale deeply"'/>
<rdf:Description rdf:about="&a;200004002">
	<b:glossaryEntry>breathe noisily, as when one is exhausted; "The runners reached the finish line, panting heavily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200004183">
	<b:glossaryEntry>exhale abruptly, as when one has a chest cold or congestion; "The smoker coughs all day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200004432">
	<b:glossaryEntry>cough spasmodically; "The patient with emphysema is hacking all day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200004570"
	 b:glossaryEntry="discharge for the lungs"/>
<rdf:Description rdf:about="&a;200004767"
	 b:glossaryEntry="make a snorting sound by exhaling hard"/>
<rdf:Description rdf:about="&a;200004868"
	 b:glossaryEntry="breathe with difficulty"/>
<rdf:Description rdf:about="&a;200004955"
	 b:glossaryEntry="blow hard and loudly"/>
<rdf:Description rdf:about="&a;200005052"
	 b:glossaryEntry='exhale hard; "blow on the soup to cool it down"'/>
<rdf:Description rdf:about="&a;200005197"
	 b:glossaryEntry="utter a yawn; as from lack of oxygne or when one is tired"/>
<rdf:Description rdf:about="&a;200005316"
	 b:glossaryEntry="inhale audibly"/>
<rdf:Description rdf:about="&a;200005403">
	<b:glossaryEntry>briefly shut the eyes; "The TV announcer never seems to blink"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200005575">
	<b:glossaryEntry xml:space='preserve'><![CDATA[wink briefly; "bat one''s eyelids"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200005679"
	 b:glossaryEntry='signal by winking; "She winked at him"'/>
<rdf:Description rdf:about="&a;200005779"
	 b:glossaryEntry='force to go away by blinking; "blink away tears"'/>
<rdf:Description rdf:about="&a;200005910">
	<b:glossaryEntry xml:space='preserve'><![CDATA[partly close one''s eyes; "The children squinted to frighten each other"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200006074">
	<b:glossaryEntry>make a face indicating disgust or dislike; "She winced when she heard his pompous speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200006226"
	 b:glossaryEntry="cast off hair, skin, horn, or feathers; of animals"/>
<rdf:Description rdf:about="&a;200006391"
	 b:glossaryEntry="peel off in scales; of skin"/>
<rdf:Description rdf:about="&a;200006497">
	<b:glossaryEntry>make an uncontrolled, short, jerky motion; "his face is twitching"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200006642"
	 b:glossaryEntry="move in an uncontrolled manner"/>
<rdf:Description rdf:about="&a;200006829"
	 b:glossaryEntry="act in an uncontrolled manner"/>
<rdf:Description rdf:about="&a;200007023">
	<b:glossaryEntry xml:space='preserve'><![CDATA[behave in a certain manner; show a certain behavior; conduct or comport oneself; "You should act like an adult"; "Don''t behave like a fool"; "What makes her do this way?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200007780"
	 b:glossaryEntry="act as a medical quack or a charlatan"/>
<rdf:Description rdf:about="&a;200007880"
	 b:glossaryEntry='act in a threatening manner; "A menacing person"'/>
<rdf:Description rdf:about="&a;200007992">
	<b:glossaryEntry>act in a certain way so as to acquire; "make friends"; "make enemies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200008159"
	 b:glossaryEntry="act in an arrogant, overly self-assured, or conceited manner"/>
<rdf:Description rdf:about="&a;200008302"
	 b:glossaryEntry="behave cold and formally"/>
<rdf:Description rdf:about="&a;200008390"
	 b:glossaryEntry="behave extremely cruelly and brutally"/>
<rdf:Description rdf:about="&a;200008491"
	 b:glossaryEntry="act in a romantic way"/>
<rdf:Description rdf:about="&a;200008581"
	 b:glossaryEntry="act in a sentimental way"/>
<rdf:Description rdf:about="&a;200008694"
	 b:glossaryEntry='spoil by behaving clumsily or foolishly; "I bungled it!"'/>
<rdf:Description rdf:about="&a;200008814">
	<b:glossaryEntry>engage in an activity as if it were a game: "They played games on their opponents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200008958">
	<b:glossaryEntry>pretend to have certain qualities or state of mind; "He acted the idiot"; "She plays deaf when the news are bad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200009165">
	<b:glossaryEntry>act as a stooge, in a compliant or subordinate manner; "He stooged for the flamboyant Senator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200009323"
	 b:glossaryEntry="move with a tremor"/>
<rdf:Description rdf:about="&a;200009431"
	 b:glossaryEntry="shake, as from cold or fear"/>
<rdf:Description rdf:about="&a;200009549"
	 b:glossaryEntry="be at rest"/>
<rdf:Description rdf:about="&a;200009666"
	 b:glossaryEntry='be in a state of action; "she is always moving"'/>
<rdf:Description rdf:about="&a;200009805"
	 b:glossaryEntry="be asleep"/>
<rdf:Description rdf:about="&a;200010100"
	 b:glossaryEntry="sleep fully clothed in the same bed with one''s betrothed"/>
<rdf:Description rdf:about="&a;200010240"
	 b:glossaryEntry="sleep lightly or for a short period of time"/>
<rdf:Description rdf:about="&a;200010381"
	 b:glossaryEntry='take a siesta; "She naps everyday after lunch for an hour"'/>
<rdf:Description rdf:about="&a;200010542"
	 b:glossaryEntry="sleep longer than intended"/>
<rdf:Description rdf:about="&a;200010635">
	<b:glossaryEntry>sleep later than usual or customary; "On Sundays, I sleep in"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200010775"
	 b:glossaryEntry="sleep during winter, as of certain animals, such as bears"/>
<rdf:Description rdf:about="&a;200010927"
	 b:glossaryEntry="sleep during summer, as of certain animals"/>
<rdf:Description rdf:about="&a;200011065"
	 b:glossaryEntry="be on the verge of sleeping"/>
<rdf:Description rdf:about="&a;200011192"
	 b:glossaryEntry='be almost asleep; "The old man sat nodding by the fireplace"'/>
<rdf:Description rdf:about="&a;200011321">
	<b:glossaryEntry>let the head fall forward through drowsiness; "The old man was nodding in his chair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200011456"
	 b:glossaryEntry="fall asleep fast, as when one is extremely tired"/>
<rdf:Description rdf:about="&a;200011570"
	 b:glossaryEntry="breathe noisily during one''s sleep"/>
<rdf:Description rdf:about="&a;200011707">
	<b:glossaryEntry>change from a waking to a sleeping state; "he always falls asleep during lectures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200011956"
	 b:glossaryEntry='go to bed; "We bedded down at midnight"'/>
<rdf:Description rdf:about="&a;200012099">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sleep in a convenient place; "You can crash here, though it''s not very comfortable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200012272"
	 b:glossaryEntry='go to bed in order to sleep; "I usually turn in at midnight"'/>
<rdf:Description rdf:about="&a;200012545">
	<b:glossaryEntry>get up and out of bed; "I get up at 7 A.M. every day"; "They rose early"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200012725"
	 b:glossaryEntry='cause to rise; "The sergeant got us up at 2 A.M."'/>
<rdf:Description rdf:about="&a;200012846"
	 b:glossaryEntry='stop sleeping; "She woke up to the sound of the alarm clock"'/>
<rdf:Description rdf:about="&a;200013061">
	<b:glossaryEntry>cause to become awake or conscious; "He was roused by the drunken men in the street"; "Please wake me at 6 AM."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200013351"
	 b:glossaryEntry="awaken once again"/>
<rdf:Description rdf:about="&a;200013442">
	<b:glossaryEntry>make fall asleep; "The soft music caused us to to fall asleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200013620"
	 b:glossaryEntry="act physically on; have an effect upon"/>
<rdf:Description rdf:about="&a;200013890">
	<b:glossaryEntry>begin to injure; "The cancer cells are attacking his liver"; "Rust is attacking the metal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200014044"
	 b:glossaryEntry='affect with an ulcer; "Her stomach was ulcerated"'/>
<rdf:Description rdf:about="&a;200014159"
	 b:glossaryEntry="be awake, be alert, be there"/>
<rdf:Description rdf:about="&a;200014267"
	 b:glossaryEntry="not go to bed"/>
<rdf:Description rdf:about="&a;200014364"
	 b:glossaryEntry="induce hypnosis in"/>
<rdf:Description rdf:about="&a;200014487"
	 b:glossaryEntry="put into a trance"/>
<rdf:Description rdf:about="&a;200014590">
	<b:glossaryEntry>make unconscious by means of anesthetic drugs; "The patient must be anesthetized before the operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200014929"
	 b:glossaryEntry="anesthetize with ether"/>
<rdf:Description rdf:about="&a;200015025"
	 b:glossaryEntry="anesthetize with cocaine"/>
<rdf:Description rdf:about="&a;200015136">
	<b:glossaryEntry>anesthetize with chloroform; "Doctors used to put people under by chloroforming them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200015289"
	 b:glossaryEntry="anesthetize by cold, as for certain surgical procedures"/>
<rdf:Description rdf:about="&a;200015408"
	 b:glossaryEntry="bring back to consciousness"/>
<rdf:Description rdf:about="&a;200015587">
	<b:glossaryEntry>cause to be calm or quiet; "The patient must be sedated before the operation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200015782">
	<b:glossaryEntry>cause to be alert and energetic; "Coffee and tea stimulate me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200016110"
	 b:glossaryEntry="deprive of energy"/>
<rdf:Description rdf:about="&a;200016214"
	 b:glossaryEntry="inject with libidinal energy"/>
<rdf:Description rdf:about="&a;200016307"
	 b:glossaryEntry="gain or regain energy"/>
<rdf:Description rdf:about="&a;200016435">
	<b:glossaryEntry>pass out from weakness, physical or emotional distress due to a loss of blood supply to the brain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200016621"
	 b:glossaryEntry="lose consciousness due to a sudden trauma, for example"/>
<rdf:Description rdf:about="&a;200016821"
	 b:glossaryEntry='return to consciousness: "The patient came to quickly"'/>
<rdf:Description rdf:about="&a;200016967"
	 b:glossaryEntry='give new life or energy to; "A hot soup will revive me"'/>
<rdf:Description rdf:about="&a;200017157"
	 b:glossaryEntry="make fresh again"/>
<rdf:Description rdf:about="&a;200017304">
	<b:glossaryEntry>become or make oneself fresh again; "She freshened up after the tennis game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200017506">
	<b:glossaryEntry xml:space='preserve'><![CDATA[wash one''s face and hands; "She freshened up in the bathroom"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200017632"
	 b:glossaryEntry="make lively or spirited"/>
<rdf:Description rdf:about="&a;200017738"
	 b:glossaryEntry="make tense"/>
<rdf:Description rdf:about="&a;200017929"
	 b:glossaryEntry="twist the head into a strained position"/>
<rdf:Description rdf:about="&a;200018031"
	 b:glossaryEntry='cause to feel relaxed; "A hot bath always relaxes me"'/>
<rdf:Description rdf:about="&a;200018290">
	<b:glossaryEntry>release from mental strain, tension, or formality; "unbend the mind from absorbing too much information"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200018458">
	<b:glossaryEntry>become tense or tenser; "He tensed up when he saw his opponent enter the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200018644"
	 b:glossaryEntry='become less tense; "He relaxed in the hot tub"'/>
<rdf:Description rdf:about="&a;200018860"
	 b:glossaryEntry="settle into a comfortable sitting position"/>
<rdf:Description rdf:about="&a;200018983"
	 b:glossaryEntry="prepare for strenuous physical activity"/>
<rdf:Description rdf:about="&a;200019111">
	<b:glossaryEntry xml:space='preserve'><![CDATA[extend one''s limbs or muscles, or the entire body; "Stretch your legs!" "Extend your right arm above your head"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200019340">
	<b:glossaryEntry>stretch out completely; "They spread-eagled him across the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200019475">
	<b:glossaryEntry>extend out and forward, as of a limb; "He held out his hand"; "point a finger"; "extend a hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200019686"
	 b:glossaryEntry="of the neck; so as to see better"/>
<rdf:Description rdf:about="&a;200019795">
	<b:glossaryEntry>impart vigor, strength, or vitality to; "Exercise is invigorating"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200019944">
	<b:glossaryEntry>change one''s facial expression by spreading the lips, often to signal pleasure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200020183">
	<b:glossaryEntry>produce dimples while smiling; "The child dimpled up to the adults"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200020314">
	<b:glossaryEntry>to draw back the lips and reveal the teeth, in a smile, grimace, or snarl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200020449">
	<b:glossaryEntry>smile radiantly; express joy through one''s facial expression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200020571"
	 b:glossaryEntry="smile affectedly or derisively"/>
<rdf:Description rdf:about="&a;200020681"
	 b:glossaryEntry="laugh loudly and harshly"/>
<rdf:Description rdf:about="&a;200020775"
	 b:glossaryEntry="laugh a deep, hearty laugh"/>
<rdf:Description rdf:about="&a;200020869"
	 b:glossaryEntry="laugh unrestrainedly and heartily"/>
<rdf:Description rdf:about="&a;200020971"
	 b:glossaryEntry="laugh quietly"/>
<rdf:Description rdf:about="&a;200021067"
	 b:glossaryEntry="laugh nervously"/>
<rdf:Description rdf:about="&a;200021155"
	 b:glossaryEntry="laugh unrestrainedly"/>
<rdf:Description rdf:about="&a;200021252">
	<b:glossaryEntry>weaken or destroy in spirit or body; "For a hero loves the world till it breaks him"--Yeats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200021406"
	 b:glossaryEntry="collapse due to fatigue, an illness, or a sudden attack"/>
<rdf:Description rdf:about="&a;200021540">
	<b:glossaryEntry>fall forward and down; "The old woman went over without a sound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200021681"
	 b:glossaryEntry="emit a loud, unpleasant kind of laughing"/>
<rdf:Description rdf:about="&a;200021785"
	 b:glossaryEntry="laugh boisterously"/>
<rdf:Description rdf:about="&a;200021890"
	 b:glossaryEntry="laugh quietly or with restraint"/>
<rdf:Description rdf:about="&a;200022011"
	 b:glossaryEntry="produce laughter"/>
<rdf:Description rdf:about="&a;200022398"
	 b:glossaryEntry="be overcome with laughter"/>
<rdf:Description rdf:about="&a;200022497"
	 b:glossaryEntry="laugh loudly and in an unrestrained way"/>
<rdf:Description rdf:about="&a;200022604"
	 b:glossaryEntry="smile contemptuously"/>
<rdf:Description rdf:about="&a;200022695"
	 b:glossaryEntry="express contempt through a facial expression"/>
<rdf:Description rdf:about="&a;200022810"
	 b:glossaryEntry="wrinkle one''s forehead in a sign of disapproval"/>
<rdf:Description rdf:about="&a;200022963">
	<b:glossaryEntry>look at with a fixed gaze: "The girl glared at the man who tried to make a pass at her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200023130">
	<b:glossaryEntry xml:space='preserve'><![CDATA[fixate one''s eyes; look at with a fixed gaze, as of a sculpture or a painting; "The ancestor in the painting stared down at us menacingly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200023357">
	<b:glossaryEntry>have a certain outward or facial expression; "How does she look?" "The child looks unhappy"; "She looked pale after the surgery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200023538"
	 b:glossaryEntry="frown with displeasure"/>
<rdf:Description rdf:about="&a;200023623">
	<b:glossaryEntry>raise one''s shoulders to indicate indifference or resignation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200023765">
	<b:glossaryEntry xml:space='preserve'><![CDATA[clap one''s hands together; "The children were clapping to the music"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200023902">
	<b:glossaryEntry>contort the face, make a face; "He grimaced when he saw the amount of homework he had to do"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200024185">
	<b:glossaryEntry xml:space='preserve'><![CDATA[twist into a strained configuration; "screw up one''s face"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200024309"
	 b:glossaryEntry='make a sad face; "mop and mow"'/>
<rdf:Description rdf:about="&a;200024413">
	<b:glossaryEntry xml:space='preserve'><![CDATA[free of obstruction by blowing air through: "blow one''s nose"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200024536">
	<b:glossaryEntry xml:space='preserve'><![CDATA[clear mucus or food from one''s throat; "he cleared his throat before he started to speak"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200024706"
	 b:glossaryEntry="clear the throat, as of phlegm"/>
<rdf:Description rdf:about="&a;200024814">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take a shower; wash one''s body in the shower; "You shuld shower after vigorous exercise"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200024966"
	 b:glossaryEntry='cleanse the entire body; "bathe daily"'/>
<rdf:Description rdf:about="&a;200025085">
	<b:glossaryEntry xml:space='preserve'><![CDATA[clean one''s body or parts thereof, as by washing; "clean up before you see your grandparents"; "clean your fingernails before dinner"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200025451">
	<b:glossaryEntry>to cleanse (itself or another animal) by licking, as of a cat; "The cat washes several times a day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200025612"
	 b:glossaryEntry="cleanse (one''s body) with soap and water"/>
<rdf:Description rdf:about="&a;200025845"
	 b:glossaryEntry="wash with a sponge"/>
<rdf:Description rdf:about="&a;200025940"
	 b:glossaryEntry="wash thoroughly; of surgeons before an operation"/>
<rdf:Description rdf:about="&a;200026062"
	 b:glossaryEntry="rub soap all over, usually with the purpose of cleaning"/>
<rdf:Description rdf:about="&a;200026214">
	<b:glossaryEntry xml:space='preserve'><![CDATA[rinse one''s mouth and throat with mouthwash; "gargle with this liquid"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200026356"
	 b:glossaryEntry="remove body hair with a razor"/>
<rdf:Description rdf:about="&a;200026510"
	 b:glossaryEntry="shave with a razor"/>
