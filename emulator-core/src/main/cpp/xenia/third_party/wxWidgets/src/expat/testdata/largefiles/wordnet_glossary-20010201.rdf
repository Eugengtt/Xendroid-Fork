	 b:glossaryEntry="a local and well-defined elevation of the land"/>
<rdf:Description rdf:about="&a;106723517"
	 b:glossaryEntry="a relatively low hill on the lower slope of a mountain"/>
<rdf:Description rdf:about="&a;106723626"
	 b:glossaryEntry="a small natural hill"/>
<rdf:Description rdf:about="&a;106723790"
	 b:glossaryEntry="(South Africa) a small hill rising up from the African veld"/>
