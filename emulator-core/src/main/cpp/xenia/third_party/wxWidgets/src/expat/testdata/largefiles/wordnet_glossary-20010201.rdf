</rdf:Description>
<rdf:Description rdf:about="&a;400259086">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without previous thought or preparation; "couldn''t give the figures offhand"; "we decided offhand to go to Canada"; "she had made these remarks offhandedly"]]></b:glossaryEntry>
</rdf:Description>
