	 b:glossaryEntry="genus of woody Asiatic vines: kudzu"/>
<rdf:Description rdf:about="&a;108867357">
	<b:glossaryEntry>fast-growing East Asian vine having hairy trifoliate leaves and racemes of purple flowers followed by long many-seed hairy pods and tuberous starchy roots; grown for fodder and forage and root starch; widespread in the southern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108867700">
	<b:glossaryEntry>small genus of mediterranean shrubs; often included in genus Genista</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108867874">
	<b:glossaryEntry>desert shrub of Syria and Arabia having small white flowers; constitutes the juniper of the Old Testament; sometimes placed in genus Genista</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108868152"
	 b:glossaryEntry="deciduous flowering trees and shrubs"/>
<rdf:Description rdf:about="&a;108868334">
