<rdf:Description rdf:about="&a;201331074"
	 b:glossaryEntry="transport by lighter"/>
<rdf:Description rdf:about="&a;201331167"
	 b:glossaryEntry="send off unceremoniously"/>
<rdf:Description rdf:about="&a;201331285"
	 b:glossaryEntry="send off promptly"/>
<rdf:Description rdf:about="&a;201331450"
	 b:glossaryEntry="send documents or materials to appropriate destinations"/>
<rdf:Description rdf:about="&a;201331576">
	<b:glossaryEntry>send or ship onward from an intermediate post or station in transit; "forward my mail"</b:glossaryEntry>
</rdf:Description>
