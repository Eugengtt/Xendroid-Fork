	 b:glossaryEntry="without a date fixed (as of an adjournment)"/>
<rdf:Description rdf:about="&a;400252604"
	 b:glossaryEntry='in an undertone; "he uttered a curse sotto voce"'/>
<rdf:Description rdf:about="&a;400252708">
