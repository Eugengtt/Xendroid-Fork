</rdf:Description>
<rdf:Description rdf:about="&a;101933279">
	<b:glossaryEntry>one-humped camel of the hot deserts of North Africa and southwestern Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101933446"
	 b:glossaryEntry="two-humped camel of the cold deserts of central Asia"/>
<rdf:Description rdf:about="&a;101933580">
