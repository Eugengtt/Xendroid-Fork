	<b:glossaryEntry>a dark meadow soil rich in organic material; developed through poor drainage in humid grassy or sedge regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110832541"
	 b:glossaryEntry="the hard fibrous lignified substance under the bark of trees"/>
<rdf:Description rdf:about="&a;110834310"
	 b:glossaryEntry="any wood from which dye is obtained"/>
