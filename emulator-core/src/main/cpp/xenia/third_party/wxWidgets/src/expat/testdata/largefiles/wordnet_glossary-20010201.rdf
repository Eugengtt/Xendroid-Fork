	 b:glossaryEntry="of snow masses in the mountains"/>
<rdf:Description rdf:about="&a;201338935"
	 b:glossaryEntry="jump lightly"/>
<rdf:Description rdf:about="&a;201339070"
	 b:glossaryEntry="jump about playfully"/>
