</rdf:Description>
<rdf:Description rdf:about="&a;108108606">
	<b:glossaryEntry>small deciduous clump-forming tree or shrub of eastern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108108820">
	<b:glossaryEntry>common perennial herb having aromatic roots used as a substitute for sarsaparilla; central and eastern North America</b:glossaryEntry>
</rdf:Description>
