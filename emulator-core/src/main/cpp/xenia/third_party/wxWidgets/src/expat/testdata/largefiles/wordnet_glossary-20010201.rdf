	 b:glossaryEntry="maintain the same pace"/>
<rdf:Description rdf:about="&a;200755606">
	<b:glossaryEntry>overcome by conquest; "conquer your fears"; "conquer a country"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200755742"
	 b:glossaryEntry="beat in a chess game"/>
<rdf:Description rdf:about="&a;200755829"
	 b:glossaryEntry='place into check in a game of chess; "He checked my kings"'/>
