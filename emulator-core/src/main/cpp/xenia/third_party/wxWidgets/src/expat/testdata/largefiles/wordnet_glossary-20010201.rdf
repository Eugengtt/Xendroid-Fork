</rdf:Description>
<rdf:Description rdf:about="&a;110722217">
	<b:glossaryEntry>a rich soil consisting of a mixture of sand and clay and decaying organic materials</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110722387">
	<b:glossaryEntry>magnetite that possess polarity and has the power to attract as well as to be attracted magnetically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110722574">
	<b:glossaryEntry>a fine-grained unstratified accumulation of clay and silt deposited by the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110722705"
	 b:glossaryEntry="a segment of the trunk of a tree when stripped of branches"/>
<rdf:Description rdf:about="&a;110722813"
	 b:glossaryEntry="brass with 30% (or less) zinc"/>
<rdf:Description rdf:about="&a;110722898">
