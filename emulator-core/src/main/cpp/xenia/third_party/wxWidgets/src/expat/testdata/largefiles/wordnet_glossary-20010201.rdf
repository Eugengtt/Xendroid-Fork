	 b:glossaryEntry="armored dinosaurs: stegosaurs and ankylosaurs"/>
<rdf:Description rdf:about="&a;101222248"
	 b:glossaryEntry="dinosaurs having bony armour"/>
<rdf:Description rdf:about="&a;101222394"
	 b:glossaryEntry="quadrupedal armored herbivore of the Jurassic and Cretaceous"/>
<rdf:Description rdf:about="&a;101222556">
	<b:glossaryEntry>herbivorous ornithischian dinosaur with a row of bony plates along its back and a spiked tail probably used as a weapon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101222784"
	 b:glossaryEntry="armored herbivorous dinosaurs of the Cretaceous"/>
<rdf:Description rdf:about="&a;101222953">
	<b:glossaryEntry>having the back covered with thick bony plates; thought to have walked with a sprawling gait resembling a lizard''s</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101223176">
	<b:glossaryEntry>heavily armored and highly spiked dinosaur with semi-upright posture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101223320">
	<b:glossaryEntry>includes bone-headed (pachycephalosaurs) and horned (ceratopsian) dinosaurs</b:glossaryEntry>
</rdf:Description>
