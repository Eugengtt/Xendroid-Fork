	 b:glossaryEntry="crude iron tapped from a blast furnace"/>
<rdf:Description rdf:about="&a;110752070"
	 b:glossaryEntry="lead that is cast in pigs"/>
<rdf:Description rdf:about="&a;110752150"
	 b:glossaryEntry="an enzyme that dissolves the fibrin of blood clots"/>
<rdf:Description rdf:about="&a;110752299">
	<b:glossaryEntry>an inactive form of plasmin that occurs in plasma and is converted to plasmin by organic solvents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110752454">
	<b:glossaryEntry>a fine black powder of platinum; used as a catalyst in chemical reactions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110752588">
	<b:glossaryEntry>an enzyme that catalyzes the formation of DNA and RNA from an existing strand of DNA or RNA</b:glossaryEntry>
</rdf:Description>
