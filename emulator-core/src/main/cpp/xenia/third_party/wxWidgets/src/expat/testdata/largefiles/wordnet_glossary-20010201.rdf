	 b:glossaryEntry="raise the pitch of (musical notes)"/>
<rdf:Description rdf:about="&a;200273227"
	 b:glossaryEntry="lower the pitch of (musical notes)"/>
<rdf:Description rdf:about="&a;200273351">
	<b:glossaryEntry>get used to a certain climate; "They never acclimatized in Egypt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200273505">
	<b:glossaryEntry>get accustomed or used (to something); "We never adapted to life in the U.S."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200273680">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make synchronous and adjust in time or manner; "Let''s synchronize our efforts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200273878">
