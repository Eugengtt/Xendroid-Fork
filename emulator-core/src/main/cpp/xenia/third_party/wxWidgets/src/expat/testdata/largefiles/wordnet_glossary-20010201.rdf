</rdf:Description>
<rdf:Description rdf:about="&a;102083489"
	 b:glossaryEntry="porgy of southern Atlantic coastal waters of North America"/>
<rdf:Description rdf:about="&a;102083673">
	<b:glossaryEntry>warm-water marine fishes including the drums and grunts and croakers and sea trout</b:glossaryEntry>
</rdf:Description>
