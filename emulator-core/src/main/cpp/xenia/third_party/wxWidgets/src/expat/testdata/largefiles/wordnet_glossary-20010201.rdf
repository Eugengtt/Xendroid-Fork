<rdf:Description rdf:about="&a;101354086"
	 b:glossaryEntry="oilbirds"/>
<rdf:Description rdf:about="&a;101354219"
	 b:glossaryEntry="type and sole genus of the family Steatornithidae"/>
<rdf:Description rdf:about="&a;101354382">
	<b:glossaryEntry>nocturnal fruit-eating bird of South America that has fatty young yielding an oil that is used instead of butter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101354602">
	<b:glossaryEntry>woodpeckers; jacamars; puffbirds; barbets; honey guides; toucans</b:glossaryEntry>
</rdf:Description>
