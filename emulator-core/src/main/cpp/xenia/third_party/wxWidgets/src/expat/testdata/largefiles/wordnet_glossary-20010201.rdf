	 b:glossaryEntry="type genus of the Chamaeleontidae"/>
<rdf:Description rdf:about="&a;101214993"
	 b:glossaryEntry="a chameleon found in Africa"/>
<rdf:Description rdf:about="&a;101215126"
	 b:glossaryEntry="a kind of chameleon"/>
<rdf:Description rdf:about="&a;101215245"
	 b:glossaryEntry="monitor lizards"/>
<rdf:Description rdf:about="&a;101215373"
	 b:glossaryEntry="type and sole extant genus of the Varanidae"/>
<rdf:Description rdf:about="&a;101215524">
