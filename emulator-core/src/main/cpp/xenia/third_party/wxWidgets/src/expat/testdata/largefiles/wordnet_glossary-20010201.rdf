	 b:glossaryEntry="practice play between a football team''s squads"/>
<rdf:Description rdf:about="&a;100577166">
	<b:glossaryEntry>sparring with an imaginary opponent (for exercise or training)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100577287"
	 b:glossaryEntry="practice in shooting at targets"/>
<rdf:Description rdf:about="&a;100577380"
	 b:glossaryEntry="a full rehearsal shortly before the first performance"/>
<rdf:Description rdf:about="&a;100577495">
	<b:glossaryEntry>an activity that stands as an equivalent of something or results in an equivalent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100577745"
	 b:glossaryEntry="a representation of something (usually on a smaller scale)"/>
