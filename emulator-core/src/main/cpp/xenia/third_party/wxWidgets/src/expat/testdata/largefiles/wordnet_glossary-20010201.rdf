<rdf:Description rdf:about="&a;400279200">
	<b:glossaryEntry>in a wild and confused manner; "the drugged man was talking chaotically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400279330"
	 b:glossaryEntry='in a chaste and virtuous manner; "she lived chastely"'/>
<rdf:Description rdf:about="&a;400279469">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in a chatty manner; "`when I was a girl,'' she said chattily, `I used to ride a bicycle''"]]></b:glossaryEntry>
