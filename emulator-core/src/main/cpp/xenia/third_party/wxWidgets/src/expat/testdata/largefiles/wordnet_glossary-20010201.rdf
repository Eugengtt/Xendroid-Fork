	 b:glossaryEntry="propel oneself through the water in a finning motion"/>
<rdf:Description rdf:about="&a;201335716"
	 b:glossaryEntry="swim like a dog; in shallow water"/>
<rdf:Description rdf:about="&a;201335813">
	<b:glossaryEntry xml:space='preserve'><![CDATA[swim by doing the crawl; "European children learn the breast stroke; they often don''t know how to crawl"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201335980"
	 b:glossaryEntry="bathe in the nude"/>
<rdf:Description rdf:about="&a;201336065"
