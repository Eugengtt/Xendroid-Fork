	 b:glossaryEntry="type genus of the Alcedinidae"/>
<rdf:Description rdf:about="&a;101344854"
	 b:glossaryEntry="small kingfisher with greenish-blue and orange plumage"/>
<rdf:Description rdf:about="&a;101345009"
	 b:glossaryEntry="a genus of birds of the family Aldecinidae"/>
<rdf:Description rdf:about="&a;101345157">
