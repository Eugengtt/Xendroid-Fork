	 b:glossaryEntry="the hoof of a horse"/>
<rdf:Description rdf:about="&a;101666749"
	 b:glossaryEntry="insects; about five-sixths of all known animal species"/>
<rdf:Description rdf:about="&a;101667395"
	 b:glossaryEntry="small air-breathing arthropod"/>
<rdf:Description rdf:about="&a;101668259"
	 b:glossaryEntry="an insect that strips the leaves from plants"/>
<rdf:Description rdf:about="&a;101668360"
	 b:glossaryEntry="an insect that carries pollen from one flower to another"/>
<rdf:Description rdf:about="&a;101668473">
	<b:glossaryEntry>any of various insects that deposit their eggs in plants causing galls in which the larvae feed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101668622"
	 b:glossaryEntry="minute wingless arthropods: springtails"/>
<rdf:Description rdf:about="&a;101668775">
	<b:glossaryEntry>any of numerous minute wingless primitive insects possessing a special abdominal appendage that allows the characteristic nearly perpetual springing pattern; found in soil rich in organic debris or on the surface of snow or water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101669094"
	 b:glossaryEntry="minute wingless arthropods: telsontails"/>
<rdf:Description rdf:about="&a;101669241">
	<b:glossaryEntry>any of several minute primitive wingless and eyeless insects having a cone-shaped head; inhabit damp soil or decaying organic matter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101669460"
	 b:glossaryEntry="beetles"/>
<rdf:Description rdf:about="&a;101669942">
	<b:glossaryEntry>insect having biting mouthparts and front wings modified to form horny covers overlying the membranous rear wings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101670433"
	 b:glossaryEntry="tiger beetles"/>
<rdf:Description rdf:about="&a;101670565">
	<b:glossaryEntry>active usually bright-colored beetle that preys on other insects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101670707"
	 b:glossaryEntry="the ladybugs"/>
<rdf:Description rdf:about="&a;101670916">
	<b:glossaryEntry>small round bright-colored and spotted beetle that usually feeds on aphids and other insect pests</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101671214"
	 b:glossaryEntry="genus of ladybugs"/>
<rdf:Description rdf:about="&a;101671337"
	 b:glossaryEntry="red ladybug with a black spot on each wing"/>
<rdf:Description rdf:about="&a;101671484">
	<b:glossaryEntry>genus of ladybugs native to Mexico and Central America; both larvae and adults feed on plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101671689">
	<b:glossaryEntry>introduced into the United States from Mexico; feeds on the foliage of the bean plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101671896"
	 b:glossaryEntry="genus of ladybugs"/>
<rdf:Description rdf:about="&a;101672027"
	 b:glossaryEntry="a variety of ladybug"/>
