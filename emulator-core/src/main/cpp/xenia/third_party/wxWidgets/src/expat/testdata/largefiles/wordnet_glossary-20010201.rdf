<rdf:Description rdf:about="&a;200238223"
	 b:glossaryEntry='happen in a particular manner; "how did your talk go over?"'/>
<rdf:Description rdf:about="&a;200238368"
	 b:glossaryEntry='happen regularly; "Christmas rolled around again"'/>
<rdf:Description rdf:about="&a;200238500">
