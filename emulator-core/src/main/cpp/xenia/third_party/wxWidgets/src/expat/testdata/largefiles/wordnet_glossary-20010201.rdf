</rdf:Description>
<rdf:Description rdf:about="&a;108145530"
	 b:glossaryEntry="1 species: greasewood"/>
<rdf:Description rdf:about="&a;108145665">
	<b:glossaryEntry>low hardy much-branched spiny shrub common in alkaline soils of western America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108145865"
	 b:glossaryEntry="spinach"/>
<rdf:Description rdf:about="&a;108145982">
	<b:glossaryEntry>southwestern Asian plant widely cultivated for its succulent edible dark green leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108146220"
	 b:glossaryEntry="a family of flowering plants of the order Caryophyllales"/>
<rdf:Description rdf:about="&a;108146551">
	<b:glossaryEntry>a caryophyllaceous genus of the family Nyctaginaceae having only one species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108146741">
	<b:glossaryEntry>viscid branched perennial of the southwestern United States and northern Mexico having tuberous roots and deep red flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108146970"
	 b:glossaryEntry="genus of western North American herbs having showy flowers"/>
<rdf:Description rdf:about="&a;108147136">
	<b:glossaryEntry>any of various plants of the genus Abronia of western North America and Mexico having flowers resembling verbena</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108147434">
	<b:glossaryEntry>plant having heads of fragrant white trumpet-shaped flowers; grows in sandy arid regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108147618">
	<b:glossaryEntry>taller than Abronia_elliptica and having night-blooming flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108147765">
	<b:glossaryEntry>plant having hemispherical heads of yellow trumpet-shaped flowers; found in coastal dunes from California to British Columbia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108147976">
	<b:glossaryEntry>plant having hemispherical heads of wine-red flowers; found in coastal dunes from California to Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108148157">
	<b:glossaryEntry>prostrate herb having heads of deep pink to white flowers; found in coastal dunes from British Columbia to Baja California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108148384">
	<b:glossaryEntry>soft-haired sticky plant with heads of bright pink trumpet-shaped flowers; found in sandy desert soil; after ample rains may carpet miles of desert with pink from the southwestern United States to northern Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108148680"
	 b:glossaryEntry="small genus of chiefly American herbs"/>
<rdf:Description rdf:about="&a;108148827">
	<b:glossaryEntry>trailing plant having crowded clusters of 3 brilliant deep pink flowers resembling a single flower blooming near the ground; found in dry gravelly or sandy soil; southwestern United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108149155"
	 b:glossaryEntry="ornamental tropical woody vines"/>
<rdf:Description rdf:about="&a;108149330">
	<b:glossaryEntry>any of several South American ornamental woody vines of the genus Bougainvillea having brilliant red or purple flower bracts; widely grown in warm regions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108149581"
	 b:glossaryEntry="Brazilian vine that tends to flower continuously"/>
<rdf:Description rdf:about="&a;108149711"
	 b:glossaryEntry="four_o''clocks"/>
<rdf:Description rdf:about="&a;108149874"
	 b:glossaryEntry="a plant of the genus Mirabilis"/>
<rdf:Description rdf:about="&a;108149982">
	<b:glossaryEntry>any of several plants of the genus Mirabilis having flowers that open in late afternoon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108150237">
	<b:glossaryEntry>common garden plant of North America having fragrant red or purple or yellow or white flowers that open in late afternoon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108150481"
	 b:glossaryEntry="California four_o''clock with purple-red flowers"/>
<rdf:Description rdf:about="&a;108150660">
	<b:glossaryEntry>leafy wildflower having fragrant slender white or pale pink trumpet-shaped flowers; southwestern United States and northern Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108150890">
	<b:glossaryEntry>wildflower having vibrant deep pink tubular evening-blooming flowers; found in sandy and desert areas from southern California to southern Colorado and into Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108151178">
	<b:glossaryEntry>leafy wildflower with lavender-pink flowers that open in the evening and remain through cool part of the next day; found in open woods or brush in mountains of southern Colorado to Arizona and into Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108151475">
	<b:glossaryEntry>genus of often thorny tropical trees and shrubs and some vines; mainly America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108151661"
	 b:glossaryEntry="small spiny West Indian tree"/>
<rdf:Description rdf:about="&a;108151782"
	 b:glossaryEntry="coextensive with the family Cactaceae: cactuses"/>
<rdf:Description rdf:about="&a;108151943"
	 b:glossaryEntry="constituting the order Opuntiales"/>
<rdf:Description rdf:about="&a;108152618">
	<b:glossaryEntry>any spiny succulent plant of the family Cactaceae native chiefly to arid regions of the New World</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108153237">
	<b:glossaryEntry>mostly trailing cacti having nocturnal white flowers; tropical America and Caribbean region</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108153429">
	<b:glossaryEntry>cactus of the southwestern United States and northern Mexico having edible juicy fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108153661"
	 b:glossaryEntry="small genus of epiphytic cacti of Mexico"/>
<rdf:Description rdf:about="&a;108153817">
	<b:glossaryEntry>commonly cultivated tropical American cactus having slender creeping stems and very large showy crimson flowers that bloom for several days</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108154085">
	<b:glossaryEntry>slow-growing geophytic cacti; northern and eastern Mexico; southern Texas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108154272">
	<b:glossaryEntry>usually unbranched usually spineless cactus covered with warty tubercles and having magenta flowers and white or green fruit; resembles the related mescal; northeastern Mexico and southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108154579"
	 b:glossaryEntry="l species: saguaro"/>
<rdf:Description rdf:about="&a;108154709">
	<b:glossaryEntry>extremely large treelike cactus of desert regions of southwestern United States having a thick columnar sparsely branched trunk bearing white flowers and edible red pulpy fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108154989">
	<b:glossaryEntry>genus of much-branched treelike or shrubby cacti with pronounced ribs and rounded needlelike spines and nocturnal flowers usually white</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108155230"
	 b:glossaryEntry="any of several cacti of the genus Cereus"/>
<rdf:Description rdf:about="&a;108155357">
	<b:glossaryEntry>mainly globose cacti of southwestern United States and Mexico covered with many nodules; superficially resembling and formerly included in genus Mammilaria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108155614"
	 b:glossaryEntry="a cactus of the genus Coryphantha"/>
<rdf:Description rdf:about="&a;108155724">
	<b:glossaryEntry>globular or cylindrical cacti; southwestern United States to Brazil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108155894">
	<b:glossaryEntry>any cactus of the genus Echinocactus; strongly ribbed and very spiny; southwestern United States to Brazil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108156130"
	 b:glossaryEntry="cactus of the genus Echinocactus having stout sharp spines"/>
<rdf:Description rdf:about="&a;108156250">
	<b:glossaryEntry>large cactus of east central Mexico having golden to pale yellow flowers and spines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108156424">
	<b:glossaryEntry>large genus of low-growing shrubby ribbed cacti of Mexico and southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108156630"
	 b:glossaryEntry="cactus of the genus Echinocereus"/>
<rdf:Description rdf:about="&a;108156743">
	<b:glossaryEntry>small genus of tropical American (mainly Central America) cacti</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108156907">
	<b:glossaryEntry>any cactus of the genus Epiphyllum having flattened jointed irregularly branching stems and showy tubular flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108157112">
	<b:glossaryEntry>genus of nearly globular cacti of Mexico and southwestern United States: barrel cacti</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108157311">
	<b:glossaryEntry>a cactus of the genus Ferocactus: unbranched barrel-shaped cactus having deep ribs with numerous spines and usually large funnel-shaped flowers followed by dry fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108157556">
	<b:glossaryEntry>large genus of low-growing globular South American cacti with spiny ribs covered with many tubercles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108157757">
	<b:glossaryEntry>genus of slender often treelike spiny cacti with solitary showy nocturnal white or pink flowers; Florida and Caribbean to South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108157983"
	 b:glossaryEntry="small genus of South American epiphytic or lithophytic cacti"/>
<rdf:Description rdf:about="&a;108158151">
	<b:glossaryEntry>spring-blooming South American cactus with oblong joints and coral-red flowers; sometimes placed in genus Schlumbergera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108158395">
	<b:glossaryEntry>genus of climbing or epiphytic tropical American cacti with angular stems and mostly white very fragrant flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108158621"
	 b:glossaryEntry="any of several cacti of the genus Hylocereus"/>
<rdf:Description rdf:about="&a;108158752">
	<b:glossaryEntry>tropical American cacti usually tall and branching with stout spines and funnel-shaped flowers and globular or ovoid often edible fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108159009"
	 b:glossaryEntry="tall treelike Mexican cactus with edible red fruit"/>
<rdf:Description rdf:about="&a;108159159">
	<b:glossaryEntry>two species of small cacti of northeastern Mexico and southwestern United States having rounded stems covered with jointed tubercles: mescal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108159413">
	<b:glossaryEntry>a small spineless globe-shaped cactus; source of mescal buttons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108159609"
	 b:glossaryEntry="the button-shaped top of the mescal cactus"/>
<rdf:Description rdf:about="&a;108159767">
	<b:glossaryEntry>large genus of cacti characterized chiefly by nipple-shaped protuberances or tubercles on their surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108159972"
	 b:glossaryEntry="any cactus of the genus Mammilaria"/>
<rdf:Description rdf:about="&a;108160083">
	<b:glossaryEntry>a low tuberculate cactus with white feathery spines; northeastern Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108160236">
	<b:glossaryEntry>genus of strongly ribbed globose or spheroid cacti of tropical South and Central America and the Caribbean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108160437">
	<b:glossaryEntry>small genus of arborescent cacti of Mexico and Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108160621">
	<b:glossaryEntry>arborescent cactus of western Mexico bearing a small oblong edible berrylike fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108160848"
	 b:glossaryEntry="low-growing cacti of the American Great Plains"/>
<rdf:Description rdf:about="&a;108161010">
	<b:glossaryEntry>small clustering cactus of southwestern United States; a threatened species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108161193"
	 b:glossaryEntry="a genus of the cactus family with scarlet flowers"/>
<rdf:Description rdf:about="&a;108161350">
	<b:glossaryEntry>any of several cacti of the genus Nopalea resembling prickly pears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108161487"
	 b:glossaryEntry="large genus of cactuses native to America: prickly pears"/>
<rdf:Description rdf:about="&a;108161670">
	<b:glossaryEntry>cacti having spiny flat joints and oval fruit that is edible in some species; often used as food for stock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108161931">
	<b:glossaryEntry>arborescent cacti having very spiny cylindrical stem segments; southwestern United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108162120"
	 b:glossaryEntry="cactus having yellow flowers and purple fruits"/>
<rdf:Description rdf:about="&a;108162240"
	 b:glossaryEntry="tropical American flat-jointed prickly pear; Jamaica"/>
<rdf:Description rdf:about="&a;108162358">
	<b:glossaryEntry>genus of tropical American shrubby trees and woody climbers having slender branches with broad flat leaves and large panicles of flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108162634">
	<b:glossaryEntry>West Indian woody scrambler with spiny stems and numerous fragrant white flowers in panicles followed by small yellow to orange fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108162919">
	<b:glossaryEntry>large genus of epiphytic or lithophytic unarmed cacti with usually segmented stems and pendulous branches; flowers are small followed by berrylike fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108163184"
	 b:glossaryEntry="a plant of the genus Rhipsalis"/>
<rdf:Description rdf:about="&a;108163296"
	 b:glossaryEntry="South American epiphytic or lithophytic cacti"/>
<rdf:Description rdf:about="&a;108163461">
	<b:glossaryEntry>epiphytic cactus of Brazilian ancestry widely cultivated as a houseplant having jointed flat segments and usually rose-purple flowers that bloom in winter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108163749"
	 b:glossaryEntry="mostly epiphytic climbing cacti that bloom at night"/>
<rdf:Description rdf:about="&a;108163918">
	<b:glossaryEntry>any of several night-blooming cacti of the genus Selenicereus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108164084">
	<b:glossaryEntry>tropical American climbing cactus having triangular branches; often cultivated for its large showy night-blooming flowers followed by yellow red-streaked fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108164337">
	<b:glossaryEntry>small genus of Brazilian cacti having flat fleshy usually branched joints and showy red or pink flowers followed by red fleshy fruits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108164584">
	<b:glossaryEntry>South American jointed cactus with usually red flowers; often cultivated as a houseplant; sometimes classified as genus Schlumbergera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108164865">
	<b:glossaryEntry>chiefly tropical herbaceous plants (including shrubs and trees) with racemose flowers: genera Phytolacca; Agdestis; Ercilla; Rivina; Trichostigma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108165170"
	 b:glossaryEntry="type genus of Phytolaccaceae: pokeweed"/>
<rdf:Description rdf:about="&a;108165322"
	 b:glossaryEntry="perennial of the genus Phytolacca"/>
<rdf:Description rdf:about="&a;108165483"
	 b:glossaryEntry="pokeweed of southeastern Asia and China"/>
<rdf:Description rdf:about="&a;108165601">
	<b:glossaryEntry>tall coarse perennial American herb having small white flowers followed by blackish-red berries on long drooping racemes; young fleshy stems are edible; berries and root are poisonous</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108165890">
	<b:glossaryEntry>fast-growing herbaceous evergreen tree of South America having a broad trunk with high water content and dark green oval leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108166103">
	<b:glossaryEntry>small genus of erect perennial shrubby herbs; tropical and subtropical America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108166287">
	<b:glossaryEntry>bushy houseplant having white to pale pink flowers followed by racemes of scarlet berries; tropical Americas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108166529">
	<b:glossaryEntry>family of usually succulent herbs; cosmopolitan in distribution especially in Americas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108166868">
	<b:glossaryEntry>a plant of the family Portulacaceae having fleshy succulent obovate leaves often grown as a potherb or salad herb; a weed in some areas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108167076"
	 b:glossaryEntry="genus of mainly tropical fleshy or trailing herbs"/>
<rdf:Description rdf:about="&a;108167244">
	<b:glossaryEntry>a plant of the genus Portulaca having pink or red or purple or white ephemeral flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108167423">
	<b:glossaryEntry>widely cultivated in many varieties for its fleshy mosslike foliage and profusion of brightly colored flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108167624">
	<b:glossaryEntry>weedy trailing mat-forming herb with bright yellow flowers cultivated for its edible mildly acid leaves eaten raw or cooked especially in Indian and Greek and Middle Eastern cuisine; cosmopolitan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108167952">
	<b:glossaryEntry>large genus of low-growing herbs; widespread throughout tropical and warm temperate regions having usually basal leaves and panicles of purplish ephemeral flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108168249"
	 b:glossaryEntry="a plant of the genus Calandrinia"/>
<rdf:Description rdf:about="&a;108168360">
	<b:glossaryEntry>succulent carpet-forming plant having small brilliant reddish-pink flowers; southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108168570">
	<b:glossaryEntry>genus of mainly North American succulent herbs with white or pink flowers usually in terminal racemes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108168821">
	<b:glossaryEntry>similar to Claytonia virginica but having usually pink flowers; eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108169018">
	<b:glossaryEntry>small slender plant having 1 pair of succulent leaves at midstem and a loose raceme of white or pink or rose bowl-shaped flowers and an edible corm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108169266">
	<b:glossaryEntry>small cormous perennial grown for its low rosette of succulent foliage and racemes of pink-tinged white flowers; eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108169510">
	<b:glossaryEntry>genus of western North American low-growing herbs having linear woolly leaves and large pink flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108169737">
	<b:glossaryEntry>evergreen perennial having a dense basal rosette of long spatula-shaped leaves and panicles of pink or white-and-red-striped or pink-purple flowers; found on cliffs and in rock crevices in mountains of southwestern Oregon and northern California</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108170084">
	<b:glossaryEntry>showy succulent ground-hugging plant of Rocky Mountains regions having deep to pale pink flowers and fleshy farinaceous roots; the Montana state flower</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108170330">
	<b:glossaryEntry>small genus of densely tufted annual herbs; north temperate regions and South America and tropical Africa and Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108170550">
	<b:glossaryEntry>a plant of the genus Montia having edible pleasant-tasting leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108170767">
	<b:glossaryEntry>succulent plant with mostly basal leaves; stem bears 1 pair of broadly ovate or heart-shaped leaves and a loose raceme of 3-10 white flowers; western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108171016"
	 b:glossaryEntry="small Indian lettuce of northern regions"/>
<rdf:Description rdf:about="&a;108171170">
	<b:glossaryEntry>a floating or creeping Indian lettuce having terminal racemes of pale rose flowers; wet areas at high elevations of western North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108171382">
	<b:glossaryEntry>succulent herb sometimes grown as a salad or pot herb; grows on dunes and waste ground of Pacific coast of North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108171618">
	<b:glossaryEntry>small genus of usually perennial herbs having deep woody taproots and flower heads of umbels or cymes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108171829">
	<b:glossaryEntry>pink clusters of densely packed flowers on prostrate stems resemble upturned pads of cats'' feet; grow in coniferous forests of western North America; sometimes placed in genus Calyptridium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108172167"
	 b:glossaryEntry="genus of mainly American more-or-less succulent herbs"/>
<rdf:Description rdf:about="&a;108172404">
	<b:glossaryEntry>plant with fleshy roots and erect stems with narrow succulent leaves and 1 reddish-orange flower in each upper leaf axil; southwestern United States; Indians once cooked the fleshy roots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108172772">
	<b:glossaryEntry>similar to Talinum aurantiacum but with narrower leaves and yellow-orange flowers; southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108172997">
	<b:glossaryEntry>low plant with crowded narrow succulent leaves and fairly large deep pink axillary flowers that seem to sit on the ground; southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108173247">
	<b:glossaryEntry>pink-flowered perennial of rocky regions of western United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108173407">
	<b:glossaryEntry>erect plant with tuberous roots and terminal panicles of red to yellow flowers; southwestern North America to Central America; widely introduced elsewhere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108173644">
	<b:glossaryEntry>low cushion-forming plant with rose to crimson-magenta flowers and leaf midribs that persist as spines when the leaves die; southwestern United States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108173894"
	 b:glossaryEntry="an order of dicotyledonous plants"/>
<rdf:Description rdf:about="&a;108174132">
	<b:glossaryEntry>a dilleniid dicot family of the order Rhoeadales that includes: genera Capparis; Cleome; Crateva; Polanisia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108174413"
	 b:glossaryEntry="tropical or subtropical evergreen shrubs or small trees"/>
<rdf:Description rdf:about="&a;108174578"
	 b:glossaryEntry="any of numerous plants of the genus Capparis"/>
<rdf:Description rdf:about="&a;108174783"
	 b:glossaryEntry="small Australian tree bearing edible pomegranatelike fruit"/>
<rdf:Description rdf:about="&a;108174925"
	 b:glossaryEntry="shrub of southern Florida to West Indies"/>
<rdf:Description rdf:about="&a;108175070">
	<b:glossaryEntry>shrub or small tree of southern Florida to Central and South America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108175234"
	 b:glossaryEntry="small Australian tree bearing edible dark purple fruit"/>
<rdf:Description rdf:about="&a;108175370">
	<b:glossaryEntry>prostrate spiny shrub of the Mediterranean region cultivated for its greenish flower buds which are pickled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108175574">
	<b:glossaryEntry>tropical and subtropical annual or perennial herbs or low shrubs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108175735">
	<b:glossaryEntry>any of various often strong-smelling plants of the genus Cleome having showy spider-shaped flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108175956">
	<b:glossaryEntry>native to South America but naturalized in warm parts of United States; grown for its long-lasting spider-shaped white to pink-purple flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108176193">
	<b:glossaryEntry>plant of western North America having trifoliate leaves and white or pink spider-shaped flowers; sometimes used as an ornamental</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108176429">
	<b:glossaryEntry>widely distributed herbs having palmate leaves and creamy white to or pink to magenta flowers with many stamens of unequal length</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108176670">
	<b:glossaryEntry>strong-scented herb common in southern United States covered with intermixed gland and hairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108176884"
	 b:glossaryEntry="plants with four-petaled flowers"/>
<rdf:Description rdf:about="&a;108178016"
	 b:glossaryEntry="any of various plants of the family Cruciferae"/>
<rdf:Description rdf:about="&a;108178553">
	<b:glossaryEntry>any of various plants of the family Cruciferae having edible pungent-tasting leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108178847"
	 b:glossaryEntry="any of several water-loving cresses"/>
<rdf:Description rdf:about="&a;108179030"
	 b:glossaryEntry="Old World genus of the family Cruciferae"/>
<rdf:Description rdf:about="&a;108179184">
	<b:glossaryEntry>any Old World herb of the genus Aethionema; native of sunny limestone habitats</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108179352">
	<b:glossaryEntry>a genus of herbs of the family Cruciferae; have broad leaves and whit flowers and long siliques</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108179557"
	 b:glossaryEntry="European herb that smells like garlic"/>
<rdf:Description rdf:about="&a;108179746"
	 b:glossaryEntry="a genus of the family Cruciferae"/>
<rdf:Description rdf:about="&a;108179886">
	<b:glossaryEntry>any garden plant of the genus Alyssum having clusters of small yellow or white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108180055"
	 b:glossaryEntry="one species: rose of Jericho; resurrection plant"/>
<rdf:Description rdf:about="&a;108180198">
	<b:glossaryEntry>small gray Asiatic desert plant bearing minute white flowers that rolls up when dry and expands when moist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108180433">
	<b:glossaryEntry>annual to perennial woody herbs of temperate North America, Europe and Asia: rockcress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108180625"
	 b:glossaryEntry="any of several rock-loving cresses of the genus Arabis"/>
<rdf:Description rdf:about="&a;108180803"
	 b:glossaryEntry="North American rock cress having very long curved pods"/>
<rdf:Description rdf:about="&a;108180933">
	<b:glossaryEntry>European cress having stiff erect stems; sometimes placed in genus Turritis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108181099">
	<b:glossaryEntry>or genus Arabis: erect cress widely distributed throughout Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108181291"
	 b:glossaryEntry="horseradish"/>
<rdf:Description rdf:about="&a;108181414">
	<b:glossaryEntry>coarse Eurasian plant cultivated for its thick white pungent root</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108181623">
	<b:glossaryEntry>the root of the horseradish plant; it is grated or ground and used for seasoning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108181837">
	<b:glossaryEntry>biennial or perennial herbs of north temperate regions: winter cress</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108182053">
	<b:glossaryEntry>any plant of the genus Barbarea: yellow-flowered Eurasian cresses; widely cultivated for winter salad</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108182286"
	 b:glossaryEntry="of southwestern Europe; cultivated in Florida"/>
<rdf:Description rdf:about="&a;108182522">
	<b:glossaryEntry>noxious cress with yellow flowers; sometimes placed in genus Sisymbrium</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108182741"
	 b:glossaryEntry="hoary alyssum"/>
<rdf:Description rdf:about="&a;108182864">
	<b:glossaryEntry>tall European annual with downy gray-green foliage and dense heads of small white flowers followed by hairy pods; naturalized in North America; sometimes a troublesome weed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108183148"
	 b:glossaryEntry="genus of Eurasian herbs and small shrubs: buckler mustard"/>
<rdf:Description rdf:about="&a;108183319">
	<b:glossaryEntry>plant of southeastern Europe having yellow flowers like those of mustard and pods with open valves resembling bucklers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108183541"
	 b:glossaryEntry="mustards: cabbages; cauliflowers; turnips; etc."/>
<rdf:Description rdf:about="&a;108183736">
	<b:glossaryEntry>wild original of cultivated cabbages; common in western coastal Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108183904">
	<b:glossaryEntry>any of various cultivars of the genus Brassica oleracea grown for their edible leaves or flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108184151">
