	 b:glossaryEntry="hyraxes and some extinct animals"/>
<rdf:Description rdf:about="&a;101873378"
	 b:glossaryEntry="includes all recent members of the order Hyracoidea"/>
<rdf:Description rdf:about="&a;101873565">
	<b:glossaryEntry>any of several small ungulate mammals of Africa and Asia with rodent-like incisors and feet with hooflike toes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101873794"
	 b:glossaryEntry="type genus of the Procaviidae"/>
<rdf:Description rdf:about="&a;101873933"
	 b:glossaryEntry="hyrax that lives in rocky areas"/>
<rdf:Description rdf:about="&a;101874074">
	<b:glossaryEntry>nonruminant ungulates: horses; tapirs; rhinoceros; extinct forms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101874317">
