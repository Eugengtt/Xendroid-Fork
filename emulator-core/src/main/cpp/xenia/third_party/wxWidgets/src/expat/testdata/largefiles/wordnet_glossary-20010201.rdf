</rdf:Description>
<rdf:Description rdf:about="&a;200760408"
	 b:glossaryEntry='assail again; "Her old fears reassailed her"'/>
<rdf:Description rdf:about="&a;200760534">
	<b:glossaryEntry>make a sudden physical attack on; "The muggers jumped the woman in the fur coat"</b:glossaryEntry>
