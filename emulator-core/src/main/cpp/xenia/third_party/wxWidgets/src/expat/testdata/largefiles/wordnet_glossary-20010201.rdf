<rdf:Description rdf:about="&a;201351846"
	 b:glossaryEntry="undergo a change in bodily posture"/>
<rdf:Description rdf:about="&a;201352194">
	<b:glossaryEntry>drop oneself to a lower or less erect position; "She fell back in her chair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201352350">
	<b:glossaryEntry>lose an upright position suddenly; "The vase fell over and the water spilled onto the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201352522">
	<b:glossaryEntry>regain an upright or proper position; "The capsized boat righted again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201352682">
	<b:glossaryEntry>put in or restore to an upright position; "They righted the sailboat that had capsized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201352850"
	 b:glossaryEntry="take a seat"/>
<rdf:Description rdf:about="&a;201352959">
	<b:glossaryEntry>assume a reclining position; "lie down on the bed until you feel better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201353183">
	<b:glossaryEntry>lie down comfortably; "To enjoy the picnic, we stretched out on the grass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201353337"
	 b:glossaryEntry="lie down on command, of hunting dogs"/>
<rdf:Description rdf:about="&a;201353437">
	<b:glossaryEntry>droop, sink, or settle from or as if from pressure or loss of tautness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201353634">
	<b:glossaryEntry>cause to sag; "The children sagged their bottoms down even more comfortably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201353782">
	<b:glossaryEntry>fall or drop to a lower place or level; "He sank to his knees."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201354006"
	 b:glossaryEntry="sink or fall"/>
<rdf:Description rdf:about="&a;201354092"
	 b:glossaryEntry="cause to settle, as of liquids"/>
<rdf:Description rdf:about="&a;201354194">
	<b:glossaryEntry>cause to sink; "The Japanese sank American ships in Pearl Harbour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201354366"
	 b:glossaryEntry="come to rest"/>
<rdf:Description rdf:about="&a;201354457"
	 b:glossaryEntry="cause to be in an appropriate place, state, or relation"/>
<rdf:Description rdf:about="&a;201354700"
	 b:glossaryEntry='position so as to be square: "He squared his shoulders"'/>
<rdf:Description rdf:about="&a;201354837"
	 b:glossaryEntry="even up the edges of a stack of paper, in printing"/>
<rdf:Description rdf:about="&a;201354970"
	 b:glossaryEntry="place in glycerol; in chemistry"/>
<rdf:Description rdf:about="&a;201355088"
	 b:glossaryEntry="remove from glycerol; in chemistry"/>
<rdf:Description rdf:about="&a;201355211">
	<b:glossaryEntry>place at intervals; "Space the interviews so that you have some time between the different candidates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201355384"
	 b:glossaryEntry="place in proper rank; of military troops"/>
<rdf:Description rdf:about="&a;201355497"
	 b:glossaryEntry="settle into a position"/>
<rdf:Description rdf:about="&a;201355605">
	<b:glossaryEntry>fall or sink heavily; "He slumped onto the couch"; "My spirits sank"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201355772">
	<b:glossaryEntry>break down, literally or metaphorically; "The wall collapsed"; "The business collapsed"; "The dam broke"; "The roof collapsed"; "The wall gave in"; "The roof finally gave under the weight of the ice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201356227"
	 b:glossaryEntry='cause to burst; "The ice broke the pipe"'/>
<rdf:Description rdf:about="&a;201356367"
	 b:glossaryEntry="assume a drooping posture or carriage"/>
<rdf:Description rdf:about="&a;201356484"
	 b:glossaryEntry='go_under, "The raft sank and its occupants drowned"'/>
<rdf:Description rdf:about="&a;201356725"
	 b:glossaryEntry="sink below the surface"/>
<rdf:Description rdf:about="&a;201356820"
	 b:glossaryEntry="come to the surface"/>
<rdf:Description rdf:about="&a;201357011">
	<b:glossaryEntry>come up to the surface of or rise, as from water; also used metaphorically: "He felt new emotions emerge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201357188"
	 b:glossaryEntry="reappear on the surface"/>
<rdf:Description rdf:about="&a;201357286"
	 b:glossaryEntry='move upwards in bubbles; "Gases bubbled up from the earth"'/>
<rdf:Description rdf:about="&a;201357411"
	 b:glossaryEntry='come up, as of liquids: "Tears well in her eyes"'/>
<rdf:Description rdf:about="&a;201357529">
	<b:glossaryEntry>emerge from the surface, as of fish in water; "The whales broke"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201357656"
	 b:glossaryEntry="sink below the surface; go under water"/>
<rdf:Description rdf:about="&a;201357794">
	<b:glossaryEntry>travel along a zigzag path: "The river zigzags through the countryside"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201357963">
	<b:glossaryEntry>travel along a certain course: "follow the road"; "follow the trail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201358128"
	 b:glossaryEntry="follow at the heels of a person"/>
<rdf:Description rdf:about="&a;201358229"
	 b:glossaryEntry="move up and down as if on a seesaw"/>
<rdf:Description rdf:about="&a;201358335"
	 b:glossaryEntry="ride on a plank"/>
<rdf:Description rdf:about="&a;201358414">
	<b:glossaryEntry>move forward, also in the metaphorical sense: "Time marches on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201358798"
	 b:glossaryEntry='advance stealthily or unnoticed: "Age creeps up on you"'/>
<rdf:Description rdf:about="&a;201358938"
	 b:glossaryEntry="advance beyond the usual limit"/>
<rdf:Description rdf:about="&a;201359081">
	<b:glossaryEntry>trespass or encroach; infringe; "This in entrenching on other domains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201359226"
	 b:glossaryEntry="continue moving forward"/>
<rdf:Description rdf:about="&a;201359345">
	<b:glossaryEntry>push forcibly, as of brakes: "The driver jammed the brake pedal to the floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201359491"
	 b:glossaryEntry="move or come along"/>
<rdf:Description rdf:about="&a;201359612"
	 b:glossaryEntry='cause to move forward; "Can you move the car seat forward?"'/>
<rdf:Description rdf:about="&a;201359796">
	<b:glossaryEntry>advance the forward part of with caution: "She nosed the car into the left lane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201359938"
	 b:glossaryEntry="move forward; of clocks and watches"/>
<rdf:Description rdf:about="&a;201360050">
	<b:glossaryEntry>pull back or move away or backward; "The enemy withdrew"; "The limo pulled away from the curb"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201360346"
	 b:glossaryEntry='move back; "The glacier retrogrades"'/>
<rdf:Description rdf:about="&a;201360460">
	<b:glossaryEntry>move in a direction contrary to the usual one; of stars and planets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201360595"
	 b:glossaryEntry="move backward in an orbit, of celestial bodies"/>
<rdf:Description rdf:about="&a;201360709">
	<b:glossaryEntry>bring, take, or pull out of a container or from under a cover; "draw a weapon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201360914">
	<b:glossaryEntry>move ahead; travel onward; "We proceeded towards Washington"; "She continued in the direction of the hills"; can also be used in the temporal sense: "We are moving ahead in time now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201361265">
	<b:glossaryEntry>act or proceed in a riotous, turbulent, or disorderly way: "desperadoes from the hills regularly roared in to take over the town"-R.A.Billington</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201361481">
	<b:glossaryEntry>proceed slowly or with difficulty; "the boat limped into the harbor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201361635">
	<b:glossaryEntry xml:space='preserve'><![CDATA[push one''s way; "she barged into the meeting room"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201361796"
	 b:glossaryEntry='march in a procession; "They processed into the dining room"'/>
<rdf:Description rdf:about="&a;201362009"
	 b:glossaryEntry="march back along the same way"/>
<rdf:Description rdf:about="&a;201362108">
	<b:glossaryEntry>travel backward; "back into the driveway"; "The car backed up and hit the tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201362365">
	<b:glossaryEntry>move out of a space backwards; "He backed out of the driveway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201362501">
	<b:glossaryEntry>cause to travel backward; "back the car into the parking spot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201362669">
	<b:glossaryEntry>move backwards from a certain position; "The bully had to back down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201362833">
	<b:glossaryEntry>hang (back) or fall (behind) in movement, progress, development, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201363024"
	 b:glossaryEntry="follow at a dangerously close distance; of vehicles"/>
<rdf:Description rdf:about="&a;201363149">
	<b:glossaryEntry>make a sweeping movement; "The camera panned across the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201363279">
	<b:glossaryEntry>to travel behind, go after, come after; "The ducklings followed their mother around the pond"; "Please follow the guide through the museum"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201363605">
	<b:glossaryEntry>reach a the point where one should be after a delay; "I caught up on my homework"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201363796"
	 b:glossaryEntry="even the score, in sports"/>
<rdf:Description rdf:about="&a;201363896"
	 b:glossaryEntry='reach the highest point of; "We scaled the Mont Blanc"'/>
<rdf:Description rdf:about="&a;201364032"
	 b:glossaryEntry='reach the summit: "They breasted the mountain"'/>
<rdf:Description rdf:about="&a;201364150"
	 b:glossaryEntry="move ahead (of others) in time or space"/>
<rdf:Description rdf:about="&a;201364337">
	<b:glossaryEntry>travel in front of; go in advance of others: "The procession was headed by John"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201364494">
	<b:glossaryEntry>take somebody somewhere; "We lead him to our chief"; "can you take me to the main entrance?"; "He conducted us to the palace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201364775"
	 b:glossaryEntry="lead someone in the wrong direction"/>
<rdf:Description rdf:about="&a;201364900">
	<b:glossaryEntry>show (someone) to their seats, as in theaters or auditoriums; "The usher showed us to our seats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201365093"
	 b:glossaryEntry="lead ceremoniously, as in a procession"/>
<rdf:Description rdf:about="&a;201365204">
	<b:glossaryEntry>follow in or as if in pursuit; "The police car pursued the suspected attacker"; "Her bad deed followed her and haunted her dreams all her life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201365498">
	<b:glossaryEntry xml:space='preserve'><![CDATA[follow, usually without the person''s knowledge; "The police are shadowing her"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201365664">
	<b:glossaryEntry>pursue a line of scent or be a bearer, as of a dog; "fetch and carry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201365796"
	 b:glossaryEntry="go after with the intent to catch"/>
<rdf:Description rdf:about="&a;201366058">
	<b:glossaryEntry>drive out or away by or as if by fire; "The soldiers were fired"; "Surrender fires the cold skepticism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201366239">
	<b:glossaryEntry>search the trail of, as of game: "The dog went of and quested"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201366372">
	<b:glossaryEntry xml:space='preserve'><![CDATA[force to go away; used both with concrete and metaphoric meanings; "Drive away potential burglars''; "drive away bad thoughts"; "dispel doubts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201366738"
	 b:glossaryEntry='drive away: "banish bad thoughts"; "banish gloom"'/>
<rdf:Description rdf:about="&a;201366859"
	 b:glossaryEntry='drive away by crying "shoo!"'/>
<rdf:Description rdf:about="&a;201366980"
	 b:glossaryEntry="pursue or chase relentlessly"/>
<rdf:Description rdf:about="&a;201367094"
	 b:glossaryEntry="recur constantly and spontaneously to"/>
<rdf:Description rdf:about="&a;201367202"
	 b:glossaryEntry='pursue until captured: "They ran down the fugitive"'/>
<rdf:Description rdf:about="&a;201367327">
	<b:glossaryEntry>to go back over again, as of a route or steps: we retraced the route we took last summer.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201367489"
	 b:glossaryEntry="retrace one''s course"/>
<rdf:Description rdf:about="&a;201367610"
	 b:glossaryEntry="return in time; of films or stories"/>
<rdf:Description rdf:about="&a;201367732">
	<b:glossaryEntry>come back to place where one has been before, or return to a previous activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201368085">
	<b:glossaryEntry>return home accurately from a long distance, as of some birds; "homing pigeons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201368235"
	 b:glossaryEntry='return home; "After the movie, we went home"'/>
<rdf:Description rdf:about="&a;201368356">
	<b:glossaryEntry>return to a previous position; in mathematics: "The point returned to the interior of the figure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201368517">
	<b:glossaryEntry>return to the initial position from where it came; like a boomerang</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201368651">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reach a destination; arrive by movement or by making progress; "She arrived home at 7 o''clock"; "He got into college"; "She didn''t get to Chicago until after midnight"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201369099"
	 b:glossaryEntry='reach and board; "She got the bus just as it was leaving"'/>
<rdf:Description rdf:about="&a;201369235">
	<b:glossaryEntry>be received, as of news on the radio or television; "News came in of the massacre in Rwanda"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201369399">
	<b:glossaryEntry>reach a point in time, or a certain state or level; "The thermometer hit 100 degrees"; "This car can reach a speed of 140 miles per hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201369640">
	<b:glossaryEntry>attain a level at which there is neither gain nor loss, as in business, gambling, or a competitive sport</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201369821"
	 b:glossaryEntry="reach or gain access to"/>
<rdf:Description rdf:about="&a;201369917"
	 b:glossaryEntry="arrive in great numbers"/>
<rdf:Description rdf:about="&a;201370014">
	<b:glossaryEntry>to reach the highest point; attain maximum intensity, activity: "That wild, speculative spirit peaked in 1929."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201370246"
	 b:glossaryEntry='reach a high point; "The river crested last night"'/>
<rdf:Description rdf:about="&a;201370367"
	 b:glossaryEntry="reach the low point"/>
<rdf:Description rdf:about="&a;201370454"
	 b:glossaryEntry="go away or leave"/>
<rdf:Description rdf:about="&a;201370678"
	 b:glossaryEntry="leave, usually as an expression of disapproval"/>
<rdf:Description rdf:about="&a;201370793">
	<b:glossaryEntry>depart after obtaining formal permission: "He has congeed with the King"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201370937"
	 b:glossaryEntry="leave quickly"/>
<rdf:Description rdf:about="&a;201371015">
	<b:glossaryEntry>remain behind; "I had to stay at home and watch the children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201371162"
	 b:glossaryEntry="depart hastily"/>
<rdf:Description rdf:about="&a;201371248">
	<b:glossaryEntry xml:space='preserve'><![CDATA[go away from a place; "At what time does your train leave?" "She didn''t leave until midnight"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201371791">
	<b:glossaryEntry>leave abruptly, often in protest or anger: "The customer that was not served walked out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201371945"
	 b:glossaryEntry='leave in a certain condition; "She came away angry"'/>
<rdf:Description rdf:about="&a;201372072"
	 b:glossaryEntry='leave (very informal usage); "skip town"'/>
<rdf:Description rdf:about="&a;201372201">
	<b:glossaryEntry>leave immediately; used usually in the imperative form; "Scram!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201372366">
	<b:glossaryEntry>leave suddenly and as if in a hurry; "The listeners bolted when he discussed his strange ideas"; "When she started to tell silly stories, I ran out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201372615"
	 b:glossaryEntry="ride away on a horse, for example"/>
<rdf:Description rdf:about="&a;201372750"
	 b:glossaryEntry="take the field, as a soldier"/>
<rdf:Description rdf:about="&a;201372850"
	 b:glossaryEntry="leave slowly and hesitantly"/>
<rdf:Description rdf:about="&a;201372965"
	 b:glossaryEntry="of trains"/>
<rdf:Description rdf:about="&a;201373065"
	 b:glossaryEntry="cause to run off the tracks; of trains"/>
<rdf:Description rdf:about="&a;201373175"
	 b:glossaryEntry="transfer to another track, of trains"/>
<rdf:Description rdf:about="&a;201373274">
	<b:glossaryEntry>move around; "transfer the packet from his trouser pockets to a pocket in his jacket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201373583">
	<b:glossaryEntry>transfer from one place to another: "transfer a number" (as in an addition)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201373722">
	<b:glossaryEntry>move about, move back and forth; "He shuffled his funds among different accounts in various countries so as to avoid the IRS"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201373912">
	<b:glossaryEntry>transfer for further transportation from one ship or conveyance to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201374053"
	 b:glossaryEntry="transfer cargo form a ship to a warehouse"/>
<rdf:Description rdf:about="&a;201374158">
	<b:glossaryEntry>transfer from one time period to the next, as in accounting, for example</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201374314"
	 b:glossaryEntry='force to move; "the refugees were displaced by the war"'/>
<rdf:Description rdf:about="&a;201374509">
	<b:glossaryEntry>press, force, or thrust out of a small space; "The weeds crowded out the flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201374681"
	 b:glossaryEntry="take the place of"/>
<rdf:Description rdf:about="&a;201374772"
	 b:glossaryEntry="move people from their homes or country"/>
<rdf:Description rdf:about="&a;201374895"
	 b:glossaryEntry='leave; "The family took off for Florida"'/>
<rdf:Description rdf:about="&a;201375175">
	<b:glossaryEntry>take off from the ground, as of an aircraft or balloon; "The plane departed two hours late"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201375351"
	 b:glossaryEntry='leave; "The car roared off into the fog"'/>
<rdf:Description rdf:about="&a;201375481">
	<b:glossaryEntry>move rapidly and as if blazing; "The spaceship blazed out into space"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201375649"
	 b:glossaryEntry="set out in a sudden, energetic or violent manner"/>
<rdf:Description rdf:about="&a;201375786">
	<b:glossaryEntry>move out or away; "The troops pulled out after the cease-fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201375966"
	 b:glossaryEntry="move into (a station) of trains"/>
<rdf:Description rdf:about="&a;201376117"
	 b:glossaryEntry="move out of; as of a room, a country, a bus, etc."/>
<rdf:Description rdf:about="&a;201376459"
	 b:glossaryEntry="leave a vehicle, aircraft, etc."/>
<rdf:Description rdf:about="&a;201376617"
	 b:glossaryEntry="leave a train"/>
<rdf:Description rdf:about="&a;201376695"
	 b:glossaryEntry="get off an airplane"/>
<rdf:Description rdf:about="&a;201376779"
	 b:glossaryEntry="go outside a room or building for a short period of time"/>
<rdf:Description rdf:about="&a;201376901">
	<b:glossaryEntry>to come or go into: "the ship entered an area of shallow marshes.."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201377385"
	 b:glossaryEntry="enter a harbor, as of a ship"/>
<rdf:Description rdf:about="&a;201377487">
	<b:glossaryEntry>arrive suddenly and unannounced; "He plumped in on a Sunday morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201377621"
	 b:glossaryEntry='depart suddenly; "He plumped out of the house"'/>
<rdf:Description rdf:about="&a;201377734"
	 b:glossaryEntry="enter the water; of waterfowl"/>
<rdf:Description rdf:about="&a;201377831"
	 b:glossaryEntry="make an entrance by turning from a road"/>
<rdf:Description rdf:about="&a;201377959"
	 b:glossaryEntry="push one''s way into (a space)"/>
<rdf:Description rdf:about="&a;201378071"
	 b:glossaryEntry="get on board of (trains, buses, ships, aircraft, etc.)"/>
<rdf:Description rdf:about="&a;201378269"
	 b:glossaryEntry="board a plane"/>
<rdf:Description rdf:about="&a;201378357">
	<b:glossaryEntry xml:space='preserve'><![CDATA[reach in time; "I have to catch a train at 7 o''clock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201378509"
	 b:glossaryEntry='enter uninvited; "They intruded on our dinner party"'/>
<rdf:Description rdf:about="&a;201378733">
	<b:glossaryEntry xml:space='preserve'><![CDATA[intrude or enter uninvited: "Don''t bother the professor while she is grading term papers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201378886">
	<b:glossaryEntry xml:space='preserve'><![CDATA[enter uninvited; informal: "let''s crash the party!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201379032"
	 b:glossaryEntry="make intrusive advances towards"/>
<rdf:Description rdf:about="&a;201379139"
	 b:glossaryEntry="move violently; as through a barrier"/>
<rdf:Description rdf:about="&a;201379254">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make one''s way by force: "He muscled his way into the office"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201379379"
	 b:glossaryEntry="pass beyond; of limits and boundaries"/>
<rdf:Description rdf:about="&a;201379506">
	<b:glossaryEntry>to intrude upon, infringe, encroach on, violate : "This does not allow the mystery to invade us."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201379729"
	 b:glossaryEntry="enter someone else''s territory"/>
<rdf:Description rdf:about="&a;201379834"
	 b:glossaryEntry="invade in great numbers, as of pests"/>
<rdf:Description rdf:about="&a;201379952">
	<b:glossaryEntry>reach a destination, either real or abstract; "We hit Detroit by noon"; "The water reached the doorstep"; "We barely made the plane"; "I have to hit the MAC machine before the weekend starts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201380463"
	 b:glossaryEntry='reach in time; "We barely made the plane"'/>
<rdf:Description rdf:about="&a;201380584"
	 b:glossaryEntry='succeed in reaching; arrive at; "The arrrow found its mark"'/>
<rdf:Description rdf:about="&a;201380705">
	<b:glossaryEntry>of a celestial body: reach its highest altitude or the meridian</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201380835">
	<b:glossaryEntry>succeed in reaching a real or abstract destination after overcoming problems; "We finally got through the bureaucracy and could talk to the Minister"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201381076">
	<b:glossaryEntry>reach a goal, e.g., "make the first team"; "We made it!" "She may not make the grade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201381254"
	 b:glossaryEntry="hit or reach the ground"/>
<rdf:Description rdf:about="&a;201381363"
	 b:glossaryEntry="bring to the ground, as of vessels"/>
<rdf:Description rdf:about="&a;201381493"
	 b:glossaryEntry='fail to reach or get to: "She missed her train"'/>
<rdf:Description rdf:about="&a;201381620"
	 b:glossaryEntry='get or come together; "the two lines meet here"'/>
<rdf:Description rdf:about="&a;201381781">
	<b:glossaryEntry>meet by design; be present at the arrival of; "Can you meet me at the train station?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201381955"
	 b:glossaryEntry='meet with by appointment; "She met up with her former lover"'/>
<rdf:Description rdf:about="&a;201382085">
	<b:glossaryEntry xml:space='preserve'><![CDATA[meet; "I''ll probably see you at the meeting"; "How nice to see you again!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201382318"
	 b:glossaryEntry="meet at a point"/>
<rdf:Description rdf:about="&a;201382450"
	 b:glossaryEntry="move together"/>
<rdf:Description rdf:about="&a;201382612"
	 b:glossaryEntry="gather in, or as if in, a fort, as for protection or defense"/>
<rdf:Description rdf:about="&a;201382752">
	<b:glossaryEntry>join together into a mass; collect or form a mass; of crowds of people; "Crowds were massing outside the palace"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201382952"
	 b:glossaryEntry='crowd closely; "The crowds pressed along the street"'/>
<rdf:Description rdf:about="&a;201383076"
	 b:glossaryEntry='meet formally; "The council convened last week"'/>
<rdf:Description rdf:about="&a;201383248">
	<b:glossaryEntry>meet again; "The bill will be considered when the Legislature reconvenes next Fall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201383406"
	 b:glossaryEntry="be in session, as of courts of law, for example"/>
<rdf:Description rdf:about="&a;201383522">
	<b:glossaryEntry>come together as in a cluster or flock; "The poets constellate in this town every summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201383758">
	<b:glossaryEntry>move as a crowd or in a group; "Tourists flocked to the schrine where the statue was said to have shed tears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201383938">
	<b:glossaryEntry>go or travel along with; "The nurse accompanied the old lady everywhere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201384199"
	 b:glossaryEntry="accompany as an escort"/>
<rdf:Description rdf:about="&a;201384391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[accompany or escort: "I''ll see you to the door"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201384508"
	 b:glossaryEntry="attend upon as a squire; serve as a squire"/>
<rdf:Description rdf:about="&a;201384614"
	 b:glossaryEntry="escort safely"/>
<rdf:Description rdf:about="&a;201384702"
	 b:glossaryEntry="escort in transit"/>
<rdf:Description rdf:about="&a;201384809"
	 b:glossaryEntry="accompany as a chaperone"/>
<rdf:Description rdf:about="&a;201384929"
	 b:glossaryEntry="protect from physical harm"/>
<rdf:Description rdf:about="&a;201385041"
	 b:glossaryEntry="go along with"/>
<rdf:Description rdf:about="&a;201385129"
	 b:glossaryEntry="crowd or draw together"/>
<rdf:Description rdf:about="&a;201385241">
	<b:glossaryEntry>form into a bunch; "The frighened children bunched together in the corner of the classroom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201385423">
	<b:glossaryEntry>to gather together in large numbers: "men in straw boaters and waxed mustaches crowded the verandah."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201385718"
	 b:glossaryEntry="crowd together too much"/>
<rdf:Description rdf:about="&a;201385808">
	<b:glossaryEntry>fill to capacity with people; "The air raids had surcharged the emergency wards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201385955">
	<b:glossaryEntry>cause to crowd together too much; "The students overcrowded the cafeteria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201386122">
	<b:glossaryEntry>move in large numbers; "people were pouring out of the theater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201386282"
	 b:glossaryEntry="move together, like a herd"/>
<rdf:Description rdf:about="&a;201386370"
	 b:glossaryEntry="cause to herd, drive, or crowd together"/>
<rdf:Description rdf:about="&a;201386521">
	<b:glossaryEntry>move away from each other; "The crowds dispersed"; "The children scattered in all directions when the teacher approached";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201386789"
	 b:glossaryEntry='scatter or part; "The clouds broke after the heavy downpour"'/>
<rdf:Description rdf:about="&a;201386912"
	 b:glossaryEntry="be dispersed in a volley"/>
<rdf:Description rdf:about="&a;201387008"
	 b:glossaryEntry="come apart"/>
<rdf:Description rdf:about="&a;201387110"
	 b:glossaryEntry="undergo diffraction; of light"/>
<rdf:Description rdf:about="&a;201387205"
	 b:glossaryEntry="stop functioning, as of organizations or groups"/>
<rdf:Description rdf:about="&a;201387336">
	<b:glossaryEntry xml:space='preserve'><![CDATA[go one''s own away; move apart; "The friends separated after the party"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201387549"
	 b:glossaryEntry="separate with a rope"/>
<rdf:Description rdf:about="&a;201387651">
	<b:glossaryEntry>to cause to separate and go in different directions, of crowds, for example; "She waved her hand and scattered the crows."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201387907">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make a rupture in the ranks of the enemy or one''s own by quitting or fleeing (military usage); "The ranks broke"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201388108">
	<b:glossaryEntry>cause to break up or function, as of groups and organizations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201388242"
	 b:glossaryEntry="make a division or separation"/>
<rdf:Description rdf:about="&a;201388460">
	<b:glossaryEntry>military use: separate (a small unit) from a larger, esp. for a special assignment; "detach a regiment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201388635"
	 b:glossaryEntry="isolate or separate"/>
<rdf:Description rdf:about="&a;201388782"
	 b:glossaryEntry="separate by means of a curtain"/>
<rdf:Description rdf:about="&a;201388889"
	 b:glossaryEntry="separate by avulsion"/>
<rdf:Description rdf:about="&a;201388981">
	<b:glossaryEntry>go, come, or spread in a rambling or irregular way; "Branches straggling out quite far"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201389151"
	 b:glossaryEntry='move or draw apart; "The two paths diverge here"'/>
<rdf:Description rdf:about="&a;201389316">
	<b:glossaryEntry>move or draw together at a certain location; "The crowd converged on the movie star"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201389526">
	<b:glossaryEntry>draw together or meet in one common center; "These groups concentrate in the inner cities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201389693"
	 b:glossaryEntry="change direction"/>
<rdf:Description rdf:about="&a;201389779">
	<b:glossaryEntry>turn sharply; change direction abruptly; "The car cut to the left at the intersection"; "The motorbike veered to the right"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201390061"
	 b:glossaryEntry="to leave a formation; of airplanes"/>
<rdf:Description rdf:about="&a;201390161"
	 b:glossaryEntry="turn aside"/>
<rdf:Description rdf:about="&a;201390254"
	 b:glossaryEntry="become deflected"/>
<rdf:Description rdf:about="&a;201390339"
	 b:glossaryEntry="turn from a straight course or fixed direction"/>
<rdf:Description rdf:about="&a;201390477">
	<b:glossaryEntry>turn away or aside; "They averted their eyes when the King entered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201390619"
	 b:glossaryEntry="bend or cause to bend"/>
<rdf:Description rdf:about="&a;201390737"
	 b:glossaryEntry="curve or bend (something) back or down"/>
<rdf:Description rdf:about="&a;201390840"
	 b:glossaryEntry="form an arch"/>
<rdf:Description rdf:about="&a;201390954"
	 b:glossaryEntry='form an arch over: "Big rocks overarch the stream"'/>
<rdf:Description rdf:about="&a;201391064"
	 b:glossaryEntry="curve upward in the middle"/>
<rdf:Description rdf:about="&a;201391162"
	 b:glossaryEntry="arch one''s back"/>
<rdf:Description rdf:about="&a;201391294"
	 b:glossaryEntry="straighten up or out; make straight"/>
<rdf:Description rdf:about="&a;201391432"
	 b:glossaryEntry="form a curve"/>
<rdf:Description rdf:about="&a;201391681"
	 b:glossaryEntry="dress ranks; of troops"/>
<rdf:Description rdf:about="&a;201391776"
	 b:glossaryEntry="form a queue, form a line, stand in line"/>
<rdf:Description rdf:about="&a;201391918"
	 b:glossaryEntry="dress ranks; of troops"/>
<rdf:Description rdf:about="&a;201392011"
	 b:glossaryEntry='contract; "flex a muscle"'/>
<rdf:Description rdf:about="&a;201392106"
	 b:glossaryEntry='be at an angle; "The terrain sloped down"'/>
<rdf:Description rdf:about="&a;201392290">
	<b:glossaryEntry>slope downward; "The hills around here fall towards the ocean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201392422">
	<b:glossaryEntry>slope upward: "The path climbed all the way to the top of the hill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201392560"
	 b:glossaryEntry='slope downwards; "Our property dips towards the river"'/>
<rdf:Description rdf:about="&a;201392675"
	 b:glossaryEntry="cause to slope"/>
<rdf:Description rdf:about="&a;201392754">
	<b:glossaryEntry>to incline or bend from a vertical position: "She leaned over the banister."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201393063"
	 b:glossaryEntry="move the upper body backwards and down"/>
<rdf:Description rdf:about="&a;201393204"
	 b:glossaryEntry="fall backwards and down"/>
<rdf:Description rdf:about="&a;201393302"
	 b:glossaryEntry="tip laterally; of boats and aircraft"/>
<rdf:Description rdf:about="&a;201393400"
	 b:glossaryEntry="cause to tip or tilt"/>
<rdf:Description rdf:about="&a;201393499"
	 b:glossaryEntry='sink; "The sun dipped below the horizon"'/>
<rdf:Description rdf:about="&a;201393615"
	 b:glossaryEntry="go down"/>
<rdf:Description rdf:about="&a;201393713"
	 b:glossaryEntry="stir up (water) so as to form ripples"/>
<rdf:Description rdf:about="&a;201393878">
	<b:glossaryEntry>bend the head or the upper part of the body in a gesture of respect or greeting; "He bowed before the King"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201394136"
	 b:glossaryEntry="a gesture of respectful greeting, for women"/>
<rdf:Description rdf:about="&a;201394253"
	 b:glossaryEntry="bow in a servile manner"/>
<rdf:Description rdf:about="&a;201394369"
	 b:glossaryEntry="bow in church or before a religious superior or image"/>
<rdf:Description rdf:about="&a;201394489"
	 b:glossaryEntry='lower briefly; "She dipped her knee"'/>
<rdf:Description rdf:about="&a;201394586">
	<b:glossaryEntry>rise and move, as in waves or billows; "The army surged forward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201394730"
	 b:glossaryEntry="billow forth; as of smoke or waves"/>
<rdf:Description rdf:about="&a;201394863">
	<b:glossaryEntry>billow up in the form of a cloud: "The smoke clouded above the houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201394996">
	<b:glossaryEntry>move with great difficulty; "The soldiers billowed across the muddy riverbed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201395145">
	<b:glossaryEntry>fall apart; also used metaphorically: "Negociations broke down"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201395316">
	<b:glossaryEntry>move through by or as by digging; "burrow through the forest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201395450"
	 b:glossaryEntry='move around freely; "She circulates among royalty"'/>
<rdf:Description rdf:about="&a;201395599"
	 b:glossaryEntry='flow freely, as of air or liquids; "Blood flows in my veins"'/>
<rdf:Description rdf:about="&a;201395734">
	<b:glossaryEntry>cause to move around; "The fan circulates the air in the room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201395907"
	 b:glossaryEntry="circulate hot air by convection, as of certain ovens"/>
<rdf:Description rdf:about="&a;201396032">
	<b:glossaryEntry>cause to be distributed; "This letter is circulating among the faculty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201396269">
	<b:glossaryEntry>forward to others; "he is sending around an appeal for funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201396433"
	 b:glossaryEntry="distribute circulars to"/>
<rdf:Description rdf:about="&a;201396547"
	 b:glossaryEntry="put into circulation; of counterfeit currency"/>
<rdf:Description rdf:about="&a;201396655">
	<b:glossaryEntry>move in an orbit, as of celestial bodies: "The moon orbits around the Earth"; "The planets are orbiting the sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201396866"
	 b:glossaryEntry="move in circles"/>
<rdf:Description rdf:about="&a;201397037"
	 b:glossaryEntry="circulate, move around"/>
<rdf:Description rdf:about="&a;201397130"
	 b:glossaryEntry="fly loops, perform a loop, as of an airplane"/>
<rdf:Description rdf:about="&a;201397244"
	 b:glossaryEntry="move in loops"/>
<rdf:Description rdf:about="&a;201397327"
	 b:glossaryEntry="move or proceed at an angle"/>
<rdf:Description rdf:about="&a;201397433">
	<b:glossaryEntry>turn on or around an axis or a center; "The Earth revolves around the Sun"; "The lamb roast rotates on a spit over the fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201397769"
	 b:glossaryEntry='turn outward; "These birds can splay out their toes"'/>
<rdf:Description rdf:about="&a;201397924">
	<b:glossaryEntry>spread open or apart; "He splayed his huge hands over the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201398059"
	 b:glossaryEntry='cause to turn on an axis or center; "Rotate the handle"'/>
<rdf:Description rdf:about="&a;201398276">
	<b:glossaryEntry>change directions as of revolving on a pivot; "They wheeled their horses around and left"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201398469">
	<b:glossaryEntry>do cartwheels: perform an acrobatic movement using both hands and feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201398606"
	 b:glossaryEntry="wheel somebody or something"/>
<rdf:Description rdf:about="&a;201398719"
	 b:glossaryEntry="turn on a pivot"/>
<rdf:Description rdf:about="&a;201398848">
	<b:glossaryEntry xml:space='preserve'><![CDATA[revolve quickly and repeatedly around one''s own axis; "The dervishes whirl around and around without getting dizzy"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201399097"
	 b:glossaryEntry="whirl or spin like a whirligig"/>
<rdf:Description rdf:about="&a;201399194"
	 b:glossaryEntry="drive out; subject to the action of a centrifuge"/>
<rdf:Description rdf:about="&a;201399333"
	 b:glossaryEntry="flow in a circular current, of liquids"/>
<rdf:Description rdf:about="&a;201399476">
	<b:glossaryEntry>fly around, as of paper on the sidewalk, or clothes in a dryer, or rising smoke in the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201399670"
	 b:glossaryEntry='cause to spin; "spin a coin"'/>
<rdf:Description rdf:about="&a;201399783"
	 b:glossaryEntry="cause a floating log to rotate by treading"/>
<rdf:Description rdf:about="&a;201399895"
	 b:glossaryEntry="do a pirouette, usually as part of a dance"/>
<rdf:Description rdf:about="&a;201400004"
	 b:glossaryEntry="kick a leg up"/>
<rdf:Description rdf:about="&a;201400079"
	 b:glossaryEntry="dance by rotating the pelvis in an erotically suggestive way"/>
<rdf:Description rdf:about="&a;201400202">
	<b:glossaryEntry>turn in a twisting or spinning motion; "The leaves swirled in the autumn wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201400393">
	<b:glossaryEntry>to wind or move in a spiral course:" the muscles and nerves of his fine drawn body were coiling for action,", "black smoke coiling up into the sky"; "the young people gyrated on the dance floor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201400675"
	 b:glossaryEntry="move in a spiral or zigzag course"/>
<rdf:Description rdf:about="&a;201400792">
	<b:glossaryEntry>travel past, as of a vehicle; "The sports car passed all the trucks" "</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201401006">
	<b:glossaryEntry xml:space='preserve'><![CDATA[pass or move in front of; "Bride''s Biscuit got by the other dogs to win the race"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201401176">
	<b:glossaryEntry>go across or through; "We passed the point where the police car had parked"; "A terrible thought went through his mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201401678"
	 b:glossaryEntry="pick one''s way"/>
<rdf:Description rdf:about="&a;201401857"
	 b:glossaryEntry='pass through a cycle; "This machine automatically cycles"'/>
<rdf:Description rdf:about="&a;201401995"
	 b:glossaryEntry="come to the starting point of a cycle"/>
<rdf:Description rdf:about="&a;201402098">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make one''s way clumsily; "His steps fumbled"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201402214">
	<b:glossaryEntry>pass by; "A black limousine passed by when she looked out the window"; "He passed his professor in the hall"; "One line of soldiers surpassed the other"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201402590">
	<b:glossaryEntry>pass around or about; move along the border; "The boat skirted the coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201402726"
	 b:glossaryEntry='pass by while running; "We watched children were running by"'/>
<rdf:Description rdf:about="&a;201402858"
	 b:glossaryEntry='pass by while flying; "An enemy plane flew by"'/>
<rdf:Description rdf:about="&a;201402976"
	 b:glossaryEntry='cause to pass: "She passed around the plates"'/>
<rdf:Description rdf:about="&a;201403175"
	 b:glossaryEntry="cause to go through a cycle"/>
<rdf:Description rdf:about="&a;201403283"
	 b:glossaryEntry="cause to repeat a cycle"/>
<rdf:Description rdf:about="&a;201403371">
	<b:glossaryEntry>cause to be circulated and accepted in a false character or identity; "She passed the glass off as diamonds"; "He passed himself off as a secret agent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201403596"
	 b:glossaryEntry='cause to move through; "Pass a chemical through a solution"'/>
<rdf:Description rdf:about="&a;201403779"
	 b:glossaryEntry="pass through a hole or opening, as of a rope"/>
<rdf:Description rdf:about="&a;201403886"
	 b:glossaryEntry='pass an inspection or receive authorization; "clear customs"'/>
<rdf:Description rdf:about="&a;201404017"
	 b:glossaryEntry="pass a rope through, as of a an opening"/>
<rdf:Description rdf:about="&a;201404119"
	 b:glossaryEntry="cut one''s way through the woods or bush"/>
<rdf:Description rdf:about="&a;201404225"
	 b:glossaryEntry="move by very quickly"/>
<rdf:Description rdf:about="&a;201404337">
	<b:glossaryEntry>move towards; draw closer to; "We were approaching our destination"; "They are drawing near"; "The enemy army came nearer and nearer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201404727"
	 b:glossaryEntry='draw near: "The probe closed with the space station"'/>
<rdf:Description rdf:about="&a;201404850">
	<b:glossaryEntry>come together, as if in an embrace; "Her arms closed around her long lost relative"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201405012"
	 b:glossaryEntry='advance or converge on; "The police were closing in on him"'/>
<rdf:Description rdf:about="&a;201405155"
	 b:glossaryEntry='approach a certain age or speed: "She is pushing fifty"'/>
<rdf:Description rdf:about="&a;201405280">
	<b:glossaryEntry>extend or stretch out to a greater or the full length; "Unfold the newspaper"; "stretch out that piece of cloth"; "extend the TV antenna"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201405541">
	<b:glossaryEntry>move quickly and violently; "The car tore down the street"; "He came charging into my office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201405759"
	 b:glossaryEntry="move along very quickly"/>
<rdf:Description rdf:about="&a;201405887"
	 b:glossaryEntry="move very fast"/>
<rdf:Description rdf:about="&a;201406075">
	<b:glossaryEntry>travel at an excessive or illegal velocity; "I got a ticket for speeding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201406219"
	 b:glossaryEntry="move noisily, as of aircraft"/>
<rdf:Description rdf:about="&a;201406309"
	 b:glossaryEntry="run away in a stampede"/>
<rdf:Description rdf:about="&a;201406457">
	<b:glossaryEntry>force or drive out; "The police routed them out of bed at 2 A.M."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201406646"
	 b:glossaryEntry='drive out with smoke; "smoke out the bees"'/>
<rdf:Description rdf:about="&a;201406763">
	<b:glossaryEntry>cause someone or something to move by driving; "She drove me to school every day"; "We drove the car to the garage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201407057">
	<b:glossaryEntry xml:space='preserve'><![CDATA[steer into a certain direction; of a vehicle; "pull one''s horse to a stand"; "Pull the car over"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201407216"
	 b:glossaryEntry='move into a certain direction; of a car; "The van pulled up"'/>
<rdf:Description rdf:about="&a;201407365">
	<b:glossaryEntry>drive in front of another vehicle leaving too little space for that vehicle to maneuver comfortably</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201407536"
	 b:glossaryEntry="drive someone in a vehicle"/>
<rdf:Description rdf:about="&a;201407660">
	<b:glossaryEntry>move or cause to move energetically or busily; "The cheerleaders bustled about excitingly before their performance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201407881"
	 b:glossaryEntry='move restlessly; "The child is always fidgeting in his seat"'/>
<rdf:Description rdf:about="&a;201408005"
	 b:glossaryEntry="take one''s time; proceed slowly"/>
<rdf:Description rdf:about="&a;201408153">
	<b:glossaryEntry>to lag or linger behind: "But in so many other areas we still are dragging."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201408362">
	<b:glossaryEntry>step on it; "He rushed down the hall to receive his guests"; "The cars raced down the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201408728">
	<b:glossaryEntry>cause to move fast or to rush or race; "The psychologist raced the rats through a long maze"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201408905"
	 b:glossaryEntry="depart in a hurry"/>
<rdf:Description rdf:about="&a;201409000"
	 b:glossaryEntry="run with the ball, in football"/>
<rdf:Description rdf:about="&a;201409092">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to walk or proceed draggingly, slowly: "Snow buried the streets and covered the slanting rooftops, as John trudged toward St. Peter''s."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201409315"
	 b:glossaryEntry='move outward; "The soldiers fanned out"'/>
<rdf:Description rdf:about="&a;201409539">
	<b:glossaryEntry>spread gradually: "Light percolated into our house in the morning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201409672">
	<b:glossaryEntry>grow in such a way as to cover (a building, for example); of plants such as ivy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201409834"
	 b:glossaryEntry="be diffused; of dyes and colors"/>
<rdf:Description rdf:about="&a;201409952"
	 b:glossaryEntry="release color when rubbed, of badly dyed fabric"/>
<rdf:Description rdf:about="&a;201410062"
	 b:glossaryEntry="draw back, as with fear"/>
<rdf:Description rdf:about="&a;201410235"
	 b:glossaryEntry="shrink back, as in fear"/>
<rdf:Description rdf:about="&a;201410345">
	<b:glossaryEntry>run or move very quickly or hastily; "She dashed into the yard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201410552">
	<b:glossaryEntry>travel back and forth regularly, as between one''s place of work and home</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201410739"
	 b:glossaryEntry="travel back and forth between two points"/>
<rdf:Description rdf:about="&a;201410852"
	 b:glossaryEntry="make a thrusting forward movement"/>
<rdf:Description rdf:about="&a;201410999">
	<b:glossaryEntry xml:space='preserve'><![CDATA[bend one''s back as in fear or deference; "he crouched down"; "She bowed before the Queen"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201411253"
	 b:glossaryEntry="crouch down"/>
<rdf:Description rdf:about="&a;201411353">
	<b:glossaryEntry>bend over or curl up, usually with laughter or pain; "He doubled and vomited violently"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201411530"
	 b:glossaryEntry='move out of a curled position; "He uncurled himself"'/>
<rdf:Description rdf:about="&a;201411654"
	 b:glossaryEntry="get into a prostrate position, as in submission"/>
<rdf:Description rdf:about="&a;201411779"
	 b:glossaryEntry="show submission or fear"/>
<rdf:Description rdf:about="&a;201411906"
	 b:glossaryEntry="crouch or curl up"/>
<rdf:Description rdf:about="&a;201411995">
	<b:glossaryEntry>press tightly together or cram; "The crowd packed the auditorium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201412150">
	<b:glossaryEntry>move down on as if in an attack; "The teacher swooped down upon the new students"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201412311"
	 b:glossaryEntry="move with a sweep, or in a swooping arc"/>
<rdf:Description rdf:about="&a;201412421"
	 b:glossaryEntry="turn aside; turn away from"/>
<rdf:Description rdf:about="&a;201412583">
	<b:glossaryEntry>cause to turn away from a previous or expected course; "The river was deviated to prevent flooding"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201412809">
	<b:glossaryEntry>cause a celestial body to deviate from a theoretically regular orbital motion, esp. as a result of interposed or extraordinary gravitational pull; "The orbits of these stars were perturbed by the passings of a comet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201413108">
	<b:glossaryEntry>disturb or interfere with the usual path of an electron or atom; "The electrons were perturbed by the passing ion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201413305"
	 b:glossaryEntry="provide with or divert by means of an electrical shunt"/>
<rdf:Description rdf:about="&a;201413430">
	<b:glossaryEntry>deviate erratically form a set course, as of a ship, for example</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201413563"
	 b:glossaryEntry="travel via a detour"/>
<rdf:Description rdf:about="&a;201413646"
	 b:glossaryEntry="wander from a direct or straight course"/>
<rdf:Description rdf:about="&a;201413806">
	<b:glossaryEntry>move or progress freely as if in a stream; "The crowd flowed out of the stadium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201414010"
	 b:glossaryEntry="flow or pour from or as if from a sluice"/>
<rdf:Description rdf:about="&a;201414122">
	<b:glossaryEntry>pass through the tissue or substance or its pores or interstices, as of gas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201414286"
	 b:glossaryEntry='move along, of liquids; "Water flowed into the cave"'/>
<rdf:Description rdf:about="&a;201414729"
	 b:glossaryEntry='cause to flow; "The artist flowed the washes on the paper"'/>
<rdf:Description rdf:about="&a;201414857"
	 b:glossaryEntry='run off as waste: "The water wastes back into the ocean"'/>
<rdf:Description rdf:about="&a;201414994">
	<b:glossaryEntry>stream in jets, of liquids: "The creek spun its course through the woods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201415155"
	 b:glossaryEntry='move downward; "The water ran down"'/>
<rdf:Description rdf:about="&a;201415256"
	 b:glossaryEntry="flow intermittently"/>
<rdf:Description rdf:about="&a;201415345"
	 b:glossaryEntry="gush forth in a sudden stream or jet of liquids"/>
<rdf:Description rdf:about="&a;201415540">
	<b:glossaryEntry>spout moist air from the blowhole, as of some marine mammals; "The whales blew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201415681">
	<b:glossaryEntry>gush or squirt out; "Oil whooshed up when the drill hit the well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201415818"
	 b:glossaryEntry="move with a whooshing sound"/>
<rdf:Description rdf:about="&a;201415924"
	 b:glossaryEntry='move with a sibilant sound; "He whooshed the doors open"'/>
<rdf:Description rdf:about="&a;201416044"
	 b:glossaryEntry="flow in a spurt; of liquids"/>
<rdf:Description rdf:about="&a;201416151"
	 b:glossaryEntry="cause to run; of liquids"/>
<rdf:Description rdf:about="&a;201416353"
	 b:glossaryEntry="pour out, of liquids"/>
<rdf:Description rdf:about="&a;201416448"
	 b:glossaryEntry="run or spill over, as of a liquid"/>
<rdf:Description rdf:about="&a;201416552"
	 b:glossaryEntry='be disgorged; "The crowds spilled out into the streets"'/>
<rdf:Description rdf:about="&a;201416698"
	 b:glossaryEntry="pour out; of wines or sherry"/>
<rdf:Description rdf:about="&a;201416816"
	 b:glossaryEntry='flow freely and abundantly; "Tears streamed down her face"'/>
<rdf:Description rdf:about="&a;201416975">
	<b:glossaryEntry>to extend, wave or float outward, as if in the wind: "their manes streamed like stiff black pennants in the wind."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201417153">
	<b:glossaryEntry>run or flow slowly, or in an unsteady stream: "reports began to dribble in."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201417339"
	 b:glossaryEntry="fall in drops; of liquids"/>
<rdf:Description rdf:about="&a;201417434"
	 b:glossaryEntry="rush down in big quantities, like a cascade"/>
<rdf:Description rdf:about="&a;201417557">
	<b:glossaryEntry>flow off gradually; "The rain water drains into this big vat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201417691"
	 b:glossaryEntry="permeate; penetrate gradually; of liquids"/>
<rdf:Description rdf:about="&a;201417815"
	 b:glossaryEntry="cause (a liquid) to leach or percolate"/>
<rdf:Description rdf:about="&a;201417934">
	<b:glossaryEntry>pass gradually or leak through or as if through small openings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201418065"
	 b:glossaryEntry="flow or run over (a limit or brim)"/>
<rdf:Description rdf:about="&a;201418246"
	 b:glossaryEntry="to overflow like a geyser"/>
<rdf:Description rdf:about="&a;201418335"
	 b:glossaryEntry="advance slowly, as if by inches"/>
<rdf:Description rdf:about="&a;201418461"
	 b:glossaryEntry="move by degrees in one direction only, as of toothed wheels"/>
<rdf:Description rdf:about="&a;201418612"
	 b:glossaryEntry="pass by, as of time"/>
<rdf:Description rdf:about="&a;201418799">
	<b:glossaryEntry>pass away rapidly; "Time flies like an arrow"; "Time fleeing beneath him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201418950">
	<b:glossaryEntry>move away or escape suddenly; "The horses broke from the stable"; "Three inmates broke jail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201419172">
	<b:glossaryEntry xml:space='preserve'><![CDATA[get rid of; "I couldn''t shake the car that was following me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201419341">
	<b:glossaryEntry>run away; usually includes taking something or somebody along</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201419543"
	 b:glossaryEntry="run off without paying a debt"/>
<rdf:Description rdf:about="&a;201419636">
	<b:glossaryEntry xml:space='preserve'><![CDATA[run away secretly with one''s beloved; "The young couple eloped and got married in Las Vegas"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201419809">
	<b:glossaryEntry>escape, either physically or mentally; "The thief eluded the police"; "This difficult idea seems to elude me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201420004">
	<b:glossaryEntry>run away from confinement; "The convicted murderer escaped from a high security prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201420304"
	 b:glossaryEntry="take to one''s heels; cut and run"/>
<rdf:Description rdf:about="&a;201420490"
	 b:glossaryEntry='to run away: "He threw down his gun and fled."'/>
<rdf:Description rdf:about="&a;201420734"
	 b:glossaryEntry="run away, as if in a panic"/>
<rdf:Description rdf:about="&a;201420827">
	<b:glossaryEntry>head into a specified direction; "The escaped convict took to the hills"; "We made for the mountains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201420997"
	 b:glossaryEntry="leave furtively and stealthily"/>
<rdf:Description rdf:about="&a;201421160"
	 b:glossaryEntry="move smoothly and easily"/>
<rdf:Description rdf:about="&a;201421290">
	<b:glossaryEntry>leave behind empty; move out of; "You must vacate your office by tonight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201421453"
	 b:glossaryEntry='leave a camp; "The hikers decamped before dawn"'/>
<rdf:Description rdf:about="&a;201421577"
	 b:glossaryEntry="leave an aircraft rapidly, using an ejection seat or capsule"/>
<rdf:Description rdf:about="&a;201421708">
	<b:glossaryEntry>grow in volume, as under the influence of heat or fermentation; of substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201421865"
	 b:glossaryEntry='extend in one or more directions; "The dough expands"'/>
<rdf:Description rdf:about="&a;201422057"
	 b:glossaryEntry='spread abroad or out; "The sun dispread its beams"'/>
<rdf:Description rdf:about="&a;201422173"
	 b:glossaryEntry="grow outward; of plants"/>
<rdf:Description rdf:about="&a;201422262">
	<b:glossaryEntry>take something or somebody with oneself somewhere; "Bring me the box from the other room"; "Take these letters to the boss"; also metaphorical, as in "This brings me to the main point"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201422854"
	 b:glossaryEntry="bring back to the point of departure"/>
<rdf:Description rdf:about="&a;201422995"
	 b:glossaryEntry="carry (as mud) on the feet and deposit"/>
<rdf:Description rdf:about="&a;201423096">
	<b:glossaryEntry>bring in a new person or object into a familiar environment; "He brought in a new judge"; "The new secretary introduced a nasty rumor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201423342"
	 b:glossaryEntry='introduce; "God interposed death"'/>
<rdf:Description rdf:about="&a;201423442">
	<b:glossaryEntry>bring someone to church for a special rite, as of a woman after childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201423580">
	<b:glossaryEntry>transport from one place or state to another; "Adam would have been carried over into the life eternal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201423775"
	 b:glossaryEntry="convey in a tube"/>
<rdf:Description rdf:about="&a;201423853">
	<b:glossaryEntry>move somewhere quickly; "The President was whisked away in his limo"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201423992"
	 b:glossaryEntry='move quickly and nimbly; "He whisked into the house"'/>
<rdf:Description rdf:about="&a;201424107">
	<b:glossaryEntry>transmit or serve as the medium for transmission, as of sounds or images; "Sound carries well over water"; "The airwaves carry the sound"; "Many metals conduct heat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201424437"
	 b:glossaryEntry='bring in through pipes; "Music was piped into the offices"'/>
<rdf:Description rdf:about="&a;201424568">
	<b:glossaryEntry>as of sounds or images; "The microphone brought in the sounds from the room next to mine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201424723"
	 b:glossaryEntry="transmit again"/>
<rdf:Description rdf:about="&a;201424805"
	 b:glossaryEntry="travel around, esp. on foot"/>
<rdf:Description rdf:about="&a;201424909">
	<b:glossaryEntry>pass by, over, or under without making contact; "the balloon cleared the tree tops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201425087">
	<b:glossaryEntry>turn the forearm or the hand so that the palm is directed downwards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201425219">
	<b:glossaryEntry>turn the hand and forearm so that the palm faces up or forwards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201425348"
	 b:glossaryEntry='go far ahead of; "He outdistanced the other runners"'/>
<rdf:Description rdf:about="&a;201425499">
	<b:glossaryEntry>to depart and forget, or neglect to bring or take along: She wept thinking she''d been left behind.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201425693"
	 b:glossaryEntry='bulge outward; "His eyes popped"'/>
<rdf:Description rdf:about="&a;201425848">
	<b:glossaryEntry>move headlong at high speed; "The cars careered down the road"; "The mob careered through the streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201426022">
	<b:glossaryEntry>move around in a circular motion; "The Earth revolves around the Sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201426194"
	 b:glossaryEntry='make a circuit: "They were circuiting about the state"'/>
<rdf:Description rdf:about="&a;201426321">
	<b:glossaryEntry>strew or distribute over an area; "He spread fertilizer over the lawn"; "scatter cards across the table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201426574"
	 b:glossaryEntry="spread manure, as for fertilization"/>
<rdf:Description rdf:about="&a;201426688"
	 b:glossaryEntry="spread birdlime on branches to catch birds"/>
<rdf:Description rdf:about="&a;201426811"
	 b:glossaryEntry="spread something around something"/>
<rdf:Description rdf:about="&a;201426912"
	 b:glossaryEntry="fold or close up, as of an umbrella or a music stand"/>
<rdf:Description rdf:about="&a;201427074"
	 b:glossaryEntry="collapse like a concertina"/>
<rdf:Description rdf:about="&a;201427168"
	 b:glossaryEntry='become active: "He finally bestirred himself"'/>
<rdf:Description rdf:about="&a;201427285">
	<b:glossaryEntry>march out (as from a defile) into open ground; "The regiments debouched from the valley"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201427466"
	 b:glossaryEntry="bring outside the body for surgery, of organs"/>
<rdf:Description rdf:about="&a;201427596"
	 b:glossaryEntry="move in an agitated or confused manner"/>
<rdf:Description rdf:about="&a;201427706">
	<b:glossaryEntry>force to march; "The Japanese marched their prisoners through Manchuria"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201427877">
	<b:glossaryEntry>cause to march or go at a marching pace; "They marched the mules into the desert"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201428021"
	 b:glossaryEntry="march a person against his will by any method"/>
<rdf:Description rdf:about="&a;201428133"
	 b:glossaryEntry='flow in small streams; "Tears guttered down her face"'/>
<rdf:Description rdf:about="&a;201428258"
	 b:glossaryEntry='run quickly; "He hared down the hill"'/>
<rdf:Description rdf:about="&a;201428381">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move quickly, as if by cutting one''s way: "Planes lanced towards the shore"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201428543"
	 b:glossaryEntry="spread over a surface, like a mantle"/>
<rdf:Description rdf:about="&a;201428651"
	 b:glossaryEntry="go around the flank of (an opposing army)"/>
<rdf:Description rdf:about="&a;201428778"
	 b:glossaryEntry="travel through the air, of sound or light"/>
<rdf:Description rdf:about="&a;201428886"
	 b:glossaryEntry="come into dock, as of a ship"/>
<rdf:Description rdf:about="&a;201429002"
	 b:glossaryEntry='move out of a dock; "We docked at noon"'/>
<rdf:Description rdf:about="&a;201429131">
	<b:glossaryEntry>move (another actor) upstage, forcing him to turn away from the audience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201429276">
	<b:glossaryEntry>toss, roll, or rise and fall in an uncontrolled way; "The shipwrecked survivors welterd in the sea for hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201429473">
	<b:glossaryEntry>shift the position or location of, as for business, legal, educational, or military purposes; "He removed his children to the countryside"; "Remove the troops to the forest surrounding the city"; "remove a case to another court"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201429784"
	 b:glossaryEntry='cause to run in panic: "Thunderbolts can stampede animals"'/>
<rdf:Description rdf:about="&a;201429924">
	<b:glossaryEntry>fill to capacity; "This singer always packs the concert halls"; "They murder trial packed the court house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201430118">
	<b:glossaryEntry>bring ashore; "The drug smugglers landed the heroin on the beach of the island"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201430303">
	<b:glossaryEntry>move quickly in a straight line; "The plane streaked across the sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201430443"
	 b:glossaryEntry='move in a curve; "He swung his left fist"'/>
<rdf:Description rdf:about="&a;201430565"
	 b:glossaryEntry="give a preliminary swing to the arm pitching, as in baseball"/>
<rdf:Description rdf:about="&a;201430690">
	<b:glossaryEntry>move or go steadily or gradually; "The crowd is drawing nearer to the square"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201430837">
	<b:glossaryEntry>change from one vehicle or transportation line to another; "She changed in Chicago on her way to the East coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201431048">
	<b:glossaryEntry>nautical: to move or cause to move in a specified way, direction, or position: "The vessel hove into sight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201431218">
	<b:glossaryEntry>move with, or as if with, a crashing noise; "The car crashed through the glass door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201431365">
	<b:glossaryEntry>move fast, noisily, and heavily; "The bus thundered down the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201431504"
	 b:glossaryEntry='move with a snapping sound; "bullets snapped past us"'/>
<rdf:Description rdf:about="&a;201431619"
	 b:glossaryEntry="make violent, noisy movements"/>
<rdf:Description rdf:about="&a;201431711">
	<b:glossaryEntry>make oneself visible; take action; "Young people should step to the fore and help their peers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201431957">
	<b:glossaryEntry>cause to move around a center so as to show another side of; "turn a page of a book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201432133"
	 b:glossaryEntry='turn over pages; "leaf through a book"'/>
<rdf:Description rdf:about="&a;201432233"
	 b:glossaryEntry='turn over the pages of; "leaf a book"'/>
<rdf:Description rdf:about="&a;201432332">
	<b:glossaryEntry>cause to move around, "turn a key"; "turn a wheel"; "he turned her around"; also used in an abstract sense: "turn your attention to this painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201432584">
	<b:glossaryEntry>move smoothly along a surface; "He slid the money over to the other gambler"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201432723"
	 b:glossaryEntry="go at a pace, as of a horse"/>
<rdf:Description rdf:about="&a;201432910">
	<b:glossaryEntry>put down the foot, place the foot; "For fools rush in where angels fear to tread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201433087">
	<b:glossaryEntry>place or press the foot on; "He stepped on the hem of her long gown"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201433231">
	<b:glossaryEntry>move with or as if with a rushing sound; "The cars hurtled by"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201433357"
	 b:glossaryEntry="to sink in status or dignity, or worsen in condition"/>
<rdf:Description rdf:about="&a;201433482"
	 b:glossaryEntry="cause an animal to move fast"/>
<rdf:Description rdf:about="&a;201433579">
	<b:glossaryEntry>move away, as for privacy; "The Pope retreats to Castelgondolfo every summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201433747">
	<b:glossaryEntry>retreat at full speed; "The actress haigh-tailed to her villa when reporters began to follow her to the resturant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201433928">
	<b:glossaryEntry>move with, or as with, a whistling sound: "The bullets whistled past him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201434074">
	<b:glossaryEntry>move, send, or bring as if by whistling; "Her optimism whistled away these worries"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201434230">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move with a flapping motion; "The bird''s wings were flapping"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201434414">
	<b:glossaryEntry>move with a thrashing motion; "The bird flapped its wings"; "The eagle beat its wings and soared high into the sky"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201434652"
	 b:glossaryEntry='move like a flail; thresh about; "Her arms were flailing"'/>
<rdf:Description rdf:about="&a;201434789"
	 b:glossaryEntry="flap the wings wildly or frantically; used of falcons"/>
<rdf:Description rdf:about="&a;201434904"
	 b:glossaryEntry="strike the air in flight; of the wings of certain birds"/>
<rdf:Description rdf:about="&a;201435021">
	<b:glossaryEntry>cause to strike the air in flight; "The big bird clapped its wings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201435150">
	<b:glossaryEntry>move in an abrupt or headlong manner; "He flung himself onto the sofa"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201435291">
	<b:glossaryEntry>press or force; "Stuff money into an envelope"; "She thrust the letter into his hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201435474"
	 b:glossaryEntry="make a jump forward or upward"/>
<rdf:Description rdf:about="&a;201435572"
	 b:glossaryEntry='jump across; "He hopped the bush"'/>
<rdf:Description rdf:about="&a;201435674"
	 b:glossaryEntry='make a quick trip esp. by air; "Hop the Pacific Ocean"'/>
<rdf:Description rdf:about="&a;201435798"
	 b:glossaryEntry="move quickly from one place to another"/>
<rdf:Description rdf:about="&a;201435923"
	 b:glossaryEntry='sleep around; "His wife bed hops"'/>
<rdf:Description rdf:about="&a;201436021">
	<b:glossaryEntry>climb up on the body; "Shorts that ride up"; "This skirt keeps riding up my legs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201436172">
	<b:glossaryEntry xml:space='preserve'><![CDATA[move as if accompanied by a singsong; "The porters singsonged the travellers'' luggage up the mountain"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201436340"
	 b:glossaryEntry="travel from one island to the next, as on a cruise"/>
<rdf:Description rdf:about="&a;201436458"
	 b:glossaryEntry='send forth suddenly, intensely, swiftly;"shoot a glance"'/>
<rdf:Description rdf:about="&a;201436577"
	 b:glossaryEntry='move around an axis or a center; "The wheels are turning"'/>
<rdf:Description rdf:about="&a;201436722"
	 b:glossaryEntry='move with a swishing sound; "She swished into the room"'/>
<rdf:Description rdf:about="&a;201436864">
	<b:glossaryEntry>cause to move furtively and hurriedly; "The secret service agents hustled the speaker out of the amphitheater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201437046">
	<b:glossaryEntry>make a sudden movement in a new direction (as to evade a blow)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201437171">
	<b:glossaryEntry>move to and fro or from place to place usually in an irregular course</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201437311">
	<b:glossaryEntry>move in a way resembling that of a plow cutting into or going through the soil; "The ship plowed through the water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201437506"
	 b:glossaryEntry="cause to topple or tumble by pushing"/>
<rdf:Description rdf:about="&a;201437639">
	<b:glossaryEntry>move violently, energetically, or carelessly; "She threw herself forwards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201437776">
	<b:glossaryEntry>to put into a state or activity hastily, suddenly, or carelessly; "Jane threw dinner together", throw the car into reverse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201437979">
	<b:glossaryEntry>move slowly and unsteadily; "The truck lurched down the road"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201438121"
	 b:glossaryEntry='cause to flow: "draw blood"'/>
<rdf:Description rdf:about="&a;201438218">
	<b:glossaryEntry>come forth or out; "You stick the coins in, but they come out again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201438362">
	<b:glossaryEntry>move precipitously or violently; "The tornado ripped along the coast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201438507">
	<b:glossaryEntry>move by or as if by water; "The swollen river washed away the footbridge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201438642">
	<b:glossaryEntry>move by or as if by water; "The footbridge washed away during the floods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201438777">
	<b:glossaryEntry xml:space='preserve'><![CDATA[get out of the way; "make way for the President''s motorcade"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201438903">
	<b:glossaryEntry xml:space='preserve'><![CDATA[shape one''s body into a curl; "She curled farther down under the covers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201439055"
	 b:glossaryEntry='change to an upright sitting position; "He sat up in bed"'/>
<rdf:Description rdf:about="&a;201439184">
	<b:glossaryEntry>move as if through a sieve; "The soliders sifted through the woods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201439321">
	<b:glossaryEntry>be or come between; "An interposing thicket blocked their way"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201439432">
	<b:glossaryEntry>skip, leap, or move up and down or sideways; "Dancing flames"; "The children danced with joy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201439596">
	<b:glossaryEntry>make a grasping or snatching motion with the hand: "The passenger grabbed for the oxygen mask"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201439752">
	<b:glossaryEntry>move in a specified direction; "The line of men fall forward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201439883"
	 b:glossaryEntry="move slowly and as if with great effort"/>
<rdf:Description rdf:about="&a;201440008">
	<b:glossaryEntry>move through with or as if with a rake; "She raked her fingers through her hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201440150">
	<b:glossaryEntry>move about freely and without restraint, or act as if running around in an uncontrolled way; "who are these people running around in the building?" "She runs around telling everyone of her troubles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201440417">
	<b:glossaryEntry>move noisily; "The window banged shut"; "The old man banged around the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201440564">
	<b:glossaryEntry>"The car was driving down the road"; "The convertible tooled down the street"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201440719">
	<b:glossaryEntry>escape from the control of; "Industry is running away with us all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201440875">
	<b:glossaryEntry>cause to move by means of an air current; "The wind blew the leaves around in the yard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201441032"
	 b:glossaryEntry='cause air to go in, on, or through: "Blow my hair dry"'/>
<rdf:Description rdf:about="&a;201441148"
	 b:glossaryEntry="change directions suddenly"/>
<rdf:Description rdf:about="&a;201441245">
	<b:glossaryEntry>move in a gyrating fashion; "the poles of the Earth precess at a right angle to the force that is applied"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201441424">
	<b:glossaryEntry>move, as of a fist in boxing; "his opponent cut upward toward his chin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201441556">
	<b:glossaryEntry>use a computer mouse to move icons on the screen and select commands from a menu; "drag this icon to the lower right hand corner of the screen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201441769"
	 b:glossaryEntry="be aware of"/>
<rdf:Description rdf:about="&a;201441871">
	<b:glossaryEntry>perceive by a physical sensation, e.g., coming from the skin or muscles; "He felt the wind"; "She felt an object brushing her arm"; "He felt his flesh crawl"; "She felt the heat when she got out of the car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201442173">
	<b:glossaryEntry>to become aware of through the senses; "I could perceive the ship coming over the horizon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201442638"
	 b:glossaryEntry="have apperception of; a term used in psychology"/>
<rdf:Description rdf:about="&a;201442761">
	<b:glossaryEntry>of perceptual input: receive a signal, receive news, receive a verdict, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201442930">
	<b:glossaryEntry>receive a communication from someone: "We heard nothing from our son for five years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201443076">
	<b:glossaryEntry>perceive intuitively or through some inexplicable perceptive powers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201443215">
	<b:glossaryEntry>of mental or bodily states or experiences: "get an idea"; "experience vertigo"; "get nauseous"; "undergo a strange sensation"; "The fluid undergoes shear"; "receive injuries"; "have a feeling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201443552">
	<b:glossaryEntry>receive as a retribution or punishment; "He got 5 years in prison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201443689">
	<b:glossaryEntry>cause to experience suddenly; "Panic struck me"; "An interesting idea hit her"; "A thought came to me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201443854">
	<b:glossaryEntry>experience or feel; submit to; "Take a test"; "Take the plunge"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201443979"
	 b:glossaryEntry='be subjected to; "He suffered the penalty"'/>
<rdf:Description rdf:about="&a;201444130">
	<b:glossaryEntry>suffer from the receipt of; "She will catch hell for this behavior!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201444303">
	<b:glossaryEntry>suffer or face the pain of death; "Martyrs may die every day for their faith"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201444459">
	<b:glossaryEntry>undergo or suffer; "meet a violent death"; "suffer a terrible fate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201444597"
	 b:glossaryEntry='go or live through; "We had many trials to go through"'/>
<rdf:Description rdf:about="&a;201444868">
	<b:glossaryEntry>undergo passive experience of:"We felt the effects of inflation"; "her fingers felt their way through the string quartet"; "she felt his contempt of her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201445091">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have for one''s benefit; "The industry enjoyed a boom"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201445225">
	<b:glossaryEntry>cause to experience or suffer: "He subjected me to his awful poetry"; "The sergeant subjected the new recruits to many drills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201445550">
	<b:glossaryEntry>cause (someone) to undergo something; "He put her to the torture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201445676">
	<b:glossaryEntry>cause to experience shipwreck; "They were shipwrecked in one of the mysteries at sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201445852"
	 b:glossaryEntry="subject to refraction, as of a light beam"/>
<rdf:Description rdf:about="&a;201445966">
	<b:glossaryEntry>expose or make accessible to some action or influence: "Expose your students to art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201446194"
	 b:glossaryEntry="expose to as if to sun rays"/>
<rdf:Description rdf:about="&a;201446290"
	 b:glossaryEntry="expose to fresh air, as of old clothing"/>
<rdf:Description rdf:about="&a;201446400">
	<b:glossaryEntry>expose excessively: "As a child, I was overexposed to French movies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201446562">
	<b:glossaryEntry>expose insufficiently; "The child was underexposed to language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201446720"
	 b:glossaryEntry="expose to light, of photographic film"/>
<rdf:Description rdf:about="&a;201446857"
	 b:glossaryEntry="expose to too much light; of photographic film"/>
<rdf:Description rdf:about="&a;201446989"
	 b:glossaryEntry="expose to too little light, of photographic film"/>
<rdf:Description rdf:about="&a;201447124">
	<b:glossaryEntry>apply anesthetics to; "The doctor anesthesized the patient before surgery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201447293">
	<b:glossaryEntry>make sensitive to the influence of radiant energy and esp. light, as of an organism or a substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201447471"
	 b:glossaryEntry="cause to be senseless"/>
<rdf:Description rdf:about="&a;201447667"
	 b:glossaryEntry='make numb or insensitive; "The shock numbed her senses"'/>
<rdf:Description rdf:about="&a;201447824">
	<b:glossaryEntry>overcome esp. with astonishment or disbelief; "The news stunned her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201447978">
	<b:glossaryEntry>make dull or stupid; to muddle with drunkenness or infatuation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201448131">
	<b:glossaryEntry>cause to sense; make sensitive; "She sensitized me with respect to gender differences in this traditional male-dominated society"; "My tongue became sensitized to good wine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201448459">
	<b:glossaryEntry>stir feelings in; "stimulate my appetite"; "excite the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201448712"
	 b:glossaryEntry="provide sexual gratification through oral stimulation"/>
<rdf:Description rdf:about="&a;201448850">
	<b:glossaryEntry>cause to be thrilled by some perceptual input; "The men were thrilled by a loud whistle blow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201449015"
	 b:glossaryEntry='make keen or more acute; "whet my appetite"'/>
<rdf:Description rdf:about="&a;201449130"
	 b:glossaryEntry="perceive what is not there; have illusions"/>
<rdf:Description rdf:about="&a;201449249"
	 b:glossaryEntry="perceive incorrectly"/>
<rdf:Description rdf:about="&a;201449364">
	<b:glossaryEntry>perceive with the senses quickly, suddenly, or momentarily; "I caught the aroma of coffee"; "He caught the allusion in her glance"; "ears open to catch every sound"; "The dog picked up the scent"; "Catch a glimpse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201449652">
	<b:glossaryEntry>experience while sleeping; "She claims to never dream"; "He dreamt a strange scene"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201449850"
	 b:glossaryEntry="have fantasies"/>
<rdf:Description rdf:about="&a;201449939">
	<b:glossaryEntry>notice or perceive; "She noted that someone was following her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201450131">
	<b:glossaryEntry>observe with special attention; "Take notice of the great architecture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201450271">
	<b:glossaryEntry>observe with care or pay close attention to; "Take note of this chemical reaction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201450453"
	 b:glossaryEntry="fail to notice"/>
<rdf:Description rdf:about="&a;201450565"
	 b:glossaryEntry="fail to acknowledge; as of people in the street"/>
<rdf:Description rdf:about="&a;201450677"
	 b:glossaryEntry="catch a glimpse of; see briefly"/>
<rdf:Description rdf:about="&a;201450773"
	 b:glossaryEntry="become or make sore by or as if by rubbing"/>
<rdf:Description rdf:about="&a;201450916"
	 b:glossaryEntry="scrape or rub as if to relieve itching"/>
<rdf:Description rdf:about="&a;201451056">
	<b:glossaryEntry>touch (a body part) lightly so as to excite the surface nerves and cause uneasiness, laughter, or spasmodic movements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201451253">
	<b:glossaryEntry>cause a sharp of stinging pain or discomfort; "The sun burned his face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201451409"
	 b:glossaryEntry='feel hot or painful; "My eyes are burning"'/>
<rdf:Description rdf:about="&a;201451513"
	 b:glossaryEntry="have or perceive an itch"/>
<rdf:Description rdf:about="&a;201451659"
	 b:glossaryEntry="feel pain"/>
<rdf:Description rdf:about="&a;201451818"
	 b:glossaryEntry="feel a sudden sharp, local pain"/>
<rdf:Description rdf:about="&a;201451913"
	 b:glossaryEntry="feel the need to eat"/>
<rdf:Description rdf:about="&a;201451997"
	 b:glossaryEntry="feel the need to drink"/>
<rdf:Description rdf:about="&a;201452083"
	 b:glossaryEntry="be the source of pain"/>
<rdf:Description rdf:about="&a;201452333"
	 b:glossaryEntry="make itself felt; as of recurring pains"/>
<rdf:Description rdf:about="&a;201452454">
	<b:glossaryEntry>pulsate or pound with abnormal force; "my head is pounding"; "Her heart was throbbing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201452637"
	 b:glossaryEntry="twitch or throb with pain"/>
<rdf:Description rdf:about="&a;201452725"
	 b:glossaryEntry="cause a tingling sensation"/>
<rdf:Description rdf:about="&a;201452833"
	 b:glossaryEntry="cause a shooting pain"/>
<rdf:Description rdf:about="&a;201452925"
	 b:glossaryEntry="cause a prickling sensation"/>
<rdf:Description rdf:about="&a;201453033"
	 b:glossaryEntry="cause a stinging pain"/>
<rdf:Description rdf:about="&a;201453160"
	 b:glossaryEntry='emit an odor; "The soup smells good"'/>
<rdf:Description rdf:about="&a;201453319"
	 b:glossaryEntry="have perceptible qualities"/>
<rdf:Description rdf:about="&a;201453522"
	 b:glossaryEntry="smell to heaven"/>
<rdf:Description rdf:about="&a;201453651"
	 b:glossaryEntry='smell bad; "He rarely washes, and he smells"'/>
<rdf:Description rdf:about="&a;201453784"
	 b:glossaryEntry="be smelled; have a strong odor"/>
<rdf:Description rdf:about="&a;201453900"
	 b:glossaryEntry="inhale the odor of; perceive by the olfactory sense"/>
<rdf:Description rdf:about="&a;201454094"
	 b:glossaryEntry="draw air audibly up the nose"/>
<rdf:Description rdf:about="&a;201454219">
	<b:glossaryEntry>catch the scent of; get wind of; "The dog nosed out the drugs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201454384"
	 b:glossaryEntry='recognize or detect by or as if by smelling; "out trouble"'/>
<rdf:Description rdf:about="&a;201454552"
	 b:glossaryEntry="cause to smell or be smelly"/>
<rdf:Description rdf:about="&a;201454742"
	 b:glossaryEntry="cause to smell bad; fill with a bad smell"/>
<rdf:Description rdf:about="&a;201454872"
	 b:glossaryEntry="sniff or smell inquiringly"/>
<rdf:Description rdf:about="&a;201454971"
	 b:glossaryEntry="smell strongly and intensely"/>
<rdf:Description rdf:about="&a;201455084"
	 b:glossaryEntry="fill or impregnate with an odor"/>
<rdf:Description rdf:about="&a;201455200"
	 b:glossaryEntry="perfume esp. with a censer"/>
<rdf:Description rdf:about="&a;201455317">
	<b:glossaryEntry>eliminate the odor from; "This stick will deodorize your armpits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201455475"
	 b:glossaryEntry="treat with fumes, expose to fumes"/>
<rdf:Description rdf:about="&a;201455581"
	 b:glossaryEntry="perceive via the tactile sense"/>
<rdf:Description rdf:about="&a;201455682">
	<b:glossaryEntry>grope or feel in search of something; "He felt for his wallet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201455904"
	 b:glossaryEntry="hold and move repeatedly"/>
<rdf:Description rdf:about="&a;201456000">
	<b:glossaryEntry>fail to perceive or to catch with the senses or the mind; "I missed that remark"; "She missed his point"; "We lost part of what he said"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201456213">
	<b:glossaryEntry>see for the first time; make a discovery; "Who discovered the North Pole?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201456379"
	 b:glossaryEntry="be a witness to"/>
<rdf:Description rdf:about="&a;201456459">
	<b:glossaryEntry>observe with attention; "They watched as the murderer was executed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201456625">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perceive with any or all of one''s senses; "We found Republicans winning the offices"; "You''ll see a lot of cheating in this school"; give rise to or be characterized by; "The 1960 saw the rebellion of the younger generation against established traditions"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201456984">
	<b:glossaryEntry>perceive by sight; "You have to be a good observer to see all the details"; "Can you see the bird in that tree?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201457245">
	<b:glossaryEntry>see and understand, have a good eye; "The artist must first learn to see"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201457379"
	 b:glossaryEntry="see something for a brief time"/>
<rdf:Description rdf:about="&a;201457503"
	 b:glossaryEntry="see, as if for the first time"/>
<rdf:Description rdf:about="&a;201457618"
	 b:glossaryEntry='look at carefully; study mentally; "view a problem"'/>
<rdf:Description rdf:about="&a;201457770">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perceive with attention; direct one''s gaze towards; "She looked over the expanse of land"; "Look at your child!" "Look--a deer in the backyard!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201458506">
	<b:glossaryEntry>observe carefully or inspect; "The customs agent examined the baggage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201458875"
	 b:glossaryEntry='look at with attention; "Have a look at this!"'/>
<rdf:Description rdf:about="&a;201459012"
	 b:glossaryEntry='check, try, or ascertain; "See whether it works!"'/>
<rdf:Description rdf:about="&a;201459112"
	 b:glossaryEntry="look towards one''s back"/>
<rdf:Description rdf:about="&a;201459242"
	 b:glossaryEntry="avert one''s gaze"/>
<rdf:Description rdf:about="&a;201459333"
	 b:glossaryEntry="look about oneself"/>
<rdf:Description rdf:about="&a;201459428"
	 b:glossaryEntry="see things as if they were there twice"/>
<rdf:Description rdf:about="&a;201459552">
	<b:glossaryEntry>look at with fixed eyes; "The students stared at the teacher with amazement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201459742">
	<b:glossaryEntry>cause to waver or submit by or as if by staring; "He stared down his enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201459903"
	 b:glossaryEntry="look at attentively"/>
<rdf:Description rdf:about="&a;201459986"
	 b:glossaryEntry="observe the stars"/>
<rdf:Description rdf:about="&a;201460069">
	<b:glossaryEntry>give a certain impression or have a certain outward aspect; "She seems to be sleeping"; "This appears to be a very difficult problem"; "This project looks fishy"; "They appeared like people who had not eaten or slept for a long time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201460612">
	<b:glossaryEntry>appear to begin an activity; "He made to speak but said nothing i the end"; "She made a if to say hello to us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201460792"
	 b:glossaryEntry='give the appearance or impression of; "cut a nice figure"'/>
<rdf:Description rdf:about="&a;201460910">
	<b:glossaryEntry>produce a certain impression; "It feels nice to be home again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201461034">
	<b:glossaryEntry>be accepted as something or somebody in a false character or identity: "She passed off as a Russian agent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201461214">
	<b:glossaryEntry>seem to be true, probable, or apparent; "It seems that he is very gifted"; "It appears that the weather in California is very bad"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201461433"
	 b:glossaryEntry='appear in a certain way; "This sounds interesting"'/>
<rdf:Description rdf:about="&a;201461554">
	<b:glossaryEntry>give off a certain sound or sounds: "This record sounds scratchy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201461726"
	 b:glossaryEntry='sound sharply or shrilly; "The scream pierced the night"'/>
<rdf:Description rdf:about="&a;201461846"
	 b:glossaryEntry='make a characteristic or natural sound; "The drums spoke"'/>
<rdf:Description rdf:about="&a;201461966"
	 b:glossaryEntry='play or sound a wind instrument; "She blew the horn"'/>
<rdf:Description rdf:about="&a;201462116"
	 b:glossaryEntry='make a sound as if blown; "The whistle blew"'/>
<rdf:Description rdf:about="&a;201462240"
	 b:glossaryEntry='go "ting"'/>
<rdf:Description rdf:about="&a;201462311"
	 b:glossaryEntry="be perceived in a certain way; make a certain impression"/>
<rdf:Description rdf:about="&a;201462444">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to throw or bend back from a surface; "A mirror in the sun can reflect light into a person''s eyes."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201462616"
	 b:glossaryEntry='bring back; "This action reflects his true beliefs"'/>
<rdf:Description rdf:about="&a;201462750"
	 b:glossaryEntry='be deflected; "His actions redound on his parents"'/>
<rdf:Description rdf:about="&a;201462865">
	<b:glossaryEntry>make visible or noticeable: "She showed her talent for cooking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201463238">
	<b:glossaryEntry>disclose to view as by removing a cover; "The curtain rose to disclose a stunning set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201463399">
	<b:glossaryEntry>project on a screen; "The images are projected onto the screen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201463571"
	 b:glossaryEntry="project on a background, such as a screen, like a silhouette"/>
<rdf:Description rdf:about="&a;201463723">
	<b:glossaryEntry>bring out fully or to advantage; "This photograph does not do her justice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201463881"
	 b:glossaryEntry='expose or show briefly; "he flashed a $100 bill"'/>
<rdf:Description rdf:about="&a;201463992">
	<b:glossaryEntry>make visible by means of chemical solutions; of photographic film; "Please develop this roll of film for me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201464183">
	<b:glossaryEntry>develop for a second time, in order to improve the contrast, colour, etc., of a negative or print</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201464347">
	<b:glossaryEntry>be or become visible or noticeable; "His good upbringing really shows"; "The dirty side will show"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201464543">
	<b:glossaryEntry xml:space='preserve'><![CDATA[show in one''s face; "Her surprise did not register"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201464668"
	 b:glossaryEntry="project onto a screen for viewing; of films"/>
<rdf:Description rdf:about="&a;201464775">
	<b:glossaryEntry xml:space='preserve'><![CDATA[to show, make visible or apparent: "The Metropolitan Museum is exhibiting Goya''s works this month"; "Why don''t you show your nice legs and wear shorter skirts?" "National leaders will have to display the highest skills of statesmanship.."]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201465301"
	 b:glossaryEntry="display the contents of a file or start an application"/>
<rdf:Description rdf:about="&a;201465435">
	<b:glossaryEntry>cause a window or an application to disappear on a computer desktop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201465583">
	<b:glossaryEntry>display in the air or cause to float: "fly a kite"; "All nations fly their flags in front of the U.N."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201465746">
	<b:glossaryEntry>bring out for display: "The proud father produced many pictures of his baby"; "The accused brought forth a letter in court that he claims exonerates him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201465996"
	 b:glossaryEntry="produce suddenly or automatically, as of tears of charm"/>
<rdf:Description rdf:about="&a;201466116">
	<b:glossaryEntry>hold up something as an example; hold up one''s achievements for admiration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201466279"
	 b:glossaryEntry="exhibit on a bench; of animals such as dogs at shows"/>
<rdf:Description rdf:about="&a;201466394">
	<b:glossaryEntry xml:space='preserve'><![CDATA[expose one''s buttocks to; "moon the audience"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201466509"
	 b:glossaryEntry="display proudly"/>
<rdf:Description rdf:about="&a;201466623"
	 b:glossaryEntry="exhibit aggressively"/>
<rdf:Description rdf:about="&a;201466709"
	 b:glossaryEntry='display as a mannequin; "model the latest fashion"'/>
<rdf:Description rdf:about="&a;201466830"
	 b:glossaryEntry="as for artistic purposes"/>
<rdf:Description rdf:about="&a;201466958"
	 b:glossaryEntry="be rampant, as of a beast in a heraldic depiction"/>
<rdf:Description rdf:about="&a;201467069">
	<b:glossaryEntry>make visible; "Summer brings out bright clothes"; "He brings out the best in her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201467307">
	<b:glossaryEntry>bring out and show for inspection and admiration; "His novel trots out a rich heiress"; "always able to trot out some new excuse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201467502">
	<b:glossaryEntry>open to the view; "A walk through town will unfold many interesting buildings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201467644">
	<b:glossaryEntry>make clear and visible; "The article revealed the policies of the government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201467810">
	<b:glossaryEntry>reveal clearly as having a certain character: "His playing stamps him as a Romantic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201467965">
	<b:glossaryEntry>prevent from being seen or discovered; "Muslim women hide their faces"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201468329"
	 b:glossaryEntry='hide from view; "The lids were occulting her eyes"'/>
<rdf:Description rdf:about="&a;201468443">
	<b:glossaryEntry>shut out from view; "The thick curtain blocked the action on the stage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201468595">
	<b:glossaryEntry>be or go into hiding; keep out of sight, as for protection and safety: "Probably his horse would be close to where he was hiding"; "She is hiding out in a cabin in Montana"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201468884">
	<b:glossaryEntry>remain secluded or in hiding; "He is writing his book and is holing up in his study"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201469033"
	 b:glossaryEntry="keep a low profile, try to be inconspicuous"/>
<rdf:Description rdf:about="&a;201469149">
	<b:glossaryEntry>hold back; keep from being perceived by others, as of emotions or expressions of emotions; "She conceals her anger well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201469356"
	 b:glossaryEntry="hide in the earth, as of a hunted fox"/>
<rdf:Description rdf:about="&a;201469456">
	<b:glossaryEntry>go into hiding or conceal oneself; "Where is your little brother hiding?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201469615">
	<b:glossaryEntry>spread over a surface to conceal or protect; "This paint covers well"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201469747">
	<b:glossaryEntry xml:space='preserve'><![CDATA[hide in one''s bosom: "She bosomed his letters"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201469864"
	 b:glossaryEntry="cover from sight"/>
<rdf:Description rdf:about="&a;201469958"
	 b:glossaryEntry="hide under a false appearance"/>
<rdf:Description rdf:about="&a;201470093"
	 b:glossaryEntry="hide from others, as of feelings"/>
<rdf:Description rdf:about="&a;201470194"
	 b:glossaryEntry="take part in a masquerade"/>
<rdf:Description rdf:about="&a;201470287">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cover up a misdemeanor; "Let''s not whitewash the crimes of Stallin"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201470473">
	<b:glossaryEntry>hide from view or knowledge; "The President covered the fact that he bugged the offices in the White House"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201470672"
	 b:glossaryEntry="hold a thought or feeling of"/>
<rdf:Description rdf:about="&a;201470807">
	<b:glossaryEntry>show or demonstrate something to an interested audience; "She shows her dogs frequently"; "We will demo the new software in Washington"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201471095">
	<b:glossaryEntry>demonstrate the guilt of (someone); "Her strange behavior condemned her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201471250"
	 b:glossaryEntry="condemn by attainder"/>
<rdf:Description rdf:about="&a;201471335">
	<b:glossaryEntry>give a demonstration of: "This improvement shows the effect of the drug most clearly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201471504">
	<b:glossaryEntry>become concealed or hidden from view or have its light extinguished; "The beam of light occults every so often"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201471679"
	 b:glossaryEntry="examine by taking x-rays"/>
<rdf:Description rdf:about="&a;201471774"
	 b:glossaryEntry="examine eggs for freshness by holding them against a light"/>
<rdf:Description rdf:about="&a;201471896"
	 b:glossaryEntry="perform an autopsy; do a post-mortem"/>
<rdf:Description rdf:about="&a;201471997"
	 b:glossaryEntry="examine by auscultation"/>
<rdf:Description rdf:about="&a;201472096"
	 b:glossaryEntry="make a survey of"/>
<rdf:Description rdf:about="&a;201472212"
	 b:glossaryEntry='look attentively; "watch a basketball game"'/>
<rdf:Description rdf:about="&a;201472406">
	<b:glossaryEntry>strain to watch; stare curiously; "The cars slowed down and the drivers rubbernecked after the accident"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201472578">
	<b:glossaryEntry>see or watch; "view a show on television"; "This program will be seen all over the world"; "view an exhibition"; "Catch a show on Brodaway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201472847"
	 b:glossaryEntry="be a spectator, as of a sports event"/>
<rdf:Description rdf:about="&a;201472949">
	<b:glossaryEntry>watch a movie or play before it is released to the general public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201473079">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be vigilant, be on the lookout, be on one''s guard, be careful; "Watch out for pickpockets!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201473300"
	 b:glossaryEntry="examine hastily"/>
<rdf:Description rdf:about="&a;201473424"
	 b:glossaryEntry="examine minutely or intensely"/>
<rdf:Description rdf:about="&a;201473541"
	 b:glossaryEntry="scan with binoculars, as for game in the forest"/>
<rdf:Description rdf:about="&a;201473651">
	<b:glossaryEntry>examine or consider with attention and in detail; "Please peruse this report at your leisure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201473826">
	<b:glossaryEntry>look through a book or other written material; "He thumbed through the report"; "She leafed through the volume"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201474038">
	<b:glossaryEntry xml:space='preserve'><![CDATA[examine closely; focus one''s attention on; "He zoomed in on the book"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201474172">
	<b:glossaryEntry>to look at critically or searchingly, or in minute detail: "he scrutinized his likeness in the mirror."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201474374">
	<b:glossaryEntry>search or seek; "We looked all day and finally found the child in the forest"; "Look elsewhere for the perfect gift!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201474588"
	 b:glossaryEntry="catch sight of"/>
<rdf:Description rdf:about="&a;201474694">
	<b:glossaryEntry>discover or determine the existence, presence, or fact of; "She detected high levels of lead in her drinking water"; "We found traces of lead in the paint"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201475002">
	<b:glossaryEntry>disclose or reveal (obsolete); "We must develop the enemy soldiers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201475142"
	 b:glossaryEntry="discover again"/>
<rdf:Description rdf:about="&a;201475232">
	<b:glossaryEntry>become invisible or unnoticeable; "The effect vanished when day broke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201475457"
	 b:glossaryEntry='go away or disappear; "The fog cleared in the afternoon"'/>
<rdf:Description rdf:about="&a;201475576">
	<b:glossaryEntry>disappear suddenly, as if under the surface of a body of water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201475713">
	<b:glossaryEntry>bring onto the market or release, as of an intellectual creation: "produce a movie"; "bring out a book"; "produce a new play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201475970">
	<b:glossaryEntry>produce or introduce on the stage; "The Shakespeare Company is offering "King Lear" this month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201476128">
	<b:glossaryEntry>produce or disclose suddenly or unexpectedly; "He sprang a new haircut on his wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201476275"
	 b:glossaryEntry="appear suddenly or unexpectedly"/>
<rdf:Description rdf:about="&a;201476380">
	<b:glossaryEntry>make less visible or unclear; "The stars are obscured by the clouds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201476582">
	<b:glossaryEntry>become glassy; lose clear vision; "Her eyes glazed over from lack of sleep</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201476725">
	<b:glossaryEntry xml:space='preserve'><![CDATA[cast a shadow upon; "The tall tree overshadowed the house"; "The tragedy overshadowed the couple''s happiness"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201476920">
	<b:glossaryEntry>cause an eclipse of (a celestial body) by intervention; "The Sun eclipses the moon today"; "Planets and stars often are occulted by other celestial bodies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201477149">
	<b:glossaryEntry>make unrecognizable; "The herb disguises the garlic taste"; "We disguised our faces before robbing the bank"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201477419">
	<b:glossaryEntry>disguise by camouflaging; exploit the natural surroundings to disguise something; "The troops camoflaged themselves before they went into enemy territory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201477665"
	 b:glossaryEntry="determine one''s position with reference to another point"/>
<rdf:Description rdf:about="&a;201477851"
	 b:glossaryEntry='use as a guide; "They had the lights to guide on"'/>
<rdf:Description rdf:about="&a;201477982"
	 b:glossaryEntry="orient once again, after a disorientation"/>
<rdf:Description rdf:about="&a;201478111"
	 b:glossaryEntry="cause to be lost or disoriented"/>
<rdf:Description rdf:about="&a;201478242"
	 b:glossaryEntry='gleam or glow intermittently; "The lights were flashing"'/>
<rdf:Description rdf:about="&a;201478422"
	 b:glossaryEntry='flash intermittently; "The lights flicked on and off"'/>
<rdf:Description rdf:about="&a;201478548"
	 b:glossaryEntry='shine hard; of the sun: "The sun beat down on the hikers"'/>
<rdf:Description rdf:about="&a;201478672"
	 b:glossaryEntry="shine like a beacon"/>
<rdf:Description rdf:about="&a;201478755"
	 b:glossaryEntry="cause to be seen by emitting light"/>
<rdf:Description rdf:about="&a;201478921"
	 b:glossaryEntry="shine brightly, like a star or a light"/>
<rdf:Description rdf:about="&a;201479032">
	<b:glossaryEntry>emit a steady even light without flames; "The fireflies were glowing and flying about in the garden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201479212"
	 b:glossaryEntry="exhibit fluorescence"/>
<rdf:Description rdf:about="&a;201479299">
	<b:glossaryEntry>esp. of the complexion: show a strong bright color, such as red or pink; "Her face glowed when she came out of the sauna"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201479515"
	 b:glossaryEntry='to make less distinct or clear: "heat haze blurs the hills."'/>
<rdf:Description rdf:about="&a;201479663"
	 b:glossaryEntry="put into focus"/>
<rdf:Description rdf:about="&a;201479766">
	<b:glossaryEntry>become or make darker; "The screen darkend"; "He darkened the colors by adding brown"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201479955"
	 b:glossaryEntry="switch a car''s headlights from a higher to a lower beam"/>
<rdf:Description rdf:about="&a;201480077">
	<b:glossaryEntry>become brighter; "The sjy brightened around noon"; "Her face brightened when she heard the good news"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201480270">
	<b:glossaryEntry>to cause someone to lose clear vision, esp. from intense light; "She was dazzled by the bright headlights"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201480466"
	 b:glossaryEntry='shine intensely; "The sun glared down on us"'/>
<rdf:Description rdf:about="&a;201480591">
	<b:glossaryEntry>glare or strike with great intensity; "The sun was beating down on us"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201480723"
	 b:glossaryEntry='be shiny, as if wet; "His eyes were glistening"'/>
<rdf:Description rdf:about="&a;201480905"
	 b:glossaryEntry="glitter as if covered with spangles"/>
<rdf:Description rdf:about="&a;201481005"
	 b:glossaryEntry="keep tabs on; keep an eye on; keep under surveillance"/>
<rdf:Description rdf:about="&a;201481176">
	<b:glossaryEntry>catch sight of; to perceive with the eyes: "caught sight of the kings men coming over the ridge."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201481380"
	 b:glossaryEntry="look at with amorous intentions"/>
<rdf:Description rdf:about="&a;201481481"
	 b:glossaryEntry="look seductively at someone"/>
<rdf:Description rdf:about="&a;201481583">
	<b:glossaryEntry>look suggestively or obliquely; look or gaze with a sly, immodest, or malign expression: "They leer, they simper at her shame": Gay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201481785"
	 b:glossaryEntry="look with amazement; look stupidly"/>
<rdf:Description rdf:about="&a;201481912"
	 b:glossaryEntry="look at with admiration"/>
<rdf:Description rdf:about="&a;201482007">
	<b:glossaryEntry xml:space='preserve'><![CDATA[look at thoughtfully; observe deep in thought; "contemplate one''s navel"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201482148"
	 b:glossaryEntry="look furtively"/>
<rdf:Description rdf:about="&a;201482231">
	<b:glossaryEntry xml:space='preserve'><![CDATA[throw a glance at; take a brief look at; "She only glanced at the paper"; "glint" is archaic; "I only peeked--I didn''t see anything interesting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201482454">
	<b:glossaryEntry xml:space='preserve'><![CDATA[look over carefully; "Please inspect your father''s will carefully"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201482665">
	<b:glossaryEntry>make an official inspection on foot of (the bounds of a property); "Selectmen are required by law to perambulate the bounds every five years"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201482875">
	<b:glossaryEntry>look over, usually with the intention to rob; "They men cased the housed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201483010">
	<b:glossaryEntry>examine carefully; "Someone should vet this report before it goes out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201483141"
	 b:glossaryEntry="watch over"/>
<rdf:Description rdf:about="&a;201483225"
	 b:glossaryEntry="look past, fail to notice"/>
<rdf:Description rdf:about="&a;201483324">
	<b:glossaryEntry>give careful consideration to; "consider the possibility of moving"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201483517"
	 b:glossaryEntry="cause oneself to consider something"/>
<rdf:Description rdf:about="&a;201483617">
	<b:glossaryEntry>gaze at or think about something with great self-satisfaction, gratification, or joy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201483772"
	 b:glossaryEntry="look at"/>
<rdf:Description rdf:about="&a;201483858">
	<b:glossaryEntry>pay attention; be watchful;(colloquial): "Keep your eyes peeled for any policemen"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201484077"
	 b:glossaryEntry='keep under careful scrutiny; "Keep an eye on this prisoner!"'/>
<rdf:Description rdf:about="&a;201484230"
	 b:glossaryEntry="get the lay of the land"/>
<rdf:Description rdf:about="&a;201484352">
	<b:glossaryEntry>colloquial: look at with a critical eye; "When the movie star entered, all the women gave him the once over"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201484559"
	 b:glossaryEntry="be cross-eyed; have a squint or strabismus"/>
<rdf:Description rdf:about="&a;201484665">
	<b:glossaryEntry>make blind by putting the eyes out; "The criminals were punished and blinded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201484824"
	 b:glossaryEntry="render unable to see"/>
<rdf:Description rdf:about="&a;201484943"
	 b:glossaryEntry="sew up the eyelids of hawks and falcons"/>
<rdf:Description rdf:about="&a;201485044"
	 b:glossaryEntry="affect with snow blindness"/>
<rdf:Description rdf:about="&a;201485138">
	<b:glossaryEntry>look searchingly; "We peered into the back of the shop to see whether a salesman was around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201485292">
	<b:glossaryEntry>search or inquire in a meddlesome way; "This guy is always nosing around the office"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201485469">
	<b:glossaryEntry>watch attentively; "Please observe the reaction of these two chemicals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201485693"
	 b:glossaryEntry="perceive sound; perceive by the auditory sense"/>
<rdf:Description rdf:about="&a;201485853"
	 b:glossaryEntry='hear with intention; "Listen to the sound of this cello"'/>
<rdf:Description rdf:about="&a;201486107"
	 b:glossaryEntry="listen to every detail and give a full hearing to"/>
<rdf:Description rdf:about="&a;201486230"
	 b:glossaryEntry="listen quietly, without contributing to the conversation"/>
<rdf:Description rdf:about="&a;201486353">
	<b:glossaryEntry>give heed (to); "The children in the audience attended the recital quietly"; "She hung on his every word"; "They paid attention to everything he said"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201486629">
	<b:glossaryEntry>listen and pay attention; "Listen to your father"; "We must hear the expert before we make a decision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201486822">
	<b:glossaryEntry>of a radio or television set, in order to receive a certain station or program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201486965"
	 b:glossaryEntry="make a high-pitched, screeching noise, as of a door"/>
<rdf:Description rdf:about="&a;201487154"
	 b:glossaryEntry="make a racket"/>
<rdf:Description rdf:about="&a;201487239"
	 b:glossaryEntry="make a rattling sound"/>
<rdf:Description rdf:about="&a;201487351">
	<b:glossaryEntry>make a shrill creaking noise by rubbing together special bodily structures, as of male insects such as crickets or grasshoppers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201487556">
	<b:glossaryEntry>make imperceptible; "The noise from the ice machine drowned out the music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201487705">
	<b:glossaryEntry>as of metallic objects; "The keys were jingling in his pocket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201487855"
	 b:glossaryEntry="emit a noise"/>
<rdf:Description rdf:about="&a;201488249">
	<b:glossaryEntry>make a loud, piercing sound; "Fighter planes are screaming through the skies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201488390"
	 b:glossaryEntry="give off the sound of a bullet flattening on impact"/>
<rdf:Description rdf:about="&a;201488504">
	<b:glossaryEntry>emit a loud noise as a result of undergoing a backfire, as of cars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201488636"
	 b:glossaryEntry="sound with a twang, as of a bowstring"/>
<rdf:Description rdf:about="&a;201488736"
	 b:glossaryEntry='cause to sound with a twang; "He twanged the guitar string"'/>
<rdf:Description rdf:about="&a;201488866"
	 b:glossaryEntry="make a loud noise, as if striking metal"/>
<rdf:Description rdf:about="&a;201488994"
	 b:glossaryEntry="make a clank"/>
<rdf:Description rdf:about="&a;201489085"
	 b:glossaryEntry="make a loud resonant noise"/>
<rdf:Description rdf:about="&a;201489203">
	<b:glossaryEntry>make a deep hollow sound; "Her voice booms out the words of the song"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201489353">
	<b:glossaryEntry>make a rhythmic sound: "Rain drummed against the windshield"; "The drums beat all night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201489544"
	 b:glossaryEntry="make short successive sounds"/>
<rdf:Description rdf:about="&a;201489734"
	 b:glossaryEntry="make a hoarse, rattling sound"/>
<rdf:Description rdf:about="&a;201489835">
	<b:glossaryEntry>make a crackling sound; "My Rice Crispies crackled in the bowl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201489975">
	<b:glossaryEntry>make a sound like a clock or a timer; "the clocks were ticking"; "the grandfather clock beat midnight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201490168"
	 b:glossaryEntry="sound loudly, like a shot"/>
<rdf:Description rdf:about="&a;201490259"
	 b:glossaryEntry="sound with resonance"/>
<rdf:Description rdf:about="&a;201490371">
	<b:glossaryEntry xml:space='preserve'><![CDATA[make a certain noise or sound; "She went `Mmmmm''"; "The gun went `bang''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201491489">
	<b:glossaryEntry>make a gurgling sound as of liquid issuing from a bottle: "glasses clinked...and the wine bottles glugged"- Gerald Durrell.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201491682">
	<b:glossaryEntry>sound by having air expelled through a tube; "The trumpets blew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201491826"
	 b:glossaryEntry="make a sibilant sound"/>
<rdf:Description rdf:about="&a;201491918">
	<b:glossaryEntry>make a sound like a liquid that''s being poured form a bottle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201492050">
	<b:glossaryEntry>make a short high-pitched sound, as of a bullet striking metal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201492174"
	 b:glossaryEntry="of car engines, when firing too early"/>
<rdf:Description rdf:about="&a;201492281"
	 b:glossaryEntry="produce a sound as if from a trumpet"/>
<rdf:Description rdf:about="&a;201492388"
	 b:glossaryEntry="make a sucking sound"/>
<rdf:Description rdf:about="&a;201492481"
	 b:glossaryEntry="of engines"/>
<rdf:Description rdf:about="&a;201492553"
	 b:glossaryEntry='cause to sound; "sound the bell"'/>
<rdf:Description rdf:about="&a;201492818"
	 b:glossaryEntry="sound a gong"/>
<rdf:Description rdf:about="&a;201492892"
	 b:glossaryEntry="cause to make a ting"/>
<rdf:Description rdf:about="&a;201492974"
	 b:glossaryEntry="sound the strings of (a guitar or similar string instrument)"/>
<rdf:Description rdf:about="&a;201493105"
	 b:glossaryEntry='announce by means of a sound; "sound the alarm"'/>
<rdf:Description rdf:about="&a;201493215"
	 b:glossaryEntry='cause to be heard; "His voice projects well"'/>
<rdf:Description rdf:about="&a;201493348"
	 b:glossaryEntry="make a ringing sound"/>
<rdf:Description rdf:about="&a;201493527"
	 b:glossaryEntry='go "ding dong", like a bell'/>
<rdf:Description rdf:about="&a;201493634"
	 b:glossaryEntry="ring or sound like a small bell"/>
<rdf:Description rdf:about="&a;201493737"
	 b:glossaryEntry="ring recurrently; of bells"/>
<rdf:Description rdf:about="&a;201493832"
	 b:glossaryEntry='make ring, as of bells etc.; "Ring the bells"'/>
<rdf:Description rdf:about="&a;201493991"
	 b:glossaryEntry="ring, as of bells announcing death"/>
<rdf:Description rdf:about="&a;201494088"
	 b:glossaryEntry='ring slowly, of bells; "For whom the bell tolls"'/>
<rdf:Description rdf:about="&a;201494198"
	 b:glossaryEntry="make a buzzing sound"/>
<rdf:Description rdf:about="&a;201494304"
	 b:glossaryEntry="of bells, chimes, and gongs"/>
<rdf:Description rdf:about="&a;201494412">
	<b:glossaryEntry>make a strident sound; "She tended to blast when speaking into a microphone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201494559"
	 b:glossaryEntry="make a dry crackling sound, as of silk or leaves"/>
<rdf:Description rdf:about="&a;201494671"
	 b:glossaryEntry="as of tightly stretched ropes or fingers"/>
<rdf:Description rdf:about="&a;201494789"
	 b:glossaryEntry='make a very sharp explosive sound; "His gun cracked"'/>
<rdf:Description rdf:about="&a;201494904"
	 b:glossaryEntry='make a loud noise; "The horns of the taxis blared"'/>
<rdf:Description rdf:about="&a;201495081"
	 b:glossaryEntry="toot continuously; as of a car horn"/>
<rdf:Description rdf:about="&a;201495196"
	 b:glossaryEntry='make whistling sounds; "He lay there, snoring and whistling"'/>
<rdf:Description rdf:about="&a;201495321">
	<b:glossaryEntry>ring or echo with sound; reverberate; "the hall resounded with laughter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201495548">
	<b:glossaryEntry>repeat or return an echo again or repeatedly; send (an echo) back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201495677"
	 b:glossaryEntry="echo repeatedly, echo again and again"/>
<rdf:Description rdf:about="&a;201495786"
	 b:glossaryEntry="ring loudly and deeply, as of bells"/>
<rdf:Description rdf:about="&a;201495883"
	 b:glossaryEntry="make a dull sound"/>
<rdf:Description rdf:about="&a;201495970"
	 b:glossaryEntry="make a crunching noise, as of an engine lacking lubricants"/>
<rdf:Description rdf:about="&a;201496117">
	<b:glossaryEntry>make or move along with a sound as of a horse''s hooves striking the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201496285"
	 b:glossaryEntry="make light, rapid and repeated sounds, as of rain"/>
<rdf:Description rdf:about="&a;201496422"
	 b:glossaryEntry="make light, repeated taps on a surface"/>
<rdf:Description rdf:about="&a;201496550"
	 b:glossaryEntry='make a clicking or ticking sound; "The clock ticked away"'/>
<rdf:Description rdf:about="&a;201496693"
	 b:glossaryEntry="click repeatedly or uncontrollably, as of teeth"/>
<rdf:Description rdf:about="&a;201496814"
	 b:glossaryEntry="make a sharp explosive noise"/>
<rdf:Description rdf:about="&a;201496921"
	 b:glossaryEntry="make an explosive sound"/>
<rdf:Description rdf:about="&a;201497009"
	 b:glossaryEntry="make or emit a high tinkling sound"/>
<rdf:Description rdf:about="&a;201497130"
	 b:glossaryEntry="make a high sound, as of champagne glasses during a toast"/>
<rdf:Description rdf:about="&a;201497268"
	 b:glossaryEntry="make a splashing sound; of liquids"/>
<rdf:Description rdf:about="&a;201497399"
	 b:glossaryEntry="sound with a monotonous hum"/>
<rdf:Description rdf:about="&a;201497511"
	 b:glossaryEntry="emit a single short high-pitched signal, as of apparatus"/>
<rdf:Description rdf:about="&a;201497630"
	 b:glossaryEntry="make a low noise, as of thunder"/>
<rdf:Description rdf:about="&a;201497743">
	<b:glossaryEntry>make a resonant sound; as of artillery: "His deep voice boomed through the hall."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201497892">
	<b:glossaryEntry>to produce a sharp often metallic explosive or percussive sound: "One of them banged the sash of the window nearest my bed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201498085">
	<b:glossaryEntry>make a babbling, gurgling sound, as of water; "babbling brooks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201498265">
	<b:glossaryEntry>move with or make or cause to move with or make a whistling or hissing sound, as of liquids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201498441"
	 b:glossaryEntry="make a monotonous low dull sound"/>
<rdf:Description rdf:about="&a;201498536">
	<b:glossaryEntry>make a soft swishing sound, as of a motor working or wings flapping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201498703"
	 b:glossaryEntry="tap a telephone or telegraph wire to get information"/>
<rdf:Description rdf:about="&a;201498845">
	<b:glossaryEntry>hear, usually without the knowledge of the speakers; "We overheard the conversation at the next table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201499075">
	<b:glossaryEntry xml:space='preserve'><![CDATA[perceive by hearing; "I didn''t catch your name"; "She didn''t get his name when they met the first time"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201499265"
	 b:glossaryEntry="listen; used mostly in the imperative"/>
<rdf:Description rdf:about="&a;201499391"
	 b:glossaryEntry="listen without the speaker''s knowledge"/>
<rdf:Description rdf:about="&a;201499534"
	 b:glossaryEntry="make or render deaf"/>
<rdf:Description rdf:about="&a;201499632"
	 b:glossaryEntry='be unbearably loud; "a deafening noise"'/>
<rdf:Description rdf:about="&a;201499743">
	<b:glossaryEntry>become quiet or quieter; "The audience fell silent when the speaker entered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201499942"
	 b:glossaryEntry="make soft or softer; of images and sounds"/>
<rdf:Description rdf:about="&a;201500099"
	 b:glossaryEntry="make sharp or sharper of images and sounds"/>
<rdf:Description rdf:about="&a;201500258"
	 b:glossaryEntry="prevent from speaking"/>
<rdf:Description rdf:about="&a;201500357"
	 b:glossaryEntry="increase or decrease in intensity"/>
<rdf:Description rdf:about="&a;201500580"
	 b:glossaryEntry="deaden (a sound or noise), esp. by wrapping"/>
<rdf:Description rdf:about="&a;201500737"
	 b:glossaryEntry='perceive by the sense of taste; "Can you taste the garlic?"'/>
<rdf:Description rdf:about="&a;201500886"
	 b:glossaryEntry="lend flavor to"/>
<rdf:Description rdf:about="&a;201501081">
	<b:glossaryEntry>impregnate with resin to give a special flavor to, as of some Greek wines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201501220"
	 b:glossaryEntry="add herbs or spices to"/>
<rdf:Description rdf:about="&a;201501352"
	 b:glossaryEntry="add ginger to"/>
<rdf:Description rdf:about="&a;201501429"
	 b:glossaryEntry='distinguish flavors; "We tasted wines last night"'/>
<rdf:Description rdf:about="&a;201501559">
	<b:glossaryEntry xml:space='preserve'><![CDATA[detect with the senses; "The fleeing convicts were picked out of the darkness by the watchful prison guards"; "I can''t make out the faces in this photograph"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201501886"
	 b:glossaryEntry="make clearly visible, as of images in optics"/>
<rdf:Description rdf:about="&a;201501995">
	<b:glossaryEntry>distinguish; "I could not discriminate the different tastes in this complicated dish"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201502150"
	 b:glossaryEntry="taste appreciatively"/>
<rdf:Description rdf:about="&a;201502242"
	 b:glossaryEntry="give taste to"/>
<rdf:Description rdf:about="&a;201502335"
	 b:glossaryEntry="have flavor; taste of something"/>
<rdf:Description rdf:about="&a;201502454">
	<b:glossaryEntry>have a distinctive or characteristic taste; "This tastes of nutmeg"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201502592">
	<b:glossaryEntry>have an element suggestive (of something); "his speeches smacked of racism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201502738"
	 b:glossaryEntry="fill with distaste"/>
<rdf:Description rdf:about="&a;201502875"
	 b:glossaryEntry="make sick or nauseated; turn one''s stomach"/>
<rdf:Description rdf:about="&a;201502992"
	 b:glossaryEntry="make sweeter in taste"/>
<rdf:Description rdf:about="&a;201503219"
	 b:glossaryEntry="make bitter"/>
<rdf:Description rdf:about="&a;201503302"
	 b:glossaryEntry="sweeten with honey"/>
<rdf:Description rdf:about="&a;201503383"
	 b:glossaryEntry="sweeten with sugar"/>
<rdf:Description rdf:about="&a;201503476"
	 b:glossaryEntry="add pepper to"/>
<rdf:Description rdf:about="&a;201503553"
	 b:glossaryEntry="add salt to"/>
<rdf:Description rdf:about="&a;201503626"
	 b:glossaryEntry="coat with something sweet, such as a hard sugar glaze"/>
<rdf:Description rdf:about="&a;201503770">
	<b:glossaryEntry>heat with sugar and spices to make a hot drink; "mulled cider"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201503903"
	 b:glossaryEntry="make sour or more sour"/>
<rdf:Description rdf:about="&a;201504053"
	 b:glossaryEntry="alter the flavor of"/>
<rdf:Description rdf:about="&a;201504196">
	<b:glossaryEntry>allow to go out of sight: "The detective lost the man he was shadowing after he had to stop at a red light"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201504355"
	 b:glossaryEntry='enjoy in a sexual way; "He gets off on shoes"'/>
<rdf:Description rdf:about="&a;201504465">
	<b:glossaryEntry>experience orgasm; "she could not come because she was too upset"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201504592">
	<b:glossaryEntry>be perceived by; "Loud music greeted him when he entered the apartment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201504716">
	<b:glossaryEntry>observe or plot the moving path of something (e.g., a target or missile)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201504859">
	<b:glossaryEntry>perceive oneself to be in a certain condition or place; "I found myself in a difficult situation"; "When he woke up, he found himself in a hospital room"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201505092">
	<b:glossaryEntry>emit, produce, or utter with a deep prolonged reverberating sound; "The thunder rolled"; "rolling drums"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201505258">
	<b:glossaryEntry xml:space='preserve'><![CDATA[appear to one''s own mind or opinion; "I seem to be misunderstood by everyone"; "I can''t seem to learn these Chinese characters"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201505447">
	<b:glossaryEntry>interrupt the normal function of by means of anesthesia; "block a nerve"; "block a muscle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201505608">
	<b:glossaryEntry>keep under surveillance; "The police had been following him for weeks but they could not prove his involvement in the bombing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201505815">
	<b:glossaryEntry>be the source of great pain for; "These new shoes are killing me!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201505951">
	<b:glossaryEntry>transfer possession of something concrete or abstract to somebody; "I gave her my money"; "can you give me lessons?" "She gave the children lots of love and tender loving care"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201506611">
	<b:glossaryEntry xml:space='preserve'><![CDATA[give reluctantly; "He coughed up some money for his children''s tuition"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201506768">
	<b:glossaryEntry>leave with; give temporarily: "Can I give you my keys while I go in the pool?" "Can I give you the children for the weekend?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201506956">
	<b:glossaryEntry>give as a present; make a gift of; "What will you give her for her birthday?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201507300">
	<b:glossaryEntry>to get into a position of having, e.g., safety, comfort; "take shelter from the storm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201507431"
	 b:glossaryEntry="furnish with an endowment"/>
<rdf:Description rdf:about="&a;201507553"
	 b:glossaryEntry="endow with a benefice"/>
<rdf:Description rdf:about="&a;201507640"
	 b:glossaryEntry="give out freely"/>
<rdf:Description rdf:about="&a;201507791"
	 b:glossaryEntry="dispose of in a raffle"/>
<rdf:Description rdf:about="&a;201507890">
	<b:glossaryEntry>give a tip or gratuity to in return for a service, beyond the agreed-on compensation; "Remember to tip the waiter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201508080"
	 b:glossaryEntry="retain possession of"/>
<rdf:Description rdf:about="&a;201508396"
	 b:glossaryEntry="hold over goods to be sold for the next season"/>
<rdf:Description rdf:about="&a;201508522">
	<b:glossaryEntry>look after; be the keeper of; have charge of; "He keeps the bees on the estate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201508689">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have or possess, either in a concrete or an abstract sense: "She has $1,000 in the bank"; "He has got two beautiful daughters"; "She holds a Master''s degree from Harvard"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201509063">
	<b:glossaryEntry>have or exploit a monopoly of; "OPEC wants to monopolize oil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201509192"
	 b:glossaryEntry="of power or authority"/>
<rdf:Description rdf:about="&a;201509295">
	<b:glossaryEntry>have ownership or possession of; "He owns three houses in Florida"; "How many cars does she have?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201509471"
	 b:glossaryEntry="possess beforehand"/>
<rdf:Description rdf:about="&a;201509557">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have left; "I have two years left"; "I don''t have any money left" "They had two more games left"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201509715">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take into one''s possession; "We are taking an orphan from Romania"; "I''ll take three salmon steaks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201510126">
	<b:glossaryEntry>take from a person or place; "We took the abused child away from its parents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201510294"
	 b:glossaryEntry="regain possession of something"/>
<rdf:Description rdf:about="&a;201510403"
	 b:glossaryEntry="obtain, especially accidentally"/>
<rdf:Description rdf:about="&a;201510517">
	<b:glossaryEntry>encounter by chance; "I stumbled across a long-lost cousin last night in a restaurant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201510674">
	<b:glossaryEntry>take by force; "Hitler took the Baltic Republics"; "The army took the fort on the hill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201511029"
	 b:glossaryEntry="take forcibly from legal custody, as of prisoners"/>
<rdf:Description rdf:about="&a;201511142">
	<b:glossaryEntry>take by attacking with scaling ladders; "The troops took the fort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201511279">
	<b:glossaryEntry>obtain by purchase; acquire by means of a financial transaction: "The family purchased a new car"; "The conglomerate acquired a new company"; "She buys for the big department store"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201511800">
	<b:glossaryEntry xml:space='preserve'><![CDATA[buy, select; "I''ll take a pound of that sausage"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201511928"
	 b:glossaryEntry='purchase; "What did you get at the toy store?"'/>
<rdf:Description rdf:about="&a;201512035"
	 b:glossaryEntry='sell; "We cleared a lot of the old model cars"'/>
<rdf:Description rdf:about="&a;201512144">
	<b:glossaryEntry xml:space='preserve'><![CDATA[engage in a commercial transaction; "We took an apartment on a quiet street"; "Let''s rent a car"; "Shall we take a guide in Rome?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201512393">
	<b:glossaryEntry>grant use or occupation of under a term of contract; "I am leasing my country estate to some foreigners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201512625">
	<b:glossaryEntry>lease or rent all or part of (a leased or rented property) to another person; "We sublet our apartment over the summer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201512827">
	<b:glossaryEntry>grant the services of or the temporary use of, for a fee; "We rent out our apartment to tourists every year"; "He hired himself out as a cook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201513073">
	<b:glossaryEntry>receive or obtain by regular payment; "We take the Times every day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201513237">
	<b:glossaryEntry>make use of or accept for some purpose; "take a risk"; "take an opportunity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201513366">
	<b:glossaryEntry>get something; come into possession of; "receive payment"; "receive a gift"; "receive letters from the front"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201513653">
	<b:glossaryEntry>of a deliberative body: receive (a report) officially, as from a committee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201513791"
	 b:glossaryEntry="receive stolen goods"/>
<rdf:Description rdf:about="&a;201513874">
	<b:glossaryEntry>come into the possession of something concrete or abstract; "She got a lot of paintings from her uncle"; "They acquired a new pet"; "Get your results the next day"; "Get permission to take a few days off from work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201514751">
	<b:glossaryEntry>acquire by trade or sacrifice or exchange; "She wanted to buy his love with her dedication to him and his work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201514923">
	<b:glossaryEntry>obtain through effort or management; "She found the time and energy to take care of her aging parents"; "We found the money to send our sons to college"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201515137">
	<b:glossaryEntry>seize upon or latch onto something; "The Republicans glommed onto Whitewater"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201515276">
	<b:glossaryEntry>take possession of; "She entered upon the estate of her rich relatives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201515455">
	<b:glossaryEntry>refuse to let have; "She denies me every pleasure"; "he denies her her weekly allowance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201515668">
	<b:glossaryEntry>restrain, esp. from indulging in some pleasure; "She denied herself wine and spirits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201515833">
	<b:glossaryEntry>get something or somebody for a specific purpose; "I found this gadget that will serve as a bottle opener"; "I got hold of these tools to fix our plumbing"; "The chairman got hold of a secretary on Friday night to type the urgent letter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201516187"
	 b:glossaryEntry="hold back; refuse to hand over"/>
<rdf:Description rdf:about="&a;201516385">
	<b:glossaryEntry xml:space='preserve'><![CDATA[refuse to grant, as of a petition or request; "The dean denied the students'' request for more physics courses"; "the prisoners were denied the right to exercise for more than 2 hours a day"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201516644">
	<b:glossaryEntry>hold back or set aside, esp. for future use or contingency: reserve: they held back their applause in anticipation.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201516824"
	 b:glossaryEntry="hold as reserve or withdraw from circulation; of capital"/>
<rdf:Description rdf:about="&a;201516948">
	<b:glossaryEntry>retain and refrain from disbursing; of payments; "My employer is withholding taxes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201517141"
	 b:glossaryEntry="deduct from someone''s wages"/>
<rdf:Description rdf:about="&a;201517230"
	 b:glossaryEntry="take by conquest; as of territory"/>
<rdf:Description rdf:about="&a;201517364"
	 b:glossaryEntry="take illegally, as of territory"/>
<rdf:Description rdf:about="&a;201517466"
	 b:glossaryEntry='furnish a fund for; "Who will fund the new welfare program?"'/>
<rdf:Description rdf:about="&a;201517669"
	 b:glossaryEntry="supply with funds in return for a promised share of profits"/>
<rdf:Description rdf:about="&a;201517803">
	<b:glossaryEntry>provide with sufficient funds; finance; "Who will bankroll the restoration of the former East German economy?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201517979">
	<b:glossaryEntry>take up, as of debts or payments; "absorb the costs for something"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201518129">
	<b:glossaryEntry>support through subsidies; "The arts in Europe are heavily subsidized"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201518274">
	<b:glossaryEntry>obtain or provide money for; "Can we finance the addition to our home?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201518465"
	 b:glossaryEntry='support financial backing for; "back this enterprise"'/>
<rdf:Description rdf:about="&a;201518580"
	 b:glossaryEntry="sell or provide on credit"/>
<rdf:Description rdf:about="&a;201518670">
	<b:glossaryEntry>raise money for a cause or project; "We are fundraising for AIDS research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201518840">
	<b:glossaryEntry>call for and obtain payment of; "we collected over a million dollars in outstanding debts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201519049"
	 b:glossaryEntry="collect fees or profits"/>
<rdf:Description rdf:about="&a;201519152"
	 b:glossaryEntry="renew the financing of"/>
<rdf:Description rdf:about="&a;201519241"
	 b:glossaryEntry="store in a fund"/>
<rdf:Description rdf:about="&a;201519318"
	 b:glossaryEntry='store in a computer; "computerized dictionary"'/>
<rdf:Description rdf:about="&a;201519433"
	 b:glossaryEntry="set up a fund; convert into a debt"/>
<rdf:Description rdf:about="&a;201519529">
	<b:glossaryEntry>support financially in an enterprise; "The scholarship saw me through college"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201519748"
	 b:glossaryEntry="assume sponsorship of"/>
<rdf:Description rdf:about="&a;201519872">
	<b:glossaryEntry>assume responsibility for or leadership of; "The senator announced that he would sponsor the health care plan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201520055"
	 b:glossaryEntry="sponsor together with another sponsor"/>
<rdf:Description rdf:about="&a;201520167">
	<b:glossaryEntry>cause to change ownership; "I transferred my stock holdings to my children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201520476">
	<b:glossaryEntry>transfer to another; of rights or property; "Our house passed under his official control"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201520635">
	<b:glossaryEntry>transfer from ecclesiastical to civil possession, use, or control</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201520768">
	<b:glossaryEntry>be transferred to another owner; "This restaurant changed owners twice last year"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201520955"
	 b:glossaryEntry='throw or cast away; "Put away your worries"'/>
<rdf:Description rdf:about="&a;201521401"
	 b:glossaryEntry='toss out; get rid of; "deep-six these old souvenirs!"'/>
<rdf:Description rdf:about="&a;201521543"
	 b:glossaryEntry="throw away, of something encumbering"/>
<rdf:Description rdf:about="&a;201521645"
	 b:glossaryEntry='dispose of; "trash these old chairs;"; "junk an old car"'/>
<rdf:Description rdf:about="&a;201521779">
	<b:glossaryEntry>get rid of; "We waste the dirty water by channeling it into the sewer"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201521912">
	<b:glossaryEntry>remove unwanted elements; "The company weeded out the incompetent people"; "The new law removes the old inequities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201522120">
	<b:glossaryEntry>dispose of; "Get rid of these old shoes!" "The company got rid of all the dead wood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201522341">
	<b:glossaryEntry>get rid of unceremoniously or irresponsibly; "The company dumped him after many years of service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201522508"
	 b:glossaryEntry='as of refuse; "No dumping in these woods!"'/>
<rdf:Description rdf:about="&a;201522620">
	<b:glossaryEntry>dispose of; as of old clothes; "She finally retired that old coat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201522764">
	<b:glossaryEntry>to keep up and reserve for personal or special use: "save something in case you hit trouble."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201522995"
	 b:glossaryEntry="supply sparingly, with a meager allowance"/>
<rdf:Description rdf:about="&a;201523115"
	 b:glossaryEntry="equip with fins, as of a car"/>
<rdf:Description rdf:about="&a;201523204"
	 b:glossaryEntry="provide with a terrace, as of a house"/>
<rdf:Description rdf:about="&a;201523317"
	 b:glossaryEntry="supply nerves to (some organ or body part)"/>
<rdf:Description rdf:about="&a;201523426"
	 b:glossaryEntry="of materials from waste products"/>
<rdf:Description rdf:about="&a;201523551"
	 b:glossaryEntry="preserve a dead body"/>
<rdf:Description rdf:about="&a;201523661"
	 b:glossaryEntry="make into a mummy"/>
<rdf:Description rdf:about="&a;201523751"
	 b:glossaryEntry='throw away (slang); "Chuck these old notes"'/>
<rdf:Description rdf:about="&a;201523865"
	 b:glossaryEntry='turn away from; give up; "I am foreswearing women forever"'/>
<rdf:Description rdf:about="&a;201524047">
	<b:glossaryEntry>give up with the intent of never claiming again; "Abandon your life to God"; "She gave up her children to her ex-husband when she moved to Tahiti"; "We gave the drowning victim up for dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201524319">
	<b:glossaryEntry>forsake, leave behind; "We abandoned the old car in the empty parking lot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201524538"
	 b:glossaryEntry='forsake; "ditch a lover"'/>
<rdf:Description rdf:about="&a;201524625"
	 b:glossaryEntry="leave stranded; put ashore on a desolate island and abandon"/>
<rdf:Description rdf:about="&a;201524757"
	 b:glossaryEntry="transfer one''s right to"/>
<rdf:Description rdf:about="&a;201524852"
	 b:glossaryEntry='give out; "We were assigned new uniforms"'/>
<rdf:Description rdf:about="&a;201525019">
	<b:glossaryEntry>leave or give by will; "My aunt bequeathed me all her jewelry"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201525224">
	<b:glossaryEntry>be inherited by; "The estate fell to my sister"; "The land returned to the family"; The estate devolved to an heir that everybody had assumed to be dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201525483">
	<b:glossaryEntry>fall to somebody by assignment or lot: "The task fell to me"; "It fell to me to notify the parents of the victims"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201525675">
	<b:glossaryEntry>come into the possession of; "The house accrued to the oldest son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201525812">
	<b:glossaryEntry>give to or transfer possession of; "I am passing on my genes to my children"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201525997"
	 b:glossaryEntry="transmit from one generation to the next, of characteristics"/>
<rdf:Description rdf:about="&a;201526132">
	<b:glossaryEntry>passed on, as by inheritance; "This ring was handed down through many generations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201526289">
	<b:glossaryEntry>place into the hands or custody of; "Turn the files over to me, please"; "He turned over the prisoner to his lawyers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201526780">
	<b:glossaryEntry>pass on stealthily; "He slipped me the key when nobody was looking"</b:glossaryEntry>
