	 b:glossaryEntry="type genus of the family Ornithorhynchidae"/>
<rdf:Description rdf:about="&a;101389315">
	<b:glossaryEntry>small densely furred aquatic monotreme of Australia and Tasmania having a broad bill and tail and webbed feet; only species in the family Ornithorhynchidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101389627">
	<b:glossaryEntry>generalized extinct mammals widespread during the Jurassic; commonly conceded to be ancestral to marsupial and placental mammals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101389855"
	 b:glossaryEntry="pouched animals"/>
<rdf:Description rdf:about="&a;101389987">
