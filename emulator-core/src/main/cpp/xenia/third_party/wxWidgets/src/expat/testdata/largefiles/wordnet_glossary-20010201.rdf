	 b:glossaryEntry="ferns that grow in water"/>
<rdf:Description rdf:about="&a;109253734"
	 b:glossaryEntry="clover ferns"/>
<rdf:Description rdf:about="&a;109253903"
	 b:glossaryEntry="clover ferns"/>
<rdf:Description rdf:about="&a;109254044">
	<b:glossaryEntry>any of several water ferns of the genus Marsilea having four leaflets</b:glossaryEntry>
</rdf:Description>
