</rdf:Description>
<rdf:Description rdf:about="&a;100573314"
	 b:glossaryEntry="a course introducing a new situation or environment"/>
<rdf:Description rdf:about="&a;100573444">
	<b:glossaryEntry>a course that reviews and updates a topic for those who have not kept abreast of developments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100573612"
	 b:glossaryEntry="a course offered for a small group of advanced students"/>
<rdf:Description rdf:about="&a;100573721">
	<b:glossaryEntry>a brief intensive course for a small group; emphasizes problem solving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100573846">
	<b:glossaryEntry>teaching in an overly simplified way that discourages independent thought</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100573978">
	<b:glossaryEntry>teaching by giving a discourse on some subject (typically to a class)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100574169">
	<b:glossaryEntry>presentation of an example of what the lecturer is discoursing about</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100574324">
	<b:glossaryEntry>a act of giving a talk to an audience; "I attended an interesting talk on local history"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100574481"
