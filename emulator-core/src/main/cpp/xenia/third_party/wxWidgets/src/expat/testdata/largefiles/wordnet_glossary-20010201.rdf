</rdf:Description>
<rdf:Description rdf:about="&a;200811027">
	<b:glossaryEntry>to be spent or finished; "The money had gone after a few days"; "Gas is running low at the gas stations in the Midwest"</b:glossaryEntry>
</rdf:Description>
