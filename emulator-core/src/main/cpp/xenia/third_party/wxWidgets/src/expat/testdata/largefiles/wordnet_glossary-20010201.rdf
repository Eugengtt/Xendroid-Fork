</rdf:Description>
<rdf:Description rdf:about="&a;201066937">
	<b:glossaryEntry>remove by erasing or crossing out; "Please strike this remark from the record"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201067122">
	<b:glossaryEntry>strike or cancel by or as if by rubbing or crossing out; "scratch out my name on that list"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201067308"
	 b:glossaryEntry='mar or spoil the appearance of; "scars defaced her cheeks"'/>
<rdf:Description rdf:about="&a;201067496"
	 b:glossaryEntry='cut open or cut apart; "dissect the bodies for analysis"'/>
<rdf:Description rdf:about="&a;201067661">
