	 b:glossaryEntry="a seed of the coffee tree; ground to make coffee"/>
<rdf:Description rdf:about="&a;105948884">
	<b:glossaryEntry>a beverage consisting of an infusion of ground coffee beans; "he ordered a cup of coffee"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105949269"
	 b:glossaryEntry="black coffee with cognac and lemon peel and sugar"/>
<rdf:Description rdf:about="&a;105949391">
	<b:glossaryEntry>a punch made of fruit juices mixed with water or soda water (with or without alcohol)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105949534"
	 b:glossaryEntry="a punch made of spirits and milk and sugar and spices"/>
<rdf:Description rdf:about="&a;105949644"
	 b:glossaryEntry="a mixed drink containing champagne and orange juice"/>
<rdf:Description rdf:about="&a;105949748">
	<b:glossaryEntry>an iced mixed drink usually containing alcohol and prepared for multiple servings; normally served in a punch bowl</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105950058"
	 b:glossaryEntry="punch served in a pitcher instead of a punch bowl"/>
<rdf:Description rdf:about="&a;105950193"
	 b:glossaryEntry="a punch containing a sparkling wine"/>
<rdf:Description rdf:about="&a;105950288">
	<b:glossaryEntry>a punch made of claret and brandy with lemon juice and sugar and sometimes sherry or curacao and fresh fruit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105950472">
	<b:glossaryEntry>sweetened ale or wine heated with spices and roasted apples; especially at Christmas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105950610"
	 b:glossaryEntry="rum and lime or lemon juice with sugar and sometimes bitters"/>
<rdf:Description rdf:about="&a;105950751">
	<b:glossaryEntry>make of rums and brandy and water or tea sweetened with sugar syrup</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105950881">
	<b:glossaryEntry>moselle and sugar and sparkling water or champagne flavored with sweet woodruff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105951034">
	<b:glossaryEntry>sweetened milk or cream mixed with eggs and usually alcoholic liquor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105951155">
	<b:glossaryEntry>Scandinavian punch made of claret and aquavit with spices and raisins and orange peel and sugar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105951302"
	 b:glossaryEntry="a drink resembling beer; made from fermented cassava juice"/>
<rdf:Description rdf:about="&a;105951433">
	<b:glossaryEntry>made of sweetened lime juice and soda water usually with liquor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105951567"
	 b:glossaryEntry="a rickey made with gin"/>
<rdf:Description rdf:about="&a;105951646">
	<b:glossaryEntry>dried leaves of the tea shrub; used to make tea; "the store shelves held many different kinds of tea"; "they threw the tea into Boston harbor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105951959">
	<b:glossaryEntry>a measured amount of tea in a bag for an individual serving of tea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105952079">
	<b:glossaryEntry>a beverage made by steeping tea leaves in water; "iced tea is a cooling drink"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105952299"
	 b:glossaryEntry="(British) a cup of tea"/>
<rdf:Description rdf:about="&a;105952382"
	 b:glossaryEntry="tea-like drink made of leaves of various herbs"/>
<rdf:Description rdf:about="&a;105952514"
	 b:glossaryEntry="infusion of e.g. dried or fresh flowers or leaves"/>
<rdf:Description rdf:about="&a;105952634"
	 b:glossaryEntry="tea-like drink made from camomile leaves and flowers"/>
<rdf:Description rdf:about="&a;105952764"
	 b:glossaryEntry="strong tea served over ice"/>
<rdf:Description rdf:about="&a;105952855"
	 b:glossaryEntry="fermented tea leaves"/>
<rdf:Description rdf:about="&a;105952967"
	 b:glossaryEntry="black tea grown in China"/>
<rdf:Description rdf:about="&a;105953089">
	<b:glossaryEntry>a superior grade of black tea; grown in India and Sri Lanka and Java</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105953224">
	<b:glossaryEntry>tea leaves that have been steamed and dried without fermenting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105953342">
	<b:glossaryEntry>tea leaves that have been semi-fermented before being dried; grown in China</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105953470">
	<b:glossaryEntry>pure natural water from a stream or brook; often distinguished from soda water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105953607"
	 b:glossaryEntry="water from a spring"/>
<rdf:Description rdf:about="&a;105953685"
	 b:glossaryEntry="water sweetened with sugar"/>
<rdf:Description rdf:about="&a;105953769"
	 b:glossaryEntry="water directly from the spigot"/>
<rdf:Description rdf:about="&a;105953855"
	 b:glossaryEntry="water suitable for drinking"/>
<rdf:Description rdf:about="&a;105954051"
	 b:glossaryEntry="water served ice-cold or with ice"/>
<rdf:Description rdf:about="&a;105954140">
	<b:glossaryEntry>effervescent beverage artificially charged with carbon dioxide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105954337">
	<b:glossaryEntry>water naturally or artificially impregnated with mineral salts or gasses; often effervescent; often used therapeutically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105954571"
	 b:glossaryEntry="naturally effervescent mineral water"/>
<rdf:Description rdf:about="&a;105954661">
	<b:glossaryEntry>sparkling mineral water from springs at Vichy France or similar to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105954788"
	 b:glossaryEntry="a strong solution of salt and water used for pickling"/>
<rdf:Description rdf:about="&a;105954893">
	<b:glossaryEntry>food prepared by cooking and straining or processed in a blender</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105955009"
	 b:glossaryEntry="foods that will decay rapidly if not refrigerated"/>
<rdf:Description rdf:about="&a;105955129">
	<b:glossaryEntry>a cheese dish made with bread and egg crumbs that is baked and served in individual fireproof dishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105955294"
	 b:glossaryEntry="an orderly grouping (of things or persons)"/>
<rdf:Description rdf:about="&a;105955484">
	<b:glossaryEntry>a wandering or disorderly grouping (of things or persons); "a straggle of outbuildings"; "a straggle of followers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105955653"
	 b:glossaryEntry='an orderly arrangement: "an array of troops in battle order"'/>
<rdf:Description rdf:about="&a;105955891"
	 b:glossaryEntry="a group of people or things arranged by class or category"/>
<rdf:Description rdf:about="&a;105956044">
	<b:glossaryEntry>classification into two opposed parts: "the dichotomy between eastern and western culture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105956190">
	<b:glossaryEntry>a group of genetically identical cells or organisms derived from a single cell or individual by some kind of asexual reproduction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105956378"
	 b:glossaryEntry="a basic group of natural objects"/>
<rdf:Description rdf:about="&a;105956482">
	<b:glossaryEntry>one of five biological categories: Monera or Protista or Plantae or Fungi or Animalia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105956784">
	<b:glossaryEntry>(biology) a taxonomic group comprising a major division of a kingdom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105956909">
	<b:glossaryEntry>the taxonomic kingdom comprising all living or extinct plants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105957058">
	<b:glossaryEntry>all inorganic objects; contrasts with animal and plant kingdoms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105957183"
	 b:glossaryEntry="a group of plants or animals"/>
<rdf:Description rdf:about="&a;105957400"
	 b:glossaryEntry="a group of organisms sharing a specific genetic constitution"/>
<rdf:Description rdf:about="&a;105957533">
	<b:glossaryEntry>organisms sharing a specified genotype or the genotype (or peculiarities) so shared</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105957670">
	<b:glossaryEntry>all of the inhabitants of the earth; "all the world loves a lover"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105957883">
	<b:glossaryEntry>(plural) any group of human beings (men or women or children) collectively; "old people"; "there were at least 200 people in the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105958778"
	 b:glossaryEntry="a group people having approximately the same age"/>
<rdf:Description rdf:about="&a;105958932">
	<b:glossaryEntry>people who are old; "special arrangements were available for the aged"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105959071">
	<b:glossaryEntry>young people collectively; "rock music appeals to the young"; "youth everywhere rises in revolt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105959245">
	<b:glossaryEntry xml:space='preserve'><![CDATA[people who are frustrated and perplexed; "the children''s faces clearly expressed the frustration of the baffled"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105959411">
	<b:glossaryEntry>people who have severe visual impairments; "he spent hours reading to the blind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105959562">
	<b:glossaryEntry>people viewed as members of a group; "we need more young blood in this organization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105959698"
	 b:glossaryEntry='people who are brave; "the home of the free and the brave"'/>
<rdf:Description rdf:about="&a;105959826">
	<b:glossaryEntry>people who are fearful and cautious; "whitewater rafting is not for the timid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105959985">
	<b:glossaryEntry>people who are condemned to eternal punishment; "he felt he had visited the realm of the damned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105960134"
	 b:glossaryEntry='people who are no longer living; "they buried the dead"'/>
<rdf:Description rdf:about="&a;105960295"
	 b:glossaryEntry='people who are still living; "save your pity for the living"'/>
<rdf:Description rdf:about="&a;105960426">
	<b:glossaryEntry>people who have severe hearing impairments; "many of the deaf use sign language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105960576">
	<b:glossaryEntry>people who are defeated; "the Romans had no pity for the defeated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105960711"
	 b:glossaryEntry="people who are crippled or otherwise physically handicapped"/>
<rdf:Description rdf:about="&a;105960825">
	<b:glossaryEntry>people who are destined to die soon; "the agony of the doomed was in his voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105960964">
	<b:glossaryEntry>any hostile group of people; "he viewed lawyers as the real enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105961082">
	<b:glossaryEntry xml:space='preserve'><![CDATA[people in general; "they''re just country folk"; "the common people determine the group character and preserve its customs from one generation to the next"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105961376">
	<b:glossaryEntry>the common people at a local level (as distinguished from the centers of political activity)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105961526"
	 b:glossaryEntry='people who are free; "the home of the free and the brave"'/>
<rdf:Description rdf:about="&a;105961648"
	 b:glossaryEntry="folks from your own home town"/>
<rdf:Description rdf:about="&a;105961734"
	 b:glossaryEntry="people who are confined to their homes"/>
<rdf:Description rdf:about="&a;105961847">
	<b:glossaryEntry>people who are homeless; "the homeless lived on the city streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105961967">
	<b:glossaryEntry>people who been introduced to the mysteries of some field or activity; "it is very familiar to the initiate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105962162">
	<b:glossaryEntry>people who have not been introduced to the mysteries of some field or activity; "it diverts the attention of the uninitiate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105962361">
	<b:glossaryEntry>people who are mentally retarded; "he started a school for the mentally retarded"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105962506">
	<b:glossaryEntry>people who have retreated; "he had only contempt for the retreated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105962629">
	<b:glossaryEntry>people who are sick; "they devote their lives to caring for the sick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105962749"
	 b:glossaryEntry="people who have been slain (as in battle)"/>
<rdf:Description rdf:about="&a;105962842">
	<b:glossaryEntry>people who are wounded; "they had to leave the wounded where they fell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105962976"
	 b:glossaryEntry="people sharing some social relation"/>
<rdf:Description rdf:about="&a;105963394"
	 b:glossaryEntry="several things grouped together"/>
<rdf:Description rdf:about="&a;105964766">
	<b:glossaryEntry>the collection of equipment and methods used in the practice of medicine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105964898">
	<b:glossaryEntry>an accumulation of jobs not done or materials not processed that are yet to be dealt with; "a large backlog of orders"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105965070">
	<b:glossaryEntry>a collection of related things intended for use together: "took a battery of achievement tests"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105965257">
	<b:glossaryEntry>a collection of bottles: "her bottle collection is arranged on glass shelves in the wondow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105965412"
	 b:glossaryEntry="a collection of coins"/>
<rdf:Description rdf:about="&a;105965495">
	<b:glossaryEntry>an assemblage of parts or details (as in a work of art) considered as forming a whole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105965651"
	 b:glossaryEntry="tenants of an estate considered as a group"/>
<rdf:Description rdf:about="&a;105965748"
	 b:glossaryEntry="a collection of art works"/>
<rdf:Description rdf:about="&a;105965852"
	 b:glossaryEntry="a number of pictures loaned by their owners for exhibition"/>
<rdf:Description rdf:about="&a;105965972">
	<b:glossaryEntry>any collection in its entirety; "she bought the whole caboodle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105966104"
	 b:glossaryEntry='a collection of writings; "he edited the Hemingway corpus"'/>
<rdf:Description rdf:about="&a;105966215"
	 b:glossaryEntry="a complete collection of similar things"/>
<rdf:Description rdf:about="&a;105966323"
	 b:glossaryEntry="a pack of 52 playing cards"/>
<rdf:Description rdf:about="&a;105966470">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the cards held in a card game by a given player at any given time; "I didn''t hold a good hand all evening"; "he kept trying to see my hand"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105966703"
	 b:glossaryEntry="the cards held in a game of bridge"/>
<rdf:Description rdf:about="&a;105966795"
	 b:glossaryEntry="the 5 cards held in a game of poker"/>
<rdf:Description rdf:about="&a;105966995"
	 b:glossaryEntry="a poker hand with Ace-to-10 in the same suit"/>
<rdf:Description rdf:about="&a;105967097"
	 b:glossaryEntry="a poker hand with consecutive cards in the same suit"/>
<rdf:Description rdf:about="&a;105967210"
	 b:glossaryEntry="a poker hand with 3 of a kind and a pair"/>
<rdf:Description rdf:about="&a;105967307"
	 b:glossaryEntry="a poker hand with all 5 cards in the same suit"/>
<rdf:Description rdf:about="&a;105967405"
	 b:glossaryEntry="a poker hand with 5 consecutive cards (regardless of suit)"/>
<rdf:Description rdf:about="&a;105967518"
	 b:glossaryEntry="a poker hand with 2 cards of the same value"/>
<rdf:Description rdf:about="&a;105967612">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a number or quantity of related things dealt with as a unit; "he reserved a large block of seats"; "he held a large block of the company''s stock"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105967809">
	<b:glossaryEntry>everything that is included in a collection; "he emptied the contents of his pockets"; "the two groups were similar in content"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105967990"
	 b:glossaryEntry="a collection of stamps"/>
<rdf:Description rdf:about="&a;105968075"
	 b:glossaryEntry="statues collectively"/>
<rdf:Description rdf:about="&a;105968150">
	<b:glossaryEntry>the final aggregate; "the sum of all our troubles did not equal the misery they suffered"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105968319"
	 b:glossaryEntry="a jumbled collection or mass"/>
<rdf:Description rdf:about="&a;105968443">
	<b:glossaryEntry>all of the identical copies of something offered to the public at the same time; "the first edition appeared in 1920" or "it was too late for the morning edition" or "they issued a limited edition of Bach recordings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105968713"
	 b:glossaryEntry="a collection of gimmicks"/>
<rdf:Description rdf:about="&a;105968793">
	<b:glossaryEntry>a thick grouping of similar things; "a bunch of trees"; "a cluster of admirers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105969050">
	<b:glossaryEntry>a tight cluster of people or things; "a small knot of women listened to his sermon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105969184"
	 b:glossaryEntry='(informal) a bunch; "a thick swad of plants"'/>
<rdf:Description rdf:about="&a;105969279"
	 b:glossaryEntry="a bunch of hair or feathers or growing grass"/>
<rdf:Description rdf:about="&a;105969420"
	 b:glossaryEntry='a small tuft or lock; "wisps of hair"'/>
<rdf:Description rdf:about="&a;105969508"
	 b:glossaryEntry='a compact mass; "a ball of mud caught him on the shoulder"'/>
<rdf:Description rdf:about="&a;105969690"
	 b:glossaryEntry="a ball of yarn or cord or thread"/>
<rdf:Description rdf:about="&a;105969773"
	 b:glossaryEntry="a collection of objects laid on top of each other"/>
<rdf:Description rdf:about="&a;105970032">
	<b:glossaryEntry>an ill-structured collection of similar things (objects or people)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105970185"
	 b:glossaryEntry="a heap of dung or refuse"/>
<rdf:Description rdf:about="&a;105970295"
	 b:glossaryEntry="an immovable mass of logs blocking a river"/>
<rdf:Description rdf:about="&a;105970390">
	<b:glossaryEntry>a bushy thick mass (especially hair); "he had an unruly shock of black hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105970518"
	 b:glossaryEntry="pile of discarded metal"/>
<rdf:Description rdf:about="&a;105970597">
	<b:glossaryEntry>a pile of sheaves of grain set on end in a field to dry; stalks of Indian corn set up in a field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105970745"
	 b:glossaryEntry="pile of waste matter from coal mining etc"/>
<rdf:Description rdf:about="&a;105970841"
	 b:glossaryEntry="an orderly pile"/>
<rdf:Description rdf:about="&a;105970926"
	 b:glossaryEntry="a stack of hay"/>
<rdf:Description rdf:about="&a;105971030">
	<b:glossaryEntry>a small cone-shaped pile of hay that has been left in the field until it is dry enough to carry to the hayrick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105971194"
	 b:glossaryEntry="wood heaped for burning a dead body as a funeral rite"/>
<rdf:Description rdf:about="&a;105971313"
	 b:glossaryEntry="a pile or stack of wood to be used for fuel"/>
<rdf:Description rdf:about="&a;105971411">
	<b:glossaryEntry>a collection of things that have been combined; an assemblage of separate parts or qualities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105971597">
	<b:glossaryEntry>a combination or blend of diverse things; "his theory is an amalgam of earlier ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105971736">
	<b:glossaryEntry>a planned combination of colors; "the color scheme for this room was determined by an interior decorator"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105971916">
	<b:glossaryEntry>an alliance of people or corporations or countries for a special purpose (formerly to achieve some antisocial end but now for general political or economic purposes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105972157">
	<b:glossaryEntry>any monopoly or contract or combination or conspiracy intended to restrain commerce (which are illegal according to anti-trust laws of the US)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105972379">
	<b:glossaryEntry>a group of persons associated by some common tie or occupation and regarded as an entity; "the whole body filed out of the auditorium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105972960">
	<b:glossaryEntry>a body of people sharing some common interest; "the reading public"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105973080">
	<b:glossaryEntry>people in general; especially a distinctive group of people with some shared interest; "the Western world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105973283">
	<b:glossaryEntry>an extended social group having a distinctive cultural and economic organization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105973473">
	<b:glossaryEntry>a group of people who differ racially or politically from a larger group of which it is a part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105973622">
	<b:glossaryEntry>a body of people who form part of society or economy; "the public sector"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105973804">
	<b:glossaryEntry>business concerns collectively; "Government and business could not agree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105973950">
	<b:glossaryEntry>people of the same race or nationality who share a distinctive culture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105974106">
	<b:glossaryEntry>people who are believed to belong to the same genetic stock; "some biologists doubt that there are important genetic differences between races of human beings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105974460">
	<b:glossaryEntry>a race with skin pigmentation different from the white race (especially Blacks)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105974637">
	<b:glossaryEntry>a race that considers itself superior to all others and fitted to rule the others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105974789">
	<b:glossaryEntry>(usually plural) a social group whose members control some field of activity and who have common aims; "the iron interests stepped up production"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105975024">
	<b:glossaryEntry>an individual or group who are concerned with some particular part of the economy and who try to influence legislators or bureacrats to act in their favor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105975241"
	 b:glossaryEntry="group of people related by blood or marriage"/>
<rdf:Description rdf:about="&a;105975517">
	<b:glossaryEntry>primary social group; parents and children; "he wanted to have a good job before starting a family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105975776">
	<b:glossaryEntry>people descended from a common ancestor; "his family had lived in Masachusetts since the Mayflower"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105976077"
	 b:glossaryEntry='your parents; "he wrote to his folks every day"'/>
<rdf:Description rdf:about="&a;105976176">
	<b:glossaryEntry>members of a family line; "his people have been farmers for generations"; "are your people still alive?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105976333">
	<b:glossaryEntry>the people of your home locality (especially your own family); "he wrote his homefolk every day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105976484"
	 b:glossaryEntry='aristocratic family line; "the House of York"'/>
<rdf:Description rdf:about="&a;105976600"
	 b:glossaryEntry="a sequence of powerful leaders in the same family"/>
<rdf:Description rdf:about="&a;105976721">
	<b:glossaryEntry>family based on male descent; "he had no sons and there was no one to carry on his name"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105976867">
	<b:glossaryEntry>the social system that developed in Europe in the 8th C; vassals were protected by lords who they had to serve in war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977056">
	<b:glossaryEntry>a form of social organization in which a male is the family head and title is traced through the male line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977234">
	<b:glossaryEntry>a form of social organization in which a female is the family head and title is traced through the female line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977416">
	<b:glossaryEntry>a form of social system in which power goes to those with superior intellects</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977551">
	<b:glossaryEntry>the occupants of a building; "the entire building complained about the noise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977683">
	<b:glossaryEntry>a family consisting of parents and their children and grandparents of a marital partner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977849">
	<b:glossaryEntry>a family consisting of the nuclear family and their blood relatives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105977978">
	<b:glossaryEntry>a household in which an orphaned or delinquent child is placed (usually by a social-service agency)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105978135">
	<b:glossaryEntry>people having the same social or economic status; "the working class"; "an emerging professional class"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105978761"
	 b:glossaryEntry="people in the same age range"/>
<rdf:Description rdf:about="&a;105978845"
	 b:glossaryEntry="a group of persons together in one place"/>
<rdf:Description rdf:about="&a;105979656">
	<b:glossaryEntry>a social gathering to carry out some communal task or to hold competitions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105979816"
	 b:glossaryEntry="a gathering of passengers sufficient to fill an automobile"/>
<rdf:Description rdf:about="&a;105979928">
	<b:glossaryEntry>an assemblage of people or animals or things collected together; "a congregation of children pleaded for his autograph"; "a great congregation of birds flew over"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105980149">
	<b:glossaryEntry>a gathering of persons representative of some larger group; "each nation sent a contingent of athletes to the Olympics"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105980325">
	<b:glossaryEntry>the occupants of a floor; "the whole floor complained about the lack of heat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105980454">
	<b:glossaryEntry>a social gathering intended to create goodwill among the participants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105980580"
	 b:glossaryEntry="a gathering to make quilts"/>
<rdf:Description rdf:about="&a;105980665"
	 b:glossaryEntry="two people considered as a unit"/>
<rdf:Description rdf:about="&a;105980765"
	 b:glossaryEntry="historical and literary materials relating to Judaism"/>
<rdf:Description rdf:about="&a;105980872">
	<b:glossaryEntry>(computing) a collection of standard programs and subroutines that are stored and available for immediate use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105981110">
	<b:glossaryEntry>a collection of literary documents or records kept for reference or borrowing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105981295"
	 b:glossaryEntry="a collection of books"/>
<rdf:Description rdf:about="&a;105981374"
	 b:glossaryEntry="a nonprofit library maintained for public use"/>
<rdf:Description rdf:about="&a;105981480">
	<b:glossaryEntry>a collection of books that can be rented by readers in return for a small daily fee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105981627">
	<b:glossaryEntry>myths collectively; the body of stories associated with a culture or institution or person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105981828">
	<b:glossaryEntry>the system of mythology of the Greeks and Roman together; much of Roman mythology (especially the gods) was borrowed from the Greeks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105982062"
	 b:glossaryEntry="the mythology of the ancient Greeks"/>
<rdf:Description rdf:about="&a;105982159"
	 b:glossaryEntry="the mythology of the ancient Romans"/>
<rdf:Description rdf:about="&a;105982256">
	<b:glossaryEntry>the mythology of Scandinavia (shared in part by Britain and Germany) until the establishment of Christianity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105982426"
	 b:glossaryEntry="a set containing a single member"/>
<rdf:Description rdf:about="&a;105982514"
	 b:glossaryEntry="a set of two similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105982639">
	<b:glossaryEntry>two or more draft animals that work together to pull a vehicle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105982753">
	<b:glossaryEntry>a pair who associate with one another; "the engaged couple"; "an inseprable twosome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105982913">
	<b:glossaryEntry>a set of three literary or dramatic works related in subject or theme</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105983036">
	<b:glossaryEntry>the people who are present in a room; "the whole room was cheering"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105983154"
	 b:glossaryEntry="three people considered as a unit"/>
<rdf:Description rdf:about="&a;105983286"
	 b:glossaryEntry="a set of three similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105983441"
	 b:glossaryEntry="the triad of divinities of later Hinduism"/>
<rdf:Description rdf:about="&a;105983594">
	<b:glossaryEntry>a group of three men responsible for public administration or civil authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105983747"
	 b:glossaryEntry="a modern Russian triumvirate"/>
<rdf:Description rdf:about="&a;105983828">
	<b:glossaryEntry>the group that gathers together for a particular occasion; "a large turnout for the meeting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105983974">
	<b:glossaryEntry>four people considered as a unit; "he joined a barbershop quartet"; "the foursome teed off before 9 a.m."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105984174"
	 b:glossaryEntry="five people considered as a unit"/>
<rdf:Description rdf:about="&a;105984283"
	 b:glossaryEntry="six people considered as a unit"/>
<rdf:Description rdf:about="&a;105984388"
	 b:glossaryEntry="seven people considered as a unit"/>
<rdf:Description rdf:about="&a;105984497"
	 b:glossaryEntry="eight people considered as a unit"/>
<rdf:Description rdf:about="&a;105984604"
	 b:glossaryEntry="a group of four men"/>
<rdf:Description rdf:about="&a;105984683"
	 b:glossaryEntry="a set of four similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105984811"
	 b:glossaryEntry="a set of five similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105984926"
	 b:glossaryEntry="a set of six similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105985047"
	 b:glossaryEntry="a set of seven similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105985161"
	 b:glossaryEntry="a set of eight similar things considered as a unit"/>
<rdf:Description rdf:about="&a;105985273"
	 b:glossaryEntry="any two people who are hard to tell apart"/>
<rdf:Description rdf:about="&a;105985414">
	<b:glossaryEntry>a pair of people who live together; "a married couple from Chicago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105985550">
	<b:glossaryEntry>two people who are married to each other; "his second marriage was happier than the first"; "a married couple without love"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105985779"
	 b:glossaryEntry="the young of an animal cared for at one time"/>
<rdf:Description rdf:about="&a;105985893"
	 b:glossaryEntry="a group of birds"/>
<rdf:Description rdf:about="&a;105986088"
	 b:glossaryEntry="a group of sheep or goats"/>
<rdf:Description rdf:about="&a;105986184"
	 b:glossaryEntry="a church congregation guided by a pastor"/>
<rdf:Description rdf:about="&a;105986276">
	<b:glossaryEntry>a group of people who adhere to a common faith and habitually attend a given church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105986473"
	 b:glossaryEntry="a flock of quail"/>
<rdf:Description rdf:about="&a;105986559"
	 b:glossaryEntry="a flock of coots"/>
<rdf:Description rdf:about="&a;105986647"
	 b:glossaryEntry="a small flock of grouse or partridge"/>
<rdf:Description rdf:about="&a;105986773"
	 b:glossaryEntry="a flock of geese"/>
<rdf:Description rdf:about="&a;105986861"
	 b:glossaryEntry="a flock of snipe"/>
<rdf:Description rdf:about="&a;105986947">
	<b:glossaryEntry>a group of biological taxa or species that share features inherited from a common ancestor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105987089"
	 b:glossaryEntry="animal or plant group having natural relations"/>
<rdf:Description rdf:about="&a;105987709"
	 b:glossaryEntry="all the plant and animal life of a particular region"/>
<rdf:Description rdf:about="&a;105987861"
	 b:glossaryEntry="all the animal life in a particular region"/>
<rdf:Description rdf:about="&a;105988029"
	 b:glossaryEntry="the birds of a particular region or period"/>
<rdf:Description rdf:about="&a;105988126">
	<b:glossaryEntry>all living things (except people) that are undomesticated; "chemicals could kill all the wildlife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105988279"
	 b:glossaryEntry="a group of animals"/>
<rdf:Description rdf:about="&a;105988699">
	<b:glossaryEntry>a group of cattle or sheep or other domestic mammals all of the same kind that are herded by humans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105988905">
	<b:glossaryEntry>a group of wild animals of one species that remain together: antelope or elephants or seals or whales or zebra</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105989066">
	<b:glossaryEntry>the herd of horses from which those to be used the next day are chosen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105989189"
	 b:glossaryEntry="a group of hunting animals"/>
<rdf:Description rdf:about="&a;105989322"
	 b:glossaryEntry="a group of wolves hunting together"/>
<rdf:Description rdf:about="&a;105989412"
	 b:glossaryEntry="a group of aquatic mammals"/>
<rdf:Description rdf:about="&a;105989526"
	 b:glossaryEntry="a group of lions"/>
<rdf:Description rdf:about="&a;105989613"
	 b:glossaryEntry="a group of cats"/>
<rdf:Description rdf:about="&a;105989701">
	<b:glossaryEntry>a large group of fish; "a school of small glittering fish swam by"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105989847"
	 b:glossaryEntry="a group of animals of the same type living together"/>
<rdf:Description rdf:about="&a;105989951">
	<b:glossaryEntry>(microbiology) a group of organisms grown from a single parent cell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105990071"
	 b:glossaryEntry="a group of insects"/>
<rdf:Description rdf:about="&a;105990160"
	 b:glossaryEntry="a colony of rabbits"/>
<rdf:Description rdf:about="&a;105990251">
	<b:glossaryEntry>a group of things of the same kind that belong together and are so used: "a set of books"; "a set of golf clubs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105990810"
	 b:glossaryEntry="a set of 32 chessmen"/>
<rdf:Description rdf:about="&a;105990886">
	<b:glossaryEntry>collection of materials of or characteristic of the Victorian era</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105991008">
	<b:glossaryEntry>a collection of things sharing a common attribute; "there are two classes of detergents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105991331"
	 b:glossaryEntry='a type or class; "more men of his stamp are needed"'/>
<rdf:Description rdf:about="&a;105991434">
	<b:glossaryEntry>a set containing all and only the members of two or more given sets; "let C be the union of the sets A and B"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105991626">
	<b:glossaryEntry>a union of two disjoint sets in which every element is the sum of an element from each of the disjoint sets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105991790">
	<b:glossaryEntry>the set of elements common to two or more sets; "the set of red hats is the intersection of the set of hats and the set of red things"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105991993">
	<b:glossaryEntry>either of the two categories (male or female) into which most organisms are divided; "the war between the sexes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105992155">
	<b:glossaryEntry>all the competitors in a particular contest or sporting event</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105992268"
	 b:glossaryEntry="(horse racing) all of the horses in a particular race"/>
<rdf:Description rdf:about="&a;105992373">
	<b:glossaryEntry>an abstract collection of numbers or symbols; "the set of prime numbers is infinite"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105992669"
	 b:glossaryEntry="a distinct and often subordinate group within a group"/>
<rdf:Description rdf:about="&a;105992777">
	<b:glossaryEntry>a set whose members are members of another set; a set contained within another set</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105992912"
	 b:glossaryEntry="a set that is empty; a set with no members"/>
<rdf:Description rdf:about="&a;105993009">
	<b:glossaryEntry>(mathematics) any set of points that satisfy a set of postulates of some kind; "assume the vector space is finite dimensional"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105993261"
	 b:glossaryEntry="a company that manages tv or radio stations"/>
<rdf:Description rdf:about="&a;105993371"
	 b:glossaryEntry="a company that makes and sells automobiles"/>
<rdf:Description rdf:about="&a;105993486"
	 b:glossaryEntry="a company that makes and sells pharmaceuticals"/>
<rdf:Description rdf:about="&a;105993591"
	 b:glossaryEntry="a company that makes and sells electronic instruments"/>
<rdf:Description rdf:about="&a;105993729"
	 b:glossaryEntry="a company that processes and sells food"/>
<rdf:Description rdf:about="&a;105993827"
	 b:glossaryEntry="a company that sells furniture"/>
<rdf:Description rdf:about="&a;105993921"
	 b:glossaryEntry="a company that owns and manages mines"/>
<rdf:Description rdf:about="&a;105994019"
	 b:glossaryEntry="a company that provides shipping services"/>
<rdf:Description rdf:about="&a;105994141"
	 b:glossaryEntry="a company that makes and sells steel"/>
<rdf:Description rdf:about="&a;105994237"
	 b:glossaryEntry="a company that is completely controlled by another company"/>
<rdf:Description rdf:about="&a;105994373"
	 b:glossaryEntry="a company providing transportation"/>
<rdf:Description rdf:about="&a;105994494"
	 b:glossaryEntry="a company that ships goods or possessions by truck"/>
<rdf:Description rdf:about="&a;105994626"
	 b:glossaryEntry="a space that is contained within another space"/>
<rdf:Description rdf:about="&a;105994727"
	 b:glossaryEntry="a space that contains no points; and empty space"/>
<rdf:Description rdf:about="&a;105994832">
	<b:glossaryEntry>a set of points such that for every pair of points there is a nonnegative real number called their distance that is symmetric and satisfies the triangle inequality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105995090">
	<b:glossaryEntry>a space in which Euclid''s axioms and definitions apply; a metric space that is linear and finite-dimensional</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105995260">
	<b:glossaryEntry>a metric space that is linear and complete and (usually) infinite-dimensional</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105995397">
	<b:glossaryEntry>a set of elements such that addition and multiplication are commutative and associative and multiplication is distributive over addition and there are two elements 0 and 1; "the set of all rational numbers is a field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105995684"
	 b:glossaryEntry="a field of scalars"/>
<rdf:Description rdf:about="&a;105995761">
	<b:glossaryEntry>the set of values that give a true statement when substituted into an equation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105995901"
	 b:glossaryEntry="a category falling within certain defined limits"/>
<rdf:Description rdf:about="&a;105996039"
	 b:glossaryEntry="a category of taxpayers based on the amount of their income"/>
<rdf:Description rdf:about="&a;105996194"
	 b:glossaryEntry="a category of merchandise based on their price"/>
<rdf:Description rdf:about="&a;105996300">
	<b:glossaryEntry>a class of nouns having the same inflectional forms: "the first declension in Latin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105996441">
	<b:glossaryEntry>the complete set of inflected forms of a noun or pronoun or adjective</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105996567"
	 b:glossaryEntry="a class of verbs having the same inflectional forms"/>
<rdf:Description rdf:about="&a;105996676"
	 b:glossaryEntry="the complete set of inflected forms of a verb"/>
<rdf:Description rdf:about="&a;105996779"
	 b:glossaryEntry="a miscellaneous collection of things sold together"/>
<rdf:Description rdf:about="&a;105996883"
	 b:glossaryEntry="a matching set of furniture"/>
<rdf:Description rdf:about="&a;105997016"
	 b:glossaryEntry="a suite of furniture for the bedroom"/>
<rdf:Description rdf:about="&a;105997126"
	 b:glossaryEntry="a suite of furniture for the diningroom"/>
<rdf:Description rdf:about="&a;105997245"
	 b:glossaryEntry="a suite of furniture for the livingroom"/>
<rdf:Description rdf:about="&a;105997364"
	 b:glossaryEntry="a collection of things wrapped or boxed together"/>
<rdf:Description rdf:about="&a;105997511"
	 b:glossaryEntry="a small bundle of straw or hay"/>
<rdf:Description rdf:about="&a;105997592"
	 b:glossaryEntry="a group of people who work together"/>
<rdf:Description rdf:about="&a;105998351">
	<b:glossaryEntry>an international organization that provides a support group for persons trying to overcome alcoholism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105998524">
	<b:glossaryEntry>a militant organization of Irish nationalists who use guerrilla warfare in an effort to achieve a united independent Ireland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105998735">
	<b:glossaryEntry>an international organization that cares for the sick or wounded or homeless in wartime</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105998878">
	<b:glossaryEntry>a charitable and religious organization to evangelize and to care for the poor and homeless</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105999030">
	<b:glossaryEntry>a political organization in New York city (late 1800''s and early 1900''s) seeking political control by corruption and bossism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105999241">
	<b:glossaryEntry>any organization whose responsibility it is to defend against something; "police are the major line of defense against crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105999428">
	<b:glossaryEntry>the organizational structure of activities contributing directly to the organization''s output</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105999585">
	<b:glossaryEntry>a formal organization of people; "he joined the Modern Language Association"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106000009">
	<b:glossaryEntry>an association of nations consisting of the United Kingdom and its dependencies and many former British colonies that are now sovereign states but owe allegiance to the British Crown</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106000284"
	 b:glossaryEntry="a politically organized unit"/>
<rdf:Description rdf:about="&a;106000383">
	<b:glossaryEntry>the organization that is the governing authority of a political unit; "the government reduced taxes"; "the matter was referred to higher authorities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106000944">
	<b:glossaryEntry>a political and social system that no longer governs (especially the system that existed in France before the French Revolution)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106001132">
	<b:glossaryEntry>the sovereign and his advisers who are the governing power of a state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106001253">
	<b:glossaryEntry>a group of countries under a single authority: "the Roman empire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106001371"
	 b:glossaryEntry="a government with strong central powers"/>
<rdf:Description rdf:about="&a;106001530">
	<b:glossaryEntry>a temporary government moved to or formed in a foreign land by exiles who hope to rule when their country is liberated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106001714"
	 b:glossaryEntry="the government of a local area"/>
<rdf:Description rdf:about="&a;106001843">
	<b:glossaryEntry>the governing group of a kingdom; "the palace issued an order binding on all subjects"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106001982"
	 b:glossaryEntry="the government of the Roman Catholic Church"/>
<rdf:Description rdf:about="&a;106002111">
	<b:glossaryEntry>the government (political and military) of the Soviet Union; "the Soviets said they wanted to increase trade with Europe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106002286"
	 b:glossaryEntry="an organization founded and united for a specific purpose"/>
<rdf:Description rdf:about="&a;106002579"
	 b:glossaryEntry="an institution created for the practice of medicine"/>
<rdf:Description rdf:about="&a;106002732">
	<b:glossaryEntry>a medical establishment run by a group of medical specialists</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106002864">
	<b:glossaryEntry>a medical institution where sick or injured people are given medical or surgical care</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106003023"
	 b:glossaryEntry="a clinic where specialist care for a patient''s eyes"/>
<rdf:Description rdf:about="&a;106003131">
	<b:glossaryEntry>an institution (public or private) that collects funds (from the public or other institutions) and invests them in financial assets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106003535">
	<b:glossaryEntry>an institution that issues something (securities or publications or currency etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106003670">
	<b:glossaryEntry>a British financial system in which a bank or a post office transfers money from one account to another when they receive authorization to do so</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106003865">
	<b:glossaryEntry>a central collection place where banks exchange checks or drafts; participants maintain an account against which credits or debits are posted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106004067"
	 b:glossaryEntry="a financial institution that makes loans"/>
<rdf:Description rdf:about="&a;106004173"
	 b:glossaryEntry="an institution set up to provide help to the needy"/>
<rdf:Description rdf:about="&a;106004313">
	<b:glossaryEntry>a charity supported by individual subscriptions; defrays the demands on a community for social welfare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106004477"
	 b:glossaryEntry="a place where food is dispensed to the needy"/>
<rdf:Description rdf:about="&a;106004580">
	<b:glossaryEntry>an organization created for business ventures; "a growing enterprise must have a bold leader"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106004802"
	 b:glossaryEntry='an unusually large enterprise; "Walton built a retail giant"'/>
<rdf:Description rdf:about="&a;106004914"
	 b:glossaryEntry="members of a cooperative enterprise"/>
<rdf:Description rdf:about="&a;106005024"
	 b:glossaryEntry="a farm operated collectively"/>
<rdf:Description rdf:about="&a;106005150">
	<b:glossaryEntry>(Israel) a collective farm owned by its members; children are reared collectively</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106005304"
	 b:glossaryEntry="(USSR) a collective farm owned by the communist state"/>
<rdf:Description rdf:about="&a;106005430"
	 b:glossaryEntry="a business that serves other businesses"/>
<rdf:Description rdf:about="&a;106005684">
	<b:glossaryEntry>the business of a broker; charges a fee to arrange a contract between two parties</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106005839">
	<b:glossaryEntry>a person or firm in the business of transporting people or goods or messages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106006004">
	<b:glossaryEntry>a number of similar establishments (stores or restaurants or banks or hotels or theaters) under one ownership</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106006256">
	<b:glossaryEntry>an institution created to conduct business; "he only invests in large well-established companies"; "he started the company in his garage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106006951"
	 b:glossaryEntry="a group of companies run as a single organization"/>
<rdf:Description rdf:about="&a;106007068">
	<b:glossaryEntry>a business whose articles of incorporation have been approved in some state</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106007316">
	<b:glossaryEntry>members of a business organization; "he worked for a brokerage house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106007568">
	<b:glossaryEntry>a business established or operated under an authorization to sell or distribute a company''s goods or services in a particular area</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106007767"
	 b:glossaryEntry="a business engaged in manufacturing some product"/>
<rdf:Description rdf:about="&a;106007961"
	 b:glossaryEntry="the members of a business venture created by contract"/>
<rdf:Description rdf:about="&a;106008090">
	<b:glossaryEntry>a partnership in which employees get a share of the profits in addition to their wages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106008236">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a commercial or industrial enterprise and the people who constitute it; "he bought his brother''s business"; "a small mom-and-pop business"; "a racially integrated business concern"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106008759"
	 b:glossaryEntry="a chain of clothing stores"/>
<rdf:Description rdf:about="&a;106008845"
	 b:glossaryEntry="a chain of discount stores"/>
<rdf:Description rdf:about="&a;106008951"
	 b:glossaryEntry="a chain of restaurants"/>
<rdf:Description rdf:about="&a;106009055"
	 b:glossaryEntry="a chain of retail stores"/>
<rdf:Description rdf:about="&a;106009157">
	<b:glossaryEntry>a firm of accountants who provide accounting and auditing services for a fee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106009295">
	<b:glossaryEntry>a firm of experts providing professional advice to an organization for a fee</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106009454"
	 b:glossaryEntry="a firm in the publishing business"/>
<rdf:Description rdf:about="&a;106009637">
	<b:glossaryEntry>a business firm that publishes newspapers; "Murdoch owns many newspapers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106009796">
	<b:glossaryEntry>a business firm that publishes magazines; "he works for a magazine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106009939"
	 b:glossaryEntry="a firm engaged in trading"/>
<rdf:Description rdf:about="&a;106010089"
	 b:glossaryEntry="a firm that sells and buys cars"/>
<rdf:Description rdf:about="&a;106010177"
	 b:glossaryEntry="a firm that sells and buys computers"/>
<rdf:Description rdf:about="&a;106010275"
	 b:glossaryEntry="a firm that sells and buys jewelry"/>
<rdf:Description rdf:about="&a;106010386"
	 b:glossaryEntry="a firm that sells and buys trucks"/>
<rdf:Description rdf:about="&a;106010478"
	 b:glossaryEntry="a firm of lawyers"/>
<rdf:Description rdf:about="&a;106010550">
	<b:glossaryEntry>an organization of defenders that provides resistance against attack; "he joined the defense against invasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106010742">
	<b:glossaryEntry>a group that defends a principle; "a bastion against corruption"; "the last bastion of communism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106010893">
	<b:glossaryEntry>the defendant and his legal advisors collectively; "the defense called for a mistrial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106011094">
	<b:glossaryEntry>the lawyers acting for the state to put the case against the defendant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106011240"
	 b:glossaryEntry="an enterprise connected with commerce"/>
<rdf:Description rdf:about="&a;106011363">
	<b:glossaryEntry>the people engaged in a particular kind of commercial enterprise; "each industry has its own trade publications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106011980">
	<b:glossaryEntry>a business engaged in processing agricultural products and preparing them for market</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106012120"
	 b:glossaryEntry="a manufacturer of firearms"/>
<rdf:Description rdf:about="&a;106012211"
	 b:glossaryEntry="a manufacturer of aluminum"/>
<rdf:Description rdf:about="&a;106012321"
	 b:glossaryEntry="a maker and seller of fashionable clothing"/>
<rdf:Description rdf:about="&a;106012464"
	 b:glossaryEntry="a business engaged in the manufacture of automobiles"/>
<rdf:Description rdf:about="&a;106012643"
	 b:glossaryEntry="a business that manufactures and sells computers"/>
<rdf:Description rdf:about="&a;106012755"
	 b:glossaryEntry="a manufacturer of automobiles"/>
<rdf:Description rdf:about="&a;106012869"
	 b:glossaryEntry="a manufacturer of chemicals"/>
<rdf:Description rdf:about="&a;106012960"
	 b:glossaryEntry="a producer of coal"/>
<rdf:Description rdf:about="&a;106013038"
	 b:glossaryEntry="a manufacturer of computers"/>
<rdf:Description rdf:about="&a;106013129"
	 b:glossaryEntry="a building of housing"/>
<rdf:Description rdf:about="&a;106013237"
	 b:glossaryEntry="a manufacturer of electronic products"/>
<rdf:Description rdf:about="&a;106013360">
	<b:glossaryEntry>those involved in providing entertainment: radio and television and films and theater</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106013560"
	 b:glossaryEntry="those involved in producing and distributing movies"/>
<rdf:Description rdf:about="&a;106013719"
	 b:glossaryEntry="an industry that is growing rapidly"/>
<rdf:Description rdf:about="&a;106013816">
	<b:glossaryEntry>an industry devoted to manufacturing and selling and installing lighting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106013952"
	 b:glossaryEntry="an industry that manufacturers weapons of war"/>
<rdf:Description rdf:about="&a;106014078"
	 b:glossaryEntry="an industry that produces and delivers oil and oil products"/>
<rdf:Description rdf:about="&a;106014269"
	 b:glossaryEntry="a company that sells oil"/>
<rdf:Description rdf:about="&a;106014370">
	<b:glossaryEntry>a company that packages goods for sale or shipment or storage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106014515"
	 b:glossaryEntry="a company that operates oil pipelines for the oil industry"/>
<rdf:Description rdf:about="&a;106014655"
	 b:glossaryEntry="a company that does commercial printing"/>
<rdf:Description rdf:about="&a;106014796"
	 b:glossaryEntry="an industry that manufactures plastic articles"/>
<rdf:Description rdf:about="&a;106014906">
	<b:glossaryEntry>a stock broker''s business; charges a fee to act as intermediary between buyer and seller</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106015140"
	 b:glossaryEntry="an unethical or overly aggressive brokerage firm"/>
<rdf:Description rdf:about="&a;106015246"
	 b:glossaryEntry="a brokerage firm dealing in commodities"/>
<rdf:Description rdf:about="&a;106015351"
	 b:glossaryEntry="a business that arranges marriage contracts"/>
<rdf:Description rdf:about="&a;106015475"
	 b:glossaryEntry="a financial institution that sells insurance"/>
<rdf:Description rdf:about="&a;106015634">
	<b:glossaryEntry>a financial institution that collects regular contributions from employers to provide retirement income for employees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106015810">
	<b:glossaryEntry>a financial institution that sells shares to individuals and invests in securities issued by other companies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106016135">
	<b:glossaryEntry>a flexible investment company for a small number of large investors (usually the minimum investment is $1 million); can use high-risk techniques (not allowed for mutual funds) such a short-selling and heavy leveraging</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106016409">
	<b:glossaryEntry>a regulated investment company that regularly sells and redeems its shares</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106016605">
	<b:glossaryEntry>a mutual fund that invests in the stocks that are the basis of a well-known stock or bond index</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106016757">
	<b:glossaryEntry>a regulated investment company that issues a fixed number of shares which are listed on a stock market</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106016953">
	<b:glossaryEntry>a regulated investment company that pays a stated amount to certificate holders on a stated maturity date</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106017136">
	<b:glossaryEntry>a regulated investment company consisting of professional managers who issue redeemable securities representing a portfolio of many different securities; "you can invest in a unit investment trust for as little as $1000"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106017424">
	<b:glossaryEntry>the securities markets in the aggregate; "the market always frustates the small investor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106017680"
	 b:glossaryEntry="a market characterized by falling prices for securities"/>
<rdf:Description rdf:about="&a;106017793"
	 b:glossaryEntry="a market characterized by rising prices for securities"/>
<rdf:Description rdf:about="&a;106017905"
	 b:glossaryEntry="a market for short-term debt instruments"/>
<rdf:Description rdf:about="&a;106018004"
	 b:glossaryEntry="an industry that provides services"/>
<rdf:Description rdf:about="&a;106018101"
	 b:glossaryEntry="a business that builds and repairs ships"/>
<rdf:Description rdf:about="&a;106018218"
	 b:glossaryEntry="an industry that builds ships"/>
<rdf:Description rdf:about="&a;106018334"
	 b:glossaryEntry="an industry that manufactures and sells shoes"/>
<rdf:Description rdf:about="&a;106018439"
	 b:glossaryEntry="an industry that produces signs"/>
<rdf:Description rdf:about="&a;106018530"
	 b:glossaryEntry="the industry that makes steel and steel products"/>
<rdf:Description rdf:about="&a;106018639">
	<b:glossaryEntry>an industry that manufactures and sells products containing tobacco</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106018769"
	 b:glossaryEntry="an industry that manufactures and sells toys for children"/>
<rdf:Description rdf:about="&a;106018900">
	<b:glossaryEntry>an industry that provides transportation for commercial products</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106019047"
	 b:glossaryEntry="the class of people engaged in growing food"/>
<rdf:Description rdf:about="&a;106019148">
	<b:glossaryEntry>people engaged in a particular occupation; "the medical fraternity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106019335"
	 b:glossaryEntry="any large organization"/>
<rdf:Description rdf:about="&a;106019417">
	<b:glossaryEntry>a company that invests in (acquires control of) other companies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106019563">
	<b:glossaryEntry>a company that has been chosen as attractive for takeover by a potential acquirer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106019741">
	<b:glossaryEntry>a corporate investor who intends to take over a company by buying a controlling interest in its stock and installing new management</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106019925">
	<b:glossaryEntry>a potential takeover target that has not yet been put in play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106020048"
	 b:glossaryEntry="a company that is a friendly acquirer in a takeover"/>
<rdf:Description rdf:about="&a;106020176"
	 b:glossaryEntry="a white knight that buys less than a majority interest"/>
<rdf:Description rdf:about="&a;106020289"
	 b:glossaryEntry="a firm that conducts auctions"/>
<rdf:Description rdf:about="&a;106020378"
	 b:glossaryEntry="a unit composed of the pitcher and catcher"/>
<rdf:Description rdf:about="&a;106020493"
	 b:glossaryEntry="a unit with administrative responsibilities"/>
<rdf:Description rdf:about="&a;106020728">
	<b:glossaryEntry>a unit of firefighters including their equipment: "a hook-and-ladder company"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106020859">
	<b:glossaryEntry>a hospital unit specially staffed and equipped to treat patients with serious cardiac problems</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106021037">
	<b:glossaryEntry>a social unit living together; "he moved his family to Virginia"; "It was a good Christian household"; "I waited until the whole house was asleep"; "the teacher asked how many people made up his home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106021380">
	<b:glossaryEntry>a mobile group of trained people (police or executives or officials) able to move quickly in the case of emergencies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106021555"
	 b:glossaryEntry="a team that plays in a major league"/>
<rdf:Description rdf:about="&a;106021712"
	 b:glossaryEntry="a team that plays in a minor league"/>
<rdf:Description rdf:about="&a;106021887">
	<b:glossaryEntry>a minor-league team that is owned by a major-league team (especially in baseball)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106022036"
	 b:glossaryEntry="a team that plays baseball"/>
<rdf:Description rdf:about="&a;106022330">
	<b:glossaryEntry>a team of professional baseball players who play and travel together; "each club played six home games with teams in its own division"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106022569"
	 b:glossaryEntry="a team that plays basketball"/>
<rdf:Description rdf:about="&a;106022742"
	 b:glossaryEntry="a team that plays football"/>
<rdf:Description rdf:about="&a;106023065"
	 b:glossaryEntry="a team that plays ice hockey"/>
<rdf:Description rdf:about="&a;106023189"
	 b:glossaryEntry="a team representing a college or university"/>
<rdf:Description rdf:about="&a;106023299"
	 b:glossaryEntry="a team considered to be the best of its class"/>
<rdf:Description rdf:about="&a;106023401"
	 b:glossaryEntry="the team that has the ball (or puck) and is trying to score"/>
<rdf:Description rdf:about="&a;106023532">
	<b:glossaryEntry>the team that is trying to prevent the other team from scoring; "his teams are always good on defense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106023733">
	<b:glossaryEntry>institution to express belief in a divine power; "he was raised in the Baptist religion"; "a member of his own faith contradicted him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106024128">
	<b:glossaryEntry>the collective body of Christians throughout the world and history; "for a thousand years the Roman Catholic Church was the principal church of Christendom"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106024357">
	<b:glossaryEntry>a group of Christians; any group professing Christian doctrine or belief; "church is a biblical term for assembly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106024631">
	<b:glossaryEntry>any of several churches claiming to have maintained historical continuity with the original Christian Church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106024910">
	<b:glossaryEntry>the Christian Church based in the Vatican and presided over by a pope and an episcopal hierarchy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106025216"
	 b:glossaryEntry="the leadership of the Roman Catholic Church"/>
<rdf:Description rdf:about="&a;106025329">
	<b:glossaryEntry>(Roman Catholic Church) the body of cardinals who advise the Pope and elect new Popes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106025513">
	<b:glossaryEntry>Catholic churches that broke away from the Roman Catholic Church in the 18th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106025682"
	 b:glossaryEntry="the Catholic Church of the Byzantine Empire"/>
<rdf:Description rdf:about="&a;106025805">
	<b:glossaryEntry>derived from the Byzantine Church and adhering to Byzantine rites</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106026038">
	<b:glossaryEntry>state church of Greece; an autonomous part of the Eastern Orthodox Church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106026213">
	<b:glossaryEntry>independent with its own Patriarch of Moscow; until 1917 the established church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106026362">
	<b:glossaryEntry>any of several Eastern churches acknowledging papal authority but retaining their own rites and canon law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106026561"
	 b:glossaryEntry="the ancient Christian church of Egypt"/>
<rdf:Description rdf:about="&a;106026677">
	<b:glossaryEntry>any fundamentalist Protestant church that uses revivalistic methods to achieve experiences comparable to the Pentecostal experiences of the first Christian disciples</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106026928"
	 b:glossaryEntry="the Protestant churches and denominations collectively"/>
<rdf:Description rdf:about="&a;106027115">
	<b:glossaryEntry>a Protestant church that accepts the Bible as the only source of true Christian faith and practices baptism by immersion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106027320">
	<b:glossaryEntry>the national church of England (and all other churches in other countries that share its beliefs); has its see in Canterbury and the Sovereign as its temporal head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106027678"
	 b:glossaryEntry="US church in communication with the see of Canterbury"/>
<rdf:Description rdf:about="&a;106027843"
	 b:glossaryEntry="autonomous branch of the Church of England in Ireland"/>
<rdf:Description rdf:about="&a;106027960"
	 b:glossaryEntry="autonomous branch; Scotland"/>
<rdf:Description rdf:about="&a;106028050">
	<b:glossaryEntry>a group in the Anglican Church that emphasizes the Catholic tradition (especially in sacraments and rituals and obedience to church authority)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106028273">
	<b:glossaryEntry>church founded by Joseph Smith in 1830 with headquarters in Salt Lake City Utah</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106028487">
	<b:glossaryEntry>any of various evangelical Protestant churches that believe in the baptism of voluntary believers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106028675"
	 b:glossaryEntry="group of Baptist congregations"/>
<rdf:Description rdf:about="&a;106028826"
	 b:glossaryEntry="an association of Northern Baptists"/>
<rdf:Description rdf:about="&a;106028965"
	 b:glossaryEntry="an association of Southern Baptists"/>
<rdf:Description rdf:about="&a;106029074">
	<b:glossaryEntry>group of Baptist congregations believing the teachings of the Dutch theologian Jacobus Arminius (who opposed the doctrine of strict predestination of the Calvinists)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106029320">
	<b:glossaryEntry>group of Baptist congregations believing the teachings of the French theologian John Calvin who believed in strict predetermination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106029538">
	<b:glossaryEntry>German-American Baptist denomination founded in 1708; opposed to military service and taking legal oaths; practiced trine immersion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106029795"
	 b:glossaryEntry="founded by Mary Baker Eddy in 1866"/>
<rdf:Description rdf:about="&a;106029941">
	<b:glossaryEntry>a Protestant denomination holding that each individual congregation should be self-governing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106030120"
	 b:glossaryEntry="merger of the Congregational Church and the Christian Church"/>
<rdf:Description rdf:about="&a;106030258">
	<b:glossaryEntry>merger of the Congregational Christian Church and the Evangelical and Reformed Church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106030413"
	 b:glossaryEntry="founded in US in late 19th century"/>
<rdf:Description rdf:about="&a;106030532">
	<b:glossaryEntry>the Protestant denomination adhering to the views of Martin Luther</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106030679">
	<b:glossaryEntry>the Protestant denomination adhering to the views of John Calvin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106030828">
	<b:glossaryEntry>the Protestant denomination that rejects the doctrine of the Trinity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106030978">
	<b:glossaryEntry>the Protestant denomination adhering to the views of Jacobus Arminius</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106031128">
	<b:glossaryEntry>a deriving founded on the principles of John and Charles Wesley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106031304"
	 b:glossaryEntry="original Methodist Church"/>
<rdf:Description rdf:about="&a;106031442">
	<b:glossaryEntry>union of the Methodist Church and the Evangelical United Brethren</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106031577">
	<b:glossaryEntry>a Protestant sect denying infant baptism and baptising only believers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106031735">
	<b:glossaryEntry>formed from the Anabaptist movement in the 16th century; noted for its simplicity of life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106031906">
	<b:glossaryEntry>an orthodox Anabaptist sect separated from the Mennonites in late 17th century; settled chiefly in SE Pennsylvania</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106032096">
	<b:glossaryEntry>Jews who practice a religion based on the Old Testament and the Talmud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106032322">
	<b:glossaryEntry>Jews who strictly observe the Mosaic Law as interpreted in the Talmud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106032473">
	<b:glossaryEntry>Jews who keep some of the requirements of the Mosaic Law but allow for adaptation of other requirements (as some of the dietary laws) to fit modern circumstances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106032701">
	<b:glossaryEntry>the most liberal Jews; Jews who do not follow the Talmud strictly but try to adapt all of the historical forms of Judaism to the modern world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106032903">
	<b:glossaryEntry>Muslims collectively and their civilization; based on a monotheistic religion believing that Mohammed was the last and major prophet of God; "the term Mohammedanism is offensive to Muslims"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106033254">
	<b:glossaryEntry>one of the two main branches of orthodox Islam; mainly in Iran</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106033422"
	 b:glossaryEntry="one of the two main branches of orthodox Islam"/>
<rdf:Description rdf:about="&a;106033539">
	<b:glossaryEntry>the dominant religion of India; characterized by a caste system and belief in reincarnation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106033810"
	 b:glossaryEntry="the religious and social system of orthodox Hinduism"/>
<rdf:Description rdf:about="&a;106033932"
	 b:glossaryEntry="a Hindu sect worshiping Shiva"/>
<rdf:Description rdf:about="&a;106034064"
	 b:glossaryEntry="a Hindu sect worshiping Shakti"/>
<rdf:Description rdf:about="&a;106034197"
	 b:glossaryEntry="Hindu sect worshiping of Vishnu"/>
<rdf:Description rdf:about="&a;106034337">
	<b:glossaryEntry>a society founded in the US in 1966; based on Vedic scriptures; groups engage in joyful chanting of `Hare Krishna'' (`O Krishna!'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106034622"
	 b:glossaryEntry="sect founded in the 6th century as a revolt against Hinduism"/>
<rdf:Description rdf:about="&a;106034755"
	 b:glossaryEntry="religion adhering to the teaching of Lao-tzu"/>
<rdf:Description rdf:about="&a;106034871">
	<b:glossaryEntry>Chinese Taoist sect claiming to follow the teaching of Lao-Tzu but also incorporating pantheism and sorcery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106035050">
	<b:glossaryEntry>the religion venerating Buddha represented by many groups especially in Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106035272">
	<b:glossaryEntry>school of Mahayana Buddhism asserting that enlightenment can come through meditation and intuition rather than faith; China and Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106035489">
	<b:glossaryEntry>a major school of Buddhism teaching social concern and universal salvation; China; Japan; Tibet; Nepal; Korea; Mongolia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106035700">
	<b:glossaryEntry>a major school of Buddhism teaching personal salvation through one''s own efforts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106035854">
	<b:glossaryEntry>Tibetan Buddhism having great variety in its ritual practices and a complex hierarchical organization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106036028">
	<b:glossaryEntry>movement within Buddhism combining elements of Hinduism and paganism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106036170"
	 b:glossaryEntry="the native religion and former ethnic cult of Japan"/>
<rdf:Description rdf:about="&a;106036331">
	<b:glossaryEntry>the branch of Shinto recognized as the official state religion of Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106036488"
	 b:glossaryEntry="any branch of Shinto other than Kokka"/>
<rdf:Description rdf:about="&a;106036610">
	<b:glossaryEntry>a militant black religion of the followers of Haile Selassie of Ethiopia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106036762">
	<b:glossaryEntry>the church that is recognized as the official church of a nation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106036891"
	 b:glossaryEntry="the religious institution under the authority of a vicar"/>
<rdf:Description rdf:about="&a;106037015">
	<b:glossaryEntry>a special kind of domesticated animals within a species; "he experimented on a particular breed of white rats"; "he created a new variety of sheep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106037296"
	 b:glossaryEntry="thoroughbred horses (collectively)"/>
<rdf:Description rdf:about="&a;106037387"
	 b:glossaryEntry="line of descent of a pure-bred animal"/>
<rdf:Description rdf:about="&a;106037479"
	 b:glossaryEntry='a special lineage; "a breed of Americans"'/>
<rdf:Description rdf:about="&a;106037572">
	<b:glossaryEntry>the descendants of one individual; "his entire lineage has been warriors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106037872">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a family line of descent; "he gets his brains from his father''s side"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106037992"
	 b:glossaryEntry="successive generations of kin"/>
<rdf:Description rdf:about="&a;106038109">
	<b:glossaryEntry>(biology) the major taxonomic group of animals and plants; contains classes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106038816">
	<b:glossaryEntry>(biology) a taxonomic group ranking between a phylum and a class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106038955">
	<b:glossaryEntry>(biology) a taxonomic group ranking between a phylum and below a class or subclass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106039114">
	<b:glossaryEntry>(linguistics) a large group of languages that are historically related</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106039237"
	 b:glossaryEntry="(biology) a taxonomic group containing one or more orders"/>
<rdf:Description rdf:about="&a;106041994">
	<b:glossaryEntry>(biology) a taxonomic category below a class and above an order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106042112"
	 b:glossaryEntry="(biology) a taxonomic class below a phylum and above a class"/>
<rdf:Description rdf:about="&a;106042229"
	 b:glossaryEntry="(biology) taxonomic group containing one or more families"/>
<rdf:Description rdf:about="&a;106042467"
	 b:glossaryEntry="(biology) taxonomic group that is a subdivision of an order"/>
<rdf:Description rdf:about="&a;106042600">
	<b:glossaryEntry>(biology) a taxonomic group ranking above an order and below a class or subclass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106042737">
	<b:glossaryEntry>(biology) a taxonomic group containing one or more genera; "sharks belong to the fish family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106043373">
	<b:glossaryEntry>(biology) a taxonomic group ranking below an order but above a family</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106043500">
	<b:glossaryEntry>(biology) an artificial taxonomic category for organisms of which the true relationships are obscure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106043658"
	 b:glossaryEntry="(biology) a taxonomic category below a family"/>
<rdf:Description rdf:about="&a;106043778">
	<b:glossaryEntry>(biology) a taxonomic category between a genus and a subfamily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106043947"
	 b:glossaryEntry="(biology) taxonomic group containing one or more species"/>
<rdf:Description rdf:about="&a;106044562"
	 b:glossaryEntry="(biology) taxonomic group between a genus and a species"/>
<rdf:Description rdf:about="&a;106044691">
	<b:glossaryEntry>(biology) a taxonomic group with a single member (a single species or genus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106044822">
	<b:glossaryEntry>(biology) genus from which the name of a family or subfamily is formed; it is not necessarily the most representative genus by often the largest or best known or earliest described</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106045059">
	<b:glossaryEntry>(biology) an artificial taxonomic category for organisms of which the true relationships are obscure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106045216"
	 b:glossaryEntry="(biology) taxonomic group whose members can interbreed"/>
<rdf:Description rdf:about="&a;106045417">
	<b:glossaryEntry>(biology) a taxonomic group that is a division of a species; usually arises as a consequence of geographical isolation within a species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106045616">
	<b:glossaryEntry>(biology) a group of organisms within a species that differ in trivial ways from similar groups; "a new strain of microorganisms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106045841">
	<b:glossaryEntry>(biology) the taxonomic group whose characteristics are used to define the next higher taxon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106045984">
	<b:glossaryEntry>(biology) the species that best exemplifies the essential characteristics of the genus to which it belongs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106046149"
	 b:glossaryEntry="people whose blood has the same antigens"/>
<rdf:Description rdf:about="&a;106046332"
	 b:glossaryEntry="the blood group whose red cells carry the A antigen"/>
<rdf:Description rdf:about="&a;106046450"
	 b:glossaryEntry="the blood group whose red cells carry the B antigen"/>
<rdf:Description rdf:about="&a;106046568">
	<b:glossaryEntry>the blood group whose red cells carry both the A and B antigens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106046701">
	<b:glossaryEntry>the blood group whose red cells carry neither the A nor B antigens; "people with type O blood are universal donors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106046883"
	 b:glossaryEntry="a society in an advanced state of development"/>
<rdf:Description rdf:about="&a;106047005">
	<b:glossaryEntry>the body of people in a learned occupation; "the news spread rapidly through the medical community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106047281"
	 b:glossaryEntry="the body of individuals qualified to practice law"/>
<rdf:Description rdf:about="&a;106047417">
	<b:glossaryEntry>the body of individuals whose work helps to maintain the health of their clients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106047598"
	 b:glossaryEntry="the body of individuals who practice medicine"/>
<rdf:Description rdf:about="&a;106047728"
	 b:glossaryEntry="the body of individuals who manage businesses"/>
<rdf:Description rdf:about="&a;106047852"
	 b:glossaryEntry="the body of individuals holding advanced academic degrees"/>
<rdf:Description rdf:about="&a;106047977"
	 b:glossaryEntry="the body of professional economists"/>
<rdf:Description rdf:about="&a;106048098"
	 b:glossaryEntry="the body of ordained religious practitioners"/>
<rdf:Description rdf:about="&a;106048253"
	 b:glossaryEntry="pastors collectively"/>
<rdf:Description rdf:about="&a;106048329"
	 b:glossaryEntry="prelates collectively"/>
<rdf:Description rdf:about="&a;106048416"
	 b:glossaryEntry="religious ministers collectively (especially Presbyterian)"/>
<rdf:Description rdf:about="&a;106048529"
	 b:glossaryEntry="rabbis collectively"/>
<rdf:Description rdf:about="&a;106048623"
	 b:glossaryEntry="a government department under the direction of a minister"/>
<rdf:Description rdf:about="&a;106048753"
	 b:glossaryEntry="the government department in charge of foreign relations"/>
<rdf:Description rdf:about="&a;106048888">
	<b:glossaryEntry>the French department in charge of foreign affairs; referred to familiarly by its address in Paris</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106049069">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a specialized division of a large organization; "you''ll find it in the hardware department"; "she got a job in the historical section of the Treasury"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106049358">
	<b:glossaryEntry>a division of a school that is responsible for a given subject</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106049756">
	<b:glossaryEntry>the academic department responsible for teaching and research in anthropology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106049932">
	<b:glossaryEntry>the academic department responsible for teaching art and art appreciation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106050066">
	<b:glossaryEntry>the academic department responsible for teaching and research in biology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106050227">
	<b:glossaryEntry>the academic department responsible for teaching and research in chemistry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106050394">
	<b:glossaryEntry>the academic department responsible for teaching and research in computer science</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106050552">
	<b:glossaryEntry>the academic department responsible for teaching and research in economics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106050719">
	<b:glossaryEntry>the academic department responsible for teaching English and American literature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106050888"
	 b:glossaryEntry="the academic department responsible for teaching history"/>
<rdf:Description rdf:about="&a;106051033">
	<b:glossaryEntry>the academic department responsible for teaching and research in linguistics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106051206">
	<b:glossaryEntry>the academic department responsible for teaching and research in mathematics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106051379"
	 b:glossaryEntry="the academic department responsible for teaching philosophy"/>
<rdf:Description rdf:about="&a;106051533">
	<b:glossaryEntry>the academic department responsible for teaching and research in physics</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106051694">
	<b:glossaryEntry>the academic department responsible for teaching music and music appreciation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106051856">
	<b:glossaryEntry>the academic department responsible for teaching and research in psychology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106052026">
	<b:glossaryEntry>the academic department responsible for teaching and research in sociology</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106052193"
	 b:glossaryEntry="a division of a business firm"/>
<rdf:Description rdf:about="&a;106052432">
	<b:glossaryEntry>the division of a business that is responsible for advertising</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106052586">
	<b:glossaryEntry>the department of a publishing business that edits material for publication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106052764">
	<b:glossaryEntry>the editorial department of a newspaper that edits the local news</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106052885">
	<b:glossaryEntry>the editorial department of a newspaper that edits the sports news</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106053009">
	<b:glossaryEntry>the division of a business (e.g. a service garage) the sells replacement parts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106053150"
	 b:glossaryEntry="the division of a business responsible for hiring employees"/>
<rdf:Description rdf:about="&a;106053310">
	<b:glossaryEntry>the division of a business responsible for building and maintaining the physical plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106053481"
	 b:glossaryEntry="the division of a business responsible for purchases"/>
<rdf:Description rdf:about="&a;106053601"
	 b:glossaryEntry="the division of a business that is responsible for selling"/>
<rdf:Description rdf:about="&a;106053753"
	 b:glossaryEntry="the division of a business that provides customer services"/>
<rdf:Description rdf:about="&a;106053876"
	 b:glossaryEntry="a department of government"/>
<rdf:Description rdf:about="&a;106054116">
	<b:glossaryEntry>the government department responsible for collecting and managing and spending public revenues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106054265">
	<b:glossaryEntry>a permanent department created to perform the work of a local government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106054469">
	<b:glossaryEntry>a department responsible for the security of the institutions property and workers; "the head of security was a former policeman"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106054653">
	<b:glossaryEntry>the department of local government responsible for preventing and extinguishing fires</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106054837"
	 b:glossaryEntry="British name for a fire department"/>
<rdf:Description rdf:about="&a;106054930">
	<b:glossaryEntry>a private or temporary organization of individuals equipped to fight fires</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106055078">
	<b:glossaryEntry>the department of local government concerned with enforcing the law and preventing crime</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106055230">
	<b:glossaryEntry>in the US: a department of government in one of the 50 states</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106055354"
	 b:glossaryEntry="a department of the federal government"/>
<rdf:Description rdf:about="&a;106055549">
	<b:glossaryEntry>a former agency (from 1947 to 1977) that was responsible for research into atomic energy and its peacetime uses in the US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106055766">
	<b:glossaryEntry>a former US agency that was responsible for developing atomic bombs during World War II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106055936">
	<b:glossaryEntry>a federal agency established to coordinate programs aimed at reducing pollution and protecting the environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106056130"
	 b:glossaryEntry="a federal department in the executive branch of government"/>
<rdf:Description rdf:about="&a;106056616"
	 b:glossaryEntry="an agency of the executive branch of government"/>
<rdf:Description rdf:about="&a;106056798">
	<b:glossaryEntry>an executive agency responsible for providing economic advice to the President</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106056951">
	<b:glossaryEntry>a government agency in Atlanta that investigates and diagnoses and tries to control diseases (especially new and unusual diseases)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106057154">
	<b:glossaryEntry>an independent agency of the US government responsible for collecting and coordinating intelligence and counterintelligence activities abroad in the national interest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106057400">
	<b:glossaryEntry>an independent agency of the US government responsible for aviation and spaceflight</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106057582">
	<b:glossaryEntry>the executive agency that advises the President on the federal budget</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106057735">
	<b:glossaryEntry>the executive agency that advises the President on protecting the environment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106057890">
	<b:glossaryEntry>the executive agency that administers the President''s policies on international trade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106058056"
	 b:glossaryEntry="the chief executive department of the US government"/>
<rdf:Description rdf:about="&a;106058165">
	<b:glossaryEntry>the federal department that administers programs that provide services to farmers (including research and soil conservation and efforts to stabilize the farming economy); created in 1862</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106058462">
	<b:glossaryEntry>the federal department that promotes and administers domestic and foreign trade (including management of the census and the patent office); created in 1913</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106058738">
	<b:glossaryEntry>the bureau of the Commerce Department responsible for taking the census</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106058911">
	<b:glossaryEntry>the federal department responsible for safeguarding national security; created in 1947</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106059102">
	<b:glossaryEntry>the federal department that administers all federal programs dealing with education (including federal aid to educational institutions and students); created 1979</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106059369">
	<b:glossaryEntry>the federal department responsible for maintaining a national energy policy; created in 1977</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106059557">
	<b:glossaryEntry>the federal department that administers all federal programs dealing with health and welfare; created in 1979</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106059799">
	<b:glossaryEntry>the agency of Health and Human Services responsible for the social security system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106059977">
	<b:glossaryEntry>the federal department that administers federal program dealing with better housing and urban renewal; created in 1965</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106060223">
	<b:glossaryEntry>the federal department responsible for enforcing federal laws (including the enforcement of all civil rights legislation); created in 1870</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106060479"
	 b:glossaryEntry="the law enforcement agency in the Justice Department"/>
<rdf:Description rdf:about="&a;106060634">
	<b:glossaryEntry>the federal department responsible for promoting the working conditions of wage earners; created in 1913</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106060831">
	<b:glossaryEntry>the federal department that sets and maintains foreign policies; "the Department of State was created in 1789"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106061034">
	<b:glossaryEntry>the federal department charged with conservation and the development of natural resources; created in 1849</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106061246">
	<b:glossaryEntry>an agency of the Interior Department responsible for the National Parks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106061385">
	<b:glossaryEntry>the federal department that collects revenue and administers federal finances; the Treasury Department was created in 1789</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106061727">
	<b:glossaryEntry>the agency of the Treasury Department that administers federal laws concerning alcohol and tobacco and firearms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106061942">
	<b:glossaryEntry>the agency of the Treasury Department responsible for controlling the currency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106062113">
	<b:glossaryEntry>the agency of the Treasury Department that enforces import tariffs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106062262"
	 b:glossaryEntry="the agency of the Treasury Department that produces currency"/>
<rdf:Description rdf:about="&a;106062420">
	<b:glossaryEntry>the bureau of the Treasury Department responsible for tax collections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106062585">
	<b:glossaryEntry>a bureau of the Treasury Department responsible for intelligence operations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106062754">
	<b:glossaryEntry>the federal department that institutes and coordinates national transportation programs; created in 1966</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106062950">
	<b:glossaryEntry>the federal department responsible for the interests of military veterans; created in 1989</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106063117">
	<b:glossaryEntry>a former executive department; created in 1903 and split into two departments in 1913</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106063281">
	<b:glossaryEntry>a former executive department; created in 1953 and divided in 1979</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106063436">
	<b:glossaryEntry>a former executive department; created in 1798 and combined with the War Department in 1947</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106063589">
	<b:glossaryEntry>a former executive department; created in 1789 and combined with the Navy Department in 1947</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106063742">
	<b:glossaryEntry>the federal government department responsible for mail delivery (and sometimes telecommunications)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106063942"
	 b:glossaryEntry="a local branch of the Post Office Department"/>
<rdf:Description rdf:about="&a;106064102">
	<b:glossaryEntry>a part of the post office that handles mail for persons who call for it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106064272">
	<b:glossaryEntry>a subsidiary organ of government created for a special purpose; "are the judicial instrumentalities of local governments adequate?"; "he studied the French instrumentalities for law enforcement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106064547">
	<b:glossaryEntry>a group of religious congregations having its own organization and a distinctive faith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106064748"
	 b:glossaryEntry="group of Protestant congregations"/>
<rdf:Description rdf:about="&a;106065230"
	 b:glossaryEntry="a subdivision of a larger religious group"/>
<rdf:Description rdf:about="&a;106065557"
	 b:glossaryEntry="a Protestant sect; commonly called Quakers"/>
<rdf:Description rdf:about="&a;106065724"
	 b:glossaryEntry="a charismatic Protestant denomination in the US"/>
<rdf:Description rdf:about="&a;106065835"
	 b:glossaryEntry="the Jesuits: a Roman Catholic religious order"/>
<rdf:Description rdf:about="&a;106065981">
	<b:glossaryEntry>adherents of an exclusive system of religious beliefs and practices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106066118"
	 b:glossaryEntry="saints collectively"/>
<rdf:Description rdf:about="&a;106066212"
	 b:glossaryEntry="clergymen collectively (as distinguished from the laity)"/>
<rdf:Description rdf:about="&a;106066430">
	<b:glossaryEntry>the first of the three estates of the realm; the clergy in France and the lords spiritual in Britain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106066607"
	 b:glossaryEntry="cardinals collectively"/>
<rdf:Description rdf:about="&a;106066687"
	 b:glossaryEntry="everyone except the clergy"/>
<rdf:Description rdf:about="&a;106066815"
	 b:glossaryEntry="all the gods of a religion"/>
<rdf:Description rdf:about="&a;106066915"
	 b:glossaryEntry="royal persons collectively"/>
<rdf:Description rdf:about="&a;106067349">
	<b:glossaryEntry>a European royal line that ruled in France and Spain and Naples and Sicily</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106067496"
	 b:glossaryEntry="the English royal house that reigned from 1714 to 1901"/>
<rdf:Description rdf:about="&a;106067660">
	<b:glossaryEntry>a royal German family that provided rulers for several European states and wore the crown of the Holy Roman Empire from 1440 to 1806</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106067858"
	 b:glossaryEntry="a German noble family that ruled Brandenburg and Prussia"/>
<rdf:Description rdf:about="&a;106067973">
	<b:glossaryEntry>the English royal house that reigned from 1399 to 1461; its emblem was a red rose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106068169">
	<b:glossaryEntry>the family name of a line of English kings that reigned from 1154 to 1485</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106068319"
	 b:glossaryEntry="the Russian imperial line that ruled from 1613 to 1917"/>
<rdf:Description rdf:about="&a;106068456"
	 b:glossaryEntry="the royal family that ruled Scotland and England"/>
<rdf:Description rdf:about="&a;106068557">
	<b:glossaryEntry>an English royal family descended from Owen Tudor; Tudor monarchs ruled from Henry VII to Elizabeth I (from 1485 to 1603)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106068747"
	 b:glossaryEntry="the British royal family since 1917"/>
<rdf:Description rdf:about="&a;106068855">
	<b:glossaryEntry>the English royal house (a branch of the Plantagenet line) that reigned from 1461 to 1485; its emblem was a white rose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106069040">
	<b:glossaryEntry>the body of citizens of a state or country; "the Spanish people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106069224"
	 b:glossaryEntry="the body of enfranchised citizens; those qualified to vote"/>
<rdf:Description rdf:about="&a;106069396">
	<b:glossaryEntry>the body of people who are citizens of a particular government; "governments derive their just powers from the consent of the governed"--Declaration of Independence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106069615"
	 b:glossaryEntry="assembly possessing high legislative powers"/>
<rdf:Description rdf:about="&a;106069729"
	 b:glossaryEntry="the upper house of the US Congress"/>
<rdf:Description rdf:about="&a;106069858"
	 b:glossaryEntry="the legislature of the US government"/>
<rdf:Description rdf:about="&a;106070031"
	 b:glossaryEntry="the lower legislative house of the US Congress"/>
<rdf:Description rdf:about="&a;106070167"
	 b:glossaryEntry="the lower house of the British parliament"/>
<rdf:Description rdf:about="&a;106070309"
	 b:glossaryEntry="the upper house of the British parliament"/>
<rdf:Description rdf:about="&a;106070449">
	<b:glossaryEntry>an official assembly having legislative powers; "the legislature has two houses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106070671"
	 b:glossaryEntry="persons who make or amend or repeal laws"/>
<rdf:Description rdf:about="&a;106070969"
	 b:glossaryEntry="a unicameral legislature"/>
<rdf:Description rdf:about="&a;106071059"
	 b:glossaryEntry="a group of persons gathered together for a common purpose"/>
<rdf:Description rdf:about="&a;106071333">
	<b:glossaryEntry>assembly of the estates of an entire country especially the sovereign body of the Dutch republic from 16th to 18th centuries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106071536"
	 b:glossaryEntry="assembly of the estates of all France; last meeting in 1789"/>
<rdf:Description rdf:about="&a;106071657">
	<b:glossaryEntry>the persons (or committees or departments etc.) who make up a governing body and who administer something; "he claims that the present administration is corrupt"; "the governance of an association is responsible to its members"; "he quickly became recognized as a member of the establishment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106072206"
	 b:glossaryEntry="persons who administer the law"/>
<rdf:Description rdf:about="&a;106072383"
	 b:glossaryEntry="the executive under President Clinton"/>
<rdf:Description rdf:about="&a;106072489"
	 b:glossaryEntry="the executive under President Bush"/>
<rdf:Description rdf:about="&a;106072589"
	 b:glossaryEntry="the executive under President Reagan"/>
<rdf:Description rdf:about="&a;106072693"
	 b:glossaryEntry="the executive under President Carter"/>
<rdf:Description rdf:about="&a;106072797"
	 b:glossaryEntry="persons who administer justice"/>
<rdf:Description rdf:about="&a;106072910">
	<b:glossaryEntry>the system of law courts that administer justice and constitute the judicial branch of government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106073126">
	<b:glossaryEntry>the people of a nation or country or a community of persons bound by a common heritage; "a nation of Catholics"; "the whole country worshipped him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106073495">
	<b:glossaryEntry>a major social class or order of persons regarded collectively as part of the body politic of the country and formerly possessing distinct political rights</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106073762"
	 b:glossaryEntry="a federation (as of American Indians)"/>
<rdf:Description rdf:about="&a;106073912"
	 b:glossaryEntry="anti-Communist countries collectively"/>
<rdf:Description rdf:about="&a;106074006">
	<b:glossaryEntry>underdeveloped and developing countries of Asia and Africa and Latin America collectively; neutral in the East-West alignment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106074189">
	<b:glossaryEntry>a politically organized body of people under a single government; "the state has elected a new president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106074543"
	 b:glossaryEntry="the German state"/>
<rdf:Description rdf:about="&a;106074665">
	<b:glossaryEntry>the lands ruled by Charlemagne; a continuation of the Roman Empire in Europe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106074838"
	 b:glossaryEntry="1871-1919"/>
<rdf:Description rdf:about="&a;106074928"
	 b:glossaryEntry="the Nazi dictatorship under Hitler (1933-1945)"/>
<rdf:Description rdf:about="&a;106075032">
	<b:glossaryEntry>a state exercising a degree of dominion over a dependent state especially in its foreign affairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106075183">
	<b:glossaryEntry>an organization that is a member of another organization (especially a state that belongs to a group of nations); "the library was a member of the interlibrary loan association"; "Canada is a member of the United Nations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106075457">
	<b:glossaryEntry>an alliance of nations joining together to fight a common enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106075573"
	 b:glossaryEntry="a group of countries in special alliance"/>
<rdf:Description rdf:about="&a;106075689"
	 b:glossaryEntry="an informal alliance between countries"/>
<rdf:Description rdf:about="&a;106075800">
	<b:glossaryEntry>an international organization of independent Arab states formed in 1945 to promote cultural and economic and military and political and social cooperation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106076411">
	<b:glossaryEntry>an international organization of European countries formed in 1958 to reduce trade barriers and increase cooperation among its members</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106076869">
	<b:glossaryEntry>an international organization created in 1949 by the North Atlantic Treaty for purposes of collective security</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106077390">
	<b:glossaryEntry>an association of countries in the W hemisphere; created in 1948 to promote military and economic and social and cultural cooperation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106078196">
	<b:glossaryEntry>the administrative agency of the Organization of American States</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106078325">
	<b:glossaryEntry>an organization of countries formed in 1961 to agree on a common policy for the sale of petroleum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106078749"
	 b:glossaryEntry="a nation that possesses formidable naval strength"/>
<rdf:Description rdf:about="&a;106078854">
	<b:glossaryEntry>a state powerful enough to influence events throughout the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106079025"
	 b:glossaryEntry="a state ruled by religious authority"/>
<rdf:Description rdf:about="&a;106079120"
	 b:glossaryEntry="a state consisting of a sovereign city"/>
<rdf:Description rdf:about="&a;106079233">
	<b:glossaryEntry>a government that undertakes responsibility for the welfare of its citizens through programs in public health and public housing and pensions and unemployment compensation etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106079469">
	<b:glossaryEntry>the group of people comprising the government of a sovereign state; "the state has lowered its income tax"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106079663">
	<b:glossaryEntry>a group of organisms of the same species populating a given area; "they hired hunters to keep down the deer population"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106079857"
	 b:glossaryEntry="too much population"/>
<rdf:Description rdf:about="&a;106079949">
	<b:glossaryEntry>people in general considered as a whole; "he is a hero in the eyes of the public"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106080139">
	<b:glossaryEntry>the people who inhabit a territory or state; "the population seemd to be well fed and clothed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106080290">
	<b:glossaryEntry>the common people generally; "separate the warriors from the mass"; "power to the people"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106080527">
	<b:glossaryEntry>the segment of the public that is easily influenced by mass media (chiefly British)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106080663">
	<b:glossaryEntry>the third estate of the realm; the commons (especially in Britain or France) viewed as forming a political order having representation in a parliament</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106080872">
	<b:glossaryEntry>a social class comprising those who do manual labor or work for wages; "there is a shortage of skilled labor in this field"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106081123"
	 b:glossaryEntry="the source of trained people from which workers can be hired"/>
<rdf:Description rdf:about="&a;106081254"
	 b:glossaryEntry="the social class lowest in the social hierarchy"/>
<rdf:Description rdf:about="&a;106081359"
	 b:glossaryEntry="the social class between the lower and upper classes"/>
<rdf:Description rdf:about="&a;106081521">
	<b:glossaryEntry>class composed of persons lacking noble or knightly or gentle rank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106081686"
	 b:glossaryEntry="lower middle class (shopkeepers and clerical staff etc.)"/>
<rdf:Description rdf:about="&a;106081864"
	 b:glossaryEntry="the class of peasants"/>
<rdf:Description rdf:about="&a;106081960">
	<b:glossaryEntry>a large number of things or people considered together; "a crowd of insects assembled around the flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106082225"
	 b:glossaryEntry="a large gathering of people"/>
<rdf:Description rdf:about="&a;106082383"
	 b:glossaryEntry="a teeming multitude"/>
<rdf:Description rdf:about="&a;106082453"
	 b:glossaryEntry="a vast multitude"/>
<rdf:Description rdf:about="&a;106082537">
	<b:glossaryEntry>a crowd especially of ordinary or undistinguished persons or things; "his briliance raised him above the ruck"; "the children resembled a fairy herd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106082744"
	 b:glossaryEntry="a large number of people united for some specific purpose"/>
<rdf:Description rdf:about="&a;106082852"
	 b:glossaryEntry="a dense crowd of people"/>
<rdf:Description rdf:about="&a;106082959">
	<b:glossaryEntry>a number of vehicles blocking one another until they can scarcely move</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106083098"
	 b:glossaryEntry="archaic terms for army"/>
<rdf:Description rdf:about="&a;106083198">
	<b:glossaryEntry>(plural) hosts or armies; used in the book of Romans in the New Testament of the Bible: `Lord of Sabaoth''</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106083357"
	 b:glossaryEntry="a disorderly crowd of people"/>
<rdf:Description rdf:about="&a;106083469">
	<b:glossaryEntry>a mob that kills a person for some presumed offense without legal authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106083600"
	 b:glossaryEntry="a moving crowd"/>
<rdf:Description rdf:about="&a;106083682"
	 b:glossaryEntry="a group of animals (a herd or flock) moving together"/>
<rdf:Description rdf:about="&a;106083786">
	<b:glossaryEntry>a social gathering of guests or companions; "the house was filled with company when I arrived"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106083970">
	<b:glossaryEntry>(British) a company that is organized to give its owners limited liability</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106084119"
	 b:glossaryEntry="a company with controlling shares in other companies"/>
<rdf:Description rdf:about="&a;106084251"
	 b:glossaryEntry="a holding company owning or controlling one or more banks"/>
<rdf:Description rdf:about="&a;106084393"
