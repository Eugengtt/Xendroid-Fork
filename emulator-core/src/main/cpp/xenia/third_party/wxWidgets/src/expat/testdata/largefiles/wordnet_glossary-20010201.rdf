</rdf:Description>
<rdf:Description rdf:about="&a;108723976"
	 b:glossaryEntry="often used colloquially for any yellow daffodil"/>
<rdf:Description rdf:about="&a;108724077"
	 b:glossaryEntry="a monocotyledonous genus of the amaryllis family"/>
<rdf:Description rdf:about="&a;108724237">
