	<b:glossaryEntry>small bushy tree of southeastern United States having profuse clusters of white flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108605879"
	 b:glossaryEntry="genus of often spiny American shrubs and trees"/>
<rdf:Description rdf:about="&a;108606026"
	 b:glossaryEntry="any plant of the genus Forestiera"/>
