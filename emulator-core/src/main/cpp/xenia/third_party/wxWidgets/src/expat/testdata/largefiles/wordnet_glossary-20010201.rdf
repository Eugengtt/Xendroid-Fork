	 b:glossaryEntry="a lesson in playing tennis"/>
<rdf:Description rdf:about="&a;100572610"
	 b:glossaryEntry="a lesson in playing gold"/>
<rdf:Description rdf:about="&a;100572692"
	 b:glossaryEntry="a less in the facts of history"/>
<rdf:Description rdf:about="&a;100572783"
	 b:glossaryEntry="a course offered (by mail) by a correspondence school"/>
<rdf:Description rdf:about="&a;100572904"
	 b:glossaryEntry="a series of lectures dealing with a subject"/>
<rdf:Description rdf:about="&a;100573031"
	 b:glossaryEntry="a course offered as part of an extension service"/>
<rdf:Description rdf:about="&a;100573161">
