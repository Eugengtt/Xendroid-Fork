	 b:glossaryEntry="a German art song of the 19th century"/>
<rdf:Description rdf:about="&a;105287571"
	 b:glossaryEntry="a song about love or expressing love for another person"/>
<rdf:Description rdf:about="&a;105287681"
	 b:glossaryEntry="a quiet song intended to lull a child to sleep"/>
<rdf:Description rdf:about="&a;105287805">
	<b:glossaryEntry>the text of a popular song or musical-comedy number; "his compositions always started with the lyrics"; "he wrote both words and music"; "the song uses colloquial language"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105288085"
	 b:glossaryEntry="the lyric of a lovesong"/>
<rdf:Description rdf:about="&a;105288165"
	 b:glossaryEntry="a song with two or more voice parts"/>
<rdf:Description rdf:about="&a;105288291">
	<b:glossaryEntry>an unaccompanied partsong for 2 or 3 voices; follows a strict poetic form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105288419">
	<b:glossaryEntry>a partsong in which voices follow each other; one voice starts and others join in one after another until all are singing different parts of the song at the same time; "they enjoyed singing rounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105288668"
	 b:glossaryEntry="a song in which a line or phrase is repeated as the refrain"/>
<rdf:Description rdf:about="&a;105288783"
	 b:glossaryEntry="a song (sometimes improvised) sung by guests at a banquet"/>
<rdf:Description rdf:about="&a;105288909">
	<b:glossaryEntry>a song characteristically played outside the house of a woman</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105289043"
	 b:glossaryEntry="a popular song concerned with disappointment in love"/>
<rdf:Description rdf:about="&a;105289152"
	 b:glossaryEntry="a usually rhythmical song song to accompany repetitious work"/>
<rdf:Description rdf:about="&a;105289286">
	<b:glossaryEntry>a noisy mock serenade (made by banging pans and kettles) to a newly married couple</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105289482"
	 b:glossaryEntry="music written for a ballet"/>
<rdf:Description rdf:about="&a;105289561"
	 b:glossaryEntry="music written in the rhythm of the bolero dance"/>
<rdf:Description rdf:about="&a;105289661"
	 b:glossaryEntry="music composed for dancing the conga"/>
<rdf:Description rdf:about="&a;105289749"
	 b:glossaryEntry="music composed in quadruple time for dancing the gavotte"/>
<rdf:Description rdf:about="&a;105289859"
	 b:glossaryEntry="music for dancing the hornpipe"/>
<rdf:Description rdf:about="&a;105289944"
	 b:glossaryEntry="music in three-four time for dancing a jig"/>
<rdf:Description rdf:about="&a;105290036"
	 b:glossaryEntry="music in triple time for dancing the landler"/>
<rdf:Description rdf:about="&a;105290134"
	 b:glossaryEntry="music composed for dancing the mazurka"/>
<rdf:Description rdf:about="&a;105290226">
	<b:glossaryEntry>a stately piece of music composed for dancing the minuet; often incorporated into a sonata or suite</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105290378">
	<b:glossaryEntry>music in march time composed for dancing the paso doble; often played a bull fights</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105290518"
	 b:glossaryEntry="music composed for dancing the pavane"/>
<rdf:Description rdf:about="&a;105290608"
	 b:glossaryEntry="music performed for dancing the polka"/>
<rdf:Description rdf:about="&a;105290697"
	 b:glossaryEntry="music for dancing the quadrille"/>
<rdf:Description rdf:about="&a;105290784"
	 b:glossaryEntry="music composed for dancing a reel"/>
<rdf:Description rdf:about="&a;105290868"
	 b:glossaryEntry="syncopated music in duple time for dancing the rumba"/>
<rdf:Description rdf:about="&a;105290981"
	 b:glossaryEntry="music composed for dancing the samba"/>
<rdf:Description rdf:about="&a;105291069"
	 b:glossaryEntry="music composed for dancing the saraband"/>
<rdf:Description rdf:about="&a;105291163"
	 b:glossaryEntry="music performed for dancing the schottische"/>
<rdf:Description rdf:about="&a;105291264">
	<b:glossaryEntry>20th century music that uses of a definite order of notes as a thematic basis for a musical composition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105291456">
	<b:glossaryEntry>a type of serial music introduced by Arnold Schoenberg; uses a tone row formed by the twelve semitones of the chromatic scale (and inverted or backward versions of the row)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105291692"
	 b:glossaryEntry="music written in duple time for dancing the tango"/>
<rdf:Description rdf:about="&a;105291793"
	 b:glossaryEntry="music composed in six-eight time for dancing the tarantella"/>
<rdf:Description rdf:about="&a;105291909"
	 b:glossaryEntry="music composed in triple time for waltzing"/>
<rdf:Description rdf:about="&a;105292003"
	 b:glossaryEntry="music having wide appeal (but usually only for a short time)"/>
<rdf:Description rdf:about="&a;105292195">
	<b:glossaryEntry>popular dance music of Brazil; derived from the practices of the macumba religious cult</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105292336"
	 b:glossaryEntry="music of general appeal to young people"/>
<rdf:Description rdf:about="&a;105292437">
	<b:glossaryEntry>the traditional and typically anonymous music that is an expression of the life of people in a community</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105292710">
	<b:glossaryEntry>a simple style of folk music heard in the southern US; usually played on stringed instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105292903">
	<b:glossaryEntry>country music originating in mountainous regions of southern US</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105293028"
	 b:glossaryEntry="music performed for square dancing"/>
<rdf:Description rdf:about="&a;105293127">
	<b:glossaryEntry>popular music originating in the West Indies; repetitive bass riffs and regular chords played on the off beat by a guitar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105293301">
	<b:glossaryEntry>(British) a style of popular music in the 1950s; based on American folk music and played on guitars and improvised percussion instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105293492">
	<b:glossaryEntry>a way of expressing something (in language or art or music etc.) that is characteristic of a particular person or group of people or period; "all the reporters were expected to adopt the style of the newspaper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105294187">
	<b:glossaryEntry>the manner of speaking to another individual; "he failed in his manner of address to the captain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105294338">
	<b:glossaryEntry>a break or check in the voice (usually a sign of strong emotion)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105294454">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the use of closed-class words instead of inflections: e.g., "the father of the bride" instead of "the bride''s father"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105294626"
	 b:glossaryEntry="triteness or triviality of style"/>
<rdf:Description rdf:about="&a;105294711">
	<b:glossaryEntry>something in an artistic work designed to achieve a particular effect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105294851">
	<b:glossaryEntry>using the technical language of ecology to make the user seem ecologically aware</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105294987"
	 b:glossaryEntry="powerful and effective language"/>
<rdf:Description rdf:about="&a;105295084"
	 b:glossaryEntry="any artificially elegant style of language"/>
<rdf:Description rdf:about="&a;105295181"
	 b:glossaryEntry="the jargon of European community documents and regulations"/>
<rdf:Description rdf:about="&a;105295296">
	<b:glossaryEntry>the style of expressing yourself; "he suggested a better formulation"; "his manner of expression showed how much he cared"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105295633"
	 b:glossaryEntry="incomprehensible or pompous jargon of specialists"/>
<rdf:Description rdf:about="&a;105295741"
	 b:glossaryEntry="high_flown style; excessive use of verbal ornamentation"/>
<rdf:Description rdf:about="&a;105295934"
	 b:glossaryEntry="using the abbreviated style of headline writers"/>
<rdf:Description rdf:about="&a;105296038"
	 b:glossaryEntry='an expression of respect; "the Japanese use many honorifics"'/>
<rdf:Description rdf:about="&a;105296154">
	<b:glossaryEntry>specialized technical terminology characteristic of a particular subject</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105296369"
	 b:glossaryEntry="the style in which newspapers are written"/>
<rdf:Description rdf:about="&a;105296485">
	<b:glossaryEntry>a style that uses the abstruse technical vocabulary of the law</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105296602">
	<b:glossaryEntry>your characteristic style or manner of expressing yourself orally; "his manner of speaking was quite abrupt"; "her speech was barren of southernisms"; "I detected a slight accent in his speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105297025">
	<b:glossaryEntry>the style of writing characteristic of some government officials: formal and obscure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105297167"
	 b:glossaryEntry="a style that has the power to evoke feelings"/>
<rdf:Description rdf:about="&a;105297264"
	 b:glossaryEntry="matter_of_fact, commonplace, or dull expression"/>
<rdf:Description rdf:about="&a;105297363"
	 b:glossaryEntry="using language loaded with psychological terminology"/>
<rdf:Description rdf:about="&a;105297474"
	 b:glossaryEntry="using language effectively to please or persuade"/>
<rdf:Description rdf:about="&a;105297596">
	<b:glossaryEntry>the expression of one''s individuality (usually through creative activities)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105297733">
	<b:glossaryEntry>expressing in coherent verbal form; "the articulation of my feelings" or "I gave voice to my feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105297902"
	 b:glossaryEntry="the use of an archaic expression"/>
<rdf:Description rdf:about="&a;105298002"
	 b:glossaryEntry="a standard formulation of legal documents or news stories"/>
<rdf:Description rdf:about="&a;105298136">
	<b:glossaryEntry>a colloquial expression; characteristic of spoken or written communication that seeks to imitate informal speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105298308"
	 b:glossaryEntry="the appropriate word or expression"/>
<rdf:Description rdf:about="&a;105298398"
	 b:glossaryEntry="expressing something in words"/>
<rdf:Description rdf:about="&a;105298487">
	<b:glossaryEntry>a manner of speaking that is natural to native speakers of a language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105298619">
	<b:glossaryEntry>an expression that is characteristic of English as spoken by Americans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105298747">
	<b:glossaryEntry>an expression that is limited to English as spoken by Englishmen (especially as contrasted with American English)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105298941"
	 b:glossaryEntry="a word or phrase borrowed from French"/>
<rdf:Description rdf:about="&a;105299034">
	<b:glossaryEntry>the manner in which something is expressed in words: "use concise military verbiage"- G.S.Patton</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105299284">
	<b:glossaryEntry>the use of manner of speaking to communicate particular meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105299457">
	<b:glossaryEntry>a manner of speaking; "he spoke with a thick tongue"; "she has a glib tongue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105299605"
	 b:glossaryEntry="a bitter or critical manner of speaking"/>
<rdf:Description rdf:about="&a;105299703">
	<b:glossaryEntry>a manner of speaking that is distinctive of a particular group of people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105299832">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the quality of a person''s voice; "he began in a conversational tone"; "he spoke in a nervous tone of voice"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105300042">
	<b:glossaryEntry>a tone of voice that shows what the speaker is feeling; "there was a note of uncertainty in his voice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105300195"
	 b:glossaryEntry='a quiet or hushed tone of voice: "spoke in undertones"'/>
<rdf:Description rdf:about="&a;105300305">
	<b:glossaryEntry>an expert manner of speaking involving control of voice and gesture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105300428">
	<b:glossaryEntry>the rapid and continuous delivery of linguistic communication (spoken or written)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105300588"
	 b:glossaryEntry="the patterns of stress and intonation in a language"/>
<rdf:Description rdf:about="&a;105300778"
	 b:glossaryEntry="rise and fall of the voice pitch"/>
<rdf:Description rdf:about="&a;105300937">
	<b:glossaryEntry>intonations characteristic of questions and requests and statements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105301069"
	 b:glossaryEntry="an unchanging intonation"/>
<rdf:Description rdf:about="&a;105301166"
	 b:glossaryEntry="a regular and monotonous rising and falling intonation"/>
<rdf:Description rdf:about="&a;105301275">
	<b:glossaryEntry>a break or pause (usually for sense) in the middle of a verse line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105301395">
	<b:glossaryEntry>the relative prominence of a syllable (especially with regard to stress or pitch); "he put the stress on the wrong syllable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105301661"
	 b:glossaryEntry="emphasis the results from pitch rather than loudness"/>
<rdf:Description rdf:about="&a;105301787"
	 b:glossaryEntry="the distribution of stresses within a polysyllabic word"/>
<rdf:Description rdf:about="&a;105301914"
	 b:glossaryEntry="the distribution of stresses within a sentence"/>
<rdf:Description rdf:about="&a;105302022">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the arrangement of spoken words alternating stressed and unstressed elements; "the rhythm of Frost''s poetry"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105302217">
	<b:glossaryEntry>the basic rhythmic unit in a piece of music; "the piece has a fast rhythm"; "the conductor set the beat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105302452">
	<b:glossaryEntry>the first beat of a musical measure (as the conductor''s arm moves downward)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105302582"
	 b:glossaryEntry="an unaccented beat (especially the last beat of a measure)"/>
<rdf:Description rdf:about="&a;105302693"
	 b:glossaryEntry="a musical rhythm accenting a weak beat"/>
<rdf:Description rdf:about="&a;105302789">
	<b:glossaryEntry>a vocal passage of narrative text that a singer delivers with natural rhythms of speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105302951">
	<b:glossaryEntry>(music) a short recitative that is melodic but is not an aria</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105303065"
	 b:glossaryEntry="a musical passage moving from one key to another"/>
<rdf:Description rdf:about="&a;105303183"
	 b:glossaryEntry="pompous or pretentious talk or writing"/>
<rdf:Description rdf:about="&a;105303310"
	 b:glossaryEntry="using long words"/>
<rdf:Description rdf:about="&a;105303387">
	<b:glossaryEntry>the journalistic use of subject matter that appeals to vulgar tastes; "the tabloids relied on sensationalism to maintain their circulation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105303599"
	 b:glossaryEntry="technical jargon from computing and other high-tech subjects"/>
<rdf:Description rdf:about="&a;105303718"
	 b:glossaryEntry="a neatly short and concise expressive style"/>
<rdf:Description rdf:about="&a;105303907">
	<b:glossaryEntry>terseness achieved by expressing a great deal in just a few words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105304057">
	<b:glossaryEntry>a style of expression that is direct and to the point; "the crispness of his reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105304196"
	 b:glossaryEntry="the use of brief expressions"/>
<rdf:Description rdf:about="&a;105304278"
	 b:glossaryEntry="terseness of expression"/>
<rdf:Description rdf:about="&a;105304369">
	<b:glossaryEntry>a distinctive style or manner; "he continued in this vein for several minutes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105304498"
	 b:glossaryEntry="an expressive style that uses excessive words"/>
<rdf:Description rdf:about="&a;105304721"
	 b:glossaryEntry="overabundance of words"/>
<rdf:Description rdf:about="&a;105304798"
	 b:glossaryEntry="boring verboseness"/>
<rdf:Description rdf:about="&a;105304969"
	 b:glossaryEntry="a style that involves indirect ways of expressing things"/>
<rdf:Description rdf:about="&a;105305100"
	 b:glossaryEntry="pompously embellished language"/>
<rdf:Description rdf:about="&a;105305212"
	 b:glossaryEntry="verboseness resulting from excessive repetitions"/>
<rdf:Description rdf:about="&a;105305375">
	<b:glossaryEntry>repetition of messages to reduce the probability of errors in transmission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105305506"
	 b:glossaryEntry='using more words than necessary; "a tiny little child"'/>
<rdf:Description rdf:about="&a;105305615">
	<b:glossaryEntry xml:space='preserve'><![CDATA[useless repetition; "to say that something is `adequate enough'' is a tautology"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105305750">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(in logic) a statement that is necessarily true; "the statement `he is brave or he is not brave'' is a tautology"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105305918"
	 b:glossaryEntry="a shortened form of a word or phrase"/>
<rdf:Description rdf:about="&a;105306031">
	<b:glossaryEntry xml:space='preserve'><![CDATA[abbreviation of a word by omitting the final sound or sounds; "the British get `pud'' from `pudding'' by apocope"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105306196"
	 b:glossaryEntry="a word formed from the initial letters of a multi-word name"/>
<rdf:Description rdf:about="&a;105306309"
	 b:glossaryEntry="a style of expressing yourself in writing"/>
<rdf:Description rdf:about="&a;105306507">
	<b:glossaryEntry>an arrangement of the elements in a composition or discourse; "the essay was in the form of a dialogue"; "he first skethes the plot in outline form"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105306706"
	 b:glossaryEntry="literature in metrical form"/>
<rdf:Description rdf:about="&a;105306820">
	<b:glossaryEntry>any communication resembling poetry in beauty or the evocation of feeling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105306946"
	 b:glossaryEntry="the writing of verse"/>
<rdf:Description rdf:about="&a;105307062"
	 b:glossaryEntry="a system of versification"/>
<rdf:Description rdf:about="&a;105307231"
	 b:glossaryEntry="(prosody) the accent in a metrical foot of verse"/>
<rdf:Description rdf:about="&a;105307412"
	 b:glossaryEntry="analysis of verse into metrical patterns"/>
<rdf:Description rdf:about="&a;105307507"
	 b:glossaryEntry="a poetic rhythm that imitates the rhythm of speech"/>
<rdf:Description rdf:about="&a;105307617"
	 b:glossaryEntry="the usual (iambic) meter of a ballad"/>
<rdf:Description rdf:about="&a;105307729">
	<b:glossaryEntry>a group of 2 or 3 syllables forming the basic unit of poetic rhythm</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105308005">
	<b:glossaryEntry>a metrical unit with stressed-unstressed-unstressed syllables</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105308119"
	 b:glossaryEntry="a metrical unit with unstressed-stressed syllables"/>
<rdf:Description rdf:about="&a;105308229">
	<b:glossaryEntry>a metrical unit with unstressed-unstressed-stressed syllables</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105308355">
	<b:glossaryEntry>a metrical unit with unstressed-stressed-unstressed syllables (e.g., `remember'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105308492"
	 b:glossaryEntry="a metrical unit with stressed-stressed-unstressed syllables"/>
<rdf:Description rdf:about="&a;105308605"
	 b:glossaryEntry="a metrical unit with stressed-stressed syllables"/>
<rdf:Description rdf:about="&a;105308707"
	 b:glossaryEntry="a metrical unit with unstressed-unstressed syllables"/>
<rdf:Description rdf:about="&a;105308823"
	 b:glossaryEntry="a verse line having four metrical feet"/>
<rdf:Description rdf:about="&a;105308918"
	 b:glossaryEntry="a verse line having five metrical feet"/>
<rdf:Description rdf:about="&a;105309013"
	 b:glossaryEntry="a verse line having six metrical feet"/>
<rdf:Description rdf:about="&a;105309106"
	 b:glossaryEntry="a verse line having eight metrical feet"/>
<rdf:Description rdf:about="&a;105309201">
	<b:glossaryEntry>a verse line having eight syllables or a poem of octosyllabic lines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105309327"
	 b:glossaryEntry="a verse line having ten syllables"/>
<rdf:Description rdf:about="&a;105309419">
	<b:glossaryEntry>correspondence in the sounds of two or more lines (esp. final sounds)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105309656"
	 b:glossaryEntry="a rhyme between words in the same line"/>
<rdf:Description rdf:about="&a;105309755">
	<b:glossaryEntry>use of the same consonant at the beginning of each stressed syllable in a line of verse: "around the rock the ragged rascal ran"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105309989">
	<b:glossaryEntry>the repetition of similar vowels in the stressed syllables of successive words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105310137">
	<b:glossaryEntry>the repetition of consonants (or consonant patterns) especially at the ends of words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105310296">
	<b:glossaryEntry>a stanza form having seven lines of iambic pentameter; introduced by Chaucer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105310430">
	<b:glossaryEntry>a stanza of eight lines of heroic verse with the rhyme scheme abababcc</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105310558"
	 b:glossaryEntry="an imperfect rhyme (e.g., `love'' and `move'')"/>
<rdf:Description rdf:about="&a;105310658">
	<b:glossaryEntry>a use of language that creates a literary effect (but often without regard for literal significance)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105311417">
	<b:glossaryEntry>an abrupt change within a sentence from one syntactic structure to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105311563">
	<b:glossaryEntry>the repeated use of the same word or word pattern as a rhetorical device</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105311872">
	<b:glossaryEntry>repetition of the final words of a sentence or line at the beginning of the next</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105312010"
	 b:glossaryEntry="repetition after intervening words"/>
<rdf:Description rdf:about="&a;105312102"
	 b:glossaryEntry="repetition or recapitulation in reverse order"/>
<rdf:Description rdf:about="&a;105312220">
	<b:glossaryEntry>repetition of the ends of two or more successive sentences, verses, etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105312360"
	 b:glossaryEntry="doubling of a word or words"/>
<rdf:Description rdf:about="&a;105312444"
	 b:glossaryEntry="repetition to gain special emphasis or extend meaning"/>
<rdf:Description rdf:about="&a;105312549">
	<b:glossaryEntry xml:space='preserve'><![CDATA[repetition of a word in a different case or inflection in the same sentence; "My own heart''s heart"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105312705">
	<b:glossaryEntry>repetition of a word or phrase as the beginning of successive clauses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105312842">
	<b:glossaryEntry>using a pronoun or other pro-word instead of repeating a word</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105312958">
	<b:glossaryEntry>repetition of a word or phrase at the beginning and another at the end of successive clauses, i.e., simultaneous use of anaphora and epistrophe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105313156"
	 b:glossaryEntry="the reversal of the normal order of words"/>
<rdf:Description rdf:about="&a;105313266">
	<b:glossaryEntry>the use of a word in a sense opposite to its normal sense (especially in irony)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105313422">
	<b:glossaryEntry>the juxtaposition of contrasting words or ideas to give a feeling of balance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105313555"
	 b:glossaryEntry="substitution of a title for a name"/>
<rdf:Description rdf:about="&a;105313647"
	 b:glossaryEntry="mentioning something by saying it will not be mentioned"/>
<rdf:Description rdf:about="&a;105313758">
	<b:glossaryEntry>breaking off in the middle of a sentence (as by writers of realistic conversations)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105313899"
	 b:glossaryEntry="address to an absent or imaginary person"/>
<rdf:Description rdf:about="&a;105313996">
	<b:glossaryEntry>strained or paradoxical use of words either in error (as `blatant'' to mean `flagrant'') or deliberately (as in a mixed metaphor: `blind mouths'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105314197"
	 b:glossaryEntry="inversion in the second of two parallel phrases"/>
<rdf:Description rdf:about="&a;105314299"
	 b:glossaryEntry="arrangement of clauses in ascending order of forcefulness"/>
<rdf:Description rdf:about="&a;105314409"
	 b:glossaryEntry="interchange of subject and predicate of a proposition"/>
<rdf:Description rdf:about="&a;105314519">
	<b:glossaryEntry>(theater) irony that occurs when the meaning of the situation is understood by the audience but not by the characters in the play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105314709"
	 b:glossaryEntry='an exclamatory rhetorical device; "O tempore! O mores"'/>
<rdf:Description rdf:about="&a;105314834">
	<b:glossaryEntry>special and significant stress by means of position or repetition e.g.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105314959">
	<b:glossaryEntry>a substitution of part of speech or gender or number or tense etc. (e.g., editorial `we'' for `I'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105315111">
	<b:glossaryEntry>immediate rephrasing for intensification or justification; "Seems, madam! Nay, it is"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105315255">
	<b:glossaryEntry>a rhetorical device in which the speaker reproaches the audience in order to incite or convince them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105315411"
	 b:glossaryEntry="use of two conjoined nouns instead of a noun and modifier"/>
<rdf:Description rdf:about="&a;105315524">
	<b:glossaryEntry>reversal of the syntactic relation of two words (as in `her beauty''s face'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105315655"
	 b:glossaryEntry="reversal of normal word order (as in `cheese I love'')"/>
<rdf:Description rdf:about="&a;105315765"
	 b:glossaryEntry="use of a series of subjects with a single predicate"/>
<rdf:Description rdf:about="&a;105315873">
	<b:glossaryEntry>use of a series of parallel clauses (as in `I came, I saw, I conquered'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105316002">
	<b:glossaryEntry>reversal of normal order of two words or sentences etc. (as in `bred and born'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105316145">
	<b:glossaryEntry>understatement, esp. expressing an affirmative by negating its contrary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105316280"
	 b:glossaryEntry="using words that imitate the sound they denote"/>
<rdf:Description rdf:about="&a;105316385">
	<b:glossaryEntry>suggesting by deliberately concise treatment that much of significance is omitted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105316564">
	<b:glossaryEntry>juxtaposing words having a common derivation (as in `sense and sensibility'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105316697">
	<b:glossaryEntry>using several conjunctions in close succession, especially where some might be omitted (as in `he ran and jumped and laughed for joy'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105316890"
	 b:glossaryEntry="anticipating and answering objections in advance"/>
<rdf:Description rdf:about="&a;105316994">
	<b:glossaryEntry>a comparison comprising a well-known quotation followed by a facetious sequel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105317127"
	 b:glossaryEntry="language used in a figurative or nonliteral sense"/>
<rdf:Description rdf:about="&a;105317444">
	<b:glossaryEntry>a trope that involves incongruity between what is expected and what occurs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105317607"
	 b:glossaryEntry="extravagant exaggeration"/>
<rdf:Description rdf:about="&a;105317702">
	<b:glossaryEntry>conventional metaphoric name for something, used esp. in Old English and Old Norse poetry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105317845">
	<b:glossaryEntry>a figure of speech in which an expression is used to refer to something that it does not literally denote in order to suggest a similarity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105318074">
	<b:glossaryEntry>a metaphor that has occurred so often that it has become a new meaning of the expression (e.g., `he is a snake'' may once have been a metaphor but after years of use it has died and become a new sense of the word `snake'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105318372">
	<b:glossaryEntry>a metaphor that exploits a similarity between experiences in different sense modalities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105318526">
	<b:glossaryEntry>substituting the name of an attribute or feature for the name of the thing itself (as in `they counted heads'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105318709"
	 b:glossaryEntry="substituting metonymy of one figurative sense for another"/>
<rdf:Description rdf:about="&a;105318823"
	 b:glossaryEntry="conjoining contradictory terms (as in `deafening silence'')"/>
<rdf:Description rdf:about="&a;105318936">
	<b:glossaryEntry>representing an abstract quality or idea as a person or creature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105319077">
	<b:glossaryEntry>a figure of speech that expresses a resemblance between things of different kinds (usually formed with `like'' or `as'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105319248">
	<b:glossaryEntry>substituting a more inclusive term for a less inclusive one or vice versa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105319378">
	<b:glossaryEntry>use of a word to govern two or more words though agreeing in number or case etc. with only one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105319528">
	<b:glossaryEntry xml:space='preserve'><![CDATA[use of a word to govern two or more words though appropriate to only one; "`Mr. Pickwick took his hat and his leave'' is an example of zeugma"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105319740"
	 b:glossaryEntry="communication that relies on hearing"/>
<rdf:Description rdf:about="&a;105319899">
	<b:glossaryEntry>communication by word of mouth; "his speech was slurred"; "he uttered harsh language"; "he recorded the language of the streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105320310">
	<b:glossaryEntry>the words that are spoken; "I listened to his words very closely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105320427"
	 b:glossaryEntry="sounds uttered for auditory communication"/>
<rdf:Description rdf:about="&a;105320939">
	<b:glossaryEntry>the exchange of spoken words; "they were perfectly comfortable together without speech"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105321079">
	<b:glossaryEntry>the sound made by the vibration of vocal folds modified by the resonance of the vocal tract; "a singer takes good care of his voice"; "the giraffe cannot make any vocalizations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105321341">
	<b:glossaryEntry>(linguistics) an individual sound unit of speech without concern as to whether or not it is a phoneme of some language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105321661">
	<b:glossaryEntry>(linguistics) the phonemes (or strings of phonemes) that constitute the various allomorphs of a morpheme</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105321825">
	<b:glossaryEntry>(linguistics) one of a small set of speech sounds that are distinguished by the speakers of a particular language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105322010">
	<b:glossaryEntry>(linguistics) any of various acoustically different forms of the same phoneme</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105322143">
	<b:glossaryEntry>a vowel whose quality or length is changed to indicate linguistic distinctions (such as sing sang sung song)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105322316">
	<b:glossaryEntry>a vowel sound that starts near the articulatory position for one vowel and moves toward the position for another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105322484"
	 b:glossaryEntry="a speech sound made with the vocal tract open"/>
<rdf:Description rdf:about="&a;105322685"
	 b:glossaryEntry="the system of accentuation used in a particular language"/>
<rdf:Description rdf:about="&a;105322822"
	 b:glossaryEntry="the system of consonants used in a particular language"/>
<rdf:Description rdf:about="&a;105322960"
	 b:glossaryEntry="the morphophonemics of a particular language"/>
<rdf:Description rdf:about="&a;105323072"
	 b:glossaryEntry="the system of phonemes recognized in a language"/>
<rdf:Description rdf:about="&a;105323217"
	 b:glossaryEntry="the system of phones used in a particular language"/>
<rdf:Description rdf:about="&a;105323371"
	 b:glossaryEntry="the pattern of syllable formation in a particular language"/>
<rdf:Description rdf:about="&a;105323487"
	 b:glossaryEntry="a system of tenses used in a particular language"/>
<rdf:Description rdf:about="&a;105323594">
	<b:glossaryEntry>the system of tones used in a particular language or dialect of a tone language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105323765"
	 b:glossaryEntry="the system of vowels used in a particular language"/>
<rdf:Description rdf:about="&a;105323874"
	 b:glossaryEntry="a neutral middle vowel; occurs in unstressed syllables"/>
<rdf:Description rdf:about="&a;105324005">
	<b:glossaryEntry>a schwa that is incidental to the pronunciation of a consonant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105324135"
	 b:glossaryEntry="a vowel that ends a stem and precedes an inflection"/>
<rdf:Description rdf:about="&a;105324260"
	 b:glossaryEntry="a vowel-like sound that serves as a consonant"/>
<rdf:Description rdf:about="&a;105324387">
	<b:glossaryEntry>a semivowel produced with the tongue near the palate (like the initial sound in the English word `yeast'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105324546"
	 b:glossaryEntry="a letter of the alphabet standing for a spoken vowel"/>
<rdf:Description rdf:about="&a;105324668">
	<b:glossaryEntry>a mark placed below or near a consonant (as in Hebrew or Arabic) to indicate the spoken vowel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105324819"
	 b:glossaryEntry="a speech sound that is not a vowel"/>
<rdf:Description rdf:about="&a;105325089"
	 b:glossaryEntry="a letter of the alphabet standing for a spoken consonant"/>
<rdf:Description rdf:about="&a;105325201">
	<b:glossaryEntry>a consonant articulated with the tip of the tongue near the gum ridge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105325365">
	<b:glossaryEntry>a consonant produced by stopping air at some point and suddenly releasing it; "his stop consonants are too aspirated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105325725"
	 b:glossaryEntry="the initial occluded phase of a stop consonant"/>
<rdf:Description rdf:about="&a;105325846">
	<b:glossaryEntry>the terminal forced release of pressure built up during the occlusive phase of a stop consonant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105326026"
	 b:glossaryEntry="the conversion of a simple stop consonant into an affricate"/>
<rdf:Description rdf:about="&a;105326143"
	 b:glossaryEntry="a consonant pronounced with aspiration"/>
<rdf:Description rdf:about="&a;105326236">
	<b:glossaryEntry>a manner of articulation involving an audible release of breath</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105326374"
	 b:glossaryEntry="a consonant whose articulation involves movement of the lips"/>
<rdf:Description rdf:about="&a;105326542">
	<b:glossaryEntry>a consonant that is articulated using both lips; /p/ or /b/ or /w/</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105326663"
	 b:glossaryEntry="a stop consonant that is produced with the lips"/>
<rdf:Description rdf:about="&a;105326786">
	<b:glossaryEntry>a stop consonant articulated by releasing pressure at the glottis; as in the sudden onset of a vowel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105326979"
	 b:glossaryEntry="the utterance of sounds modulated by the nasal resonators"/>
<rdf:Description rdf:about="&a;105327095">
	<b:glossaryEntry>a stop consonant made by the suction of air into the mouth (as in Bantu)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105327234">
	<b:glossaryEntry>consonant articulated by constricting (but not closing) the vocal tract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105327457">
	<b:glossaryEntry>a continuant consonant produced by breath moving against a narrowing of the vocal tract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105327632"
	 b:glossaryEntry="a consonant characterized by a hissing sound (like s or sh)"/>
<rdf:Description rdf:about="&a;105327767">
	<b:glossaryEntry>a composite speech sound consisting of a stop and a fricative articulated at the same point (as `ch'' in `chair'' and `j'' in `joy'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105327988">
	<b:glossaryEntry>a continuant consonant produced through the nose with the mouth closed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105328128">
	<b:glossaryEntry>a speech sound produced with both the oral and nasal passages open (as French nasal vowels)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105328291">
	<b:glossaryEntry>a frictionless non-nasal continuant (especially `l'' and `r'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105328404"
	 b:glossaryEntry="a consonant produced without sound from the vocal cords"/>
<rdf:Description rdf:about="&a;105328532"
	 b:glossaryEntry="a consonant articulated in the back of the mouth or throat"/>
<rdf:Description rdf:about="&a;105328666"
	 b:glossaryEntry="a speech sound accompanied by sound from the vocal cords"/>
<rdf:Description rdf:about="&a;105328790">
	<b:glossaryEntry>a loud utterance; often in protest or opposition; "the speaker was interrupted by loud cries from the rear of the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105329225">
	<b:glossaryEntry>a loud utterance of emotion (especially when inarticulate); "a cry of rage"; "a yell of pain"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105329393"
	 b:glossaryEntry='a very loud utterance; "his bellow filled the hallway"'/>
<rdf:Description rdf:about="&a;105329592"
	 b:glossaryEntry="a cry expressing disapproval"/>
<rdf:Description rdf:about="&a;105329674">
	<b:glossaryEntry>loud and persistent outcry from many people; "he ignored the clamor of the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105329857">
	<b:glossaryEntry>a shout to attract attention; "he gave a great halloo but no one heard him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105329985"
	 b:glossaryEntry="a loud raucous cry as of an awl"/>
<rdf:Description rdf:about="&a;105330067"
	 b:glossaryEntry="a cry of praise or adoration (to God)"/>
<rdf:Description rdf:about="&a;105330158"
	 b:glossaryEntry="sharp piercing cry"/>
<rdf:Description rdf:about="&a;105330285"
	 b:glossaryEntry="a loud hooting cry of exultation or excitement"/>
<rdf:Description rdf:about="&a;105330383"
	 b:glossaryEntry="a yell intended to rally a group of soldiers in battle"/>
<rdf:Description rdf:about="&a;105330531"
	 b:glossaryEntry="uttering a loud inarticulate cry as of pain or excitement"/>
<rdf:Description rdf:about="&a;105330653">
	<b:glossaryEntry>a songlike cry in which the voice fluctuates rapidly between the normal voice and falsetto</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105330795"
	 b:glossaryEntry="a cry or noise made to express displeasure or contempt"/>
<rdf:Description rdf:about="&a;105330964">
	<b:glossaryEntry>blasphemous language (expressing disrespect for God or for something sacred)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105331114"
	 b:glossaryEntry="obscene word or phrase"/>
<rdf:Description rdf:about="&a;105331240">
	<b:glossaryEntry>lewd or obscene talk or writing; " it was smoking-room bawdry" or "they published a collection of Elizabethan bawdy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105331417"
	 b:glossaryEntry="a preoccupation with scatology"/>
<rdf:Description rdf:about="&a;105331503"
	 b:glossaryEntry="profane or obscene expression usually of surprise or anger"/>
<rdf:Description rdf:about="&a;105331675"
	 b:glossaryEntry="a harsh hoarse utterance (as of a frog)"/>
<rdf:Description rdf:about="&a;105331777">
	<b:glossaryEntry>an abrupt excited utterance; "she gave an exclamation of delight"; "there was much exclaiming over it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105331986">
	<b:glossaryEntry>a word used in exclamations of confusion; "what the devil" or "the deuce with it" or "the dickens you say"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105332162"
	 b:glossaryEntry="an abrupt emphatic exclamation"/>
<rdf:Description rdf:about="&a;105332265">
	<b:glossaryEntry>a word or phrase conveying no independent meaning but added to fill out a sentence or metrical line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105332420"
	 b:glossaryEntry="an utterance expressing pain or disapproval"/>
<rdf:Description rdf:about="&a;105332522">
	<b:glossaryEntry>a long loud emotional utterance; "he gave a howl of pain"; "howls of laughter"; "their howling had no effect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105332704"
	 b:glossaryEntry="the sound of laughing"/>
<rdf:Description rdf:about="&a;105332914"
	 b:glossaryEntry="a loud laugh suggestive of a hen''s cackle"/>
<rdf:Description rdf:about="&a;105333008"
	 b:glossaryEntry="a soft partly suppressed laugh"/>
<rdf:Description rdf:about="&a;105333102"
	 b:glossaryEntry="a foolish or nervous laugh"/>
<rdf:Description rdf:about="&a;105333181"
	 b:glossaryEntry="a burst of deep loud hearty laughter"/>
<rdf:Description rdf:about="&a;105333284"
	 b:glossaryEntry="a loud laugh that sounds like a horse neighing"/>
<rdf:Description rdf:about="&a;105333415"
	 b:glossaryEntry="a disrespectful laugh"/>
<rdf:Description rdf:about="&a;105333508"
	 b:glossaryEntry="a nervous restrained laugh"/>
<rdf:Description rdf:about="&a;105333587">
	<b:glossaryEntry>calling out the name of a person (especially by a loudspeaker system); "the public address system in the hospital was used for paging"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105333774"
	 b:glossaryEntry="vulgar or irreverent speech or action"/>
<rdf:Description rdf:about="&a;105333921"
	 b:glossaryEntry="the manner of uttering a word"/>
<rdf:Description rdf:about="&a;105334082"
	 b:glossaryEntry="the utterance of sounds expressing great joy"/>
<rdf:Description rdf:about="&a;105334182"
	 b:glossaryEntry="an utterance made by exhaling audibly"/>
<rdf:Description rdf:about="&a;105334270"
	 b:glossaryEntry="a vicious angry growl"/>
<rdf:Description rdf:about="&a;105334343"
	 b:glossaryEntry="a convulsive gasp made during weeping"/>
<rdf:Description rdf:about="&a;105334440"
	 b:glossaryEntry="the utterance of intelligible speech"/>
<rdf:Description rdf:about="&a;105334587">
	<b:glossaryEntry>something spoken; "he could hear them uttering merry speeches"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105334702"
	 b:glossaryEntry="an utterance (of words) with spitting sounds (as in rage)"/>
<rdf:Description rdf:about="&a;105334824"
	 b:glossaryEntry="speaking without vibration of the vocal cords"/>
<rdf:Description rdf:about="&a;105334941"
	 b:glossaryEntry="a loud whisper"/>
<rdf:Description rdf:about="&a;105335015"
	 b:glossaryEntry="uttering in an irritated tone"/>
<rdf:Description rdf:about="&a;105335105"
	 b:glossaryEntry="incorrect pronunciation"/>
<rdf:Description rdf:about="&a;105335191">
	<b:glossaryEntry>two words are heteronyms if they are spelled the same way but differ in pronunciation (e.g. bow)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105335343">
	<b:glossaryEntry>two words are homographs if they are spelled the same way but differ in meaning (e.g. fair)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105335490">
	<b:glossaryEntry>two words are homonyms if they are pronounced or spelled the same way but have different meanings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105335677">
	<b:glossaryEntry>two words are homophones if they are pronounced the same way but differ in meaning or spelling or both (e.g. bare and bear)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105335856"
	 b:glossaryEntry="the same pronunciation for words of different origins"/>
<rdf:Description rdf:about="&a;105335965">
	<b:glossaryEntry xml:space='preserve'><![CDATA[distinctive manner of oral expression; "he couldn''t suppress his contemptuous accent"; "she had a very clear speech pattern"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105336177"
	 b:glossaryEntry="a slow speech pattern with prolonged vowels"/>
<rdf:Description rdf:about="&a;105336272">
	<b:glossaryEntry>bringing articulatory organs together so as to shape the sounds of speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105336512">
	<b:glossaryEntry>an articulatory gesture made by turning the tip of the tongue back against the roof of the mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105336683">
	<b:glossaryEntry>the articulation of speech regarded from the point of view of its intelligibility to the audience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105336866"
	 b:glossaryEntry="indistinct enunciation"/>
<rdf:Description rdf:about="&a;105336943">
	<b:glossaryEntry>the loss of sounds in the interior of a word (as in `fo''c''sle'' for `forecastle'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105337091">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an expression that is difficult to articulate clearly; "`rubber baby buggy bumper'' is a tongue twister"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105337255"
	 b:glossaryEntry="speech used for informal exchange of views"/>
<rdf:Description rdf:about="&a;105337608"
	 b:glossaryEntry="a lively or heated interchange of ideas and opinions"/>
<rdf:Description rdf:about="&a;105337716">
	<b:glossaryEntry>conversational speech used to communicate sociability more than information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105337874"
	 b:glossaryEntry="communication between individuals"/>
<rdf:Description rdf:about="&a;105338004"
	 b:glossaryEntry="sharing thoughts and feelings"/>
<rdf:Description rdf:about="&a;105338099">
	<b:glossaryEntry>a mutual expression of views (especially an unpleasant one); "they had a bitter exchange"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105338243"
	 b:glossaryEntry="an informal conversation"/>
<rdf:Description rdf:about="&a;105338361"
	 b:glossaryEntry="light informal conversation for social occasions"/>
<rdf:Description rdf:about="&a;105338555">
	<b:glossaryEntry>a conversation that spreads personal information about other people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105338714"
	 b:glossaryEntry="spreading malicious gossip"/>
<rdf:Description rdf:about="&a;105338816">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an exchange of ideas via conversation; "let''s have more work and less talk around here"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105339054">
	<b:glossaryEntry>talk about your business that only others in the same business can understand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105339187"
	 b:glossaryEntry="a conversation between two persons"/>
<rdf:Description rdf:about="&a;105339296"
	 b:glossaryEntry="noisy talk"/>
<rdf:Description rdf:about="&a;105339413"
	 b:glossaryEntry="idle or foolish talk"/>
<rdf:Description rdf:about="&a;105339530">
	<b:glossaryEntry xml:space='preserve'><![CDATA[empty or insincere or exaggerated talk; that''s a lot of wind"; "don''t give me any of that jazz"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105339710"
	 b:glossaryEntry="insincere talk about religion or morals"/>
<rdf:Description rdf:about="&a;105339818">
	<b:glossaryEntry>inconsequential conversation; "they traded a few nothings as they parted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105339964">
	<b:glossaryEntry>inconsequential expressions of affection; "he whispered sweet nothings into her ear"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105340125"
	 b:glossaryEntry="social exchange, esp. of opinions, attitudes, etc."/>
<rdf:Description rdf:about="&a;105340230"
	 b:glossaryEntry="formal conversation"/>
<rdf:Description rdf:about="&a;105340304">
	<b:glossaryEntry>extended treatment of particulars; "the essay contained too much detail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105340429">
	<b:glossaryEntry>an extended communication (often interactive) dealing with some particular topic; "the book contains an excellent discussion of modal logic"; "his treatment of the race question is badly biased"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105340758">
	<b:glossaryEntry>a report of a discourse in which deictic terms are modified appropriately (e.g., `he said `I am a fool'''' would be modified to `he said he is a fool'')</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105340990">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a report of the exact words used in a discourse; e.g., `he said "I am a fool"'']]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105341168">
	<b:glossaryEntry>a discussion of a topic (as in a meeting); "consideration of the traffic problem took more than an hour"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105341350">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(`talk about'' is a less formal alternative for `discussion of'') discussion; "his poetry contains much talk about love and anger"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105341529">
	<b:glossaryEntry>a consideration of a topic (as in a meeting) with a view to changing an earlier decision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105341679">
	<b:glossaryEntry>a communication intended to urge or persuade the recipients to take some action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105341816">
	<b:glossaryEntry>the communication (in speech or writing) of your beliefs or opinions; "expressions of good will"; "he helped me find expression for my ideas"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105342032">
	<b:glossaryEntry>an exchange of views on some topic; "we had a good discussion"; "we had a word or two about it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105342315">
	<b:glossaryEntry>a discussion in which reasons are advanced for and against some proposition or proposal; "the argument over foreign aid goes on and on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105342514"
	 b:glossaryEntry="a negotiation between enemies"/>
<rdf:Description rdf:about="&a;105342596"
	 b:glossaryEntry="(informal) voluble conversation"/>
<rdf:Description rdf:about="&a;105342677">
	<b:glossaryEntry>conversation in a situation where feelings can be expressed and criticized or supported</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105342822"
	 b:glossaryEntry="conversation during a meal"/>
<rdf:Description rdf:about="&a;105342905"
	 b:glossaryEntry="a conversation over the telephone"/>
<rdf:Description rdf:about="&a;105343007"
	 b:glossaryEntry="a private conversation between two people"/>
<rdf:Description rdf:about="&a;105343106">
	<b:glossaryEntry>(usually plural) discussion of all sides of a question; "the deliberations of the jury"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105343252">
	<b:glossaryEntry>a discussion among participants who have an agreed (serious) topic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105343592"
	 b:glossaryEntry="(informal) an informal discussion (usually among men)"/>
<rdf:Description rdf:about="&a;105343704"
	 b:glossaryEntry="a conversation especially a formal one"/>
<rdf:Description rdf:about="&a;105343797">
	<b:glossaryEntry>a conference between two or more people to consider a particular question; "frequent consultations with his lawyer"; "a consultation of several medical specialists"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105344038">
	<b:glossaryEntry>(law) a courtroom conference between the lawyers and the judge in a trial that is held out of the jury''s hearing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105344204">
	<b:glossaryEntry>a conference (usually with someone important); "he had a consultation with the judge"; "he requested an audience with the king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105344413">
	<b:glossaryEntry>discussion of a subject of public interest by a group of persons forming a panel usually before an audience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105344583"
	 b:glossaryEntry="discussion of an event after it has occurred"/>
<rdf:Description rdf:about="&a;105344684"
	 b:glossaryEntry="(informal) a quick private conference"/>
<rdf:Description rdf:about="&a;105344783">
	<b:glossaryEntry>a conference at which press and tv reporters ask questions of a politician or other celebrity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105344957">
	<b:glossaryEntry>(law) a conference held before the trial begins to bring the parties together to outline discovery proceedings and to define the issues to be tried; more useful in civil than in criminal cases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105345226">
	<b:glossaryEntry>a meeting of peers for discussion and exchange of views; "a roundtable on the future of computing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105345420">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a meeting for execution of a group''s functions; "it was the opening session of the legislature"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105345677">
	<b:glossaryEntry>an extended session (as on a college campus) for lectures and discussion on an important and usually controversial issue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105345852">
	<b:glossaryEntry>a conference of people who are in different locations that is made possible by the use of such telecommunications equipment as closed-circuit television</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105346084"
	 b:glossaryEntry="a session as of a legislature or court"/>
<rdf:Description rdf:about="&a;105346176">
	<b:glossaryEntry>meeting for diagnosis of problems and instruction or remedial work in a particular activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105346392"
	 b:glossaryEntry="a clinic for people with reading disabilities"/>
<rdf:Description rdf:about="&a;105346498">
	<b:glossaryEntry>a meeting at which basketball players receive special evaluation and instruction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105346642">
	<b:glossaryEntry>a meeting at which baseball players receive special evaluation and instruction; "a summer baseball clinic for promising young players"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105346838">
	<b:glossaryEntry>a meeting at which hockey players receive special evaluation and instruction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105346974">
	<b:glossaryEntry>a session (usually of a legislative body) that is closed to the public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105347125">
	<b:glossaryEntry>a session (of a committee or grand jury) in which witnesses are called and testimony is taken; "the investigative committee will hold hearings in Chicago"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105347351">
	<b:glossaryEntry>a hearing held by the U.S. senate to gather information on which to approve or reject candidates for high federal office that are nominated by the president</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105347574"
	 b:glossaryEntry="a session that is held in addition to the regular sessions"/>
<rdf:Description rdf:about="&a;105347694">
	<b:glossaryEntry>a session of intensive tuition given by a tutor to an individual or to a small number of students</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105347846">
	<b:glossaryEntry>a discussion intended to produce an agreement; "the buyout negotiation lasted several days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105348111"
	 b:glossaryEntry="negotiation between nations"/>
<rdf:Description rdf:about="&a;105348274"
	 b:glossaryEntry="diplomacy influenced by economic considerations"/>
<rdf:Description rdf:about="&a;105348384">
	<b:glossaryEntry>diplomacy in which the nations threaten to use force in order to obtain their objectives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105348553">
	<b:glossaryEntry>negotiations between the US and the USSR opened in 1969 in Helsinki designed to limit both countries'' stock of nuclear weapons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105348764"
	 b:glossaryEntry="the negotiation of the terms of a transaction or agreement"/>
<rdf:Description rdf:about="&a;105348933"
	 b:glossaryEntry="negotiation between an employer and trade union"/>
<rdf:Description rdf:about="&a;105349048"
	 b:glossaryEntry="an instance of intense bargaining"/>
<rdf:Description rdf:about="&a;105349167">
	<b:glossaryEntry>a refusal by a negotiator to come to terms in the hope of obtaining a better deal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105349302">
	<b:glossaryEntry>negotiation accompanied by mutual concessions and shrewd bargaining</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105349429">
	<b:glossaryEntry>negotiation to resolve differences conducted by some impartial party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105349585"
	 b:glossaryEntry="mediation by an umpire"/>
<rdf:Description rdf:about="&a;105349662">
	<b:glossaryEntry>a word or phrase that particular people use in particular situations; "pardon the expression"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105350084"
	 b:glossaryEntry="an expression that relates to anatomy"/>
<rdf:Description rdf:about="&a;105350201"
	 b:glossaryEntry="a locution or pronunciation peculiar to the southern US"/>
<rdf:Description rdf:about="&a;105350314"
	 b:glossaryEntry="a very short speech; usually on radio or television"/>
<rdf:Description rdf:about="&a;105350422"
	 b:glossaryEntry="a favorite saying of a sect or political group"/>
<rdf:Description rdf:about="&a;105350572"
	 b:glossaryEntry='a slogan used to rally support for a cause; "a cry to arms"'/>
<rdf:Description rdf:about="&a;105350719"
	 b:glossaryEntry="a saying that widely accepted on its own merits"/>
<rdf:Description rdf:about="&a;105350862"
	 b:glossaryEntry="a short pithy saying expressing a general truth"/>
<rdf:Description rdf:about="&a;105350961"
	 b:glossaryEntry="a short pithy instructive saying"/>
<rdf:Description rdf:about="&a;105351072"
	 b:glossaryEntry="a witty saying"/>
<rdf:Description rdf:about="&a;105351147">
	<b:glossaryEntry>a condensed but memorable saying embodying some important fact of experience that is taken as true by many people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105351337"
	 b:glossaryEntry="a trite or obvious remark"/>
<rdf:Description rdf:about="&a;105351480"
	 b:glossaryEntry="an obvious truth"/>
<rdf:Description rdf:about="&a;105351567">
	<b:glossaryEntry>an expression whose meanings cannot be inferred from the meanings of the words that make it up</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105351774"
	 b:glossaryEntry="sayings of Jesus not recorded in the canonical Gospels"/>
<rdf:Description rdf:about="&a;105351882">
	<b:glossaryEntry>speech that differs from the usual accepted easily-recognizable speech of native adult members of a speech community</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105352208"
	 b:glossaryEntry="the developing speech of a young child"/>
<rdf:Description rdf:about="&a;105352302"
	 b:glossaryEntry="an adult''s imitation of the speech of a young child"/>
<rdf:Description rdf:about="&a;105352409">
	<b:glossaryEntry>the usage or vocabulary that is characteristic of a specific group of people; "the immigrants spoke an odd dialect of English"; "he has a strong German accent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105352657">
	<b:glossaryEntry>a regional dialect of a language (especially French); usually considered substandard</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105352794">
	<b:glossaryEntry>a phrase or pronunciation that is peculiar to a particular locality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105352916">
	<b:glossaryEntry>the language or speech of one individual at a particular period in life</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105353042">
	<b:glossaryEntry>a long utterance by one person (especially one that prevents others from participating in the conversation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105353205">
	<b:glossaryEntry>language characterized by terseness and ellipsis as in telegrams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105353328">
	<b:glossaryEntry>the everyday speech of the people (as distinguished from literary language)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105353460">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a characteristic language of a particular group (as among thieves); "they don''t speak our lingo"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105353662">
	<b:glossaryEntry>informal language consisting of words and expressions that are not considered appropriate for formal occasions; often vituperative or vulgar; "their speech was full of slang expressions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105353900">
	<b:glossaryEntry>a verbal formula believed to have magical force; "he whispered a spell as he moved his hands"; "inscribed around its base is a charm in Balinese"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105354155"
	 b:glossaryEntry="a ritual recitation of magical words or sounds"/>
<rdf:Description rdf:about="&a;105354259"
	 b:glossaryEntry='an evil spell; "a witch put a curse on his whole family"'/>
<rdf:Description rdf:about="&a;105354380"
	 b:glossaryEntry="speech intended for reproduction in writing"/>
<rdf:Description rdf:about="&a;105354479"
	 b:glossaryEntry="speech you make to yourself"/>
<rdf:Description rdf:about="&a;105354574"
	 b:glossaryEntry="the use of language to perform some act"/>
<rdf:Description rdf:about="&a;105355066">
	<b:glossaryEntry>the act of making a proposal; "they listened to her proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105355200"
	 b:glossaryEntry="an offer of marriage"/>
<rdf:Description rdf:about="&a;105355353">
	<b:glossaryEntry>an informal reference to a marriage proposal; "he was ready to pop the question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105355488"
	 b:glossaryEntry="something proposed (as a plan)"/>
<rdf:Description rdf:about="&a;105355699"
	 b:glossaryEntry="a proposal offered as an alternative to an earlier proposal"/>
<rdf:Description rdf:about="&a;105355820"
	 b:glossaryEntry="a proposal intended to explain certain facts or observations"/>
<rdf:Description rdf:about="&a;105355937"
	 b:glossaryEntry="a proposal offered for acceptance or rejection"/>
<rdf:Description rdf:about="&a;105356118">
	<b:glossaryEntry>a new proposal; "they resisted the introduction of impractical alternatives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105356253">
	<b:glossaryEntry>a proposal of something previously rejected; "they avoided a re-introduction of the old terminology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105356415"
	 b:glossaryEntry="the first presentation of a bill in a legislature"/>
<rdf:Description rdf:about="&a;105356524">
	<b:glossaryEntry>the second presentation of a bill in a legislature; to approve its general principles (Britain) or to discuss a committee''s report and take a vote (US)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105356736">
	<b:glossaryEntry>a formal proposal for action made to a deliberative assembly for discussion and vote; "he made a motion to adjourn"; "she called for the question"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105356946">
	<b:glossaryEntry>a motion calling for an immediate vote on the main question under discussion by a deliberative assembly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105357131">
	<b:glossaryEntry>an indirect suggestion; "not a breath of scandal ever touched her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105357270">
	<b:glossaryEntry>a suggestion of some quality; "there was a touch of sarcasm in his tone"; "he detected a ghost of a smile on her face"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105357456">
	<b:glossaryEntry>a tentative suggestion designed to elicit the reactions of others; "she rejected his advances"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105357635">
	<b:glossaryEntry>something offered (as a proposal or bid); "noteworthy new offerings for investors included several index funds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105357935"
	 b:glossaryEntry="an offer made by someone who has rejected a prior offer"/>
<rdf:Description rdf:about="&a;105358049"
	 b:glossaryEntry="a proposal to buy at a specified price"/>
<rdf:Description rdf:about="&a;105358182"
	 b:glossaryEntry="a bid that is higher than preceding bids"/>
<rdf:Description rdf:about="&a;105358276"
	 b:glossaryEntry="a bid to buy all of a person''s holdings"/>
<rdf:Description rdf:about="&a;105358372">
	<b:glossaryEntry>an offer to buy shares in a corporation (usually above the market price) for cash or securities or both</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105358552">
	<b:glossaryEntry>the offer of money for helping to find a criminal or for returning lost property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105358703">
	<b:glossaryEntry>a special offering (usually temporary and at a reduced price) that is featured in advertising; "they are having a special on pork chops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105358893">
	<b:glossaryEntry>a reward for helping to catch a criminal; "the cattle thief has a price on his head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105359029">
	<b:glossaryEntry>something offered to an adversary in the hope of obtaining peace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105359169"
	 b:glossaryEntry="the act of presenting a proposal"/>
<rdf:Description rdf:about="&a;105359296"
	 b:glossaryEntry="a message submitted in a competition"/>
<rdf:Description rdf:about="&a;105359415">
	<b:glossaryEntry>the entering of a legal document into the public record; "he filed a complaint"; "he filed his tax return"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105359574"
	 b:glossaryEntry="an authoritative direction or instruction to do something"/>
<rdf:Description rdf:about="&a;105359821">
	<b:glossaryEntry>(often plural) a command given by a superior (e.g., a military or law enforcement officer) that must be obeyed; "the British ships dropped anchor and waited for orders from London"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105360089"
	 b:glossaryEntry='a verbal command for action; "when I give the word, charge!"'/>
<rdf:Description rdf:about="&a;105360200"
	 b:glossaryEntry="an order to appear in person at a given place and time"/>
<rdf:Description rdf:about="&a;105360326"
	 b:glossaryEntry="an order to report for military duty"/>
<rdf:Description rdf:about="&a;105360416">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a formal statement of a command or injunction to do something; "the judge''s charge to the jury"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105360607"
	 b:glossaryEntry="an incorrect charge to a jury given by a judge"/>
<rdf:Description rdf:about="&a;105360712"
	 b:glossaryEntry="something that is commanded"/>
<rdf:Description rdf:about="&a;105360815"
	 b:glossaryEntry="the biblical commandments of Moses"/>
<rdf:Description rdf:about="&a;105360924">
	<b:glossaryEntry>a pronouncement encouraging or banning some activity; "the boss loves to send us directives"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105361072"
	 b:glossaryEntry="a formal command or admonition"/>
<rdf:Description rdf:about="&a;105361159"
	 b:glossaryEntry="an authoritative command or request"/>
<rdf:Description rdf:about="&a;105361247"
	 b:glossaryEntry="a magical command; used by Ali Baba"/>
<rdf:Description rdf:about="&a;105361340"
	 b:glossaryEntry="an explanation resulting from interpreting something"/>
<rdf:Description rdf:about="&a;105361669">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an interpretation that clears up ambiguity; "the professor''s clarification helped her to understand the textbook"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105361856">
	<b:glossaryEntry>an explanation or critical interpretation (especially of the Bible)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105361978">
	<b:glossaryEntry>a passage from the Bible that is used as the subject of a sermon; "the preacher chose a text from Psalms to introduce his sermon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105362177"
	 b:glossaryEntry="an interpretation that provides additional information"/>
<rdf:Description rdf:about="&a;105362301"
	 b:glossaryEntry="an interpretation based on the exact wording"/>
<rdf:Description rdf:about="&a;105362432">
	<b:glossaryEntry>a strictly literal interpretation (as distinct from the intention); "he followed instructions to the letter"; "he obeyed the letter of the law"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105362628">
	<b:glossaryEntry>an interpretation of a matter from a particular viewpoint; "his version of the fight was different from mine"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105362809">
	<b:glossaryEntry>a particular interpretation or performance; "on that reading it was an insult"; "he was famous for his reading of Mozart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105362984">
	<b:glossaryEntry>an interpretation of a text or action; "they put an unsympathetic construction on his conduct"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105363145">
	<b:glossaryEntry>an interpretation formed by piecing together bits of evidence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105363267"
	 b:glossaryEntry="an interpretation that easily understandable and acceptable"/>
<rdf:Description rdf:about="&a;105363387">
	<b:glossaryEntry>putting the wrong interpretation on; "his misinterpretation of the question caused his error" or "there was no mistaking her meaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105363669"
	 b:glossaryEntry="a very embarrassing misunderstanding"/>
<rdf:Description rdf:about="&a;105363761"
	 b:glossaryEntry="a deliberate misinterpretation"/>
<rdf:Description rdf:about="&a;105363868"
	 b:glossaryEntry="misinterpretation caused by inaccurate reading"/>
<rdf:Description rdf:about="&a;105363971"
	 b:glossaryEntry="the verbal act of agreeing"/>
<rdf:Description rdf:about="&a;105364269">
	<b:glossaryEntry>agreement with a statement or proposal; "he gave his assent eagerly"; "a murmur of consent from the assembly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105364474"
	 b:glossaryEntry="happy friendly agreement"/>
<rdf:Description rdf:about="&a;105364555">
	<b:glossaryEntry>in contract law: words signifying consent to the terms of an offer (thereby creating a contract)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105364726"
	 b:glossaryEntry="the act of conceding or yielding"/>
<rdf:Description rdf:about="&a;105364856">
	<b:glossaryEntry>you advance to the next round in a tournament without playing an opponent; "he had a bye in the first round"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105365021"
	 b:glossaryEntry="agreement of results or opinions"/>
<rdf:Description rdf:about="&a;105365111">
	<b:glossaryEntry>concurrence of opinion; "we are in accord with your proposal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105365251"
	 b:glossaryEntry="agreement on a secret plot"/>
<rdf:Description rdf:about="&a;105365346">
	<b:glossaryEntry>agreeing with; "assenting to the Congressional determination"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105365475">
	<b:glossaryEntry>a settlement of differences; "they reached an accommodation with Japan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105365642">
	<b:glossaryEntry>a final settlement; "the conclusion of a business deal"; "the conclusion of the peace treaty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105365792"
	 b:glossaryEntry="a conclusive resolution of a matter and disposition of it"/>
<rdf:Description rdf:about="&a;105365996">
	<b:glossaryEntry>resolution of a dispute prior to the rendering of a final decision by the trial court</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105366151">
	<b:glossaryEntry>(matrimonial law) the division of property owned or acquired by marriage partners during their marriage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105366320">
	<b:glossaryEntry>the settlement of a debt by paying less than the amount demanded in exchange for extinguishing the debt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105366493">
	<b:glossaryEntry>an agreement by two or more people to commit suicide together at a given place and time; "the two lovers killed themselves in a suicide pact"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105366693">
	<b:glossaryEntry>a temporary accommodation of a disagreement between parties pending a permanent settlement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105366843">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an accommodation in which both sides make concessions; "the newly elected congressmen rejected a compromise because they considered it `business as usual''"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105367055">
	<b:glossaryEntry>agreement expressed by (or as if expressed by) signing your name</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105367196">
	<b:glossaryEntry>making something valid by formally ratifying or confirming it; "the ratification of the treaty"; "confirmation of the appointment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105367418"
	 b:glossaryEntry="agreement of opinions"/>
<rdf:Description rdf:about="&a;105367517"
	 b:glossaryEntry='a speech seconding a motion; "do I hear a second?"'/>
<rdf:Description rdf:about="&a;105367634"
	 b:glossaryEntry="the speech act of disagreeing or arguing or disputing"/>
<rdf:Description rdf:about="&a;105367872"
	 b:glossaryEntry="a hostile disagreement face-to-face"/>
<rdf:Description rdf:about="&a;105367990"
	 b:glossaryEntry="disagreement; especially disagreement with the government"/>
<rdf:Description rdf:about="&a;105368104"
	 b:glossaryEntry="a difference of opinion"/>
<rdf:Description rdf:about="&a;105368181"
	 b:glossaryEntry="lack of harmony or correspondence"/>
<rdf:Description rdf:about="&a;105368274"
	 b:glossaryEntry="disagreement among those expected to cooperate"/>
<rdf:Description rdf:about="&a;105368405"
	 b:glossaryEntry="discord that splits a group"/>
<rdf:Description rdf:about="&a;105368498">
	<b:glossaryEntry>a disagreement or argument about something important; "he had a dispute with his wife"; "there were irreconcilable differences"; "the familiar conflict between Republicans and Democrats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105368840"
	 b:glossaryEntry="a weak argument set up to be easily refuted"/>
<rdf:Description rdf:about="&a;105368939">
	<b:glossaryEntry>an argument in which the participants are trying to gain some advantage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105369065"
	 b:glossaryEntry="an argument that ignores all unfavorable evidence"/>
<rdf:Description rdf:about="&a;105369177">
	<b:glossaryEntry>a dispute where there is strong disagreement; "they were involved in a violent argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105369415"
	 b:glossaryEntry="a controversy (especially over a belief or dogma)"/>
<rdf:Description rdf:about="&a;105369518"
	 b:glossaryEntry='an angry dispute; "they had a quarrel"; "they had words"'/>
<rdf:Description rdf:about="&a;105369724">
	<b:glossaryEntry>an intense verbal dispute; "a violent fight over the bill is expected in the Senate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105369860"
	 b:glossaryEntry="noisy quarrel"/>
<rdf:Description rdf:about="&a;105369967"
	 b:glossaryEntry="a silly altercation"/>
<rdf:Description rdf:about="&a;105370050"
	 b:glossaryEntry="petty quarrel"/>
<rdf:Description rdf:about="&a;105370160"
	 b:glossaryEntry="a serious quarrel (especially one that ends a friendship)"/>
<rdf:Description rdf:about="&a;105370271"
	 b:glossaryEntry='the verbal act of offering; "a generous offer of assitance"'/>
<rdf:Description rdf:about="&a;105370393"
	 b:glossaryEntry="the verbal act of requesting"/>
<rdf:Description rdf:about="&a;105370646">
	<b:glossaryEntry>a request for payment; "the notification stated the grace period and the penalties for defaulting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105370812">
	<b:glossaryEntry>an expression of some desire or inclination; "I could tell that it was his wish that the guests leave"; "his crying was an indirect request for attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105371036"
	 b:glossaryEntry="a formal request to participate or be present"/>
<rdf:Description rdf:about="&a;105371174"
	 b:glossaryEntry='a request to be present; "they came at his bidding"'/>
<rdf:Description rdf:about="&a;105371289">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a colloquial expression for invitation; "he didn''t get no invite to the party"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105371420"
	 b:glossaryEntry="earnest or urgent request"/>
<rdf:Description rdf:about="&a;105371608">
	<b:glossaryEntry>impassioned appeals to the prejudices and emotions of the populace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105371761"
	 b:glossaryEntry="an appeal intended to arouse patriotic emotions"/>
<rdf:Description rdf:about="&a;105371877"
	 b:glossaryEntry="humble request for help"/>
<rdf:Description rdf:about="&a;105371966">
	<b:glossaryEntry>an entreaty addressed to someone of superior status; "a solicitation to the king for relief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105372171">
	<b:glossaryEntry>a solicitation for money or food (especially in the street by an apparently penniless person)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105372341">
	<b:glossaryEntry>the act of soliciting money (as a gift or loan); "he watched the beggar trying to make a touch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105372488"
	 b:glossaryEntry="insistent begging"/>
<rdf:Description rdf:about="&a;105372563">
	<b:glossaryEntry>a petition or appeal made to a person of superior status or rank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105372686">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a man''s courting of a woman; seeking the affections of a woman (usually with the hope of marriage); "its was a brief and intense courtship"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105372926">
	<b:glossaryEntry>a one-time custom during courtship of unmarried couples occupying the same bed without undressing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105373078"
	 b:glossaryEntry="reverent petition to a deity"/>
<rdf:Description rdf:about="&a;105373317"
	 b:glossaryEntry="a ceremonial prayer invoking divine protection"/>
<rdf:Description rdf:about="&a;105373450"
	 b:glossaryEntry="a spoken blessing"/>
<rdf:Description rdf:about="&a;105373521">
	<b:glossaryEntry>a short prayer generally preceding the lesson in the Church of Rome or the Church of England</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105373667">
	<b:glossaryEntry>prayers proclaiming God''s anger against sinners; read in the Church of England on Ash Wednesday</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105373820"
	 b:glossaryEntry="a short prayer of thanks before a meal"/>
<rdf:Description rdf:about="&a;105373954"
	 b:glossaryEntry="a prayer to God on behalf of another person"/>
<rdf:Description rdf:about="&a;105374056"
	 b:glossaryEntry="a prayer asking God''s help as part of a religious service"/>
<rdf:Description rdf:about="&a;105374222"
	 b:glossaryEntry="a solemn supplication ceremony prescribed by the church"/>
<rdf:Description rdf:about="&a;105374332"
	 b:glossaryEntry="a prayer for the repose of the soul of a dead person"/>
<rdf:Description rdf:about="&a;105374441">
	<b:glossaryEntry>a request; "many calls for Christmas stories"; "not many calls for buggywhips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105374570">
	<b:glossaryEntry>request for payment of a debt; "they submitted their charges at the end of each month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105374737"
	 b:glossaryEntry="a document that must be accepted and paid by another person"/>
<rdf:Description rdf:about="&a;105374854">
	<b:glossaryEntry>an urgent or peremptory request; "his demands for attention were unceasing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105375126"
	 b:glossaryEntry="a demand by a sentry for a password or identification"/>
<rdf:Description rdf:about="&a;105375235"
	 b:glossaryEntry="a final peremptory demand"/>
<rdf:Description rdf:about="&a;105375316"
	 b:glossaryEntry="continual and persistent demands"/>
<rdf:Description rdf:about="&a;105375417"
	 b:glossaryEntry='a demand especially in the phrase "the call of duty"'/>
<rdf:Description rdf:about="&a;105375528"
	 b:glossaryEntry="an authoritative request"/>
<rdf:Description rdf:about="&a;105375610">
	<b:glossaryEntry>a demand for a show of hands in a card game; "after two raises there was a call"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105375760">
	<b:glossaryEntry>a demand by a broker that a customer deposit enough to bring his margin up to the minimum requirement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105375926">
	<b:glossaryEntry>the wage demanded from management for workers by their union representatives</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105376071">
	<b:glossaryEntry>a request by children on Halloween; they pass from door to door asking for goodies and threatening to play tricks on those who refuse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105376265"
	 b:glossaryEntry="a request for information"/>
<rdf:Description rdf:about="&a;105376414">
	<b:glossaryEntry>questioning a statement and demanding an explanation; "he challenged the assumption that Japan is our enemy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105376578">
	<b:glossaryEntry>an instance of questioning; "there was a question about my training"; "we made inquiries of all those who were present"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105376816"
	 b:glossaryEntry="a question that can be answered by yes or no"/>
<rdf:Description rdf:about="&a;105376922"
	 b:glossaryEntry="formal systematic questioning"/>
<rdf:Description rdf:about="&a;105377133">
	<b:glossaryEntry>a series of question put to an individual (such as a political candidate) to elicit their views</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105377284"
	 b:glossaryEntry="a severe interrogation"/>
<rdf:Description rdf:about="&a;105377364">
	<b:glossaryEntry>interrogation accompanied by torture to extort information or a confession</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105377497"
	 b:glossaryEntry="close questioning"/>
<rdf:Description rdf:about="&a;105377597"
	 b:glossaryEntry="a question asked in cross-examination"/>
<rdf:Description rdf:about="&a;105377714">
	<b:glossaryEntry>the questioning of a person (or a conversation in which information is elicited); often conducted by journalists; "my interviews with teen-agers revealed a weakening of religious bonds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105377973"
	 b:glossaryEntry="an interview conducted over the telephone"/>
<rdf:Description rdf:about="&a;105378080">
	<b:glossaryEntry>a sentence of inquiry that asks for a reply; "he asked a direct question"; "he had trouble phrasing his interrogations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105378329">
	<b:glossaryEntry>a set of questions or exercises evaluating skill or knowledge; "when the test was stolen the professor had to make a new set of questions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105378665"
	 b:glossaryEntry="an examination administered at the end of an academic term"/>
<rdf:Description rdf:about="&a;105378809">
	<b:glossaryEntry>an examination administered in the middle of an academic term</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105378961"
	 b:glossaryEntry="a quiz given without prior warning"/>
<rdf:Description rdf:about="&a;105379050"
	 b:glossaryEntry="an examination conducted by word of mouth"/>
<rdf:Description rdf:about="&a;105379185">
	<b:glossaryEntry>an examination taken by graduate students to determine their fitness to continue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105379363"
	 b:glossaryEntry="an examination consisting of a few short questions"/>
<rdf:Description rdf:about="&a;105379482"
	 b:glossaryEntry="a written examination"/>
<rdf:Description rdf:about="&a;105379577"
	 b:glossaryEntry="final honors degree examinations at Cambridge University"/>
<rdf:Description rdf:about="&a;105379686">
	<b:glossaryEntry>the speech act of continuing a conversational exchange; "he growled his reply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105379917"
	 b:glossaryEntry="a reply that has no relevance to what preceded it"/>
<rdf:Description rdf:about="&a;105380025">
	<b:glossaryEntry>a reply to a question or remark (especially a witty or critical one); "it brought a sharp rejoinder from the teacher"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105380255"
	 b:glossaryEntry="a reply that repeats what has just been said"/>
<rdf:Description rdf:about="&a;105380350"
	 b:glossaryEntry="the speech act of replying to a question"/>
<rdf:Description rdf:about="&a;105380497"
	 b:glossaryEntry="lots thrown to determine God''s answers to yes-no questions"/>
<rdf:Description rdf:about="&a;105380618">
	<b:glossaryEntry>the speech act of answering an attack on your assertions; "his refutation of the charges was short and persuasive"; "in defense he said the other man started it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105380874">
	<b:glossaryEntry>the act of refuting by offering a contrary contention or argument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105380994"
	 b:glossaryEntry="a act of describing something"/>
<rdf:Description rdf:about="&a;105381135">
	<b:glossaryEntry>a graphic or vivid verbal description; "too often the narrative was interrupted by long word pictures"; "the author gives a depressing picture of life in Poland"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105381462"
	 b:glossaryEntry="descriptive word or phrase"/>
<rdf:Description rdf:about="&a;105381542"
	 b:glossaryEntry="a word picture of a person''s appearance and character"/>
<rdf:Description rdf:about="&a;105381676">
	<b:glossaryEntry>a brief description given for purposes of identification; "the label Modern is applied to many different kinds of architecture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105381855"
	 b:glossaryEntry="an individualized description of a particular instance"/>
<rdf:Description rdf:about="&a;105381985"
	 b:glossaryEntry="brief description"/>
<rdf:Description rdf:about="&a;105382066"
	 b:glossaryEntry="the act of affirming or asserting or stating something"/>
<rdf:Description rdf:about="&a;105382220"
	 b:glossaryEntry="one chap''s arbitrary assertion"/>
<rdf:Description rdf:about="&a;105382303"
	 b:glossaryEntry='a reply of affirmation; "he answered in the affirmative"'/>
<rdf:Description rdf:about="&a;105382489"
	 b:glossaryEntry='an affirmative; "I was hoping for a yes"'/>
<rdf:Description rdf:about="&a;105382597"
	 b:glossaryEntry='an affirmative; "The yeas have it"'/>
<rdf:Description rdf:about="&a;105382699"
	 b:glossaryEntry="an assertion that something alleged is not true"/>
<rdf:Description rdf:about="&a;105382817">
	<b:glossaryEntry>the act of refusing a request; "it resulted in a complete denial of his privileges"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105383025"
	 b:glossaryEntry="the act of saying no to a request"/>
<rdf:Description rdf:about="&a;105383114"
	 b:glossaryEntry='a reply of denial; "he answered in the negative"'/>
<rdf:Description rdf:about="&a;105383289"
	 b:glossaryEntry='a negative; "his no was loud and clear"'/>
<rdf:Description rdf:about="&a;105383395"
	 b:glossaryEntry='a negative; "the nays have it"'/>
<rdf:Description rdf:about="&a;105383493">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a grammatically substandard but emphatic negative; "I don''t never go"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105383624">
	<b:glossaryEntry>an affirmative constructed from two negatives; "A not unwelcome outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105383758"
	 b:glossaryEntry="the act of refusing"/>
<rdf:Description rdf:about="&a;105383849"
	 b:glossaryEntry="denial of any connection with or knowledge of"/>
<rdf:Description rdf:about="&a;105383968"
	 b:glossaryEntry="a disavowal of a previous assertion"/>
<rdf:Description rdf:about="&a;105384105"
	 b:glossaryEntry="a retraction of a previously held position"/>
<rdf:Description rdf:about="&a;105384228"
	 b:glossaryEntry="the act of negating"/>
<rdf:Description rdf:about="&a;105384349">
	<b:glossaryEntry>the speech act of contradicting someone; "he spoke as if he thought his claims were immune to contradiction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105384517">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(in logic) a statement that is necessarily false; "the statement `he is brave and he is not brave'' is a contradiction"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105384738"
	 b:glossaryEntry="the act of revoking or annulling or making void"/>
<rdf:Description rdf:about="&a;105384844"
	 b:glossaryEntry="the speech act of rejecting"/>
<rdf:Description rdf:about="&a;105384981"
	 b:glossaryEntry="rejecting as invalid"/>
<rdf:Description rdf:about="&a;105385110">
	<b:glossaryEntry>(law) a voluntary repudiation of a person''s legal claim to something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105385235"
	 b:glossaryEntry="refusal to acknowledge as one''s own"/>
<rdf:Description rdf:about="&a;105385339"
	 b:glossaryEntry="an instance of driving away or warding off"/>
<rdf:Description rdf:about="&a;105385451">
	<b:glossaryEntry>a brief and unsympathetic rejection; "they made short shrift of my request"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105385605"
	 b:glossaryEntry="the speech act of objecting"/>
<rdf:Description rdf:about="&a;105385832">
	<b:glossaryEntry>a formal objection to the selection of a particular person as a juror</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105385957"
	 b:glossaryEntry="an expression of grievance or resentment"/>
<rdf:Description rdf:about="&a;105386125">
	<b:glossaryEntry>(formerly) a loud cry (or repeated cries) of pain or rage or sorrow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105386266"
	 b:glossaryEntry="(law) a formal objection to an opponent''s pleadings"/>
<rdf:Description rdf:about="&a;105386391">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(law) the difference of one judge''s opinion from that of the majority; "he expressed his dissent in a contrary opinion"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105386564">
	<b:glossaryEntry>grounds for adverse criticism; "his authority is beyond exception"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105386686">
	<b:glossaryEntry>informal terms for objecting; "I have a gripe about the service here"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105386838">
	<b:glossaryEntry>a formal and solemn declaration of objection; "they finished the game under protest to the league prsident"; "the senator rose to register his protest"; "the many protestations did not stay the execution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105387111">
	<b:glossaryEntry>the act of making a strong public expression of disagreement and disapproval; "he shouted his protests at the umpire"; "a shower of protest was heard from the rear of the hall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105387341">
	<b:glossaryEntry>a complaint about a (real or imaginary) wrong that causes resentment and is grounds for action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105387491">
	<b:glossaryEntry>a gruff or angry utterance (suggestive of the growling of an animal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105387614"
	 b:glossaryEntry="a complaint uttered in a plaintive whining way"/>
<rdf:Description rdf:about="&a;105387722"
	 b:glossaryEntry="a complaint uttered in a low and indistinct tone"/>
<rdf:Description rdf:about="&a;105387878">
	<b:glossaryEntry>a cry of sorrow and grief; "their pitiful laments could be heard throughout the ward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105388046">
	<b:glossaryEntry>a long and mournful complaint; "a jeremiad against any form of government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105388175"
	 b:glossaryEntry="a speech act that conveys information"/>
<rdf:Description rdf:about="&a;105388391"
	 b:glossaryEntry="informing by words"/>
<rdf:Description rdf:about="&a;105388537">
	<b:glossaryEntry>advance notification of the intention to withdraw from an arrangement or contract; "we received a notice to vacate the premises"; "he gave notice two months before he moved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105388763"
	 b:glossaryEntry="notification that you have been fired from your job"/>
<rdf:Description rdf:about="&a;105388870"
	 b:glossaryEntry="making something evident"/>
<rdf:Description rdf:about="&a;105389120">
	<b:glossaryEntry>behavior that makes your feelings public; "a display of emotion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105389274"
	 b:glossaryEntry="a deliberate display of emotion for effect"/>
<rdf:Description rdf:about="&a;105389374"
	 b:glossaryEntry="a display of extreme remorse or repentance or grief"/>
<rdf:Description rdf:about="&a;105389491"
	 b:glossaryEntry="the act of divulging something"/>
<rdf:Description rdf:about="&a;105389592"
	 b:glossaryEntry="something that is discovered"/>
<rdf:Description rdf:about="&a;105389676"
	 b:glossaryEntry="an unintentional disclosure"/>
<rdf:Description rdf:about="&a;105389758">
	<b:glossaryEntry>to furnish incriminating evidence to an officer of the law (usually in return for favors)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105389913">
	<b:glossaryEntry>unauthorized (esp. deliberate) disclosure of confidential information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105390033">
	<b:glossaryEntry>the disclosure of something secret; "they feared exposure of their campaign plans"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105390188">
	<b:glossaryEntry>the exposure of an impostor or a fraud; "he published an expose of the graft and corruption in city government"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105390364"
	 b:glossaryEntry="an acknowledgment of the truth of something"/>
<rdf:Description rdf:about="&a;105390481"
	 b:glossaryEntry="an admission of misdeeds or faults"/>
<rdf:Description rdf:about="&a;105390590">
	<b:glossaryEntry>an admission that you have failed to do or be something you know you should do or be</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105390774">
	<b:glossaryEntry>a point conceded or yielded; "they won all the concessions they asked for"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105390941"
	 b:glossaryEntry="an agreement to raise wages"/>
<rdf:Description rdf:about="&a;105391030">
	<b:glossaryEntry>a concession given to mollify or placate: "the offer was a sop to my feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105391158"
	 b:glossaryEntry="formally making a person known to another or to the public"/>
<rdf:Description rdf:about="&a;105391298"
	 b:glossaryEntry="giving detailed instructions, as for a military operation"/>
<rdf:Description rdf:about="&a;105391410">
	<b:glossaryEntry>the act of informing by verbal report; "he heard reports that they were causing trouble"; "by all accounts they were a happy couple"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105391713">
	<b:glossaryEntry>a written document describing the findings of some individual or group; "this accords with the recent study by Hill and Dale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105391971">
	<b:glossaryEntry xml:space='preserve'><![CDATA[information in some unspecified form; "it was stuff I had heard before"; "there''s good stuff in that book"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105392129"
	 b:glossaryEntry="a government report; bound in white"/>
<rdf:Description rdf:about="&a;105392235"
	 b:glossaryEntry="a report published by the British government; bound in blue"/>
<rdf:Description rdf:about="&a;105392350"
	 b:glossaryEntry="a report of work accomplished during a specified time period"/>
<rdf:Description rdf:about="&a;105392472">
	<b:glossaryEntry>a report of the results of a medical examination of a patient</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105392594">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a written evaluation of a student''s scholarship and deportment; "his father signed his report card"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105392760"
	 b:glossaryEntry="report of a mission or task"/>
<rdf:Description rdf:about="&a;105392862"
	 b:glossaryEntry="short account of an incident (especially a biographical one)"/>
<rdf:Description rdf:about="&a;105392977">
	<b:glossaryEntry>an account describing incidents or events; "after dinner he told the children stories of his adventures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105393346"
	 b:glossaryEntry="an improbable (unusual or incredible or fanciful) story"/>
<rdf:Description rdf:about="&a;105393457"
	 b:glossaryEntry="a tale circulated by word of mouth among the common folk"/>
<rdf:Description rdf:about="&a;105393587">
	<b:glossaryEntry>a sentimental story or personal distress; designed to arouse sympathy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105393724"
	 b:glossaryEntry="a story about fairies; told to amuse children"/>
<rdf:Description rdf:about="&a;105393839"
	 b:glossaryEntry="a tale in rhymed verse for children"/>
<rdf:Description rdf:about="&a;105393934">
	<b:glossaryEntry>an act of narration; "he was the hero according to his own relation"; "his endless recounting of the incident eventually became unbearable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105394151"
	 b:glossaryEntry="an outpouring of gossip"/>
<rdf:Description rdf:about="&a;105394227">
	<b:glossaryEntry>a report (often malicious) about the doings of other people; "the divorce caused much gossip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105394487">
	<b:glossaryEntry>gossip (usually a mixture of truth and untruth) passed around by word of mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105394636">
	<b:glossaryEntry>gossip spread by spoken communication; "the news of their affair was spread by word of mouth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105394812"
	 b:glossaryEntry="disgraceful gossip about the private lives of other people"/>
<rdf:Description rdf:about="&a;105394950"
	 b:glossaryEntry='idle gossip or rumor; "there has been talk about you lately"'/>
<rdf:Description rdf:about="&a;105395080"
	 b:glossaryEntry="a message informing of danger"/>
<rdf:Description rdf:about="&a;105395289"
	 b:glossaryEntry="needless warnings"/>
<rdf:Description rdf:about="&a;105395361"
	 b:glossaryEntry="a warning serves to make you more alert to danger"/>
<rdf:Description rdf:about="&a;105395473">
	<b:glossaryEntry>a warning against certain acts: "a caveat against unfair practices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105395603"
	 b:glossaryEntry="an early warning about a future event"/>
<rdf:Description rdf:about="&a;105395712"
	 b:glossaryEntry="(military) a warning prior to the start of a threatening act"/>
<rdf:Description rdf:about="&a;105395854"
	 b:glossaryEntry="(military) a warning after the initiation of a hostile act"/>
<rdf:Description rdf:about="&a;105395993">
	<b:glossaryEntry>a warning that something unpleasant is immanent; "they were under threat of arrest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105396129">
	<b:glossaryEntry>(military) a warning to national policy makers that an enemy intends to launch an attack in the near future</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105396300">
	<b:glossaryEntry>(military) a warning to national policy makers that an enemy intends war or is preparing for war and is on a course that increases the risk of war</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105396507">
	<b:glossaryEntry>a verbal commitment by one person to another agreeing to do (or not to do) something in the future</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105396749"
	 b:glossaryEntry='a promise; "he gave his word"'/>
<rdf:Description rdf:about="&a;105396854">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a statement intended to inspire confidence; "the President''s assurances were not respected"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105397001">
	<b:glossaryEntry>a binding commitment to do or give or refrain from something: "an assurance of help when needed"; "signed a pledge never to reveal the secret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105397262"
	 b:glossaryEntry="a solemn pledge of fidelity"/>
<rdf:Description rdf:about="&a;105397350"
	 b:glossaryEntry="a mutual promise to marry"/>
<rdf:Description rdf:about="&a;105397470">
	<b:glossaryEntry>a mutual promise of a couple not to date anyone else; on college campuses it is signaled by the giving of a fraternity pin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105397646"
	 b:glossaryEntry="the giving of a ring as a token of engagement"/>
<rdf:Description rdf:about="&a;105397745">
	<b:glossaryEntry>a promise that an unaccepted offer will be renewed in the future</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105397866"
	 b:glossaryEntry="an acknowledgment of appreciation"/>
<rdf:Description rdf:about="&a;105398035">
	<b:glossaryEntry>an expression of gratitude; "he expressed his appreciation in a short note"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105398169"
	 b:glossaryEntry="a conversational expression of gratitude"/>
<rdf:Description rdf:about="&a;105398265">
	<b:glossaryEntry>an appearance by actors or performers at the end of the concert or play in order to acknowledge the applause of the audience</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105398454"
	 b:glossaryEntry="speaking of yourself in superlatives"/>
<rdf:Description rdf:about="&a;105398653">
	<b:glossaryEntry>an instance of boastful talk; "his brag is worse than his fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105398823"
	 b:glossaryEntry="vain and empty boasting"/>
<rdf:Description rdf:about="&a;105398928"
	 b:glossaryEntry="extravagant self-praise"/>
<rdf:Description rdf:about="&a;105399003">
	<b:glossaryEntry>the act of putting forth your own opinions in a boastful or inconsiderate manner that implies you feel superior to others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105399185">
	<b:glossaryEntry>the verbal act of naming; "the part he failed was the naming of state capitals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105399371"
	 b:glossaryEntry="the act of designating"/>
<rdf:Description rdf:about="&a;105399469"
	 b:glossaryEntry="naming numbers"/>
<rdf:Description rdf:about="&a;105399540"
	 b:glossaryEntry="the act of indicating"/>
<rdf:Description rdf:about="&a;105399631"
	 b:glossaryEntry="naming explicitly"/>
<rdf:Description rdf:about="&a;105399705"
	 b:glossaryEntry="a call to engage in a contest or fight"/>
<rdf:Description rdf:about="&a;105399907">
	<b:glossaryEntry>a challenge to do something dangerous or foolhardy; "he could never refuse a dare"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105400049"
	 b:glossaryEntry="a bold challenge"/>
<rdf:Description rdf:about="&a;105400125"
	 b:glossaryEntry="a challenge to a fight or duel"/>
<rdf:Description rdf:about="&a;105400210"
	 b:glossaryEntry="a hostile challenge"/>
<rdf:Description rdf:about="&a;105400284"
	 b:glossaryEntry="a challenge to defend what someone has said"/>
<rdf:Description rdf:about="&a;105400420"
	 b:glossaryEntry="as by a sentry"/>
<rdf:Description rdf:about="&a;105400506"
	 b:glossaryEntry="a public act of denouncing"/>
<rdf:Description rdf:about="&a;105400696"
	 b:glossaryEntry="severe censure"/>
<rdf:Description rdf:about="&a;105400768"
	 b:glossaryEntry="thunderous verbal attack"/>
<rdf:Description rdf:about="&a;105400861"
	 b:glossaryEntry="a violent denunciation"/>
<rdf:Description rdf:about="&a;105400960"
	 b:glossaryEntry="the act of damning"/>
<rdf:Description rdf:about="&a;105401034">
	<b:glossaryEntry>an appeal to some supernatural power to inflict evil on someone or some group</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105401227"
	 b:glossaryEntry="a formal ecclesiastical curse accompanied by excommunication"/>
<rdf:Description rdf:about="&a;105401342">
	<b:glossaryEntry>a curse that invokes evil (and usually serves as an insult); "he suffered the imprecations of the mob"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105401516">
	<b:glossaryEntry>a formal charge of wrongdoing brought against a person; an imputation of blame or guilt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105401832"
	 b:glossaryEntry="mutual accusations"/>
<rdf:Description rdf:about="&a;105401910">
	<b:glossaryEntry>a detailed statement giving facts and figures; "his wife gave a recital of his infidelities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105402056">
	<b:glossaryEntry>a public instance of reciting or repeating something prepared; "the program included songs and recitations of well-loved poems"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105402260">
	<b:glossaryEntry>a formal document written for a prosecuting attorney charging a person with some offense</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105402481"
	 b:glossaryEntry="an indictment charging someone with murder"/>
<rdf:Description rdf:about="&a;105402583"
	 b:glossaryEntry="an indictment endorsed by a grand jury"/>
<rdf:Description rdf:about="&a;105402677">
	<b:glossaryEntry>a formal document charging a public official with misconduct in office</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105402805">
	<b:glossaryEntry>a legal document calling someone to court to answer an indictment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105402928"
	 b:glossaryEntry="a formal accusation against somebody"/>
<rdf:Description rdf:about="&a;105403087">
	<b:glossaryEntry>an allegation that something imposes an illegal obligation or denies some legal right or causes injustice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105403248"
	 b:glossaryEntry="bringing a charge or accusation against someone"/>
<rdf:Description rdf:about="&a;105403362">
	<b:glossaryEntry>a written statement of the grounds of complaint made to court law asking for the grievance to be redressed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105403521">
	<b:glossaryEntry>a statement attributing something dishonest (especially a criminal offense); "he denied the imputation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105403681">
	<b:glossaryEntry>an accusation of wrongdoing; "the book is an indictment of modern philosophy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105403815"
	 b:glossaryEntry="formal accusation of a crime"/>
<rdf:Description rdf:about="&a;105403901"
	 b:glossaryEntry='the act of making accusations; "preferment of charges"'/>
<rdf:Description rdf:about="&a;105404012">
	<b:glossaryEntry>an accusation that you are responsible for some lapse or misdeed; "his incrimination was based on my testimony"; "the police laid the blame on on the driver"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105404269"
	 b:glossaryEntry="a charge that implicates someone (usually of wrongdoing)"/>
<rdf:Description rdf:about="&a;105404433">
	<b:glossaryEntry>an accusation that is understood without needing to be spoken</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105404580"
	 b:glossaryEntry="an indirect (and usually malicious) implication"/>
<rdf:Description rdf:about="&a;105404696"
	 b:glossaryEntry="an accusation that incriminates yourself"/>
<rdf:Description rdf:about="&a;105404801">
	<b:glossaryEntry>a formal spoken communication delivered to an audience; "he listened to an address on minor Roman poets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105405205"
	 b:glossaryEntry="an address to an academic meeting or seminar"/>
<rdf:Description rdf:about="&a;105405306">
	<b:glossaryEntry>an extemporaneous speech or remark; "a witty impromptu must not sound premeditated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105405445">
	<b:glossaryEntry>a short musical passage that seems to have been made spontaneously without advance preparation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105405595">
	<b:glossaryEntry>an address delivered at an inaugural ceremony (especially by a US president)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105405766"
	 b:glossaryEntry="the principal theme in a speech or literary work"/>
<rdf:Description rdf:about="&a;105405887"
	 b:glossaryEntry="a speech setting forth the keynote"/>
<rdf:Description rdf:about="&a;105406019">
	<b:glossaryEntry>a speech that is open to the public; "he attended a lecture on telecommunications"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105406179">
	<b:glossaryEntry>any long and tedious address or recital; "the patient recited a litany of complaints"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105406317">
	<b:glossaryEntry>addressing an audience formally (usually a long and rhetorical address and often pompous); "he loved the sound of his own oratory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105406573">
	<b:glossaryEntry>an instance of oratory; "he delivered an oration on the decline of family values"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105406727">
	<b:glossaryEntry>delivering an address to a public audience; "the people came to see the candidates and hear the speaking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105406961">
	<b:glossaryEntry>the formal presentation of and opposition to a stated proposition (usually followed by a vote)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105407138"
	 b:glossaryEntry="vehement oratory"/>
<rdf:Description rdf:about="&a;105407248"
	 b:glossaryEntry="bombastic declamation"/>
<rdf:Description rdf:about="&a;105407359"
	 b:glossaryEntry="a long monotonous harangue"/>
<rdf:Description rdf:about="&a;105407438"
	 b:glossaryEntry="declaiming wildly"/>
<rdf:Description rdf:about="&a;105407515"
	 b:glossaryEntry="political oratory"/>
<rdf:Description rdf:about="&a;105407591">
	<b:glossaryEntry>a farewell oration delivered by the most outstanding member of a graduating class</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105407766">
	<b:glossaryEntry>an address of a religious nature (usually delivered during a church service)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105407991">
	<b:glossaryEntry>a farewell sermon to a graduating class at their commencement ceremonies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105408142">
	<b:glossaryEntry>preaching the gospel of Christ in the manner of the early church</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105408270">
	<b:glossaryEntry>the first major discourse delivered by Jesus; Matthew 5-7 and Luke 6:20-49</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105408448"
	 b:glossaryEntry="a sermon on a moral or religious topic"/>
<rdf:Description rdf:about="&a;105408552"
	 b:glossaryEntry="the act of persuading (or attempting to persuade)"/>
<rdf:Description rdf:about="&a;105408794">
	<b:glossaryEntry>a means of persuading or arguing; "he used all his conversational weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105408933"
	 b:glossaryEntry="a successful persuasion"/>
<rdf:Description rdf:about="&a;105409013"
	 b:glossaryEntry="the act of exhorting; an earnest attempt at persuasion"/>
<rdf:Description rdf:about="&a;105409138">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of suggesting; "it was a suggestion we couldn''t refuse"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105409270">
	<b:glossaryEntry>persuasion not to do something; the act of talking someone out of an intended course of action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105409439"
	 b:glossaryEntry="an expression of opposition to a course of action"/>
<rdf:Description rdf:about="&a;105409575"
	 b:glossaryEntry="persuasion of voters in a political campaign"/>
<rdf:Description rdf:about="&a;105409708"
	 b:glossaryEntry="persuasion by means of empty slogans"/>
<rdf:Description rdf:about="&a;105409803">
	<b:glossaryEntry>a message issued in behalf of some product or cause or institution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105410086">
	<b:glossaryEntry>subject matter that is calculated to excite and please vulgar tastes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105410251"
	 b:glossaryEntry="a sensational message (in a film or play or novel)"/>
<rdf:Description rdf:about="&a;105410355">
	<b:glossaryEntry>a promotion intended to create goodwill for a person or institution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105410485">
	<b:glossaryEntry>a promotional statement (as found on the dust jackets of books)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105410614">
	<b:glossaryEntry>a paper jacket for a book; a jacket on which promotional information is printed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105410821"
	 b:glossaryEntry="blatant or sensational promotion"/>
<rdf:Description rdf:about="&a;105410931"
	 b:glossaryEntry="promotion by means of an argument and demonstration"/>
<rdf:Description rdf:about="&a;105411061"
	 b:glossaryEntry="a public promotion of some product or service"/>
<rdf:Description rdf:about="&a;105411302"
	 b:glossaryEntry="a printed advertisement that is published in a newspaper"/>
<rdf:Description rdf:about="&a;105411461"
	 b:glossaryEntry="promotion that supplements or coordinates advertising"/>
<rdf:Description rdf:about="&a;105411576"
	 b:glossaryEntry="a newspaper advertisement stating what is wanted"/>
<rdf:Description rdf:about="&a;105411678"
	 b:glossaryEntry="a commercially sponsored ad on radio or television"/>
<rdf:Description rdf:about="&a;105411824">
	<b:glossaryEntry>a television commercial presented in the form of a short documentary</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105411950">
	<b:glossaryEntry>an advertisement (usually printed on a page or in a leaflet) intended for wide distribution; "he mailed the circular to all subscribers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105412212">
	<b:glossaryEntry>the part of a phonebook that lists business products and services along with classified advertising</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105412404"
	 b:glossaryEntry="the verbal act of urging on"/>
<rdf:Description rdf:about="&a;105412500">
	<b:glossaryEntry xml:space='preserve'><![CDATA[encouragement in the form of cheers from spectators; "it''s all over but the shouting"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105412651">
	<b:glossaryEntry>encouragement of the progress or growth or acceptance of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105412801"
	 b:glossaryEntry="encouragement; aiding the development of something"/>
<rdf:Description rdf:about="&a;105412919"
	 b:glossaryEntry="a verbalization that encourages you to attempt something"/>
<rdf:Description rdf:about="&a;105413081">
	<b:glossaryEntry>needed encouragement; "the result was a provocation of vigorous investigation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105413248">
	<b:glossaryEntry>underhandedly or improperly inducing someone to do something improper or unlawful; "subornation of perjury is a crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105413424">
	<b:glossaryEntry>an expression of approval and encouragement; "they gave the chairman a vote of confidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105413579"
	 b:glossaryEntry="the expression of opposition and disapproval"/>
<rdf:Description rdf:about="&a;105413756"
	 b:glossaryEntry="a communication that leaves you disheartened or daunted"/>
<rdf:Description rdf:about="&a;105413872"
	 b:glossaryEntry="a communication that dissuades you"/>
<rdf:Description rdf:about="&a;105413963"
	 b:glossaryEntry="a communication that makes you afraid to try something"/>
<rdf:Description rdf:about="&a;105414101"
	 b:glossaryEntry="the act of resigning"/>
<rdf:Description rdf:about="&a;105414215"
	 b:glossaryEntry="a formal resignation and renunciation of powers"/>
<rdf:Description rdf:about="&a;105414335"
	 b:glossaryEntry="a verbal act of renouncing"/>
<rdf:Description rdf:about="&a;105414453"
	 b:glossaryEntry="a verbal act of relinquishing"/>
<rdf:Description rdf:about="&a;105414577"
	 b:glossaryEntry="a verbal act of admitting defeat"/>
<rdf:Description rdf:about="&a;105414688"
	 b:glossaryEntry="refusal to approve or assent to"/>
<rdf:Description rdf:about="&a;105414813"
	 b:glossaryEntry="authoritative prohibition"/>
<rdf:Description rdf:about="&a;105414897"
	 b:glossaryEntry="an official prohibition"/>
<rdf:Description rdf:about="&a;105415007"
	 b:glossaryEntry="communication by paranormal means"/>
<rdf:Description rdf:about="&a;105415214">
	<b:glossaryEntry>apparent communication from one mind to another without using sensory perceptions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105415374">
	<b:glossaryEntry>apparent knowledge of distant events without using sensory perceptions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105415501">
	<b:glossaryEntry>phenomena that appear to contradict physical laws and suggest the possibility of causation by mental processes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105415785">
	<b:glossaryEntry>apparent power to perceive things that are not present to the senses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105415983"
	 b:glossaryEntry="knowledge of an event before it occurs"/>
<rdf:Description rdf:about="&a;105416096">
	<b:glossaryEntry>a the power to move something by thinking about it without the application of physical force</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105416262"
	 b:glossaryEntry="alleged form of communication with spirits of the dead"/>
<rdf:Description rdf:about="&a;105416428">
	<b:glossaryEntry>manipulation of a table during a seance; attributed to spirits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105416617">
	<b:glossaryEntry>a truncated cloth cone mounted on a mast; used (e.g., at airports) to show the direction of the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105416802">
	<b:glossaryEntry>a pole or stake set up to mark something (as the start of a race track)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105416968">
	<b:glossaryEntry>a post marking the starting point of a race (especially a horse race)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105417097"
	 b:glossaryEntry="the post at the end of a racecourse"/>
<rdf:Description rdf:about="&a;105417191">
	<b:glossaryEntry>an indicator that orients you generally; "it is used as a reference for comparing the heating and the electrical energy involved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105417541">
	<b:glossaryEntry>a publication (or a passage from a publication) that is referred to; "he carried an armful of references back to his desk"; "he spent hours looking for the source of that quotation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105417787">
	<b:glossaryEntry>a surveyor''s mark on a permanent object of predetermined position and elevation used as a reference point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105417961"
	 b:glossaryEntry="a mark showing the boundary of a piece of land"/>
<rdf:Description rdf:about="&a;105418080">
	<b:glossaryEntry>an old term for a landmark that consisted of a pile of stones surmounted by an upright slab</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105418252"
	 b:glossaryEntry="a fixed line on a ship''s compass indicating its heading"/>
<rdf:Description rdf:about="&a;105418414"
	 b:glossaryEntry="a rule describing (or prescribing) a linguistic practice"/>
<rdf:Description rdf:about="&a;105418557"
	 b:glossaryEntry="a linguistic rule for the syntax of grammatical utterances"/>
<rdf:Description rdf:about="&a;105418696">
	<b:glossaryEntry>a basis for comparison; a reference point against which other things can be evaluated; "they set the measure for all subsequent work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105419027">
	<b:glossaryEntry>a standard by which something can be measured or judged; "his painting sets the benchmark of quality"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105419184">
	<b:glossaryEntry>a measure or standard used for comparison: "on what kind of yardstick is he basing his judgment?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105419337"
	 b:glossaryEntry='a reference point to shoot at; "his arrow hit the mark"'/>
<rdf:Description rdf:about="&a;105419507"
	 b:glossaryEntry="a target used in archery"/>
<rdf:Description rdf:about="&a;105419583"
	 b:glossaryEntry="a funnel-shaped device towed as a target by an airplane"/>
<rdf:Description rdf:about="&a;105419691"
	 b:glossaryEntry="a white stripe in the middle of a road to mark traffic lanes"/>
<rdf:Description rdf:about="&a;105419808"
	 b:glossaryEntry="a signal for attracting attention"/>
<rdf:Description rdf:about="&a;105419915">
	<b:glossaryEntry>a blinking light on a motor vehicle that indicates the direction in which the vehicle is about to turn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105420135"
	 b:glossaryEntry="worn around arm as identification or to indicate mourning"/>
<rdf:Description rdf:about="&a;105420246">
	<b:glossaryEntry>propels bright light high in the sky, or used to propel a lifesaving line or harpoon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105420395"
	 b:glossaryEntry="a signal generated by electronic means"/>
<rdf:Description rdf:about="&a;105420551">
	<b:glossaryEntry>a radar echo displayed so as to show the position of a reflecting surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105420690">
	<b:glossaryEntry>an electronic signal that has been reflected back to the radar antenna; contains information about the location and distance of the reflecting object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105420896">
	<b:glossaryEntry>a device that, on receiving radar signals, transmits coded signals in response to help navigators determine their position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105421085">
	<b:glossaryEntry>a characteristic signal emitted by a transmitter used for navigation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105421212">
	<b:glossaryEntry>a fire (usually on a hill or tower) that can be seen from a distance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105421365"
	 b:glossaryEntry="an artillery shell containing an illuminant"/>
<rdf:Description rdf:about="&a;105421465">
	<b:glossaryEntry>a steady bright blue light; formerly used as a signal but now a firework</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105421596"
	 b:glossaryEntry="a colored flare fired from a Very pistol"/>
<rdf:Description rdf:about="&a;105421693"
	 b:glossaryEntry="a fire set as a signal"/>
<rdf:Description rdf:about="&a;105421788"
	 b:glossaryEntry="signal going into an electronic system"/>
<rdf:Description rdf:about="&a;105421893"
	 b:glossaryEntry="signal that comes out of an electronic system"/>
<rdf:Description rdf:about="&a;105422025"
	 b:glossaryEntry="the output of a computer in printed form"/>
<rdf:Description rdf:about="&a;105422120">
	<b:glossaryEntry>a loud warning signal produced by a burglar alarm; "they could hear the burglar alarm a mile away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105422278"
	 b:glossaryEntry="a shout or bell to warn that fire has broken out"/>
<rdf:Description rdf:about="&a;105422383">
	<b:glossaryEntry>a loud low warning signal that can be heard by fog-bound ships</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105422511"
	 b:glossaryEntry="a noise made by the driver of an automobile to give warning;"/>
<rdf:Description rdf:about="&a;105422623">
	<b:glossaryEntry>a red light on the rear of a motor vehicle that signals when the brakes are applied to slow or stop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105422811">
	<b:glossaryEntry>bright-colored; a float attached by rope to the seabed to mark channels in a harbor or underwater hazards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105423039"
	 b:glossaryEntry="a buoy that can be heard (at night)"/>
<rdf:Description rdf:about="&a;105423170"
	 b:glossaryEntry="a buoy with a bell on it"/>
<rdf:Description rdf:about="&a;105423262"
	 b:glossaryEntry="a buoy that makes a whistling noise"/>
<rdf:Description rdf:about="&a;105423373"
	 b:glossaryEntry="a buoy with a round bottom and conical top"/>
<rdf:Description rdf:about="&a;105423476"
	 b:glossaryEntry="a buoy resembling a cone"/>
<rdf:Description rdf:about="&a;105423576"
	 b:glossaryEntry="a buoy resembling a vertical log"/>
<rdf:Description rdf:about="&a;105423664"
	 b:glossaryEntry="striped pole outside a barbershop"/>
<rdf:Description rdf:about="&a;105423757"
	 b:glossaryEntry="a rod carried as a symbol"/>
<rdf:Description rdf:about="&a;105423906">
	<b:glossaryEntry>a staff surmounted by a crook or cross carried by bishops as a symbol of pastoral office</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105424058">
	<b:glossaryEntry>a ceremonial staff carried as a symbol of office or authority</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105424170"
	 b:glossaryEntry="a ceremonial or emblematic staff"/>
<rdf:Description rdf:about="&a;105424299"
	 b:glossaryEntry="a mock scepter carried by a court jester"/>
<rdf:Description rdf:about="&a;105424392">
	<b:glossaryEntry>staff with a metal tip carried as a sign of office by e.g. a bailiff or constable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105424528"
	 b:glossaryEntry="cord or ribbon worn as an insignia of honor or rank"/>
<rdf:Description rdf:about="&a;105424632">
	<b:glossaryEntry>stylized bird wings worn as an insignia by qualified pilots or air crew members</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105424763">
	<b:glossaryEntry>an arrangement of ribbons in a rose-shaped design worn as a badge of office or medal of honor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105424910">
	<b:glossaryEntry>a black sash worn to show expert standards in the martial arts (judo or karate)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105425046"
	 b:glossaryEntry="an honor or award gained for excellence"/>
<rdf:Description rdf:about="&a;105425157">
	<b:glossaryEntry>an annual award for outstanding contributions to chemistry or physics or physiology and medicine or literature or economics or peace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105425347">
	<b:glossaryEntry>an annual award by the Academy of Motion Picture Arts and Sciences for achievements in motion picture production and performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105425527"
	 b:glossaryEntry="V-shaped sleeve badge indicating military rank and service"/>
<rdf:Description rdf:about="&a;105425675">
	<b:glossaryEntry>a piece of braid, usually on the sleeve, indicating military rank or length of service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105425814">
	<b:glossaryEntry>(computer science) a graphic symbol (usually a simple picture) that denotes a program or a command or a data file or a concept in a graphical user interface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105426040">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a distinguishing symbol; "the owner''s mark was on all the sheep"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105426390">
	<b:glossaryEntry>a cancellation mark stamped on mail by postal officials; indicates the post office and date of mailing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105426547">
	<b:glossaryEntry>a distinguishing mark impressed on paper during manufacture; visible when paper is held up to the light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105426706"
	 b:glossaryEntry="an arrowhead mark identifying British government property"/>
<rdf:Description rdf:about="&a;105426821"
	 b:glossaryEntry="stone post at side of a road to show distances"/>
<rdf:Description rdf:about="&a;105426934">
	<b:glossaryEntry>a symbol (like x or y) that is used in mathematical or logical expressions to represent a variable quantity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105427114"
	 b:glossaryEntry="a variable whose values are solutions of an equation"/>
<rdf:Description rdf:about="&a;105427239">
	<b:glossaryEntry>small markers inserted into a surface to mark scores or define locations etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105427372"
	 b:glossaryEntry="a mark on a playing card (shape depending on the suit)"/>
<rdf:Description rdf:about="&a;105427502"
	 b:glossaryEntry="a company emblem or device"/>
<rdf:Description rdf:about="&a;105427590"
	 b:glossaryEntry="an identifying or descriptive marker"/>
<rdf:Description rdf:about="&a;105427739">
	<b:glossaryEntry>a label identifying the owner of a book in which it is pasted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105427868"
	 b:glossaryEntry="metal plate on a dog collar bearing its registration number"/>
<rdf:Description rdf:about="&a;105427981"
	 b:glossaryEntry="military identification tag worn on a chain around the neck"/>
<rdf:Description rdf:about="&a;105428094"
	 b:glossaryEntry="a tag showing the name of the person who wears it"/>
<rdf:Description rdf:about="&a;105428198"
	 b:glossaryEntry="a tag showing the price of the article it is attached to"/>
<rdf:Description rdf:about="&a;105428310"
	 b:glossaryEntry="made of cardboard, plastic, or metal"/>
<rdf:Description rdf:about="&a;105428468">
	<b:glossaryEntry>a mound of stones piled up as a memorial or to mark a boundary or path</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105428590"
	 b:glossaryEntry="a gesture involving the shoulders"/>
<rdf:Description rdf:about="&a;105428675"
	 b:glossaryEntry="the act of signaling by a movement of the hand"/>
<rdf:Description rdf:about="&a;105428809">
	<b:glossaryEntry>a sign (for victory); making a V with the index and middle fingers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105428928"
	 b:glossaryEntry="a sign of assent or salutation or command"/>
<rdf:Description rdf:about="&a;105429019">
	<b:glossaryEntry>bending the head or body or knee as a sign of reverence or submission or shame</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105429258">
	<b:glossaryEntry>a gesture with the right hand moving to form a cross; used by Catholics as a profession of faith</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105429418"
	 b:glossaryEntry="bending at the knees; a gesture of respect made by women"/>
<rdf:Description rdf:about="&a;105429537"
	 b:glossaryEntry="the act of bending the knees in worship or reverence"/>
<rdf:Description rdf:about="&a;105429662">
	<b:glossaryEntry>a former Chinese custom of touching the ground with the forehead as a sign of respect or submission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105429822">
	<b:glossaryEntry>a deep bow with the foot drawn backwards (indicating excessive humility); "all that bowing and scraping did not impress him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105430010"
	 b:glossaryEntry="a deep bow; a Muslim form of salutation"/>
<rdf:Description rdf:about="&a;105430102">
	<b:glossaryEntry>a special rule (as in baseball) dealing with situations that arise due to the nature of the playing grounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105430267">
	<b:glossaryEntry>a computer user''s instruction (not part of a program) that calls for action by the computer''s executive program</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105430439"
	 b:glossaryEntry="a notice of dismissal or discharge"/>
<rdf:Description rdf:about="&a;105430534">
	<b:glossaryEntry>a piece of writing that has been copied from someone else and is presented as being your own work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105430688">
	<b:glossaryEntry>something suggestive of speech in being a medium of expression; "the wee small voice of conscience"; "the voice of experience"; "he said his voices told him to do it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105430906"
	 b:glossaryEntry='the music of Bach; "he played Bach on the organ"'/>
<rdf:Description rdf:about="&a;105431005"
	 b:glossaryEntry='the music of Beethoven; "he enjoyed Beethoven most of all'/>
<rdf:Description rdf:about="&a;105431118"
	 b:glossaryEntry='the music of Brahms; "Brahms was included in the program"'/>
<rdf:Description rdf:about="&a;105431228"
	 b:glossaryEntry='the music of Chopin; "he practiced Chopin day and night"'/>
<rdf:Description rdf:about="&a;105431337">
	<b:glossaryEntry>the music of Gilbert and Sullivan; "he could sing all of Gilbert and Sullivan"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105431482"
	 b:glossaryEntry="the music of Handel"/>
<rdf:Description rdf:about="&a;105431554"
	 b:glossaryEntry="the music of Haydn"/>
<rdf:Description rdf:about="&a;105431624"
	 b:glossaryEntry='the music of Mozart; "the concert was mostly Mozart"'/>
<rdf:Description rdf:about="&a;105431729">
	<b:glossaryEntry>the music of Stravinsky; "Stravinsky no longer causes riots in the streets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105431861">
	<b:glossaryEntry>the music of Wagner; "they say that Hitler listened only to Wagner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105431981">
	<b:glossaryEntry>a system of linguistic units or elements used in a particular language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105432221">
	<b:glossaryEntry>a communicative interaction; "the pilot made contact with the base"; "he got in touch with his colleagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105432389">
	<b:glossaryEntry>a transmission from Earth to a spacecraft or the path of such a transmission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105432518"
	 b:glossaryEntry="an event that could have occurred but never did"/>
<rdf:Description rdf:about="&a;105432627">
	<b:glossaryEntry>an anticipated event that turns out to be far less significant than was expected</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105432762"
	 b:glossaryEntry="an event that happens"/>
<rdf:Description rdf:about="&a;105433534">
	<b:glossaryEntry>an event or situation that happens at the same time as or in connection with another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105433744">
	<b:glossaryEntry>any event that usually accompanies or is closely connected with another; "first was the lightning and then its thunderous associate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105433932">
	<b:glossaryEntry>a sudden appearance of an overwhelming number of things; "the program brought an avalanche of mail"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105434087">
	<b:glossaryEntry>relatively unimportant or inconspicuous accompanying situation: "when the rain came he could hear the sound of thunder in the background"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105434281">
	<b:glossaryEntry>an event as apprehended; "a surprising experience"; "that painful experience certainly got our attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105434587">
	<b:glossaryEntry>an experience that appalls; "is it better to view the appalling or merely hear of it?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105434729">
	<b:glossaryEntry>an event that is experienced as indicating important things to come; "he hoped it was an augury"; "it was a sign from God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105434947"
	 b:glossaryEntry="an ominous sign that war threatens"/>
<rdf:Description rdf:about="&a;105435037">
	<b:glossaryEntry>a sign of something about to happen; "he looked for an omen before going into battle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105435260"
	 b:glossaryEntry="a favorable omen"/>
<rdf:Description rdf:about="&a;105435330"
	 b:glossaryEntry="an unfavorable omen"/>
<rdf:Description rdf:about="&a;105435406"
	 b:glossaryEntry="an omen of death or destruction"/>
<rdf:Description rdf:about="&a;105435495">
	<b:glossaryEntry>a short vivid experience; "a flash of emotion swept over him"; "the flashings of pain were a warning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105435659">
	<b:glossaryEntry>the experience of losing a loved one; "he sympathized on the loss of their grandfather"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105435797"
	 b:glossaryEntry="a severe or trying experience"/>
<rdf:Description rdf:about="&a;105435879">
	<b:glossaryEntry>a brief experience of something; "he got a taste of life on the wild side"; "she enjoyed her brief taste of independence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105436052">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a person''s experience on a particular occasion; "he had a time holding back the tears" or "they had a good time together"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105436224">
	<b:glossaryEntry>a religious or mystical experience of a supernatural appearance; "he had a vision of the Virgin Mary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105436378"
	 b:glossaryEntry="an event characteristic of persons forming groups"/>
<rdf:Description rdf:about="&a;105436522"
	 b:glossaryEntry="a marvellous event manifesting a supernatural act of God"/>
<rdf:Description rdf:about="&a;105436632">
	<b:glossaryEntry>an event causing distress or pain; "what is the trouble?"; "heart trouble"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105436886"
	 b:glossaryEntry="any amazing or wonderful occurrence"/>
<rdf:Description rdf:about="&a;105436975">
	<b:glossaryEntry>something that causes feelings of wonder; "the wonders of modern science"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105437110"
	 b:glossaryEntry='an event: "a funny thing happened on the way to the..."'/>
<rdf:Description rdf:about="&a;105437235">
	<b:glossaryEntry>a happening that is distinctive in a series of related events</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105437423">
	<b:glossaryEntry>something experienced with great delight; "a feast for the eyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105437539"
	 b:glossaryEntry="an episode that is turbulent or highly emotional"/>
<rdf:Description rdf:about="&a;105437656"
	 b:glossaryEntry="a possible event or occurrence or result"/>
<rdf:Description rdf:about="&a;105437768">
	<b:glossaryEntry>the event consisting of the start of something: "the beginning of the war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105438024"
	 b:glossaryEntry="an event used to justify starting a war"/>
<rdf:Description rdf:about="&a;105438121">
	<b:glossaryEntry>an event whose occurrence ends something; "his death marked the ending of an era"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105438448">
	<b:glossaryEntry>the concluding part of an event or occurrence: "the end was exciting"; "I had to miss the last of the movie"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105438613">
	<b:glossaryEntry>the situation that exists when something ends; "he listened for the results on the radio"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105438927"
	 b:glossaryEntry="the outcome of a complex sequence of events"/>
<rdf:Description rdf:about="&a;105439027">
	<b:glossaryEntry>the type of treatment received (especially as the result of an agreement); "he got a good deal on his car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105439220"
	 b:glossaryEntry="fair treatment"/>
<rdf:Description rdf:about="&a;105439304"
	 b:glossaryEntry="unfair treatment"/>
<rdf:Description rdf:about="&a;105439375">
	<b:glossaryEntry>the outcome of a game or contest: "the team dropped three decisions in a row"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105439507">
	<b:glossaryEntry>(boxing) a victory won on points when no knockout has occurred: "had little trouble in taking a unanimous decision over his opponent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105439713"
	 b:glossaryEntry="a boxing decision in which the judges are not unanimous"/>
<rdf:Description rdf:about="&a;105439829">
	<b:glossaryEntry>the outcome of an event especially as relative to an individual; "that result is of no consequence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105440088">
	<b:glossaryEntry>a practical consequence that follows naturally; "blind jealousy is a frequent corollary of passionate love"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105440251">
	<b:glossaryEntry>the consequence of some effort or action; "he lived long enough to see the fruit of his policies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105440400"
	 b:glossaryEntry="a secondary consequence"/>
<rdf:Description rdf:about="&a;105440478">
	<b:glossaryEntry>a series of consequences wrought by an event; "it led to a train of disasters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105440608">
	<b:glossaryEntry>an outcome in which virtue triumphs over vice (often ironically)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105440748">
	<b:glossaryEntry xml:space='preserve'><![CDATA[something that comes into existence as a result; "industrialism prepared the way for acceptance of the French Revolution''s various socialistic offspring"; "this skyscraper is the solid materialization of his efforts"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105441038"
	 b:glossaryEntry="something that follows something else"/>
<rdf:Description rdf:about="&a;105441142">
	<b:glossaryEntry>a recompense for worthy acts or retribution for wrongdoing; "the wages of sin is death"; "virtue is its own reward"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105441327"
	 b:glossaryEntry="an inevitable event"/>
<rdf:Description rdf:about="&a;105441431"
	 b:glossaryEntry='the least favorable outcome; "the worst that could happen"'/>
<rdf:Description rdf:about="&a;105441541"
	 b:glossaryEntry="an event that recurs at intervals"/>
<rdf:Description rdf:about="&a;105441797">
	<b:glossaryEntry>an event that occurs when something passes from one state or phase to another: "the change was intended to increase sales"; "this storm is certainly a change for the worse"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105442374">
	<b:glossaryEntry>(psychology) modifying the natural expression of an impulse or instinct (especially a sexual one) to one that is socially acceptable</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105442564"
	 b:glossaryEntry="a sudden unexpected event"/>
<rdf:Description rdf:about="&a;105442734">
	<b:glossaryEntry>a shocking surprise; "news of the attack came like a bombshell"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105442881"
	 b:glossaryEntry="a dramatic surprise"/>
<rdf:Description rdf:about="&a;105442962"
	 b:glossaryEntry="something surprising and revealing"/>
<rdf:Description rdf:about="&a;105443053">
	<b:glossaryEntry>an unpleasant or disappointing surprise; "it came as a shock to learn that he was injured"; "it was blow to their hopes of reconciliation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105443250">
	<b:glossaryEntry>an unexpected and amazing event: "the stunner was what happened on Saturday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105443380"
	 b:glossaryEntry="anything that happens by chance without an apparent cause"/>
<rdf:Description rdf:about="&a;105443572"
	 b:glossaryEntry="a mishap; especially one causing injury or death"/>
<rdf:Description rdf:about="&a;105443765">
	<b:glossaryEntry>an accident resulting from violent impact of a moving object; "three passengers were killed in the collision"; "the collision of the two ships resulted in a serious oil spill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105444050">
	<b:glossaryEntry>a serious accident (usually involving one or more vehicles); "they are still investigating the crash of the TWA plane"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105444228"
	 b:glossaryEntry="an accident in which a train runs off its track"/>
<rdf:Description rdf:about="&a;105444332">
	<b:glossaryEntry>a sharp uncontrollable turn made by an airplane while moving along the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105444467"
	 b:glossaryEntry="an event in which two or more bodies come together"/>
<rdf:Description rdf:about="&a;105444579">
	<b:glossaryEntry>the event of something burning (often destructive); "they lost everything in the fire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105444860"
	 b:glossaryEntry="a large outdoor fire"/>
<rdf:Description rdf:about="&a;105444945">
	<b:glossaryEntry>an uncontrolled fire that consumes brush and shrubs and bushes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105445064"
	 b:glossaryEntry="a small outdoor fire for warmth or cooking (as at a camp)"/>
<rdf:Description rdf:about="&a;105445176"
	 b:glossaryEntry="a very intense and uncontrolled fire"/>
<rdf:Description rdf:about="&a;105445300"
	 b:glossaryEntry="an uncontrolled fire in a wooded area"/>
<rdf:Description rdf:about="&a;105445449"
	 b:glossaryEntry="an uncontrolled fire in a grassy area"/>
<rdf:Description rdf:about="&a;105445542"
	 b:glossaryEntry='a smouldering fire; "the smoulder became a blaze"'/>
<rdf:Description rdf:about="&a;105445646"
	 b:glossaryEntry="a smoky fire to drive away insects"/>
<rdf:Description rdf:about="&a;105445733">
	<b:glossaryEntry>a forest fire that advances with great speed jumping from crown to crown ahead of the ground fire</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105445887">
	<b:glossaryEntry>a forest fire that burns the humus; may not appear on the surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105446010">
	<b:glossaryEntry>a forest fire that burns only the surface litter and undergrowth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105446133"
	 b:glossaryEntry="an raging and rapidly spreading conflagration"/>
<rdf:Description rdf:about="&a;105446233"
	 b:glossaryEntry="unnecessary and unforeseen trouble"/>
<rdf:Description rdf:about="&a;105446443">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an unfortunate development; "it''s a pity he couldn''t do it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105446561"
	 b:glossaryEntry="a cause of great suffering and distress"/>
<rdf:Description rdf:about="&a;105446747">
	<b:glossaryEntry>some event that causes someone to be embarrassed; "the outcome of the vote was an embarrassment for the liberals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105446938"
	 b:glossaryEntry="something that extricates you from embarrassment"/>
<rdf:Description rdf:about="&a;105447067">
	<b:glossaryEntry>a cause of difficulty and suffering; "war is hell"; "go to blazes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105447192"
	 b:glossaryEntry="any experience that causes intense suffering"/>
<rdf:Description rdf:about="&a;105447302"
	 b:glossaryEntry="a sudden and severe onset of trouble"/>
<rdf:Description rdf:about="&a;105447394"
	 b:glossaryEntry="a disgraceful event"/>
<rdf:Description rdf:about="&a;105447477">
	<b:glossaryEntry>a series of related events forming an episode; "a chapter of disasters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105447602">
	<b:glossaryEntry>an episode of such pastoral or romantic charm as to qualify as the subject of a poetic idyll</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105447746"
	 b:glossaryEntry="a single distinct event"/>
<rdf:Description rdf:about="&a;105447915"
	 b:glossaryEntry="any incident that attracts great public attention"/>
<rdf:Description rdf:about="&a;105448024"
	 b:glossaryEntry="the sudden giving off of energy"/>
<rdf:Description rdf:about="&a;105448165"
	 b:glossaryEntry="a discharge of electricity"/>
<rdf:Description rdf:about="&a;105448312">
	<b:glossaryEntry>the electrical discharge that travels along a nerve fiber; "they demonstrated the transmission of impulses from the cortex to the hypothalamus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105448543">
	<b:glossaryEntry>the local voltage change across the cell wall as a nerve impulse is transmitted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105448685"
	 b:glossaryEntry="a transient variation in voltage or current"/>
<rdf:Description rdf:about="&a;105448780">
	<b:glossaryEntry>a violent release of energy caused by a chemical or nuclear reaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105448971">
	<b:glossaryEntry>an occurrence of something; "it was a case of bad judgment"; "another instance occurred yesterday"; "but there is always the famous example of the Smiths"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105449233">
	<b:glossaryEntry>an instance or single occasion for some event; "This time he succeeded"; "He called four times"; "he could do ten at a clip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105449415">
	<b:glossaryEntry>an instance of some kind; "it was a nice piece of work"; "he had a bit of good luck"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105449557">
	<b:glossaryEntry>a natural event that involves a change in the position or location of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105450024"
	 b:glossaryEntry="the event of one object coming closer to another"/>
<rdf:Description rdf:about="&a;105450141">
	<b:glossaryEntry>the motion of one object relative to another; "stellar passings can perturb the orbits of comets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105450302">
	<b:glossaryEntry>the movement of the pointer or pen of a measuring instrument from its zero position</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105450454"
	 b:glossaryEntry="movement that causes the formation of a curve"/>
<rdf:Description rdf:about="&a;105450578">
	<b:glossaryEntry>a movement through space that changes the location of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105450913">
	<b:glossaryEntry>a collision between motor vehicles that produces minor damage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105451034">
	<b:glossaryEntry>free movement or passage especially through a circuit as of water through pipes or sap through a plant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105451194"
	 b:glossaryEntry="a slow longitudinal movement or deformation"/>
<rdf:Description rdf:about="&a;105451289">
	<b:glossaryEntry>the periodic passage from one region to another for feeding or breeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105451416">
	<b:glossaryEntry>process or result of becoming less or smaller: "the material lost 2 inches per yard in shrinkage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105451599">
	<b:glossaryEntry>the process or result of becoming smaller or pressed together: "the contraction of a gas on cooling"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105451786"
	 b:glossaryEntry="an accident that results in physical damage or hurt"/>
<rdf:Description rdf:about="&a;105451946">
	<b:glossaryEntry>a personal or social separation (as between opposing factions); "they hoped to avoid a break in relations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105452156">
	<b:glossaryEntry>an accidental happening; "he recorded all the little haps and mishaps of his life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105452288"
	 b:glossaryEntry="an instance of misfortune"/>
<rdf:Description rdf:about="&a;105452519">
	<b:glossaryEntry>loss of air pressure in a tire when a hole is made by some sharp object</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105452645">
	<b:glossaryEntry>an event resulting in great loss and misfortune; "the whole city was affected by the irremediable calamity"; "the earthquake was a disaster"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105452923">
	<b:glossaryEntry>a natural and unavoidable catastrophe that interrupts the expected course of events; "he discovered that his house was not insured against acts of God"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105453204">
	<b:glossaryEntry>a cosmic cataclysm in which God destroys the ruling powers of evil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105453327">
	<b:glossaryEntry>an event that might have been arranged although it was really accidental</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105453472">
	<b:glossaryEntry>an unexpected piece of good luck; "he finally got his big break"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105453615"
	 b:glossaryEntry="multiple collisions of vehicles"/>
<rdf:Description rdf:about="&a;105453699"
	 b:glossaryEntry="a serious collision (especially of motor vehicles)"/>
<rdf:Description rdf:about="&a;105453812">
	<b:glossaryEntry>an accidental misstep threatening (or causing) a fall; "he blamed his slip on the ice"; "the jolt caused many slips and a few spills"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105454021"
	 b:glossaryEntry="an event that does not accomplish its intended purpose"/>
<rdf:Description rdf:about="&a;105454273"
	 b:glossaryEntry="failure that results in a loss of position or reputation"/>
<rdf:Description rdf:about="&a;105454384"
	 b:glossaryEntry="a failure to function normally"/>
<rdf:Description rdf:about="&a;105454490">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a malfunction in the flight of an aircraft in which there is a sudden loss of lift that results in a downward plunge; "the plane went into a stall and I couldn''t control it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105454715">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an event that accomplishes its intended purpose; "let''s call heads a success and tails a failure"; "the election was a remarkable success for Republicans"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105454977">
	<b:glossaryEntry>(informal) a impressively successful event; "the rock concert was a real barnburner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105455118"
	 b:glossaryEntry='a successful journey; "they wished him Godspeed"'/>
<rdf:Description rdf:about="&a;105455221">
	<b:glossaryEntry>any weakening or degeneration (especially through lack of use)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105455349"
	 b:glossaryEntry="becoming weaker"/>
<rdf:Description rdf:about="&a;105455528">
	<b:glossaryEntry>weakening in force or intensity: "attenuation in the volume of the sound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105455668"
	 b:glossaryEntry="becoming stronger"/>
<rdf:Description rdf:about="&a;105455763">
	<b:glossaryEntry>a sudden decline in strength or number or importance; "the fall of the House of Hapsburg"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105455950">
	<b:glossaryEntry>a disappointing decline after ad previous rise: "the anticlimax of a brilliant career"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105456093"
	 b:glossaryEntry="failure of a plan"/>
<rdf:Description rdf:about="&a;105456179"
	 b:glossaryEntry="a failure to hit (or meet or find etc)"/>
<rdf:Description rdf:about="&a;105456279">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the becoming visible; "not a day''s difference between the emergence of the andrenas and the opening of the willow catkins"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105456510"
	 b:glossaryEntry="the emergence of a tooth as it breaks through the gum"/>
<rdf:Description rdf:about="&a;105456618">
	<b:glossaryEntry>the event of being born; "they celebrated the birth of their first child"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105456848"
	 b:glossaryEntry='the event of giving birth; "she had a difficult delivery"'/>
<rdf:Description rdf:about="&a;105456978"
	 b:glossaryEntry="the birth of a living fetus"/>
<rdf:Description rdf:about="&a;105457098"
	 b:glossaryEntry="(informal) the live birth of a child"/>
<rdf:Description rdf:about="&a;105457208"
	 b:glossaryEntry="delivery of an infant whose feet appear first"/>
<rdf:Description rdf:about="&a;105457330"
	 b:glossaryEntry="a second or new birth"/>
<rdf:Description rdf:about="&a;105457439"
	 b:glossaryEntry="the passing of a soul into another body after death"/>
<rdf:Description rdf:about="&a;105457551"
	 b:glossaryEntry="the event of coming into sight"/>
<rdf:Description rdf:about="&a;105457728"
	 b:glossaryEntry="appearing again"/>
<rdf:Description rdf:about="&a;105457802">
	<b:glossaryEntry>(Christian theology) the reappearance of Jesus as judge for the Last Judgment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105457964"
	 b:glossaryEntry="an appearance in bodily form (as of a ghost)"/>
<rdf:Description rdf:about="&a;105458088"
	 b:glossaryEntry='a clear appearance; "a manifestation of great emotion"'/>
<rdf:Description rdf:about="&a;105458256">
	<b:glossaryEntry>an unexpected appearance or becoming visible; "I was recalled to the present by the apparition of two cowboys riding toward me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105458440"
	 b:glossaryEntry="a divine manifestation"/>
<rdf:Description rdf:about="&a;105458517"
	 b:glossaryEntry="a manifestation of the mind and will of God"/>
<rdf:Description rdf:about="&a;105458618">
	<b:glossaryEntry>an event that is a beginning; a first part or stage of subsequent events</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105458815">
	<b:glossaryEntry>the gradual beginning or coming forth; "figurines presage the emergence of sculpture in Greece"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105459005"
	 b:glossaryEntry="a growth in strength or number or importance"/>
<rdf:Description rdf:about="&a;105459154"
	 b:glossaryEntry="a sudden rise in the crime rate"/>
<rdf:Description rdf:about="&a;105459242"
	 b:glossaryEntry='the beginning of anything; "it was off to a good start"'/>
<rdf:Description rdf:about="&a;105459493">
	<b:glossaryEntry>the increase in activity of the adrenal glands just before puberty</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105459616"
	 b:glossaryEntry="the first occurrence of menstruation in a woman"/>
<rdf:Description rdf:about="&a;105459718"
	 b:glossaryEntry='the beginning or early stages; "the onset of pneumonia"'/>
<rdf:Description rdf:about="&a;105459836">
	<b:glossaryEntry>the earliest period: "the dawn of civilization"; "the morning of the world"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105459972">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the first event in a series: "she played Chopin for her opener"; "the season''s opener was a game agains the Yankees"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105460141">
	<b:glossaryEntry>events that provide the generative force that is the origin of something; "they are trying to determine the cause of the crash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105460392"
	 b:glossaryEntry="a preceding occurrence or cause or event"/>
<rdf:Description rdf:about="&a;105460489">
	<b:glossaryEntry>something that serves as a preceding event or introduces what follows; "training is a necessary preliminary to employment"; "drinks were the overture to dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105460728"
	 b:glossaryEntry="the cause of a disease"/>
<rdf:Description rdf:about="&a;105460817">
	<b:glossaryEntry>anything that contributes causally to a result; "a number of factors determined the outcome"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105461016">
	<b:glossaryEntry>any factor that defines a system and determines (or limits) its performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105461147">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a factor in a given situation whose bearing and importance is not apparent; "I don''t know what the new man will do; he''s still an unknown quantity"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105461357">
	<b:glossaryEntry>something that produces; "Maine is a leading producer of potatoes" or "this microorganism is a producer of disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105461527">
	<b:glossaryEntry>the event that occured at the beginning of something; "from its creation the plan was doomed to failure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105461717">
	<b:glossaryEntry>the beginning of a series or sequence; "the Alpha and Omega, the first and the last, the beginning and the end"--Revelations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105461893">
	<b:glossaryEntry>the first performance (as of a theatrical production); "the opening received good critical reviews"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105462080">
	<b:glossaryEntry>a start given to contestants; "I was there with my parents at the kickoff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105462231">
	<b:glossaryEntry>an event (or course of events) that will inevitably happen in the future</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105462436">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an unavoidable event; "don''t argue with the inevitable"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105462548">
	<b:glossaryEntry>(Hinduism and Buddhism) the effects of a person''s actions that determine his destiny in his next incarnation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105462708"
	 b:glossaryEntry="(Islamic) the will of Allah"/>
<rdf:Description rdf:about="&a;105462797">
	<b:glossaryEntry>total destruction; "bomb tests resulted in the annihilation of the atoll"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105462964"
	 b:glossaryEntry="the complete destruction of every trace of something"/>
<rdf:Description rdf:about="&a;105463089"
	 b:glossaryEntry="serious weakening and loss of energy"/>
<rdf:Description rdf:about="&a;105463225"
	 b:glossaryEntry="coming apart"/>
<rdf:Description rdf:about="&a;105463353">
	<b:glossaryEntry>process or result of distributing or extending over a wide expanse of space</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105463529">
	<b:glossaryEntry>the spread of social institutions (and myths and skills) from one society to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105463669"
	 b:glossaryEntry="driving off or spreading widely"/>
<rdf:Description rdf:about="&a;105463806">
	<b:glossaryEntry>the dispersion of the Jews from Palestine after the Babylonian exile (358 BC)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105463938">
	<b:glossaryEntry>breaking up and scattering by dispersion; "the dissipation of the mist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105464067">
	<b:glossaryEntry>complete annihilation; "they think a meteor cause the extinction of the dinosaurs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105464222">
	<b:glossaryEntry>the death of Jesus on the cross after he was condemned by the Jews as a false Messiah</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105464365">
	<b:glossaryEntry>a death resulting from an accident or a disaster; "a decrease in the number of automobile fatalities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105464571">
	<b:glossaryEntry>the absolute defeat and death of persons on one side of a conflict; "it was a fight to the finish"; "he will be the finish of me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105464753">
	<b:glossaryEntry>death that is imposed because of the person''s adherence of a religious faith or cause</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105464894">
	<b:glossaryEntry>the death of a million people; "they calibrate the effects of atom bombs in megadeaths"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105465037">
	<b:glossaryEntry>euphemistic expressions for death; "thousands mourned his passing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105465214">
	<b:glossaryEntry>an unpleasant or disastrous destiny; "everyone was aware of the approaching doom but was helpless to avoid it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105465405"
	 b:glossaryEntry="an event that destroys something"/>
<rdf:Description rdf:about="&a;105465616"
	 b:glossaryEntry='(usually plural) a destructive action; "the ravages of time"'/>
<rdf:Description rdf:about="&a;105465729">
	<b:glossaryEntry>the event of a structure being completely demolished and leveled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105465857"
	 b:glossaryEntry="an event that results in destruction"/>
<rdf:Description rdf:about="&a;105465992"
	 b:glossaryEntry="an event that results in total destruction"/>
<rdf:Description rdf:about="&a;105466105"
	 b:glossaryEntry='the destruction or collapse of something; "wrack and ruin"'/>
<rdf:Description rdf:about="&a;105466222"
	 b:glossaryEntry="the event of passing out of sight"/>
<rdf:Description rdf:about="&a;105466369"
	 b:glossaryEntry="a sudden or mysterious disappearance"/>
<rdf:Description rdf:about="&a;105466461"
	 b:glossaryEntry="a slow or gradual disappearance"/>
<rdf:Description rdf:about="&a;105466557">
	<b:glossaryEntry>a stroke of ill fortune; a calamitous event: "a period marked by adversities"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105466690">
	<b:glossaryEntry>something that causes or entails suffering: "I cannot thinking it a hardship that more more indulgence is allowed to men than to women"- James Boswell; "the many hardships of frontier life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105466934"
	 b:glossaryEntry='a bad experience; "the school of hard knocks"'/>
<rdf:Description rdf:about="&a;105467031"
	 b:glossaryEntry="an instance of change; the rate or magnitude of change"/>
<rdf:Description rdf:about="&a;105467299">
	<b:glossaryEntry>a variation in circumstances or fortune at different times in your life or in the development of something; "the project was subject to the usual vicissitudes of exploratory research"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105467540">
	<b:glossaryEntry>(chemistry) variability in chemical composition without variation in crystalline form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105467682">
	<b:glossaryEntry>contact by fitting together; "the engagement of the clutch"; "the meshing of gears"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105467854">
	<b:glossaryEntry>a light sharp contact (usually with something flexible); "he gave it a flick with his finger" or "he felt the flick of a whip"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105468032"
	 b:glossaryEntry="the striking of one body against another"/>
<rdf:Description rdf:about="&a;105468143">
	<b:glossaryEntry>an impact (as from a collision); "the bump threw him off the bicycle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105468378"
	 b:glossaryEntry='a sudden impact; "the door closed with a jolt"'/>
<rdf:Description rdf:about="&a;105468490">
	<b:glossaryEntry>the physical coming together of two or more things; "contact with the pier scraped paint from the hull"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105468760"
	 b:glossaryEntry="loss of military equipment"/>
<rdf:Description rdf:about="&a;105468896"
	 b:glossaryEntry="loss of military equipment in battle"/>
<rdf:Description rdf:about="&a;105469010"
	 b:glossaryEntry="loss of military equipment in field operations"/>
<rdf:Description rdf:about="&a;105469144"
	 b:glossaryEntry="a decrease of military personnel or equipment"/>
<rdf:Description rdf:about="&a;105469280"
	 b:glossaryEntry="a casualty to military personnel resulting from combat"/>
<rdf:Description rdf:about="&a;105469447">
	<b:glossaryEntry>a wound that would cause an English soldier to be sent home from service abroad</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105469586">
	<b:glossaryEntry>a wound that does not damage important internal organs or shatter any bones</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105469719"
	 b:glossaryEntry="military personnel lost by death or capture"/>
<rdf:Description rdf:about="&a;105469870">
	<b:glossaryEntry>personnel that are sacrificed (e.g., surrendered or lost in order to gain an objective)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105470013">
	<b:glossaryEntry>a single complete execution of a periodically repeated phenomenon: "a year constitutes a cycle of the seasons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105470229">
	<b:glossaryEntry>the complete cycle of events in the heart from the beginning of one heart beat to the beginning of the next; an electrical impulse in conducted through the heart muscle that constricts the atria which is followed by constriction of the ventricles; "the cardiac cycle can be shown on an electrocardiogram"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105470593">
	<b:glossaryEntry>one complete cycle of operations (as by a computer); "it was not possible to complete the computation in a single pass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105470763">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an event that repeats; "the events today were a repeat of yesterday''s"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105470971"
	 b:glossaryEntry="several repetitions of a melodic phrase in different keys"/>
<rdf:Description rdf:about="&a;105471083">
	<b:glossaryEntry>a periodically repeated sequence of events: "a cycle of reprisal and retaliation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105471216"
	 b:glossaryEntry="something (especially a game) that is played again"/>
<rdf:Description rdf:about="&a;105471329">
	<b:glossaryEntry>happening again (especially at regular intervals); "the return of spring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105471504"
	 b:glossaryEntry="a reappearance of an earlier characteristic"/>
<rdf:Description rdf:about="&a;105471625">
	<b:glossaryEntry>an unexpected but vivid recurrence of a past experience (especially a recurrence of the effects of an hallucinogenic drug taken much earlier)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105471822"
	 b:glossaryEntry="the daily event of the sun rising above the horizon"/>
<rdf:Description rdf:about="&a;105471927"
	 b:glossaryEntry="the daily event of the sun sinking below the horizon"/>
<rdf:Description rdf:about="&a;105472032"
	 b:glossaryEntry="a broad and deep undulation of the ocean"/>
<rdf:Description rdf:about="&a;105472145"
	 b:glossaryEntry="waves breaking on the shore"/>
<rdf:Description rdf:about="&a;105472244">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the wave that spreads behind a boat as it moves forward; "the motorboat''s wake capsized the canoe"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105472404">
	<b:glossaryEntry>the movement or sound of water; "the swash of waves on the beach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105472521"
	 b:glossaryEntry="a small wave on the surface of a liquid"/>
<rdf:Description rdf:about="&a;105472643">
	<b:glossaryEntry>(physics) a wave that is hypothesized to propagate gravity and to travel at the speed of light</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105472815"
	 b:glossaryEntry="a wave whose waveform resembles a sine curve"/>
<rdf:Description rdf:about="&a;105472915"
	 b:glossaryEntry="(physics) a regular variation in value about a mean"/>
<rdf:Description rdf:about="&a;105473126">
	<b:glossaryEntry>(electronics) an oscillation of small amplitude imposed on top of a steady value</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105473259">
	<b:glossaryEntry>(physics) a progressive disturbance propagated without displacement of the medium itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105473610"
	 b:glossaryEntry='a wave motion; "the fluctuations of the sea"'/>
<rdf:Description rdf:about="&a;105473712">
	<b:glossaryEntry>a wave on the surface of a lake or landlocked bay; caused by atmospheric or seismic disturbances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105473861">
	<b:glossaryEntry>a wave (as a sound wave in a chamber or an electromagnetic wave in a transmission line) in which the ratio of its instantaneous amplitude at one point to that at any other point does not vary with time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105474140"
	 b:glossaryEntry="(acoustics) a wave that transmits sound"/>
<rdf:Description rdf:about="&a;105474254"
	 b:glossaryEntry="a sound wave that is transmitted via air"/>
<rdf:Description rdf:about="&a;105474349">
	<b:glossaryEntry>(physics) a short-lived oscillation in a system caused by a sudden change of voltage or current or load</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105474508">
	<b:glossaryEntry>the shape of a wave illustrated graphically by plotting the values of the period quantity against time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105474690">
	<b:glossaryEntry>a region of high pressure travelling through a gas at a high velocity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105474834">
	<b:glossaryEntry>an explosive sound caused by the shock wave of an airplane traveling faster than the speed of sound; "a sonic boom follows an aircraft as a wake follows a ship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105475051"
	 b:glossaryEntry="the undulating movement of the surface of the open sea"/>
<rdf:Description rdf:about="&a;105475192"
	 b:glossaryEntry="a wave that lifts the surface of the water or ground"/>
<rdf:Description rdf:about="&a;105475302"
	 b:glossaryEntry="a large sea wave"/>
<rdf:Description rdf:about="&a;105475379">
	<b:glossaryEntry>a huge destructive wave (especially one caused by an earthquake)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105475510"
	 b:glossaryEntry="a long heavy sea wave as it advances towards the shore"/>
<rdf:Description rdf:about="&a;105475639">
	<b:glossaryEntry>a periodic motion in which the displacement is either symmetrical about a point or is the sum of such motions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105475828"
	 b:glossaryEntry="(geology) a horizontal dislocation"/>
<rdf:Description rdf:about="&a;105475914"
	 b:glossaryEntry="a movement back from an impact"/>
<rdf:Description rdf:about="&a;105476069"
	 b:glossaryEntry="rebounding from an impact (or series of impacts)"/>
<rdf:Description rdf:about="&a;105476181"
	 b:glossaryEntry="the backward jerk of a gun when it is fired"/>
<rdf:Description rdf:about="&a;105476284">
	<b:glossaryEntry>(computer science) the movement of a read/write head to a specific data track on a disk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105476422"
	 b:glossaryEntry='a twisting squeeze: "gave the wet cloth a wring"'/>
<rdf:Description rdf:about="&a;105476532">
	<b:glossaryEntry>the maximum movement available to a pivoted or reciprocating piece by a cam</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105476717">
	<b:glossaryEntry>the stroke of an engine piston moving away from the crankshaft</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105476834"
	 b:glossaryEntry="the stroke of an engine piston moving toward the crankshaft"/>
<rdf:Description rdf:about="&a;105476949"
	 b:glossaryEntry='a movement in a new direction; "the turning of the wind"'/>
<rdf:Description rdf:about="&a;105477156"
	 b:glossaryEntry="a jerky pulling movement"/>
<rdf:Description rdf:about="&a;105477241">
	<b:glossaryEntry>one of a series of ridges that moves across the surface of a liquid (especially across a large body of water)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105477614">
	<b:glossaryEntry>a wave that is blown by the wind so its crest is broken and appears white</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105477756">
	<b:glossaryEntry>something that rises rapidly and dies away; "a wave of emotion swept over him"; "there was a sudden wave of buying before the market closed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105477947"
	 b:glossaryEntry="an accident that destroys a ship at sea"/>
<rdf:Description rdf:about="&a;105478068">
	<b:glossaryEntry>(nautical) the event of a boat accidentally turning over in the water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105478207">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the ending of a contest (as a race); "it was an exciting finish"; "I didn''t stay for the close of the tournament"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105478453">
	<b:glossaryEntry>a finish in first place (as in a race or other competition); "he was happy to get the win"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105478593"
	 b:glossaryEntry="(in horse racing) a finish in second place"/>
<rdf:Description rdf:about="&a;105478687"
	 b:glossaryEntry="(in horse racing) a finish in third place"/>
<rdf:Description rdf:about="&a;105478779"
	 b:glossaryEntry="the concluding part of any performance"/>
<rdf:Description rdf:about="&a;105478896">
	<b:glossaryEntry>the ending of a series or sequence; "the Alpha and the Omega, the first and the last, the beginning and the end"--Revelation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105479076">
	<b:glossaryEntry>the event of dying or departure from life: "her death came as a terrible shock"; "upon your decease the capital will pass to your grandchildren"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105479408"
	 b:glossaryEntry='a change downward; "there was a sharp drop-off in sales"'/>
<rdf:Description rdf:about="&a;105479668">
	<b:glossaryEntry>a slow fall or decline (as for lack of strength); "after several hours of sinking an unexpected rally rescued the market"; "he could not control the sinking of his legs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105479891">
	<b:glossaryEntry>a change resulting in an increase; "the fare increase is scheduled for next month"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105480118"
	 b:glossaryEntry='a wearing down to weaken or destroy; "a war of attrition"'/>
<rdf:Description rdf:about="&a;105480231"
	 b:glossaryEntry="a change for the better"/>
<rdf:Description rdf:about="&a;105480347"
	 b:glossaryEntry="a change for the better; progress in development"/>
<rdf:Description rdf:about="&a;105480566">
	<b:glossaryEntry>the result of improving something; "he described a refinement of this technique"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105480717">
	<b:glossaryEntry>alteration in the shape or dimensions of an object as a result of the application of stress to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105480908">
	<b:glossaryEntry>a change from one place or state or subject or stage to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105481064">
	<b:glossaryEntry>an obvious change of public opinion or political sentiment that occurs without leadership or overt expression; "there was a ground swell of antiwar sentiment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105481281">
	<b:glossaryEntry>an abrupt transition; "a successful leap from college to the major leagues"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105481414"
	 b:glossaryEntry="a qualitative change"/>
<rdf:Description rdf:about="&a;105481681">
	<b:glossaryEntry>a change in the relative numbers of the different groups of individuals making up a population</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105481838">
	<b:glossaryEntry>(chemistry) a change directly from the solid to the gaseous state without becoming liquid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105481985">
	<b:glossaryEntry>the transformation of ordinary white tin into powdery gray tin a very cold temperatures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105482154"
	 b:glossaryEntry="an incident is which an infectious disease is transmitted"/>
<rdf:Description rdf:about="&a;105482294">
	<b:glossaryEntry>an incident (real or imaginary); "their parting was a sad scene"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105482410">
	<b:glossaryEntry>a subordinate incident of little importance relative to the main event; "instruction is not an educational sideshow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105482581">
	<b:glossaryEntry>a mishap caused by something suddenly falling down or caving in</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105482753"
	 b:glossaryEntry="the sudden collapse of something into a hollow beneath it"/>
<rdf:Description rdf:about="&a;105482877"
	 b:glossaryEntry="an event that causes someone to die"/>
<rdf:Description rdf:about="&a;105482982"
	 b:glossaryEntry="an accident that causes someone to die"/>
<rdf:Description rdf:about="&a;105483110"
	 b:glossaryEntry='a stopping; "a cessation of the thunder"'/>
<rdf:Description rdf:about="&a;105483217"
	 b:glossaryEntry="a gradual sinking to a lower level"/>
<rdf:Description rdf:about="&a;105483331">
	<b:glossaryEntry>a descent as through liquid (especially through water); "they still talk about the sinking of the Titanic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105483545">
	<b:glossaryEntry>a free and rapid descent by the force of gravity; "it was a miracle that he survived the drop from that height"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105483742"
	 b:glossaryEntry="a movement downward"/>
<rdf:Description rdf:about="&a;105483905">
	<b:glossaryEntry>a sudden downpour (as of tears or sparks etc) likened to a rain shower; "a little shower of rose petals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105484062">
	<b:glossaryEntry>the descent of a heavenly body below the horizon; "before the set of sun"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105484185"
	 b:glossaryEntry="covering completely with water"/>
<rdf:Description rdf:about="&a;105484329"
	 b:glossaryEntry="a brief immersion"/>
<rdf:Description rdf:about="&a;105484396"
	 b:glossaryEntry="(of a ship) sinking"/>
<rdf:Description rdf:about="&a;105484486"
	 b:glossaryEntry="a rocking motion"/>
<rdf:Description rdf:about="&a;105484555"
	 b:glossaryEntry='a complete failure; "the play was a dismal flop"'/>
<rdf:Description rdf:about="&a;105484679">
	<b:glossaryEntry>an event that fails badly or is totally ineffectual; "the first experiment was a real turkey"; "the meeting was a dud as far as new business was concerned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105484900"
	 b:glossaryEntry="a sudden and violent collapse"/>
<rdf:Description rdf:about="&a;105484992"
	 b:glossaryEntry='a sudden inward collapse; "the implosion of a light bulb"'/>
<rdf:Description rdf:about="&a;105485105">
	<b:glossaryEntry>the event of something ending; "it came to a stop at the bottom of the hill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105485275"
	 b:glossaryEntry="an interruption of normal activity"/>
<rdf:Description rdf:about="&a;105485383">
	<b:glossaryEntry>a variation that deviates from the standard or norm; "the deviation from the mean"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105485595"
	 b:glossaryEntry="an event that departs from expectations"/>
<rdf:Description rdf:about="&a;105485713">
	<b:glossaryEntry>the deviation (by a vessel or aircraft) from its intended course due to drifting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105485848"
	 b:glossaryEntry="something abnormal or anomalous"/>
<rdf:Description rdf:about="&a;105485970">
	<b:glossaryEntry>something hideous or frightful; "they regarded the atom bomb as a monstrosity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105486106"
	 b:glossaryEntry="an event that results in a displacement or discontinuity"/>
<rdf:Description rdf:about="&a;105486233">
	<b:glossaryEntry>the occurrence of breaking; "the break in the dam threatened the valley"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105486357">
	<b:glossaryEntry>some occurrence that interrupts; "the telephone is an annoying interruption"; "there was a break in the action when a player was hurt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105486628"
	 b:glossaryEntry="an interruption in the intensity or amount of something"/>
<rdf:Description rdf:about="&a;105486800"
	 b:glossaryEntry="one celestial body obscures another"/>
<rdf:Description rdf:about="&a;105486961"
	 b:glossaryEntry="the moon interrupts light from the sun"/>
<rdf:Description rdf:about="&a;105487077"
	 b:glossaryEntry="the earth interrupts light shining on the moon"/>
<rdf:Description rdf:about="&a;105487183"
	 b:glossaryEntry="only a thin outer disk of the sun can be seen"/>
<rdf:Description rdf:about="&a;105487290">
	<b:glossaryEntry>an eclipse as seen from a place where the eclipsed body is completely obscured</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105487428">
	<b:glossaryEntry>an eclipse in which the eclipsed body is only partially obscured</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105487554"
	 b:glossaryEntry="the amount by which something increases"/>
<rdf:Description rdf:about="&a;105487652"
	 b:glossaryEntry="making or becoming suitable; adjusting to circumstances"/>
<rdf:Description rdf:about="&a;105487790">
	<b:glossaryEntry>a movement upward; "they cheered the rise of the hot-air balloon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105488098"
	 b:glossaryEntry='a movement downward; "the rise and fall of the tides"'/>
<rdf:Description rdf:about="&a;105488220">
	<b:glossaryEntry>an event that involves rising to a higher point (as in altitude or temperature or intensity etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105488391"
	 b:glossaryEntry="the event of something being raised"/>
<rdf:Description rdf:about="&a;105488499">
	<b:glossaryEntry>an upward movement (especially a rhythmical rising and falling); "the heaving of waves on a rough sea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105488663"
	 b:glossaryEntry="the initial ascent of a rocket from its launching pad"/>
<rdf:Description rdf:about="&a;105488770">
	<b:glossaryEntry>the sudden occurrence of an audible event; "the sound awakened them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105489772">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an angry disturbance; "he didn''t want to make a fuss"; "they had labor trouble"; "a spot of bother"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105489950">
	<b:glossaryEntry>a movement forward; "he listened for the progress of the troops"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105490111">
	<b:glossaryEntry>forward movement; "the ship made little headway against the gale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105490237">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an annoying or frustrating event; "his mother-in-law''s visits were a great trial for him"; "life is full of tribulations"; "a visitation of the plague"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105490485">
	<b:glossaryEntry>the occurrence of a uniting of separate parts; "lightning produced an unusual union of the metals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105490689"
	 b:glossaryEntry="union of sperm and egg in sexual reproduction"/>
<rdf:Description rdf:about="&a;105490810"
	 b:glossaryEntry="an occurrence that involves the production of a union"/>
<rdf:Description rdf:about="&a;105490939"
	 b:glossaryEntry="an occurrence that results in things being combined"/>
<rdf:Description rdf:about="&a;105491124"
	 b:glossaryEntry="combining into a solid mass"/>
<rdf:Description rdf:about="&a;105491211">
	<b:glossaryEntry>an event that combines things in a mixture; "a gradual mixture of cultures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105491382"
	 b:glossaryEntry="an occurrence of an unusual mixture"/>
<rdf:Description rdf:about="&a;105491474"
	 b:glossaryEntry="an occurrence combining miscellaneous things"/>
<rdf:Description rdf:about="&a;105491579"
	 b:glossaryEntry="an occurrence of thorough mixing"/>
<rdf:Description rdf:about="&a;105491663"
	 b:glossaryEntry="a rapid rise"/>
<rdf:Description rdf:about="&a;105491755"
	 b:glossaryEntry="the initial ascent of an airplane as it becomes airborne"/>
<rdf:Description rdf:about="&a;105491865">
	<b:glossaryEntry>(geology) a rise of land to a higher elevation (as in the process of mountain building)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105492038">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the rising of something; "the coulds'' uplifting revealed the blue of a summer sky"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105492176"
	 b:glossaryEntry="the cry made by sheep"/>
<rdf:Description rdf:about="&a;105492247"
	 b:glossaryEntry="a sudden very loud noise"/>
<rdf:Description rdf:about="&a;105492388"
	 b:glossaryEntry="a continuing very loud noise"/>
<rdf:Description rdf:about="&a;105492470"
	 b:glossaryEntry="the sound made by a dog"/>
<rdf:Description rdf:about="&a;105492562"
	 b:glossaryEntry="a noise resembling the bark of a dog"/>
<rdf:Description rdf:about="&a;105492649"
	 b:glossaryEntry="the sound of a hound on the scent"/>
<rdf:Description rdf:about="&a;105492732"
	 b:glossaryEntry='the sound of stroke or blow; "he heard the beat of a drum"'/>
<rdf:Description rdf:about="&a;105492841"
	 b:glossaryEntry="a short high tone produced as a signal or warning"/>
<rdf:Description rdf:about="&a;105492949"
	 b:glossaryEntry='the sound of a bell: "saved by the bell"'/>
<rdf:Description rdf:about="&a;105493076"
	 b:glossaryEntry="a loud harsh or strident noise"/>
<rdf:Description rdf:about="&a;105493195"
	 b:glossaryEntry="a deep prolonged loud noise"/>
<rdf:Description rdf:about="&a;105493300"
	 b:glossaryEntry="the sound of sheep or goats (or any sound resembling this)"/>
<rdf:Description rdf:about="&a;105493410"
	 b:glossaryEntry="the cry of an ass"/>
<rdf:Description rdf:about="&a;105493478"
	 b:glossaryEntry="the bark of a dog"/>
<rdf:Description rdf:about="&a;105493549"
	 b:glossaryEntry='sound of rapid vibration: "the buzz of a bee"'/>
<rdf:Description rdf:about="&a;105493645"
	 b:glossaryEntry="the sound made by a hen after laying an egg"/>
<rdf:Description rdf:about="&a;105493741"
	 b:glossaryEntry="the yowling sound made by a cat in heat"/>
<rdf:Description rdf:about="&a;105493836"
	 b:glossaryEntry="the sound made by corvine birds"/>
<rdf:Description rdf:about="&a;105493917">
	<b:glossaryEntry>the high-pitched continuing noise made by animals (birds or monkeys)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105494052"
	 b:glossaryEntry="the rapid series of noises made by the parts of a machine"/>
<rdf:Description rdf:about="&a;105494176"
	 b:glossaryEntry="the short weak cry of a young bird"/>
<rdf:Description rdf:about="&a;105494269"
	 b:glossaryEntry="a short light metallic sound"/>
<rdf:Description rdf:about="&a;105494365"
	 b:glossaryEntry="a sharp sound made by small birds or insects"/>
<rdf:Description rdf:about="&a;105494479"
	 b:glossaryEntry="a series of chirps"/>
<rdf:Description rdf:about="&a;105494561">
	<b:glossaryEntry>any utterance produced simultaneously by a group; "a chorus of boos"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105494682"
	 b:glossaryEntry="the dull explosive noise made by an engine"/>
<rdf:Description rdf:about="&a;105494775">
	<b:glossaryEntry>a loud resonant repeating noise; "he could hear the clang of distant bells"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105494969">
	<b:glossaryEntry>a rattling noise (often produced by rapid movement); "the shutters clattered against the house"; "the clatter of iron wheels on cobblestones"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105495164"
	 b:glossaryEntry="a succession of clicks"/>
<rdf:Description rdf:about="&a;105495262">
	<b:glossaryEntry>a fast and rhythmic click-clack; "the clickety-clack of the typewriters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105495412"
	 b:glossaryEntry="the sound made by a hen (as in calling her chicks)"/>
<rdf:Description rdf:about="&a;105495514"
	 b:glossaryEntry="an imitation of the crow of a cock"/>
<rdf:Description rdf:about="&a;105495612"
	 b:glossaryEntry="the sound made by a pigeon"/>
<rdf:Description rdf:about="&a;105495688">
	<b:glossaryEntry>a sudden sharp noise; "the crack of a whip"; "he heard the cracking of the ice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105495830"
	 b:glossaryEntry="the sharp sound of snapping noises"/>
<rdf:Description rdf:about="&a;105495980">
	<b:glossaryEntry>a squeaking sound; "the creak of the floorboards gave him away"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105496106">
	<b:glossaryEntry>the crackling sound heard on auscultation when patients with respiratory diseases inhale</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105496282"
	 b:glossaryEntry="the cry of a cock (or an imitation of it)"/>
<rdf:Description rdf:about="&a;105496392">
	<b:glossaryEntry>the sound of something crunching; "he heard the crunch of footsteps on the gravel path"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105496532">
	<b:glossaryEntry>the characteristic utterance of an animal; "animal cries filled the night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105497034">
	<b:glossaryEntry>the crackling or breaking up of certain crystals when they are heated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105497163">
	<b:glossaryEntry>the sound of a drum; "he could hear the drums before he heard the fifes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105497286"
	 b:glossaryEntry="the noise made by a bell"/>
<rdf:Description rdf:about="&a;105497366">
	<b:glossaryEntry>the sound of a step of someone walking; "he heard footsteps on the porch"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105497512"
	 b:glossaryEntry="the sound produced while gargling"/>
<rdf:Description rdf:about="&a;105497598"
	 b:glossaryEntry="the characteristic sound made by a turkey cock"/>
<rdf:Description rdf:about="&a;105497697"
	 b:glossaryEntry="a harsh and strident sound (as of the grinding of gears)"/>
<rdf:Description rdf:about="&a;105497808"
	 b:glossaryEntry="the sound of growling (as made by animals)"/>
<rdf:Description rdf:about="&a;105497913"
	 b:glossaryEntry="the short low gruff noise of the kind made by pigs"/>
<rdf:Description rdf:about="&a;105498015">
	<b:glossaryEntry>the bubbling sound of water flowing from a bottle with a narrow neck</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105498136">
	<b:glossaryEntry>a fricative sound uttered as an expression of dislike or contempt; "the performers could not be heard over the hissing of the audience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105498332"
	 b:glossaryEntry="the cry of a goose (or any sound resembling this)"/>
<rdf:Description rdf:about="&a;105498432">
	<b:glossaryEntry>a loud sustained noise resembling the cry of a hound; "the howl of the wind made him restless"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105498595"
	 b:glossaryEntry="the long plaintive cry of a hound or a wolf"/>
<rdf:Description rdf:about="&a;105498689"
	 b:glossaryEntry="loud confused noise from many sources"/>
<rdf:Description rdf:about="&a;105498799"
	 b:glossaryEntry='a humming noise; "the hum of distant traffic"'/>
<rdf:Description rdf:about="&a;105498904">
	<b:glossaryEntry>the sound of a bell rung slowly to announce a death or a funeral or the end of something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105499044">
	<b:glossaryEntry>the sound of knocking (as on a door or in an engine or bearing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105499170"
	 b:glossaryEntry="the sound made by a cat (or any sound resembling this)"/>
<rdf:Description rdf:about="&a;105499297"
	 b:glossaryEntry="the sound made by a cow or bull"/>
<rdf:Description rdf:about="&a;105499378"
	 b:glossaryEntry="a low continuous indistinct sound"/>
<rdf:Description rdf:about="&a;105499511"
	 b:glossaryEntry="the sound made by a horse"/>
<rdf:Description rdf:about="&a;105499597">
	<b:glossaryEntry>sound of any kind (especially unintelligible or dissonant sound); "he enjoyed the street noises"; "they heard indistinct noises of people talking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105500551"
	 b:glossaryEntry="the noise made by a short puff of steam (as from an engine)"/>
<rdf:Description rdf:about="&a;105500661">
	<b:glossaryEntry>the sound of a drum (especially a snare drum) beaten rapidly and continuously</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105500814"
	 b:glossaryEntry="the sound made by a gentle blow"/>
<rdf:Description rdf:about="&a;105500925"
	 b:glossaryEntry="a deep prolonged sound (as of thunder)"/>
<rdf:Description rdf:about="&a;105501041"
	 b:glossaryEntry="a sharp high-pitched metallic sound"/>
<rdf:Description rdf:about="&a;105501127">
	<b:glossaryEntry>a series of rapid tapping sounds; "she missed the pitter-patter of little feet around the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105501283"
	 b:glossaryEntry="the noise of something dropping (as into liquid)"/>
<rdf:Description rdf:about="&a;105501383">
	<b:glossaryEntry>the noise of a rounded object dropping into a liquid without a splash</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105501503"
	 b:glossaryEntry="the sound of a sudden heavy fall"/>
<rdf:Description rdf:about="&a;105501587"
	 b:glossaryEntry="a hollow twanging sound"/>
<rdf:Description rdf:about="&a;105501662"
	 b:glossaryEntry="a sharp explosive sound as from a gunshot or drawing a cork"/>
<rdf:Description rdf:about="&a;105501781"
	 b:glossaryEntry="a low vibrating sound typical of a contented cat"/>
<rdf:Description rdf:about="&a;105501880"
	 b:glossaryEntry="the harsh sound of a duck"/>
<rdf:Description rdf:about="&a;105501957"
	 b:glossaryEntry="a tremulous sound"/>
<rdf:Description rdf:about="&a;105502027"
	 b:glossaryEntry="a loud and disturbing noise"/>
<rdf:Description rdf:about="&a;105502107">
	<b:glossaryEntry>a series of short sharp noises (as made by strokes on a drum or knocks on a door)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105502258"
	 b:glossaryEntry="a rapid series of short loud sounds"/>
<rdf:Description rdf:about="&a;105502357">
	<b:glossaryEntry>a sharp explosive sound (especially the sound of a gun firing); "they heard a violent report followed by silence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105502523">
	<b:glossaryEntry>the sound of a bell ringing; "the distinctive ring of the church bell"; "the ringing of the telephone"; "the tintinnabulation that so volumnously swells from the ringing and the dinging of the bells"--E. A. Poe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105502831"
	 b:glossaryEntry="the sound made by a lion"/>
<rdf:Description rdf:about="&a;105502906"
	 b:glossaryEntry="the sound made by beating a drum"/>
<rdf:Description rdf:about="&a;105503005">
	<b:glossaryEntry>a loud low dull continuous noise; "they heard the rumbling of thunder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105503161">
	<b:glossaryEntry>the light noise like the noise of silk clothing or leaves blowing in the wind</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105503325">
	<b:glossaryEntry>a harsh noise made by scraping; "the scrape of violin bows distracted her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105503486">
	<b:glossaryEntry>a high-pitched noise resembling a human cry; "he ducked at the screechings of shells"; "he heard the scream of the brakes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105503717"
	 b:glossaryEntry="a crunching noise"/>
<rdf:Description rdf:about="&a;105503788">
	<b:glossaryEntry>a continuing shrill noise; "the clash of swords and the shrilling of trumpets"--P. J. Searles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105503937">
	<b:glossaryEntry>a sound like a person sighing; "she heard the sigh of the wind in the trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105504064"
	 b:glossaryEntry="the sound of (the chanter of) a bagpipe"/>
<rdf:Description rdf:about="&a;105504155"
	 b:glossaryEntry="the rattling noise produced when snoring"/>
<rdf:Description rdf:about="&a;105504258">
	<b:glossaryEntry>a distinctive or characteristic sound; "the song of bullets was in the air"; "the song of the wind"; "the wheels sang their song as the train rocketed ahead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105504466">
	<b:glossaryEntry>the noise of something spattering or sputtering explosively; "he heard a spatter of gunfire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105504684"
	 b:glossaryEntry="the sound like water splashing"/>
<rdf:Description rdf:about="&a;105504793"
	 b:glossaryEntry='a single splash; "he heard a splat as it hit the floor"'/>
<rdf:Description rdf:about="&a;105504900"
	 b:glossaryEntry='the noise of squawking; "the squawk of car horns"'/>
<rdf:Description rdf:about="&a;105505002">
	<b:glossaryEntry>a short high-pitched noise; "the squeak of of shoes on powdery snow"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105505123"
	 b:glossaryEntry="a high-pitched howl"/>
<rdf:Description rdf:about="&a;105505195">
	<b:glossaryEntry>a shrill grating or chirping noise made by some insects by rubbing body parts together</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105505340"
	 b:glossaryEntry='sound of strumming: "the strum of a guitar"'/>
<rdf:Description rdf:about="&a;105505435"
	 b:glossaryEntry="a brushing or rustling sound"/>
<rdf:Description rdf:about="&a;105505515">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the sound of light blow or knock; "he heard the tapping of the man''s cane"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105505643">
	<b:glossaryEntry>a sound with a strong rhythmic beat; "the throbbing of the engines"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105505766"
	 b:glossaryEntry="a heavy dull sound (as made by impact of heavy objects)"/>
<rdf:Description rdf:about="&a;105505907"
	 b:glossaryEntry='a thrumming sound; "he could hear the thrum of a banjo"'/>
<rdf:Description rdf:about="&a;105506014">
	<b:glossaryEntry>a booming or crashing noise caused by air expanding along the path of a bolt of lightning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105506175"
	 b:glossaryEntry="a single sharp crash of thunder"/>
<rdf:Description rdf:about="&a;105506264">
	<b:glossaryEntry>a dull hollow sound; "the basketball made a thunk as it hit the rim"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105506384">
	<b:glossaryEntry>a metallic tapping sound; "he counted the ticks of the clock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105506524"
	 b:glossaryEntry="steady recurrent ticking sound as made by a clock"/>
<rdf:Description rdf:about="&a;105506648"
	 b:glossaryEntry="a light clear metallic sound as of a small bell"/>
<rdf:Description rdf:about="&a;105506755"
	 b:glossaryEntry="a blast of a horn"/>
<rdf:Description rdf:about="&a;105506823"
	 b:glossaryEntry="sound of tooting softly and repeatedly as on a flute"/>
<rdf:Description rdf:about="&a;105506928"
	 b:glossaryEntry="the sound of trampling"/>
<rdf:Description rdf:about="&a;105507016"
	 b:glossaryEntry="a sharp vibrating sound (as of a plucked string)"/>
<rdf:Description rdf:about="&a;105507116"
	 b:glossaryEntry="a week chirping sound as of a small bird"/>
<rdf:Description rdf:about="&a;105507208">
	<b:glossaryEntry>(music) a pulsating effect in an instrumental or vocal tone produced by slight and rapid variations in pitch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105507388">
	<b:glossaryEntry>vocal vibrato especially an excessive or poorly controlled one</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105507504">
	<b:glossaryEntry>a sound suggestive of a vocal utterance; "the noisy voice of the waterfall"; "the incessant voices of the artillery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105507672"
	 b:glossaryEntry="the banging sound of steam in pipes"/>
<rdf:Description rdf:about="&a;105507766">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sound of something in rapid motion: "whir of a bird''s wings"; "the whir of the propellers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105507926">
	<b:glossaryEntry>the sound made by something moving rapidly or by steam coming out of a small aperture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105508077"
	 b:glossaryEntry="a sharp high-pitched cry (especially by a dog)"/>
<rdf:Description rdf:about="&a;105508184">
	<b:glossaryEntry>a brief high-pitched buzzing or humming sound: "the zing of the passing bullet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105508314"
	 b:glossaryEntry="a newsworthy event"/>
<rdf:Description rdf:about="&a;105508389">
	<b:glossaryEntry>the rhythmic contraction and expansion of the arteries with each beat of the heart; "he could feel the beat of her heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105508647">
	<b:glossaryEntry>the widening of the chambers of the heart between two contractions when the chambers fill with blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105508802">
	<b:glossaryEntry>the contraction of the chambers of the heart (especially the ventricles) to drive blood into the aorta and pulmonary artery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105508979">
	<b:glossaryEntry>an instance of rapid strong pulsation (of the heart); "he felt a throbbing in his head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105509141"
	 b:glossaryEntry="the tide when the water is highest"/>
<rdf:Description rdf:about="&a;105509328"
	 b:glossaryEntry="the outward flow of the tide"/>
<rdf:Description rdf:about="&a;105509434"
	 b:glossaryEntry="the lowest (farthest) ebb of the tide"/>
<rdf:Description rdf:about="&a;105509556"
	 b:glossaryEntry="the tide while water is flowing out"/>
<rdf:Description rdf:about="&a;105509682">
	<b:glossaryEntry>the periodic rise and fall of the sea level under the gravitational pull of the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105509964">
	<b:glossaryEntry>the occurrence of high tide on one side of the earth coinciding with high tide on the opposite side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105510121">
	<b:glossaryEntry>the inward flow of the tide; "a tide in the affairs of men which, taken at the flood, leads on to fortune" -Shakespeare</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105510311">
	<b:glossaryEntry>the occurrence of incoming water (between a low tide and the following high tide)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105510500">
	<b:glossaryEntry>a less than average tide occurring at the first and third quarters of the moon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105510659">
	<b:glossaryEntry>a greater than average tide occurring during the new and full moons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105510801">
	<b:glossaryEntry>the occurrence of relatively still water at the turn of the (low) tide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105510942">
	<b:glossaryEntry>a high wave (often dangerous) caused by tidal flow (as by colliding tidal currents or in a narrow estuary)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105511136"
	 b:glossaryEntry="the water current caused by the tides"/>
<rdf:Description rdf:about="&a;105511283">
	<b:glossaryEntry>the seaward undercurrent created after waves have broken on the shore</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105511441"
	 b:glossaryEntry="a strong surface current flowing outwards from a shore"/>
<rdf:Description rdf:about="&a;105511582"
	 b:glossaryEntry="a stretch of turbulent water in the sea"/>
<rdf:Description rdf:about="&a;105511707"
	 b:glossaryEntry="a current below the surface of a fluid"/>
<rdf:Description rdf:about="&a;105511853">
	<b:glossaryEntry>(geology) the descent of a large mass of earth or rocks or snow etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105512009">
	<b:glossaryEntry>a slide of large masses of snow and ice and mud down a mountain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105512146">
	<b:glossaryEntry>an avalanche volcanic water and mud down the slopes of a volcano</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105512262">
	<b:glossaryEntry>a slide of a large mass of dirt and rock down a mountain or cliff</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105512430"
	 b:glossaryEntry="a landslide of mud"/>
<rdf:Description rdf:about="&a;105512503"
	 b:glossaryEntry="a landslide of rocks"/>
<rdf:Description rdf:about="&a;105512579"
	 b:glossaryEntry="the motion characteristic of fluids (liquids or gases)"/>
<rdf:Description rdf:about="&a;105512964"
	 b:glossaryEntry="a flow that returns toward its source"/>
<rdf:Description rdf:about="&a;105513070"
	 b:glossaryEntry="the flow of air"/>
<rdf:Description rdf:about="&a;105513139">
	<b:glossaryEntry>a steady flow (usually from natural causes); "the raft floated downstream on the current"; "he felt a stream of air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105513444">
	<b:glossaryEntry>the occurrence of a water flow resulting from sudden rain or melting snow</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105513579">
	<b:glossaryEntry>the occurrence of surplus liquid (as water) exceeding the limit or capacity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105513744">
	<b:glossaryEntry>a violently fast stream of water (or other liquid); "the houses were swept away in the torrent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105513910"
	 b:glossaryEntry="the pouring forth of a fluid"/>
<rdf:Description rdf:about="&a;105514049"
	 b:glossaryEntry="a flow or discharge"/>
<rdf:Description rdf:about="&a;105514129"
	 b:glossaryEntry="an explosion (as of dynamite)"/>
<rdf:Description rdf:about="&a;105514228"
	 b:glossaryEntry="the explosion of a bomb"/>
<rdf:Description rdf:about="&a;105514326"
	 b:glossaryEntry="the explosion of an atomic bomb"/>
<rdf:Description rdf:about="&a;105514459"
	 b:glossaryEntry="backfire from a recoilless weapon"/>
<rdf:Description rdf:about="&a;105514548">
	<b:glossaryEntry>a loud noise made by the explosion of fuel in the manifold or exhaust of an internal combustion engine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105514723"
	 b:glossaryEntry="the backward escape of unburned gunpowder after a shot"/>
<rdf:Description rdf:about="&a;105514832"
	 b:glossaryEntry="a glancing rebound"/>
<rdf:Description rdf:about="&a;105514913">
	<b:glossaryEntry>the event of something coming in contact with the body; "he longed for the touch of her hand"; "the cooling touch of the night air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105515143"
	 b:glossaryEntry="any violent blow or collision"/>
<rdf:Description rdf:about="&a;105515237"
	 b:glossaryEntry="a gentle blow"/>
<rdf:Description rdf:about="&a;105515315">
	<b:glossaryEntry>a vigorous blow; "the sudden knock floored him"; "he took a bash right in his face"; "he got a bang on the head"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105515508"
	 b:glossaryEntry="repeated heavy blows"/>
<rdf:Description rdf:about="&a;105515595"
	 b:glossaryEntry="a blow from a flat object (as an open hand)"/>
<rdf:Description rdf:about="&a;105515697"
	 b:glossaryEntry="the amount by which a propagating wave is bent"/>
<rdf:Description rdf:about="&a;105515825">
	<b:glossaryEntry>periodic motion in which the restoring force is proportional to the displacement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105515974">
	<b:glossaryEntry>turning in an opposite direction or position; "the reversal of the image in the lens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105516128"
	 b:glossaryEntry="an erratic deflection from an intended course"/>
<rdf:Description rdf:about="&a;105516232">
	<b:glossaryEntry>injury to the brain caused by a blow; usually resulting in loss of consciousness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105516369"
	 b:glossaryEntry="a rapid change in brightness"/>
<rdf:Description rdf:about="&a;105516479">
	<b:glossaryEntry>a weak and tremulous light; "the shimmer of colors on iridescent feathers"; "the play of light on the water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105516648"
	 b:glossaryEntry="a sudden intense burst of radiant energy"/>
<rdf:Description rdf:about="&a;105516848"
	 b:glossaryEntry="a momentary flash of light"/>
<rdf:Description rdf:about="&a;105516944"
	 b:glossaryEntry="a flash of light (especially reflected light)"/>
<rdf:Description rdf:about="&a;105517062"
	 b:glossaryEntry="the occurrence of a small flash or spark"/>
<rdf:Description rdf:about="&a;105517181"
	 b:glossaryEntry="a flash of intense heat (as released by an atomic explosion)"/>
<rdf:Description rdf:about="&a;105517298">
	<b:glossaryEntry>the flash of light that accompanies an electric discharge in the atmosphere (or something resembling such a flash); can scintillate for a second or more</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105517542">
	<b:glossaryEntry>bright flashes of light near the horizon without thunder (especially on hot evenings); usually attributed to distant lightning that is reflected by clouds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105517757">
	<b:glossaryEntry>lightning that appears as a broad sheet; due to reflections of more distant lightning and to diffusion by the clouds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105517934"
	 b:glossaryEntry="a sudden flash (as of lightning)"/>
<rdf:Description rdf:about="&a;105518019"
	 b:glossaryEntry="momentary contact"/>
<rdf:Description rdf:about="&a;105518102"
	 b:glossaryEntry="a light touch"/>
<rdf:Description rdf:about="&a;105518168"
	 b:glossaryEntry="increase in density"/>
<rdf:Description rdf:about="&a;105518283"
	 b:glossaryEntry='a sudden and decisive increase; "a jump in attendance"'/>
<rdf:Description rdf:about="&a;105518395">
	<b:glossaryEntry>a gradual increase in magnitude or extent; "the waxing of the moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105518515"
	 b:glossaryEntry="the occurrence of two or more things coming together"/>
<rdf:Description rdf:about="&a;105518643">
	<b:glossaryEntry>a casual or unexpected convergence; "he still remembers their meeting in Paris"; "there was a brief encounter in the hallway"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105518852">
	<b:glossaryEntry>(astronomy) apparent meeting or passing of two or more celestial bodies in the same degree of the zodiac</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105519062">
	<b:glossaryEntry>(astronomy) the alignment of the Earth and a planet on the same side of the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105519208">
	<b:glossaryEntry>(astronomy) the alignment of the Earth and a planet on the opposite side of the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105519358"
	 b:glossaryEntry="an event that results in a transformation"/>
<rdf:Description rdf:about="&a;105519482">
	<b:glossaryEntry>an event that occurs at a critical time; "at such junctures he always had an impulse to leave"; "it was needed only on special occasions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105519793">
	<b:glossaryEntry>a difficult juncture; "a pretty pass"; "matters came to a head yesterday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105519934">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the highest point of anything conceived of as growing or developing or unfolding: "the climax of the artist''s career"; "in the flood tide of his success"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105520153"
	 b:glossaryEntry="a critical combination of events or circumstances"/>
<rdf:Description rdf:about="&a;105520260">
	<b:glossaryEntry>a sudden unforeseen crisis (usually involving danger) that requires immediate action; "he never knew what to do in an emergency"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105520463">
	<b:glossaryEntry>a crucial stage or turning point in the course of something; "after the crisis the patient either dies or gets better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105520652">
	<b:glossaryEntry>an event marking a unique or important historical change or one on which important developments depend</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105520861">
	<b:glossaryEntry>(Old Testament) in Judeo-Christian mythology--when Adam and Eve ate of the fruit of the tree of knowledge of good and evil in the Garden of Eden God punished them by driving them out of the Garden and into the world where they would be subject to sickness and pain and eventual death</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105521202">
	<b:glossaryEntry>a sudden turning point in a person''s life (similar to the sudden conversion of the Apostle Paul on the road from Jerusalem to Damascus of arrest Christians)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105521421"
	 b:glossaryEntry="a significant event in your life (or in a project)"/>
<rdf:Description rdf:about="&a;105521527"
	 b:glossaryEntry="an increase in the density of something"/>
<rdf:Description rdf:about="&a;105521666">
	<b:glossaryEntry>a decrease in the density of something; "a sound wave causes periodic rarefactions in its medium"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105521821">
	<b:glossaryEntry>an occurrence of improvement by virtue of preventing loss or injury or other change</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105521978">
	<b:glossaryEntry>return to an original state; "the recovery of the forest after the fire was surprisingly rapid"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105522128">
	<b:glossaryEntry>an abatement in the manifestations of a disease; "his cancer is in remission"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105522274"
	 b:glossaryEntry="a severe affliction"/>
<rdf:Description rdf:about="&a;105522355"
	 b:glossaryEntry='a severe trial; "he went through fire and damnation"'/>
<rdf:Description rdf:about="&a;105522458"
	 b:glossaryEntry="a damage or loss"/>
<rdf:Description rdf:about="&a;105522555"
	 b:glossaryEntry='a detriment or sacrifice; "at the expense of"'/>
<rdf:Description rdf:about="&a;105522654"
	 b:glossaryEntry="the occurrence of a change for the worse"/>
<rdf:Description rdf:about="&a;105522821">
	<b:glossaryEntry>(electronics) a sharp transient wave in the normal electrical state (or a series of such transients); "the pulsations seemed to be coming from a star"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105523055"
	 b:glossaryEntry='a cessation of normal operation; "there was a power failure"'/>
<rdf:Description rdf:about="&a;105523281"
	 b:glossaryEntry="electrical circuit is overloaded"/>
<rdf:Description rdf:about="&a;105523381"
	 b:glossaryEntry="brakes fail to stop a vehicle"/>
<rdf:Description rdf:about="&a;105523470"
	 b:glossaryEntry="engine does not run"/>
<rdf:Description rdf:about="&a;105523550"
	 b:glossaryEntry="supply of power fails"/>
<rdf:Description rdf:about="&a;105523649"
	 b:glossaryEntry="the failure of electric power for a general region"/>
<rdf:Description rdf:about="&a;105523754">
	<b:glossaryEntry>a becoming gradually less; "there is no greater sadness that the dwindling away of a family"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105523937">
	<b:glossaryEntry>a gradual decrease in magnitude or extent; "the waning of his enthusiasm was obvious"; "the waxing and waning of the moon"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105524112"
	 b:glossaryEntry="gradually diminishing in brightness or loudness or strength"/>
<rdf:Description rdf:about="&a;105524229">
	<b:glossaryEntry>an unforeseen development; "events suddenly took an awkward turn"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105524370">
	<b:glossaryEntry>a recent event that has some relevance for the present situation; "recent developments in Iraq"; "what a revolting development!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105524610"
	 b:glossaryEntry="a remarkable development"/>
<rdf:Description rdf:about="&a;105524691">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a development that complicates a situation; "the court''s decision had many unforeseen ramifications"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105524865">
	<b:glossaryEntry>a drastic and far-reaching change in ways of thinking and behaving; "the industrial revolution was also a cultural revolution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105525066">
	<b:glossaryEntry>the introduction of pesticides and high-yield grains and better management which greatly increased agricultural productivity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105525253"
	 b:glossaryEntry="the process or event of mutating"/>
<rdf:Description rdf:about="&a;105525358"
	 b:glossaryEntry="a mutation due to an intramolecular reorganization of a gene"/>
<rdf:Description rdf:about="&a;105525495"
	 b:glossaryEntry="passing from a more complex to a simpler biological form"/>
<rdf:Description rdf:about="&a;105525662">
	<b:glossaryEntry>a loss of vitality and a degeneration of cells and tissues not due to any apparent injury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105525808">
	<b:glossaryEntry>(biology) degenerative reversion of cells or tissue to a less differentiated or more primitive form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105525964">
	<b:glossaryEntry>activity that is an intrusion or interruption; "he looked around for the source of the disturbance"; "there was a disturbance of neural function"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105526218">
	<b:glossaryEntry>a sudden disturbance of the earth''s magnetic field; caused by emission of particles from the sun</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105526375">
	<b:glossaryEntry>shaking and vibration at the surface of the earth resulting from underground movement along a fault plane of from volcanic activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105526643"
	 b:glossaryEntry="an instance of agitation of the earth''s crust"/>
<rdf:Description rdf:about="&a;105526762"
	 b:glossaryEntry="a small earthquake"/>
<rdf:Description rdf:about="&a;105526897">
	<b:glossaryEntry>a tremor (or one of a series of tremors) occurring after the main shock of an earthquake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105527042"
	 b:glossaryEntry="a tremor preceding an earthquake"/>
<rdf:Description rdf:about="&a;105527130"
	 b:glossaryEntry="an earthquake at the sea bed"/>
<rdf:Description rdf:about="&a;105527236">
	<b:glossaryEntry>any entry into an area not previously occupied; "an invasion of tourists"; "an invasion of locusts"; "a viral invasion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105527437"
	 b:glossaryEntry="a movement into or inward"/>
<rdf:Description rdf:about="&a;105527546">
	<b:glossaryEntry>electrical or acoustic activity that can disturb communication</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105527761">
	<b:glossaryEntry>a gradual temporary loss of a transmitted signal due to electrical disturbances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105527894">
	<b:glossaryEntry>extraneous signals that can be confused with the phenomenon to be observed or measured; "they got a bad connection and could hardly hear one another over the background signals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105528184">
	<b:glossaryEntry>extraneous noise contaminating sound measurements that cannot be separated from the desired signal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105528378">
	<b:glossaryEntry>noise produced by the friction of the stylus of a record player moving over the rotating record</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105528533">
	<b:glossaryEntry>radiation coming from sources other than those being observed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105528661">
	<b:glossaryEntry>the presence of an unwanted signal via an accidental coupling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105528783">
	<b:glossaryEntry>a crackling or hissing noise cause by electrical interference</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105528951"
	 b:glossaryEntry="static at radio wavelengths"/>
<rdf:Description rdf:about="&a;105529036"
	 b:glossaryEntry="an explosion fails to occur"/>
<rdf:Description rdf:about="&a;105529123"
	 b:glossaryEntry="the process of seeping"/>
<rdf:Description rdf:about="&a;105529233"
	 b:glossaryEntry="the process of exuding"/>
<rdf:Description rdf:about="&a;105529326">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the formation and falling of drops of liquid; "there''s a drip through the roof"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105529476">
	<b:glossaryEntry>a miniature whirlpool or whirlwind resulting when the current of a fluid doubles back on itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105529630">
	<b:glossaryEntry>a powerful circular current of water (usually the resulting of conflicting tides)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105529806">
	<b:glossaryEntry>(Greek mythology) a ship-devouring whirlpool lying on the other side of a narrow strait from Scylla</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105529961"
	 b:glossaryEntry="the removal of limbs; being cut to pieces"/>
<rdf:Description rdf:about="&a;105530077">
	<b:glossaryEntry>an injury that deprives you of a limb or other important body part</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105530228"
	 b:glossaryEntry="the occurrence of a flow of water (as from a pipe)"/>
<rdf:Description rdf:about="&a;105530333"
	 b:glossaryEntry="a change for the worse"/>
<rdf:Description rdf:about="&a;105530444"
	 b:glossaryEntry="a moral or mental distortion"/>
<rdf:Description rdf:about="&a;105530533"
	 b:glossaryEntry="a steep drop"/>
<rdf:Description rdf:about="&a;105530598"
	 b:glossaryEntry="making fertile as by applying fertilizer or manure"/>
<rdf:Description rdf:about="&a;105530751"
	 b:glossaryEntry="a layer of fertilizer or manure not plowed in"/>
<rdf:Description rdf:about="&a;105530855">
	<b:glossaryEntry>the emergence of seeds as seed pods burst open when they are ripe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105530978">
	<b:glossaryEntry>a sudden violent happening; "an outburst of heavy rain"; "a burst of lightning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105531167">
	<b:glossaryEntry>an outburst resembling the discharge of firearms or the release of bombs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105531291">
	<b:glossaryEntry>a sudden violent spontaneous occurrence of an undesirable condition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105531449">
	<b:glossaryEntry>a widespread outbreak of an infectious disease; many people are infected at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105531611">
	<b:glossaryEntry>an epidemic that is geographically widespread; occurring throughout a region or even throughout the world</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105531771">
	<b:glossaryEntry>a return of something after a period of abatement; "a recrudescence of racism"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105531909"
	 b:glossaryEntry="the occurrence of a sudden discharge (as of liquid)"/>
<rdf:Description rdf:about="&a;105532053">
	<b:glossaryEntry>a sudden burst of activity; "come back after the rush"; "he joined the gold rush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105532185">
	<b:glossaryEntry>the sudden occurrence of a violent discharge of steam and volcanic material</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105532335">
	<b:glossaryEntry>the unwanted discharge of a fluid from some container; "they tried to stop the escape of gas from the damaged pipe"; "he had to clean up the leak"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105532561">
	<b:glossaryEntry>creation by the union of sperm or pollen with an animal or plant or egg cell</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105532832"
	 b:glossaryEntry="transfer of pollen from the anther to the stigma of a plant"/>
<rdf:Description rdf:about="&a;105532999">
	<b:glossaryEntry>fertilization by the union of male and female gametes from different individual of the same species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105533222"
	 b:glossaryEntry="cross-fertilization in plants"/>
<rdf:Description rdf:about="&a;105533324">
	<b:glossaryEntry>fertilization by the union of male and female gametes from the same individual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105533524">
	<b:glossaryEntry>fertilization of two or more ova released during the same menstrual cycle by sperm from separate acts of coitus (especially by different males)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105533730">
	<b:glossaryEntry>fertilization of a second ovum after a pregnancy has begun; results in two fetuses of different ages in the uterus at the same time; "superfetation is normal in some animal species"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105533971"
	 b:glossaryEntry="sellf-fertilization in plants"/>
<rdf:Description rdf:about="&a;105534073">
	<b:glossaryEntry>fertilization by transfer of pollen from the anthers of one flower to the stigma of another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105534246">
	<b:glossaryEntry>fertilization by transfer of pollen from the anthers to the stigma of the same flower</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105534412"
	 b:glossaryEntry="the motion made by flapping up and down"/>
<rdf:Description rdf:about="&a;105534547">
	<b:glossaryEntry>a sudden rapid flow (as of water); "he heard the flush of a toilet"; "there was a little gush of blood"; "she attacked him with an outpouring of words"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105534788"
	 b:glossaryEntry="a sudden forceful flow"/>
<rdf:Description rdf:about="&a;105534905">
	<b:glossaryEntry>a forceful forward rush; "it was forgotten in the onrush of events"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105535025">
	<b:glossaryEntry>a swelling rush of anything; "he rose on the springtide of prosperity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105535152">
	<b:glossaryEntry>a complete turn; "the plane made three rotations before it crashed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105535341">
	<b:glossaryEntry>confused movement; "he was caught up in a whirl of work"; "a commotion of people fought for the exits"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105535507"
	 b:glossaryEntry="a swift whirling motion (usually of a missile)"/>
<rdf:Description rdf:about="&a;105535658">
	<b:glossaryEntry>spin (usually of a moving ball) that retards or reverses the forward motion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105535788">
	<b:glossaryEntry>(sports) the spin given to a ball by striking it on one side or releasing it with a sharp twist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105535944">
	<b:glossaryEntry>forward spin (usually of a moving ball) that is imparted by an upward stroke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105536074">
	<b:glossaryEntry>an indolent or clumsy rolling about: "a good wallow in the water"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105536192">
	<b:glossaryEntry>a row of unravelled stitches; "she got a run in her stocking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105536320">
	<b:glossaryEntry>an occurrence of control or strength weakening; "the relaxation of requirements": "the loosening of his grip"; "the slackening of the wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105536541"
	 b:glossaryEntry="an event in which one thing is substituted for another"/>
<rdf:Description rdf:about="&a;105536707">
	<b:glossaryEntry>recurring fluctuations in economic activity consisting of recession and recovery and growth and decline</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105536885"
	 b:glossaryEntry="fluctuations that occur between one day and the next"/>
<rdf:Description rdf:about="&a;105536999"
	 b:glossaryEntry="fluctuations that occur during each day"/>
<rdf:Description rdf:about="&a;105537102">
	<b:glossaryEntry>something that may increase or decrease (like the tides of the sea); "a rising tide of popular interest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105537257"
	 b:glossaryEntry="an event in which something is displaced without rotation"/>
<rdf:Description rdf:about="&a;105537417"
	 b:glossaryEntry="(physics) the maximum displacement of a periodic wave"/>
<rdf:Description rdf:about="&a;105537526"
	 b:glossaryEntry="displacement or misalignment of a joint or organ"/>
<rdf:Description rdf:about="&a;105537647"
	 b:glossaryEntry="partial displacement of a joint or organ"/>
<rdf:Description rdf:about="&a;105537745">
	<b:glossaryEntry>a wild headlong rush of frightened animals (horses or cattle)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105537861"
	 b:glossaryEntry="a uniform movement without rotation"/>
<rdf:Description rdf:about="&a;105537972"
	 b:glossaryEntry="a jet of vapor"/>
<rdf:Description rdf:about="&a;105538038">
	<b:glossaryEntry>the sound of a bell rung in Roman Catholic churches to announce the time when the Angelus should be recited</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105538214"
	 b:glossaryEntry="the sound of someone playing a set of bells"/>
<rdf:Description rdf:about="&a;105538316">
	<b:glossaryEntry>the occurrence of a change in direction back in the opposite direction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105538453"
	 b:glossaryEntry="a rolling or revolving motion"/>
<rdf:Description rdf:about="&a;105538537">
	<b:glossaryEntry>a vaguely specified social event; "the party was quite an affair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105538738">
	<b:glossaryEntry>an occasion on which people can assemble for social interaction and entertainment; "he planned a party to celebrate Bastille Day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105539027"
	 b:glossaryEntry="an uproarious party"/>
<rdf:Description rdf:about="&a;105539110"
	 b:glossaryEntry="a party held on the anniversary of someone''s birth"/>
<rdf:Description rdf:about="&a;105539221"
	 b:glossaryEntry="an afternoon party at which cocktails are served"/>
<rdf:Description rdf:about="&a;105539330"
	 b:glossaryEntry="a party lasting over one or more nights at a large house"/>
<rdf:Description rdf:about="&a;105539444"
	 b:glossaryEntry="a party at which tea is served"/>
<rdf:Description rdf:about="&a;105539530"
	 b:glossaryEntry="(British) a progressive whist party"/>
<rdf:Description rdf:about="&a;105539623"
	 b:glossaryEntry="an occasion for special festivities to mark some happy event"/>
<rdf:Description rdf:about="&a;105539741">
	<b:glossaryEntry>a formal event performed on a special occasion; "a ceremony commemorating Pearl Harbor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105540129">
	<b:glossaryEntry>a ceremony at which a dead person is buried or cremated; "hundreds of people attended his funeral"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105540299"
	 b:glossaryEntry="the ritual placing of a corpse in a grave"/>
<rdf:Description rdf:about="&a;105540443">
	<b:glossaryEntry>the social event at which the ceremony of marriage is performed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105540590"
	 b:glossaryEntry="a rich and spectacular ceremony"/>
<rdf:Description rdf:about="&a;105540687">
	<b:glossaryEntry>a ceremony in which something (as a building) is dedicated to some goal or purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105540844">
	<b:glossaryEntry>a new dedication; "the rededication of the Temple of Jerusalem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105540966"
	 b:glossaryEntry="a ceremony accompanying the start of some enterprise"/>
<rdf:Description rdf:about="&a;105541072"
	 b:glossaryEntry="a ceremony to honor the memory of someone or something"/>
<rdf:Description rdf:about="&a;105541222"
	 b:glossaryEntry="a formal ceremony performed by military personnel"/>
<rdf:Description rdf:about="&a;105541335">
	<b:glossaryEntry>a formal entry into a position or office; "his initiation into the club"; "he was ordered to report for induction into the arm"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105541618"
	 b:glossaryEntry="the ceremony of installing a new monarch"/>
<rdf:Description rdf:about="&a;105541761">
	<b:glossaryEntry>(Judaism) an initiation ceremony marking the 13th birthday of a Jewish boy and signifying the beginning of religious responsibility; "a bar mitzvah is an important social event"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105541996">
	<b:glossaryEntry>(Judaism) an initiation ceremony marking the 12th birthday of a Jewish girl and signifying the beginning of religious responsibility</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105542215">
	<b:glossaryEntry>(usually plural) a ceremony that involves processions and speeches</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105542354">
	<b:glossaryEntry>the ceremony of walking barefoot over hot stones or a bed of embers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105542480"
	 b:glossaryEntry="an academic exercise in which diplomas are conferred"/>
<rdf:Description rdf:about="&a;105542693"
	 b:glossaryEntry="a requirement of etiquette or custom"/>
<rdf:Description rdf:about="&a;105542799">
	<b:glossaryEntry>an occasion on which a winner is selected from among two or more contestants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105543177"
	 b:glossaryEntry="a contest between athletes"/>
<rdf:Description rdf:about="&a;105543404"
	 b:glossaryEntry="an athletic contest consisting of ten different events"/>
<rdf:Description rdf:about="&a;105543514">
	<b:glossaryEntry>the modern revival of the ancient games held once every 4 years in a selected country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105543699">
	<b:glossaryEntry>an athletic contest modeled after the Olympic Games but intended for mentally or physically handicapped persons</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105543873"
	 b:glossaryEntry="an olympics for winter sports"/>
<rdf:Description rdf:about="&a;105543987"
	 b:glossaryEntry="a minor match preceding the main event"/>
<rdf:Description rdf:about="&a;105544092"
	 b:glossaryEntry="an athletic contest consisting of five different events"/>
<rdf:Description rdf:about="&a;105544204">
	<b:glossaryEntry>a foolhardy competition; a dangerous activity that is continued until one competitor becomes afraid and stops</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105544367"
	 b:glossaryEntry="a contest whose outcome is uncertain up to the very end"/>
<rdf:Description rdf:about="&a;105544480"
	 b:glossaryEntry='a contest of speed; "the race is to the swift"'/>
<rdf:Description rdf:about="&a;105544847"
	 b:glossaryEntry="a race between (usually high-performance) automobiles"/>
<rdf:Description rdf:about="&a;105545028"
	 b:glossaryEntry="one of several international races"/>
<rdf:Description rdf:about="&a;105545119"
	 b:glossaryEntry="an automobile race run over public roads"/>
<rdf:Description rdf:about="&a;105545211"
	 b:glossaryEntry="a race between people riding bicycles"/>
<rdf:Description rdf:about="&a;105545307"
	 b:glossaryEntry="a race between people rowing or driving boats"/>
<rdf:Description rdf:about="&a;105545426">
	<b:glossaryEntry>(British slang) a high-speed motorcycle race on a public road</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105545540"
	 b:glossaryEntry="a race between ancient chariots"/>
<rdf:Description rdf:about="&a;105545630">
	<b:glossaryEntry>a race between dogs; usually an occasion for betting on the outcome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105545754"
	 b:glossaryEntry="a race between crews of people in yachts"/>
<rdf:Description rdf:about="&a;105545866">
	<b:glossaryEntry>a race run on foot; "she broke the record for the half-mile run"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105546075"
	 b:glossaryEntry="a footrace of 26 miles 385 yards"/>
<rdf:Description rdf:about="&a;105546162">
	<b:glossaryEntry>a race (as in swimming) in which each contestant has a free choice of the style to use</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105546304"
	 b:glossaryEntry="a long race run over open country"/>
<rdf:Description rdf:about="&a;105546397">
	<b:glossaryEntry>an equestrian competition; the first day is dressage; the second is cross-country jumping; the third is stadium jumping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105546635">
	<b:glossaryEntry>a contest of speed between horses; usually held for the purpose of betting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105546910">
	<b:glossaryEntry>a horse race in which each owner declares before the race at what price his horse will be offered for sale fater the race</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547091">
	<b:glossaryEntry>a horse race in which the winning horse must be put up for auction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547216">
	<b:glossaryEntry>a horse race between people riding in sulkies behind horses that are trotting or pacing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547379">
	<b:glossaryEntry>an annual race for three-year-old horses; held at Churchill Downs in Louisville, Kentucky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547529">
	<b:glossaryEntry>an annual race for three-year-old horses; held at Pimlico in Baltimore, Maryland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547665">
	<b:glossaryEntry>an annual race for three-year-old horses; held on Long Island at Elmont, New York</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547807">
	<b:glossaryEntry>a horse race in which part of the prize is put up by the owners of the horses in the race</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105547953"
	 b:glossaryEntry="a horse race over an obstructed course"/>
<rdf:Description rdf:about="&a;105548068"
	 b:glossaryEntry="an annual steeplechase run in Liverpool, England"/>
<rdf:Description rdf:about="&a;105548177"
	 b:glossaryEntry="a race in which competitors must negotiate obstacles"/>
<rdf:Description rdf:about="&a;105548289">
	<b:glossaryEntry>a footrace of usually 3000 meters over a closed track with hurdles and a water jump</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105548431">
	<b:glossaryEntry>a novelty race in which competitors move potatoes from one place to another one at a time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105548578">
	<b:glossaryEntry>a novelty race in which competitors jump ahead with their feet confined in a sack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105548715">
	<b:glossaryEntry>a race in which all contestant start from scratch (on equal terms)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105548840"
	 b:glossaryEntry="a race between people wearing skis"/>
<rdf:Description rdf:about="&a;105548979"
	 b:glossaryEntry="a ski race down a trail"/>
<rdf:Description rdf:about="&a;105549057">
	<b:glossaryEntry>a downhill race over a winding course defined by upright poles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105549172">
	<b:glossaryEntry>a race between teams; each member runs or swims part of the distance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105549324">
	<b:glossaryEntry>(classical Greece) in which a torch is passed from one runner to the next</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105549454">
	<b:glossaryEntry>a sporting competition in which contestants play a series of games to decide the winner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105549662">
	<b:glossaryEntry>a tournament in which losers are eliminated in successive rounds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105549852">
	<b:glossaryEntry>a tournament in which both professionals and amateurs may play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105549965"
	 b:glossaryEntry="any final competition to determine a championship"/>
<rdf:Description rdf:about="&a;105550105">
	<b:glossaryEntry>the playoff for the baseball championship; "we watched the Wordl Series on TV"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105550251">
	<b:glossaryEntry>the final match between the winners of all previous matches in an elimination tournament</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105550428">
	<b:glossaryEntry>the final game of any cup competition; especially the annual final of the F.A.Cup soccer competition at Wembley</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105550595">
	<b:glossaryEntry>one of the two competitions in the next to the last round of an elimination tournament</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105550763">
	<b:glossaryEntry>one of the four competitions in an elimination tournament whose winners go on to play in the semifinals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105550944">
	<b:glossaryEntry>a tournament in which every contestant plays every other contestant</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105551069">
	<b:glossaryEntry>a contest between gun dogs to determine their proficiency in pointing and retrieving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105551211"
	 b:glossaryEntry="a meeting at which a number of athletic contests are held"/>
<rdf:Description rdf:about="&a;105551445">
	<b:glossaryEntry>a meet at which riders and horses display a range of skills and aptitudes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105551573">
	<b:glossaryEntry>(British) a regular occasion on which a number of horse races are held on the same track; "the Epsom race meeting was an important social event"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105551776"
	 b:glossaryEntry="a meeting for boat races"/>
<rdf:Description rdf:about="&a;105551854"
	 b:glossaryEntry="a swimming competition between two or more teams"/>
<rdf:Description rdf:about="&a;105552012"
	 b:glossaryEntry="a track and field competition between two or more teams"/>
<rdf:Description rdf:about="&a;105552181"
	 b:glossaryEntry="a footrace performed on a track (indoor or outdoor)"/>
<rdf:Description rdf:about="&a;105552363">
	<b:glossaryEntry>a footrace run at top speed; "he is preparing for the 100-yard dash"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105552482">
	<b:glossaryEntry>a footrace in which contestant must negotiate a series of hurdles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105552626">
	<b:glossaryEntry>a footrace extending one mile; "he holds the record in the mile"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105552741">
	<b:glossaryEntry>a competition that takes place on a field rather than on a running track</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553016">
	<b:glossaryEntry>a competition that involves jumping as high as possible over a horizontal high bar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553154">
	<b:glossaryEntry>a competition that involves jumping as far as possible from a running start</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553298">
	<b:glossaryEntry>a competition that involves jumping over a high crossbar with the aid of a long pole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553501">
	<b:glossaryEntry>an athletic competition in which a heavy metal ball is hurled as far as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553636">
	<b:glossaryEntry>an athletic competition in which a heavy metal ball that is attached to a flexible wire is hurled as far as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553820">
	<b:glossaryEntry>an athletic competition in which a disc-shaped object is thrown as far as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105553955">
	<b:glossaryEntry>an athletic competition in which a javelin is thrown as far as possible</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105554080"
	 b:glossaryEntry="an athletic competition that involves swimming"/>
<rdf:Description rdf:about="&a;105554206"
	 b:glossaryEntry="an athletic competition that involves diving into water"/>
<rdf:Description rdf:about="&a;105554348"
	 b:glossaryEntry="a contest in which two or more persons or teams compete"/>
<rdf:Description rdf:about="&a;105554635"
	 b:glossaryEntry="an international championship match"/>
<rdf:Description rdf:about="&a;105554755"
	 b:glossaryEntry="a match between wrestlers"/>
<rdf:Description rdf:about="&a;105554880"
	 b:glossaryEntry="when a wrestler''s shoulders are forced to the mat"/>
<rdf:Description rdf:about="&a;105555023">
	<b:glossaryEntry>(amateur wrestling) being brought to the mat from a standing position; "a takedown counts two points"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105555198"
	 b:glossaryEntry="a practice or exhibition boxing match"/>
<rdf:Description rdf:about="&a;105555296"
	 b:glossaryEntry="a match between boxers; usually held in a boxing ring"/>
<rdf:Description rdf:about="&a;105555444"
	 b:glossaryEntry="a boxing match between professional boxers for a cash prize"/>
<rdf:Description rdf:about="&a;105555560">
	<b:glossaryEntry>a match in a cockpit between two fighting cocks heeled with metal gaffs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105555687">
	<b:glossaryEntry>a contest in which teams pull of opposite ends of a rope; the team dragged across a central line loses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105555846"
	 b:glossaryEntry="a series of jousts between knights contesting for a prize"/>
<rdf:Description rdf:about="&a;105555979">
	<b:glossaryEntry>a combat between two mounted knights tilting against each other with blunted lances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105556140"
	 b:glossaryEntry='any competition; "the race for the presidency"'/>
<rdf:Description rdf:about="&a;105556273">
	<b:glossaryEntry>a competition between nations to have the most powerful armaments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105556394"
	 b:glossaryEntry="a race between candidates for elective office"/>
<rdf:Description rdf:about="&a;105556569"
	 b:glossaryEntry="a race for election to the governorship"/>
<rdf:Description rdf:about="&a;105556694"
	 b:glossaryEntry="a race for election to the senate"/>
<rdf:Description rdf:about="&a;105556803">
	<b:glossaryEntry>dissemination by word of mouth of derogatory charges against a candidate for public office</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105556959">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a successful ending of a struggle or contest; "the general always gets credit for his army''s victory"; "the agreement was a triumph for common sense"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105557334">
	<b:glossaryEntry>the successful ending of the American Revolution; "they maintained close relations with England even after independence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105557513">
	<b:glossaryEntry>an overwhelming electoral victory; "Roosevelt defeated Hoover in a landslide"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105557646"
	 b:glossaryEntry="a victory that is won by incurring terrible losses"/>
<rdf:Description rdf:about="&a;105557758"
	 b:glossaryEntry="winning all or all but one of the tricks in bridge"/>
<rdf:Description rdf:about="&a;105557922"
	 b:glossaryEntry="winning all of the tricks in a hand of bridge"/>
<rdf:Description rdf:about="&a;105558024"
	 b:glossaryEntry="winning all but one of the tricks in a hand of bridge"/>
<rdf:Description rdf:about="&a;105558148"
	 b:glossaryEntry="victory in a game of chess"/>
<rdf:Description rdf:about="&a;105558249"
	 b:glossaryEntry="an easy victory"/>
<rdf:Description rdf:about="&a;105558356"
	 b:glossaryEntry="a game won on the opponent''s service"/>
<rdf:Description rdf:about="&a;105558471"
	 b:glossaryEntry="an unsuccessful ending"/>
<rdf:Description rdf:about="&a;105558628">
	<b:glossaryEntry>an unfortunate happening that hinders of impedes; something that is thwarting or frustrating</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105558802"
	 b:glossaryEntry="a defeat in battle"/>
<rdf:Description rdf:about="&a;105558898"
	 b:glossaryEntry="a sound defeat"/>
<rdf:Description rdf:about="&a;105559036"
	 b:glossaryEntry="a final crushing defeat"/>
<rdf:Description rdf:about="&a;105559114">
	<b:glossaryEntry>a contest in which you are eliminated if you fail to spell a word correctly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105559279">
	<b:glossaryEntry>(sports) a preliminary competition to determine qualifications; "the trials for the semifinals began yesterday"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105559442"
	 b:glossaryEntry="a sudden happening that brings very good fortune"/>
<rdf:Description rdf:about="&a;105559582">
	<b:glossaryEntry>a sudden large decline of business or the prices of stocks (especially one that causes additional failures)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105559752">
	<b:glossaryEntry>the occurrence of a loss of the ability to perceive and respond</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105559901">
	<b:glossaryEntry>a spontaneous loss of consciousness caused by insufficient blood to the brain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105560048">
	<b:glossaryEntry>the lapse of mankind into sinfulness because of the sin of Adam and Eve; "women have been blamed ever since the Fall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105560216">
	<b:glossaryEntry>an irretrievable loss; "that was the shipwreck of their romance"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105560336">
	<b:glossaryEntry>(computer science) an event that causes a computer system to become inoperative; "the crash occurred during a thunderstorm and the system has been down ever since"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105560569">
	<b:glossaryEntry>(computer science) a crash of a read/write head in a hard disk drive (usually caused by contact of the head with the surface of the magnetic disk)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105560772"
	 b:glossaryEntry="the conscious subjective aspect of feeling or emotion"/>
<rdf:Description rdf:about="&a;105560878"
	 b:glossaryEntry="any strong feeling"/>
<rdf:Description rdf:about="&a;105561094">
	<b:glossaryEntry>a persistent illogical feeling of desire or aversion: "he has a thing about seafood"; "she has a thing about him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105561259">
	<b:glossaryEntry>a feeling of considerable warmth; "the glow of new love"; "a glow of regret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105561386"
	 b:glossaryEntry="deep feeling or emotion"/>
<rdf:Description rdf:about="&a;105561474"
	 b:glossaryEntry="strong feeling or emotion"/>
<rdf:Description rdf:about="&a;105561624">
	<b:glossaryEntry>foolish and usually extravagant passion or love or admiration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105561743"
	 b:glossaryEntry='extreme emotional intensity; "the wildness of his anger"'/>
<rdf:Description rdf:about="&a;105561864">
	<b:glossaryEntry>feelings of great warmth and intensity; "he spoke with great ardor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105562060">
	<b:glossaryEntry>excessive fervor to do something or accomplish some end; "he had an absolute zeal for litigation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105562208"
	 b:glossaryEntry="tender, romantic, or nostalgic feeling or emotion"/>
<rdf:Description rdf:about="&a;105562331"
	 b:glossaryEntry="extravagant or affected feeling or emotion"/>
<rdf:Description rdf:about="&a;105562452"
	 b:glossaryEntry="insincere pathos"/>
<rdf:Description rdf:about="&a;105562535">
	<b:glossaryEntry>(psychoanalysis) a combination of emotions and impulses that have been rejected from awareness but still influence a person''s behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105562777">
	<b:glossaryEntry>a complex of males; desire to possess the mother sexually and to exclude the father; said to be a source of personality disorders if unresolved</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105563000"
	 b:glossaryEntry="a complex of females; sexual attraction to the father"/>
<rdf:Description rdf:about="&a;105563115">
	<b:glossaryEntry>a sense of personal inferiority arising from conflict between the desire to be noticed and the fear of being humiliated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105563300"
	 b:glossaryEntry="mixed feelings or emotions"/>
<rdf:Description rdf:about="&a;105563416">
	<b:glossaryEntry>opposition between two simultaneous but incompatible feelings; "he was immobilized by conflict and indecision"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105563581"
	 b:glossaryEntry="an absence of emotion or enthusiasm"/>
<rdf:Description rdf:about="&a;105563705"
	 b:glossaryEntry="apathy demonstrated by an absence of emotional reactions"/>
<rdf:Description rdf:about="&a;105563906"
	 b:glossaryEntry="a feeling of lack of interest or energy"/>
<rdf:Description rdf:about="&a;105564026"
	 b:glossaryEntry="the feeling that accompanies an unsatisfied state"/>
<rdf:Description rdf:about="&a;105564290">
	<b:glossaryEntry>a cherished desire; "his ambition is to own his own business"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105564463">
	<b:glossaryEntry>the widespread aspiration of Americans to live better than their parents did</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105564600"
	 b:glossaryEntry="ambition to equal or excel"/>
<rdf:Description rdf:about="&a;105564682"
	 b:glossaryEntry="a desire for bloodshed"/>
<rdf:Description rdf:about="&a;105564760">
	<b:glossaryEntry>the desire to have or do something that you know you should avoid; "he felt the temptation and his will power weakened"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105564936"
	 b:glossaryEntry="an intense desire for some particular thing"/>
<rdf:Description rdf:about="&a;105565069">
	<b:glossaryEntry>a feeling of craving something; "an appetite for life"; "the object of life is to satisfy as many appetencies as possible"- Granville Hicks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105565323">
	<b:glossaryEntry>an appetite for food; "exercise gave him a good stomach for dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105565444"
	 b:glossaryEntry="a strong appetite for sweet food"/>
<rdf:Description rdf:about="&a;105565534"
	 b:glossaryEntry="an abnormally strong craving"/>
<rdf:Description rdf:about="&a;105565618">
	<b:glossaryEntry>a specific feeling of desire; "he got his wish"; "he was above all wishing and desire"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105565790"
	 b:glossaryEntry="a mere wish, unaccompanied by effort to obtain"/>
<rdf:Description rdf:about="&a;105565891"
	 b:glossaryEntry="prolonged unfulfilled desire or need"/>
<rdf:Description rdf:about="&a;105566100"
	 b:glossaryEntry="a yearning for something or to do something"/>
<rdf:Description rdf:about="&a;105566205"
	 b:glossaryEntry="a feeling of deep longing"/>
<rdf:Description rdf:about="&a;105566301"
	 b:glossaryEntry="an unrealistic yearning"/>
<rdf:Description rdf:about="&a;105566382"
	 b:glossaryEntry="a sadly pensive longing"/>
<rdf:Description rdf:about="&a;105566463"
	 b:glossaryEntry="longing for something past"/>
<rdf:Description rdf:about="&a;105566563"
	 b:glossaryEntry="a pining for a loved one"/>
<rdf:Description rdf:about="&a;105566646"
	 b:glossaryEntry="a longing to return home"/>
<rdf:Description rdf:about="&a;105566729">
	<b:glossaryEntry>all of the feelings resulting from the urge to gratify sexual impulses; "he wanted a better sex life"; "the film contained no sex or violence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105566935"
	 b:glossaryEntry="a desire for sexual intimacy"/>
<rdf:Description rdf:about="&a;105567241">
	<b:glossaryEntry>a deep feeling of sexual desire and attraction; "their love left them indifferent to their surroundings"; "she was his first love"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105567422"
	 b:glossaryEntry="a desire for heterosexual intimacy"/>
<rdf:Description rdf:about="&a;105567531"
	 b:glossaryEntry="decline or absence of sexual desire"/>
<rdf:Description rdf:about="&a;105567643"
	 b:glossaryEntry="a feeling of strong sexual desire"/>
<rdf:Description rdf:about="&a;105567730"
	 b:glossaryEntry="desire for sensual pleasures"/>
<rdf:Description rdf:about="&a;105567842"
	 b:glossaryEntry="the arousal of feelings of sexual desire"/>
<rdf:Description rdf:about="&a;105568005"
	 b:glossaryEntry="(psychoanalysis) a Freudian term for sexual urge or desire"/>
<rdf:Description rdf:about="&a;105568116"
	 b:glossaryEntry="a strong sexual desire"/>
<rdf:Description rdf:about="&a;105568219"
	 b:glossaryEntry="abnormally intense sexual desire in women"/>
<rdf:Description rdf:about="&a;105568318"
	 b:glossaryEntry="abnormally intense sexual desire in men"/>
<rdf:Description rdf:about="&a;105568414"
	 b:glossaryEntry="feeling morbid sexual desire"/>
<rdf:Description rdf:about="&a;105568539"
	 b:glossaryEntry='a strong restless desire; "why this urge to travel?"'/>
<rdf:Description rdf:about="&a;105568649"
	 b:glossaryEntry='a sudden desire; "he bought it on impulse"'/>
<rdf:Description rdf:about="&a;105568771">
	<b:glossaryEntry>a fundamental feeling that is hard to define but that people desire to experience; "he was tingling with pleasure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105569060">
	<b:glossaryEntry>a feeling of extreme pleasure or satisfaction; "his delight to see her was obvious to all"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105569254">
	<b:glossaryEntry>a feeling of delight at being filled with wonder and enchantment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105569390"
	 b:glossaryEntry="a feeling of delight at being entertained"/>
<rdf:Description rdf:about="&a;105569487"
	 b:glossaryEntry="the pleasure felt when having a good time"/>
<rdf:Description rdf:about="&a;105569620"
	 b:glossaryEntry="a keen enjoyment of living"/>
<rdf:Description rdf:about="&a;105569706"
	 b:glossaryEntry="vigorous and enthusiastic enjoyment"/>
<rdf:Description rdf:about="&a;105569841">
	<b:glossaryEntry>the feeling caused by agreeable stimuli; one pole of a continuum of states of feeling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105570021">
	<b:glossaryEntry>the pleasure of remembering some pleasant event; "he basked in the afterglow of his victory"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105570169"
	 b:glossaryEntry="a feeling of freedom from worry or disappointment"/>
<rdf:Description rdf:about="&a;105570308">
	<b:glossaryEntry>the comfort you feel when consoled in times of disappointment; "second place was no consolation to him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105570509">
	<b:glossaryEntry>a consoling aspect of a difficult situation; "every cloud has a silver lining" or "look on the bright side of it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105570696">
	<b:glossaryEntry>the feeling that comes when something burdensome is removed or reduced; "as he heard the news he was suddenly flooded with relief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105570907"
	 b:glossaryEntry="pleasure derived from sexual activities"/>
<rdf:Description rdf:about="&a;105571062">
	<b:glossaryEntry>sexual pleasure obtained by inflicting harm (physical or psychological) on others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105571196">
	<b:glossaryEntry>sexual pleasure obtained both by inflicting pain or receiving pain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105571322">
	<b:glossaryEntry>sexual pleasure obtained from receiving punishment (physical or psychological)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105571456">
	<b:glossaryEntry>emotional distress; a fundamental feeling that people try to avoid; "the pain of loneliness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105571721">
	<b:glossaryEntry>the feeling caused by disagreeable stimuli; one pole of a continuum of states of feeling</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105571888">
	<b:glossaryEntry>sudden sharp painful emotion; "pangs of regret" or "twinges of conscience"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105572040"
	 b:glossaryEntry="pangs of feeling guilty"/>
<rdf:Description rdf:about="&a;105572120"
	 b:glossaryEntry="sustained dull painful emotion"/>
<rdf:Description rdf:about="&a;105572211"
	 b:glossaryEntry="feelings of mental or physical pain"/>
<rdf:Description rdf:about="&a;105572363">
	<b:glossaryEntry>intense feelings of suffering; acute mental or physical pain; "an agony of doubt"; "the torments of the damned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105572546"
	 b:glossaryEntry='violent pangs of suffering; "death throes"'/>
<rdf:Description rdf:about="&a;105572641"
	 b:glossaryEntry="an uncomfortable feeling in some part of the body"/>
<rdf:Description rdf:about="&a;105572802"
	 b:glossaryEntry="soreness or irritation of the skin caused by friction"/>
<rdf:Description rdf:about="&a;105572909">
	<b:glossaryEntry>psychological suffering; "the death of his wife caused him great distress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105573093"
	 b:glossaryEntry="extreme mental distress"/>
<rdf:Description rdf:about="&a;105573190"
	 b:glossaryEntry="self-imposed distress"/>
<rdf:Description rdf:about="&a;105573285">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a feeling of pleasure and enjoyment; "I''ve always had a liking for reading"; "she developed a liking for gin"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105573609">
	<b:glossaryEntry>a predisposition to like something; "he had a fondness for whiskey"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105573752">
	<b:glossaryEntry>a feeling of great liking for something wonderful and unusual</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105573914">
	<b:glossaryEntry>a strong liking; "my own preference is for good literature"; "the Irish have a penchant for blarney"; "martinis are an acquired taste"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105574157">
	<b:glossaryEntry>a penchant for something even though it might not be good for you; "he has a weakness for chocolate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105574312"
	 b:glossaryEntry="abnormal attraction to filth"/>
<rdf:Description rdf:about="&a;105574397">
	<b:glossaryEntry>that toward which you are inclined to feel a liking; "her inclination is for classical music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105574602">
	<b:glossaryEntry>an inclination to do something; "he felt leanings toward frivolity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105574747">
	<b:glossaryEntry>an inclination contrary to the strongest or prevailing feeling; "his account had a poignant undertow of regret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105574913">
	<b:glossaryEntry>a feeling of liking for another person; enjoyment in their company</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105575110"
	 b:glossaryEntry="a disinclination to quarrel"/>
<rdf:Description rdf:about="&a;105575210"
	 b:glossaryEntry="the friendly hope that something will succeed"/>
<rdf:Description rdf:about="&a;105575322"
	 b:glossaryEntry="the feeling that men should treat one another like brothers"/>
<rdf:Description rdf:about="&a;105575439">
	<b:glossaryEntry>a feeling of liking something or someone good; "although she fussed at them, she secretly viewed all her children with approval"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105575676"
	 b:glossaryEntry="a feeling of favorable regard"/>
<rdf:Description rdf:about="&a;105575766"
	 b:glossaryEntry="official approval"/>
<rdf:Description rdf:about="&a;105575841"
	 b:glossaryEntry="a feeling of delighted approval and liking"/>
<rdf:Description rdf:about="&a;105575985"
	 b:glossaryEntry="exaggerated admiration for England and English customs"/>
<rdf:Description rdf:about="&a;105576115"
	 b:glossaryEntry="a feeling of profound love and admiration"/>
<rdf:Description rdf:about="&a;105576222"
	 b:glossaryEntry="admiration for great men (or their memory)"/>
<rdf:Description rdf:about="&a;105576323">
	<b:glossaryEntry>a feeling of aversion or antipathy; "my dislike of him was instinctive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105576628">
	<b:glossaryEntry>that toward which you are inclined to feel dislike; "his disinclination for modesty is well known"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105576805"
	 b:glossaryEntry="exaggerated dislike of England and English customs"/>
<rdf:Description rdf:about="&a;105576931"
	 b:glossaryEntry="dislike experienced as an absence of friendliness"/>
<rdf:Description rdf:about="&a;105577059"
	 b:glossaryEntry="the feeling of being alienated from other people"/>
<rdf:Description rdf:about="&a;105577212"
	 b:glossaryEntry="a feeling of being disliked and alone"/>
<rdf:Description rdf:about="&a;105577305"
	 b:glossaryEntry="a feeling of intense dislike"/>
<rdf:Description rdf:about="&a;105577411"
	 b:glossaryEntry="a feeling of disliking something or what someone is doing"/>
<rdf:Description rdf:about="&a;105577544"
	 b:glossaryEntry="lack of respect accompanied by a feeling of intense dislike"/>
<rdf:Description rdf:about="&a;105577676"
	 b:glossaryEntry="strong feelings of dislike"/>
<rdf:Description rdf:about="&a;105577810"
	 b:glossaryEntry="hate coupled with disgust"/>
<rdf:Description rdf:about="&a;105577970"
	 b:glossaryEntry="intense aversion"/>
<rdf:Description rdf:about="&a;105578076"
	 b:glossaryEntry="disgust so strong it makes you feel sick"/>
<rdf:Description rdf:about="&a;105578169">
	<b:glossaryEntry>a feeling of thankfulness and appreciation; "he was overwhelmed with gratitude for their help"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105578355"
	 b:glossaryEntry="warm friendly feelings of gratitude"/>
<rdf:Description rdf:about="&a;105578483"
	 b:glossaryEntry="a lack of gratitude"/>
<rdf:Description rdf:about="&a;105578595">
	<b:glossaryEntry>a feeling of sympathy for someone or something; "She felt strong concern for those less fortunate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105578801">
	<b:glossaryEntry>a cause for feeling concern; "his major care was the illness of his wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105578925"
	 b:glossaryEntry="a feeling of excessive concern"/>
<rdf:Description rdf:about="&a;105579029">
	<b:glossaryEntry>a feeling of concern for the welfare of someone (especially someone defenseless)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105579184"
	 b:glossaryEntry="a feeling of lack of concern"/>
<rdf:Description rdf:about="&a;105579322"
	 b:glossaryEntry="unbiased impartial unconcern"/>
<rdf:Description rdf:about="&a;105579445"
	 b:glossaryEntry='indifference by personal withdrawal; "emotional distance"'/>
<rdf:Description rdf:about="&a;105579569"
	 b:glossaryEntry="avoiding emotional involvement"/>
<rdf:Description rdf:about="&a;105579669"
	 b:glossaryEntry="an absence of concern for the welfare of others"/>
<rdf:Description rdf:about="&a;105579830"
	 b:glossaryEntry="feelings of extreme heartlessness"/>
<rdf:Description rdf:about="&a;105579963">
	<b:glossaryEntry>a painful emotion resulting from an awareness of inadequacy or guilt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105580137">
	<b:glossaryEntry>a feeling of shame when you do something immoral; "he has no conscience about his cruelty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105580284">
	<b:glossaryEntry>shame resulting from strong dislike of yourself or your actions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105580420">
	<b:glossaryEntry>the shame you feel when your inadequacy or guilt is made public</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105580651">
	<b:glossaryEntry>embarrassment deriving from the feeling that others are critically aware of you</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105580828"
	 b:glossaryEntry="feeling embarrassed about yourself"/>
<rdf:Description rdf:about="&a;105580938"
	 b:glossaryEntry="strong feelings of embarrassment"/>
<rdf:Description rdf:about="&a;105581054"
	 b:glossaryEntry="a feeling of embarrassment that leaves you confused"/>
<rdf:Description rdf:about="&a;105581180"
	 b:glossaryEntry="feeling embarrassed due to modesty"/>
<rdf:Description rdf:about="&a;105581284"
	 b:glossaryEntry="anxious embarrassment"/>
<rdf:Description rdf:about="&a;105581430"
	 b:glossaryEntry="a feeling of self-respect and personal worth"/>
<rdf:Description rdf:about="&a;105581613"
	 b:glossaryEntry="a feeling of pride in yourself"/>
<rdf:Description rdf:about="&a;105581714"
	 b:glossaryEntry="an inflated feeling of pride in your superiority to others"/>
<rdf:Description rdf:about="&a;105581850"
	 b:glossaryEntry="feelings of excessive pride"/>
<rdf:Description rdf:about="&a;105581967">
	<b:glossaryEntry>a humble feeling; "he was filled with humility at the sight of the Pope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105582161"
	 b:glossaryEntry="the feeling of patient submissive humbleness"/>
<rdf:Description rdf:about="&a;105582260"
	 b:glossaryEntry="a feeling of being of little worth"/>
<rdf:Description rdf:about="&a;105582358">
	<b:glossaryEntry>the feeling that accompanies something extremely surprising; "he looked at me in astonishment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105582577"
	 b:glossaryEntry="the feeling aroused by something strange and surprising"/>
<rdf:Description rdf:about="&a;105582729">
	<b:glossaryEntry>an overwhelming feeling of wonder or admiration; "he stared over the edge with a feeling of awe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105582875">
	<b:glossaryEntry>the astonishment you feel when something totally unexpected happens to you</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105583004"
	 b:glossaryEntry="a feeling of stupefied astonishment"/>
<rdf:Description rdf:about="&a;105583116">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a sudden state of violent emotional disturbance; "the shock of his mother''s death"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105583266"
	 b:glossaryEntry="the feeling that something is about to happen"/>
<rdf:Description rdf:about="&a;105583387"
	 b:glossaryEntry="pleasurable expectation"/>
<rdf:Description rdf:about="&a;105583536">
	<b:glossaryEntry>excited anticipation of an approaching climax; "the play kept the audience in suspense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105583678"
	 b:glossaryEntry='intense nervous anticipation; "in a fever of resentment"'/>
<rdf:Description rdf:about="&a;105583804"
	 b:glossaryEntry="nervous excitement of an inexperienced hunter"/>
<rdf:Description rdf:about="&a;105583906">
	<b:glossaryEntry>a specific instance of feeling hopeful; "it revived their hope of winning the pennant"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105584043"
	 b:glossaryEntry="feeling an inappropriate lack of seriousness"/>
<rdf:Description rdf:about="&a;105584176"
	 b:glossaryEntry="a festive merry feeling"/>
<rdf:Description rdf:about="&a;105584266"
	 b:glossaryEntry="a solemn and dignified feeling"/>
<rdf:Description rdf:about="&a;105584398"
	 b:glossaryEntry="an earnest and sincere feeling"/>
<rdf:Description rdf:about="&a;105584512"
	 b:glossaryEntry="sensitivity to emotional feelings (of self and others)"/>
<rdf:Description rdf:about="&a;105584730"
	 b:glossaryEntry="sensitivity leading to easy irritation or upset"/>
<rdf:Description rdf:about="&a;105584841">
	<b:glossaryEntry>refined sensitivity to pleasurable or painful impressions; "cruelty offended his sensibility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105585046">
	<b:glossaryEntry>emotional or moral sensitivity (especially in relation to personal principles or dignity); "the remark hurt his feelings"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105585222"
	 b:glossaryEntry="a feeling of understanding"/>
<rdf:Description rdf:about="&a;105585334"
	 b:glossaryEntry="a sensuous feeling"/>
<rdf:Description rdf:about="&a;105585411">
	<b:glossaryEntry xml:space='preserve'><![CDATA[sensibility to trouble (as in the phrase "wring one''s withers"); "the lawsuit was wringing his withers"; "our withers are unwrung"--Shakespeare]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105585608"
	 b:glossaryEntry="the feeling of being agitated; not calm"/>
<rdf:Description rdf:about="&a;105585811"
	 b:glossaryEntry="a feeling of restless agitation"/>
<rdf:Description rdf:about="&a;105585895">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a feeling of agitation expressed in continual motion; "he''s got the fidgets"; "waiting gave him a feeling of restlessness"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105586117"
	 b:glossaryEntry="a restless desire for change and excitement"/>
<rdf:Description rdf:about="&a;105586217">
	<b:glossaryEntry>an extreme state of worry and agitation; "his stewing over the fight kept him awake most of the night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105586373"
	 b:glossaryEntry="emotional agitation and excitement"/>
<rdf:Description rdf:about="&a;105586494"
	 b:glossaryEntry="violent agitation"/>
<rdf:Description rdf:about="&a;105586574">
	<b:glossaryEntry>keen and shared excitement; "the stage crackled with electricity whenever she was on it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105586720">
	<b:glossaryEntry>a general feeling of excitement; "the announcement caused a sensation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105586846"
	 b:glossaryEntry="a feeling of calm; an absence of agitation or excitement"/>
<rdf:Description rdf:about="&a;105587029"
	 b:glossaryEntry="a feeling of calmness; a quiet and undisturbed feeling"/>
<rdf:Description rdf:about="&a;105587152">
	<b:glossaryEntry>calm and unruffled self-assurance; "he performed with all the coolness of a veteran"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105587339"
	 b:glossaryEntry="a state of peace and quiet"/>
<rdf:Description rdf:about="&a;105587497"
	 b:glossaryEntry="the absence of mental stress or anxiety"/>
<rdf:Description rdf:about="&a;105587663"
	 b:glossaryEntry="a state of refreshing tranquility"/>
<rdf:Description rdf:about="&a;105587782"
	 b:glossaryEntry="a relaxed comfortable feeling"/>
<rdf:Description rdf:about="&a;105587878">
	<b:glossaryEntry>a strong emotion; a feeling that is oriented toward some real or supposed grievance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105588172">
	<b:glossaryEntry>a feeling of intense indignation (now used only in the phrase "in high dudgeon")</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105588321"
	 b:glossaryEntry="intense anger (usually on an epic scale)"/>
<rdf:Description rdf:about="&a;105588413">
	<b:glossaryEntry>a feeling of intense anger; "hell hath no fury like a woman scorned"; "his face turned red with rage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105588618"
	 b:glossaryEntry="a state of fury so great the face becomes discolored"/>
<rdf:Description rdf:about="&a;105588725"
	 b:glossaryEntry="a feeling of intense anger"/>
<rdf:Description rdf:about="&a;105588822">
	<b:glossaryEntry>a feeling of anger caused by an offence; "give or take umbrage or offense"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105588960"
	 b:glossaryEntry="a feeling of righteous anger"/>
<rdf:Description rdf:about="&a;105589074"
	 b:glossaryEntry="a passing state of anger and resentment"/>
<rdf:Description rdf:about="&a;105589169">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a feeling of anger and animosity; "having one''s hackles or dander up"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105589301"
	 b:glossaryEntry="a persisting angry mood"/>
<rdf:Description rdf:about="&a;105589430"
	 b:glossaryEntry="anger produced by some annoying irritation"/>
<rdf:Description rdf:about="&a;105589637">
	<b:glossaryEntry>a sudden outburst of anger; "his temper sparked like damp firewood"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105589778">
	<b:glossaryEntry>a feeling of annoyance at being hindered or criticized; "her constant complaints were the main source of his frustration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105589957"
	 b:glossaryEntry="an exasperated feeling of annoyance"/>
<rdf:Description rdf:about="&a;105590065">
	<b:glossaryEntry>a feeling of intense annoyance caused by being tormented; "so great was his harassment that he wanted to destroy his tormentors"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105590260">
	<b:glossaryEntry>an emotion experienced in anticipation of some specific pain or danger (usually accompanied by a desire to flee or fight)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105590744"
	 b:glossaryEntry="fear resulting from the awareness of danger"/>
<rdf:Description rdf:about="&a;105590900">
	<b:glossaryEntry>(informal) a feeling of fear and revulsion; "he gives me the creeps"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105591021">
	<b:glossaryEntry>an almost pleasurable sensation of fright; "a frisson of surprise shot through him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105591212"
	 b:glossaryEntry="intense and profound fear"/>
<rdf:Description rdf:about="&a;105591290"
	 b:glossaryEntry="excessive or uncontrollable fear"/>
<rdf:Description rdf:about="&a;105591377"
	 b:glossaryEntry="an overwhelming feeling of fear and anxiety"/>
<rdf:Description rdf:about="&a;105591481"
	 b:glossaryEntry="a profound fear inspired by a deity"/>
<rdf:Description rdf:about="&a;105591591"
	 b:glossaryEntry="a sudden attack of fear"/>
<rdf:Description rdf:about="&a;105591681"
	 b:glossaryEntry="fear that affects a person about to face an audience"/>
<rdf:Description rdf:about="&a;105591792">
	<b:glossaryEntry>fearful expectation or anticipation: "the student looked around the examination room with apprehension"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105592071"
	 b:glossaryEntry="a feeling of alarm or dread"/>
<rdf:Description rdf:about="&a;105592156">
	<b:glossaryEntry>a feeling of evil to come: "a steadily escalating sense of foreboding"; "the lawyer had a presentiment that the judge would dismiss the case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105592428">
	<b:glossaryEntry>a premonition of something adverse; "a shadow over his happiness"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105592546"
	 b:glossaryEntry="a foreboding about what is about to happen"/>
<rdf:Description rdf:about="&a;105592642"
	 b:glossaryEntry="apprehension about what is going to happen"/>
<rdf:Description rdf:about="&a;105592739"
	 b:glossaryEntry="fear of the unknown or unfamiliar and of making decisions"/>
<rdf:Description rdf:about="&a;105592914"
	 b:glossaryEntry="a feeling of fear of embarrassment"/>
<rdf:Description rdf:about="&a;105593002"
	 b:glossaryEntry="lack of self-confidence"/>
<rdf:Description rdf:about="&a;105593183"
	 b:glossaryEntry="a feeling of diffidence about doing something"/>
<rdf:Description rdf:about="&a;105593296"
	 b:glossaryEntry="diffidence about self promotion"/>
<rdf:Description rdf:about="&a;105593389"
	 b:glossaryEntry="the feeling of being intimidated"/>
<rdf:Description rdf:about="&a;105593480">
	<b:glossaryEntry>a vague unpleasant emotion that is experienced in anticipation of some (usually ill-defined) misfortune</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105593817">
	<b:glossaryEntry>a strong feeling of anxiety; "his distress as the prospect of being fired"; "it is not work but worry that kills"; "he wanted to die and end his troubles"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105594044">
	<b:glossaryEntry>an anxious feeling; "care had aged him"; "they hushed it up out of fear of public reaction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105594203"
	 b:glossaryEntry="a feeling of mild anxiety about possible developments"/>
<rdf:Description rdf:about="&a;105594325">
	<b:glossaryEntry>the anxiety you experience when you feel vulnerable and insecure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105594446"
	 b:glossaryEntry="feelings of anxiety that make you tense and irritable"/>
<rdf:Description rdf:about="&a;105594594">
	<b:glossaryEntry>a feeling caused by uneasiness or apprehension; "with a sinking heart"; "a sinking feeling in the pit of my stomach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105594782"
	 b:glossaryEntry="uneasiness about the fitness of an action"/>
<rdf:Description rdf:about="&a;105594897"
	 b:glossaryEntry="the anxious feeling you have when you have the jitters"/>
<rdf:Description rdf:about="&a;105595049">
	<b:glossaryEntry>an acute but unspecific feeling of anxiety; usually reserved for philosophical anxiety about the world or about personal freedom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105595229"
	 b:glossaryEntry="feeling no fear"/>
<rdf:Description rdf:about="&a;105595349">
	<b:glossaryEntry>freedom from anxiety or fear; "the watch dog gave her a feeling of security"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105595498">
	<b:glossaryEntry>a feeling of trust (in someone or something); "I have confidence in our team"; "confidence is always borrowed, never owned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105595732"
	 b:glossaryEntry="emotions experienced when in a state of well-being"/>
<rdf:Description rdf:about="&a;105596018"
	 b:glossaryEntry="(French) happiness and good humor"/>
<rdf:Description rdf:about="&a;105596105"
	 b:glossaryEntry="experiencing joy and pleasure"/>
<rdf:Description rdf:about="&a;105596218"
	 b:glossaryEntry="the emotion of great happiness"/>
<rdf:Description rdf:about="&a;105596414"
	 b:glossaryEntry="a feeling of joy and pride"/>
<rdf:Description rdf:about="&a;105596527"
	 b:glossaryEntry="a feeling of extreme joy"/>
<rdf:Description rdf:about="&a;105596663"
	 b:glossaryEntry="the exultation of victory"/>
<rdf:Description rdf:about="&a;105596742">
	<b:glossaryEntry>the feeling of lively and cheerful joy; "he could hardly conceal his excitement when she agreed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105596946">
	<b:glossaryEntry>the release of a store of affective force; "they got a great bang out of it"; "what a rush!"; "he does it for kicks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105597153"
	 b:glossaryEntry="an aroused excitement (as from teasing)"/>
<rdf:Description rdf:about="&a;105597250"
	 b:glossaryEntry="a feeling of great (usually exaggerated) elation"/>
<rdf:Description rdf:about="&a;105597371"
	 b:glossaryEntry="a gay feeling"/>
<rdf:Description rdf:about="&a;105597503"
	 b:glossaryEntry="great merriment"/>
<rdf:Description rdf:about="&a;105597617"
	 b:glossaryEntry="a feeling of great happiness"/>
<rdf:Description rdf:about="&a;105597701"
	 b:glossaryEntry="a feeling facetious merriment"/>
<rdf:Description rdf:about="&a;105597799">
	<b:glossaryEntry>happiness felt in a secure relationship; "with his classmates he felt a sense of belonging"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105597982"
	 b:glossaryEntry="aa feeling of being at ease in a relationship"/>
<rdf:Description rdf:about="&a;105598089">
	<b:glossaryEntry>a feeling of being intimate and belonging together; "their closeness grew as the night wore on"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105598269"
	 b:glossaryEntry="affectionate closeness"/>
<rdf:Description rdf:about="&a;105598350">
	<b:glossaryEntry>a feeling of spontaneous good spirits; "his cheerfulness made everyone feel better"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105598559"
	 b:glossaryEntry="cheerfulness that bubbles to the surface"/>
<rdf:Description rdf:about="&a;105598666"
	 b:glossaryEntry="the cheerful feeling you have when nothing is troubling you"/>
<rdf:Description rdf:about="&a;105598833"
	 b:glossaryEntry="happiness with one''s situation in life"/>
<rdf:Description rdf:about="&a;105598965">
	<b:glossaryEntry>the contentment you feel when you have done something right; "the chef tasted the sauce with great satisfaction"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105599226">
	<b:glossaryEntry xml:space='preserve'><![CDATA[satisfaction with your (or another''s) achievements; "he takes pride in his son''s success"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105599367">
	<b:glossaryEntry>the feeling you have when you are satisfied with yourself; "his complacency was absolutely disgusting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105599598"
	 b:glossaryEntry="an excessive feeling of self-satisfaction"/>
<rdf:Description rdf:about="&a;105599694"
	 b:glossaryEntry="a feeling of satisfaction at having achieved your desires"/>
<rdf:Description rdf:about="&a;105599822"
	 b:glossaryEntry="malicious satisfaction"/>
<rdf:Description rdf:about="&a;105599930"
	 b:glossaryEntry="emotions experienced when not in a state of well-being"/>
<rdf:Description rdf:about="&a;105600250"
	 b:glossaryEntry="sadness caused by grief or affliction"/>
<rdf:Description rdf:about="&a;105600345"
	 b:glossaryEntry="a feeling of thoughtful sadness"/>
<rdf:Description rdf:about="&a;105600505"
	 b:glossaryEntry="a feeling of melancholy apprehension"/>
<rdf:Description rdf:about="&a;105600637"
	 b:glossaryEntry="a feeling of dispirited melancholy"/>
<rdf:Description rdf:about="&a;105600734"
	 b:glossaryEntry="persistent morbid meditation on a problem"/>
<rdf:Description rdf:about="&a;105600844"
	 b:glossaryEntry="sadness on thinking about the evils of the world"/>
<rdf:Description rdf:about="&a;105600968"
	 b:glossaryEntry="intense mournfulness"/>
<rdf:Description rdf:about="&a;105601051">
	<b:glossaryEntry>a feeling of intense unhappiness; "she was exhausted by her misery and grief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105601181"
	 b:glossaryEntry="sadness resulting from being forsaken or abandoned"/>
<rdf:Description rdf:about="&a;105601315"
	 b:glossaryEntry="sadness expressed by weeping"/>
<rdf:Description rdf:about="&a;105601413">
	<b:glossaryEntry>an emotion of great sadness associated with loss or bereavement; "he tried to express his sorrow at her loss"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105601647"
	 b:glossaryEntry="sorrow for sin arising from fear of damnation"/>
<rdf:Description rdf:about="&a;105601776">
	<b:glossaryEntry>intense sorrow caused by loss of a loved one (especially by death)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105601957"
	 b:glossaryEntry="a state of gloomy sorrow"/>
<rdf:Description rdf:about="&a;105602106"
	 b:glossaryEntry="expressing sorrowfulness"/>
<rdf:Description rdf:about="&a;105602190"
	 b:glossaryEntry="painful grief; a poetic term"/>
<rdf:Description rdf:about="&a;105602279">
	<b:glossaryEntry>sadness associated with some wrong done or some disappointment; "he drank to drown his sorrows"; "he wrote a note expressing his regret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105602526"
	 b:glossaryEntry="a feeling of deep regret (usually for some misdeed)"/>
<rdf:Description rdf:about="&a;105602697"
	 b:glossaryEntry="remorse cause by feeling responsible for some offence"/>
<rdf:Description rdf:about="&a;105602852"
	 b:glossaryEntry="remorse for your past conduct"/>
<rdf:Description rdf:about="&a;105602960"
	 b:glossaryEntry="a feeling of dreary or pessimistic sadness"/>
<rdf:Description rdf:about="&a;105603115"
	 b:glossaryEntry="a sudden numbing dread"/>
<rdf:Description rdf:about="&a;105603196"
	 b:glossaryEntry="a feeling of dismal cheerlessness"/>
<rdf:Description rdf:about="&a;105603287"
	 b:glossaryEntry="sad feelings of gloom and inadequacy"/>
<rdf:Description rdf:about="&a;105603470"
	 b:glossaryEntry="a feeling of lowness of spirits"/>
<rdf:Description rdf:about="&a;105603599"
	 b:glossaryEntry="depression resulting from an undermining of your morale"/>
<rdf:Description rdf:about="&a;105603715"
	 b:glossaryEntry="a feeling of being unable to manage"/>
<rdf:Description rdf:about="&a;105603809">
	<b:glossaryEntry>a feeling of sorrow (often self-indulgent) over your own sufferings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105603932"
	 b:glossaryEntry="feeling downcast and disheartened and hopeless"/>
<rdf:Description rdf:about="&a;105604103"
	 b:glossaryEntry="a fit of despondency"/>
<rdf:Description rdf:about="&a;105604181"
	 b:glossaryEntry="a feeling of being oppressed"/>
<rdf:Description rdf:about="&a;105604301">
	<b:glossaryEntry>an oppressive feeling of heavy force; "bowed down by the weight of responsibility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105604436"
	 b:glossaryEntry="a longing for something better than the present situation"/>
<rdf:Description rdf:about="&a;105604658"
	 b:glossaryEntry="a feeling of sulky discontent"/>
<rdf:Description rdf:about="&a;105604748"
	 b:glossaryEntry="abnormal depression and discontent"/>
<rdf:Description rdf:about="&a;105604874">
	<b:glossaryEntry>the feeling of being displeased and discontent; "he was never slow to express his dissatistfaction with the service he received"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105605136"
	 b:glossaryEntry="the feeling of being bored by something tedious"/>
<rdf:Description rdf:about="&a;105605272">
	<b:glossaryEntry>(informal usage) a general feeling of boredom and dissatisfaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105605389">
	<b:glossaryEntry>the feeling of being displeased or annoyed or dissatisfied with someone or something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105605549">
	<b:glossaryEntry>a feeling of dissatisfaction that results when your expectations are not realized; "his hopes were so high he was doomed to disappointment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105605777">
	<b:glossaryEntry>the feeling that accompanies an experience of being thwarted in attaining your goals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105605928">
	<b:glossaryEntry>the general feeling that some desire will be fulfilled; "in spite of his troubles he never gave up hope"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105606155"
	 b:glossaryEntry="the feeling you have when you have hope"/>
<rdf:Description rdf:about="&a;105606270"
	 b:glossaryEntry="the feeling of being encouraged"/>
<rdf:Description rdf:about="&a;105606361"
	 b:glossaryEntry="the optimistic feeling that all is going to turn out well"/>
<rdf:Description rdf:about="&a;105606509"
	 b:glossaryEntry="feeling sanguine; optimistically cheerful and confident"/>
<rdf:Description rdf:about="&a;105606636">
	<b:glossaryEntry>the feeling that everything is wrong and nothing will turn out well</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105606847">
	<b:glossaryEntry>the despair you feel when you have abandoned hope of comfort or success</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105606995"
	 b:glossaryEntry="acceptance of despair"/>
<rdf:Description rdf:about="&a;105607104"
	 b:glossaryEntry="acceptance of the inevitability of defeat"/>
<rdf:Description rdf:about="&a;105607201"
	 b:glossaryEntry="the feeling of despair in the face of obstacles"/>
<rdf:Description rdf:about="&a;105607353">
	<b:glossaryEntry>the feeling of discouragement in the face of someone''s superior fame or wealth or status etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105607505"
	 b:glossaryEntry="the feeling that things will turn out badly"/>
<rdf:Description rdf:about="&a;105607640"
	 b:glossaryEntry="a cynical feeling of distrust"/>
<rdf:Description rdf:about="&a;105607724">
	<b:glossaryEntry>a strong positive emotion of regard and affection; "his love for his work"; "children need a lot of love"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105608042"
	 b:glossaryEntry="intense feeling of love"/>
<rdf:Description rdf:about="&a;105608126"
	 b:glossaryEntry="a feeling of sexual love"/>
<rdf:Description rdf:about="&a;105608223"
	 b:glossaryEntry="temporary love of an adolescent"/>
<rdf:Description rdf:about="&a;105608345">
	<b:glossaryEntry>feelings of ardent love; "their devotion to each other was beautiful"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105608483">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a positive feeling of liking; "he had trouble expressing the affection he felt"; "the child won everyone''s heart"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105608793"
	 b:glossaryEntry="a feeling of affection for a person or an institution"/>
<rdf:Description rdf:about="&a;105608917"
	 b:glossaryEntry="a feeling of protective affection"/>
<rdf:Description rdf:about="&a;105609011">
	<b:glossaryEntry>a feeling of friendship and esteem; "she mistook his manly regard for love"; "he inspires respect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105609172">
	<b:glossaryEntry>a sentimental affection; "she had a soft spot for her youngest son"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105609295"
	 b:glossaryEntry="disposition to do good"/>
<rdf:Description rdf:about="&a;105609411"
	 b:glossaryEntry="doing good; feeling beneficent"/>
<rdf:Description rdf:about="&a;105609517"
	 b:glossaryEntry="a loving feeling"/>
<rdf:Description rdf:about="&a;105609617"
	 b:glossaryEntry="a warmhearted feeling"/>
<rdf:Description rdf:about="&a;105609709"
	 b:glossaryEntry="feelings of allegiance"/>
<rdf:Description rdf:about="&a;105609785">
	<b:glossaryEntry>the emotion of hate; a feeling of dislike so strong that it demands action</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105610135"
	 b:glossaryEntry="hatred of mankind"/>
<rdf:Description rdf:about="&a;105610210"
	 b:glossaryEntry="hatred of marriage"/>
<rdf:Description rdf:about="&a;105610283"
	 b:glossaryEntry="hatred of women"/>
<rdf:Description rdf:about="&a;105610366"
	 b:glossaryEntry="hatred of reasoning"/>
<rdf:Description rdf:about="&a;105610440"
	 b:glossaryEntry="hatred of change or innovation"/>
<rdf:Description rdf:about="&a;105610544"
	 b:glossaryEntry="hatred of new ideas"/>
<rdf:Description rdf:about="&a;105610620"
	 b:glossaryEntry="hatred of children"/>
<rdf:Description rdf:about="&a;105610694"
	 b:glossaryEntry="a bloodthirsty hatred arousing murderous impulses"/>
<rdf:Description rdf:about="&a;105610803"
	 b:glossaryEntry="a feeling of scornful hatred"/>
<rdf:Description rdf:about="&a;105610898">
	<b:glossaryEntry>the feeling of a hostile person; "he could no longer contain his hostility"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105611157"
	 b:glossaryEntry="a feeling of ill will arousing active hostility"/>
<rdf:Description rdf:about="&a;105611281">
	<b:glossaryEntry>feelings of envy and resentment of one social or economic class for toward another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105611423"
	 b:glossaryEntry="an actively expressed feeling of dislike and hostility"/>
<rdf:Description rdf:about="&a;105611552"
	 b:glossaryEntry="a feeling of hostility that arouses thoughts of attack"/>
<rdf:Description rdf:about="&a;105611680"
	 b:glossaryEntry="hostile or warlike attitude or nature"/>
<rdf:Description rdf:about="&a;105611809">
	<b:glossaryEntry>hostile or belligerent mood: "the chief is on the warpath today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105611927"
	 b:glossaryEntry="a feeling of deep and bitter anger and ill-will"/>
<rdf:Description rdf:about="&a;105612142">
	<b:glossaryEntry>intense resentment; "his promotion caused much heartburning among his rivals"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105612278"
	 b:glossaryEntry="a feeling of sulky resentment"/>
<rdf:Description rdf:about="&a;105612377">
	<b:glossaryEntry>a resentment strong enough to justify retaliation; "holding a grudge"; "settling a score"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105612539">
	<b:glossaryEntry>a feeling of grudging admiration and desire to have something possessed by another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105612765"
	 b:glossaryEntry="an envious eagerness to possess something"/>
<rdf:Description rdf:about="&a;105612865"
	 b:glossaryEntry="a feeling of jealous envy (especially of a rival)"/>
<rdf:Description rdf:about="&a;105612990">
	<b:glossaryEntry>(psychoanalysis) a female''s envy of the male''s penis; said to explain femininity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105613127"
	 b:glossaryEntry="wishing evil to others"/>
<rdf:Description rdf:about="&a;105613291"
	 b:glossaryEntry="doing or causing evil"/>
<rdf:Description rdf:about="&a;105613388"
	 b:glossaryEntry="feeling a need to see other suffer"/>
<rdf:Description rdf:about="&a;105613522"
	 b:glossaryEntry="a malevolent desire for revenge"/>
<rdf:Description rdf:about="&a;105613629">
	<b:glossaryEntry>a characteristic (habitual or relatively temporary) state of feeling; "whether he praised or cursed me depended on his temper at the time"; "he was in a bad humor"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105613923">
	<b:glossaryEntry>a mood or display of sullen aloofness or withdrawal: "stayed home in a sulk"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105614062"
	 b:glossaryEntry="a cheerful and agreeable mood"/>
<rdf:Description rdf:about="&a;105614225"
	 b:glossaryEntry="feeling jolly and jovial and full of good humor"/>
<rdf:Description rdf:about="&a;105614356"
	 b:glossaryEntry="an angry and disagreeable mood"/>
<rdf:Description rdf:about="&a;105614509"
	 b:glossaryEntry="a sullen gloomy feeling"/>
<rdf:Description rdf:about="&a;105614606"
	 b:glossaryEntry="a gloomy ill-tempered feeling"/>
<rdf:Description rdf:about="&a;105614716"
	 b:glossaryEntry="a feeling of resentful anger"/>
<rdf:Description rdf:about="&a;105614842"
	 b:glossaryEntry="an irritable petulant feeling"/>
<rdf:Description rdf:about="&a;105615021"
	 b:glossaryEntry="feeling easily irritated"/>
<rdf:Description rdf:about="&a;105615127">
	<b:glossaryEntry>sharing the feelings of others (especially feelings of sorrow or anguish)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105615380"
	 b:glossaryEntry="sympathy arising from a kind heart"/>
<rdf:Description rdf:about="&a;105615476"
	 b:glossaryEntry="a deep awareness of and sympathy for another''s suffering"/>
<rdf:Description rdf:about="&a;105615645">
	<b:glossaryEntry>a feeling of sympathy and sorrow for the misfortunes of others; "the blind are too often objects of pity"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105615833"
	 b:glossaryEntry="warm compassionate feelings"/>
<rdf:Description rdf:about="&a;105615937"
	 b:glossaryEntry="the feeling that motivates compassion"/>
<rdf:Description rdf:about="&a;105616059"
	 b:glossaryEntry="compassionate feelings that support a willingness to forgive"/>
<rdf:Description rdf:about="&a;105616177"
	 b:glossaryEntry="a feeling of sympathetic understanding"/>
<rdf:Description rdf:about="&a;105616285"
	 b:glossaryEntry="understanding and entering into another''s feelings"/>
<rdf:Description rdf:about="&a;105616407">
	<b:glossaryEntry>the attribution to yourself of the characteristics of others; "his identification with his father shaped his entire life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105616611"
	 b:glossaryEntry="a feeling of excitement"/>
<rdf:Description rdf:about="&a;105616745"
	 b:glossaryEntry="a positive feeling of wanting to push ahead with something"/>
<rdf:Description rdf:about="&a;105616909">
	<b:glossaryEntry>a feeling of strong eagerness (usually in favor of a person or cause); "they were imbued with a revolutionary ardor"; "he felt a kind of religious zeal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105617136"
	 b:glossaryEntry="joyful enthusiasm"/>
<rdf:Description rdf:about="&a;105617228"
	 b:glossaryEntry="the art or science of food"/>
<rdf:Description rdf:about="&a;105617311"
	 b:glossaryEntry="any substance that can be used as food"/>
<rdf:Description rdf:about="&a;105617456"
	 b:glossaryEntry="food to be eaten with the fingers"/>
<rdf:Description rdf:about="&a;105617547"
	 b:glossaryEntry="a heavy filling and often starchy food"/>
<rdf:Description rdf:about="&a;105617638"
	 b:glossaryEntry="food that fulfills the requirements of Jewish dietary law"/>
<rdf:Description rdf:about="&a;105617748"
	 b:glossaryEntry="the food and drink that are regularly consumed"/>
<rdf:Description rdf:about="&a;105617971">
	<b:glossaryEntry>the usual food and drink consumed by an organism (person or animal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105618089"
	 b:glossaryEntry="a prescribed selection of foods"/>
<rdf:Description rdf:about="&a;105618405"
	 b:glossaryEntry="a regulated daily food allowance"/>
<rdf:Description rdf:about="&a;105618491"
	 b:glossaryEntry="a diet designed to avoid the foods that you are allergic to"/>
<rdf:Description rdf:about="&a;105618609">
	<b:glossaryEntry>a diet that contains adequate amounts of all the necessary nutrients required for healthy growth and activity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105618778">
	<b:glossaryEntry>a diet of foods that are not irritating; "he ate a bland diet because of his colitis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105618933">
	<b:glossaryEntry>a diet of fluids with minimal residues (fat-free broth or strained fruit juices or gelatin); cannot be used for more than one day postoperative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105619140"
	 b:glossaryEntry="a diet designed to help control the symptoms of diabetes"/>
<rdf:Description rdf:about="&a;105619256">
	<b:glossaryEntry>a diet of foods high in starch that increases carbohydrate reserves in muscles; "carbo loading is used by endurance athletes just before competing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105619486"
	 b:glossaryEntry="a reducing diet that enjoys temporary popularity"/>
<rdf:Description rdf:about="&a;105619589">
	<b:glossaryEntry>a diet high in plant and animal proteins; used to treat malnutrition or to increase muscle mass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105619748"
	 b:glossaryEntry="a diet designed to patients with vitamin deficiencies"/>
<rdf:Description rdf:about="&a;105619891">
	<b:glossaryEntry>a diet of foods that can be served in liquid or strained form (plus custards or puddings); prescribed after certain kinds of surgery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105620099"
	 b:glossaryEntry="a diet that is low on calories"/>
<rdf:Description rdf:about="&a;105620192">
	<b:glossaryEntry>a diet containing limited amounts of fat and stressing high-carbohydrate foods; used in treatment of some gallbladder conditions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105620379">
	<b:glossaryEntry>a diet that limits the intake of salt (sodium chloride); often used in treating hypertension or edema or certain other disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105620602"
	 b:glossaryEntry="a diet consisting chiefly of beans and whole grains"/>
<rdf:Description rdf:about="&a;105620716"
	 b:glossaryEntry="a diet designed to help you lose weight (especially fat)"/>
<rdf:Description rdf:about="&a;105620883">
	<b:glossaryEntry>a diet that does not require chewing; advised for those with intestinal disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105621048"
	 b:glossaryEntry="a diet excluding all meat and fish"/>
<rdf:Description rdf:about="&a;105621160"
	 b:glossaryEntry="the dishes making up a meal"/>
<rdf:Description rdf:about="&a;105621238"
	 b:glossaryEntry="informal terms for a meal"/>
<rdf:Description rdf:about="&a;105621336">
	<b:glossaryEntry>food or meals in general; "she sets a fine table"; "room and board"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105621463"
	 b:glossaryEntry="a meal eaten by service personnel"/>
<rdf:Description rdf:about="&a;105621547"
	 b:glossaryEntry='soft semiliquid food; "a mess of porridge"'/>
<rdf:Description rdf:about="&a;105621640">
	<b:glossaryEntry>the food allowance for one day (especially for service personnel); "the rations should be nutritionally balanced"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105621824"
	 b:glossaryEntry="rations issued for United States troops in the field"/>
<rdf:Description rdf:about="&a;105621971">
	<b:glossaryEntry>a small package of emergency rations; issued to United States troops in World War II</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105622110"
	 b:glossaryEntry="a canned field ration issued by the United States army"/>
<rdf:Description rdf:about="&a;105622219"
	 b:glossaryEntry="a substance that can be used or prepared for use as food"/>
<rdf:Description rdf:about="&a;105622976"
	 b:glossaryEntry="flour or meal or grain used in baking bread"/>
<rdf:Description rdf:about="&a;105623076">
	<b:glossaryEntry>a digestible substance used to give color to food; "food color made from vegetable dyes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105623291">
	<b:glossaryEntry>a concentrated form of a foodstuff; the bulk is reduced by removing water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105623476"
	 b:glossaryEntry="a concentrated form of tomatoes"/>
<rdf:Description rdf:about="&a;105623572">
	<b:glossaryEntry>coarsely ground foodstuff; especially seeds of various cereal grasses or pulse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105623791"
	 b:glossaryEntry="coarsely ground corn"/>
<rdf:Description rdf:about="&a;105623880">
	<b:glossaryEntry>fine meal made from cereal grain especially wheat; often used as a cooked cereal or in puddings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105624028"
	 b:glossaryEntry="meal made from ground matzos"/>
<rdf:Description rdf:about="&a;105624113"
	 b:glossaryEntry="meal used for making porridge e.g."/>
<rdf:Description rdf:about="&a;105624234"
	 b:glossaryEntry="meal made from dried peas"/>
<rdf:Description rdf:about="&a;105624315">
	<b:glossaryEntry>coarse food high in fiber but low in nutrients; its bulk stimulates peristalsis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105624467"
	 b:glossaryEntry="food prepared from the husks of cereal grains"/>
<rdf:Description rdf:about="&a;105624582">
	<b:glossaryEntry>fine powdery foodstuff obtained by grinding and sifting the meal of a cereal grain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105624827"
	 b:glossaryEntry="flour prepared from wheat"/>
<rdf:Description rdf:about="&a;105624928">
	<b:glossaryEntry>flour made by grinding the entire wheat berry including the bran; (`whole_meal_flour'' is British usage)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105625138"
	 b:glossaryEntry="meal made from soybeans"/>
<rdf:Description rdf:about="&a;105625286">
	<b:glossaryEntry>milled product of durum wheat (or other hard wheat) used in pasta</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105625406"
	 b:glossaryEntry="the dried and powdered blood of animals"/>
<rdf:Description rdf:about="&a;105625502">
	<b:glossaryEntry>a protein substance that remains when starch is removed from cereal grains; gives cohesiveness to dough</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105625694"
	 b:glossaryEntry="gluten prepared from corn"/>
<rdf:Description rdf:about="&a;105625777"
	 b:glossaryEntry="a feed consisting primarily of corn gluten"/>
<rdf:Description rdf:about="&a;105625882"
	 b:glossaryEntry="gluten prepared from wheat"/>
<rdf:Description rdf:about="&a;105625967"
	 b:glossaryEntry="a source of nourishment"/>
<rdf:Description rdf:about="&a;105626343">
	<b:glossaryEntry>the practice or manner of preparing food or the food so prepared</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105626532"
	 b:glossaryEntry="warmed leftovers"/>
<rdf:Description rdf:about="&a;105626604"
	 b:glossaryEntry="a particular style of cookery (as of a region)"/>
<rdf:Description rdf:about="&a;105626707"
	 b:glossaryEntry="a stock or supply of foods"/>
<rdf:Description rdf:about="&a;105626873"
	 b:glossaryEntry="food in a secure or hidden storage place"/>
<rdf:Description rdf:about="&a;105626970"
	 b:glossaryEntry="a supply of food especially for a household"/>
<rdf:Description rdf:about="&a;105627066">
	<b:glossaryEntry>food that is not preserved by canning or dehydration or freezing or smoking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105627212"
	 b:glossaryEntry="food preserved by freezing"/>
<rdf:Description rdf:about="&a;105627311"
	 b:glossaryEntry="food preserved by canning"/>
<rdf:Description rdf:about="&a;105627439"
	 b:glossaryEntry="food preserved by dehydration"/>
<rdf:Description rdf:about="&a;105627549"
	 b:glossaryEntry="the food served and eaten at one time"/>
<rdf:Description rdf:about="&a;105627993">
	<b:glossaryEntry>whatever happens to be available especially when offered to an unexpected guest or when brought by guests and shared by all: "having arrived unannounced we had to take potluck"; "a potluck supper"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105628243"
	 b:glossaryEntry="a light meal or repast"/>
<rdf:Description rdf:about="&a;105628321"
	 b:glossaryEntry="snacks and drinks served as a light meal"/>
<rdf:Description rdf:about="&a;105628419"
	 b:glossaryEntry="the first meal of the day (usually in the morning)"/>
<rdf:Description rdf:about="&a;105628542">
	<b:glossaryEntry>combination breakfast and lunch; usually served in late morning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105628658"
	 b:glossaryEntry="a midday meal"/>
<rdf:Description rdf:about="&a;105628754"
	 b:glossaryEntry="(British) substantial early evening meal including tea"/>
<rdf:Description rdf:about="&a;105628863">
	<b:glossaryEntry>(British) a light midafternoon meal of tea and sandwiches or cakes; "an Englishman would interrupt a war to have his afternoon tea"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105629070">
	<b:glossaryEntry>the main meal of the day served in the evening or at midday: "dinner will be at 8"; "on Sundays they had a large dinner when they returned from church"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105629292">
	<b:glossaryEntry>a light evening meal; served in early evening if dinner is at midday or served late in the evening at bedtime</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105629472"
	 b:glossaryEntry="a meal set out on a buffet at which guests help themselves"/>
<rdf:Description rdf:about="&a;105629601">
	<b:glossaryEntry>a meal that is prepared in advance and frozen; can be heated and served</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105629728"
	 b:glossaryEntry="any informal meal eaten outside or on an excursion"/>
<rdf:Description rdf:about="&a;105629849"
	 b:glossaryEntry="an informal meal cooked and eaten outdoors"/>
<rdf:Description rdf:about="&a;105630035">
	<b:glossaryEntry>a cookout in which food is cooked over an open fire; especially a whole animal carcass roasted on a spit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105630194">
	<b:glossaryEntry>a cookout at the seashore where clams and fish and other foods are cooked--usually on heated stones covered with seaweed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105630369"
	 b:glossaryEntry="a cookout where fried fish is the main course"/>
<rdf:Description rdf:about="&a;105630469"
	 b:glossaryEntry="a cookout where roasted frankfurters are the main course"/>
<rdf:Description rdf:about="&a;105630599"
	 b:glossaryEntry="a light informal meal"/>
<rdf:Description rdf:about="&a;105630734"
	 b:glossaryEntry="(British slang) a large satisfying meal"/>
<rdf:Description rdf:about="&a;105630827">
	<b:glossaryEntry>a snack taken during a break in the work day: "a ten-minute coffee break"; "the British have tea breaks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105631002">
	<b:glossaryEntry>a meal that is well prepared and greatly enjoyed: "a banquet for the graduating seniors"; "the Thanksgiving feast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105631178">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an individual portion of food or drink: "the helpings were all small"; "his portion was larger than hers"; "there''s enough for two servings each"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105631615">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a small amount eaten or drunk; "take a taste--you''ll like it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105631794">
	<b:glossaryEntry>a small amount of solid food; a mouthful; "all they had left was a bit of bread"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105631994"
	 b:glossaryEntry='a small amount of liquid food: "a sup of ale"'/>
<rdf:Description rdf:about="&a;105632099"
	 b:glossaryEntry="a wad of something chewable as tobacco"/>
<rdf:Description rdf:about="&a;105632221">
	<b:glossaryEntry>part of a meal served at one time; "she prepared a three course meal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105632416">
	<b:glossaryEntry>a particular item of prepared food; "she prepared a special dish for dinner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105635031"
	 b:glossaryEntry="the principal dish of a meal"/>
<rdf:Description rdf:about="&a;105635144"
	 b:glossaryEntry="the most important dish of a meal"/>
<rdf:Description rdf:about="&a;105635243">
	<b:glossaryEntry>a main course served on a plate: "a vegetable plate"; "the blue plate special"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105635373">
	<b:glossaryEntry>(Philippine) a dish of marinated vegetables and meat or fish; served with rice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105635503"
	 b:glossaryEntry="a dish subordinate to a main course"/>
<rdf:Description rdf:about="&a;105635613"
	 b:glossaryEntry="a dish or meal given prominence in e.g. a restaurant"/>
<rdf:Description rdf:about="&a;105635719"
	 b:glossaryEntry="food cooked and served in a casserole"/>
<rdf:Description rdf:about="&a;105635830"
	 b:glossaryEntry="chicken cooked and served in a casserole"/>
<rdf:Description rdf:about="&a;105635952">
	<b:glossaryEntry>chicken casserole prepared with tomatoes and mushrooms and herbs in the Italian style</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105636142">
	<b:glossaryEntry>a piece of meat roasted or for roasting and of a size for slicing into more than one portion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105636456"
	 b:glossaryEntry="a course of appetizers in an Italian meal"/>
<rdf:Description rdf:about="&a;105636553">
	<b:glossaryEntry>food or drink to stimulate the appetite (usually served before a meal)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105636769">
	<b:glossaryEntry>an appetizer consisting usually of a thin slice of bread or toast spread with caviar or cheese or other savory food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105636937"
	 b:glossaryEntry="an appetizer served as a first course at a meal"/>
<rdf:Description rdf:about="&a;105637093"
	 b:glossaryEntry="a mixture of sliced or diced fruits"/>
<rdf:Description rdf:about="&a;105637189"
	 b:glossaryEntry="a cocktail of cold cooked crabmeat and a sauce"/>
<rdf:Description rdf:about="&a;105637314"
	 b:glossaryEntry="a cocktail of cold cooked shrimp and a sauce"/>
<rdf:Description rdf:about="&a;105637439"
	 b:glossaryEntry="a dish served as an appetizer before the main meal"/>
<rdf:Description rdf:about="&a;105637585"
	 b:glossaryEntry="spicy or savory condiment"/>
<rdf:Description rdf:about="&a;105637753">
	<b:glossaryEntry>tasty mixture or liquid into which bite-sized foods are dipped</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105637919"
	 b:glossaryEntry="a dip made of cooked beans"/>
<rdf:Description rdf:about="&a;105638000"
	 b:glossaryEntry="a dip made of cheeses"/>
<rdf:Description rdf:about="&a;105638078"
	 b:glossaryEntry="a dip made of clams and soft cream cheese"/>
<rdf:Description rdf:about="&a;105638174">
	<b:glossaryEntry>liquid food especially of meat or fish or vegetable stock often containing pieces of solid food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105638770"
	 b:glossaryEntry="the soup that a restaurant is featuring on a given day"/>
<rdf:Description rdf:about="&a;105638883"
	 b:glossaryEntry="clear soup usually of beef or veal or chicken"/>
<rdf:Description rdf:about="&a;105639001"
	 b:glossaryEntry="a tomato-flavored consomme; often served chilled"/>
<rdf:Description rdf:about="&a;105639105"
	 b:glossaryEntry="a thick cream soup made from shellfish"/>
<rdf:Description rdf:about="&a;105639196"
	 b:glossaryEntry="a Russian soup usually containing beet juice as a foundation"/>
<rdf:Description rdf:about="&a;105639356"
	 b:glossaryEntry="a thin soup of meat or fish or vegetable stock"/>
<rdf:Description rdf:about="&a;105639490"
	 b:glossaryEntry="the liquid in which vegetables or meat have be cooked"/>
<rdf:Description rdf:about="&a;105639609"
	 b:glossaryEntry="used to feed infants"/>
<rdf:Description rdf:about="&a;105639688"
	 b:glossaryEntry="a clear seasoned broth"/>
<rdf:Description rdf:about="&a;105639765"
	 b:glossaryEntry="a stock made with beef"/>
<rdf:Description rdf:about="&a;105639857"
	 b:glossaryEntry="a stock made with chicken"/>
<rdf:Description rdf:about="&a;105639958">
	<b:glossaryEntry>liquid in which meat and vegetables are simmered; used as a basis for e.g. soups or sauces; "she made gravy with a base of beef stock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105640224"
	 b:glossaryEntry="a cube of dehydrated stock"/>
<rdf:Description rdf:about="&a;105640307"
	 b:glossaryEntry="soup made from chicken broth"/>
<rdf:Description rdf:about="&a;105640394"
	 b:glossaryEntry="soup made from chicken boiled with leeks"/>
<rdf:Description rdf:about="&a;105640508"
	 b:glossaryEntry="a soup or stew thickened with okra pods"/>
<rdf:Description rdf:about="&a;105640599"
	 b:glossaryEntry="soup cooked in a large pot"/>
<rdf:Description rdf:about="&a;105640679">
	<b:glossaryEntry>soup made from a calf''s head or other meat in imitation of green turtle soup</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105640818"
	 b:glossaryEntry="E Indian curry-flavored soup with a meat or chicken base"/>
<rdf:Description rdf:about="&a;105640933"
	 b:glossaryEntry="a soup made from the skinned tail of an ox"/>
<rdf:Description rdf:about="&a;105641052"
	 b:glossaryEntry="a thick soup made of dried peas (usually made into a puree)"/>
<rdf:Description rdf:about="&a;105641166">
	<b:glossaryEntry>a soup made with vegetables and tripe and seasoned with peppercorns; often contains dumplings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105641342"
	 b:glossaryEntry="soup made with a variety of vegetables"/>
<rdf:Description rdf:about="&a;105641471"
	 b:glossaryEntry="thick (often creamy) soup"/>
<rdf:Description rdf:about="&a;105641549"
	 b:glossaryEntry="a stew of vegetables and (sometimes) meat"/>
<rdf:Description rdf:about="&a;105641644"
	 b:glossaryEntry="soup usually made of the flesh of green turtles"/>
<rdf:Description rdf:about="&a;105641769"
	 b:glossaryEntry="made by stirring beaten eggs into a simmering broth"/>
<rdf:Description rdf:about="&a;105641879">
	<b:glossaryEntry>a thick soup or stew made with milk and bacon and onions and potatoes</b:glossaryEntry>
