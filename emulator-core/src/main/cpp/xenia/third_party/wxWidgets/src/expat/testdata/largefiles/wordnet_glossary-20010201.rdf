	 b:glossaryEntry="the vast grassy plains of northern Argentina"/>
<rdf:Description rdf:about="&a;106411256"
	 b:glossaryEntry="a picturesque region of Germany around the Rhine river"/>
<rdf:Description rdf:about="&a;106411397">
