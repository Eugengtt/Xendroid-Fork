	 b:glossaryEntry="Mediterranean herbs having small white or pink flowers"/>
<rdf:Description rdf:about="&a;108120996">
	<b:glossaryEntry>tall plant with small lance-shaped leaves and numerous tiny white or pink flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108121197"
	 b:glossaryEntry="low-growing Old World herbs with minute bright green leaves"/>
