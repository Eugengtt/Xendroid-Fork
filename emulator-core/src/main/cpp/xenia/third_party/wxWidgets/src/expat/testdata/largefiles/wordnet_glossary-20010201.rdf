</rdf:Description>
<rdf:Description rdf:about="&a;110593588">
	<b:glossaryEntry>a secretion of the pharyngeal glands of bees that is fed to very young larvae and to bees destined to be queens</b:glossaryEntry>
</rdf:Description>
