</rdf:Description>
<rdf:Description rdf:about="&a;110672655">
	<b:glossaryEntry>hydrocarbon gases, usually propane or butane, kept under pressure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110672822">
	<b:glossaryEntry>a mixture of hydrogen and carbon monoxide with small amounts of other gases; made by blowing steam over hot coke or coal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110673016">
	<b:glossaryEntry>an Indian gum from the dhawa tree; used as a substitute for gum arabic</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110673152">
	<b:glossaryEntry>strong wrapping paper made from pulp processed with a sulfur solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110673287">
	<b:glossaryEntry>a strong wrapping paper that resists penetration by blood or meat fluids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110673419"
	 b:glossaryEntry="attractive wrapping paper suitable for wrapping gifts"/>
<rdf:Description rdf:about="&a;110673528">
	<b:glossaryEntry>a brass that is rich in copper; used to make articles that were to be gilded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110673664"
	 b:glossaryEntry="(Australian) soil in the melon holes of Australia"/>
<rdf:Description rdf:about="&a;110673771"
	 b:glossaryEntry="magma of any composition that cooled very rapidly"/>
<rdf:Description rdf:about="&a;110673916"
	 b:glossaryEntry="colorless glass made of almost pure silica"/>
<rdf:Description rdf:about="&a;110674071"
	 b:glossaryEntry="a milky white translucent or opaque glass"/>
<rdf:Description rdf:about="&a;110674182">
	<b:glossaryEntry>clear homogeneous glass of known refractive index; used to make lenses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110674348"
	 b:glossaryEntry="optical glass of low dispersion and low refractive index"/>
<rdf:Description rdf:about="&a;110674478"
	 b:glossaryEntry="optical glass of high dispersion and high refractive index"/>
<rdf:Description rdf:about="&a;110674610">
	<b:glossaryEntry>a glass blown into a globe which is later flattened and spun to form a disk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110674743"
	 b:glossaryEntry="thought to derive from meteorites"/>
<rdf:Description rdf:about="&a;110674830">
	<b:glossaryEntry>a kind of natural glass produced when molten lava cools very rapidly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110675013">
	<b:glossaryEntry>acid or granitic glass; usually dark, but transparent in thin pieces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110675136"
	 b:glossaryEntry="dark acid granitic glass"/>
<rdf:Description rdf:about="&a;110675217"
	 b:glossaryEntry="a basic or basalt glass"/>
<rdf:Description rdf:about="&a;110675296"
	 b:glossaryEntry="a brittle transparent solid with irregular atomic structure"/>
<rdf:Description rdf:about="&a;110675698"
	 b:glossaryEntry="glass having a relatively low softening point"/>
<rdf:Description rdf:about="&a;110675800">
	<b:glossaryEntry>glass that diffuses light due to a rough surface produced by abrasion or etching</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110675939"
	 b:glossaryEntry="particulate glass made by grinding and used as an abrasive"/>
<rdf:Description rdf:about="&a;110676056"
	 b:glossaryEntry="glass containing lead oxide; has a high refractive index"/>
<rdf:Description rdf:about="&a;110676169">
	<b:glossaryEntry>glass made with plates of plastic or resin or other material between two sheets of glass to prevent shattering</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110676377">
	<b:glossaryEntry>a glass with the general formula Na2O.xSiO2, x=3 or 5; used as a cement or as a protective coating and to preserve eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110676588"
	 b:glossaryEntry="a glass that contains a layer of wire netting in it"/>
<rdf:Description rdf:about="&a;110676696">
	<b:glossaryEntry>a solid formed by the solidification of a chemical and having a highly regular atomic structure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110676917"
	 b:glossaryEntry="an amine containing the double bond linkage -C=C-N-"/>
<rdf:Description rdf:about="&a;110677022">
	<b:glossaryEntry>either one of a pair of compounds (crystals or molecules) that are mirror images on each other but are not identical</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110677210">
	<b:glossaryEntry>a monosaccharide sugar that has several forms; an important source of physiological energy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110677408"
	 b:glossaryEntry="an isomer of glucose that is found in honey and sweet fruits"/>
<rdf:Description rdf:about="&a;110677553"
	 b:glossaryEntry="glucose in the bloodstream"/>
<rdf:Description rdf:about="&a;110677653"
	 b:glossaryEntry="a salt or ester of glutamic acid"/>
<rdf:Description rdf:about="&a;110677741"
	 b:glossaryEntry="an enzyme involved in transamination"/>
<rdf:Description rdf:about="&a;110677892">
	<b:glossaryEntry>a sweet crystalline aldehyde formed by the breakdown of sugars</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110678035">
	<b:glossaryEntry>a syrupy acid obtained by oxidation of glycerol or glyceraldehyde</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110678160">
	<b:glossaryEntry>an ester of glycerol and fatty acids that occurs naturally as fats and fatty oils</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110678352">
	<b:glossaryEntry>naturally occurring in animal and vegetable tissues; an important energy source forming much of the fat stored by the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110678551"
	 b:glossaryEntry="a glyceryl ester obtained by saponification of fats and oils"/>
<rdf:Description rdf:about="&a;110678689">
	<b:glossaryEntry>a gelatinous preparation made from gelatin and glycerin and water; used as a base for ointments and suppositories</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110678869">
	<b:glossaryEntry>a mixture of glycerin and gelatin that is used in histology for mounting specimens</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110679012"
	 b:glossaryEntry="a medicine made by mixing a substance in glycerin"/>
<rdf:Description rdf:about="&a;110679129">
	<b:glossaryEntry>a medicated skin preparation made from glycerin and glycerinated gelatin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110679275">
	<b:glossaryEntry>a trivalent radical derived from glycerol by removing the three hydroxyl radicals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110679411">
	<b:glossaryEntry>a heavy yellow poisonous oily explosive liquid obtained by nitrating glycerol; used in making explosives and medically as a vasodilator</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110679740"
	 b:glossaryEntry="an ester of glycerol"/>
<rdf:Description rdf:about="&a;110680037"
	 b:glossaryEntry="a group of compounds derived from monosaccharides"/>
<rdf:Description rdf:about="&a;110680178"
	 b:glossaryEntry="a glycoside derived from glucose"/>
<rdf:Description rdf:about="&a;110680284">
	<b:glossaryEntry>any of various plant glucosides that form soapy lathers when mixed and agitated with water; used in detergents and foaming agents and emulsifiers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110680483">
	<b:glossaryEntry>a translucent crystalline compound found in sugar cane and sugar beets and unripe grapes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110680669"
	 b:glossaryEntry="a conjugated protein having a carbohydrate component"/>
<rdf:Description rdf:about="&a;110680798">
	<b:glossaryEntry>any of several plant glycoproteins that act like specific antibodies but are not antibodies in that they are not evoked by an antigenic stimulus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110680995"
	 b:glossaryEntry="a laminated metamorphic rock similar to granite"/>
<rdf:Description rdf:about="&a;110681095">
	<b:glossaryEntry>a red or brown oxide coating on iron or steel caused by the action of oxygen and moisture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110681254">
	<b:glossaryEntry>any substance (such as thiouracil) that induces the formation of a goiter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110681383"
	 b:glossaryEntry="aventurine spangled densely with fine gold-colored particles"/>
<rdf:Description rdf:about="&a;110681499"
	 b:glossaryEntry="a hard cream-colored wax obtained from a Javanese fig tree"/>
<rdf:Description rdf:about="&a;110681625"
	 b:glossaryEntry="grease derived from geese"/>
<rdf:Description rdf:about="&a;110681709"
	 b:glossaryEntry="paper that has lines to permit drawing graphs"/>
<rdf:Description rdf:about="&a;110681812"
	 b:glossaryEntry="plutonic igneous rock having visibly crystalline texture"/>
<rdf:Description rdf:about="&a;110681941">
	<b:glossaryEntry>if steel or iron cool very slowly the cementite may occur in globules instead of in layers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110682115">
	<b:glossaryEntry>a substance capable of reducing friction by making surfaces smooth or slippery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110682322">
	<b:glossaryEntry>a thick fatty oil (especially one used to lubricate machinery)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110682455">
	<b:glossaryEntry>a mixture used by Byzantine Greeks that was often shot at adversaries; catches fire when wetted</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110682625">
	<b:glossaryEntry>a gold alloy (at least 14 karat gold with silver or silver and cadmium) that has a green appearance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110682781"
	 b:glossaryEntry="a granitic rock composed of quartz and mica"/>
<rdf:Description rdf:about="&a;110682878">
	<b:glossaryEntry>the matrix of fine-grained crystalline material in which larger crystals are embedded</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110683039">
	<b:glossaryEntry>a kind of hard lead that is used for grids in storage batteries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110683159">
	<b:glossaryEntry>a thin mortar that can be poured and used to fill cracks in masonry or brickwork</b:glossaryEntry>
</rdf:Description>
