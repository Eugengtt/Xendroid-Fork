</rdf:Description>
<rdf:Description rdf:about="&a;108236983">
	<b:glossaryEntry>shrubby European wormwood naturalized in North America; sometimes used in brewing beer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108237169">
