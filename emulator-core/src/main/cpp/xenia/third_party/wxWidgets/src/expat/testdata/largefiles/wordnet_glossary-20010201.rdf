</rdf:Description>
<rdf:Description rdf:about="&a;101935550"
	 b:glossaryEntry="foot of a pig or sheep especially one used as food"/>
<rdf:Description rdf:about="&a;101935692"
	 b:glossaryEntry="a front foot of a quadruped"/>
<rdf:Description rdf:about="&a;101935793"
	 b:glossaryEntry="a rear foot of a quadruped"/>
<rdf:Description rdf:about="&a;101935893"
	 b:glossaryEntry="a clawed foot of an animal especially a quadruped"/>
<rdf:Description rdf:about="&a;101936067"
	 b:glossaryEntry="front paw; analogous to the human hand"/>
<rdf:Description rdf:about="&a;101936196">
	<b:glossaryEntry xml:space='preserve'><![CDATA[terminal part of the forelimb in certain vertebrates (e.g. apes or kangaroos): "the kangaroo''s forearms seem undeveloped but the powerful five-fingered hands are skilled at feinting and clouting"- Springfield (Mass.) Union]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101936469">
	<b:glossaryEntry>the foot or fleshy cushion-like underside of the toes of an animal</b:glossaryEntry>
</rdf:Description>
