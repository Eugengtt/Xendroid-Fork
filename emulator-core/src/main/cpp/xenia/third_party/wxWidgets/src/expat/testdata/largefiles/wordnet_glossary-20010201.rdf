</rdf:Description>
<rdf:Description rdf:about="&a;109252505"
	 b:glossaryEntry="chiefly tropical climbing ferns"/>
<rdf:Description rdf:about="&a;109252646"
	 b:glossaryEntry="any of several ferns of the genus Lygodium"/>
<rdf:Description rdf:about="&a;109252803">
	<b:glossaryEntry>delicate fern of the eastern United States having a twining stem and palmately-lobed sterile fronds and forked fertile fronds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109253024">
	<b:glossaryEntry>tropical fern widespread in Old World; naturalized in Jamaica and Florida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;109253227"
	 b:glossaryEntry="African terrestrial ferns"/>
<rdf:Description rdf:about="&a;109253358"
	 b:glossaryEntry="sweetly scented African fern with narrow bipinnate fronds"/>
