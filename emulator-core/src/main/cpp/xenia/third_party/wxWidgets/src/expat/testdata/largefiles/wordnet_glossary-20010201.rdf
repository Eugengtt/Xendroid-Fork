	<b:glossaryEntry>a white tasteless odorless crystalline product of protein metabolism; found in the blood and urine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110822466">
	<b:glossaryEntry>an amino acid essential for growth in children and nitrogen balance in adults</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110822596"
	 b:glossaryEntry="the seed of flax used as a source of oil"/>
<rdf:Description rdf:about="&a;110822701">
	<b:glossaryEntry>a drying oil extracted from flax seed and used in making such things as oil paints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110822894"
	 b:glossaryEntry="a yellow oil obtained from the seeds of the tung tree"/>
