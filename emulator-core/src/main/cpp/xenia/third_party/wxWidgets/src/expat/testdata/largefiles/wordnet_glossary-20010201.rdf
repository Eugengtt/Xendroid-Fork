	 b:glossaryEntry="a white waxy substance from oil of the sperm whale"/>
<rdf:Description rdf:about="&a;110830116"
	 b:glossaryEntry="wax from plants; especially from the trunks of certain palms"/>
<rdf:Description rdf:about="&a;110830236">
	<b:glossaryEntry>a hard wax separated from shellac by its insolubility in alcohol</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110830368">
	<b:glossaryEntry>a colorless toxic ptomaine with an unpleasant odor formed during the putrefaction of animal tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110830523"
	 b:glossaryEntry="a yellow sulfide used chiefly as a pigment"/>
