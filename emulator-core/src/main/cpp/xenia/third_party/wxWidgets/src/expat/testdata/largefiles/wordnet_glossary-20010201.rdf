	 b:glossaryEntry="a character set that includes letters"/>
<rdf:Description rdf:about="&a;104876833"
	 b:glossaryEntry="the alphabet evolved by the ancient Romans"/>
<rdf:Description rdf:about="&a;104876936"
	 b:glossaryEntry="a Semitic alphabet used since the 5th century BC"/>
<rdf:Description rdf:about="&a;104877521"
	 b:glossaryEntry="the alphabet used by ancient Greeks"/>
<rdf:Description rdf:about="&a;104878073">
	<b:glossaryEntry>an alphabet drived from the Greek alphabet and used for writing Slavic language</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104878227">
	<b:glossaryEntry>the alphabet of 28 characters derived from Aramaic and used for writing Arabic languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104878377">
	<b:glossaryEntry>a character set that includes letters and digits and punctuation marks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104878507">
	<b:glossaryEntry>an alphabet of characters intended to represent specific sounds of speech</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104878698">
	<b:glossaryEntry>a phonetic alphabet invented by Alexander Melville Bell in the 19th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104878834">
	<b:glossaryEntry>an alphabet used by the deaf; letters are represented by finger positions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104879006">
	<b:glossaryEntry>a document issued by a country to a citizen allowing that person to travel abroad and re-enter the home country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104879191"
	 b:glossaryEntry="a document granting an inventor sole rights to an invention"/>
<rdf:Description rdf:about="&a;104879303">
	<b:glossaryEntry>a document stating the aims and principles of a political party; "their candidate simply ignored the party platform"; "they won the election even though they offered no positive program"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104879614"
	 b:glossaryEntry="an endorsed policy in the platform of a political party"/>
<rdf:Description rdf:about="&a;104879740">
	<b:glossaryEntry>official papers which a ship is legally required to have; related to ownership, cargo, etc.</b:glossaryEntry>
</rdf:Description>
