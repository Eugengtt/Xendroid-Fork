	 b:glossaryEntry="a domestic hen ready to brood"/>
<rdf:Description rdf:about="&a;101310893"
	 b:glossaryEntry="young hen usually less than a year old"/>
<rdf:Description rdf:about="&a;101310984">
	<b:glossaryEntry>American breed of heavy-bodied brownish-red general-purpose chicken</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101311114">
	<b:glossaryEntry>American breed of chicken having barred gray plumage raised for meat and brown eggs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101311264"
	 b:glossaryEntry="English breed of large white-skinned chickens"/>
<rdf:Description rdf:about="&a;101311365"
	 b:glossaryEntry="turkeys and some extinct forms"/>
<rdf:Description rdf:about="&a;101311535"
	 b:glossaryEntry="type genus of the Meleagrididae: wild and domestic turkeys"/>
<rdf:Description rdf:about="&a;101311705">
	<b:glossaryEntry>large gallinaceous bird with fan-shaped tail; widely domesticated for food</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101311891"
	 b:glossaryEntry="male turkey"/>
<rdf:Description rdf:about="&a;101312008">
