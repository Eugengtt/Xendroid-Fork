<rdf:Description rdf:about="&a;109158630"
	 b:glossaryEntry="basil"/>
<rdf:Description rdf:about="&a;109158741">
	<b:glossaryEntry>any of several Old World tropical aromatic annual or perennial herbs of the genus Ocimum</b:glossaryEntry>
