<rdf:Description rdf:about="&a;101648794"
	 b:glossaryEntry="a variety of fruit bat"/>
<rdf:Description rdf:about="&a;101648883"
	 b:glossaryEntry="a variety of fruit bat"/>
<rdf:Description rdf:about="&a;101648972"
