	 b:glossaryEntry="sacred writings of Islam"/>
<rdf:Description rdf:about="&a;104856408"
	 b:glossaryEntry="sacred writings of Orthodox Judaism"/>
<rdf:Description rdf:about="&a;104856496"
	 b:glossaryEntry="any of the Hindu sacred writing"/>
<rdf:Description rdf:about="&a;104856660"
	 b:glossaryEntry="a Veda consisting of Hindu poems dating from before 2000 BC"/>
<rdf:Description rdf:about="&a;104856774"
	 b:glossaryEntry="a collection of mantras and tunes for use with the Rig-Veda"/>
<rdf:Description rdf:about="&a;104856889"
	 b:glossaryEntry="a collection of mantras and formulas"/>
<rdf:Description rdf:about="&a;104856984"
	 b:glossaryEntry="a collection of sacrificial formulas"/>
<rdf:Description rdf:about="&a;104857077">
	<b:glossaryEntry>Hindu sacred text instructing the Brahmins to perform the Vedic rituals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104857203">
	<b:glossaryEntry>later sacred texts of Hinduism dealing with broad philosophical questions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104857332">
	<b:glossaryEntry>(Hinduism or Buddhism) a sacred word or syllable repeated in prayer or meditation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104857466"
	 b:glossaryEntry="any sacred song used to praise the Deity"/>
<rdf:Description rdf:about="&a;104857558">
	<b:glossaryEntry>one of the 150 lyrical poems and prayers that comprise the Book of Psalms in the Old Testament; said to have been written by David</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104857759"
	 b:glossaryEntry="writing that presents the main points in a concise form"/>
<rdf:Description rdf:about="&a;104858064"
	 b:glossaryEntry="a summary that repeats the substance of a longer discussion"/>
<rdf:Description rdf:about="&a;104858219">
	<b:glossaryEntry>a concluding summary (as in presenting a case before a law court)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104858363"
	 b:glossaryEntry='a summary list; as in e.g. "a news roundup"'/>
<rdf:Description rdf:about="&a;104858460"
	 b:glossaryEntry="a concise but comprehensive summary of a larger work"/>
<rdf:Description rdf:about="&a;104858569"
	 b:glossaryEntry="a summary of the main points of an argument or theory"/>
<rdf:Description rdf:about="&a;104858761">
	<b:glossaryEntry>a summary of the subject or plot of a literary work or play or movie; "the editor added the argument to the poem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104858949"
	 b:glossaryEntry="a condensed written summary or abstract"/>
<rdf:Description rdf:about="&a;104859040"
	 b:glossaryEntry="short descriptive summary (of events)"/>
<rdf:Description rdf:about="&a;104859148"
	 b:glossaryEntry="a short synopsis"/>
<rdf:Description rdf:about="&a;104859217"
	 b:glossaryEntry="a summary of your academic and work history"/>
<rdf:Description rdf:about="&a;104859332"
	 b:glossaryEntry="an overall summary"/>
<rdf:Description rdf:about="&a;104859407"
	 b:glossaryEntry="a brief abstract (as of an article or book)"/>
<rdf:Description rdf:about="&a;104859504"
	 b:glossaryEntry="a shortened version of a written work"/>
<rdf:Description rdf:about="&a;104859637">
	<b:glossaryEntry>writing that provides information (especially information of an official nature)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104860144">
	<b:glossaryEntry>a document filed with a state by the founders of a corporation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104860297"
	 b:glossaryEntry="a document listing the alternatives that is used in voting"/>
<rdf:Description rdf:about="&a;104860426">
	<b:glossaryEntry>a document entitling a commissioned officer to hold a higher rank temporarily (but without higher pay)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104860581"
	 b:glossaryEntry="a document attesting to the truth of certain stated facts"/>
<rdf:Description rdf:about="&a;104860883">
	<b:glossaryEntry>a document incorporating an institution and specifying its rights; includes the articles of incorporation and the certificate of incorporation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104861153"
	 b:glossaryEntry="a document of or relating to commerce"/>
<rdf:Description rdf:about="&a;104861370">
	<b:glossaryEntry>a written document acknowledging an offense and signed by the guilty party</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104861501">
	<b:glossaryEntry>an equating verb (such as `be'' or `become'') that links the subject with the complement of a sentence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104861667">
	<b:glossaryEntry>a document granting exclusive right to publish and sell literary or musical or artistic work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104861862">
	<b:glossaryEntry>something (usually a supporting document) that is enclosed in an envelope with a covering letter</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104862026">
	<b:glossaryEntry>a printed document with spaces in which to write; "he filled out his tax form"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104862282"
	 b:glossaryEntry="a form to use when making an application"/>
<rdf:Description rdf:about="&a;104862385"
	 b:glossaryEntry="a form to use when filing a claim"/>
<rdf:Description rdf:about="&a;104862475"
	 b:glossaryEntry="a form to use when placing an order"/>
<rdf:Description rdf:about="&a;104862567">
	<b:glossaryEntry>a form containing a set of questions; submitted to people to gain statistical information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;104862716"
	 b:glossaryEntry="a form to use when paying your taxes"/>
<rdf:Description rdf:about="&a;104862807"
	 b:glossaryEntry="a form to use when sending a telegram"/>
<rdf:Description rdf:about="&a;104862905"
	 b:glossaryEntry="a ballot that is cast in absentia"/>
<rdf:Description rdf:about="&a;104863000">
	<b:glossaryEntry>state approval of the articles of incorporation of a corporation</b:glossaryEntry>
</rdf:Description>
