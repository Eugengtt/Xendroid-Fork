	<b:glossaryEntry>any of various shrubby plants of the genus Atriplex that thrive in dry alkaline soil</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108141529">
	<b:glossaryEntry>Asiatic plant resembling spinach often used as a potherb; naturalized in Europe and North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108141726">
	<b:glossaryEntry>handsome low saltbush of arid southwestern United States and Mexico having blue-green prickly-edged leaves often used for Christmas decoration</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108141950">
	<b:glossaryEntry>spiny shrub with silvery-scurfy foliage of alkaline plains of southwestern United States and Mexico</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108142159"
	 b:glossaryEntry="summer cypress"/>
<rdf:Description rdf:about="&a;108142303">
	<b:glossaryEntry>densely branched Eurasian plant; foliage turns purple-red in autumn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108142524"
	 b:glossaryEntry="beets"/>
<rdf:Description rdf:about="&a;108142630">
	<b:glossaryEntry>biennial Eurasian plant usually having a swollen edible root; widely cultivated as a food crop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108142896">
	<b:glossaryEntry>beet having a massively swollen red root; widely grown for human consumption</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108143087">
	<b:glossaryEntry>beet lacking swollen root; grown as a vegetable for its edible leaves and stalks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108143315">
	<b:glossaryEntry>beet with a large yellowish root; grown chiefly as cattle feed</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108143489">
	<b:glossaryEntry>form of the common beet having a sweet white root from which sugar is obtained</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108143624"
	 b:glossaryEntry="a caryophyllaceous genus of the family Chenopodiaceae"/>
<rdf:Description rdf:about="&a;108143789">
	<b:glossaryEntry>bushy annual weed of central North America having greenish flowers and winged seeds</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108143993"
	 b:glossaryEntry="a caryophyllaceous genus of the family Chenopodiaceae"/>
<rdf:Description rdf:about="&a;108144165">
	<b:glossaryEntry>a coarse annual herb introduced into North America from Siberia; dangerous to sheep and cattle on western rangelands because of its high oxalate content</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108144415"
	 b:glossaryEntry="Algerian plant formerly burned to obtain calcium carbonate"/>
<rdf:Description rdf:about="&a;108144564"
	 b:glossaryEntry="glassworts"/>
<rdf:Description rdf:about="&a;108144688">
	<b:glossaryEntry>fleshy maritime plant having fleshy stems with rudimentary scalelike leaves and small spikes of minute flowers; formerly used in making glass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108144937"
	 b:glossaryEntry="chiefly Old World herbs or shrubs: saltworts"/>
<rdf:Description rdf:about="&a;108145070">
	<b:glossaryEntry>bushy plant of Old World salt marshes and sea beaches having prickly leaves; burned to produce a crude soda ash</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108145306">
