<rdf:Description rdf:about="&a;200278110">
	<b:glossaryEntry>make more complex, intricate, or richer; "refine a design or pattern"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200278339"
	 b:glossaryEntry='make complex; "he unnecessarily complexified every problem"'/>
<rdf:Description rdf:about="&a;200278474">
	<b:glossaryEntry>make complex or intricate or complicated; "The situation was rather involved"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200278624">
	<b:glossaryEntry>make more precise or increase the discriminatory powers of; "refine a method of analysis"; "refine the constant in the equation"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200278824">
	<b:glossaryEntry>attenuate or reduce in vigor, strength, or validity by polishing or purifying; "many valuble nutrients are refined out of the foods in our modern diet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200279047">
