	<b:glossaryEntry>primitive predaceous North American fish covered with hard scales and having long jaws with needle-like teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102131302">
	<b:glossaryEntry>scorpionfishes; sculpins; gurnards; greenlings; flying gurnards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102131519"
	 b:glossaryEntry="mail-cheeked fishes: scorpionfishes; gurnards"/>
<rdf:Description rdf:about="&a;102131801"
	 b:glossaryEntry="fishes having the the head armored with bony plates"/>
<rdf:Description rdf:about="&a;102132128"
	 b:glossaryEntry="scorpionfishes; rockfishes; lionfishes"/>
<rdf:Description rdf:about="&a;102132342">
	<b:glossaryEntry>any of numerous carnivorous usually bottom-dwelling warm-water marine fishes found worldwide but most abundant in the Pacific</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102132633"
	 b:glossaryEntry="type genus of the Scorpaenidae: scorpionfishes"/>
<rdf:Description rdf:about="&a;102132810">
