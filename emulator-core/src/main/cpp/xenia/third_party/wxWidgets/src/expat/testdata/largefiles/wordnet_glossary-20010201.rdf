	 b:glossaryEntry="underwater swimming with a breathing apparatus"/>
<rdf:Description rdf:about="&a;100281939"
	 b:glossaryEntry="skin diving with scuba apparatus"/>
<rdf:Description rdf:about="&a;100282030"
