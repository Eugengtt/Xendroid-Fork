	 b:glossaryEntry="having the character of a loud deep sound"/>
<rdf:Description rdf:about="&a;103898740"
	 b:glossaryEntry="having the timbre of a loud high-pitched sound"/>
<rdf:Description rdf:about="&a;103898867">
