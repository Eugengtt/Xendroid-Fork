	 b:glossaryEntry="make off with belongings of others"/>
<rdf:Description rdf:about="&a;201556515"
	 b:glossaryEntry="take illegally, as of cattle"/>
<rdf:Description rdf:about="&a;201556622"
	 b:glossaryEntry="steal in a store"/>
<rdf:Description rdf:about="&a;201556712"
	 b:glossaryEntry="rob at gunpoint or by means of some other threat"/>
<rdf:Description rdf:about="&a;201556872">
	<b:glossaryEntry>rob at gunpoint or with the threat of violence; "I was mugged in the streets of New York last night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201557033"
	 b:glossaryEntry="copy illegally; of published material"/>
<rdf:Description rdf:about="&a;201557142">
	<b:glossaryEntry>take without referencing from someone else''s writing or speech; of intellectual property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201557368"
	 b:glossaryEntry="take unauthorized (intellectual material)"/>
<rdf:Description rdf:about="&a;201557471">
