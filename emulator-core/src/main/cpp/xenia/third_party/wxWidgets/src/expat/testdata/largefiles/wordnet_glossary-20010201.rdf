	 b:glossaryEntry="representation by drawing or painting etc"/>
<rdf:Description rdf:about="&a;100579072"
	 b:glossaryEntry="the activity of making portraits"/>
<rdf:Description rdf:about="&a;100579162"
	 b:glossaryEntry="(medicine) obtaining pictures of the interior of the body"/>
<rdf:Description rdf:about="&a;100579376"
	 b:glossaryEntry="obtaining images by the use of X rays"/>
<rdf:Description rdf:about="&a;100579500">
	<b:glossaryEntry>a method of examining body organs by scanning them with X rays and using a computer to construct an image</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100579742">
	<b:glossaryEntry>using the reflections of high-frequency sound waves to construct an image of a body organ (a sonogram); commonly used to observe fetal growth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100579958">
	<b:glossaryEntry>using a computerized radiographic technique to examine the metabolic activity in various tissues (especially in the brain)</b:glossaryEntry>
</rdf:Description>
