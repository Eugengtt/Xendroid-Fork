	<b:glossaryEntry>Madagascan roller with terrestrial and crepuscular habits that feeds on e.g. insects and worms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101344279"
	 b:glossaryEntry="kingfishers"/>
<rdf:Description rdf:about="&a;101344464">
	<b:glossaryEntry>nonpasserine large-headed bird with a short tail and long sharp bill; usually crested and bright-colored; feed mostly on fish</b:glossaryEntry>
</rdf:Description>
