<rdf:Description rdf:about="&a;105218185">
	<b:glossaryEntry>the official language of Hungary (also spoken in Rumania); belongs to the Ugric family of languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105218349">
	<b:glossaryEntry>a Ugric language (related to Hungarian) spoken by the Ostyak people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105218478">
	<b:glossaryEntry>the Ugric language (related to Hungarian) spoken by the Vogul people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105218606">
	<b:glossaryEntry>any of the languages spoken by the Lapp people and generally assumed to be Uralic languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105218778">
	<b:glossaryEntry>the language of the nomadic Lapp people in N Scandinavia and the Kola Peninsula</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105218915">
	<b:glossaryEntry>the Uralic languages spoken by the Samoyed people in NW Siberia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105219116"
	 b:glossaryEntry="a Uralic language spoken by a Samoyed people of N Siberia"/>
<rdf:Description rdf:about="&a;105219260"
	 b:glossaryEntry="the Uralic language spoken by the Yeniseian people"/>
<rdf:Description rdf:about="&a;105219418"
	 b:glossaryEntry="the Uralic language spoken by the Nganasan people"/>
<rdf:Description rdf:about="&a;105219522"
	 b:glossaryEntry="the Uralic language spoken by the Ostyak-Samoyed people"/>
<rdf:Description rdf:about="&a;105219647">
	<b:glossaryEntry>a branch of the Indo-European languages that (judging from inscriptions and place names) was spread widely over Europe in the pre-Christian era</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105219897">
	<b:glossaryEntry>any of several related languages of the Celts in Ireland and Scotland</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105220091"
	 b:glossaryEntry="the Celtic language of Ireland"/>
<rdf:Description rdf:about="&a;105220206"
	 b:glossaryEntry="Irish Gaelic from 1100 to 1500"/>
<rdf:Description rdf:about="&a;105220295"
	 b:glossaryEntry="the Gaelic language of Scotland"/>
<rdf:Description rdf:about="&a;105220403"
	 b:glossaryEntry="the Gaelic language formerly spoken on the Isle of Man"/>
<rdf:Description rdf:about="&a;105220508"
	 b:glossaryEntry="a southern group of Celtic languages"/>
<rdf:Description rdf:about="&a;105220666"
	 b:glossaryEntry="a Celtic language of Wales"/>
<rdf:Description rdf:about="&a;105220744"
	 b:glossaryEntry="a Celtic language formerly spoken in Cornwall"/>
<rdf:Description rdf:about="&a;105220843"
	 b:glossaryEntry="a Celtic language of Brittany"/>
<rdf:Description rdf:about="&a;105220925">
	<b:glossaryEntry>a branch of the Indo-European languages of which Latin is the chief representative</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105221114">
	<b:glossaryEntry>a group of dead languages of ancient Italy; they were displace by Latin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105221298"
	 b:glossaryEntry="an extinct Italic language of ancient S Italy"/>
<rdf:Description rdf:about="&a;105221397"
	 b:glossaryEntry="an extinct Italic language of ancient S Italy"/>
<rdf:Description rdf:about="&a;105221494">
	<b:glossaryEntry>an extinct Osco-Umbrian language of ancient Italy that survives only in a few inscriptions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105221640"
	 b:glossaryEntry="any dialect of the language of ancient Rome"/>
<rdf:Description rdf:about="&a;105221825">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the language of educated people in ancient Rome; "Latin is a language as dead as dead can be. It killed the ancient Romans--and now it''s killing me"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105222036"
	 b:glossaryEntry="any dialect of Latin other than the classical"/>
<rdf:Description rdf:about="&a;105222173">
	<b:glossaryEntry>nonclassical Latin dialects spoken in the Roman Empire; source of Romance languages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105222315"
	 b:glossaryEntry="the form of Latin written between the 3rd and 8th centuries"/>
<rdf:Description rdf:about="&a;105222448"
	 b:glossaryEntry="Latin used for liturgical purposes during the Middle Ages"/>
<rdf:Description rdf:about="&a;105222566">
	<b:glossaryEntry>Latin since the Renaissance; used for scientific nomenclature</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105222695"
	 b:glossaryEntry="the group of languages derived from Latin"/>
<rdf:Description rdf:about="&a;105222955"
	 b:glossaryEntry="the Romance language spoken in Italy"/>
<rdf:Description rdf:about="&a;105223063"
	 b:glossaryEntry="a dialect of Italian spoken in Tuscany (especially Florence)"/>
<rdf:Description rdf:about="&a;105223176">
	<b:glossaryEntry>the Romance language spoken in France and in countries colonized by France</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105223411">
	<b:glossaryEntry>medieval provincial dialects of French spoken in central and northern France</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105223568">
	<b:glossaryEntry>medieval provincial dialects of French formerly spoken in the S of France</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105223738">
	<b:glossaryEntry>the earliest form of the French language; 9th to 13th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;105223856"
	 b:glossaryEntry="the medieval Norman dialect of Old French"/>
<rdf:Description rdf:about="&a;105223976"
	 b:glossaryEntry="the French (Norman) language used in medieval England"/>
<rdf:Description rdf:about="&a;105224103"
	 b:glossaryEntry="the French language as spoken in Quebec, Canada"/>
<rdf:Description rdf:about="&a;105224212"
	 b:glossaryEntry="the medieval dialects of Langue_d''oc"/>
<rdf:Description rdf:about="&a;105224314"
	 b:glossaryEntry="the Romance language spoken in Portugal and Brazil"/>
