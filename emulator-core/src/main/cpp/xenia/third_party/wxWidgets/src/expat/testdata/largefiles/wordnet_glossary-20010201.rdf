</rdf:Description>
<rdf:Description rdf:about="&a;102020580">
	<b:glossaryEntry>large diverse group of bony fishes; includes most living species</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102020911"
	 b:glossaryEntry="a bony fish of the subclass Teleostei"/>
<rdf:Description rdf:about="&a;102021282">
	<b:glossaryEntry>most primitive teleost fishes; all are soft-finned: salmon; trout; herring; shad; sardines; anchovies; whitefish; smelts; tarpon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102021697"
	 b:glossaryEntry="coextensive with the genus Gonorhynchus"/>
<rdf:Description rdf:about="&a;102021859">
	<b:glossaryEntry>slender cylindrical marine fishes lacking air bladders and teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102022041">
