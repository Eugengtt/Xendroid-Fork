	 b:glossaryEntry="fish of North American Pacific coast"/>
<rdf:Description rdf:about="&a;102086947"
	 b:glossaryEntry="kingfishes; whiting"/>
<rdf:Description rdf:about="&a;102087141"
	 b:glossaryEntry="any of several food fishes of North American coastal waters"/>
<rdf:Description rdf:about="&a;102087382">
	<b:glossaryEntry>any of several food and game fishes of the drum family indigenous to warm Atlantic waters of the North American coast</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102087592"
	 b:glossaryEntry="whiting of the southeastern coast of North America"/>
<rdf:Description rdf:about="&a;102087746">
	<b:glossaryEntry>whiting of the east coast of United States; closely resembles king whiting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102087908"
	 b:glossaryEntry="bluish-gray whiting of California coast"/>
<rdf:Description rdf:about="&a;102088026">
	<b:glossaryEntry>a dull silvery whiting of southern Atlantic and Gulf coasts of the United States</b:glossaryEntry>
</rdf:Description>
