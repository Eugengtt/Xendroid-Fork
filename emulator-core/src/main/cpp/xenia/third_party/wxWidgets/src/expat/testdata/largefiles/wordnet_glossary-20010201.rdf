	 b:glossaryEntry='go ashore; "The passengers disembarked at Southampton"'/>
<rdf:Description rdf:about="&a;201348218"
	 b:glossaryEntry="go on board; used of ships or aircraft"/>
<rdf:Description rdf:about="&a;201348364"
	 b:glossaryEntry="board a train"/>
<rdf:Description rdf:about="&a;201348442"
	 b:glossaryEntry="bring (aircraft) to a landing"/>
<rdf:Description rdf:about="&a;201348563">
	<b:glossaryEntry>reach or come to rest; "The bird landed on the highest branch"; "The plane landed in Istanbul"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201348890">
	<b:glossaryEntry>arrive by motorcar; "The star and her manager drive in today from their motor tour across the country"</b:glossaryEntry>
</rdf:Description>
