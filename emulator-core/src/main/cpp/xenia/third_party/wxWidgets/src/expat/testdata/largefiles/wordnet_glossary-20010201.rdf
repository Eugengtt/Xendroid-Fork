	<b:glossaryEntry>Old World bird that tumbles or rolls in flight; related to kingfishers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101343823"
	 b:glossaryEntry="type genus of the Coraciidae"/>
<rdf:Description rdf:about="&a;101343961">
	<b:glossaryEntry>common European blue-and-green roller with a reddish-brown back</b:glossaryEntry>
</rdf:Description>
