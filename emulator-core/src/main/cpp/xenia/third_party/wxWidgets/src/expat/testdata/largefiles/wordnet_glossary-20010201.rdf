	 b:glossaryEntry="a city of southern India"/>
<rdf:Description rdf:about="&a;106511039"
	 b:glossaryEntry="a state of northeastern India"/>
<rdf:Description rdf:about="&a;106511139">
	<b:glossaryEntry>an industrialized state in western India that includes parts of Bombay</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;106511292">
