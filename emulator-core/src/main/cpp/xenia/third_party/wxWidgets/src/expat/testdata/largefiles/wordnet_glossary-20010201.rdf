	 b:glossaryEntry="make (continental) European in customs, character, or ideas"/>
<rdf:Description rdf:about="&a;200284640">
	<b:glossaryEntry>denationalize and subject (a territory) to the supervision of an agency of a European community of nations</b:glossaryEntry>
</rdf:Description>
