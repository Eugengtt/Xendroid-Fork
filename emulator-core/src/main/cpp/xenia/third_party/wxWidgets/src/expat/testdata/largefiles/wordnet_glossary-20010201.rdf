	 b:glossaryEntry="thin curly wood shavings used for packing or stuffing"/>
<rdf:Description rdf:about="&a;110747124"
	 b:glossaryEntry="a roofing tile with a S-shape; laid so that curves overlap"/>
<rdf:Description rdf:about="&a;110747236"
	 b:glossaryEntry="material used for pavement"/>
<rdf:Description rdf:about="&a;110747432">
	<b:glossaryEntry>a black bituminous material used for paving roads or other areas; usually spread over crushed rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110747600"
	 b:glossaryEntry="broken stone used in macadamized roadways"/>
<rdf:Description rdf:about="&a;110747695">
	<b:glossaryEntry>a paving material of tar and broken stone; mixed in a factory and shaped during paving</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110747847"
	 b:glossaryEntry="used to coat outer walls and line chimneys"/>
<rdf:Description rdf:about="&a;110747954"
	 b:glossaryEntry="material used to pave an area"/>
<rdf:Description rdf:about="&a;110748047"
	 b:glossaryEntry="ore that yields a substantial profit to the miner"/>
<rdf:Description rdf:about="&a;110748151">
	<b:glossaryEntry>a lamellar mixture of cementite and ferrite formed during the cooling of austenite; a micro-constituent of steel and cast iron</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110748426"
	 b:glossaryEntry="a complex acid that occurs in ripe fruit and some vegetables"/>
<rdf:Description rdf:about="&a;110748544">
	<b:glossaryEntry>any of various water-soluble colloidal carbohydrates that occur in ripe fruit and vegetables; used in making fruit jellies and jams</b:glossaryEntry>
</rdf:Description>
