	<b:glossaryEntry>direct into a position for use; "point a gun"; "He charged his weapon at me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200783256"
	 b:glossaryEntry="hit the target or goal, as intended"/>
<rdf:Description rdf:about="&a;200783396"
	 b:glossaryEntry="fail to hit the intended target"/>
<rdf:Description rdf:about="&a;200783551"
	 b:glossaryEntry="shoot short of or below (a target)"/>
