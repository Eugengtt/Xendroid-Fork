	 b:glossaryEntry="the sport of hunting wild boar with spears"/>
<rdf:Description rdf:about="&a;100287951">
	<b:glossaryEntry xml:space='preserve'><![CDATA[working the land as an occupation or way of life; "farming is a strenuous life"; "there''s no work on the land any more"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100288131"
	 b:glossaryEntry="the act of someone who fishes as a diversion"/>
<rdf:Description rdf:about="&a;100288265"
	 b:glossaryEntry="the occupation of catching fish"/>
<rdf:Description rdf:about="&a;100288350">
	<b:glossaryEntry>the sport of catching fish with a rod and line and a baited hook (or other lure)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100288502"
	 b:glossaryEntry="angling with an artificial fly as a lure"/>
<rdf:Description rdf:about="&a;100288600">
	<b:glossaryEntry>the act of throwing a fishing line out over the water by means of a rod and reel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100288813">
	<b:glossaryEntry>the single-handed rod casting of a relatively heavy (artificial) bait</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100288941"
	 b:glossaryEntry="casting an artificial fly as a lure"/>
<rdf:Description rdf:about="&a;100289034"
	 b:glossaryEntry="a cast that falls beyond the intended spot"/>
<rdf:Description rdf:about="&a;100289131">
	<b:glossaryEntry>casting (artificial) bait out into the ocean with the waves breaking around you</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100289269">
	<b:glossaryEntry>a contest with rules to determine a winner; "you need four people to play this game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100289585"
	 b:glossaryEntry='a single play of a game; "the game lasted 2 hours"'/>
<rdf:Description rdf:about="&a;100289830"
	 b:glossaryEntry="a game in which one side fails to score"/>
<rdf:Description rdf:about="&a;100289923"
	 b:glossaryEntry="a game played in daylight"/>
<rdf:Description rdf:about="&a;100290021"
	 b:glossaryEntry="a game played under artificial illumination at night"/>
<rdf:Description rdf:about="&a;100290148"
	 b:glossaryEntry="a game played away from home"/>
<rdf:Description rdf:about="&a;100290262"
	 b:glossaryEntry="a game played at home"/>
<rdf:Description rdf:about="&a;100290357">
	<b:glossaryEntry>a game whose outcome is not recorded in the season''s standing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100290496">
	<b:glossaryEntry>an immediate second innings forced on a cricket team scoring a prescribed number of runs fewer than it opponents in the first innings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100290685"
	 b:glossaryEntry="the batting turn of a cricket player or team"/>
<rdf:Description rdf:about="&a;100290820">
	<b:glossaryEntry>the activity of doing something in an agreed succession; "it is my turn" or "it is still my play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100291138">
	<b:glossaryEntry>an offensive move in a sport or game; "they won the game with a 10-hit attack in the 9th inning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100291287">
	<b:glossaryEntry>a complete play to advance the football; "you have 4 downs to gain 10 yards"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100291414">
	<b:glossaryEntry>a turn batting (in baseball); "he was at bat when it happened" or "he got 4 hits in 4 at-bats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100291567">
	<b:glossaryEntry>an amusement or pastime; "he thought of his painting as a game that filled his empty time"; "his life was all fun and games"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100291922">
	<b:glossaryEntry>a cooperative game in which a ball is passed back and forth; "he played catch with his son in the backyard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100292081"
	 b:glossaryEntry="a game to amuse guests at a party"/>
<rdf:Description rdf:about="&a;100292171"
	 b:glossaryEntry="a game played against a computer"/>
<rdf:Description rdf:about="&a;100292294">
	<b:glossaryEntry>a hypothetical three-dimensional visual world created by a computer; user wears special goggles and fiber optic gloves etc., and can enter and move about in this world and interact with objects as if inside it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100292565">
	<b:glossaryEntry>a game played on a sloping board; the object is to propel marbles against pins or into pockets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100292746"
	 b:glossaryEntry="a Japanese pinball game played on a vertical board"/>
<rdf:Description rdf:about="&a;100292851">
	<b:glossaryEntry>a game in which participants compete to identify some obscurely indicated thing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100293008"
	 b:glossaryEntry="player acts out a phrase for others to guess"/>
<rdf:Description rdf:about="&a;100293126">
	<b:glossaryEntry>a game in which a flat stone is bounced along the surface of calm water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100293260">
	<b:glossaryEntry>an outdoor game; the hares start off on a long run scattering bits of paper (the scent) and the hounds try to catch them before they reach a designated spot</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100293492">
	<b:glossaryEntry>a children''s game in which the players dance around in a circle and at a given signal all squat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100293689">
	<b:glossaryEntry>a children''s game; two teams capture opposing players by tagging them and taking them to their own base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100293854">
	<b:glossaryEntry>a game in which players try to find hidden articles by using a series of clues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100293992"
	 b:glossaryEntry="the final game of a double header"/>
<rdf:Description rdf:about="&a;100294099"
	 b:glossaryEntry="two instead of one"/>
<rdf:Description rdf:about="&a;100294224"
	 b:glossaryEntry="one game in the series of games constituting a playoff"/>
<rdf:Description rdf:about="&a;100294356"
	 b:glossaryEntry="an eliminating game between teams in a cup competition"/>
<rdf:Description rdf:about="&a;100294464"
	 b:glossaryEntry="a simulated battle for training military commanders"/>
<rdf:Description rdf:about="&a;100294570">
	<b:glossaryEntry>(Scotland) a game played on ice; curling stones (heavy stones with handles) are slid toward a target</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100294724">
	<b:glossaryEntry>a game in which balls are rolled at an object or group of objects with the aim of knocking them over</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100294968"
	 b:glossaryEntry="bowling down an alley at a target of ten wooden pins"/>
<rdf:Description rdf:about="&a;100295091"
	 b:glossaryEntry="bowling down an alley at a target of nine wooden pins"/>
<rdf:Description rdf:about="&a;100295210">
	<b:glossaryEntry>a bowling game using a pin smaller than a tenpin but proportionately wider</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100295339"
	 b:glossaryEntry="a bowling game using slender bowling pins"/>
<rdf:Description rdf:about="&a;100295457">
	<b:glossaryEntry>a bowling game played on a lawn with wooden balls that are rolled at a jack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100295627"
	 b:glossaryEntry="Italian lawn bowling (played on a long narrow dirt court)"/>
<rdf:Description rdf:about="&a;100295753"
	 b:glossaryEntry="lawn bowling at a jack using biased wooden balls"/>
<rdf:Description rdf:about="&a;100295853">
	<b:glossaryEntry>a 17th C game; a wooden ball was driven along an alley with a mallet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100295977"
	 b:glossaryEntry="a game involving athletic activity"/>
<rdf:Description rdf:about="&a;100296274">
	<b:glossaryEntry>a game played on an ice rink by two opposing teams of 6 skaters each who try to knock a flat round puck into the opponents'' goal with hockey sticks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100296595">
	<b:glossaryEntry>(ice hockey) the method of starting play; a referee drops the puck between two opposing players</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100296764">
	<b:glossaryEntry>a game with two players who use rackets to strike a ball that is tethered to the top of a pole; the object is to wrap the string around the pole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100296965">
	<b:glossaryEntry>a game played in a swimming pool by two teams of swimmers who try to throw an inflated ball into the opponents'' goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100297138"
	 b:glossaryEntry="an athletic game that is played outdoors"/>
<rdf:Description rdf:about="&a;100297363">
	<b:glossaryEntry>a game played on a large open course with 9 or 18 holes; the object is use as few strokes as possible in playing all the holes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100297660"
	 b:glossaryEntry="playing golf for money"/>
<rdf:Description rdf:about="&a;100297764">
	<b:glossaryEntry>the activity of playing 18 holes of golf; "a round of golf takes about 4 hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100297911"
	 b:glossaryEntry="golf scoring by total strokes taken"/>
<rdf:Description rdf:about="&a;100298017"
	 b:glossaryEntry="golf scoring by holes won"/>
<rdf:Description rdf:about="&a;100298099">
	<b:glossaryEntry>a novelty version of golf played with golf balls and putters on a miniature course featuring many obstacles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100298267">
	<b:glossaryEntry>a game in which players hit a wooden ball through a series of hoops; the winner is the first to traverse all the hoops and hit a peg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100298453">
	<b:glossaryEntry>a game in which quoits or horseshoes are thrown at a stake in the ground in the hope of encircling it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100298620">
	<b:glossaryEntry>a game in which players use long sticks to shove wooden disks onto the scoring area marked on a smooth surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100298803"
	 b:glossaryEntry="an outdoor game played on a field of specified dimensions"/>
<rdf:Description rdf:about="&a;100299061">
	<b:glossaryEntry>hockey played on a field; two opposing teams use curved sticks to drive a ball into the opponents'' net</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100299231">
	<b:glossaryEntry>any of various games played with a ball (round or oval) in which two teams try to kick or carry or propel the ball into each other''s goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100299609">
	<b:glossaryEntry>a game played by two teams of 11 players on a rectangular field 100 yards long; teams try to get possession of the ball and advance it across the opponents goal line in a series of (running or passing) plays</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100299935"
	 b:glossaryEntry="playing football for money"/>
<rdf:Description rdf:about="&a;100300047">
	<b:glossaryEntry>a version of football in which the ball carrier is touched rather than tackled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100300186">
	<b:glossaryEntry>a traditional Irish game resembling hockey; played by two teams of 15 players each</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100300322"
	 b:glossaryEntry="(British) a form of football played with an oval ball"/>
<rdf:Description rdf:about="&a;100300491">
	<b:glossaryEntry>(Rugby) knocking the ball forward while trying to catch it (a foul)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100300632">
	<b:glossaryEntry>(rugby) the method of beginning play in which the forwards of each team crouch side by side with locked arms; play starts when the ball is put between them and the two sides compete for possession</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100300911">
	<b:glossaryEntry>a game played with a bat and ball between two teams of 9 players; teams take turns at bat trying to score run</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100301642"
	 b:glossaryEntry="playing baseball for money"/>
<rdf:Description rdf:about="&a;100301754"
	 b:glossaryEntry="baseball as distinguished from softball"/>
<rdf:Description rdf:about="&a;100301866">
	<b:glossaryEntry>a game in which a pitcher does not allow any opposing player to reach base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100301999"
	 b:glossaryEntry="a game in which a pitcher allows the opposing team no hits"/>
<rdf:Description rdf:about="&a;100302127">
	<b:glossaryEntry>a game in which a pitcher allows the opposing team only one hit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100302258">
	<b:glossaryEntry>a game in which a pitcher allows the opposing team only 2 hits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100302388">
	<b:glossaryEntry>a game in which a pitcher allows the opposing team only 3 hits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100302520"
	 b:glossaryEntry="a game in which a pitcher allows the opposing team 4 hits"/>
<rdf:Description rdf:about="&a;100302646"
	 b:glossaryEntry="a game in which a pitcher allows the opposing team 5 hits"/>
<rdf:Description rdf:about="&a;100302772">
	<b:glossaryEntry>a game closely resembling baseball that is played on a smaller diamond and with a ball that is larger and softer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100302973"
	 b:glossaryEntry="an English ball game similar to baseball"/>
<rdf:Description rdf:about="&a;100303068">
	<b:glossaryEntry>a form of baseball played in the streets with a rubber ball and broomstick handle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100303222">
	<b:glossaryEntry>a game played with a ball and bat by two teams of 11 players; teams take turns trying to score runs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100303413"
	 b:glossaryEntry="the act of delivering a cricket ball to the batsman"/>
<rdf:Description rdf:about="&a;100303572"
	 b:glossaryEntry="the approach run during which an athlete gathers speed"/>
<rdf:Description rdf:about="&a;100303736">
	<b:glossaryEntry>a ball bowled by a left-handed bowler to a right-handed batsman that spins from off to leg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100303881">
	<b:glossaryEntry>a cricket ball bowled as if to break one way that actually breaks in the opposite way</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100304052">
	<b:glossaryEntry>unlawfully delivered ball in cricket; "the umpire called it a no ball"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100304176">
	<b:glossaryEntry>a game invented by American indians; now played by two teams who use long-handled rackets to catch and carry and throw the ball toward the opponents'' goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100304385">
	<b:glossaryEntry>a game similar to field hockey but played on horseback using long-handled mallets and a wooden ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100304535">
	<b:glossaryEntry>a game using a leather-covered ball 6 feet in diameter; the two side try to push it across the opponents'' goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100304700">
	<b:glossaryEntry>a football game in which two teams of 11 players try to kick or head a ball into the opponents'' goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100304914"
	 b:glossaryEntry="the propulsion of a ball by repeated taps or kicks"/>
<rdf:Description rdf:about="&a;100305068"
	 b:glossaryEntry="an athletic game played on a court"/>
<rdf:Description rdf:about="&a;100305357">
	<b:glossaryEntry>a game played in a walled court or against a single wall by two or four players who strike a rubber ball with their hands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100305533"
	 b:glossaryEntry="a game played on a handball court with short-handled rackets"/>
<rdf:Description rdf:about="&a;100305651">
	<b:glossaryEntry>(British) a game resembling handball; played on a court with a front wall and two side walls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100305795">
	<b:glossaryEntry>a game played in an enclosed court by two or four players who strike the ball with long-handled rackets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100305986">
	<b:glossaryEntry>a game in which two teams hit an inflated ball over a high net using their hands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100306141">
	<b:glossaryEntry>a Basque or Spanish game played in a court with a ball and a wickerwork racket</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100306283">
	<b:glossaryEntry>a game played on a court with light long-handled rackets used to volley a shuttlecock over a net</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100306489"
	 b:glossaryEntry="an ancient racket game"/>
<rdf:Description rdf:about="&a;100306597">
	<b:glossaryEntry>a game played on a court by two opposing teams of 5 players; points are scored by throwing the basketball through an elevated horizontal hoop</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100306945"
	 b:glossaryEntry="the act of starting a basketball game with a jump ball"/>
<rdf:Description rdf:about="&a;100307082">
	<b:glossaryEntry>(basketball) the way play begins or resumes when possession is disputed; an official tosses the ball up between two players who jump in an effort to tap it to a teammate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100307325"
	 b:glossaryEntry="playing basketball for money"/>
<rdf:Description rdf:about="&a;100307441">
	<b:glossaryEntry>a team game that resembles basketball; a soccer ball is to be thrown so that it passes through a ring on the top of a post</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100307617">
	<b:glossaryEntry>a game played with rackets by two or four players who hit a ball back and forth over a net that divides the court</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100307964">
	<b:glossaryEntry>(tennis) a score consisting of winning a game when your opponent was serving; "he was up two breaks in the second set"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100308151"
	 b:glossaryEntry="a score that makes the match even"/>
<rdf:Description rdf:about="&a;100308240"
	 b:glossaryEntry="playing tennis for money"/>
<rdf:Description rdf:about="&a;100308348"
	 b:glossaryEntry="tennis played with one person on each side"/>
<rdf:Description rdf:about="&a;100308444"
	 b:glossaryEntry="badminton played with one person on each side"/>
<rdf:Description rdf:about="&a;100308543"
	 b:glossaryEntry="tennis played with two players on each side"/>
<rdf:Description rdf:about="&a;100308640"
	 b:glossaryEntry="badminton played with two players on each side"/>
<rdf:Description rdf:about="&a;100308740"
	 b:glossaryEntry="an ancient form of tennis played in a four-walled court"/>
<rdf:Description rdf:about="&a;100308883"
	 b:glossaryEntry="an Italian game similar to tennis"/>
<rdf:Description rdf:about="&a;100308970"
	 b:glossaryEntry="a game enjoyed by children"/>
<rdf:Description rdf:about="&a;100309343">
	<b:glossaryEntry>a children''s game in which a blindfolded player tries to catch and identify other players</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100309494"
	 b:glossaryEntry="game played with string looped over the fingers"/>
<rdf:Description rdf:about="&a;100309600">
	<b:glossaryEntry>a child covers his eyes while the other players hide then tries to find them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100309755">
	<b:glossaryEntry>a child tosses a stone into an area drawn on the ground and then hops through it and back to regain the stone</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100309920">
	<b:glossaryEntry>a game in which jackstones are thrown and picked up in various groups between bounces of a small rubber ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100310108">
	<b:glossaryEntry>a game in which players try to pick each jackstraw (or spillikin) off of a pile without moving any of the others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100310290"
	 b:glossaryEntry="one child bends down and another leaps over"/>
<rdf:Description rdf:about="&a;100310388"
	 b:glossaryEntry="advancing as if in the game of leapfrog"/>
<rdf:Description rdf:about="&a;100310482">
	<b:glossaryEntry>a children''s game played with little balls made of a hard substance (as glass)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100310614">
	<b:glossaryEntry>N players march around N-1 chairs; when the music stops the player who did not find a chair is eliminated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100310780">
	<b:glossaryEntry>a game played with young children; you hide your face and suddenly reveal it as you say Boo!</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100310936"
	 b:glossaryEntry="a child''s game of fighting with pillows"/>
<rdf:Description rdf:about="&a;100311034">
	<b:glossaryEntry>a children''s game in which kisses are exchanged for pretended letters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100311161">
	<b:glossaryEntry>a game in which a player spins a bottle and kisses the person that it points to when it stops spinning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100311325">
	<b:glossaryEntry>a game in which something round (as a plate) is spun on edge and the name of a player is called; the named player must catch the spinning object before it falls or pay a forfeit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100311582">
	<b:glossaryEntry>one child chases the others; the one who is caught becomes the next chaser</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100311725">
	<b:glossaryEntry>a game in which players try to flip plastic disks into a cup by pressing them on the side sharply with a larger disk</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100311899"
	 b:glossaryEntry="a game played with playing cards"/>
<rdf:Description rdf:about="&a;100312507">
	<b:glossaryEntry>the division of a deck of cards before dealing; "his cutting the cards before every deal soon became a ritual"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100312696">
	<b:glossaryEntry>card games in which points are won for taking the high or low or jack or game</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100312899">
	<b:glossaryEntry>a card game played in casinos in which two or more punters gamble against the banker; the player wins who holds 2 or 3 cars that total closest to nine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100313120">
	<b:glossaryEntry>a card game in which the object is to hold cards having a higher count than those dealt to the bank up to but not exceeding 21</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100313329"
	 b:glossaryEntry="any of various card games based on whist for four players"/>
<rdf:Description rdf:about="&a;100313569">
	<b:glossaryEntry>the earliest form of bridge; the dealer could name the trump suit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100313693">
	<b:glossaryEntry>a variety of bridge in which tricks made in excess of the contract are scored toward game; now generally superseded by contract bridge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100313898">
	<b:glossaryEntry>a variety of bridge in which the bidder receives points toward game only for the number of tricks he bid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100314075">
	<b:glossaryEntry>a card game in which cards face up on the table are taken with eligible cards in the hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100314263">
	<b:glossaryEntry>a card game in which each player is dealt 6 cards and discards one or two to make up the crib</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100314418">
	<b:glossaryEntry>a card game for 2 players; played with 32 cards and king high</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100314532">
	<b:glossaryEntry>a card game similar to ecarte; each player is dealt 5 cards and the player making trump must take 3 tricks to win a hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100314720">
	<b:glossaryEntry>a card game in which you play your sevens and other cards in sequence in the same suit as their sevens; you win if you are the first to use all your cards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100314949">
	<b:glossaryEntry>a card game in which players bet against the dealer on the cards he will draw from a dealing box</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100315096">
	<b:glossaryEntry>a game for two players who try to assemble books of cards by asking the opponent for particular cards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100315258">
	<b:glossaryEntry>a gambling card game of Spanish origin; 3 or 4 cards are dealt face up and players bet that one of the will be matched before the others as the cards are dealt from the pack one at a time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100315534">
	<b:glossaryEntry>a gambling card game in which chips are placed on the ace and king and queen and jack of separate suits (taken from a separate deck); a player plays the lowest card of a suit in his hand and successively higher cards are played until the sequence stops; the player who plays a card matching one in the layout wins all the chips on that card</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100315968">
	<b:glossaryEntry>a card game played with a 48-card pack (two of each suit for high cards); play resembles whist</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100316127"
	 b:glossaryEntry="a card game for two players using a reduced pack of 32 cards"/>
<rdf:Description rdf:about="&a;100316240">
	<b:glossaryEntry>any of various card games in which players bet that they hold the highest-ranking hand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100316499">
	<b:glossaryEntry>a card game in which two rows of cards are dealt and players can bet on the color of the cards or on which row will have a count nearer some number</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100316727">
	<b:glossaryEntry>a card game based on collecting sets and sequences; the winner is the first to meld all their cards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100316920"
	 b:glossaryEntry="a card game played by one person"/>
<rdf:Description rdf:about="&a;100317037">
	<b:glossaryEntry>a card game for four players who form two partnerships; a pack of 52 cards is dealt and each side scores one point for each trick it takes in excess of six</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100317307">
	<b:glossaryEntry>a form of whist with three players; four hands are dealt with the hand opposite the dealer being face up</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100317469">
	<b:glossaryEntry>a form of whist in which players avoid winning tricks containing hearts of the queen of spades</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100317630"
	 b:glossaryEntry="two play solitaire with separate packs"/>
<rdf:Description rdf:about="&a;100317738">
	<b:glossaryEntry>a form of rummy in which a player can go out if the cards remaining in their hand total less than 10 points</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100317921">
	<b:glossaryEntry>a form of rummy using two decks and four jokers; jokers and deuces are wild; the object is to meld groups of seven of the same rank</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100318164"
	 b:glossaryEntry="a form of canasta in which sequences can be melded"/>
<rdf:Description rdf:about="&a;100318268"
	 b:glossaryEntry="a form of canasta using three decks and six jokers"/>
<rdf:Description rdf:about="&a;100318370">
	<b:glossaryEntry>poker in which a player can discard cards and receive substitutes from the dealer; "he played only draw and stud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100318547"
	 b:glossaryEntry="poker in which the high and low hands split the pot"/>
<rdf:Description rdf:about="&a;100318653"
	 b:glossaryEntry="poker played for small stakes"/>
<rdf:Description rdf:about="&a;100318758">
	<b:glossaryEntry>poker in which each player gets 5 cards face down and bets a made without drawing any further cards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100318918">
	<b:glossaryEntry>poker in which a player''s losses are paid by removing an article of clothing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100319052">
	<b:glossaryEntry>poker in which each player receives hole cards and the remainder are dealt face up; bets are placed after each card is dealt</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100319240">
	<b:glossaryEntry>a form of all fours in which the players bid for the privilege of naming trumps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100319371"
	 b:glossaryEntry="an all-fours game in which the first card led is a trump"/>
<rdf:Description rdf:about="&a;100319495"
	 b:glossaryEntry="a form of all fours in which a total of seven points is game"/>
<rdf:Description rdf:about="&a;100319623"
	 b:glossaryEntry="a form of casino in which face cards have extra point values"/>
<rdf:Description rdf:about="&a;100319742"
	 b:glossaryEntry="a form of casino in which spades have the value of one point"/>
<rdf:Description rdf:about="&a;100319861"
	 b:glossaryEntry="a game that is played on a table"/>
<rdf:Description rdf:about="&a;100320040">
	<b:glossaryEntry>a game resembling tennis but played on a table with paddles and a light hollow ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100320194"
	 b:glossaryEntry="any of several games played with small rectangular blocks"/>
<rdf:Description rdf:about="&a;100320316">
	<b:glossaryEntry>any of several games played on rectangular cloth-covered table (with cushioned edges) in which long tapering cue sticks are used to propel ivory (or composition) balls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100320615">
	<b:glossaryEntry>the opening shot that scatters the balls in billiards or pool</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100320766">
	<b:glossaryEntry>a shot in billiards in which the cue ball contacts one object ball and then the other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100320950">
	<b:glossaryEntry>a shot in billiards made by hitting the cue ball with the cue held nearly vertically; the cue ball spins around another ball before hitting the object ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100321208">
	<b:glossaryEntry>a faulty shot in billiards; the cue tip slips off the cue ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100321361"
	 b:glossaryEntry="any of various games played on a pool table having 6 pockets"/>
<rdf:Description rdf:about="&a;100321585">
	<b:glossaryEntry>a form of pool played with 15 red balls and six balls of other colors and a cue ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100321723">
	<b:glossaryEntry>(British) a table game in which short cues are used to knock balls into holes that are guarded by wooden pegs; penalties are incurred if the pegs are knocked over</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100321957"
	 b:glossaryEntry="a game suitable for playing in a parlor"/>
<rdf:Description rdf:about="&a;100322090">
	<b:glossaryEntry>any game involving the formation or alteration or discovery of words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100322250">
	<b:glossaryEntry>a game whose object is to form words from a group of randomly chosen letters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100322381">
	<b:glossaryEntry>(trademark) a game in which words are formed from letters in patterns similar to a crossword puzzle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100322535"
	 b:glossaryEntry="a game played on a specially designed board"/>
<rdf:Description rdf:about="&a;100322887">
	<b:glossaryEntry>a board game for two players; pieces move according to throws of the dice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100323017">
	<b:glossaryEntry>a checkerboard game for two players who each have 12 pieces; the object is to jump over and so capture the opponent''s pieces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100323207">
	<b:glossaryEntry>a game for two players who move their 16 pieces according to specific rules; the object is to checkmate the opponent''s king</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100323451">
	<b:glossaryEntry>a board game in which each player tries to move a set of marbles through a set of holes from one point of a six-pointed star to the opposite point</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100323679"
	 b:glossaryEntry="a game in which darts are thrown at a dartboard"/>
<rdf:Description rdf:about="&a;100323778">
	<b:glossaryEntry>(Japanese) a board game for two players who place counters on a grid; the object is to surround and so capture the opponent''s counters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100323971">
	<b:glossaryEntry>a board game in which players try to move their pieces into their opponent''s bases</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100324105">
	<b:glossaryEntry>a game in which numbered balls are drawn and random and players cover the corresponding numbers on their cards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100324290">
	<b:glossaryEntry>(British) a lottery in which tickets are drawn from a revolving drum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100324412">
	<b:glossaryEntry>(British) a simple board game in which players move counters according to the throw of dice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100324554"
	 b:glossaryEntry="Chinese game played by 4 people with 144 tiles"/>
<rdf:Description rdf:about="&a;100324666">
	<b:glossaryEntry>(trademark) a board game in which players try to gain a monopoly on real estate as pieces advance around the board according to the throw of a die</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100324867">
	<b:glossaryEntry>an ancient board game resembling backgammon; played on a cross-shaped board</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100325014"
	 b:glossaryEntry="(trademark) a modern board game based on pachisi"/>
<rdf:Description rdf:about="&a;100325118">
	<b:glossaryEntry>(Japanese) a form of chess played on a board of 81 squares; each player has 20 pieces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100325255">
	<b:glossaryEntry>(British) a game in which coins or discs are slid by hand across a board toward a mark</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100325435">
	<b:glossaryEntry>a game in which two players alternately put crosses and circles in one of the compartments of a 3-by-3 board; the object is to get a row of three crosses or three circles before the opponent does</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100325752">
	<b:glossaryEntry>the act of playing for stakes in the hope of winning (including the payment of a price for a chance to win a prize); "his gambling cost him a fortune"; "there was heavy play at the blackjack table"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100326128"
	 b:glossaryEntry="active interest in gambling on sports events"/>
<rdf:Description rdf:about="&a;100326232"
	 b:glossaryEntry='the act of gambling; "he did it on a bet"'/>
<rdf:Description rdf:about="&a;100326453"
	 b:glossaryEntry="a single bet on two horse races in the same day"/>
<rdf:Description rdf:about="&a;100326559">
	<b:glossaryEntry>a bet that you can pick the first and second finishers in the right order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100326696"
	 b:glossaryEntry="betting where winners share the total amount wagered"/>
<rdf:Description rdf:about="&a;100326805"
	 b:glossaryEntry="a bet that a horse will finish a race no worse than second"/>
<rdf:Description rdf:about="&a;100326919">
	<b:glossaryEntry>a bet that you can pick the first four finishers in a race in the right order</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100327053"
	 b:glossaryEntry="a game that involves gambling"/>
<rdf:Description rdf:about="&a;100327267">
	<b:glossaryEntry>a Chinese gambling game; a random number of counters are placed under a bowl and you gamble on how many will be left (0 or 1 or 2 or 3) modulo 4</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100327464">
	<b:glossaryEntry>players buy chances and prizes are distributed according to the drawing of lots</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100327679"
	 b:glossaryEntry="an illegal daily lottery"/>
<rdf:Description rdf:about="&a;100327804"
	 b:glossaryEntry="a lottery in which the prizes are goods rather than money"/>
<rdf:Description rdf:about="&a;100327914">
	<b:glossaryEntry>a lottery in which the prize consists of the money paid by the participants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100328060"
	 b:glossaryEntry="a gambling game using two dice"/>
<rdf:Description rdf:about="&a;100328189">
	<b:glossaryEntry>a gambling game in which players bet on which compartment of a revolving wheel a small ball will come to rest in</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100328356">
	<b:glossaryEntry>any gambling game in which bets are laid against the gambling house or the dealer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100328496"
	 b:glossaryEntry="any festival or other celebration"/>
<rdf:Description rdf:about="&a;100328689"
	 b:glossaryEntry="boisterous celebration"/>
<rdf:Description rdf:about="&a;100328836"
	 b:glossaryEntry="noisy and mischievous merrymaking"/>
<rdf:Description rdf:about="&a;100328944"
	 b:glossaryEntry="unrestrained merrymaking"/>
<rdf:Description rdf:about="&a;100329120"
	 b:glossaryEntry="any carefree episode"/>
<rdf:Description rdf:about="&a;100329202"
	 b:glossaryEntry="a brief indulgence of your impulses"/>
<rdf:Description rdf:about="&a;100329304">
	<b:glossaryEntry>an occasion for heavy drinking; "they went on a bust that lasted three days"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100329473"
	 b:glossaryEntry="a merry drinking party"/>
<rdf:Description rdf:about="&a;100329560">
	<b:glossaryEntry>a wild gathering involving excessive drinking and promiscuity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100329759"
	 b:glossaryEntry="a festival marked by merrymaking and processions"/>
<rdf:Description rdf:about="&a;100329880">
	<b:glossaryEntry>an orgiastic festival in ancient Greece in honor of Dionysus (= Bacchus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100330021">
	<b:glossaryEntry>gay or light-hearted recreational activity for diversion or amusement; "it was all done in play"; "their frolic in the surf threatened to become ugly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100330345">
	<b:glossaryEntry>activities that are enjoyable or amusing; "I do it for the fun of it"; "he is fun to have around"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100330518"
	 b:glossaryEntry="playful behavior intended to arouse sexual interest"/>
<rdf:Description rdf:about="&a;100330677"
	 b:glossaryEntry="foolish or senseless behavior"/>
<rdf:Description rdf:about="&a;100330812"
	 b:glossaryEntry="acting like a clown or buffoon"/>
<rdf:Description rdf:about="&a;100330945"
	 b:glossaryEntry="rowdy or boisterous play"/>
<rdf:Description rdf:about="&a;100331025"
	 b:glossaryEntry='playful vexation; "the parody was just a form of teasing"'/>
<rdf:Description rdf:about="&a;100331136"
	 b:glossaryEntry="playing on words or speech sounds"/>
<rdf:Description rdf:about="&a;100331225"
	 b:glossaryEntry="a ludicrous or grotesque act done for fun and amusement"/>
<rdf:Description rdf:about="&a;100331381">
	<b:glossaryEntry>a prank or trick played on a person especially one intended to make the victim appear foolish</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100331571"
	 b:glossaryEntry="a practical joke or trick played on April Fools'' day"/>
<rdf:Description rdf:about="&a;100331680">
	<b:glossaryEntry>(British) a boisterous practical joke (especially by college students)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100331800"
	 b:glossaryEntry="activity characterized by good humor"/>
<rdf:Description rdf:about="&a;100331961"
	 b:glossaryEntry="a quaint and amusing jest"/>
<rdf:Description rdf:about="&a;100332051">
	<b:glossaryEntry>as a joke: trying to make somebody believe something that is not true</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100332189"
	 b:glossaryEntry='an agreeable or amusing remark; "they exchange pleasantries"'/>
<rdf:Description rdf:about="&a;100332306"
	 b:glossaryEntry="an activity that entertains"/>
<rdf:Description rdf:about="&a;100332459"
	 b:glossaryEntry="any lavishly staged or spectacular entertainment"/>
<rdf:Description rdf:about="&a;100332566">
	<b:glossaryEntry>the public performance of a sacrament or solemn ceremony with all appropriate ritual; "the celebration of marriage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100332755">
	<b:glossaryEntry>the ancient Panhellenic celebration at Olympia in honor of Zeus; held every 4 years beginning in 472 BC</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100332935">
	<b:glossaryEntry>an eisteddfod with competitions in music and drama and poetry and the fine arts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100333086">
	<b:glossaryEntry>any of several annual Welsh festivals involving artistic competitions (especially in singing)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100333254"
	 b:glossaryEntry="an organized series of acts and performances"/>
<rdf:Description rdf:about="&a;100333503"
	 b:glossaryEntry="a festival that features performances by jazz artists"/>
<rdf:Description rdf:about="&a;100333616">
	<b:glossaryEntry>a festival featuring African-American culture; celebrated between Christmas and New Years</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100333768"
	 b:glossaryEntry="an orgiastic festival in ancient Rome in honor of Saturn"/>
<rdf:Description rdf:about="&a;100333881"
	 b:glossaryEntry="festival at the time of sheepshearing"/>
<rdf:Description rdf:about="&a;100333978"
	 b:glossaryEntry="a gay festivity"/>
<rdf:Description rdf:about="&a;100334079">
	<b:glossaryEntry>a celebration following a victory in a battle or sports competition</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100334212"
	 b:glossaryEntry="noisy and boisterous revelry"/>
<rdf:Description rdf:about="&a;100334294">
	<b:glossaryEntry>a traveling show; having sideshows and rides and games of skill etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100334453"
	 b:glossaryEntry="a competitive exhibition of dogs"/>
<rdf:Description rdf:about="&a;100334540"
	 b:glossaryEntry="a competitive exhibition of horses"/>
<rdf:Description rdf:about="&a;100334630"
	 b:glossaryEntry="a street show"/>
<rdf:Description rdf:about="&a;100334700">
	<b:glossaryEntry>performance given by a traveling company of acrobats clowns and trained animals; "the children always love to go to the circus"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100334898"
	 b:glossaryEntry="a circus with simultaneous performances in three rings"/>
<rdf:Description rdf:about="&a;100335016"
	 b:glossaryEntry="the pre-Lenten festival of Shrove Tuesday"/>
<rdf:Description rdf:about="&a;100335147">
	<b:glossaryEntry>a public entertainment or exhibition; "a remarkable show of skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100335498"
	 b:glossaryEntry="a series of acts at a night club"/>
<rdf:Description rdf:about="&a;100335609"
	 b:glossaryEntry="any entertainment performed by ice skaters"/>
<rdf:Description rdf:about="&a;100335706">
	<b:glossaryEntry>a brief show (music or dance etc) performed between the sections of another performance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100335874"
	 b:glossaryEntry='a visible display; "she made a parade of her sorrows"'/>
<rdf:Description rdf:about="&a;100335980">
	<b:glossaryEntry>something shown to the public; "the museum had many exhibits of oriental art"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100336149">
	<b:glossaryEntry>the act of presenting something; "he gave the customer a demonstration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100336363">
	<b:glossaryEntry>a show of military force or preparedness; "he confused the enemy with feints and demonstrations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100336519">
	<b:glossaryEntry>the act of exhibiting; "a remarkable exhibition of musicianship"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100336676">
	<b:glossaryEntry>(law) the act of exhibiting in a court of law; "the appellate court demanded the production of all documents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100336842"
	 b:glossaryEntry="an exhibition of cowboy skills"/>
<rdf:Description rdf:about="&a;100336981"
	 b:glossaryEntry="a show on tour"/>
<rdf:Description rdf:about="&a;100337051"
	 b:glossaryEntry="a minor show that is part of a larger one (as at the circus)"/>
<rdf:Description rdf:about="&a;100337166">
	<b:glossaryEntry>an entertainment that provokes pleased interest and distracts you from worries and vexations</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100337330">
	<b:glossaryEntry>taking a series of rhythmical steps (and movements) in time to music</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100337690">
	<b:glossaryEntry>the interpretation in harmonious bodily movements of the rhythm of musical compositions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100337848">
	<b:glossaryEntry>a form of solo dancing that involves rapid acrobatic moves in which different parts of the body touch the ground; normally performed to the rhythm of rap music</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100338081">
	<b:glossaryEntry>an intricate traditional dance in India performed by professional dancing girls</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100338236"
	 b:glossaryEntry="a stately court dance of the 16th and 17th centuries"/>
<rdf:Description rdf:about="&a;100338341">
	<b:glossaryEntry>a stately court dance of the 17th and 18th centuries; in slow time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100338462">
	<b:glossaryEntry>a form of dancing in which dancers slam into one another; normally performed to punk rock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100338623">
	<b:glossaryEntry>dancing in which the steps are more important than gestures or postures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100338800"
	 b:glossaryEntry="a dance step tapped out audibly with the feet"/>
<rdf:Description rdf:about="&a;100338969"
	 b:glossaryEntry="a dance performed on tiptoe"/>
<rdf:Description rdf:about="&a;100339066"
	 b:glossaryEntry="tap dancing wearing soft-soled shoes"/>
<rdf:Description rdf:about="&a;100339198"
	 b:glossaryEntry="a solo tap dance emphasizing sharp taps"/>
<rdf:Description rdf:about="&a;100339297"
	 b:glossaryEntry="artistic dancing"/>
<rdf:Description rdf:about="&a;100339532">
	<b:glossaryEntry>a theatrical representation of a story performed to music by ballet dancers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100339825"
	 b:glossaryEntry="a solo dance or dance figure"/>
<rdf:Description rdf:about="&a;100339927">
	<b:glossaryEntry>a dance for two people (usually a ballerina and a danseur noble)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100340075">
	<b:glossaryEntry>a style of ballet based on precise conventional steps performed with graceful and flowing movements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100340237"
	 b:glossaryEntry="a style of ballet that admits a wider variety of movements"/>
<rdf:Description rdf:about="&a;100340355"
	 b:glossaryEntry="a ballet that stresses the drama with features of comedy"/>
<rdf:Description rdf:about="&a;100340471">
	<b:glossaryEntry>a style of theatrical dancing that is not as restricted as classical ballet; movements are expressive of feelings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100340661">
	<b:glossaryEntry>a dance performed while wearing clogs; has heavy stamping steps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100340803">
	<b:glossaryEntry>a violent fast dance in French vaudeville (an apache is a member of the French underworld)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100340952">
	<b:glossaryEntry>a Middle Eastern dance in which the dancer makes sensuous movements of the hips and abdomen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100341135">
	<b:glossaryEntry>a Spanish dance in triple time accompanied by guitar and castanets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100341254">
	<b:glossaryEntry>a strutting dance based on a march; was performed in minstrel shows; originated as a competition among Black dancers to win a cake</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100341439">
	<b:glossaryEntry>a high-kicking dance of French origin performed by a female chorus line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100341563"
	 b:glossaryEntry="erotic dancing with little or no clothing"/>
<rdf:Description rdf:about="&a;100341717">
	<b:glossaryEntry>a solo dance in which large fans are manipulated to suggest or reveal nakedness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100341852">
	<b:glossaryEntry>a form of entertainment in which a dancer undresses to music; "she did a strip right in front of everyone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100342023">
	<b:glossaryEntry>a solo dance similar to a fan dance except large balloons are used instead of fans</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100342164">
	<b:glossaryEntry>a form of modern dance in which the dancer''s movements depict an emotion or tell a story</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100342388"
	 b:glossaryEntry="dancing as part of a social occasion"/>
<rdf:Description rdf:about="&a;100342665"
	 b:glossaryEntry="a jerky American dance that was popular in the 1940s"/>
<rdf:Description rdf:about="&a;100342773">
	<b:glossaryEntry>an energetic American dance that was popular in the 1930s (probably named for the aviator Charles Lindbergh)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100342945">
	<b:glossaryEntry>a provocative Spanish courtship dance in triple time; performed by a man and a woman playing castanets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100343102">
	<b:glossaryEntry>a lively dance from Provence; all the dancers join hands and execute various figures</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100343242">
	<b:glossaryEntry>a style of dancing characteristic of the Andalusian gypsies; vigorous and rhythmic with clapping and stamping of feet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100343430"
	 b:glossaryEntry="an old formal French dance in quadruple time"/>
<rdf:Description rdf:about="&a;100343528">
	<b:glossaryEntry>a lively dance step consisting of hopping on each foot in turn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100343652"
	 b:glossaryEntry="a dance involving a rhythmical stamping step"/>
<rdf:Description rdf:about="&a;100343748"
	 b:glossaryEntry="a lively whirling Italian dance for two persons"/>
<rdf:Description rdf:about="&a;100343865">
	<b:glossaryEntry>a sequence of foot movements that make up a particular dance; "he taught them the waltz step"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100344095"
	 b:glossaryEntry="(ballet) quick gliding steps with one foot always leading"/>
<rdf:Description rdf:about="&a;100344233"
	 b:glossaryEntry="a gliding or sliding step in ballet"/>
<rdf:Description rdf:about="&a;100344342">
	<b:glossaryEntry>any of a variety of social dances performed by couples in a ballroom</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100344796">
	<b:glossaryEntry>a modern ballroom dance from Latin America; small steps and swaying movements of the hips</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100344953"
	 b:glossaryEntry="an early ballroom dance; precursor to the fox-trot"/>
<rdf:Description rdf:about="&a;100345076"
	 b:glossaryEntry="an early ragtime one-step"/>
<rdf:Description rdf:about="&a;100345159">
	<b:glossaryEntry>a ballroom dance in quadruple time; combines short and long and fast and slow steps fixed sequences</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100345313"
	 b:glossaryEntry="a ballroom dance in duple meter; marked by sliding steps"/>
<rdf:Description rdf:about="&a;100345424">
	<b:glossaryEntry>a Spanish dance in triple time; accompanied by guitar and castanets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100345544"
	 b:glossaryEntry="a syncopated ballroom dance formerly popular in the US"/>
<rdf:Description rdf:about="&a;100345654">
	<b:glossaryEntry>an American ballroom dance in syncopated rhythm; popular early in the 20th century</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100345793">
	<b:glossaryEntry>a Latin American dance of 3 steps and a kick by people in single file</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100345914"
	 b:glossaryEntry="a lively dance originating in France in the 18th century"/>
<rdf:Description rdf:about="&a;100346037"
	 b:glossaryEntry="a stately court dance in the 17th century"/>
<rdf:Description rdf:about="&a;100346131"
	 b:glossaryEntry="a ballroom dance in fast duple time"/>
<rdf:Description rdf:about="&a;100346223"
	 b:glossaryEntry="a ballroom dance with both quick and slow steps"/>
<rdf:Description rdf:about="&a;100346326"
	 b:glossaryEntry="a ballroom dance based on the Cuban folk dance"/>
<rdf:Description rdf:about="&a;100346424"
	 b:glossaryEntry="a lively ballroom dance from Brazil"/>
<rdf:Description rdf:about="&a;100346511"
	 b:glossaryEntry="a ballroom dance characterized by revolving movement"/>
<rdf:Description rdf:about="&a;100346637"
	 b:glossaryEntry="a ballroom dance of Latin-American origin"/>
<rdf:Description rdf:about="&a;100346730">
	<b:glossaryEntry>a ballroom dance in triple time with a strong accent on the first beat</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100346860">
	<b:glossaryEntry>a style of dancing that originated among ordinary people (not in the royal courts)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100347194"
	 b:glossaryEntry="a Polish national dance in triple time"/>
<rdf:Description rdf:about="&a;100347286"
	 b:glossaryEntry="a Bohemian dance with 3 steps and a hop in fast time"/>
<rdf:Description rdf:about="&a;100347390"
	 b:glossaryEntry="a German round dance resembling a slow polka"/>
<rdf:Description rdf:about="&a;100347492">
	<b:glossaryEntry>any of various English folk dances performed by men in costume</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100347630">
	<b:glossaryEntry>any of various dances by men who step nimbly over swords or flourish them in the air</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100347788"
	 b:glossaryEntry="a rhythmic syncopated Cuban folk dance in duple time"/>
<rdf:Description rdf:about="&a;100347892"
	 b:glossaryEntry="a vigorous Scottish reel"/>
<rdf:Description rdf:about="&a;100347977"
	 b:glossaryEntry="a British solo dance performed by sailors"/>
<rdf:Description rdf:about="&a;100348073">
	<b:glossaryEntry>any of various old rustic dances involving kicking and leaping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100348185">
	<b:glossaryEntry>a type of folk dance in which couples are arranged in sets or face one another in a line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100348506">
	<b:glossaryEntry>country dancing performed with couples in two long lines facing each other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100348670">
	<b:glossaryEntry>an American country dance which starts with the couples facing each other in two lines</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100348823"
	 b:glossaryEntry="a folk dance; dancers form a circle"/>
<rdf:Description rdf:about="&a;100348934"
	 b:glossaryEntry="American country dancing in which couples form squares"/>
<rdf:Description rdf:about="&a;100349176">
	<b:glossaryEntry>a lively dance of Scottish highlanders; marked by circular moves and gliding steps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100349361"
	 b:glossaryEntry="a Scottish reel for eight dancers"/>
<rdf:Description rdf:about="&a;100349450"
	 b:glossaryEntry="a square dance of 5 or more figures for 4 or more couples"/>
<rdf:Description rdf:about="&a;100349581"
	 b:glossaryEntry="a quadrille for 8 or 16 couples"/>
<rdf:Description rdf:about="&a;100349666">
	<b:glossaryEntry>a square-dance figure; two dancers approach each other and circle back to back before returning to their original places</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100349860">
	<b:glossaryEntry>a square dance figure; couples march counterclockwise in a circle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100350000">
	<b:glossaryEntry>a square dance figure; partners circle each other taking sideways steps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100350143">
	<b:glossaryEntry>a square dance figure; a pair of dancers join hands and dance around a point between them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100350303">
	<b:glossaryEntry>a moderately slow Austrian country dance in triple time; involves spinning and clapping</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100350444"
	 b:glossaryEntry="a dance that is part of a religious ritual"/>
<rdf:Description rdf:about="&a;100350744"
	 b:glossaryEntry="a ritual dance of the Apache Indians"/>
<rdf:Description rdf:about="&a;100350845"
	 b:glossaryEntry="a rain dance of Amerindians"/>
<rdf:Description rdf:about="&a;100350929">
	<b:glossaryEntry>a medieval dance in which a skeleton representing death leads a procession of others to the grave</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100351103">
	<b:glossaryEntry>a religious dance of native Americans looking for communication with the dead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100351238"
	 b:glossaryEntry="a Polynesian rain dance performed by a woman"/>
<rdf:Description rdf:about="&a;100351364"
	 b:glossaryEntry="an ancient Greek dance imitating the motions of warfare"/>
<rdf:Description rdf:about="&a;100351473"
	 b:glossaryEntry="a ritual dance intended to bring rain"/>
<rdf:Description rdf:about="&a;100351603">
	<b:glossaryEntry>a ceremonial dance (as by the American Hopi Indians) in which snakes are handled or invoked</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100351752">
	<b:glossaryEntry>a ceremonial dance performed by Amerindians at the summer solstice</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100351874">
	<b:glossaryEntry>a ceremonial dance performed before a battle or after a victory</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100351993"
	 b:glossaryEntry='a musical diversion; "his music was his central interest"'/>
<rdf:Description rdf:about="&a;100352265"
	 b:glossaryEntry="music composed for ballroom dancing"/>
<rdf:Description rdf:about="&a;100352447"
	 b:glossaryEntry="music with a syncopated melody (usually for the piano)"/>
<rdf:Description rdf:about="&a;100352561">
	<b:glossaryEntry>a style of dance music popular in the 1920s; similar to New Orleans jazz but played by large bands</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100352710">
	<b:glossaryEntry>music that originated in New Orleans around 1900 and developed through increasingly complex styles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100352985"
	 b:glossaryEntry="an early form of modern jazz (originating around 1940)"/>
<rdf:Description rdf:about="&a;100353097"
	 b:glossaryEntry="an instrumental version of the blues (especially for piano)"/>
<rdf:Description rdf:about="&a;100353243"
	 b:glossaryEntry="any of various styles of jazz that appeared after 1940"/>
<rdf:Description rdf:about="&a;100353377">
	<b:glossaryEntry>a type of dance music originating in the 1950s; a blend of rhythm-and-blues with country-and-western</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100353591">
	<b:glossaryEntry>rock music with deliberately offensive lyrics expressing anger and social alienation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100353738"
	 b:glossaryEntry="(Brit) traditional jazz as revived in the 1950s"/>
<rdf:Description rdf:about="&a;100353836">
	<b:glossaryEntry>a style of jazz played by big bands popular in the 1930s; flowing rhythms but less complex than later styles of jazz</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100354025">
	<b:glossaryEntry>a kind of danceable music popular among black South Africans; includes a whistle among its instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100354179">
	<b:glossaryEntry>music that is vocalized (as contrasted with instrumental music)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100354354">
	<b:glossaryEntry>a form of vocal music in which rhyming lyrics are chanted to a musical accompaniment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100354500"
	 b:glossaryEntry="the act of singing vocal music"/>
<rdf:Description rdf:about="&a;100354831"
	 b:glossaryEntry="(British) informal group singing of popular songs"/>
<rdf:Description rdf:about="&a;100354935"
	 b:glossaryEntry="a style of operatic singing"/>
<rdf:Description rdf:about="&a;100355018"
	 b:glossaryEntry="singing with florid ornamentation"/>
<rdf:Description rdf:about="&a;100355108">
	<b:glossaryEntry>the act of singing; "with a shout and a song they marched up to the gates"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100355296"
	 b:glossaryEntry="a joyful song (usually celebrating the birth of Christ)"/>
<rdf:Description rdf:about="&a;100355403"
	 b:glossaryEntry="a quiet song that lulls a child to sleep"/>
<rdf:Description rdf:about="&a;100355510"
	 b:glossaryEntry="an elaborate song for solo voice"/>
<rdf:Description rdf:about="&a;100355593"
	 b:glossaryEntry="singing joyful religious songs (especially at Christmas)"/>
<rdf:Description rdf:about="&a;100355704"
	 b:glossaryEntry="the act of singing popular songs in a sentimental manner"/>
<rdf:Description rdf:about="&a;100355815">
	<b:glossaryEntry>singing in a soft low tone; "her crooning soon put the child to sleep"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100355940">
	<b:glossaryEntry>singing jazz; the singer substitutes nonsense syllables for the words of the song and tries to sound like a musical instrument</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100356150"
	 b:glossaryEntry='music written for marching; "Sousa wrote the best marches"'/>
<rdf:Description rdf:about="&a;100356331">
	<b:glossaryEntry>brisk marching music suitable for troops marching in a military parade</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100356514"
	 b:glossaryEntry="a march accompanying quick time"/>
<rdf:Description rdf:about="&a;100356601">
	<b:glossaryEntry>martial music with variations; for the Scottish Highlands bagpipe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100356720"
	 b:glossaryEntry="a slow march to be played for funeral processions"/>
<rdf:Description rdf:about="&a;100356842"
	 b:glossaryEntry="a march to be played for processions"/>
<rdf:Description rdf:about="&a;100356963"
	 b:glossaryEntry="playing a set of bells that are (usually) hung in a tower"/>
<rdf:Description rdf:about="&a;100357127">
	<b:glossaryEntry>ringing tuned bells in a fixed order that is continually changing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100357253">
	<b:glossaryEntry>the act of playing drums; "he practiced his drumming several hours every day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100357398">
	<b:glossaryEntry>the act of whistling a tune; "his cheerful whistling indicated that he enjoyed his work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100357542">
	<b:glossaryEntry>a stroke or blow; "the signal was two beats on the steam pipe"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100357655">
	<b:glossaryEntry>a stroke with a curved piece of wood with taut horsehair strands that is used in playing stringed instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100357850"
	 b:glossaryEntry="a downward stroke from the heel to the tip of the bow"/>
<rdf:Description rdf:about="&a;100357958"
	 b:glossaryEntry="an upward stroke from the tip to the heel of the bow"/>
<rdf:Description rdf:about="&a;100358063"
	 b:glossaryEntry="the performance of a part or role in a drama"/>
<rdf:Description rdf:about="&a;100358359"
	 b:glossaryEntry="acting the part of a character on stage"/>
<rdf:Description rdf:about="&a;100358502">
	<b:glossaryEntry>an impressionistic portrayal of a person; "he did a funny impression of a politician"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100358644"
	 b:glossaryEntry="imitating the mannerisms of another person"/>
<rdf:Description rdf:about="&a;100358778"
	 b:glossaryEntry="the act of mimicking; imitative behavior"/>
<rdf:Description rdf:about="&a;100358898"
	 b:glossaryEntry="humorous or satirical mimicry"/>
<rdf:Description rdf:about="&a;100359000">
	<b:glossaryEntry>a performance using gestures and body movements without words</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100359154"
	 b:glossaryEntry="(British) an abbreviation of pantomime"/>
<rdf:Description rdf:about="&a;100359244">
	<b:glossaryEntry>incidental activity performed by an actor for dramatic effect; "his business with the cane was hilarious"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100359430">
	<b:glossaryEntry>the act of presenting a play or a piece of music or other entertainment; "we congratulated him on his performance at the recital"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100359780">
	<b:glossaryEntry>a performance (or series of performances) at a public presentation; "the program lasted more than two hours"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100359972"
	 b:glossaryEntry="the entertainment offered at a public presentation"/>
<rdf:Description rdf:about="&a;100360073"
	 b:glossaryEntry="a short theatrical episode"/>
<rdf:Description rdf:about="&a;100360150"
	 b:glossaryEntry="poor acting by a ham actor"/>
<rdf:Description rdf:about="&a;100360243"
	 b:glossaryEntry="ostentatious hammy conduct"/>
<rdf:Description rdf:about="&a;100360323"
	 b:glossaryEntry="acting a particular role (as in psychotherapy)"/>
<rdf:Description rdf:about="&a;100360427"
	 b:glossaryEntry="a trick performed with playing cards"/>
<rdf:Description rdf:about="&a;100360520"
	 b:glossaryEntry="manual dexterity in the execution of tricks"/>
<rdf:Description rdf:about="&a;100360644"
	 b:glossaryEntry="general activity and motion"/>
<rdf:Description rdf:about="&a;100360740"
	 b:glossaryEntry="a confused disturbance far greater than its cause merits"/>
<rdf:Description rdf:about="&a;100360851">
	<b:glossaryEntry>a frenetic disorganized (and often comic) disturbance suggestive of a circus or carnival; "it was so funny it was a circus"; "the whole occasion had a carnival atmosphere"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100361086"
	 b:glossaryEntry="the act of causing disorder"/>
<rdf:Description rdf:about="&a;100361221"
	 b:glossaryEntry="the act of disrupting an established order"/>
<rdf:Description rdf:about="&a;100361333"
	 b:glossaryEntry="the act of surprising someone"/>
<rdf:Description rdf:about="&a;100361442"
	 b:glossaryEntry="the act of making a noisy disturbance"/>
<rdf:Description rdf:about="&a;100361596"
	 b:glossaryEntry="a sudden outburst (as of protest)"/>
<rdf:Description rdf:about="&a;100361708"
	 b:glossaryEntry="violent and needless disturbance"/>
<rdf:Description rdf:about="&a;100361801"
	 b:glossaryEntry="a noisy riotous fight"/>
<rdf:Description rdf:about="&a;100361901"
	 b:glossaryEntry="disturbance usually in protest"/>
<rdf:Description rdf:about="&a;100362034"
	 b:glossaryEntry="a sudden violent disturbance"/>
<rdf:Description rdf:about="&a;100362142"
	 b:glossaryEntry="violently angry and destructive behavior"/>
<rdf:Description rdf:about="&a;100362255">
	<b:glossaryEntry>the act of disturbing the mind or body; "his carelessness could have caused an ecological upset"; "she was unprepared for this sudden overthrow of their normal way of living"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100362507"
	 b:glossaryEntry="a rapid bustling commotion"/>
<rdf:Description rdf:about="&a;100362624">
	<b:glossaryEntry>a sudden flurry of activity (often for no obvious reason); "a burst of applause"; "a fit of housecleaning"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100362788">
	<b:glossaryEntry>the act of moving hurriedly and in a careless manner; "in his haste to leave he forgot his book"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100362997">
	<b:glossaryEntry>the act of moving with great haste; "he made a dash for the door"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100363120"
	 b:glossaryEntry="rushing about hastily in an undignified way"/>
<rdf:Description rdf:about="&a;100363237">
	<b:glossaryEntry>a deliberate coordinated movement requiring dexterity and skill; "he made a great play"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100363615">
	<b:glossaryEntry>a predetermined set of movements in dancing or skating; "she made the best score on compulsory figures"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100363807"
	 b:glossaryEntry="a skating figure that carves an 8 in the ice"/>
<rdf:Description rdf:about="&a;100363910">
	<b:glossaryEntry>a skating figure executed with the skates heel to heel in a straight line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100364042"
	 b:glossaryEntry="a successful forward pass in football"/>
<rdf:Description rdf:about="&a;100364173">
	<b:glossaryEntry>a preset plan of action in team sports; "the coach drew up the plays for her team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100364396">
	<b:glossaryEntry>a skillful maneuver in catching balls or in stealing the ball from the opposing team</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100364539">
	<b:glossaryEntry>in sports (baseball or basketball or ice hockey) the act of enabling another player to make a good play</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100364695">
	<b:glossaryEntry>(ice hockey) the act of shooting the puck from within your own defensive area the length of the rink beyond the opponent''s goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100364910"
	 b:glossaryEntry="a play by the offensive team in a football game"/>
<rdf:Description rdf:about="&a;100365145">
	<b:glossaryEntry>a football play in which a player runs with the ball; "the defensive line braced to stop the run"; "the coach put great emphasis on running"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100365447">
	<b:glossaryEntry>the quarterback moves back as if to pass and then hands the ball to the fullback who is running toward the line of scrimmage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100365634">
	<b:glossaryEntry>the act of running back the football after a kickoff or punt or interception or fumble</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100365792">
	<b:glossaryEntry>(football) an attempt to advance the ball by running into the line; "the linebackers were ready to stop a rush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100365964">
	<b:glossaryEntry>(football) an attempt to advance the ball by running around the end of the line</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100366105">
	<b:glossaryEntry>a football play that involves one player throwing the ball to a teammate; "the coach sent in a passing play on third and long"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100366358">
	<b:glossaryEntry>a football play in which one player hands the ball to a teammate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100366476"
	 b:glossaryEntry="a pass to a receiver downfield from the passer"/>
<rdf:Description rdf:about="&a;100366608">
	<b:glossaryEntry>a forward pass in which the receiver is protected by a screen of blockers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100366739"
	 b:glossaryEntry="a pass to a receiver upfield from the passer"/>
<rdf:Description rdf:about="&a;100366852">
	<b:glossaryEntry>(football) grasping an opposing player with the intention of stopping by throwing to the ground</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100367000"
	 b:glossaryEntry="the performance of a juggler"/>
<rdf:Description rdf:about="&a;100367083"
	 b:glossaryEntry="getting in someone''s way"/>
<rdf:Description rdf:about="&a;100367201">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the act of blocking someone''s path with your body (as in football); "he threw a rolling block into the line backer"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100367431"
	 b:glossaryEntry="(football) an illegal block"/>
<rdf:Description rdf:about="&a;100367515"
	 b:glossaryEntry="obstructing an opponent in ice hockey"/>
<rdf:Description rdf:about="&a;100367659"
	 b:glossaryEntry="an illegal check (chopping at an opponent''s arms or stick)"/>
<rdf:Description rdf:about="&a;100367774">
	<b:glossaryEntry>knocking the puck away by jabbing at it with the hockey stick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100367892">
	<b:glossaryEntry>any exciting and complex play intended to confuse (dazzle) the opponent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100368056"
	 b:glossaryEntry="a play executed by a basketball team"/>
<rdf:Description rdf:about="&a;100368227">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a basketball maneuver; obstructing an opponent with one''s body; "he was called for setting an illegal pick"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100368385">
	<b:glossaryEntry>a basketball maneuver; two defensive players shift assignments so that each guards the player usually guarded by the other</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100368560">
	<b:glossaryEntry>a basketball maneuver; one offensive player passes the ball to another, then runs toward the basket to take a return pass</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100368739"
	 b:glossaryEntry="a play executed by a baseball team"/>
<rdf:Description rdf:about="&a;100368906"
	 b:glossaryEntry="the act of getting two players out on one play"/>
<rdf:Description rdf:about="&a;100369010"
	 b:glossaryEntry="the act of getting three players out on one play"/>
<rdf:Description rdf:about="&a;100369116">
	<b:glossaryEntry>a baseball play in which a runner on third base tries to score as the batter bunts the pitch</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100369303">
	<b:glossaryEntry>the runner on third base starts home as the pitcher delivers the ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100369457">
	<b:glossaryEntry>the runner on third base waits to start home until the batter has bunted successfully</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100369625"
	 b:glossaryEntry="the manner of using the feet"/>
<rdf:Description rdf:about="&a;100369708">
	<b:glossaryEntry>(sports) the act of swinging or striking at a ball with a club or racket or bat or cue or hand; "a good shot require good balance and tempo"; "he left me an almost impossible shot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100370110">
	<b:glossaryEntry>a stroke (in tennis or badminton or squash) that puts reverse spin on the ball; "cuts do not bother a good tennis player"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100370281"
	 b:glossaryEntry="a sweeping stroke or blow"/>
<rdf:Description rdf:about="&a;100370358"
	 b:glossaryEntry="the act of hitting a tennis ball with a tennis racket"/>
<rdf:Description rdf:about="&a;100370521">
	<b:glossaryEntry>a tennis stroke that returns the ball to the other player; "he won the point on a cross-court return"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100370892">
	<b:glossaryEntry>a return made with the palm of the hand facing the direction of the stroke (as in tennis or badminton or squash)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100371093">
	<b:glossaryEntry>hard straight return made on the forehand side (as in tennis or badminton or squash)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100371238">
	<b:glossaryEntry>a return made with the back of the hand facing the direction of the stroke</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100371419"
	 b:glossaryEntry="a hard straight return made on the backhand side"/>
<rdf:Description rdf:about="&a;100371528"
	 b:glossaryEntry="a backhand shot made holding the racquet in both hands"/>
<rdf:Description rdf:about="&a;100371648">
	<b:glossaryEntry>a tennis return made with a downward motion that puts backspin on the ball</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100371785"
	 b:glossaryEntry="a hard straight return (as in tennis or squash)"/>
<rdf:Description rdf:about="&a;100371920">
	<b:glossaryEntry>a stroke (in tennis or badminton or squash) that puts the ball in play; "his powerful serves won the game"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100372142"
	 b:glossaryEntry="a serve that the receiver is unable to reach"/>
<rdf:Description rdf:about="&a;100372236">
	<b:glossaryEntry>a serve that lands outside the prescribed area; "he served too many double faults"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100372370">
	<b:glossaryEntry>a serve that strikes the net before falling into the receiver''s court; the ball must be served again</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100372531"
	 b:glossaryEntry="a tennis return made by hitting the ball before it bounces"/>
<rdf:Description rdf:about="&a;100372660">
	<b:glossaryEntry>a tennis return made by hitting the ball after it has bounced once</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100372804">
	<b:glossaryEntry>a tennis return made by hitting the ball immediately after it bounces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100372931"
	 b:glossaryEntry="an easy return of a tennis ball in a high arc"/>
<rdf:Description rdf:about="&a;100373026"
	 b:glossaryEntry="a hard return hitting the tennis ball above your head"/>
<rdf:Description rdf:about="&a;100373142">
	<b:glossaryEntry>a soft return so that the tennis ball drops abruptly after crossing the net</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100373273">
	<b:glossaryEntry>a tennis return that passes an opponent who has approached the net</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100373398">
	<b:glossaryEntry>any one of the repeated movements of the limbs and body used for locomotion in swimming or rowing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100373566">
	<b:glossaryEntry>a method of moving the arms and legs to push against the water and propel the swimmer forward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100373866">
	<b:glossaryEntry>a swimming stroke; arms are moved alternately overhead accompanied by a flutter kick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100374054"
	 b:glossaryEntry="an elementary swimming stroke imitating a swimming dog"/>
<rdf:Description rdf:about="&a;100374165">
	<b:glossaryEntry>a swimming stroke in which the arms move forward and backward while the legs do a scissors kick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100374336">
	<b:glossaryEntry>a swimming stroke in which the arms are thrown forward together out of the water while the feet kick up and down</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100374542">
	<b:glossaryEntry>a swimming stroke; the arms are extended together in front of the head and swept back on either side accompanied by a frog kick</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100374747">
	<b:glossaryEntry>a swimming stroke that resembles the crawl except the swimmer lies on his or her back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100374908">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in baseball; a batter''s attempt to hit a pitched ball; "he took a vicious cut at the ball"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100375073">
	<b:glossaryEntry>the act of swinging a golf club at a golf ball and (usually) hitting it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100375330"
	 b:glossaryEntry="a swing downward of a golf club"/>
<rdf:Description rdf:about="&a;100375417">
	<b:glossaryEntry>a golf shot that curves to the right for a right-handed golfer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100375538">
	<b:glossaryEntry>a golf shot that curves to the left for a right-handed golfer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100375657">
	<b:glossaryEntry>hitting a golf ball off of a tee with a driver; "he sliced his drive out of bounds"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100375802"
	 b:glossaryEntry="hitting a golf ball on the putting surface with a putter"/>
<rdf:Description rdf:about="&a;100375919">
	<b:glossaryEntry>a form of golf in which you putt from positions arranged on the circumference of a circle around the hole</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100376081">
	<b:glossaryEntry>a relatively short golf shot intended to put the ball onto the putting green; "he lost the hole when his approach rolled over the green"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100376324"
	 b:glossaryEntry="a low running approach shot"/>
<rdf:Description rdf:about="&a;100376414"
	 b:glossaryEntry="a high approach shot in golf"/>
<rdf:Description rdf:about="&a;100376507"
	 b:glossaryEntry="a movement of the legs in swimming"/>
<rdf:Description rdf:about="&a;100376710">
	<b:glossaryEntry>a swimming kick; the legs are moved rapidly up and down without bending the knees</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100376888">
	<b:glossaryEntry>a swimming kick; knees are drawn upward and outward so the legs can be brought together when fully extended</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100377070"
	 b:glossaryEntry="a swimming kick; an up and down kick of the feet together"/>
<rdf:Description rdf:about="&a;100377205">
	<b:glossaryEntry>a kick used in the sidestroke; legs are brought together in a scissoring motion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100377363"
	 b:glossaryEntry="a swimming kick used while treading water"/>
<rdf:Description rdf:about="&a;100377476">
	<b:glossaryEntry>a stroke that keeps the head above water by thrashing the legs and arms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100377627">
	<b:glossaryEntry>any activity that is easy to do; "marketing this product will be no picnic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100377835">
	<b:glossaryEntry>activity directed toward making or doing something; "she checked several points needing further work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100378419">
	<b:glossaryEntry>a damaging piece of work: "dry rot did the job of destroying the barn"; "the barber did a real job on my hair"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100378579">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an act or process or manner of functioning or operating: "the power of its engine determines its operation": "the plane''s performance in high winds"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100378829">
	<b:glossaryEntry>the performance of a piece of work; "she did an outstanding job as Ophelia"; "he gave it up as a bad job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100378984">
	<b:glossaryEntry>a process or series of acts especially of a practical or mechanical nature involved in a particular form of work: "the operations in building a house"; "certain machine tool operations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100379237">
	<b:glossaryEntry>performance of moral or religious acts; "salvation by deeds" or "the reward for good works"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100379388">
	<b:glossaryEntry>work done by one person or group that benefits another; "budget separately for goods and services"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100379558"
	 b:glossaryEntry="washing clothes and bed linens"/>
<rdf:Description rdf:about="&a;100379645">
	<b:glossaryEntry>the work of making something shine by polishing it; "he performed the menial chore of shining shoes"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100379811">
	<b:glossaryEntry>the service provided by a utility company; "the cost of utilities never decreases"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100379947">
	<b:glossaryEntry>(common law) the acts performed by an English feudal tenant for the benefit of his lord which formed the consideration for the property granted to him</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100380205">
	<b:glossaryEntry>land tenure by agricultural service or payment of rent; not burdened with military service</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100380348"
	 b:glossaryEntry="land tenure by service in the lord''s army"/>
<rdf:Description rdf:about="&a;100380452"
	 b:glossaryEntry="land tenure by service to the lord as a knight"/>
<rdf:Description rdf:about="&a;100380561"
	 b:glossaryEntry="the work of a housewife"/>
<rdf:Description rdf:about="&a;100380642"
	 b:glossaryEntry="the work of cleaning and running a house"/>
<rdf:Description rdf:about="&a;100380753"
	 b:glossaryEntry="the work of ironing washed clothes"/>
<rdf:Description rdf:about="&a;100380841"
	 b:glossaryEntry="work that a person is expected to do in a specified time"/>
<rdf:Description rdf:about="&a;100380970">
	<b:glossaryEntry>the number of cases handled in a given period of time (as by a court or agency)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100381105"
	 b:glossaryEntry="work paid for according to the quantity produced"/>
<rdf:Description rdf:about="&a;100381209">
	<b:glossaryEntry>active work of little value; "while he was waiting he filled the days with busywork"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100381360"
	 b:glossaryEntry="the work of cutting down trees for timber"/>
<rdf:Description rdf:about="&a;100381455"
	 b:glossaryEntry="work that is left incomplete"/>
<rdf:Description rdf:about="&a;100381561"
	 b:glossaryEntry="work to be done at night"/>
<rdf:Description rdf:about="&a;100381641">
	<b:glossaryEntry>work that involves handling papers: forms or letters or reports etc.</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100381765">
	<b:glossaryEntry>an organized activity to improve the condition of disadvantaged people in society</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100381958">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the principal activity in your life; "he''s not in my line of business"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100382316">
	<b:glossaryEntry xml:space='preserve'><![CDATA[any activity that occupies a person''s attention; "he missed the bell in his occupation with the computer game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100382483">
	<b:glossaryEntry xml:space='preserve'><![CDATA[informal terms for your occupation; "he''s in the plumbing game"; "she''s in show biz"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100382624"
	 b:glossaryEntry="the particular occupation for which you are trained"/>
<rdf:Description rdf:about="&a;100382821">
	<b:glossaryEntry>the special line of work you have adopted as your career; "his specialization is gastroenterology"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100383035">
	<b:glossaryEntry>the act of specializing; making something suitable for a special purpose</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100383185">
	<b:glossaryEntry>the act of making something spiritual; infusing it with spiritual content</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100383340"
	 b:glossaryEntry="becoming urbanized; changing from a rural to an urban state"/>
<rdf:Description rdf:about="&a;100383458">
	<b:glossaryEntry>familiarizing with or converting to customs and practices of Western civilization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100383600"
	 b:glossaryEntry="the principal work of your career"/>
<rdf:Description rdf:about="&a;100383688"
	 b:glossaryEntry='careers in general; "it happens in all walks of life"'/>
<rdf:Description rdf:about="&a;100383807">
	<b:glossaryEntry>the occupation for which you are paid; "he is looking for a job"; "a lot of people are out of work"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100384174">
	<b:glossaryEntry>the responsibility to do something; "it is their job to print the truth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100384296">
	<b:glossaryEntry>employment in work for another; "he retired after 30 years of service"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100384420">
	<b:glossaryEntry>performance of duties helpful to others; "the mayor tried to maintain city services" or "the medical services are excellent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100384599">
	<b:glossaryEntry>employment within a government system (especially in civil service)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100384745"
	 b:glossaryEntry="(British) the job of a head of a government department"/>
<rdf:Description rdf:about="&a;100384872">
	<b:glossaryEntry>(British) the job of a senior minister who is a member of the British cabinet</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100385049">
	<b:glossaryEntry>the position of the cabinet minister who is in charge of government affairs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100385219">
	<b:glossaryEntry>the job to which you are (or hope to be) appointed; "he applied for an appointment in the treasury"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100385376">
	<b:glossaryEntry>a job in an organization or hierarchy; "he ocupied a post in the treasury"</b:glossaryEntry>
</rdf:Description>
