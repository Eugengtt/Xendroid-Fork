<rdf:Description rdf:about="&a;201569933"
	 b:glossaryEntry="share a room or a bed designed for only one person"/>
<rdf:Description rdf:about="&a;201570058"
	 b:glossaryEntry='combine into a common fund; "We pooled resources"'/>
<rdf:Description rdf:about="&a;201570177"
	 b:glossaryEntry="make something the property of the commune or community"/>
<rdf:Description rdf:about="&a;201570315"
	 b:glossaryEntry='tell, give knowledge; "give a secret to the Russians"'/>
<rdf:Description rdf:about="&a;201570483"
	 b:glossaryEntry="make a tender of; in legal settlements"/>
<rdf:Description rdf:about="&a;201570585"
	 b:glossaryEntry="offer or present for acceptance"/>
<rdf:Description rdf:about="&a;201570696">
	<b:glossaryEntry>make available or accessible, provide or furnish; "The conference center offers a health spa"; "The hotel offers private meeting rooms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201570936"
	 b:glossaryEntry="provide with traffic signals, as of an intersection"/>
<rdf:Description rdf:about="&a;201571054">
	<b:glossaryEntry>present for acceptance or rejection; ; "She offered us all a cold drink"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201571251">
	<b:glossaryEntry>make available for sale; "The stores are offering specials on sweaters this week"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201571395">
	<b:glossaryEntry>offer verbally: "extend my greetings"; "He offered his sympathy"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201571565">
	<b:glossaryEntry>make available; provide; "extend a loan"; "The bank offers a good deal on new mortgages"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201571759"
	 b:glossaryEntry="have or produce for sale"/>
<rdf:Description rdf:about="&a;201571865"
	 b:glossaryEntry="deal in a market"/>
<rdf:Description rdf:about="&a;201571953">
	<b:glossaryEntry>propose a payment; as at sales or auctions; "The Swiss dealer offered $2 million for the painting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201572253"
	 b:glossaryEntry="bid on behalf of someone else"/>
<rdf:Description rdf:about="&a;201572346">
	<b:glossaryEntry>off to buy, as of stocks and shares: "The broker subscribed 500 shares"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201572484"
	 b:glossaryEntry="bid more than the object is worth, as during an auction"/>
<rdf:Description rdf:about="&a;201572622"
	 b:glossaryEntry="bid too low"/>
<rdf:Description rdf:about="&a;201572717"
	 b:glossaryEntry="bid higher than others"/>
<rdf:Description rdf:about="&a;201572821"
	 b:glossaryEntry="bid lower than a competing bidder"/>
<rdf:Description rdf:about="&a;201572938">
	<b:glossaryEntry>make a demand in card games, as for a card or a suit or a show of hands; "He called his trump"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201573208">
	<b:glossaryEntry>make a higher bid than (the previous bid or player); in a card game</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201573340">
	<b:glossaryEntry>bid (a hand of cards) at less than the strength of the hand warrants</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201573474">
	<b:glossaryEntry>bid over an opponent''s bid when one''s partner has not bid or doubled, in Bridge</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201573617"
	 b:glossaryEntry="to bid for more tricks than one can expect to win, in Bridge"/>
<rdf:Description rdf:about="&a;201573742"
	 b:glossaryEntry="make a preemptive bid; in bridge"/>
<rdf:Description rdf:about="&a;201573839"
	 b:glossaryEntry="pay out"/>
<rdf:Description rdf:about="&a;201573930">
	<b:glossaryEntry>be owned by; be in the possession of; "This book belongs to me"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201574057">
	<b:glossaryEntry xml:space='preserve'><![CDATA[take on as one''s own expenses or debts of another person; "I''ll accept the charges"; "She agreed to bear the responsibility"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201574273">
	<b:glossaryEntry>have rightfully; of rights, titles, and offices; "She bears the title of Duchess"; "He held the governorship for almost a decade"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201574471"
	 b:glossaryEntry="acquire by preemption"/>
<rdf:Description rdf:about="&a;201574557"
	 b:glossaryEntry="sell or offer for sale from place to place"/>
<rdf:Description rdf:about="&a;201574705"
	 b:glossaryEntry="forgo; do or go without"/>
<rdf:Description rdf:about="&a;201574799"
	 b:glossaryEntry="lose or lose the right to by some error, offense, or crime"/>
<rdf:Description rdf:about="&a;201575011"
	 b:glossaryEntry='let slip; "He lapsed his membership"'/>
<rdf:Description rdf:about="&a;201575110"
	 b:glossaryEntry="take after a conquest or invasion; as of land"/>
<rdf:Description rdf:about="&a;201575276">
	<b:glossaryEntry>capture after a fight; "The troops carried the town after a brief fight"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201575411">
	<b:glossaryEntry>take back by force, as after a battle; "The military forces managed to recapture the fort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201575585">
	<b:glossaryEntry>bring about the capture of an elementary particle or celestial body and causing it enter a new orbit; "This nucleus has captured the slow-moving neutrons"; "The star captured a comet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201575833"
	 b:glossaryEntry='be captured; "The cities fell to the enemy"'/>
<rdf:Description rdf:about="&a;201575938">
	<b:glossaryEntry>get hold of or seize quickly and easily; "I snapped up all the good buys during the garage sale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201576134"
	 b:glossaryEntry="take greedily; take more than one''s share"/>
<rdf:Description rdf:about="&a;201576236"
	 b:glossaryEntry="get together"/>
<rdf:Description rdf:about="&a;201576416">
	<b:glossaryEntry>gather or collect; "You can get the results on Monday"; "She picked up the children at the day care center"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201576630"
	 b:glossaryEntry="save up as for future use"/>
<rdf:Description rdf:about="&a;201576771"
	 b:glossaryEntry="store honey or pollen, as of bees"/>
<rdf:Description rdf:about="&a;201576902">
	<b:glossaryEntry>collect funds for a specific purpose; "The President raised several million dollars for his college"</b:glossaryEntry>
</rdf:Description>
