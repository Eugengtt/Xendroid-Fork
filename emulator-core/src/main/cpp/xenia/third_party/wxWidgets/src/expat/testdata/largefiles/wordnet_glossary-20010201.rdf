	 b:glossaryEntry="break in the staves (of), as of a cask"/>
<rdf:Description rdf:about="&a;200232275"
	 b:glossaryEntry="break apart or in two, using violence"/>
<rdf:Description rdf:about="&a;200232384">
	<b:glossaryEntry>break into pieces, as by striking or knocking over; "Smash a plate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200232529">
	<b:glossaryEntry>become fractured; break or crack on the surface only; "The glass cracked when it was heated"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200232754"
	 b:glossaryEntry='make cracks or chinks in; "The heat checked the paint"'/>
