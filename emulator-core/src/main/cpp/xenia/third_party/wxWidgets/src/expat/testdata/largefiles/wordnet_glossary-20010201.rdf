</rdf:Description>
<rdf:Description rdf:about="&a;103890352"
	 b:glossaryEntry="a sickly yellowish skin color"/>
<rdf:Description rdf:about="&a;103890438"
	 b:glossaryEntry="a tawny complexion"/>
<rdf:Description rdf:about="&a;103890512"
	 b:glossaryEntry="a swarthy complexion"/>
<rdf:Description rdf:about="&a;103890613">
	<b:glossaryEntry>(computer science) a color produced by a pattern of differently colored dots that together simulate the desired color</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103890844">
	<b:glossaryEntry>coloration making an organism less visible or attractive to predators</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103891035">
	<b:glossaryEntry xml:space='preserve'><![CDATA[conspicuous coloration or markings of an animal serving to warn off predators: "a skunk''s aposematic coloration"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103891236"
	 b:glossaryEntry="coloring serving to as natural camouflage"/>
<rdf:Description rdf:about="&a;103891343"
	 b:glossaryEntry="coloring that conceals or disguises an animal''s shape"/>
<rdf:Description rdf:about="&a;103891461">
	<b:glossaryEntry>relative darkness or lightness of a color: "I establish the colors and principal values by organizing the painting into three values--dark, medium...and light"-Joe Hing Lowe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103891794"
	 b:glossaryEntry="having a light color"/>
<rdf:Description rdf:about="&a;103891888"
	 b:glossaryEntry="having a dark or somber color"/>
<rdf:Description rdf:about="&a;103891990"
	 b:glossaryEntry="any property detected by the olfactory system"/>
<rdf:Description rdf:about="&a;103892211"
	 b:glossaryEntry="a pleasingly sweet olfactory property"/>
<rdf:Description rdf:about="&a;103892338"
	 b:glossaryEntry="the attribute of having a strong offensive smell"/>
<rdf:Description rdf:about="&a;103892518"
	 b:glossaryEntry="malodourousness resulting from a failure to bathe"/>
<rdf:Description rdf:about="&a;103892643">
	<b:glossaryEntry>the particular auditory effect produced by a given cause; "the sound of rain on the roof" or "the beautiful sound of music"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103892908"
	 b:glossaryEntry="characterized by loud and constant noise"/>
<rdf:Description rdf:about="&a;103893036"
	 b:glossaryEntry='a characteristic sound; "it has the ring of sincerity"'/>
<rdf:Description rdf:about="&a;103893141">
	<b:glossaryEntry>two or more sounds or tones at the same pitch or in octaves: "singing in unison"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103893274">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the distinctive quality or pitch or condition of a person''s speech; "A shrill voice sounded behind us"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103893446"
	 b:glossaryEntry="a woman''s voice with male qualities"/>
<rdf:Description rdf:about="&a;103893540">
	<b:glossaryEntry>the absence of sound; "he needed silence in order to sleep"; "the street was quiet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103893757"
	 b:glossaryEntry='(poetic) tranquil silence; "the still of the night"'/>
<rdf:Description rdf:about="&a;103893879"
	 b:glossaryEntry="the property of being speechless"/>
<rdf:Description rdf:about="&a;103893972"
	 b:glossaryEntry="the property of making no sound"/>
<rdf:Description rdf:about="&a;103894093"
