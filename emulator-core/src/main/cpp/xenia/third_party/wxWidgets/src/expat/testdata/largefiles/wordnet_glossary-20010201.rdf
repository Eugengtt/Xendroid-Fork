</rdf:Description>
<rdf:Description rdf:about="&a;108066046">
	<b:glossaryEntry>any of various tropical shrubs or trees of the genus Mimosa having usually yellow flowers and compound leaves</b:glossaryEntry>
</rdf:Description>
