	 b:glossaryEntry="water pimpernel of Europe to China"/>
<rdf:Description rdf:about="&a;108403911"
	 b:glossaryEntry="American water pimpernel"/>
<rdf:Description rdf:about="&a;108404035">
	<b:glossaryEntry>family of Old World tropical trees and shrubs; some in Florida</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108404250">
	<b:glossaryEntry>evergreen trees and shrubs having aromatic foliage; Africa; Asia: New Zealand</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108404416">
	<b:glossaryEntry>tropical evergreen subshrubs (some climbers) to trees of Asia and Australasia to Americas</b:glossaryEntry>
</rdf:Description>
