</rdf:Description>
<rdf:Description rdf:about="&a;110814391"
	 b:glossaryEntry="a soft thin (usually translucent) paper"/>
<rdf:Description rdf:about="&a;110814570"
	 b:glossaryEntry="a soft thin absorbent paper for use in toilets"/>
<rdf:Description rdf:about="&a;110814727"
	 b:glossaryEntry="a roll of toilet paper"/>
<rdf:Description rdf:about="&a;110814807">
