</rdf:Description>
<rdf:Description rdf:about="&a;102012165"
	 b:glossaryEntry="catfish common in eastern United States"/>
<rdf:Description rdf:about="&a;102012297"
	 b:glossaryEntry="freshwater catfish of eastern United States"/>
<rdf:Description rdf:about="&a;102012401"
	 b:glossaryEntry="channel catfishes"/>
<rdf:Description rdf:about="&a;102012511"
