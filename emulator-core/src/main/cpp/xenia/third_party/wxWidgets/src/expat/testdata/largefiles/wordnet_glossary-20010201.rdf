	<b:glossaryEntry>gum from an acacia tree; used as a thickener (especially in candies and pharmaceuticals)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110692334"
	 b:glossaryEntry="from the vicinity of the Senegal river"/>
<rdf:Description rdf:about="&a;110692430"
	 b:glossaryEntry="dried juice of the dhak tree; used as an astringent"/>
<rdf:Description rdf:about="&a;110692576">
	<b:glossaryEntry>obtained from various tropical plants; used as an astringent and in tanning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110692724"
	 b:glossaryEntry="obtained from mesquite pods; resembles gum arabic"/>
<rdf:Description rdf:about="&a;110692832"
	 b:glossaryEntry="a gelatinous substance secreted by plants"/>
<rdf:Description rdf:about="&a;110692928">
