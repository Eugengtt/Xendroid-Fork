	 b:glossaryEntry="inflammation of the peritoneum"/>
<rdf:Description rdf:about="&a;110297620"
	 b:glossaryEntry="inflammation of a finger or toe"/>
<rdf:Description rdf:about="&a;110297709"
	 b:glossaryEntry="inflammation of a vein"/>
<rdf:Description rdf:about="&a;110297805"
	 b:glossaryEntry="inflammation of many or all of the peripheral nerves"/>
<rdf:Description rdf:about="&a;110297916">
	<b:glossaryEntry>phlebitis in conjunction with the formation of a blood clot (thrombus)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110298049">
	<b:glossaryEntry>inflammation of the lungs; caused by a virus or an allergic reaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;110298175"
	 b:glossaryEntry="inflammation of many muscles"/>
<rdf:Description rdf:about="&a;110298262">
	<b:glossaryEntry>inflammation of the foreskin of the penis; usually caused by bacterial infection</b:glossaryEntry>
</rdf:Description>
