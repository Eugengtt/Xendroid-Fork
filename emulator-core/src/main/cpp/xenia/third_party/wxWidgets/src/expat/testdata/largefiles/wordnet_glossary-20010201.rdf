	 b:glossaryEntry="goatsucker of western North America"/>
<rdf:Description rdf:about="&a;101353665"
	 b:glossaryEntry="frogmouths"/>
<rdf:Description rdf:about="&a;101353809"
	 b:glossaryEntry="type genus of the Podargidae"/>
<rdf:Description rdf:about="&a;101353928">
	<b:glossaryEntry>insectivorous bird of Australia and southeastern Asia having a wide frog-like mouth</b:glossaryEntry>
