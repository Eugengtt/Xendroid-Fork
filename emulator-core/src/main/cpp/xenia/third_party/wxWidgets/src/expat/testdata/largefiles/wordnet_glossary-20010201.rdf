<rdf:Description rdf:about="&a;400253851"
	 b:glossaryEntry='toward the outside; "move the needle further outward!"'/>
<rdf:Description rdf:about="&a;400253970"
	 b:glossaryEntry='up to the knees; "we were standing knee-deep in the water"'/>
<rdf:Description rdf:about="&a;400254078">
