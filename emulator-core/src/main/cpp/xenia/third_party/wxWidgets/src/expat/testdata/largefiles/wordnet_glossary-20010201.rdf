</rdf:Description>
<rdf:Description rdf:about="&a;108137440">
	<b:glossaryEntry>used in former classifications systems; now included in genus Alternanthera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108137610"
	 b:glossaryEntry="family coextensive with genus Batis: saltworts"/>
<rdf:Description rdf:about="&a;108137789">
	<b:glossaryEntry>small genus of plants constituting the family Batidaceae: low straggling dioecious shrubs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108137982">
	<b:glossaryEntry>low-growing strong-smelling coastal shrub of warm parts of the New World having unisexual flowers in conelike spikes and thick succulent leaves</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108138216"
	 b:glossaryEntry="includes spinach and beets"/>
<rdf:Description rdf:about="&a;108138554"
	 b:glossaryEntry="goosefoot; pigweed"/>
<rdf:Description rdf:about="&a;108138688">
	<b:glossaryEntry>any of various weeds of the genus Chenopodium having small greenish flowers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108139018">
	<b:glossaryEntry>common weedy European plant introduced into North America; often used as a potherb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108139245"
	 b:glossaryEntry="rank-smelling tropical American pigweed"/>
<rdf:Description rdf:about="&a;108139414">
	<b:glossaryEntry>European plant naturalized in North America; often collected from the wild as a potherb</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108139646">
	<b:glossaryEntry>Eurasian aromatic oak-leaved goosefoot with many yellow-green flowers; naturalized North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108139877">
	<b:glossaryEntry>European annual with clusters of greenish flowers followed by red pulpy berrylike fruit; naturalized North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108140114">
	<b:glossaryEntry>annual European plant with spikes of greenish flowers and leaves that are white-hairy beneath; common as a weed in North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108140351"
	 b:glossaryEntry="herb considered fatal to swine"/>
<rdf:Description rdf:about="&a;108140474">
	<b:glossaryEntry>European annual with coarsely dentate leaves; widespread in United States and southern Canada</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108140681"
	 b:glossaryEntry="common Eurasian weed; naturalized in United States"/>
<rdf:Description rdf:about="&a;108140829">
	<b:glossaryEntry>European goosefoot with strong-scented foliage; adventive in eastern North America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108140999"
	 b:glossaryEntry="orach; saltbush"/>
<rdf:Description rdf:about="&a;108141143">
	<b:glossaryEntry>any of various herbaceous plants of the genus Atriplex that thrive in deserts and salt marshes</b:glossaryEntry>
</rdf:Description>
