</rdf:Description>
<rdf:Description rdf:about="&a;102019190"
	 b:glossaryEntry="young eel"/>
<rdf:Description rdf:about="&a;102019251">
	<b:glossaryEntry>eels that live in fresh water as adults but return to the sea to spawn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102019438"
	 b:glossaryEntry="type genus of the Anguillidae: eels"/>
<rdf:Description rdf:about="&a;102019583">
