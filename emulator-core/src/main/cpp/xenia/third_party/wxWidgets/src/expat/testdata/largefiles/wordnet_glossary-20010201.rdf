<rdf:Description rdf:about="&a;400258400">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in or into a field (especially a field of battle); "the armies were afield, challenging the enemy''s advance"; "unlawful to carry hunting rifles afield until the season opens"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400258609">
