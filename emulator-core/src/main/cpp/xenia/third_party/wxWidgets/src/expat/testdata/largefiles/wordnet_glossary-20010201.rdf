<rdf:Description rdf:about="&a;201529391"
	 b:glossaryEntry="surrender, as a result of pressure or force"/>
<rdf:Description rdf:about="&a;201529508">
	<b:glossaryEntry>give up for a price or reward: "She sold her principles for a successful career"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;201529684">
