<rdf:Description rdf:about="&a;100399414"
	 b:glossaryEntry="the position of warder"/>
<rdf:Description rdf:about="&a;100399493"
	 b:glossaryEntry="a job involving drudgery and confinement"/>
<rdf:Description rdf:about="&a;100399601">
	<b:glossaryEntry>a career in industrial or commercial or professional activities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100399744">
	<b:glossaryEntry>the skilled practice of a practical occupation; "he learned his trade as an apprentice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100400269"
	 b:glossaryEntry="the craft of building and repairing airplanes"/>
<rdf:Description rdf:about="&a;100400379"
	 b:glossaryEntry="the craft of building and repairing automobiles"/>
<rdf:Description rdf:about="&a;100400487"
	 b:glossaryEntry="the craft of basket making"/>
<rdf:Description rdf:about="&a;100400568"
	 b:glossaryEntry="the craft of binding books"/>
<rdf:Description rdf:about="&a;100400652"
	 b:glossaryEntry="the craft of laying bricks"/>
<rdf:Description rdf:about="&a;100400736">
	<b:glossaryEntry>the craft of making furniture (especially furniture of high quality)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100400874"
	 b:glossaryEntry="the craft of a carpenter: making things out of wood"/>
<rdf:Description rdf:about="&a;100401042"
	 b:glossaryEntry="the craft of drawing blueprints"/>
<rdf:Description rdf:about="&a;100401149"
	 b:glossaryEntry="the craft of making dresses"/>
<rdf:Description rdf:about="&a;100401252"
	 b:glossaryEntry="the craft of an electrician"/>
<rdf:Description rdf:about="&a;100401341">
	<b:glossaryEntry>the trade of planning the layout and furnishings of an architectural interior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100401520">
	<b:glossaryEntry>the craft of providing artificial light; "an interior decorator must understand lighting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100401664"
	 b:glossaryEntry="the craft of a mason"/>
<rdf:Description rdf:about="&a;100401775">
	<b:glossaryEntry>the occupation of a house painter; "house painting was the only craft he knew"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100401944">
	<b:glossaryEntry>the occupation of a plumber (installing and repairing pipes and fixtures for water or gas or sewage in a building)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100402143"
	 b:glossaryEntry="the craft of making earthenware"/>
<rdf:Description rdf:about="&a;100402228">
	<b:glossaryEntry>an occupation requiring special education (especially in the liberal arts or sciences)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100402497">
	<b:glossaryEntry>an occupation for which you are especially well suited; "in law he found his true metier"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100402648">
	<b:glossaryEntry>one of the three professions traditionally believed to require advanced learning and high principles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100402867">
	<b:glossaryEntry>the profession or art of a writer; "her place in literature is secure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100402994">
	<b:glossaryEntry>the profession of designing buildings and environments with consideration for their esthetic effect</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100403152">
	<b:glossaryEntry>the learned profession that is mastered by graduate study in a law school and that is responsible for the judicial system; "he studied law at Yale"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100403367">
	<b:glossaryEntry>the profession of teaching (especially at a school or college or university)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100403517">
	<b:glossaryEntry>the profession of reporting or photographing or editing news stories for one of the media</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100403663"
	 b:glossaryEntry="the profession devoted to governing and to political affairs"/>
<rdf:Description rdf:about="&a;100403778">
	<b:glossaryEntry>the learned profession that is mastered by graduate training in a medical school and that is devoted to preventing or alleviating or curing diseases and injuries; "he studied medicine at Harvard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100404087"
	 b:glossaryEntry="the branch of medicine concerned with preventing disease"/>
<rdf:Description rdf:about="&a;100404209">
	<b:glossaryEntry>the practice of medicine without the use of drugs; may involve self-awareness</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100404378">
	<b:glossaryEntry>the learned profession acquired by specialized courses in religion (usually taught at a college or seminary); "he studied theology at Oxford"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100404574">
	<b:glossaryEntry>the activity of putting something in written form: "she did the thinking while he did the writing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100404780">
	<b:glossaryEntry>the activity of writing by hand: "handwriting can be slow and painful for one with arthritis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100404931">
	<b:glossaryEntry>the act or art of writing in shorthand: "stenography is no longer a marketable skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100405074"
	 b:glossaryEntry="act of writing in code"/>
<rdf:Description rdf:about="&a;100405203"
	 b:glossaryEntry="the activity of converting from plain text into code"/>
<rdf:Description rdf:about="&a;100405341">
	<b:glossaryEntry>encoding information while reducing the bandwidth or bits required</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100405501"
	 b:glossaryEntry="the compression of graphics for storage or transmission"/>
<rdf:Description rdf:about="&a;100405620">
	<b:glossaryEntry>restoring compressed information to its normal form for use or display</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100405768"
	 b:glossaryEntry="converting from one code to another"/>
<rdf:Description rdf:about="&a;100405858">
	<b:glossaryEntry>the activity of making clear or converting from code into plain text</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100406027">
	<b:glossaryEntry>the practice of measuring angles and distances on the ground so that they can be accurately plotted on a map</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100406209">
	<b:glossaryEntry>a method of surveying; the area is divided into triangles and the length of one side and its angles with the other two are measured, then the lengths of the other sides can be calculated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100406455"
	 b:glossaryEntry="the draft of a joiner"/>
<rdf:Description rdf:about="&a;100406546"
	 b:glossaryEntry="the craft of making fireworks"/>
<rdf:Description rdf:about="&a;100406647"
	 b:glossaryEntry="the shoemaker''s trade"/>
<rdf:Description rdf:about="&a;100406753"
	 b:glossaryEntry="the craft of a roofer"/>
<rdf:Description rdf:about="&a;100406865">
	<b:glossaryEntry>the craft of doing sheet metal work (as in ventilation systems)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100407010"
	 b:glossaryEntry="the occupation of a tailor"/>
<rdf:Description rdf:about="&a;100407092"
	 b:glossaryEntry="the craft of making special tools and dies"/>
<rdf:Description rdf:about="&a;100407198"
	 b:glossaryEntry="high fashion designing and dressmaking"/>
<rdf:Description rdf:about="&a;100407290">
	<b:glossaryEntry>the occupation of maintaining and auditing records and preparing financial reports for a business</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100407494"
	 b:glossaryEntry="keeping account of the costs of items in production"/>
<rdf:Description rdf:about="&a;100407625"
	 b:glossaryEntry="(British) cost accounting"/>
<rdf:Description rdf:about="&a;100407704"
	 b:glossaryEntry="the activity of recording business transactions"/>
<rdf:Description rdf:about="&a;100407856">
	<b:glossaryEntry>a simple bookkeeping system; transactions are entered in only one account</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100408015">
	<b:glossaryEntry>bookkeeper debits the transaction to one account and credits it to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100408175"
	 b:glossaryEntry="the business of a butcher"/>
<rdf:Description rdf:about="&a;100408287">
	<b:glossaryEntry>the occupation of taking and printing photographs or making movies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100408411">
	<b:glossaryEntry>productive work (especially physical work done for wages); "his labor did not require a great deal of skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100408767">
	<b:glossaryEntry>productive work performed voluntarily without material reward or compensation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100408921">
	<b:glossaryEntry>confrontational activities intended to break up a strike by workers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100409049">
	<b:glossaryEntry>unpaid labor (as for the maintenance of roads) required by a lord of his vassals in lieu of taxes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100409199"
	 b:glossaryEntry="hard monotonous routine work"/>
<rdf:Description rdf:about="&a;100409314">
	<b:glossaryEntry>use of physical or mental energy; hard work; "he got an A for effort"; "they managed only with great exertion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100409719">
	<b:glossaryEntry>strenuous effort; "the struggle to get through the crowd exhausted her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100409863">
	<b:glossaryEntry>the act of engaging in close hand-to-hand combat; "they had a fierce wrestle"; "we watched his grappling and wrestling with the bully"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100410109">
	<b:glossaryEntry>the work of finding and killing or capturing animals for food or pelts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100410276"
	 b:glossaryEntry="professional work done according to formula"/>
<rdf:Description rdf:about="&a;100410374"
	 b:glossaryEntry="cutting grass and curing it to make hay"/>
<rdf:Description rdf:about="&a;100410469"
	 b:glossaryEntry="taking full advantage of an opportunity while it lasts"/>
<rdf:Description rdf:about="&a;100410579"
	 b:glossaryEntry="labor done with the hands"/>
<rdf:Description rdf:about="&a;100410787">
	<b:glossaryEntry>the act working too much or too long; "he became ill from overwork"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100410923"
	 b:glossaryEntry="work done under harsh conditions for little or no pay"/>
<rdf:Description rdf:about="&a;100411030">
	<b:glossaryEntry>working as a substitute for someone who is ill or on leave of absence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100411168">
	<b:glossaryEntry>an effort that is inconvenient; "I went to a lot of trouble"; "he won without any trouble"; "had difficulty walking"; "finished the test only with great difficulty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100411399"
	 b:glossaryEntry="the least effortful way to do something"/>
<rdf:Description rdf:about="&a;100411516"
	 b:glossaryEntry="an intense or violent exertion"/>
<rdf:Description rdf:about="&a;100411620">
	<b:glossaryEntry>the activity of exerting you muscles in various was to keep fit; "the doctor recommended regular exercise"; "he did some exercising"; "the physical exertion required by his work kept him fit"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100412181"
	 b:glossaryEntry='a sustained effort; "it was a long pull but we made it"'/>
<rdf:Description rdf:about="&a;100412287">
	<b:glossaryEntry>exercise that conditions the body; "farmwork can be a good conditioner"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100412416">
	<b:glossaryEntry>several exercises intended to be done in series; "he did four sets of the incline bench press"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100412575"
	 b:glossaryEntry="exercise that increases the need for oxygen"/>
<rdf:Description rdf:about="&a;100412692"
	 b:glossaryEntry="exercise that builds muscles through tension"/>
<rdf:Description rdf:about="&a;100412869"
	 b:glossaryEntry="exercise by lifting weights"/>
<rdf:Description rdf:about="&a;100413028">
	<b:glossaryEntry>a weightlifting exercise in which you lie on your back on a bench and press weights upward</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100413194"
	 b:glossaryEntry="a bench press performed on an inclined bench"/>
<rdf:Description rdf:about="&a;100413304">
	<b:glossaryEntry>a weightlift in which the barbell is lifted to shoulder height and then jerked overhead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100413460">
	<b:glossaryEntry>a weightlift in which the barbell is lifted to shoulder height and then smoothly lifted overhead</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100413625">
	<b:glossaryEntry>a weightlift in which the barbell is lifted overhead in one rapid motion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100413750"
	 b:glossaryEntry="bodybuilding that increases muscle mass and body weight"/>
<rdf:Description rdf:about="&a;100413866"
	 b:glossaryEntry="light exercise designed to promote general fitness"/>
<rdf:Description rdf:about="&a;100414038">
	<b:glossaryEntry>muscle-building exercises involving muscular contractions against resistance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100414171"
	 b:glossaryEntry="running at a jog trot as a form of exercise"/>
<rdf:Description rdf:about="&a;100414268">
	<b:glossaryEntry>exercise designed to extend the limbs and muscles to their full extent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100414405"
	 b:glossaryEntry="exercise designed to strengthen the arm muscles"/>
<rdf:Description rdf:about="&a;100414547">
	<b:glossaryEntry>an arm exercise performed lying face to the floor and pushing the body up and down with the arms</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100414725"
	 b:glossaryEntry="a pushup with the arms widely separated"/>
<rdf:Description rdf:about="&a;100414826">
	<b:glossaryEntry>an arm exercise performed by pulling yourself up on a horizontal bar until your chin is level with the bar</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100414986"
	 b:glossaryEntry="exercise designed to strengthen the back muscles"/>
<rdf:Description rdf:about="&a;100415094"
	 b:glossaryEntry="exercise designed to strengthen the leg muscles"/>
<rdf:Description rdf:about="&a;100415254">
	<b:glossaryEntry>exercising by repeatedly assuming a squatting position; strengthens the leg muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100415401">
	<b:glossaryEntry>an exercise designed to strength the flexor muscles of the leg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100415532">
	<b:glossaryEntry>an exercise designed to strengthen the extensor muscles of the leg</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100415657"
	 b:glossaryEntry="exercise designed to strengthen the neck muscles"/>
<rdf:Description rdf:about="&a;100415765"
	 b:glossaryEntry="exercise designed to strengthen the abdominal muscles"/>
<rdf:Description rdf:about="&a;100415881">
	<b:glossaryEntry>the exercise of a profession; "the practice of the law"; "I took over his practice when he retired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100416107"
	 b:glossaryEntry="the practice of dentistry"/>
<rdf:Description rdf:about="&a;100416194"
	 b:glossaryEntry="the practice of law"/>
<rdf:Description rdf:about="&a;100416272"
	 b:glossaryEntry="the practice of medicine"/>
<rdf:Description rdf:about="&a;100416359"
	 b:glossaryEntry="the practice of an optometrist"/>
<rdf:Description rdf:about="&a;100416445">
	<b:glossaryEntry>a diligent effort; "it is a job requiring serious application"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100416577">
	<b:glossaryEntry>any effort that seems to go farther than would be necessary to achieve its goal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100416711"
	 b:glossaryEntry="an effort above and beyond the call of duty"/>
<rdf:Description rdf:about="&a;100416815">
	<b:glossaryEntry>the exertion of so much effort that discomfort or injury results</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100416938">
	<b:glossaryEntry>the work of inquiring into something thoroughly and systematically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100417296"
	 b:glossaryEntry="systematic investigation to establish facts"/>
<rdf:Description rdf:about="&a;100417484">
	<b:glossaryEntry>(formerly in England) an examination taken by 11 and 12 year old students to select suitable candidates for grammar school</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100417674"
	 b:glossaryEntry="the act of testing students or candidates (as by questions)"/>
<rdf:Description rdf:about="&a;100417819">
	<b:glossaryEntry>an investigation seeking answers; "a thorough search of the ledgers revealed nothing" or "the outcome justified the search"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100417995">
	<b:glossaryEntry>research designed to determine most efficient way to do something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100418126"
	 b:glossaryEntry="a systematic investigation of a matter of public interest"/>
<rdf:Description rdf:about="&a;100418301">
	<b:glossaryEntry>an inquiry into the financial position of someone applying for financial aid</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100418434"
	 b:glossaryEntry="an inquiry into the cause of an unexpected death"/>
<rdf:Description rdf:about="&a;100418536">
	<b:glossaryEntry>scientific research that requires massive capital investment but is expected to yield very significant results</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100418704"
	 b:glossaryEntry="the act of conducting a controlled test or investigation"/>
<rdf:Description rdf:about="&a;100418927">
	<b:glossaryEntry>an investigation carried out in the field rather than in a laboratory or headquarters</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100419069">
	<b:glossaryEntry>the act of subjecting to experimental test; "they agreed to end the testing of atomic weapons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100419217"
	 b:glossaryEntry="research with the use of microscopes"/>
<rdf:Description rdf:about="&a;100419364"
	 b:glossaryEntry="microscopy with the use of electron microscopes"/>
<rdf:Description rdf:about="&a;100419477"
	 b:glossaryEntry="experimenting until a solution is found"/>
<rdf:Description rdf:about="&a;100419578"
	 b:glossaryEntry="an investigation conducted using a probe instrument"/>
<rdf:Description rdf:about="&a;100419681">
	<b:glossaryEntry>research into questions posed by scientific theories and hypotheses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100419850"
	 b:glossaryEntry="the act of examining something closely (as for mistakes)"/>
<rdf:Description rdf:about="&a;100420276">
	<b:glossaryEntry>examination of the interior of a hollow body organ by use of an endoscope</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100420441">
	<b:glossaryEntry>endoscopic examination of the abdomen through the abdominal wall</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100420562">
	<b:glossaryEntry>endoscopic examination of a woman''s pelvic organs by the insertion of a culdoscope through the vagina</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100420720">
	<b:glossaryEntry>the act of scanning; systematic examination of a prescribed region; "he made a thorough scan of the beach with his binoculars"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100420897">
	<b:glossaryEntry>boarding and inspecting a ship on the high seas; "right of search"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100421016"
	 b:glossaryEntry="a detailed critical inspection"/>
<rdf:Description rdf:about="&a;100421125">
	<b:glossaryEntry>an examination of the characteristics of something; "there are laboratories for commercial testing"; "it involved testing thousands of children for smallpox"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100421336">
	<b:glossaryEntry>an analysis of a specific job in an effort to find the most efficient method in terms of time and effort</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100421569">
	<b:glossaryEntry>a form of microscopic examination of living material by scattered light; specimens appear luminous against a dark background</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100421790">
	<b:glossaryEntry>light microscopy in which the specimen is irradiated at wavelengths that excite fluorochromes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100421971">
	<b:glossaryEntry>a method of using fluorescence microscopy to detect the presence of an antigen indirectly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100422134"
	 b:glossaryEntry="an investigation of the component parts of a whole"/>
<rdf:Description rdf:about="&a;100422311">
	<b:glossaryEntry>detailed part-by-part critical analysis or examination as of a literary work</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100422444"
	 b:glossaryEntry="the chemical analysis of urine (for medical diagnosis)"/>
<rdf:Description rdf:about="&a;100422568">
	<b:glossaryEntry>the chemical analysis of excrement (for medical diagnosis or for paleontological purposes)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100422714"
	 b:glossaryEntry='a detailed analysis; "he studied the anatomy of crimes"'/>
<rdf:Description rdf:about="&a;100422823">
	<b:glossaryEntry>the act of decomposing a substance into its constituent elements</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100423082">
	<b:glossaryEntry>chemical analysis to determine the amounts of each element in the substance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100423330"
	 b:glossaryEntry="quantitative chemical analysis by color using a colorimeter"/>
<rdf:Description rdf:about="&a;100423471">
	<b:glossaryEntry>quantitative analysis by the use of definite volumes of standard solutions or reagents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100423641">
	<b:glossaryEntry>a measured amount of a solution of unknown concentration is added to a known volume of a second solution until the reaction between them is just complete; the concentration of the unknown solution (the titer) can them be calculated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100423928">
	<b:glossaryEntry>determination of the volume of gases (or changes in their volume) during combination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100424078"
	 b:glossaryEntry="quantitative analysis by weight"/>
<rdf:Description rdf:about="&a;100424176">
	<b:glossaryEntry>breaking down the costs of some operation and reporting on each factor separately</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100424317"
	 b:glossaryEntry="the use of spectroscopes to analyze spectra"/>
<rdf:Description rdf:about="&a;100424523">
	<b:glossaryEntry>separation of substances in solution my means of their unequal diffusion through semipermeable membranes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100424755">
	<b:glossaryEntry>a procedure in which blood is drawn and separated into its components by dialysis; some are retained and the rest are returned to the donor by transfusion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100424965">
	<b:glossaryEntry>dialysis of the blood to remove toxic substances or metabolic wastes from the bloodstream; used in the case of kidney failure</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100425165">
	<b:glossaryEntry>a procedure for removing plasma from the blood; blood is drawn and the cellular elements are separated and transfused back to the donor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100425361">
	<b:glossaryEntry>the use of spectroscopy to determine the masses of small electrically charged particles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100425512"
	 b:glossaryEntry="the act of comparing similarities"/>
<rdf:Description rdf:about="&a;100425600">
	<b:glossaryEntry>drawing a comparison in order to show a similarity in some respect; "the models show by analogy how matter is built up"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100425773">
	<b:glossaryEntry>careful examination and comparison to note points of disagreement</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100425894"
	 b:glossaryEntry="the act of distinguishing by comparing differences"/>
<rdf:Description rdf:about="&a;100425999">
	<b:glossaryEntry>an official call for inspection or supervision; "the commissioner made visits to all the precinct stations"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100426189">
	<b:glossaryEntry>visiting in an official capacity to examine a site to determine its suitability for some enterprise</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100426345"
	 b:glossaryEntry="the act of counting"/>
<rdf:Description rdf:about="&a;100426600">
	<b:glossaryEntry>the act of putting into tabular form; "the tabulation of the results"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100426726">
	<b:glossaryEntry>the act of estimating the number of red and white corpuscles in a blood sample</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100426880">
	<b:glossaryEntry>counting the number of white and red blood cells and the number of platelets in 1 cubic millimeter of blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100427077"
	 b:glossaryEntry="a period count of the population"/>
<rdf:Description rdf:about="&a;100427174">
	<b:glossaryEntry>counting backward from an arbitrary number to indicate the time remaining before some event (such as launching a space vehicle)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100427357"
	 b:glossaryEntry="an inaccurate count"/>
<rdf:Description rdf:about="&a;100427431"
	 b:glossaryEntry="the counting of votes (as in an election)"/>
<rdf:Description rdf:about="&a;100427523">
	<b:glossaryEntry>an additional (usually a second) count; especially of the votes in a close election</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100427660">
	<b:glossaryEntry>the act of estimating the number of spermatozoa in an ejaculate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100427781">
	<b:glossaryEntry>the investigation of criminal activities to determine the perpetrator; "detection is hard on the feet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100428003"
	 b:glossaryEntry="the act of keeping a secret watch for intelligence purposes"/>
<rdf:Description rdf:about="&a;100428151">
	<b:glossaryEntry>the act of tapping a telephone or telegraph line to get information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100428272">
	<b:glossaryEntry>the systematic use of spies to get military or political secrets</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100428392"
	 b:glossaryEntry="spying on the spies"/>
<rdf:Description rdf:about="&a;100428474"
	 b:glossaryEntry="close observation of a person or group"/>
<rdf:Description rdf:about="&a;100428625"
	 b:glossaryEntry="surveillance by electronic means (e.g. television)"/>
<rdf:Description rdf:about="&a;100428745">
	<b:glossaryEntry>the work of caring for or attending to someone or something; "no medical care was required"; "the old car needed constant attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100429190">
	<b:glossaryEntry>the work of a baby sitter; caring for children when their parents are not home</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100429326"
	 b:glossaryEntry="care and treatment of a convalescent patient"/>
<rdf:Description rdf:about="&a;100429426"
	 b:glossaryEntry="care for the teeth"/>
<rdf:Description rdf:about="&a;100429520">
	<b:glossaryEntry>the act of brushing your teeth; "the dentist recommended two brushes a day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100429658">
	<b:glossaryEntry>emergency care given before regular medical aid can be obtained</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100429777"
	 b:glossaryEntry="professional treatment for illness or injury"/>
<rdf:Description rdf:about="&a;100430183">
	<b:glossaryEntry>care by procedures or applications that are intended to relieve illness or injury</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100430554"
	 b:glossaryEntry="medical care in a hospital"/>
<rdf:Description rdf:about="&a;100430676">
	<b:glossaryEntry>maintaining something at the most favorable temperature for its development</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100430808"
	 b:glossaryEntry="the care (feeding and stabling) of horses for pay"/>
<rdf:Description rdf:about="&a;100430910">
	<b:glossaryEntry>kneading and rubbing parts of the body to increase circulation and promote relaxation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100431103">
	<b:glossaryEntry>a rhythmic stroking; "effleurage of the abdomen is used in the Lamaze method of childbirth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100431270">
	<b:glossaryEntry>massage combined with a system of active and passive exercises for the muscles and joints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100431421"
	 b:glossaryEntry="professional care for the hands and fingernails"/>
<rdf:Description rdf:about="&a;100431523"
	 b:glossaryEntry="professional care for the feet and toenails"/>
<rdf:Description rdf:about="&a;100431621">
	<b:glossaryEntry>(medicine) the act of caring for someone (as by medication or remedial training etc.); "the quarterback is undergoing treatment for a knee injury"; "he tried every treatment the doctors suggested"; "heat therapy gave the best relief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100432142"
	 b:glossaryEntry="a method of therapy that involves physical treatment"/>
<rdf:Description rdf:about="&a;100432304">
	<b:glossaryEntry>a method of physical therapy that involves generating local heat in body tissues by high-frequency electromagnetic currents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100432483">
	<b:glossaryEntry>the therapeutic use of crafts and hobbies; especially for the rehabilitation of emotionally disturbed patients</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100432660"
	 b:glossaryEntry="care by a skilled nurse"/>
<rdf:Description rdf:about="&a;100432742"
	 b:glossaryEntry="the work of caring for the sick or injured or infirm"/>
<rdf:Description rdf:about="&a;100432866">
	<b:glossaryEntry>considerate and solicitous care; "young children need lots of TLC"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100433003"
	 b:glossaryEntry="care for the skin"/>
<rdf:Description rdf:about="&a;100433094">
	<b:glossaryEntry>care for the face that usually involves cleansing and massage and the application of cosmetic creams</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100433247">
	<b:glossaryEntry>surgical removal of the adenoids; commonly performed along with tonsillectomy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100433384"
	 b:glossaryEntry="surgical removal of one or both adrenal glands"/>
<rdf:Description rdf:about="&a;100433509"
	 b:glossaryEntry="surgical removal of the vermiform appendix"/>
<rdf:Description rdf:about="&a;100433627"
	 b:glossaryEntry="a surgical removal of all or part of a limb"/>
<rdf:Description rdf:about="&a;100433727">
	<b:glossaryEntry>an operation to repair a damaged blood vessel or unblock a coronary artery</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100433859">
	<b:glossaryEntry>surgical reconstruction or replacement of a malformed or degenerated joint</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100433992">
	<b:glossaryEntry>a minimally invasive operation to repair a damaged joint; the surgeon examines the joint with an arthroscope while making repairs through a small incision</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100434204">
	<b:glossaryEntry>surgical repair by using tissue from another part of the patient''s own body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100434336">
	<b:glossaryEntry>surgical removal of the testes or ovaries (usually to inhibit hormone secretion in cases of breast cancer in women or prostate cancer in men); "bilateral castration results in sterilization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100434583">
	<b:glossaryEntry>use of chemical to destroy diseased or malignant tissue; used in treatment of skin cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100434731">
	<b:glossaryEntry>a surgical operation that creates an opening from the colon to the surface of the body to function as an anus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100434915"
	 b:glossaryEntry="a surgical opening through the skull"/>
<rdf:Description rdf:about="&a;100435008">
	<b:glossaryEntry>the use of extreme cold (usually liquid nitrogen) to destroy unwanted tissue (warts or cataracts or skin cancers)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100435179">
	<b:glossaryEntry>spontaneous removal or casting off of a body part (as the tail of a lizard or claw or a lobster) especially when the organism is injured or under attack</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100435386">
	<b:glossaryEntry>surgical removal of the gall bladder (usually for relief of gallstone pain)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100435541">
	<b:glossaryEntry>removal of the gall bladder through small punctures in the abdomen to permit the insertion of a laparoscope and surgical instruments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100435760">
	<b:glossaryEntry>surgery to remove tissue or growths from a bodily cavity (as the uterus) by scraping with a curette</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100435966">
	<b:glossaryEntry>a method of induced abortion; prior to the 14th week of gestation the embryo and placenta are removed by applying suction to the dilated cervix</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100436211">
	<b:glossaryEntry>a surgical procedure usually performed under local anesthesia in which the cervix is dilated and the endometrial lining of the uterus is scraped with a curet; performed to obtain tissue samples or to stop prolonged bleeding or to remove small tumors or to remove fragments of placenta after childbirth or as a method of abortion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100436664">
	<b:glossaryEntry>a therapeutic procedure with instruments to repair damage or arrest disease in a living body; "they will schedule the operation as soon as an operating room is available"; "he died while undergoing surgery"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100437574"
	 b:glossaryEntry="surgical removal of an embolus (usually from an artery)"/>
<rdf:Description rdf:about="&a;100437687">
	<b:glossaryEntry>an operation to remove wrinkles and other signs of aging from your face</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100437860"
	 b:glossaryEntry="any surgical procedure involving the heart"/>
<rdf:Description rdf:about="&a;100437998">
	<b:glossaryEntry>heart surgery in which a small incision is made in the heart; a heart-lung machine is not required</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100438163">
	<b:glossaryEntry>heart surgery in which the heart is opened and blood is detoured through a heart-lung machine</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100438339">
	<b:glossaryEntry>open-heart surgery in which a section of a blood vessel is grafted from the aorta to the coronary artery to bypass the blocked section of the coronary artery and improve the blood supply to the heart</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100438600"
	 b:glossaryEntry="surgical removal of the uterus"/>
<rdf:Description rdf:about="&a;100438725">
	<b:glossaryEntry>surgical removal of the uterus and the ovaries and oviducts and cervix and related lymph nodes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100438904"
	 b:glossaryEntry="surgical removal of the uterus and cervix"/>
<rdf:Description rdf:about="&a;100439010">
	<b:glossaryEntry>the cutting of or into body tissues or organs (especially by a surgeon as part of an operation)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100439207">
	<b:glossaryEntry>surgical incision of the perineum to enlarge the vagina and so facilitate delivery during childbirth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100439364">
	<b:glossaryEntry>surgical creation of an opening between the jejunum and the anterior abdominal wall; will allow artificial feeding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100439536">
	<b:glossaryEntry>a surgical procedure in which part or all of the cornea is replaced by healthy corneal tissue from a donor</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100439734">
	<b:glossaryEntry>using a piece of donated corneal tissue to repair the eye of someone who has had a cataract removed; "epikeratophakia gave her a living contact lens"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100439945"
	 b:glossaryEntry="surgical removal of the bony arches on one or more vertebrae"/>
<rdf:Description rdf:about="&a;100440063"
	 b:glossaryEntry="surgical incision into the abdominal wall"/>
<rdf:Description rdf:about="&a;100440179"
	 b:glossaryEntry="laparotomy performed with a laparoscope"/>
<rdf:Description rdf:about="&a;100440276">
	<b:glossaryEntry>surgical removal of part or all of the larynx (usually to treat cancer of the larynx)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100440420"
	 b:glossaryEntry="surgical removal of a stone (calculus)"/>
<rdf:Description rdf:about="&a;100440532"
	 b:glossaryEntry="removal of gallstone through an incision in the gallbladder"/>
<rdf:Description rdf:about="&a;100440652">
	<b:glossaryEntry>surgical removal of a lobe from any organ of the body (as the lung or brain)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100440784">
	<b:glossaryEntry>surgical interruption of nerve tracts to and from the frontal lobe of the brain</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100440963">
	<b:glossaryEntry>surgical removal of a tumor without removing much of the surrounding tissue or lymph nodes; performed in some cases of breast cancer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100441152">
	<b:glossaryEntry>any surgical procedure that involves anesthesia or respiratory assistance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100441303">
	<b:glossaryEntry>any surgical procedure that does not involve anesthesia or respiratory assistance</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100441462"
	 b:glossaryEntry="surgical removal of a breast to remove a malignant tumor"/>
<rdf:Description rdf:about="&a;100441629">
	<b:glossaryEntry>removal of a breast and the pectoralis minor and some lymph nodes in the adjacent armpit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100441791">
	<b:glossaryEntry>removal of a breast and the underlying muscles (pectoralis major and pectoralis minor) and lymph nodes in the adjacent armpit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100441981">
	<b:glossaryEntry>removal of a breast leaving the underlying muscles and the lymph nodes intact</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100442122"
	 b:glossaryEntry="surgical removal of the mastoid process"/>
<rdf:Description rdf:about="&a;100442221"
	 b:glossaryEntry="surgical removal of the meniscus of the knee"/>
<rdf:Description rdf:about="&a;100442324"
	 b:glossaryEntry="surgical removal of a kidney"/>
<rdf:Description rdf:about="&a;100442410"
	 b:glossaryEntry="surgical removal of all or part of a nerve"/>
<rdf:Description rdf:about="&a;100442509"
	 b:glossaryEntry="surgical removal of one of both ovaries"/>
<rdf:Description rdf:about="&a;100442621"
	 b:glossaryEntry="surgical removal of one or both testicles"/>
<rdf:Description rdf:about="&a;100442735"
	 b:glossaryEntry="surgical removal of a lung (usually to treat lung cancer)"/>
<rdf:Description rdf:about="&a;100442852"
	 b:glossaryEntry="surgical removal of part or all of the prostate gland"/>
<rdf:Description rdf:about="&a;100442965"
	 b:glossaryEntry="surgical removal of one or both Fallopian tubes"/>
<rdf:Description rdf:about="&a;100443072">
	<b:glossaryEntry>surgical removal of part or all of the sigmoid colon (usually to remove a malignant tumor)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100443222"
	 b:glossaryEntry="surgical removal of the spleen"/>
<rdf:Description rdf:about="&a;100443310"
	 b:glossaryEntry="surgical removal of the stapes of the middle ear"/>
<rdf:Description rdf:about="&a;100443417">
	<b:glossaryEntry>surgical interruption of a nerve pathway in the sympathetic nervous system</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100443551">
	<b:glossaryEntry>surgical removal of a blood clot (thrombus) from a blood vessel</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100443673"
	 b:glossaryEntry="surgical removal of the thyroid gland"/>
<rdf:Description rdf:about="&a;100443770">
	<b:glossaryEntry>surgical removal of the palatine tonsils; commonly performed along with adenoidectomy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100443915">
	<b:glossaryEntry>any surgery that involves the nervous system (brain or spinal cord or peripheral nerves)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100444062"
	 b:glossaryEntry="cosmetic surgery to improve the appearance of your nose"/>
<rdf:Description rdf:about="&a;100444186">
	<b:glossaryEntry>surgery concerned with therapeutic or cosmetic reformation of tissue</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100444347"
	 b:glossaryEntry="surgical incision of the sclerotic coat of the eye"/>
<rdf:Description rdf:about="&a;100444454">
	<b:glossaryEntry>a surgical procedure in which a suture is used to close the cervix in a pregnant woman; is performed when the cervix has failed to retain previous pregnancies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100444705">
	<b:glossaryEntry>the surgical operation of cutting a muscle or tendon of the eye in order to correct strabismus</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100444856">
	<b:glossaryEntry>a surgical operation that creates an opening into the trachea with a tube inserted to provide a passage for air; performed when the pharynx is obstructed by edema or cancer or other causes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100445136">
	<b:glossaryEntry>an operation moving an organ from one person (the donor) to another (the recipient)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100445312">
	<b:glossaryEntry>the act of replacing a damaged or diseased cornea with another cornea taken from a donor (usually a donor who has recently died)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100445521">
	<b:glossaryEntry>a operation that removes a circular section of bone from the skull</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100445646"
	 b:glossaryEntry="the act of treating with medicines or remedies"/>
<rdf:Description rdf:about="&a;100445785"
	 b:glossaryEntry="the act of administering medication"/>
<rdf:Description rdf:about="&a;100445919"
	 b:glossaryEntry="the administration of a sedative agent or drug"/>
<rdf:Description rdf:about="&a;100446031">
	<b:glossaryEntry>(medicine) cleaning a wound or body organ by flushing or washing out with water or a medicated solution</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100446245">
	<b:glossaryEntry>irrigation with a jet of water or medicated solution into or around a body part (especially the vagina) to treat infections or cleanse from odorous contents</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100446454">
	<b:glossaryEntry>injection of a liquid through the anus to stimulate evacuation; sometimes used for diagnostic purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100446618">
	<b:glossaryEntry>washing out a hollow organ (especially the stomach) by flushing with water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100446763">
	<b:glossaryEntry>washing out the stomach with sterile water or a salt-water solution; removes blood or poisons; "when the doctor ordered a gastric lavage the hospital pumped out my stomach"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100446996"
	 b:glossaryEntry="the act of applying a bandage"/>
<rdf:Description rdf:about="&a;100447102">
	<b:glossaryEntry>the act of putting a liquid into the body by means of a syringe; "the nurse gave him a flu shot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100447333">
	<b:glossaryEntry>the act of coagulating blood and destroying tissue with a hot iron or caustic agent or by freezing</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100447535">
	<b:glossaryEntry>application of a substance that destroys tissue by freezing it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100447655">
	<b:glossaryEntry>formerly used as a treatment to reduce excess blood (one of the four humors of medieval medicine)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100447847"
	 b:glossaryEntry="surgical incision into a vein"/>
<rdf:Description rdf:about="&a;100447947">
	<b:glossaryEntry>a treatment in which evacuated cups are applied to the skin to draw blood through the surface</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100448094">
	<b:glossaryEntry>treatment by stopping fibrillation of heart muscles (usually by electric shock delivered by a defibrillator)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100448263"
	 b:glossaryEntry="treatment by counteracting toxic properties"/>
<rdf:Description rdf:about="&a;100448367">
	<b:glossaryEntry>a treatment for addiction to drugs or alcohol intended to rid the body of the addictive substances</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100448526">
	<b:glossaryEntry>therapy based on a theory that taking very large doses of vitamins will prevent or cure physical or psychological disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100448715">
	<b:glossaryEntry>treatment of a specific defect; "the correction of his vision with eye glasses"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100448869">
	<b:glossaryEntry>correction of an unstable part of the spine by joining two or more vertebrae; usually done surgically but sometimes done by traction or immobilization</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100449088"
	 b:glossaryEntry="care provided through prayer and faith in God"/>
<rdf:Description rdf:about="&a;100449224">
	<b:glossaryEntry>the application of a faith healer''s hands to the patient''s body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100449352">
	<b:glossaryEntry>the treatment of mental or emotional problems by psychological means</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100449552">
	<b:glossaryEntry>psychotherapy that seeks to extinguish or inhibit abnormal or maladaptive behavior by reinforcing desired behavior and extinguishing undesired behavior</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100449898">
	<b:glossaryEntry>a method of psychotherapy that reinforces you for stating negative and positive feelings directly</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100450064">
	<b:glossaryEntry>any technique of behavior modification that uses unpleasant stimuli in a controlled fashion to alter behavior in a therapeutic way; primarily used for alcoholism or drug abuse (but with little success)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100450328">
	<b:glossaryEntry>a technique used in behavior therapy to treat phobias and other behavior problems involving anxiety; client is exposed to the threatening situation under relaxed conditions until the anxiety reaction is extinguished</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100450672">
	<b:glossaryEntry>a technique used in behavior therapy; client is flooded with experiences of a particular kind until becoming either averse to them or numbed to them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100450895">
	<b:glossaryEntry>a method of behavior therapy based on the inhibition of one response by the occurrence of another response that is mutually incompatible with it; a relaxation response might be conditioned to a stimulus that previously evoked anxiety</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100451228">
	<b:glossaryEntry>a form of behavior therapy that has been used in some mental institutions; patients are rewarded with tokens for appropriate behavior and the tokens may be cashed in for valued rewards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100451472">
	<b:glossaryEntry>psychotherapy that focuses on acute critical situations (depressive episodes or attempted suicides or drug overdoses) with the aim of restoring the person to the level of functioning before the crisis</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100451738">
	<b:glossaryEntry>a set of techniques for exploring underlying motives and a method of treating various mental disorders; "his physician recommended psychoanalysis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100451975">
	<b:glossaryEntry>the application of psychotherapeutic principles to the analysis of your own personality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100452122">
	<b:glossaryEntry>the treatment of disease (especially cancer) by exposure to radiation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100452336"
	 b:glossaryEntry="the use of radium in radiotherapy"/>
<rdf:Description rdf:about="&a;100452430"
	 b:glossaryEntry="the therapeutic use of X rays"/>
<rdf:Description rdf:about="&a;100452519">
	<b:glossaryEntry>the use of chemical agents to treat or control disease (or mental illness)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100452670">
	<b:glossaryEntry>the use of chemicals containing gold for treating diseases (such as rheumatoid arthritis)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100452819"
	 b:glossaryEntry="the therapeutic application of electricity to the body"/>
<rdf:Description rdf:about="&a;100452943">
	<b:glossaryEntry>treatment of certain psychotic states by the administration of shocks that are followed by convulsions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100453177">
	<b:glossaryEntry>the administration of a strong electric current that passes through the brain to induce convulsions and coma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100453401">
	<b:glossaryEntry>the administration of sufficient insulin to induce convulsions and coma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100453582">
	<b:glossaryEntry>the administration of sufficient Metrazol to induce convulsions and coma</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100453767">
	<b:glossaryEntry>treating an infectious disease by injecting an antitoxin or specific serum</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100453915"
	 b:glossaryEntry="any therapy intended to correct a disorder of speech"/>
<rdf:Description rdf:about="&a;100454028">
	<b:glossaryEntry>a method of treatment that manipulates body structures in the belief that it restores proper nerve functioning</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100454197">
	<b:glossaryEntry>a method of treating disease using food and exercise and heat to assist the natural healing process</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100454354">
	<b:glossaryEntry>a drugless method of treatment based on the belief that disease symptoms arise from problems with ligaments and connective tissues</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100454541">
	<b:glossaryEntry>therapy based on the assumption that restoring health is best accomplished by manipulating the skeleton and muscles</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100454713">
	<b:glossaryEntry>therapy that uses physical agents: exercise and massage and other modalities</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100454901"
	 b:glossaryEntry="treatment to destroy harmful microorganisms"/>
<rdf:Description rdf:about="&a;100455021">
	<b:glossaryEntry>disinfection of water by the addition of small amounts of chlorine or a chlorine compound</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100455169">
	<b:glossaryEntry>the administration of digitalis for the treatment of certain heart disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100455323">
	<b:glossaryEntry>the administration of an anticoagulant drug to retard coagulation of the blood</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100455463">
	<b:glossaryEntry>(Chinese) treatment of pain or disease by inserting the tips of needles at specific points on the skin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100455637">
	<b:glossaryEntry>(Chinese and Japanese) treatment of symptoms by applying pressure with the fingers to specific pressure points on the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100455834"
	 b:glossaryEntry="training patients in self-induced relaxation"/>
<rdf:Description rdf:about="&a;100455976">
	<b:glossaryEntry>the usual method of treating disease with remedies that produce effects differing from those produced by the disease itself</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100456173">
	<b:glossaryEntry>a method of treating disease with small amounts of remedies that, in large amounts in healthy people, produce symptoms similar to those being treated</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100456411">
	<b:glossaryEntry>the internal and external use of water in the treatment of disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100456549"
	 b:glossaryEntry="rest as a medical treatment for stress or anxiety etc."/>
<rdf:Description rdf:about="&a;100456659"
	 b:glossaryEntry="a hunt for game carried on by stalking or waiting in ambush"/>
<rdf:Description rdf:about="&a;100456812"
	 b:glossaryEntry="stalking deer"/>
<rdf:Description rdf:about="&a;100456884"
	 b:glossaryEntry="hunting for birds'' nests to get the eggs"/>
<rdf:Description rdf:about="&a;100456982"
	 b:glossaryEntry="effort expended in rubbing one object against another"/>
<rdf:Description rdf:about="&a;100457130">
	<b:glossaryEntry>the work of applying something; "the doctor prescribed a topical application of iodine"; "a complete bleach requires several applications"; "the surface was ready for a coating of paint";</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100457666"
	 b:glossaryEntry="the act of applying oil or an oily liquid"/>
<rdf:Description rdf:about="&a;100457794">
	<b:glossaryEntry>the application of a gas or smoke to something for the purpose of disinfecting it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100457932"
	 b:glossaryEntry="the work of making or repairing vehicle bodies"/>
<rdf:Description rdf:about="&a;100458033">
	<b:glossaryEntry>manual (or mechanical) carrying or moving or delivering or working with something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100458223">
	<b:glossaryEntry>act of loading and unloading and moving goods within e.g. a factory especially using mechanical devices</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100458391"
	 b:glossaryEntry='the labor of loading something; "the loading took 2 hours"'/>
<rdf:Description rdf:about="&a;100458521"
	 b:glossaryEntry="the labor of unloading something"/>
<rdf:Description rdf:about="&a;100458627"
	 b:glossaryEntry="the act of picking (crops or fruit or hops etc.)"/>
<rdf:Description rdf:about="&a;100458729">
	<b:glossaryEntry>the act of someone who picks up or takes something; "the pickings were easy"; "clothing could be had for the taking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100458908"
	 b:glossaryEntry="the work of covering an area with planks"/>
<rdf:Description rdf:about="&a;100459003">
	<b:glossaryEntry>the work of installing the wires for an electrical system or device</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100459123"
	 b:glossaryEntry="joining or attaching by stitches"/>
<rdf:Description rdf:about="&a;100459238"
	 b:glossaryEntry="surgical joining of two surfaces"/>
<rdf:Description rdf:about="&a;100459344">
	<b:glossaryEntry>surgical removal of all or part of the vas deferens (usually as a means of sterilization)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100459507"
	 b:glossaryEntry="surgical removal of part or all of the vulva"/>
<rdf:Description rdf:about="&a;100459608">
	<b:glossaryEntry>operating on living animals especially in scientific research</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100459727"
	 b:glossaryEntry="an application of a lubricant to something"/>
<rdf:Description rdf:about="&a;100459827"
	 b:glossaryEntry="the application of paving materials to an area"/>
<rdf:Description rdf:about="&a;100459926">
	<b:glossaryEntry>the act of applying paint to a surface; "you can finish the job of painting faster with a roller than with a brush"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100460150">
	<b:glossaryEntry>the application of a liquid in the form of small particles ejected from a sprayer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100460304"
	 b:glossaryEntry="applying paint with a sprayer"/>
<rdf:Description rdf:about="&a;100460412"
	 b:glossaryEntry="the act of splashing a (liquid) substance on a surface"/>
<rdf:Description rdf:about="&a;100460568"
	 b:glossaryEntry="painting by using the fingers to spread the paint"/>
<rdf:Description rdf:about="&a;100460679"
	 b:glossaryEntry="the act of coating something with a protective layer of tin"/>
<rdf:Description rdf:about="&a;100460806">
	<b:glossaryEntry>the act of coating with soft solder; "tinning the ends of the wires makes a better joint when you solder them"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100460970"
	 b:glossaryEntry="the application of wallpaper"/>
<rdf:Description rdf:about="&a;100461068"
	 b:glossaryEntry="the application of plaster"/>
<rdf:Description rdf:about="&a;100461161"
	 b:glossaryEntry="the application of a thin coat of metal (as by electrolysis)"/>
<rdf:Description rdf:about="&a;100461275">
	<b:glossaryEntry>the application of very thin coat of color over the surface of a picture</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100461401"
	 b:glossaryEntry="the application of tiles to cover a surface"/>
<rdf:Description rdf:about="&a;100461497"
	 b:glossaryEntry="the application of wax to a surface"/>
<rdf:Description rdf:about="&a;100461585">
	<b:glossaryEntry>work that you are obliged to perform for moral or legal reasons: "the duties of the job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100461778">
	<b:glossaryEntry xml:space='preserve'><![CDATA[a specific piece of work required to be done as a duty or for a specific fee: "estimates of the city''s loss on that job ranged as high as a million dollars"; "the job of repairing the engine took several hours"; "the endless task of classifying the samples"; "the farmer''s morning chores"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100462185">
	<b:glossaryEntry>an individuals prescribed share of work: "her stint as a lifeguard exhausted her"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100462318">
	<b:glossaryEntry>the actions and activities assigned to or required or expected of a person or group: "the function of a teacher"; "the government must do its part" or "play its role" or "do its duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100462651">
	<b:glossaryEntry>a specified function; "he was employed in the capacity of director"; "he should be retained in his present capacity at a higher salary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100462841">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an informal term for a person''s role; "he took off his politician''s hat and talked frankly"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100462982">
	<b:glossaryEntry>the function or position properly or customarily occupied or served by another: "can you go in my stead?"; "took his place"; "in lieu of"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100463215">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as the agent of or on someone''s part; usually expressed as "on behalf of" rather than "in behalf of": "the guardian signed the contract on behalf of the minor child"; "this letter is written on behalf of my client"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100463482">
	<b:glossaryEntry>a secondary role or function; "he hated to play second fiddle to anyone"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100463614">
	<b:glossaryEntry>normal or customary activity; "what is your role on the team?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100463745">
	<b:glossaryEntry>(in team sports) the role assigned to an individual player; "what position does he play?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100464213">
	<b:glossaryEntry>the position on a baseball team of the player who throws the ball for a batter to try to hit; "he has played every position except pitcher"; "they have a southpaw on the mound"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100464470">
	<b:glossaryEntry>the position on a baseball team of the player who is stationed behind home plate and who catches the balls that the pitcher throws; "a catcher needs a lot of protective equipment"; "he plays behind the plate"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100464759">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is stationed at first base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100464928">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is stationed near 2nd base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100465099">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is stationed between 2nd and 3rd base</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100465278">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is stationed near 3rd base; "he is playing third"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100465470">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is expected to field balls in the left third of the outfield (looking from home plate)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100465691">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is expected to field balls in the central third of the outfield</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100465891">
	<b:glossaryEntry>the fielding position of the player on a baseball team who is expected to field balls in the right third of the outfield (looking from home plate)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100466114"
	 b:glossaryEntry="a position on a basketball team"/>
<rdf:Description rdf:about="&a;100466218">
	<b:glossaryEntry>a position on a basketball team of the player who participates in the center jump to start the game</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100466389"
	 b:glossaryEntry="a position on a basketball team"/>
<rdf:Description rdf:about="&a;100466491">
	<b:glossaryEntry>the position of a player on a football team who is stationed behind the line of scrimmage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100466741">
	<b:glossaryEntry>the position of a player on a football team who is stationed on the line of scrimmage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100466971">
	<b:glossaryEntry>the position of the football player in the backfield who directs the offensive play of his team; "quarterback is the most important position on the team"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100467233"
	 b:glossaryEntry="the position of a back on a football team"/>
<rdf:Description rdf:about="&a;100467348">
	<b:glossaryEntry>the position of the offensive back on a football team who lines up farthest from the line of scrimmage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100467524">
	<b:glossaryEntry>the position of the offensive back who lines up behind or outside the end</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100467671">
	<b:glossaryEntry xml:space='preserve'><![CDATA[the position of the player on the line of scrimmage who puts the ball in play; "it is a center''s responsibility to get the football to the quarterback"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100467894">
	<b:glossaryEntry>a position on the line of scrimmage; "guards must be good blockers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100468032">
	<b:glossaryEntry>a position on the line of scrimmage; "it takes a big man to play tackle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100468176">
	<b:glossaryEntry>a position on the line of scrimmage; "no one wanted to play end"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100468309">
	<b:glossaryEntry>the fielding position in cricket closest to the bowler on the off side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100468433">
	<b:glossaryEntry>the fielding position in cricket closest to the bowler on the on side</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100468555">
	<b:glossaryEntry>the position on a hockey team of the player who participates in the face off at the beginning of the game</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100468732"
	 b:glossaryEntry="a school task performed by a student to satisfy the teacher"/>
<rdf:Description rdf:about="&a;100468909"
	 b:glossaryEntry="a school task requiring considerable effort"/>
<rdf:Description rdf:about="&a;100469045">
	<b:glossaryEntry>preparatory school work done outside school (especially at home)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100469204">
	<b:glossaryEntry>a task assigned for individual study; "he did the lesson for today"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100469415"
	 b:glossaryEntry="a period of instruction learning a language"/>
<rdf:Description rdf:about="&a;100469574"
	 b:glossaryEntry="instruction in the French language"/>
<rdf:Description rdf:about="&a;100469668"
	 b:glossaryEntry="instruction in the German language"/>
<rdf:Description rdf:about="&a;100469762"
	 b:glossaryEntry="instruction in the Hebrew language"/>
<rdf:Description rdf:about="&a;100469856">
	<b:glossaryEntry>a task performed or problem solved in order to develop skill or understanding; "you must work the examples at the end of each chapter in the textbook"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100470071"
	 b:glossaryEntry="the reading of a passage assigned by the teacher"/>
<rdf:Description rdf:about="&a;100470184">
	<b:glossaryEntry>an instance of a student reciting a lesson that has been learned</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100470305">
	<b:glossaryEntry>as duty that you are assigned to perform especially in the armed forces: "hazardous duty"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100470577">
	<b:glossaryEntry>the duty of serving as a sentry; "he was on guard that night"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100470729">
	<b:glossaryEntry>labor of a nonmilitary kind done by soldiers (cleaning or digging or draining or so on); "the soldiers were put on fatigue to teach them a lesson"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100470944"
	 b:glossaryEntry="the organized work of a religious missionary"/>
<rdf:Description rdf:about="&a;100471060">
	<b:glossaryEntry>a task that has been assigned to a person or group; "a confidential mission to London"; "his charge was deliver a message"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100471276"
	 b:glossaryEntry="an extremely dangerous or difficult mission"/>
<rdf:Description rdf:about="&a;100471384">
	<b:glossaryEntry>a short trip that is taken in the performance of a necessary task or mission</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100471513"
	 b:glossaryEntry="assignment to a different duty"/>
<rdf:Description rdf:about="&a;100471620">
	<b:glossaryEntry>the detachment of a person from their regular organization for temporary assignment elsewhere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100471770"
	 b:glossaryEntry="naval service aboard a ship at sea"/>
<rdf:Description rdf:about="&a;100471893"
	 b:glossaryEntry="naval service at land bases"/>
<rdf:Description rdf:about="&a;100471977"
	 b:glossaryEntry="a chore that causes discomfort"/>
<rdf:Description rdf:about="&a;100472071">
	<b:glossaryEntry>activity that transgresses moral or civil law; "he denied any wrongdoing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100472484"
	 b:glossaryEntry="entry to another''s property without right or permission"/>
<rdf:Description rdf:about="&a;100472651">
	<b:glossaryEntry>an encroachment or intrusion; "they made inroads in the US market"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100472770">
	<b:glossaryEntry>any wrongdoing for which and action for damages may be brought</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100472951">
	<b:glossaryEntry>the wrongful intrusion by individuals or the government into private affairs with which the public has no concern</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100473130">
	<b:glossaryEntry>a wrongful interference with the possession of property (personal property as well as realty), or the action instituted to recover damages</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100473413">
	<b:glossaryEntry>trespass that is not transient or intermittent but continues as long as the offending object remains; "dumping his garbage on my land was a case of continuing trespass"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100473647">
	<b:glossaryEntry>an action brought to recover damages from a person who has taken goods or property from its rightful owner</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100473828">
	<b:glossaryEntry>an action brought to recover damages from a person whose actions have resulted indirectly in injury or loss; "a person struck by a log as it was thrown onto a road could maintain trespass against the thrower but one who was hurt by stumbling over it could maintain and action on the case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100474183"
	 b:glossaryEntry="the defendant unlawfully enters the land of the plaintiff"/>
<rdf:Description rdf:about="&a;100474316">
	<b:glossaryEntry>trespass with force and arms resulting in injury to another''s person or property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100474462"
	 b:glossaryEntry="misconduct in public office"/>
<rdf:Description rdf:about="&a;100474548"
	 b:glossaryEntry="improper or wicked or immoral behavior"/>
<rdf:Description rdf:about="&a;100474813"
	 b:glossaryEntry="an antisocial misdeed in violation of the law by a minor"/>
<rdf:Description rdf:about="&a;100474950">
	<b:glossaryEntry>reckless or malicious behavior that causes discomfort or annoyance in others</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100475235"
	 b:glossaryEntry='noisy and unrestrained mischief; "raising blazes"'/>
<rdf:Description rdf:about="&a;100475343"
	 b:glossaryEntry="violent lawless behavior"/>
<rdf:Description rdf:about="&a;100475424"
	 b:glossaryEntry="an act of undue intimacy"/>
<rdf:Description rdf:about="&a;100475542">
	<b:glossaryEntry>behavior that breaches the rule or etiquette or custom or morality</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100475699"
	 b:glossaryEntry="deviate behavior"/>
<rdf:Description rdf:about="&a;100475782"
	 b:glossaryEntry="an indecent or improper act"/>
<rdf:Description rdf:about="&a;100475915">
	<b:glossaryEntry>the perverse act of exposing and attracting attention to your own genitals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100476061"
	 b:glossaryEntry="an obscene act"/>
<rdf:Description rdf:about="&a;100476131"
	 b:glossaryEntry="a petty misdeed"/>
<rdf:Description rdf:about="&a;100476218"
	 b:glossaryEntry="infantile behavior in mature persons"/>
<rdf:Description rdf:about="&a;100476312"
	 b:glossaryEntry="willful negligence"/>
<rdf:Description rdf:about="&a;100476406">
	<b:glossaryEntry>a failure to act when under an obligation to do so; a refusal (without sufficient excuse) to do that which it is your legal duty to do</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100476598"
	 b:glossaryEntry="failure to act"/>
<rdf:Description rdf:about="&a;100476765"
	 b:glossaryEntry="breach of a (legal) duty"/>
<rdf:Description rdf:about="&a;100476851">
	<b:glossaryEntry>nonperformance of something distasteful (as by deceit or trickery) that you are supposed to do; "his evasion of his clear duty was reprehensible"; "that escape from the consequences is possible but unattractive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100477225"
	 b:glossaryEntry="a form of behavior that evades unpleasant realities"/>
<rdf:Description rdf:about="&a;100477339"
	 b:glossaryEntry="evading duty or work by pretending to be incapacitated"/>
<rdf:Description rdf:about="&a;100477462"
	 b:glossaryEntry="the evasion of work or duty"/>
<rdf:Description rdf:about="&a;100477597"
	 b:glossaryEntry="the act of evading by going around"/>
<rdf:Description rdf:about="&a;100477691">
	<b:glossaryEntry>the deliberate failure to pay taxes (usually by making a false report)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100477819"
	 b:glossaryEntry="doing a proper act in a wrongful or injurious manner"/>
<rdf:Description rdf:about="&a;100477929">
	<b:glossaryEntry>a wrongful act that the actor had no right to do; improper professional conduct; "he charged them with electoral malpractices"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100478127">
	<b:glossaryEntry>professional wrongdoing that results in injury or damage; "the widow sued his surgeon for malpractice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100478287">
	<b:glossaryEntry>the action of perverting something (turning it to a wrong use); "it was a perversion of justice"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100478440">
	<b:glossaryEntry>useless or profitless activity; using or expending or consuming thoughtlessly or carelessly: "if the effort brings no compensating gain it is a waste"; "mindless dissipaton of natural resources"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100478823"
	 b:glossaryEntry="a useless effort"/>
<rdf:Description rdf:about="&a;100478919"
	 b:glossaryEntry="a useless consumption of material"/>
<rdf:Description rdf:about="&a;100479016">
	<b:glossaryEntry>money spent for inadequate return; "the senator said that the project was a waste of money"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100479168">
	<b:glossaryEntry>the devotion of time to a useless activity; "the waste of time could prove fatal"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100479309"
	 b:glossaryEntry="excessive spending"/>
<rdf:Description rdf:about="&a;100479413"
	 b:glossaryEntry="spending money wastefully"/>
<rdf:Description rdf:about="&a;100479514"
	 b:glossaryEntry="prodigious squandering (usually by a government)"/>
<rdf:Description rdf:about="&a;100479622">
	<b:glossaryEntry>a legal injury is any damage resulting from a violation of a legal right</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100479770"
	 b:glossaryEntry="an act that injures someone"/>
<rdf:Description rdf:about="&a;100479886"
	 b:glossaryEntry="an unjust act"/>
<rdf:Description rdf:about="&a;100479979"
	 b:glossaryEntry="an act causing pain or damage"/>
<rdf:Description rdf:about="&a;100480065"
	 b:glossaryEntry="evil behavior"/>
<rdf:Description rdf:about="&a;100480312"
	 b:glossaryEntry="morally objectionable behavior"/>
<rdf:Description rdf:about="&a;100480502"
	 b:glossaryEntry="a treacherous or vicious act"/>
<rdf:Description rdf:about="&a;100480585"
	 b:glossaryEntry="wicked and cruel behavior"/>
<rdf:Description rdf:about="&a;100480675"
	 b:glossaryEntry="an act of extreme wickedness"/>
<rdf:Description rdf:about="&a;100480758">
	<b:glossaryEntry>unfair or treacherous behavior (especially involving violence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100480876"
	 b:glossaryEntry="a disrespectful act"/>
<rdf:Description rdf:about="&a;100480983"
	 b:glossaryEntry="blasphemous behavior"/>
<rdf:Description rdf:about="&a;100481099">
	<b:glossaryEntry>a corrupt or depraved or degenerate act or practice: "the various turpitudes of modern society"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100481262">
	<b:glossaryEntry>a specific form of evildoing; "vice offends the moral standards of the community"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100481448"
	 b:glossaryEntry="unlicensed gambling is illegal in most jurisdictions"/>
<rdf:Description rdf:about="&a;100481584"
	 b:glossaryEntry="illegal activities designed to stimulate sexual desire"/>
<rdf:Description rdf:about="&a;100481711"
	 b:glossaryEntry="immoderate indulgence of bodily appetites"/>
<rdf:Description rdf:about="&a;100481883"
	 b:glossaryEntry="consumption of alcoholic drinks"/>
<rdf:Description rdf:about="&a;100482009"
	 b:glossaryEntry="offering sexual intercourse for pay"/>
<rdf:Description rdf:about="&a;100482125"
	 b:glossaryEntry="dissolute indulgence in sensual pleasure"/>
<rdf:Description rdf:about="&a;100482267">
	<b:glossaryEntry>the act of drinking alcoholic beverages to excess; "drink was his downfall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100482460"
	 b:glossaryEntry="a long period of drinking"/>
<rdf:Description rdf:about="&a;100482545">
	<b:glossaryEntry>a tour of bars or public houses (usually taking one drink at each stop)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100482672"
	 b:glossaryEntry="a bout of drinking or drug taking"/>
<rdf:Description rdf:about="&a;100482755"
	 b:glossaryEntry="lack of honesty; acts of lying or cheating or stealing"/>
<rdf:Description rdf:about="&a;100482966"
	 b:glossaryEntry="an act of deliberate betrayal"/>
<rdf:Description rdf:about="&a;100483136">
	<b:glossaryEntry>activity aimed at bringing about an overthrow of a legally constituted government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100483296">
	<b:glossaryEntry>an act of betrayal; "he gave us the old double cross"; "I could no longer tolerate his impudent double-crossing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100483485"
	 b:glossaryEntry="an act of betrayal"/>
<rdf:Description rdf:about="&a;100483557"
	 b:glossaryEntry="the dishonesty of a charlatan"/>
<rdf:Description rdf:about="&a;100483656">
	<b:glossaryEntry>the act of plagiarizing; taking someone''s words or ideas as if they were your own</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100483794">
	<b:glossaryEntry>an attempt to get you to do something foolish or imprudent; "that offer was a dirty trick"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100483936"
	 b:glossaryEntry="a willful act of falsifying"/>
<rdf:Description rdf:about="&a;100484181"
	 b:glossaryEntry="an act that incriminates someone on a false charge"/>
<rdf:Description rdf:about="&a;100484294">
	<b:glossaryEntry>the act of falsely representing the ideas or work of others as your own</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100484452">
	<b:glossaryEntry>the act of distorting something so it seems to mean something it was not intended to mean</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100484648"
	 b:glossaryEntry="falsification by means of vague or ambiguous language"/>
<rdf:Description rdf:about="&a;100484777"
	 b:glossaryEntry="the deliberate act of deviating from the truth"/>
<rdf:Description rdf:about="&a;100484923"
	 b:glossaryEntry="a trivial act of lying"/>
<rdf:Description rdf:about="&a;100485011"
	 b:glossaryEntry="the act of faking (or the product of faking)"/>
<rdf:Description rdf:about="&a;100485108"
	 b:glossaryEntry="the act of deceiving"/>
<rdf:Description rdf:about="&a;100485403">
	<b:glossaryEntry>deceitful action that is not straightforward; "he could see through the indirections of diplomats"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100485559">
	<b:glossaryEntry>the use of tricks to deceive someone (usually to extract money from them)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100485763">
	<b:glossaryEntry>acting in bad faith; deception by pretending to entertain one set of intentions while acting under the influence of another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100485959"
	 b:glossaryEntry="deliberate trickery intended to gain an advantage"/>
<rdf:Description rdf:about="&a;100486135">
	<b:glossaryEntry>anything that is supposed to be valuable but turns out to be worthless</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100486261">
	<b:glossaryEntry xml:space='preserve'><![CDATA[artful trickery designed to achieve an end; "the senator''s tax program was mere jugglery"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100486405"
	 b:glossaryEntry="a fraudulent business scheme"/>
<rdf:Description rdf:about="&a;100486495"
	 b:glossaryEntry="a deception for profit to yourself"/>
<rdf:Description rdf:about="&a;100486610">
	<b:glossaryEntry>an act of gerrymandering (dividing a voting area so as to give your own party an unfair advantage)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100486766"
	 b:glossaryEntry="deception by creating illusory ideas"/>
<rdf:Description rdf:about="&a;100486869"
	 b:glossaryEntry="the act of pretending"/>
<rdf:Description rdf:about="&a;100487065">
	<b:glossaryEntry>pretending that something is the case in order to make a good impression; "they try to keep up appearances"; "that ceremony is just for show"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100487270"
	 b:glossaryEntry="the enactment of a pretense"/>
<rdf:Description rdf:about="&a;100487356"
	 b:glossaryEntry="a deliberate pretense or exaggerated display"/>
<rdf:Description rdf:about="&a;100487495">
	<b:glossaryEntry>a theatrical pose created for effect; "the actor struck just the right attitude"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100487630">
	<b:glossaryEntry xml:space='preserve'><![CDATA[making a false outward show; "a beggar''s masquerade of wealth"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100487749"
	 b:glossaryEntry="pretending to be another person"/>
<rdf:Description rdf:about="&a;100487852"
	 b:glossaryEntry="a deliberate act intended to make something obscure"/>
<rdf:Description rdf:about="&a;100487962">
	<b:glossaryEntry>the act of bluffing in poker; deception by a false show of confidence in the strength of your cards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100488126">
	<b:glossaryEntry>a lapse into sin; a loss of innocence or of chastity; "a fall from virtue"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100488251">
	<b:glossaryEntry>an act that is regarded by theologians as a transgression of God''s will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100488472">
	<b:glossaryEntry>a sin committed of your own free will (as contrasted with original sin)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100488618">
	<b:glossaryEntry>a sin inherited by all descendants of Adam; "Adam and Even committed the original sin when they ate the forbidden fruit in the Garden of Eden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100488837">
	<b:glossaryEntry>an unpardonable sin entailing a total loss of grace; theologians list 7 mortal sins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100489134">
	<b:glossaryEntry>a pardonable sin regarded as entailing only a partial loss of grace</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100489276">
	<b:glossaryEntry>unreasonable and inordinate self-esteem (personified as one of the deadly sins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100489418">
	<b:glossaryEntry>spite and resentment at seeing the success of another (personified as one of the deadly sins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100489572">
	<b:glossaryEntry>reprehensible acquisitiveness; insatiable desire for wealth (personified as one of the deadly sins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100489770">
	<b:glossaryEntry>apathy and inactivity in the practice of virtue (personified as one of the deadly sins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100489929">
	<b:glossaryEntry>belligerence aroused by a real or supposed wrong (personified as one of the deadly sins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100490089"
	 b:glossaryEntry="eating to excess (personified as one of the deadly sins)"/>
<rdf:Description rdf:about="&a;100490220">
	<b:glossaryEntry>self-indulgent sexual desire (personified as one of the deadly sins)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100490349">
	<b:glossaryEntry>the systematic use of violence as a means to intimidate or coerce societies or governments</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100490495"
	 b:glossaryEntry="an act of terrorism"/>
<rdf:Description rdf:about="&a;100490590"
	 b:glossaryEntry="an act punishable by law; usually considered an evil act"/>
<rdf:Description rdf:about="&a;100491001">
	<b:glossaryEntry>an evil act not necessarily punishable by law; "crimes of the heart"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100491121">
	<b:glossaryEntry>some transgression committed with the assistance of someone trusted by the victim; "the police decided that the crime was an inside job"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100491314">
	<b:glossaryEntry>an intentional physical attack or beating that causes unlawful violence to another person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100491543">
	<b:glossaryEntry>a crime so serious that capital punishment is considered appropriate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100491673"
	 b:glossaryEntry="a serious crime"/>
<rdf:Description rdf:about="&a;100491849">
	<b:glossaryEntry>criminal falsification by making or altering an instrument with intent to defraud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100492002"
	 b:glossaryEntry="intentional deception resulting in injury to another person"/>
<rdf:Description rdf:about="&a;100492275">
	<b:glossaryEntry>seizure of a vehicle in transit either to rob it or divert it to an alternate destination</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100492428">
	<b:glossaryEntry>the willful and unlawful crippling or mutilation of another person</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100492547"
	 b:glossaryEntry="a crime less serious than a felony"/>
<rdf:Description rdf:about="&a;100492786">
	<b:glossaryEntry>an act that disregards an agreement or a right; "he claimed a violation of his rights under the Fifth Amendment"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100492969">
	<b:glossaryEntry>any act of molesting or interrupting or hindering or disquieting or agitating or arousing from a state of repose or otherwise depriving inhabitants of the peace and quiet to which they are entitled</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100493302"
	 b:glossaryEntry="vulgar and offensive nakedness in a public place"/>
<rdf:Description rdf:about="&a;100493430"
	 b:glossaryEntry="criminal offense of making false statements under oath"/>
<rdf:Description rdf:about="&a;100493581">
	<b:glossaryEntry>physical efforts to oppose a lawful arrest; the resistance is classified as assault and battery upon the person of the police officer attempting to make the arrest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100493807">
	<b:glossaryEntry>an illegal action inciting resistance to lawful authority and tending to cause the disruption or overthrow of the government</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100493986"
	 b:glossaryEntry="the act of committing a crime"/>
<rdf:Description rdf:about="&a;100494087">
	<b:glossaryEntry>the crime of forcing a woman to submit to sexual intercourse against her will</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100494303">
	<b:glossaryEntry>rape in which the rapist is known to the victim (as when they are on a date together)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100494444"
	 b:glossaryEntry='an assault on someone; "they made an attempt on his life"'/>
<rdf:Description rdf:about="&a;100494564"
	 b:glossaryEntry="assault with intent to rob"/>
<rdf:Description rdf:about="&a;100494644"
	 b:glossaryEntry="crimes created by statutes and not by common law"/>
<rdf:Description rdf:about="&a;100494836"
	 b:glossaryEntry="violent or brutal acts as of thugs"/>
<rdf:Description rdf:about="&a;100494925">
	<b:glossaryEntry>the offense of having two or more wives or husbands living at the same time</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100495053"
	 b:glossaryEntry="the act of taking of a person by force"/>
<rdf:Description rdf:about="&a;100495191">
	<b:glossaryEntry>the criminal act of capturing and carrying away by force a family member; if a man''s wife is abducted it is a crime against the family relationship and against the wife</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100495415">
	<b:glossaryEntry>the unlawful act of capturing and carrying away a person against their will and holding them in false imprisonment</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100495586">
	<b:glossaryEntry>an illegal enterprise (such as extortion or fraud or drug peddling or prostitution) carried on for profit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100495790"
	 b:glossaryEntry="engaging in a racket"/>
<rdf:Description rdf:about="&a;100495869">
	<b:glossaryEntry>the practice of offering something (usually money) in order to gain an illicit advantage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100496037">
	<b:glossaryEntry>bribery of a purchasing agent in order to induce the agent to enter into a transaction</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100496188">
	<b:glossaryEntry>the fraudulent appropriation of funds or property entrusted to your care but actually owned by someone else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100496453"
	 b:glossaryEntry="an attempt by speculators to defraud investors"/>
<rdf:Description rdf:about="&a;100496561">
	<b:glossaryEntry>a act of plundering (especially the embezzlement of goods on shipboard)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100496689"
	 b:glossaryEntry="use of the mails to defraud someone"/>
<rdf:Description rdf:about="&a;100496781">
	<b:glossaryEntry>misrepresentation or alteration of the true results of an election</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100496908">
	<b:glossaryEntry>comprises all acts or omissions or concealments involving breach of equitable or legal duty or trust or confidence</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100497119">
	<b:glossaryEntry>fraud that prevents a party from knowing their rights or from having a fair opportunity of presenting them at trial</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100497315">
	<b:glossaryEntry>actual deceit; concealing something or making a false representation with an evil intent to cause injury to another</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100497507">
	<b:glossaryEntry>fraud that is presumed from the circumstances although the one who commits it need not have had any evil intent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100497677">
	<b:glossaryEntry>fraud that arises from a disparity between the instrument intended to be executed and the instrument actually executed; e.g., leading someone to sign the wrong contract</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100497911">
	<b:glossaryEntry>fraud which intentionally causes a person to execute and instrument or make an agreement or render a judgment; e.g., misleading someone about the true facts</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100498137">
	<b:glossaryEntry>fraud (as by use of forged documents or false claims or perjury) that misleads a court or jury and induces a finding for the one perpetrating the fraud</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100498350">
	<b:glossaryEntry>a swindle in which you cheat at gambling or persuade a person to buy worthless property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100498592">
	<b:glossaryEntry>the act of swindling by some fraudulent scheme: "that book is a fraud"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100498814">
	<b:glossaryEntry>the act of hiding playing cards in a gambling game so they are available for personal use later</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100498963"
	 b:glossaryEntry="British"/>
<rdf:Description rdf:about="&a;100499021">
	<b:glossaryEntry>a swindling sleight-of-hand game; victim guesses which of three things a pellet is under</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100499179">
	<b:glossaryEntry>the act of stealing; "the thieving is awful at Kennedy International"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100499505"
	 b:glossaryEntry="the act of stealing small amounts or small articles"/>
<rdf:Description rdf:about="&a;100499612"
	 b:glossaryEntry="the act of stealing goods that are on display in a store"/>
<rdf:Description rdf:about="&a;100499726"
	 b:glossaryEntry="larceny by threat of violence"/>
<rdf:Description rdf:about="&a;100499935"
	 b:glossaryEntry="robbery at gunpoint"/>
<rdf:Description rdf:about="&a;100500041"
	 b:glossaryEntry="a crime that undermines the offender''s government"/>
<rdf:Description rdf:about="&a;100500174"
	 b:glossaryEntry="a vice that is illegal"/>
<rdf:Description rdf:about="&a;100500307">
	<b:glossaryEntry>an act that is legally a crime but that seem to have no victims; "he considers prostitution to be a victimless crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100500487"
	 b:glossaryEntry="a crime committed in wartime; violation of rules of war"/>
<rdf:Description rdf:about="&a;100500598">
	<b:glossaryEntry>a crime (especially a robbery); "the gang pulled off a bank job in St. Louis"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100500733"
	 b:glossaryEntry="(in India and Burma) robbery by a gang of armed dacoits"/>
<rdf:Description rdf:about="&a;100500852"
	 b:glossaryEntry="(slang) the act of stealing"/>
<rdf:Description rdf:about="&a;100500941"
	 b:glossaryEntry="robbery of a traveller or vehicle by force"/>
<rdf:Description rdf:about="&a;100501053">
	<b:glossaryEntry>robbery on the high seas; taking a ship away from the control of those who are legally entitled to it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100501222">
	<b:glossaryEntry>the act of robbing a helpless person; "he was charged with rolling drunks in the park"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100501362">
	<b:glossaryEntry>larceny of property having a value greater than some amount (the amount varies by locale)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100501529">
	<b:glossaryEntry>larceny of property having a value less than some amount (the amount varies by locale)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100501709">
	<b:glossaryEntry>failure to declare income in order to avoid paying taxes on it</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100501826">
	<b:glossaryEntry>the felonious act of extorting money (as by threats of violence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100502000">
	<b:glossaryEntry>extortion of money by threats to divulge discrediting information</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100502121">
	<b:glossaryEntry>payment extorted by gangsters on threat of violence; "every store in the neighborhood had to pay him protection"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100502300"
	 b:glossaryEntry="(slang) extortion of money (as by blackmail)"/>
<rdf:Description rdf:about="&a;100502400">
	<b:glossaryEntry>entering a building at night with intent to commit a felony or to steal valuable property</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100502562"
	 b:glossaryEntry="trespassing for an unlawful purpose"/>
<rdf:Description rdf:about="&a;100502692">
	<b:glossaryEntry>any venturesome undertaking especially one with an uncertain outcome</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100502904">
	<b:glossaryEntry>a venture by a partnership or conglomerate designed to share risk or expertise: "a joint venture between the film companies to produce TV shows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100503108">
	<b:glossaryEntry>a purposeful or industrious undertaking (especially one that requires effort or boldness); "he had doubts about the whole enterprise"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100503375">
	<b:glossaryEntry>a venture at something new or different; "as an experiment he decided to grow a beard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100503518"
	 b:glossaryEntry="a hopeless or desperate enterprise"/>
<rdf:Description rdf:about="&a;100503611">
	<b:glossaryEntry>earnest and conscientious activity intended to do or accomplish something: "made an effort to cover all the reading material"; "wished him luck in his endeavor"; "she gave it a good try"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100504213">
	<b:glossaryEntry>an attempt to get something; "they made a futile play for power"; "he made a bid to gain attention"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100504369"
	 b:glossaryEntry="a tentative attempt"/>
<rdf:Description rdf:about="&a;100504440">
	<b:glossaryEntry xml:space='preserve'><![CDATA[any one of a number of individual efforts in a common endeavor: "I am proud of my contribution to the team''s success"; "they all did their share of the work"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100504689"
	 b:glossaryEntry='the part you are expected to play; "he held up his end"'/>
<rdf:Description rdf:about="&a;100504794">
	<b:glossaryEntry>an aggressive attempt to compel acquiescence by the concentration or manipulation of power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100504966">
	<b:glossaryEntry>a usually brief attempt; "he took a crack at it"; "I gave it a whirl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100505123"
	 b:glossaryEntry="taking the bull by the horns"/>
<rdf:Description rdf:about="&a;100505274">
	<b:glossaryEntry>the act of confronting bravely; "he hated facing the facts"; "he excelled in the face of danger"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100505430">
	<b:glossaryEntry xml:space='preserve'><![CDATA[an initial attempt (especially outside your usual areas of competence); "scientists'' forays into politics"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100505588"
	 b:glossaryEntry="an attempt to acquire or gain something"/>
<rdf:Description rdf:about="&a;100505681"
	 b:glossaryEntry="an effortful attempt to attain a goal"/>
<rdf:Description rdf:about="&a;100505798">
	<b:glossaryEntry>an energetic attempt to achieve something; "getting through the crowd was a real struggle"; "he fought a battle for recognition"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100506044">
	<b:glossaryEntry>any struggle between two skillful opponents (individuals or groups)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100506162"
	 b:glossaryEntry="an unceremonious and disorganized struggle"/>
<rdf:Description rdf:about="&a;100506269">
	<b:glossaryEntry>acquisition of a company by purchasing a controlling percentage of its stock</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100506452">
	<b:glossaryEntry>an acquisition based on analysis of the benefits of consolidation in anticipation of increased earning power</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100506623">
	<b:glossaryEntry>a change by sale or merger in the controlling interest of a corporation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100506785"
	 b:glossaryEntry="resistance to or defense against a hostile takeover"/>
<rdf:Description rdf:about="&a;100506904"
	 b:glossaryEntry="an attempt to take control of a corporation"/>
<rdf:Description rdf:about="&a;100507046"
	 b:glossaryEntry="an offer to buy shares in order to take over the company"/>
<rdf:Description rdf:about="&a;100507197">
	<b:glossaryEntry>a takeover bid where the acquirer offers to pay more for the shares needed to gain control than for the remaining shares</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100507376">
	<b:glossaryEntry>a takeover bid where the acquirer offers to buy any and all shares outstanding</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100507516">
	<b:glossaryEntry>a takeover that is resisted by the management of the target company</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100507646">
	<b:glossaryEntry>a takeover that is welcomed by the management of the target company</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100507777">
	<b:glossaryEntry>the act of testing something; "in the experimental trials the amount of carbon was measured separately"; "he called each flip of the coin a new trial"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100508046">
	<b:glossaryEntry>the act of undergoing testing; "he survived the great test of battle"; "candidates must compete in a trial of skill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100508221"
	 b:glossaryEntry="a test of the suitability of a performer"/>
<rdf:Description rdf:about="&a;100508343"
	 b:glossaryEntry="a filmed audition of an actor or actress"/>
<rdf:Description rdf:about="&a;100508441"
	 b:glossaryEntry="trying on clothes to see whether they fit"/>
<rdf:Description rdf:about="&a;100508557">
	<b:glossaryEntry>activity planned as a test or trial; "they funded a pilot project in six states"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100508713">
	<b:glossaryEntry>dull or routine preliminary work preparing for an undertaking</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100508830"
	 b:glossaryEntry="work paid for at a rate per unit of time"/>
<rdf:Description rdf:about="&a;100508925"
	 b:glossaryEntry="any piece of work"/>
<rdf:Description rdf:about="&a;100509169"
	 b:glossaryEntry="a wild and exciting undertaking (not necessarily lawful)"/>
<rdf:Description rdf:about="&a;100509332">
	<b:glossaryEntry>a project of personal concern to someone; "this project is his baby"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100509451"
	 b:glossaryEntry="any long and arduous undertaking"/>
<rdf:Description rdf:about="&a;100509558"
	 b:glossaryEntry="(informal) anything that requires little thought"/>
<rdf:Description rdf:about="&a;100509663">
	<b:glossaryEntry>a formidable task or requirement; "finishing in time was a tall order but we did it"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100509818"
	 b:glossaryEntry="the pastime of exploring caves"/>
<rdf:Description rdf:about="&a;100509919">
	<b:glossaryEntry>a series of actions advancing a principle or tending toward a particular end; "he supported populist campaigns"; "they worked in the cause of world peace"; "the team was ready for a drive toward the pennant"; "the movement to end slavery"; "contributed to the war effort"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100510453">
	<b:glossaryEntry>a campaign aimed to correct abuses or malpractices; "the reforms he proposed were too radical for the politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100510620"
	 b:glossaryEntry="a campaign to raise money for some cause"/>
<rdf:Description rdf:about="&a;100510771"
	 b:glossaryEntry="the movement aimed at equal rights for women"/>
<rdf:Description rdf:about="&a;100510953">
	<b:glossaryEntry>the movement aimed at liberating homosexuals from legal or social or economic oppression</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100511121">
	<b:glossaryEntry>a movement among Protestant groups aimed at universal Christian unity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100511256">
	<b:glossaryEntry>political or religious or social reform movement or agitation consisting chiefly of young people</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100511429"
	 b:glossaryEntry="the campaign of a candidate to be elected"/>
<rdf:Description rdf:about="&a;100511628">
	<b:glossaryEntry>the organized dissemination of derogatory rumors designed to discredit a candidate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100511776">
	<b:glossaryEntry>campaigning for something by making political speeches (stump speeches)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100511902"
	 b:glossaryEntry="an organized program of advertisements"/>
<rdf:Description rdf:about="&a;100512068">
	<b:glossaryEntry>a concerted campaign to end something that is injurious; "the war on poverty"; "the war against crime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100512220"
	 b:glossaryEntry="an advertising campaign intended to promote sales"/>
<rdf:Description rdf:about="&a;100512330"
	 b:glossaryEntry="an advertising campaign intended to improve public relations"/>
<rdf:Description rdf:about="&a;100512462">
	<b:glossaryEntry>a venture off the beaten path; "a sally into the wide world beyond his home"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100512607">
	<b:glossaryEntry>the act of helping or improving yourself without relying on anyone else</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100512734">
	<b:glossaryEntry>a venture undertaken without regard to possible loss or injury; "he saw the rewards but not the risks of crime"; "there was a danger he would do the wrong thing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100512999">
	<b:glossaryEntry>a risk involving danger; "you take a chance when you let her drive"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100513119"
	 b:glossaryEntry="a risky act or venture"/>
<rdf:Description rdf:about="&a;100513230">
	<b:glossaryEntry>a venture that involves great risk but promises great rewards</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100513347">
	<b:glossaryEntry xml:space='preserve'><![CDATA[increasing the size of a bet (as in poker); "I''ll see your raise and double it"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100513496">
	<b:glossaryEntry>raising the stakes in a card game by a factor of 2; "I decided his double was a bluff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100513665">
	<b:glossaryEntry>the activity of managing or exerting control over something; "the control of the mob by the police was admirable"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100514134"
	 b:glossaryEntry="activity of controlling a crowd"/>
<rdf:Description rdf:about="&a;100514225"
	 b:glossaryEntry="an effort to minimize or curtail damage or loss"/>
<rdf:Description rdf:about="&a;100514333">
	<b:glossaryEntry>(engineering) act or technique of trying to control rivers with dams etc to minimize occurrence of floods</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100514498">
	<b:glossaryEntry>coordination and supervision of supply as well as storage and distribution and recording of materials to maintain adequate quantities for current needs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100514713"
	 b:glossaryEntry="any instance of aggressive extension of authority"/>
<rdf:Description rdf:about="&a;100514820">
	<b:glossaryEntry>the act of regulating; "fiscal regulations are in the hands of politicians"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100515073">
	<b:glossaryEntry>the act of freeing from regulation (especially from governmental regulations)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100515224">
	<b:glossaryEntry>(physiology) maintaining a generally constant physiological state in a cell or organism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100515372">
	<b:glossaryEntry>an official lowering of a nation''s currency; a decrease in the value of a country''s currency relative to that of foreign countries</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100515560"
	 b:glossaryEntry="efforts to regulate or control sales of guns"/>
<rdf:Description rdf:about="&a;100515662">
	<b:glossaryEntry>a system of economic regulation: wages and interest are tied to the cost-of-living index in order to reduce the effects of inflation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100515851"
	 b:glossaryEntry="maintenance of standards of quality of manufactured goods"/>
<rdf:Description rdf:about="&a;100515970">
	<b:glossaryEntry>the regulation of diverse elements into an integrated and harmonious operation</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100516143">
	<b:glossaryEntry>coordinating by causing to indicate the same time; "the synchronization of their watches was an important preliminary"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100516357">
	<b:glossaryEntry>cutting off the electric current on certain lines when the demand becomes greater than the supply</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100516514">
	<b:glossaryEntry>the proproportional limitation of production or distribution of something (e.g. crude oil or natural gas) to some fractional part of the total capacity of each producer</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100516738"
	 b:glossaryEntry="an act of limiting or restricting (as by regulation)"/>
<rdf:Description rdf:about="&a;100516933">
	<b:glossaryEntry>a limitation on the size and armament of the armed forces of a country</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100517062">
	<b:glossaryEntry>fixing (of prices or wages etc) at a particular level: "a freeze on hiring"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100517208"
	 b:glossaryEntry="sudden restriction on an activity"/>
<rdf:Description rdf:about="&a;100517297"
	 b:glossaryEntry="the fixing of wages at a given level"/>
<rdf:Description rdf:about="&a;100517391"
	 b:glossaryEntry='the act of possessing; "they took possession of the ball"'/>
<rdf:Description rdf:about="&a;100517535"
	 b:glossaryEntry="the act of keeping in your possession"/>
<rdf:Description rdf:about="&a;100517684">
	<b:glossaryEntry>the act of holding back or keeping within your possession or control; "I resented his withholding permission"; "there were allegations of the withholding of evidence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100517908"
	 b:glossaryEntry="the act of storing something"/>
<rdf:Description rdf:about="&a;100518008">
	<b:glossaryEntry>preservation and methodical arrangement as of documents and papers etc: "I having some filing to do"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100518162"
	 b:glossaryEntry="the commercial enterprise of storing goods and materials"/>
<rdf:Description rdf:about="&a;100518308"
	 b:glossaryEntry="the act of packing or storing away"/>
<rdf:Description rdf:about="&a;100518406"
	 b:glossaryEntry="the act of storing in tanks"/>
<rdf:Description rdf:about="&a;100518487"
	 b:glossaryEntry="the measures taken to control a riot"/>
<rdf:Description rdf:about="&a;100518608"
	 b:glossaryEntry="the act of gripping something firmly with the hands"/>
<rdf:Description rdf:about="&a;100518769">
	<b:glossaryEntry>the act of grasping; "he released his clasp on my arm"; "he has a strong grip for an old man"; "she kept a firm hold on the railing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100519040"
	 b:glossaryEntry="a hold used in the sport of wrestling"/>
<rdf:Description rdf:about="&a;100519301">
	<b:glossaryEntry>a wrestling hold with arms locked tightly around the opponent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100519417">
	<b:glossaryEntry>a wrestling hold in which the holder puts both arms under the opponent''s arms and exerts pressure on the back of the neck (illegal in amateur wrestling)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100519627">
	<b:glossaryEntry>a wrestling hold in which the holder puts an arm under the opponent''s arm and exerts press on the back of the neck</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100519799">
	<b:glossaryEntry>a wrestling hold in which the opponent''s arm is twisted up behind his back</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100519930">
	<b:glossaryEntry>a wrestling hold in which the opponent''s head is locked between the crook of your elbow and the side of your body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100520098">
	<b:glossaryEntry>a wrestling hold in which the opponent''s arms are crossed in front of his own neck to exert pressure on his windpipe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100520282">
	<b:glossaryEntry>any wrestling hold in which some part of the opponent''s body is twisted or pressured</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100520453">
	<b:glossaryEntry>a wrestling_hold in which you wrap your legs around the opponents body and put your feet together and squeeze</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100520617">
	<b:glossaryEntry>a wrestling hold in which the arms are pressed against the opponent''s windpipe</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100520754">
	<b:glossaryEntry>a wrestling hold in which the toe is held and the leg is twisted against the joints</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100520891"
	 b:glossaryEntry="the act of steering a ship"/>
<rdf:Description rdf:about="&a;100521002">
	<b:glossaryEntry>the act of setting and holding a course; "a new council was installed under the direction of the king"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100521308">
	<b:glossaryEntry>the action of directing something at an object; "he took aim and fired"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100521429"
	 b:glossaryEntry="the guidance of ships or airplanes from place to place"/>
<rdf:Description rdf:about="&a;100521616"
	 b:glossaryEntry="navigation of an airplane solely by instruments"/>
<rdf:Description rdf:about="&a;100521727"
	 b:glossaryEntry="navigating according to the positions of the stars"/>
<rdf:Description rdf:about="&a;100521862">
	<b:glossaryEntry>a method of controlling the flight of a missile or spacecraft by reference to the positions of celestial bodies</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100522038">
	<b:glossaryEntry>a method of controlling the flight of a missile by devices that respond to inertial forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100522214">
	<b:glossaryEntry>a method of controlling the flight of a missile by commands originating from the ground or from another missile</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100522388">
	<b:glossaryEntry>a method of controlling the flight of a missile by devices that respond to the strength and direction of the earth''s gravitational field</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100522591"
	 b:glossaryEntry="navigation without the aid of celestial observations"/>
<rdf:Description rdf:about="&a;100522704">
	<b:glossaryEntry>(during World War II in Britain) watching for fires started by bombs that dropped from the sky</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100522858">
	<b:glossaryEntry>the activity of protecting someone or something; "the witnesses demanded police protection"; "he hated to spend so much time guarding his new car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100523391"
	 b:glossaryEntry="the act of shielding from harm"/>
<rdf:Description rdf:about="&a;100523477">
	<b:glossaryEntry>the responsibility of a guardian or keeper; "he left his car in my keeping"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100523653">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(with `in'') guardianship over; "my fate is in your hands"; "too much power in the president''s hands"; "the children are in the custody of their mother"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100523866"
	 b:glossaryEntry="the activity of protecting something from loss or danger"/>
<rdf:Description rdf:about="&a;100524093">
	<b:glossaryEntry>the preservation and careful management of the environment and of natural resources</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100524316"
	 b:glossaryEntry="protection of soil against erosion or deterioration"/>
<rdf:Description rdf:about="&a;100524431"
	 b:glossaryEntry="the conservation of petroleum resources"/>
<rdf:Description rdf:about="&a;100524533"
	 b:glossaryEntry="the conservation of water resources"/>
<rdf:Description rdf:about="&a;100524633">
	<b:glossaryEntry>preservation of oneself from harm; a natural or instinctive tendency</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100524765">
	<b:glossaryEntry>the act of keeping back or setting aside for some future occasion</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100524888">
	<b:glossaryEntry>preservation (of a dead body) by treating with balsams and drugs and other chemicals</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100525047"
	 b:glossaryEntry="embalmment and drying a dead body and wrapping it as a mummy"/>
<rdf:Description rdf:about="&a;100525167"
	 b:glossaryEntry="excessive protection"/>
<rdf:Description rdf:about="&a;100525273">
	<b:glossaryEntry>intelligence on the identity and capability and intentions of hostile individuals or organizations that may be engaged in espionage or sabotage or subversion or terrorism</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100525511">
	<b:glossaryEntry>counterintelligence achieved by banning or deleting any information of value to the enemy</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100525723">
	<b:glossaryEntry>all types of censorship conducted by personnel of the armed forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100525927">
	<b:glossaryEntry>military censorship of civilian communications (correspondence or printed matter of films) entering or leaving of circulating within territories controlled by armed forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100526161">
	<b:glossaryEntry>security review of news (including all information or material intended for dissemination to the public) subject to the jurisdiction of the armed forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100526382">
	<b:glossaryEntry>military censorship of communication to and from prisoners of war and civilian internees held by the armed forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100526568">
	<b:glossaryEntry>military censorship of personal communications to or from persons in the armed forces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100526759">
	<b:glossaryEntry>armed forces censorship performed by personnel of a military unit on the personal communications of persons assigned to that unit</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100526953">
	<b:glossaryEntry>armed forces censorship of the personal communications of officers or civilian employees or enlisted personnel not subject to primary censorship</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100527164">
	<b:glossaryEntry>censorship under civil authority of communications entering or leaving of crossing the borders of the United States or its territories or possessions</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100527379"
	 b:glossaryEntry="warding off an impending threat"/>
<rdf:Description rdf:about="&a;100527497">
	<b:glossaryEntry>measures taken as a precaution against theft or espionage or sabotage etc.; "military security has been stepped up since the recent uprising"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100527713">
	<b:glossaryEntry>protection from harm; "sanitation is the best defense against disease"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100527847">
	<b:glossaryEntry>taking a vaccine as a precaution against contracting a disease</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100527981">
	<b:glossaryEntry>the act of protecting against disease by introducing a vaccine into the body to induce immunity</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100528148">
	<b:glossaryEntry>the activity of going around or through an area at regular intervals for security purposes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100528304"
	 b:glossaryEntry="the act of defending yourself"/>
<rdf:Description rdf:about="&a;100528443"
	 b:glossaryEntry="a Japanese martial art employing principles similar to judo"/>
<rdf:Description rdf:about="&a;100528555">
	<b:glossaryEntry>any of several Oriental arts of weaponless self-defense; usually practiced as a sport; "he had a black belt in the martial arts"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100528849">
	<b:glossaryEntry>a sport adapted from jujitsu (using principles of not resisting) and similar to wrestling; developed in Japan</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100529027">
	<b:glossaryEntry>a method of self-defense without weapons that was developed in China and Japan; holds and blows are supplemented by clever use of the attacker''s own weight and strength</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100529260">
	<b:glossaryEntry>a traditional Japanese system of unarmed combat; sharp blows and kicks are given to pressure-sensitive points on the body of the opponent</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100529450">
	<b:glossaryEntry>a Chinese martial art; combines principles of karate and judo</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100529565"
	 b:glossaryEntry="a Korean martial art similar to karate"/>
<rdf:Description rdf:about="&a;100529661">
	<b:glossaryEntry>the act of insulating for the purposes of protecting something</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100529798">
	<b:glossaryEntry>the act of attaching an inside lining (to a garment or curtain etc.)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100529919"
	 b:glossaryEntry="providing something with a surface of a different material"/>
<rdf:Description rdf:about="&a;100530057"
	 b:glossaryEntry="lining a surface or bearing with babbitt metal"/>
<rdf:Description rdf:about="&a;100530172"
	 b:glossaryEntry="the act of locking something up to protect it"/>
<rdf:Description rdf:about="&a;100530280">
	<b:glossaryEntry>the act of accompanying someone or something in order to protect them</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100530436"
	 b:glossaryEntry="the act of escorting while in transit"/>
<rdf:Description rdf:about="&a;100530526"
	 b:glossaryEntry="the act of protecting something by covering it"/>
<rdf:Description rdf:about="&a;100530645"
	 b:glossaryEntry="the activity of getting dressed"/>
<rdf:Description rdf:about="&a;100530778">
	<b:glossaryEntry xml:space='preserve'><![CDATA[careful or finicky grooming; "the boss didn''t want them to waste time primping"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100530912">
	<b:glossaryEntry>the act of dressing and preparing yourself; "he made his toilet and went to breakfast"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100531051"
	 b:glossaryEntry="processes in the conversion of rough hides into leather"/>
<rdf:Description rdf:about="&a;100531161"
	 b:glossaryEntry="the act of making immune (especially by inoculation)"/>
<rdf:Description rdf:about="&a;100531323">
	<b:glossaryEntry>rendering an organism sensitive to a serum by a series of injections</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100531481">
	<b:glossaryEntry>attention and management implying responsibility for safety; "he is under the care of a physician"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100531737">
	<b:glossaryEntry>the guardianship and control exercised by a deity; "divine providence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100531864">
	<b:glossaryEntry>the act of making a piece of equipment rugged (strengthening to resist wear or abuse)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100532025">
	<b:glossaryEntry>a formation of military planes maintained over ground operations or targets; "an air umbrella over England"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100532187"
	 b:glossaryEntry="the act of treating something to make it repel water"/>
<rdf:Description rdf:about="&a;100532309"
	 b:glossaryEntry='the act of wearing; "she bought it for everyday wear"'/>
<rdf:Description rdf:about="&a;100532423">
	<b:glossaryEntry>(physiology) regulation or maintenance of a function or action or reflex etc; "the timing and control of his movements were unimpaired"; "he had lost control of his sphincters"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100532671"
	 b:glossaryEntry="control of muscles"/>
<rdf:Description rdf:about="&a;100532749">
	<b:glossaryEntry>the process of taking in oxygen from the air and releasing carbon dioxide</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100533092">
	<b:glossaryEntry>an emergency procedure whereby respiration that is maintained artificially</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100533254">
	<b:glossaryEntry>recording the activity of the heart electronically with a cardiograph (and producing a cardiogram)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100533434">
	<b:glossaryEntry>an emergency procedure that employs rhythmic compression of the heart (either through the chest wall or (during surgery) directly to the heart) in an attempt to maintain circulation during cardiac arrest</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100533752">
	<b:glossaryEntry>an emergency procedure consisting of external cardiac massage and artificial respiration; the first treatment for a person who has collapsed and has no pulse and has stopped breathing; attempts to restore circulation of the blood and prevent death or brain damage due to lack of oxygen</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100534181">
	<b:glossaryEntry>an emergency procedure to help someone who is choking because food is lodged in the trachea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100534336">
	<b:glossaryEntry>breathing in which most of the respiratory effort is done by the abdominal muscles; "abdominal breathing is practiced by singers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100534531">
	<b:glossaryEntry>abnormal respiration in which periods of shallow and deep breathing alternate</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100534701">
	<b:glossaryEntry>energetic (deep and rapid) respiration that occurs normally after exercise or abnormally with fever or various disorders</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100534877">
	<b:glossaryEntry>an increased depth and rate of breathing greater than demanded by the body needs; can cause dizziness and tingling of the fingers and toes and chest pain if continued</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100535106"
	 b:glossaryEntry="breathing heavily (as after exertion)"/>
<rdf:Description rdf:about="&a;100535207"
	 b:glossaryEntry="an act of forcible exhalation"/>
<rdf:Description rdf:about="&a;100535312">
	<b:glossaryEntry>the act of breathing heavily through the nose (as when the nose is congested)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100535462">
	<b:glossaryEntry>the act of smoking tobacco or other substances; "he went outside for a smoke"; "smoking stinks"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100535656">
	<b:glossaryEntry>blowing tobacco smoke out into the air; "they smoked up the room with their ceaseless puffing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100535804">
	<b:glossaryEntry>the process of taking in and expelling air during breathing; "he took a deep breath and dived into the pool"; "he was fighting to his last breath"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100536039"
	 b:glossaryEntry="the act of inhaling"/>
<rdf:Description rdf:about="&a;100536235">
	<b:glossaryEntry>forceful exhalation through the nose or mouth; "he gave his nose a loud blow"; "he blew out all the candles with a single puff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100536438"
	 b:glossaryEntry="an act of blowing or breathing on or into something"/>
<rdf:Description rdf:about="&a;100536548"
	 b:glossaryEntry="the act of snoring or producing a snoring sound"/>
<rdf:Description rdf:about="&a;100536667"
	 b:glossaryEntry="breathing with a husky or whistling sound"/>
<rdf:Description rdf:about="&a;100536761"
	 b:glossaryEntry='breath; "the collision knocked the wind out of him"'/>
<rdf:Description rdf:about="&a;100536863"
	 b:glossaryEntry="the act of inhaling"/>
<rdf:Description rdf:about="&a;100537041">
	<b:glossaryEntry>a short labored intake of breath with the mouth open; "she gave a gasp and fainted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100537182"
	 b:glossaryEntry="an involuntary intake of breath through a wide open mouth"/>
<rdf:Description rdf:about="&a;100537290">
	<b:glossaryEntry>a slow inhalation (as of tobacco smoke); "he took a puff on his pipe"; "he took a drag on his cigarette and expelled the smoke slowly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100537526">
	<b:glossaryEntry>a puff of a marijuana or hashish cigarette: "the boys took a few tokes on a joint"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100537659">
	<b:glossaryEntry>the process of taking food into the body through the mouth (as by eating)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100537892"
	 b:glossaryEntry="the act of consuming food"/>
<rdf:Description rdf:about="&a;100538233"
	 b:glossaryEntry="the act of gripping or chewing off with the teeth and jaws"/>
<rdf:Description rdf:about="&a;100538386"
	 b:glossaryEntry="the act of feeding by continual nibbling"/>
<rdf:Description rdf:about="&a;100538490">
	<b:glossaryEntry>a reflex response to the passage of electric current through the body</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100538647"
	 b:glossaryEntry="a reflex that expels intestinal gas through the anus"/>
<rdf:Description rdf:about="&a;100538792">
	<b:glossaryEntry>the act of swallowing; "one swallow of the liquid was enough"; "he took a drink of his beer and smacked his lips"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100539035">
	<b:glossaryEntry>swallowing air (usually followed by belching and discomfort and flatulence)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100539167">
	<b:glossaryEntry>a large and hurried swallow; "he finished it at a single gulp"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100539305"
	 b:glossaryEntry="a spasmodic reflex of the throat made as if in swallowing"/>
<rdf:Description rdf:about="&a;100539423"
	 b:glossaryEntry="the act of eating dinner"/>
<rdf:Description rdf:about="&a;100539518">
	<b:glossaryEntry>eating an elaborate meal (often accompanied by entertainment)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100539647"
	 b:glossaryEntry="the act of grazing"/>
<rdf:Description rdf:about="&a;100539727"
	 b:glossaryEntry="the act of eating lunch"/>
<rdf:Description rdf:about="&a;100539805"
	 b:glossaryEntry="chewing steadily"/>
<rdf:Description rdf:about="&a;100539887"
	 b:glossaryEntry="a dinner where each person pays for his own"/>
<rdf:Description rdf:about="&a;100539988"
	 b:glossaryEntry="eating until excessively full"/>
<rdf:Description rdf:about="&a;100540083"
	 b:glossaryEntry="eating liquid food with a spoon or by drinking"/>
<rdf:Description rdf:about="&a;100540183"
	 b:glossaryEntry="taking a small amount into the mouth to test its quality"/>
<rdf:Description rdf:about="&a;100540316"
	 b:glossaryEntry="gentle biting"/>
<rdf:Description rdf:about="&a;100540382"
	 b:glossaryEntry="small sharp biting"/>
<rdf:Description rdf:about="&a;100540458"
	 b:glossaryEntry="feeding on corpses or carrion"/>
<rdf:Description rdf:about="&a;100540558"
	 b:glossaryEntry="the eating of raw food"/>
<rdf:Description rdf:about="&a;100540636"
	 b:glossaryEntry="the eating of excrement or other filth"/>
<rdf:Description rdf:about="&a;100540731"
	 b:glossaryEntry="the act of sucking"/>
<rdf:Description rdf:about="&a;100540820"
	 b:glossaryEntry="the act of consuming liquids"/>
<rdf:Description rdf:about="&a;100540981"
	 b:glossaryEntry="drinking large mouthfuls rapidly"/>
<rdf:Description rdf:about="&a;100541089"
	 b:glossaryEntry="drinking small amounts slowly"/>
<rdf:Description rdf:about="&a;100541182"
	 b:glossaryEntry="a small drink"/>
<rdf:Description rdf:about="&a;100541251"
	 b:glossaryEntry="the act of drinking (especially an alcoholic drink)"/>
<rdf:Description rdf:about="&a;100541357">
	<b:glossaryEntry>mutual sexual gratification without the exchange of bodily fluids</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100541480">
	<b:glossaryEntry>sexual activity (especially sexual intercourse) with the use of measures (such as latex condoms) to avoid the transmission of disease (especially AIDS)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100541686">
	<b:glossaryEntry>activities associated with sexual intercourse; "they had sex in the back seat"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100542207">
	<b:glossaryEntry>the act of becoming pregnant; fertilization of an ovum by a spermatozoon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100542336"
	 b:glossaryEntry="the introduction of semen into the genital tract of a female"/>
<rdf:Description rdf:about="&a;100542492">
	<b:glossaryEntry>the introduction of semen into the oviduct or uterus by some means other than sexual intercourse</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100542663">
	<b:glossaryEntry>the act of sexual procreation between a man and a woman; the man''s penis is inserted into the woman''s vagina and excited until orgasm and ejaculation occur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;100543107"
	 b:glossaryEntry="slang terms for sexual intercourse"/>
