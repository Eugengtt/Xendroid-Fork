	 b:glossaryEntry="large family of important mostly marine food fishes"/>
<rdf:Description rdf:about="&a;102015068"
	 b:glossaryEntry="type genus of the Gadidae: the typical codfishes"/>
<rdf:Description rdf:about="&a;102015220"
	 b:glossaryEntry="major food fish of arctic and cold-temperate waters"/>
<rdf:Description rdf:about="&a;102015440"
	 b:glossaryEntry="young codfish"/>
