	 b:glossaryEntry="the property of being suitable for singing"/>
<rdf:Description rdf:about="&a;103894766"
	 b:glossaryEntry="the property of having a melody"/>
<rdf:Description rdf:about="&a;103894871">
	<b:glossaryEntry>the musical pattern created by parts being played or sung together; "then another melodic line is added to the texture"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;103895044"
	 b:glossaryEntry="an agreeable sound property"/>
<rdf:Description rdf:about="&a;103895161"
	 b:glossaryEntry="the property of sounding harmonious"/>
