<rdf:Description rdf:about="&a;101864774"
	 b:glossaryEntry="mountain beavers"/>
<rdf:Description rdf:about="&a;101864911">
	<b:glossaryEntry>type genus of the Aplodontiidae: comprising the mountain beavers</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101865089">
	<b:glossaryEntry>bulky nocturnal burrowing rodent of uplands of the Pacific coast of North America; the most primitive living rodent</b:glossaryEntry>
