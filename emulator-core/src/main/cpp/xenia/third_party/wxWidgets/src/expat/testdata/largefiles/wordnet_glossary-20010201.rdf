</rdf:Description>
<rdf:Description rdf:about="&a;400252820">
	<b:glossaryEntry>one behind the other; "ride tandem on a bicycle built for two"; "riding horses down the path in tandem"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400252958"
	 b:glossaryEntry='three times; "I called you thrice last night"'/>
<rdf:Description rdf:about="&a;400253038">
