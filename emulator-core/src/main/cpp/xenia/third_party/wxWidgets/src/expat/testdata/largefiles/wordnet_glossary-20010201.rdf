	 b:glossaryEntry='in an unfair manner; "they dealt with him unfairly"'/>
<rdf:Description rdf:about="&a;400280847">
	<b:glossaryEntry>without distortion; "she played the piano accompaniment cleanly"</b:glossaryEntry>
