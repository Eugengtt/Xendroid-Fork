</rdf:Description>
<rdf:Description rdf:about="&a;109004541"
	 b:glossaryEntry="type genus of the Polygalaceae: milkwort; seneca; snakeroot"/>
<rdf:Description rdf:about="&a;109004710"
	 b:glossaryEntry="any of various plants of the genus Polygala"/>
<rdf:Description rdf:about="&a;109004917">
