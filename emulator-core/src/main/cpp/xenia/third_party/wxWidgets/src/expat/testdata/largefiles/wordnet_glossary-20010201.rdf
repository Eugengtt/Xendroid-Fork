	 b:glossaryEntry="a genus of Trochilidae"/>
<rdf:Description rdf:about="&a;101351033"
	 b:glossaryEntry="a kind of hummingbird"/>
<rdf:Description rdf:about="&a;101351140"
	 b:glossaryEntry="thornbills"/>
<rdf:Description rdf:about="&a;101351268"
	 b:glossaryEntry="thornbills"/>
