<rdf:Description rdf:about="&a;101983240"
	 b:glossaryEntry="proboscis monkeys"/>
<rdf:Description rdf:about="&a;101983346"
	 b:glossaryEntry="Borneo monkey having a long bulbous nose"/>
<rdf:Description rdf:about="&a;101983468">
	<b:glossaryEntry>New World monkeys: capuchin; douroucouli; howler monkey; saki; spider monkey; squirrel monkey; titi; uakari; woolly monkey; marmoset; tamarin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101983769">
	<b:glossaryEntry>hairy-faced arboreal monkeys having widely separated nostrils and long usually prehensile tails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101984126"
	 b:glossaryEntry="marmosets"/>
<rdf:Description rdf:about="&a;101984315">
	<b:glossaryEntry>small soft-furred South and Central American monkey with claws instead of nails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101984522"
	 b:glossaryEntry="type genus of the Callithricidae: true marmosets"/>
<rdf:Description rdf:about="&a;101984684"
	 b:glossaryEntry="a marmoset"/>
<rdf:Description rdf:about="&a;101984773"
	 b:glossaryEntry="pygmy marmosets"/>
<rdf:Description rdf:about="&a;101984898"
	 b:glossaryEntry="the smallest monkey; of tropical forests of the Amazon"/>
<rdf:Description rdf:about="&a;101985051"
	 b:glossaryEntry="tamarins"/>
<rdf:Description rdf:about="&a;101985194">
	<b:glossaryEntry>small South American marmoset with silky fur and long nonprehensile tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101985416">
	<b:glossaryEntry>golden South American monkey with long soft hair forming a mane</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101985561"
	 b:glossaryEntry="South American tamarin with a tufted head"/>
<rdf:Description rdf:about="&a;101985677"
	 b:glossaryEntry="all the New World monkeys except marmosets and tamarins"/>
<rdf:Description rdf:about="&a;101985993"
	 b:glossaryEntry="type genus of the Cebidae"/>
<rdf:Description rdf:about="&a;101986122">
	<b:glossaryEntry>monkey of Central and South America having a cowl of thick hair on the head</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101986300"
	 b:glossaryEntry="douroucoulis"/>
<rdf:Description rdf:about="&a;101986416">
	<b:glossaryEntry>nocturnal monkey of Central and South America with large eyes and thick fur</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101986588"
	 b:glossaryEntry="howler monkeys"/>
<rdf:Description rdf:about="&a;101986712">
	<b:glossaryEntry>monkey of tropical South American forests having a loud howling cry</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101986867"
	 b:glossaryEntry="sakis"/>
<rdf:Description rdf:about="&a;101986982">
	<b:glossaryEntry>small arboreal monkey of tropical South America with long hair and bushy nonprehensile tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101987143"
	 b:glossaryEntry="uakaris"/>
<rdf:Description rdf:about="&a;101987258">
	<b:glossaryEntry>medium-sized tree-dwelling monkey of the Amazon basin; only New World monkey with a short tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101987424"
	 b:glossaryEntry="titis"/>
<rdf:Description rdf:about="&a;101987543">
	<b:glossaryEntry>small South American monkeys with long beautiful fur and long nonprehensile tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101987707"
	 b:glossaryEntry="spider monkeys"/>
<rdf:Description rdf:about="&a;101987827">
	<b:glossaryEntry>arboreal monkey of tropical America with long slender legs and long prehensile tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101988008"
	 b:glossaryEntry="squirrel monkeys"/>
<rdf:Description rdf:about="&a;101988113">
	<b:glossaryEntry>small long-tailed monkey of Central and South America with greenish fur and black muzzle</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101988282"
	 b:glossaryEntry="woolly monkeys"/>
<rdf:Description rdf:about="&a;101988408">
	<b:glossaryEntry>large monkeys with dark skin and woolly fur of the Amazon and Orinoco basins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101988563">
	<b:glossaryEntry>a small order comprising only the tree shrews: in some classifications tree shrews are considered either primates (and included in the suborder Prosimii) or true insectivores (and included in the order_Insectivora)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101988891">
	<b:glossaryEntry>tree shrews; in some classifications tree shrews are considered prosimian primates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101989124"
	 b:glossaryEntry="type genus of the Tupaia: chief genus of tree shrews"/>
<rdf:Description rdf:about="&a;101989263">
	<b:glossaryEntry>insectivorous arboreal mammal of southeast Asia that resembles a squirrel with large eyes and long sharp snout</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101989467"
	 b:glossaryEntry="pentails"/>
<rdf:Description rdf:about="&a;101989591">
	<b:glossaryEntry>brown tree shrew having a naked tail bilaterally fringed with long stiff hairs on the distal third; of Malaysia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101989799">
	<b:glossaryEntry>not used in all classifications; in some classifications considered coextensive with the Lemuroidea; in others includes both Lemuroidea and Tarsioidea</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101990062">
	<b:glossaryEntry>primitive primates having large ears and eyes and characterized by nocturnal habits</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101990220">
	<b:glossaryEntry>extinct small mostly diurnal lower primates that fed on leaves and fruit; abundant in North America and Europe 30 to 50 million years ago; their descendents probably include the lemurs; some authorities consider them ancestral to anthropoids but others consider them only cousins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101990586">
	<b:glossaryEntry>Lemuridae; Lorisidae; Daubentoniidae; Indriidae; used in some classifications instead of Prosimii; in others considered a subdivision of Prosimii</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101990923">
	<b:glossaryEntry>large-eyed arboreal prosimian having foxy faces and long furry tails</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101991224">
	<b:glossaryEntry>in some classifications either coextensive with the Lemuroidea or comprising the true lemurs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101991418"
	 b:glossaryEntry="typical lemurs; of Madagascar"/>
<rdf:Description rdf:about="&a;101991560"
	 b:glossaryEntry="type genus of the Lemuridae"/>
<rdf:Description rdf:about="&a;101991683"
	 b:glossaryEntry="small lemur having its tail barred with black"/>
<rdf:Description rdf:about="&a;101991842"
	 b:glossaryEntry="comprising solely the aye-aye"/>
<rdf:Description rdf:about="&a;101991993"
	 b:glossaryEntry="type genus; coextensive with the family Daubentoniidae"/>
<rdf:Description rdf:about="&a;101992163">
	<b:glossaryEntry>nocturnal lemur with long bony fingers and rodent-like incisor teeth closely related to the lemurs</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101992365">
	<b:glossaryEntry>slow-moving omnivorous nocturnal primates of tropical Asia; usually tailless</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101992630"
	 b:glossaryEntry="type genus of the Lorisidae"/>
<rdf:Description rdf:about="&a;101992753"
	 b:glossaryEntry="slim-bodied lemur of southern India and Sri Lanka"/>
<rdf:Description rdf:about="&a;101992898"
	 b:glossaryEntry="a genus of Lorisidae"/>
<rdf:Description rdf:about="&a;101993032"
	 b:glossaryEntry="stocky lemur of southeastern Asia"/>
<rdf:Description rdf:about="&a;101993188"
	 b:glossaryEntry="a genus of Lorisidae"/>
<rdf:Description rdf:about="&a;101993326"
	 b:glossaryEntry="a kind of lemur"/>
<rdf:Description rdf:about="&a;101993444"
	 b:glossaryEntry="a genus of Lorisidae"/>
<rdf:Description rdf:about="&a;101993578"
	 b:glossaryEntry="a kind of lemur"/>
<rdf:Description rdf:about="&a;101993710"
	 b:glossaryEntry="bush babies"/>
<rdf:Description rdf:about="&a;101993818">
	<b:glossaryEntry>agile long-tailed nocturnal African lemur with dense woolly fur and large eyes and ears</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101994000"
	 b:glossaryEntry="a family of Lemuroidea"/>
<rdf:Description rdf:about="&a;101994154"
	 b:glossaryEntry="type genus of the Indriidae"/>
<rdf:Description rdf:about="&a;101994277">
	<b:glossaryEntry>large short-tailed lemur of Madagascar having thick silky fur in black and white and fawn</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101994482"
	 b:glossaryEntry="a genus of Indriidae"/>
<rdf:Description rdf:about="&a;101994606"
	 b:glossaryEntry="nocturnal indris with thick gray-brown fur and a long tail"/>
<rdf:Description rdf:about="&a;101994759">
	<b:glossaryEntry>extinct tiny nocturnal lower primates that fed on fruit and insects; abundant in North America and Europe 30 to 50 million years ago; probably gave rise to the tarsiers; some authorities consider them ancestral to anthropoids but others consider them only cousins</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101995111"
	 b:glossaryEntry="in some classifications assigned to the suborder Prosimii"/>
<rdf:Description rdf:about="&a;101995285"
	 b:glossaryEntry="coextensive with the genus Tarsius: tarsiers"/>
<rdf:Description rdf:about="&a;101995442"
	 b:glossaryEntry="type and sole genus of the family Tarsiidae"/>
<rdf:Description rdf:about="&a;101995593">
	<b:glossaryEntry>nocturnal arboreal primate of Indonesia and the Philippines having huge eyes and digits ending in pads to facilitate climbing; the only primate that spurns all plant material as food living entirely on insects and small vertebrates</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101995933"
	 b:glossaryEntry="a variety of tarsier"/>
<rdf:Description rdf:about="&a;101996016"
	 b:glossaryEntry="a variety of tarsier"/>
<rdf:Description rdf:about="&a;101996095"
	 b:glossaryEntry="flying lemurs"/>
<rdf:Description rdf:about="&a;101996222"
	 b:glossaryEntry="a family of Dermoptera"/>
<rdf:Description rdf:about="&a;101996367"
	 b:glossaryEntry="type genus of the family Cynocephalidae"/>
<rdf:Description rdf:about="&a;101996524">
	<b:glossaryEntry>arboreal nocturnal mammal of southeast Asia and the Philippines resembling a lemur and having a fold of skin on each side from neck to tail that is used for long gliding leaps</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101996817"
	 b:glossaryEntry="a variety of flying lemur"/>
<rdf:Description rdf:about="&a;101996912"
	 b:glossaryEntry="an order of animals including elephants and mammoths"/>
<rdf:Description rdf:about="&a;101997137"
	 b:glossaryEntry="massive herbivorous mammals having tusks and a long trunk"/>
<rdf:Description rdf:about="&a;101997323"
	 b:glossaryEntry="elephants"/>
<rdf:Description rdf:about="&a;101997527"
	 b:glossaryEntry="five-toed pachyderm"/>
<rdf:Description rdf:about="&a;101997710"
	 b:glossaryEntry="a wild and vicious elephant separated from the herd"/>
<rdf:Description rdf:about="&a;101997822"
	 b:glossaryEntry="type genus of the family Elephantidae"/>
<rdf:Description rdf:about="&a;101997967">
	<b:glossaryEntry>Asian elephant having smaller ears and tusks primarily in the male</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101998150">
	<b:glossaryEntry>albinic Indian elephant; rare and sometimes venerated in east Asia</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101998277"
	 b:glossaryEntry="a genus of Elephantidae"/>
<rdf:Description rdf:about="&a;101998412">
	<b:glossaryEntry>African elephant having enormous flapping ears and ivory tusks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101998577"
	 b:glossaryEntry="extinct genus: mammoths"/>
<rdf:Description rdf:about="&a;101998712">
	<b:glossaryEntry>any of numerous extinct elephants widely distributed in the Pleistocene; extremely large with hairy coats and long upcurved tusks</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101998968">
	<b:glossaryEntry>very hairy mammoth common in colder portions of the northern hemisphere</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;101999143"
	 b:glossaryEntry="a variety of mammoth"/>
<rdf:Description rdf:about="&a;101999247"
	 b:glossaryEntry="a genus of Elephantidae"/>
<rdf:Description rdf:about="&a;101999390"
	 b:glossaryEntry="largest known mammoth; of America"/>
<rdf:Description rdf:about="&a;101999551"
	 b:glossaryEntry="extinct family: mastodons"/>
<rdf:Description rdf:about="&a;101999714"
	 b:glossaryEntry="extinct type genus of the Mammutidae: mastodons"/>
<rdf:Description rdf:about="&a;101999903">
	<b:glossaryEntry>extinct elephant-like mammal that flourished worldwide from Miocene through Pleistocene times; differ from mammoths in the form of the molar teeth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102000153">
	<b:glossaryEntry>North American mastodon; in some classifications considered a mammoth rather than a mastodon</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102000369"
	 b:glossaryEntry="elephants extinct since the Pleistocene"/>
<rdf:Description rdf:about="&a;102000533"
	 b:glossaryEntry="type genus of the Gomphotheriidae"/>
<rdf:Description rdf:about="&a;102000686">
	<b:glossaryEntry>extinct elephants of Central and South America; of the Miocene and Pleistocene</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102000841">
	<b:glossaryEntry>an animal that walks with the entire sole of the foot touching the ground as e.g. bears and human beings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102001028">
	<b:glossaryEntry>an animal that walks so that only the toes touch the ground as e.g. dogs and cats and horses</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102001203">
	<b:glossaryEntry>raccoons; coatis; cacomistles; kinkajous; and sometimes pandas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102001515"
	 b:glossaryEntry="plantigrade carnivorous mammals"/>
<rdf:Description rdf:about="&a;102001729"
	 b:glossaryEntry="type genus of the family Procyonidae: raccoons"/>
<rdf:Description rdf:about="&a;102001883">
	<b:glossaryEntry>omnivorous nocturnal mammal native to North and Central America</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102002064"
	 b:glossaryEntry="North American raccoon"/>
<rdf:Description rdf:about="&a;102002197"
	 b:glossaryEntry="South American raccoon"/>
<rdf:Description rdf:about="&a;102002307"
	 b:glossaryEntry="in some classifications considered a separate family"/>
<rdf:Description rdf:about="&a;102002464"
	 b:glossaryEntry="cacomistles"/>
<rdf:Description rdf:about="&a;102002591">
	<b:glossaryEntry>raccoon-like omnivorous mammal of Mexico and the southwestern United States having a long bushy tail with black and white rings</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102002920"
	 b:glossaryEntry="a genus of Procyonidae"/>
<rdf:Description rdf:about="&a;102003046">
	<b:glossaryEntry>arboreal fruit-eating mammal of tropical America with a long prehensile tail</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102003254"
	 b:glossaryEntry="coatis"/>
<rdf:Description rdf:about="&a;102003364"
	 b:glossaryEntry="omnivorous mammal of Central and South America"/>
<rdf:Description rdf:about="&a;102003535"
	 b:glossaryEntry="lesser pandas"/>
<rdf:Description rdf:about="&a;102003656">
	<b:glossaryEntry>reddish-brown Old World raccoon-like carnivore; in some classifications considered unrelated to the giant pandas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102003906">
	<b:glossaryEntry>in some classifications considered the family comprising the giant pandas</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102004081">
	<b:glossaryEntry>only the giant panda: in some classifications considered a genus of the separate family Ailuropodidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102004296">
	<b:glossaryEntry>large black-and-white herbivorous mammal of bamboo forests of China and Tibet; in some classifications considered a member of the bear family or of a separate family Ailuropodidae</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102004610">
	<b:glossaryEntry>respiratory organ of aquatic animals that breathe oxygen dissolved in water</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102004801">
	<b:glossaryEntry>occurs in some mollusks and in tadpoles and other immature amphibians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102004930">
	<b:glossaryEntry>one of a series of slit openings in the pharynxes of fishes and aquatic amphibians through which water passes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102005126">
	<b:glossaryEntry>one of the bony or cartilaginous arches on each side of the pharynx that support the gills of fishes and aquatic amphibians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102005333"
	 b:glossaryEntry="region around the mouth in various invertebrates"/>
<rdf:Description rdf:about="&a;102005456"
	 b:glossaryEntry="the vocal organ of a bird"/>
<rdf:Description rdf:about="&a;102005553">
	<b:glossaryEntry>a group of vertebrates comprising both cartilaginous and bony fishes and sometimes including the jawless vertebrates; not used technically</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102005782">
	<b:glossaryEntry>any of various mostly cold-blooded aquatic vertebrates usually having scales and breathing through gills</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102006216"
	 b:glossaryEntry="any fish providing sport for the angler"/>
<rdf:Description rdf:about="&a;102006311"
	 b:glossaryEntry="any fish used for food by human beings"/>
<rdf:Description rdf:about="&a;102006621"
	 b:glossaryEntry="any of numerous small food fishes taken with hook and line"/>
<rdf:Description rdf:about="&a;102006733"
	 b:glossaryEntry="any fish useless for food or sport or even as bait"/>
<rdf:Description rdf:about="&a;102006840">
	<b:glossaryEntry>fish that live on the sea bottom especially commercially important gadoid fishes like cod and haddock or flatfish like flounder</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102007038"
	 b:glossaryEntry="a fish that is young"/>
<rdf:Description rdf:about="&a;102007187"
	 b:glossaryEntry="the young of various fishes"/>
<rdf:Description rdf:about="&a;102007265">
	<b:glossaryEntry>any of various fishes that carry their eggs and their young in their mouths</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102007399">
	<b:glossaryEntry>a class of fish having a skeleton composed of bone in addition to cartilage</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102007649"
	 b:glossaryEntry="any fish of the class Osteichthyes"/>
<rdf:Description rdf:about="&a;102007812">
	<b:glossaryEntry>fishes having paired fins resembling limbs and regarded as ancestral to amphibians</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102008038">
	<b:glossaryEntry>any fish of the order Crossopterygii; most known only in fossil form</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102008234"
	 b:glossaryEntry="extinct except for the coelacanth"/>
<rdf:Description rdf:about="&a;102008384"
	 b:glossaryEntry="type genus of the Latimeridae: coelacanth"/>
<rdf:Description rdf:about="&a;102008537">
	<b:glossaryEntry>fish thought to have been extinct since the Cretaceous Period but found in 1938 off the coast of Africa</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102008738">
	<b:glossaryEntry>bony fishes of the southern hemisphere that breathe by a modified air bladder as well as gills; sometimes classified as an order of Crossopterygii</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102009012">
	<b:glossaryEntry>air-breathing fish having an elongated body and fleshy paired fins; certain species construct mucus-lined mud coverings in which to survive drought</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102009269"
	 b:glossaryEntry="lungfishes having hornlike ridges on the teeth"/>
<rdf:Description rdf:about="&a;102009457">
	<b:glossaryEntry>type genus of the Ceratodontidae: extinct genus of lungfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102009618"
	 b:glossaryEntry="extinct lungfish"/>
<rdf:Description rdf:about="&a;102009709"
	 b:glossaryEntry="extant Australian lungfishes"/>
<rdf:Description rdf:about="&a;102009855"
	 b:glossaryEntry="large edible Australian lungfish having paddle-shaped fins"/>
<rdf:Description rdf:about="&a;102010013">
	<b:glossaryEntry>an order of fish belonging to the superorder Malacopterygii including catfishes</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102010286">
	<b:glossaryEntry>any of numerous mostly freshwater bottom-living fishes of Eurasia and North America with barbels like whiskers around the mouth</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102010612"
	 b:glossaryEntry="Old World catfishes"/>
<rdf:Description rdf:about="&a;102010782">
	<b:glossaryEntry>Old World freshwater catfishes having naked skin and a long anal fin more or less merged with the eellike caudal fin</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102011022"
	 b:glossaryEntry="type genus of the Siluridae: catfishes"/>
<rdf:Description rdf:about="&a;102011168"
	 b:glossaryEntry="large elongated catfish of central and eastern Europe"/>
<rdf:Description rdf:about="&a;102011332"
	 b:glossaryEntry="electric catfish"/>
<rdf:Description rdf:about="&a;102011466">
	<b:glossaryEntry>freshwater catfish of the Nile and tropical central Africa having an electric organ</b:glossaryEntry>
</rdf:Description>
