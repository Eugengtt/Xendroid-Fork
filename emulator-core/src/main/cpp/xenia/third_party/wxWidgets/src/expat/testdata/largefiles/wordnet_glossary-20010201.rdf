	 b:glossaryEntry="handle clumsily"/>
<rdf:Description rdf:about="&a;200824290"
	 b:glossaryEntry='touch clumsily; "The man tried to paw her"'/>
<rdf:Description rdf:about="&a;200824419"
	 b:glossaryEntry='scrape with the paws; "The bear pawed the door"'/>
<rdf:Description rdf:about="&a;200824527"
	 b:glossaryEntry="pet, as of a small child"/>
<rdf:Description rdf:about="&a;200824623"
	 b:glossaryEntry="hold something in one''s hands and move it"/>
<rdf:Description rdf:about="&a;200824912"
	 b:glossaryEntry="manage with the hands"/>
<rdf:Description rdf:about="&a;200825003"
	 b:glossaryEntry="manipulate the mouse of a computer"/>
<rdf:Description rdf:about="&a;200825100">
	<b:glossaryEntry>guide or pass over something; "He ran his eyes over her naked body." "She ran her fingers along the carved figurine."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200825349">
	<b:glossaryEntry>take hold of; also metaphorically: "Fear seized the prisoners"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200825761">
	<b:glossaryEntry>to make grasping motions; "the cat snatched at the butterflies"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200825871"
	 b:glossaryEntry="seize suddenly"/>
<rdf:Description rdf:about="&a;200825946">
	<b:glossaryEntry>seize together, as of parallel ropes of a tackle in order to prevent running through the block</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200826102"
	 b:glossaryEntry='clutch as if in panic: "She clawed the doorknob"'/>
<rdf:Description rdf:about="&a;200826212"
	 b:glossaryEntry='take by force; "The enemy seized the city"'/>
<rdf:Description rdf:about="&a;200826405"
	 b:glossaryEntry="obtain or seize by violence"/>
<rdf:Description rdf:about="&a;200826495">
	<b:glossaryEntry>seize forcibly or violently; "wrest the knife from his hands"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200826635">
	<b:glossaryEntry xml:space='preserve'><![CDATA[get into one''s hands, take physically; "Take a cookie!" "Can you take this bag, please"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200826966">
	<b:glossaryEntry>take out of a container or enclosed space; "Get out your best dress--we are going to a party!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200827155"
	 b:glossaryEntry="fold up, of sails"/>
<rdf:Description rdf:about="&a;200827285"
	 b:glossaryEntry="take in a sail with a brail"/>
<rdf:Description rdf:about="&a;200827375"
	 b:glossaryEntry="release ice; of icebergs or glaciers"/>
<rdf:Description rdf:about="&a;200827485"
	 b:glossaryEntry="take into custody, as of suspected criminals, by the police"/>
<rdf:Description rdf:about="&a;200827658">
	<b:glossaryEntry>succeed in catching or seizing, , esp. after a chase; "We finally got the suspect"; "Did you catch the thief?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200827873"
	 b:glossaryEntry='furnish with a collar; "collar the dog"'/>
<rdf:Description rdf:about="&a;200827976"
	 b:glossaryEntry="seize by the neck or collar"/>
<rdf:Description rdf:about="&a;200828075"
	 b:glossaryEntry="hold firmly"/>
<rdf:Description rdf:about="&a;200828218">
	<b:glossaryEntry xml:space='preserve'><![CDATA[hold on tightly or tenaciously; "hang on to your father''s hands"; "The child clung to his mother''s apron"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200828409"
	 b:glossaryEntry="hold firmly and tightly"/>
<rdf:Description rdf:about="&a;200828539">
	<b:glossaryEntry xml:space='preserve'><![CDATA[have or hold in one''s hands; "Hold this bowl for a moment, please"; also metaphorically: "A crazy idea took hold of him"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200828871">
	<b:glossaryEntry xml:space='preserve'><![CDATA[be the support of; "The beam holds up the roof"; "He supported me with one hand while I balanced on the beam"; "What''s holding that mirror?"; also metaphorically: "Her efforts support us morally"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200829362">
	<b:glossaryEntry>support, secure, or raise with a block; "block a plate for printing"; "block the wheels of a car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200829522">
	<b:glossaryEntry>bear or be able to bear the weight, pressure,or responsibility of; "His efforts carried the entire project"; "How many credits is this student carrying?"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200829746"
	 b:glossaryEntry="support on chocks, as of boats, for example"/>
<rdf:Description rdf:about="&a;200829852"
	 b:glossaryEntry='keep afloat: "The life vest buoyed him up"'/>
<rdf:Description rdf:about="&a;200829974"
	 b:glossaryEntry="support on poles, of climbing plants, such as beans"/>
<rdf:Description rdf:about="&a;200830095"
	 b:glossaryEntry="support with brackets, as of shelves, for example"/>
<rdf:Description rdf:about="&a;200830209"
	 b:glossaryEntry="support from beneath"/>
<rdf:Description rdf:about="&a;200830295"
	 b:glossaryEntry="support by placing against something solid or rigid"/>
<rdf:Description rdf:about="&a;200830455"
	 b:glossaryEntry="prop up with a pillow or bolster"/>
<rdf:Description rdf:about="&a;200830552"
	 b:glossaryEntry="support structurally, of roofs or bridges"/>
<rdf:Description rdf:about="&a;200830664"
	 b:glossaryEntry="lift with a jack, as of a car"/>
<rdf:Description rdf:about="&a;200830765"
	 b:glossaryEntry="support by bracing"/>
<rdf:Description rdf:about="&a;200830872">
	<b:glossaryEntry>brace (an archer''s bow) by pressing the foot against the center</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200830998">
	<b:glossaryEntry xml:space='preserve'><![CDATA[support or hold steady, as if with a brace; "brace your elbows while working on the potter''s wheel"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200831185">
	<b:glossaryEntry xml:space='preserve'><![CDATA[hold firmly, usually with one''s hands; "She clutched my arm when she got scared"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200831392"
	 b:glossaryEntry="close the slats of (windows)"/>
<rdf:Description rdf:about="&a;200831482">
	<b:glossaryEntry xml:space='preserve'><![CDATA[close or secure with or as if with a stopper; "She stoppered the wine bottle"; "The mothers stoppered their babies'' mouths with pacifiers"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200831685">
	<b:glossaryEntry xml:space='preserve'><![CDATA[come or be in close contact with; "The dress clings to her body"; "The shirt stuck to the athlete''s sweaty chest"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200831949"
	 b:glossaryEntry="stick together; as of the edges of a wound"/>
<rdf:Description rdf:about="&a;200832061"
	 b:glossaryEntry="clump together; as of bacteria, red blood cells, etc."/>
<rdf:Description rdf:about="&a;200832183"
	 b:glossaryEntry="string together, of morphemes in an agglutinating language"/>
<rdf:Description rdf:about="&a;200832310">
	<b:glossaryEntry>hold gently and carefully; "He cradles the child in his arms"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200832443"
	 b:glossaryEntry='grasp firmly; "The child clasped my hands"'/>
<rdf:Description rdf:about="&a;200832582"
	 b:glossaryEntry='release from a clasp; "She clasped and unclasped her hands"'/>
<rdf:Description rdf:about="&a;200832742"
	 b:glossaryEntry='turn in the opposite direction; "twist a wire"'/>
<rdf:Description rdf:about="&a;200832887">
	<b:glossaryEntry>twist or curve abruptly; "She quirked her head in a peculiar way"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200833015"
	 b:glossaryEntry='turn upside down, or throw so as to reverse; "flip a coin"'/>
<rdf:Description rdf:about="&a;200833183"
	 b:glossaryEntry='form into a spiral shape; "The cord is all twisted"'/>
<rdf:Description rdf:about="&a;200833483"
	 b:glossaryEntry="cause to become untwisted"/>
<rdf:Description rdf:about="&a;200833591"
	 b:glossaryEntry="put a kink in"/>
<rdf:Description rdf:about="&a;200833674"
	 b:glossaryEntry='twist or roll into coils or ringlets; "curl my hair, please"'/>
<rdf:Description rdf:about="&a;200833837"
	 b:glossaryEntry="curl tightly, of hair"/>
<rdf:Description rdf:about="&a;200833964"
	 b:glossaryEntry='hold fast or firmly; "He gripped the steering wheel"'/>
<rdf:Description rdf:about="&a;200834138"
	 b:glossaryEntry="manipulate, as in a nervous or unconscious manner"/>
<rdf:Description rdf:about="&a;200834266"
	 b:glossaryEntry='handle effectively; "The burglar wielded an axe"'/>
<rdf:Description rdf:about="&a;200834440"
	 b:glossaryEntry='wield vigorously; "ply an axe"'/>
<rdf:Description rdf:about="&a;200834531">
	<b:glossaryEntry>handle and cause to function; "do not operate machinery after imbibing alcohol"; "control the lever"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200834858"
	 b:glossaryEntry="operate by a treadle, of machinery"/>
<rdf:Description rdf:about="&a;200834957"
	 b:glossaryEntry="control or operate by relay"/>
<rdf:Description rdf:about="&a;200835047">
	<b:glossaryEntry>operate like a pump; move up and down, like a handle or a pedal</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200835172">
	<b:glossaryEntry>touch lightly and with affection, with brushing motions; "He stroked his long beard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200835355">
	<b:glossaryEntry>touch or stroke lightly in a loving or endearing manner: "He caressed her face"; "They caressed in the back seat of the taxi"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200835678"
	 b:glossaryEntry="slang; fondle or pet affectionately"/>
<rdf:Description rdf:about="&a;200835779">
	<b:glossaryEntry>examine physically with or as if with a probe; "probe an anthill"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200835956">
	<b:glossaryEntry>penetrate injuriously; "The glass from the shattered windshield cut into her forehead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200836103">
	<b:glossaryEntry>penetrate mutually or be interlocked; "The territories of two married people interpenetrate a lot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200836284">
	<b:glossaryEntry>be diffused thoroughly; "Sunlight percolated the entire house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200836413">
	<b:glossaryEntry>pass into or through, often by overcoming resistance; "The bullet penetrated her chest"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200836925"
	 b:glossaryEntry='pierce or penetrate; "The blade broke her skin"'/>
<rdf:Description rdf:about="&a;200837071"
	 b:glossaryEntry='become punctured or penetrated: "The skin broke"'/>
<rdf:Description rdf:about="&a;200837182"
	 b:glossaryEntry='pierce the surface of; "The fish broke the water"'/>
<rdf:Description rdf:about="&a;200837312"
	 b:glossaryEntry="briefly enter enemy territory"/>
<rdf:Description rdf:about="&a;200837412"
	 b:glossaryEntry='enter briefly; "We poked into the bar"'/>
<rdf:Description rdf:about="&a;200837525">
	<b:glossaryEntry xml:space='preserve'><![CDATA[enter surreptitiously; "He sneaked in under cover of darkness"; "In this essay, the author''s personal feelings creep in"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200837730">
	<b:glossaryEntry>spread or diffuse through; "An atmosphere of distrust has permeated this administration"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200837930"
	 b:glossaryEntry="imbue with a spirit"/>
<rdf:Description rdf:about="&a;200838024">
	<b:glossaryEntry>penetrate thoroughly and into every part; "the revolutionaries honeycombed the organization"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200838192">
	<b:glossaryEntry>poke or thrust abruptly; "he jabbed his finger into her ribs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200838367"
	 b:glossaryEntry="make a hole by poking"/>
<rdf:Description rdf:about="&a;200838458"
	 b:glossaryEntry="stab or pierce"/>
<rdf:Description rdf:about="&a;200838574"
	 b:glossaryEntry="strike quickly"/>
<rdf:Description rdf:about="&a;200838665"
	 b:glossaryEntry="urge on; cause to act"/>
<rdf:Description rdf:about="&a;200838792"
	 b:glossaryEntry="urge on with shouts, of dogs in a hunt"/>
<rdf:Description rdf:about="&a;200838894"
	 b:glossaryEntry="to push against gently"/>
<rdf:Description rdf:about="&a;200839048"
	 b:glossaryEntry="give a slight push to"/>
<rdf:Description rdf:about="&a;200839154"
	 b:glossaryEntry='use a knife on; "The victim was knifed to death"'/>
<rdf:Description rdf:about="&a;200839308"
	 b:glossaryEntry="stab with a poniard"/>
<rdf:Description rdf:about="&a;200839392"
	 b:glossaryEntry="stab or kill someone with a bayonet"/>
<rdf:Description rdf:about="&a;200839492"
	 b:glossaryEntry="injure badly by beating"/>
<rdf:Description rdf:about="&a;200839630"
	 b:glossaryEntry="split (wood) with a maul and wedges"/>
<rdf:Description rdf:about="&a;200839727"
	 b:glossaryEntry="usually for medicinal or relaxation purposes"/>
<rdf:Description rdf:about="&a;200839881"
	 b:glossaryEntry="hit lightly"/>
<rdf:Description rdf:about="&a;200839967"
	 b:glossaryEntry="apply (usually a liquid) to a surface"/>
<rdf:Description rdf:about="&a;200840079">
	<b:glossaryEntry>cover (a surface) by smearing (a substance) over it; "smear the paint onto the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200840252">
	<b:glossaryEntry>smear with blood, as in a hunting initiation rite, where the face of a person is smeared with the blood of the kill</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200840430"
	 b:glossaryEntry="cover with thatch; of roofs"/>
<rdf:Description rdf:about="&a;200840521"
	 b:glossaryEntry="provide a building with a roof; cover a building with a roof"/>
<rdf:Description rdf:about="&a;200840697"
	 b:glossaryEntry='cover with shingles; "shingle a roof"'/>
<rdf:Description rdf:about="&a;200840799"
	 b:glossaryEntry="cover with mulch, as of garden beds"/>
<rdf:Description rdf:about="&a;200840897"
	 b:glossaryEntry="cover with turf"/>
<rdf:Description rdf:about="&a;200840974">
	<b:glossaryEntry>place in the earth and cover with soil; "They buried the stolen goods"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200841124"
	 b:glossaryEntry="cover with ashes, of fires, to control the rate of burning"/>
<rdf:Description rdf:about="&a;200841244"
	 b:glossaryEntry="cover with a carpet, as of rooms"/>
<rdf:Description rdf:about="&a;200841340">
	<b:glossaryEntry>cover completely, as if with a carpet; as of flowers in meadows</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200841467"
	 b:glossaryEntry="cover with wooden boards; as of windows, for example"/>
<rdf:Description rdf:about="&a;200841585"
	 b:glossaryEntry="make uniform, as of dough or clay"/>
<rdf:Description rdf:about="&a;200841706">
	<b:glossaryEntry>to strike, thrust or shove against, often with head or horns: "He butted his sister out of the way."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200841893">
	<b:glossaryEntry>hit against; come into sudden contact with; "The arrow hit the target"; "The car hit a tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200842352"
	 b:glossaryEntry='hit with a pinging noise; "The bugs pinged the lamp shade"'/>
<rdf:Description rdf:about="&a;200842480">
	<b:glossaryEntry>leap. jerk, bang (dialectal); "Bullets spanged into the trees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200842620"
	 b:glossaryEntry='collide with the rear end of; "The car rear-ended me"'/>
<rdf:Description rdf:about="&a;200842763"
	 b:glossaryEntry='collide with the broad side of; "her car broad-sided mine"'/>
<rdf:Description rdf:about="&a;200842912">
	<b:glossaryEntry>strike together so as to produce a sharp percussive noise, as of two flat, hard surfaces</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200843062">
	<b:glossaryEntry>strike with the flat of the hand; usually in a friendly way, as in encouragement or greeting</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200843224">
	<b:glossaryEntry>land on or hit solidly: "The brick connected on her head, knocking her out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200843365"
	 b:glossaryEntry='fail to reach; "The arrow missed the target"'/>
<rdf:Description rdf:about="&a;200843471">
	<b:glossaryEntry>strike with a sound like that of falling rain; "Bullets were spatting the leaves"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200843614">
	<b:glossaryEntry>strike with a dull sound; "Bullets were thudding against the wall"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200843750"
	 b:glossaryEntry="strike the ground, as with a ship''s bottom"/>
<rdf:Description rdf:about="&a;200843856"
	 b:glossaryEntry="hit the ground; of cars"/>
<rdf:Description rdf:about="&a;200843947">
	<b:glossaryEntry>deliver a sharp blow or push :"He knocked the glass clear across the room."</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200844179">
	<b:glossaryEntry>push with the shoulders; "He shouldered his way into the crowd"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200844308">
	<b:glossaryEntry>carry a burden, either real or metaphoric; "shoulder the burden"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200844438">
	<b:glossaryEntry>carry diagonally across the body; "port a canoe"; "port a rifle"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200844564"
	 b:glossaryEntry="lift onto one''s shoulders"/>
<rdf:Description rdf:about="&a;200844663"
	 b:glossaryEntry="shove one''s elbow into another person''s ribs"/>
<rdf:Description rdf:about="&a;200844770">
	<b:glossaryEntry>knock against with force or violence; "My car bumped into the tree"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200844977">
	<b:glossaryEntry>cause to come or go down; "The policeman downed the heavily armed suspect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200845185">
	<b:glossaryEntry>collide violently with an obstacle; "I ran into the telephone pole"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200845391"
	 b:glossaryEntry="scrape gently"/>
<rdf:Description rdf:about="&a;200845525"
	 b:glossaryEntry='touch lightly and briefly; "He brushed the wall lightly"'/>
<rdf:Description rdf:about="&a;200845704"
	 b:glossaryEntry="prod or urge as if with a log stick"/>
<rdf:Description rdf:about="&a;200845817"
	 b:glossaryEntry="urge with or as if with a goad"/>
<rdf:Description rdf:about="&a;200845943"
	 b:glossaryEntry="goad with spurs, as of horses when riding"/>
<rdf:Description rdf:about="&a;200846046"
	 b:glossaryEntry='equip with spurs: "spur horses"'/>
<rdf:Description rdf:about="&a;200846139"
	 b:glossaryEntry="strike with a spur"/>
<rdf:Description rdf:about="&a;200846245"
	 b:glossaryEntry="move with a flick"/>
<rdf:Description rdf:about="&a;200846340">
	<b:glossaryEntry>propel or give impetus to; "The sudden gust of air propelled the ball to the other side of the fence"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200846512">
	<b:glossaryEntry>touch or hit with a light, quick blow; "flicked him with his hand"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200846658"
	 b:glossaryEntry="cause to make a snapping sound; of fingers"/>
<rdf:Description rdf:about="&a;200846778"
	 b:glossaryEntry="strike violently"/>
<rdf:Description rdf:about="&a;200846871"
	 b:glossaryEntry="hit violently, as in an attack"/>
<rdf:Description rdf:about="&a;200847023"
	 b:glossaryEntry='throw violently; "He slammed the book on the table"'/>
<rdf:Description rdf:about="&a;200847148"
	 b:glossaryEntry='close violently; "He slammed the door shut"'/>
<rdf:Description rdf:about="&a;200847276"
	 b:glossaryEntry="close with shutters, as of doors and windows"/>
<rdf:Description rdf:about="&a;200847385">
	<b:glossaryEntry>move or pull so as to cover or uncover something; "draw the shades"; "draw the curtains"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200847535">
	<b:glossaryEntry>pull back the sling of (a bow); "The archers were drawing their bows"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200847678"
	 b:glossaryEntry="hit lightly with a picking motion"/>
<rdf:Description rdf:about="&a;200847811"
	 b:glossaryEntry="pat or squeeze fondly or playfully, esp. under the chin"/>
<rdf:Description rdf:about="&a;200847935">
	<b:glossaryEntry>rub with a brush, or as if with a brush: "Johnson brushed the hairs from his jacket"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200848090">
	<b:glossaryEntry>clean with a brush; "She brushed the suit before hanging it back into the closet"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;200848250"
	 b:glossaryEntry='wash with a swab or a mop; "Mop the floors"'/>
<rdf:Description rdf:about="&a;200848386"
	 b:glossaryEntry="mop so as to leave a semi-dry surface, of floors"/>
<rdf:Description rdf:about="&a;200848495"
