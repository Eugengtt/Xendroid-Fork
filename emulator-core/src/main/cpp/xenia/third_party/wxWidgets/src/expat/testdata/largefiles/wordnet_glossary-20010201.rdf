</rdf:Description>
<rdf:Description rdf:about="&a;102072266">
	<b:glossaryEntry>the more common dolphinfish valued as food; about six feet long</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;102072395"
	 b:glossaryEntry="a kind of dolphinfish"/>
