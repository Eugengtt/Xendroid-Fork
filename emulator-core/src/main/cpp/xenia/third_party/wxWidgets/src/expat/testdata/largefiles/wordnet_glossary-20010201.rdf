	<b:glossaryEntry>with respect to material aspects; "psychologically similar but materially different"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400132958">
	<b:glossaryEntry>to a significant degree; "it aided him materially in winning the argument"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400133089">
	<b:glossaryEntry>in a surgical manner; by means of surgery; "surgically removed"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400133209"
	 b:glossaryEntry="by means of an operative"/>
<rdf:Description rdf:about="&a;400133291"
	 b:glossaryEntry='after the operation; "remove postoperatively"'/>
<rdf:Description rdf:about="&a;400133398"
	 b:glossaryEntry="my means of a chromatographic process"/>
<rdf:Description rdf:about="&a;400133501">
	<b:glossaryEntry>in an alternating sequence or position; "They were deglycerolized by alternately centrifuging and mixing"; "he planted fir and pine trees alternately"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400133709"
	 b:glossaryEntry='in a transverse manner; "they were cut transversely"'/>
<rdf:Description rdf:about="&a;400133854">
	<b:glossaryEntry>in the order given; "the brothers were called Felix and Max, respectively"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400133999">
	<b:glossaryEntry>in like or similar manner; "He was similarly affected"; "some people have littlepower to do good, and have likewise little strength to resist evil"- Samuel Johnson</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400134229"
	 b:glossaryEntry='of secondary import; "secondarily affected"'/>
<rdf:Description rdf:about="&a;400134348">
	<b:glossaryEntry>of primary import; "this is primarily a question of economics"; "it was in the first place a local matter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400134549">
	<b:glossaryEntry>with considerable certainty; without much doubt; "He is probably out of the country"; "in all likelihood we are headed for war"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400134790"
	 b:glossaryEntry='like a banner; "She waved her scarf at him bannerlike"'/>
<rdf:Description rdf:about="&a;400134883"
	 b:glossaryEntry='in a dramatic manner; "he confessed dramatically"'/>
<rdf:Description rdf:about="&a;400135009"
	 b:glossaryEntry="in an undramatic manner"/>
<rdf:Description rdf:about="&a;400135111"
	 b:glossaryEntry='towards the shore from the water; "we invited them ashore"'/>
<rdf:Description rdf:about="&a;400135240"
	 b:glossaryEntry='as was to be expected; "she won as expected"'/>
<rdf:Description rdf:about="&a;400135324">
	<b:glossaryEntry>to a notable extent; "notably in the social sciences, the professors teach too much"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400135462"
	 b:glossaryEntry='in an intensive manner; "he studied the snake intensively"'/>
<rdf:Description rdf:about="&a;400135578"
	 b:glossaryEntry='in an appropriate manner; "he was appropriately dressed"'/>
<rdf:Description rdf:about="&a;400135829"
	 b:glossaryEntry='in an inappropriate manner; "he was inappropriately dressed"'/>
<rdf:Description rdf:about="&a;400136033">
	<b:glossaryEntry>in an inalienable manner; "this property is held inalienably"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400136152">
	<b:glossaryEntry>away from shore; away from land; "cruising three miles offshore"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400136271"
	 b:glossaryEntry='on or toward the land; "they were living onshore"'/>
<rdf:Description rdf:about="&a;400136374">
	<b:glossaryEntry>by three orders of magnitude; "this poison is a thousand-fold more toxic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400136506">
	<b:glossaryEntry>according to nature; by natural means; "naturally grown flowers"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400136644">
	<b:glossaryEntry>not according to nature; not by natural means; "artificially induced conditions"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400136837"
	 b:glossaryEntry='having a rapid onset; "an acutely debilitating virus"'/>
<rdf:Description rdf:about="&a;400136962">
	<b:glossaryEntry>in a slowly developing and long lasting manner; "chronically ill persons"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400137111">
	<b:glossaryEntry>in a habitual and long-standing manner; "smoking chronically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400137263"
	 b:glossaryEntry='in a contradictory manner; "he argued contradictarily"'/>
<rdf:Description rdf:about="&a;400137379">
	<b:glossaryEntry>in an electrostatic manner; "the dust adhered electrostatically to the surface"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400137522"
	 b:glossaryEntry="in an episodic manner"/>
<rdf:Description rdf:about="&a;400137602"
	 b:glossaryEntry='in a fabulous manner; "she was a fabulously gifted player"'/>
<rdf:Description rdf:about="&a;400137715"
	 b:glossaryEntry='in a feverish manner; "she worked feverishly"'/>
<rdf:Description rdf:about="&a;400137817"
	 b:glossaryEntry='in a feudal manner; "a feudally organized society"'/>
<rdf:Description rdf:about="&a;400137922"
	 b:glossaryEntry="in, at, or toward the front"/>
<rdf:Description rdf:about="&a;400138005">
	<b:glossaryEntry>with respect to geometry; "this shape is geometrically interesting"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400138132"
	 b:glossaryEntry='by a glacier; "glacially deposited material"'/>
<rdf:Description rdf:about="&a;400138232"
	 b:glossaryEntry='in a glaring manner; "it was glaringly obvious"'/>
<rdf:Description rdf:about="&a;400138335"
	 b:glossaryEntry='with respect to gravitation; "gravitationally strong forces"'/>
<rdf:Description rdf:about="&a;400138457"
	 b:glossaryEntry='in a guttural manner; "gutturally articulated"'/>
<rdf:Description rdf:about="&a;400138560"
	 b:glossaryEntry='by means of hieroglyphs; "hieroglyphically written"'/>
<rdf:Description rdf:about="&a;400138674"
	 b:glossaryEntry="by means of horticulture"/>
<rdf:Description rdf:about="&a;400138760"
	 b:glossaryEntry='in the manner of human beings; "humanly possible"'/>
<rdf:Description rdf:about="&a;400138863"
	 b:glossaryEntry='in an imperial manner; "imperially decreed"'/>
<rdf:Description rdf:about="&a;400138963"
	 b:glossaryEntry='by incest; "incestuously conceived"'/>
<rdf:Description rdf:about="&a;400139057"
	 b:glossaryEntry='to an inconceivable degree; "inconceivably small"'/>
<rdf:Description rdf:about="&a;400139166"
	 b:glossaryEntry="in an insistent manner"/>
<rdf:Description rdf:about="&a;400139246"
	 b:glossaryEntry='by an institution; "institutionally controlled"'/>
<rdf:Description rdf:about="&a;400139355"
	 b:glossaryEntry='in a judicial manner; "judically controlled process"'/>
<rdf:Description rdf:about="&a;400139463"
	 b:glossaryEntry='in a nasal manner; "inhaled nasally"'/>
<rdf:Description rdf:about="&a;400139553"
	 b:glossaryEntry='at night; "nocturnally active bird"'/>
<rdf:Description rdf:about="&a;400139646"
	 b:glossaryEntry="in a rural manner"/>
<rdf:Description rdf:about="&a;400139717"
	 b:glossaryEntry='in a spherical manner; "spherically shaped"'/>
<rdf:Description rdf:about="&a;400139818"
	 b:glossaryEntry='in a superficial manner; "he was supercifically interested"'/>
<rdf:Description rdf:about="&a;400139937"
	 b:glossaryEntry='in or with syllables; "syllabically pronounced"'/>
<rdf:Description rdf:about="&a;400140043"
	 b:glossaryEntry="in a monosyllabic manner"/>
<rdf:Description rdf:about="&a;400140130"
	 b:glossaryEntry="in a polysyllabic manner"/>
<rdf:Description rdf:about="&a;400140217"
	 b:glossaryEntry="by symptoms"/>
<rdf:Description rdf:about="&a;400140290"
	 b:glossaryEntry='in passing; "touched on it tangentially"'/>
<rdf:Description rdf:about="&a;400140389"
	 b:glossaryEntry='by or like volcanoes; "volcanically created landscape"'/>
<rdf:Description rdf:about="&a;400140502">
	<b:glossaryEntry>for a short time; "sit down and stay awhile"; "they settled awhile in Virginia before moving West"; "the baby was quiet for a while"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400140683"
	 b:glossaryEntry='in a wicked evil manner; "act wickedly"; "grin evilly"'/>
<rdf:Description rdf:about="&a;400140819">
	<b:glossaryEntry xml:space='preserve'><![CDATA[definitely or positively; "the results are surely encouraging"; "she certainly is a hard worker"; "it''s going to be a good day for sure"; "they are coming, for certain"; "they thought he had been killed sure enough"; "he''ll win sure as shooting"; (`sure'' is used informally for `surely'' as in "they sure smell good"; "sure he''ll come")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400141302"
	 b:glossaryEntry='in a surprising manner; "he was surprisingly friendly"'/>
<rdf:Description rdf:about="&a;400141415"
	 b:glossaryEntry='by means of technology; "technologically impossible"'/>
<rdf:Description rdf:about="&a;400141529"
	 b:glossaryEntry='by temperament; "temperamentally suited to each other"'/>
<rdf:Description rdf:about="&a;400141645">
	<b:glossaryEntry>to a sufficient degree; "she was sufficiently fluent in Mandarin"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400141787"
	 b:glossaryEntry="in an adequate manner"/>
<rdf:Description rdf:about="&a;400141865">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as much as necessary; "Have I eaten enough?"; (`plenty'' is nonstandard) "I''ve had plenty, thanks"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400142006"
	 b:glossaryEntry='to an insufficient degree; "he was insufficiently prepared"'/>
<rdf:Description rdf:about="&a;400142144"
	 b:glossaryEntry='without hesitation; "she said yes unhesitatingly"'/>
<rdf:Description rdf:about="&a;400142272">
	<b:glossaryEntry>with hesitation; in a hesitant manner; "he finally accepted hesitantly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400142433"
	 b:glossaryEntry='from that time on; "thereafter he never called again"'/>
<rdf:Description rdf:about="&a;400142539">
	<b:glossaryEntry>at any time; "did you ever smoke?"; "the best con man of all time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400142652">
	<b:glossaryEntry>intentionally so written (used after a printed word or phrase)</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400142746">
	<b:glossaryEntry>(intensifier) to a very great extent or degree; "the idea is so obvious"; "never been so happy"; "I love you so"; "my head aches so!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400142910">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(usually followed by `that'') to an extent or degree as expressed; "he was so tired he could hardly stand"; "so dirty that it smells"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400143073">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in such a condition or manner, especially as expressed or implied; "They''re happy and I hope they will remain so"; "so live your life that old age will bring no regrets"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400143273">
	<b:glossaryEntry>to a certain unspecified extent or degree; "I can only go so far with this student"; "can do only so much in a day"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400143419">
	<b:glossaryEntry>in they same way; also; "I was offended and so was he"; "worked hard and so did she"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400143534">
	<b:glossaryEntry>(intensifier) to so extreme a degree; "he is such a baby"; "Such rich people!"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400143645"
	 b:glossaryEntry='in all ways possible; "they served him hand and foot"'/>
<rdf:Description rdf:about="&a;400143740">
	<b:glossaryEntry xml:space='preserve'><![CDATA[clasping each other''s hands; "they walked hand in hand"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400143836"
	 b:glossaryEntry='at a tremendous rate; "made money hand over fist"'/>
<rdf:Description rdf:about="&a;400143928"
	 b:glossaryEntry='with no difficulty; "she beat him handily"'/>
<rdf:Description rdf:about="&a;400144019">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with ease; "she was easily excited"; "was easily confused"; "he won easily"; "this china breaks very easily"; (`easy'' is used informally for `easily'' as in "success came too easy")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400144259">
	<b:glossaryEntry xml:space='preserve'><![CDATA[(informal) in a relaxed manner; or without hardship; "just wanted to take it easy" (`soft'' is nonstandard)]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400144441"
	 b:glossaryEntry='under control; "the riots were in hand"'/>
<rdf:Description rdf:about="&a;400144534"
	 b:glossaryEntry='out of control; "the riots got out of hand"'/>
<rdf:Description rdf:about="&a;400144652"
	 b:glossaryEntry='from some points of view; "she was right in a way"'/>
<rdf:Description rdf:about="&a;400144758">
	<b:glossaryEntry>as a fact or based on fact; "they learn much, factually, about the problems of retirement and provision for old age, and, psychologically, in the sharing of their thoughts on retirement"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400145000">
	<b:glossaryEntry>in reality or actuality; "in fact, it was a wonder anyone survived"; "painters who are in fact anything but unsophisticated"; "as a matter of fact, he is several inches taller than his father"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400145269">
	<b:glossaryEntry>used to imply that one would expect the fact to be the opposite of that stated; surprisingly; "you may actually be doing the right thing by walking out"; "she actually spoke Latin"; "they thought they made the rules but in reality they were only puppets"; "people who seem stand-offish are in reality often simply nervous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400145641">
	<b:glossaryEntry>in actual fact; "to be nominally but not actually independent"; "no one actually saw the shark"; "large meteorites actually come from the asteroid belt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400145875">
	<b:glossaryEntry xml:space='preserve'><![CDATA[as a sentence modifier to add slight emphasis; "actually, we all help clear up after a meal"; "actually, I haven''t seen the film"; "I''m not all that surprised actually"; "she hasn''t proved to be too satisfactory, actually"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400146134">
	<b:glossaryEntry>at the present moment; "the transmission screen shows the picture that is actually on the air"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400146265"
	 b:glossaryEntry='admittedly; "to be sure, he is no Einstein"'/>
<rdf:Description rdf:about="&a;400146374">
	<b:glossaryEntry>as supposed or expected; "sure enough, he asked her for money again"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400146482"
	 b:glossaryEntry="an interjection expressing agreement"/>
<rdf:Description rdf:about="&a;400146563">
	<b:glossaryEntry>in entirety; "they bought the business in toto"; "in recommendations were adopted in toto"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400146689"
	 b:glossaryEntry='to any extent at all; "are you in the least interested?"'/>
<rdf:Description rdf:about="&a;400146802">
	<b:glossaryEntry>above and beyond all other consideration; "above all, you must be independent"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400146955">
	<b:glossaryEntry>while absent; although absent; "he was sentenced in absentia"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400147056"
	 b:glossaryEntry='including all; "we got a pay raise across the board"'/>
<rdf:Description rdf:about="&a;400147171">
	<b:glossaryEntry>to some extent; not very well; "he speaks French after a fashion"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400147280">
	<b:glossaryEntry>emphasizes something to be considered; "after all, she is your boss, so invite her"; "he is, after all, our president"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400147436">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in spite of expectations; "came to the party after all"; "it didn''t rain after all"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400147557"
	 b:glossaryEntry='not during regular hours; "he oftern worked after hours"'/>
<rdf:Description rdf:about="&a;400147653">
	<b:glossaryEntry>as fast as possible; before a deadline; "it was a race against the clock"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400147787">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in an advantageous position; "she''s ahead of the game"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400147887">
	<b:glossaryEntry xml:space='preserve'><![CDATA[with everything considered (and neglecting details); "altogether, I''m sorry it happened"; "all in all, it''s not so bad"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400148089"
	 b:glossaryEntry='without warning; "all at once, he started shouting"'/>
<rdf:Description rdf:about="&a;400148198"
	 b:glossaryEntry='to the goal; "she climbed the mountain all the way"'/>
<rdf:Description rdf:about="&a;400148305">
	<b:glossaryEntry>not stopping short of sexual intercourse; "she went all the way with him"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400148418"
	 b:glossaryEntry="completely"/>
<rdf:Description rdf:about="&a;400148477"
	 b:glossaryEntry="an expression of emphatic agreement"/>
<rdf:Description rdf:about="&a;400148572">
	<b:glossaryEntry xml:space='preserve'><![CDATA[and considerably more in addition; "it cost me a week''s salary and then some"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400148691"
	 b:glossaryEntry='without stopping; "she worked around the clock"'/>
<rdf:Description rdf:about="&a;400148816"
	 b:glossaryEntry='what is listed next; "her complaints went as follows"'/>
<rdf:Description rdf:about="&a;400148908"
	 b:glossaryEntry='as if it were really so; "she lives here, as it were"'/>
<rdf:Description rdf:about="&a;400149014">
	<b:glossaryEntry>in a manner of speaking; "the feeling is, as we say, quite dead"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400149130">
	<b:glossaryEntry xml:space='preserve'><![CDATA[by the shortest and most direct route; "it''s 10 miles as the crow flies"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400149248">
	<b:glossaryEntry>regardless of the cost involved; "he wanted to save her life at all cost"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400149393"
	 b:glossaryEntry='simultaneously; "he took three cookies at a time"'/>
<rdf:Description rdf:about="&a;400149504">
	<b:glossaryEntry>as one chooses or pleases; "he can roam the neighborhood at will"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400149605"
	 b:glossaryEntry='knitted in a loose manner; "loosely knit"'/>
<rdf:Description rdf:about="&a;400149700"
	 b:glossaryEntry='taking care or paying attention; "they watched carefully"'/>
<rdf:Description rdf:about="&a;400149813"
	 b:glossaryEntry="in a careful deliberate manner"/>
<rdf:Description rdf:about="&a;400149997"
	 b:glossaryEntry="in a careless and thoughtless manner"/>
<rdf:Description rdf:about="&a;400150109"
	 b:glossaryEntry='in an excited manner; "she shook his hand excitedly"'/>
<rdf:Description rdf:about="&a;400150235"
	 b:glossaryEntry='in a vociferous manner; "he complained vociferously"'/>
<rdf:Description rdf:about="&a;400150346"
	 b:glossaryEntry='with safety; in a safe manner; "we are safely out of there"'/>
<rdf:Description rdf:about="&a;400150440">
	<b:glossaryEntry>according to what has been alleged; "he was on trial for allegedly murdering his wife"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400150582"
	 b:glossaryEntry="believed or reputed to be the case"/>
<rdf:Description rdf:about="&a;400150705"
	 b:glossaryEntry='in an illegal manner; "they dumped the waste illegally"'/>
<rdf:Description rdf:about="&a;400150894"
	 b:glossaryEntry="in an original manner"/>
<rdf:Description rdf:about="&a;400150972">
	<b:glossaryEntry>in mental comfort; without stress; "he works comfortably on three continents"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151107">
	<b:glossaryEntry>in physical comfort; "she could have been lying comfortably in bed getting the same relief"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151274">
	<b:glossaryEntry>in physical discomfort" "she lay on the couch, her body uncomfortably twisted"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151430">
	<b:glossaryEntry xml:space='preserve'><![CDATA[by a great deal; "he is the best by a long shot"; "his labors haven''t ended there--not by a long shot"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151575">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at some eventual time in the future; "By and by he''ll understand"; "I''ll see you later"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151708">
	<b:glossaryEntry xml:space='preserve'><![CDATA[usually; as a rule; "by and large it doesn''t rain much here"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151852">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in any way necessary; "I''ll pass this course by hook or by crook"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400151980"
	 b:glossaryEntry='by committing to memory; "she knew the poem by heart"'/>
<rdf:Description rdf:about="&a;400152082"
	 b:glossaryEntry='by a short distance; "they moved it by inches"'/>
<rdf:Description rdf:about="&a;400152204"
	 b:glossaryEntry='intermittently; "he worked on his book by fits and starts"'/>
<rdf:Description rdf:about="&a;400152335">
	<b:glossaryEntry xml:space='preserve'><![CDATA[introducing a different topic; "by the way, I won''t go to the party"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400152470"
	 b:glossaryEntry='one piece at a time; "she sold the plates by the piece"'/>
<rdf:Description rdf:about="&a;400152579">
	<b:glossaryEntry>by spoken rather than written means; "these stories were transmitted by word of mouth"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400152737">
	<b:glossaryEntry>(of drugs) through the mouth rather than through injection; "he was administered the drug orally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400152898">
	<b:glossaryEntry xml:space='preserve'><![CDATA[in spite of all obstacles; "we''ll go to Tibet come hell or high water"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400153065"
	 b:glossaryEntry='without respite; "he plays chess day in and day out"'/>
<rdf:Description rdf:about="&a;400153179"
	 b:glossaryEntry='exactly ahead or in front; "the laboratory is dead ahead"'/>
<rdf:Description rdf:about="&a;400153275"
	 b:glossaryEntry='without betraying any feeling; "she told the joke deadpan"'/>
<rdf:Description rdf:about="&a;400153369"
	 b:glossaryEntry='all together; "the students turned out en masse"'/>
<rdf:Description rdf:about="&a;400153477"
	 b:glossaryEntry='occasionally; "every so often she visits her father"'/>
<rdf:Description rdf:about="&a;400153593"
	 b:glossaryEntry='in every way; completely; "he was every inch a statesman"'/>
<rdf:Description rdf:about="&a;400153689">
	<b:glossaryEntry>so as to be complete; with everything necessary; "he had filled out the form completely"; "the apartment was completely furnished"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400153876">
	<b:glossaryEntry>not to a full degree or extent; "words incompletely understood"; "a form filled out incompletely"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400154032"
	 b:glossaryEntry='without anybody else; "the child stayed home alone"'/>
<rdf:Description rdf:about="&a;400154133">
	<b:glossaryEntry>of greatest importance; "first and foremost, we must feed the refugees"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400154270">
	<b:glossaryEntry>taking everything together; "she was first and last a scientist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400154389">
	<b:glossaryEntry>indicating exactness or preciseness; "he was doing precisely (or exactly) what she had told him to do"; "it was just as he said--the jewel was gone"; "it has just enough salt"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400154655">
	<b:glossaryEntry>for a relatively small amount of money; "we bought the house for a song"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400154805">
	<b:glossaryEntry>as though your life was at stake; "he was running for dear life"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400154911"
	 b:glossaryEntry='as an example; "take ribbon snakes, for example"'/>
<rdf:Description rdf:about="&a;400155021">
	<b:glossaryEntry>in addition (as to close a deal); "the car salesman threw in the radio, for good measure"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400155155"
	 b:glossaryEntry='for the winner to keep all; "they played for keeps"'/>
<rdf:Description rdf:about="&a;400155244">
	<b:glossaryEntry xml:space='preserve'><![CDATA[under any circumstances; "she wouldn''t give up her pets for love or money"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400155415">
	<b:glossaryEntry>as a particular one of several possibilities; "I for one feel very grateful"; "her mother for one was worried"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400155561">
	<b:glossaryEntry>for a particular example; "for one thing, you must work harder"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400155666"
	 b:glossaryEntry='as an abbreviation; "call me Bob for short"'/>
<rdf:Description rdf:about="&a;400155747">
	<b:glossaryEntry>on the occasion of a request; "advice was free for the asking"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400155865"
	 b:glossaryEntry='from the beginning; "he baked the torte from scratch"'/>
<rdf:Description rdf:about="&a;400155959"
	 b:glossaryEntry="written formula for ending a letter"/>
<rdf:Description rdf:about="&a;400156050"
	 b:glossaryEntry='since long ago; "she knows him from way back"'/>
<rdf:Description rdf:about="&a;400156161">
	<b:glossaryEntry>(nautical) nearly opposite to the direction from which wind is coming; "sailing close to the wind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400156305">
	<b:glossaryEntry>in a close relation or position in time or space; "the onsets were closely timed"; "houses set closely together"; "was closely involved in monitoring daily progress"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400156524">
	<b:glossaryEntry>in a close manner; "the two phenomena are intimately connected"; "the person most nearly concerned"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400156699">
	<b:glossaryEntry>in a relative manner; by comparison to something else; "the situation is relatively calm now"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400156883">
	<b:glossaryEntry>much greater in number or influence; "the patients are predominantly indigenous"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400157058">
	<b:glossaryEntry>without much difficulty; "these snakes can be identified readily"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400157159">
	<b:glossaryEntry>in a clearly noticeable manner; "sales of luxury cars dropped markedly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400157285"
	 b:glossaryEntry='so as to be palpable; "she was palpably nervous"'/>
<rdf:Description rdf:about="&a;400157388"
	 b:glossaryEntry='in a crude or unrefined manner; "he was crudely bold"'/>
<rdf:Description rdf:about="&a;400157495">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without speed; "he spoke slowly"; "go easy here--the road is slippery"; "glaciers move tardily"; (`slow'' is sometimes used informally for `slowly'' as in "please go slow; I want to see the sights")]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400157786">
	<b:glossaryEntry>in a manner accessible to or observable by the public; openly; "she admitted publicly to being a communist"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400157991">
	<b:glossaryEntry>kept private or confined to those intimately concerned; "it was discussed privately between the two men"; "privately, she thought differently"; "some member of his own party hoped privately for his defeat"; "he was questioned in private"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400158315">
	<b:glossaryEntry>not openly; inwardly; "they were secretly delighted at his embarrassment"; "hoped secretly she would change her mind"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400158487">
	<b:glossaryEntry>by a private person or interest; "a privately financed campaign"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400158607">
	<b:glossaryEntry>by the public or the people generally; "publicly provided medical care"; "publicly financed schools"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400158780">
	<b:glossaryEntry>by a group of people rather than an individual; "the mills were owned communally"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400158918">
	<b:glossaryEntry>in a reproving or reproachful manner; "she spoke to him reprovingly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400159078"
	 b:glossaryEntry='in a gay manner; "the scandals were gaily diverting"'/>
<rdf:Description rdf:about="&a;400159182"
	 b:glossaryEntry='in close cooperation; "they work hand in glove"'/>
<rdf:Description rdf:about="&a;400159304">
	<b:glossaryEntry>in close proximity; "the houses were jumbled together cheek by jowl"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400159414"
	 b:glossaryEntry='haphazardly; "the books were piled up helter-skelter"'/>
<rdf:Description rdf:about="&a;400159527">
	<b:glossaryEntry>in disorderly haste; "we ran head over heels toward the shelter"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400159704"
	 b:glossaryEntry="in a feckless manner; irresponsibly and incompetently"/>
<rdf:Description rdf:about="&a;400159814">
	<b:glossaryEntry>in a wild or reckless manner; "dashing harum-scarum all over the place"; "running pell-mell up the stairs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400159973">
	<b:glossaryEntry xml:space='preserve'><![CDATA[without care or concern; "carelessly raised the children''s hopes without thinking of their possible disappointment"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400160176"
	 b:glossaryEntry='with complete faith; "she was with him heart and soul"'/>
<rdf:Description rdf:about="&a;400160289">
	<b:glossaryEntry>in every detail; "he believed her story hook, line, and sinker"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400160423">
	<b:glossaryEntry>with much ceremony; "they celebrated her birthday in a big way"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400160545"
	 b:glossaryEntry='without making progress; "the candidates talked in circles"'/>
<rdf:Description rdf:about="&a;400160657"
	 b:glossaryEntry="(colloquial) very unlikely"/>
<rdf:Description rdf:about="&a;400160744"
	 b:glossaryEntry='in some respects; "in a sense, language is like math"'/>
<rdf:Description rdf:about="&a;400160847">
	<b:glossaryEntry>if there happens to be need; "in case of trouble call 911"; "I have money, just in case"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400160986"
	 b:glossaryEntry='in a cold unemotional manner; "he killed her in cold blood"'/>
<rdf:Description rdf:about="&a;400161132">
	<b:glossaryEntry>in a serious manner; "talking earnestly with his son"; "she started studying snakes in earnest"; "a play dealing seriously with the question of divorce"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400161383">
	<b:glossaryEntry xml:space='preserve'><![CDATA[at the appropriate time; "we''ll get to this question in due course"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400161559"
	 b:glossaryEntry='proceeding with full vigor; "the party was in full swing"'/>
<rdf:Description rdf:about="&a;400161675"
	 b:glossaryEntry='with something of the same kind; "she pays him back in kind"'/>
<rdf:Description rdf:about="&a;400161790">
	<b:glossaryEntry>one behind another in a line or queue; "they waited in line for the tickets"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400161902">
	<b:glossaryEntry xml:space='preserve'><![CDATA[by title or repute though not in fact; "he''s a doctor in name only"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400162020">
	<b:glossaryEntry>in a relatively short time; "she finished the assignment in no time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400162139">
	<b:glossaryEntry>for an extended time or at a distant time; "a promotion long overdue"; "something long hoped for"; "his name has long been forgotten"; "talked all night long"; "how long will you be gone?"; "arrived long before he was expected"; "it is long after your bedtime"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400162432"
	 b:glossaryEntry="for an extended distance"/>
<rdf:Description rdf:about="&a;400162489">
	<b:glossaryEntry>incidentally; in the course of doing something else; "he made this remark in passing"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400162626"
	 b:glossaryEntry='in practical applications; "will this work in practice?"'/>
<rdf:Description rdf:about="&a;400162722">
	<b:glossaryEntry>in secrecy; not openly; "met secretly to discuss the invasion plans"; "the children secretly went to the movies when they were supposed to be at the library"; "they arranged to meet in secret"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400162989"
	 b:glossaryEntry='without delay; "John got ready in short order"'/>
<rdf:Description rdf:about="&a;400163078">
	<b:glossaryEntry>with the inside facing outward; "she turned the shirt inside out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163182">
	<b:glossaryEntry>thoroughly; from every perspective; "she knows this town inside out"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163289">
	<b:glossaryEntry xml:space='preserve'><![CDATA[on everybody''s mind; "Christmas was in the air"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163400">
	<b:glossaryEntry xml:space='preserve'><![CDATA[before now; "why didn''t you tell me in the first place?"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163561">
	<b:glossaryEntry>after a very lengthy period of time; "she will succeed in the long run"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163689">
	<b:glossaryEntry>at the last possible moment; "she was saved in the nick of time"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163816">
	<b:glossaryEntry>simultaneously; "she praised and criticized him in the same breath"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400163930"
	 b:glossaryEntry='without being tardy; "we made it to the party in time"'/>
<rdf:Description rdf:about="&a;400164034">
	<b:glossaryEntry>to no avail; "he looked for her in vain"; "the city fathers tried vainly to find a solution"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400164189">
	<b:glossaryEntry>without success; "she tried unsuccessfully to persuade him to buy a new car"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400164344"
	 b:glossaryEntry='in a careful manner; "you must treat this plant just so"'/>
<rdf:Description rdf:about="&a;400164454"
	 b:glossaryEntry='without delay; "she tackled the job lickety-split"'/>
<rdf:Description rdf:about="&a;400164590">
	<b:glossaryEntry>(informal) with great speed or effort or intensity; "drove like crazy"; "worked like hell to get the job done"; "ran like sin for the storm cellar"; "work like thunder"; "fought like the devil"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400164888">
	<b:glossaryEntry xml:space='preserve'><![CDATA[used ironically to indicate the opposite of what is stated; "says he''ll help me? Like hell he will!"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400165026"
	 b:glossaryEntry='on and on for a long time; "the child cried no end"'/>
<rdf:Description rdf:about="&a;400165131"
	 b:glossaryEntry='not regularly; "they phone each other off and on"'/>
<rdf:Description rdf:about="&a;400165232">
	<b:glossaryEntry>without preparation; "the presidential candidate made a remark off the cuff"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400165349">
	<b:glossaryEntry>in a confidential manner; "spoke to him intimately and confidentially"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400165480"
	 b:glossaryEntry='not for quotation; "he spoke to the reporter off the record"'/>
<rdf:Description rdf:about="&a;400165583">
	<b:glossaryEntry>on hands and knees; "he got down on all fours to play with his grandson"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400165696"
	 b:glossaryEntry='typically; "on average he watches three movies a week"'/>
<rdf:Description rdf:about="&a;400165806">
	<b:glossaryEntry>for examination (with an option to buy); "they took the VCR on approval"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400165918"
	 b:glossaryEntry='with trust and confidence; "we accepted him on faith"'/>
<rdf:Description rdf:about="&a;400166027"
	 b:glossaryEntry="by hypothesis"/>
<rdf:Description rdf:about="&a;400166101">
	<b:glossaryEntry>according to the assumed facts; "on paper the candidate seems promising"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400166238">
	<b:glossaryEntry>in a theoretical manner; "he worked the problem out theoretically"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400166382"
	 b:glossaryEntry="in an opposite position"/>
<rdf:Description rdf:about="&a;400166462">
	<b:glossaryEntry xml:space='preserve'><![CDATA[contrary to expectations; "he didn''t stay home; on the contrary, he went out with his friends"]]></b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400166664">
	<b:glossaryEntry>on the run or in a hurry; "she wrote those letters on the fly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400166765">
	<b:glossaryEntry>without delay or immediately; "we hired her on the spot"; "thought they were going to shoot us down on the spot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400166917">
	<b:glossaryEntry>at the place in question; there; "they were on the spot when it happened"; "it had to be decided by the man on the spot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400167077">
	<b:glossaryEntry>in a difficult situation; "that question really put him on the spot"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400167185">
	<b:glossaryEntry>on impulse; without premeditation; "he decided to go to Chicago on the spur of the moment"; "he made up his mind suddenly"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400167372">
	<b:glossaryEntry>on a route to some place; "help is on the way"; "we saw him on the way to California"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400167507"
	 b:glossaryEntry='at the expected time; "she always arrives on time"'/>
<rdf:Description rdf:about="&a;400167618"
	 b:glossaryEntry='without warning; "your cousin arrived out of thin air"'/>
<rdf:Description rdf:about="&a;400167748"
	 b:glossaryEntry='of unwed parents; "he was born out of wedlock"'/>
<rdf:Description rdf:about="&a;400167856">
	<b:glossaryEntry>in a flattering way; "the dress brought out her figure to advantage"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400167965"
	 b:glossaryEntry='to an excessive degree; "John is neat to a fault"'/>
<rdf:Description rdf:about="&a;400168096"
	 b:glossaryEntry='without exception; "voted for unionization to a man"'/>
<rdf:Description rdf:about="&a;400168185"
	 b:glossaryEntry='in every detail; "the new house suited them to a T"'/>
<rdf:Description rdf:about="&a;400168316">
	<b:glossaryEntry>prior to the present time; "no suspect has been found to date"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400168426"
	 b:glossaryEntry='to specification; "he had the shoes made to order"'/>
<rdf:Description rdf:about="&a;400168513"
	 b:glossaryEntry='with force and ferocity; "she fought tooth and nail"'/>
<rdf:Description rdf:about="&a;400168608">
	<b:glossaryEntry>with that general meaning; "she said something to that effect"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400168713"
	 b:glossaryEntry='in full; "you are in this to the hilt"'/>
<rdf:Description rdf:about="&a;400168806">
	<b:glossaryEntry>because of prevailing conditions; "under the circumstances I cannot buy the house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400168940"
	 b:glossaryEntry="toward the mouth or oral region"/>
<rdf:Description rdf:about="&a;400169040"
	 b:glossaryEntry="away from the mouth or oral region"/>
<rdf:Description rdf:about="&a;400169145">
	<b:glossaryEntry>in a courageous manner; "bravely he went into the burning house"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400169296">
	<b:glossaryEntry>from on board a vessel into the water; "they dropped their garabge overboard"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400169411">
	<b:glossaryEntry>in or toward the northern parts of a state, as in "upstate New York"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400169515">
	<b:glossaryEntry>to a great depth psychologically; "They felt the loss deeply"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400169660"
	 b:glossaryEntry='in an impatient manner; "he answered her impatiently"'/>
<rdf:Description rdf:about="&a;400169807"
	 b:glossaryEntry='in a patient manner; "he patiently played with the child"'/>
<rdf:Description rdf:about="&a;400169954"
	 b:glossaryEntry='in a tense manner; "he sat down tensely"'/>
<rdf:Description rdf:about="&a;400170048"
	 b:glossaryEntry='in a methodical manner; "she worked methodically"'/>
<rdf:Description rdf:about="&a;400170156"
	 b:glossaryEntry='without seeing or looking; "he felt around his desk blindly"'/>
<rdf:Description rdf:about="&a;400170270">
	<b:glossaryEntry>in an apologetic manner; "he spoke apologetically about his past"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400170396">
	<b:glossaryEntry>in an unsteady manner; "he walked unsteadily toward the exit"; "The wounded soldier was swinging unsteadily on his legs"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400170655"
	 b:glossaryEntry='in a steady manner; "he could still walk steadily"'/>
<rdf:Description rdf:about="&a;400170787"
	 b:glossaryEntry='in a haughty manner; "he peered haughtily down his nose"'/>
<rdf:Description rdf:about="&a;400170899">
	<b:glossaryEntry>to an extreme or greatly exaggerated degree; "the storyline is wildly unrealistic"</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;400171034">
	<b:glossaryEntry>in a wild or undomesticated manner; "growing wild"; "roaming wild"</b:glossaryEntry>
