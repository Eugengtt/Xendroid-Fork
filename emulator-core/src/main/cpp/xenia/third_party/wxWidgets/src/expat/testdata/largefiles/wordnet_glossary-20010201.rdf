</rdf:Description>
<rdf:Description rdf:about="&a;108075061">
	<b:glossaryEntry>tropical American trees and shrubs; often placed in other genera</b:glossaryEntry>
</rdf:Description>
<rdf:Description rdf:about="&a;108075220">
