<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The DocumentsProvider lives in :emulator-core (it depends on Application/Utils,
         which moved here too). ${applicationId} resolves to the consuming app's id at
         merge time, so :app gets a distinct, non-colliding authority. -->
    <application>
        <provider
            android:name="xendroid.compose.DocumentsProvider"
            android:authorities="${applicationId}.DocumentsProvider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
